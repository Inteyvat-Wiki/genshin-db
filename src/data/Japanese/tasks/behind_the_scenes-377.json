			"dialogs": [
				{
					"id": 3770201,
					"content": "来たんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3770202,
					"content": "#ん？君は…{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770203,
					"content": "…ジン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "先に言っておくと、僕が今回連絡したのは一人だけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770206,
					"content": "それから、こちらはただの「ジン」だ。「団長」としてのジンではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770207,
					"content": "栄誉騎士の君でも、そうそう接触できない人物だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770208,
					"content": "意外だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770209,
					"content": "天空のライアーの話は聞いていたが、まさか君だったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770210,
					"content": "では、ディルックが言ったようにライアーの音で風魔龍が浄化され元に戻るという話は…本当なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770211,
					"content": "#そうだよ！今、この栄誉騎士{NICKNAME}は風魔龍事件を解決するために、最前線で頑張ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3770212,
					"content": "さすが騎士団のスーパールーキーだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3770213,
					"content": "違法なこともやらかしそうになったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3770214,
					"content": "ふん、神話と関わるような荒唐無稽な説明を信じないのも無理はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770215,
					"content": "だが、問題ない。詩人にもう一度歌ってもらって、この…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770216,
					"content": "信じるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770217,
					"content": "頑固な団長様を説得…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770218,
					"content": "四風守護の東風の龍、トワリン、彼の裏切る理由がどう考えても分からなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770219,
					"content": "数百年前のモンドを守る戦争で、毒血の侵食を受け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770220,
					"content": "目覚めた後もアビスの魔術師のせいで腐食を受けたのなら、そうなるのも筋が通る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770221,
					"content": "——でもこれは「代理団長」の立場としては、絶対に口にできないことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770222,
					"content": "「ファデュイ」の圧力のせいで、騎士団が公に風魔龍への善意を示すことは難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770223,
					"content": "そんなことをすれば、務めを放棄したと解釈される可能性もある。だから私は、プライベートという形で行動するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770224,
					"content": "ふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770225,
					"content": "そういうところも、騎士団の嫌いな理由の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770226,
					"content": "ただ、この正体の分からない異邦人をそのまま信じるとは思わなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770227,
					"content": "<color=#00E1FFFF>先輩</color>のような厳しくて慎重な人でも、この旅人を信用しているではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770228,
					"content": "だから先輩はやめろ…今回は協力すると決めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770229,
					"content": "先輩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770232,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770233,
					"content": "触れちゃいけない過去があるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3770234,
					"content": "とにかく、天空のライアーについては心当たりがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770235,
					"content": "（何事もないように話題を変えた！彼女、やるねぇ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3770236,
					"content": "モンドとスネージナヤの衝突、本質的には七国と七神の衝突だが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770237,
					"content": "氷の神が率いる「ファデュイ」は、風神が残した力を利用しようと企んでいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3770239,
					"content": "彼らはモンドの防御を管理するつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770242,
					"content": "もし、風龍を殺す計画を騎士団が止めたとなると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770243,
					"content": "天空のライアーは、彼らが唯一手にすることができる風神の力だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770244,
					"content": "モンドで単独行動している「ファデュイ」のメンバーはいくらでもいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770245,
					"content": "すでにそいつらから情報を聞き出した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770246,
					"content": "ディルックが手に入れた情報によると、ファデュイは天空のライアーをゲーテホテルに置いていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770247,
					"content": "さすがに彼らでも、せっかく手にした秘宝を半ば公の場所ともいえるようなところに置いておけないのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3770248,
					"content": "分かる分かる。大事になったら、外交問題に繋がるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3770249,
					"content": "はっ…七国同士の関係性はそういうものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770250,
					"content": "異邦人、出発の準備はできているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3770240,
					"content": "彼らはトワリンを殺すつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "（聞いてないふりをする。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "どうして団長がここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
