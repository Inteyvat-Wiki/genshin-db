			"trigger": {
				"objectNames": [
					"ヴィナヤック",
					"シュリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735160101,
					"content": "——シュリヤ、みたか！僕たちの「対ウェネト殺蟲大砲」は、やっぱり新時代を画するデザインだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160102
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160102,
					"content": "まったく、当時僕たちの卒業発表を審査した先生方に見せてやりたいよ。あの人たちの古く保守的な視野をどうにかしてやれそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160103,
					"content": "本当に大した問題もなく起動できるなんて…どうせ三号機のような結末になるって思ってたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160104
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735160104,
					"content": "コホン…失敗は成功の母って言うだろ。もう昔の僕じゃないってことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160105
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160105,
					"content": "当時、一体どれだけ事故ったんだよ…まあ、とにかく実験は成功したんだからそれでいいよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735160106,
					"content": "ああ、この勢いで、場所を変えてもう一度だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160107
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160107,
					"content": "——目撃情報によると、この辺りには少なくともまだ二桁のウェネトが潜んでいるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160108,
					"content": "ちょっと待った——二桁！？こんな調子で一匹ずつやっつけていくつもりじゃないよな？一体いつになったら終われるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735160109,
					"content": "えっ？何か問題があるかい？「対ウェネト殺蟲大砲」のメンテナンスなら、心配はいらないはずだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160110
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160110,
					"content": "いやいや！そんな終わりの見えないことをやってたら、たとえ機械が大丈夫でも、オイラたちのほうが先に持たなくなるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735160111,
					"content": "ヴィナヤック、みんながあなたみたいに、エンジンオイルの匂いを嗅ぐだけで元気になれるわけじゃないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160112
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735160112,
					"content": "そうか？じゃあ次はウェットウェアの機能についても検討しないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160113
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735160113,
					"content": "とにかく、今日はここまでにしましょう。今回とれた完全運行のデータと戦闘後のサンプルは、私が謎を解くための一歩を踏み出させてくれたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160114
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735160114,
					"content": "謎って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735160115
					]
				},
				{
					"id": 735160115,
					"content": "ウェネトが暴れ出す原因、環境パラメータの異常…こういったことたちを究明できれば、もしかしたら根本的に今回の騒ぎを解決できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160116
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735160116,
					"content": "あと一日、調査する時間をもらえないかしら。明日のこの頃には、結果が出てるはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				}
			]
		}
	]
}