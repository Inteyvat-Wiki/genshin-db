			"trigger": {
				"objectNames": [
					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "槍突き…はぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310102,
					"content": "練習に付き合いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "おお！あなたですか、また私の依頼を受けてくれたのですか？感謝します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310104,
					"content": "あなたのような実力者が、私の対戦相手になってくれるだなんて、非常に助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310105,
					"content": "また槍術が上達したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "はは…からかわないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310107,
					"content": "槍は武道に精通していない私のような者でも使えるようにと考慮し、発明されたとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310108,
					"content": "何しろ長くて尖った武器ですから、使い方を知らずにただ突いたり振ったりしているだけでも、十分な戦力になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310109,
					"content": "しかし、そう考えてみますと…長い柄と三つの歯を持った農具の方が強そうですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310110,
					"content": "武器はもう取り返したよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "武器を取り返したからといって、修行が終わったわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310112,
					"content": "今回は海乱鬼と遭遇しましたが、今後、もっと強大な敵に出会わないとは言い切れませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310113,
					"content": "もう二度と敵に武器を盗られたりなどしません。二度と武士の名誉を踏みにじらせない、これが私の求める武士の道です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2203102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
