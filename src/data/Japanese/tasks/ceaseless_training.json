			},
			"dialogs": [
				{
					"id": 220310201,
					"content": "おっと、話し過ぎてしまいました。あなたの時間を無駄にしてはいけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2203103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "先ほど、あなたは気が散っていたように見えます。歩調が乱れ、攻撃の力が強かったり、弱かったりと、一貫性がありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310302,
					"content": "手加減は許しませんよ。きちんと準備してから、もう一度手合わせしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
