					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "はぁ…はぁ…あなたの実力は、私をはるかに上回っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310402,
					"content": "次は手加減する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "いいえ！やはり全力を出してください。徹底的にやらないと、成長しないと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310404,
					"content": "あなたのその強さも、鍛練を積んだ成果ですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310405,
					"content": "いきなり失礼ですが…あなたはどうやって自身を鍛えたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310406,
					"content": "巨龍と飛行訓練をした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "きょ、巨龍と飛行するなんて、想像がつきません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310410,
					"content": "大したことじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "ははは、そうなんですか。では、あなたは間違いなく天才です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310412,
					"content": "練習に付き合ってくれてありがとうございます。これは報酬です、受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310408,
					"content": "巨大な狼に練習相手になってもらった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "それはまさに…勇猛果敢。巨大な狼と戦うあなたの姿を見たい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝倉"
				}
			]
		},
