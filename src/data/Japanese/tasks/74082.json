					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "塗り絵ヒト、パシーフ、チシキ、おてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821026,
					"content": "うーん…「塗り絵ヒト」ってやつはおまえに知識を与えてくれたのか？",
