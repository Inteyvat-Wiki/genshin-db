			"dialogs": [
				{
					"id": 740820401,
					"content": "（ほとんどの文字が消されて、読めるのはこれだけ——『…清き露…三…』）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "謎の祭壇"
				},
				{
					"id": 740820402,
					"content": "うわっ、ここの文字も消されてるぞ、なにか秘密があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820403,
					"content": "清き露？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "「清き露」ってなんのことだ？きれいな露？でも周りは水だらけだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820405,
					"content": "この「三」は、三滴ってことか？全然わかんないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820409,
					"content": "そのお宝を見つける鋭い鼻に聞いてみて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "もう聞いたぞ！とにかく…とにかく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820411,
					"content": "とにかく「三」と「水」に関係があるみたいだ、近くを探してみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820406,
					"content": "三？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "「三」って三つってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820408,
					"content": "「清き露」ってきれいな露のことか？でも周りは水だらけだ…全然わかんないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "パイモン"
				}
			]
		},
