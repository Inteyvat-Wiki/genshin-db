					"nextDialogs": [
						740821018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821018,
					"content": "#塗り絵ヒト！パイモン、パイモン、{NICKNAME}、{NICKNAME}、塗り絵ヒト、塗り絵ヒト！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
