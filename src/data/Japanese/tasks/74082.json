			"dialogs": [
				{
					"id": 740820101,
					"content": "（ほとんどの文字が消されて、読めるのはこれだけ——『…清き露…霧の幽林道で歌う…』）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "文字が刻まれた石碑"
				},
				{
					"id": 740820102,
					"content": "うわ！文字が消されてるぞ！この場所の紹介文だろ？まったく、マナーの悪い観光客だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820103,
					"content": "観光客なら、落書きぐらいしかしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#まぁ、そうだな…たとえば{NICKNAME}とパイモンここに参上とか…いやいや、オイラたちはいいやつだから、そんな落書きしないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820105,
					"content": "おかしいな、なんで文字が消えてるんだ？残ってるのはこれだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820106,
					"content": "この文の上にも削った跡がたくさんあるぞ、きっと消しきれなかったんだろ。「霧の幽林道」の文字は運がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820107,
					"content": "霧の幽林道ってどんな場所かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "うーん…霧の中に林がある？っていう意味だろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820109,
					"content": "見に行ってみようぜ、珍しいお宝が見つかるような秘密が隠されてたりして！本だったらそんな展開になるだろ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820110,
					"content": "どこの屋台で読んだ本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "オイラは食べてばっかのパイモンじゃないぞ！きっとお宝が隠されてるから、この霧の幽林道は秘密の場所って言われてるんだと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}、宝探しの旅に出るぞ！お宝に鼻が利く最高の仲間、パイモンを連れて出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820111,
					"content": "どこの書庫で読んだ本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
