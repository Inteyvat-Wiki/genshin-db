					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821032,
					"content": "#{M#君}{F#あなた}は塗り絵ヒトに協力してるの？",
