					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821038,
					"content": "急ごう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#パイモン、パシーフ！{NICKNAME}、パシーフ！",
