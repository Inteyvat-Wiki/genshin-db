			"dialogs": [
				{
					"id": 740820701,
					"content": "キラキラした雫が祭壇の上に現れた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "あれ、この雫…まさかこれがお宝なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820703,
					"content": "あまりそうは見えないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "オイラもそう思うぞ…こんなにあっさり見つかったんだからな…じゃあ、お宝じゃなかったら、これっていったいなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820705,
					"content": "魔王を封じてた重要アイテムかもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "え？じゃあ大変なことになるだろ、早く！元のところに戻すんだ！手遅れになる前に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820707,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820708,
					"content": "おしまいだぁ！魔王が出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820709,
					"content": "マオウ？メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820715,
					"content": "びっくりしたぞ…メリュジーヌか…どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820716,
					"content": "鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820717,
					"content": "え…なにが鍵なんだ？この雫が鍵なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820718,
					"content": "パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820719,
					"content": "えっと…この雫がパシーフ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820720,
					"content": "メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820721,
					"content": "えぇ？どういうことだよ？この雫がメリュジーヌ？頭がくらくらしてきたぞ、一体なんなんだ？おまえこそメリュジーヌだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820722,
					"content": "パシーフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820723,
					"content": "ん…？おまえがパシーフ？それは名前か？それとも苗字？…聞いたらますますくらくらしてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820724,
					"content": "よし！おまえをパシーフって呼ぶ！これでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820725,
					"content": "メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}…どうしよう？こいつがなにを言いたいのか全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820727,
					"content": "#{M#俺}{F#私}たちの言葉は分かるんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "パシーフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820729,
					"content": "この雫が鍵なんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820731,
					"content": "#{M#君}{F#あなた}は人間じゃない、でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820733,
					"content": "おい…そんなの見ればわかるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820734,
					"content": "#{M#俺}{F#私}は人間じゃない、でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "メ…メリュジーヌ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820736,
					"content": "あ！待て、ちょっとわかったぞ…「パシーフ」がはい、「メリュジーヌ」がいいえって意味じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820737,
					"content": "パシーフ！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820738,
					"content": "パシーフっておまえの名前じゃなかったのか…ごめんな、間違えちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820739,
					"content": "パシーフ…好き…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820740,
					"content": "この名前が気に入ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820742,
					"content": "#よかった！じゃあおまえをそう呼ぼう！へへっ、オイラはパイモン！こっちは{NICKNAME}。はじめまして、パシーフ。おまえみたいなメリュジーヌは見たことないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820743,
					"content": "#パイモン、パシーフ！{NICKNAME}、パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820744,
					"content": "エリニュス…メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820745,
					"content": "…エリニュスがいいえ？うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820746,
					"content": "エリニュス島は良くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "エリニュス、メリュジーヌ、今…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820748,
					"content": "パシーフ、エリニュス、守る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820749,
					"content": "エリニュス島がまずいことになってるから、守りたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820750,
					"content": "#パイモン、{NICKNAME}、エリニュス、手、おてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820751,
					"content": "うーん…今度は言葉が五つも出てきたぞ…えっと…オイラとこいつと、手を繋ぎたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820752,
					"content": "メリュジーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820753,
					"content": "#{M#俺}{F#私}たちの手を借りたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820755,
					"content": "協力してほしいってことか…手を繋ぐのかと思ってたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820756,
					"content": "手、おてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820757,
					"content": "報酬はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "ホウ…シュウ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820759,
					"content": "#まったく、{NICKNAME}。こいつってあんまり話せないだろ、だからきっと他のやつに助けを求めたりするのができないと思うぞ。オイラたちが助けてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820760,
					"content": "助けるってどうやって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "鍵、鍵、鍵、数。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820763,
					"content": "それで？鍵の数は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820764,
					"content": "鍵！鍵！鍵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820765,
					"content": "鍵は三本？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "パシーフ！鍵、霧…道、南…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820767,
					"content": "鍵、泉、北…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820768,
					"content": "鍵、柳、東…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820769,
					"content": "おお！なるほど…ひとまず覚えておくか…鍵は全部で三本、南の霧の道、北の泉、東の柳…ってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820770,
					"content": "鍵、鍵、鍵、広場、西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820771,
					"content": "西の広場にはさらに鍵が三本あるって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820772,
					"content": "鍵を三本集めて広場に行くってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#パイモン、メリュジーヌ！{NICKNAME}、パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820774,
					"content": "#あっ、パシーフ！{NICKNAME}がオイラより賢いみたいに言わなくてもいいじゃんか！オイラはこいつと同じくらい賢いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820775,
					"content": "とにかく、オイラたちは鍵を一本手に入れたんだ、あと二本取ってくればいいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820776,
					"content": "エリニュス、メリュジーヌ…パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820777,
					"content": "安心しろ。何が起きたかわかんないけど、エリニュス島はオイラたちが守ってやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820778,
					"content": "でも一つだけ…パシーフ、誰の物じゃない金ピカでまん丸の物、それかひと目見て高そうな箱があったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820779,
					"content": "オイラたちに一言くれると嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820780,
					"content": "パシーフは分かったのか分からなかったのか頭を掻き、嬉しそうにぴょんぴょん飛び跳ねると、少し急ぎ足で去っていった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#あ、行っちゃったぞ…よっぽど急いでんだな。{NICKNAME}、残り二本の鍵を探しに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820761,
					"content": "助けるってどうやって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "誰かがここに置いてたのかもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "え？じゃあ、オイラたち泥棒じゃんか！ごめんごめん…早く元の場所に戻そうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820712,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740820713,
					"content": "おしまいだぁ！持ち主が戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740820714,
					"content": "モチヌシ？メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "パシーフ"
				}
			]
