						740821003
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821003,
					"content": "うわ！パシーフ、どこから現れたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821004,
					"content": "トツゼン！パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821005,
					"content": "わかった、まったく…おまえはオイラが見た中で一番特別なメリュジーヌだぞ…。そうだ、オイラの知ってるメリュジーヌは、ほとんどフォンテーヌ廷かメリュシー村で暮らしてるけど…おまえはどうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821006,
					"content": "フォンテーヌテイ？メリュシームラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821007,
					"content": "困ってそうだな…聞いたこともないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821008,
					"content": "フォンテーヌテイ、メリュジーヌ…メリュシームラ、メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821009,
					"content": "あ…エリニュス、パシーフ、おうち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821010,
					"content": "エリニュス、パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821011,
					"content": "待て、ここがおまえの家だって？つまり故郷を守ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821012,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740821013,
					"content": "メリュジーヌの故郷はメリュシー村だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "そうだよな。おかしい…つまり他の場所で生まれるメリュジーヌもいるってことか？でもここに他のメリュジーヌはいないみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821015,
					"content": "パシーフ、ずっと一人で暮らしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740821016,
					"content": "一人？メリュジーヌ。塗り絵ヒト！パシーフ！",
