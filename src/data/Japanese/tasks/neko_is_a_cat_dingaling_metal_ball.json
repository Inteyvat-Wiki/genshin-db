			"trigger": {
				"objectNames": [
					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "にゃおーん、この石、いつになったらうちと同じ姿になるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150102,
					"content": "彫刻はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "あの石人間が、あとしばらくしたら完成すると言っていたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150104,
					"content": "響が帰ってきたら、きっと喜ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150105,
					"content": "それと、石を作る以外に、神社もキレイにしないといけないにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150106,
					"content": "主ら、この丸くて音がする鉄球を神社の周りにかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150107,
					"content": "これは響が以前準備していたものにゃ。たしか、うちとあの子らのことが好きだった響のために、百目鬼が贈ったもの、探し出すのに苦労したにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150108,
					"content": "これは…鈴？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "「鈴」？うちはわからない…でも響が昔、その鉄球を使ってよくうちと遊んでいたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150110,
					"content": "その鉄球を地面に置いて、遠くに飛ばす。鉄球が動いてるときは、音が鳴るにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150111,
					"content": "鉄球にどんな力があるか知らにゃいが、その音はうちと他の猫たちを引きつけるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150112,
					"content": "だから、うちはわかったにゃ。神社に人が来ないのは、その鉄球がないからにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150113,
					"content": "主ら、この鉄球を高いところに飾るにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150114,
					"content": "そうしたら、人間は鉄球の音を聞き、神社に来ることができるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150115,
					"content": "「賽銭箱」にもお金がたくさん入り、神社も賑やかになる。そしたら響も喜ぶにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150116,
					"content": "だから、その鉄球を神社の周りに飾ってくれにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150117,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "頼んだにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221502,
