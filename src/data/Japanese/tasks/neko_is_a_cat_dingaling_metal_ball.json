					"「寝子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "ぜんぶ飾ったのかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150302,
					"content": "うん、全部終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "にゃおーん、よかったにゃ。これで神社も賑やかににゃる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150305,
					"content": "ん？どうして人間が来ないにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150306,
					"content": "そんなに早くは来ないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "ふむ、人間は難しいにゃ。もちろん、主は違う。主は察しがいいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150309,
					"content": "人はまだ来にゃいけど…鉄球の音があれば、少なくともあの子らが道に迷うことはなくなるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150310,
					"content": "あの石人間、うちの形をした石がもうすぐでできるから、必ず来いと言っていたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150311,
					"content": "あっ、それと、おかしなことがあるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150312,
					"content": "うち、あの緑色の二人の人間に、響と百目鬼のことを聞いたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150313,
					"content": "でも二人とも、響のことや響に関わることも知らないと言ったにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150314,
					"content": "でも背の高い方の緑色の人間は、「赤穂百目鬼」の話を聞いたことがあるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150315,
					"content": "しかも…「賊」や「討伐」と言っていた…つまり、百目鬼が悪者だと言っていたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150316,
					"content": "きっと何かの間違いにゃ。響は彼といつも遊んでいた。百目鬼はいいやつにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150317,
					"content": "きっとあの人間の察しが悪いせいにゃ。やっぱり、頼れるのは主だけにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150318,
					"content": "響…いつになったら帰ってくるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722150307,
					"content": "そんなに簡単にはいかないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}