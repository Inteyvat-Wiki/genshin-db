					"アランチャトラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "「アタマダケ」を手に入れて「お料理修行」を終えられた上に、大きくて頼れるナラに出会えた…心から嬉しく思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200402,
					"content": "#アランパカティ、アランサカ、アランパス、アランファラも、キミに感謝するはずです。ナラ{NICKNAME}、キミはいいナラですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200403,
					"content": "感謝？どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "だって、キミが手伝ってくれたおかげで、みんなも「アタマダケ」を味わえるんですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランチャトラ"
				}
			]
		},
