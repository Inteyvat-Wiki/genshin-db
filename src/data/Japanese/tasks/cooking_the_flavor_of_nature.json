					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "うぐっ？うっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200102,
					"content": "あ。ナラだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200103,
					"content": "ゴホンゴホン。そちらのナラには、取り乱したところをお見せしてしまいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200104,
					"content": "善良なナラ、ボクはアランチャトラです。キミたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200105,
					"content": "#{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "オイラはパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200107,
					"content": "#ナラ{NICKNAME}とパイモンですね。お二人に感謝です。ここでお二人にお会いしなければ、回復までもうちょっとかかっていたでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200108,
					"content": "もうちょっとってどれくらいだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200109,
					"content": "お恥ずかしい話ですが、前にも悪いキノコのせいで同じような目に遭いました。その時は湖面のサウマラタ蓮が開いては閉じるのを二回繰り返す頃に、回復したのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200110,
					"content": "開いて閉じてって…それじゃ、二日もかかったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200111,
					"content": "ああ、二日ですか。なるほど、それが「～日」の意味だったんですね。キミたちナラは、実に面白い。二日は長い？短い？どちらでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200112,
					"content": "#うーん…{NICKNAME}、どう思う？二日って長いか？それとも短いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200113,
					"content": "長いんじゃないかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "うんうん。アランチャトラが二日もずっと「うええええっ」ってしてる姿は想像できないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200115,
					"content": "へえ？そんなに長い時間だったとは…大ごとだったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200126,
					"content": "そういえば、アランチャトラって言うと…アランパカティの親戚か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200127,
					"content": "いいえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200128,
					"content": "あれ？でも…アランパカティの兄ちゃんなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200129,
					"content": "あれ？どうしてご存知で？アランパカティは確かにワタシの「妹」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200130,
					"content": "一体どうなってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200131,
					"content": "多分、アランナラとは概念が違うんだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "とにかく、これまでの事情をかいつまんで話すと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200133,
					"content": "アランチャトラにこれまでの経緯を説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "またウツァヴ祭が帰ってくるんですか…どうしましょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200135,
					"content": "まだ、大切な「食材」が用意できていません。ウツァヴ祭でアランサカとアランパス、アランファラに、キノコ料理が一番だって証明したいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200136,
					"content": "それで、ランス…スパ…ラン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200137,
					"content": "アランサカ、アランパス、アランファラ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "あああっ！アランナラの名前って覚えづらいぞ！アランチャトラ、おまえの兄弟はどこへ行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200139,
					"content": "それぞれの修行の道へは、行けば行くほど遠ざかるものです。川の流れが渓流に変わるみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200140,
					"content": "つまり、バラバラになったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200141,
					"content": "ワタシたちの「お料理修行」は、「至高のごちそう」を作るためのもの。でもヤツらは、キノコ料理を認めようとしなかったのです。どう考えても「アタマダケ」は無敵なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200142,
					"content": "とにかくワタシたちは各々の料理を完成させて、食べ比べしようと決めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200143,
					"content": "なるほど、料理の美味しさを極めるのか。事情はよく分かったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200144,
					"content": "それで、おまえの「アタマダケ」は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200145,
					"content": "それが…繁殖しすぎた「マラーナ」に、「アタマダケ」の生育地を奪われたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200146,
					"content": "えっと、つまり死域にってことか…ラナが無事だといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200147,
					"content": "貴重なキノコが、植物を枯らす毒牙にかかったのです。お二人なら分かるでしょう。「マラーナ」の地がどれほどに危険か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200148,
					"content": "「アタマダケ」がなかったので、ワタシはアランナラにとっては未知の怪しいキノコを食べてみたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200149,
					"content": "で、どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200150,
					"content": "結果はご覧の通りだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "まったくもってお恥ずかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200153,
					"content": "でもその死域…えっと「マラーナ」な。オイラたち、それと前に戦ったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200154,
					"content": "楽勝だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "うわぁ、「マラーナ」と戦う力をお持ちとは、すごいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200157,
					"content": "#でも、なるほど納得です。何てったって、クラクサナリデビの力でワタシを治してくれたナラ{NICKNAME}ですからね。「マラーナ」を消すくらい、容易いことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200158,
					"content": "#ナラ{NICKNAME}、お願いです。ワタシと一緒に「アタマダケ」の生育地にきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200159,
					"content": "#極上のキノコ料理を味わうチャンスだぜ！なあ{NICKNAME}、兄妹の再会のためにひと肌脱ごう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200160,
					"content": "アランパカティとの約束もあるしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "では、この先にある洞窟に付き合ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200161,
					"content": "ただ食べたいだけでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "一石二鳥だろ、なにが悪いんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200155,
					"content": "なんとか勝てた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "「うええええ——！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "短いと思うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "うん…確かに。考えてみると、オイラたちが知り合ったのも昨日のことみたいに思えるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200118,
					"content": "へえ？それなら安心しました。森で二日間のたうち回るというのも、さほど長い時間じゃなかったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200119,
					"content": "誰もそうは言ってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200120,
					"content": "その時間でなにをするかによるかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "確かに。丸二日「うええええっ」だったら長いけど、野生のイノシシが子供から大人になるまでって考えたら短いよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200122,
					"content": "へえ？そんなに長い時間だったとは…大ごとだったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200123,
					"content": "時間は主観的なものだから、意味はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#そうなんです。ナラ{NICKNAME}は、森の道理がよくお分かりのようですね。森では命が誕生して、育って、地に還る時間を、「～日」だなどと考える必要もないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200125,
					"content": "なんかメチャクチャだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランチャトラ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "おおっ、念願の「アタマダケ」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200202,
					"content": "「アタマダケ」、その香りを失ってしまったとしても、キミはまだ「アタマダケ」と言えるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200203,
					"content": "へへっ、このキノコ、確かにいい匂いだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200204,
					"content": "まぁとにかく、こっから出ようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランチャトラ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "お二人に会えて、本当によかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200302,
					"content": "これが完全に成熟した「アタマダケ」の香り…前に嗅いだものより、ずっと濃厚な芳香です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200303,
					"content": "生育地が「マラーナ」に占拠されても、立派に育って…すごいぞ、キノコ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200304,
					"content": "あのさ、その「アタマダケ」…味見したいなぁ、なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200305,
					"content": "もちろん。お二人には恩があります。最高のキノコ料理でナラをもう一度もてなす、それが「お料理修行」の目的でもありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200306,
					"content": "ひゃっほー！アタマダケ、最高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200307,
					"content": "アランチャトラはすぐさま料理に取り掛かった…\\nキノコの芳醇な香りが、鍋から溢れ出した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "その後、アランチャトラは出来上がった料理をあなたとパイモンにくれた。\\n…しかし、がっかりしたというべきか、案の定というべきか、これといった味はしなかった。\\nしかも生命力が強すぎるのか、歯ごたえがありすぎて、なかなか嚙み切れない。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "…完成です。ワタシの「お料理修行」は、とうとう完璧なフィナーレを迎えました。どうです？ナラにとっても、最高の味だったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200310,
					"content": "もぐもぐ…うぐっ…うーん…どうだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200311,
					"content": "（必死で咀嚼）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "（ングッと呑みこむ）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "なんとか食べられる。かなり頑張ればね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "うーん…確かに香りはいいけど、味と歯ごたえはちょっとオイラたちには合わないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200317,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200318,
					"content": "#えええっ、どうして？前にナラに食べてもらった時、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はおいしいと言っていましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200319,
					"content": "前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200320,
					"content": "#前にも、キノコ料理をナラに作ってあげたんです。とてもおいしかったようで、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は呑みこむ時に思い切りゴクンッとしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200321,
					"content": "なんの問題もなかったと思うのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200323,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "ふぅ。アランナラに生える葉っぱがそれぞれ違うように、キノコ料理もすべてのナラに受けるとは限らないということですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200325,
					"content": "そういうことだな。…そういえば、その葉っぱだけど…アランナラは火が怖くないのか？おまえら、どこからどう見ても葉っぱっぽいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200326,
					"content": "火はもちろん怖いですよ。森で山火事が起きたら、はげ山になることもありますし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200327,
					"content": "でも「お料理修行」のためなら、火が怖いなんて言ってはいられません。火加減を操るのも、修行の一環ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200328,
					"content": "なるほどな…さて、そろそろ帰るか。アランパカティが待ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200329,
					"content": "はい。急いでヴァナラーナに帰りましょう。大事な「妹」を心配させてはいけませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200330,
					"content": "仲間たち…アランサカ、アランパス、アランファラはそれぞれ<color=#00E1FFFF>ガンダルヴァー村の近く</color>、<color=#00E1FFFF>アパーム叢林</color>と<color=#00E1FFFF>デーヴァーンタカ山</color>にいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200331,
					"content": "#ありがとうございます。金色のナラ{NICKNAME}は、まるで太陽のようです。パイモンも割とすごいですね。妹のお願いの件についても、どうかよろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200332,
					"content": "なんでオイラのことは、「割と」すごいなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200333,
					"content": "まぁまぁ、そうカリカリなさらず…とにかく、色々とお世話になりました。どうお礼をしたらいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200334,
					"content": "よし、決めた。「至高のごちそう」の作り方をお教えしましょう。大人になれば、そのおいしさが分かるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730200335,
					"content": "#（{NICKNAME}、このレシピはオイラに調整させてくれ…きっといいオリジナルレシピにできるはずなんだ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730200314,
					"content": "少なくとも毒は入ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "この味は、ちょっと前衛的すぎたかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
