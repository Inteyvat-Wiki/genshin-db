						710210102,
						710210106
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210102,
					"content": "風の翼を使おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "やめよう。教令院に行ってからずっと屋内にいて、滅多に外に出ることもなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210104,
					"content": "それに教令院でも風の翼を使う機会はなかったから、風の翼の操縦方法も綺麗さっぱり忘れてしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210105,
					"content": "風の翼なんて使ったら、途中で水の中に落ちちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210106,
					"content": "船を借りよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "それがいいと思う。荆夫港なら船を借りられるけど、ここから遠すぎるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210108,
					"content": "往復で時間がかかりすぎてしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710210109,
					"content": "自分で船を組み立てるわけにも行かないし。教令院でも船の作り方なんて教わらなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘンリーモートン"
				}
			]
		}
	]
}