				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980101,
					"content": "今回の訓練は順調だったようネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980102,
						736980104
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736980102,
					"content": "まあまあかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980103
					]
				},
				{
					"id": 736980103,
					"content": "ああ、ソルシュにとっちゃ簡単すぎるぐらいだったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980106,
					"content": "ふふっ、次のパフォーマンスが楽しみだコト。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980107
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736980107,
					"content": "そうだ、ソルシュの振り返りで分かったことなんだけど、ソルシュが過去にやったことは、反抗期のせい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980108,
					"content": "それは言わなくていいデショ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980109
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980109,
					"content": "ええっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980110,
					"content": "コホン、と、とにかく今はもう、そんな段階は卒業してるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980111
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980111,
					"content": "それより、「謁賛主」と白フラに花霊誕生の歴史について語った後、森の中に住む草木の眷属および、かの者たちの特別なお祭りについて話しマシタ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980112
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980112,
					"content": "花霊には自分たちのお祭りがないコトが、ずっと引っかかっていたのデス。先輩はどうお考えでしょうカ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980113
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980113,
					"content": "私のアイデアですが、花霊のお祭りには、花霊を讃える詩を人に詠わせましょう。そして、私が優勝者を選ぶのデス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980114
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980114,
					"content": "私の知る限り、ウツァヴ祭はそんなふざけたお祭りではないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980115
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736980115,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980116
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980116,
					"content": "そもそも、自分の功績を人に記録させようなんて考えること自体、他の花霊とはかなり違うよな…これもスケプティック団の影響か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980117,
					"content": "だからこそ、過去を振り返って反省するコトが大事なノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980118
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736980118,
					"content": "ふふ、何はともあれ、ソルシュのパフォーマンスを楽しみにしているワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736980104,
					"content": "それほどでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980105
					]
				},
				{
					"id": 736980105,
					"content": "ソルシュは本人が言う程にはすごくなかったな。もうちょっと努力が必要だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7369806,
			"completionStepIds": [
				7369806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369806",
							"2"
						],
						"stepId": 7369806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980601,
					"content": "あ！オイラ、ここ覚えてるぞ。前にも来たことがあるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980602,
						736980604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980602,
					"content": "確かに印象深い場所だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980603
					]
				},
				{
					"id": 736980603,
					"content": "初めて見た時はびっくりしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980606,
					"content": "そいつは運悪くここに封印されたって、ソルシュが言ってたな。でも、ソルシュの訓練と何の関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980607,
					"content": "あ！もしかして、これはズルヴァーンからのメッセージなのか。「ふふ、ソルシュ、よく御覧なさい、運悪き者の結末よ」みたいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980608,
					"content": "ぷっ…先輩はそんなくだらないマネはしないワ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980609
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980609,
					"content": "…話を戻すわヨ。前にここを通った時は詳しく言わなかったケド、あいつが封印された災難のことなら——あなたたちも知っているかもしれないわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980610
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980610,
					"content": "それって五百年前の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980611,
					"content": "そう、恐らく一瞬の出来事だったと思うワ。見なさい。結晶となっても尚、当時の動きが見て取れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980612
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980612,
					"content": "もし封印が解除されたら、たちまち復活して洞窟の中を往来する勢いだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980613
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980613,
					"content": "この瞬間、お前は永遠を手にする…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980614
					]
				},
				{
					"id": 736980614,
					"content": "うぇっ、オイラはそんな目に遭いたくないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980615,
					"content": "一瞬の出来事とは言っても、うぅ…無理無理、考えただけでぞっとするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980616,
					"content": "パイモンをそんな目に遭わせないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980617
					]
				},
				{
					"id": 736980617,
					"content": "#おう！オイラも絶対に{NICKNAME}をそんな危険に遭遇させないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980618,
					"content": "じゃあ、あなたたちは私たち花霊に感謝しなくちゃネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980619
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980619,
					"content": "当時災禍を収めるために、花霊をはじめとする多くの種族や存在が犠牲になった…命より大切なものさえ、犠牲になったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980620
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980620,
					"content": "今の私たちが、そのような取返しのつかない災禍に巻き込まれずに済んでいるのは、当時の犠牲のお陰ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980621
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980621,
					"content": "私はその巨大な災厄を経験せずに済んだカラこそ、もしこの地が再び危機に陥った際には、より貢献しなければならないと思っているワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980622,
					"content": "その…こいつってソルシュより年上だよな。ソルシュにとっては先輩か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980623,
					"content": "そうネ。でも、生き返ることはもうないワ。結晶となって何百年も経つんだもノ。この先に待っているのは、朽ちてゆくだけの運命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980624,
					"content": "あの災厄では、数えきれない程の命が失われたワ。中にはこのように、災厄が発生した瞬間に封印された命も数多くある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980625
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980625,
					"content": "でも、もっと不幸な命がたくさんある。それらは数百年もの時が流れるとともに、跡形もなく消えていったノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980626
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980626,
					"content": "この世に何も残ってないそれらの命を、覚えている者は誰もいないし、弔うための場所もないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980627
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980627,
					"content": "目の前にいるこの命は、元々巨大な身体だった上に、太陽と風の当たらない地下の洞窟に棲息していたコトが幸いして、比較的完全な形が維持されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980628
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980628,
					"content": "陸地に生きる命で、時間に抗えるモノなんて存在しないワ。如何なる残骸も、いつかは跡形もなく消えてしまうノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980629
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980629,
					"content": "なんだか惜しいな…最終的には生きた痕跡さえ残らないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980630,
					"content": "ええ…人類の文献にはこの記録が残ってないのかしらネ？それとも人類にとっても、珍しい現象なのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980631
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980631,
					"content": "スケプティック団の他にも、森から調査に来た学者たちがいるって、以前先輩に聞いたことがあるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980632
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980632,
					"content": "だけど、人類の中には、風蝕ウェネトが流砂ウナギの完全な形態だと信じている者もいるって聞く…そんな程度の知識や想像力で記録された内容なんて、心配すぎるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980633
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736980633,
					"content": "それじゃ全然頼りにならないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980634,
					"content": "よく考えたら、人間の記録ってこんなに頼りにならないものなのに、それでもソルシュは根気強く人間の「謁賛主」に記録を頼んでるよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980635,
					"content": "この結晶よりも先に、オイラたちがソルシュに頼まれて書く頌歌のほうが、跡形もなく消えるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736980636,
