			"dialogs": [
				{
					"id": 742250201,
					"content": "ありがとう、恩人よ。神王の祝福あれ、私はついに救われました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "フォスカリ"
				},
				{
					"id": 742250202,
					"content": "君はこの町を守る兵士か？それとも通りすがりの正義の者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "フォスカリ"
				},
				{
					"id": 742250203,
					"content": "まずは自己紹介しておこう。私はファウストゥス、神王様に命じられて、辺境で商人をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "フォスカリ"
				},
				{
					"id": 742250204,
					"content": "南国の香料を運ぶためにここへ来たんだが、上陸してすぐ、あの忌々しいヴィシャップどもに囲まれてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "フォスカリ"
				},
				{
					"id": 742250205,
					"content": "ヴィシャップって？どこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "ほう？先ほど倒したばかりの敵もすでに眼中にないとは。君は実に素晴らしい勇者だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "フォスカリ"
				},
				{
					"id": 742250207,
					"content": "これを受け取ってくれ、礼はいらない。早く荷物を町に届けないといけないんだ。町でまた会うこともあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フォスカリ"
				}
			]
		}
	]
