			"dialogs": [
				{
					"id": 736740301,
					"content": "ちびっこ、お前が俺を連れて来たんだろ？ほら、動けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740302,
					"content": "はぁ、もういい。お前はそこでじっとしてろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740303,
					"content": "ウルマン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "旅人？久しぶりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740306,
					"content": "調子はどうだ？まだ世界中を旅しているのか？お前の数多くの偉業は俺の耳にも入ってきている、流石だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740307,
					"content": "ははっ、今回スメールに来たのは、どんな問題を解決するためなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740308,
					"content": "縁起の悪いことを言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "わかったわかった、本題に入ろう。旅人、今回も俺に協力してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740313,
					"content": "見ろ、このスメールの大地には、至る所に宝物やモラが隠されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740314,
					"content": "俺の体質も…いつも通り働いてくれて、たくさんの仙霊を引き付けてる。その中には、俺たちに馴染みのある「宝探し仙霊」もいるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740315,
					"content": "前と同じように、お前は宝を探して、俺はお前に報酬を用意するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740316,
					"content": "俺たちが手を組めば、絶対に大儲けできる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740317,
					"content": "今回も「鉄銭」を探すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "いや、それは違う。今回は「鉄銭」よりも価値のある、「古鉄銭」を探しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740319,
					"content": "一文字しか違わない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "その一文字を見くびらないでくれ。たった一文字の違いで、売るときに貰えるモラが増えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740326,
					"content": "じゃあ、この件はこれで決まりだ。前みたいに力を合わせて、大儲けしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740321,
					"content": "他の人を当たってみないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "いやあ…協力相手となれば、自分が一番よく知っている人を選びたいに決まってるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740323,
					"content": "それに、お前と俺の関係だからな。こんなにいい話があるってのに、お前以外に利益を譲るわけにはいかないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740324,
					"content": "しばらく見ないうちに、お喋り上手になったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "へへへっ、宝物の買い手を探すには、まず話し方から勉強しないといけなかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740310,
					"content": "#まずは{M#君}{F#あなた}を片付けてから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "ははは、よしてくれ。俺がお前の攻撃に耐えられるわけがないだろ。",
					"roleType": "TALK_ROLE_NPC",
