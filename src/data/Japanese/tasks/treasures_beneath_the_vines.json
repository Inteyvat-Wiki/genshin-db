					"ウルマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "ちびっこ、お前が俺を連れて来たんだろ？ほら、動けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740102,
					"content": "はぁ、もういい。お前はそこでじっとしてろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "はぁ、今回もまたちびっこにやられた…最初から話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740107,
					"content": "信じられないかもしれないが、俺は不思議と仙霊を引き付けやすい体質みたいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740108,
					"content": "そして俺についてくる仙霊の中に、宝探しにハマっている仙霊がいることに気がついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740109,
					"content": "名前を付けるのは苦手だから、やつらのことは「宝探し仙霊」と呼んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740110,
					"content": "やつらは宝探しが得意なんだ。おかげで俺も結構な数の宝を見つけて、少しは儲けることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740111,
					"content": "だが、急に反応しなくなることもある。宝探しに疲れたのか、俺をつまらない奴だと思ったのか、理由はわからないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740112,
					"content": "そういう時は、仙霊が気に入る人間を探して協力してもらうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740113,
					"content": "そいつに「宝探し仙霊」を連れて宝物を探させて、俺は…見つかった宝を売って利益を出すって寸法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740114,
					"content": "スメールには至る所に遺跡があって、骨董品で溢れていると聞いたから、ここでも一儲けしようと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740115,
					"content": "スメールに来てみたら、案の定たくさんの仙霊たちが寄ってきて、その中にいた「宝探し仙霊」が俺をここまで連れてきてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740116,
					"content": "なのに、地面を掘り始めて少し経ったと思ったら、またちびっこが俺に反応しなくなってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740117,
					"content": "ん？どうして急に動き出したんだ？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740118,
					"content": "旅人、仙霊と一緒に宝探しをすることに興味はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740119,
					"content": "#{M#俺}{F#私}が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "話す必要はない。ただそいつに付いて行って、止まったら地面を掘ればいいんだ。簡単だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740122,
					"content": "どうだ、試してみないか？そうだな…もし本当に宝物が見つかったら、俺は「古鉄銭」だけ貰えればいい。他は全部お前のものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740123,
					"content": "それだけじゃない。お前が本当に「古鉄銭」を見つけることができたら、それに応じた報酬を支払う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740124,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "話が早いな！お前みたいな奴は好きだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740130,
					"content": "とにかく、俺たちは今から協力関係だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740131,
					"content": "このノートを持っていけ。これには、前に見つけて掘らずにおいた宝蔵地が書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740132,
					"content": "じゃあ頼んだぞ、旅人。もし「古鉄銭」を見つけたら、忘れずに持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740126,
					"content": "「古鉄銭」ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "端的に言えば、ある種の特別な骨董品だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740128,
					"content": "コネさえあれば、この「古鉄銭」を使っていいものをたくさん手に入れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740129,
					"content": "まあ…コネについては、まだ見当がついてないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 736740120,
					"content": "仙霊の言葉がわからない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "これは…仙霊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "このちびっこのことか？ああ…まあ、そんな感じだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "ウルマン"
				}
			]
		},
