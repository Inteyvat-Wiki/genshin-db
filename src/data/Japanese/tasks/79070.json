			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サボーン",
					"スーファシュ",
					"シメスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "ベルウインド王国を代表してあなた方を歓迎します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700102,
					"content": "これからどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "そうですね…まず、レリックが判断を下したことを王国全体に発表します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700104,
					"content": "守護者は…あの遠路はるばるいらしたフロベールさんだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700105,
					"content": "ええ！？なんでそんなことするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790700106,
					"content": "私たちが経験したことを皆に説明するのは、実際複雑すぎます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700107,
					"content": "それに、私がプリンセスであり、かつ守護者である理由は、皆すぐには理解できないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700108,
					"content": "適切な時機が来たら、すべてを詳細に記して、全国民に書面で伝えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700109,
					"content": "それまでは、私はやはりプリンセスとして王国の様々なことを取り仕切らねばなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700110,
					"content": "あの「試練の場」を正式に「鍛錬の場」に作り替えたら、私は旅立ちます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700111,
					"content": "旅立つ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "プリンセス…洞窟にいた時、レリックは誰のために光ったか、覚えていらっしゃいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700114,
					"content": "え？誰のために光ったか…ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700115,
					"content": "そうです。あのとき俺たちはみなレリックのそばにいました。プリンセスはもちろん認められるに値しますが、お、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700116,
					"content": "#{M#君}{F#あなた}はあのチャンピオンに認められた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "そうだぞ。チャンピオンのシブレロがわざわざおまえに頼みに来たんだ。十分認められてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790700118,
					"content": "プリンセスの光が眩しすぎるあまり、みんな勘違いしているんだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700119,
					"content": "ふふっ…ではチャンピオンさん、もう一度試練を受けてみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700120,
					"content": "このベルウインド王国のプリンセス·シメスト自ら、レリックを用いてあなたの証人となりましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700121,
					"content": "良いのですか！ぜひ受けたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700122,
					"content": "そう興奮しないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "へへっ、プリンセスが言うとこんな張り切るんだな、フロベールって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790700125,
					"content": "誤解しないでくれ！これも雨歌の池の使命のためだ！これほどの訓練を積むのは、プリンセスを救うためであり…その、守るためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700126,
					"content": "こんなにも重要な任務なんだから、万全を期さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700127,
					"content": "プリンセスに同行したいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "そ、そうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700129,
					"content": "ふふっ、それなら良かった。ではチャンピオンさんことフロベール、私の試練を受ける準備はよろしいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700130,
					"content": "はい、プリンセス！いつでも結構です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700131,
					"content": "わっ、レリックがまた光り出したぞ！ま、眩しい…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790700123,
					"content": "み、耳がキーンとした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フロベール",
					"ホレロウ",
					"エスタンプ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "エスタンプ！今までどこへ行っていたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700202,
					"content": "ああ、周りを確認して、試練に挑戦してたんだ。なかなか面白いよ。ただ他の方法で突破しなきゃならないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "エスタンプ"
				},
				{
					"id": 790700203,
					"content": "あなた方のことはホレロウさんから聞いたよ。すごいな「守護者殿」、かなりの実力者なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "エスタンプ"
				},
				{
					"id": 790700204,
					"content": "き、き、君…君が近くにいたら！絶対に君を推薦したのに！十回あれば、十回とも推したのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700205,
					"content": "だからこそ試練に行ったんだよ。わが友フロベール。あなたならやれると信じていた。ほら、実際やれただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "エスタンプ"
				},
				{
					"id": 790700206,
					"content": "アッハハハ、二人とも実に好い。今日は我々雨歌の池にとってめでたい日です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700207,
					"content": "ついに真のチャンピオンが誕生しました。フロベールにはまだプリンセスを救う機会が訪れていませんが、必ずや腕を見せる場面があると信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700208,
					"content": "いやいや！俺は何もしていないんだ、ホレロウさん。ただそばで見ていただけで、何もかもプリンセスがやってくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700209,
					"content": "それなら、なおのこと良いではないですか。プリンセスが危険にさらされるところを見たかったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700210,
					"content": "そ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700211,
					"content": "やれやれ、いいですか、フロベールさん。君はあのシブレロから直々に託されたのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700212,
					"content": "どうだか！あれが本当にシブレロだったかも分からないのに！俺は彼の噂を知っているだけで、実際の声なんて聞いたこともないんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700213,
					"content": "それに、あなたはあのプリンセスの試練を受けた。さすがはチャンピオンだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "エスタンプ"
				},
				{
					"id": 790700214,
					"content": "もうこの話はやめにしないか？頼むから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "フロベール"
				},
				{
					"id": 790700215,
					"content": "とにかく、我ら雨歌の池の未来は、君に託しましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700216,
					"content": "これでやっと、何のプレッシャーもなくジャンプができるようになりました。帰って組織委員会に提案してみましょう。ジャンプコンテストに、もっと面白い内容を加えてみないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "ホレロウ"
				},
				{
					"id": 790700217,
					"content": "それはいい考えだね。僕は司会をやりたい。さ、今すぐ帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "エスタンプ"
				},
				{
					"id": 790700218,
					"content": "俺をここに放置してかないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フロベール"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シメスト",
					"サボーン",
					"スーファシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "プリンセスもそちらの紙カエル殿も、認められて守護者となったですと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "サボーン"
				},
				{
					"id": 790700302,
					"content": "そんな奇妙な話、聞いたこともありません！過去の記録もありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "スーファシュ"
				},
				{
					"id": 790700303,
					"content": "しかも試練を作り替えるなんて…ダメです！いけません！プリンセス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "サボーン"
				},
				{
					"id": 790700304,
					"content": "古より受け継がれてきたものを勝手に作り替えてはなりませんよ、プリンセス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "スーファシュ"
				},
				{
					"id": 790700305,
					"content": "はいはい、もう少し声を押さえてください。耳がキンキンしてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700306,
					"content": "もう決めたことです。今の私はプリンセスであると同時に、レリックに認められた守護者。あなたたちではなおのこと止められません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700307,
					"content": "しかし、プリンセス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "サボーン"
				},
				{
					"id": 790700308,
					"content": "安心なさい。私は鍛錬の儀式を取り仕切り、頼れるモモンガをたくさん訓練して王国を守ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700309,
					"content": "そしてその後、私は王国を出るつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "シメスト"
				},
				{
					"id": 790700310,
					"content": "殿下、私たちは…はぁ、あなたというお方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "スーファシュ"
				},
				{
					"id": 790700311,
