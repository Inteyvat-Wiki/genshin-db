			"dialogs": [
				{
					"id": 705400101,
					"content": "シャーッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705400102,
					"content": "うぅ…ロサリアさん、この子すごく怒ってるみたいです…わ、私怖いです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705400103,
					"content": "君は下がってなさい。顔を引っかかれて真っ赤な血しぶきを咲かせたくはないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400104,
					"content": "どうしたんだ？ヴァレリナ、猫にいじめられてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705400105,
					"content": "もしかして野良猫が勝手に浸入してきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "栄誉騎士さん、ネコネコ白魔法使いさん！雪大福をお散歩させてたら、このでっかい猫ちゃんに目をつけられて…一緒に入ってきちゃったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705400108,
					"content": "落ち着いて。ここじゃ誰も君を傷つけたりしないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400109,
					"content": "凶悪なものも、君に悪いことを強いるやつらも、みんな塀の外よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400110,
					"content": "ここでなら、君は優しい人たちに囲まれていられるわよ。鬱陶しく感じることもあるかもしれないけど、みんな君のことを思うからこそうるさくするの。だから、肩の力を抜いてゆったり過ごしてみるのも悪くないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400111,
					"content": "フー…——にゃあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705400112,
					"content": "も、もしかして、本当に伝わった…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705400113,
					"content": "上手くいったみたい。頭のいい猫ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400114,
					"content": "こいつ、他の猫と比べるとホントにでっかいな。バブルオレンジのジュースみたいな色だぜ。ん？スカーフをしてるぞ。騎士団のマークがついてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705400115,
					"content": "そうだ！こいつのことは「橙色{RUBY#[D]おれんじきし}騎士」って呼ぼうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705400116,
					"content": "にゃおーん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705400117,
					"content": "警戒を解いてくれたみたい。君の方法は効果抜群ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400118,
					"content": "でも、橙色騎士が落ち着きを取り戻したのはロサリアに声をかけられた直後だぞ。つまり、今回はロサリアのお手柄だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705400119,
					"content": "ロサリアも猫と仲良くなれた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "別にどうでもいいけど…まっ、こんなに可愛い面倒事なら、多くても困らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705400122,
					"content": "橙色騎士がなんで怒ってたのかわからないけど、「魔法」の力で、もっとこいつの機嫌をよくしてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705400120,
					"content": "ロサリアの「特別業務」、楽しくなりそうだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "「誇り高き猫の騎士」って感じにも見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}