			},
			"dialogs": [
				{
					"id": 401120301,
					"content": "び、びっくりした…変なところに転送されちゃうんじゃないかと思ってびびったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120302,
					"content": "えへへ、ごめんね。わざとじゃないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120303
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120303,
					"content": "そりゃわかってるけど。でも、「不思議な招待状」が本当に機能するなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120304,
					"content": "面白い——本当に一瞬でスメールに到着したのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120305
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120305,
					"content": "ここがママのお友達が住んでるところなんだね。大きなお花がたくさんある…それから、ぴょんぴょん跳ねるキノコも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120306
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120306,
					"content": "スメールにはまだまだ不思議なものが沢山あるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120307,
					"content": "例えば、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120308,
						401120310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120308,
					"content": "背中にキノコが生えたイノシシ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120309
					]
				},
				{
					"id": 401120309,
					"content": "そうそう。初めて見たときは、オイラもびっくりしたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120312,
					"content": "クレー、この跳ねるキノコはキノコンっていうんだ。見た目は可愛いが、不用意に近づいたらわざと帽子をぶつけてくるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120313
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120313,
					"content": "本当？じゃあクレーも帽子をぶつけ返す！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120314
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120314,
					"content": "クレーは頭の帽子とは別に、パーカーにも帽子がついてるからきっと勝てるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120315
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120315,
					"content": "やるね、クレー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120316
					]
				},
				{
					"id": 401120316,
					"content": "少なくとも、爆弾よりは帽子のほうがだいぶマシか…まあ、オイラたちは仲良しだから、きっとクレーが爆弾を使わないように止められるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120317,
					"content": "うん！爆弾で周りのものを爆発させないよう、気を付ける！えっと…できるだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120318
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120318,
					"content": "本当か？いい子じゃないか。クレーも大人になったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120319,
					"content": "うん！クレーはお利口さんの火花騎士だもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120320
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120320,
					"content": "じゃあ、お利口さんの火花騎士さん。さっそくティナリっていう友達に会いに、ガンダルヴァー村へ行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120310,
					"content": "銀色の空飛ぶフライム。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120311
					]
				},
				{
					"id": 401120311,
					"content": "えっ、そんなのあったか…っておい！まさかオイラのことじゃないだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "パイモン"
				}
			]
		},
