					"nextDialogs": [
						401120260
					]
				},
				{
					"id": 401120260,
					"content": "うん、ティナリにも手伝ってもらえるかもだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120261
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120261,
					"content": "よし、じゃあまずはガンダルヴァー村へ行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120262
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120262,
					"content": "#うん、クレーはどこへ行くのでも楽しいよ！それに、クレーはガイアお兄ちゃんと栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}たちを信じてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120263
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120263,
					"content": "それじゃ、代理団長、行ってくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120264
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120264,
					"content": "風の導くままに。君たちの旅がうまく行くよう、祈っている。それから、クレー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120265
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120265,
					"content": "わかってるって。クレー、気を付けるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120266
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120266,
					"content": "よ～し、出発だ！目指すは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120267,
					"content": "ガンダルヴァー村！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120268
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120268,
					"content": "ガンダルヴァー村。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120269
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120269,
					"content": "ガンダルヴァー村。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120270
					]
				},
				{
					"id": 401120270,
					"content": "がんばるだあ村——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120271
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120271,
					"content": "ええっ、今なに村？っておい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120239,
					"content": "喜んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120211,
					"content": "パイモン、案内はここまで。じゃあお先に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120212
					]
				},
				{
					"id": 401120212,
					"content": "おまえに案内してもらう必要がどこにあるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "パイモン"
				}
