			"dialogs": [
				{
					"id": 401120501,
					"content": "そういう服装のやつのことなら、確かに他のレンジャーから聞いたことがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120502
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120502,
					"content": "そう…やっぱり私の推測は間違っていなかったみたいね…あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120503
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120503,
					"content": "旅人、パイモン、ガイアさんと…それにクレーまで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120504
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120504,
					"content": "コレイのお姉ちゃん、久しぶり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120505
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120505,
					"content": "コレイにエウルア！おまえたち、なんでここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120506,
					"content": "特にエウルアに聞きたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120507,
					"content": "遠出してきたら、バカンス中の遊撃小隊隊長にばったり会うとは、奇遇だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120508
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120508,
					"content": "…どうしてみんなが来るの？ふんっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120509
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120509,
					"content": "いま、困った顔しなかったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120510,
						401120511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120510,
					"content": "まあまあ、細かいことは気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				},
				{
					"id": 401120512,
					"content": "うんうん、そうだな！行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120513
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120513,
					"content": "私に気を遣ってそこまでしてくれる必要はないわ。勘違いしないで、気まずくなんか感じてないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120514
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120514,
					"content": "だったらいいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120515
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120515,
					"content": "それならよかったぜ。はるばるスメールまで来たからには、きっと興味深い理由があるんだろう？早く俺たちにも教えてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120516
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120516,
					"content": "（見物を楽しむ気満々の顔…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120517
					]
				},
				{
					"id": 401120517,
					"content": "ちょっと複雑な話になるけど…簡単に言うと、私は従兄弟を探しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120518
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120518,
					"content": "少し前、彼は突然失踪してしまった。彼の家の調査結果から見るに、彼はローレンス家を再興する方法を探しにスメールまで来たらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120519
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120519,
					"content": "はるばる別の国まで方法を探しに？まさかスメールで勉強でもするつもりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120520,
					"content": "何だかちょっと遠回りすぎるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120521
					]
				},
				{
					"id": 401120521,
					"content": "それはないと思うわ…彼はもう基礎教育を受ける歳をとうに過ぎているもの。もう一段階上の勉学となると…あくまで私の彼に対する印象だけど、その気はないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120522
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120522,
					"content": "彼は家族の名誉を何よりも大事に思っている。再興という考え方は間違ってるとは言えないけど…どこまでそれに執着しているのか、トラブルに発展しないかどうかまでは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120523
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120523,
					"content": "どちらにせよ、放っておけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120524
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120524,
					"content": "それが事実なんだったら、お前のその従兄弟ってローレンス家の大した行動派だよな。モンドからスメールまでの道のりってけっこう大変なんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120525
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120525,
					"content": "ふん。その上、私に身の安全まで心配させるなんて…いい度胸をしてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120526
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120526,
					"content": "へへっ、エウルアって優しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120527,
					"content": "そうだよ！エウルアお姉ちゃんはこの前、クレーにムーンパイをごちそうしてくれたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120528
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120528,
					"content": "コホン！彼は同じ一族の者だもの…とにかくどうにか見つけて、身の安全を確保したうえで連れて帰るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120529,
						401120530
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120529,
					"content": "苦労するね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120531,
					"content": "君たちは？どうして急にここに現れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120532
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120532,
					"content": "エウルアとコレイにスメールまで来た目的を伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120533
					]
				},
				{
					"id": 401120533,
					"content": "そうだったのか、困ったな…ティナリ師匠は最近、パルディスディアイで講座をやってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120534
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120534,
					"content": "でも、あたしで良ければちょっとは手伝えるかも。この招待状にざっくり書いてある位置だと、砂漠の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120535
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120535,
					"content": "砂漠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120536
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120536,
					"content": "あれ？ママのお友達って、砂漠に住んでるの？えっと…じゃあ、砂漠のおばちゃん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120537
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120537,
					"content": "セノ様から聞いたことがあるんだけど、その砂漠のエリアでは妙な伝説が語り継がれてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120538
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120538,
					"content": "すべての願いを叶えてくれる秘境が存在するんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120539
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120539,
					"content": "あっ…セノさんだったな！さん付けでいいって言われたんだった。慣れていかないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120540
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120540,
					"content": "すべての願いを叶えてくれる秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120541
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120541,
					"content": "本当なのかよ？そんなところが実際に存在するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120542
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120542,
					"content": "数年前のあたしだったら信じちゃってただろうけど、今は色々経験したから…正直本当かどうかは怪しいと思ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120543
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120543,
					"content": "なるほど…伝説が本当だとは限らないけど、彼はもしかするとそこへ運試しに行ったのかもしれないわね。君たちがそのエリアに行くなら、私も一緒に行くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120544
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120544,
					"content": "従兄弟の本棚にはスメールの砂漠に関する伝説が沢山置いてあったの。その線から考えると…彼もその秘境を目指した可能性が高いわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120545
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120545,
					"content": "あたしも一緒に行っていいかな？や、役に立てると思うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120546
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120546,
					"content": "スメールにいる限りはガイドが必要だろうし、あたしならピッタリだと思うよ！レンジャーなら、勇気を出して助けの手を差し伸べるべきだと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120547
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120547,
					"content": "コレイの能力なら安心できる。これでまた更に強いチームになったな。クレー隊長はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120548
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120548,
					"content": "クレーもすーーっごくいいと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120549
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120549,
					"content": "「一人の喜びは小さなものだけど、みんなの喜びを集めれば大きなものになる」って、物語の本に書いてあったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120550
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120550,
					"content": "こんなにたくさんのお兄ちゃんやお姉ちゃんたちと一緒にいるクレーを見たら、ママのお友達もきっと喜んでくれると思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120551
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120551,
					"content": "その通りだな！それじゃさっそく、「不思議な招待状」をもう一回使おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120552,
					"content": "クレーが「不思議な招待状」を出すと、みんなはそこに書いてある目的地を読み上げた——",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401120530,
					"content": "大変だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120511,
					"content": "みんなでティータイムでも楽しもう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				}
			]
		},
