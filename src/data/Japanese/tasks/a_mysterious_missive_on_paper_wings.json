			"dialogs": [
				{
					"id": 401120701,
					"content": "ねえ見て！ここに広ーい綺麗なお庭があるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120702
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120702,
					"content": "不思議ね…あんなに小さな瓶だったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120703
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120703,
					"content": "みんな、ここで少し休憩をとりがてら現状を分析して、これからどうするかを決めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120704
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120704,
					"content": "そういえば…「魔瓶」の物語を知ってるヤツはいるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120705
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120705,
					"content": "あっ、キングデシェレトと瓶にいるジンニーの話か？全部の単語がわかったわけじゃないけど、読んだことあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120706
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120706,
					"content": "ガイアお兄ちゃん、それってどんな物語なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120707
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120707,
					"content": "昔ね、冒険隊が瓶の国で冒険するってお話をママから聞いたことがあるの…でも、それは魔瓶って名前じゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120708
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120708,
					"content": "ああ…ゆっくりクレーに教えてあげてもいいぞ。だが、クレーが一人でどんどん先に進んでしまったら、半分しか聞けないかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120709
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120709,
					"content": "うぅ…わかった。クレーもちゃんと、みんなと一緒に歩くよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120710
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120710,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120711
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120711,
					"content": "コレイ、君も何となく違和感を覚えてるんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120712
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120712,
					"content": "うん…ここは眺めがいいけど、やけに静かだ。それに、クレーのお母さんの友達だって人も出てこないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120713
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120713,
					"content": "砂漠のおばちゃんは奥に住んでるのかな？きっとフィッシュルお姉ちゃんの幽夜浄土みたいに、お部屋がすっごく広いのかも。もしかして、今クレーたちがいる場所はまだ一番端っこだったりして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120714
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120714,
					"content": "仕方ない、とにかく奥へ進んでみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120715,
					"content": "この先で、会えるかもしれないしな。",
