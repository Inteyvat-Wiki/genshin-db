			"dialogs": [
				{
					"id": 401120201,
					"content": "ジン団長、来たぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120202,
					"content": "二人とも、待っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120203
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120203,
					"content": "うわっ、思ってたより人がいるな…クレーにガイアまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120204,
					"content": "#パイモンちゃんと栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}だったんだ！久しぶりだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120205
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120205,
					"content": "ほう、お前らだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120206
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120206,
					"content": "参ったな…何と言うか、お前らはいつも予想外のサプライズを持ってきてくれるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120207
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120207,
					"content": "へへっ、仲良しの友達に会えるって思うと楽しみで、ノックしそびれちゃったぜ。びっくりさせたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120208,
					"content": "あっ、おまえたち、まさか聞かれたらまずい秘密の話とかをしてたわけじゃないよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120209,
						401120211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120209,
					"content": "あれ、鹿狩り頼んでない？間違えちゃった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120210
					]
				},
				{
					"id": 401120210,
					"content": "ずるいぞ、いきなり鹿狩りの配達員になりきるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120213,
					"content": "本当に久しぶりだ。パイモンと旅人は相変わらず仲がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120214
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120214,
					"content": "心配するな、機密の話をしていたわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120215
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120215,
					"content": "むしろ、ちょうど君たちの話をしていたところだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120216
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120216,
					"content": "そうだな——この件の主役に話してもらおうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120217
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120217,
					"content": "うん、クレーが話すね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120218
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120218,
					"content": "何日か前ね、クレーは反省室で『ドドコの物語』を読んでたんだけど…そしたら、窓の外から手紙が一通飛んできたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120219
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120219,
					"content": "手紙？手紙がどうやって飛ぶんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120220,
					"content": "小鳥みたいに、羽をパタパタさせて飛んできたんだよ。おしゃべりもできたんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120221
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120221,
					"content": "それでね…えっと、よくわからないお話しをしてたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120222
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120222,
					"content": "よくわからない話？反省室がどうのこうのって話みたいにか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120223
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120223,
					"content": "こら、ガイア…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120224
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120224,
					"content": "おっと、教育的指導は大事だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120225
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120225,
					"content": "うぅ…わかった、ちゃんと話すね。手紙はこう始まったの——「クレー、なんでまた反省室にいるの…」って…ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120226
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120226,
					"content": "それから、「ママは最近忙しくて、なかなか遊びに連れて行ってあげられないけど、ママのお友達がね、クレーをぜひおうちに招待したいんだって！」って書いてあったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120227
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120227,
					"content": "ああ、アリスからだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120228,
					"content": "いいじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120229
					]
				},
				{
					"id": 401120229,
					"content": "それが、一応危険はないはずなんだが…少し遠い場所にあって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120230
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120230,
					"content": "うん、ママのお友達のおうちは、スメールにあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120231
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120231,
					"content": "もちろん、騎士団はクレーを一人でスメールまで行かせられやしない。でもその友人を訪ねたいっていうクレーの意志もなかなか固くてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120232
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120232,
					"content": "絶対行くよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120233
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120233,
					"content": "そこで、一緒に遠出してくれる人がいないか、考えてたってわけだ。もし頼りになる英雄が…それもモンドを救ったことがあるような英雄がついて行ってくれれば——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120234
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120234,
					"content": "なるほどな！それでオイラたちを呼んだってわけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120235,
					"content": "すまない。でもクレーは君と仲がいいし…一番適切な人選なんじゃないかと、私たちは考えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120236
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120236,
					"content": "うんうん、いいぞ。この依頼、受けてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120237,
					"content": "#へへっ、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}…いい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120238,
						401120239
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120238,
					"content": "もちろん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120240,
					"content": "#やった！！栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}がいてくれるんだったら、どこへ行ったって怖くないよ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120241
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120241,
					"content": "ほらな、応じてくれるって言っただろ？それじゃ後はみんな、頼りになる旅人に任せて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120242
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120242,
					"content": "ガイア…君も一緒に行ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120243
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120243,
					"content": "この間から貯めていた書類は、もうこっそり終わらせたんだろう？…君もこの機会に、ゆっくり羽根を伸ばしてくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120244
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401120244,
					"content": "やれやれ、バレてたか。なら断る理由もなくなっちまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120245
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120245,
					"content": "ガイアがいてくれるなら、トラブルに遭っても安心だよな！でもスメールって、またまた遠いな…いっぱい歩かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120246,
					"content": "大丈夫。ママの手紙には「不思議な招待状」もついてたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120247
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120247,
					"content": "大声で行きたい場所をみんなで一緒に叫んだら、またたく間にびゅーんって飛んで行けるって、手紙には書いてあったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120248
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120248,
					"content": "わあ、そんなに便利な道具があるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120249,
					"content": "でもチャンスは三回しかないから、むやみに使っちゃダメなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120250
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120250,
					"content": "なんだよ、行き帰りの二回を抜いたって、まだ一回余ってるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120251,
					"content": "そんな不思議なもの、なおさら大切に使うべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120252
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120252,
					"content": "何しろ今は目的地も分からないんだ。向こうについたら、別の危険があるってことも考えられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120253
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120253,
					"content": "一つ俺に考えがある。旅人、お前の人脈なら、スメールの地理にも詳しい現地の友人がいるだろう？その人の傍に飛ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120254
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120254,
					"content": "そしたら「不思議な招待状」の機能も試せるし、その人に案内してもらうことだってできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120255
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120255,
					"content": "確かに一理あるな。どうせ一回余ってるわけだし、ちょうどいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120256,
					"content": "それで…賢いパイモンは、誰か思いつくか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120257
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120257,
					"content": "へへ…そうだな、スメールに詳しくてガイドもできるやつってなると…レンジャーが良さそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120258,
					"content": "で、レンジャーが普段よくいる場所は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120259
