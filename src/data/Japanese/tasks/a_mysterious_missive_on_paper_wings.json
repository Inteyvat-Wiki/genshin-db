			"dialogs": [
				{
					"id": 401120601,
					"content": "わあ、広い砂漠——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120602
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120602,
					"content": "実際にこの目で見るとすごいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120603
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120603,
					"content": "確かに、壮観だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120604
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120604,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120605
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120605,
					"content": "どうした。具合でも悪いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120606
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120606,
					"content": "いえ、ただちょっと慣れるのに時間がかかっただけ。ここの空気はモンドと比べて…少し乾燥しているから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120607
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120607,
					"content": "ここは人が住めるような環境には見えないわ。本当に秘境があるとしても…この辺りには、入口も見当たらないようだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120608
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120608,
					"content": "まさかさっき、あ、あたしが読み間違えちゃって…そのせいで…？そんなことないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120609
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120609,
					"content": "違うよ！絶対コレイお姉ちゃんのせいなんかじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120610
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120610,
					"content": "一回目のときはクレーも読み間違えたけど、それでもちゃんとガンダルヴァー村に着いたもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120611
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120611,
					"content": "これまでの経験からすると、目的地は間違ってないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120612
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120612,
					"content": "ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120613
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120613,
					"content": "砂丘の下に、入口が埋もれたりしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120614,
					"content": "…仕方ない、探してみるしかないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120615
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120615,
					"content": "手分けして探してみたが、しばらく探してもやはり手がかりは見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120616
					]
				},
				{
					"id": 401120616,
					"content": "疲れたぞ…喉も渇いたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120617,
					"content": "おかしいな。「不思議な招待状」に何か問題でも起こったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120618
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120618,
					"content": "あれ？そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120619
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120619,
					"content": "まさか、クレーが壊したんじゃないよね？でも、クレー何もしてないんだけどな…ドドコが証人になってくれるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120620
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120620,
					"content": "きっとクレーのせいじゃないと思うよ。だってほら、この紙、シワもついてないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120621
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120621,
					"content": "もしその秘境が近くにあるなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120622
					]
				},
				{
					"id": 401120622,
					"content": "#ん？栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、なにかいい方法を思いついた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120623
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120623,
					"content": "こっちから秘境を探すより…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120624
					]
				},
				{
					"id": 401120624,
					"content": "あっ、オイラわかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120625,
					"content": "うん、秘境のほうに案内してもらおう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120626
					]
				},
				{
					"id": 401120626,
					"content": "ほう、なかなか面白い考え方だな。「不思議な招待状」もここにあることだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120627
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120627,
					"content": "招待状を出した秘境も、必然的にこれと関係があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120628
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120628,
					"content": "あーっ、クレーわかった！クレー、とっておきの技があるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120629
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120629,
					"content": "へえ、どんな技？私たちも覚えられるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120630
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120630,
					"content": "うん！ママが言ってたの…助けが必要なときはこうして大声で叫んでって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120631
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120631,
					"content": "「不思議な招待状」さん、「不思議な招待状」さん…クレーは助けが必要なの！なんとかして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120632
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401120632,
					"content": "おい見ろ！本当になにか飛んできたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120633,
					"content": "え？あれは…瓶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120634
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120634,
					"content": "どうやら効果があったみたいだな。俺もその技を覚えておくとしよう。お前もどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120635
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401120635,
					"content": "結構よ！私には向いてないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120636
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401120636,
					"content": "瓶って言うと、スメールの伝説にはおなじみのアイテムだよな…まさかこれが秘境の入り口なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120637
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401120637,
					"content": "瓶の中にある秘境か…璃月ならありそうだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120638,
					"content": "本当にそうなんだったら、入る方法は一つしかないよな！ほら、手を出せよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401120639,
					"content": "（瓶に触れる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
