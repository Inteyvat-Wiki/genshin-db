					"チャールズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "ほう、覚えが早いな。それに味も悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020302,
					"content": "うんうん、オイラも美味しいと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020303,
					"content": "ただ、今のはあくまで練習だ。実際はお客さんの注文に応えて作る必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020304,
					"content": "もっと味を濃くしてほしいと言われたり、もっと酸っぱくしてほしいと言われたりな。そういった時は、その注文に応じて材料を加えるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020305,
					"content": "じゃ、オイラは甘めのマツカサキャラメルをくれ！一番大きいカップで頼むぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020306,
					"content": "ああ、まさにこんな感じにな。それと、優秀なバーテンダーは飲み物を作るだけでなく、お客さんと会話するスキルも身につけなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020307,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "そうか。なら、このカウンターは君たちに任せよう。何か問題があったら、いつでも俺を呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020310,
					"content": "ふぅ…これで一通り終わったみたいだな！いや、待った…オイラのマツカサキャラメルがまだ出来てないぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020311,
					"content": "本当に注文してたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "会話なら得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
