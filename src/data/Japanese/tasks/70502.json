			"trigger": {
				"objectNames": [
					"ルカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "こんにちは。君があの名高い旅人さんですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020102,
					"content": "そうだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "おい、オイラもいるぞ。オイラがあの名高いパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020105,
					"content": "実は最近、「エンジェルズシェア」で「バーテンダー体験ウィーク」というものを開催していまして。君も興味を持つんじゃないかと思い、探していたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020106,
					"content": "簡単に説明しますと、この体験では自分で好きなお酒を作ることができるんです。もちろん、お酒以外の飲み物も作れます。使用する材料も自由に選んでいただいて構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020107,
					"content": "また、無駄にしない限り、出来上がった品は飲み放題となっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020108,
					"content": "飲み放題っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020109,
					"content": "お客さんたちを満足させる品ができましたら、それに見合った報酬もお出しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020110,
					"content": "おおっ、報酬まであるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020111,
					"content": "パイモンが完全に落ちた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "よし、オイラたちも参加しようぜ！いいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020113,
					"content": "「バーテンダー体験ウィーク」とはいえ、出勤日数などの制約はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020114,
					"content": "もちろん、すぐにお返事していただかなくても大丈夫です。一回だけお試しで、というのも可能ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020115,
					"content": "どうです、体験してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705020103,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
