				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"チャールズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "ああ、君たちか。今日は何を飲みに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020202,
					"content": "こんにちは、チャールズ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "チャールズ、オイラたちバーテンダーをやりに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020204,
					"content": "バーテンダーを…なるほど、ルカが君たちに声をかけたんだな。そいつは運がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020205,
					"content": "君の実力は俺も知ってる。だが、バーテンダーという仕事には技術が必要だ。決して簡単なものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020206,
					"content": "材料の割合、混ぜ方…それらすべてが完成品の質に影響してくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020207,
					"content": "おう、それなら大丈夫！こいつが作る料理はすっごく美味しいんだ。「美味しいものを作る」って点なら理解してるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705020208,
					"content": "それならいい。それともう一つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020209,
					"content": "実は前に、ある研修生がやらかしたことがあってな。そいつが自分の好きなように度数の高い酒を三つブレンドしたところ、たった一杯でお客さんを酔い潰してしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020210,
					"content": "それ以来、新入りにはアルコールを含む材料の提供を控えてる。アルコールを出すことはできないから、それだけは覚えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 705020211,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "さて、注意すべき点はこれで全部だ。作り方と必要な技術については、実際に作りながら教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャールズ"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
