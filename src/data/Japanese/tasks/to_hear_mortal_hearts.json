						"rawParams": [
							"1201805",
							"2"
						],
						"stepId": 1201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条鎌治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "将軍様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180507,
					"content": "将軍様がどうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180508,
					"content": "今の状況を私に話してください、鷹司家の跡取り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180509,
					"content": "私たちはただ、近ごろ天領奉行で起きた事について話し合いをしていただけです。将軍様がお気になさる必要はございません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180510,
					"content": "そのためだけに、このような人里離れた場所で、浪人と海乱鬼を見張りに置いていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180511,
					"content": "それは近頃の混乱のせいで、安全面の問題を考慮し…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180512,
					"content": "黙りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180513,
					"content": "九条家の子息、説明を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180514,
					"content": "はい。元々交渉が目的で来たのですが、彼らが欲したのは九条家が罪を認めることを記した書面でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180515,
					"content": "罪を認める？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180516,
					"content": "はい、九条家が目狩り令で犯した諸々の罪や、近ごろ起きた様々な失態など…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180517,
					"content": "事実を述べているだけで、決して捏造ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180518,
					"content": "確かに捏造ではないでしょう。しかし、その中には鷹司家の功績が多々記されてありました。鷹司家は危機に陥っても混乱することなく、必死に形勢を変えようとしたと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180519,
					"content": "しかし、それらはすべて身も蓋もないことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180520,
					"content": "何を言う。き、貴様…急に態度を変えおって、話が違う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180521,
					"content": "事実を述べたまで。判断は将軍様が下してくれるでしょう。鷹司家は、自らの印象を良くしようと操作し、九条家に取って代わろうとしているだけに過ぎません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180522,
					"content": "そうでなければ、どうしてさきの書面にありもしない功績を強調して書いたのでしょう。そして、このように軟禁する形で僕に署名を強制させるのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180523,
					"content": "何を言ってる！誰が貴様なんかを軟禁していると言うんだ！これは交渉だ！これじゃさっきとまったく話が違うじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180524,
					"content": "状況は概ね理解しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180525,
					"content": "この若造の戯言に耳を傾けないでください。将軍様も知っての通り、九条家は以前大きな過ちを犯しました。彼らの話は一言も信じてはなりません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180526,
					"content": "ふん、あなたたちの論争に興味はありません。しかし鷹司家の跡取り、あなたは天領奉行の地位を得たいと思っている、間違いないですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180527,
					"content": "えっと、それは…はい、将軍様のためにすべてを捧げる、これは天領奉行衆にいるすべての者が永遠に追い求めることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180528,
					"content": "そうであれば、わざわざこんなことをする必要はありません。天領奉行を任命するのは私です。決闘で私に勝った者に、新たな天領奉行の座を与えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180529,
					"content": "なっ…将軍様と決闘？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180530,
					"content": "初代天領奉行は、己が手に握った刀を用いて彼の意志を私に証明しました。それがあったからこそ、今の九条家まで受け継がれてきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180531,
					"content": "私に新たな名を認めさせようとするならば、当然、それ相応の試練を受ける必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180532,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180533,
					"content": "まさか、剣術の心得がないとでも？それとも、歳を取って自信を失くしているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180534,
					"content": "私のためと口にしておきながら、私の刀と相対するのが恐いと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180535,
					"content": "ぐっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180536,
					"content": "そうですか。ではあなたたちは？鷹司でもなんでも、私に勝てれば新たな天領奉行と認めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180537,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "鷹司家家臣"
				},
				{
					"id": 120180538,
					"content": "私の前に立つ勇気のある者は、一人もいないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180539,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180540,
					"content": "ぼ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180541,
					"content": "僕に挑戦させてください、将軍様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180542,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120180543,
					"content": "九条家の子息。残念ながら、あなたが私に勝っても、九条家の犯した過ちが帳消しになることはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180544,
					"content": "いえ、勝算があるとは思っていません。それに、当主があんな過ちを犯してしまったんです。九条家が天領奉行を受け継いでいくのも、終わって当然だと僕は思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180545,
					"content": "目狩り令を執行していた時、僕は父の考え方に疑問を抱いていました。自分のしていることが間違っていることも自覚していたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180546,
					"content": "しかし、どんなに疑いや反省を繰り返しても、たとえすべてを理解していても、行動には移せませんでした。ましてや誰かを救うこともしませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180547,
					"content": "今の九条家の没落は、そんな僕への罰なのでしょう。僕は何もできなかったんじゃなく、何もしなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180548,
					"content": "少々残酷ですが、あなたの力では、どちらにしても何もできませんでしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180549,
					"content": "はい、僕の力は微々たるものです。父は話を聞いてくれず、兄も僕を手伝えない、一平に叱られることもしばしばありました。ずっと、ずっとそうだったんです…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180550,
					"content": "しかし少なくとも今は、九条家が最後を迎えようとしている時である今は、僕が九条家の名代なんです！よって、父と同じ責務を果たします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180551,
					"content": "将軍様の言った通り、僕の祖先は刀で自身の意志を証明しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180552,
					"content": "では、僕にも、この九条鎌治にも、同じ形で終わらせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180553,
					"content": "これが僕に残された…「何かできる」最後の機会なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120180554,
					"content": "明らかに、意味のないことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180555,
					"content": "しかし、受け入れましょう。かかってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201807",
							"2"
						],
						"stepId": 1201807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "九条鎌治は傷を負いました。鷹司の跡取り、面倒を見てやってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180702,
					"content": "挑戦する勇気がなくとも、このような雑務はこなせるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180703,
					"content": "はっ、返す言葉もございません、誠に…申し訳ございません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180704,
					"content": "今の九条家では大局に耐えることはできないでしょう。このことは以前から聞いていました。元々天領奉行の後継者を探すのは確かに急を要すること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180705,
					"content": "しかしこの決闘を経て、九条家への処置はしばらく保留することにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180706,
					"content": "これから、鷹司家は以前と同じように、九条家に助力していってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180707,
					"content": "将軍様の仰せのままに、忠誠を誓います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180708,
					"content": "もしあなたたちがまだ、ファデュイのやり方に従い、誤った情報で私に間違った判断をさせようと考えていたら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180709,
					"content": "私は今日と同じように、再び出向くでしょう。その時は、私の刀に容赦はないことを肝に銘じておきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180710,
					"content": "はっ、感謝いたします、将軍様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180711,
					"content": "もう結構です。その他の調査は奥詰衆に任せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180712,
					"content": "あなたたちは私と共に来てください。静かな場所へ行き、話したいことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201810",
							"2"
						],
						"stepId": 1201810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "影が物事を処理する時、やっぱり将軍って感じがして、威厳たっぷりだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181002,
					"content": "そうですか？自分では結構、融通が利くようになったと思いますが、将軍であればきっと…容赦なく九条鎌治を斬っていたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181003,
					"content": "彼も運が良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "彼はあのようになる覚悟ができていました。あの目を見ればわかります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181006,
					"content": "九条家には栄光から衰退へと、確かに想像を絶するほど大きな変化が起きました。九条鎌治は優秀な後継者ではありませんでしたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181007,
					"content": "彼はそんな巨大な変化の中、私に変わらないものを見せてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181008,
					"content": "これはあなたたちのおかげでもあります。町の散歩、あなたたちがくれた写真、それらを見たからこそ、このことに気づけたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181009,
					"content": "これからの九条家はどうなるんだ？まだ天領奉行を引き続きやれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181010,
					"content": "それはやはり不可能でしょう。あの後継者に光るものがあるとはいえ、犯した過ちをかき消すことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181011,
					"content": "しかし…もう少し時間を与えましょう。何せ過ちを犯したのは彼らだけではないのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181012,
					"content": "将軍は間違いを犯さない、犯してはいけないもの。しかし「影」として、彼らにはお詫びの気持ちを伝えたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181013,
					"content": "これからの日々、考えるべきことがたくさんあるでしょう。しかし少なくとも今は、進むべき道を見つけられたような気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181014,
					"content": "じゃあ、影が稲妻を管理するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "それはやはり将軍に任せるでしょう。最も永遠を脅かすのは、時間がもたらす「摩耗」ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181016,
					"content": "将軍には自己保護の機能があると言いましたよね。それは私が時間と共に変化してしまうことを予測したからなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181017,
					"content": "ですがまとまった考えについては、どんなに困難でもやり遂げようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181018,
					"content": "んっ…ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181019,
					"content": "確かにこの一時は、記念しておく価値のあるものですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181020,
					"content": "そうだな、天領奉行のことも解決したし、城内の人も健康な将軍の姿が見れた、これで悪い噂とかも自然に消えるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181021,
					"content": "もし外を回るのが気に入ったのなら、またおまえを誘いに来るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181022,
					"content": "お土産とかを持って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "いいえ、結構です。これは私の生活の一部ではありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181025,
					"content": "それに、私に付き添いが必要みたいに言わないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181026,
					"content": "では、私は帰る準備をします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181027,
					"content": "静養はまだしばらく続きますが、あまり長くはならないでしょう。あまり重要でないことは、あなたたち人間に任せるとします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181028,
					"content": "おう、じゃあまた今度な！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181029,
					"content": "色々予想外のこともたくさん起きたけど、最後は結構順調にいったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181030,
					"content": "あとは、通行証を神子に返すだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181023,
					"content": "目新しい物とかを持って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "もしかしたら彼の予想通りかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
		{
			"id": 1201812,
			"completionStepIds": [
				1201812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201812",
