			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "神子、帰ったぞ。うまくいったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181202,
					"content": "ほう、ならば汝らの物語をしかと妾に話してもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181203,
					"content": "ふふっ、実に面白い。堂々たる将軍様が、田舎から来た素朴な娘のように城内で買い物をするとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181204,
					"content": "この目で見られなかったのが、誠に惜しまれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181205,
					"content": "そんなこと言えるのは神子くらいだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "いいんじゃ、あやつはそのようなこと気にせぬ、決してな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181208,
					"content": "じゃが、汝らの話によれば、あやつは「永遠」の在り方について少しだけ触れることができたようじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181209,
					"content": "それが一番重要な収穫じゃ。実を言うと、汝らに通行証を渡した時は、ここまでの進展があるとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181210,
					"content": "おう、もうすべてが止まることを強制することはないみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181211,
					"content": "良く言えば、神の独り善がりな思い。悪く言えば、「俗世の七執政」でさえ、より強大な存在を前にした時、成す術のないこともあるということじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181212,
					"content": "人の心のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "ふふ、自分で考えろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181215,
					"content": "とにかく、話を聞くと今回の旅は愉快なものであったみたいじゃな。影のそれほど堅苦しくない一面も見られたはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181216,
					"content": "今度またあやつに会いたい時は、妾に通行証を借りに来るといい。口では言わぬが、実は結構な寂しがり屋なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181217,
					"content": "えっ？でも付き添いはいらないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120181218,
					"content": "あやつは神じゃ。神に付き添いが必要なわけではなく、「付き添い」が贅沢すぎるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181219,
					"content": "じゃが汝は、この世界に属さぬ者。もしかすれば、それが最良の選択となるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181213,
					"content": "天理のこと？",
