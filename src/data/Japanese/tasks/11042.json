			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#どうだ？{NICKNAME}、なんか気分悪そうな表情だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420702,
					"content": "なんか…燃えてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "飲めるって言ったじゃないか！なんでこうなってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420705,
					"content": "ん？これはあらゆる可能性の中で最も正常な反応で、喜ばしい結果だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420706,
					"content": "この薬剤は元素力を体内に流し込むから、通常なら拒絶反応を引き起こすんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420707,
					"content": "内部の流れが順調なら、一時的な不快感に耐えればいい、他の影響はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420708,
					"content": "つまり、おまえは気分が悪くなるのを知った上でそれを飲んだのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420709,
					"content": "ハハッ、ボクが作った薬剤だから、ボクから試すのが筋だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420710,
					"content": "研究対象への思いやり…かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "もちろんさ、キミはボクの協力者、キミにリスクを背負わせるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420714,
					"content": "とにかく、結論から言うよ。元素力テストにおいては、キミはこの世界の者と同じ、特別なところはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420715,
					"content": "もっと特別かと思ってたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420716,
					"content": "特別よりも、普通の方がいいと思うけどね。「特別」は…全て望み通りというわけじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420717,
					"content": "なんか別の意味が含まれてる気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "普通のメリットは、周りはキミと同じ、キミを理解できる人が多くいること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420719,
					"content": "同じだから、互いを理解し思いやりや励まし、支え合うことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420720,
					"content": "病気になった時も、他人と同じだから診断しやすい。何かあっても、他人と同じだから経験談を聞くことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420721,
					"content": "でも「特別」な人は、そういう当たり前を体験できない。命の本質から違いがあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420722,
					"content": "たとえば…人類は爆炎樹や狂風のコアの生活を理解できないだろ。この説明で理解できるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420723,
					"content": "大体理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "とにかく、実験の結果はいいものだった。少なくともキミは安心してその元素力を使うことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420726,
					"content": "ティマイオス、新たな実験結果が出たよ。まとめてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420727,
					"content": "はい！任せてください、先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420728,
					"content": "さっき先生からヒントをもらって、僕の考えの狭さを改めて思い知りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420729,
					"content": "君を「動物」だと決め付けるのは慎重な判断ではなかった。でも君を「元素生物」だと検証することから始めれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420730,
					"content": "ふむ、面白い考えだ。細かなところはボクが判断するより、キミ自身で研究した方がよさそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420731,
					"content": "はい、必ずみんなを満足させる結果を出してみせます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420732,
					"content": "落ち込むどころか、やる気に満ち溢れてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420733,
					"content": "真面目だと言うべきか、それともアルベドの口がうまいと言うべきか。はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420734,
					"content": "では、次の研究に入る前に、準備があるから少し待っててほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420735,
					"content": "興味があるなら、ここを見学してみるといい、時間を潰せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420724,
					"content": "それでも…別の意味がある気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "危険だと思わないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "学者としての自負がボクにはある、それに不要なトラブルの多くを省けるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420703,
					"content": "飲めたものじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
