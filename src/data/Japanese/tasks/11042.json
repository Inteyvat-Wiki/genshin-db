			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "そういえば、その種が芽を出した後、なにになるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420102,
					"content": "分からない。でも大事なのは結果ではなく、過程だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420103,
					"content": "錬金術を使って、テイワットに「この世のものではない命」を目覚めさせることができれば、命の本質に対するボクの理解もより深まるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420104,
					"content": "目覚めさせることができたなら、創造をすることも不可能ではなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420105,
					"content": "う、う～ん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420106,
					"content": "ハハッ、少し難しすぎたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420107,
					"content": "いやいや、分かるぞ。ただオイラは芽が出た後、なにが出てくるのか気になるだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420108,
					"content": "全然分かってないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "美味しい果実が実ったら、一緒に食べようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420111,
					"content": "おう！約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420112,
					"content": "簡単にパイモンを説得した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "…ボクも子供の相手をしないといけない時があるからね。説明すると長くなるから、錬金術以外のスキルだと思っておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420115,
					"content": "話を戻すけど、1つ目の研究は元素力に関するものなんだ。この世界の者は神の目がないと元素力は使えない。でもキミは神の目を持っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420116,
					"content": "なぜキミは自由に元素力を使えるか確認したい。いくつか質問をするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420117,
					"content": "キミは他の人にない器官を持っているかい？たとえば、2つ目の心臓や、4つ目の胃とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420118,
					"content": "ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "なるほど。では、キミの周りにいるちびっ子は、キミの体と繋がってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420121,
					"content": "その質問、おかしいぞ！見れば分かるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420122,
					"content": "それと「ちびっ子」じゃない、パイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420123,
					"content": "「外付け器官」としての可能性を考えたまでだよ。キミたちは見えない形で繋がってるのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420124,
					"content": "旅の途中で知り合ったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "ふむ、可能性はなしということだね。では、パイモンが元素力をキミに授けた可能性は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420127,
					"content": "10メートルの岩を貫通する、もしくは清泉町の滝を逆流させるほどの元素力をパイモンが持っているという前提になるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420128,
					"content": "うーん、ありえないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420129,
					"content": "まだなにも言ってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420130,
					"content": "となると、キミの身体構造はこの世界の者とはあまり違いがないようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420131,
					"content": "それなら実験であらゆる差異を研究するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420132,
					"content": "まず、その正体不明の元素力がどうやって流れてるか見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420133,
					"content": "スライムを集めてくるから、慣れた方法でそれらを倒してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420134,
					"content": "そんな単純な方法で観察するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420135,
					"content": "良い実験とは直観的で明瞭であるべきだよ。それにこれは簡単な研究に過ぎないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420136,
					"content": "もちろん、簡単すぎると思うなら同時に6体の純水精霊との戦闘に変えようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420137,
					"content": "スライム！スライムでいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420138,
					"content": "よく分からないけど、大変そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "さあ、準備をして、スライムが来るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420139,
					"content": "弄ばれるのは御免だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "パイモンは海で釣ったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "ないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "パイモンの思考を分かっている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "同じく知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "お疲れ様、異常とかはないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420302,
					"content": "怪我をしてたら、応急用の薬剤を持ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420303,
					"content": "安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "ならいい。ボクの観察だと、キミの元素力の流れは順調、元素反応も正常、特別な状態は見られないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420306,
					"content": "「外への流れ」に問題はない、次は「内部の流れ」を試してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420307,
					"content": "「内部の流れ」…どうやってやるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420308,
					"content": "簡単だよ、錬金術で元素力を抽出した薬剤を作った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420309,
					"content": "もし元素力を生理的な形でキミの体内に保存、蓄積できるなら、元素反応が起こるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420310,
					"content": "お腹の中で拡散する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "こ、怖っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420313,
					"content": "大丈夫、全て正常なら一時的に調子が悪くなるだけで、体に害はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420314,
					"content": "正常じゃなかったら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420315,
					"content": "万が一のために、ちゃんと準備はしておいたから心配ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420316,
					"content": "心配だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "うん、リスクがないわけじゃないけど、キミの中の元素の流れに障害があるなら、ついでに調べられると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420318,
					"content": "異常の早期発見にもなるんだよ。もし内部の元素反応が他のトラブルによって発生したら、それこそ厄介なことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420319,
					"content": "身体検査みたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "うん、そう理解していいと思う。でもその前に、検査用の薬剤にあとひとつ触媒が足りないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420321,
					"content": "「星銀鉱」という鉱石でね、触媒に相応しい鉱石だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420322,
					"content": "ボクの拠点に案内するよ。途中で「星銀鉱」も探そう。触媒に使えるものがあったら教えるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420323,
					"content": "順調にいけば、拠点についたらすぐに薬剤の調合を始められるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420324,
					"content": "あまり安全には思えないけど、一応メリットはあるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420325,
					"content": "道中探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420311,
					"content": "お腹の中で結晶になる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "少し寒いだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "ここがボクの拠点だよ。さっき集めた材料はすでに薬剤の調合に使わせてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420502,
					"content": "調合が完了するのを待とう、ちょっとこっちに来てくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420503,
					"content": "こちらは助手のティマイオス、モンドで会ったことがあると思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420504,
					"content": "こんにちは、実験データをもらってすぐ、それをボードにまとめて貼っておいたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420505,
					"content": "わっ、こんなに…スライムと戦っただけでこんな分かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110420506,
					"content": "ハハッ、分かったというか、ほとんどが推論と僕の推測だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420507,
					"content": "最も合理的な方法は、旅人とスライムの系統学的関係、つまり類似性を調べることだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420508,
					"content": "本気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "ほら、君は神の目を持っていないのに元素力を使えるだろ。スライムも同じだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420511,
					"content": "この方向性から手がかりを探せば、きっといろいろと収穫があると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420512,
					"content": "その切り口に問題はないけど、厳密に言えばスライムは元素生物、すなわち元素そのものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420513,
					"content": "どちらかと言うと急凍樹やトリックフラワーの方が近いと思う。しかし動植物の関係となると、世界の原初まで遡ることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420514,
					"content": "その角度から見ると、少し難しすぎると思わないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420515,
					"content": "うっ、確かに先生の言う通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420516,
					"content": "それに、データの一番上に書いてあるけど、この旅人は異世界の客人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420517,
					"content": "もしこの世界と系統学的関係があるなら、却って研究価値のある課題になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420518,
					"content": "ああっ、確かに！データをもらってつい興奮してしまっていた！今度は気を付けます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420519,
					"content": "そうだ、僕はしばらくここでデータを分析することになる。実験結果を知りたいなら、僕のところに来るといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 110420520,
					"content": "ああ、ここはキミに任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420521,
					"content": "薬剤はもう完成したようだ。試してくるから、問題がなければキミにも飲んでもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420509,
					"content": "パイモンの方が近いと思うけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
