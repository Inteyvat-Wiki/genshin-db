			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "ボクが試したところ、予想通りの結果だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420602,
					"content": "飲む時は焦らないように、気分が悪くなったら深呼吸して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110420603,
					"content": "観察したデータと結果を全て記録するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
