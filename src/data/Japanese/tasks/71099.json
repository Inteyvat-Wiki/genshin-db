			"dialogs": [
				{
					"id": 710990401,
					"content": "まったく範二兄ときたら…どうして今まで舞台を交換しなかったんじゃろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990402
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990402,
					"content": "あの人は昔からケチなんじゃよ。年をとってからますます酷くなっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990403,
						710990404
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990403,
					"content": "ケチが原因とは限らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990405
					]
				},
				{
					"id": 710990405,
					"content": "あの人のことはよく知っておる。こんだけ年をとっても、まだ過去を気にして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990406
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990406,
					"content": "はぁ、この話はもう終わりにしよう。後で雲家の娘が遊びに来るんじゃ。私はちょっと片付けに行ってくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 710990404,
					"content": "ケチが唯一の原因とは限らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990405
					]
				}
			]
		},
