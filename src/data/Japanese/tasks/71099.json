			},
			"dialogs": [
				{
					"id": 710995501,
					"content": "これで解決しましたね。良かったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995502,
						710995508
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995502,
					"content": "若心について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710995503
					]
				},
				{
					"id": 710995503,
					"content": "軽策荘の若心先輩を訪ねたことも、そこでお話ししたことも、すべて本当のことです。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995504
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995504,
					"content": "ただ…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710995505
					]
				},
				{
					"id": 710995505,
					"content": "ただ…すべては言いませんでした。先輩が言っていたのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995506
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995506,
					"content": "「範二兄はいつも過去のことを気にしている。さらに性格もケチで、周りの人に迷惑をかけてばかり。だから、私まで悲しくなってくる」です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995507
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995507,
					"content": "すべて本当のことではありますが、これを言ってしまうと範二さんは気を悪くしてしまうでしょう。ですので、半分だけ切り取って言いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995508,
					"content": "ここで座ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710995509
					]
				},
				{
					"id": 710995509,
					"content": "ええ、どうぞ。私が二番目に好きなのは、いい天気の日に茶館へと座りに来ることなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995510
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995510,
					"content": "劉蘇先生の講談がない時は、こうしてここで人々の声を聴いていると、とても心地よい気持ちになれるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995511
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995511,
					"content": "一番好きなのは何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710995512
					]
				},
				{
					"id": 710995512,
					"content": "もちろん、劇を通じて歌うことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710995513
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710995513,
					"content": "お話ししたいのは山々ですが、見てください、劉蘇先生があなたを待っています。舞台の修理を手伝ってあげてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				}
			]
		},
