				"points": []
			},
			"dialogs": [
				{
					"id": 710990601,
					"content": "お任せください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990602
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990602,
					"content": "大雨は作業を進めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990603
					]
				},
				{
					"id": 710990603,
					"content": "最後の一脚も完成しました。どうぞ、村長さん。私はこれから、和裕茶館の依頼をこなしてきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990604
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990604,
					"content": "待っててくださいね、師匠。何日かしたら帰ってこれると思いますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990605
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990605,
					"content": "ああ、行ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990606
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990606,
					"content": "よし。じゃあ、さっそく出発しましょう。今出れば、おそらく明日の夜には着くはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990607
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990607,
					"content": "では、和裕茶館で会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				}
			]
		},
		{
			"id": 7109907,
			"completionStepIds": [
				7109907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109907",
							"2"
						],
						"stepId": 7109907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大雨",
					"茶博士劉蘇",
					"範二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990701,
					"content": "えっと、どういうことでしょう？これだけ時間が経ってるのに、まだ話し合いが済んでなかったんですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990702
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990702,
					"content": "…なるほど、そういうことでしたか。劉蘇さんは新しい舞台が欲しいけど、決定権は彼ではなく、範二さんにあると。しかし、範二さんは新しいのに換えたくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990703
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990703,
					"content": "では話し合いが終わったら、また私に声をかけてください。なにせ私も長旅でしたので、ちょっとその辺で休んできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990704
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990704,
					"content": "はぁ、どうしてこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990705,
						710990706
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990705,
					"content": "つまり、無駄足だったってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				},
				{
					"id": 710990707,
					"content": "まあまあ、そう結論を急がないでくれ。もう少し説得してみるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990708
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990708,
					"content": "範二殿、舞台に使うお金をケチったら、この先いつか大損しますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990709
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990709,
					"content": "ほら、雲座頭が私たちの舞台で劇をするところを想像してみてください。歌い出す前に、舞台がギシギシと鳴ってしまったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990710
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990710,
					"content": "そんな恥をかかせるわけにはいかないでしょう？今のところ雲翰社はここに所属していますが、このせいで気分を害して他のところへ行ったら、それこそ大損です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990711
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990711,
					"content": "雲座頭とは長い付き合いだ。そんなことはしないわい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990712
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990712,
					"content": "まだそんな楽観的でいるのですか！最近は、三杯酔のほうがお客さんが多いんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990713
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990713,
					"content": "田饒舌の人気も、私より高くなっています。少しは危機意識を持ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990714
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990714,
					"content": "雲座頭があれだけの利益を茶館にもたらしているんです。舞台を交換するだけの資金がないわけではないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990715
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990715,
					"content": "おや、私の名前が聞こえましたが、劉蘇先生ではありませんか。何やらご立腹のようですが、一体どうなさったのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990716
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990716,
					"content": "いやいや、怒っているわけじゃない。雲座頭こそ、今日は劇を演じにいらしたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990717
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990717,
					"content": "いえ、ただ茶館へお茶を飲みに。それとついでに、範二さんと劉蘇先生にご挨拶をしようかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990718
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990718,
					"content": "#おや、奇遇ですね。{NICKNAME}さんもいらしていたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990719,
						710990721
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990719,
					"content": "雲菫が来るとは思わなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990720
					]
				},
				{
					"id": 710990720,
					"content": "縁があれば自ずと相見えるもの。私は意外なことだとは思いませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990723,
					"content": "はははっ、雲座頭は相変わらず会話が軽妙だ。さあ、翹英荘から新茶を仕入れたんだ、今それを淹れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990724
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990724,
					"content": "範二さん、先ほど下で茶館の舞台が修理されると聞いたのですが、やっとあれに手をかける気になったのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990725
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990725,
					"content": "コホンッ…それについては急がず、じっくりと検討する必要が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990726
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990726,
					"content": "じっくりと検討ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990727
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990727,
					"content": "ところでお聞きしますが、私が軽策荘へと足を運んだ際、どちらの家でお食事をするかご存知でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990728
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990728,
					"content": "回りくどい言い方はよさんか。また若心のところに行ったんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990729
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990729,
					"content": "ええ、その通りです。若心先輩が、今の和裕茶館がどうなっているのか聞いてきたので、先輩の若い頃と変わらないとお答えしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990730
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990730,
					"content": "なんて言ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990731
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990731,
					"content": "残念ながら、忘れてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990732
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990732,
					"content": "まったく、普段は記憶力が良いのに、重要な部分を忘れるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990733
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990733,
					"content": "まあいい。ほら、すべて元のままのほうが、あいつも喜ぶだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990734
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990734,
					"content": "若いもんは古い物に思いを馳せず、新しいものを追い求める。こっちが何を言っても理解を示そうとせず、ただ急かしてくるばかり…まったく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990735
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990735,
					"content": "#そうお気を悪くしないでください、範二さん。まずはお茶を飲みましょう。私が皆さんにお淹れします。{NICKNAME}さん、劉蘇先生、茶葉を少し取ってきてもらえますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990721,
					"content": "ちょうど雲菫のことを考えてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990722
					]
				},
				{
					"id": 710990722,
					"content": "まったく、冗談がお上手なんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990706,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				}
			]
		},
		{
			"id": 7109908,
			"completionStepIds": [
				7109908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109908",
							"2"
						],
						"stepId": 7109908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雲菫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990801,
					"content": "私は今までずっと、なぜ範二殿が新しい舞台を作りたがらないのか、その意図が分かっていませんでした。誰にとっても利益になることだというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990802
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990802,
					"content": "ですが、雲座頭のおかげでそれが分かりました。やはり、座頭は凄いお方だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990803
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990803,
					"content": "範二さんが古い物を大事にすることは知っていましたが…まさか何十年も経っているのに、まだ昔のことを気にかけていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990804
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990804,
					"content": "これですべて分かりましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990805
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990805,
					"content": "分からないんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990806
					]
				},
				{
					"id": 710990806,
					"content": "ええ、昔のことですので、分からないのも無理ありません。貴方を巻き込んでしまった以上、お話ししても大丈夫でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990807
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990807,
					"content": "若い頃の範二さんは歌がとてもお上手で、よく若心先輩と一緒に、夫婦の役で劇に出演されていました。そしていつしか、それが役から本当の気持ちへと変わっていったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990808
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990808,
					"content": "しかし、若心先輩には他に想い人がいらっしゃいました。やがて舞台生活に飽きると、その方と一緒に軽策荘へと行くことにしたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990809
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990809,
					"content": "ただ、途中で何があったのかは知りませんが、その方が若心先輩と共に軽策荘に辿り着くことはありませんでした。若心先輩は一人取り残されることになったのです…そう、今に至るまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990810
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990810,
					"content": "範二さんは、私がよく軽策荘の若心先輩のもとを訪ねることを知っており、いつも先輩の近況を聞いてきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990811
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990811,
					"content": "今でも若心先輩を想っているが故に、思い出深い舞台を取り換えたくないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990812
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990812,
					"content": "はぁ、あの舞台が範二殿にとってそんなにも大切なものなら、新しいものを作らせるわけにもいかない…木工職人には悪いことをしてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990813
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990813,
					"content": "そうとは限りません。私に考えがあります、少々お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990814
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990814,
					"content": "本当ですか？もしこれが上手くいったら、必ずや謝礼をお渡しいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990815
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990815,
					"content": "#いえ、その必要はありません。ただ、私に講談の『裁雨の音』をお聞かせいただけますか。今回こそは、最後まで聞きたいのです。もちろん、{NICKNAME}さんもご一緒に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990816
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990816,
					"content": "なんか普段の雲菫と違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990817
					]
				},
				{
					"id": 710990817,
					"content": "我々茶館は雲翰社と深い関係にある。雲座頭にとって、我々は他の人よりも身近な存在なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990818
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990818,
					"content": "安心してください、必ずや君たちのために講談を行いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990819
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990819,
					"content": "はい。「お茶」も飲み終えたことですし、そろそろ範二さんとお話ししましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				}
			]
		},
		{
			"id": 7109909,
			"completionStepIds": [
				7109909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109909",
							"2"
						],
						"stepId": 7109909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"範二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990901,
					"content": "範二さん、先ほどお茶を飲んでいる時に、急に若心先輩がなんと言っていたのか思い出しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990902
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990902,
					"content": "ほう、なんと言っていた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990903
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990903,
					"content": "「範二兄はいつも過去を気にしてくれている。だから、私まで悲しくなってくる」とおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990904
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990904,
					"content": "はぁ、やはり彼女は私のことを分かってくれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990905
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990905,
					"content": "だが、彼女のほうにはこの古い物になんの思い入れもないみたいだ。気にしていたのは私だけか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990906
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990906,
					"content": "こう意地を張っていても、意味がないのだな。もういい、直していいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990907
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990907,
					"content": "それは情が深いのであって、決して意味がないということではありません。そのような言い方、私は納得できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990908
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990908,
					"content": "劇台は直します。ですが、範二さんの想いを壊すことはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990909
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990909,
					"content": "やっと話が付いたんですね？では、今から準備します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990910
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990910,
					"content": "事前に用意した設計図をご覧ください。群玉閣にある大きな舞台も、この設計図をもとに作られています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990911
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990911,
					"content": "この設計に沿って、左右の壁は打ち抜く必要がありますね。それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990912
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990912,
					"content": "そう急がないでください。この舞台はやはり元の形を保ったまま直すべきだと思います。床の音が演出に影響を及ぼすのなら、まずは床を修理しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990913
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990913,
					"content": "他の部分は後からでも遅くはありません。劉蘇先生、これでいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990914
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710990914,
					"content": "普段の演出に影響が出なくなれば、それでいい。どう修理するかは、雲座頭と範二殿にお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990915
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990915,
					"content": "えっと、それだけでいいんですか？新しい舞台などはいらないと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990916
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990916,
					"content": "やはり、雲座頭のお考えは素晴らしい。それならいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990917
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990917,
					"content": "ちょうど、修理に使える木板が埠頭にある。新しいものを買う必要もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990918
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990918,
					"content": "若いの…悪いが取ってきてくれないか。報酬は後でまとめて払おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990919
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710990919,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990920
					]
				},
				{
					"id": 710990920,
					"content": "…分かりました。お任せください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				}
			]
		},
		{
			"id": 7109911,
			"completionStepIds": [
				7109911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109911",
							"2"
						],
						"stepId": 7109911,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710991101,
					"content": "よし、木板はこれで十分です。では始めますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991102
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991102,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710991103
					]
				},
				{
					"id": 710991103,
					"content": "実に素晴らしい、元の形のまま修理されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991104
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991104,
					"content": "何も変わってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991105
					]
				},
				{
					"id": 710991105,
					"content": "若い職人さん、わざわざ軽策荘から来てくださり感謝する。報酬のほうは、そちらが額を提示するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991106
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991106,
					"content": "大きな仕事を引き受けたと思ったら、木板を修理するだけの簡単なものだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991107
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991107,
					"content": "私は新人ですので、そう多くはいりません。二食程度の額、つまり八千ほどでどうでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991108
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991108,
					"content": "確かに適正な額だな、実に良い。だが、私から渡せるのは二千だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991109
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991109,
					"content": "えっ？そんなのただ働きとほぼ同じようなものではないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991110
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991110,
					"content": "範二殿はいつもこうなんだ。容赦なく値切りをしてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991111
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710991111,
					"content": "半分の半分まで値切る…まったく…「綿密な計算」をされている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991112
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710991112,
					"content": "そんな、とんでもなくケチなオーナーじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991113
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991113,
					"content": "木板を少し付け加えただけだろう。二千だ二千、それ以上は一モラもやれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991114
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991114,
					"content": "はぁ、今回は初めての依頼でしたし、諦めて泣き寝入りするしかないでしょう。その代わり、範木堂を宣伝していただければと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991115
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991115,
					"content": "もちろん、それについては任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991116
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991116,
					"content": "若いのもご苦労さん。報酬は必ず出そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991117
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991117,
					"content": "この設計図、かなりよく出来ているな。なかなか価値がありそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991118,
						710991119
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991120
					]
				},
				{
					"id": 710991120,
					"content": "はははっ、綿密な計算なくしては、交渉事などできんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991121
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991121,
					"content": "それと雲座頭、こうも手伝ってもらって、なんと礼を言えばいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991122
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991122,
					"content": "範二さんもご冗談を、礼だなんて必要ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991123
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710991123,
					"content": "実は今日、茶館に来たのは「星燕」さんに会うためだったんです。一緒にロックのライブを見に行こうと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991124
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710991124,
					"content": "ほう、またロックとやらを聴きに行くのか。なるほど、口裏を合わせてほしいのだな、はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991125
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991125,
					"content": "口裏を合わせるだなんて、私はただ親友の「星燕」さんにしばらく会っていなかったから、寂しく思っただけですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991126
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710991126,
					"content": "もし劇団の方がいらしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991127
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710991127,
					"content": "分かっておる。「雲座頭？雲座頭なら私の家で『星燕』とずっと刺繡をしているよ」だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991128
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991128,
					"content": "こう言えば、満足していただけるかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991129
					],
					"speakerTitle": "範二"
				},
				{
					"id": 710991129,
					"content": "ええ、約束ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				},
				{
					"id": 710991119,
					"content": "ケチだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991120
					]
				}
			]
		},
