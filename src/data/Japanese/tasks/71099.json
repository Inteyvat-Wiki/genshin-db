		},
		{
			"id": 7109903,
			"completionStepIds": [
				7109903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109903",
							"2"
						],
						"stepId": 7109903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ルーじぃ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990301,
					"content": "何を急いでるんだ、若いの。ここに座って、茶でも飲んでいきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990302,
						710990303
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990302,
					"content": "ルーじぃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				},
				{
					"id": 710990304,
					"content": "劉蘇の依頼をルーじぃに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990305
					]
				},
				{
					"id": 710990305,
					"content": "新しい舞台を作るのはそう難しいことではない。だが、探す相手を間違えておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990306
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990306,
					"content": "璃月港と軽策荘はこんなに離れてるんだ。わしが璃月港へ行ったら、誰が「範木堂」の留守番をすればいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990307
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990307,
					"content": "それに、わしはもう年だ。そんな遠くまでは行けん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990308,
						710990309
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990308,
					"content": "じゃあ、範木堂に頼むのはやめとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990310,
					"content": "まあ待て、せっかく遠くから来たんだ。腕利きの者を紹介してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990311
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990311,
					"content": "まあ、まだわしの弟子ではないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990312
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990312,
					"content": "ルーじぃ、村長から頼まれてた椅子ですが、四脚のうち三脚完成しました。ただ、残り一脚を作るには木材が足りないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990313
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990313,
					"content": "うむ、手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990314
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990314,
					"content": "そうだ、ちょうどいいところに来た。さっき言おうとしてたのは、この大雨のことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990315
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990315,
					"content": "私がどうかしましたか？まだルーじぃに弟子入りしていないので、範木堂の一員ではありませんけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990316
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990316,
					"content": "この方たちは璃月港の和裕茶館の代理で来たんだ。わしらに新しい舞台を作ってほしいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990317
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990317,
					"content": "えっ、今「わしら」って言いました？私とルーじぃが、ひとくくりにされたということですよね？村長さん、今の聞いてました？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990318
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990318,
					"content": "ああ、聞いたよ。ルーじぃ、大雨は他の木工職人のことには目もくれず、範木堂でしか学ぼうとしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990319
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990319,
					"content": "これだけ腕が立って、誠意もあるんじゃ。そろそろ、弟子にしてもいいじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990320
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990320,
					"content": "ああ、分かっとるよ。わしの代わりに仕事を任せようとしてたところだ。それが何を意味するか、分からないわけじゃないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990321
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990321,
					"content": "ありがとうございます、師匠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990322
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990322,
					"content": "大雨、和裕茶館の舞台作りが、わしから与える最初の仕事だ。わしの顔に泥を塗らないよう、良い仕事をするように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990323
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990323,
					"content": "お任せください。それに以前、群玉閣の舞台を作った木工職人を手伝ったこともあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990324
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990324,
					"content": "よく言うわい。それから、和裕茶館の舞台はもう何十年も交換してないと聞いた。今回は丈夫なやつを作ってやれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990325
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 710990325,
					"content": "なるほど、範二兄が劇台の交換をね…どうしてずっと、あんな小さな舞台を使っていたんじゃろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990326
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990326,
					"content": "よし、最後の椅子を作ったら、すぐに出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990327
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990327,
					"content": "#お待たせすることになってしまいすみません、{M#お兄さん}{F#お姉さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990328
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990328,
					"content": "実は最後の椅子を作るのに、松材が三つ足りないんです…今から集めてきますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990329,
						710990330
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990329,
					"content": "まだ待たないといけないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990331,
					"content": "でしたら、今ここで松材を三つ渡していただくしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990332
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990332,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990333
					]
				},
				{
					"id": 710990333,
					"content": "えっ、本当にいいんですか？じゃあ、ついでに赤色の染料も貰えます？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990334
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990334,
					"content": "ちょっと待ってて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990335
					]
				},
				{
					"id": 710990335,
					"content": "あははっ、器が大きいんですね。細かいことを気にされないお方のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990330,
					"content": "もう待てない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990309,
					"content": "報酬は別の人に渡すしかないか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990303,
					"content": "頼みたいことがあるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				}
			]
		},
