			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "こちらはプスパカフェの伝言板です。諸事情により当店は店主に代わって私が運営しています。お客様からご意見があれば、ぜひこちらにお書きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "「今週も引き続き、皆さんに大英雄アンタルの伝説をお話ししましょう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010202,
					"content": "「『プスパカフェ特別招待講談師』マッダフがお届けします。お楽しみに！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010203,
					"content": "マッダフさん…ここで宣伝をしないでくれれば、もう一杯コーヒーをサービスしますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "「ふふ…ガタ…ふふふ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010302,
					"content": "ガタもあなたのことが好きなようですよ、ニィロウさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "「『七聖召喚』プスパ·カード同好会、会員募集中！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010402,
					"content": "「デッキ構築のテクを見せてやる！対戦者募集中！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010403,
					"content": "ナヤブさん、お店でカードゲームをするのはいいんですが、コーヒー1杯くらいは注文してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "「最近、缶詰知識の密輸事件が続発している」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010502,
					"content": "「マハマトラから学生諸君へ、知識が必要なら、正式なルートで申請するように警告する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010503,
					"content": "「非合法な方法で禁制の知識を得たことが発覚すると、教令院で学ぶ資格が剥奪される。軽はずみな行動は慎むように。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "「酒場よりもここの環境の方が、僕のような受験生にとって優しいと思う。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010602,
					"content": "「コーヒーで眠気覚ましできるだけじゃなく、教えてくれる先輩もたくさんいるしね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010603,
					"content": "「店長も占いの結果、今年こそ必ず教令院の試験に受かるって言ってくれた！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010604,
					"content": "願いが叶いますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "「みんな気を付けて！この前、夜中に友達と道を急いでいた時、西北の森でラージャに会ったんだ！運良くケガはなかったけど、夜の外出は控えた方がいい！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "「大学者プルシナの最新の研究によると、コーヒーの大量摂取は脳の思考能力の向上に役立つそうだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010802,
					"content": "「教令院に進学したければ、ここのカフェにたくさんお世話になるしかない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010803,
					"content": "当店の宣伝をしてくれるのはありがたいのですが、コーヒーには皆さんを元気にする程度の効果しかありません…あまり根拠のない話は教令官に睨まれてしまいますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "「カードゲームをしにカフェに来たお前らに、俺から教訓だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010902,
					"content": "「『七聖召喚』をプレイする時、存在しないカードを勝手にでっち上げて仲間を騙してはいけない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010903,
					"content": "「ジャッカルヘッドさまに教えられて、俺は自分の過ちに気づき、深く反省した」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732010904,
					"content": "「過ちに気づいた時点で、お前は他の大多数より賢い。だが、ジャッカルヘッドとは誰のことだ？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "「最近、砂漠の方で盗賊が増えて、いくつものキャラバンが動けなくなっているらしい。近いうちにデーツなんかの値段が高騰するかもな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732011002,
					"content": "「よし、じゃあキノコを売っぱらってデーツを買い漁ってやるぜ。はっはっは、これぞガンディー家先祖伝来の度胸ってヤツよ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732011003,
					"content": "商売のご成功を祈っていますが、この伝言板の情報を元に財産を失ったとしても、当店は責任を負いかねますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
