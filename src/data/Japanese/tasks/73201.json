			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "「何年経ってもここはにぎやかね。ここへ来るたびに、彼と一緒にカフェでたった一文字の解釈について議論していた午後の時間を思い出します。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732011302,
					"content": "あなたのような方がいてくれたから、今のこのお店があります。これからもたくさんいらしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
