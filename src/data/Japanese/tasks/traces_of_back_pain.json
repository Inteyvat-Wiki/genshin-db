			"dialogs": [
				{
					"id": 240210101,
					"content": "いてて…この箱、どうしてこんなに重いの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210102,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "名誉上級研究員、また会ったわね。ごめんなさい…こ…腰をやられたみたいで、いてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210104,
					"content": "大きな箱を持ってきて、中の書類を整理しようとしてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210105,
					"content": "それがまさか…あんなに重いなんて、運ぶ時によろけて、全重量が腰にきちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210106,
					"content": "今…腰が折れそう、あう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210107,
					"content": "おんぶしてあげるから医者に行く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "い、いいえ…前に腰を痛めた時も、少し休めば治ったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210110,
					"content": "そんなに重いなんて、どんだけ書類が入ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240210111,
					"content": "きっと…大量の書類よ、院内ではしばらく「記録保持方式」がとられていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210112,
					"content": "簡単に言うと、院内のあらゆる研究事務において紙の記録を残すというやり方だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210113,
					"content": "それが導入されてから、科学院全体の紙の消費量が五倍に増えたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210114,
					"content": "書類が多くなりすぎて、どこの局にも書類を分ける「文書整理」専門の役職を作らなきゃいけなくなったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210115,
					"content": "ぜんぶ紙で残さなきゃダメなのか？めんどくさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240210116,
					"content": "そうなのよ。その後、一部の書類以外ではだんだんと廃れていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210117,
					"content": "それより…名誉上級研究員、書類入れを取ってくれない？腰は痛いけど、中身の書類を早く整理しなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210118,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "ちゃんと休んでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "大丈夫、書類の整理は腰じゃなくて手でするものだから。ご安心を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240210108,
					"content": "誰か呼んでこようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
