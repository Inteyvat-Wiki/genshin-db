				{
					"id": 10293201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293202
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293202,
					"content": "どうしたの？急に黙り込むなんて、普段の君らしくないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10293203,
					"content": "しっ、話は後だ。今、これまでの手がかりをまとめているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293204,
					"content": "突破口は私が見落としてしまった細部に隠れているかもしれない…だから、一から見直さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293205,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10293206,
					"content": "ああ、心配はいらない。お前が言った内容は紙に記録しないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10293207,
					"content": "そうじゃなくて。つまり、そのことについて考えるなら、私も混ぜてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
