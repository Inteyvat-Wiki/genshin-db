			"dialogs": [
				{
					"id": 10293301,
					"content": "なあ、丑雄。このチビ助、眠ってんだよな。どんな夢見てんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10293302,
					"content": "モ？モォ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10293303,
					"content": "普段は威勢のいいチビだが、こんな風に元気がなくなることもあんだな…はぁ、かわいそうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10293304,
					"content": "それに、あのあんちゃんも、だいぶ弱ってるみてぇだ。二人とも心配だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10293305,
					"content": "モモモー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10293306,
					"content": "俺様が牢屋にいる時もこんな感じで寝てるって？冗談はよせって。俺様の寝姿は世界で一番カッコイイに決まってんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10293307,
					"content": "#おっ、{NICKNAME}か！ったく、いつからいたんだよ？",
					"roleType": "TALK_ROLE_NPC",
