			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "カッシオドル様、カッシオドル様…でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741860303,
					"content": "やはりあなたでしたか。やっと帰っていらっしゃったのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860304,
					"content": "私はこの要塞を守るようにと命じられたのですが、残虐なヴィシャップと蛮族からの激しい攻撃を受け、じりじり後退した末にここまで来てしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860305,
					"content": "あれからどれぐらい経ったのでしょう…外の状況はどうなっていますか？我々は、勝ったのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741860307,
					"content": "…そうですか。我々は負けたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860308,
					"content": "すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741860309,
					"content": "そんなこと、仰らないでください。思っていたんです。至尊の軍団に加入したときから…いつか、この日が訪れると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860310,
					"content": "かつて至尊は、みんなを連れて「フォルトゥナ」の枷を破ると仰っていました。しかし、そう簡単にいくものでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860311,
					"content": "我々が抵抗しようとしたのは、運命そのものなのです。偉大なる神にさえ、抗えない運命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860312,
					"content": "結局、すべての努力は水の泡になってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741860313,
					"content": "いいえ。我々は剣を手に運命に抗い、成し遂げることで高天の法に挑みました。予言に対し、我々は必死に抵抗した——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860314,
					"content": "最終的には失敗に終わってしまいましたが…きっと誰かの裏切りのせいで、我々は道を踏み外してしまったのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860315,
					"content": "しかし、結果などはもう重要ではありません。たとえ何があろうとも、我々の行いは「歴史」に刻まれるのでしょうから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "無名の魔像"
				},
				{
					"id": 741860316,
					"content": "おい、倒れちゃったぞ。石の人間も急に意識を失ったりするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741860317,
					"content": "私は…彼の名前さえ知らない…彼の「歴史」は、ここで終わったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741860318,
					"content": "なん千年もずっとここで戦ってたのか？なんか、かわいそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741860319,
					"content": "だがやっと、安らかに眠ることができたんだ。引き続き前へ進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウッスー"
				}
			]
		}
	]
}