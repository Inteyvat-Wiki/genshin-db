			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "や、やめて！…あれ？旅人、アイツらは？君が追い払ってくれのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170102,
					"content": "よかった！ありがとう…本当に行ったんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170103,
					"content": "ふう…君がいなかったら、キャラバン隊に追いつけなくなるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170104,
					"content": "それに車もアイツらに壊された。早く直して城に戻らないと、フルーツが台無しになってしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170105,
					"content": "フルーツが腐った後、いくら洗っても消えないにおいがどんなものか、君はきっと知りたくないと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170106,
					"content": "とりあえずフルーツの状態を確認するよ。もうそういう匂いがしてきたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "ファオラ"
				},
				{
					"id": 200170107,
					"content": "車の修理に必要な材料を探してくれないかい？…<color=#00E1FFFF>丈夫な木の板</color>があれば十分だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファオラ"
				}
			]
		},
