					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "あら、来てくれたのね。もっとわかりやすい案内が必要なんじゃないかって、考えていたところよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030102,
					"content": "でも、手がかりが目立ちすぎると、かえってあなたたちの旅の計画を邪魔してしまうかもって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030103,
					"content": "そんな風に悩んでいたところに、ちょうど現れてくれたわね！めでたしめでたし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030104,
					"content": "よう、ニコ！元気そうだな！それに…いつも以上におしゃべりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030105,
					"content": "褒め言葉として受け取っておくわ。さあ、次の部屋に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
