						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "これは…白銀の古樹か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030302,
					"content": "ああ、この絵ね。あなたたちも白い古樹のことはよく知っていると思うけど…最初の天の使いによる裏切りも、この樹の下で起きたって知ってた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030303,
					"content": "あまり知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "ちょっと気になるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030306,
					"content": "うん、それじゃあ久しぶりに、恐怖のラブストーリーでも話してあげるわ。当事者たちのプライバシーは守らないとだから…よし、こうしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030307,
					"content": "昔々、星間をさすらう一人の旅人がいました——あなたとはかなり違うのだけれど、それについて話すと長くなってしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030308,
					"content": "ある日、旅人は暁の星のプリンセスに会うため銀の樹の下へ向かいました。そして、彼女に会うやいなや、王国で最も禁忌とされている機密について問いかけたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030309,
					"content": "彼の言葉に、プリンセスは困惑しました——神にも許されぬ事を、一体どうして知っているのだろう…と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030310,
					"content": "少年は自らの来歴を明かし、プリンセスがかつて見たことのない、自由な意志と崇高な愛を示しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030311,
					"content": "彼の言葉は、神に囚われていたプリンセスの自我を呼び覚まし、それにより舞い上がった彼女の心は、初めて障壁を乗り越えたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030312,
					"content": "暁の星のプリンセスは少年に王国の秘密を打ち明け、二人の間には愛のみならず、神にさえ抗う決意も芽生えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030313,
					"content": "今のところ、ありがちなラブストーリーって感じだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030314,
					"content": "恐ろしいのはここからよ。二人は、人々が何物にも縛られない自由な命を得ることを望みましたが、神はその裏切りを赦しはしませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030315,
					"content": "神は雷霆と怒りを下し、彼らの住処を破壊しました。そして、大戦の終息後、プリンセスは永遠にその力と知恵を失ってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030316,
					"content": "そうして彼女だけでなく、彼女の親友たちさえも、ともに呪いをかけられてしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030317,
					"content": "うぅ…恐ろしい結末だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030318,
					"content": "でも、そもそも「最初の天の使い」の話をしてて、この物語につながったんだよな？まさか、実話じゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030319,
					"content": "ええ、そのまさかよ。それこそが一番恐ろしい部分なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030320,
					"content": "うん、それじゃあ久しぶりに、恐怖のラブストーリーでも話してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030321,
					"content": "当事者たちのプライバシーは守らないとだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030322,
					"content": "よし、こうしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030304,
					"content": "聞いたことあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
