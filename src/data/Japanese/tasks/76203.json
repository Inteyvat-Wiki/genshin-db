				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニコ"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "うわっ、いきなり絵の中に吸い込まれちゃったぞ！ん？この風景、なんだか見覚えが…あっ、魔女たちが集会するテーブルだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030202,
					"content": "——もっと言うと、あたしが初めてアリスにお茶会へ招待された時のことから話さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030203,
					"content": "でも、その日、あたしは出席しなかったの。あの時はまだ、魔女会に正式に参加するかどうか決めていなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030204,
					"content": "あの場にいた人たちの中で、あたしの正体を知っていたのはアリスだけだったわ。彼女からは事前に、ボロを出さないよう黙って陰からみんなを観察しているようにって、釘を刺されたのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030205,
					"content": "それで、どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030206,
					"content": "…あれは、参加を躊躇っていたあたしに対する意地悪だって確信したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030207,
					"content": "みんながあんなに面白い話をしているのに、口を挟まないよう我慢しろだなんて、無理に決まってるじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030208,
					"content": "話の最中、誰でも分かるような質問をされたら、答えずにはいられないじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030209,
					"content": "詳しく話すとなると、アリスとバービーの賭け事や、レインドットの禁忌の創造、イヴァノヴナの政治的手腕についても触れなきゃいけないのだけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030210,
					"content": "そのどれもが、まるでティーカップの中に凝縮された、素晴らしい物語のようだったの…聞いているだけで、真実を話したいって本能が刺激されたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030211,
					"content": "それで、みんなの頭の中に語りかけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762030212,
					"content": "まさか。たとえ息苦しくなるほど我慢していても、あたしにだって天の使いとしての責任があるもの。「したいこと」と「していいこと」の区別くらい、わきまえているわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030213,
					"content": "だから、結局お茶会が終わってからアリスのところに行って、思いっきり喋り倒して鬱憤を晴らしたわ。そのついでに、魔女会への参加も了承したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762030214,
					"content": "魔女会への参加はすぐに受け入れてくれたのだけれど、喋り倒したことについては…その後の数日間、頭痛がひどくて璃月の医者に診てもらったらしいわ。でも、全部が全部、あたしのせいじゃないわよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7620303,
