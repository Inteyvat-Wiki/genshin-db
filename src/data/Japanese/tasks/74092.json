			"dialogs": [
				{
					"id": 740920101,
					"content": "どうして…どうしてこんなことに…卑劣な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920102,
					"content": "クロニエさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}！来たのね、よかったわ…あなたは…少なくとも真相を知ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920105,
					"content": "クロニエ、ちょっと落ち着けよ。ど…どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740920106,
					"content": "たとえ…私の記事が新聞に載せてもらえなくても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920107,
					"content": "#{M#君}{F#あなた}の記事、どうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "そうだぞ。おまえの記事がなかなかお披露目されないから変だと思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740920109,
					"content": "まだ読んでない…そう、そうよね…あなたたちが読んでるわけないわよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920110,
					"content": "取り乱して…どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "あの日…フォンテーヌ科学院から帰った後、私はさっそく記事を書き始めたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920112,
					"content": "見聞きしたこと、私が感じたことをすべてありのままに書き出したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920113,
					"content": "たとえば、フォンテーヌ科学院がアルケウムを完全には排除していないこと。それどころか、新たにアルケウムに関わるプロジェクトを始めたこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920114,
					"content": "そして、エドウィンのかつての部下がフォンテーヌ科学院の廃墟へ探索に行かされて、爆発で亡くなったこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920115,
					"content": "フォンテーヌ科学院の上級技術官レモンドは彼の死を認めようとせず、爆発は計画されたものだったと頑なに言い張っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920116,
					"content": "まだまだあるわ。廃墟に残された制御不能の巨大なマシン、汚染された水系…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920117,
					"content": "フォンテーヌ科学院が隠そうとしていることを何もかも文章に書き入れたのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920118,
					"content": "なのに…記事を提出した後、フォンテーヌ科学院が私を訴えることを知らされたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920119,
					"content": "新聞社内の規定に基づいて、フォンテーヌ科学院に関する私の記事の内容はすべて「信頼性審査」を受けなければならなくなったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920120,
					"content": "フォンテーヌ科学院についての記事も取り下げられた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920121,
					"content": "信頼性審査って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "いいえ。審査は特定の記事に対するものじゃなく、私自身に対するものよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920124,
					"content": "要するにフォンテーヌ科学院は、私が「科学院と利益が対立するからといって主観的な感情を報道に盛り込み、大衆に誤った情報を伝えた」と主張して、訴えたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920125,
					"content": "でも、利益の対立なんてあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "クロニエは写真を数枚撮っただけだろ。写ってるのはボロボロの石と動かない巨大なマシナリーばっかりだったし…それのどこが「利益の対立」なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740920127,
					"content": "そんな…あの人たちの倫理観を暴いたから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "彼らは…私がフォンタの最新ラインナップを漏洩したと非難してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920129,
					"content": "フォンテーヌ科学院側は、私が廃墟で撮った写真の一部に新作フォンタのデザイン案が写っていたと言い張るのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920130,
					"content": "どの写真にも精査が必要だとね。それが終わるまではフォンテーヌ科学院が訴訟を取り消すことはないし、私も信頼性審査を受け続けないとならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920131,
					"content": "私の記事を報道させないためにフォンテーヌ科学院がこんな手段に出たことは確かよ…でも、諦めないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920132,
					"content": "#{NICKNAME}さん、これを持って行って！私がこっそり自分で印刷した新聞よ。この後、外で新聞を配るの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920133,
					"content": "真相とフォンテーヌ科学院の真の姿をすべての人に知らしめ、そして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920134,
					"content": "クロニエさん！どうしてこんなところにいるの？ずいぶん探したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "マーナ"
				},
				{
					"id": 740920135,
					"content": "ああ！誰か来たわ。ここにはもういられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920136,
					"content": "この新聞をあげる。大事に持っていって。真相のすべてがここに書かれているわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740920137,
					"content": "規定通り、今すぐ共律庭へ行って毎日の定例審査を受けてもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "マーナ"
				},
				{
					"id": 740920138,
					"content": "あ！逃げないで、クロニエさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "マーナ"
				},
				{
					"id": 740920139,
					"content": "たかがフォンタだもん。ただの誤解かもしれないでしょ。はっきり説明しさえすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "マーナ"
				},
				{
					"id": 740920140,
					"content": "ねえ！待ってってば、クロニエさんったら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーナ"
				},
				{
					"id": 740920122,
					"content": "#会社は{M#君}{F#あなた}の記事が信頼性に欠けるって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}