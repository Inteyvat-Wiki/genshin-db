					"トゥゼー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420101,
					"content": "あれ、異国の英雄さん。まだ何かご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420102,
					"content": "きっと採掘現場とテフラ遺跡の場所がわかんないんだよ。なら、おれたちも大人の言いつけをちょっとやぶって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420104,
					"content": "わかったよ…集落からは出ない。それでいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420105,
					"content": "#それで…{NICKNAME}さん、何か聞きたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナイア"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7514201",
							"2"
						],
						"stepId": 7514201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥナイア",
					"トゥゼー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "採掘現場について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "えっと、採掘現場って、本当は「秘源遺跡の採掘現場」っていうんです。聖山の南に広がる、遺跡のエリアです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420203,
					"content": "大昔の巨龍が残したものだそうですよ。わるい宝盗団にこっそり遺跡が採掘されないように、エンポゾお爺ちゃんが毎日パトロールしてるんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420204,
					"content": "エンポゾお爺ちゃんは昔から遺跡や遺物が大好きなんです。龍の遺物研究会に入ってたこともあるみたいで、いつも大昔の話を聞かせてくれるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420205,
					"content": "でも、エンポゾ爺ちゃんの話ってつまんないんだよなぁ。遺跡の模様から「酸っぱい」のトーテムが見えるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420206,
					"content": "「崇拝」のトーテムでしょ…エンポゾお爺ちゃんは語り部というよりは考古学者だし、しょうがないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420207,
					"content": "エンポゾお爺ちゃんは昔火山の中を探索したことがあるって言ってました。もしかしたら助けてくれるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナイア"
				}
			]
		},
		{
			"id": 7514203,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
