							286.745,
							10158.87
						],
						"pointId": 351700001
					}
				]
			},
			"dialogs": [
				{
					"id": 751420501,
					"content": "聖山様はお腹の具合を悪くしてるから、毎日いろんなものを吐き出してるの。見たらわかるでしょ！いま集落の外に行くのは危ないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420502
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420502,
					"content": "昔、おじさんが話してくれたお話の中で「火山の具合が悪い時は、みんなで何度か叩けば治る」って言ってたもんな。おれの手じゃ小さすぎるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420503
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420503,
					"content": "大人たちの手なら絶対大丈夫なのに、おれたちを集落の外に行かせないために、わざと叩きに行かないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420504
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420504,
					"content": "あははっ、トゥゼーはそんな風に思ってたの？ふふっ、でも聖山様を治すためには…部族の大人全員で行かなきゃ無理だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420505
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420505,
					"content": "でも大人たちはみんな忙しいんだから。例えば、ヴァレサお姉ちゃんは果樹園の世話をしないといけないでしょ？みーんな時間のある時じゃないと、聖山様は叩きにいけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420506
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420506,
					"content": "そりゃそうだけど…はぁ、大人たちの仕事が終わるのを待つしかないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420507
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420507,
					"content": "そう。だから、それまでは大人たちのいう通り、集落から出ないようにしましょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420508
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420508,
					"content": "…わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420509
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420509,
					"content": "どうしたんだ？叩く…とか聞こえたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751420510,
					"content": "あ、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420511
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420511,
					"content": "外から来た変なやつに部族の秘密を話しちゃいけない、って話をしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420512
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420512,
					"content": "火山を叩いて治すのって秘密なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420513
					]
				},
				{
					"id": 751420513,
					"content": "な、なんだよ。全部聞いてたんじゃねえか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420514
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420514,
					"content": "トゥゼーの声が大きすぎるんだよ。今度から内緒話をするときは、こしょこしょ話ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420515
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420515,
					"content": "わかったよ…えっ。でも、そ、それ、めちゃくちゃ近くならねえか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420516
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420516,
					"content": "あははっ、そうかもね。えっと…こんにちは、異郷のお客さん。わたしはトゥナイアで、こっちがおばかのトゥゼーです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420517
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420517,
					"content": "またおれのこと「ばか」って言った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420518
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420518,
					"content": "豊穣の邦へようこそ、テペトル仔竜も…あれっ、聖山様の具合が悪いからかな…集落にはよその竜を退ける「符石」があるはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420519
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420519,
					"content": "へへっ、符石も叩いて治してやらないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420520
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420520,
					"content": "今一番叩いて治さないといけないのはトゥゼーの頭のほうじゃない？…はぁ、お二人が悪い人じゃなさそうでよかったです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420521
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420521,
					"content": "それで、お二人はどうしてここへ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420522
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420522,
					"content": "トゥナイアとトゥゼーに自己紹介をして、\\n聖山に入る目的を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420523
					]
				},
				{
					"id": 751420523,
					"content": "「聖山に入りたい」、ですか…難しいと思いますよ。大人たちはいつも「聖山は危険な場所だから気軽に入るな」って言ってますし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420524
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420524,
					"content": "でも、異郷のお客さんが聖山に入りたがるなんて、きっと何か理由があるんですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420525
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420525,
					"content": "うーん…聖山に入ったことがある人なら知ってますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420526
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420526,
					"content": "お、おれも知ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420527
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420527,
					"content": "えっ、でも…聖山って部族の大事な場所なんだろ？そんな気軽にオイラたちに教えちゃっていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751420528,
					"content": "「聖山」っていうのは、遥か昔のウォーベンに載っていた呼び方をそのまま使ってるだけです…わたしたちにとっては、「聖火競技場」のほうが神聖ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420529
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420529,
					"content": "入っちゃいけないのは、ただ危ないからってだけですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420530
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420530,
					"content": "しかも、昔火山の中を探索するために、「談議室」が探検隊を組んだこともあるんだぜ！へへ、おれも大きくなったら絶対遊びに行くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420531
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420531,
					"content": "もう、危ないって何回言ったらわかるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420532
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420532,
					"content": "うーん…わたしも詳しくは知らないんですけど、よかったら<color=#00E1FFFF>エンポゾお爺ちゃん</color>に聞いてみてください。きっと喜んで助けてくれると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420533
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420533,
					"content": "暇そうにぶらぶらしてるエンポゾ爺ちゃんか…？それより<color=#00E1FFFF>キモシー</color>に聞いた方が早いぜ。へへっ、キモシーはおれのおじさんなんだ。昔探検隊のメンバーだったんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420534
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420534,
					"content": "エンポゾお爺ちゃんは暇でぶらぶらしてるわけじゃないの。うーん、片方は<color=#00E1FFFF>山の南側にある採掘現場</color>、もう片方は<color=#00E1FFFF>村の西側にあるテフラ遺跡</color>にいます…ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420535
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420535,
					"content": "案内してあげたいところなんですが、今は聖山様の活動期なので…わたしたちは一緒に行けないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420536
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420536,
					"content": "大丈夫だ。いろいろ教えてくれただけで十分だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751420537,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}！戻ってこーい！出発するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751420538,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420539
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751420539,
					"content": "えへへ、かわいいですね。しっぽに巻いてあるスカーフが素敵。聖山様が眠ったら、部族の外で一緒に遊びましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420540
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420540,
					"content": "もちろん！今度は遊ぼうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
