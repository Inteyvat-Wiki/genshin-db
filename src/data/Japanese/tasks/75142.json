			"dialogs": [
				{
					"id": 751420401,
					"content": "いや、大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420402
					]
				},
				{
					"id": 751420402,
					"content": "そうですか。じゃあ、いい旅になりますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420403
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420403,
					"content": "へへっ、たまには遊びに来てくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥゼー"
				}
			]
		},
		{
