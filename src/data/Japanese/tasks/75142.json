			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥゼー",
					"トゥナイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420301,
					"content": "テフラ遺跡について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420302
					]
				},
				{
					"id": 751420302,
					"content": "おお、テフラ遺跡について知りたいんだな！おれにまかせろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420303
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420303,
					"content": "むかーしむかし…ナタがまだおだやかな楽園だった頃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420304
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420304,
					"content": "五百年前、ナタでアビスの侵蝕が一番ひどかった頃のことです。その時、火山から、きれいまるごと遺跡が噴出したんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420305
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420305,
					"content": "なんだよ、トゥナイア！おれが言おうとしてたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420306
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420306,
					"content": "だってテフラ遺跡の話をするとき、いつもすっごく昔の話から始めるじゃん。最後まで聞いていられないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420307
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420307,
					"content": "ちぇっ、全部キモシーおじさんが教えてくれたことなのに。おじさんも、昔「談議室」が組んだ探索隊のメンバーだったんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420308
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420308,
					"content": "でも最近、またテフラ遺跡の近くでアビスの痕跡が見つかったらしいんだ。おじさん、大丈夫かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420309
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420309,
					"content": "テフラ遺跡に行くなら、キモシーおじさんによろしく伝えといてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥゼー"
				}
			]
		},
		{
			"id": 7514204,
