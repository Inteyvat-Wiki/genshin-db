						],
						"pointId": 351700001
					}
				]
			},
			"dialogs": [
				{
					"id": 751420701,
					"content": "聖山様はお腹の具合を悪くしてるから、毎日いろんなものを吐き出してるの。見たらわかるでしょ！いま集落の外に行くのは危ないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420702
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420702,
					"content": "昔、おじさんが話してくれたお話の中で「火山の具合が悪い時は、みんなで何度か叩けば治る」って言ってたもんな。おれの手じゃ小さすぎるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420703
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420703,
					"content": "大人たちの手なら絶対大丈夫なのに、おれたちを集落の外に行かせないために、わざと叩きに行かないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420704
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420704,
					"content": "あははっ、トゥゼーはそんな風に思ってたの？ふふっ、でも聖山様を治すためには…部族の大人全員で行かなきゃ無理だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420705
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420705,
					"content": "でも大人たちはみんな忙しいんだから。例えば、ヴァレサお姉ちゃんは果樹園の世話をしないといけないでしょ？みーんな時間のある時じゃないと、聖山様は叩きにいけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420706
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420706,
					"content": "そりゃそうだけど…はぁ、大人たちの仕事が終わるのを待つしかないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420707
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420707,
					"content": "そう。だから、それまでは大人たちのいう通り、集落から出ないようにしましょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420708
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420708,
					"content": "…わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420709
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420709,
					"content": "どうしたんだ？叩く…とか聞こえたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751420710,
					"content": "#えっと…あっ、金髪の人と銀色の妖精…{NICKNAME}とパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420711
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420711,
					"content": "ぶ、部族の大事な大事な秘密を話してたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420712
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420712,
					"content": "火山を叩いて治すのって秘密なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420713
					]
				},
				{
					"id": 751420713,
					"content": "な、なんだよ。全部聞いてたんじゃねえか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420714
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420714,
					"content": "トゥゼーの声が大きすぎるんだよ。今度から内緒話をするときは、こしょこしょ話ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420715
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420715,
					"content": "わかったよ…えっ。でも、そ、それ、めちゃくちゃ近くならねえか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420716
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420716,
					"content": "あははっ、そうかもね。えっと…こんにちは、異郷の大英雄さん。わたしはトゥナイアで、こっちがおばかのトゥゼーです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420717
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420717,
					"content": "またおれのこと「ばか」って言った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420718
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420718,
					"content": "豊穣の邦へようこそ、テペトル仔竜も…あれっ、聖山様の具合が悪いからかな…集落にはよその竜を退ける「符石」があるはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420719
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420719,
					"content": "へへっ、符石も叩いて治してやらないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420720
					],
					"speakerTitle": "トゥゼー"
				},
				{
					"id": 751420720,
					"content": "今一番叩いて治さないといけないのはトゥゼーの頭のほうじゃない？…それにしても、大英雄さんが「豊穣の邦」まで来てくれるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420721
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420721,
					"content": "なにかお困りですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420722
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420722,
					"content": "トゥナイアとトゥゼーに聖山に入る目的を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420723
					]
				},
				{
					"id": 751420723,
					"content": "「聖山に入りたい」、ですか…難しいと思いますよ。大人たちはいつも「聖山は危険な場所だから気軽に入るな」って言ってますし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420724
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420724,
					"content": "#でも、{NICKNAME}さんが聖山に入りたがるからには、きっとそれなりの理由があるんですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420725
					],
					"speakerTitle": "トゥナイア"
				},
				{
					"id": 751420725,
					"content": "うーん…聖山に入ったことがある人なら知ってますよ。",
					"roleType": "TALK_ROLE_NPC",
