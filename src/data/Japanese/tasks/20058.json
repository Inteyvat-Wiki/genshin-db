					"ノーラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "うう、どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "風神の神像は見た？上を見て、すごく高い所…風神様の手を見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580104,
					"content": "そこで遊びたいの…でも、きっとグレイスおばさんは登らせてくれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580105,
					"content": "ねえ、お願いだから、こっちを見ないようにグレイスおばさんとなんか話してきてよ。私登るの早いし、すぐ終わるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580106,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "じゃあお願いね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580110,
					"content": "とにかく、グレイスおばさんの相手してて。行ってくるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580111,
					"content": "ノーラ、行っちゃだめよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580112,
					"content": "ふう…少し目を離した隙に、あの子があなたにそんな願いをするなんて、ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580113,
					"content": "そんな！ちょっと遊んでくるだけだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580114,
					"content": "だめなことはだめよ。お父さんだって許さないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580115,
					"content": "あの子のことは気にしないで、あなたもこんな危ないことしたら、きっと誰かに心配されるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580108,
					"content": "危ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "大丈夫だよ、私はすごいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "ノーラ"
				}
			]
		},
