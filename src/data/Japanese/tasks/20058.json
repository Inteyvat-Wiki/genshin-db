			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580202,
					"content": "登ってなにするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "誰かに内緒話したい時、その内容を蒲公英に教えて、蒲公英を飛ばしたら、風神様は蒲公英と内緒話を相手に届けてくれるって、グレイスおばさんが言ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580204,
					"content": "しかも飛ばした場所が高いほど、願いが早く届くって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580205,
					"content": "グローリーお姉さんも冒険者に風神の石像で蒲公英を飛ばすようにお願いしたら…数日でグッドウィンお兄さんの返事をもらったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580206,
					"content": "私もお父さんに話したいことがあるし、蒲公英も見つけておいたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580207,
					"content": "でも…グレイスおばさんが許してくれなくて…大人にならないとお父さんと一緒に暮らせないって言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580208,
					"content": "どうすれば早く大人になれるのかな。いっぱい鍛錬したけど、全然背が伸びないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580209,
					"content": "うん…そういえば、よく城内であなたが飛んでるの見かけるんだけど、普段どうやって飛んでるか教えてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580210,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "へへっ、じゃあ隣で見てるね。それならグレイスおばさんも怒らないはずだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 200580212,
					"content": "一緒に飛んでみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "だめだよ、グレイスおばさんに見られたらまた怒られるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ノーラ"
				}
			]
		},
