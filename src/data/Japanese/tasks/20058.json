			"dialogs": [
				{
					"id": 200580901,
					"content": "はあ、ノーラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580902,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が彼女の世話を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "ええ、事情があって彼女の母親は…家を空けてて、私があの子の世話をしてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580904,
					"content": "他にも数人の子供の面倒を私が見てるわ。これもシスターの仕事だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580905,
					"content": "まるで急に子供が一気に増えたみたいでね、みんないい子だから、グローリーとも仲良くしてくれてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580906,
					"content": "ふふっ…一番長く世話したティミーは私のことをグレイスママと呼び始めたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580907,
					"content": "ノーラのお父さんは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "パットンさんよ、前はお酒が好きすぎてちょっといろいろ問題があってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580909,
					"content": "教会も西風騎士団も何回も警告したけど、ずっと反省してなくて、最後はディルックさんのおかげでなんとかなったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580910,
					"content": "今のパットンさんはノーラの世話に向いていないから、ノーラを教会に預けて、パットンさんに反省する時間を与えたほうがいいというのがシスターヴィクトリアの意見よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580911,
					"content": "でもノーラも成長してるし、「お父さんが仕事頑張ってるから、邪魔しちゃだめ」という言い訳ももうすぐ使えなくなるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200580912,
					"content": "風神様の蒲公英は、どんな願いも叶えてくれるわけじゃないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
		},
