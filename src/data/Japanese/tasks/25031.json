					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "どうしよう…これはまずいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310102,
					"content": "アレムの訓練で何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}！本当にいいところに来てくれたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310104,
					"content": "説明してる余裕がないの。早く彼女を助けて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310105,
					"content": "#{M#君}{F#あなた}のお友達？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "そ…そんなものよ。私たちは論文を書いてる時に何回も挫折したの。一緒に図書館で抱き合って号泣したこともあったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310108,
					"content": "——って、今はそんな話をしてる場合じゃないわ！彼女、全然私の話を聞かないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310109,
					"content": "彼女は論文のためなら何も惜しくないとか言って、護衛を連れて毎日外をうろうろしてるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310110,
					"content": "それで、まだ帰ってこないの！部族の方も人手不足で助けに行けなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}さん、どうか彼女を助けて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310112,
					"content": "任せて、慣れてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#この件はあなたに頼るしかないの！お願い、{NICKNAME}さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310113,
					"content": "教令院の人たちって本当に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "彼女って…はぁ、本当にただ運が悪すぎるとしか言いようがないの。今回ナタに来て、論文のために最後の足掻いてやるとか言ってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "タフムーラス"
				},
				{
					"id": 250310106,
					"content": "#{M#君}{F#あなた}の知り合い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
