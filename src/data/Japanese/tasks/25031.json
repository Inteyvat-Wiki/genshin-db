			"dialogs": [
				{
					"id": 250310401,
					"content": "本当にありがとう、助かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310402,
					"content": "あんなバッグ、とっとと捨てれば、アタシ一人でやつらをなんとかできたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310403,
					"content": "それじゃあナタの旅が台無しだよ！絶対にイヤだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310404,
					"content": "#待って、{M#君}{F#あなた}は…アラニ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#え？あなたは…{NICKNAME}！本当に{NICKNAME}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310406,
					"content": "隣にいるのって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "ナザム、宝盗団だよ。アタシたち会ったことあるけど、覚えてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310408,
					"content": "ふぅ…あなたは間違いなく私の救いの星だよ。何回助けてくれたんだっけ？一回、二回…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310409,
					"content": "アレはカウントしないでくれ。あの時、行きたくないとかほざいたのはあんただからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310410,
					"content": "あの時のことはカウントしてないよ。それに、私はちゃんとお金を払ったんだからね。どうしてそんなこと言われなきゃいけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310411,
					"content": "それっぽっちのお金じゃ、適当に食って飲んでればなくなるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310412,
					"content": "論文のために来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "へへっ…もう随分時間をかけてきたから、無駄にするわけにはいかないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310414,
					"content": "今回はちゃんと教令院に専用の経費を申請して、誰とも課題が被ってないことを確認したんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310415,
					"content": "それに、ナザムが護衛だから、悪いやつは全部彼女が片づけてくれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310416,
					"content": "それはな、アタシら襲ってもうま味がないから、わざわざちょっかいかけてくる輩がいないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310417,
					"content": "それじゃあ、さっきのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "…こいつ、文献を入れたバッグを死ぬほど固く抱えて、「こだまの子」の方からここまで歩いてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310420,
					"content": "正直、アタシから見ても、懐にお宝を抱えてるバカにしか見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310421,
					"content": "お宝を抱えたやつが、こんな人気のない荒野を護衛一人だけ付けて歩いてるとなると…誰だって賭けてみようと思うさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310422,
					"content": "そうよ！私のバッグに入ってるのはお宝だよ。実地見聞した記録と、各種文献の写しが入ってるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310423,
					"content": "これがあれば、私はあの論文を完成させられる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310424,
					"content": "ふふん、論文のタイトルは「帰火聖夜の巡礼」なんだからね。圧倒的な学術価値があるから、卒業させてくれるに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310425,
					"content": "ああでも、タフムーラスがアドバイスしてくれたおかげでもある。さすが私の親友、えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310426,
					"content": "#本当にありがとう、{NICKNAME}、あなたがいなかったら、あの悪者たちに本を破られて、モラまで奪われるところだった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310427,
					"content": "この前、書籍と資料の整理のお手伝いで、やっと少し稼いだのに、これを奪われたら、新しい資料を買えなくなっちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310428,
					"content": "ああ、あんたは全ての金を本に使うからな。アタシがあんたの財布を持ってなきゃ、二人とも餓死してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "ナザム"
				},
				{
					"id": 250310429,
					"content": "そ、そんなに買ったわけじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310430,
					"content": "もう、雑談はここまでにしよう。私たちはこれから「流泉の衆」に取材しに行かないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310431,
					"content": "それじゃあね。次に会う時は、きっと私の論文も完成してるはず！その時は、絶対ご馳走してあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				},
				{
					"id": 250310418,
					"content": "結局面倒事に巻き込まれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
