			"dialogs": [
				{
					"id": 706920101,
					"content": "あっ、騎士のお兄さん。みんなの大英雄が来たよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "「マッドマンハンター」"
				},
				{
					"id": 706920102,
					"content": "旅人さんとパイモンさん！こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920103,
					"content": "ミカと…ナタの友達か？おまえら、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706920104,
					"content": "僕たちは冒険者のために役立ってくれるアイテム「偵察竜」を宣伝しているところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920105,
					"content": "アンバー先輩がスメールから持ち帰った「偵察パートナー」の機械コアと、ナタの友人からもらった仔竜のぬいぐるみを組み合わせてできています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920106,
					"content": "偵察パートナー…おおっ、オイラ覚えてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706920107,
					"content": "スメールの「偵察パートナー」と似たようなもので、魔物の偵察や地形の調査を手伝ってくれるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920108,
					"content": "偵察竜は後者により重点を置いているので、行動の制御性と精密性を重視して作られているんですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920109,
					"content": "…旅人さん、試験飛行に挑戦してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920110,
					"content": "すごく真面目な説明だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "え？ちょっと…緊張してたかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920113,
					"content": "以前はあなたの前でも落ち着いて、自然に接することができていましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920114,
					"content": "でも最近、他の国の友達からあなたの活躍を聞いて、ますます凄くて素晴らしい人なんだと実感して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920115,
					"content": "力になりたい、足を引っ張ってはいけないって、気を張っちゃってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920116,
					"content": "ミカらしい考え方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706920117,
					"content": "君は十分よくやってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "「マッドマンハンター」"
				},
				{
					"id": 706920118,
					"content": "#ナタでは{NICKNAME}に出会うと、興奮のあまり言葉を詰まらせる戦士もいれば、一言もしゃべれなくなる人もいるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "「マッドマンハンター」"
				},
				{
					"id": 706920119,
					"content": "#{NICKNAME}と同じ騎士なんだから、君もレジェンド級みたいなもんだよ。私たちの族長と話すのに、気後れすることなんかないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "「マッドマンハンター」"
				},
				{
					"id": 706920120,
					"content": "そうだぞ、ミカはもっと自信を持てよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706920121,
					"content": "あはは…そんな考え方、思いつきもしませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920122,
					"content": "#とにかく、もし{NICKNAME}さんが試験飛行で満足してくれるほどのクオリティだと確認できれば、キュートで頼もしいこのサポート装置は、きっとより多くの冒険者たちの役に立ってくれるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920123,
					"content": "#{M#俺}{F#私}の得意分野だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "はい！では「偵察竜」を調整しますね。すぐに試験飛行できますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706920124,
					"content": "偵察竜の性能を試してみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "そんなにかしこまらなくてもいいのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}