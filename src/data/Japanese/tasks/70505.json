			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "悪くない味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050202,
					"content": "材料がいいからな！新鮮な果物を使ってるから、なにも加えなくても甘いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050203,
					"content": "なるほど、モンドの大地に感謝するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050204,
					"content": "…グレーバレーサンセット、これは僕が初めて作ったドリンクなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050205,
					"content": "僕がまだ子供だった頃、父さんが材料をいくつか並べて、試しに何か作ってみろと言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050206,
					"content": "どんな物を作ればいいのか、どうやって作ればいいのか、父さんは何も教えてくれなかった。多分、僕の実力を試してみたかったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050207,
					"content": "最終的に僕が作ったのが、このジュースだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050208,
					"content": "え？こ、これを…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050209,
					"content": "父さんも驚いていた。ただ当時の僕は、ジュースは甘いものだとばかり考えていたんだ。だから、他のことは頭から抜けていてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050210,
					"content": "今思えば、あれほど稚拙で短絡的な考えもないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050211,
					"content": "#{M#俺}{F#私}はそう思わない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050213,
					"content": "きっといいドリンクだと思ってくれたはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "僕は、そんな風に考えたことがなかった…何しろあの時、父さんは何も言ってくれなかったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050216,
					"content": "だが、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050217,
					"content": "それから、君に渡したいものがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050218,
					"content": "…ただ、君がバーテンダーとして、もっと経験を積んだ後に渡すとしよう。君の実力なら、きっといい仕事ができるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050219,
					"content": "オイラも…応援するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050220,
					"content": "ああ、君たちの成果に期待してる。僕はこれで失礼しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050221,
					"content": "時間があったらまた来てくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050214,
					"content": "きっと美味しいと思ってくれたはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}