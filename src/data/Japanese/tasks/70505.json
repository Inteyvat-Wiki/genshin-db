			},
			"dialogs": [
				{
					"id": 705050101,
					"content": "あっ、ディルックの旦那！珍しいな！今日はヒマなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050102,
					"content": "ヒマとはどういう意味だ。君たちがバーテンダーをしていると聞き、様子を見に来ただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050103,
					"content": "おおっ、さすが耳が早いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050104,
					"content": "で、バーテンダーの体験はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050105,
					"content": "まだ始めたばかりだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "そうだな。聞くのが早すぎるぞ。オイラたち、まだ始めたばかりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050107,
					"content": "いや、今の気持ちを聞きたいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050108,
					"content": "楽しめそうか？それとも不安に感じているだろうか？思っていることをそのまま口にしてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050109,
					"content": "とても新鮮な感じ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050112,
					"content": "おい、オイラには聞かないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050113,
					"content": "オイラの感想は…美味しいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705050114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050115,
					"content": "ならいい、よかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050116,
					"content": "グレーバレーサンセットを作ってくれないか？サイズは任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050117,
					"content": "分かった、少し待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "ああ、急がなくて大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 705050110,
					"content": "忙しくて手が回らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
		{
			"id": 7050502,
			"completionStepIds": [
				7050503
