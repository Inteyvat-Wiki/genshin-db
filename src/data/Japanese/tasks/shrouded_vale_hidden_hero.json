			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "あれ？剣になにか書いてあるぞ？どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090602,
					"content": "「…剣を手に長歌を詠みて去り、龍を斬りて血をすすり戻る。神光は閃光のごとく、冴える波は山をも砕かんと欲す…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "古剣の銘文"
				},
				{
					"id": 711090603,
					"content": "「…天衡の下で虎を斬り、雲海の間で蛟を刺す。功成り衣を払いし後は、永く煙水と同じくして閑なり…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "古剣の銘文"
				},
				{
					"id": 711090604,
					"content": "隣にもう一つ石碑があるな…あれ、文字が違うみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090605,
					"content": "「…魚や羊の馳走をここに残そうとしたが、時間が経てば腐ってしまうだろう。故に作り方をここに書き残し、これを見た者は自ら料理するといい。実に美味なり。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "古い模刻"
				},
				{
					"id": 711090606,
					"content": "「…他に何もなく、この剣とこの景色のみ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "古い模刻"
				},
				{
					"id": 711090607,
					"content": "「…九死の境に至る際は、何をすればいいのだろう？知っているはずだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "古い模刻"
				},
				{
					"id": 711090608,
					"content": "「…遺宝を…取らず、ただ…を一つ残す…これからは…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "クネクネした模刻"
				},
				{
					"id": 711090609,
					"content": "「九死の境より逃れるため…今こそ我が…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "クネクネした模刻"
				},
				{
					"id": 711090610,
					"content": "うぇ…この後に書かれてる字、ぐにゃぐにゃでまったく読めないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090611,
					"content": "何も取らなかったって意味かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "うぅ、結局価値のあるお宝とかなかったぞ、期待して損したぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090614,
					"content": "確かに！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "でも、こんなところであんな綺麗な景色を見れたんだし…少なくとも無駄足じゃなかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090615,
					"content": "気を落とさないで、料理を作ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#えっ！？本当にいいのか！{NICKNAME}、約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711090612,
					"content": "#{M#俺}{F#私}も読めない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
