			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"文四",
					"黄三"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "はぁ…千年受け継がれし古華派が、門主を筆頭にたかりのような真似をするまでに落ちぶれるとは…まことに無念なり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "文四"
				},
				{
					"id": 711092502,
					"content": "まあまあ…そう言うな。わしとて門派のために弟弟子が飢え死にするのは見たくないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "黄三"
				},
				{
					"id": 711092503,
					"content": "#そんな顔をするな。日がな一日中、憂鬱な顔をしおって…先ほどのあの{M#少年}{F#嬢ちゃん}の活躍ぶりを見て、お前さんも嬉しく思ったであろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "黄三"
				},
				{
					"id": 711092504,
					"content": "#あの{M#小僧}{F#小娘}を？一通り見て回り、干し肉の飯を作ってくれて？私が喜んだと？私がもう少し若ければ、兄者を殴り倒していますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "文四"
				},
				{
					"id": 711092505,
					"content": "たわけが！お前さんの掌法は、若い頃のわし以下だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "黄三"
				},
				{
					"id": 711092506,
					"content": "まぁよい。よく聞け…残るはわしら数人の老いぼれのみ。こう縁ある者の事情でも探らねば、本当に蔵書と共に棺桶に入ることになりかねんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "黄三"
				},
				{
					"id": 711092507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "文四"
				},
				{
					"id": 711092508,
					"content": "わはは！まぁ、縁起でもない話はこの辺りでやめておくか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "黄三"
				},
				{
					"id": 711092509,
					"content": "そうだ、先ほどあの子たちが作ってくれた飯をお前さんも食うてみろ。わはは、万民堂よりウマいぞ。ほら、一口どうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄三"
				}
			]
		}
	]
}