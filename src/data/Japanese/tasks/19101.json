				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "最高だ…「キャッツテール」の酒は実にいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010102,
					"content": "えっと、なにテール？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "ん？ああ…旅人か、どうした…もしかして「キャッツテール」を知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010104,
					"content": "まあ、その感じじゃあ、聞いたことも行ったこともなさそうだな…お前、それは人生損してるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010105,
					"content": "「キャッツテール」には面白いドリンクがたくさんあってな、きっと旅人が飲んだことないものばかりだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010106,
					"content": "しかも店名の通り、可愛い猫たちが店内にいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010107,
					"content": "可愛い猫に囲まれながら美味しいドリンクを飲めば…あっという間に時間が過ぎていく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010108,
					"content": "「キャッツテール」は今営業中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "うーん、未成年に見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010111,
					"content": "でも大丈夫か！あのディオナっていう娘は、モンドで最高のバーテンダーだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010112,
					"content": "ノンアルコールのドリンクくらい…パパっと作ってくれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010113,
					"content": "それに、あの子もすごく可愛くてな、まるで子猫みたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010114,
					"content": "あ…こほんッ！ディオナには内緒にしてくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010115,
					"content": "とにかく、「キャッツテール」はすぐそこだ、気になるなら行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010116,
					"content": "俺は…うッ！その辺で酔いを覚ましてくる、今の俺には…5次会は無理だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 191010109,
					"content": "行ってみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}