					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "やあやあ！調子はどうだ！「荒瀧煌々虫相撲大修行」の進捗を私にも見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664002,
					"content": "ちょうどいいところに来たな、煙緋！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716664003,
					"content": "大恩人！今回の大会開催を手伝ってくれてあんがとな！あと、あの超かっこいい告知絵も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664004,
					"content": "でもよ、その様子を見るに…大恩人も、参加するつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664005,
					"content": "うん？だめなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664006,
					"content": "よく海外貿易をやっている大口の顧客がいて、一度彼女の重大案件の裁判を勝訴に導いたことがあってな。それでたくさんの贈り物をもらって、中に特別なオニカブトムシがいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664007,
					"content": "当時は飼い方が分からなかったから、ばあやに面倒を見てもらってたんだが…今見るとこのオニカブトムシ、結構屈強なことに気づいた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664008,
					"content": "虫相撲に参加しても、興ざめってことにはならないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664009,
					"content": "恩人姉さんを侮るな、鬼王。虫相撲の経験は無いが、驚くほど屈強なオニカブトムシが出てくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716664010,
					"content": "そうなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664011,
					"content": "だったら、「鬼王の右腕」が指揮する「赤紅一杵」に出てもらう。ダチ公ならどんな相手でも、冷静に戦える！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664012,
					"content": "その通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "旅人が私と戦うのか？いいだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664015,
					"content": "こういう遊びのコツはまだよく分からないが、上手く指揮ができなくても許してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664013,
					"content": "お褒めの言葉ありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
