			"dialogs": [
				{
					"id": 716664101,
					"content": "煙緋のオニカブトムシは強いな！流石はピンばあやが手塩にかけて育てたスペシャルオニカブトムシ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716664102,
					"content": "ほらな、恩人姉さんのオニカブトムシは厄介な相手だっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716664103,
					"content": "俺の部将は前回たくさん迷惑をかけたけど、「装備」と「仲間」の性能差は、時に指揮で補うのが難しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716664104,
					"content": "た、たたた、確かにな…ゴホンッ、だがダチ公はよく耐えた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664105,
					"content": "なるほどなるほど！虫相撲の面白さが分かってきたかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "「装備ガチ勢」"
				},
				{
					"id": 716664106,
					"content": "楽しいじゃないか！旅人、一斗、そして「花角玉将」！ここでこのまま遊んでいたいくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「装備ガチ勢」"
				}
			]
		},
