			},
			"dialogs": [
				{
					"id": 733052201,
					"content": "私をその「駒」に繋げて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733052202,
					"content": "つ…繋げる…？どうやってだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733052203,
					"content": "表面にある突起物を見つけて、それを私の瓶のスロットに差し込めばいい。ただそれだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733052204,
					"content": "えぇ…そんなものあったか？おまえの瓶ってツルツルしてるから…差し込めそうなところなんてないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733052205,
					"content": "それは、あなたに見えていないだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733052206,
					"content": "そ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733052207,
					"content": "だって、私が適当に言っただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733052208,
					"content": "…おいっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733052209,
					"content": "くすっ…はいはい、冗談はこのくらいにしておきましょう。我が主よ、私を持って、その「駒」に触れるだけで大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				}
			]
