	"talks": [
		{
			"id": 7330504,
			"completionStepIds": [
				7330504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330504",
							"2"
						],
						"stepId": 7330504,
