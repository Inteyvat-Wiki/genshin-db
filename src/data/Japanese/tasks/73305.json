			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050402,
					"content": "えっと…リルパァール、おまえ大丈夫か？なんでいきなり反応しなくなるんだよ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050403,
					"content": "しっ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "ちょっと待った、見ろ…なんか光りだしたぞ。いつもと様子が違うな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050406,
					"content": "ジンニーの魔瓶が微かに光を放つ、それは「駒」の振動と同調しているようだ。\\nまるで監獄の中を滴り落ちる水の音のように、時間が流れていくのが聞こえる…一生のように長く、一瞬のように短い。\\nだが、リルパァールは一言も発さない。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "やがて、あなたは霧の中に巨大な都市を見た——あの大きく、厚く、鈍く冷たい都市を。\\n大地が裂けて口を開き、ジュラバドのすべてを飲み込んだ…\\nただ、街門だけは山壁にそのままはめ込まれている。その醜い姿は、まるで古き世界の穢れをすべて集約したかのよう。だが、そのような姿を皆に見られずに済んだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "そこに、ジュラバドがあります。思い出しましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050409,
					"content": "頭が痛い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "えっ、どうしたんだよ、おまえたち…次に同じ様なことがある時は事前に言えよ！毎度毎度、ビックリさせるなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050411,
					"content": "ごめん、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "ふん！なにを言われようとも、オイラは怒ってるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050415,
					"content": "#くすっ…まるで子供みたい。よしよし、心配しないで、おチビちゃん。{M#彼}{F#彼女}を返すから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050416,
					"content": "#時期が来たら、{M#彼}{F#彼女}はあなたにたくさんの美味しい食べ物と…それに、うん、「ミラ」もあげよう。たしか、あなたたちの貨幣だったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050417,
					"content": "#正しくは「モラ」…なんで{M#俺}{F#私}が訂正を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "そうこなくっちゃ…今の記録しといたからな！美味しいものと、それにモラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050420,
					"content": "さて、子供の時間はこれで終わり。次はジュラバドに向かいましょう、我が主よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050421,
					"content": "どうして、そこに行く必要があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "どうしてと言われましても、私にも分からないのです…もしかしたら、理由なんてまったく重要じゃないのかもしれません。でも、私はそこに行かないといけない。ですから、我が主よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050423,
					"content": "どうしても理由が必要であれば、こうしましょう。私の過去、私の教訓を、あなたに見届けてもらうためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050428,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050429,
					"content": "脈絡がなくて…よく分からないけどさ。その言い方、まるでお別れを言おうとしてるみたいに聞こえるぞ、なにかあったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050430,
					"content": "ふふっ、なんでもない…ただ少し、あなたたちに見てもらいたいものがあるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050431,
					"content": "なんだよ、いい歳して誤魔化す気か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050432,
					"content": "とにかく、ついてきてください。ジュラバドの場所まで導いてあげますわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050424,
					"content": "ジュラバド…そこには何があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "何もありませんわ、何も残されていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050426,
					"content": "そこに残されているのは、幽霊の思い出と元に戻せない夢の欠片、それから復讐の甘い後味だけ…と言っておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050427,
					"content": "少し行き過ぎたお願いかもしれませんが…私の過去、私の教訓を、あなたに見届けてもらいたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050418,
					"content": "勝手に決めつけないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "#{M#俺}{F#私}は平気だよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "ふん！いっつも同じこと言ってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050404,
					"content": "リルパァール？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330506",
							"2"
						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "わっ！さっきまで「駒」の近くにいたのに、「シュパッ」とここまで来ちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050602,
					"content": "どんな原理なんだ、すごかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050603,
					"content": "ふふっ、もう一回試しますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050604,
					"content": "もう一回、もう一回！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "やめろって、子供かよおまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050608,
					"content": "無理もありません、座標がズレているから。多分老化のせいでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050609,
					"content": "あれ…ここって最初に来た峡谷だよな？ここに連れてきて、なにをするつもりなんだ？なにか見る価値のあるものでもあるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050610,
					"content": "おチビちゃん、質問が多すぎ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050611,
					"content": "おかしい…ここにあるはず…ああ、あった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050606,
					"content": "遠慮しとく、ちょっとめまいが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "うぅ…言われてみれば、オイラもちょっとぐらぐらするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "光る欠片がリルパァールの魔瓶に入っていくにつれて、あなたは自身の力も少し引き抜かれていくような感じがした…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "「シェロイは、まさにホラムディンだ。」\\n黄銅の仮面をつけた者はこう語った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "「汝に属する人間は一人残らず処す。汝の神の霊廟から諸々の偶像を滅ぼそう。汝のせいで我は卑劣となり、そして汝を墓へと帰すのだ。」\\n黄銅の仮面をつけた者はこう語った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "ジンニーの恍惚とした目から、あなたはジュラバドが闇に吞まれた時の光景を見た…\\nジュラバドは古き時代より水が溜まりゆく大池のようなところであったが、今や住民たちは洪水のように四散して逃げている。\\n知性のないジンニーが冷酷な機械や兵士たちの武具から湧き出て…朱色の酒、石榴の汁がそれと共に爆ぜて散っていく…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "石榴が転がりひびが入って、すぐに踏まれて泥と一体となり混ざる…豊満なものも干からびたものも、高貴なものも卑賎なものも…鮮やかな赤色の果実が、次々とホラムディンの到来を叫んでいる——生命の喜びと復讐の愉悦。\\n汁の味は甘美で芳醇、城全体から泉が湧き溢れ、赤色の海となる…\\n海はまず奴隷を沈め、やがてその主も夜の海原に浮かんで悲鳴を上げた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "最後に、黄銅の仮面をつけている王を見た。彼は影に隠れ、シリンの懐に身を潜める…\\n彼女の顔は老いてぼやけ、生命と知性の痕跡は夜風の塵のように消え去った。\\nそして、既に黒い魔獣と化したキスラ王…その者たちは皆あなたの肉親だ。しかし、あなたはこれを大いに喜んでいる——報いによって、あなたは狂喜しているのだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "ジュラバドよ、その傷はもう治せない、その恥は衆目に晒された…\\nこのことを知った人間は、誰しも必ず拍手して歓喜の声を上げるだろう——\\nなぜなら、あの終わりのない暴虐を体験したことない人間が、どこにいると言えよう？",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "「ジュラバドよ、その傷はもう治せない、その恥は衆目に晒された…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050909,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "オルマズドはかつてリルパァールの愛する人であり、ジンニーの愛によって羊飼いから人間の王となりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050912,
					"content": "彼こそ凡人を越える伴侶だと私は思うと、愚かにも私は彼のその両の目に惚れました…しかし、王の虚栄と利己心がやがて彼を掴んだのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050913,
					"content": "彼は儚い凡人の諸王と何ら変わらなかった…征服と迫害の迷夢の中を歩き、流砂を礎に宮殿を建てた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050914,
					"content": "#だから、{M#君}{F#あなた}が彼を謀殺した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "前に言いましたね、彼に罰を与えたと。父から子供、三代に渡ってです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050916,
					"content": "キスラ·パーヴェズラヴァン、シリン、すべて私の肉親…私は血の陰謀、蜜の極刑、それと狂暴な野望を、あの者たち全員に罰として与えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050917,
					"content": "そして、それだけじゃありません…そう、それだけでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050918,
					"content": "「罰」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "虚栄なパーヴェズラヴァン、我が愛しい息子よ…彼は無限の権力を欲したから、それをあげたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050921,
					"content": "彼のためにジンニーの残魄で駆動する機械を設計しました。深き黒い夢の中から、流れる水のように人工物を生産できる巨大機械を作るよう導きました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050922,
					"content": "それが無限の富をもたらしたと同時に、労働する者の生命力を奪い、農民の財を奪った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050923,
					"content": "王公と大商人たちは涙を流して称賛した——これぞ凡人の凱旋であり、これぞ奴役の終わりだと。でも私には分かる、私だけは分かっていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050924,
					"content": "奴隷の廃止は、奴隷を果てない残虐の中で奴役することの始まりであると——主は奴隷を養う義務から解放され、そして奴隷は飢えをしのげるという小さな恩恵を剥奪された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050925,
					"content": "オ…オイラ、だんだん頭がこんがらがってきたぞ…いったいなんの話をしてるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050926,
					"content": "貧苦には憎しみが伴い、憎しみは野望を繁殖させる…富は貪欲を蔓延させ、貪欲も野望を加速させる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050927,
					"content": "野望は彼を王妃シリン——同時に彼の実の姉に、知性のない奇形のジンニーを産ませた…そして、彼女の苦痛が私を喜ばせ、私に力を与えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050928,
					"content": "…それにより、私は彼らの肉親を育てることができたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050929,
					"content": "それって、シェロイのこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "シェロイ、すなわち「黄銅の仮面」ホラムディンのことです。賤民と奴隷たちは彼を女主人の使者、苦難の中に降臨した救世主だと信じていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050931,
					"content": "そのため、彼は彼らに正義を抱き…滅亡を抱くよう導いたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050935,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050936,
					"content": "おや？まだいたのか、おチビちゃん…どうして何も喋らない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050937,
					"content": "うぅ…オイラ、全部は理解できなかったけど…でも、すごく怖かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050938,
					"content": "大丈夫、気にしないで…先ほど話したのが私の過去のすべて、そして私の運命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050939,
					"content": "おぅ…オ…オイラ、なにをどう言えばいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050940,
					"content": "あなたが付き添ってくれたおかげで、私はようやく女主人の花園に再び戻って来られました。本当に感謝しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050941,
					"content": "えっ…急にそんなこと言って、どうしたんだよ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050942,
					"content": "ジュラバドこそ、私の運命の地。この都に戻らなければいけない。まだ使命が私を待っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050943,
					"content": "えっと…昔、いろんな間違いをしちゃったから、戻って償おうとしてる…ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050944,
					"content": "間違い…？くすっ…私は何も間違っていない。でも、私の子供たちはまだそこにいる。彼女とシェロイは…きっととても寂しがっているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050945,
					"content": "それってつまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "漆黒の力がますます強まってきました…それに相対することができるのは、母の力だけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050947,
					"content": "かつての私は漆黒のアビスを利用して、憎んでいる相手に罰を与えられると思い込んでいました…その私も、今や報いを受けた…ジュラバドに行き、その報復に相対することもまた私の使命となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050948,
					"content": "我が主よ…申し訳ありません。もっと長くお傍にいて…あなたのことをもっと知りたかったのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050949,
					"content": "でも、私には分かります。運命は必ず私たちが再会するよう導いてくれることを。あなたは腐敗に侵蝕されない気質をお持ちです。私の選択が正しいものであると…信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050950,
					"content": "#{M#君}{F#あなた}の選択…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "普通なら、主がジンニーを選ぶのではなく、ジンニーが主を選ぶのです。たとえ離れようとも、私たちの繋がりがあっけなく終わることなどありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050953,
					"content": "ですから…私からの最後のプレゼントを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050954,
					"content": "私を耳の近くに…もう一度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050955,
					"content": "あなたは、魔瓶をゆっくり耳元へと持っていった…\\n微笑みの後、誰かがこの上なく雅びで優しい言葉を囁いた…\\n彼女が囁く言葉はまるで流れる泉のようで、測り難いものであったが、\\nあなたは一言も漏らさず全てを記憶した。\\n最後の言葉が消えると、あなたの耳介に残ったのは、微かな涼しい余韻のみ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "彼女の教えにより、あなたは古代の韻文を理解した…\\nしかし、彼女は二度と喋らなくなってしまった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "おい…見ろよ、瓶の光が弱くなったぞ…リルパァール、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050958,
					"content": "リルパァール…リルパァール…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050959,
					"content": "（瓶の光が次第に弱まり、そしてまた明滅する状態に戻った。だが、彼女の声はもう聞こえてこない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050960,
					"content": "彼女は行ってしまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "そっか…つまり、本当にお別れなんだな…これから先、またあいつと会える機会ってあるのかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050963,
					"content": "はぁ…オイラたちも…戻るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733050961,
					"content": "ジュラバドが…彼女を待ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "もう行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "「黄銅の仮面」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "それは…ホラムディン、すなわち黄銅の仮面を被ったシェロイ王のことです。「女主人の使者」、「貧乏人と奴隷の救世主」…ふふふっ、そして賢い嘘つき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050934,
					"content": "最後に、彼は自分の後を追う人々を漆黒の滅亡へと導いた…このジュラバドと共に、裂けた大地に、その漆黒の口に吞まれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733050919,
					"content": "ジュラバドの最期について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "つまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
