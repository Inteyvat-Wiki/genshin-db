			"dialogs": [
				{
					"id": 733051201,
					"content": "…気をつけて。地下深くから、妙な震動を感じますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733051202,
					"content": "えっ？いったいなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733051203,
					"content": "なんてことはない…ただの予行演習よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 733051204,
					"content": "なんだ、なんてことはない、ただの「予行演習」か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733051205,
					"content": "って、待てよ——「予行演習」ってなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733051206,
					"content": "しーっ…来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				}
