				"objectNames": [
					"キスピ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910401,
					"content": "うむ…ここは辛抱だな。静かになったら、これらの石を「宝の岩」に食べさせよう…ふへへ、石を持ってきてくれてありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910402
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910402,
					"content": "もっと素晴らしい石を生やしてくれ、「宝の岩」よ。へへ、一つ…一つ、二つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスピ"
				}
			]
		},
		{
			"id": 7509105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
