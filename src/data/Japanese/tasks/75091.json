				"objectNames": [
					"キスピ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "おお、本当にもっときれいな石が出てきたぞ。この光景を見るのは二回目だけど、やっぱり不思議だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910502,
					"content": "ふへ、へへっ、疑り深いよそ者よ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910503,
					"content": "これでやっと…「宝の岩」の偉大さが分かっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910504,
					"content": "ああ、「宝の岩」を…君たちが持ってきてくれた石のおかげで、「宝の岩」の力がますます強くなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910505,
					"content": "最後にはどんな姿になるんだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910506,
					"content": "そう言われたら、オイラも興味が湧いてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910507,
					"content": "石を食べて、もっといいやつを吐き出す…一体なんでそんなことができるんだ？いっそ…開けてみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910508,
					"content": "な、何を言っている！？絶対にだめだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910509,
					"content": "ほ、本気で「宝の岩」を開けたいなら、俺の屍を超えていけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910510,
					"content": "うぅ、ただ言ってみただけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910511,
					"content": "ふん、「宝の岩」のために石を持ってきてくれたことに免じて…今回は許してやる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910512,
					"content": "お、おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910513,
					"content": "へへ、俺には分かる——もし「宝の岩」にもっといい石を食べさせれば、きっと素晴らしい変化が起こるってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910514,
					"content": "異郷の旅人よ、以前よそから来た行商人から聞いたことがあるんだ。砂漠には、不思議な力を秘めた、特別な輝きを放つ石があると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910515,
					"content": "たしか…そうそう、「サングイト」だ。もし、その石を「宝の岩」に食べさせれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910516,
					"content": "きっと、きっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910517,
					"content": "#うーん…{NICKNAME}、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910518,
					"content": "試してみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "ま、そうだな。なにが起こるか気になるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910520,
					"content": "もし、もし「サングイト」が見つかったら…一つだけでいいから、渡してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスピ"
				}
			]
		},
