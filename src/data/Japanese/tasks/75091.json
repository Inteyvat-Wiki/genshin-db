					"キスピ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "うわぁ、ほ、本当に生えてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910302,
					"content": "「宝の岩」ってすごいな…あ、いや、キスピ、おまえが「宝の岩」の上に置いたんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910303,
					"content": "…ふぇっふぇっふぇっ、そんなバカなことするわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910304,
					"content": "君たちが持ってきてくれた石のおかげで、「宝の岩」がさらに活動的になった。ほら、聞こえるだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910305,
					"content": "まるで地中のマグマが脈打つような…ああ、まさに鼓動の音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910306,
					"content": "やはり、石を食べさせて…正解だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910307,
					"content": "うぅ、なにも聞こえないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}は聞こえるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910309,
					"content": "普通の岩にしか見えないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910313,
					"content": "ふへへ…ああ、偉大なる異郷の客人よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910314,
					"content": "もし可能なら、石をもっと持ってきてくれないか？もっと質がよくて、きれいな石がほしいんだ…「宝の岩」は絶対に君たちをがっかりさせたりしないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910315,
					"content": "きっと、きっと、この岩にとってもいいことのはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910316,
					"content": "なんか、まんまと罠にはまっちゃった気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}、おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910318,
					"content": "もっといい石が手に入るのなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "試してみる価値はある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910320,
					"content": "ふぇっふぇっ…なら、これまでよりももっと素晴らしい石を探してくれ…ああ、もっと素晴らしい石があれば…「宝の岩」の力もさらに強くなるに違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910311,
					"content": "宝の岩が聞こえる…「わあっ！！！」って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "そんなわけないだろ！驚かすなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7509104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
