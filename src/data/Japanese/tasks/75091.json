					"キスピ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "一つ、二つ、うむ、三つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910102,
					"content": "うむ、一つ…二つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910103,
					"content": "うわっ、変なやつがいるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910104,
					"content": "ふぇっふぇっふぇ…変なのはそっちのほうだろう。…ここは異郷の者が来ていいような場所じゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910105,
					"content": "ここって立ち入り禁止なのか？それとも…聖地とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910106,
					"content": "いや、俺が偶然見つけた宝の場所だ。こっちに来てくれ。聞こえないか？この特別な石…「宝の岩」から…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910107,
					"content": "低い鳴き声のような音が聞こえるだろう？まるで…そう、まるで呼吸音のような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910108,
					"content": "石も大変そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "ただ呼吸してるだけだろ？なにが大変なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910112,
					"content": "石が…呼吸するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910113,
					"content": "呼吸だけじゃない。耳を近づけると、律動まで聞こえるんだ。この荒々しい肌の下で、石が擦れ合う音がな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910114,
					"content": "ふへ…ふへへっ…実に美しい音だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910115,
					"content": "しかも、小さな石をやれば、もっときれいで質のいい石を吐き出してくれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910116,
					"content": "本当に不思議だろう？ほら、この宝石がそうだ。一つ、二つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910117,
					"content": "ああ、さっきはその宝石を数えてたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910118,
					"content": "そうだ…俺は気づいたのさ。この「宝の岩」が色んな石を食べて、さらに強くなったことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910119,
					"content": "これはきっと、奇跡に違いない。ああ、「宝の岩」よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910120,
					"content": "なんか怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "へ、へへ…君たちみたいなよそ者に信じてもらえるなんて、ハナから思っちゃいない。自ら試してみないことには、誰も信じないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910123,
					"content": "俺だって、集めた鉱石をたまたま「宝の岩」の横に置いた時に、初めて気づいたからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910124,
					"content": "そうだ…君たちも試してみるといい！そしたら信じる気になるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910125,
					"content": "近くの石は一通り食べさせたから、新しい石を食べさせてやらないと…でも、俺が石を探しに行くわけにはいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910126,
					"content": "えっ、なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910127,
					"content": "当然だ！俺は「宝の岩」を見守ってないといけないだろう？もしも俺がいない間に、地下へ潜り込んでしまったら大変じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910128,
					"content": "もう長いことここで見守ってるんだ…持ってる石は全部食べさせた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910129,
					"content": "とにかく、新しい石を持ってきてくれ…！そしたらこいつに食べさせて、俺が言ったことが本当だと証明してみせる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910130,
					"content": "うーん、まったく信じられないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910131,
					"content": "#どうだ、{NICKNAME}、試してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750910132,
					"content": "まあ、たかが石だし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "へへ、じゃ、石のことは頼んだぞ…きっと「宝の岩」からもっと素晴らしい宝石が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910121,
					"content": "信じる気にはなれないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "#{M#俺}{F#私}も呼吸できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "そうだぞ、呼吸してることのどこがすごいんだよ…って、そうじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
