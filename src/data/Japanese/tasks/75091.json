			"dialogs": [
				{
					"id": 750910201,
					"content": "うむ…ここは辛抱だな。静かになったら、「宝の岩」にこの石を食べさせよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "キスピ"
				},
				{
					"id": 750910202,
					"content": "もう少し待てば…へへっ、もっといい石が生えてくるはず。ふへへっ、一つ…一つ、二つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスピ"
				}
			]
		},
