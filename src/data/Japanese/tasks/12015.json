			},
			"dialogs": [
				{
					"id": 120150401,
					"content": "八重様に会いに来られたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150402
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 120150402,
					"content": "先ほどまで中にいましたが、八重様の動向はいつも謎めいているので、いつ席を離れてもおかしくありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150403
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 120150403,
					"content": "とりあえず中に入って確かめてみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲城蛍美"
				}
			]
		},
		{
			"id": 1201505,
			"completionStepIds": [
				1201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201505",
							"2"
						],
						"stepId": 1201505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150501,
					"content": "よもや休憩時に、神社の貴賓を迎えるとはな。ふふっ、妾に会いに来てくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150502,
						120150505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150502,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150503
					]
				},
				{
					"id": 120150503,
					"content": "ふん、口は達者じゃが、目は嘘をつくのが苦手なようじゃ。何か用事があって妾を訪ねたんじゃろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150504,
					"content": "まあじゃが、その返答は少なくとも、妾をいい気分にさせたことは確かじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150508,
					"content": "言ってみるがいい、何を聞きたいんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150509,
					"content": "最近、将軍が静養を取ってるって聞いたんだ。それで、稲妻外海の雷が不安定な状態になってるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150510,
					"content": "噂によると、雷は将軍の意志と関係があるから、みんな将軍の具合が悪いんじゃないかって思ってるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150511,
					"content": "天領奉行の事務には彼女の決定が必要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150512
					]
				},
				{
					"id": 120150512,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150513,
					"content": "まあ、汝らになら隠す必要はないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150514,
					"content": "将軍様はあの戦いの後、心がこじれて、人が変わってしまったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150515,
					"content": "えっ——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150516,
						120150517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150516,
					"content": "人が変わった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150518,
					"content": "将軍様の力は日々衰えておる、汝があのとき強く打ちすぎたせいじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150519,
					"content": "あやつにとって敗北は何よりも重い一撃、それにこの前妾が会いに行った時、うっかり三色団子と娯楽小説を忘れてしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150520,
					"content": "ああ、妾の旧友よ、甘味を食べながら娯楽小説を読むことができず、心が乱れて泣き喚いてしまうとは。しくしく、かわいそうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150521,
					"content": "そんなことで泣きわめく神がいるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150522,
						120150523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150522,
					"content": "信じるんじゃなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150524,
					"content": "ふん、仕方ないじゃろ。妾からすれば、汝らの「心配」は妾の嘘と同じように無意味なもののように聞こえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150525,
					"content": "あれは永遠を求める影じゃぞ、凡人の命などあやつからすれば須臾にすぎぬ。凡人に安否を心配されてどうしろと言うのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150526,
					"content": "てことは、無事なんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150527,
					"content": "詳しい状況は妾も知らぬ。静養したいと言っておったし、妾もこれといった用がなかったゆえ、自分から面倒に巻き込まれに行く必要もなかったしのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150528,
					"content": "じゃが、雷の件は妾も耳にしておる。「あやつの意志に変化が起きた」という点については、些か有り得ないことでもないじゃろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150529,
						120150530
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150529,
					"content": "じゃあ、見に行ってみないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150531,
					"content": "静養中に会えるのは、稲妻でも妾だけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150532,
					"content": "じゃが、なぜ妾が汝らの手助けをせねばならぬのじゃ？浮世のすべてをとっくに見飽きた妾の心を、いったい何で動かそうと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150533,
						120150534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150533,
					"content": "これは稲妻の人々のため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150535,
					"content": "はははっ、その答え、気に入ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150536,
					"content": "これは通行証じゃ。門番の奥詰衆に見せれば、中に通してもらえるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150537,
					"content": "ありがとう！神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150538,
					"content": "さっきの質問は冗談じゃったが、あのように答えたからにはしっかりとやってもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150539,
					"content": "そうじゃ、通行証も後で妾に返すんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150534,
					"content": "これは影のため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150530,
					"content": "何があったか心配。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150523,
					"content": "本当にいるかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150517,
					"content": "そんな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150505,
					"content": "聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150506
					]
				},
				{
					"id": 120150506,
					"content": "いくらなんでも冷たすぎるのではないか？妾は汝の命の恩人じゃぞ、あいさつの一つもせぬのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150507,
					"content": "まあ、それが汝の魅力の一つでもあるがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
