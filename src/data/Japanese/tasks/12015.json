					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150802,
					"content": "あなたたち、どうやって入ってきたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150803
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150803,
					"content": "無断でこの地に入る者は、直ちに排除します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150804
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150804,
					"content": "待て、オイラたちだ！なんでまた敵を見るかのような感じになってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150805,
					"content": "もう仲直りしただろ。ここに入ったのも正当な手段を使ってだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150806,
					"content": "いけません、武力行使は、禁則事項でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150807
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150807,
					"content": "とにかく、お帰りを。私の静養を邪魔しないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150808,
						120150809
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150808,
					"content": "「禁則事項」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				},
				{
					"id": 120150810,
					"content": "知る必要はありません。これが私の静養時の状態です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150811
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150811,
					"content": "#うぅ、{NICKNAME}、なんかちょっと変じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150812,
						120150813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150812,
					"content": "人形にも静養が必要なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150814,
					"content": "この身に休息は必要ありません。しかし私はあくまでも「内なる者」の協力者、静養が彼女の意志であるなら、その願いに従うまでです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150815
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150815,
					"content": "てことは、「静養」は中の影が干渉してるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150816,
					"content": "でも、なんでだろう？たとえ将軍が外で活動してても、「一心浄土」には影響しないはずだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150817,
					"content": "あんなに大きな庭園もあるんだし、静養にぴったりな環境じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150818,
					"content": "彼女の願いです。それ以外言うことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150819,
						120150820
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150819,
					"content": "みんな将軍のことを心配してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150821,
					"content": "今の私が外へ行っても、何もやることはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150822
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150822,
					"content": "事務を処理しないのも、それをすることができないからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150823
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150823,
					"content": "ん？どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150824
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150824,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150825
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150825,
					"content": "すべて禁則事項です。はぁ、もう私に話しかけないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150826
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120150826,
					"content": "#どうしよう、{NICKNAME}、まったく会話が進まない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150827,
						120150828
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150827,
					"content": "病気になったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150829,
					"content": "あなたたちでしたか、お久しぶりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150830
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150830,
					"content": "将軍はいま都合が悪いので、私に会いたければ直接中へ来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				},
				{
					"id": 120150828,
					"content": "壊れちゃったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150820,
					"content": "みんな会いたいと思ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150813,
					"content": "昔からこんな感じだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150809,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				}
			]
		},
		{
			"id": 1201509,
			"completionStepIds": [
				1201510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201510",
							"2"
						],
						"stepId": 1201510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150901,
					"content": "急にオイラたちを中に引き入れるなよ…びっくりしたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150902,
					"content": "あら、何を慌てているのですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150903
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150903,
					"content": "外の将軍は壊れちゃったのか？修理しないとだめなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150904,
					"content": "その心配は必要ありません、あれは私の意志です。将軍のほとんどの機能は、私が一時的に停止しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150905
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150905,
					"content": "今の将軍は事務も処理できず、「私」として振る舞うこともできません。ですのでいっそのこと「静養」を皆に告げたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150906,
						120150907
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150906,
					"content": "それでずっと「禁則事項」と…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150908
					]
				},
				{
					"id": 120150908,
					"content": "言ったはずです。稲妻の「永遠」について、もう一度よく考える必要があると。それには時間が必要になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150909
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150909,
					"content": "そして私が考えを終えるまでの間、基となる規則に則って動く将軍が間違いを起こしてはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150910
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150910,
					"content": "将軍にスイッチみたいなものはないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150911,
					"content": "ありません。創造した時は停止することを考慮していませんでしたので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150912
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150912,
					"content": "それに当時の私は、未来の私が将軍の運行規則を変える可能性があると考えた上に、そのようなことは「永遠」にふさわしくないと思ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150913
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150913,
					"content": "自分にも厳しいんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150914
					]
				},
				{
					"id": 120150914,
					"content": "そのため、予期せぬ事態に対する保険として、将軍は規則修正に対して非常に完璧な防御機能を備えています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150915
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150915,
					"content": "私にとって、人形の規則を直接変えるよりも、「永遠」の形についての考えが終わるまで、いくつかの機能を一時的に停止する方が効率的なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150916
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150916,
					"content": "そういうことか。じゃあ、稲妻外海の雷が荒れ狂ってるのは、将軍の機能がいくつか停止したからなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150917,
					"content": "雷が荒れ狂う？それは初耳ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150918
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150918,
					"content": "えっ？知らなかったのか？実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150919,
					"content": "なるほど。外界の雷がそのようなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150920
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150920,
					"content": "厄介な状況なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150921,
					"content": "操作の手違いで、そういうこともあるんです。あとで私が将軍を調整すれば問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150922,
						120150923
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150922,
					"content": "そんなことだったの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150924,
					"content": "そんな目で見ないでください。こういった操作は今までにやったことがないんです。将軍の構造は複雑なもので、調整をするだけでも問題が出てくるものなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150925
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150925,
					"content": "これは言い訳ではありませんよ。ええ、事実を言っているだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150926
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150926,
					"content": "大丈夫、気にするな。解決できればそれでいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150927,
					"content": "「永遠」について考えに進展はあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150928
					]
				},
				{
					"id": 120150928,
					"content": "いえ、進むべき方向は見つけたのですが、未だに矛盾が存在しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150929
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150929,
					"content": "しかし、それほど急ぐ必要はありません。慎重さを欠いて、結論を急いてしまっては本末転倒ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150930,
						120150931
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150930,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}と気分転換に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150932,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150933
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150933,
					"content": "みんな将軍の元気な姿を見れば、外で噂されてる憶測とかもなくなると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150934
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150934,
					"content": "それに場所を変えて気分転換すれば、新しい考えが思いつくかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150935
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150935,
					"content": "私に、この「一心浄土」を離れろと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150936,
						120150938
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150936,
					"content": "皆にとって有益なことかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150937
					]
				},
				{
					"id": 120150937,
					"content": "確かに、そうですね。今の将軍は私の代わりに事務を行えないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150940,
					"content": "わかりました。外に行ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150941
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150941,
					"content": "気分転換に行くのですから、私のことは「影」と呼んでくれて構いませんよ。堅苦しい呼び方はあまり好きではないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150942
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150942,
					"content": "えっ？でも、オイラたちの目の前にいるのは影の意識だろ？意識はここから離れられるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150943
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150943,
					"content": "もちろん方法はあります。自分で自分を監禁するようなまねはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150944
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150944,
					"content": "おう、じゃあもう心配はいらないな！これからはオイラたちがおまえのガイドだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150945
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150945,
					"content": "ガイド？なんですかそれは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150946
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150946,
					"content": "今の稲妻で、なにが美味しくてなにが面白いか、オイラたちが紹介してやるってことだ！よし、じゃあ出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150938,
					"content": "長いこと外に行ってないんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150939
					]
				},
				{
					"id": 120150939,
					"content": "私にとって必要なことではありません。しかし、あなたの誘いであれば…気分転換も悪くないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150931,
					"content": "外に行ってみない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150923,
					"content": "すごく単純な理由だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150907,
					"content": "影がやってたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150908
					]
				}
			]
		},
