			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トーマ",
					"九条鎌治",
					"一平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150201,
					"content": "もし雷の件について、天領奉行の力を借りることができなければ、非常に危険な状況に陥る可能性もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150202
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150202,
					"content": "これは何も我々の本心じゃない。ただ今は人手が本当に足りないんだ、理解してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150203
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150203,
					"content": "そうですよ、だからこそ話し合いが必要なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150204
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150204,
					"content": "おーい、トーマ！なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150205,
					"content": "君たちか、ちょうど君たちが稲妻に残した影響について話していたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150206,
						120150207
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150206,
					"content": "奇遇だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				},
				{
					"id": 120150208,
					"content": "やあ、以前は柊さんの手紙を送り届けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150209
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150209,
					"content": "お二方のご友人でしたか。僕は九条家の次男である鎌治様の付き人です、一平って呼んでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150210
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150210,
					"content": "何か困りごと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150211
					]
				},
				{
					"id": 120150211,
					"content": "ああ。これまでの三奉行の仕事は、将軍様のために情報を集め、指示された任務を執行することだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150212
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150212,
					"content": "だけど近ごろ、将軍様が静養を告げられ、誰にも会わないようにしているんだ…つまり、もうオレたちの代わりに物事の判断をしてくれる人がいないってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150213
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150213,
					"content": "将軍様に心の整理をする時間が必要なのは、もちろん理解している。だけど時期を同じくして、稲妻外海で雷が荒れ狂い始めたのも事実なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150214
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150214,
					"content": "あれは鎖国意志の表れって聞いたけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150215
					]
				},
				{
					"id": 120150215,
					"content": "その通り。長きに渡り、雷の規模や形態に変化が起きたことは一度もなかった。けど現在、それらが稲妻の島々に近づきつつあるみたいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150216
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150216,
					"content": "えっ！？それって将軍に今、稲妻を滅ぼそうとしてる意思があるってことか？それともオイラたちに復讐を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150217,
						120150220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150217,
					"content": "それはいくらなんでも大人げない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150218
					]
				},
				{
					"id": 120150218,
					"content": "そうだぞ。それに、オイラたちに復讐したかったら、普通の雷でも全然十分だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150219,
					"content": "——ってそれも怖いって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150223,
					"content": "ハハハッ、そこは安心してくれ。オレたちが心配しているのは将軍様なんだ。今まで、あのお方の意志が揺らいだことなんて見たことなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150224
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150224,
					"content": "それに、璃月の神が近頃去ったことを思うと、どうも良い兆しには思えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150225
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150225,
					"content": "雷が荒れ狂うのは、将軍様の体に何か起きたからだと考える人も多い。誰にも会わないのは、悪い影響を拡大させないためだとかなんとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150226,
						120150227
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150226,
					"content": "確かに心配になるのも頷ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150228,
					"content": "だから、変な噂が広がる前に、お嬢に頼まれて天領奉行と対策を練っていたところなんだ。もし混乱が起きた時に対処できるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150229
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150229,
					"content": "しかし、そうは言っても天領奉行の内部は今、非常に不安定な状態なんだ。他の家門に対して「九条家」の制御が効かなくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150230
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150230,
					"content": "どうして、そんなことになったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150231,
					"content": "九条家がファデュイと結託し、稲妻を破滅に追い込んでしまった。今は将軍様の裁きを待っている最中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150232
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150232,
					"content": "ただ将軍様からの命が下されていないだけで、天領奉行の人間が交代することは皆が分かりきったこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150233
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150233,
					"content": "簡単に言えば、配下はもう命令を聞いてくれないのに、仕事は同じようにやらなきゃいけないってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150234
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150234,
					"content": "孝行様の体がまだお元気であれば、何か方法もあったのではと思いますが…今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150235
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150235,
					"content": "あの時、真相を見抜けず、父を止めることもできなかった。そして父の代わりに当主の仕事をやってる今もなお、内乱を鎮めることができていない。全部、僕の力不足のせいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150236
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150236,
					"content": "そんなことおっしゃらずに、鎌治様、元気を出してください。少なくとも若旦那が戻ってくるまで耐えなければいけません…今の九条家にはもう、些末な変化にさえ対応する力がないんですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150237
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150237,
					"content": "ああ、それもそうだな。兄さんもいま切羽詰まってる状態だ、迷惑はかけられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150238
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150238,
					"content": "それじゃ、トーマ、先ほどのことはまた後日話そう。僕は今から「鷹司家」の当主、鷹司進に会いに行ってくる。今この状況を統括できる人物は彼くらいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150239
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150239,
					"content": "ああ、分かった。今後のためにも、早く天領奉行内部のことを解決しておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150240
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150240,
					"content": "では僕もお供します、鎌治様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150241
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150241,
					"content": "いや、僕一人でいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150242
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120150242,
					"content": "えっ、そうですか…ではお気をつけて、いってらっしゃいませ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150243
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150243,
					"content": "でも、雷のことも天領奉行のことも、元はと言えばぜんぶ将軍が急に静養を始めたことが原因なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150244,
					"content": "このまま話を進めても、びくびくするだけで解決しないと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150245,
					"content": "じゃあ、彼女に出てきてもらうのは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150246
					]
				},
				{
					"id": 120150246,
					"content": "え？そんなことできるんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150247
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150247,
					"content": "わからない。でも試してみる価値はあると思うぞ。出てきてくれるかは、将軍の気分次第だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150248,
					"content": "なんとか糸口が見つかったみたいだね。じゃあ、君たちにお願いしてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150249
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150249,
					"content": "みんな将軍様のことを心配しているんだ。もしあのお方に会えれば、要らぬ噂も自然と消え去ることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150250
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150250,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150251
					]
				},
				{
					"id": 120150251,
					"content": "#ありがとう、{NICKNAME}。また君に借りができたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150252
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 120150252,
					"content": "こんな状況で将軍に会えるかもしれない人って、あいつしかいないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150253
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150253,
					"content": "じゃあさっそく、鳴神大社に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150227,
					"content": "雷が荒れ狂うのにはきっと原因がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150220,
					"content": "彼女のことが怖いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150221
					]
				},
				{
					"id": 120150221,
					"content": "そ、そんなことないぞ！オイラたちに負けたやつのことなんか、怖いもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150222,
					"content": "オイラは、将軍が怒ってるかどうかちょっと心配なだけだぞ。うん、ほんのちょっとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150207,
					"content": "嫌味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				}
			]
		},
		{
			"id": 1201504,
