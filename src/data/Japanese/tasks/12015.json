			"trigger": {
				"objectNames": [
					"毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150701,
					"content": "将軍様は現在静養中です、誰も会うことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150702
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150702,
					"content": "オイラたち、神子からもらった通行証があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120150703,
					"content": "ご冗談を。今まで宮司様が他の方に通行証を渡したことはありません。それが例え、あなたたちのように名高い旅人であろうとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150704
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150704,
					"content": "将軍様はそんな八重宮司様を信頼しているからこそ、この通行証に効力を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150705
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150705,
					"content": "って、えっ…これは、本物！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150706,
						120150707
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150706,
					"content": "これの偽物は作れないんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				},
				{
					"id": 120150708,
					"content": "分かりました。将軍様の命に従い、あなた方を止めるわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150709
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150709,
					"content": "失礼しました、どうぞ中へ。しかし静養中の将軍様に対して、くれぐれも失礼のないよう、お気を付けください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "毅"
				},
				{
					"id": 120150707,
					"content": "神子様に直接聞いてみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				}
			]
		},
		{
			"id": 1201508,
			"completionStepIds": [
				1201508,
