			"dialogs": [
				{
					"id": 760300501,
					"content": "ぐすっ…ん？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "リェカ"
				},
				{
					"id": 760300502,
					"content": "きれい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "リェカ"
				},
				{
					"id": 760300503,
					"content": "これで帰れるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300504,
					"content": "なるほど！石を拾いながら歩けば、「霜月の里」にたどり着けるわけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300505,
					"content": "（コロンビーナは「神」扱いされるのは嫌だって言ってたけど、やっぱり困ってる人を放っておけないみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "あ、でも絵のほうは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300507,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300508,
					"content": "絵はあとで完成させればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300509,
					"content": "人が自分たちの「家」に帰るところを見るのが好きなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
