			"dialogs": [
				{
					"id": 760300301,
					"content": "結構採れたな。これで十分じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300302,
					"content": "そろそろ戻ろうぜ。絵を完成させないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300303,
					"content": "ぐすっ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "リェカ"
				},
				{
					"id": 760300304,
					"content": "まずい！誰か来るぞ、早く隠れろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300305,
					"content": "うぅ…ここはどこ…お母さん…おうちに帰りたいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "リェカ"
				},
				{
					"id": 760300306,
					"content": "「霜月の子」のやつみたいだな。迷子か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300307,
					"content": "助けてあげよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "いいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300309,
					"content": "なに言ってるんだ。当然だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300310,
					"content": "「霜月の子」は「よそ者」に強い警戒心を持ってるはず。こんな時間に、頭に角のない人から声をかけられたら、かえって怖がって逃げちゃうかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300311,
					"content": "そ…そうかもしれないけど、放っとくわけにもいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300312,
					"content": "うん…ついて来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300313,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
