			"dialogs": [
				{
					"id": 760300101,
					"content": "なんだ？珍しい。花畑を飾り付けてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300102,
					"content": "ううん…この子たちが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300103,
					"content": "この子たちって…月霊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300104,
					"content": "そう——この石はクーヴァキを吸収すると微かに光を放つの。この子たちはこれが大好きなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300105,
					"content": "なるほど…それで石を床に置いて遊んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300106,
					"content": "こっち来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300107,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300108,
					"content": "おぉ！高いところから見ると絵に見えるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300109,
					"content": "少し欠けてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "石が足りないみたいだね。もう少し集めてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300111,
					"content": "えっ、今から出かけるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760300112,
					"content": "うん、月明かりがよく届く場所があって、こういう石がたくさん採れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300113,
					"content": "一緒に行こうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "いいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760300115,
					"content": "じゃ、多めに採ってこようぜ。どんな絵になるか楽しみだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
