				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715070101,
					"content": "この効果は私が思っていたよりもずっと良い。現象もデータもすべて記録されている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070102,
					"content": "そして何より重要なのが、ここの黒泥がすべて取り除かれた点だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070103,
					"content": "ただ、うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070104,
					"content": "なんでまだ不満そうな顔してるんだ？鉱区がきれいになったんだし、いいことじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715070105,
					"content": "いや…前にヘディーヴと一緒に分析した時、黒泥を出している地脈の出口は鉱区にあるという結論に至ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070106,
					"content": "だが、地脈の出口がそう簡単にきれいになるはずがない。つまり、その出口は他にあることになる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070107,
					"content": "鉱区を除いて、今回黒泥が湧き出たことで影響を受けたエリアは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070108,
					"content": "前線坑道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "そう…黒泥を出している地脈の出口は坑道のエリアにあるということだ。坑道はここより狭いし、黒泥も溜まりやすい。つまり、魔物を引き寄せやすく、より深刻な問題に発展する可能性がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070110,
					"content": "だが、私は「プルシナスパイク」を信じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070111,
					"content": "これはプルシナ先輩が作った偉大な機器なのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715070112,
					"content": "でも、まずは修理をしないといけない。それが終わったら、約束した鉱夫たちが下りて来るのを待ち、スパイクを坑道まで運ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				}
			]
		}
	]
}