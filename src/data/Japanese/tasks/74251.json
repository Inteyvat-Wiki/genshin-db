				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "招待感謝する、ギヨタンさん。この清水は、この茶会のために特別に用意してくれたものなのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510102,
					"content": "気にしないで。フォンテーヌ最高審判官であるアナタが、忙しい中わざわざ時間を割いて…水を飲みに来てくださるなんて、光栄極まりないことだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510103,
					"content": "それで、今日はファデュイの公務に関して、私に何か相談事でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510104,
					"content": "いいえ、ファデュイとは関係なく、個人的にお話がしたかっただけよ。相談というほどのことでもないんだけど…昔の知り合いについて聞きたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510105,
					"content": "昔の知り合い…もしや、偉大なる「奇械公」、アラン・ギヨタン殿のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510106,
					"content": "ええ…昔はどんな人だったの？若い頃、アナタの部下だったそうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510107,
					"content": "うむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510108,
					"content": "実に誠実で、堅実な人物だった。「護国の白騎士」の称号を授かった後も、驕ることは一度もなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510109,
					"content": "そして…世間に無関心で、大半の時間を機械の研究に注いでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510110,
					"content": "へえ…若い頃からそうだったのね。達観していたのか、単に世間知らずだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510111,
					"content": "しかし…そんな彼も家族や友人を失ってからは、随分と変わってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510112,
					"content": "ゲシュタル塔…そしてエリナスの件ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510113,
					"content": "ああ。私と共にゲシュタル塔の捜索令状に署名した時、彼はとても…やるせない様子だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510114,
					"content": "過去のわだかまりとすれ違いが招いた事態だもの…きっと、罪悪感を抱いていたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510115,
					"content": "ああ。それ以来、彼はますます寡黙になり、私との交流も減ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510116,
					"content": "「奇械公」の称号を授かった時、彼は壇上から人々にこう言った——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510117,
					"content": "「際限なき完璧を追い求めるよりも、静かで慎ましい生活を送ったほうが、幸福を見つけやすい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510118,
					"content": "ふふっ…晩年の彼は、確かにそうしていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510119,
					"content": "きっと参列者だけでなく、自分にも言い聞かせていたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510120,
					"content": "ギヨタンさんは、この言葉をどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510121,
					"content": "ワタシ？ふん、アランの悟りや生き方について、とやかく言うつもりはないわ。彼もワタシに、生き方を強要しなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510122,
					"content": "同じ道を歩もうとは思っていないし、彼が理想としていた日々を送るつもりもない。ワタシにはワタシの人生があるんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510123,
					"content": "ふふっ…ありがとう。おかげで、彼をより理解できたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510124,
					"content": "礼には及ばない。私もアラン殿の後継者と昔話を分かち合えて、嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				}
			]
		},
