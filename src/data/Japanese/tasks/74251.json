				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "水を味わいながら、ギヨタンさんと過去に思いを馳せる…とても良い時間だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742510204,
					"content": "うむ。君のゆく道が万事順調であることを祈る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742510203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
}