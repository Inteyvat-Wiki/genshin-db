					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060402,
					"content": "アファンについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "あら？何かありましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732060404,
					"content": "アファンの問題をサバーフに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "なるほど。それで私を頼って下さったのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732060406,
					"content": "こういう時に思い出していただけたのは光栄ですけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732060407,
					"content": "私は品種栽培が専門の学者ではありませんでした。私の限られた経験で、お役に立てるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732060408,
					"content": "でも頑張ってみますわ。それに、新種のローズを栽培しているあの方にもすごく興味があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732060409,
					"content": "時間を見つけてアファンお爺さんの苗畑を見に行きますわ。後ほどそちらでお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
