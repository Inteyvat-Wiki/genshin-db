			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "「ローズよローズ、叶えておくれ、わしの願いを。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070502,
					"content": "「花は石から咲き誇り、ゴールデンローズはわしに歌う。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070503,
					"content": "「あの子はこう歌う…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070504,
					"content": "「私を支える土はない。歌だけが支えてくれる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070505,
					"content": "「歌は牙を剥く運命に勝ち、私の結末に勝ち——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070506,
					"content": "「私に勝ち、私の時間に勝ち、永遠に止まぬ消失に勝つだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070507,
					"content": "これが、昔シャフカットおじさんが教えてくれた歌だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				}
			]
		},
