			"dialogs": [
				{
					"id": 732900101,
					"content": "スメールローズを摘んできたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7329002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329002",
							"2"
						],
						"stepId": 7329002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "懐かしい花ですね。私も貴方たちにプレゼントを用意したんです。受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900202,
					"content": "ここでは発芽できない植物の種ばかりです。もし他の土地の庭があれば、この子たちの成長を見届けられるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900203,
					"content": "あら、私ばかり話過ぎましたわね…でも、何だかすっきりしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900204,
					"content": "貴方が来るまでは、あまり友達がいなくて…ちょっと寂しかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900207,
					"content": "この村に、花を栽培するような余裕のある人はいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900208,
					"content": "えっと…正確には、全くいらっしゃらないわけではないのですけれど。村の北の方では、あるお爺さんが苗畑を作って、花の栽培をしていますの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900209,
					"content": "彼を訪ねたことがあるのですが、少し変わった年配の方でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900210,
					"content": "石を埋めたのに、花を植えたと言い張って…追い出されてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900211,
					"content": "一人の生活が寂しかったのでしょうね。私はその気持ちを理解できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900212,
					"content": "私のためにスメールローズを咲かせてくださった貴方なら、彼のことも手伝えるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732900213,
					"content": "機会があったら、貴方とパイモンも彼のところに行ってみてくださいませ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		}
	]
}