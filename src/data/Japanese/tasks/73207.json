						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "シャフカットおじさん、最後の願いは叶えてやれんようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060602,
					"content": "シャフカットって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "この前、化け爺の話を聞いてきただろう。化け爺ももとから化け爺という名前だったわけじゃあない。本名なわけないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060604,
					"content": "彼の名はシャフカット。若い頃にスメールシティを離れて、わしらの村に来たと、年長者からは聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060605,
					"content": "ここに来てからはこの家を建て、一人暮らしを始めた。以来数十年間、ここを離れんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060606,
					"content": "わしは彼の若い頃を知らんが、その頃はまだ子供がそれほど嫌いではなかったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060607,
					"content": "彼の家の周りには沢山の花や木が植えてあり、子供たちはそこへ行くのが大好きだった。デーツをもらったり、彼の話を聞いたりしてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060608,
					"content": "だが、わしが出会った頃には、彼はすでにもう年を取っておって、人からは化け爺と呼ばれ、子供も嫌いになっておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060621,
					"content": "きっとまだ何か方法はあるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "どんな方法があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060623,
					"content": "シャフカットおじさん…化け爺はすでにひそかに去った後だった。そうでなければ、わしだってこのローズを栽培する特殊な方法について聞きたかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060624,
					"content": "今は誰に聞けばいいのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060625,
					"content": "サバーフって生論派学者を知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "ああ、よそから来たあのお嬢ちゃんのことか。彼女が手伝えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060627,
					"content": "前に彼女がここを訪れた時、わしは叱って追い出したからなぁ。手伝ってくれるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060628,
					"content": "頼んでみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "お前はいい子だな。たとえ手伝ってくれる人が見つからなくても、その気持ちだけでもう充分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060609,
					"content": "どうして花を育てるのに執着してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "うちの村は、時々よそから来た人が、ここでの生活を余儀なくされる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060611,
					"content": "どれだけ無理をしても、ここでの生活に一向に慣れることが出来んで、生涯孤独な者もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060612,
					"content": "化け爺…つまりシャフカットおじさんもそういううちの一人だったのだろうな。みんな長く、こういうことに慣れ過ぎてしもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060613,
					"content": "だが、わしは何年経っても、そういうことには慣れん。彼のことは本当に残念だったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060614,
					"content": "彼の花園は、お前たちが見ても気に入ったはずだ。色とりどりの花や、高さの揃わない木々…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060615,
					"content": "そんな小さな花園を作り上げた本人が、ひっそりと消えていった。彼のことは、悪い子供をさらう化け爺としてしか、みんなの記憶に残らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060616,
					"content": "わしはそういうのが、どうしても受け入れられんでな。彼は手記で、方々でローズが咲いてほしいと書いとったから、わしはただ彼の願いを叶えてやりたかったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060617,
					"content": "わしはもうこの年だ。周りにどう思われようが構わん。このことさえ成し遂げられれば、わしの人生も無駄じゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060618,
					"content": "部屋はわしが片付けた。残された冊子も整理した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060619,
					"content": "興味があったら、一冊を取り出して見てみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732060620,
					"content": "<color=#00E1FFFF>部屋の前</color>に置いておくよ。この冊子の中の彼にも日の光を浴びさせてやりたいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "アファン"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "来てくれたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070102,
					"content": "彼女が見つけてくれた助っ人のお嬢ちゃんだろう？先日はきついことを言ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070103,
					"content": "まったく…はぁ、わしとしたことが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070104,
					"content": "今、こうして仲良くお話しできているじゃありませんか。気になさらないでくださいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070105,
					"content": "種は発芽した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "残念ながら。私もアファンお爺さんも確認したのですが、まだ発芽していません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070107,
					"content": "観察してみましたが、これらの種の外側が石化し始めてしまっているようです。こうなったのには、二つの可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070108,
					"content": "一つは、長い時間によって自然に風化してしまったせいで、生き物としての機能を失い、化石化しつつあるという可能性です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070109,
					"content": "この状況だとすると、もちろん種は発芽できません。でも、この仮説が成立する可能性は低いでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070110,
					"content": "化石化するには相当長い時間が必要ですから。これらの種はこの時間的な条件を満たしていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070111,
					"content": "二つ目は、この品種自体に岩元素との親和性がある可能性です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070112,
					"content": "この子たちが種の段階で十分な岩元素を集めることができた場合、種の外側には石殻が出来るでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070113,
					"content": "この仮説が成立するとすれば、これは種が長時間保存できる基本的な原理にもなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070114,
					"content": "オ…オイラにはよくわからないけど、種は全部石になっちゃったってことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732070115,
					"content": "石…やはり、望みなしか。石からゴールデンローズは咲かんだろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070116,
					"content": "ゴールデンローズというのは？まさか、歌に出てくるゴールデンローズのことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070117,
					"content": "ああ、お前らは知らなかったのか。村に伝えられとるローズの歌は、シャフカットおじさんが作ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070118,
					"content": "彼は自分で作った歌をわしの上の世代に教え、彼らもまた、それを子供たちに教えたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070119,
					"content": "わしの代よりも若いもんは、もう誰もこのことを知らん。わしらがいなくなれば、もう彼のことを覚えているやつはいなくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070120,
					"content": "「ローズよローズ、叶えておくれ、わしの願いを。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070121,
					"content": "「花は石から咲き誇り、ゴールデンローズはわしに歌う。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070122,
					"content": "そうよ…石から花を咲かせられますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070123,
					"content": "サバーフ、何か思いついたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "歌の示す通り、石の殻を破れば、種を石から発芽させることができるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070125,
					"content": "普通、植物を育てるには、理想的な条件を作り、種を呼び覚まし、自ら種の殻を破ってもらわねばなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070126,
					"content": "しかしこの品種のローズの種の殻はあまりに堅すぎて、種の芽は自ら殻を破ることができないのです。私たちはそれを外から手伝ってあげればいいのですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070127,
					"content": "アファンお爺さん、いかがですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070128,
					"content": "力ずくで種を砕くというのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070129,
					"content": "もちろん、種を完全に砕いてはいけません。ですから器用な人にしてもらわなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}、頼まれていただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070131,
					"content": "#やっぱり{M#俺}{F#私}か。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "この過程はどうか慎重になさってください。まずは<color=#00E1FFFF>叩いて</color>種の殻を破り、それから<color=#00E1FFFF>草元素</color>の力で種を「覚醒」させて下さい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070132,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン",
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "しばらく待つと、幼芽が土からゆっくりと萌え出てきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "サバーフさんの方法、効果があったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732070302,
					"content": "やっと発芽したか、やっとだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070303,
					"content": "どうやら、シャフカットさんの願いは叶えられそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070304,
					"content": "アファンお爺さん、この品種のローズは彼が作ったと、教えて下さいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070305,
					"content": "新しい品種を作れるということは、つまり…彼も私のように、ここに追放された学者だったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070306,
					"content": "…ああ。彼はこの村に追放されてから、わしらの後ろにあるこの家で、その一生を終えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070307,
					"content": "そうでしたか。確かに…追放者になったからには、そのような結末を迎えることになりますよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070308,
					"content": "新しい品種の栽培というのは、トップレベルの学者にしかできないことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070309,
					"content": "そのような方が、教令院から遠く離れた地で、名も残さずに消え去ってしまうなんて、とても残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070310,
					"content": "サバーフさん、自分の将来と重ねてるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732070311,
					"content": "しっかりして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "そうだぞ。お嬢ちゃんの道のりはまだ長い。できることだってまだまだ沢山あるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070313,
					"content": "悲しみに囚われてはならん。二人目の化け爺を見るのはごめんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070317,
					"content": "それもそうですね…私ったら、喜ぶべき時に悲しくなったりして。本題に戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070318,
					"content": "今、ゴールデンローズはただ発芽しただけで、まだ開花はしていません。私はゴールデンローズが咲き誇るところが見たいです。貴方たちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070319,
					"content": "#{M#俺}{F#私}も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "ではもう少し待ちましょう。十分な養分を吸収させて、しばらくしたら開花を一緒に見届けましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732070314,
					"content": "（サバーフをどう慰めていいかわからない…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "そう悲しむな。ほら、彼は最後に、わしらにゴールデンローズを残してくれたじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732070316,
					"content": "この子らはシャフカットおじさんがこの世で生きていた証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "アファン"
				}
			]
		},
