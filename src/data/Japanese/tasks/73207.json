				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030619,
					"content": "アアル村での生活はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "まあまあ、というところですわ。食べ物もありますし、住む場所もあります。基本的な生活が保障されているだけでありがたいものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030621,
					"content": "追放された身には、蔵書や研究器材なんて贅沢な望みでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030622,
					"content": "そもそもこの村は昔から、教令院が学者を追放する場所でした。生存環境も研究環境もスメールシティとは比べ物になりませんから、学術的雰囲気なんていうものはもちろんありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030623,
					"content": "私は最初の追放者ではありませんし、最後でもないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030624,
					"content": "来たからには、慣れるしかない。それだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030625,
					"content": "あら、私ばかり話過ぎましたわね…でも、何だかすっきりしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "サバーフ"
