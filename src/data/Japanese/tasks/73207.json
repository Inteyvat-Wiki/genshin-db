					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030602,
					"content": "スメールローズを沢山摘んできた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "懐かしい花ですね。私も貴方たちにプレゼントを用意したんです。受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030604,
					"content": "ここでは発芽できない植物の種ばかりです。もし他の土地の庭があれば、この子たちの成長を見届けられるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "お話しをしに来てくださったのですか？ちょうど話したいことが沢山あるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "どの学派の学者だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "私の学派ですか？それについて話すなら、三日三晩の長話になりますね、ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030607,
					"content": "昔は生論派で、植物の進化を実証研究する学科を専攻していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030608,
					"content": "でも、新しい素材がなければ、新しい結論を発見するのは難しい…簡単に言うと、過去の植物について考察するためには、歴史ある標本が研究の基礎になってくるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030609,
					"content": "にもかかわらず、採取できる標本の数は変わらず、基本的にはすでに見つかっているようなものがほとんどです。教令院が提供できる新しい標本は限りがありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030610,
					"content": "客観的に見ればそんな状況です。それでも教令院からは、一定水準の研究が求め続けられるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030611,
					"content": "だから、昔の研究結果を少し変えて、つなぎ合わせて提出しているような人もいました。それじゃ、つまらないと思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030612,
					"content": "実は歴史や地理の角度から、新しい素材を探すこともできました。そうすれば、きっと新しい発見もあったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030613,
					"content": "生論派が重視していない、文学的素材も活用できます。でも、そうするとそれは因論派や知論派の領域になってしまうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030614,
					"content": "私はその領域の知識がない上に、関連する「知識」を申請する手続きも複雑すぎました。関連する領域の学者たちと協力するのはもっと難しくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030615,
					"content": "それでも私は信じていました。学科を越えた協力が出来れば、過去の様々な問題に突破的な進展が得られると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030616,
					"content": "けれど、この試みはどれも続きませんでした。因論派と知論派の変人たちの物事を見る角度が独特というか…その、異常で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030617,
					"content": "誤解を招かないように、提案するときには、すべての措辞を細かく吟味したものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030618,
					"content": "教令院に追い出される前に、知論派の人と喧嘩にもなりました。今は、もう喧嘩する機会さえ失ってしまいましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030625,
					"content": "あら、私ばかり話過ぎましたわね…でも、何だかすっきりしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030626,
					"content": "貴方が来るまでは、あまり友達がいなくて…ちょっと寂しかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030629,
					"content": "この村に、花を栽培するような余裕のある人はいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030630,
					"content": "えっと…正確には、全くいらっしゃらないわけではないのですけれど。村の北の方では、あるお爺さんが苗畑を作って、花の栽培をしていますの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030631,
					"content": "彼を訪ねたことがあるのですが、少し変わった年配の方でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030632,
					"content": "石を埋めたのに、花を植えたと言い張って…追い出されてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030633,
					"content": "一人の生活が寂しかったのでしょうね。私はその気持ちを理解できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030634,
					"content": "私のためにスメールローズを咲かせてくださった貴方なら、彼のことも手伝えるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 732030635,
					"content": "機会があったら、貴方とパイモンも彼のところに行ってみてくださいませ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		},
		{
