			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イラード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756590101,
					"content": "#よくぞおいでくださいました。英雄{NICKNAME}様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590102
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590102,
					"content": "長くお待ちしていた甲斐がございました。そのお姿を目の当たりにした瞬間、私の身に溜まっていた疲れも、一気に吹き飛びました…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590103,
						756590104
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590103,
					"content": "タイミングばっちりでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				},
				{
					"id": 756590105,
					"content": "なんか、すごくかしこまってるけど…オ、オイラも、合わせなきゃいけないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756590106,
					"content": "#英雄{NICKNAME}様を導く尊きガイド様、どうか肩の力を抜いてくださいませ。まずは、簡単に自己紹介を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590107
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590107,
					"content": "私は談議室の職員で、戦闘準備連絡官のイラードと申します。炎神様のご指示のもと、各集落のパトロール隊の訓練を担当しております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590108
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590108,
					"content": "毎年、それぞれの集落の若者の中からパトロール隊の予備軍となる戦士を定期的に選出して参りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590109
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590109,
					"content": "また、ベテラン隊員たちがさらに己を高められるよう、高難易度の試験も用意してございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590110
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590110,
					"content": "そういった選抜や試験を行うための「ステージ」は、私や各集落の優秀な戦士たちが協力してデザインしているものなのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590111
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590111,
					"content": "おお！オイラ、分かったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756590112,
					"content": "#{NICKNAME}は戦闘とか競走とかのプロだ。面白いステージを作るなら、こいつの力はすごく助けになると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590113,
						756590114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756590113,
					"content": "#{M#俺}{F#私}に依頼したいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590115,
					"content": "#とんでもございません！英雄である{NICKNAME}様に私めの仕事をしていただくなど！失礼極まりないことでございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590116
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590116,
					"content": "#ステージのデザインはすでに完了しております。{NICKNAME}様にはその「検証」をしていただき、ほかの戦士たちに手本を見せていただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590117
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590117,
					"content": "筆記試験で満点を目指すのと同じように、技を磨くにあたっても目標は大事です。強い戦士たちが試験を通過する姿を見ることは、後輩たちにとって励みになるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590118
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590118,
					"content": "例えば、「こだまの子」の試験には「バレカ」のシロネン様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590119
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590119,
					"content": "「懸木の民」と「花翼の集」の試験は、それぞれ「マリポ」のキィニチ様と「ヴーカ」のチャスカ様に検証をお願いしております。高い志をもった多くの戦士が挑むことになるでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590120
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590120,
					"content": "#なるほど…じゃあ、{NICKNAME}はまさに…えっと、なんて言ったっけな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756590121,
					"content": "あ、そうそう、「永遠に追いつけない地平線」みたいな存在になるってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756590122,
					"content": "みんなのお手本になれるよう頑張る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590123
					]
				},
				{
					"id": 756590123,
					"content": "#何と素晴らしい精神…！さすが{NICKNAME}様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590124
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590124,
					"content": "ほかにも強者がいっぱいいるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590125
					]
				},
				{
					"id": 756590125,
					"content": "驕らないその姿勢…！あなたは本物の英雄です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756590126
					],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590126,
					"content": "それでは、試練ステージの位置をマップにマークいたします。いつでも大丈夫ですので、どうぞよろしくお願いいたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イラード"
				},
				{
					"id": 756590114,
					"content": "#{M#俺}{F#私}のクライアントってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590115
					]
				},
				{
					"id": 756590104,
					"content": "ど…どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756590105
					]
				}
			]
		}
	]
}