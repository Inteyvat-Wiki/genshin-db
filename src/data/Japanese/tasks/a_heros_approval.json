			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7565901",
							"2"
						],
						"stepId": 7565901,
						"stateName": "QUEST_STATE_UNFINISHED"
