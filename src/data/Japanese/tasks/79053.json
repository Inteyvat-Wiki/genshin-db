	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イディア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "「みんな…ようこそ『ヴェルーリヤ·ミラージュ』へ！どうかここで旅の疲れを忘れて、ゆっくり休んでくださいね！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530102,
					"content": "本来なら、初めて会った時にこういう歓迎のセリフを言うべきだったんです。なのに…はぁ、まさかこんなに沢山のことが起こるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530103,
					"content": "すべてが元通りに戻ったところで、改めてこの始まりのセリフを言わせてもらいますよ…どうです？いい感じでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530104,
					"content": "先成図について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "えっ、原理を説明して欲しいのですか？実は私もよく分かってないですよ。とにかく、先成図はどちらかと言いますと、考え方のひとつで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530106,
					"content": "例えば、植物がどのように成長するかは最初から種の中に書き込まれていて、鳥の羽がどのように広がっていくのかが卵の中にいた時から決まっていたように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530107,
					"content": "物事は道理に沿って、いま目に映るすべてになっているのです。そして実は最初から、万物の設計図とは決まっていたりするのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530108,
					"content": "先成図がその設計図となります。ビンの中の光に照らされると、それが広がってヴェルーリヤ·ミラージュとなるのです。あっ、これはこの魔瓶の中でしか実現できない芸当になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530109,
					"content": "純水精霊について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "えっと、どうして私がフォンテーヌから逃げ出したのかってことですか？思い返してみると、それはまるで前世の記憶のようですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530111,
					"content": "逃げ出した理由を挙げるのなら、それは「水」のせいです。フォンテーヌの水は変わりました。純水精霊にとって、あそこの水は今…苦しみと憎しみに満ちていると言ったところでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530112,
					"content": "私たちにとって、生き延びるためには故郷から逃げるのが最善の選択肢でした。あっ、ちょうどその時に慌てて逃げたせいで、私は砂漠に倒れてしまったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530113,
					"content": "私から言わせると、この砂漠は広すぎるんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530114,
					"content": "ローデシアについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "ふ～ん、ローデシアお姉さんのことですか？あれ、もう会ったことがあるんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530116,
					"content": "どうやら、彼女も自分の居場所を見つけたみたいですね…軽策荘ということは、璃月ですか？それはまた、遠い場所まで行きましたね、ローデシアお姉さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 790530117,
					"content": "頑張って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "はい、頑張り…ます！あなたたちもどうかこの潤った環境を楽しんでください。砂漠の中で、こんな場所はめったにありませんからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
