				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イディア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "イディア、すごいことが起こったぞ！大ニュースだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531302,
					"content": "オイラたち、懐中時計をひとつ見つけたんだ！ほら見てくれ、これって伝説のモラの懐中時計じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531303,
					"content": "見た目は金ピカ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "へえ？どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531306,
					"content": "まさか、本当に見つけてしまうなんて！もしかして、これが運命というものなのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531307,
					"content": "不思議な冒険者が残した究極の財宝が、伝説の旅人に見つけられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531308,
					"content": "これは何というか…精神的な伝承を感じますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531309,
					"content": "そこまで褒めてくれるのは確かに嬉しいけど…この懐中時計を見つけることでなにが起きるかのほうが気になるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531310,
					"content": "追加報酬はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "な…何もありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531313,
					"content": "実は誰かに見つけられることを全く考えてこなかったのです…何しろ、自分ですらどこに埋めたのか覚えていなかったので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531314,
					"content": "でも、このこと自体にすごく価値があります！私から追加の報酬なんて必要ないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531315,
					"content": "とにかく、このことを記録してから少し脚色して、ドキドキハラハラの物語を作りましょう。そして、それを今後やってくる客人に話していきたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531316,
					"content": "今日からはあなたたちが残した宝物こそが、このモラの懐中時計の代わりになるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531317,
					"content": "それもそうだな。さっき話してた通り、大事なのはお宝の中に秘められた物語だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531318,
					"content": "#とにかく、もう少しこの懐中時計を観察してみようぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531319,
					"content": "イディア、オイラたちの物語をちゃんとすごいものにしてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531320,
					"content": "安心して私に任せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531311,
					"content": "隠しイベントとかが発生する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "周りにモラの模様がある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
			"completionStepIds": [
				7905304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905304",
							"2"
						],
						"stepId": 7905304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120462",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"0",
							"79053"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イディア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "おや？お二人ともどうかしましたか？何やら聞きたいことがあるご様子ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531402,
					"content": "もし「ヴェルーリヤ·ミラージュ」について何か聞きたいのなら、私に聞くのが大正解ですよ。私にとって「ヴェルーリヤ·ミラージュ」は、手のひらの水の模様のように詳しいことですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531403,
					"content": "み、水の模様ってシワ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "ただの比喩ですよ！私にシワなんかできるわけないじゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531407,
					"content": "それよりも、オイラたち楽園でこんな手紙を拾ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531408,
					"content": "イディアならきっと、これがどこから来たものか知ってるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531409,
					"content": "そりゃあもちろん、そのような手紙は一目で…あれ、こんな手紙は初めてですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531410,
					"content": "手のひらの水の模様が、すごくボヤけてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531411,
					"content": "こ、これは明らかに私の隙を狙って、誰かがこっそり埋めたものです。見たことがないのも仕方ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531412,
					"content": "それに内容を読む限り、手紙というよりも遺書や記録のように思えますね。一体誰のものでしょうか…手紙のこの雰囲気、どこかで覚えがあるような気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531413,
					"content": "「蜃楼玉匣」と関係してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "あっ！そう言われると確かにそうですね。これは「蜃楼玉匣」を持ち込んだおじいさんが残したものです…あれは、まだ私が瓶の中に来て間もない頃のことでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531415,
					"content": "あのおじいさんは稲妻の人で、ここに来てすぐ「ここは願いが叶う場所か？」と聞いてきたのです。そして、彼は自分を昔の戦場に送り返して欲しいと言ってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531416,
					"content": "なんとか説明しようとしたのですが…彼は秘境に入ってきた時点で身体がかなり悪かったようです。ここまでの道のりも長かったことで、精神もかなりすり減らしてるようでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531417,
					"content": "彼はただひたすらに「お願いだ、俺をあの日に戻してくれ…」、「俺をあの戦争の中に送り返してくれ…」みたいなことを言い続けていましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531418,
					"content": "だから、私は瓶の中の蜃境を使って…彼が想像する戦場を模倣しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531419,
					"content": "ああ、それで手紙には「やっとここへ戻れた」って書いてあったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790531420,
					"content": "それは蜃境だったはずの場所が、ぼんやりしている間にいきなり記憶の中の戦場になったせいかもしれませんね。戦場は恐ろしいものでしたけど、彼はすごく楽しそうに笑ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531421,
					"content": "死の間際にそんな恐ろしい光景を見たい人がいるなんて不思議ですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531422,
					"content": "彼からすると他に意味があるのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "私にはよく分かりません。でも彼は最後まですごく満足そうにしてましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531425,
					"content": "もしあのシチュエーションで叶えたい願いがあったのなら、それを抱き続けてきた時間はきっと大変なものだったでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531426,
					"content": "コアホイールが再び回るようにした時、「蜃楼玉匣」にはかなり助けられました。この秀家さんには感謝しないといけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				},
				{
					"id": 790531423,
					"content": "そのほうが刺激的かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531405,
					"content": "本当に？見せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531406
					]
				},
				{
					"id": 790531406,
					"content": "た、ただの比喩ですから。あなたの手相と同じで、何も面白くなんてないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "イディア"
				}
			]
		}
	]
}