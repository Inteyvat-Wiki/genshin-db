							"4141304",
							"2"
						],
						"stepId": 4141304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "感謝する、風花祭のスター。敬愛する「風の花」は風神バルバトスに捧げられた、風がモンドを守らんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130402,
					"content": "いい選択だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130403,
					"content": "好きな花だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "うーん——当ててみて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130405,
					"content": "またそれかよ、いじわるなヤツだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130406,
					"content": "あはははっ！教えるよ。でも、違う場所で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130407,
					"content": "人混みで話すことでもないからね、場所を変えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130408,
					"content": "おう、どこに行けばいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130409,
					"content": "一緒に「風龍廃墟」に行ってくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141307",
							"2"
						],
						"stepId": 4141307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "うん！やっぱりここの景色が一番だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130702,
					"content": "綺麗な景色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "そうだね、ボクはこの場所が好きなんだ。ヒマさえあれば、ここに来て景色を眺めてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130705,
					"content": "サボりに来てるだけだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130706,
					"content": "えへへっ、バレた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130707,
					"content": "あとはリンゴ酒があれば、この絶景をもっと堪能できたのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130708,
					"content": "旅人、モンドの風花祭は気に入ってくれたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130709,
					"content": "人情味があって賑やかだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "でもまだ疑問が残ってる、そうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130712,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "聞きたいことは分かるよ。「風の花」とは何か。風神バルバトスから見た「風の花」と「風花祭」とは何か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130714,
					"content": "知っての通り、モンドの民にはそれぞれ自分の選択がある。蒲公英を選ぶ人もいれば、風車アスターを選ぶ人もいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130715,
					"content": "一人一人が思う「風の花」は違うみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130716,
					"content": "その通り、そしてそれが正しいのさ。「風の花」は現実に存在しないものだから、答えはないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130717,
					"content": "えっ…存在しないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130718,
					"content": "「風の花」という言葉は、元は旧モンド時代、人々が互いに連絡を取り合い、共に反旗を翻す際に使われた隠語だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130719,
					"content": "風が強いほど、「風の花」の土台が安定し、鮮やかな花が咲き誇ると言われていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130720,
					"content": "ボクからすれば、実在はしないけど、どこにでもあるものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130721,
					"content": "それは自由を望む魂、風を追う勇気…美しく、祝福に値するものはすべて「風の花」になり得る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130722,
					"content": "存在しないようで、どこにでもあるもの。風みたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130723,
					"content": "ははっ、その通り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130724,
					"content": "だから、風神バルバトスは「風の花」を定義したりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130725,
					"content": "祝福の花、敬愛の花、深愛の花。みんな自分の「風の花」を持っている、一人一人に定義する権利があるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130726,
					"content": "自由の都モンドが風神に捧げる花も、やっぱり自由なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130727,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も自由な感じは好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "分かってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130729,
					"content": "人々は共通の意志により集まり、自由の風が互いを繋ぐ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130730,
					"content": "それは旅の終わりや、世界の彼方、そしてボクたちの心の中からやってくる。決して止まることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130731,
					"content": "「毅然とした君の顔を撫でるのは誰\\n小川のそば\\n巨岩の横」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130732,
					"content": "「高貴なる君の魂を握ったのは誰\\n夢見の中\\n高天の上」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130733,
					"content": "「親愛なる友よ\\n君の手を引き\\n夜の明かりを見に行こう」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130734,
					"content": "「祝祭に響く自由と夢の楽章を\\n君に語らん」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130710,
					"content": "みんなと一緒で楽しかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "素敵な雰囲気だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
