			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "ジン団長、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130202,
					"content": "旅人！あ、いや、今は栄誉騎士と呼ぶべきだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130203,
					"content": "もう聞いていると思うが、君が今期の「風花祭のスター」だ。モンドの人々を代表して風神バルバトスに「風の花」を献上する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130204,
					"content": "しかし…今回はいつもと違った祝祭だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130205,
					"content": "オイラたち、そして吟遊野郎、今回の風花祭はとても賑やかだったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130206,
					"content": "ああ。君たちがモンドに来てくれて本当に感謝している。これからもモンドで楽しい日々を過ごせるよう祈っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130207,
					"content": "そろそろセレモニーが始まる。風花祭のスター、君が選ぶ「風の花」はもう決まったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130208,
					"content": "花を1つ選んで、風神に捧げるんだったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130209,
					"content": "そうだ、慎重に考えてから選んでほしい。全モンドを代表することを忘れないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130210,
					"content": "ウェンティは、どんな花が好き？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "ん？ずるいなぁ、直接ボクに聞くなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130212,
					"content": "コホンッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130213,
					"content": "こんなところでひそひそ話するなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130214,
					"content": "あははっ、怒られてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130215,
					"content": "ボクに気を遣わないで。好きなのを選ぶといい。君のセンスを信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 414130216,
					"content": "それでは栄誉騎士、選択を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130217,
					"content": "蒲公英",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "おう！「風の花」は支持者の多い蒲公英で決まりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130229,
					"content": "モンドの人々を代表し、君の「風の花」を神像に献上したまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 414130219,
					"content": "風車アスター",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "おう！「風の花」は支持者の多い風車アスターで決まりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130221,
					"content": "セシリアの花",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "おう！ベアトリーチェと意見が一致したな。人気はあまりないけど、コアな支持層を持つセシリアの花が「風の花」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130223,
					"content": "イグサ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "おう！ニムロドと意見が一致したな。暗闇を照らすイグサが「風の花」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130225,
					"content": "スイートフラワー",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "おう！スクロースと意見が一致したな。古くから生い茂ってるスイートフラワーが「風の花」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414130227,
					"content": "ググプラム",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "おう！レザーと意見が一致したな。トゲトゲしてチクチクするググプラムが「風の花」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
