			"dialogs": [
				{
					"id": 761850101,
					"content": "うん、お茶もお菓子も美味しいねぇ。おもてなしに感謝するよ、サンドローネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850102,
					"content": "気に入ってもらえたなら何よりよ。そうそう、アシュルの好きなお菓子も持ってきたのよ。ほら、アナタの好物でしょ？いい子いい子、こっちへいらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850103,
					"content": "にゃあん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "アシュル"
				},
				{
					"id": 761850104,
					"content": "あんたとナド・クライ、そして「秘聞の館」との繋がりが、今後の協力関係において役立つことを願うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850105,
					"content": "ええ、ワタシもそう願っているわ。さあ、アシュル、食べてごらんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850106,
					"content": "それから、前に尋ねた件だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850107,
					"content": "ふふっ。柔らかくて素敵な肉球ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850109,
					"content": "サンドローネ…まさかあんた、お茶会を口実に猫を触りに来ただけじゃないだろうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850110,
					"content": "えっ…？そ、そんなことないわよ！「秘聞の館」との交流だって、忘れていないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850111,
					"content": "おいで、アシュル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850112,
					"content": "にゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "アシュル"
				},
				{
					"id": 761850113,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850114,
					"content": "さてと、具体的に「交流」について話し合おうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850115,
					"content": "…ふん。少し猫を触ったからって、なんだって言うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850116,
					"content": "動物は普通、機械が苦手なのよ。せっかく「数秘配列」の研究中に仲良くなれたんだから、ちょっとぐらい撫でたっていいでしょう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850117,
					"content": "はぁ…分かった分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850118,
					"content": "行きな、アシュル。どうせあんたが誰にすり寄ろうと、あたしには止められないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850119,
					"content": "にゃ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "アシュル"
				},
				{
					"id": 761850120,
					"content": "アシュルを撫でるのもいいけど、本題を忘れないでおくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850121,
					"content": "だから忘れてないって言ってるじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
