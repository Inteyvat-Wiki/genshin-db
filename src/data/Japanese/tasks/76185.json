			"dialogs": [
				{
					"id": 761850201,
					"content": "「情報」と一緒に飲むお茶は、一味違うね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761850204,
					"content": "ああ、気をつけて帰るんだよ。暇があったらまたおいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761850203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
