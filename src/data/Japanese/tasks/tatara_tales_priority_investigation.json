			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "ビーコンを置いたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150302,
					"content": "置いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "ありがとう、あとはデータが集まるのを待つだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150304,
					"content": "どうして、場所を知ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "俺も「御影炉心」の設計チームの一員だった。あの場所にビーコンを置けば、「御影炉心」内のほとんどのエリアのデータを集めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150306,
					"content": "いくつかの場所に浄化装置を設置した後、一晩待てば一件落着だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150307,
					"content": "今の状況を…もしヴロワさんが知ったら、きっと荒れ狂ってたに違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150311,
					"content": "さて、手伝ってくれてありがとう。これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150312,
					"content": "コホン、それでなんだが…しばらくしたら、ビーコンの回収もお前にお願いするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150313,
					"content": "このグザヴィエは「神の目」を持っていない。だから、「祟り神」のエネルギーが満ちた場所には自由に出入りできないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
