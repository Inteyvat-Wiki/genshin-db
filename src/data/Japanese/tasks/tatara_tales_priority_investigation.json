			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "やあ！「御影炉心」について、いいお知らせと悪いお知らせがあるんだが、どっちから先に聞きたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150102,
					"content": "いいお知らせ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "いいお知らせは、炉心の破損状況が思ったほど深刻ではなくて、まだ俺に処理できる範囲内だったことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150104,
					"content": "で、悪いお知らせは、中にいるファデュイがこのいいお知らせをよく思ってないことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150105,
					"content": "彼らは「祟り神」の核心を手に入れる方法を探し続けてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150111,
					"content": "彼らを放っておいたら、「祟り神」の力はいずれに制御不能になり、この島も、島にいる俺たちも上空まで吹き飛ばされるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150112,
					"content": "だがもしファデュイだけに注意力を注いでいたら、バリアに蓄積していた「祟り神」も、いずれに限界に達してしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150113,
					"content": "じゃあ、両方を同時に解決するしかない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "ああ…分かりやすく言おう。学術的なものと客観的な観点で言えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150115,
					"content": "今の状況、ファデュイと「祟り神」、この二つの問題が突きつけられている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150116,
					"content": "だが、「御影炉心」の中の現状を見るに、一つの問題を解決しようと行動してる時、もう一つの問題が壁となる可能性が非常に高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150117,
					"content": "だから、いま直面している現実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150118,
					"content": "やるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "えっと、そう、そうだ。俺たちは両方を同時に解決するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150120,
					"content": "だが一歩ずつ進もう。「急がば回れ」、璃月人はよくそう言うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150121,
					"content": "璃月のことわざを知ってるんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "前に璃月に行ったことがある。これは旅の小さな記念品だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150123,
					"content": "このような記念品はまだたくさんある。モンドの記念品はもう飲み干したけど…味は最高だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150124,
					"content": "さて、本題に入ろう。「御影炉心」の件を解決するため、一つ提案がある。お前に協力してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150125,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "ははっ！俺はお前みたいな…まっすぐな性格をしたやつは好きだぜ、助かる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150131,
					"content": "コホン、本題に戻ろう。この「探測ビーコン」を持っていってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150132,
					"content": "そして、「探測ビーコン」を何ヶ所かに分けて設置してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150133,
					"content": "このビーコンは「御影炉心」内の「祟り神」の力の濃度と分布データを集めることができる。それらのデータがあれば、より詳しい計画を立てることが可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150134,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "では、頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150141,
					"content": "設置する場所はマップに記しておこう、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150136,
					"content": "このビーコン、いったいどんな原理で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "それは…元素力原理をもとに、各種のエネルギーを定量化及び計算をする機械だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150138,
					"content": "「簡単に説明すると」って…言いたいところだが、この動作原理は簡単には説明できない。そうだ、七つの元素からまず説明しよう！それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150139,
					"content": "だ、大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "そうか、分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150127,
					"content": "何かメリットはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "メリットは…この島にあるまだ発見されてない宝物と、「御影炉心」の中にある「欠片」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150129,
					"content": "ほら、稲妻で最大の製錬施設として、「御影炉心」の中にはきっと…うん…目を見張るべきものがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150130,
					"content": "もちろん！「神の目」を持っていない俺は、「御影炉心」に入ることすらできないから、その中の状況は分からないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150106,
					"content": "悪いお知らせ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "悪いお知らせは、ファデュイのヤツらがまだ「御影炉心」の中で暴れてることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150108,
					"content": "彼らは「祟り神」の核心を手に入れる方法を探し続けてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150109,
					"content": "で、いいお知らせは、現在の炉心の破損状況が思ったほど深刻ではなくて、まだ俺に処理できる範囲内だったことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721150110,
					"content": "でも明らかに、ファデュイのヤツらはこのいい知らせをよく思ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
