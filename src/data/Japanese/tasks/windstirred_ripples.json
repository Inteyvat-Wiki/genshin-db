			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニキータ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760930601,
					"content": "普段なら、自ら申し出たりはしませんが…今回の件、本当に僕がいなくても大丈夫なんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930602
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930602,
					"content": "ああ、来てくれたのだね、フリンズ。来ないかと思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930603
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930603,
					"content": "本当にそう思っていらっしゃるのなら、僕宛ての手紙の頻度を減らしては？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930604
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930604,
					"content": "記憶が確かなら、一週間前に僕の灯台に知らせが届いています。受け取っておきながら無視するなんて、マスター・ライトキーパーに対してそんな無礼なこと、できませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930605
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930605,
					"content": "よく言うよ。君に本部からの通知を送らなかったことなんてない…あの子のために来てくれたのだろう？ライトキーパーで一番仲がいいそうじゃないか。いつもあの子から君のことを聞かれるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930606
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930606,
					"content": "彼はどうしていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930607
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930608
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930608,
					"content": "結局、あなたは彼の肩に重責を託すことを選んだのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930609
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930609,
					"content": "ああ。私は彼を必要としているし、信頼している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930610
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930610,
					"content": "忠告はしましたからね。あれは普通のワイルドハントではありません。あの魔物たちは引き寄せられているんです——キプマキの崖に封印されていた、古き存在によって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930611
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930611,
					"content": "「彼」のことは、僕も少なからず知っています。かつてツァーリ・ベールイの宮廷で一度だけお会いしたことがありますが…あの毒蛇を見くびってはいけませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930612
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930612,
					"content": "未だに彼の目を覚えています。今僕たちを見つめているあの目と、全く同じでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930613
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930613,
					"content": "フリンズ、我々がライトキーパーになったきっかけを覚えているかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930614
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930614,
					"content": "「あなたたち」のきっかけですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930615
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930615,
					"content": "「我々」のきっかけだよ、フリンズ…「我々」だ。最近、過去のことをよく夢に見るんだ。君と共に戦った…あの戦場の夢を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930616
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930616,
					"content": "災難は常に突如として訪れる…決心を固め毅然と立ち向かう者も、不安を抱えて僥倖を願っていた者も、その時が来れば、誰一人として逃れることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930617
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930617,
					"content": "だが我々は、永遠の静寂が訪れるまでは、抗うことには意味があるのだと知っている。我々ライトキーパーは、実に五百年もの「抗い」を経て、この要塞の礎を築き上げてきたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930618
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930618,
					"content": "イルーガにそこまで教え込む必要はないと思いますよ。彼はすでに全てを失ったことのある人間だ——そのことは、あなたのほうがよく解っているでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930619
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930619,
					"content": "あなたの言った道理など、十分承知しているはずです。ただ今は、若い意地が邪魔して認めたくないだけでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930620
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930620,
					"content": "だが、私の時間も残り少ない…大きな責任を課すことになるというのに、私が彼のために確保すべきだった歳月は、もうほとんど絞り出せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930621
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930621,
					"content": "決心は固いようですね。それなら、僕から言う事はありません。マスター・ライトキーパーはあなたなんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930622
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930622,
					"content": "ところで、この前頼んだ件…忘れていないだろうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930623
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930623,
					"content": "マスター・ライトキーパー様直々のご依頼を、忘れるわけがないでしょう？ただ、なにせ五百年前の遺物で、初代詠月使と深い因縁のある物ですから、さすがの僕も手間取ってしまいまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930624
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760930624,
					"content": "ふふふ。では、私たちも準備を始めよう。ライトブリンガーが残した「弓矢」…その力を見せてもらおうじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニキータ"
				}
			]
		},
