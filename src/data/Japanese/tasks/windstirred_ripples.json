			"dialogs": [
				{
					"id": 760930401,
					"content": "すみません、本部をご案内できなくなりました。今から苦しい戦いが始まります。準備が必要でしたら、早めに済ませてきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930402
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930402,
					"content": "僕は部隊を連れて一足先に「クリフサイド・キャンプ」へ向かって、戦闘に必要な前準備を済ませてくるので、そこで合流しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930403
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930403,
					"content": "おう！オイラたちもすぐに行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930404,
					"content": "よし、準備しなきゃいけないことはないか、早く考えようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930405,
					"content": "そこのお二人さん、ちょっといいかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930406
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930406,
					"content": "ん？なにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930407,
					"content": "私はニキータ、この辺境の地で長年見張りを続けている、しがないライトキーパーだ。初めて見る顔だが…只者ではないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930408
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930408,
					"content": "#最近、諸国を旅して数々の伝説を残した金髪の冒険者{NICKNAME}とその仲間が、ナド・クライにやって来たと聞いている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930409
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930409,
					"content": "もしかして、君たちはその…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930410,
						760930411
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930410,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930412
					]
				},
				{
					"id": 760930412,
					"content": "まさかここでも正体がバレるなんて…このままだと、どこに行くにも変装しないといけなくなるぞ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930413,
					"content": "決起集会に参加してたようだが…キプマキの崖の魔物討伐に行くのかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930414
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930414,
					"content": "おう！オイラたち、調査分隊の臨時隊員なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930415,
					"content": "イルーガとの出会いと、調査分隊へ参加した経緯について、ニキータに説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760930416
					]
				},
				{
					"id": 760930416,
					"content": "ほう、二人に会えるとは、あの子も幸運だな。私も安心して作戦を見守れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930417
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930417,
					"content": "余談だが、あの子が隊長としてこんな重大な任務を担うのは、今回で初めてでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930418
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930418,
					"content": "イルーガは新世代のライトキーパーの中で最も高い実力を持っている。戦闘面の心配はないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930419
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930419,
					"content": "はぁ、老いぼれの世迷い言だとでも思ってくれ。君たちの功績の数々は耳に入っている。危険な場所の調査にもきっと慣れているのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930420
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930420,
					"content": "どうか冒険者としての知恵を活かして、あの子を助けてやってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930421
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930421,
					"content": "もちろん、隊員として全力を尽くすよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930422
					]
				},
				{
					"id": 760930422,
					"content": "おう！おまえに言われなくても、全力で手伝うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930423,
					"content": "それは心強い。昔のように足が動かなくてね…そうでもなければ、私もキプマキの崖まで行って、化け物たちと対峙したんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930424
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930424,
					"content": "ふっふっふ、結局は若い者に任せて、身を引くことになるのだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 760930411,
					"content": "#{M#俺}{F#私}たちの動向がまた漏れてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930412
					]
				}
			]
		},
		{
			"id": 7609305,
			"completionStepIds": [
				7609305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
