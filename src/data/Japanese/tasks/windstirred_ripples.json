			"dialogs": [
				{
					"id": 760930101,
					"content": "辺境の闇を照らすライトブリンガーよ！我らライトキーパー、ここに誓わん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930102
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930102,
					"content": "「予見の通り——波の花が舞い上がり、静寂が星月夜を滅ぼした。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930103
					],
					"speakerTitle": "ライトキーパーたち"
				},
				{
					"id": 760930103,
					"content": "「宣言しよう——手の中の灯りを燈し続ける者は、深き闇に陥らずに済む…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930104
					],
					"speakerTitle": "ライトキーパーたち"
				},
				{
					"id": 760930104,
					"content": "「我々はライトキーパー。雪原に忍ぶ希望の灯火を守り抜く存在。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930105
					],
					"speakerTitle": "ライトキーパーたち"
				},
				{
					"id": 760930105,
					"content": "皆さん、今回の作戦目標はキプマキの崖に潜む魔物の撃退と…今回のワイルドハントを引き起こした元凶の調査です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930106
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930106,
					"content": "三年の時を経て、今、我々は再び崖の上で決戦に挑もうとしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930107
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930107,
					"content": "多くの人は僕と同じように、この作戦に参加せざるを得なかった理由を抱えていることと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930108
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930108,
					"content": "どうか、忘れないでください！我々の背後にはピラミダがあります。生きる者たちのため、未来のため——絶対に後には引けません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930109
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930109,
					"content": "「骨と血を燃料に、死よりも壮大な生を生きよう」——この誓いの言葉通り、ライトキーパーとしての責務を果たしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930110
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930110,
					"content": "出動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930111
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760930111,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ライトキーパーたち"
				}
			]
		},
