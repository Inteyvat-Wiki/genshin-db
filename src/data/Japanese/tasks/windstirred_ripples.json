						"pointId": 13664
					},
					{
						"sceneId": 3,
						"position": [
							5152.701,
							228.696,
							9595.494
						],
						"pointId": 14738
					}
				]
			},
			"dialogs": [
				{
					"id": 760930301,
					"content": "ったく、マジでやってらんないぜ。このポンコツ車、また動かなくなっちまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930302
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930302,
					"content": "なぁ月車さんよ、もうちょっとだけでいいんだ！もうちょっとだけ動いてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930303
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930303,
					"content": "もうちょっとの辛抱でピラミダに戻れるんだ！無事戻れたら、休むなり寝込むなり好きにしてくれりゃあいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930304
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930304,
					"content": "なのに、こんなところで止まりやがって…俺たちにピラミダまで担いでってもらおうってのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930305
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930305,
					"content": "はぁ～、マジついてねぇ…何やってもうまくいきゃしない。俺はお前に付き合ってる暇なんざねぇんだ…ロロンよぉ、何人か助っ人を呼ばねぇとだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930306
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930306,
					"content": "おお！？まだ誰も呼んでないのに、二人も助っ人が来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930307
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930307,
					"content": "にしては見ない顔だな。新人のトレジャーハンターか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930308
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930308,
					"content": "#よう！オイラはパイモンで、こっちは{NICKNAME}。通りすがりの冒険者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930309,
					"content": "なにか困ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930310,
					"content": "おお！俺はアンライフ、ライトキーパーだ。冒険者だったのか…そんなら、ここに来るのは間違いだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930311,
						760930312
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930311,
					"content": "大丈夫、変にあちこち弄ったりしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				},
				{
					"id": 760930313,
					"content": "そういうわけじゃないんだけどな…来たばかりで知らないかもしれないけどさ、最近北の方のキプマキの崖あたりで、大規模なワイルドハントが発生してんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930314
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930314,
					"content": "開拓時代から残る古い遺跡のあるところで、数年前にも災害があったんだ。でもまさか、こんなことになるなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930315
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930315,
					"content": "ほら、北の方を見てみろ。見えたか？最近かなりの数の魔物があそこから湧いてて、色々物騒なんだ。急ぎの用事でもない限り、ここをウロウロすんのはやめときな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930316
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930316,
					"content": "今回俺たちがピラミダに戻るのも、おやじに呼ばれたからなんだ。ワイルドハントを討伐しにいくんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930317
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930317,
					"content": "だよな、ロロン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930318
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930318,
					"content": "おいおい、どうしたんだよ、さっきから黙りこくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930319
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930319,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930312,
					"content": "ここは冒険者を歓迎してないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				}
			]
		},
