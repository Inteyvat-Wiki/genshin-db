					},
					{
						"sceneId": 3,
						"position": [
							5150.815,
							228.122,
							9597.794
						],
						"pointId": 13664
					},
					{
						"sceneId": 3,
						"position": [
							5152.701,
							228.696,
							9595.494
						],
						"pointId": 14738
					}
				]
			},
			"dialogs": [
				{
					"id": 760930501,
					"content": "ロロン…大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930502
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930502,
					"content": "大丈夫です。すみません…もうすぐピラミダに戻れると思うと、つい気が緩んでしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930503
					],
					"speakerTitle": "ロロン"
				},
				{
					"id": 760930503,
					"content": "#大丈夫ならいいんだ。さっき、ワイルドハントにやられたんだぞ。こっちの英雄{M#くん}{F#ちゃん}のおかげで助かったけど…二人とも、ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930504
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930504,
					"content": "なんてことないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930505
					]
				},
				{
					"id": 760930505,
					"content": "#{NICKNAME}にとっちゃ朝飯前だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930506,
					"content": "いやあ、なかなかやるな。ライトキーパーに加入しないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930507
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930507,
					"content": "いや、こんな時に勧誘なんて、よくねぇよな…やっぱり今の話はナシだ。忘れてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930508
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930508,
					"content": "さっき俺たちが相手にしたのは、キプマキの崖から来たワイルドハントだ。やつらは普通のワイルドハントとは違って、ありとあらゆる生き物を群れで襲うだけじゃなく、人の精神をおかしくする力を持ってやがる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930509
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930509,
					"content": "奴らがどんな術を使ってるのかは知らねぇが、人が油断した隙を狙って、ワイルドハントに取り込んじまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930510
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930510,
					"content": "今回の作戦は奴らを倒すためのもんだ。上手くいかなけりゃ、ライトキーパーの存続すら怪しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930511
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930511,
					"content": "そ、そんな深刻な問題だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930512,
					"content": "ああ、だがこれはお前ら冒険者の…それも子供の心配する事じゃねぇ。俺たちに任せな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930513
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930513,
					"content": "もしまた会えたら、今日の礼にピラミダの夜鳴鶯やミートライ麦パンをご馳走してやるよ。ライトキーパーのおもてなしだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930514
					],
					"speakerTitle": "アンライフ"
				},
				{
					"id": 760930514,
					"content": "きっとまた会えるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930515
					]
				},
				{
					"id": 760930515,
					"content": "応援してるぞ！絶対無事に帰って来てくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760930516,
					"content": "おう、ありがとな！じゃあこれで俺たちはピラミダに帰るから、縁があったらまた会おうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンライフ"
				}
			]
		},
		{
			"id": 7609306,
			"completionStepIds": [
				7609308,
				7609309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
