				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンライフ",
					"ロロン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5153.061,
							228.983,
							9598.229
