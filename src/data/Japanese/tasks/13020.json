		{
			"id": 1302012,
			"completionStepIds": [
				1302012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302012",
							"2"
						],
						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "結局シラージは酒場に来なかったし、ナランドラからも手がかりはなかったな…なんだか手詰まりって感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201202,
					"content": "アルハイゼン、本当に最後まで関わるつもりか？おまえ、この件に興味津々だよな。なんだかオイラ、ちょっと意外だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201203,
					"content": "君はすでに理由に気付いていると思っていたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201204,
					"content": "えっ？全然わからないぞ…おまえはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201205,
					"content": "シラージを知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "ああ、俺の同級生だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201207,
					"content": "そうだったのか！だからアーラヴに報告されたとき、わざわざ一緒について来るって言ったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201208,
					"content": "つまり興味があったのは、内容じゃなくて、容疑者が知り合いだったからってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201209,
					"content": "その説明は事実からあまりにもかけ離れている。まあ、俺も君がそれ以上正確な答えを出してくれるとは期待していない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201210,
					"content": "だから、一旦そのように理解してくれて構わない。俺と彼は同じ年に入学したんだ。その後、俺は書記官になったが、彼は引き続き学術の道に進んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201211,
					"content": "一年前、彼はある課題を申請した。当時の大賢者はそれを見て、俺に意見を求めてきたが…俺にはその課題があまり良いものには思えなかった。結果的に見れば、それは「根源の六罪」における「人類の進化にまつわること」に触れていたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201212,
					"content": "「人類の進化にまつわること」から「恐れを知らずに奥秘について語ること」まで、「根源の六罪」はこの世のすべての罪の始まりだ。賢者たちが教令の制定と修正をするための規範でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201213,
					"content": "俺から見て、シラージの研究はあまりにも詰めが甘く、そして一線を越えるものだった。大賢者は様々な意見を参考にして、最終的にそれを棄却した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201214,
					"content": "つまり、そいつがエネルギー源と電子部品を買おうとしてるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201215,
					"content": "おおかた、許可を得ていない状況でこっそり実験を行おうとしているんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201216,
					"content": "なーんか怪しいな…なおさら止めたほうがいいって気がしてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201217,
					"content": "イリヤース、もうちょっとがんばってくれよ。なにか思い出せないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201218,
					"content": "すまない。何度も試したけど、どうやっても思い出せない。まるで、厚い霧に覆われているような感覚なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201219,
					"content": "強烈な刺激を受けたとき、人は自己防衛のため、記憶の一部を無意識に切り取ってしまうことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201220,
					"content": "だが、それらの記憶は実際に消えたわけではなく、一時的に封じられているだけに過ぎない。適切な刺激を与えれば、回復する可能性はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201221,
					"content": "何でもいい、少しでも気になることを思い返してみるといい。必ずしも事件に関係している必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201222,
					"content": "実を言うと、さらわれて実験をされたこと以外に、忘れてしまったことがもっとある気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201223,
					"content": "自分がどんな人間だったのか、何をしていたのか、思い出せるものもあれば、どうやっても分からないものもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201224,
					"content": "ただ、「やらなければならないこと」が二つあったことまでは、かすかだけど覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201225,
					"content": "話してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201226,
					"content": "一つ目は、「教令院から給料を受け取り、ガンダルヴァー村にいる妹に渡すこと」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201227,
					"content": "詳しいことまでは思い出せないけど…毎月お金を妹に渡して、家計の助けにしていたような記憶があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201228,
					"content": "二つ目は？二つ目はなんなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201229,
					"content": "思い出せない。すまない、本当にたくさんのことを忘れてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201230,
					"content": "驚くことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201231,
					"content": "現時点において、シラージに会ったことがあるのは君だけだ。あの洞窟の具体的な位置を知っているのも君しかいない。俺たちは必要なだけ君をサポートし、記憶を回復させる手伝いをするつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130201232,
					"content": "記憶を失うのって、きっとすっごく苦しいよな…思い出せるように、オイラたちが手伝ってやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130201233,
					"content": "ありがとう。「苦しい」だけじゃなく、言葉にできないような感覚もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201234,
					"content": "記憶を多く失くしすぎたせいで、自分への認知も曖昧なものになってるんだ。頭の中で何かがざわざわ鳴り響いて、今にも気を失いそうになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201235,
					"content": "けど、そんな吐き気のするような感覚の中にも、どこか解放されたような気持ちもあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130201236,
					"content": "何はともあれ、君たちのおかげで、少しはハッキリとしてきたよ。",
