			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランチョ",
					"ピア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200101,
					"content": "君のやってるあの課題だけど、進捗はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200102
					],
					"speakerTitle": "ランチョ"
				},
				{
					"id": 130200102,
					"content": "来月には発表できるはずです。ふぅ…この前はあやうく差し止められるかと思ったのですが、何事もなくて本当によかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200103
					],
					"speakerTitle": "ピア"
				},
				{
					"id": 130200103,
					"content": "何せ、あの課題の指導教員の中にはアザールの名前もあったからね。君がとばっちりを受けるかもしれないと思ってたけど…結局どんなふうに解決したのさ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200104
					],
					"speakerTitle": "ランチョ"
				},
				{
					"id": 130200104,
					"content": "ほら、新しく代理賢者の方がいらっしゃったじゃないですか？あの方が私たちのプロジェクトを改めてチェックして、研究を続けることを許可してくださったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200105
					],
					"speakerTitle": "ピア"
				},
				{
					"id": 130200105,
					"content": "代理賢者？そんな職位、今まであったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200106
					],
					"speakerTitle": "ランチョ"
				},
				{
					"id": 130200106,
					"content": "聞いた話では、新しい賢者はまだ選定中で、しばらくは決まりそうにないから…一時的に、その人に任せることになったそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200107
					],
					"speakerTitle": "ピア"
				},
				{
					"id": 130200107,
					"content": "とにかく、彼が私たちの肩を持ってくださったおかげで、みんなの研究成果が無駄にならずに済んだんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200108
					],
					"speakerTitle": "ピア"
				},
				{
					"id": 130200108,
					"content": "論文を出したら、私も長い休暇を取ってゆっくりするつもりです。そうですね、モンドへ旅行にでも行きたいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200109
					],
					"speakerTitle": "ピア"
				},
				{
					"id": 130200109,
					"content": "連中め、よもやアルハイゼンのやつを代理賢者にするなど…一体何を考えておるのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200110
					],
					"speakerTitle": "ラージクマール"
				},
				{
					"id": 130200110,
					"content": "まあまあ、落ち着いてください先生。たしかに経歴で言えば、先生こそが学術における権威なわけですから…どうしてあんな若造が代理賢者になったのかは、正直僕も疑問に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200111
					],
					"speakerTitle": "リーアン"
				},
				{
					"id": 130200111,
					"content": "バカもん！賢者になれなかったことに文句を言っとるわけではないわ。儂はな、なぜ、よりにもよってあのアルハイゼンが選ばれたのか、それが理解できないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200112
					],
					"speakerTitle": "ラージクマール"
				},
				{
					"id": 130200112,
					"content": "昔、あいつが儂の授業を選択していたことがあったが…一学期を通しても数えるほどしか顔を見せなかった。それについて問い詰めたとき、あやつめ…なんと言ったと思う！？——儂の授業を聞くぐらいなら、家で本でも読んだほうがマシだと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200113
					],
					"speakerTitle": "ラージクマール"
				},
				{
					"id": 130200113,
					"content": "あの身の程知らず！へそ曲がりめ！あんなやつが代理賢者なんぞ、これが教令院の不幸でなくてなんだというのだ！ゴホッ…ゴホッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200114
					],
					"speakerTitle": "ラージクマール"
				},
				{
					"id": 130200114,
					"content": "お、落ち着いてください、先生！すぐにお水を持ってきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200115
					],
					"speakerTitle": "リーアン"
				},
				{
					"id": 130200115,
					"content": "シーッ…一つ秘密を教えてやるよ。新しい代理賢者だけどな、聞くところによると…俺たち知論派の先輩らしいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200116
					],
					"speakerTitle": "レザハニ"
				},
				{
					"id": 130200116,
					"content": "ほんと？誰誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200117
					],
					"speakerTitle": "ファリバ"
				},
				{
					"id": 130200117,
					"content": "アルハイゼンって名前の人だ。俺は会ったことないけど、近ごろは彼の噂で持ち切りだぜ。まあ、どれが本当の情報で、どれが偽物なのかは分からないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200118
					],
					"speakerTitle": "ロウシャン"
				},
				{
					"id": 130200118,
					"content": "それより、最近は因論派にも勢いに乗ってる学者がいるらしいじゃないか。なんでも、その人が次の賢者の一人になる可能性が高いとかなんとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200119
					],
					"speakerTitle": "ロウシャン"
				},
				{
					"id": 130200119,
					"content": "へえ。その人ってプロジェクトは立ち上げてるのかしら？私たちも早めに会っておいたほうがいいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200120
					],
					"speakerTitle": "ファリバ"
				},
				{
					"id": 130200120,
					"content": "うーん…アルハイゼンが代理賢者になるって噂は、けっこう広まってるみたいだな。でも、あいつを知らないって人もいたよな…もしかしてあいつ、そんなに有名じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200121,
					"content": "それに、評価も良いものと悪いもので真っ二つだ。特にさっきのお爺さんは、あいつにすっごく不満があるみたいだったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200122,
					"content": "うわっ、大丈夫か？具合でも悪いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200123,
					"content": "マハマトラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200124
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200124,
					"content": "マハマトラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200125,
					"content": "僕の名は…イリヤース、マハマトラに会いたい。とても、重要なことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200126
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200126,
					"content": "おいおい、大丈夫かよ。あんまり無理しないほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200127,
					"content": "いっそオイラたちに事情を言って、オイラたちがおまえの代わりにマハマトラに伝言してやるってのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200128,
					"content": "ダメだ。必ずマハマトラに直接会う必要がある…信用できるのは、マハマトラのみ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200129
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200129,
					"content": "悪いけど、少し肩を貸してくれないか。これはとても重要なことで、どんな失敗も起こってはならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200130
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200130,
					"content": "そこまで言うなら…いいぜ、オイラたちがマハマトラのところまで連れてってやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1302003,
			"completionStepIds": [
				1302003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302003",
							"2"
						],
						"stepId": 1302003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アーラヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200301,
					"content": "こんにちは！ちょっと聞きたいんだけど、セノっていま教令院にいるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200302,
					"content": "おや、よくお見かけするお二方ですね。もしかして、セノ様のご友人の方々でしょうか？あいにくですがセノ様は、いま外で任務を執行なさっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200303
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200303,
					"content": "何かありましたら私に言ってください。後ほどセノ様にお伝えしておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200304
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200304,
					"content": "オイラたち、教令院の入り口でこいつに会ったんだ。なにか重要なことで、マハマトラに会いたいらしいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200305,
					"content": "ふむ？もしよろしければ、私に話してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200306
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200307
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200307,
					"content": "シラージ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200308
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200308,
					"content": "シラージ？よく聞く名ですね、あの因論派の学者のことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200309
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200309,
					"content": "因論派の学者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200310,
					"content": "ええ。いま勢いに乗っていると話題の因論派の学者です。大胆な発想で、考えたことをそのまま実行する天才らしいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200311
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200311,
					"content": "聞くところによると、彼は因論派を代表して次の賢者の一人になるかもしれないそうです…それで、そのシラージがどうかしたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200312
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200312,
					"content": "告発をしたい…シラージは今、危険な実験を行っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200313
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200313,
					"content": "僕はやつに攫われ、恐ろしい洞窟に連れていかれた…そこには、実験機材が山ほどあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200314
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200314,
					"content": "僕は必死に逃げた…もう少しで、やつに捕まっていただろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200315
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200315,
					"content": "落ち着いて、ゆっくり話してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200316
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200316,
					"content": "彼はなんの実験をしていたんですか？その洞窟はどこにあるんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200317
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200317,
					"content": "それは、覚えていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200318
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200318,
					"content": "えっ？そんな大事なこと、なんで覚えてないんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200319,
					"content": "僕が覚えているのは、シラージがこちらに向かって歩いてきた後、僕の脳に異常が起きはじめたことだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200320
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200320,
					"content": "たくさんの事を忘れてしまった。まるで悪夢でも見ていたような感覚だ。だけど、あそこがとても危険なことだけは覚えている。今すぐやつらを阻止しなくてはならないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200321
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200321,
					"content": "そうだ、やつらは酒場で取引をすると聞いた。一刻も早く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200322
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200322,
					"content": "そう言われましても…わかりました、同僚にシラージのことを調べさせますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200323
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200323,
					"content": "ですがその前に、マハマトラによる「虚偽検出テスト」を受けてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200324
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200324,
					"content": "僕を疑っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200325
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200325,
					"content": "誤解しないでください、これはただの慣例です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200326
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200326,
					"content": "お二人はここでしばらくお待ちください。すぐに戻ってまいります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200327
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200327,
					"content": "思ったよりも長い時間待たされたあと…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130200328
					]
				},
				{
					"id": 130200328,
					"content": "あれ、アルハイゼン？どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200329,
					"content": "私が説明しましょう。先ほどイリヤースさんに虚偽検出テストを行いまして、無事に合格されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200330
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200330,
					"content": "つまり、彼の話は信憑性が高いということです。我々は彼の提供した手がかりに基づいて、調査を展開します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200331
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200331,
					"content": "そして慣例に従って、この件をアルハイゼン様にお伝えしました。それを聞いたアルハイゼン様はセノ様に手紙を残し、我々と共に行動するとおっしゃったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200332
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200332,
					"content": "なんか怪しいぞ…あのアルハイゼンがマハマトラと一緒に行動するなんて、なにか特別な理由でもあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200333,
					"content": "考えすぎだ。少し興味があるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200334
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200334,
					"content": "そうなのか？意外と暇なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200335,
					"content": "なあ、いっそオイラたちも一緒に行っていいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200336,
					"content": "アルハイゼン様が我々の行動に加わること自体、すでに規則に反していますから…そこにあなた方も一緒となると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200337
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200337,
					"content": "…はぁ、まあいいでしょう。何せ、イリヤースさんを連れてきたのはあなた方ですからね。一緒に来てもいいですよ。ただし、計画の一切については、必ず秘密にしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200338
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200338,
					"content": "おう、安心しろ！オイラたち、すっごく口が堅いんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200339,
					"content": "では、いま把握している手がかりについて説明します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200340
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200340,
					"content": "イリヤースさんは、シラージがある妙論派学者と酒場で取引をすると言っていました。これは数少ない正確な記憶で、逃げる際に偶然聞いたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200341
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200341,
					"content": "それとシラージはいま教令院にはおらず、一か月前に長期の外出調査研究を申請しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200342
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200342,
					"content": "もうじき、イリヤースさんの言っていた取引の日時になります。今すぐ酒場へ向かい、怪しい者がいないか捜索しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200343
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200343,
					"content": "そういうことだ。すぐに出発する。…君たちは勝手にするといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200344
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200344,
					"content": "オイラたちも行くって言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1302005,
			"completionStepIds": [
				1302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302005",
							"2"
						],
						"stepId": 1302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200501,
					"content": "着きました。アルハイゼン様、この後はどうなさいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200502
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200503
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200503,
					"content": "アルハイゼン様？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200504
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200504,
					"content": "どうやら君は最近、文書を一つも読んでいないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200505
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200505,
					"content": "新しく公布された教令には、すでに確立された調査案件について、たとえ賢者であってもマハマトラの行動に介入する権利はないと明確に記されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200506
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200506,
					"content": "君たちの上司がこの場にいれば、俺に何をするか聞くどころか、逆に「手出しするな」と警告していただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200507
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200507,
					"content": "…おっしゃる通りです、分かりました。ではこちらでしばらくお待ちください。ただちに周辺エリアを封鎖し、怪しい者を捜索してまいります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200508
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200508,
					"content": "イリヤースさんはここに残しておきます。アルハイゼン様には、重要参考人である彼の保護をお願いできますでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200509
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200509,
					"content": "いいだろう。もっとも、彼が自分で自分の身を守れれば尚よかったんだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200510
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200510,
					"content": "相変わらずだな…アアル村のときもそうだったけど、すーぐ人を無視するんだもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200511,
					"content": "程度の低い質問に答えることは、質問した者の甘えを許すことにつながる。それに、俺は自らの態度を彼にはっきりと理解させる必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200512
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200512,
					"content": "どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130200513
					]
				},
				{
					"id": 130200513,
					"content": "君たちと同じように、アーラヴもなぜ俺が一緒に来たのかについて疑問に思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200514
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200514,
					"content": "だが君たちと違って、彼はこの問題をさらに複雑に考えてしまった。例えるなら、「代理賢者がマハマトラの権力に手を出そうとしている」という具合にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200515
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200515,
					"content": "彼の質問は、明らかに探りを入れてきていた。マハマトラはかつて賢者の影響を受け、こういった官僚の罠に巻き込まれていたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200516
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200516,
					"content": "本来であれば、彼がそんな言い方をする必要はまったくないんだ。だからこそ俺は、彼らの仕事に手出しをしないことを、彼に分かってもらいたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200517
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200517,
					"content": "ややこしすぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130200518,
					"content": "…だから代理賢者になんてなりたくないと言ったんだ。肩書きは様々な物事を、どうしても面倒なものにしてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200519
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200519,
					"content": "失礼…アルハイゼンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200520
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200520,
					"content": "どうしても聞きたいことがあるんだ…以前、会ったことはないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200521
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200521,
					"content": "いや、君のことは記憶にない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200522
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200522,
					"content": "はは…それもそうか、あなたのような方と関わり合いがあるはずもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200523
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200523,
					"content": "なら、どうしてそんなことを聞く？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200524
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200524,
					"content": "初めて会った時、なんだか、その…馴染みのあるような感覚を覚えて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200525
					],
					"speakerTitle": "イリヤース"
				},
				{
					"id": 130200525,
					"content": "そうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200526
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200526,
					"content": "錯覚だろうか？あるいは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200527
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200527,
					"content": "アルハイゼン様！容疑者を確保しました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200528
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200528,
					"content": "シラージか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200529
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200529,
					"content": "いえ、彼と取引をしていた妙論派の学者です。名前はナランドラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200530
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200530,
					"content": "ア、アルハイゼン様？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200531
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200531,
					"content": "ちょっと待ってくれ、誰か説明してくれないか？たしかに俺は実験室から機材やパーツを盗んで売ろうとした、だが代理賢者が直々に出張ってくるようなことじゃないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200532
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200532,
					"content": "おいおい、なんてこった…まさか、とんでもないことに巻き込まれたんじゃないだろうな？お、俺はただ一時の利益に目がくらんだだけなんだ。どうか、お許しを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200533
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200533,
					"content": "いくつか彼に質問をしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200534
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200534,
					"content": "もちろんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200535
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200535,
					"content": "シラージを知っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200536
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200536,
					"content": "ああ、買い手の名前だ。酒場で取引すると約束したんだが、いつまで経っても来なくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200537
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200537,
					"content": "取引の内容は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200538
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200538,
					"content": "なんの実験をしているか知らないが、大量のエネルギー源と電子部品を必要としていた。それらは俺たちのプロジェクトでしか扱っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200539
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200539,
					"content": "そいつはそれを高値で買い取るからって、俺に「損傷品の廃棄」という名目で、一部の品を確保してほしいと個人的に連絡してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200540
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200540,
					"content": "本当なら今日、酒場でその取引をする予定だったんだ。でもまさかすっぽかされたあげく、あんたらに出くわすなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200541
					],
					"speakerTitle": "ナランドラ"
				},
				{
					"id": 130200541,
					"content": "もしかしたら、シラージはイリヤースさんが情報を漏らすことを察して、あえて約束の場に来なかったのかもしれません。いずれにせよ、手がかりはここで途切れてしまったようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200542
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200542,
					"content": "幸い、シラージのやっていることはこのエネルギー源と電子部品を必要とするようです。その進捗も必ず滞るでしょう。我々にはまだ、じっくり調査する時間があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200543
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200543,
					"content": "アルハイゼン様は、他に何か聞いておかれたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200544
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200544,
					"content": "いや、ない。ナランドラは君たちが連れていくといい。それはそうと、少しの間イリヤースを「借りる」ことはできるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200545
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200545,
					"content": "はい、問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200546
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200546,
					"content": "イリヤースさんには、すでに全面的な虚偽検出テストをしました。他に覚えていることはなかったようですし、我々も現時点では、彼から突破口を見つけられるとは思っていませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200547
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200547,
					"content": "ただ、これはついでとしてお聞きするだけなのですが、彼を手元に置いておきたい理由を伺っても？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200548
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200548,
					"content": "昔、記憶喪失に関する論文を読んだことがある。彼の記憶を取り戻せるか試してみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200549
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130200549,
					"content": "なるほど…では、我々は一足先に教令院に戻ります。イリヤースさんを頼みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200550
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 130200550,
					"content": "ついて来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				}
			]
		},
