	"talks": [
		{
			"id": 1302001,
			"completionStepIds": [
				1302001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
