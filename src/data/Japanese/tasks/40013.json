			"dialogs": [
				{
					"id": 400130201,
					"content": "これは…いったい何が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130202,
					"content": "島全体が、エネルギーの層に包まれた…まるで巨大な箱の中に閉じ込められたみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400130203,
					"content": "あそこに何かあるようだ、見に行かなくていいのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400130204,
					"content": "うん、見に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130205,
					"content": "やっと来たね、悪しき炎の娘。待ちくたびれたよ、ほんとにもう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130206,
					"content": "よーくもこのドド一族の統治者たる、ドド大魔王様に刃向かったね、その勇気褒めてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130207,
					"content": "けど残念、これでおしまい。だってドド大魔王は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130208,
					"content": "この私、クレーちゃんのママ——アリスだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130209,
					"content": "えっ？えっ？ママ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130210,
					"content": "アリスって…あ、あの『テイワット観光ガイド』を書いた人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130211,
					"content": "クレー、そしてこの島まで付き添ってくれた人たち、ど～も～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130212,
					"content": "どう？この島の海は楽しめた？照りつける夏の太陽と砂浜！むふふ、中々のバカンスだったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130213,
					"content": "ああ、探しても無駄だよ、私はここにいないから。今話してるのは私が発明した「アリスレコーダー」、ママの愛を記録して伝えるための機械だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130214,
					"content": "ほう？なるほどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400130215,
					"content": "ん～？まさか驚かせちゃってるかな？ごめんね～、うちのクレーはおもちゃが大好きだからさ。ふふっ、ママとしてそういった気持ちには応えてあげなくちゃと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130216,
					"content": "おもちゃってレベルの物じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130217,
					"content": "マ…マ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400130218,
					"content": "みんなと会えないのは残念だけど、遠くからみんなのこと見守ってるからね、これまで通り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130219,
					"content": "まさか、アリスさんがこの件に絡んでいたとは！これは私も予想外だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130220,
					"content": "えっ？ええっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400130221,
					"content": "みんな、不思議に思ってるよね？どうして、こんな遠く離れた場所にわざわざ仕掛けを作ったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130222,
					"content": "それはね！私がその島を気に入ったから！その島の遺跡や景色がすごく素敵だったから、この喜びをみんなと分かち合いたかったの。だから、色々と仕掛けを作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130223,
					"content": "クレーのママも、かなり自由人だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130224,
					"content": "あれ～、今誰か私の悪口を言ったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130225,
					"content": "えっ？い、言ってないぞ！こっちの声が聞こえてるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130226,
					"content": "いや、このくらいアリスさんなら容易いことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130227,
					"content": "どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130228,
					"content": "クレーの母親は神秘的な力を持つ万能なる魔女。驚くことはない、彼女はこういう人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400130229,
					"content": "さてさて、今は手紙のことや、船のことを考えてるのかなぁ？あと浮標とエネルギーの層のことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130230,
					"content": "まあ正直言うと、私もやりすぎたかなって思ってるんだ。でも、みんなを集めるにはこうするしかなかったからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130231,
					"content": "それに、その島には色々の物語が隠されてる、かつて暮らしていた人たちの痕跡、難破した船、謎の機械とかね。利用しないと、もったいないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130232,
					"content": "さてさて、手紙を受け取った人は全員いるよね？ガイアさん、ディルックさん、レザーちゃん、ジンさん、バーバラさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130233,
					"content": "最後は頼もしくて頭のいいアルベドちゃん…そして、謎の旅人とその仲間パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130234,
					"content": "あなたたちは私がクレーのために招待した大切な客人。クレーに素晴らしいひと夏をもたらしてくれて、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130235,
					"content": "島のすべては私からのプレゼントだよ。あなたたちがこの録音を聞いてる頃、私はどこか他のところを旅してるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130236,
					"content": "旅から旅の生活は慌ただしいけど楽しいよ。あはは、これはそこにいる旅人もよく知ってるよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130237,
					"content": "アリスさん、忙しくてクレーと一緒にいられないから、きっとこんなことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130238,
					"content": "違うよ、ママはずっとこうなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130239,
					"content": "もし今、この一件のことを深く考えていたら一言言わせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130240,
					"content": "私がモンドを気に入ったのは、自由が私たち母娘の望みだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130241,
					"content": "私はただ、クレーが好奇心と善意ある人に成長してほしいだけ。クレーの望むままに、何でもできて、どこにでも行ける…そんな子に育ってほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130242,
					"content": "なるほど…確かにアリスさんらしい考えだ。申し訳ない、誤解していたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130243,
					"content": "なんか、いいママだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130244,
					"content": "うん！クレーのママは世界一のママだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130245,
					"content": "ママ、クレーはね、お魚を捕って、船に乗って、泳いで…いっぱいいっぱい遊んだんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130246,
					"content": "みんなクレーにとっても優しくて、いつも助けてくれるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130247,
					"content": "今度はママも一緒に来て遊ぼうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130248,
					"content": "母娘揃って自由なエルフだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400130249,
					"content": "夏…そう言えば、私がその島に行った時もちょうど夏だったな。砂浜に腰を下ろして、波の音に耳を傾けていたら、クレーとの思い出が蘇ってきてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130250,
					"content": "クレー、あなたは夏に生まれた子、海と風の祝福。ママの子供として生まれてきてくれてありがとう。ママね、ずっとクレーにプレゼントを贈りたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130251,
					"content": "だから、この島を利用したの。古びた遺跡を夏の楽園にして、ドド大魔王の名を借りて招待状を送った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130252,
					"content": "異世界の伝説に「金リンゴ」って呼ばれる奇跡の島があるんだ。その島は色々な名前で呼ばれていて、人々の美しい夢が詰まってる場所なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130253,
					"content": "ママはこの伝説が好きでね。このお話と同じような素敵な思い出をクレーに作ってあげたかったんだ。だから、これはクレーへのプレゼント、青い海、真珠のように輝く砂浜、不思議な楽園、それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130254,
					"content": "クレーを愛する人たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130255,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130256,
					"content": "それで3つの水晶だったんだね…花弁のような薄紅、波のような水色、秋の葉のような鬱金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400130257,
					"content": "アリスさんにとって、この群島が4つ目の水晶なんだろう…海の真ん中に位置する、緑に覆われたエメラルド——「夏の水晶」というわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130258,
					"content": "クレーもママも、普通の人より長生きする種族。私たちにとって、時間は風のようにあっという間に吹き抜けてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130259,
					"content": "この長い命の中で、親という存在は子供の人生のほんの一部でしかない。たとえ離れたくなくとも、いずれ自分の道を歩み始めることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130260,
					"content": "クレー、ママはずっとクレーを愛してるよ。でもママ以外にも、たくさんの人がクレーの傍にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130261,
					"content": "お友達や先生、不審がりながらもクレーのために島に残ってくれた人たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130262,
					"content": "この夏はみんなのもの。たとえ生活がどんなに変わろうとも、何が起きようとも夏は消えない、人の愛のようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130263,
					"content": "これからの人生、何があっても忘れないでほしい。この世にクレーを愛する人がたくさんいるってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130264,
					"content": "あ、そうそう。アルベドお兄ちゃんの言う事をちゃんと聞くのよ。ママ、定期的に様子を見に行くから。実はたまにコッソリとモンドに帰ってるんだよ。まだ誰にもバレてないみたいだけど、ふふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130265,
					"content": "アリスさん、相変わらずのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400130266,
					"content": "もしかしてアルベド、最初から気づいてたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130267,
					"content": "ん？そろそろ時間だね、お話はここまでにしよっか。ああ、そうそう、私が苦労して作ったこの楽園、思う存分楽しんでいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130268,
					"content": "それじゃあ、みんな、クレー、バイバーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 400130269,
					"content": "ママ、バイバイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130270,
					"content": "クレー、喜んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "ふふ…大魔王はママだったんだ。クレー、なんだか嬉しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130272,
					"content": "モンドの正門をドカーンしたママも、反省室に閉じ込められたママも、変な手紙書いてくれるママも…クレー大好き。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130273,
					"content": "寂しくない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "そんなことないよ。ママはすっごいすっごい大魔女だから、いつでもクレーと一緒なの。だから寂しくない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130275,
					"content": "クレー、世界で一番ママが好き！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130276,
					"content": "#栄誉騎士の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}は、クレーのこと好き？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130277,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "クレーも大好き！ここでクレーと一緒に遊んでくれる？じゃないと、ここを頑張って作ったママが悲しむから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130279,
					"content": "まだボンボン爆弾がいっぱい残ってるの、それにドドコもいるよ。一緒に泳いで、お魚をドカーンしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130280,
					"content": "クレーと一緒だといつも楽しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130281,
					"content": "ねぇ——早く——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130282,
					"content": "クレーが待ってるみたいだ！オイラたちも行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
