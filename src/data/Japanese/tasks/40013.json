			"dialogs": [
				{
					"id": 400130101,
					"content": "クレー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130102,
					"content": "うろこを置いたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "すごい！えへへ、じゃあ次はクレーの番だね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130104,
					"content": "ああ、スイッチはクレーに任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130105,
					"content": "やった——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130106,
					"content": "クレー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130108,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "うん、分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130112,
					"content": "クレー、どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400130113,
					"content": "クレー…なんだか緊張してきちゃった…もし本当にドド大魔王がこの先にいたらどうしよう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130114,
					"content": "もし、ドド大魔王がクレーを認めてくれなかったら？クレーがドド大魔王に負けたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130115,
					"content": "負けたら、ドドコと一緒にいられなくなる。ママを悲しませちゃうかも…ドドコは、ママがくれた大切なお友達なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130116,
					"content": "怖くて、押せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400130118,
					"content": "#やっぱり、栄誉騎士の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}が押して？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130119,
					"content": "クレー、それは出来ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130121,
					"content": "武器を持ってるからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "そうじゃないとクレーを守れない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "そうだ。皆、クレーのことを守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400130124,
					"content": "ああ、これだけの精鋭が揃ってるしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400130125,
					"content": "どんな敵が出てきたとしても、俺たちがいれば怖くないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 400130126,
					"content": "ふん、ちょうどこの島の敵がどれほど強いのか、戦ってみたかったところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 400130127,
					"content": "行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400130128,
					"content": "オレも、傍にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400130129,
					"content": "みんな、そんなこと言って…ドド大魔王はただ話をしたいだけかもしれないよ？それにもしかしたら…今はもうクレーのこと認めてるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400130130,
					"content": "そうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130131,
					"content": "ボクもそう思う。クレーはここまで頑張った、大したものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400130132,
					"content": "本当？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130133,
					"content": "クレーは良い子だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "…うん、分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130136,
					"content": "じゃあ、クレー押すね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130137,
					"content": "スイッチ…ポチっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 400130134,
					"content": "#きっと認めてくれてる、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が保証する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが傍にいる。",
					"roleType": "TALK_ROLE_PLAYER",
