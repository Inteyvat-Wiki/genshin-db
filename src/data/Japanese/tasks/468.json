					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "そうか。息子が帰ってくるのを待つしかないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
