			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥナー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "こんにちは。俺の息子からなんか伝言があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680601,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "俺？ワイナリーのみんなは俺のことをトゥナーのおっちゃんと呼ぶんだ。このアカツキワイナリーの農夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680603,
					"content": "俺の家は代々この場所を耕してる。もし美味しいワインを飲んだら、8割ここのブドウのものだと言えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680604,
					"content": "だから、このワイナリーのオーナーはよくしてくれてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680605,
					"content": "ただ子孫もこのまま畑仕事を続けると思うと、あまりいいことではないかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680701,
					"content": "息子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "ゲイルだ！名前はゲイル、俺の大事な息子だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680703,
					"content": "なに？知らない？ははっ、大丈夫さ。いずれは知ることになる、このモンドもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680704,
					"content": "やつはモンドで最も優秀な西風騎士になるんだ。やつにそう言われたから、自分の息子は当然信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680705,
					"content": "はあ、やつには俺と同じように畑仕事を一生続けてほしくないから、小さい頃からいろいろやらせたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680706,
					"content": "でもさすが俺の息子、16歳で見習騎士になったから、頼りになるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680801,
					"content": "じゃあ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "ああ、俺の息子ゲイルに会ったら、時間があったら帰ってこいと伝えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
				}
			]
		},
