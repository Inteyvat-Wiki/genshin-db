			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "君は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680203,
					"content": "…旅人さんか。優しい人なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680204,
					"content": "今はブドウ栽培の大事な時期なのに、どこから来たのか、イノシシの群れがここを狙ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680205,
					"content": "一人じゃ追い払いきれないし、息子もここにいないからさ、あいつらがブドウを壊していくのを見るしかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 4680206,
					"content": "イノシシをこらしめてくれるなら、このトゥナーがちゃんとお礼するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
				}
			]
		},
		{
			"id": 46803,
