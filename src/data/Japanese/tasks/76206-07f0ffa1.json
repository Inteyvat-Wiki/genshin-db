			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カスティリオーネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "狩野、まだ屏風も描き終わっていないのに、うろうろしないように。まずは滝をどう描くか考えてください。ああ、エゲリア様よ…散点透視で滝を描く人なんていないんですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060102,
					"content": "…ん？ああ、すみません。見知らぬ方でしたか。足音を聞いて、てっきり狩野かと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060103,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "ご覧の通り、絵を描いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060105,
					"content": "誤解のないよう、先に申し上げておきます。私は動物を描くのは得意ですが、私が描く動物は食べるためのものではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060106,
					"content": "えっ、食べられるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762060107,
					"content": "絵の中の人物が目の前の人物であるなら、絵の中の獣もまた皿の上の獣となり得る…はぁ、とは言え、璃月の妌{RUBY#[D]ジョウキ}癸さんのように、私に魚肉ばかり描かせようとするのは勘弁していただきたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060108,
					"content": "芸術——尊い芸術！いつの時代も、その主旨は人の魂の救済、情操の陶冶にあり、真、善、美をもって、私たちをより高き精神の境地へと導くものであるべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060109,
					"content": "たとえば、山の頂に立ったとしましょう。そこで目にする風景はありのままで、遮るものは何もありません。私が追求する芸術もまた、そのようなものなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "カスティリオーネ"
				},
				{
					"id": 762060110,
					"content": "むう…言葉だけでは、ストレートに理解するのは難しいかもしれません。ではこうしましょう、私が浮遊台を描いて差し上げますので、それに乗って体験してみれば、あなたにもご理解いただけると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カスティリオーネ"
				}
			]
		}
	]
}