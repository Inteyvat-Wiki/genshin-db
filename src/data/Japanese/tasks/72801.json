					"梢"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "いらっしゃいませ、「木漏茶屋」へ何かご用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010202,
					"content": "ラムゼイについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "あの商人ですか…確かに茶屋にいますが、何だか最近は緊張しているように見えます。何があったのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "梢"
				},
				{
					"id": 728010204,
					"content": "彼を探したいのであれば、中に入れば会えるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梢"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラムゼイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "君は…旅人？何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010302,
					"content": "「遊記」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "ああ、緑っていう子に書いてあげた「遊記」のことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010304,
					"content": "実は…最近はそれを書く時間が無くて。あの子、きっと待ちくたびれているだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010305,
					"content": "「遊記」の内容は本当のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "ははは、君はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010307,
					"content": "嘘っぽい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "ははっ、さすが世界を旅する人。あっさりとバレちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010311,
					"content": "その通り、「遊記」に書いてあることは本当のことじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010312,
					"content": "現実を参考にした場所や人物はあるけど…ほとんどの内容は僕個人の想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010313,
					"content": "もちろん、全部が想像ってわけじゃないよ。例えばある「遊記」では、主人公は一人でスーパー風船を作ったって書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010314,
					"content": "そして数人の仲間を集め、風船を使って八十日以内にテイワット大陸を一周しようとしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010315,
					"content": "しかも、その風船の操縦に「神の目」は必要なくて、技術に関する知識があれば十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010316,
					"content": "彼らは風船に乗って世界を旅し、道中、数え切れないほどの不思議なものや現象に遭遇した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010317,
					"content": "その話は、もともと緑に書いてあげる予定だった…でもある理由で、今はほとんど書けてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010318,
					"content": "どんな理由？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "廊下にいるやつをみた？彼は平八、いつからかは分からないけど、ずっと僕の後についているんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010320,
					"content": "もともとは、「遊記」のネタを探しに外に出ようと思っていたんだけど、彼はなぜか僕についてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010321,
					"content": "彼が何か悪さをするんじゃないかと恐れて、外に出ないようにした。こうして、「遊記」をしばらく書かなくなったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010322,
					"content": "でも旅人、せっかく君が来てくれたんだ。ネタ探しに付き合ってくれる？君がいると、こいつも悪さをする勇気がなくなると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010323,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "じゃあお願いするね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010327,
					"content": "しかも「警戒心を失ってはならない」ってよく言うでしょ。誰かに後をつけられてたら、多少は警戒しておかないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010328,
					"content": "だから、ネタ探しの時の護衛はお願いするね、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010329,
					"content": "場所はいくつか決まっているんだ、今すぐ行けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010330,
					"content": "一つ目は近くの海辺だ。さっそく出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010325,
					"content": "彼はどうしてそんなことするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "分からない。でも…誰かに悪意を抱くには、特に理由は必要ないと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010309,
					"content": "本当のことであってほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "ははっ、僕も書いたことを現実にしたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "ラムゼイ"
				}
			]
		},
