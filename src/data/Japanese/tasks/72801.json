					"nextDialogs": [
						728011302
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728011302,
					"content": "山頂の風はかなり強いし、障害物もないから飛行に最適だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728011303,
					"content": "しかも稲妻城から十分離れているから、同心…暇人に邪魔されない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
