			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラムゼイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "ここの海水は非常に澄んでいて、砂の色も白い。狂騒的な外海とは全く違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010502,
					"content": "ここから海に…空を飛べば、きっといい眺めになる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010503,
					"content": "コホッ、ここの景色はすばらしい。記録しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010504,
					"content": "旅人、少し待ってくれる？遊記の書き方を考えてみたいんだ。君たちは先に海を楽しみながら散策しててよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "ラムゼイ"
				},
				{
					"id": 728010505,
					"content": "…でも、そう遠くには行かないでね。あの平八ってやつ、もうついてきてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラムゼイ"
				}
			]
		},
		{
			"id": 7280106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
