			"dialogs": [
				{
					"id": 740310301,
					"content": "ハハッ、愉快！爽快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310302
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310302,
					"content": "#オレの目に狂いはなかった。金髪の{M#兄ちゃん}{F#嬢ちゃん}は、やっぱり戦い甲斐のある相手だったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310303,
						740310305
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310303,
					"content": "#{M#君}{F#あなた}もなかなか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310304
					]
				},
				{
					"id": 740310304,
					"content": "ハハッ、俺の鍛錬もまだまだ足りねぇな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310307,
					"content": "自慢じゃねぇけど、オレは言ったことを必ず守る人間でね。ほら、約束した特別許可券だ、持っていけ。また機会があったら、戦おうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310305,
					"content": "まだまだだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310306
					]
				},
				{
					"id": 740310306,
					"content": "#おっと、{M#兄ちゃん}{F#嬢ちゃん}は容赦ないな。気に入った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "ニザーミー"
				}
			]
