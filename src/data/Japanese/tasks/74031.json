			"dialogs": [
				{
					"id": 740310101,
					"content": "若き戦士よ。オレと勝負しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310102,
					"content": "と、唐突だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740310103,
					"content": "#なんとでも言え。金髪の{M#兄ちゃん}{F#嬢ちゃん}、見たところ相当な鍛錬を積んだ強者だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310104,
					"content": "最近は誰も勝負してくれなくて、退屈してたんだ。練習に付き合ってくれたら、特別許可券をやろう！以前、ロシモフからたくさん勝ち取ったもんなんだが、使い道に困っていてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "ニザーミー"
				},
				{
					"id": 740310105,
					"content": "さっ、俺と勝負してくれるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニザーミー"
				}
			]
		},
