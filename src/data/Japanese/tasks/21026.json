			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "この漂流瓶に入った手紙、子供の筆跡のように見えるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260102,
					"content": "モン？そんな子知らないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260103,
					"content": "え？この漂流瓶は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "旅人？その言い方、君はこの手紙を書いた人を知っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260105,
					"content": "まあ、知ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "そうか。その子も色んなことを考えているんだね。大人になりたい、か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260108,
					"content": "外に出て、旅をして、自分の視野を広げれば、彼のこういう悩みは自然に解消されると思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260109,
					"content": "そういえば、モンも璃月港を出て外の世界を見たいって言ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210260110,
					"content": "でも、オイラたちも彼を誘ったのに、なんで受け入れなかったんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210260111,
					"content": "ハハハ、それはその小さな漢の「強情」ってものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260112,
					"content": "自分の悩みなんだから、他人に頼るんじゃなく、自分で解決しないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260113,
					"content": "でもモンは漂流瓶を流しただけで、それじゃ問題は解決しないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210260114,
					"content": "ああ。だから、こういう時には頼れる大人の助けが必要だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260115,
					"content": "さあ、旅人、その坊やに手紙を書こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260116,
					"content": "この手紙を通して、外の世界ではどんなものが彼を待ち受けているのか、教えてあげるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260117,
					"content": "でも…へへ、私はそんなにたくさんの場所に行ったことがあるわけじゃないから、どこの面白い話を書くかは、君に任せるよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260118,
					"content": "暴風に包まれる高塔の廃墟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "ああ、ゆっくりで頼むよ。まだ書けてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260122,
					"content": "うん、ここは…こう書いたほうがいいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260123,
					"content": "よし！完成だ、ついこんなにたくさん書いてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260124,
					"content": "ハハハ、君の話を聞いてたら、私も旅がしたくなったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260125,
					"content": "旅に出るのも悪くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "私はこんな歳だから、やるべきことがたくさんあってね。もう好きなように旅に出ることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260127,
					"content": "手紙は漂流瓶に入れた。さあ、早く川に流してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210260119,
					"content": "雷暴に包まれる海の外の群島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "雷神の一太刀で斬られた島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "璃月港の子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
