					"岳川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "どうだ？漂流瓶を流したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261002,
					"content": "モンはちゃんと拾えるかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "うん…それは難しいだろうな。普通なら拾えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261004,
					"content": "それじゃ意味ないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210261005,
					"content": "まあまあ、落ち着いて。さっき言っただろう、頼れる大人が彼を助けるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261006,
					"content": "「スメール」というところを知ってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261007,
					"content": "商売をしてる仲間が何人かいてね。彼らはキノコの商売を計画してるから、最近そこに調査をしに行ってるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261008,
					"content": "ハハハ、分かるだろう。スメールに「調査」をしに行くとかなんだか言って、その実、遊びに行くだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261009,
					"content": "そのモンという坊やが外を旅したいと思ってるなら、やつらに他にも連れて行けないかって連絡してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261010,
					"content": "君たちは心配しなくていい、私が手配しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261011,
					"content": "他のことに使いたいから、手紙をもう一通書き写しておいた。その漂流瓶は…そのままにしておいてもいい。きっと拾う人はいないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261012,
					"content": "手助けしてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "大人が子供の夢を叶えてあげるのは、当然のことだろう？この件は私に任せて、安心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261015,
					"content": "そうだ、子供を怖がらせないよう、まともな服を着ておけと仲間たちに伝えないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岳川"
				},
				{
					"id": 210261013,
					"content": "どうしてモンを手伝おうと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
