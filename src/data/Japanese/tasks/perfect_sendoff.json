			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130601,
					"content": "やっと辿り着いた。あのおかしな空間から抜け出せないかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130602,
					"content": "わざとそういう風にすることで、勝手に入ってきた人を驚かせて近づけさせないようにしているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "もう変なものは出てこないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130604,
					"content": "うん、あとはここから飛び降りるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "はあ——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1111307,
			"completionStepIds": [
				1111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
