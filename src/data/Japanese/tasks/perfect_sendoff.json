			"dialogs": [
				{
					"id": 111130801,
					"content": "ほお、僕たち5人の名前が書いてあるよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130802,
					"content": "へへ、よかった。そうだ、さっき毎年灯を飛ばしてるって言ってたけど、そこに書かれた名前も多くなっていってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130803,
					"content": "たとえば、小五の子供とか、木木のお嫁さんとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130804,
					"content": "実はいい知らせがあってな、木木はもうすぐお父さんになるんだ。あいつ、最近はそのことで居ても立っても居られない様子でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130805,
					"content": "はははっ、あんなに鈍感だったのに、いいお父さんになれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130806,
					"content": "いやいや、今は頭が切れるぞ。詳しく話すとだな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孟"
				}
