				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "おっ、戻ってきた！想定してたよりも早い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130102,
					"content": "パイモン、バレてないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130103,
					"content": "オイラ、そんなに信用できないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130104,
					"content": "えへへ、冗談だよ。別に大丈夫。自分たちを象徴する物をくれたということは、多かれ少なかれ勘付かれてるだろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130105,
					"content": "でも、幽霊や亡霊に関しては、何が起きてもおかしくないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130106,
					"content": "彼らがそれ以上追及してこない理由はそこにあるのかもね。もし後々何かに付け狙われることになったら、その時は…一線を越えることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130107,
					"content": "なんだか怖い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "「生と死の境界を維持する」、往生堂にとって一番重要な仕事だもの、普段よりも真面目になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130110,
					"content": "オイラたちはもう特例なのか？「境界」を越えても大丈夫なんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130111,
					"content": "もちろん、あなたたちを巻き込んだ以上、孟と同じように何も隠すつもりはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130112,
					"content": "これから行く場所で、何を見ても、何があっても、驚かないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130113,
					"content": "そこは生と死の境界にある場所だけど、ただの平凡な地。一つ特別なところを挙げるとすれば、人々に知られていないってところくらいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130114,
					"content": "ほんとうに、ほんとぉーに驚かないでよ？じゃないと、あとであなたたちの記憶を消さなきゃいけなくなるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130115,
					"content": "行こう！お互いのためにも肝に銘じておいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130116,
					"content": "な、なんか怖いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130117,
					"content": "でも、ここまで巻き込まれた以上、最後まで付き合おうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130108,
					"content": "冗談なのか真面目なのか分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111301",
