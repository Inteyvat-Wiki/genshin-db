			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小五",
					"木木",
					"聡子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "そういえば、お前たち二人は自作の物なのに、俺だけ買ってきた物だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111122302,
					"content": "でも値段的には、そっちの方が僕たちのより何倍も高いでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111122303,
					"content": "重要なのは値段じゃなくて、記憶に残っている大切な物かどうかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111122304,
					"content": "それと、あの約束を永遠に忘れないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聡子"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
