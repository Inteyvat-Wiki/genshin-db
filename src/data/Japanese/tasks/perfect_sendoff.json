			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"思い出の中の狼兄貴",
					"思い出の中の小五",
					"思い出の中の木木",
					"思い出の中の聡子",
					"思い出の中の孟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "また海灯祭の時期か、いつの日か灯を見にいけたらいいなあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "思い出の中の小五"
				},
				{
					"id": 111130402,
					"content": "灯がなくても願い事はできるよ、お母さんが教えてくれたの。大声で願いを言えば、将来きっと叶うって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "思い出の中の聡子"
				},
				{
					"id": 111130403,
					"content": "大声で？それは…恥ずかしくない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "思い出の中の狼兄貴"
				},
				{
					"id": 111130404,
					"content": "誰かが先にやって、みんなが続けば、お前も恥ずかしくなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "思い出の中の孟"
				},
				{
					"id": 111130405,
					"content": "そうだそうだ。小五、先にやってよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "思い出の中の聡子"
				},
				{
					"id": 111130406,
					"content": "僕は、いつの日か、食べきれないほどのご飯とお菓子がある大きな料理屋を開く！毎日、椒椒鶏が食べられるように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "思い出の中の小五"
				},
				{
					"id": 111130407,
					"content": "ははは、それだけかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "思い出の中の木木"
				},
				{
					"id": 111130408,
					"content": "笑うな、そっちはどうなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "思い出の中の小五"
				},
				{
					"id": 111130409,
					"content": "もちろんお金を稼ぐことさ！たくさん商売をして、たくさんお金を稼ぐ！お金があれば何でもできる、こんないいことはないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "思い出の中の木木"
				},
				{
					"id": 111130410,
					"content": "そうだな、お金があれば、あの高いおもちゃ箱だって買えるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "思い出の中の孟"
				},
				{
					"id": 111130411,
					"content": "買うなんてもんじゃねえ、一人一個ずつ……いや、一人何個でもだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "思い出の中の木木"
				},
				{
					"id": 111130412,
					"content": "じゃあ、木木が大商人になったら、私はお金を稼がなくてもいいってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "思い出の中の聡子"
				},
				{
					"id": 111130413,
					"content": "いやいや、お金を稼ぐのは大変なんだ。俺だけに頼るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "思い出の中の木木"
				},
				{
					"id": 111130414,
					"content": "私は、大きな明霄の灯を作りたい。霄灯作りも学びたい。将来は最も腕の立つ職人になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "思い出の中の聡子"
				},
				{
					"id": 111130415,
					"content": "そうだね、そうなったら璃月港に行かなくても、霄灯を飛ばせる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "思い出の中の狼兄貴"
				},
				{
					"id": 111130416,
					"content": "それで、孟と狼兄貴は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "思い出の中の小五"
				},
				{
					"id": 111130417,
					"content": "僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "思い出の中の狼兄貴"
				},
				{
					"id": 111130418,
					"content": "あっ、一番肝心なところで消えちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130419,
					"content": "懐かしいなあ。あれが俺たち5人の揃った最後の海灯祭だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130420,
					"content": "時間が経って、みんなこんなに大きくなったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130421,
					"content": "あの時言ってた願いは、叶えられたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130422,
					"content": "叶ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "3人に会ってきて、それぞれ自分を象徴する物を貰ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130425,
					"content": "小五は料理人に、木木は大商人に、聡子は霄灯職人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130426,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130427,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130428,
					"content": "あの時言ってたことは、ずっと俺たちの心に残ってる。何がなんでも叶えるという約束だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130429,
					"content": "とりあえず、この灯を飛ばそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130430,
					"content": "#ちょっと、{NICKNAME}、空気を読んであげてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130431,
					"content": "彼らが話してる間は、遠くでそっと見守りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130423,
					"content": "全部ここにある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
			"id": 1111305,
			"completionStepIds": [
				1111305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111305",
							"2"
						],
						"stepId": 1111305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡桃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130501,
					"content": "空気が読めないって、おまえに一番言われたくないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130502,
						111130504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130502,
					"content": "生と死の「境界」の維持は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130503
					]
				},
				{
					"id": 111130503,
					"content": "孟はすでに「境界」を越えた人間、だからこれでいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130506,
					"content": "前にも言ったけど、往生堂が最初に行ってたのは葬儀じゃなくて、お医者さんみたいな仕事だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130507
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130507,
					"content": "魔神戦争の時期は、死体の山、おびただしい数の霊、蔓延する疫病、すなわち「死」が私たち生者の世界を蝕んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130508
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130508,
					"content": "その時に、往生堂ができたの。弱々しい人間という身分で、長い時をかけ、死を追い返した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130509
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130509,
					"content": "大きな代償を払ってきたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130510,
					"content": "それからまた長い年月が経ち、璃月港は栄えた。人々は名誉とモラを追い求め、やがて狂気に達した人が死の「遺産」に触れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130511
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130511,
					"content": "魔神の残滓が人の世を壊したの。具体的なことは省くけど、それは「生」という自滅と、「死」という終焉でもあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130512
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130512,
					"content": "それから凄く凄く長い時を経て、やっと均衡が整い、境界を保てるようになったの。そのおかげであなたたちが見た今の璃月港がある。今の往生堂と、私もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130513,
						111130515
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130513,
					"content": "そんな真面目なこと、言えたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130514
					]
				},
				{
					"id": 111130514,
					"content": "あははっ、これは以前の堂主が好んで語ってたことだよ。彼らよりは上手く話せてると思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130517,
					"content": "どれだけ理解できてるかは、あなたたち次第。私からしたら、何も知らない方が楽だけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130518,
						111130519
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130518,
					"content": "それが一番かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130520,
					"content": "この時代は恵まれてるよ。生と死がこんなに平和に寄り添ってる。こんなの当たり前じゃないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130521
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130521,
					"content": "ふぅ、そろそろ時間だね。行こう！彼らを「始まりと終わりの地」へ送らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130522
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130522,
					"content": "それってどこのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130523,
					"content": "私たちが初めて会った場所。適当につけた名前だから、気にしないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130519,
					"content": "うん、そろそろ帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130515,
					"content": "もう少し話してくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130516
					]
				},
				{
					"id": 111130516,
					"content": "だーめ！あなたは本当に好奇心旺盛だね。忘れないで、知らない方がいいことは、知らない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130504,
					"content": "往生堂は想像してたのと全然違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130505
					]
				},
				{
					"id": 111130505,
					"content": "そう？目的が達成できるなら、過程なんてどうでもいいでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "胡桃"
				}
			]
		},
		{
			"id": 1111306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
