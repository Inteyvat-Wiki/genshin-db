			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "狼兄貴、満足できたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130702,
					"content": "もし何かのきっかけで悪鬼になったら、その時は容赦なく滅却するけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130703,
					"content": "しないしない、こんなにしてもらって、もう大満足だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130704,
					"content": "みんなが元気にやってるのが分かって、本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130705,
					"content": "お前たちにも感謝しないとな。ある意味、俺の夢を叶えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130706,
					"content": "さっき言ったことはあなたも同じよ、孟。もしまだこれ以上クヨクヨするようなら、覚悟してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130707,
					"content": "い、いや…そんな笑いながら怖いこと言わないでくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130708,
					"content": "あはは。じゃあ、最後の最後に、狼兄貴に一言言ってあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130709,
					"content": "またな、狼兄貴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130710,
					"content": "違う違う、またなはだめ、「いってらっしゃい」とかにしないと。また会ったら困るでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130711,
					"content": "はは、大丈夫、僕はそっと離れることにするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130712,
					"content": "ごめんね、僕たち二人が言った夢だけは、叶えられそうにない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130713,
					"content": "気にするな、どうってことない。安心していけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130714,
					"content": "うん、みんなのことは忘れない、それじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111130715,
					"content": "行っちまったな、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130716,
					"content": "何だか人生の一大事を成し遂げたみたいで、心が空っぽな感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130717,
					"content": "さっき言ってた、二人の願いって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130718,
					"content": "「お互い家庭を築いたら、家族皆を連れて海灯祭を過ごす。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130719,
					"content": "だから俺はあいつらが羨ましいんだ。あいつらはもう夢を叶えたが、俺の夢は、もう一生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130720,
					"content": "そんなに悲しまないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "そうだそうだ、それに誰だって死ぬ日はいつか来るものなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130723,
					"content": "生きているうちにしっかり生きて、やるべきことをやってから、会いたい人に会う、それもいいことだと思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130724,
					"content": "うぅ…あ、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130725,
					"content": "とにかく、もう無妄の丘には戻らないと思うから、しっかりと気持ちの整理をしなきゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111130726,
					"content": "それじゃあ、この機会にどこか遊びに行ってきなよ、許可する。あ、もちろん今と同じく給料は出ないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130727,
					"content": "待てよ、なにか忘れてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130728,
					"content": "「人探し」を手伝うって言ってたのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "ん？「境界」に連れて行ったのは、人探しを手伝うのも兼ねてたんだよ。その反応じゃ、見つからなかったみたいだね。残念、惜しい惜しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130730,
					"content": "いや、ちっとも惜しくない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130731,
					"content": "ははは、私もあなたたちが見てないところで探してみたんだけど、残念ながら何も見つからなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130732,
					"content": "これからも気には留めておくから、何か分かったらあなたに連絡する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130733,
					"content": "適当に言ってるだけじゃないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130734,
					"content": "えへへ、生きてる人を探すのは得意じゃないんだ。もし「境界」の向こうにいる人探しなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130735,
					"content": "縁起でもないこと言うなよ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130736,
					"content": "安心して、その生きた人もしっかりと探してあげる。もう、いつになったら私の冗談に慣れてくれるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130737,
					"content": "この仕事を心底楽しんでるようだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "あはは…私にも私なりの理由があるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130740,
					"content": "理由？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111130741,
					"content": "今日私たちが行った場所で見てきたものは、生者の世界に執念を持つ死者たちなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130742,
					"content": "でも、私はそこで歴代の「堂主」を見たことがない…一度も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130743,
					"content": "往生堂の堂主になることは、きっと悔いの残らない正しいことなんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111130738,
					"content": "本当に堂主に向いてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "人生はまだ長い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
