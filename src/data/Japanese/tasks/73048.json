			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランムフクンダ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730480101,
					"content": "なんと懐かしい。前回このような光景を見たのは、数百年前になるか…この目で再びヴァナラーナの夢郷を見られたのも、キミたちのおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480102
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480102,
					"content": "わぁ！おまえってずいぶん長生きなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480103,
						730480104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730480103,
					"content": "アランナラが「年」って言うのを初めて聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				},
				{
					"id": 730480105,
					"content": "そうだろうか？それはワタシが多くの記憶と知識を吸収したからかもしれない。夢郷の中のヴァナラーナには昼も夜もなく、すべてが平穏だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480106
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480106,
					"content": "その上、ワタシたちの寿命は長い。ゆえに、ワタシたちは「時間」の概念が希薄なんだ。ワタシたちは樹木の成長、花の盛り、月の昇り降りで時間の流れを測る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480107
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480107,
					"content": "ウツァヴ祭を行う以上、ビージャの実が必要なのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480108
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480108,
					"content": "うん…そういえば、ビージャの実って一体なんなんだ？前にアランラジャとアランマも、あまり教えてくれなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730480109,
					"content": "#キミたちはすでにアランナラの友達だ。ならば、アランラカラリの原理は聞いたことがあるだろう。ナラ{NICKNAME}、パイモン、分かるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480110
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480110,
					"content": "アランラナは記憶の力だって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480111
					]
				},
				{
					"id": 730480111,
					"content": "アランラナ？懐かしい、元気だろうか。アイツは少しそそっかしいが、きっとキミを友達と思ったから教えたのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480112
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480112,
					"content": "ビージャの実は記憶と夢を抽出して実る果実、ワタシたちアランナラにとって、もっとも貴重なものの結晶だ。果実とは言うが、希望の種でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480113
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480113,
					"content": "誰かを助けたいという願いだけを、ビージャの実は叶えることができる。キミたちと今回ビージャの実を求めるアランナラには、誰かを助けたいという願いがあるのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480114,
						730480115
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480114,
					"content": "ラナを助けたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480116,
					"content": "#うん、ならば問題ない。ナラ{NICKNAME}がアランナラの友達ならば、これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480117,
						730480118
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480117,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480119,
					"content": "小さな花…この前、アランラナやアランナキンたちも花をくれたっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730480120,
					"content": "そうだったか。長い時が経ったが、この習慣は変わっていないようでよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480121
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480121,
					"content": "#以前、ワタシはアランラジャ、アランジ…そしてアランパカティたちと一緒に、ナラヴァルナに花を贈ったことがある。{M#カノジョ}{F#カレ}はワタシたちの大事な友達だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480122
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480122,
					"content": "この花はアランナラの友情の証。そしてこの花を受け取った者は、アランナラとの友情を認めたことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480123
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480123,
					"content": "ワタシたちアランナラは口下手だ。ゆえにワタシたちにとって、ヒト類の友達が花を受け取ってくれることは、とても誇るべきことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480124
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480124,
					"content": "#多くのナラ{NICKNAME}の物語を聞いたが、キミもワタシの大切な友達だと言える。キミがワタシの花を受け取ってくれるのは光栄なことだ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480125,
						730480126
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480125,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480127,
					"content": "#必ずまた会おう。その時はナラ{NICKNAME}、パイモン、ワタシの家に来てほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480128
					],
					"speakerTitle": "アランムフクンダ"
				},
				{
					"id": 730480128,
					"content": "あ、消えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730480129,
					"content": "なんか変わったアランナラだったな！まあいいや、他のアランナラにも会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730480126,
					"content": "こちらこそありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480118,
					"content": "ありがたく受け取るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480115,
					"content": "アランラナは友達を助けようとしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480104,
					"content": "他のアランナラとは時間の概念が違う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				}
			]
		}
	]
}