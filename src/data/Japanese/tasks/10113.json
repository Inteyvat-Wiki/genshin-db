			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "やっと来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130502,
					"content": "分かりにくかったぞ！次はこういうのやめてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130503,
					"content": "そうだ、吟遊野郎、酒は手に入ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130504,
					"content": "手に入れたよ。ジャックのやつ、「貴重な名酒」って言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130505,
					"content": "結局、ただのアップルサイダーだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130506,
					"content": "懐かしいなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130507,
					"content": "初めてここで景色を眺めた時、ボクは「この姿」じゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130508,
					"content": "この姿…じゃなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "だいたい2600年くらい前かな、この世界がまだ七神の管理下に置かれていなかった時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130510,
					"content": "あの頃、「旧モンド」は暴君が吹き起こした暴風に囲まれていて、鳥すらも行き来できなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130511,
					"content": "「旧モンド」？ああ、思い出したぞ、今の風龍廃墟だろ？おまえが前に言ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130512,
					"content": "その通り。かつてあの高塔を統治した風の暴君は、「竜巻の魔神」デカラビアンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130513,
					"content": "あの時のボクは、千の風の中の一つで、神でもなく、人の姿でもなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130514,
					"content": "風の中の些細な元素の精霊、「小さな転機と希望をもたらす風」だったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130515,
					"content": "元素の精霊？人の姿じゃなかった？あれ？吟遊野郎、昔はこんな感じじゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130516,
					"content": "うん。今のボクの姿は、実はあの偽物のスタンレーと同じ、「友達」のものを借りたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130517,
					"content": "その後は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130518,
					"content": "おまえの友達、その後どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130519,
					"content": "（ウェンティの友達は、スタンレーのように…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "パイモン、その後の話が知りたいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130521,
					"content": "あったりまえだろ！もったいぶらないで、早く教えてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130522,
					"content": "パイモン、リンゴ二つ取ってきてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "なんで急にリンゴなんか食べたくなるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130526,
					"content": "あははっ、お腹が空いたんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130527,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "うう…仕方ないやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130529,
					"content": "ああ——君は賢すぎると、ボクはたまにそう思ってしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130530,
					"content": "でも、友達の間ではこういう暗黙の了解があった方がいいのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130531,
					"content": "美酒、そよ風…こういう時は、いつも思い出してしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130532,
					"content": "彼から教えてもらった歌をね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130533,
					"content": "ちゃんと聞くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "パイモン、魚肉を探してきてくれないかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "ん？今は話を聞いてる途中だろ？どうして急に食べ物を欲しがるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}