				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スタンレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "スタンレー…どうすればいいか教えてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130302,
					"content": "ん？なんで自分の名前を呼んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130303,
					"content": "何か秘密があるのかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "まさか、他にもスタンレーっていう名前の人がいるとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130307,
					"content": "ううっ！くっ…スタンレー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130308,
					"content": "あの時、燼寂海で死ぬべきだったのは…俺だった！なぜお前の名前を騙ってるのに、俺はお前の魂を繋ぎ止められないんだ？スタンレー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130309,
					"content": "新米の俺を庇わなければ、あの風のない場所でお前が死ぬことはなかったのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130310,
					"content": "お前には偉大な大冒険者の肩書きがある、でもクズの俺なんかのために、もう伝説になれないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130311,
					"content": "これは…一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130312,
					"content": "…たぶん、彼は本当に燼寂海に辿り着いたんだろう。そこで遭った危機も、本当のことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130313,
					"content": "ただ、彼と共に冒険をした仲間こそが、本物の「大冒険者スタンレー」だったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130314,
					"content": "本物のスタンレーは、ボクたちの知る「スタンレー」を助けるために死んだんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130315,
					"content": "あっ…じゃあ、この「スタンレー」がスタンレーと名乗ってるのは、彼がそいつの名前を「盗んだ」から？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130316,
					"content": "そういうことだと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130317,
					"content": "スタンレー…もう何年経った。モンドの人々がお前のことを忘れていくのが怖くて、俺はあちこちでお前の話をした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130318,
					"content": "俺はモンドの人々にお前を覚えていて欲しい。スタンレーが燼寂海に辿り着いたこと…そして偉大な冒険者であり、彼が生きていると！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130319,
					"content": "スタンレーは死なない、なぜなら俺がスタンレーだからだ！…俺が…スタンレーだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130320,
					"content": "すまない、スタンレー…俺も歳を取った、歳を取ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130321,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130322,
					"content": "お前たち、いつまで盗み聞きしてるつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130323,
					"content": "まずい！気付かれた…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130305,
					"content": "他にもスタンレーがいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "それはないかな、スタンレーが2人いるなんてボクも聞いたことないもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スタンレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "行け、何も聞かないでくれ、一人にしてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130402,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130403,
					"content": "行け！二度は言わんぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130404,
					"content": "栄誉騎士、ウェンティ、それとパイモン！よかった、みんなここにいたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130405,
					"content": "あちこち探したよ！お礼を言いに来たんだ。君たちが剣と盾を探してくれたおかげで、両親がやっと認めてくれてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130406,
					"content": "おや？それは本当かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130407,
					"content": "本当さ！金を出して「煌めく勇気の剣」と「輝く意志の盾」を直すと言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130408,
					"content": "それはよかったね。それでジャック、君はモンドを離れてテイワット大陸を旅するのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130409,
					"content": "いや、しばらくはモンドにいるよ。今の僕の実力じゃ、遠くへ行けそうもないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130410,
					"content": "それに、スタンレーさんの話をもっと聞きたいからさ。へへっ…なんたって、彼が僕の夢のきっかけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130411,
					"content": "スタンレーさん…ああ、また酔っぱらってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130412,
					"content": "また明日、スタンレーさん。酔いが覚めたら、またお話を聞かせてくださいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 101130413,
					"content": "スタンレーはジャックのことが気に入ってるんだろうね、君はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130414,
					"content": "ジャック？ジャック！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130415,
					"content": "ジャックならもう帰ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130416,
					"content": "そうか…俺の秘密を守ってくれてありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130417,
					"content": "えっ？急に現実を見るようになったのかい？今までの君らしくないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130418,
					"content": "俺はさっき…彼を見る勇気がなかった。彼の冒険に対する情熱は、何の雑念も含まれてないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130419,
					"content": "俺は疲弊した嘘つきだが、あの子はまだキラキラと光を放つルーキーだ。だからこそ、その夢を壊しちゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130420,
					"content": "嘘つきってこともないだろ？だって、「スタンレー」の冒険や経歴は全て本物だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130421,
					"content": "冒険…経歴…ハッ、もういいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130422,
					"content": "実はな、今となっては冒険のことも、スタンレーの記憶も…もうはっきりとは覚えてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130423,
					"content": "これこそが俺の最大の秘密であり、最大の恐れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130424,
					"content": "ここ数年、俺は彼の話を伝えるために生きてきた。しかし彼の性格、彼の人生、それら全てをほとんど覚えてないんだよ。ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130426,
					"content": "彼の人生は罪悪感に呑み込まれてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "もう「空想の友達」しか残ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "俺が唯一忘れられないのは、彼が風のない燼寂海で死んだこと、そして風が彼の魂を連れ戻せないことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130428,
					"content": "うん、そうだね…本当のスタンレーは、彼の記憶の中にある生き生きとした友達とは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130429,
					"content": "傷だらけの戦士として、彼の人生の全てを束縛してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130430,
					"content": "俺は歳を取ったんだ…いくら拒んでも、手放してしまうことがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130431,
					"content": "俺は役立たずだ！本当に役立たず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130432,
					"content": "だが、冒険者はこんな形で死んではいけない…いけないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130433,
					"content": "ふ、不思議だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130434,
					"content": "ありがとう…ありがとう、バルバトス様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130435,
					"content": "すまない、気持ちの整理に、少し時間が必要そうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130436,
					"content": "でも、きっと俺は大丈夫だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "スタンレー"
				},
				{
					"id": 101130437,
					"content": "うん、めでたしめでたし！スタンレーは本当の自分を見つけて、ジャックも自立できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130438,
					"content": "おめでたいことがたくさんあったら、祝杯を挙げてお祝いしないとね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130439,
					"content": "このまま、この酒場で飲む気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130440,
					"content": "あははっ、ここのお酒は高すぎるからね。それにジャックがくれるって言った酒がまだでしょ。報酬に貴重な名酒をくれるって言ったのを覚えてるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130441,
					"content": "ボクは彼からお酒をもらってくるよ、あとで<color=#00E1FFFF>「いつもの場所」</color>で落ち合おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101130443,
					"content": "当てるしかない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "知ってるかも…たぶん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "うん、<color=#00E1FFFF>「いつもの場所」</color>で！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "え？いつもの場所ってどこだよ？おい！待てってば、吟遊野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101130446,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
