			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "スタンレー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 101130212,
					"content": "この数年、彼を束縛していたのは、その「友人」本人ですらなくなっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 101130213,
					"content": "しかしその友人の話は、きっとモンドで忘れられることはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
