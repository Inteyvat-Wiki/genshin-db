			"dialogs": [
				{
					"id": 718020301,
					"content": "用があればさっさと言え。妾は忙しいのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020302,
					"content": "挨拶しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020304,
					"content": "珍しいなぁ…願い事ではなく、挨拶だけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020305,
					"content": "まあよい、凡人の考えなど、妾は興味がないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020306,
					"content": "しかし時間を持て余しておるなら、妾の手伝いをしてくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020307,
					"content": "昔、妾が仕掛けの術を研究していた頃、空中に浮遊する「雲中仙居」を作ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020308,
					"content": "この「雲中仙居」は浮生の石を使い、仕掛けの術と組み合わせておる。その中で最も面白いのは…まあよい、言ってもお前達には分からぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020309,
					"content": "「雲中仙居」を作った後、設計図をそこに置いたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020310,
					"content": "縁のある者に譲ろうと通って、少し封印をかけたが、まさか今まで何ともなかったとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020311,
					"content": "設計図をそこに置いたままというのももったいないから、「雲中仙居」に行って設計図を持ってきてくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020312,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "ではさっさと行くがよい。手に入れたら洞府に持ってくるのだ。妾はここで待っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020314,
					"content": "その設計図でなにを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "もちろん使い道はある。お前に言っても分からぬからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "仙府を訪れる"
				},
				{
					"id": 718020316,
					"content": "早く行くがよい。手に入れたら洞府に持ってくるのだ。妾はここで待っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "仙府を訪れる"
				}
			]
		},
