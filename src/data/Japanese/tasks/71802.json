			"dialogs": [
				{
					"id": 718021001,
					"content": "仙人を訪ねるのは決して容易なことではない。汝らが訪ねてきたということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021002,
					"content": "ええっ！あ、あいつ璃月港に行ったんだよな？まさかこっそり帰ってきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021003,
					"content": "なんか…声が違う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "その…仙君、おまえの家に泥棒が入らないか心配だっただけで、別に邪魔するつもりはなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021005,
					"content": "…妾には一つやるべきことがある。もし適切に対処すれば、仙府に入ることができよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021006,
					"content": "周りにお構いなく独り言を喋り続けてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "え？つまり、今オイラと喋ってるのは留雲真君じゃなくて、あいつが残した仕掛けってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021009,
					"content": "昔、妾が仕掛けの術を研究していた頃、空中に浮遊する「雲中仙居」を作ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021010,
					"content": "「雲中仙居」完成後、貴重な仙縁のことを思い、設計図をそこに残しておいた。縁有るものであれば、自ずとそれを手に取るであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021011,
					"content": "設計図を持って来い、仙府に入ったらまた詳しく話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021012,
					"content": "仙人様？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "留雲真君？か、閑雲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021014,
					"content": "設計図を持って来い。それを済ませたら、仙府に入ってまた詳しく話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "仙府を訪れる",
					"speakerSubtitle": "…声が少し違うような？"
				},
				{
					"id": 718021015,
					"content": "全然こっちの言ってることを聞いてくれないぞ。一人で延々と喋りつづけてるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021016,
					"content": "これ、絶対仕掛けだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021018,
					"content": "でも、洞府を守るのって普通…バンバン敵を倒すような仕掛けじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021019,
						718021020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021019,
					"content": "彼女なりの考えがあるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "じゃあ、設計図を手に入れようぜ。それで、洞府に入って様子を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021022,
					"content": "ヘヘっ、オイラも気になってたんだ。あいつが洞府に一体どんな仕掛けを置いてるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021020,
					"content": "その設計図が少し気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "最後の言葉を繰り返し始めた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021007,
					"content": "この声、まさか何かの仕掛けなんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				}
