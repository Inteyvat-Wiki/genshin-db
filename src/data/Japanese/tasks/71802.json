			"dialogs": [
				{
					"id": 718021301,
					"content": "…なんだこれ？机の上に、箱が一つ置いてあるだけで、周りにはなんもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021302,
						718021303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021302,
					"content": "これが仙人の机。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "ここにたどり着いたということは、妾もその目的を分かっておるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021305,
					"content": "また喋った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021306,
					"content": "願いをつづり、匣中に入れよ。さすれば妾が結果を見定めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021307,
					"content": "…幾つもの困難を乗り越え、志は揺るがず。その強靭な意志は得難いものだ。これらの宝を持っていくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021308,
					"content": "やったー！へへっ、仙人ならオイラたちに無駄足を踏ませるわけないってわかってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021309,
					"content": "でも、「願いをつづり、匣中に入れよ。」っていうのは、願いを書いて、箱の中に入れろってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021310,
					"content": "無暗に仙人に願い事はしないでおこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "そっか…それもそうだな、オイラたちになにかあれば、直接留…閑雲に相談すればいいし、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021313,
					"content": "じゃあ、設計図を箱に入れて、ここを出ようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021314,
					"content": "でもこの辺り、ガランとしててなにもないな。たぶん真君が全部持って行ったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021315,
					"content": "ここの装置は何を想定して置かれたのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "オイラにもわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021317,
					"content": "とにかく次に真君に会ったとき、洞府について聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718021311,
					"content": "知り合いに願い事をするのは、ちょっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021303,
					"content": "それから仙人の箱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				}
