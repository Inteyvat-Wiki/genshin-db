					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390504
					]
				},
				{
					"id": 230390504,
					"content": "この速度じゃ、きっとハバチ兄ちゃんに追いつかれちまう。どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
