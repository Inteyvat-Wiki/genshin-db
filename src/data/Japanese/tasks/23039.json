				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#兄ちゃん}{F#姉ちゃん}！ちょっと待って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390102,
					"content": "その…おまえって、冒険者か？あちこちに冒険に出かけて、戦いが得意なあの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390103,
					"content": "まあそうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#ほら！言った通りだろ、ヒルミ。この{M#兄ちゃん}{F#姉ちゃん}は冒険者に違いないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390106,
					"content": "でも冒険者って、みんなあの緑の服を着てるんじゃないの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390107,
					"content": "#{M#俺}{F#私}は強いから、そんなの着なくていい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "へえー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390110,
					"content": "へえー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390111,
					"content": "#じゃあ{M#兄ちゃん}{F#姉ちゃん}は、きっとおれたちを助けてくれるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390112,
					"content": "村のあの大きな倉庫が見えるか？ハバチ兄ちゃんの話では、中に大事なものが入っているから、しっかり守らないといけないんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390113,
					"content": "それから、もし悪者が村に攻めてきたら、まずリフトを止めに行って、それから吊り橋を切断しに行くらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390114,
					"content": "でもあの倉庫からリフトまではかなり距離があるんだ。ハバチ兄ちゃんがリフトを止めようと思ったら、必死で走らなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390115,
					"content": "おれたち、練習に付き合うって提案したんだけど、ハバチ兄ちゃんは相手にしてくれなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390116,
					"content": "ボクたちが水切り遊びしてるときこそ、無視してくれたらいいのに…ちぇっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390117,
					"content": "コホン、まあとにかく！もし悪者が村に攻めてきて、ハバチ兄ちゃんが走れないってなったら、おれたちがリフトを止めに行くしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390118,
					"content": "#{M#兄ちゃん}{F#姉ちゃん}冒険者なんだったら、きっと走るのは得意だろ。おれたちの訓練に付き合ってよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390119,
					"content": "じゃあ、一緒に走ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#やったあ！{M#兄ちゃん}{F#姉ちゃん}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390126,
					"content": "#スタート地点は選んであるんだ。行こう、{M#兄ちゃん}{F#姉ちゃん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390127,
					"content": "へへ、今度はボクが相手だよ。先に言っとくけど、ボクはかけっこは得意なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヒルミ"
				},
				{
					"id": 230390121,
					"content": "ハバチを信じてあげたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "えー！おれたちの遊び…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390123,
					"content": "#じゃなくて、訓練に付き合ってよ。{M#兄ちゃん}{F#姉ちゃん}、お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390124,
					"content": "まあいいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#やったあ！{M#兄ちゃん}{F#姉ちゃん}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "エベード"
				},
				{
					"id": 230390108,
					"content": "#{M#俺}{F#私}は特別だから、そんなの着なくていい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "まあ、そう言ってもいいかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
