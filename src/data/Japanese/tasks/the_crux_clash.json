	"talks": [
		{
			"id": 200103,
			"completionStepIds": [
				200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200103",
							"2"
						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"楓原万葉",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "はははっ、さすがはアタシが見込んだ強者だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010302,
					"content": "#あんたも見ただろ、万葉！まったく無駄な動きをせず、迷いなく勝負をつけた{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}の姿を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010303,
					"content": "そうであるな。しかし、相手を傷つけぬよう、少し手加減をしていたようにも見えたでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010304,
					"content": "今まで色んな戦いを経験してきたアタシだが、この一試合を見ただけでこいつの強さがはっきりと分かったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010305,
					"content": "だから、褒め言葉をケチる必要なんてないんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010306,
					"content": "うむ、褒めるとするなら、そうであるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010307,
					"content": "「悪くない勝負であった」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010308,
					"content": "はぁ、まぁいい。あんたに詩を読んでもらって場の雰囲気を盛り上げようと思ったが、無理強いだったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010309,
					"content": "実はさっき、参加者が大勢アタシのところに来てな、璃月の大英雄が武闘会に参加するなんて思わなかったって驚いてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010310,
					"content": "それから、参加を申し込む人が一気に増えた。中には武道を極めたヤツもいる。みんなあんたと勝負したいと思ってるみたいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010311,
					"content": "自分にそんな宣伝効果があったとは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "ははっ、だからあんたには優勝候補に相応しい待遇を与えると決めた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010314,
					"content": "一般選手との勝負で体力を消費してほしくないし、それにあんたももっと熱い対決を期待してるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010315,
					"content": "だから、あんたには直接準決勝に進出してもらうことにした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010316,
					"content": "ええっ？さっきのはまだ予選だろ。直接準決勝だなんて、適当すぎじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010317,
					"content": "これが姉君の性格でござる。止められんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010318,
					"content": "それに実際の実力でも、この大英雄は準決勝まで進むと拙者は思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010319,
					"content": "それはそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010320,
					"content": "じゃあまずは、他の試合を観戦しよう。誰があんたへの挑戦権を手にするか見てみようじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010321,
					"content": "ついに、ついに来たぞ！本日の大目玉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010322,
					"content": "ははっ、どうやら姉君はこの勝負に大いに期待しているようだ。これほどまでに興奮した姿は久しぶりに見たでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010323,
					"content": "お主の対戦相手は数々の試練を突破し、準決勝まで進んだ百戦錬磨の強者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010324,
					"content": "実力ではお主に及ばぬかもしれぬが、油断は禁物でこざる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010325,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "では、お主があの嵐を突破する準備ができているかどうか、しかと拝見させてもらうでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010328,
					"content": "おしゃべりはその辺にしときな、観客も待ちきれないみたいだぜ。申し込みをした時の船員のところに行ってこい、彼女が会場まで案内してくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010326,
					"content": "参加した目的を忘れてはいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "別に気にしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
