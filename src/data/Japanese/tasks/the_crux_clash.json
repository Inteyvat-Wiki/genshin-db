							"200106",
							"2"
						],
						"stepId": 200106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戎世",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "汗がたくさん出た、悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010602,
					"content": "認めよう、お前の方が強い。まだまだ鍛錬が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010603,
					"content": "そっちこそ凄いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "そうだな、さっきは危なかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010606,
					"content": "もしおまえが神の目を持ってたら、きっともっと凄かっただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010607,
					"content": "小さい頃、神の目が欲しかった。それを手にすれば、強くなれると聞いてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010608,
					"content": "だが、手に入らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010609,
					"content": "それからは、興味もなくなった。神の目よりも筋肉の方が使える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010610,
					"content": "神の目を持つ者にも勝ったことがある。あの力は神が与えたもの、羨ましくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010611,
					"content": "えっ？あの主なき神の目のために来たんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010612,
					"content": "いや、ただ勝負がしたかっただけだ。誰が強いか、試しにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010613,
					"content": "敗北のみが、力の差を悟らせ、成長させる。だから嬉しいのだ、稀に味わえる敗北が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010614,
					"content": "これこそ、本当に実力のある人が言うことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010615,
					"content": "機会があれば、また勝負しよう。俺ももっと強くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010616,
					"content": "こっちもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "そうだ、決勝に進んだ人を知ってるか？おまえより強いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010618,
					"content": "俺より強いかどうかは分からない。ただ、とてつもなく「速い」と聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010619,
					"content": "油断はするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戎世"
				},
				{
					"id": 20010604,
					"content": "優勝する実力がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
