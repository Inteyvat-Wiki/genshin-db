			"dialogs": [
				{
					"id": 20012301,
					"content": "神の目を使わずして元素力を…ということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20012302
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20012302,
					"content": "気にするな、独り言でござる。お主の挑戦はきちんと横で見ておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
