			"trigger": {
				"objectNames": [
					"楓原万葉",
					"北斗",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010901,
					"content": "実にお見事、天晴であった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010902,
					"content": "相手の動きに慣れるのに少々手こずり、苦戦を強いられていたでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010903,
					"content": "しかし迅速に態勢を立て直し、勝利を勝ち取った。これこそが最も称賛に値するでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010904,
					"content": "よく見てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "実は、耳で聞いたのでござるよ、砂と呼吸の音を。しかし、この程度は造作もないこと、姉君にも分かっていたでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010907,
					"content": "はははっ、たしかにな。ただアタシは経験に頼ってるだけだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010908,
					"content": "あんたにとって、この武闘会は新鮮で良い体験になってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010909,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "ちょっと聞きたいんだけど、決勝の相手ってどんなやつなんだ？準決勝の人より強いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010912,
					"content": "そうでもない。ただ決勝に進出したヤツは「強い」というよりも、突出した能力を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010913,
					"content": "彼は「速い」。身のこなしに長けている。それに一目で分かるほど豊富な実戦経験を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010914,
					"content": "どうした？決勝戦で不意を突かれないかが心配か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010915,
					"content": "慎重に越したことはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "であれば、拙者から一つ助言を授けよう。共に静かな場所に来てくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010918,
					"content": "まだ話してなかったと思うが、実は稲妻にいた頃、拙者は浪人であった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010919,
					"content": "おう、それは服装を見て分かってたけど…話してる感じは、刀を使うような人には見えないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010920,
					"content": "学問を得れば本を知り、武道を得れば刀を知る。長い道のりの中で、芸を一つ増やすのは悪いことではないであろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010921,
					"content": "武芸に優れているとは決して言えぬが、大陸中の様々な達人を見てきたでござる。お主の相手が得意とする技術についても、少々心得ている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010922,
					"content": "お主の才覚であれば、拙者からの少しの助言でその技を打破するすべを思いつくであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010923,
					"content": "おいおい、それはちょっと反則じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20010924,
					"content": "情報収集も決闘の一部、問題はないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010925,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}らはモンドから数々の修羅場を経験してきた。それらをくぐり抜けられたのは、気力によるだけのものでもあるまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010926,
					"content": "そうだそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010927,
					"content": "って、えっ？オイラたち、モンドにいたこと言ってなかったよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20010928,
					"content": "ははっ、その場所へ行けば、自然の中に足跡を残す。そして自然はお主らに特別な匂いをもたらすのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010929,
					"content": "しかし、その匂いはあくまでも拙者に助言を与えるのみ、本質に触れることはできぬ。拙者もまだまだ気になることがたくさんあるのでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010930,
					"content": "拙者と共に行かぬか、試合後の余興として。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20010916,
					"content": "稲妻に行くのはとても重要なこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "やっと終わる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "すごい洞察力だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
		},
		{
			"id": 200111,
