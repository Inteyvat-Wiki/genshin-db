					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "辺りに人影はない、単刀直入に聞くでござるよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011102,
					"content": "お主は元素力を巧みに扱える、それも一種類のみにあらず、そうであるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011103,
					"content": "やっぱりそのことか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "なんか最初に会ったときから、会話の中に意味深な感じを含ませてたよな。とっくに気づいてたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011106,
					"content": "ああ、会場で聞かなかったのは、お主が元素力を扱えることを他の参加者が聞き、いらぬ誤解を招かぬようにするためであった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011107,
					"content": "勝負で不利な場面に陥ろうと元素力を使わなかったのは、拙者と同じようにそう考えていたからであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011108,
					"content": "どうして分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "ははっ、拙者が言っていた「見た」や「聞いた」は詩的な表現をしていたわけではなく、事実なのでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011110,
					"content": "拙者は幼少の頃より大自然から得られる情報を理解することができた。風の息する音や、木の葉のささやきを聞けたのでござる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011111,
					"content": "お主からは似たものが聞こえた、それだけでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011112,
					"content": "信じられない話だけど、うそをついてるようには見えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011113,
					"content": "お主らと比べれば、拙者のこれは取るに足らぬもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011114,
					"content": "神の目に頼らず、複数の元素力を扱える人間など…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011115,
					"content": "それにどこから来たのかも分からぬ、至極複雑な匂いのした神秘的な生物も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011116,
					"content": "「匂い」でオイラを判断するんじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011117,
					"content": "その複数の元素力を如何にして手に入れたのか、拙者に聞かせてはくれぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011118,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}にも分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "ふむ…理解しがたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011121,
					"content": "では、お主は如何にして元素力を応用し、実戦で使用しているのでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011122,
					"content": "全部パイモンの知識のおかげ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "へへっ、それほどでもないぜ。オイラはただ自分が思ったことをこいつに教えてやってるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011125,
					"content": "長い旅を経て、様々な経験をした。それらを振り返り、色んなことに気づく。こいつは、そうやって自然と元素の使い方を会得したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011126,
					"content": "正直、オイラも原理まではわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20011127,
					"content": "もしかすればその不可解こそ、神と神の目の本質であるのかもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011128,
					"content": "だが、やはり拙者はこの目で見てみたいでござる。お主が如何にして元素力を使うのか、それを実際に見れば拙者も何か気づけるかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011129,
					"content": "拙者が持っている情報も共有しよう、さすれば平等な情報交換となるであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011130,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "では、そこの舞台を利用して行うでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20011131,
					"content": "やっと普通に戦える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "全部パイモンがいるおかげ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "ただ七天神像に触れただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "どうりで会場では言えなかったわけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
