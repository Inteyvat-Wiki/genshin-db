					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20012202
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20012202,
					"content": "何か聞きたいことがあるなら、この機会に聞いてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		},
		{
