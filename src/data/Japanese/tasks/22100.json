			"dialogs": [
				{
					"id": 221000201,
					"content": "どうです？周辺の怪物は倒しましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "急がなくて大丈夫です。あの怪物たちはこの周りをうろうろしているだけで、ここには近づいてきませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000204,
					"content": "しかし、怪物が例のお客様の邪魔をしてしまったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000205,
					"content": "この旅館が数日営業できないどころか、荻花洲がどうにかなってしまうかも知れません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
