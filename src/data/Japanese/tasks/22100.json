					"speakerTitle": "淮安"
				},
				{
					"id": 221000302,
					"content": "全部倒した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "よかった、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000304,
					"content": "約束の報酬、どうか受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000305,
					"content": "これでしばらくは平和な日々を送れますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000306,
					"content": "例のお客様は誰かって？…それはオーナーに聞いてください。",
					"roleType": "TALK_ROLE_NPC",
