			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "はあ、どうしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "はあ、ここで旅館を開くのは大変ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000104,
					"content": "この荻花洲には荻花が多い、宝物が多い、怪物はもっと多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000105,
					"content": "幸い、千岩軍のおかげで、この辺の怪物のほとんどが倒されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000106,
					"content": "でもどうしてか、最近怪物たちがまた出てくるようになったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000107,
					"content": "旅館の近くには絶対に来ませんが、こうして毎日見てると、お客様はもちろんのこと、私でさえ目障りだって思ってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000108,
					"content": "もしお時間がありましたら、旅館の周囲にいる怪物を片付けてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "アハハ、さすがですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000114,
					"content": "お客様にお願いするなんて申し訳ないのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000115,
					"content": "解決しましたら、ちゃんと報酬をお支払いしますので、ご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000116,
					"content": "では、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000110,
					"content": "目障りだけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "おっしゃる通りなのですが、目障りなところが一番迷惑なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000113,
					"content": "特にあの綺麗好きなお客様、彼を怒らせたら、この荻花洲一体は大変なことになりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				}
			]
		},
