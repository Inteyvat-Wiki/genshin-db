				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "危なかったわね…ウェネトまで引き付けちゃうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735140102,
					"content": "ったく！さっき点火モジュールを外してなかったら、そのままやっつけられたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140103,
					"content": "今、逃してしまったということは、やつの警戒心が融けるまで、少なくとも丸一日待たなくちゃならないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140104,
					"content": "まさか、明日になっても、こんな些細な問題で二の足を踏んで、またやつを逃してしまう気じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140105,
					"content": "うっ…でも、パラメータが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735140106,
					"content": "もう計った。チャージ速度は設計値より低くなるけど、使用する分には問題ないはずだ。それに安全面の懸念だってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140107,
					"content": "シュリヤ…分かってるさ。すべてをちゃんと分析してから始めたいんだろ。でも君も知ってるはずだ。実際の状況がいつも計算通りにいくわけじゃないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140108,
					"content": "万全を期すことに拘り過ぎて逆にチャンスを逃してしまったら、以前の中期発表のときみたいに、延期という悲惨な結末を招くことになる…そうすれば、結局さらなる問題を生み出してしまうだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140109,
					"content": "はぁ…わかったわよ…ほら、持っていきなさい。点火モジュールよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735140110,
					"content": "——よーし！明日こそ「対ウェネト殺蟲大砲」の見せ場だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140111,
					"content": "アアル村まで持って帰って、再調整してみるよ。「対ウェネト殺蟲大砲」の初陣なんだ…ちゃんと準備しとかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735140112,
					"content": "…でも環境パラメータのほうは、どうして誤差が生じたんでしょう？そもそも、ウェネトはどうして突然暴れ出したのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735140113,
					"content": "やっぱりこの問題をほったらかしておくわけにはいかない…冒険者さん、申し訳ないんだけど、明日もまた来てくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735140114,
					"content": "明日はウェネトに直面することになるし、多少なりとも研究成果があればいいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				}
			]
		}
	]
}