				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "へぇ？面白そうだな。見せてくれ…ふーん、アイデアは六点、実現性は四点ってとこか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 708090502,
					"content": "こ、これって…「犯罪計画書」じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090503,
					"content": "ハハッ、俺がわざわざ駐屯地から出てきたのは、どっかの誰かがここで奇妙な「犯罪計画」を練ってるって聞いたからなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 708090504,
					"content": "…ま、このメモを見たら、あの噂がどうやって広まったのか…大体見当がついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 708090505,
					"content": "この「犯罪計画書」は騎士団に任せとけ。あとで暇があれば、俺の駐屯地に遊びに来いよ。面白いもんが見れるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローエン"
				}
			]
		}
	]
