				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "こ、これは…僕の「犯行の手口」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}！あいつ、あっさり認めたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090403,
					"content": "ああっ！誤解しないでくれ。これは次の小説で使おうと思ってたトリックでね。先日、酒を飲みながら思いついたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090404,
					"content": "まさか、酔いがさめるとメモごと消えることになるとは…自分が夢でも見ていたのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "内田幸太郎"
				},
				{
					"id": 708090405,
					"content": "とにかく、見つけてくれてありがとう。これで小説も無事に完成しそうだ。出来上がったら真っ先に一冊送ってあげるよ！サイン入りでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "内田幸太郎"
				}
			]
		},
		{
			"id": 7080905,
