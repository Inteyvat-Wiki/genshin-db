			"dialogs": [
				{
					"id": 708090301,
					"content": "（鳥の巣の中にはバラバラになった紙切れがたくさんあり、ところどころに字の跡も見られる…）",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "このメモ…もしかして、巣を作るために破かれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090303,
					"content": "なにか書いてあるみたいだぞ。つなぎ合わせて、読んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090304,
					"content": "やっぱり自力でつなげなきゃいけないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "おまえはこれが気にならないのか！？宝の地図かもしれないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090306,
					"content": "パイモンに促され、メモをつなぎ合わせた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "よーし、どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090308,
					"content": "こ、これってまさか…「犯罪計画書」じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090309,
					"content": "そんなものを鳥に取られるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "で、でも小説にはよくある展開だろ？万全な計画に限って、ありえないところでミスをしちゃうって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090313,
					"content": "近くの酒場で聞き込みしてみようぜ？「最近、誰かが犯罪しようとしてる！」みたいな噂があるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708090311,
					"content": "ありえないとは言い切れない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "お、おう。万が一ってこともあるし…もしホントに犯罪を企んでるやつがいたら、後で後悔しても遅いもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7080904,
