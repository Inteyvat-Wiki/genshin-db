			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エデ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "どうやら…カリベルトではないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110102,
					"content": "あの子じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "ああ、カリベルトの腕にあるスカーフは、かつて私があの子の母親に贈った物なんだ。今では、目印として私がそれを使っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110105,
					"content": "私の目もいよいよなのかもしれないな。自分の息子さえも見分けがつかなくなりつつあるとは、この体はもう…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110106,
					"content": "でも、あのヒルチャール…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "確かに…私たちにまるで興味がなく、頑なにあっちのほうへ向かっていた…この先に何かあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110109,
					"content": "分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "ああ、ヒルチャールに関する情報なら…多ければ多いほどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110110,
					"content": "ついて行ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "少し変わってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "あの子と違って腕にスカーフがなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
							"2"
						],
						"stepId": 801104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エデ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "なんと不気味なところだ。こんな場所…前からあっただろうか？今までずっとここに気付かなかったとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110202,
					"content": "あれ、見て…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "ん？ヒルチャールたちが…ひれ伏して何かを崇めているようだな？歩いて、跪き…なんとも敬虔そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110205,
					"content": "こんな光景、見たことない。一体この場所に何が隠されているというんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110206,
					"content": "それを知るには、ここを探ってみるしかなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110207,
					"content": "（ここの雰囲気、それにこの不気味な光景、まさか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "ヒルチャールたちが何かしてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
		{
			"id": 801103,
