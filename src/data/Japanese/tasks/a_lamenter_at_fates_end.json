			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "止まれ、人間よ。汝等はこの地で「運命」の探求を許可されておらぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "運命の使徒"
				},
				{
					"id": 80110302,
					"content": "（アビスの使徒？違う、アビス教団でこんなやつ見たことない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "ほう、汝等はそれでも「謁見」を執拗に望むか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "運命の使徒"
				},
				{
					"id": 80110304,
					"content": "…いいだろう、ならば汝等に「運命の試練」を授けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "運命の使徒"
				}
			]
		},
		{
