			"dialogs": [
				{
					"id": 80110401,
					"content": "先ほどのは一体何者だ？なんと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110402,
					"content": "びっくりした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "…なんと完璧な生命体だ。称賛に値する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110405,
					"content": "え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "あの身に漂う計り知れないオーラ、危険に満ちながらも優雅であり力を感じる姿、この上なく魅力的な存在であった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110407,
					"content": "よくあのような存在を負かすことができたものだ。君の実力は少しばかり私の想像を超えているのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110408,
					"content": "独特なセンスを持ってるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "先に進むとしよう。ますます好奇心が掻き立てられ、興奮が抑えられなくなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデ"
				},
				{
					"id": 80110409,
					"content": "ただ経験が豊富なだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "前に似たようなのに会ったことある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
