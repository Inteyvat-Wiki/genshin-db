					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "助けがいるか聞いてたの。どうやら手伝ってほしいみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700200112,
					"content": "私たちに強い敵を倒してほしいみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
