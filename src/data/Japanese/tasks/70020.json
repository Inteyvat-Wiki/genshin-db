					"nextDialogs": [
						700200114
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700200115,
					"content": "うん、そいつの居場所はもう記したから、あとは任せたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
