						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "まったく…妙な話じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200702,
					"content": "今の、見たか？さっきこの木が、ぱあっと光りおったんじゃ。それに、この小さいのも…残念ながら魚ではなかったがのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200703,
					"content": "ってことは、真ん中のやつってこの木の根っこなのか？仕組みはよくわかんないけど、キラキラしてて、さっきのくすんだ感じよりずっとキレイだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760200704,
					"content": "これまでの経緯を語った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "信じがたいが…わしを騙すためにわざわざ嘘をつく理由もなかろう。どうやら、半分霜月の子の釣り友が言っておったことは本当だったようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200706,
					"content": "じゃが、それがどうした。所詮は過去の残影に過ぎん。やつらがどんな歌を歌おうと、何を語ろうと、わしら生きる者が生きた魚を釣るのに、関係などありはせん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200707,
					"content": "さて、話は戻るが…あんたらも宝探しをしておるんじゃろ？さっき、これを釣り上げたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200708,
					"content": "これ…<color=#00E1FFFF>「識者の証」</color>か？ただの鳥の羽に見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760200709,
					"content": "馴染みの行商人の話じゃと、<color=#00E1FFFF>「識者の証」</color>を五つ集めれば、月の東、太陽の西に埋められた「偉大なる財宝」が見つかるそうじゃ。本当かどうかは知らんがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200710,
					"content": "実際、多くのトレジャーハンターがそれを信じ込み、我先にと飛びついていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200711,
					"content": "た、宝物だもんな！オイラも興味あるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760200712,
					"content": "もしあと二十ほど若かければ、わしもあるいは…いや、若返ったとしても、やっぱり釣りが一番じゃわい。とはいえ、今日も手ぶらで帰る羽目になりそうじゃがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				}
			]
		}
	]
}