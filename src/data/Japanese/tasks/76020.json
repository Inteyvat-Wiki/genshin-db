			"trigger": {
				"objectNames": [
					"イルマリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "今日も収穫ナシか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "釣りじゃ。今のとこ、魚じゃない変なものばかり釣れとるがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200104,
					"content": "もし沈没船の小物なんかが釣れれば、行商人が買い取ってくれるんじゃがな。前に釣り上げた靴なんか…おっと、あんまり話すと魚が逃げちまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200105,
					"content": "この辺りで何か気になったことはない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "さては、宝探しじゃな？月の東、太陽の西にしかない「偉大なる財宝」なんてものは…聞いただけで、ここにはないとわかるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200107,
					"content": "ああ、そう言えば、ここは昔から船の海難事故が多い場所なんじゃ。沈没船の中には確かに価値のあるものもあるかもしれんがな、見つけ出すのはそう簡単じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200108,
					"content": "これは酒場で生き残った船乗りから聞いた話なんじゃが…その夜は月もないのに、荒れ狂う大波の中に光る物が見えたんじゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200109,
					"content": "間違いなく隻眼のケラティに違いないと言っておったのう。月さえも飲み込む怪物が、海の巨蛇と縄張り争いをしておったのじゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200110,
					"content": "その後は長いこと、このあたり一帯が、まるでインク壺をひっくり返したみたいに真っ黒じゃったわい。どの船も怖がって、通らんようになってのう…みんな、水底の亡霊に引きずり込まれるんじゃないかと震え上がっとったもんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200111,
					"content": "今でもその亡霊たちがこの辺りを彷徨ってるという噂があるが、まあ、子供を怖がらせるにはちょうどいい話じゃろう？そんな根も葉もない戯言は信じとらんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200112,
					"content": "この木について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "この木はちょっと不気味でのう。元々ここいらには渦が出るもんでな、船乗りたちはケラティの眼と呼んでおったんじゃが、ある日突然、この木が生えてきおったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200114,
					"content": "あの頃起きたおかしなことと言えば、それだけじゃなかったのう。考えてみれば、石っころが空から降ってきた後のことじゃ…もしかしたら、この木も石っころと同じように天外から来たのやもしれんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200115,
					"content": "たびたび見かけるキラキラした小物も、珍しいものばかりじゃ。ひょっとして、新種の魚でもおるのかもしれんと思って、運試しに来とるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200116,
					"content": "もともとは、わしの釣り仲間も一緒に来とったんじゃが…妙な歌声が聞こえると言い出しおってな、怖じ気づいて来なくなってしもうた。半分霜月の子なんじゃが、悪癖はまるっきり、そのものじゃわい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760200117,
					"content": "邪魔したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "構わん構わん。どうせ魚の影も見えんからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				}
			]
		},
