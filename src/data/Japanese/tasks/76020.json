						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "わあっ…ここ、前にも見たことあるキラキラしたやつがいっぱいあるぞ！そういえば、オイラたちって今どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760200302,
					"content": "まさか…あの変な木の真下まで来ちゃったのか？真ん中の緑っぽい物がなんなのかもわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
