					}
				]
			},
			"dialogs": [
				{
					"id": 746750101,
					"content": "素晴らしい日ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750102
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750102,
					"content": "あなた方くらい有名になると、名刺を差し出す人が絶えないのではないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750103
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750103,
					"content": "#ん？…オイラたちを知ってるのか？随分ませた子供だなあ。{NICKNAME}、そう思わないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746750104,
					"content": "相手が年若いからといって見下すのは、無知な者だけが犯す過ちです。お二人はそこまで浅はかではないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750105
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750105,
					"content": "自慢するわけではありませんが、僕と兄は当地では少し名の知れた映影監督なのです。みんなからはプチ·ルミエール先生と呼ばれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750106,
						746750107
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750106,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				},
				{
					"id": 746750108,
					"content": "はい、お二人の冒険や経験にはとても興味がありますから。僕たちの業界では、いつも非凡なストーリーが求められているんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750109
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750109,
					"content": "お二人は僕をご存知ないでしょうから、まず自己紹介しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750110
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750110,
					"content": "僕と兄はずっと一緒に映影を撮っています。けっこう有名な作品もいくつかあるんですよ。『工場の入り口』をご覧になったことは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750111
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750111,
					"content": "ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750112
					]
				},
				{
					"id": 746750112,
					"content": "ああ、構いませんよ。では『ポートへの船舶の到着』は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750113
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750113,
					"content": "それもないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746750114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750115
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750115,
					"content": "はぁ…そうですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750116
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750116,
					"content": "…無理もありませんね。僕たち兄弟のシネアストとしての道のりはまだまだ長いのですから。誰でも知っているほどの映影をこの先もっと沢山撮りますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750117
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750117,
					"content": "映影の制作は、物語の構想に始まり、俳優が演技し、カメラマンと監督が協力して撮影し…完成品に編集します。どれも面白い工程ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750118
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750118,
					"content": "中でも一番技術が求められるのが撮影の過程でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750119
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750119,
					"content": "どこに重きをおき、取捨選択するかによって、観客がどんな情報を得て、どんな雰囲気を感じ取れるかが決まります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750120
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750120,
					"content": "セリフも大切ですが、セリフだけで物語を成り立たせることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750121
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750121,
					"content": "——四カットです！僕はずっと、四つのカットがあればストーリーの最小単位を構成できると信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750122
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750122,
					"content": "この四つのカットから、天才は奇跡を創り出せるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750123
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750123,
					"content": "お二人も試してみますか？この機会に、映影の魅力を味わってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750124
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750124,
					"content": "それで、なにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746750125,
					"content": "簡単ですよ。僕が撮影テーマとして、すでに形になっている短いプロットを提供します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750126
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750126,
					"content": "カットやセリフを色々と試して、短編映影の撮影を完成させることが大事です。お二人とも、興味はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750127
					],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750127,
					"content": "面白そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750128
					]
				},
				{
					"id": 746750128,
					"content": "よかった！ではいつでもいいので、準備ができたら僕が選んだ撮影場所に行って撮影してきてください。僕も出来上がった作品にフィードバックしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プチ·ルミエール"
				},
				{
					"id": 746750107,
					"content": "#{M#君}{F#あなた}も名刺をくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				}
			]
		}
	]
}