			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660901,
					"content": "来たか。どうだった？これであのファデュイの小娘も安心しただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660902
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660902,
					"content": "リュドヒカが残した手紙とお金を百代に渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722660903
					]
				},
				{
					"id": 722660903,
					"content": "は？あいつ、これを残して行ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660904
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660904,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660905,
					"content": "チッ、全く。何が「百代さんが目を失ったのは全部私のせいです」だ。別にあいつがやったわけではあるまいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660906
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660906,
					"content": "強いて言えば、これは任務のための負傷…労災ってやつだな。埋め合わせなら、終末番がするべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660907
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660907,
					"content": "とにかく、あいつの金なんか要らない。お前らが好きに使え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660908
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660908,
					"content": "そう言われても、オイラたちがもらうわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660909,
					"content": "パイモンがお金を拒むなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660910
					]
				},
				{
					"id": 722660910,
					"content": "おい、オイラを守銭奴みたいに言うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660911,
					"content": "それに、稲妻を離れてリュドヒカさんはどこに行くつもりなんだ？ちゃんと新しい生活と幸せを手に入れられるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660912,
					"content": "そうだ、私はもう神社に戻ることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660913
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660913,
					"content": "宮司様は、この前の偽物がいいそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660914
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660914,
					"content": "彼女を行方不明にしたのはお前らだ。それが宮司様に知れたらどうなるか、覚悟するんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660915
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660915,
					"content": "えっ、なぜかオイラたちの責任になってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660916,
					"content": "そうじゃないとでも言うのか？お前らが止めなかったせいで、彼女は稲妻から去ったんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660917
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660917,
					"content": "あ、分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660918,
					"content": "ありがとな、百代さん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660919
					]
				},
				{
					"id": 722660919,
					"content": "彼女はおそらく、離島を通って外に出るはずだ。そこで彼女を探せ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660920
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660920,
					"content": "連れて帰って来たら、今後も「玄冬林檎」の名前を使わせろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660921
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660921,
					"content": "私が適当につけた偽名だが、彼女の身分には案外よく似合ってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660922
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660922,
					"content": "早く行け、彼女のことは任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660923
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660923,
					"content": "#{NICKNAME}、早く離島の港へ行って、リュドヒカさんを連れて帰ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7226610,
