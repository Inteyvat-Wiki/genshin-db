						],
						"stepId": 7226606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百代",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660601,
					"content": "くっ…牢屋のカビ臭さには参ったぜ。ようやくちゃんと息ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660602
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660602,
					"content": "百代さん、その目はどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660603,
					"content": "安心しろ、こっちの目はもう治ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660604
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660604,
					"content": "でも、もう片方は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660605
					]
				},
				{
					"id": 722660605,
					"content": "何だその冴えない表情は！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660606
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660606,
					"content": "もっと喜べ！目玉一つ犠牲にしただけで、あいつら全員を騙せたんだ。ついでにファデュイのアジトも暴けた。大成功じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660607
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660607,
					"content": "ははっ、「先生」は私の術中にすっかりはまっていた。お前らが救おうとしているあのファデュイの女も、もう恐れて生きる必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660608
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660608,
					"content": "百代さん、もしかしてリュドヒカが死んだと思わせるために、わざと隠れ家から逃げなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660609,
					"content": "約束したことだからな。しかも最後に尻尾を出してしまえば、これまでの努力が水の泡になってしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660610
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660610,
					"content": "それに、助けに来てくれると、信じていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660611
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660611,
					"content": "捕まえられたのは突然のことだった。すぐに海祇島での任務があるから、書面報告はもう間に合わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660612
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660612,
					"content": "今から鳴神大社に行って、終末番の誰かにこのことを伝えてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660613
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660613,
					"content": "お前たちもリュドヒカにもう安全だと伝えてやれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660614
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722660614,
					"content": "分かった、すぐ行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
