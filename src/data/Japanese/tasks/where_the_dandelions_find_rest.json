			"dialogs": [
				{
					"id": 722660801,
					"content": "何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660802
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660802,
					"content": "なあ、オイラたち人探ししてるんだけど、最近ここで校正をしていた女の人がどこに行ったか知らないか？友達なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660803,
					"content": "#あら、君たちが{NICKNAME}とパイモンね。来ることは遠山さんから聞いてたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660804
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660804,
					"content": "（遠山さん？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660805,
					"content": "（たぶんリュドヒカさんの偽名。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660806
					]
				},
				{
					"id": 722660806,
					"content": "彼女が昨日、家の事情で校正の仕事を続けることができなくなったって言ってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660807
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660807,
					"content": "本当に残念！彼女みたいな器用で真面目な人は滅多にいないから。非常勤じゃなくて、専任で働いてもらいたいと思ってた所だったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660808
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660808,
					"content": "そうだ、これは彼女が君に渡したいと言っていたものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660809
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 722660809,
					"content": "オイラたちに手紙を残してくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660810,
					"content": "リュドヒカさん…行っちゃったんだな。そして、オイラたちと百代さんのために、お金を残してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660811,
					"content": "本当にこれでいいのか…？百代さんに聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7226609,
			"completionStepIds": [
				7226609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226608",
							"3"
						],
						"stepId": 7226608,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226609",
