			},
			"dialogs": [
				{
					"id": 722661801,
					"content": "ご親切に、心から感謝いたします。でも…私はもう決めたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661802
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661802,
					"content": "誤解だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661803
					]
				},
				{
					"id": 722661803,
					"content": "そうだぞ。実はオイラたち、説得しに来たわけじゃないんだ。稲妻を離れるんだから、なにかプレゼントがしたくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661804,
					"content": "えっ、何かくれるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				}
			]
		},
		{
