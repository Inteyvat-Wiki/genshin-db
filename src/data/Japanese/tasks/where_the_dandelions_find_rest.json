			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722660301,
					"content": "百代さん！百代さん！どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660302,
					"content": "ここはもうファデュイにめちゃくちゃにされたな。百代さんのもの…それに材料とかも無くなってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660303,
					"content": "この場所はもうバレてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660304
					]
				},
				{
					"id": 722660304,
					"content": "じゃあ百代さんはどうなるんだ？まさかファデュイに捕まったりしないよな！？…ハ、ハクション！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660305,
					"content": "そういえば、隠れ家に入ってきてから、鼻の調子がおかしいんだ…ハクション！ここの空気、なんだか変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660306,
					"content": "地面に粉末の跡が見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660307
					]
				},
				{
					"id": 722660307,
					"content": "#粉末？この前使った元素の粉か？{NICKNAME}、早く元素視角で確認してみろよ。きっと、百代さんが危険を冒しながらもオイラたちに残したメッセージだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7226606,
			"completionStepIds": [
				7226606
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226616",
							"3"
						],
						"stepId": 7226616,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
