			},
			"dialogs": [
				{
					"id": 722662001,
					"content": "何だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662002,
						722662004,
						722662007,
						722662014
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662002,
					"content": "目が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662003
					]
				},
				{
					"id": 722662003,
					"content": "大丈夫だ、行動するには支障ない。今後はこの姿で海賊団に潜入できたりするかもな。ははっ、面白そうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662004,
					"content": "今後の予定について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662005
					]
				},
				{
					"id": 722662005,
					"content": "まずは海祇島に毒を仕込もうとしているファデュイたちを一掃する。しかし、やつらの先生はもう稲妻を去った後のようだ。フン、もし戻ってきたら、二度とここを出られないようにしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662006
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662006,
					"content": "既に終末番に情報が伝わるよう手配しているから、心配はいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662007,
					"content": "その助っ人は誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662008
					]
				},
				{
					"id": 722662008,
					"content": "早柚って名前のチビだ。お前たちとは知り合いのようだな。彼女が今頃、終末番に情報を届けてくれてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662009
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662009,
					"content": "本当に大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662010
					]
				},
				{
					"id": 722662010,
					"content": "早柚は見た目は頼りないが、腐っても終末番の忍者だからな。信頼できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662011
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662011,
					"content": "それに、暗号集を使うのがお前らだと知っていれば、もっと努力していたそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662012
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662012,
					"content": "暗号集を暗記する努力？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662013
					]
				},
				{
					"id": 722662013,
					"content": "「その上によだれをたらさないようにする努力。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722662014,
					"content": "さらばだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662015
					]
				},
				{
					"id": 722662015,
					"content": "ああ、早く離島に行くがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662016
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722662016,
					"content": "ふぅ…百華姉。あんたは当時、孤児だった私を終末番に入れた。今の私は…あんたの誇りになれたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
