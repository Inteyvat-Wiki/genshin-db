			"dialogs": [
				{
					"id": 722660701,
					"content": "帰ってきたぞ！全部解決したから、リュドヒカさんはもう安全だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660702,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660703,
					"content": "リュドヒカさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722660704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722660704,
					"content": "中にはいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722660705
					]
				},
				{
					"id": 722660705,
					"content": "おかしいな、いったいどこに行ったんだ？八重堂の人に聞いてみよう。リュドヒカさんの行方を知ってるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
