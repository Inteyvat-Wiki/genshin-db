			"dialogs": [
				{
					"id": 722661601,
					"content": "#{NICKNAME}、パイモン、来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661602
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661602,
					"content": "百代さん、大丈夫か？わっ、大変だ…！怪我してるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661603,
					"content": "#騒ぐな。これしきの傷、どうってことない。{NICKNAME}、少し肩を借りるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661604
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661604,
					"content": "おい、一人で歩けないなんて全然大丈夫じゃないじゃないか！？ちょっと待っててく…百代さん？どうしてこっちを見ないんだ…その目、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661605,
					"content": "ああ、元素の粉が入った箱を取りに行った時、ファデュイに箱を撃ち壊されたんだが、粉が目に入ってしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661606
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661606,
					"content": "確か、元素の粉は毒があるんだったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661607,
					"content": "うるさいやつだな。片方は無事だから心配ない。ただ、ここは暗すぎて何も見えないからとりあえず外に出よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
