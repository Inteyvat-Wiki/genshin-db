			},
			"dialogs": [
				{
					"id": 722661001,
					"content": "リュドヒカさん！やっと見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661002,
					"content": "#{NICKNAME}にパイモン…どうしてここへ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661003
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661003,
					"content": "一緒に帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661004
					]
				},
				{
					"id": 722661004,
					"content": "そうだ、百代さんもオイラたちもおまえのお金なんかいらない！そのお金はリュドヒカ自身が使って、稲妻で新しい生活を始めるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661005,
					"content": "あなたたち…何を言ってるんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661006
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661006,
					"content": "私は稲妻を危険に晒した、ファデュイだったのですよ。皆さんに大きな迷惑をかけたのです…いくら何でも、ここに残る資格はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661007
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661007,
					"content": "それに、あなたたちが残って欲しいと思ってくれていたとしても、他の人たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661008
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661008,
					"content": "この土地に、私を必要としている人なんていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661009
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661009,
					"content": "そんなことないぞ！オイラたち以外にも、リュドヒカさんに残って欲しい人がいるんだ！例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661010,
					"content": "百代さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661011
					]
				},
				{
					"id": 722661011,
					"content": "そうだぞ！百代さんのヒントがあったからこそ、リュドヒカさんを見つけられたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661012,
					"content": "百代さんは、目を失ったのはリュドヒカさんのせいじゃないって言ってた。ええと、労災だから終末番に埋め合わせしてもらうんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661013,
					"content": "労災とかは、言う必要ないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661014
					]
				},
				{
					"id": 722661014,
					"content": "えっ、どうしてだ？百代さんが言ってたから、説得力があると思ったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661015,
					"content": "し…しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661016
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661016,
					"content": "やっぱり百代さんとオイラたちの気持ちだけじゃ、残る気にはなれないのか？他にもいるんだぞ、例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661017,
					"content": "荒谷さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661018
					]
				},
				{
					"id": 722661018,
					"content": "そうそう！荒谷さんはリュドヒカさんのことを「器用で真面目」だって言ってたし、八重堂で正式に働いてほしいらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661019,
					"content": "でもオイラは、八重堂で働くのはやめた方がいいと思う。だってあそこで働いてる人たち、目の下のくまがひどいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661020,
					"content": "パイモン、そんなこと言っていいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661021
					]
				},
				{
					"id": 722661021,
					"content": "いいじゃないか！リュドヒカさんが残るんだったら、仕事もちゃんと選ばないとダメだろ。オイラの意見は超重要だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661022
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661022,
					"content": "リュドヒカさんには、やっぱり巫女が一番似合うと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661023,
					"content": "そう言われても、鳴神大社は私のような人間が気軽に行ける場所では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661024
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661024,
					"content": "そのことは心配しなくてもいいぞ。超大物が認めてくれてるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661025
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661025,
					"content": "八重宮司。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661026
					]
				},
				{
					"id": 722661026,
					"content": "神子はリュドヒカさんが偽者だってずっと知ってたんだ。それでも巫女に向いてるって思ってるらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661027
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661027,
					"content": "それに百代さんはもう神社で働けないから、リュドヒカさんも戻らないとなると、神子は怒ってオイラたちがひどい目に遭うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661028
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661028,
					"content": "脅しに聞こえるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661029
					]
				},
				{
					"id": 722661029,
					"content": "そんなことない！理性的に、情に訴えかけただけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661030
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661030,
					"content": "しかも、本当に神子にこってり絞られるかもしれないんだぞ。おまえは全く心配してないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661031
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661031,
					"content": "ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661032
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661032,
					"content": "へへっ、やっと笑ってくれたな！じゃあ、残ってくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661033
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661033,
					"content": "#パイモン、{NICKNAME}、それに私を受け入れて下さった皆さんも…本当にありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661034
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661034,
					"content": "ただ…私は幼い頃からスパイとしての訓練を受けてきました。稲妻に来るまでは、普通の生活を一度も経験したことが無いのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661035
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661035,
					"content": "「スネージヴナ」としての、自分の本当の居場所がどこにあるか、私にはまだ分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661036
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661036,
					"content": "それに、闇に染まった私のような者に、光の世界に戻る権利があるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661037
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661037,
					"content": "リュドヒカさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661038
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661038,
					"content": "ですから、稲妻を離れてテイワットを探索することは、私にとってもいいことかもしれないと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661039
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661039,
					"content": "少なくとも、自分がどんな人間になりたいか、じっくり考えることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661040
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661040,
					"content": "でも、リュドヒカさんは稲妻が大好きなんだろ？離れちゃったら、きっと後悔するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661041
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661041,
					"content": "確かに、そうかもしれません…けれど仕方のないことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661042
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722661042,
					"content": "ううう、そんな！リュドヒカさんも、本当は残りたいと思ってるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661043
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661043,
					"content": "これ以上言っても、説得は難しそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661044
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661044,
					"content": "その逆を利用してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661045
					]
				},
				{
					"id": 722661045,
					"content": "え、どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661046
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661046,
					"content": "先ずは彼女の警戒心を解く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661047
					]
				},
				{
					"id": 722661047,
					"content": "そして、自分の心に正面から向き合わせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661048
					]
				},
				{
					"id": 722661048,
					"content": "なるほど。リュドヒカさんは夢がない訳じゃないもんな。自分は幸せになる資格がないって思い込んでるから、素直になれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661049
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661049,
					"content": "あ、だったら！オイラたちが持ってるものが役に立つかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661050
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661050,
					"content": "今度こそ成功させようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
