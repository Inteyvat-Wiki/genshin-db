			},
			"dialogs": [
				{
					"id": 722661201,
					"content": "コホッ…もういい。お前たちみたいなゴミクズに言うことなんかもうない…さっさとやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661202
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661202,
					"content": "百代さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661203,
					"content": "助けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661204
					]
				},
				{
					"id": 722661204,
					"content": "#この声…パイモンと{NICKNAME}か？ふん、こんなところまで来るとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661205
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661205,
					"content": "おい、強がりはやめろよな。元素の粉を残したんだから、オイラたちが助けに来るって信じてたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661206,
					"content": "チッ…ならどうしろって言うんだ。この私に褒められたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661207
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661207,
					"content": "えへへっ、誉め言葉はここから脱出してからにしようぜ。先に扉を開けないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722661208,
					"content": "扉は施錠されてる。鍵はやつらのボスが持ってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661209
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661209,
					"content": "やつら、尋問の途中で何か情報が入ったようで、慌てて離れて行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661210
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661210,
					"content": "恐らく今は最上層の部屋で作戦を立ててやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661211
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661211,
					"content": "恐らく中から鍵をかけているだろう。侵入するには、特別な勾玉が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722661212
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722661212,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722661213
					]
				},
				{
					"id": 722661213,
					"content": "ああ、頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				}
			]
		},
