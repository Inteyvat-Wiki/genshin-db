			},
			"dialogs": [
				{
					"id": 722662101,
					"content": "これは…鳴神大社のおみくじ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662102
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662102,
					"content": "そうだぞ。偽のみくじ竹を使って尾行した時に手に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662103,
					"content": "みくじ竹は偽物だったけど、おかげでリュドヒカさんの思いが理解できただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662104,
					"content": "その時、オイラたちに言ったよな。「あなたたちは良い人だから、おみくじの内容は的中する」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662105,
					"content": "リュドヒカさんも良い人だから、このおみくじもきっと的中するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662106,
					"content": "これで稲妻での楽しい時間を思い出して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662107
					]
				},
				{
					"id": 722662107,
					"content": "ご神託のままに進みなさい、「飛翔し、漂って、海を渡り、はるか遠くへ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662108,
					"content": "「でもいつの日か、あなたの漂泊は終わる。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662109
					]
				},
				{
					"id": 722662109,
					"content": "「そしていつの日かきっと、あなたは自分の望む姿になれる。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662110
					]
				},
				{
					"id": 722662110,
					"content": "「いつの日かきっと、あなたは自分の望む姿になれる。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662111
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662111,
					"content": "私の…望む姿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662112
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662112,
					"content": "リュドヒカさんは自分の人生に向かう場所がないって言ってたけど、そんなことないぞ。ただ、過去の自分に縛られているだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662113,
					"content": "本当は、どんな人になりたいか、はっきり分かってるんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662114,
					"content": "私が…すでに分かっている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662115
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662115,
					"content": "そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662116,
					"content": "その身にまとった巫女服が——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662117
					]
				},
				{
					"id": 722662117,
					"content": "答えだと思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662118
					]
				},
				{
					"id": 722662118,
					"content": "…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662119
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662119,
					"content": "う…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662120
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662120,
					"content": "…そ、そうです。あなたたちの、言う通りです…！私は…いつも、本物の巫女になりたいと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662121
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662121,
					"content": "みくじ箱からおみくじを引く人達が、真剣に悩みを打ち明けてくれるたび、私は自分が詐欺師であることへの罪悪感に苛まれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662122
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662122,
					"content": "私はずっと、彼らに幸運をもたらしたかった…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662123
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662123,
					"content": "#うう…{NICKNAME}、パイモン、私の願いは叶えられるものでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662124
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662124,
					"content": "私は、本当にここに残っていいのでしょうか…私が憧れているような人間に、なれるでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662125,
						722662126
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662125,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				},
				{
					"id": 722662127,
					"content": "百代さんも言ってたぞ。必要なら、引き続き「玄冬林檎」って言う名前を使っていいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662128,
					"content": "もうリュドヒカという名前にだって、縛られる必要はないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662129,
					"content": "うぅ…本当に…ありがとうございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662130
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662130,
					"content": "私は必ず、本物の「玄冬林檎」になってみせます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662131
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662131,
					"content": "しばらくして、リュドヒカはやっと落着きを取り戻した。\\nそこで、もらったお金を彼女に返した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722662132
					]
				},
				{
					"id": 722662132,
					"content": "ふぅ…お二人には、迷惑をかけてしまいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662133
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662133,
					"content": "へへっ、結果オーライだったんだから、苦労した甲斐があったぞ。もう大丈夫だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722662134,
					"content": "はい、この気持ちは確かなものです。私は稲妻に、鳴神大社に残りたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662135
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662135,
					"content": "モラを返していただいたので、お二人もこのおみくじを受け取ってください。この祝福が、ずっとあなたたちを守ってくれますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662136
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662136,
					"content": "これから神社に戻ります。叶うなら、百代さんに直接お礼を言いたいです。それから、私を受け入れてくれた八重様にも感謝しなくては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662137
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662137,
					"content": "#{NICKNAME}、パイモン、さようなら。また鳴神大社でお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722662138
					],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662138,
					"content": "さようなら、リュドヒカ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662139
					]
				},
				{
					"id": 722662139,
					"content": "ふふっ、次にお会いする時は、「玄冬林檎」と呼んでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「玄冬林檎」"
				},
				{
					"id": 722662126,
					"content": "きっとなれるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722662127
					]
				}
			]
		}
	]
}