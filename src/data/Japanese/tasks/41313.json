					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "どうだ、事は解決したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130202,
					"content": "解決した、だけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "それならいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130204,
					"content": "明霄の灯を見に行かない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "行かぬ。人が多い所は好きではないと言ったはずだ、この時期は特に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130206,
					"content": "今年の明霄の灯は「移霄導天真君」だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "そうだぞ。すごく神々しい鹿なんだ、一緒に見に行かないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130208,
					"content": "「移霄導天真君」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130209,
					"content": "所詮ただの霄灯だ。人が作った光るゴミに興味は無い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130210,
					"content": "お前たちだけで行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "どうやら、また魈様と一緒に大事を成し遂げたようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413130302,
					"content": "ここまで騒ぎが聞こえてきましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130303,
					"content": "今年の海灯祭もそろそろ終わりだけど、やっぱり行かなかったのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413130304,
					"content": "はあ、ここ数年、あの方が海灯祭に行ったのを見たことがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130305,
					"content": "海灯祭に行ってもらうよりも、海灯祭をここに持ってくる方が簡単かもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130306,
					"content": "海灯祭を…持ってくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130307,
					"content": "いいアイデアだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "それだ！魈が海灯祭に行かないのなら、海灯祭を持ってくればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130309,
					"content": "え？ただの冗談ですよ…本気にしてるんですか？どうやって「運ぶ」のです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130310,
					"content": "海灯祭を回っていた時に「霄灯」の編み方を教わったんだ。それと、特産品を売ってる屋台も見つけた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130311,
					"content": "たくさんの美味しいものときれいな霄灯、あと…うん、過去の英雄、それと昔の友人たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130312,
					"content": "これが海灯祭の全てだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130313,
					"content": "確かにその通りね。でも、どこに配置すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 413130314,
					"content": "そうですね。少し広い場所がいいでしょう。屋台も作った方がいい。ふむ…<color=#00E1FFFF>旅館の下の方</color>なら場所が空いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130315,
					"content": "そこに行っていい場所を探しましょう。どのような屋台がいいのかも大体把握しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130316,
					"content": "ふむ…何か参考になるものがあるはずだ、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "ここがいいですね。うん…静かでぴったりな場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130702,
					"content": "ではここにしましょう。どのようにして屋台を立てるかも思いつきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130703,
					"content": "少しお待ちください。うーん、どこから始めるべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130704,
					"content": "よし、これでいいでしょう。ほら、見てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130705,
					"content": "支配人、その木工技術…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "はは、少しかじっていただけです。何年も前に学んだものなので、もうほとんど覚えていませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130707,
					"content": "これで屋台はできました。ついでに「霄灯」も飾りましたが、いい感じでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130708,
					"content": "霄灯も編めるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "はは、私のような璃月で生まれ育った者は、ほとんど編めますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130710,
					"content": "そうだ、せっかくの祭り…いい物を食べなくては。料理については考えてありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130711,
					"content": "料理…あ、「杏仁豆腐」！前に魈にごちそうしたことがあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130712,
					"content": "あと「チ虎魚焼き」も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "「杏仁豆腐」と「チ虎魚焼き」ですね。分かりました、すぐに言笑に用意させます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 413130714,
					"content": "ちょうど食材も旅館に揃っていますし、これくらいの料理なら、すぐに作ってくれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
