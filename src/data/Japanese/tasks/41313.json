					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "何の用だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130802,
					"content": "一緒に海灯祭に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "…人の多いところは好きではない。お前たちだけで行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130804,
					"content": "璃月港に行く必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130806,
					"content": "海灯祭を運んで来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "「運んで来た」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130808,
					"content": "もう、だから旅館の下に美味しい物と霄灯をたくさん並べたんだ。周りには人もいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130809,
					"content": "「杏仁豆腐」と「チ虎魚焼き」もある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "早く降りよう！料理が冷めちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
