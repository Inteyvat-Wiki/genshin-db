			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "どうだ、オイラたちが持って来た海灯祭は美味しそうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130902,
					"content": "これがお前たちが運んできた海灯祭か？人間の行動は奇怪でなければダメなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130903,
					"content": "なんのために、こんなことをした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130904,
					"content": "魈にも海灯祭に参加してほしかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "…そうなのか？人の心を理解するのは難しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130907,
					"content": "話はいいから、早く食べようぜ。料理が冷めちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130908,
					"content": "へへ、オイラは先に食べるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130909,
					"content": "よし、ご飯も食べたし、次は「明霄の灯」を見に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130910,
					"content": "魈も一緒に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "お前たちだけで行け。我は興味ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130912,
					"content": "じゃあ、せめて近くまで送って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "そうだぞ、「明霄の灯」を見に行かなくても…オイラたちを送るくらいはしてくれてもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130915,
					"content": "ここから璃月港まで遠いし、郊外は危険だ…そう、どこもかしこも危険だらけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130916,
					"content": "城内までとは言わないから、せめて城の近くまで送ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130917,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130918,
					"content": "…ふぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130919,
					"content": "分かった、<color=#00E1FFFF>城の近くまで</color>送ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413130920,
					"content": "よし！じゃあ、早速出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413130913,
					"content": "お願い、護法夜叉様！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "海灯祭はみんなの祭りだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
