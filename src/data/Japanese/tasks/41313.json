				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "送るのはここまでだ。城の中まではついていかぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131102,
					"content": "待って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "まだ何かあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131105,
					"content": "おまえも海灯祭で祀られる英雄なんだろ…なんで明霄の灯を見ないんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413131106,
					"content": "我は…人が多いのは好きではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131107,
					"content": "何も悩みのない、穏やかに暮す人々…我と彼らは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131108,
					"content": "我は殺戮と共にありすぎた。苦行に慣れ過ぎてしまっている。幸福な人々と一緒にいるのを、我は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131109,
					"content": "…話はここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131110,
					"content": "ではまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131111,
					"content": "本当に一緒に見ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "ただの賑やかしが趣味なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131113,
					"content": "どうかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "おい！これはれっきとした祭りなんだぞ！賑やかしってなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413131115,
					"content": "…れっきとした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131116,
					"content": "もういい。灯りを見に行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131117,
					"content": "だが気を付けろ。何か危険な目に遭った時は…我の名を呼べ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131118,
					"content": "城内にいなくてもすぐ来れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "必ず駆けつける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "魈"
				},
				{
					"id": 413131120,
					"content": "お前でも、この璃月でも、全ての灯り、そして平和を祈る全ての願いは、我に届くのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 413131104,
					"content": "(仕方ない、ここからでも見えるし…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
