			},
			"dialogs": [
				{
					"id": 710501401,
					"content": "他のことは一旦置いといて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501402,
					"content": "層岩巨淵にいるこの数日間、君は色々助けてくれた。どう感謝すればいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501403,
					"content": "これ以上君にモラを払うというのは、いくらなんでも水臭いからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501404,
					"content": "どうしても払いたいなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "冗談はよしてくれ。モラで恩を返すなんて、そんな風情のないことはしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501406,
					"content": "それは君への侮辱じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501407,
					"content": "さあ、この手紙を受け取ってくれ。もし今後スメールに行く機会があれば、何か困った時や手助けが必要な時に、この手紙を持ってプルビルニの者を探すといい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501408,
					"content": "俺たちは全力で君の手助けをするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501409,
					"content": "「人情の往来は、黄金よりも貴いものだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710501410,
					"content": "スメールのこのことわざでも、こんなことを語っているのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				}
			]
		}
	]
