			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "うん、普通に美味しい料理だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440502,
					"content": "ボクが楽しみにしてた増殖現象はなかった、どうやらキミの世界でも食べ物に困らないわけではないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440503,
					"content": "いや、この世界の法則がキミの特殊能力を制限してる可能性は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440504,
					"content": "まず、調味料のように元素力を料理に入れる方法が分からなかったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440505,
					"content": "大丈夫、少なくとも美味しい料理は無駄にならなかったんだから、落ち込むことはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440506,
					"content": "さあ、これはパイモンの分だ。ゆっくり食べて、持ち帰ってくれてもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440507,
					"content": "やったー、覚えてくれてたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440508,
					"content": "パイモンに優しいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "実験中パイモンはずっとキミの心配をしてた、きっとキミの大事な友達なんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440511,
					"content": "そういう心配が役に立つかどうかは別だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440512,
					"content": "おい、オイラの悪口を言うなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440513,
					"content": "でも美味しいものをご馳走してくれたから、許してやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440514,
					"content": "オイラたちの仲を羨ましがる必要はないぞ。おまえにも友達や生徒たちがいるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440515,
					"content": "…そうだね、ボクは運に恵まれてる方だね。それより、次の実験に移ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440516,
					"content": "錬金術の道具は種類が雑多だし、その保管方法は実に難しい。少し前に、あるアクシデントで、ボクのコレクションが地面に散らばったことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440517,
					"content": "そのほとんどは見つかったけど、風晶蝶の元素抽出物と無相の雷の粉末がどうしても見つからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440518,
					"content": "ごはんを作った後は、落とし物探しか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440519,
					"content": "元々作り直すつもりだったから大丈夫だよ。ただ、もし見つかったら手間が省ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440520,
					"content": "キミに「暗視」や「振動感知」などの超能力があれば、落とし物を見つけるなんて楽勝だろうけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440521,
					"content": "キミたちが見学した場所のどこかにあると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440522,
					"content": "じゃあ…やってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440523,
					"content": "失くなったものに元素力があれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "そうだ！元素視角を使えばいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440509,
					"content": "パイモンに優しい人は少ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
