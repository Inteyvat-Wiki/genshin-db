			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "ただいま、何か興味をそそられるものは見つかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440142,
					"content": "全然分からなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "気にすることはない、錬金術の道具ばかりだし、日常生活で使うことはないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440146,
					"content": "とにかく、急いで次の研究に入ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440101,
					"content": "異なる世界には、大きな違いが存在する可能性がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440102,
					"content": "たとえば、テイワットでは神の目を持つ者は元素力を使える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440103,
					"content": "しかし「ただ一人のみが元素力を使える世界」、もしくは「誰もが元素力を使える世界」が存在するかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440104,
					"content": "#だから、元素の他に…{NICKNAME}、キミはこの世界にない特殊な力を持ってはいないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440105,
					"content": "それとも前みたいに、実験で検証する必要があるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440106,
					"content": "またスライムを倒す？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "いやいや、今回は簡単だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440109,
					"content": "そこに柱がある。念力でそれを折ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440110,
					"content": "ごめん、できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "すでに試したことがあるのかい？ふむ、そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440112,
					"content": "それが普通だろ、なんでガッカリしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440116,
					"content": "そうだ、元素力で料理したことは？調理ではなく、元素力を料理に入れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440117,
					"content": "それで料理が美味しくなるか気になるよ。それとも食感が変わったり、増殖したり…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440118,
					"content": "錬金術師の考え方は独特だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "ハハッ、他人が気付かないところに好奇心を向けると、新たな発見があったりするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440121,
					"content": "「バター魚焼き」を作ってほしい、これはボクが用意したレシピだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440151,
					"content": "準備ってのはレシピのことだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440122,
					"content": "ボクは普段よくこれを食べるんだ。だから実験としても料理としても、いい選択なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440123,
					"content": "絶対にお腹空いてるだけだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440124,
					"content": "でも美味しいものを作るなら、オイラは反対しないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440125,
					"content": "はいはい、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "おう、さすがオイラの相棒だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440128,
					"content": "では頼むよ、実験結果を楽しみにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440130,
					"content": "食べきれない場合は、ティマイオスも呼んでくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440131,
					"content": "オイラがいるから、そんなの心配ないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440126,
					"content": "ちゃんとパイモンの分も作るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "お腹空いてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "パイモン、それを折って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "オイラでもできっこないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440115,
					"content": "すでに試したことがあるのかい？ふむ、そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440107,
					"content": "また薬剤を飲む？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "少し散らかってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "同感だね、片付けようと思ったけど、次から次へと実験が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "アルベド"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "全部見つけてくれたんだね、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440321,
					"content": "落とし物探しも、雪山でボクを探したのも、「元素視角」を使った、そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440322,
					"content": "おう、超能力みたいなもんかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440323,
					"content": "残念ながら、確かに「元素視角」は珍しいけど、テイワットにある能力だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440324,
					"content": "聞いたことのない異世界の超能力だけ、ボクの研究に役立つんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440325,
					"content": "つまり、苦労が水の泡ってことだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110440326,
					"content": "そう落ち込まないで、それも想定内だよ。それに落とし物を回収できたし、価値のある実験だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440301,
					"content": "落とし物に元素力があると思いついたのも、称賛に値する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440302,
					"content": "さて、今までは異世界の違いを研究してきたけど、次はキミの人類としての肩書きに関する研究を始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440303,
					"content": "最後まで付き合うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "人類の個体差は知能と身体能力から調べられる。まずは身体能力から始めようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440306,
					"content": "ここからスクロースが何をしてるか見えるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440307,
					"content": "見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "では、平地からあちらの崖にジャンプしたら、見えるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440309,
					"content": "見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "では、目の前の山を破壊したら、見えるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440311,
					"content": "見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "それなら少し簡単なことからしようか。質問より、実験の方が直観的だしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440314,
					"content": "身体能力の実験に相応しい場所を知ってる、ついてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110440312,
					"content": "これも超能力のテストじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "「泥船に乗る」ってこういうことだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
