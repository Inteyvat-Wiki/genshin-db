			"dialogs": [
				{
					"id": 402010501,
					"content": "これで確信できたな。やっぱりあいつらは焦ってて、大量の荷物を一気にフォンテーヌまで運ぼうとしてるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
