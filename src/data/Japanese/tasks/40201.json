			"dialogs": [
				{
					"id": 402010101,
					"content": "時間通りね、いい心がけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010102,
					"content": "進捗はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "拠点に潜伏した次の日、コーダーとドッダマーニは荷物を動かし始めたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010105,
					"content": "あの船が見える？ドッダマーニが調達した貨物船よ。乗客まで乗せて偽装しているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010106,
					"content": "おお、結構デカいな！桟橋に荷物がたくさん積み上げられてるし、あれに乗ってルミドゥースハーバーに行く外国人も結構いるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010107,
					"content": "相手が本当に動いたか確かめるなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "よくそこに気が付いたわね。飲み込みが早くて助かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010110,
					"content": "あの二人はとても慎重だから、目を付けられていると知ったら、空っぽの船をルミドゥースハーバーに向かわせて、こちらの出方をうかがうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010111,
					"content": "それに、捕まえた犯人の証言によると、「邪知深き狂者」と呼ばれるベテラン宝盗犯が、「ブラックマネー・ロード」と手を組んでいるらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010112,
					"content": "「邪知深き狂者」は秘密工作が得意なの。前回の調査で確信したんだけど、島で千岩軍の信号を観測していた見張りは彼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010113,
					"content": "私は「邪知深き狂者」に気付かれないよう、この辺りを見回っているから、君たちはその隙に荷物を調べて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010114,
					"content": "できるだけ目立たないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010115,
					"content": "分かった。気をつける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "おう！オイラも…できるだけ低く飛ぶようにするぞ！飛ぶのはこいつの肩より下だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010116,
					"content": "ちゃんとやるから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "荷物を調べたほうがいいよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "何か動きはあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
		{
