			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "それにしても、びっくりしたぞ！直接犯人たちに会うなんて…警戒されて、調査がバレたらどうする気だったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010302,
					"content": "向こうはすべてを把握したうえで、こちらの言うことを聞くしかなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010303,
					"content": "「ブラックマネー・ロード」は相当慎重よ。トカゲのように尻尾を切って、逃げるつもりだったんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010304,
					"content": "競売には出品せず、荷物を全部海に沈めてしまえば、自分に繋がる証拠は消える。そうして「邪知深き狂者」に注意を移すつもりだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010305,
					"content": "でも、執律庭がかかわってきた以上、彼らは競売に参加せざるを得ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010306,
					"content": "「ブラックマネー・ロード」が代理人に美術品の落札をやめさせ、事情を知らない人がそれを落札したら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010307,
					"content": "その人は値段が不当に高いことに気が付き、警察に通報するでしょう。そうなれば、コーダーは容疑者として目を付けられ、罪に問われることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010308,
					"content": "少なくとも、「ブラックマネー・ロード」は同じ手口でモラロンダリングを行えなくなる。フォンテーヌにおける最後の右腕を失うことだって考えられるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010309,
					"content": "たとえ彼が競売に参加したとしても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "そういうこと。その場合、手がかりが途絶えることはない。競売品を落札した人を調べれば、「ブラックマネー・ロード」の足取りを追うことができるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010312,
					"content": "えっ？えっと…んん？…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010313,
					"content": "#大丈夫よ、パイモン。後で{NICKNAME}がちゃんと説明してくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010314,
					"content": "それじゃあ、一番肝心な大詰め…競売での誘導作戦のために、お互い準備を整えておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010315,
					"content": "エドラー捜査官が部下に手配させた招待状よ。受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010316,
					"content": "二日後、ホテル・ドゥボールで会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010310,
					"content": "こちらにはメリットしかない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
