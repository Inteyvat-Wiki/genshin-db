						],
						"pointId": 311500262
					}
				]
			},
			"dialogs": [
				{
					"id": 402010201,
					"content": "ご案内します。貨物室が満杯なため、一部の荷物はデッキに置かせていただきました。乗客の皆様には、ご迷惑をおかけして申し訳ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "船員"
				},
				{
					"id": 402010202,
					"content": "いいさいいさ、景気が良い証拠だよ。みんなで儲けようじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "熱心な乗客"
				},
				{
					"id": 402010203,
					"content": "「邪知深き狂者」のマークがあった荷物の持ち主はコーダーみたい。ドッダマーニは船内を動き回っているわ。荷物の確認をしているんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010204,
					"content": "荷物の…確認？箱の中身をひっくり返してまでか？なにがしたいのか、全然わからないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010205,
					"content": "この暗号表を持っていって。これがあれば、彼らの暗号が読めるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010206,
					"content": "コーダーとドッダマーニは私が引き離すから、その隙にマークのあった荷物を調べてちょうだい。手がかりを掴めると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010207,
					"content": "もし妙なものが見つかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "君の判断を信じるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010210,
					"content": "えっ？おい、おまえが直接あいつらと話しに行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010211,
					"content": "あら？そこのお二人…どこかでお見かけした気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010212,
					"content": "遺瓏埠の九略茶館で会わなかったかしら？リヨンエリアの有名な骨董品収集家コーダーさんと…そのご友人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010213,
					"content": "えっ？お…お前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "ドッダマーニ"
				},
				{
					"id": 402010214,
					"content": "…「岩上茶室」の「霊賽伝説」、夜蘭さんだね。お会いできて光栄だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010215,
					"content": "私のことを知っているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010216,
					"content": "以前「岩上茶室」で絶品のお茶を飲んだことがあってね。その時、あなたの噂を耳にしたんだ。今思うと、お茶を愛する者同士、私たちには何らかの縁があるのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010217,
					"content": "こんな偶然ってあるのね…ちょうどフォンテーヌで休暇を楽しむ予定なんだけど、おすすめの場所はないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010218,
					"content": "例えば…精巧な茶器の展示会とか…競売とか？フォンテーヌの紅茶は格別だと聞いたわ。きっと茶器も素晴らしいんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010219,
					"content": "えっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "ドッダマーニ"
				},
				{
					"id": 402010220,
					"content": "あら？君も茶器に興味があるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010221,
					"content": "コホンッ…お、俺は船主のドッダマーニ。コーダーに誘われて、フォンテーヌ旅行に向かっているところだ。よろしく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "ドッダマーニ"
				},
				{
					"id": 402010222,
					"content": "夜蘭のやつ、本当にあいつらと話し始めたぞ。大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010223,
					"content": "急いで荷物を調べよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "わかった！あいつらから見えない場所に回って、荷物を調べてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010226,
					"content": "ケホッケホッ…箱の中から強烈な匂いがするぞ。いろんなものが混ざったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010227,
					"content": "それに変なメモもある。なんて書いてあるかは読めないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010228,
					"content": "「ブラックマネー・ロード」の暗号…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "さすが夜蘭、こんな状況まで予想してたなんて！じゃあ、読み方はわかるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010231,
					"content": "なんて書いてあるんだ？教えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010232,
					"content": "解読が正しければ、これは爆弾だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "ばばばば…爆弾！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010235,
					"content": "あいつら、本気かよ！捕まりたくないからって、そんなことをしたら余計大変なことになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010236,
					"content": "「邪知深き狂者」は黒幕を守るため…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "夜蘭の読み通りだ。あいつら、どうかしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010240,
					"content": "船には関係ない人たちがたくさん乗ってる。爆弾を全部探し出して止めないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010237,
					"content": "事件を起こして注意を逸らし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "手がかりも一緒に消そうとしてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "船を爆破して証拠を消そうとしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "暗号表がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "このチャンスを利用しないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "処分しておいたほうがいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
