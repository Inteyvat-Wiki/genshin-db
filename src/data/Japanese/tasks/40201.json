			"dialogs": [
				{
					"id": 402010401,
					"content": "甲板の爆弾は全部片付けたな。船の中にもあるはずだけど…時間は大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010402,
					"content": "船の中の爆弾は、私が処理しておいたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010403,
					"content": "お疲れ様、旅人、パイモン。予想外の出来事だったけど、完璧な対応だったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010404,
					"content": "夜蘭！怪しいところに気づいて、船に乗り込んだうえに、オイラたちに暗号表まで渡しておくなんて、さすがだな！助かったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010405,
					"content": "そうだ！あの二人はどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402010406,
					"content": "ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010407,
					"content": "危ないところだったわね、コーダーさん、ドッダマーニさん。どうやら君たちは、とんでもない危険人物に命と財産を狙われているみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010409,
					"content": "いや、まったくだ。まさか、これほどの悪党がいるとは考えもしなかったよ。命を狙われるほどの恨みを買った覚えはないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010410,
					"content": "もう心配ないわ。ルミドゥースハーバーに護衛を派遣するよう、執律庭に連絡しておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010411,
					"content": "コーダーさんの荷物は、執律庭が検査してくれるわ。安全が確認できたら、警察隊員が目的地まで届けてくれるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010412,
					"content": "そういえば、コーダーさんの荷物はどこに運べばよいのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010413,
					"content": "…二日後にホテル・ドゥボールで開催される、競売会場だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010414,
					"content": "分かったわ。安心して、執律庭の警察隊員はみんな職務に忠実だから。荷物は完璧な状態で、競売に出品できる…私が保証するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010415,
					"content": "感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 402010416,
					"content": "しばらくして、船は無事ルミドゥースハーバーに到着した。執律庭の警察隊員はすぐに船の管理を引き継ぎ、安全検査を行った上で、すべての貨物に封をして運び出した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "「邪知深き狂者」がコーダーとドッダマーニに残した手紙の内容を夜蘭に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
