						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470201,
					"content": "お待たせ！それじゃあごゆっくり——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470202,
					"content": "おお、いい香りじゃのう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470203,
					"content": "…あっ、そうですわ。パイモンと旅人も朝食はまだなんでしょう？それなら一緒にどうです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470204,
					"content": "ええっ？ドリー、いつの間にそんな親切になったんだよ…タ、タダで朝ごはんが食べられるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470205,
					"content": "うふふっ、大きい取引というものは宴席で決まるものでしょう…？ほらほら、座って座って！遠慮しないでくださいまし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470206,
					"content": "（この料理はありきたりな料理に見えますし、事前に調べた限りでは、そんなにモラはかからないはずですわ！一万なら問題ありませんが、三万だとちょっと…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470207,
					"content": "（この料理、一晩徹夜するほどの価値があるのかのう？…元を取れるかどうかはお前にかかっておるぞ、旅人！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470208,
					"content": "（疲れた…眠い…眠たい…早く食べて、戻って寝よう…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470209,
					"content": "各自がそれぞれの思惑を抱え、箸を動かす…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "これは…鶏もも肉？ううん、キノシシの食感にも似てるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470211,
					"content": "噛むたびに別の味わいが広がるのう…よーく味わうと煙でいぶしたような風味もある…実に不思議じゃな、どうやって作ったんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470212,
					"content": "ハムだよ、ハムを入れたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "ハム？しかし、この料理のどこに——あ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470214,
					"content": "へへっ、気づいたみたいだな？そう！色んな種類の肉を細切りにして棒状にしたんだぞ！オイラと言笑ですっごく頑張ったんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470215,
					"content": "でも、私にはよく分からないけど……肉の種類が違えば、火を通す時間も全部違うでしょう？でもこの料理はきちんと味の調和が取れてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470216,
					"content": "え…えーっと…それは企業秘密ってやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470217,
					"content": "単に慣れてるだけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "これがお前独自の料理法とはのう。無駄足にはならんかったわい。それで、この料理は何というんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470220,
					"content": "おっと、紹介し忘れてたな。この料理の名前は「繁絃急管」——細い糸が交差するように見えるのと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470221,
					"content": "…複雑で変化に富む食感を表現したと？璃月の言葉から取った名じゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470222,
					"content": "華麗で賑やかに楽曲が盛り上がってゆく様子を意味する言葉なのじゃが…うむ、ぴったりな名前じゃの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470223,
					"content": "なんだ…知ってたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470224,
					"content": "当たり前じゃ。若者は、卒業までに少なくとも二十種類の言語を習得するはずじゃろ。ふむ…今はその必要が無いのかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470225,
					"content": "——えっ？昔もそうだったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470226,
					"content": "おまえも知論派だってこと、うっかり忘れてたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470227,
					"content": "それで…その…このお料理のお値段ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470228,
					"content": "へへっ——そんな高くないって。三万モラいただくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470229,
					"content": "さ…三万！あ…あひゃひゃ…あひゃひゃひゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470230,
					"content": "そ、そうですわ…パイモン、旅人。私、あなたたちには「一緒にどうです」と言っただけで…ご馳走するとは言ってませんわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470231,
					"content": "——つまり、「相席」しただけ…そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470232,
					"content": "——やっぱりタダの朝ごはんなんてなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470233,
					"content": "ほんの三万だよ、安いものでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "そうだそうだ！商人は信用を大事にするんじゃないのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470235,
					"content": "うぅ…たとえ一モラだってお金ですのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470239,
					"content": "くっ、いいでしょう…勉強料ということにいたしますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470240,
					"content": "…スメールに帰ったら、必ずやこの料理を再現してもらい、思い切り稼いでやりますの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470236,
					"content": "二割引きでどう？支配人に話してみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "おまえってやつは…まぁいっか。ちょっと安くしてもどうせおまえのギャラになるんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470238,
					"content": "三万モラの二割引き…うぅ、まだ少し厳しいですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470218,
					"content": "独自の調理方法があるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
