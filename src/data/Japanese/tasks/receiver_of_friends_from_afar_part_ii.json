			},
			"dialogs": [
				{
					"id": 401470301,
					"content": "朝からいい出だしじゃないか。次もよろしく頼んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470302,
					"content": "あなたとパイモンは閉店まで忙しく働いた。たくさんのお客が来店し、好みも様々だったが、驚いたことに、全員が同じように高評価を残して行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014704,
			"completionStepIds": [
				4014706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4014706",
							"2"
						],
						"stepId": 4014706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							888.421,
							255.563,
							329.875
						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401470401,
					"content": "…高価で、しかも海鮮は使えず、さらには時間もかけられない…それじゃあ大半の料理がダメじゃないか。こんな意地悪な注文、いったい誰が出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470402,
					"content": "ドリーのやつ！わざとやってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470403,
					"content": "多分わざとだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470404
					]
				},
				{
					"id": 401470404,
					"content": "うちの旅館は琉璃亭や新月軒と違って、高級な食材を常備しているわけじゃないんだ。普通はお客さんの予約が入ってから準備するもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470405,
					"content": "ありふれた食材を使って、短時間で正真正銘の高級料理を作る…そうなると、値段が付くのは料理人の「技」と料理の「独創性」だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470406,
					"content": "「繁絃急管」という料理がある。手元にある食材だけで作れて、提供するのにも時間はかからない…そして一皿の値段は…三万モラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470407
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470407,
					"content": "——三万！普通の食材を使って、時間もかからないのにか？なんでそんなに高いんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470408,
					"content": "この料理の「技」は時間じゃなく、料理人の包丁さばきと火加減にかかっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470409
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470409,
					"content": "様々な種類の肉を細切りにし、棒状にこねてから最後に鍋で炒めるんだ。食べてるうちに、味わいがどんどん変化し、しかも進化していくのがウリだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470410,
					"content": "種類の違うそれぞれの肉をいかにまとめ、ちょうどよく焼き上げるか…いかに互いの味がぶつからないようにするか——それがこの料理の価値を示す部分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470411
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470411,
					"content": "うまくできれば、超一流の名物料理。しくじったら、ただの肉そぼろだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470412
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470412,
					"content": "おお——わかったぞ！つまり高いのは料理じゃなく、料理人のギャラってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470413,
					"content": "そう言われると自信がなくなってきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470414
					]
				},
				{
					"id": 401470414,
					"content": "大丈夫だ。棒状にこねるような細かい作業は俺が手伝ってやれる。お前は一番大事な部分に集中すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470415
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470415,
					"content": "心配すんなって、大胆にやってみろよ！たとえ失敗しても、おまえが作った肉そぼろならオイラは喜んで食うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
