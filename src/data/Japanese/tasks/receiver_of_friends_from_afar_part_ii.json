						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470101,
					"content": "おはよう！支配人の話では、前回来てくれた新しいお客さんや常連からは、とても好評だったらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470102,
					"content": "こういうことには慣れないんじゃないかと心配していたんだが、この分だと…お前の腕前なら、通常業務は十分にこなせそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470103,
					"content": "味にうるさいうえに、要求が面倒な客が来ない限り、お前が困ることはないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470104,
					"content": "えぇ…そんな客もいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470105,
					"content": "そりゃもちろん！特に、ほとんど料理をしたことがないくせに、本だけは山ほど読んでる学者先生とかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470106,
					"content": "暇になるとやって来ては、「あんたの作ったものは伝統的ではない」だの、「どこどこがこうで数百年前の味と違う」だの…粗探しをするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470107,
					"content": "——ここが望舒旅館か？一応は老舗といったところかのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470108
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470108,
					"content": "この声は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470109
					]
				},
				{
					"id": 401470109,
					"content": "これ、店主！何か看板料理があるなら、早くここへ持ってまいれ！一番高いやつじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470110
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470110,
					"content": "ファルザン！…せ、先輩、どうも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470111,
					"content": "おおっ！旅人に、パイモンか？なぜここにおるのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470112
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470112,
					"content": "こっちが聞きたいぞ。なんで急に旅行できるくらいの経費ができたんだ？しかも一番高い料理まで注文して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470113,
					"content": "ふふん、これは旅行ではないぞ。ワシのような学者が「専門アドバイザー」として招かれ、世界中を旅するのは日常茶飯事じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470114
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470114,
					"content": "ファルザン先輩…ゆ…ゆっくり…ふぅ…昨日の夜はみんなで徹夜だったのに、どうして先輩だけこんなに元気なの？本当に百歳を越えてるのかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470115
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470115,
					"content": "ふふ…ふ…私が奢ると言ってから、ずっとこの調子ですのよ…しくじりましたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470116
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470116,
					"content": "レイラ！それにドリー？珍しい組み合わせだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470117,
					"content": "とりあえず座ってよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470118
					]
				},
				{
					"id": 401470118,
					"content": "三人を席に案内し、自分が望舒旅館で手伝いをしている経緯を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470119
					]
				},
				{
					"id": 401470119,
					"content": "ほう…お前は実に忙しいやつじゃのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470120
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470120,
					"content": "じゃが、ここの料理長にも認められておるなら、本場の名物料理を食べ損なう心配はないのう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470121
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470121,
					"content": "それでおまえたちはなんで璃月に来たんだ？さっき「専門アドバイザー」とかなんとかって聞いたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470122,
					"content": "うふっ、先日フォンテーヌから新しい船を入手いたしまして…なんと最先端のナビゲーションシステムが搭載されていますのよ！これを普及できれば、とても大きなビジネスチャンスになることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470123
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470123,
					"content": "ここ数日、試運転でオルモス港から離島へ、離島から璃月港へと。次はドーンマンポートにも行く予定ですわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470124
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470124,
					"content": "私と先輩は、コンパスや装置の調整を手伝うために雇われているの。昨夜は耐圧試験のために、一晩中雲来の海を漂ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470125
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470125,
					"content": "それって違法残業じゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470126
					]
				},
				{
					"id": 401470126,
					"content": "ざ…残業手当は出しますわよ！お二人ともご自分の意志で来られてますし、契約時にだってわざわざ説明していますもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470127
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470127,
					"content": "本当に隙がないな…つまりその手当の一つが「奢り」ってわけか？だからやってくるなり高いご飯を注文したのかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401470128,
					"content": "ふふん、「何でも注文していいんですのよ！」——なんて機会はなかなかないからのう。それではまず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470129
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470129,
					"content": "コホン！ファルザン…先輩…私ももちろん、一番高い料理で労いたいと思っていますわ。ですが、高いからといって美味しいとは限りませんの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470130
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470130,
					"content": "璃月料理で一番高いのは、海鮮をたくさん使う料理か、手間暇がかかる料理だと聞いたことがありますわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470131
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470131,
					"content": "でも私たちは何日も海の上で揺られていたのですから、このうえ魚やらエビやらを食べても美味しく味わえないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470132
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470132,
					"content": "むむ…言われてみれば、確かにそうじゃのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470133
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470133,
					"content": "——しかもレイラさんなんて、お腹がすいて今にも気絶しそうになっていますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470134
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470134,
					"content": "え？それはお腹がすいているからじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470135
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 401470135,
					"content": "きっと、人生の大先輩で徳の高いファルザン先輩は、後輩を空腹のまま待たせるのは忍びないと思われることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470136
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401470136,
					"content": "うむ、後輩を気にかけてやれというのに文句はないんじゃが…なにやら騙されている気がするの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470137
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 401470137,
					"content": "ですので、時間をかけて煮込む必要がある料理も出さないでくださいまし！それ以外では高いものでしたら何でも結構ですので。旅人にお任せいたしますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				}
			]
		},
		{
			"id": 4014702,
