					"nextDialogs": [
						401479709
					]
				},
				{
					"id": 401479709,
					"content": "だ…だからこそ…オイラはたくさんの経験をして学んだんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
