				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "キャラバン宿駅はスメールへ往来する重要な関所に当たり、特別にこの告知板が設置されています。各種事務事項が掲示されていますので、貿易商の皆さんはよくご確認ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "「愛しい人よ、二人の距離は遠く離れていても、私の心はずっとあなたのものだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180202,
					"content": "「分かってる、あなたにはやるべき大事なことがあるって。地位が高くなるほどそうなるんだと。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180203,
					"content": "「でも、私はこの悩みを誰にも言えない。あなたの名前すら口に出せない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180204,
					"content": "「いつの日か、あなたにどれほどの知識があって、どれほど賢いか、包み隠さずみんなに言える日が来るのを心から願ってる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321803",
							"2"
						],
						"stepId": 7321803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "ここから先、大赤砂海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180302,
					"content": "死を恐れる者はここに留まるべし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "教令院は防砂壁を破壊するあらゆる行為を固く禁ずる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180402,
					"content": "これが発覚した場合、厳罰に処す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "「砂漠の特産品、各種果物の砂糖漬け、デザートの材料を取り扱っています。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180502,
					"content": "「大量注文の際は、専用配送サービスをご提供いたします。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180503,
					"content": "「これはいい、団子に使えそうだ。稲妻まで送ってもらえるか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180504,
					"content": "「申し訳ございません、国外では現在璃月のみ配送が可能です。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "「金砂の旅」はキャラバン宿駅唯一の宿屋です。広告を出す必要はないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180602,
					"content": "ですが、本場砂漠の職人が焼き上げた私共のローストミートは、町のものより本格的な自慢の一品です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180603,
					"content": "旅でお疲れの際はぜひお立ち寄りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "「キャラバン宿駅の通行制限を厳しくすることを教令官にご一考願いたい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180702,
					"content": "「現在は砂漠の民というだけで簡単に通行できるため、それを悪用して多くの盗賊が森に逃げ込んだだけでなく、私たちスメール人の仕事を奪っている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180703,
					"content": "「現在はまだ砂漠の民にアーカーシャの権限が解放されていないとはいえ、レグザー庁が彼らに出す依頼はすでに傭兵だけに留まらない。このままでは、たとえ教令院を出ても職に就けない人間が出てくるだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180704,
					"content": "「何を言っている。砂漠の民も元々はマハールッカデヴァータの民であり、彼らもスメール人だ。彼らを町に入れるのは当然だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180705,
					"content": "「ここでそんな発言をすると叩かれるぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "キャラバン宿駅に長期滞在する学者は、知識漏洩などの不測の事態を防ぐため、チェックイン前に教令官舎にて登録を行うこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "往来の貿易商は、入国前に必ず教令官舎において登録を行い、審査を受けること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180902,
					"content": "未登録の商品、または輸出入禁止の禁制品の携帯が認められた場合、これをすべて没収とし、随行員も規定に従い砂漠に追放される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732180903,
					"content": "また、アアル村の住民は、教令院が発行した通行許可書を携帯していればそのまま関所を通過できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
