			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "「砂漠の向こうにあるという病院、過去に教令院が建てた魔鱗病の治療に特化した病院だったようだが、後に理由不明のまま放棄されたらしい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732181102,
					"content": "「アアル村の人によると、以前そこで治療を受けていた魔鱗病患者が逃げ出してきたそうだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732181103,
					"content": "「そこに何か資料が残っていれば、この病を治す方法が見つかるかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
