			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "「砂漠の冒険パック販売開始！貿易商の皆さまに、至れり尽くせりの砂漠の冒険の解決策をご提供します。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 732181002,
					"content": "「ご購入いただければ、お客様の冒険は成功間違いなし。もし効果にご納得いただけない場合は返金対応いたします。ただいま割引中！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
