			"dialogs": [
				{
					"id": 102030101,
					"content": "はぁ…クレーは、実は西風騎士団の「火花騎士」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 102030102,
					"content": "えっ？クレーみたいなのも騎士なのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102030103,
					"content": "じゃあ、パイモンにも騎士の称号を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "だな！悔しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102030106,
					"content": "でもまあ、「火花騎士」って名前の称号なら、クレーの宝物が爆弾なのも頷けるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102030107,
					"content": "ああ、トラブルメーカーな一面もあるが、騎士団のみんなはクレーのことが好きなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 102030108,
					"content": "それとクレーの生い立ちについてだが、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 102030109,
					"content": "まあ、それは後々わかってくるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 102030110,
					"content": "#その時はよろしく頼むよ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 102030104,
					"content": "しかも「栄誉騎士」より強そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
