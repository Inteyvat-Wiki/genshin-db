					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102030203,
					"content": "「冒険者協会」には冒険の心得があるって聞いたけど、お願いしてみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
