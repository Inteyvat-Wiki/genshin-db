				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "ふぅ…はぁ…大変だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350202,
					"content": "すまない、恥ずかしいところを見せてしまったな。いざ敵に立ち向かう時になって、まさかこんなに緊張してしまうとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350203,
					"content": "とにかく…私にはまだまだ鍛錬が必要だ。旅人、どうもありがとう。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350204,
					"content": "本当に璃月を出るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "それはまだ決めていない…もう少し、考える必要がある。それにもう一度小鳥を説得してみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		}
	]
}