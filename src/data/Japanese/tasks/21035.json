			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "はぁ、小鳥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350102,
					"content": "孫宇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "旅人？奇遇だな、まさかこんなところで会えるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350105,
					"content": "私は…ここで鍛錬をしている。少し経ったら璃月を出て、外を旅するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350106,
					"content": "どうして急に璃月を出るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "コホン…恥ずかしい話だが、確かに私は古華派を復興するといつも言っているが、普段していることといえば…仙人を訪ねると言って、その実は絶雲の間をぶらついているに過ぎないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350109,
					"content": "小鳥がいつもそばにいてくれることには感謝している。だが、私のしていることが、古華派を復興するのに何の役にも立たないことも分かっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350110,
					"content": "この間、買い物に街に行った時、あるフォンテーヌから来た商人と話をしたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350111,
					"content": "彼に「解決策を、問題が生じた場所で見出すことはできない」と言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350112,
					"content": "私は長い間考えたが…もしかしたら、このフォンテーヌの商人は、璃月以外のところに旅に出ようと提案してくれたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350113,
					"content": "外を見に行くのもいいことだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "私もそう思っているが…小鳥はどうしても璃月を離れたくないようなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350116,
					"content": "普段の小鳥は拗ねているように見えて、あれが本気でないことは分かっている。ただ彼女をなだめて、機嫌を直してやればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350117,
					"content": "でも今回、小鳥は本当に怒っているようだ。どうしても私の言うことを聞かず、一人で街まで行ってしまった。はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350118,
					"content": "その話はやめよう、こんなくだらない話、君も聞きたくはないだろう…旅人、一つお願いしてもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350119,
					"content": "身を守るための武術に多少の心得はあるが、普段は本気でやりあったことがあまりないんだ。これからは旅に出るんだから、実戦は避けられないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350120,
					"content": "旅人、君の外での冒険談をたくさん聞いたよ。君なら、魔物に対応する方法はたくさん知っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350121,
					"content": "練習相手となる魔物を探しに行くのに付き合ってくれないか？ついでに、指導もお願いできるとありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350122,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "そうだな…ちょうどこの近くに魔物の集落が一つある。まずはそこに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350123,
					"content": "#{M#俺}{F#私}の動きを目で追うので精一杯かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "おっと…君、そんなに腕が立つのか？ハハハ、それなら少しゆっくり動いてもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210350114,
					"content": "気晴らしだと思えばいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "古華派を復興するんじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
			"completionStepIds": [
				2103503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103503",
							"2"
						],
						"stepId": 2103503,
						"stateName": "QUEST_STATE_UNFINISHED"
