			},
			"dialogs": [
				{
					"id": 150151101,
					"content": "あっ、来てくれたんだ？ちょうど全部片付いて、今から休もうとしてたとこだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151102,
						150151107,
						150151112,
						150151116
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151102,
					"content": "ラゾーリについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151103
					]
				},
				{
					"id": 150151103,
					"content": "おばちゃんの処罰については、まだ検討中だってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151104
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151104,
					"content": "古名の技術を使った犯罪なんて、参考にできる事例が限られてるからね…パカルはしばらく頭を抱えることになるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151105
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151105,
					"content": "工房のほうは部族の人が見に行ったよ。数日したら完全に閉鎖されて、作りかけの「燃晶名刻」も処分されるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151106
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151106,
					"content": "おばちゃんの「古名」に問題が生じなかったのは不幸中の幸いだよ。じゃなきゃ、今頃ヤバイことになってただろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151107,
					"content": "「燃晶名刻」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151108
					]
				},
				{
					"id": 150151108,
					"content": "それについてはいいニュースもあんだ。「燃晶名刻」に取り込まれた記憶は元に戻せるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151109
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151109,
					"content": "「燃晶名刻」の機能が停止したら、記憶は元の道を辿って持ち主のところに戻るみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151110
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151110,
					"content": "おばちゃんはニエガを取り戻そうとして、みんなにその存在を忘れさせたんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151111
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151111,
					"content": "けど本当にいなくなった今、こうして思い出せるようになるなんて…ほんと、めちゃくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151112,
					"content": "ニペカについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151113
					]
				},
				{
					"id": 150151113,
					"content": "ニペカなら、ウチの工房で手伝ってるよ。部族の人にも相談して、出自を調べてもらってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151114
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151114,
					"content": "その結果が出るまで時間が掛かるだろうし、しばらくはあの子の世話をしながら、鍛造の技術を教えることにしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151115
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151115,
					"content": "ニペカは学習スピードこそ早くないけど…学ぶ姿勢はなかなか悪くないんだ。もうちょっと成長したら、名鋳り師になれるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150151116,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151117
					]
				},
				{
					"id": 150151117,
					"content": "うん、また。進捗があったら教えるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				}
			]
		},
