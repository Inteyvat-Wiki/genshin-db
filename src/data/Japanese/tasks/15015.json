			"dialogs": [
				{
					"id": 150151201,
					"content": "こんにちは！ようこそ…あの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151202,
						150151210
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151202,
					"content": "最近はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151203
					]
				},
				{
					"id": 150151203,
					"content": "#パイモンお姉ちゃん、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}！こ…ここはすごく楽しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151204
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151204,
					"content": "毎日色んなことを勉強できるし、美味しいものも食べられる…鍛造するときは火が飛んできて手を火傷しそうになるけど、わたしは平気。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151205
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151205,
					"content": "シロネンお姉ちゃんが、わたしの出自を調べてくれてるって言ってた。まだ分かってないけど…でもわたし、シロネンお姉ちゃんを信じてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151206
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151206,
					"content": "最近は、その日にやった面白いことを日記につけててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151207
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151207,
					"content": "夢でニエガお姉ちゃんに会ったら、全部お話しするつもりなの。きっと喜んでくれると思うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151208
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151208,
					"content": "それから、お姉ちゃんにこう伝えるんだ。今は一生懸命がんばって勉強してて、ちゃんとご飯を食べて大きくなるから、心配しないでって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150151209
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151209,
					"content": "はぁ…けど、もうずっとニエガお姉ちゃんの夢を見てないんだ。お姉ちゃん…本当にもう行っちゃったのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150151210,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150151211
					]
				},
				{
					"id": 150151211,
