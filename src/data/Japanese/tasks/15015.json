						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150150701,
					"content": "こうもすぐ追い付かれるなんて…ずいぶん足が速いのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150702
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150702,
					"content": "上を見ろ！ニエガがいるぞ！あいつ、なにするつもりだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150703,
					"content": "私は嘘なんかついていないわ。最初から最後まで、ただ娘のニエガを救いたいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150704
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150704,
					"content": "今はまだ私の子じゃないけど…すべてが終わったら、この子は本物のニエガになるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150705
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150705,
					"content": "今はって？一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150706,
						150150707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150706,
					"content": "記憶を植えこむ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				},
				{
					"id": 150150708,
					"content": "もう理解したようね？そう、私がやろうとしているのは、「記憶」を利用してニエガを甦らせること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150709
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150709,
					"content": "あの子は夜神の国に長くいすぎた…暗いのも、寒いのも苦手なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150710
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150710,
					"content": "ニエガを一人にしたのは私よ。だから、必ず連れ戻さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150711
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150711,
					"content": "怖がらないで、ニエガ。お母さんは何も忘れてなんかいない。あなたの名前を今も覚えているわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150712,
						150150713
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150712,
					"content": "「夜神の国」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150714,
					"content": "…おそらく、あんたが考えてる通りだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150715
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150715,
					"content": "じゃ…じゃあ、上で横になってるのは誰なんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150716,
					"content": "同じ集落の子よ。この子の両親は以前のアビスの侵攻で命を落としたの…でも偶然、この子の誕生日は私のニエガと同じだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150717
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150717,
					"content": "この子を引き取って、ずっと面倒を見てきた。そうすれば…少しは楽になると思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150718
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150718,
					"content": "初めてお母さんと呼んでくれたとき、すごく嬉しかったわ。けど、急に怖くなったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150719
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150719,
					"content": "この子は本当に私の子？…私の子の名前はニエガ。ニエガ以外にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150720
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150720,
					"content": "どうして嬉しいと思ったのかしら？…私のニエガは、まだお母さんを待っているのに…私が連れ戻してくれるのを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150721
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150721,
					"content": "言ったはずよ——ニエガを連れ戻すためなら、私はすべてを捧げても構わないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150722
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150722,
					"content": "今こそ、すべてを捧げる時なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150723
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150723,
					"content": "私が持っている、この役立たずの「古名」にも…そろそろ役に立ってもらわないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150724
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150724,
					"content": "力を貸してくれないのなら、ニエガの「古名」のために燃料となりなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150725
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150725,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150726
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150726,
					"content": "シロネン。まだ動かないのは、周りの銘刻図を観察しているからね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150727
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150727,
					"content": "無駄よ。「燃晶名刻」はすべて配置した。銘刻図もとっくに機能し始めているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150728
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150728,
					"content": "あなたがアイデアをくれたおかげよ。この「中枢名刻」は、ニエガの本当の「古名」になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150729
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150729,
					"content": "ニエガが帰ってきたら、誕生日会に招待してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150730,
						150150731
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150730,
					"content": "#その子を放{M#せ}{F#して}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150732,
					"content": "おい…まさか強行突破するつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150733,
						150150734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150733,
					"content": "ニエガはもういない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150735,
					"content": "…この銘刻図には穴がある。もうすぐボロが出るから、ウチの合図に合わせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150736
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150736,
					"content": "ニエガ…大丈夫、心配しないで…お母さんがいるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150737
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150737,
					"content": "３——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150738
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150738,
					"content": "ずっと傍にいるわ。決してあなたを忘れたりしない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150739
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150739,
					"content": "2——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150740
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150740,
					"content": "さあ、ニエガ…早く目を覚まして。お願いだから、早く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150741
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150741,
					"content": "1！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150734,
					"content": "罪のない子供を傷つけさせない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150735
					]
				},
				{
					"id": 150150731,
					"content": "#パイモン、{M#俺}{F#私}の後ろに隠れて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150732
					]
				},
				{
					"id": 150150713,
					"content": "もしかして…ニエガはもう亡くなってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150714
					]
				},
				{
					"id": 150150707,
					"content": "過去を忘れる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150708
					]
				}
			]
		},
		{
			"id": 1501509,
			"completionStepIds": [
				1501509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1501509",
							"2"
						],
						"stepId": 1501509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シロネン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1542.261,
							162.018,
							7891.087
						],
						"pointId": 350400220
					},
					{
						"sceneId": 3,
						"position": [
							-1539.939,
							162.305,
							7889.229
						],
						"pointId": 350400221
					}
				]
			},
			"dialogs": [
				{
					"id": 150150901,
					"content": "——これでよしっと。おばちゃんはカギをかけた部屋の中でぐるぐる巻きにしといたよ。あとで集落に連れてって、ちゃんと罰を受けさせないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150902
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150902,
					"content": "今は…ここで日向ぼっこでもしよっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150903
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150903,
					"content": "あんだけ大暴れしたし、もぉヘトヘト…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150904
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150904,
					"content": "一気に全部を終わらせちゃうなんて、シロネンってホントに仕事が早いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150905,
					"content": "にしても…いま思い返すと恐ろしいよな。自分の養子をニエガに変えようとするなんて。しかも、あと少しで成功しちゃいそうだったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150906,
						150150907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150906,
					"content": "気づけて良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150908
					]
				},
				{
					"id": 150150908,
					"content": "そうだな。カウントダウンするシロネン、すっごくカッコよかったぞ！一瞬で距離を縮めて、一気にかたを付けるんだもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150909,
					"content": "ニペカがめげなかったおかげだよ。この子が勇敢に何度も助けを求めてくれてなかったら、そう簡単におばちゃんの計画には気づけなかっただろーし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150910,
						150150911
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150910,
					"content": "ニペカは勇敢な子だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150912
					]
				},
				{
					"id": 150150912,
					"content": "#ううん、シロネンお姉ちゃんとパイモンお姉ちゃん、そして旅人の{M#お兄ちゃん}{F#お姉ちゃん}が勇気づけてくれたおかげだよ。それに、あれはわたしが思いつく最後の方法だったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150913
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150913,
					"content": "これまでにも何度か試したの。でも家によく来てくれたおじさんやおばさんたちは、ラゾーリさんの言葉を鵜呑みにして来なくなるか、わたしを信じてくれないかでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150914
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150914,
					"content": "それに何を話しても、病気のせいだってラゾーリさんに丸め込まれちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150915
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150915,
					"content": "…あの人が涙を流せば、みんな慰めるばかりで、誰もわたしの話を聞いてくれなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150916
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150916,
					"content": "わたしが送る手紙も、受け取ったプレゼントも、全部ラゾーリさんに確認されてね。す…少しでも言うことを聞かなかったら、変なお薬を飲まされちゃうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150917
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150917,
					"content": "それを飲むと、何日も眠っちゃうし、記憶力もすごく悪くなっちゃうの。寝ている間は…いろんなものが見えて、周りの壁も四六時中喋るようになって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150918
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150918,
					"content": "毎日が怖かった…今回も失敗したら、わたし本当に諦めてたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150919
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150919,
					"content": "もう全部終わったから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150920
					]
				},
				{
					"id": 150150920,
					"content": "オイラたちが傍にいるから安心しろ、ニペカ。これ以上、おまえを傷つけようとするやつがいたら、旅人とシロネンがすぐぶっとばしてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150921,
					"content": "う…うん。ごめん…ぐすっ、我慢…できなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150922
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150922,
					"content": "おまえは十分勇敢だったぞ。しかも助けを求めた相手がシロネンなのは、へへっ、大当たりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150923,
					"content": "シロネンは涙で誤魔化されるようなやつじゃないからな。こいつは人の話をしっかり聞くし、どんな些細な点も見逃さないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150924,
					"content": "そんな「些細な点」を聞けたのも、あんたたちのおかげ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150925
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150925,
					"content": "二人がいなかったら、ニペカも助けを求めるメッセージを送れなかったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150926
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150926,
					"content": "もしウチが声をかけに行ってたら、きっとラゾーリおばちゃんは警戒して、この子をまた部屋に閉じ込めてただろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150927
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150927,
					"content": "へへっ、じゃあオイラたちってば、けっこう重要な役目を果たしたってことか！でも、あいつも大胆だよな？集落の人だって、本物のニエガの顔くらい見たことあったはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150928,
					"content": "別人って、気づかれるのが怖くなかったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150929
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150929,
					"content": "燃晶名刻をかなり前から使ってたのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150930
					]
				},
				{
					"id": 150150930,
					"content": "その可能性はあるね。ラゾーリおばちゃんが作った「燃晶名刻」は、みんなからニエガの過去を集めるだけじゃなく、その記憶を消すこともできるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150931
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150931,
					"content": "ラクガキでたとえるなら——まんべんなく絵の描かれた壁に新しいものを描くには、まず古いものを消さないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150932
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150932,
					"content": "もしかしたら、ウチもおばちゃんのターゲットの一人だったのかも。だから、「中枢名刻」をあっさりウチに渡したんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150933
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150933,
					"content": "ひっ！それを知った上で受け取ったのかよ？オイラだったら、きっと遠くに投げ捨ててるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150934
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150934,
					"content": "まっ、リスクを冒さなきゃ、真実だって手に入らないっしょ？それに、この手で「中枢名刻」をバラしてなかったら、本当の狙いに気づくこともできなかっただろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150935
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150935,
					"content": "つまり、おまえは最初からあいつを疑ってたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150936
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150936,
					"content": "ぜんぜん。だって、親戚のおばちゃんだよ？最初から悪者扱いだなんてあり得ないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150937
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150937,
					"content": "せいぜい…その可能性と対策を頭の片隅に置いてたくらい。結局、最悪の結末になっちゃったけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150938
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150938,
					"content": "でも、苦しんでた子供を助けられたし、結果オーライってとこかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150939
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150939,
					"content": "さぁて、祝勝会の「健闘をたたえ合うコーナー」は終了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150940
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150940,
					"content": "全部片付いたし、ニペカはもう安全なはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150941
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150941,
					"content": "シロネンお姉ちゃん…わたし、これから何をしたらいいんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150942
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150942,
					"content": "もちろん、好きなことをやっていいんだぜ。もうおまえを部屋に閉じ込めようとするやつはいないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150943
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150943,
					"content": "でも、わたし…何ができるか分からないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150944
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150944,
					"content": "わたしが知ってることは、どれもニエガお姉ちゃんと同じだから。好きな料理や花、喋り方、普段の振る舞い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150945
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150945,
					"content": "ニエガお姉ちゃんじゃないのに…お姉ちゃんじゃないといけなかった。分からないよ…シロネンお姉ちゃん、わたしどうしたらいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150946
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150946,
					"content": "安心して、ニペカ。「燃晶名刻」はもう機能してない。別人になることを強要する人はいなくなったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150947
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150947,
					"content": "けど、自分の名前以外、何も覚えてないの。もしかして、このまま何も思い出せずに、過去を全部捨てることになるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150948
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150948,
					"content": "シロネンお姉ちゃん…怖いよ…ぐすっ…どうしたらいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150949
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150949,
					"content": "泣かないで、ニペカ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150950
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150950,
					"content": "ほら、これをあげる。ラゾーリおばちゃんが保管してた鉱石をちょっと拝借して、作ってみたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150951
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150951,
					"content": "「燃晶名刻」じゃないか！シロネン、おまえも作れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150952
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150952,
					"content": "いんや、別ものだよ、これは。ただの綺麗な石ころ。見て、「ニペカ」って名前が刻まれてるっしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150953
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150953,
					"content": "これはあんたが最初に貰った「祝福」。あんたを愛する二人からの心のこもったプレゼント。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150954
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150954,
					"content": "これがニペカを守って、ずっと傍にいてくれる。過去も未来も現在も、あんたから離れることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150955
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150955,
					"content": "…でも、お父さんとお母さんの名前すら覚えてないんだよ…わたし…何も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150956
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150956,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150957
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150957,
					"content": "何もかも元通りになる、だなんて大口は叩かないよ…あんたを待ってる未来がどんなものなのか、ウチにも分かんないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150958
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150958,
					"content": "けど一つ言えることは、この先どんなことがあっても、その「名前」だけは消えたりしないってこと。これは、一人の「名鋳り師」からあんたに贈る祝福だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150959
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150959,
					"content": "ニペカ、あんたはこれからゆっくり成長してく。苗木がすくすくと伸び、鳥が空をいつも羽ばたくようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150960
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150960,
					"content": "「ニペカ」って名前はあんたの原点であり、あんたの成長を導く道しるべでもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150961
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150961,
					"content": "自分の名前、そして経験したすべてを胸に刻むの。そうすればきっと、未来に向かってどう進めばいいか分かるはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150962
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150962,
					"content": "うん…頑張ってみる…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150963
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150963,
					"content": "その意気だぜ！ニペカ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150964
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150964,
					"content": "#{M#俺}{F#私}たちがいつも応援してるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150965
					]
				},
				{
					"id": 150150965,
					"content": "#ありがとう。シロネンお姉ちゃん、パイモンお姉ちゃん、旅人{M#お兄ちゃん}{F#お姉ちゃん}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150966
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150966,
					"content": "まぁ、どうしてもやりたいことが思いつかなくてもだいじょーぶだよ。気楽にやるのが一番だからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150967
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150967,
					"content": "同じ集落の人間なんだし、そんときはあんたのことを知ってる年寄りを捜して、出自を調べたげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150968
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150968,
					"content": "結果が出るまで、ウチの工房にいていいよ。茶碗が一つ増えたところでなんてことないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150969,
						150150970
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150969,
					"content": "予備のプランまで用意してたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150971
					]
				},
				{
					"id": 150150971,
					"content": "ま、上手くいくか分からないし、誰に聞けばいいかの見当もついてないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150972
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150972,
					"content": "そういう運任せの方法をアテにするなら、まずは自分の力で地道に頑張ってみてからのほうがいいっしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150973
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150973,
					"content": "まあ、そう深く考えないでやってこ。じゃ、ウチはラゾーリおばちゃんを集落に連れてくね。ニペカも一緒に来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150974
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150974,
					"content": "あっ…そういえば晩メシがまだだったや。好きな食べ物とかある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150975
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150975,
					"content": "えっ？わたし？好き嫌いは特にないから、何でも大丈夫だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150976
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150976,
					"content": "オッケー。んじゃ行こっか。やることが山ほど残ってるし、しばらく休めそうにないね、こりゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150977
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150977,
					"content": "あっ、そうそう…ひとつ言い忘れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150978
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150978,
					"content": "誕生日おめでと、ニペカ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150970,
					"content": "本当に調べられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150971
					]
				},
				{
					"id": 150150911,
					"content": "ニペカは賢い子だね。",
