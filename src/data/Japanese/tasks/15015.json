					}
				]
			},
			"dialogs": [
				{
					"id": 150150101,
					"content": "ニエガがいたわ。私と会話もしたのに、どこへ行ったの…ねえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150102
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150102,
					"content": "ニエガ！ニエガ！どこにいるの！聞こえたら返事してちょうだい！お願い…お願いだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150103
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150103,
					"content": "シロネン…！あなたも見たでしょう？私のニエガを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150104
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150104,
					"content": "この手で触れて、抱きしめることもできた…方法は間違ってなかったのよ…ええ、そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150105
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150105,
					"content": "あの灰色の影も、何か些細な誤差にすぎないはず…もう一度やれば、そう、もう一度やればニエガはきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150106
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150106,
					"content": "…おばちゃん、まだ気づいてないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150107
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150107,
					"content": "気づく…？何に？何も間違ってなんかいないわ、何も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150108
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150108,
					"content": "あの子は私のことを怒っていて、無視しているだけよ…あの子は昔からわがままだったから。ええ…それくらい仕方ないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150109
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150109,
					"content": "おばちゃん！いい加減にして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150110
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150110,
					"content": "「燃晶名刻」で呼び出したのは、本物のニエガじゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150111
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150111,
					"content": "おばちゃんはみんなからニエガに関する「思い出」をたくさん集めたけど、ひとつ忘れてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150112,
					"content": "集めた記憶の中には、本物の「思い出」以外にも、無数の「感情」が混じってるってことに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150113
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150113,
					"content": "気づかなかった？みんなが重病のニエガのお見舞いに来たとき、どんな「感情」を抱いてたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150114
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150114,
					"content": "死に瀕した子供の手を握りながら、ニエガの弱々しい呼吸、絶望に満ちた目…そして、徐々に下がっていく体温を見た人々は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150115
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150115,
					"content": "悲しみと痛み以外に、何を感じると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150116
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150116,
					"content": "私は…そういった感情まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150117
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150117,
					"content": "その「感情」はすべて、あんたの手によって「燃晶名刻」に取り込まれ、実在する「過去」となったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150118
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150118,
					"content": "さっき灰色の人影がいくつか現れたでしょ？あれは「過去」を「写した姿」。彼女たちはニエガの最期を繰り返すことしかできない存在なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150119
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150119,
					"content": "逆に本物のニエガが伝えようとした言葉は、どれも歪んだ悲しみによって上書きされてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150120
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150120,
					"content": "そ…そんなつもりなかったの…私はただ、ニエガのことを記憶に刻んで…あの子にもう一度会おうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150121
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150121,
					"content": "…ニエガは、ずっとおばちゃんの傍にいたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150122
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150122,
					"content": "おばちゃんに「役に立たない」って言われた「古名」は、ずっと前からすべてを記録してた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150123
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150123,
					"content": "あらゆる手を尽くし、何もかもを投げ出してまで娘を救おうとしたのは…まぎれもない事実。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150124
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150124,
					"content": "自分の「古名」の意味を忘れたわけじゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150125
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150125,
					"content": "私の「古名」は…「ウンド{RUBY#[S]家族愛}ゥグ」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150126
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150126,
					"content": "その「古名」は、あんたとニエガの間にある揺るぎない家族愛を刻み続けていた。それなのに、あんたはそれを見て見ぬふりしてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150127
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150127,
					"content": "「名前とは、過去から未来への祝福。」——これ、おばちゃんが教えてくれた言葉だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150128
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150128,
					"content": "ニエガに名前を付けて、最初の祝福を贈ったのはおばちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150129
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150129,
					"content": "けど今、その人は自分の手でニエガの名を檻に変え、罪のない子供を…そして自分をも閉じ込めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150130
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150130,
					"content": "…ニエガは私のすべてよ。あの子がいない未来なんて、考えられないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150131
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150131,
					"content": "祝福は…ふふっ…ニエガがいなくなってからは、一度も感じられなくなった。私の手を握りながら、痛いから抱きしめてとお願いする、あの子の夢ばかり見るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150132
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150132,
					"content": "けどね、何も見えない…ニエガを抱きしめられないのよ。目が覚めるまでずっと、ただ名前を呼び続けるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150133
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150133,
					"content": "毎日毎日…自分のことを憎み、「古名」のことを憎んだわ。あの子も…もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150134
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150134,
					"content": "ニエガも、自分のことを憎んでるって思うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150135
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150136
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150136,
					"content": "おばちゃん。ニエガが最期に残した言葉、本当の遺言を…覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150137
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150137,
					"content": "そ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150138
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150150138,
					"content": "「祝福」を感じられないのは、本物の「過去」を忘れたからだよ。…おばちゃんはただ、自分が想像した記憶に浸かって、現実逃避してるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150139
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150139,
					"content": "「過去」を失くした「名前」は、根のない枯れ木に過ぎない。朽ちる以外に、未来はないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150140
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150140,
					"content": "これでおしまい。おばちゃん、これでぜんぶ終わりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150141
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150141,
					"content": "おい、ゆっくりで大丈夫だぞ！なんなら横になったほうがいいんじゃないか？あっ…ええと、ここで横になるのはよくないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150142,
					"content": "シロネン！ニエガ…ニペカはもう立てるみたいだ。すぐそっちに行くから待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150143,
						150150144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150143,
					"content": "支えようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				},
				{
					"id": 150150145,
					"content": "#ありがとう。パイモンお姉ちゃん、旅人{M#お兄ちゃん}{F#お姉ちゃん}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150146
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150146,
					"content": "わたしなら平気だよ。ニエガお姉ちゃんが助けてくれたおかげで、もうそんなに苦しくなくなったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150147
					],
					"speakerTitle": "ニエガ"
				},
				{
					"id": 150150147,
					"content": "ふぃー、よかった。もし本当にニエガになっちゃったら、この物語も『勇敢なテクィ』と同じになっちゃうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150148
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150148,
					"content": "ここでおしゃべりするのもあれだし、場所を変えよっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150149
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150149,
					"content": "えっと…ラゾーリはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150150150,
					"content": "安心して。おばちゃんはもう危険な真似なんてしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150150151
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150150151,
					"content": "すべてが終わって工房を後にすると、シロネンにニペカの相手を頼まれた。彼女はまだ、ラゾーリと話すことがあるらしい…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150150144,
					"content": "おんぶしようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150150145
					]
				}
			]
		},
