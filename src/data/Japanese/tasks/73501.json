			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラーズィー",
					"タンジェ",
					"コレイ",
					"マムド",
					"ファイズ",
					"キャシト",
					"アーリヤ",
					"ルシ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "過ちを犯したアランナラの父は自ら過ちを認め、アランナラの息子から許された、か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "ラーズィー"
				},
				{
					"id": 735010202,
					"content": "うーん、子供たちはこの物語を気に入ってくれると思うけど、アランナラの父が自ら過ちを認める理由が甘すぎるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "ラーズィー"
				},
				{
					"id": 735010203,
					"content": "物語に、アランナラの親子が一緒に苦難を乗り越える話を追加するのはどうだい？そうすればお互いに理解し合えるし、アランナラの父親だって息子が苦労している姿を見れば苛まれるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "タンジェ"
				},
				{
					"id": 735010204,
					"content": "それじゃあ、アランナラの父が苦しんでるとき、話すスピードは速いほうがいいかな、それとも遅いほうがいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "ラーズィー"
				},
				{
					"id": 735010205,
					"content": "それはアランナラの息子によるかな。話すスピードが違うと面白いかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "タンジェ"
				},
				{
					"id": 735010206,
					"content": "おーい、タンジェさんにラーズィー！なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010207,
					"content": "父と一緒に、新しい童話の内容について話し合ってるんです。今後は僕から、童話を皆に語ることになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "ラーズィー"
				},
				{
					"id": 735010208,
					"content": "でも、多くの人の前で自分の物語を語ると思うと、やっぱり緊張しちゃって。だから、どういうところに気を配ったほうがいいかを聞いているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "ラーズィー"
				},
				{
					"id": 735010209,
					"content": "おお！スメールに、若い童話作家がまた一人増えそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010210,
					"content": "君たちに感謝するよ。君たちが現れなかったら、ラーズィーは本当に私を置いて行ってしまっていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "タンジェ"
				},
				{
					"id": 735010211,
					"content": "ほんとによかったぜ、うまく解決したみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010212,
					"content": "でも…一つだけ、不審な点があるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010213,
					"content": "ん？どうした？あたしが手伝ってやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010214,
					"content": "アビディアの森にあったあの木のうろには、なんでモンド人が残した紙切れがあったんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010215,
					"content": "な…何で未だにそんなこと気にしてるんだよっ。単なる偶然だろ、偶然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010216,
					"content": "秘密を紙切れに書いて木のうろに置くのなんてよくある習慣だよ。気にすることなんて何もないと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010217,
					"content": "コレイ、急にテンションが。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "うぅ…ううう…わかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010220,
					"content": "実は…あたしも秘密や悩みを抱えてるんだ。それに、秘密を木のうろに話す習慣があって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010221,
					"content": "でも、今のラーズィーとタンジェさんを見て、あることを思いついたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}、あたしの木のうろになってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010223,
					"content": "喜んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "本当によくあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
