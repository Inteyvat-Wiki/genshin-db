						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャシト",
					"アーリヤ",
					"マムド",
					"ファイズ",
					"ルシ",
					"コレイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "うぅ…今日もまたこれか…あの一番ぷくぷくしてて、プルプルそうなやつがほしかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "キャシト"
				},
				{
					"id": 735010102,
					"content": "はぁ、お小遣いをもっと貯めよっと。絶対すべてを集めるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "キャシト"
				},
				{
					"id": 735010103,
					"content": "あれ…毎日買いに来てるわよね？まだコンプリートしてないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "アーリヤ"
				},
				{
					"id": 735010104,
					"content": "あのアランナラ木彫りセットを買えば？1セットで7種類が入ってるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "アーリヤ"
				},
				{
					"id": 735010105,
					"content": "それじゃ、サプライズに欠けるじゃんかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "キャシト"
				},
				{
					"id": 735010106,
					"content": "あたしはサプライズなんていらないわ。全種類を集められればいいんだもん。これこそ、真の心がけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "アーリヤ"
				},
				{
					"id": 735010107,
					"content": "今日はモラを貯めて、はるばる木彫りセットを買いに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "アーリヤ"
				},
				{
					"id": 735010108,
					"content": "あっ、すみません、先ほどキャシトさんにお売りしたのが最後なんです。本日の商品はもう売れ切れてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "マムド"
				},
				{
					"id": 735010128,
					"content": "新しい職人を募集しているところですので、また明日いらしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "マムド"
				},
				{
					"id": 735010109,
					"content": "わかったわ…それじゃ、また明日来る。待ってちょうだい、アランナラ木彫りを商品だなんて呼んじゃダメでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "アーリヤ"
				},
				{
					"id": 735010110,
					"content": "そうだそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "キャシト"
				},
				{
					"id": 735010111,
					"content": "えっと、すみません…私が悪かったです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "マムド"
				},
				{
					"id": 735010112,
					"content": "すまないな、今日のアランナラ木彫りは売り切れちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010113,
					"content": "売り切れ？そんな…あと何個か買って、明日遊びに来るいとこにあげるつもりだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "ルシ"
				},
				{
					"id": 735010114,
					"content": "分かった、じゃあこうしよう。お前はラーズィーの家の近くに住んでるだろ？明日の朝、出来上がった木彫りをお前の家に届けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010115,
					"content": "ありがとう、ファイズのおじさん！忘れないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "ルシ"
				},
				{
					"id": 735010116,
					"content": "ああ、安心しろ。アジャンタ彫刻店は、絶対に子供たちの期待を裏切ったりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010117,
					"content": "おっと、またお客さんだ。すまないが、うちのアランナラ木彫りは今日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010118,
					"content": "ああ、お前たちだったのか。この度は助けてくれてありがとな。本当はきちんとしたお礼をしたいところなんだが、見ての通り最近は忙しくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010119,
					"content": "お前たちがいなけりゃきっと、アジャンタ彫刻店創業二十周年の日は全く違う景色が広がってたかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010120,
					"content": "商売繁盛みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "アランナラ、モテモテだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "全部ラーズィーのおかげだ。まだ若いのに、こんなすごい発想を持ってるとはなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010123,
					"content": "あっ、そうだ。感謝の意を表してな、「試作アランナラ」を記念としてお前たちにやることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "ファイズ"
				},
				{
					"id": 735010124,
					"content": "わ、何だこれ…その…すごく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010125,
					"content": "心が震えた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "そうそう！心が震えた。見た目は不思議な感じだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 735010127,
					"content": "うぅ、これを受け取るかどうかは、もうちょっと考えさせてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735010129,
					"content": "アジャンタ彫刻店のピンチは解決した。次はラーズィーとタンジェのもとを訪ねよう。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
			],
