					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "おや？場所が変わったようです。ただ、浜辺に戻ったわけではなさそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711402,
					"content": "ここって、モンドの家みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711403,
					"content": "ごきげんよう、いと尊き「断罪の皇后」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400711404,
					"content": "愛しいエミちゃん、ステーキと漁師トーストを作ったわよ。さあ、温かいうちに食べましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "フィッシュルの母"
				},
				{
					"id": 400711405,
					"content": "コホンッ！母上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400711406,
					"content": "あらら、私ったら、うっかりしてたわ。コホンッ！断罪の皇女よ、汝は気付いていたか？今は昼餉の時であることを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "フィッシュルの母"
				},
				{
					"id": 400711407,
					"content": "ええ、もちろんよ、母上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400711408,
					"content": "嗚呼——！窓からの眺めがなんと美しいことか。皇女に皇后よ、「断罪の皇帝」である余と共に、野掛けに興じようではないか。景色を愉しみ、天から賜りし美味を満喫しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "フィッシュルの父"
				},
				{
					"id": 400711409,
					"content": "ええ、喜んで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400711410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711412,
					"content": "えっと…その、みんな何か言いたいことはあるだろうけどさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "単刀直入に聞くけど、エミちゃんって…フィッシュルの本名か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711415,
					"content": "だろうな。それからさっき聞こえた二つの声は、フィッシュルのお父さんとお母さんだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711416,
					"content": "…どうして、私を見るんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711417,
					"content": "失礼かもしれぬが、その…メギストスとは、本当にお主の苗字でござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711418,
					"content": "まったく、私を馬鹿にしないでください。占星術師である私のフルネームは、アストローギスト·モナ·メギストスで間違いありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711419,
					"content": "…すまぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711420,
					"content": "長いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711421,
					"content": "この名を待つことができるのは、天才だけなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711422,
					"content": "どういう理屈だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711423,
					"content": "それより先ほどのあれ、どう思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711424,
					"content": "ひとつ確信したのは、「本を閉じる」ことも幻境に変化をもたらす一種の方法なのでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711425,
					"content": "でも、フィッシュルの家族まで彼女に付き合ってあげてるなんて、すごいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711426,
					"content": "いつもあの調子だったわけではないと思いますよ。あの声の感じからして、たぶん幼少期の思い出かと。大きくなってからも同じかどうかは分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711427,
					"content": "モナはよく知ってるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711428,
					"content": "友達なんだから、これぐらい当然のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711429,
					"content": "…フィッシュルは今、どこにいるんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711430,
					"content": "先ほどの話では出かけると言っていた。様子を見に行ってみるでござるよ。何か手がかりが見つかるやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 4007115,
			"completionStepIds": [
				4007115
			],
