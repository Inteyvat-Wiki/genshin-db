				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "わっ、戻ってきたみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711502,
					"content": "いや、待った。どうして戻ってきたんだ！まだ物語の途中だったよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711503,
					"content": "この感じ、最悪です。まるで占星術の教本を買った後に偽物だと気づいた時や、夕食の途中で財布を忘れたことに気づいた時みたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711504,
					"content": "ああ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711505,
					"content": "ああ——！モヤモヤします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711506,
					"content": "二人とも、かなりショックを受けてるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711507,
					"content": "かく言う拙者も、読んでいた本が打ち切りになるのは好まぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711508,
					"content": "ははっ、そりゃ誰だって嫌だろ。みんな、もう一回幻境の中に入ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711509,
					"content": "おお、それもそうだな！すぐ出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711510,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711511,
					"content": "何も起こらぬな。場所もそのままでござる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711512,
					"content": "あれ、さっきまで入れたのに、どうして入れてくれないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711513,
					"content": "どういうことですか。せっかくあそこまで読んだのに、意地が悪いにもほどがあります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711514,
					"content": "ふむ…もしかすると、この本はもう「最後まで読み終わった」のやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711515,
					"content": "幻境から離れる前、最後のページをめくったであろう？拙者が思うに、この『聖国の詠唱』は一冊で完結しないのではないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711516,
					"content": "まるで安っぽい娯楽小説みたいな売り方だな——続きは下巻を買ってくれってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711517,
					"content": "くっ、何が何でも結末が見たくなってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711518,
					"content": "ふむ、結末か。みんな、その続きが気になってるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711519,
					"content": "ん？そこにいるのは誰です？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711520,
					"content": "おっと、まずい。僕を見ているな、姿勢を正さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711521,
					"content": "あなたは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711522,
					"content": "僕は「道を聞かれるのが好きなアーノルド」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711523,
					"content": "その名前、役割が丸わかりだな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711524,
					"content": "ではアーノルド、あなたに聞きたいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711525,
					"content": "アーノルドじゃない、「道を聞かれるのが好きなアーノルド」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711526,
					"content": "道を聞かれるのが好きなアーノルド、聞きたいことがあるのですが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711527,
					"content": "何でしょう、お嬢さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711528,
					"content": "『聖国の詠唱』の続きを知っていますか？どこにあるのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711529,
					"content": "ふっふっふ、それなら僕に聞いて正解だ。『聖国の詠唱』は幽夜浄土の聖典であり、三巻まである。残り二冊は、王城にある二つの高き所に隠されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711530,
					"content": "もし第二巻を探すのなら、高い塔の上まで行かなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711531,
					"content": "高い塔って、あの塔のことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711532,
					"content": "そう、あの塔に聖典が保管されてる。向こうの洞窟をよく調べれば、あそこへと通ずる秘密の近道が見つかるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711533,
					"content": "ありがとうございます、アーノルド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711534,
					"content": "アーノルドじゃない、「道を聞かれるのが好きなアーノルド」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711535,
					"content": "美しきお嬢さん、他に聞くことはないかな？彼女がいるかどうか、給料をいくらもらってるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400711536,
					"content": "ありませんね、さようなら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711537,
					"content": "あの夜鴉は放っておきましょう。向こうの洞窟にある秘密の近道を使えば、塔の上へ行けるようです。さっそく行ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711538,
					"content": "ああ、お嬢さん！本当に僕に興味がないと？君があまりに美しいから、幽夜浄土の秘密を教えたというのに！あんまりじゃないか、お嬢さん…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーノルド"
				}
			]
		}
	]
}