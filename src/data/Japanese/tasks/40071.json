			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"モナ",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "行き止まりみたいだな。本が一冊あるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711302,
					"content": "さっき聞こえたのって、恐らく本に書かれてる物語だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711303,
					"content": "なるほど、書名にあった聖国は幽夜浄土のことのようですね。この本は、民の視点から皇女殿下を賛美しているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711304,
					"content": "自伝の一種なのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "最後のページまでめくってみたが、この物語にはまだ続きがあるようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711306,
					"content": "続きはどこにあるんだ？オイラ、気になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711307,
					"content": "それは探索を続けるしかないであろう。それより、読み終わった本は…閉じたほうがいいと思うでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 4007114,
			"completionStepIds": [
				4007114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
