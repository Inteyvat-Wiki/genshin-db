					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "起きたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710202,
					"content": "う～ん…もう朝…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "どう？何か起きた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "いや、なにも起こってないんだ、信じられないかもしれないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710205,
					"content": "おっ、目が覚めたか？そんじゃ結論から言うぜ。周りを探索してみたところ、怪しいもんは見つからなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400710206,
					"content": "これまでの二つの幻境から見るに、「入り口」を担う物があるはずでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400710207,
					"content": "おかしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "まだその時が来ていない、ということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710209,
					"content": "つーことは、もうちょっと待つ必要があるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400710210,
					"content": "そうです。それに、フィッシュルがいません。彼女はきっと、私たちより先に入り口を見つけたいと思っているはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710211,
					"content": "もう少し待ってみましょう。幻境に…いえ、フィッシュルに時間をあげるためにも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710212,
					"content": "モナの意見に賛成し、皆でお茶を飲みながら休んだ。その後、二組に分かれて探索することになった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "辺りを何度も行ったり来たりしていると、突然、浜辺に何かが現れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "浜辺になにか落ちてるみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710215,
					"content": "一冊の本？隣には…ふむ、鴉の彫像のようでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400710216,
					"content": "この彫像、なんかオズに似てるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710217,
					"content": "なぜ一緒に現れたのでしょう？まさか、彫像がこの本を持ってきたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710218,
					"content": "これなんだろうな？日記か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400710219,
					"content": "どれどれ…『聖国の詠唱』？聞いたことのない本ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710220,
					"content": "見ろよ、この表紙。まさか…フィッシュルが書いた本か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710221,
					"content": "言われてみれば、確かにあいつが書きそうな本だな。『聖国の詠唱』…いいタイトルだ、気に入った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400710222,
					"content": "何やら神聖なものを感じる名前でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400710223,
					"content": "どうする？触ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710224,
					"content": "…まだ帰ってきていませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710225,
					"content": "仕方ありません、先に見てみましょう。もしフィッシュルがこの本を見つけたら、きっと私たちを探しに追いかけてくるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710226,
					"content": "そうだな！日記を誰かに覗かれるようなもんだし、絶対入ってオイラたちを止めに来ると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007103",
							"2"
						],
						"stepId": 4007103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傍白",
					"モナ",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "「今の国民にその記憶はないが、学者は知っている。聖徒時代より約六百年前、混沌の時代に皇女殿下がこの世に現れたことを」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "傍白"
				},
				{
					"id": 400710302,
					"content": "えっ、まさかのナレーションですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710303,
					"content": "さすが本の中の世界だぜ。傍白が物語を語ってくれるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400710304,
					"content": "道が途切れてて、先に進めなそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710305,
					"content": "あそこに装置があります。まるで、私たちが近づくのを待っているかのようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710306,
					"content": "オイラ思ったんだけど…なんか全体的にあからさますぎないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710307,
					"content": "聖国ですからね、大目に見てあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400710308,
					"content": "それもそうだな。それにこんなに見え見えってことは、本当は誰かに気付いてほしいってことだろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400710309,
					"content": "さすがフィッシュル。こんなところで恐ろしく素直だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レオン",
					"モナ",
					"辛炎",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "こちらです、助けてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400711002,
					"content": "えっと、これって彫像だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711003,
					"content": "そんなこと言わないでください！私はれっきとした幽夜浄土の騎士で、レオンと申します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400711004,
					"content": "騎士？全然そんな風には見えないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711005,
					"content": "見えませんか？まあ、この際それはいいでしょう。しかし、夜鴉騎士の鎧を設計し、支給してくださったオズヴァルド様のことはどうか責めないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400711006,
					"content": "オズヴァルド様？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "聞いたことありませんか？オズヴァルド·ラフナヴィネス、オズのフルネームです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711008,
					"content": "知ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "メギストスのほうがまだ言いやすいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400711011,
					"content": "うむ、拙者もそう思うでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400711012,
					"content": "はは…みんなそう言います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711013,
					"content": "皆さん、楽しくおしゃべりされているところすみません。邪魔するつもりはないのですが、この先の扉が施錠されていることを皆さんご存じないですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400711014,
					"content": "ああ、たしかに知らなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400711015,
					"content": "親切なあなたたちが私を助けてくれましたら、扉の開け方を喜んで教えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400711016,
					"content": "そういうことでしたら…助けてあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 400711009,
					"content": "今、知った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
		{
			"id": 4007112,
			"completionStepIds": [
				4007112
