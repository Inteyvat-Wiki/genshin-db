			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブレスト"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1819.629,
							449.792,
							4817.158
						],
						"pointId": 340500103
					}
				]
			},
			"dialogs": [
				{
					"id": 746850101,
					"content": "よし、威力はこれくらいでいいかな。水玉の威力を、的を壊せるぐらいにしておけば、娯楽性と安全性を両立できるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850102
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850102,
					"content": "水玉？娯楽？なんだ、ただのウォーターキャノンのおもちゃだったのか。それなら安心したぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850103,
					"content": "でもこのウォーターキャノン、なんか見覚えがあるな？どこで見たんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850104,
						746850108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850104,
					"content": "覚えてないから、見たことないってことで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850105
					]
				},
				{
					"id": 746850105,
					"content": "変わった見た目だな。モチーフはスピノクロコっぽいぞ…こいつを見てると、なんだか「ワニワニバンバンキャノン」ってあだ名をつけたくなってくるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850106,
					"content": "「ワニワニバンバンキャノン」？へぇ、素敵な名前ね！「バンバン」ってまるで…砲弾が的に当たるときの音みたい。簡単で覚えやすいし、ピッタシだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850107
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850107,
					"content": "どうやら二人とも、このウォーターキャノンに興味津々のようね！どう、私の最初のお客さんになってみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850112
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850112,
					"content": "へへ！おまえの次のセリフ、だいたい予想がつくぜ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850113,
					"content": "「このウォーターキャノンは調整が終わったばかりだから、誰かに遊んでもらって、アドバイスをもらいたい」だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850114,
					"content": "わっ、大正解！よく分かったね。過去にも色んな人の協力をしてきたのかな。話が早くて助かるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850115
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850115,
					"content": "まずは自己紹介させて。私はブレスト。フォンテーヌ科学院兵器研究チームの元艦砲エンジニアだったんだけど、今は失業中なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850116
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850116,
					"content": "生計を立てるために、この「ワニ型サイクロン仕様ワニアーマー対海戦重艦砲式アミューズメント用ハイドロキャノン改良版」の研究を始めたのよ…ウォーターパークでも開こうかなって思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850117
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850117,
					"content": "待て待て！艦砲エンジニア…失業…ウォーターパーク？だんだん話についていけなくなってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850118,
						746850119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850118,
					"content": "いったい何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850120
					]
				},
				{
					"id": 746850120,
					"content": "まあ、時代が変わったんだから仕方ないよ。確かに昔のフォンテーヌにはすごい艦隊があったし、当時は艦砲の需要があった。でも、結局ある戦争で全滅しちゃったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850121
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850121,
					"content": "今のフォンテーヌはクロックワーク·マシナリーの国。パレ·メルモニアは艦隊を再建するつもりもない。艦砲は高いし、大きくて重いから、活躍する場面がなくなったの。大砲を研究するしか才能がない私みたいにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850122
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850122,
					"content": "軍事分野にはもう望みがないし、他の分野に変えたほうがいいでしょ。それにどうせ生きるなら、楽しく過ごすのが一番大事だもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850123
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850123,
					"content": "ウォーターパークを開いて、チケット代を稼いで、日々をのんびり過ごすのも悪くないじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850124
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850124,
					"content": "ポ、ポジティブっていうか…ぜんぜん慰める必要がないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850125,
					"content": "とにかく！嫌なことは一旦忘れて、このワニワニバンバンキャノンの改良版を遊んでみて！すっごく面白いから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850126
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850126,
					"content": "シャティヨンさんの残した設計図をもとに改良を加えてみたの。この新モデルは装填する必要がない上に、弾薬を切り替える機能もついてるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850127
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850127,
					"content": "それに、敵やステージのバリエーションをより豊富にして、アトラクションをもっと挑戦的なものにしてあるの！三日連続で遊んでもまったく飽きないのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850128
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850128,
					"content": "遊んだら、きっと悩みが吹き飛ぶくらい楽しいはず！ついでに、もしよかったら他の人にこのアトラクションを宣伝してちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850129,
						746850130
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850129,
					"content": "じゃあ、もう仕事や失業の話はしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850131
					]
				},
				{
					"id": 746850131,
					"content": "そこまで言うなら、思いっきり遊ばせてもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850132,
					"content": "ブレストの言う通り、話がすんなり進んでいい気分だぜ！他のやつも悩みごとがあったら…ブレストの心構えを見習ったらいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850130,
					"content": "ワニワニバンバンキャノンで遊びたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850131
					]
				},
				{
					"id": 746850119,
					"content": "職業が違いすぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850120
					]
				},
				{
					"id": 746850108,
					"content": "「ワニワニバンバンキャノン」じゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850109
					]
				},
				{
					"id": 746850109,
					"content": "あっ！そうそう思い出したぞ。これって「ヴェルーリヤ·ミラージュ」で見た「ワニワニバンバンキャノン」じゃんか！でもウォーターキャノンをいじってるのは…シャティヨンじゃないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746850110,
					"content": "シャティヨンさん？あの伝説の大砲設計士を知ってるの？…ってことは、君たちもプロね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850111
					],
					"speakerTitle": "ブレスト"
				},
				{
					"id": 746850111,
					"content": "二人とも、このウォーターキャノンに縁があるみたいだし、私の最初のお客さんになってみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850112
					],
					"speakerTitle": "ブレスト"
				}
			]
		}
	]
}