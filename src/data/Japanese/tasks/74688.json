				]
			},
			"dialogs": [
				{
					"id": 746880101,
					"content": "予想をはるかに上回ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880102
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880102,
					"content": "副隊長と助手だけで一つの部隊と同じだけの成績を上げるとは——さすがだな。遺跡の魔物が外に出る心配はもうない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880103
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880103,
					"content": "手応えはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880104,
						746880107
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880104,
					"content": "ちょっとクラクラするけど、大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880105
					]
				},
				{
					"id": 746880105,
					"content": "大砲がビカビカって光るもんな。そこまで気にはならないけど、ずっと見てるとちょっときついぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880106,
					"content": "それなら簡単に解決できる！砲口に装置をつければ閃光を抑えられると、論文で読んだんだ。目の疲れも軽減できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880110,
					"content": "何はともあれ、危機は立ち去り、十分なデータも集められた。これで大砲の改良も捗りそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880111
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880111,
					"content": "ご協力、心から感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880112
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880112,
					"content": "副隊長が到着するまでは、マインさんに随分助けてもらった。賞金は副隊長に渡すが、大砲の販売が始まったら、利益の半分をマインさんに渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880113
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880113,
					"content": "えっ、あたしの分もあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880114
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746880114,
					"content": "それならモラより、タイダルガの酒漬けをお願いしたいかも。果実酒じゃなくて、ぜったい小麦酒で漬けたやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880115
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 746880115,
					"content": "どんな食べ物なんだ？聞いてたら、食べたくなったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880116,
						746880117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880116,
					"content": "パイモン、お酒はだめでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880118,
					"content": "わかってるぞ！でも、お酒じゃなくてフォンタ漬けならいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880119,
					"content": "えっと…そんな料理、聞いたことがないが…どこで手に入るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880120
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880120,
					"content": "先輩、これを機に「自動タイダルガ漬け器」を発明したら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880121
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880121,
					"content": "前に造ってくれた「自動朝食オーブン」もすごく使いやすいし、先輩には調理器を造る才能があると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880122
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880122,
					"content": "高い殺傷力が求められる大砲に比べて、ずっとマーケットも広いはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880123
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880123,
					"content": "わざわざ危険エリアに行って魔物と戦いながらデータを集める必要もないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880124
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880124,
					"content": "そうか…確かに試してみる価値があるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880125
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880125,
					"content": "だが、調理器の発明に移ったら今までの努力が無駄になるだろう…？それに警察隊の仕事とも関係がなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880126
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880126,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880127
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880127,
					"content": "はぁ…そうね。諦めるなんて、先輩らしくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880128
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880128,
					"content": "あ、いま思いついたんだけど、警備ロボの識別モジュールを使って大砲を強化するのはどうかしら？それから、いくつかの機能を持った「護衛マシナリー」を搭載するのもいいかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880129
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880129,
					"content": "死角に隠れちゃった魔物は「護衛マシナリー」が対処するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880130
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880130,
					"content": "そういう装置と大砲をパッケージにして売り込めば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880131
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 746880131,
					"content": "おお、いいアイデアだ！顧客の悩みを一気に解決できるな…詳しく検証する価値がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880132
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 746880132,
					"content": "話をしてるだけで、どんどんアイデアが湧いてくるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880133,
					"content": "二人を何週間か部屋に閉じ込めたら、アイデアで溢れかえるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880117,
					"content": "パイモン、変なもの食べちゃダメ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880107,
					"content": "大砲の音で耳が痛い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880108
					]
				},
				{
					"id": 746880108,
					"content": "オイラもだぞ！今も耳元で千匹のカモメが鳴いてるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746880109,
					"content": "それなら、廃案となった書類に書いてあったな。多重チャンバー式でガスの速度を落とせば、発砲音を抑えられる。問題は材料費がかさむことだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "フェルロイス"
				}
			]
		}
	]
}