				]
			},
			"dialogs": [
				{
					"id": 760080101,
					"content": "あ、月光があなた方の前途を照らしますように！あなたたちも月の{RUBY#[D]クータル様}少女に祈りを捧げにきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080102
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080102,
					"content": "祈りって…ここにある彫像の前で祈るってことか？すごくでっかい彫像だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760080103,
					"content": "ふふ、きれいでしょう？この「新月の像」は500年前の詠月使様が自ら彫ったもので、月の{RUBY#[D]クータル様}少女の最初のお姿を象ったと言われているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080104
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080104,
					"content": "月の{RUBY#[D]クータル様}少女の誕生や、彼女が月下の世界で行った奇怪な出来事については…私はただの侍祭だから、省略させて貰うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080105
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080105,
					"content": "とにかく、ここは月の{RUBY#[D]クータル様}少女へ祈りを捧げる巡礼の道の最終地点よ。お祈りのために来たんじゃなくても、クータル様のお恵みを感じていってもらえると嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080106
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080106,
					"content": "なるほどな…ん？待てよ。ここが最終地点なのか？じゃあ、あそこに見えるすごそうな柱はなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760080107,
					"content": "ふふ…あれは実は柱じゃないの。あの下は「初諭の庭」。500年前の詠月使様の命令で封じられた古い聖地よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080108
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080108,
					"content": "ある意味では…「霜月の子」の禁域と言えるかしら？その詠月使様の封印で今は誰も入れないから、近づかない方がいいと思うわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080109
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080109,
					"content": "あと、あそこにあるあの巨大なやつだけど…実は前に空から降ってきたの。月の{RUBY#[D]クータル様}少女のご加護のおかげか、幸い怪我人は出なかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080110
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080110,
					"content": "えっ、欠片だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760080111,
					"content": "ええ。あの時、空から巨大な欠片がいくつか落ちてきたの。そのうちの一つが<color=#00E1FFFF>下のキャンプ</color>に落ちて…あなたたちも、ここに来る時に見たでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080112
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080112,
					"content": "他のものについては、たぶんすべて<color=#00E1FFFF>西</color>に落下したはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080113
					],
					"speakerTitle": "エベリナ"
				},
				{
					"id": 760080113,
					"content": "いずれにしても、二人がここに来たのはきっとクータル様のお導きによるものだわ。たとえお祈りに来たんじゃなくても、月光があなたたちの前途を祝福しますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エベリナ"
				}
			]
		}
	]
}