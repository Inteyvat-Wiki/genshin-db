			},
			"dialogs": [
				{
					"id": 120100501,
					"content": "用事があるんやったら、それを終わらせてからわしの物語を聞いても大丈夫や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100502
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100502,
					"content": "わしには時間も物語も、ぎょうさんあるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
