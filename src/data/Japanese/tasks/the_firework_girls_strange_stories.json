			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "父ちゃん、ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100302,
					"content": "もうじき花火大会や、各家庭の花火はほぼ準備が終わっとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100303,
					"content": "ん？こちらのお二人はお友達か？それともお客さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100304,
					"content": "どっちも、やろか。最近ここいらに来たばっかりなんや。ほんで稲妻に来たからには、花火を見てもらわなあかんと思うて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100305,
					"content": "ははは、そうか、ほなちゃんともてなしてやらんとな。この長野原龍之介が、長野原家の歴史を聞かせたる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100306,
					"content": "それよりも父ちゃん、聞きたいことがあるんやけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100307,
					"content": "昔々…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100308,
					"content": "あかん、勝手に始めてもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100309,
					"content": "堪忍な。父ちゃん、前にケガしてからずっと耳が遠いんや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100310,
					"content": "でも、さっきは会話が微妙に成立してたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100311,
					"content": "ほんで、長い時間かけて人々は理解した。ある鉱石を研磨することで出てきた粉末を燃やすと、綺麗な色に光るってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100312,
					"content": "父ちゃん、父ちゃん、ちょい待ち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100313,
					"content": "うん？どないした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100314,
					"content": "こないだ注文した花火の材料、もう届いとるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100315,
					"content": "昨日の花火なら全部出荷したで、一昨日のも、一昨々日のも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100316,
					"content": "ちゃう、材料や材料、こないだ注文したやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100317,
					"content": "今日の分もぼちぼち仕上げや。心配せんとき、腕までは年取ってへんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100318,
					"content": "ちゃうー！材料やって言うてんねん！花火の材料、こ、う、せ、き！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100319,
					"content": "何やて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100320,
					"content": "材料の鉱石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100321,
					"content": "ああ、鉱石か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100322,
					"content": "そうだそうだ、鉱石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100323,
					"content": "あっ、ごめん…興奮してつい、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100324,
					"content": "材料ならまだ届いてへんで、さっき担当のもんが理由を言いにきたんやけど、よう聞こえんかったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100325,
					"content": "かまへん、それさえ分かれば十分や。ちゅうことは、まだ完成しそうにないな。父ちゃん、あとで届いたらちゃんと受け取っといてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100326,
					"content": "ああ、任せとき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100327,
					"content": "ほんまごめんな、うるさかったやろう。うちの父ちゃんになんか聞くと、いっつもこうなんねん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100328,
					"content": "面白くて熱心な人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "ふふん、せやで、父ちゃんいい人やから、みんなに慕われてるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100332,
					"content": "父ちゃん耳が遠いから、何言われても文句言わへんし、否定もせえへん、笑うてばっかや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100333,
					"content": "子供の頃はうちの話すことをちゃんと理解しとって、何を話しても肯定してくれてると思うとった。ほんでいろんなことを父ちゃんに話してたんやけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100334,
					"content": "あとになって父ちゃんが笑うとったのは、ただよう聞こえへんかったからやって知ってな…せやからうち、毎日父ちゃんに話しかけるようにしとるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100335,
					"content": "えっ？普通逆じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100336,
					"content": "父ちゃんが笑うとこ見ると、うちも嬉しいからや。それに父ちゃんも寂しくならへんで済むやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100337,
					"content": "せやけど、花火大会が目前やのに材料が届いておらんとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100338,
					"content": "なあ、宵宮…帰って来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100339,
					"content": "うひゃ！？びっくりした、勝手に喋ったらあかん言うたやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100340,
					"content": "ご、ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100341,
					"content": "ちょい待ち、今いくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100330,
					"content": "宵宮と似ていた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "ひひっ、それよう言われるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201004,
			"completionStepIds": [
				1201004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100401,
					"content": "誰も見てへんな、出てきてええよ、こっち来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100402
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100402,
					"content": "天領奉行の連中にバレんで良かったわ。バレとったら、うちら大変なことになっとったで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100403
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100403,
					"content": "悪かったよ、君が帰ってきたと聞いてつい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100404
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100404,
					"content": "気にせんといて、朔次郎。ここまでは計画通りに進んどる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100405
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100405,
					"content": "これから花火の材料を探しに行くんやけど、ついでに船の件も何とかしたる、前に約束したやつや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100406
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100406,
					"content": "ありがとう、こんなによくしてくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100407,
						120100408
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100407,
					"content": "この人は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				},
				{
					"id": 120100409,
					"content": "昔の常連さんで稲妻の外におったんやけど、数日前に帰ってきたんや。ただ、密入国がバレてもうて天領奉行に追われとる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100410
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100410,
					"content": "お尋ね者ってことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100411,
					"content": "声デカすぎや。誰が聞いとるか分からへん、気ぃつけてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100412
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100412,
					"content": "もし捕まったら何かしらの罪に問われる、せやから何とかして船で逃がしてやりたいんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100413
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100413,
					"content": "けど、稲妻近海は雷雨で危ないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100414
					]
				},
				{
					"id": 120100414,
					"content": "危ないのは百も承知や、せやけど今はあれこれ考えとる暇はあらへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100415
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100415,
					"content": "もし船がひっくり返ったら……あわわ！溺れ死んだらどうするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100416,
					"content": "今の稲妻は危険だって分かってたんだろ、どうして帰って来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100417,
					"content": "それは、やらなくてはいけないことがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100418
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100418,
					"content": "帰ってきた矢先、信じがたい変化をたくさん耳にした…決心してきたというのに、今はどうしていいのか分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100419
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100419,
					"content": "これ以上、宵宮と龍之介さんに迷惑はかけたくない。匿ってくれてるだけでも、十分ありがたいことなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100420
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100420,
					"content": "平気平気、そう気にせんといて。うちも言うたやろ、「長野原の短冊を持っとる限り、いつまでもうちのお客さんや」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100421
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100421,
					"content": "短冊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100422,
						120100423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100422,
					"content": "覚えがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100424,
					"content": "そや、うちで花火を作ってお祝いしたいっちゅうお客さんに、あの短冊を渡しとるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100425
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100425,
					"content": "短冊には、長野原家の者しか読まれへん花火の作り方が載っとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100426
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100426,
					"content": "その短冊を見たら、十年後でも百年後でも、当時と同じ花火が作れるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100427
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100427,
					"content": "おおっ、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100428,
					"content": "代々伝わってきたもんやさかい、常連さんはみんな知っとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100429
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100429,
					"content": "当時、僕の親が龍之介さんに花火を注文したんだ。あれからもう20年も経つのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100430
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100430,
					"content": "はぁ、あの頃はこんなことになるなんて思いもしてなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100431
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100431,
					"content": "そう気落ちせんと、船での脱出は最後の手段にして他の方法も探したる。もちろん、稲妻に残れたらそれが一番やけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100432
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100432,
					"content": "原因は何であれ、お客さんが頼ってきたんや、失望はさせへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100433
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100433,
					"content": "かたじけない、これでもう少し考える時間ができた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100434
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100434,
					"content": "もうええから今は隠れとき、表に出とったら危険や。何か思いついたらまた教えるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100435
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100435,
					"content": "ああ、すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100436
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100436,
					"content": "うーん、稲妻出身やのに、故郷に戻る許可が下りへんとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100437
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100437,
					"content": "せや、あんたらも最近稲妻に来たんやろ、どないして許可をもろたんや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100438
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100438,
					"content": "離島で面倒な手続きをした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100439
					]
				},
				{
					"id": 120100439,
					"content": "それから勘定奉行にいる柊千里に手伝ってもらって、ようやくここまで来たんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100440,
					"content": "なるほど、お偉いさんの助けがあったんか。朔次郎には使えへん方法やな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100441
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100441,
					"content": "まったく、奉行衆のヤツらももうちょい融通を利かせくれてもええのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100442
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100442,
					"content": "あんたらが旅してきたとこは、稲妻と全然ちゃうんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100443,
						120100444
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100443,
					"content": "全然違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100445,
					"content": "まあ、とにかく、朔次郎を助ける方法を見つけんとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100446
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100446,
					"content": "すまんなぁ、花火を見せるっちゅうて誘うたのに、他のことに付き合わせてもうて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100447
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100447,
					"content": "面倒やと思うたら、あとでまた来てもかまへんから、うち一人で材料と船を何とかするさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100448,
						120100449
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100448,
					"content": "別に気にしてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100450,
					"content": "良かったぁ、ほな先に船の用意や！話は歩きながらにしよか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100449,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も花火大会の準備作業がみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100444,
					"content": "どの神も考えが違った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100423,
					"content": "子供たちに渡してたあれのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100408,
					"content": "どうして宵宮の家に隠れてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				}
			]
		},
		{
			"id": 1201005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
