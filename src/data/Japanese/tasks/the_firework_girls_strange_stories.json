				"points": []
			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ボクたち今「袋貉」を探してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100102,
					"content": "「袋貉」がどこにいるか知らない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100103,
					"content": "「袋貉」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100104,
					"content": "えっ、聞いたことないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100105,
					"content": "強くてずる賢い大妖怪なんだ。いろんなものに変化して、神出鬼没で人を騙すんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100106,
					"content": "俺んちの米も「袋貉」に食われたことあるぜ。それに父ちゃんもヤツに蹴られて、川に落っこちたことあんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100107,
					"content": "イタズラが好きなやつみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100108,
					"content": "どうして探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "追い払う方法が分かったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100110,
					"content": "それに父ちゃんが「袋貉」は家に帰らねえ人をいじめるって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100111,
					"content": "だから、追い払えばずっと外で遊べるようになるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100112,
					"content": "でも凄い妖怪なんだろ、怖くないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100113,
					"content": "お父さんやお母さんが心配するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100114,
					"content": "平気だけど？今日も「袋貉」探しに行くっつったら、父ちゃんなんも言わなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100115,
					"content": "あ、もしかしたら「袋貉」はいま弱ってて隠れてるのかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100116,
					"content": "うん！それに「袋貉」の妖力が回復する前に家に帰れば大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100117,
					"content": "えっと、なんか変じゃないか？うまく言えないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100118,
					"content": "狙われたら家に隠れても無駄でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "ああ、「袋貉」って物語の中にしか出てこない気がするぞ。実在するとは思えないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100122,
					"content": "確かに作り話のような気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "真実を話してやろうぜ、無意味なことをしなくても済むように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100125,
					"content": "聞いてくれ、「袋貉」なんて探さなくてもいいんだ。そんなの元から存在しないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100126,
					"content": "えっ——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100127,
					"content": "ほんとに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100128,
					"content": "そんなことない、父ちゃんは嘘ついたりしねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100129,
					"content": "おまえらの家族はただ心配で、遅くまで外で遊ばないようそう言っただけだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100130,
					"content": "ちげぇよ、「袋貉」は絶対にいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100131,
					"content": "そうそう、宵宮姉さんが武器まで用意してくれたんだ！妖怪を追っ払う方法も教えてくれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100132,
					"content": "えーと、宵宮姉さんって…あの宵宮のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100133,
					"content": "「袋貉」のことを宵宮お姉ちゃんに話したら、怖ないでって言って、追い払う方法を教えてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100134,
					"content": "それからずっと機会を待ってたんだ。そしてついに今日、「袋貉」を追い払うのにいい日だって宵宮姉さんが教えてくれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100135,
					"content": "そうだ！宵宮姉さんはいつも遊んでくれるし、物語も聞かせてくれる、嘘つくわけねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100136,
					"content": "そ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100137,
					"content": "ふん、もういい！みんな、宵宮姉さんとこに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100138,
					"content": "おいおい、待てって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100139,
					"content": "まずい、怒らせちゃったぞ。ただ心配して言っただけなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100140,
					"content": "宵宮って言ってたよな、追いかけてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100123,
					"content": "子供が遅くまで遊ぶのを防ぐためだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "見たことのない妖怪だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "お父さんの態度がおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "はいはい、そう悲しまんといてぇな、きっと冗談や、「袋貉」がおらんわけないやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100202,
					"content": "で、でも、今まで「袋貉」を見たことないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100203,
					"content": "そらぁ「袋貉」はえらい大妖怪やさかい。そのえらい大妖怪をあんたらが退治せんと、なぁ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100204,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100205,
					"content": "焦ったり、ヘコんだりすることあらへん。立派な英雄になるためにも知恵と根性を忘れたらあかん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100206,
					"content": "今はいなくても、花火大会が始まる前には必ず現れる。そんな時は、宵宮姉さんのとこまで武器を取りにくるんやで、ええか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100207,
					"content": "宵宮姉さん特製の花火なら、「袋貉」なんてちょろいもんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100208,
					"content": "家も、畑も、父ちゃんも母ちゃんもみぃんなあんたらが守ったりぃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100209,
					"content": "分かった！宵宮姉さんがそう言うなら、ボクたち信じるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100210,
					"content": "あっ、ちょっと待ちや。この短冊を1枚ずつやるさかい、帰ったら父ちゃんと母ちゃんに渡しい。で、大事に保管するよう伝えといてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100211,
					"content": "宵宮姉さんからって言うたら、分かるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100212,
					"content": "分かった！ありがとう宵宮姉さん！そろそろ帰るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100213,
					"content": "ありがとう！宵宮お姉ちゃん、また一緒に遊ぼうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100214,
					"content": "ああ、約束や、ほな気ぃ付けて帰りぃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100215,
					"content": "な、なあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100216,
					"content": "久しぶり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "やっぱあんたらかぁ、子供相手に何言うとんねん。まあ、ええわ、別に責めるつもりはあらへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100219,
					"content": "「袋貉」は子供に大人気やから、そう簡単に否定されたらそりゃ怒るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100220,
					"content": "ってことは、やっぱり「袋貉」は嘘なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100221,
					"content": "そうや、うちも最初から「子供が遅くまで外を走り回らんよう、親がでっち上げた妖怪」っちゅうことはわかっとったで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100222,
					"content": "せやけど子供に聞かれた時、ほんまのことを言えんかった。逆に「袋貉」は可愛らしうて、人を傷つけへんイタズラっ子やって言ってもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100223,
					"content": "あの子らがいま信じとるんは、ほぼうちが教えた作り話の方や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100224,
					"content": "全部おまえの作り話なのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100225,
					"content": "そうやって嘘をつき続けるのはいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "言いたいことは分かるけど、うちが否定するわけにもいかんのや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100227,
					"content": "遅くまで遊ばんようにする他にも、親御さんに別の考えがあるかもしれへんやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100228,
					"content": "何も分かってへんのに、ズバッと「袋貉なんておらん」って言うてもうたら、逆に迷惑をかけてまうかもしれへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100229,
					"content": "それに子供にとって真実なんて関係あらへん、楽しむことが何よりも大事なんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100230,
					"content": "うちかて空想の産物に憧れたりする。燃やすと虹色の光を放つ「緋紋石」とか、山奥に隠された秘境に導いてくれる「霧霊」とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100231,
					"content": "どれもうちの妄想やっちゅうのは知っとる、せやけど信じたいんや。もし「どアホ、そんなもんあるか」っちゅうヤツがおったら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100232,
					"content": "あっかんべえして、泥んこ投げたる！そんな人、嫌や！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100233,
					"content": "なんか理解できた気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "せやろ！どれも妄想やったとしても、かっこええしロマンがある、他人に否定されるんは悲しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100237,
					"content": "子供の頃に信じたもんは、大人になったらかけがえのない宝もんになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100238,
					"content": "あんたらも子供の頃は悪龍を退治する勇者とか、闇を切り裂く聖剣とか信じとったやろ、それと同じや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100239,
					"content": "幻想が崩れ去ったら、次は何を教えるんや？稲妻の鎖国の歴史？それとも「目狩り令」？どれもまだ子供には早いやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100240,
					"content": "うぅ…そうだな！オイラも、まだ早いと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100241,
					"content": "パイモン、全部理解できてないでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "ははっ、理解できんくてもええわ。とにかく安心しい、うちがちゃんと子供たちの安全を守ったるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100244,
					"content": "ほな、うちもそろそろ帰るわ。「長野原花火大会」がもうすぐ始まるさかい忙しいんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100245,
					"content": "「長野原花火大会」？おまえの店が主催してるイベントか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120100246,
					"content": "そうや、うちの苗字が入っとるやろう、稲妻ではけっこう有名なんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100247,
					"content": "あっ！せや、これから予定あるか？なかったら見てってや、うちがおっきい花火準備したるさかい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100248,
					"content": "見たいと思ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "へへ、ほなまずは店にいる父ちゃんのとこに行こか！実はまだ完成してへん花火があるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100249,
					"content": "ぜひとも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "無理に同意しなくてもいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "そんな子供みたいに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "真実なんて関係あらへん。かっこようてロマンがあれば、それは信じる価値があるもんなんや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100217,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
