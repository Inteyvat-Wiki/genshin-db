			"dialogs": [
				{
					"id": 760580101,
					"content": "こんなに真っ白な宝盗イタチ、初めて見た。病気なのかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 760580102,
					"content": "元気いっぱい動き回ってたし、さっきなんかユルヴァお兄ちゃんの食べ物を奪おうとしてたんだぞ。それのどこが病気なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 760580103,
					"content": "ものすごく珍しい種類とか…？リンネアなら何か知ってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 760580104,
					"content": "あっ！オイラのへそくりを空っぽにしたモラ泥棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760580105,
					"content": "宝盗イタチが逃げようとすると、三人の子供たちが素早く取り押さえた。最初は抵抗していたが、しばらくすると観念したので、子供たちにこれまでの出来事を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "常習犯だったのかよ。だったらお仕置きが必要だな。間違いを犯したら罰を受けなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 760580107,
					"content": "でも…この子はただの動物だし、悪いことをした自覚はないはずでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 760580108,
					"content": "パイモンのモラを返してくれれば大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "とにかく、まずはこの子が持ってるモラをパイモンに返そう。買い物なんてするはずないし、ちゃんと全部残ってるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 760580111,
					"content": "よかったぜ！へへっ、これでまたオイラのへそくりが潤ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760580112,
					"content": "この子を飼えたらいいのにな。そしたら、ヘルカが帰ってきた時、この珍しい宝盗イタチを見せてあげられるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 760580113,
					"content": "はぁ？でも、こいつは仕事しないんだぞ…泥棒は別に仕事じゃないし。働きもしないやつに、タダで飯を食わせるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "ミッコ"
				},
				{
					"id": 760580114,
					"content": "まあまあ。どうするかは…カーチャと相談して決めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ユルヴァ"
				},
				{
					"id": 760580109,
					"content": "動物だってこの世の厳しさを知るべき…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
}