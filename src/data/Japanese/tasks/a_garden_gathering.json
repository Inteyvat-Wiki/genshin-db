					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761820204,
					"content": "うん。また来ようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
