			"dialogs": [
				{
					"id": 761820101,
					"content": "ここが昔住んでた場所？すごく綺麗だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820102,
					"content": "昔はもっと綺麗だったんだから。ワタシ、庭の手入れも結構得意なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761820103,
					"content": "ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820104,
					"content": "また笑って…今度は何よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761820105,
					"content": "昔のサンドローネが花のそばでしゃがんでる姿を想像したら、なんだか可愛いなって思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820106,
					"content": "後で中を見て回ってもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820107,
					"content": "もちろんよ。もう一通り掃除してあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761820108,
					"content": "この家、どうするつもりなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820109,
					"content": "そうね…やっぱり、残しておきたいわね。時間がある時に戻ってきて、手入れするつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761820110,
					"content": "忙しい時は、私が手伝いに来ようか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820111,
					"content": "私、この家が好き。昔のキミの部屋みたいで落ち着くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761820112,
					"content": "ふん…勝手にしなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
