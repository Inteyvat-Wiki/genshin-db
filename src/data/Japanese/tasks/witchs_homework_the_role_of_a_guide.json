				]
			},
			"dialogs": [
				{
					"id": 761590201,
					"content": "気づけば、断崖の縁に立っていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590202
					]
				},
				{
					"id": 761590202,
					"content": "はい、到着。この「仙霊ノ庭」はいい場所にあるわね。ほら見て、あそこが「課題の出発点」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590203,
						761590204
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590203,
					"content": "仙霊ノ庭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				},
				{
					"id": 761590205,
					"content": "そうよ、先を急ぐために「仙霊ノ庭」をちょっと借りただけ。ここは地脈と繋がってるし、普段は誰も使っていないから、すごく便利なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590206
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590206,
					"content": "それに、あたしと仙霊たちは昔は天の使い、つまり「元同僚」だったんだしね。たまに借りても怒られたりしないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590207
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590207,
					"content": "他に誰もいないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590208
					]
				},
				{
					"id": 761590208,
					"content": "まだそのタイミングじゃないの。もうしばらくすれば、詩人が遥か昔の頌歌を歌い、悠久を彷徨う千の風を呼び戻してくれるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590209
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590209,
					"content": "ここで課題をこなす人って、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590210
					]
				},
				{
					"id": 761590210,
					"content": "そう焦らないで。近いうちに、あなたもその歌の旋律の一つとなって、千の風に包まれるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590211
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590211,
					"content": "でもその前に、ひとまずその歌を安らかな眠りにつかせてあげましょう…さあ、次の場所へ向かうわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590212,
						761590213
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590212,
					"content": "ここは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590214,
					"content": "辞典で見たわ。結果から見て、あなたとバルバトス様は素敵な合奏をしたようね。唯一残念なのは…バービーに音符ひとつたりとも聴かせられなかったことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590215
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590215,
					"content": "アリスがこれを聞いた時は、帽子を落としちゃいそうなくらい笑っていたのよ…コホン！さあ、次の場所へ向かいましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590213,
					"content": "あの島でウェンティと合奏したことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590204,
					"content": "まさか、それを使って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				}
			]
		},
