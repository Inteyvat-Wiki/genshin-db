			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "もう行っちゃうの？ちょっと、バービーったら！まだあなたから受け取ってないものが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590102,
					"content": "たくさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590103,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "いいえ、あなたたちが来たタイミングは、バービーの「予言」とほぼ一致してるわ…もっと遅くなるかと思ってたけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590106,
					"content": "でも、話の前に…軽く何か食べてきたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590107,
					"content": "…それもバーべロスさんの予言？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "違うの、あたしは耳がいいから、パイモンのお腹の音が聞こえただけよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590110,
					"content": "（ぐぅぅ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590111,
					"content": "わぁっ！い、今のはこいつの代わりに鳴ったんだぞ。オイラたち、二人とも腹ペコだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590112,
					"content": "ステーキが売り切れてるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "安心して。魔女ともあろう者が、遠路はるばる来てくれたゲストを空腹になんてさせないわ。さあ、クッキーもケーキも用意してあるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590115,
					"content": "パイモンと楽しくケーキとクッキーを食べ、お茶もたっぷり飲んだ。不思議なことに、いくら飲み食いしてもティーポットは常に半分満たされたままで、お皿には永遠に新しいお菓子が盛られていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "オ、オイラ…もう食べられないぞ。どれだけ食べても無くならないなんて…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590117,
					"content": "これが…魔女のお茶会…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "ええ。お茶会なんだもの、常に十分なお菓子とお茶を用意しておかないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590119,
					"content": "でも、食べ過ぎは魔女の気品を損なってしまうから、大抵お茶はポットの半分だけ、お皿のクッキーやケーキも一切れだけなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590123,
					"content": "ううっ、もう無理だ…オイラ、お腹いっぱいだ…さあ、本題に入ろうぜ。ゲフッ…あぁ、ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590124,
					"content": "あなたたちは、バービーがあたしに予言した「課題」を伝えるために来てくれたのよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590125,
					"content": "知ってたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "いいえ、バービーと話していたのは別件よ。月の大異変のせいで、水占の術が狂ってしまったんですって。だから、しばらく静かな場所で修行するらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590128,
					"content": "その間、あたしが代わりにみんなの「課題」を見届けるの。ついでに、辞典に新しい「課題」を書き込む手伝いもすることになっているのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590129,
					"content": "えっ？担当者って、そんな簡単に変えていいものなのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590130,
					"content": "さすがニコだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "出来るようになるつもりなんてなかったのよ！でも、バービーとアリスったら、この話をあたしにする前に、特別な「課題」を勝手に辞典に入れちゃったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590133,
					"content": "本当はそれを消して、のんびり世界を観測していたいのだけれど…アリスはテイワットの境界を守らなきゃいけないし、バービーも修行に行くっていうから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590134,
					"content": "オクタヴィアは帰ってこないし、ましてやレインドットなんて言うまでもないわ…魔女のみんなもそれぞれ事情があるから、しばらくはあたしが「課題」を監督するしかないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590135,
					"content": "魔女会ってそんなに忙しいんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "そうなのよ。最後にみんなで集まってお茶会をしたのがいつのことなのか、もう覚えてないくらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590138,
					"content": "とにかく、その特別な「課題」さえ終えれば、あたしの物語も正式に辞典に組み込まれることになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590139,
					"content": "そうすれば、ちゃんと世界を観測してみんなを導けるようになるから…旅人、パイモン、あたしに「課題」の内容を教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590140,
					"content": "そうそう、これは予言ではなく、バービーとアリスが十分前にでっち上げただけの物語だから、あまり役に立つ情報は得られないと思うわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590141,
					"content": "確かにそうだな。オイラたちがあの辞典で見たのは、複雑な「課題」じゃなかったし…というか、たった二言だけだったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590142,
					"content": "「ニコには自らの責務を果たしてもらう。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "そう…前半の文はバービーで、後半は間違いなくアリスが書き加えたものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590146,
					"content": "じゃあ、さっそく今回の「課題」を始めましょう。まずは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590147,
					"content": "待って、もう理解できたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "さっきバービーと話したついでに、あたしのやるべきことを教えてもらったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590150,
					"content": "「責務を果たす」っていうのは、それぞれの課題の場所に行って状況を確認する…つまり、実地調査をするってことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590151,
					"content": "ええっ、そんなのありなのか？ぜんぜん「予言」って感じがしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590152,
					"content": "あら、そんなことないわ。これは、十分「予言」といえるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590153,
					"content": "この「課題」はバービーが執筆したものだけれど、彼女はただ物語の最後のページを事前に開いて、結末を教えてくれただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590154,
					"content": "それって完全にネタバレだよね！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "何言ってるの、予言もネタバレも同じようなものよ。さあ、あたしについてきて。まずは…そうね、ここがよさそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590159,
					"content": "えっ？もう行くのか？ちょっと待ってくれ、行くってどうやって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590160,
					"content": "気づけば、断崖の縁に立っていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "ここに来たのは無駄足だったかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "無駄足なんかじゃないわ！「課題」はあなたが伝えなきゃいけないの。この「形式」こそが重要なのよ。この手順を欠いたら、「課題」自体が成り立たないかもしれないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590158,
					"content": "そんなことより、行くわよ！さあ、ついてきて。まずは…そうね、ここがよさそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590148,
					"content": "この文の意味が分からないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "「ただ働きはさせないから！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "——って、書いてある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "よく考えたら、魔女って結構多いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "そんなことまで出来るんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "まさか、バーべロスさんもさっき…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "今度はヴァレサを連れてこないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "ああ、ナタの豊穣の邦の、よく食べる女の子のことかしら？アリスから聞いたことあるわ。とても面白いお嬢さんなんですってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590122,
					"content": "もし彼女が来てくれるのなら、お皿は三…いや、七枚は並べておかないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590113,
					"content": "サラダじゃお腹いっぱいにならない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "そんなことまで分かるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "タイミング悪い時に来ちゃった…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
