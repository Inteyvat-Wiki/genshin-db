			"dialogs": [
				{
					"id": 761590301,
					"content": "ここは…奔狼領か？課題をこなせそうな場所には見えないけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590302,
					"content": "これでも一番近い「仙霊ノ庭」なのよ。大丈夫、あたしたちが探している「課題の出発点」も、そう遠くないとこにあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590303,
					"content": "うわっ！この狼たち、いつの間に近づいてきたんだ？その…オイラたち悪気はなかったんだ、それにレザーの知り合いだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "狼の群れ"
				},
				{
					"id": 761590305,
					"content": "いなくなった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "あの子はまだ来ていないのかしら。ちょっと早かったかもしれないわね。でもきっと、「ルピカ」と一緒にいる限り、どんな敵が相手でも勝てると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "狼の群れ"
				},
				{
					"id": 761590309,
					"content": "あれ、なんであいつらまた戻ってきたんだ？オイラたちの話を聞いてたのか？こんな時レザーがいれば、狼たちが何を言いたがってるのかわかったのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590310,
					"content": "そうね。でもあの子はそれ以外にも、もっとたくさんのことを学ばないといけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590311,
					"content": "ここは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "ええ。あのレザーという子は、運命で定められていた戦いに見事勝利したわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590314,
					"content": "きっと、「ルピカ」と一緒にいる限り、どんな敵が相手でも勝てると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "狼の群れ"
				},
				{
					"id": 761590316,
					"content": "…彼の「ルピカ」も、きっとそう思っているはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590317,
					"content": "はい！ここもチェック完了ね。疲れたし、一旦帰ってお茶を飲みましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590318,
					"content": "うわっ！この扉、いつ現れたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761590319,
					"content": "なんでステッカーまで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "このステッカーの絵、アリスが描いたものね。何か書いてあるわよ…どれどれ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590322,
					"content": "「課題の指導、お疲れ様！早く家に帰って、温かいお茶でも飲んで！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590323,
					"content": "「追伸：扉の向こうにサプライズが待ってるよ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590324,
					"content": "家に帰る…見覚えがある扉だと思ったけれど、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761590325,
					"content": "勢いよく扉を開け大股で歩くニコとともに、その中に入っていった。そして次の瞬間、ある部屋の中に立っていることに気づいた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "この雰囲気、見覚えがあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "ここでレザーと戦ったことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "ここで課題をこなす人って、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
