			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "ますますおかしな処方箋だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120102,
					"content": "アナは元気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "ああ、旅人か。信じられないかもしれないが、アナは元気だって言ってくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120104,
					"content": "本当にあの先生の処方のおかげか？俺自身もまだ信じられないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120105,
					"content": "でも、本当かどうかは置いておいて、とりあえず薬を飲み続けてもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120106,
					"content": "今回の処方は…そうだな、「水スライムの濃厚液体」を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120107,
					"content": "今回は普通だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "…うー、普通なのか？俺は逆に普通じゃないと思ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120109,
					"content": "でも前回より見つけやすいはずだ。他の人に「濃厚液体」について聞いてみたんだが、大型スライムを倒せば手に入るらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120110,
					"content": "それとジャックから聞いたんだが、大型スライムを引き出したいなら、小型スライムを倒し続ければいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120111,
					"content": "俺にはそういう戦闘力がないからな、今回も頼むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120112,
					"content": "食べれると思うから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "なんで分かるんだ、まさか食べたことがあるのか？えっ、なんで黙ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120114,
					"content": "まあ、それより水スライムは探しやすいと思うぞ。他の人に「濃厚液体」について聞いてみたんだが、大型スライムを倒せば手に入るらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120115,
					"content": "それとジャックから聞いたんだが、大型スライムを引き出したいなら、小型スライムを倒し続ければいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120116,
					"content": "俺にはそういう戦闘力がないからな、今回も頼むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120117,
					"content": "どこにあるか分かるから任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "ほほう…頼もしいな、お前はスライムの相手に慣れてるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120119,
					"content": "じゃあ頼むよ。他の人に「濃厚液体」について聞いてみたんだが、大型スライムを倒せば手に入るらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120120,
					"content": "それとジャックから聞いたんだが、大型スライムを引き出したいなら、小型スライムを倒し続ければいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120121,
					"content": "では、頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		},
