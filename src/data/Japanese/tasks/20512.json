				},
				{
					"id": 205120302,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "これは…確かに…濃厚だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120304,
					"content": "これ本当に薬に使えるのか？薬ができたら俺が先に毒見しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120305,
					"content": "俺に何かあったら、アナのことはお前が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120306,
					"content": "…世話を見てくれと、シスターグレイスに伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120307,
					"content": "それと、俺は仕事で遠い場所に行ったとアナに伝えてくれ。頼む、最後の願いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120308,
					"content": "大丈夫、自分を信じて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "だってこの薬はどう見ても怖いよ！とにかく、これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205120310,
					"content": "俺の言ったことを忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
