			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏一"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "こんにちは、どうかしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030402,
					"content": "祠に供え物を捧げることについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "ああ…それね。何度か行ったことがあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030404,
					"content": "えへへ、僕は大きくなったら外の世界に行ってみたいって神様に頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030405,
					"content": "でも、お祈りをしても、普段きちんと勉強しなきゃだめなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030406,
					"content": "お父さんとお母さんが言ってた。外を旅行したいなら、お金がないとだめなんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030407,
					"content": "そう、だから神様にお願いすれば、きっとうまくいくよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030408,
					"content": "いや、それはちょっと違うよ。だって旅行に行ったら、たとえ稲妻の神様であろうとも外国にいる僕を守れはしないと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030409,
					"content": "親が言うには、神様にお祈りをするのって、安心感を得ることなんだって。願い事を叶えるには、やっぱり自分で努力しなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030410,
					"content": "詳しい道理は僕にも分からないけど、もっと知りたいなら、七月姉に聞いてみて。七月姉さんはこういうことに詳しいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030411,
					"content": "#うぅ…じゃあ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、七月姉さんのところに行ってみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弥生七月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "翔太？浮かない顔してるわね、誰かにいじめられたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030502,
					"content": "七月姉さん、城内のみんなが祠に供え物を捧げて、神様にお祈りをしてることは知ってるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030503,
					"content": "心を込めて祠に供え物を捧げれば、神様も応えてくれて、願いが叶う…そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030504,
					"content": "あら？どうしていきなりそんなことを…何かあったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030505,
					"content": "事の経緯はこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "まったく…そんな考えを持ってたから、あんなに積極的に供え物を捧げてたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030508,
					"content": "うん！誠心誠意、神様に供え物を捧げてたんだけど、供え物が誰かに取られちゃって…。これじゃ、神様もきっと僕を責めて、もう守ってくれないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030509,
					"content": "もう…安心して、神様はそんなことくらいで怒らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030510,
					"content": "そ、そうなの？ならよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030511,
					"content": "でも同様に、神様は供え物で誰かを守ったりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030512,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030513,
					"content": "みんなが供え物を捧げたり、神様のご加護を祈ったりするのは、自分の願いを叶えてほしいからじゃなくて、「自信」を持つためなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030514,
					"content": "自信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030515,
					"content": "「神様の前で言ったからには、頑張ってやり遂げないといけない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030516,
					"content": "「神様のご加護があれば、努力は必ず報われる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030517,
					"content": "そういう「自信」を持つことで、自分の願いに向かって全力で進むことができるの。それが、みんなが祠にお祈りをしに行く理由よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030518,
					"content": "だって…結局は人々の努力によって決まるの。もし神様に祈ってばかりで、自分で行動しなかったら、神様が助けたいと思ってもできないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030519,
					"content": "で、でも！この前祠に供え物を捧げたら、神様が助けてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030520,
					"content": "あの火災とか、強くなりたいおじさんとか、僕の漫画とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030521,
					"content": "（まだ神様のこと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "ええ…確かに。どうやらこの神様は願いを直接叶えてくれるみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030524,
					"content": "でも、今回は試験もなくなってなかったし、僕をいじめる彼女もいなくなってなかった。毎日僕に勉強しろってしつこく言ってくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030525,
					"content": "うーん、ちょっと待って。その「いじめ」をする人って、名前は何？いつ現れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030526,
					"content": "彼女の…名前は…えっと…なんだっけ？えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030527,
					"content": "一緒に入学して…いや違う、僕よりも先に…いや後だったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030528,
					"content": "おかしいな…なんか、思い出せない。分かるのは毎日僕に勉強しろって言う女の子が一人いるってことだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030529,
					"content": "うん、どうやら、神様は今回も願いを聞いて、試験の手伝いをしてるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030530,
					"content": "そ、それって、僕に勉強をさせるために神様が手配した人ってこと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030531,
					"content": "い、いやだ！勉強したくないし、試験もやりたくない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030532,
					"content": "うわっ！あいつが来た！あそこ、あそこから来てる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030533,
					"content": "どこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、彼女が見えないの！？手に試験用紙をたくさん持ってる！うわぁ！やめて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030536,
					"content": "どうやら、この神様はけっこう熱心なのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030537,
					"content": "この神様は気ままなんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "でも、神様が勉強を見てくれるなら、あの子も順調に試験を通過できるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030540,
					"content": "あの子がいつも祠の前で祈ってるから、神様もうんざりしたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030541,
					"content": "あれ、ちょっと待って。この道に葉っぱなんて、さっきまでなかったはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 728030538,
					"content": "神様がやるようなことじゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "全然見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "（全然分かってくれない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}