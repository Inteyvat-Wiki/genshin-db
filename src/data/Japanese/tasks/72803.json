			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"とげとげしい宝盗団メンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "コソ泥たちめ！お前たちが供え物を奪ったせいで、神様が応えてくれなくなったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030202,
					"content": "供え物？祠に置かれてたもののことか？勘弁してくれ、あんなもんタダでくれたっていらねぇよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "とげとげしい宝盗団メンバー"
				},
				{
					"id": 728030203,
					"content": "それに、あんなしょぼい供え物、神が応えてくれるわけねぇだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "とげとげしい宝盗団メンバー"
				},
				{
					"id": 728030204,
					"content": "ふ…ふざけるな！しょぼくなんかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030205,
					"content": "まあいい、俺はお前らにかまってやる時間なんてないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "とげとげしい宝盗団メンバー"
				},
				{
					"id": 728030207,
					"content": "ぼ…僕が神様に捧げた供え物は、しょぼくなんかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030208,
					"content": "どんな願いを叶えたいか教えてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "いいよ…もうこんなことになったし、願いも叶えられないだろうから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030210,
					"content": "僕には2つの願いがある、どっちも簡単なものなんだ。1つ目は、今後試験をしなくてもいいこと！試験がなければ、僕も叱られなくなるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030211,
					"content": "もう1つは…学校で僕をいじめてるやつがやめてくれること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030212,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も試験は嫌い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "そうでしょ！試験は本当に嫌いなんだ…でも、あのいじめっ子は試験よりも嫌いだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030216,
					"content": "彼女は僕が祠で試験したくないって言ってるのを見て、先生に僕の成績を聞きに行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030217,
					"content": "それ以来彼女はいつもこう言ってくるんだ。神様にお祈りするよりも勉強に時間をかけた方がいい、そんなにしつこくしてると神様もうんざりするって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030218,
					"content": "しかも彼女は、僕が…甲斐性なしだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030219,
					"content": "神様に何でも頼るのは確かによくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "でも大人たちが面倒事に遭遇した時も、祠で供え物を捧げてるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030221,
					"content": "それは祈りを捧げてるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "うぅ…僕、わからないよ…みんな神様に問題を解決してもらうために、祠に供え物を捧げてるんじゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030224,
					"content": "他の人に聞いてみようよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030225,
					"content": "うぅ…そっか。でも何がどうあれ、僕の願いはきっと叶えられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030222,
					"content": "最後は自分で解決しないとだめ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "いじめっ子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "僕と一緒の学校に行ってる人なんだけど…彼女、すごく理不尽なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 7280304,
			"completionStepIds": [
				7280306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280306",
							"2"
						],
						"stepId": 7280306,
						"stateName": "QUEST_STATE_UNFINISHED"
