				{
					"id": 721650506,
					"content": "ふむ…「霊草」の明滅から見て…幸運じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650507,
					"content": "北東にある遺跡、海の上の古城で、旧日の霊がお前さんらを導くじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650508,
					"content": "じゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650509,
					"content": "運命に定められた報酬を手にするには…そやつのために扉を開け、永久なる甘い眠りの巣に帰らせる必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650510
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650510,
					"content": "うぅ…古城とか、巣とか…わけわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650511,
					"content": "ふふ、大丈夫じゃ。私はずっとここにおる。頭が回らない時は、私に聞くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650512,
					"content": "えっ、オイラのことバカだって言ってるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
