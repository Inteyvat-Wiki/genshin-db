			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "帰ってきたんじゃな、何か用でもあるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650102,
					"content": "占ってほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#オイラも{NICKNAME}が今日どんな運勢なのか知りたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650104,
					"content": "ふむ…「霊草」の葉の模様から見て…幸運じゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650105,
					"content": "二人とも、海祇島の一番高い場所、神を祀る古き地で、幸運に出会えるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650106,
					"content": "うーん…オイラはその模様を見ても全然わからなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650107,
					"content": "ふふ、年寄りの知恵じゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650108,
					"content": "そのごまかした感じの答え…あやしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7216502,
			"completionStepIds": [
				7216503
			],
