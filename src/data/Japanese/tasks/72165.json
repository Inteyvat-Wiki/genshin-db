			"dialogs": [
				{
					"id": 721650201,
					"content": "こんにちは、若者よ。今日はどうしたんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650202,
					"content": "占ってほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "ふふん、今日はどんな運勢なのかな～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650204,
					"content": "ふむ…「霊草」の予言から見て…厄運だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650205,
					"content": "二人とも、海祇島の南の洞窟、賊の拠点で、予期せぬ厄運に遭遇するじゃろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650206,
					"content": "えっ、厄運だ！じゃあその場所は避けた方がよさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650207,
					"content": "ふふ、じゃがのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650208,
					"content": "厄運を克服すれば、予想外の収穫があるかもしれぬぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650209,
					"content": "収穫…？お宝か？お宝なのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650210,
					"content": "そうは言ってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650211,
					"content": "おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650212,
					"content": "じゃが違うとも言ってないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650213,
					"content": "おい！なんなんだよこのおばあさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
