						721650305
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650305,
					"content": "珊瑚宮の下、海祇島の中央の深い池の周りで、善良な雷の精霊がお前さんらを導くじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650306,
					"content": "わぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721650307,
					"content": "占いはとても御利益のあるもの、当たるはずじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "小巻"
				},
				{
					"id": 721650308,
					"content": "ふん、そう言われると逆にあやしくなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "パイモン"
				},
				{
