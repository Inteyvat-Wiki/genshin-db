			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ペドラッシュ",
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "よかった、あなた方もお目覚めになったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "ペドラッシュ"
				},
				{
					"id": 130150102,
					"content": "皆さん次々と目を覚まし、街は良い知らせで溢れています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "ペドラッシュ"
				},
				{
					"id": 130150103,
					"content": "どうやら、この件も無事解決したようですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "ペドラッシュ"
				},
				{
					"id": 130150104,
					"content": "ええ、結構大変だったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150105,
					"content": "後で大勢の人が来るはずだから、会場の秩序維持をお願いできるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150106,
					"content": "#私は{M#彼ら}{F#彼女たち}と一度、教令院に行ってくるわ。すぐに戻るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シト",
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "草神様、どうなさいましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150202,
					"content": "学籍情報を調べたいの。クシャレワー学院の学者で、昏睡状態になっている人はいないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150203,
					"content": "かしこまりました、少々お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150204,
					"content": "しばらくして。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "お待たせいたしました、草神様。確かにそのような学者が一人おります。名前はべノニ、アーカーシャの違反操作により昏睡状態に陥っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150206,
					"content": "現在に至るまで意識は回復しておらず、今もなお「ビマリスタン」で治療を受けています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150207,
					"content": "えっ？モセイスって名前じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150208,
					"content": "正体を隠すためだったのでしょう。誰にも邪魔されたくなかったのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150209,
					"content": "ここに保存してある知識を、マハマトラに渡してくれるかしら。これをべノニの脳へ導入するよう頼んでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150210,
					"content": "かしこまりました、ただ安全性の考慮から、理由についてお伺いできますでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150211,
					"content": "簡単なことよ。この中にあるのは彼の意識、以前まである夢境に囚われていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150212,
					"content": "彼は夢境の中でスメールの治安に影響が出るようなことをした。彼が目を覚ました後、私から大マハマトラに状況を説明するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150213,
					"content": "かしこまりました、すぐに取り掛かります。ありがとうございます、草神様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "シト"
				},
				{
					"id": 130150214,
					"content": "ううん、礼はいらないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150215,
					"content": "「モーメントオブドリーム」に人が集まっているでしょうし、そろそろ戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "オイラたちは静かに聞いてればいいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150302,
					"content": "ナヒーダ、なにを言うんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150303,
					"content": "先ほど目を覚ました人たち、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150304,
					"content": "あなたたちの心地よい夢の邪魔をしてしまって、本当に申し訳ないと思っているわ。夢境の中での対応も少し冷たいものになってしまったかもしれない、本当にごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150305,
					"content": "夢境にはとても不思議な力がある。強い心を持つ人に対しては、心を奮い立たせ、理想に翼を与えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150306,
					"content": "でも同時に、その状況を利用して認識を混乱させ、是正をひっくり返すこともあるの——不幸にも、あなたたちはその獲物に選ばれてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150307,
					"content": "前にも言ったように、私もまだまだ学習途中で、離別の苦しみを共感できると言えるほどではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150308,
					"content": "でも、ここに同じような経験をした人が少なくないことは、周囲を見れば分かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150309,
					"content": "あなたたちがここに集まり、共に未来へ向いていること、誇りに思ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150310,
					"content": "生命という道はとても長く、その終点を見透かすことは難しい。そのせいで、私たちは多くの疑問を抱くかもしれない——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150311,
					"content": "「生きている意味は何？目標は何？どうして苦痛を味わい続けなければならない？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150312,
					"content": "確かに、足を止め、考えることを放棄し、慣れ親しんだやり方を繰り返すことは、もっとも簡単な選択よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150313,
					"content": "でも、もしもそのような考えが頭に浮かんだら、身の回りの人と物事に目を向けてみてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150314,
					"content": "一日中頑張って働く人がいるのは、家族に温かい晩ご飯を食べさせたいと願っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150315,
					"content": "世を渡り歩く人がいるのは、テイワット中が共感できる芸術品を作り出したいと思っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150316,
					"content": "世界の秘密を探す人がいるのは、迫りくる名状しがたい災難を防ぎたいと考えているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150317,
					"content": "——自我は生命の意義のすべてではない。一つ一つの行動こそ、自我と世界を作り上げるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150318,
					"content": "家族や友人はあなたたちの行ったことを覚えているし、見知らぬ人だってあなたたちの行動から恩恵を受けるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150319,
					"content": "だからこそ、苦しみに耐えてでも新たな道を切り開こうとする人がたくさんいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150320,
					"content": "そしてあなたたちが同じ道を歩んだ時、それら究極の質問の答えは少しずつ見えるようになり、それと同時に重要ではなくなるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150321,
					"content": "だけど、もしもあなたたちが生命を虚無だと思ってしまえば、それは本当にだんだんと虚無へ向かってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150322,
					"content": "あなたたちには生き方を選ぶ自由がある。でも私は神として、先にあなたたちの目を覚ます必要があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150323,
					"content": "それでも現実を捨ててまで美しき夢を抱くかどうかは、あなたたち自身が決めることよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "ナヒーダは本当にすごいな。夢境にいた時、あの学者を言い負かせないんじゃないかって思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150402,
					"content": "彼は人間性の弱点を利用することに長けていたわ。おそらく、彼自身も以前からその渦中に陥っていたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150403,
					"content": "あの夢境には、言葉で言い表せないような誘惑があった。病みつきになるほど甘く、常人では明確な判断ができなくなるほどに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150404,
					"content": "でも目を覚ますことさえできれば、いつだって遅くはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150405,
					"content": "ナヒーダも成長したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "あら？どうして急にそんなことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150407,
					"content": "よく共感できてたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "そうだぞ。おまえは人間の感情がよく分からないって言ってたけど、おまえの迷いもオイラたちには見えてたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150409,
					"content": "さっきの演説も、あいつらの立場になって言ってたし、よくできてたと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150410,
					"content": "ありがとう。この一件で数多くの悲しい話を聞いて、何度も心を揺さぶられたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150411,
					"content": "被害を受けた人たちの行為が間違いだったとは言えないし、彼らの望んだものも決して過大ではなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150412,
					"content": "だから彼らが私たちに対抗し、夢境を守ろうとした時、私には彼らの選択を理解できたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150413,
					"content": "でも私の理解と感じたことは、彼らが本当に体験した苦しみに比べれば、百分の一すらないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150414,
					"content": "その「百分の一」を共感だなんて、私には到底思えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150415,
					"content": "ナヒーダは自分に対して厳しいな。それだって共感に入るに決まってるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150416,
					"content": "完全に共感することなんて誰にもできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "ふふっ、分かった。やっぱり外に出てみると成長できるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150419,
					"content": "感情と知識はまったく違うもので、明晰な言葉でそれを描写することはとても難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150420,
					"content": "べノニ…「モセイス」は、私が生離死別を経験したことがないと言っていたけど…私にはなんだか漠然と、そうじゃないような気がするの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150421,
					"content": "夢境に入った時、どうしてかとても暖かな熱流に包み込まれる感覚を覚えたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150422,
					"content": "その暖かさは、まるで自分が生命の原初状態に還り、二度と目覚めたくないほどのものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150423,
					"content": "（まさかナヒーダも何かを見た？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "でも再び目を開けた後、その感覚は消え、何の痕跡も残っていなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150425,
					"content": "例えるなら、白紙の上に書かれた字を消すようなもので、字は見えないけど、薄いヘコみだけは見える状態ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150426,
					"content": "あの夢境を経験した後、さらにはっきりと分かったわ。あの熱流が何を意味しているかは重要じゃないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150427,
					"content": "ただ確かなのは、私はかつてその暖かな力によって支えられ、今日まで来れたということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150428,
					"content": "その暖かさがどこから来るかに過度にこだわるのは、本末転倒というものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150429,
					"content": "さっき民たちにあれだけ多くの理想を語っておきながら、結局は自分もできないだなんて、そんなの面目丸つぶれじゃない、ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150430,
					"content": "（マハールッカデヴァータは自分の行動でナヒーダを形作った。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "（たとえ世界が彼女を忘れても、ナヒーダの思考と意識が彼女の「存在した」証となる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "（真実を伝えるより、彼女たちの考えを尊重すべきだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "どうしたんだ？急に暗い表情になって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130150434,
					"content": "何度も何かを言いたげだったけど、私に伝えたいことでもあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150435,
					"content": "何を言いたいか忘れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "ふふっ、そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150438,
					"content": "なら、目を覚ましたのだし、体を伸ばしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150439,
					"content": "新たな一日が始まるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 130150436,
					"content": "別に重要なことじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "もっと自信を持って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
