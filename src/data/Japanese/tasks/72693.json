			"trigger": {
				"objectNames": [
					"レネ",
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "大伴さんのこの詩は、稲妻の詩歌の形式を打ち破りながらも、稲妻の古典的な方法を使って、人生の忘れがたい様々な思い出を挙げている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726930602,
					"content": "大伴さんが言いたいのは、モンドと稲妻はまるで違うように見えても、共通した美しさがあるということだ。僕たち二人も、モンド人や稲妻人という身分を忘れて、ただの詩人として交流している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726930603,
					"content": "レネさんはお若いのに、詩に込めた想いをこうもすぐ理解するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930604,
					"content": "忘年の交わりなど、ただの戯言に過ぎないと思っていたが…今になって初めて、それが意味あることだと分かった。なんと嬉しいことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930605,
					"content": "#それに、ここまで力を貸してくれた{M#兄さん}{F#姉さん}、俺たち三人がここで出会えたのは、まさに縁あってのこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930606,
					"content": "うん、稲妻までの旅は大変だったが、今はもう気にしていない。モンドに戻ったとしても、僕が稲妻で見たものすべては記憶に残っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726930607,
					"content": "これも君が写真を撮ってくれたおかげだ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726930608,
					"content": "将来、いつかまた三人で会えるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930609,
					"content": "ああ、必ず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レネ"
				}
			]
		},
