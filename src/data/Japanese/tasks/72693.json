					"大伴",
					"レネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "#{M#兄さん}{F#姉さん}、来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930102,
					"content": "昨日のレネさんの詩からは、俺たちが「もっと早く知り合えていたらよかった」という思いが伝わってきた。だから、俺からも彼に詩を一つ贈りたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930103,
					"content": "大伴さんから詩をプレゼントしてもらえるなんて、実に光栄だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726930104,
					"content": "俺はもういい年だが、モンドの友人と何人か知り合えたことで、あの国に興味を持つようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930105,
					"content": "この詩は、モンドの吟遊詩人の書き方を参考にしようと思っている。モンドの景色を取り入れたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930106,
					"content": "#だが、俺はモンドに行ったことがない。そこで{M#兄さん}{F#姉さん}、<color=#00E1FFFF>モンドの特産</color>の写真を撮ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930107,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "#ははっ、じゃあ頼んだよ、{M#兄さん}{F#姉さん}。これまでと同じように、4枚あれば十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
