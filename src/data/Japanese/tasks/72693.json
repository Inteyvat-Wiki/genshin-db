					"大伴",
					"レネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#{M#兄さん}{F#姉さん}、写真は撮れたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930202,
					"content": "撮ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "ありがとう。これら素材があれば、満足のいく詩を書けるはずだ。よし、少し考えさせてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930204,
					"content": "#{M#兄さん}{F#姉さん}、君が撮ってくれた写真を参考に詩を書いてみた。どれがいいか君が選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
		{
