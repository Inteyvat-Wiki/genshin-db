				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "実は最初、海祇島の神社は珊瑚宮ではなく、他の場所にありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210805,
					"content": "その場所とは海祇島の七天神像の近くです。当時、海祇島は幕府ほど将軍を崇拝してはいなかったのですが、少なくとも彼女の存在を認めてはいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210806,
					"content": "ですが、あの一太刀が振り落とされ、海祇島を守護する魔神が斬られたことで、かつての神社は放棄されたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210807,
					"content": "その頃より、海祇島と幕府の関係は微妙なものとなり、互いの偏見はより深まっていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210808,
					"content": "今回の和平交渉において、私もこの問題を天領奉行ときちんと話し合いするつもりでした。怨嗟というのは、いつか必ず解決しなければならないものですので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210809,
					"content": "珊瑚宮様、本日はどのような要件でここへ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "用高"
				},
				{
					"id": 120210810,
					"content": "なんだか顔色が以前に比べて良くない気がします。自分を労わることをお忘れなきよう。あなたは私たちが一番頼りにしているお方ですので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "用高"
				},
				{
					"id": 120210811,
					"content": "はい、ご安心を。私は大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210812,
					"content": "珊瑚宮様、どうか今一度お考えを。幕府軍とは長くに渡り戦ってきました、このまま和平交渉をするなんて納得できません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "結菜"
				},
				{
					"id": 120210813,
					"content": "彼らと和解したら、かつて我々を守護してくださった魔神の死が無駄になってしまいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "結菜"
				},
				{
					"id": 120210814,
					"content": "おいおい、いい加減にしろって。いつの時代の話をしてるんだ。戦争は終わったんだ、安心した暮らしができればいいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "用高"
				},
				{
					"id": 120210815,
					"content": "それは、もちろん分かる…じゃが…はぁ、少なくとも主導権はこちらが握るべきじゃ、妥協なんてもってのほか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "結菜"
				},
				{
					"id": 120210816,
					"content": "安心してください、このことは再度考え、最善を尽くしますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210817,
					"content": "よかったです…どうかお願いします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "結菜"
				},
				{
					"id": 120210818,
					"content": "あら、珊瑚宮様？こんなところで会うなんて思ってもいませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "志織"
				},
				{
					"id": 120210819,
					"content": "私の娘、今年巫女選抜に参加することになったんです。あの子が珊瑚宮に入ればこの先も安心です…珊瑚宮様はお優しいので、きっとよくしてくれますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "志織"
				},
				{
					"id": 120210820,
					"content": "機会があれば珊瑚宮様にご教授してもらいなさいって、いつも娘に言ってるんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "志織"
				},
				{
					"id": 120210821,
					"content": "ほら、珊瑚宮様ってお若いのにすでに人との接し方を心得ていて、聡明でいらっしゃるでしょう…うちの娘もずっと珊瑚宮様をお手本にしているんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "志織"
				},
				{
					"id": 120210822,
					"content": "彼女が珊瑚宮に入った時は、気にかけておきますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210823,
					"content": "珊瑚宮様！やっと会えました。今年の農作物の生産量が減少した問題についてご報告したいんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "岩田"
				},
				{
					"id": 120210824,
					"content": "#珊瑚宮様、こちらはメカジキ二番隊の隊長ですよね？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はこれからも海祇島に残るのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "亮子"
				},
				{
					"id": 120210825,
					"content": "珊瑚宮様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "幸也"
				},
				{
					"id": 120210826,
					"content": "ふぅ…皆さん落ち着いてください、すべてお聞きしますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210827,
					"content": "ですが、時間のかかる問題は報告書にまとめて珊瑚宮まで届けてください。時間の空いた時にきちんと処理します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210828,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}さん、大丈夫ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210830,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "ふふ…どうやらあなたはこのような場面に慣れているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210834,
					"content": "珊瑚宮様、ここにいらしたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210835,
					"content": "報告したいことが。祭礼用の道具がなかなか届かず、何者かに奪われたのではないかと思っているのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210836,
					"content": "それならもうすでに取り戻しました、ご心配なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210837,
					"content": "そうだったんですか？さすが珊瑚宮様です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210838,
					"content": "それと、ここ最近の公文書を簡単にまとめて珊瑚宮様の机に置いておきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210839,
					"content": "また予定ですと、この後より繊維産業の発展に関する会議があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210840,
					"content": "予定…今からですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210841,
					"content": "はい、遠くからいらしたお二方がすでに珊瑚宮様をお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "和泉那希"
				},
				{
					"id": 120210842,
					"content": "#わかりました…{NICKNAME}さん、今日はあなたに海祇島を紹介しようと思ったのですが、どうやら先に要件を済ませる必要があるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210843,
					"content": "明日、珊瑚宮の門の前で会いましょう。それから、共に祝賀会の準備を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210844,
					"content": "祝賀会！美味しいもんがいっぱいあるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120210845,
					"content": "ふふ…もちろんありますよ。海祇島の特産を使った美食、あなたたちにも味わってもらいたいものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210846,
					"content": "やったー！じゃあ、また明日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120210847,
					"content": "はい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210832,
					"content": "ちょっと疲れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "そうですよね、私も少し頭痛が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "珊瑚宮心海"
				}
