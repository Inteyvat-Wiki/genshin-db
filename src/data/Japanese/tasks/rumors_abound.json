				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "ですが、まさかファデュイがヒルチャールの拠点に潜み、これほど長くここで陣取っていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210202,
					"content": "彼らの目的は何なのでしょう？まさか、本当に兵士たちの言っていたように、天領奉行と結託を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210203,
					"content": "この拠点を詳しく調査しましょう。あの商人が嘘をついていないのでしたら、品物はここにあるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210204,
					"content": "おう！辺りを見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
