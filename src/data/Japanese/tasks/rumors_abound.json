					"内村"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "それは！私の品物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210402,
					"content": "ありがとうございます！珊瑚宮様！隊長様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210403,
					"content": "どうですか、冤罪だと言ったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210404,
					"content": "ふん…どうだが。とっくにファデュイと話をつけてた可能性もあるかもしれないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210405,
					"content": "ファデュイの拠点で得た情報から見て、彼はたしかにファデュイと関わりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210406,
					"content": "ファデュイのやり方を考えれば、何か証拠を残しているはずですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210407,
					"content": "しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210408,
					"content": "しかしも何もありません。品物は取り戻しました。先般の約束通り、彼の汚名を晴らすべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210409,
					"content": "申し訳ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210410,
					"content": "軽率でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210411,
					"content": "ふふん…日頃から仕事をまともにしていない間抜けなあなたたちが、こうして面倒を引き起こすんですよ…やっと自分の間違いに気付きましたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210412,
					"content": "商人さん、それを言うのはまだお早いかと。潔白を証明したとはいえ、わざと必需品を買い溜めすることは、今の政令によって罰せられる行為となっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210413,
					"content": "これらを自分の品物だと認めた以上、私たちもそれ相応の対処をしなければなりません。適正価格での販売に加え、罰金も課します。金額は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210414,
					"content": "ちょっ、ちょっとお待ちを！珊瑚宮様、私の味方だったんじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210415,
					"content": "もちろん違いますよ。私は海祇島の「現人神の巫女」、「信賞必罰」の理念に従うのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210416,
					"content": "功績ある者は賞し、罪ある者は罰する。汚名を晴らした後は、自身の行為に対して代価を払う番です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210417,
					"content": "そ、そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "成瀬"
				},
				{
					"id": 120210418,
					"content": "ほら、連れてくぞ！罰金を払いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "松田"
				},
				{
					"id": 120210419,
					"content": "珊瑚宮様、この者が品物を自分の物だと言いましたが、やはり少々気がかりなことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210420,
					"content": "天領奉行の印がある物は彼ので間違いないでしょう。しかし、他の品物を見るとそうではないようです。特にこれらは明らかに神社で使われる物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210421,
					"content": "ええ…大方、ファデュイが余所から奪った物も混じっているのでしょう。他の品物については、持ち主を探しておいてください。神社関係のものは私が対処します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210422,
					"content": "あなたたちには苦労をかけますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210423,
					"content": "いえ、とんでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210424,
					"content": "しかし珊瑚宮様、証拠を掴むことはできませんでしたが、天領奉行とファデュイの結託は、私たちの仲間がこの目で見たことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210425,
					"content": "和平交渉について…今一度お考えを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "内村"
				},
				{
					"id": 120210426,
					"content": "わかりました。しっかりと考慮しておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210427,
					"content": "私はこれら神社関連の物を持って珊瑚宮に戻ります。よければ、一緒に行きませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 1202108,
