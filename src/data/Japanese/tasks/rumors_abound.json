			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "商人の言っていたファデュイの拠点は、こちらで間違いなさそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210102,
					"content": "置いてあるものを見たところ、ここは元々ヒルチャールの拠点だったのでしょう。それがなぜかファデュイに占拠されてしまっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210103,
					"content": "うわ…すごく守りが固そうだ。オイラたち本当に入れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120210104,
					"content": "力ずくで突破するのは難しいかと。ですが問題ありません、ここは私たちにとって有利な地形です。それに私たちがいることも相手に露見していません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210105,
					"content": "敵は明所、こちらは暗所、策謀を張り巡らすのに絶好の機会です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210106,
					"content": "軍師様はどうお考えで？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "私の考えでは、三つの策があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210108,
					"content": "一つ、擒賊擒王。稲妻に残っているファデュイの勢力は微々たるものです、その多くは敗れた残党。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210109,
					"content": "高所から飛び降り、敵の大将を仕留めることができれば、雑兵を討たずとも勝利を得られるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210110,
					"content": "二つ、虎の威を借る。あちらをご覧ください、火薬樽が積まれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210111,
					"content": "彼らが気付かないうちに火薬を起爆できれば、大打撃を与えることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210112,
					"content": "不意を突かれた相手は確実に動揺し、戦力も大幅に低下するでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210113,
					"content": "そして最後、地の利を活かすこと。ここは海の近く、水気に覆われています。周囲の水蒸気を集め、あなたの雷で麻痺させることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210114,
					"content": "さすが心海、こんなに早く策を思いつくなんて！で、結局どの策でいくんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120210115,
					"content": "この三つの策にある大きな違いは、実行者の自身に対する判断能力にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210116,
					"content": "上方から飛び降り、拠点を奇襲する。最も早く解決できる方法ですが、高い武力を求められます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210117,
					"content": "爆発で相手の人員を瞬時に減らせば、正面からの戦いを避けられるでしょう。しかし、気配を消し、隠密行動する必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210118,
					"content": "そして地の利を活かすには、着実に戦いを繰り広げる必要があるため、持久戦になる可能性があるでしょう。どの戦術がいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210119,
					"content": "拠点の奇襲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "ふふ…さすがメカジキ二番隊の隊長、ご自身の実力に自信があるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210121,
					"content": "この戦術を選んだからには、共に戦いましょう。私は武闘派ではありませんが、ある程度の支援はできます。あなたを一人で戦わせたりはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210122,
					"content": "彼らをいち早く倒し、商人の品物を取り戻しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210123,
					"content": "爆薬の起爆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "ふふ…私と同じように、奇策に興味があるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210125,
					"content": "私もこれが一番好きな戦術です。何と言っても危険が最も少ないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210126,
					"content": "しっかりと作戦を練り、彼らに「驚き」をあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210127,
					"content": "感電作戦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "はい、彼らを拠点から引きずり出せば、拠点の状態を保ったままにすることができますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210129,
					"content": "ですが私たちはこれまで、共に戦う機会がそれほど多くはありませんでした。あなたについていけるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210130,
					"content": "でもご安心ください。私は武闘派とはとても言えませんが、長らく隊に身を置いていたので、このような場面にも対処できると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120210131,
					"content": "ファデュイの拠点を片づけ、すべてを明らかにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
