			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"咲耶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "こんにちは！花の鉢植えを体験しませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580102,
					"content": "花の鉢植え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "あっ、興味ありますか？詳しく知らなくても大丈夫です、簡単に説明しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580104,
					"content": "私の名前は咲耶。花を育てながら、花に関する商売をしている花職人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580105,
					"content": "あははっ、商売と言っても、ほとんどの場合、花を配達したり、お店で「生け花」を作ったりしているだけですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580106,
					"content": "生け花って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "えっ？知らないのですか？「生け花」は稲妻ではとても重要なものですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580108,
					"content": "「生け花」とは、簡単に言えば、花や植物を丁寧に切って、それを適切な形で配置することですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580109,
					"content": "具体的な操作となると…花や植物を切るには、植物の状態を細かく把握し、見栄えの悪いところを丁寧に直す必要があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580110,
					"content": "そして置く時は、場所の雰囲気に合わせて調整します。時には、花が外へ伸びる角度まで気を配る必要があります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580111,
					"content": "これらの細かなところは、隅々まで考慮しなければなりません…極めて面倒なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580112,
					"content": "生け花が好きな私からしても、この仕事は十分に疲れるのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580113,
					"content": "昔は、町中にお店を持っていたのですが、町があまりにも騒がしく、生け花をする気になれませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580114,
					"content": "そこで店を閉めて、私自身の花畑のそばでお客さんへのサービスを提供することにしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580115,
					"content": "しかし…店は静かになりましたが、商売も少々減ってしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580116,
					"content": "そのため、町に来て「咲耶の花屋」を宣伝する計画を考えたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580117,
					"content": "私はこの計画を…「花咲きし夢」と呼んでいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580118,
					"content": "具体的な計画は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "具体的には、お客さんが花を育て、自分で生け花を作るというイベントです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "咲耶"
				},
				{
					"id": 726580120,
					"content": "もし興味があって体験してみたいと思いましたら、私に教えてくださいね。花の鉢植えでも、生け花の体験でも、どちらも楽しいものですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咲耶"
				}
			]
		}
	]
}