			"dialogs": [
				{
					"id": 200210101,
					"content": "どうして風の翼を使うのに飛行免許がいるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210102,
					"content": "お兄ちゃん、飛行免許って取ったことある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210103,
					"content": "俺は風の翼を使うことが無いからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200210104,
					"content": "飛行免許がほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "だって風の翼は、冒険の必須道具でしょ。だから使い方を学んでおこうと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210106,
					"content": "でもまさか…飛行免許が必要だなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210107,
					"content": "試験には応募したけど…まだ全部は覚えられてないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210108,
					"content": "ねえ、アンバーさんから聞いたんだけど、あなたは飛行免許を持ってるんだよね？私に教えてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210109,
					"content": "アンバーが試験官なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "ううん、応募した時にアンバーさんと会っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210111,
					"content": "彼女から飛行免許のテストについて教えてもらった時、あなたのことをすごく褒めてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210112,
					"content": "だから、あなたに色々と教えてもらえたらと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210115,
					"content": "それじゃあ…三つ質問させてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210116,
					"content": "えっと…まず一つ目の質問ね。飛行する時、一つの風の翼を最大何人で一緒に使える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200210113,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "よかった！じゃあお願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "アナ"
				}
			]
		},
