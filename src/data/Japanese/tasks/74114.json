			"dialogs": [
				{
					"id": 741140401,
					"content": "この鍋、変わった形ね…うーん、でも使い方はきっと璃月のと一緒よね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140402,
					"content": "社長、食材を買ってきましたよー。でも、あの店のマルコット草は売り切れでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140403,
					"content": "他に売ってる店を今すぐ探すのも難しくてぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140404,
					"content": "#ああ…この食材だけが足りないのね。えっと、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140405,
					"content": "調達してくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "ありがとう。安心して、私も冒険者の掟は分かってるもの、絶対に損はさせないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140406,
					"content": "報酬に足しておいてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
