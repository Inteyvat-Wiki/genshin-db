			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}、紹介するわ。この方が映影マスターのガイサート先生よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140602,
					"content": "#ガイサート先生、こちらは{NICKNAME}といって、とっても腕のいい冒険者なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140603,
					"content": "#今後アクション系の映影を撮りたいなら、{NICKNAME}は最高の演者になると思いますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140604,
					"content": "はは！邱社長も大げさだな。僕は映影マスターなんかじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140605,
					"content": "僕はただ、映影の光と影の使い方についてちょっと研究しただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140606,
					"content": "まあ、ご謙遜を。先生の映影の光と影の使い方は、まるで見る者に語りかけてくるみたいなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140607,
					"content": "映影の光と影の使い方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "ああ。僕の映影理論において、光と影の使い方はまさしく感情の使い方なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140611,
					"content": "でも…そうだな…今のフォンテーヌの映影業界では、僕の理論はあまり重視されてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140612,
					"content": "ほとんどの監督は直接的な動作を多用するし、シーン自体を使って映影のストーリーを表現したりもするね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140613,
					"content": "僕は純粋な光と影の変化を使って叙情を表現する映影をいくつも制作したけど、ほとんど誰も興味を持ってくれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140614,
					"content": "でも、今になってやっと一人の監督が僕の光と影の理論に価値があることを認めてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140615,
					"content": "監督？私が？ふふふっ、冗談はやめてくださいよ。ちょっと前まで茶葉を売ってたんですよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140616,
					"content": "茶葉商人が監督になれないなんて誰が決めたんだい？僕だって元はしがない記者だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140617,
					"content": "記者…じゃあ、以前は報道記事を書くのも得意だったんでしょう？新聞に載る記事みたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140618,
					"content": "まあね。それがどうかしたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "ガイサート"
				},
				{
					"id": 741140619,
					"content": "へえ…ちょうどいいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140620,
					"content": "あっ！な、何でもないんです！私たち、これからも協力できそうだなって思って、ふふふっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140621,
					"content": "邱社長の朗らかな笑い声の中、皆は席についた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "食事が終わった頃、邱社長はもう一品料理を作ると、それを包んであなたのカバンに押し込んだ…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "光と影は、映影にとってそんなに重要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "もちろんさ。僕の映影理論において、光と影はその画の感情を伝えるための大事な方法だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "ガイサート"
				}
			]
