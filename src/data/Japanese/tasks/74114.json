			"dialogs": [
				{
					"id": 741140301,
					"content": "#ああ、{NICKNAME}！やっぱりあなたは頼りになるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140302,
					"content": "あなたが助けてくれなかったら、映影フィルムが全部駄目になっちゃってたところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140303,
					"content": "とにかく街に戻って、この映影フィルムをガイサート先生に渡しましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140304,
					"content": "#それから…ついでに食事もね。{NICKNAME}、もし良かったら一緒にどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140305,
					"content": "食事が終わったら、報酬をお渡しするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140306,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "よし！じゃあそれで決まりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140309,
					"content": "弈豊、あなたは後でこの映影フィルムをガイサート先生のところに届けてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140310,
					"content": "興曄は…美味しい食材を買い込んできて。最近ポワソンシーフードスープを研究してたのよね。せっかくだからガイサート先生に披露しようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140311,
					"content": "社長、レストランで食事するんですよね。どうして自分でやるんですかー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 741140312,
					"content": "だって…そのほうが安上がりだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140313,
					"content": "コホンッ！とにかく急いで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}、あなたは私と来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140307,
					"content": "ちょうどお腹が空いてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
