			"dialogs": [
				{
					"id": 741140201,
					"content": "はぁ…映影フィルムが水没して駄目になってないといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 741140202,
					"content": "社長、大丈夫ですよ。この箱は頑丈ですし、そう簡単に水が入り込んだりしませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 741140203,
					"content": "映影機まで水に落とさなくてよかったー。もしそうなってたら完全に終わりでしたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "興曄"
