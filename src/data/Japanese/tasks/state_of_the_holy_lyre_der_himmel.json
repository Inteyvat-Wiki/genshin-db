			"dialogs": [
				{
					"id": 3790401,
					"content": "よし、想像通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790402,
					"content": "何だか…どんどん若々しくなっていく感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790403,
					"content": "団長も一緒にか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790404,
					"content": "…天空のライアーの話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790405,
					"content": "#{NICKNAME}が結晶を浄化してくれたおかげで、何とか天空のライアーの「風」元素がこれ以上枯れることを防いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790406,
					"content": "けど、満タンになるまでまだまだ足りないね。トワリンの涙がもっとあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790407,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "でもどうやって涙の結晶を集めるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790411,
					"content": "今でも、トワリンは泣いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790412,
					"content": "苦しみを抱えて、ひと気のないところでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790413,
					"content": "トワリン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790414,
					"content": "かわいそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790415,
					"content": "これは栄誉騎士だけが抱える問題じゃない。私たちもすぐ行動に移そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790416,
					"content": "#涙の結晶を入手したら、また栄誉騎士{NICKNAME}に浄化を依頼させてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790417,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "うん…いいね。英雄たちが互いを信じ、一緒に旅に出る展開、最高だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790419,
					"content": "この曲でみんなを見送ろうかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790420,
					"content": "おい、おまえ…サボって口だけ出すつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790421,
					"content": "弦を弾くのには、手も必要だけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790422,
					"content": "うぅ、むかつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790423,
					"content": "よし…決めた、おまえのことを<color=#00E1FFFF>「吟遊野郎」</color>って呼ぶぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790409,
					"content": "どうやって涙の結晶を集める？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "どうやって泣かす？殴る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
	]
