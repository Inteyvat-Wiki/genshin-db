			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "お～、おかえりなさい、ボクのファンたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790202,
					"content": "あっ、それは…天空のライアー！うまくいったみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790203,
					"content": "風が流れるような模様と薔薇の木の木材、少し冷たい星鉄の弦、懐かしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790204,
					"content": "どうだ？それを使ってトワリンを呼べそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3790205,
					"content": "うん…確かに本物の風神の至宝だけど、今はまだ無理だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790206,
					"content": "——みんなが見た通り、千年の時を経て「風」の力はとうに枯れてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790207,
					"content": "ディルックの酒場で歌うくらいなら、できなくはないけど…この状態じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790208,
					"content": "僕の酒場のステージに出演したい歌手はたくさんいる、君の番は到底来ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3790209,
					"content": "ディルックの旦那、ツッコミどころそこじゃないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790210,
					"content": "おい！天空のライアーを手に入れたのは、酔っ払い相手に歌を聞かせるためなのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790211,
					"content": "えへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790212,
					"content": "「えへっ」てなんだよ…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3790213,
					"content": "とにかく、トワリンと話し合うには、これだとまだまだ足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790214,
					"content": "でも、問題はライアーじゃなくて、弦の方だ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790215,
					"content": "君の出番だよ、異邦人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790216,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "安心して、君に修理してもらうつもりはないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790219,
					"content": "「風」元素の濃度が、この弦にはまったく足りていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}、君はトワリンの涙の結晶をちゃんと保管してるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3790221,
					"content": "（頷く）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "楽器の修理はできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
		{
