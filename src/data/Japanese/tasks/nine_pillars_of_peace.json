			"dialogs": [
				{
					"id": 710051201,
					"content": "「貪欲、眷恋、凝視、嫉妬、憤怒、欲望、自矜、争奪、動乱…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051202,
					"content": "「九つの凡心は人を助けることがあれば、世の中の秩序を乱すこともある…ゆえに九つの柱で世間の紛争をここに鎮める。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051203,
					"content": "「九つの柱を壊す者が現れると、世間は再び戦乱にまみれるであろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "銘文"
				},
				{
					"id": 710051204,
					"content": "「この石碑を読んだ者は中で宝器を手に取り、璃月八方を守りたまえ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "銘文"
				}
			]
