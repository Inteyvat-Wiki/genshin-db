			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "この遺跡の中の雰囲気は少し気味が悪いよな。でも、ここがこの遺跡の終点のはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710050202,
					"content": "へへっ、収穫があってよかった！指輪を手に入れると思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710050203,
					"content": "この指輪はどれくらい売れるか、<color=#00E1FFFF>骨董品に詳しい人</color>に聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
