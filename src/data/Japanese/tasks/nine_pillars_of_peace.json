			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "骨董品を見てほしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "骨董品？よく聞いてくれたわ、この璃月港で骨董品に関する一番公正な見積もりを出せるのは、私だからね。さあ、見せてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050903,
					"content": "うん、玉石も指輪の素材自体もなかなかいいわね。歴史も相当長い…綺麗に保存されたのは珍しいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050904,
					"content": "でも、「世間の難、一切皆苦」は聞いたことがないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050905,
					"content": "まあいい、この指輪はどこで手に入れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050906,
					"content": "翠決坡の横にある遺跡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "翠決坡の横にある遺跡って…あんなところに行くなんて、あなたやるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050908,
					"content": "その遺跡の周辺に9本の柱と、その真ん中に石碑があったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050909,
					"content": "そう驚かないで、取引先からその話を聞いただけよ。あんな感じの遺跡にはきっとお宝がたくさんあるってね",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050910,
					"content": "あの柱と遺跡は璃月の先民たちが戦争を鎮めるために作ったって話も聞いたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050911,
					"content": "でも、それはただの伝説だと思うわ。9本の柱で戦争をなくせるなら、とうに世界平和になってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050912,
					"content": "伝説は本物かどうかはさておき、この指輪はあの遺跡のものなら、きっと伝説とも関係があるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050913,
					"content": "由緒正しいし、指輪自体もよくできてるから、いい値段で売れるのも当然よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050914,
					"content": "…安心して、どうやって遺跡に入ったかは聞かないわ。私は商売をするだけ、他のことは関係ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710050915,
					"content": "とにかく、この指輪、<color=#00E1FFFF>200000モラ</color>出すけど、どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
