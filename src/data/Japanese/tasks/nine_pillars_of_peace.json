						710050402
					]
				},
				{
					"id": 710050402,
					"content": "よしっ！さすがだ。さあ、金を受け取っておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050403,
					"content": "ハハッ、いいお宝を手に入れたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050404,
					"content": "あの遺跡にはきっと他にお宝が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
