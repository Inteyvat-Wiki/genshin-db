			"trigger": {
				"objectNames": [
					"博来"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "骨董品を見てほしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "骨董品か…そんなに詳しくないけど、ひとまず見せてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050303,
					"content": "この指輪…おや、この玉石は結構いいものだよ。玉石だけで結構売れるなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050304,
					"content": "中に字が刻まれてるな…「世間の難、一切皆苦」…この指輪は、どこから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050305,
					"content": "翠決坡の横にある遺跡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "翠決坡…残念だ、その横が絶雲の間なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050307,
					"content": "もしこの指輪は絶雲の間の遺跡からのものなら、きっといい値段になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050308,
					"content": "残念だ、仙人と関係がないなら値段はかなり低くなる。でも見た目は悪くないから、売れないこともないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050309,
					"content": "こうしよう、<color=#00E1FFFF>180000モラ</color>で売ってくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
