			"dialogs": [
				{
					"id": 710050501,
					"content": "少し考える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "…いいだろう。でも値段に関しては私が一番高いかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050503,
					"content": "もちろん商売に関しても、指輪を売ってくれるなら、絶対に損はさせないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050504,
					"content": "この指輪を私に売ってくれるなら、その後の取引も私が責任を持って報告するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050505,
					"content": "それに、私ならおまけも付けてあげるからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "博来"
				},
				{
					"id": 710050506,
					"content": "ゆっくり考えておくれ。売る気になったらいつでもおいで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
