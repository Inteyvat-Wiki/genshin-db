				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "八重宮司様、約束通り来ました。ご安心を、配下は連れてきていません。それにここへ来ることは誰にも知らせていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180202,
					"content": "約束通り来るとわかってたぞ、それに汝…ここ数日の間、胸がざわついて夜も眠れなかったのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180203,
					"content": "わ…私が当主様を疑うことなどありません。それは憶測です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180204,
					"content": "それで、証拠はどこに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180205,
					"content": "ここ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "ほぉ～、もう一人約束をしてた者も来たようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180207,
					"content": "これを手に入れるために、苦労したんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180208,
					"content": "裟羅に渡すといい、自分で判断せい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180209,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180210,
					"content": "…たしかに当主様の官印が…偽物ではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180211,
					"content": "抵抗軍、珊瑚宮、前線…どれも一言も触れていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180212,
					"content": "前線で命を落とした兵士、人々が受けている苦痛、どれも言うに値しないものとでもいうのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180213,
					"content": "命をなめている…どうしてこんな隠蔽を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180214,
					"content": "もちろん目狩り令を順調に遂行するためじゃ。それらを将軍が知って、目狩り令が廃止になったらならんからのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180215,
					"content": "天領奉行は…わざと将軍様に隠蔽を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180216,
					"content": "うむ。目狩り令の遂行で得するのが誰なのか…もう少し考えることじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180217,
					"content": "ここに手紙が一通ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "天領奉行とファデュイの間で交わされてた手紙だ。九条家の当主が隠してたものらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180220,
					"content": "どうじゃ？汝の見たかったもの、見たくなかったもの、すべて目の前にあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180221,
					"content": "よもや…見て見ぬふりはできぬじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180222,
					"content": "私が今まで続けていたことは…こんな…こんな…くそッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180223,
					"content": "裏切り行為を許すわけにはいきません…当主に会って直接話してきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180224,
					"content": "九条裟羅すごく怒ってたな、こちら側に引き込むことは成功したみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180225,
					"content": "幕府軍もこれで暫く指導者がいなくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "おう、彼女を追ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180228,
					"content": "待て、童。まだ話したいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180229,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180230,
					"content": "汝が初めて「一心浄土」に入ったのは、千手百目神像の前じゃったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180231,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "あの日の情景を再現するんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180233,
					"content": "千手百目神像の前で、雷電将軍の「心を開かせれば」、勝機は必ずやってくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180234,
					"content": "最善を尽くす。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "これを持っていけ、餞別じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180236,
					"content": "これは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180237,
					"content": "鳴神大社の御守り、御利益のあるもので、汝のために特別に残しておいたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180238,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "ふふ、絶体絶命の状態でそれを取り出せば、危機から抜け出せるかもしれぬぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180241,
					"content": "もちろん、妾に会いたいと思った時に取り出してくれても構わぬ。ひょっこり出てくるやもしれぬな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180242,
					"content": "こんな大事な時に冗談はよしてくれよ、狐お姉さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180243,
					"content": "ふふふ…悪いな。では、妾の愚鈍な友は、汝らに任せるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180239,
					"content": "大事にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "彼女についていけば雷電将軍に会えるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
