			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "お前たちも来たのか？度胸はあるようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180302,
					"content": "お前たちには証人になってもらう。当主への審問が終わるまで、捕らえられることはないと保証しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180303,
					"content": "だが…もしお前たちの言っていたことが誹謗であった場合、お前たちは帰れないどころか、罪を背負うことになる、いいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180304,
					"content": "望むところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "ふんっ、いいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180305,
					"content": "道を案内して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条孝行",
					"九条裟羅",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "やめろ！裟羅、気が狂ったか！私の禁令を無視するとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180404,
					"content": "当主様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180405,
					"content": "聞きたいことがあるんだろ？気迫に押されるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180406,
					"content": "チッ…孝行様、私は…奉行府の上奏とファデュイへの手紙を見ました。どうか…ご説明を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180407,
					"content": "遺失した上奏と手紙は、お前が盗んでいたのか？ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180408,
					"content": "では…あれらがすべてあなたの直々に書いた物であり、偽装ではないと認めるのですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180409,
					"content": "どうか私に教えてください、当主様、天領奉行は…本当に幕府を裏切ったのですか！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180410,
					"content": "ふん…私は確かにファデュイと連絡を取り合っている。お前が見た上奏も私が直々に書いたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180411,
					"content": "あっさり認めた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180412,
					"content": "目狩り令の発令と遂行に助力すれば、スネージナヤの使節と約束した利益を手に入れられるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180413,
					"content": "昔から九条家の地位を狙っているヤツらは多くいた、我々を陥れようとする家門も数え切れないほどいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180414,
					"content": "他国勢力の支持が得られる上に、目狩り令を通して敵の戦力を削れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180415,
					"content": "これほど割のいい取引はない。ただ、お前に知らせる必要がなかったと判断したまで、それだけだ、裟羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180416,
					"content": "あなたは…あれほどまで将軍様のことを崇拝していたのに、どうして裏切ったことをそんなに軽々しく言えるのですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180417,
					"content": "裏切る？これのどこが裏切りだと言うのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180418,
					"content": "あのファデュイたちは私に利用されているにすぎない、ヤツらに何ができるという？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180419,
					"content": "稲妻の国土において、天から雷が降り落ちれば、ヤツらは身を震わすことしかできないアリにすぎん。逆らうことなどできるものか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180420,
					"content": "なぜなら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180421,
					"content": "我々には天下無双の雷電将軍が、あの「無想の一太刀」があるのだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180422,
					"content": "雷電将軍を裏切ったんじゃなくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "おう…こいつが崇拝していたのは雷電将軍というよりも、彼女の武力と「無想の一太刀」みたいだ。しかも、狂信に近い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180425,
					"content": "では、忠義の心はどこに行ったのですか、当主様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180426,
					"content": "私が九条家に引き取られて以来、あなたから臣下としての忠義の道を教わってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180427,
					"content": "今思えば、それはただ私に九条家への忠誠を誓わせ、将来裏切ることがないようにするためだったのですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180428,
					"content": "先ほど言った道理は、自身の醜さと私欲を隠すための詭弁でしかありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180429,
					"content": "私欲？私は九条家の永遠を守ってきたんだぞ。将軍様はきっと理解してくれる、前当主様もきっと…きっと理解してくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180430,
					"content": "言いたくなかったんだけど、九条家は自分たちの力を過信しすぎじゃないか？ファデュイはそんな簡単にやっつけられる相手じゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180431,
					"content": "このまま話しても埒が明かない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "目狩り令が本当に正しいものかどうか…私も内心疑ったことはありました。私の心にある道義に背いてもやらなければいけない事なのか、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180434,
					"content": "しかし、それが将軍様の示す道である限り、最後まで善し悪しを判断することは誰にもできない、私はそう思ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180435,
					"content": "けれど今になって分かりました、永遠の道に終わりはないと。そしてその道は…すでにあなたたちの私欲によって穢されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180436,
					"content": "したがって、それを正すとしましょう。少なくとも、今まで私のしてきた決心に報いるためにも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180437,
					"content": "余計なことを考えおって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180438,
					"content": "行きたければ行くがいい、九条家の地位を揺るがすことは誰にもできん。お前が情勢を変えることはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180439,
					"content": "将軍様はいま<color=#00E1FFFF>天守閣</color>で、スネージナヤの使節を迎えている。そう——「淑女」と呼ばれている執行官だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "九条孝行"
				},
				{
					"id": 20180440,
					"content": "「淑女」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "稲妻の背後で起きたすべての元凶は、「淑女」だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180442,
					"content": "離島を離れた時、千里さんから言われたことがあったな…勘定奉行が身分の高そうな女性と会っていたって…あの時に気づけたはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180443,
					"content": "スネージナヤの使節…ちょうどいい、このままこの稲妻から立ち去れると思うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180444,
					"content": "九条裟羅が行っちゃったぞ。天守閣に乗り込む気なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180445,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちも、「淑女」に借りを返さないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180447,
					"content": "オイラたちも行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20180448,
					"content": "<color=#00E1FFFF>天守閣</color>へ向かう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20180432,
					"content": "九条裟羅の態度次第で状況が変わる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "雷電将軍の武力を過剰に信じてるだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
