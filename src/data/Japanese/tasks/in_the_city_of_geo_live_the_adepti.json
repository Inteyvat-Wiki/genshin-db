					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "よしっ、ここの怪物痕跡の調査も終わったし、そろそろ帰って…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030402,
					"content": "何者だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030403,
					"content": "嘉義に来るように言われたんだ。実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030404,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030405,
					"content": "総務司の仕事を応援してくれてありがとう。この件は受理した。すぐにスケジュールを調整しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030406,
					"content": "では、またいつか璃月港で会おう、熱心な旅人よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}、なんかさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030408,
					"content": "総務司の態度はあまり真面目じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "オイラもそう思ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030410,
					"content": "ここの人たちはきっと美味しいものを食べ慣れてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030411,
					"content": "でも荒野で旅をし、追いつめられると変なキノコも食べるような生活をしている旅人にとって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030412,
					"content": "おまえにとっては、海灯祭は特別だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030416,
					"content": "だから昨日、ヤツを目撃した場所に戻ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030417,
					"content": "お巡りさんから聞いた話だけど、犯人は現場に戻りたがるらしい。きっとアイツもそうだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030418,
					"content": "まだ事件は発生していないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "だからこそ急がないと。事件が発生したら終わりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030413,
					"content": "やはりこちらで問題を解決しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "オイラもそう思ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030415,
					"content": "今までの経験から考えると。この件は最後まで関わったほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "パイモン"
				}
			]
		},
