					"嘉義"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "君たち…ああ、昨日情報を提供した二人か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400030202,
					"content": "はあ…実を言うと、海灯祭期間の総務司は大忙しで、調査する人手が足りないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400030203,
					"content": "えッ！？そんなーー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030204,
					"content": "せっかく情報を提供してくれたのに申し訳ない…そうだ、もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400030205,
					"content": "もしかしたらうちの小隊は手伝えるかもしれない。今行っている任務は今日で最後なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400030206,
					"content": "帰離原で怪物退治してるから、もし君たちが連絡してくれるなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉義"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
