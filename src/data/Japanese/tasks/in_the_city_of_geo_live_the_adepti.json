			},
			"dialogs": [
				{
					"id": 400030901,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030902,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}、どうしよう？コイツ話が聞いてくれるようなヤツじゃない気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030904,
					"content": "うわっ、な、なんか、善人じゃないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030905,
					"content": "感覚だけで「善悪」について評論しないでもらえないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030906,
					"content": "が、確かに我は悪鬼、妖や魔障を斬る護法夜叉、魈だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030908,
					"content": "この単語、最近聞いたばかりだった気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "パイモンは「夜叉」を知っているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "護法夜叉…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030910,
					"content": "そ、そうだ…璃月の人に教えてもらった…夜叉も璃月を守る仙人だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030911,
					"content": "影で人類の世界を守り、何も知らない凡人のために妖魔を退治する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030912,
					"content": "普通、それは善人と言わないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030913,
					"content": "…いや、夜叉の「護法」は人類に対する善意から来たものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030914,
					"content": "うっ…海灯祭は英雄を記念するための祭りなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030915,
					"content": "璃月を守ってきた英雄たちの中で、せっかく今でも生きている英雄に出会ったと思ったら、自分たちを記念する祭りに無関心だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030916,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030917,
					"content": "魈さん…？えっと、魈仙人…？さっきはどうしてあの怪しいヤツを直接阻止しなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400030918,
					"content": "妖魔によるものかと思って、来てみただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030919,
					"content": "仙と魔の世界で、何かが解き放たれそうになっているものがあったら、それは我の責任だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030920,
					"content": "しかし、今回の脅威は人類の世界——お前たちの世界からやって来ている。だからこれはお前の責任だ、人類の旅人よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030921,
					"content": "いざという時のために…そういう自覚をお前にも持っておいてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030922,
					"content": "この妖魔を退治するための槍纓を、凡人の血で染めさせるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030923,
					"content": "これは——",
