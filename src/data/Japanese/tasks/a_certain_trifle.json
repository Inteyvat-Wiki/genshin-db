					},
					{
						"sceneId": 1083,
						"position": [
							5.38,
							0,
							6.033
						],
						"pointId": 15
					},
					{
						"sceneId": 1083,
						"position": [
							1.877,
							0,
							-1.993
						],
						"pointId": 31
					},
					{
						"sceneId": 1083,
						"position": [
							1.88,
							0,
							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "旅人さん、また来てくれるとは嬉しいな。コーヒーはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350202,
					"content": "そういえば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "そうそう、何でオイラたちがここにいるのをすんなり受け入れたんだ？…でも、あの人たちがおっきな声で話してたから、他の話題を振れなかったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350243,
					"content": "いきなり追い出されるかと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "ははっ、心配いらんさ。守衛が入館を許可したものを、我々が勝手に追い出すのはおかしいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350206,
					"content": "これも責任分担の一つの方法だね。どうも、旅人さん。スメイヌだ、初めまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350207,
					"content": "初めまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "スメイヌさんは法廷で書記官をしてたんだが…色々あって、共律庭に戻ってきてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350210,
					"content": "彼はこれまで多くの難解な問題を、その論理的な思考で解決してきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350211,
					"content": "それは褒めすぎ。ただ今までの仕事の経験を活かして物事の価値を判断し、業務を遂行しただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350212,
					"content": "実務の場面で計算外の事態に遭遇したときは、人情をよくわかってるロアルテさんが助けてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350213,
					"content": "それってつまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "簡単に言うと、スメイヌさんはみんなの精神的なバランスをとるのが上手い。バランスウェイトのように、自分が大事な存在だと全員に思わせるのに長けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350215,
					"content": "そのバランスがどうしてもうまくとれないときは、俺が「言葉の重み」をプラスするというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350216,
					"content": "アイオーヌさんは苦労してるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "そうだぞ。今にも倒れちゃいそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350219,
					"content": "それは誰しもが通る道だ。いま俺が原稿の作成を手伝えば、やつは今回の教訓を胸に刻むことなく済ませてしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350220,
					"content": "やつは共律庭に現実離れした幻想を抱いているらしい…だが、若者らしい幻想は、共律庭の職員にはそぐわない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350221,
					"content": "僕は書類作成が苦手だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350222,
					"content": "すごく正直なんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "さてと、ここになにをしに来たか聞かせてもらおうか？そうすれば俺も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350224,
					"content": "アイオーヌが突然、慌てた様子で走ってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "ど、どうしましょう…ロアルテさん、タイプライターのキーキャップの予備はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350226,
					"content": "さっきタイプしてたら、いつの間にかキーキャップが一つなくなってるのに気づいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350227,
					"content": "周りを探してみたか？床に落ちているかもしれんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350228,
					"content": "本に挟まってたり、書類の下敷きになってたり…全部捜してみたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350229,
					"content": "ペン立てとか袖の中もね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "髪とかコップの中もな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350231,
					"content": "全部捜しました。服のポケットも靴底も調べてみたんですが、どこにもありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350232,
					"content": "では、コーネリアさんに尋ねてみてくれ。「予備の部品」があるとすれば、彼女のところで申請できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350233,
					"content": "僕、買ってきたほうがいいですか？エスタブレさんに頼んで作ってもらえば、そう時間はかからないと思うので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350234,
					"content": "アイオーヌくん、なぜそう自分のお金を使いたがる？共律庭の備品なのだから、コーネリアさんに申請するのが筋だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740350235,
					"content": "でも、大した金額じゃないですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350236,
					"content": "金額の多寡ではなく、権限と責任の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350237,
					"content": "共律庭の備品を修理するんだから、公費を使うべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350238,
					"content": "君が自分の懐からお金を出して、精算もしなかったら、年末に経費のチェックをしたときにつじつまが合わなくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740350239,
					"content": "か、かしこまりました！じゃあすぐコーネリアさんのところに行ってきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350240,
					"content": "買い物一つするのも面倒だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "共律庭ではそれが普通なんです…コーネリアさんのところに行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350241,
					"content": "お金を払うのも一苦労だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "誰も手伝ってあげないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "#あの、{M#君}{F#あなた}は…",
					"roleType": "TALK_ROLE_PLAYER",
