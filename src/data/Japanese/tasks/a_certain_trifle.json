			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "あら、アイオーヌくん。どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350402,
					"content": "こんにちは。あの、タイプライターのキーキャップの予備ってありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350403,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350404,
					"content": "タイプライターのキーキャップが一つなくなってしまったので、スペアに取り替えたいんです。もしないなら…経費精算をしてもらいたいんですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350405,
					"content": "キーキャップの代金を経費で…原則的には問題ないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350406,
					"content": "ここにサインをくれる？「タイプライター故障のため、キーキャップ一個を経費で購入」——そんな感じで書いて、名前と部署名も記入して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350407,
					"content": "よし、おかげで今日中にキーキャップが手に入りますね。急いで仕事に戻らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350408,
					"content": "アイオーヌくん、今まで備品の経費精算をしたことはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350409,
					"content": "経費の精算はあなたの想像とは違って…一件ずつ処理するの。一か月単位で精算書を集計して、月末にまとめて枢律庭で決裁してもらう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350410,
					"content": "その決裁は共律庭全体の給与支払いと関係してるから、あまりに額が多い場合は枢律庭がヌヴィレット様に確認を仰がないといけない場合もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350427,
					"content": "あの方がすべて確認して署名なさった時点で、ようやく経費の支給が確定するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350411,
					"content": "ヌヴィレット様が個別の経費申請に疑問を抱かれたときは、担当者が書面で説明するの…うちもここ数日の間に精算書を提出する予定でいるけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350412,
					"content": "つまり運が悪ければ、キーキャップの精算一つにもヌヴィレット様の承認が必要になると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350413,
					"content": "そういう決まりなのよ。それに今月は経費の額が大きいから、ヌヴィレット様の確認が必要になると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350414,
					"content": "ヌヴィレット様って…あの「最高審判官」の？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350415,
					"content": "キーキャップ一つにも最高審判官のサインがいるなんて…変なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350416,
					"content": "他の方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "僕もそう思います。だって、たかがキーキャップ一つに、ヌヴィレット様のお手を煩わせるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350419,
					"content": "他の方法もなくはないけど。うーん…とりあえず、自分でキーキャップを買ってくれたら、私が仮の経費申請書を出してあげられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350420,
					"content": "経費関連の手続きが全部終わって承認が下りたら、帳簿の履歴からその費用を支払うって方法もあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350421,
					"content": "それはありがたい！ではそうさせてください。キーキャップなんて安いものですから、僕でも買えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350422,
					"content": "ここに署名して。「タイプライター故障のため、キーキャップ一個を経費で購入」って書いてね…エスタブレさんのところで買うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350423,
					"content": "ええ。それが何か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350424,
					"content": "あとでロアルテさんに、仮の経費申請書にサインしてもらわなくちゃ。それからエスタブレさんにも請求書を確認してもらうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350425,
					"content": "まあ、その辺は気にしなくていいから、急いでキーキャップを買いに行って。あとのことは私に任せてくれればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740350426,
					"content": "コーネリアさん、本当にありがとうございます。じゃあ、キーキャップを買ってきますね…旅人さん、急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350417,
					"content": "別の方法にしたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
