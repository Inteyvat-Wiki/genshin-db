			"trigger": {
				"objectNames": [
					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "ああ…旅人さん、どうも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350102,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "目の下のくまがすごいぞ。声も弱々しいし…ちょっと休んだらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740350105,
					"content": "いえ…そういうわけには。昨日の夜は徹夜して原稿をいくつも書いたんですが、全部ボツになりました。今からまた書き直さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350106,
					"content": "私にご用なら、少々お待ちを…ロアルテさんのところへ椅子を運んで座っててください。コーヒーを出してくれるかもしれませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350107,
					"content": "じゃあ…私は書き物を続けますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350108,
					"content": "駄目だ。「愛する同僚のみんな」じゃちょっとカジュアルすぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350103,
					"content": "何だか具合が悪そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
