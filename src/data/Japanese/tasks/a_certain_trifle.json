					"nextDialogs": [
						740350602
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740350602,
					"content": "エスタブレさん！あの、今すぐタイプライターのキーキャップをください！ここなら置いてますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350603,
					"content": "あるよ。でもタイプライターのキーキャップって言っても色々あるからね。どれが欲しいか自分で見とくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740350604,
					"content": "アイオーヌは慌ててお目当てのキーキャップを探し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "これです！お金はこちらに。エスタブレさん、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740350606,
					"content": "そういやあんた、この間一緒に船に乗ろうって言って…アイオーヌ！ちょいとお待ちよ、アイオーヌ！",
					"roleType": "TALK_ROLE_NPC",
