	"talks": [
		{
			"id": 101101,
			"completionStepIds": [
				101101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101101",
							"2"
						],
						"stepId": 101101,
						"stateName": "QUEST_STATE_UNFINISHED"
