		},
		{
			"id": 10110731,
			"completionStepIds": [
				101107
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101107",
							"2"
						],
						"stepId": 101107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110731,
					"content": "「3番の夜泊石」をください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110732
					]
				},
				{
					"id": 10110732,
					"content": "そうそう！オイラもこれだと思った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110733,
					"content": "かしこまりました、お気に召されたようでなによりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110771
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110771,
					"content": "ああ。「3番の夜泊石」を1箱もらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110772
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110772,
					"content": "かしこまりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110734
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110734,
					"content": "ところで…単なる好奇心ですが、お客さんはどうしてこれほど上質な「夜泊石」を必要とされているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110735
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110735,
					"content": "ああ…別に言っても支障はないから構わん。「送仙儀式」の器具を作るためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110736,
					"content": "「送仙」…！？えっと、確かに噂は最近耳にしましたが、深く聞く勇気がなく信じておりませんでした。でも、それはつまり、岩王帝君は、本当に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110737
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110737,
					"content": "…はあ、信じられません。今の「解翠行」は昔と比べて少し衰えましたが、うちは代々岩王帝君の加護を受けてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110738
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110738,
					"content": "言い伝えによると、200年前に岩王帝君が城南を巡った際、道に迷ったことがあったそうで、その時この「解翠行」の匙で料理を召し上がったとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110739
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110739,
					"content": "もう過去のことですが…はあ、岩王帝君を送る儀式に使うものでしたら、この「夜泊石」は半額で構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110740
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110740,
					"content": "おっ、いいのか…今まであんなにケチだったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110741
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110741,
					"content": "岩王帝君の加護がなければ、今の「貿易の都」はありませんでした。商人として、それで儲けを得ようだなんて思えません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110742
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110742,
					"content": "ううっ…店主、その気持ち、きっと岩王帝君にも伝わるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110743,
					"content": "「璃月七星」と、たゆまぬ努力を続ける商人たちの協力あれば、きっと璃月は今まで通り繁栄し続けることができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110744
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110744,
					"content": "だから、元気を出して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110745
					]
				},
				{
					"id": 10110745,
					"content": "ぐす…ありがとうございます。はあ、どうしたものか、こんなに泣いてたら金運が逃げてしまいますね、ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110746
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110746,
					"content": "選び終わったことだし、「夜泊石」を持って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110747
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110747,
					"content": "おい！待て、半額にはなったけど、タダじゃないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110748
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110748,
					"content": "ああ、すまない、また支払いのことを忘れていた。どれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110749
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110749,
					"content": "…うん…ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110750
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110750,
					"content": "何が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110751
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110751,
					"content": "モラがない。恥ずかしながら、また手落ちがあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110752,
						10110753
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110752,
					"content": "変わった金銭感覚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110754
					]
				},
				{
					"id": 10110754,
					"content": "どうする、結構な額だぞ…あっ、そうだ、「公子」から資金をもらってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110755
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110755,
					"content": "一応、持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110756
					]
				},
				{
					"id": 10110756,
					"content": "足りるか店主に確認してもらおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110757
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110757,
					"content": "【表现备注：主角递给老板钱】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110758
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110758,
					"content": "十分です。半額なら、ちょうどこれくらいになります…多少足りてませんが問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110759
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110759,
					"content": "ああ、モラの件が解決したならそれでいい。夜泊石を玉京台に持っていくぞ、あそこで儀式を行う予定だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110760
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110760,
					"content": "1モラも出してないくせに、よく言うよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110761,
						10110763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110761,
					"content": "今度はお金を用意してください。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110762
					]
				},
				{
					"id": 10110762,
					"content": "ああ…努力はする、今回の件は礼を言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110763,
					"content": "また公子に資金をもらわないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110764
					]
				},
