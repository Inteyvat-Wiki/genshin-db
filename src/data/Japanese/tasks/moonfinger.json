						],
						"stepId": 101104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110401,
					"content": "わあ…スープがたんまり入ってるぞ、ヒルチャールは大食いだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110402,
						10110403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110402,
					"content": "実験に利用させてもらおう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				},
				{
					"id": 10110404,
					"content": "このスープが「水」元素の代わりになるな。さっそく火をつけて、実験を始めてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110405,
					"content": "【表现备注、伸手放置的动作or投石的视觉表现】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110406,
					"content": "これでいいよな？オイラもサンプルの番号と位置を注意して見とくぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110407,
					"content": "じゃあ、始めよう！結果が出るまで、<color=#00E1FFFF>「炎」元素</color>で大鍋を加熱するんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110408,
					"content": "<color=#00E1FFFF>光が強くて、青い</color>鉱石が上質なものだって鍾離が言ってたよな、ちゃんと観察しろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110403,
					"content": "スープがもったいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				}
			]
		},
		{
			"id": 101109,
			"completionStepIds": [
				101109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101109",
							"2"
						],
						"stepId": 101109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110901,
					"content": "「夜泊石」をここに置いてくれ。すでに宝石の加工を請け負う職人を呼んである、あとで儀式に必要な器具を作ってくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110902
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110902,
					"content": "そういえば急いでいたから、まだ「公子」に会えてないな、職人への支払いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110903,
						10110904
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110903,
					"content": "代わりに支払おう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				},
				{
					"id": 10110905,
					"content": "そうするしかないな。ところで、ここが…「送仙儀式」の会場になるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110906,
					"content": "ああ、この場所を貸してもらい、儀式の準備を行っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110907,
						10110909
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110907,
					"content": "「迎仙儀式」と同じ場所…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110908
					]
				},
				{
					"id": 10110908,
					"content": "そうだ、同じ場所だ。これは「璃月七星」が黙認している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110911,
					"content": "ここであんな大事件が起きたばかりなのに…あっ、そういえば、オイラたち容疑者だから千岩軍には気をつけないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110940
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110940,
					"content": "でも絶雲の間から戻った後、千岩軍に狙われることはなくなった気がする。一体どういうことなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110912,
					"content": "それと、ここに残ってる岩王帝君の…えっと、体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110913,
					"content": "伝統的な呼び方を用いれば、「仙祖の亡骸」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110914,
					"content": "そうだ、その名前だ、鍾離は何でも知ってるんだな。それで「仙祖の亡骸」は、七星に隠されてるんだよな？まだ犯人はわかってないんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110915,
					"content": "七星は犯人の心当たりがすでにあるようだ…もしくは、犯人への手がかりを全て揃えたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110916,
						10110917
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110916,
					"content": "やっぱり変だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110918,
					"content": "そういうことは、玉京台の偉い奴らに任せておけ。彼らの心配をしても、ただ悩みの種を増やすだけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110919
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110919,
					"content": "儀式が行われるまで、「仙祖の亡骸」は一時的に「黄金屋」に保管されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110920
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110920,
					"content": "「黄金屋」って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110921,
					"content": "璃月唯一の造幣局であり…テイワット唯一の造幣局でもある。七国で流通するモラは、全てそこで作られているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110922,
					"content": "おおっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110923,
					"content": "いやっ、別に悪いことなんてこれっぽちも考えてないぞ。ただ、「モラクス」がいる場所に相応しいなぁと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110924,
					"content": "でも、なんで鍾離はそんなことを知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110925,
					"content": "「送仙儀式」は七星に黙認されてる、いわば半ば公式の催しだ。だから、俺も内部の事情に一部精通している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110926,
						10110927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110926,
					"content": "七星が場所を、公子が資金を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110928,
					"content": "それぞれの目的があるのだろう…でもまあ、この商業の都では、たまに人に利用されることも受け入れなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110929
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110929,
					"content": "「契約」の神が治めた璃月では、契約だけが裏切らない。契約以外のことは、俺は特に気にしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110930
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110930,
					"content": "さあ、そろそろ儀式に必要な<color=#00E1FFFF>香膏</color>の用意に取り掛かろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110931,
					"content": "香膏？どこで手に入るんだ？店で買えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110932
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110932,
					"content": "いや、神へ捧げる香膏を作るには<color=#00E1FFFF>「霓裳花」</color>が必要だ。その品質も特別なものが必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110933,
					"content": "「霓裳」という名の花は、その花弁が上等な繊維素材ゆえ絹織物に多く使用されている。その香りは清らかで上品な美しさがあり、神への貢ぎ物など厳粛な場に相応しい代物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110934
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110934,
					"content": "また鍾離が上流階級の豆知識タイムに入った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110935
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110935,
					"content": "詳細は割愛させてもらおう。まずは俺と共に商人から材料を買いに行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110927,
					"content": "一体、この儀式で何を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110917,
					"content": "軽率すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110909,
					"content": "そのまま「現場」を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110910
					]
				},
				{
					"id": 10110910,
					"content": "これは「璃月七星」が黙認している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110904,
					"content": "あとで公子に教えよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				}
			]
		},
