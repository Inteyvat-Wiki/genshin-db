				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"石商"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110101,
					"content": "お客さん、「解翠行」へようこそ。「天然石」で運試ししてみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110102
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110102,
					"content": "安くて、面白い！その上、ひと儲けできるかもしれませんよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110103
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110103,
					"content": "「天然石」？いらないよ、オイラたちは…なんて石だっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110104,
					"content": "夜泊石、品質は少なくとも「燭照」級のものが必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110105,
					"content": "「燭照」級の夜泊石…？ふむ、観光客ではなかったのですね、失礼しました。すぐにお持ちいたします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110106
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110106,
					"content": "（黑屏、拿来了货）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110107
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110107,
					"content": "こちらはいかがですか？「解翠行」は老舗ですからね、この品質をご覧ください！まさに岩王帝君の贈り物ですぞ。安心してお選びください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110108
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110108,
					"content": "この「夜泊石」、三つとも確かに綺麗だ。貴重なものに間違いないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110109,
					"content": "でも、どう選べばいいんだ、適当に選んで帰るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110110,
						10110113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110110,
					"content": "こういう商売をする人を信用できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110111
					]
				},
				{
					"id": 10110111,
					"content": "よろしい。貿易の都のルールをすでに理解しているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110112,
					"content": "鍾離はどう思う？この「夜泊石」って、どう選んだらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110114,
					"content": "ん？俺が決めるのか。いいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110115
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110115,
					"content": "俺が決めて良いのなら、答えは簡単だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110116
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110116,
					"content": "おう、答えは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110117,
					"content": "全部もらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110118
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110118,
					"content": "ありがとうございます！さすがお客様、お目が高い——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110119
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110119,
					"content": "待て！待てっ！店主、今のなし！もう少し話し合うから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110120,
					"content": "（黑屏遮盖、和石头稍微拉开距离、变成鍾離主角派蒙三人と会話する）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110121,
					"content": "おい！儀式に必要なのは一つだけだろ。全部買ったらモラを3倍無駄にするじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110122,
						10110123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110122,
					"content": "うん、パイモンの言う通りだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110124,
					"content": "モラ…ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110125
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110125,
					"content": "確かに。その問題は考えてなかった、俺のミスだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110126,
					"content": "はあ？買い物するならモラのことを考えろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110127,
					"content": "何事もモラを考えなければならないなら、何事もモラに縛られることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110128
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110128,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110129,
					"content": "モラは生まれながらに貨幣だが、貨幣は生まれながらにモラではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110130
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110130,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110131,
						10110134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110131,
					"content": "経済学の話だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110132
					]
				},
				{
					"id": 10110132,
					"content": "これがお金持ちの世界か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110133,
					"content": "経済学のことはわかるのに、「お金」を節約することはわからないんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110136,
					"content": "動揺することはない。たとえモラに縛られても、制限された状況で問題を解決する方法はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110137
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110137,
					"content": "「夜泊石」品質の鑑定は、確かに厄介だ。鉱石の品質に関わらず、その状態や色つや、内部の模様に大した差は生まれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110138
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110138,
					"content": "夜泊石は器具によって成形された後に、その品質の良し悪しがわかってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110139
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110139,
					"content": "後になって店主に文句をつけても、「お客さんの使った器具がよくなかった」、「火のコントロールが悪かった」などの理由でごまかされるのがよくある手だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110140
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110140,
					"content": "危なかった！こういうのに騙されやすいんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110141,
					"content": "しかし、正しい鑑定方法はちゃんとある——知識があれば目利きは可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110142
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110142,
					"content": "「人の指を以って月を指し、以って惑者に示すに、惑者は指を視て、月を視ず。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110143
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110143,
					"content": "どういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110144,
					"content": "指で月を指すと、賢い人は月を指していることを理解するが、そうでない人は指を見て、月を見ないという意味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110145
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110145,
					"content": "模様、外面…これらは指だ。夜泊石は夜間の照明に使用される奇石で、「輝度」の大事さこそが月となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110146
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110146,
					"content": "上質な「夜泊石」は炎元素と相性がいい。すなわち、高温の環境下で強く光り、青い鉱石こそが、品質の良いものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110147,
						10110148
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110147,
					"content": "鍾離先生、詳しいんだな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110149,
					"content": "値千金に匹敵する玉石界隈の秘密をお前たちに教えたんだ、あとは実践してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110150
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110150,
					"content": "値千金…うう、このさき使う機会がなさそうなのが残念だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110151,
					"content": "（黑屏遮盖、回到石头摊前と会話する）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110152,
					"content": "店主、戻ってきたぞ、少し焼いてみたいから石を貸してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110153,
					"content": "や、焼く！？いけませんよお客さん、焼かれたら売り物になりません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110154,
						10110156
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110154,
					"content": "では、サンプルを少しもらっても？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110155
					]
				},
				{
					"id": 10110155,
					"content": "それなら…まあ、いいでしょう、お客さんの言う通りにします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110158,
					"content": "こうしましょう、三つの石から少しサンプルを削ってお渡しします。今日会ったのも何かの縁ですから、それくらいはまけておきますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110159
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110159,
					"content": "安心してくれ、商売のルールはわかっている。いい鉱石だとわかったなら、損させるようなことはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110160
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110160,
					"content": "（黑屏取样品）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110161
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110161,
					"content": "では、こちらがサンプルです。彫刻刀で削りました、番号もつけてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110162,
						10110163
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110162,
					"content": "このサンプル…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110164,
					"content": "…薄すぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110165
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110165,
					"content": "紙より薄い…いや、虫の羽根よりも薄いぞ、ほぼ透明じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110166,
						10110168
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110166,
					"content": "ケチ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110167
					]
				},
				{
					"id": 10110167,
					"content": "ケチ？これでもかなりの出血大サービスですよ、これ以上削ったらこちらが損してしまいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110171,
					"content": "でも、こんなに薄いと、火で焼いたらすぐ灰になっちゃわないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110172,
					"content": "商人から利益を奪うことは、空腹の狼に食ったばかりの肉を吐き出せと言ってるのと同じことだ、仕方がない。しかし、条件さえ整えば、この薄片でも十分問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110173
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110173,
					"content": "どんな条件だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110174
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110174,
					"content": "「炎」で温度を上げながら、「水」元素の力で石を守る。そうすれば、サンプルが一瞬で灰になることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110175
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110175,
					"content": "おや？お客さん、そういった知識もお持ちとは。助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110176
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110176,
					"content": "先入観を交えずに論じただけだ。それに必ず買うという約束もせず、こちらはサンプルを要求している…これは実に不公平だ。璃月の「契約」は、公平こそが基本だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110177
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110177,
					"content": "じゃあ、あとは実験できる場所を探さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110178,
						10110179
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110178,
					"content": "確かダダウパの谷の…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110182
					]
				},
				{
					"id": 10110182,
					"content": "あっ！思い出した、モンドで見たんだ…<color=#00E1FFFF>ダダウパの谷</color>の「好肉族」のヒルチャールがすごく<color=#00E1FFFF>大きな鍋</color>を持ってたぞ！丈夫そうだったから、あれなら元素反応に耐えられるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110183
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110183,
					"content": "#{NICKNAME}、サンプルを持って、さっそく行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110179,
					"content": "香菱のキッチン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110180
					]
				},
				{
					"id": 10110180,
					"content": "「万民堂」か？そうだな、香菱がいないうちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110181
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110181,
					"content": "いや、あそこは人が多く、万が一元素反応が暴走したら、民衆に害を及ぼしかねない…そういったリスクは極力負いたくないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110182
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10110168,
					"content": "店主の技術、すごいな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110169
					]
				},
				{
					"id": 10110169,
					"content": "ハハハッ…どうもどうも、この石たちはみんなお宝ですから、優しくしてあげませんと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110170
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110170,
					"content": "万が一削りすぎたら、こちらが大損してしまいますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110163,
					"content": "薄い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110156,
					"content": "では、買わないでおこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110157
					]
				},
				{
					"id": 10110157,
					"content": "買わない…？えっ、そんな、お客さん…もう少しお話ししましょうよ。買い物は話し合いからですよ、そうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "石商"
				},
				{
					"id": 10110148,
					"content": "これがセレブか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110134,
					"content": "鍾離先生からお金持ちの気配がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110135
					]
				},
				{
					"id": 10110135,
					"content": "節約が必要ないほどお金を持ってるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10110123,
					"content": "いや、2倍が正解だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110113,
					"content": "鍾離先生の意見が聞きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110114
					]
				}
			]
		},
		{
			"id": 101104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101104",
