			"dialogs": [
				{
					"id": 200030501,
					"content": "モナ、いるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030502,
					"content": "モナ、家賃を払って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "うぅ…いないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030504,
					"content": "おかしいな…いつもなら部屋にいるはずだろ？出かけてるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030505,
					"content": "ま、まさか！お腹が空いて倒れて、ドアが開けられないのかも！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030506,
					"content": "それはない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "そ、そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030509,
					"content": "でも…どこに行ったらモナが見つかるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030507,
					"content": "前に、稼ぐ方法を見つけたって言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
