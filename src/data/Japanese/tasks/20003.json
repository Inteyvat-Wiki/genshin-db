					"ゲーテ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "ありがとう、これで十分だ。これを職人に渡して…それから、家賃の回収にも行かねば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030302,
					"content": "はぁ…あのアス…アス…なんとかモナが、家にいるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030303,
					"content": "アストローギスト·モナ·メギストス。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "そうそう！そんな名前だった。まったく私としたことが…すぐ忘れてしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030305,
					"content": "ん？モナはまだ家賃を払ってないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200030306,
					"content": "ああ。他の人たちからはもう受け取ったが、彼女だけまだなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030307,
					"content": "何回も出向いたんだが、いつも不在でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030308,
					"content": "旅人、悪いんだが、私の代わりに家賃を回収しに行ってきてくれないかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲーテ"
				}
			]
		},
