			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゲーテ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "はぁ…どうやら、直々に行かねばならんようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030102,
					"content": "この老いぼれた体は、いつガタが来てもおかしくないというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030103,
					"content": "何か急用でもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "おや、旅人じゃないか。いや…急用ではないんだが、ちょっと厄介なことがあってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030105,
					"content": "ファデュイが私のホテルを貸し切り状態にしていることは、君も知っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030106,
					"content": "彼らにホテルを貸してから、私も「ゲーテホテル」のオーナーとして、当然ながら彼らの世話をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030107,
					"content": "食材の仕入れ先への連絡、修理の手配、他にも雑事を色々とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030108,
					"content": "最近は、ホテルの机と椅子が壊れたから、直ちに適切な木材を職人に届けるための手配をしたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030109,
					"content": "街で貸してる部屋の、家賃を回収しに行ったり…まったく、家賃回収の時、マーヴィンはいつも姿を消すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030110,
					"content": "はぁ、この老いぼれがあと何年こうして続けられるだろうか…それに、マーヴィンはいつになったらもう少し利口になってくれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030111,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "手伝ってくれるのか？とても助かるよ。マーヴィンのやつも、君のようにしっかりしてくれたら、私がこんなに疲れることもないんだがね…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030114,
					"content": "それじゃあ悪いが、杉材と樺材をそれぞれ一つ用意してきてくれないか。すぐに職人に渡す必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200030112,
					"content": "ここでちょっと休んでて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
