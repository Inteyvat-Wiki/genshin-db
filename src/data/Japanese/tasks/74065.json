						],
						"pointId": 6253
					}
				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#おやおや、これはこれは、{NICKNAME}にパイモンじゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650102,
					"content": "仲良かったっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "そう冷たくしないでください。この間のことは、しっかりと胸に刻んでいるんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650105,
					"content": "この間のことって…あっ！まだ聞きたいことがあったのに、聞けなかったんだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650106,
					"content": "そ、そうでしたっけ？私の記憶にはないのですが…何のことでしょう？まったく思い出せません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650107,
					"content": "過去を振り返るより、未来に目を向けたほうが良いと、賢い方は口を揃えて言います。ですから、今後の協力の話でもしようじゃありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650108,
					"content": "実は今、報酬の悪くない仕事がいくつかありまして…ただ、手伝ってくれる人がおらず困っているんです。お二人とも、もしお時間がありましたらやってみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650109,
					"content": "ふん、また簡単に騙されると思うなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650110,
					"content": "報酬が悪くないって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "おいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650112,
					"content": "#ははっ、私が{NICKNAME}みたいな方と取引したい理由が、これで分かったでしょう？そう、まさにノリがいいからです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650113,
					"content": "さて、さっそくですが報酬を提示しましょう。絶対にご満足いただけると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650114,
					"content": "特別許可券百枚——どうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650115,
					"content": "百枚！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650116,
					"content": "ふむ、その様子からして、私の太っ腹具合に感動したみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650117,
					"content": "フォンタの栓を買うこともできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "そうだ、そうだ！よくそんなこと言えるな、信じられないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650121,
					"content": "これでも太っ腹じゃないと言うのですか？君たち若者はまったく…いい加減にしてほしいものですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650122,
					"content": "こんな楽に稼げる仕事、貧乏人たちはみんな我先にと群がるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650123,
					"content": "デサンブル！やっと見つけたぞ！以前、郵便室の近くで自分の仕事を安値で新入りに下請けさせてたな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650124,
					"content": "#ん？{NICKNAME}にパイモン？まさか、こいつのデタラメを信じたんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650125,
					"content": "うっ、もう騙されたあと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "はぁ、遅かったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650130,
					"content": "とにかく、こいつの言うことは信じないでくれ。こいつはメロピデ要塞に入ったばかりの者や、しばらく経ってはいるもののルールを知らないやつを選んで騙してるんだ。これまでにかなりの数の被害が出てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650131,
					"content": "騙すだなんて…人聞きが悪いですね。それに君だって、私と大して違わないでしょう？ほら、看守たちも特別許可券を使って、雑務をやらせてるじゃないですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650132,
					"content": "オレたちは、その一部を自分の懐に入れるなんてことはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650133,
					"content": "まったく、何が言いたいんですか？証拠もなしに言いがかりをつけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740650134,
					"content": "ふん、証拠が見たいんだな？なら、ついてこい。反省室は静かで広いし、資料を読むには打ってつけだぞ。…ったく、ジオード鉱坑道にはまだトラブルが残ってるってのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650135,
					"content": "#そうだ。{NICKNAME}、パイモン、もしよかったら手伝ってくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650136,
					"content": "オイラたち、別にいつも暇してるわけじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650137,
					"content": "報酬をいっぱい貰えるんでしょ？手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "おいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650139,
					"content": "ハハッ、もちろん規定通り支払うぞ。お前らも相場は分かってるだろ。俺はごまかしたりしないから安心しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650140,
					"content": "実はだな、ジオード鉱坑道に原海アベラントがうろついてるんだ…放っておくと危ないし、早く処理しなくちゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650141,
					"content": "オレはまず、こいつを反省室まで連れて行く。そこで同僚に引き渡しの手続きをするんだが、ちょっとばかし時間がかかる…それが済んだら、すぐお前らと合流しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650142,
					"content": "おう、あんまり遅くなるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650143,
					"content": "ああ、できるだけ早くしよう。ただ手続きだからな…早く済むかどうかはオレが決められることじゃない。じゃ、そっちはお前らに任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650127,
					"content": "今回はまだだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "今回は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650129,
					"content": "えーと…前にいろいろあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650119,
					"content": "#百枚で仕事を斡旋すれば、{M#俺}{F#私}だって儲かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "うわっ、まさかそれがおまえの目的なんじゃないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650103,
					"content": "なんか嫌な予感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406503",
							"2"
						],
						"stepId": 7406503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マポワ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "今さら来たのかよ。あの原海アベラントたちはもう追っ払ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650302,
					"content": "…ってことは、オレもやっとこういう場面に巡り合えたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650303,
					"content": "巡り合えたって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740650304,
					"content": "オレが現場に駆けつけると、やるべき仕事をもう他の人が片付けてるってやつさ。で、オレは何もしなくていいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740650305,
					"content": "ほら、これをお前らにやろう。本当にありがとな。今夜はぐっすり寝られそうだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マポワ"
				}
			]
		}
	]
}