			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"忠常",
					"忠明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860101,
					"content": "先輩、俺たち長年の付き合いでもう本当の兄弟みたいなもんだろ。俺は、真剣なんかで勝負したくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860102
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860102,
					"content": "何を日和っている。私と君、勝者はどちらか一人のみだ。さあ来い、我が弟弟子、忠常よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860103
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860103,
					"content": "えっ、こいつらなんで急にこんな路上で戦おうとしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860104,
					"content": "なんだ？通行人か？君たち、離れててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860105
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860105,
					"content": "我ら「狐野一刀流」の直弟子は、ここで勝負しなければならないのだ。剣術のことを知らない者は邪魔しないでもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860106
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860106,
					"content": "うわ、理不尽だな。道を塞いでるのはおまえたちのほうだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860107,
					"content": "それに剣術を知らないだって？剣術のことなら、この旅人は超一流なんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860108,
					"content": "何？そうか、また資格を奪いに来たやつだったんだな。先輩、ここは一時休戦してまずはこいつを追い払わないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860109
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860109,
					"content": "ああ、私も異論はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "忠明"
				}
			]
		},
		{
			"id": 7368602,
			"completionStepIds": [
				7368603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368603",
							"2"
						],
						"stepId": 7368603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斑目百兵衛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860201,
					"content": "旅人にパイモン、久しぶりだね。あいにく、社奉行様もお嬢様も今日は公務があって、屋敷にいらっしゃらないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860202
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860202,
					"content": "いや、今日はあいつらに会いに来たわけじゃないぞ。社奉行が開催する「演武伝心剣術大会」について聞きに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860203,
					"content": "おや、もしかして大会に申し込みたいのかい？申し訳ないが、今回は希望者が多くてね。参加資格証は先週のうちに配布が終わってしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860204
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860204,
					"content": "ただ、最後の模擬試合の観戦券であれば、何とか入手できるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860205
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860205,
					"content": "いやいや、誤解だぞ。実は今日、たまたま参加証を一つ手に入れたんだ。けど、まだ参加するか迷ってて…だから、ここに聞きに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860206,
					"content": "でも今の話を聞く限り、この大会ってかなり人気みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860207,
					"content": "ああ、「演武伝心」はもともと稲妻の歴史ある剣術大会でね。参加することは武人にとって自身の実力を測る絶好の機会で、そして栄誉でもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860208
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860208,
					"content": "しかも、将軍様はこれを機により多くの人に剣術の魅力を知ってもらおうと、今大会では新たな要素を取り入れた。町民たちもみんな興味を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860209
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860209,
					"content": "旅人、参加証を持っているのなら、大会に参加してみたらどうだい？せっかくの機会だしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860210,
						736860211
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860210,
					"content": "分かった、考えておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860212
					]
				},
				{
					"id": 736860212,
					"content": "おっと、そうだ。今日初めて「演武伝心」のことを聞いたのならまだ知らないと思うけど、お嬢様は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860213
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860213,
					"content": "滅多にない機会だっていうのに、何を躊躇ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860214
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860214,
					"content": "「演武伝心」に参加できることを誇りに思わないのなら、参加証を持ってる必要もないだろう。それを欲しがってるやつは大勢いるっていうのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860215
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860215,
					"content": "宏達、口を慎め。客人に対する口の利き方じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860216
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860216,
					"content": "#斑目さん、別に{M#彼ら}{F#彼女たち}を侮辱してるわけじゃない。むしろ、この旅人のお手並みを拝見したいと思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860217
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860217,
					"content": "神里屋敷の者であれば、全員君の名を知ってる。お嬢様も君のことを高く買っていてな。さぞかし立派な英傑だと思っていたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860218
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860218,
					"content": "見たところ、大したことなさそうじゃないか。気迫も感じないし、剣の腕も…おそらく平凡なもんだろう。でなきゃ、とっくに参加を決めてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860219
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860219,
					"content": "言葉が過ぎるぞ、宏達。旅人は武家の出身ではない、考え方も違うだろう。それに気迫や剣術の腕は、必ずしも試合でしか見られないものじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860220
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860220,
					"content": "なんなんだ、今日出会ったやつらはどいつもこいつも口が悪いな、ふんっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860221,
					"content": "お腹が空くこと以外でオイラが一番イヤなのは、知りもしないやつに旅人のことを軽く見られることだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860222,
						736860223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860222,
					"content": "パイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860224
					]
				},
				{
					"id": 736860224,
					"content": "でもおまえのことをよく知らないのに、気迫も腕もないだなんて、オイラさすがに頭に来るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860225,
					"content": "こいつに嫌なあだ名をつけてやる。…よし、おまえは「見る目なし野郎」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860226,
					"content": "ふん、減らず口を。腕前は口先だけで証明できるもんじゃない。この宏達は正真正銘の武人だ。ホラを吹いて名声を得ようなんてことはせん。じゃあな、俺はこれで失礼させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860227
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 736860227,
					"content": "はぁ、旅人、本当に申し訳ない。宏達は思ったことを何でも口にする人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860228
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860228,
					"content": "大丈夫、実力で認めさせるまで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860229
					]
				},
				{
					"id": 736860229,
					"content": "じゃあ、大会に参加するってことか？おぉ、オイラ大賛成だぞ！あの宏達ってやつにおまえの腕を見せてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860230,
					"content": "開催は二日後で、会場は離島だ。さっき伝えそびれたけど、今日お嬢様は離島へ向かい、柊千里様とこの大会について打ち合わせをする予定になっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860231
					],
					"speakerTitle": "斑目百兵衛"
				},
				{
					"id": 736860231,
					"content": "そうだったのか？なら、離島へ行って綾華に会いに行こうぜ。ちょうど「演武伝心」についてもっと聞きたかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860223,
					"content": "もう慣れたから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860224
					]
				},
				{
					"id": 736860211,
					"content": "まだ他に用事が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860212
					]
				}
			]
		},
		{
