					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860425,
					"content": "パイモンの言う通りですね。私もあなたのご活躍を楽しみにしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860420,
					"content": "気持ちは分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860415,
					"content": "悩みごとならいつでも相談して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				}
			]
