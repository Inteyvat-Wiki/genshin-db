	"talks": [
		{
			"id": 7368601,
			"completionStepIds": [
				7368601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
