			"trigger": {
				"objectNames": [
					"忠常",
					"忠明"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860701,
					"content": "ふぅ…やっと大人しくなった。おい、おまえたち誤解してるぞ。オイラたちはただの通りすがりで、別に資格とやらを奪いに来たわけじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860702,
					"content": "資格って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860703
					]
				},
				{
					"id": 736860703,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860704
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860704,
					"content": "先輩…今のはどういうことだ？この若者、たった数手で俺たち二人をここまで追い込んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860705
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860705,
					"content": "今度こそ「狐野一刀流」の名を世に知らしめる機会だと思ったのに。まさか、会場に足を踏み入れる前に頓挫するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860706
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860706,
					"content": "忠常よ、もうよい。このような結果になったのは、私たちの力不足が故だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860707
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860707,
					"content": "はぁ、師匠は常に「上には上がいる」とおっしゃっていたが、私たちはその言葉に耳を傾けてこなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860708
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860708,
					"content": "おそらく、このたった一つの「参加資格証」は、私たちどちらの手に渡っても同じ結果だっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860709
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860709,
					"content": "待て待て。おまえたちなんの話をしてるんだよ？それに、さっきまでケンカしようとしてたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860710,
					"content": "二人とも、誤解させてしまいすまない。私たちは剣術流派「狐野一刀流」の弟子でな。さっき戦おうとしていたのは、「演武伝心剣術大会」への参加資格を賭けてのことだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860711
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860711,
					"content": "この大会は剣を学ぶ者にとって特別な意味がある。それに、この辺りは人通りが少ない、さっきはてっきり大会の参加資格を奪いに来た者だと思ってしまったんだ。誠に申し訳ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860712,
						736860713
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860712,
					"content": "やっと誤解が解けた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860714
					]
				},
				{
					"id": 736860714,
					"content": "待ってくれ！もし君たちが目覚めさせてくれなかったら、私は自分の力不足に気づけなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860715
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860715,
					"content": "ああ、確かにそうだな。君と戦って、俺は初めて気づかされた。剣も心も、まだまだ精進する必要があるってことに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860716
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860716,
					"content": "#先輩、一つ提案だが、この参加証を{M#彼}{F#彼女}に譲らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860717
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860717,
					"content": "ああ、私も異論はない。真の剣術の使い手こそ、演武伝心の会場に立つ資格がある。私たちはまだまだ鍛錬が足りないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860718
					],
					"speakerTitle": "忠明"
				},
				{
					"id": 736860718,
					"content": "えっ、つまり、おまえたちの代わりに、旅人に大会に出てほしいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860719,
						736860720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860719,
					"content": "急すぎない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860721
					]
				},
				{
					"id": 736860721,
					"content": "参加するかどうかは、君自身が決めてくれ。この参加証は、今の俺たちには意味がない。…じゃあな、いずれまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860722
					],
					"speakerTitle": "忠常"
				},
				{
					"id": 736860722,
					"content": "行っちゃった…えっと、残されたこのなんちゃら大会の参加証だけど、どうしたらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860723,
					"content": "どれどれ…「演武伝心剣術大会」、「社奉行主催」。見たところ社奉行がやってる大会みたいだな。神里屋敷に行って聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860720,
					"content": "その大会について何も知らないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860721
					]
				},
				{
					"id": 736860713,
					"content": "じゃあ、これで失礼するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860714
					]
				}
			]
		},
