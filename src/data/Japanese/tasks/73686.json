				"points": []
			},
			"dialogs": [
				{
					"id": 736860601,
					"content": "見ろ、綾華と千里がいるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860602,
					"content": "旅人さん、パイモンさん、来てくれましたか。昨夜はゆっくり休めましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860603,
						736860605
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860603,
					"content": "よく休んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860604
					]
				},
				{
					"id": 736860604,
					"content": "さすが旅人さんです。余裕のある表情ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860607,
					"content": "へへっ、試合前に最善の状態を保つのは大事なことだからな。今回の試合は絶対に勝つぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860608,
					"content": "皆さん調子良さそうですね。今日の開幕試合もきっとうまく行くでしょう…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860609
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860609,
					"content": "そういえば、この二つの箱には投票用紙が入ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860610,
					"content": "はい、既に手配は完了しました。左の箱にあるのが演武伝心の投票用紙で、右の箱はそのほか催事用のものです。投票結果はあなたたちが三回目の試合に出る頃に発表されます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860611
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860611,
					"content": "旅人さんの実力をもってすれば、三回目の試合まで生き残るのも容易なことでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860612
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860612,
					"content": "もちろんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860613,
					"content": "小野寺さん、「演武伝心」用の投票箱を運びますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860614
					],
					"speakerTitle": "水田"
				},
				{
					"id": 736860614,
					"content": "はい、お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860615
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860615,
					"content": "そろそろ時間だ。準備して入場しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860616,
					"content": "旅人さん、試合でいい成績を収められるように祈っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860617
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860617,
					"content": "では、私と綾華さんは会場の観戦席から試合を観ていますね。また後でお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860605,
					"content": "あまり眠れなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860606
					]
				},
				{
					"id": 736860606,
					"content": "とは言え、いつもの余裕ある表情ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860607
					],
					"speakerTitle": "柊千里"
				}
			]
		},
