			},
			"dialogs": [
				{
					"id": 736860501,
					"content": "もう遅いので、私と千里さんはお先に失礼いたします。お二人とも、ここ二日はゆっくり休んでください。また大会当日にお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
