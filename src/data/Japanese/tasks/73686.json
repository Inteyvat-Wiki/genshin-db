			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華",
					"柊千里",
					"小野寺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860301,
					"content": "綾華、千里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860302,
					"content": "旅人さんにパイモンさん、お久しぶりです。最近は稲妻にいらしたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860303
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860303,
					"content": "おう、実は「演武伝心剣術大会」に参加することになったんだ。綾華が離島で準備してるって聞いたから、様子を見に来たぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860304,
					"content": "ちょうど「神使代行」のお仕事の話が終わって、旅人さんなら「演武伝心」に興味を持つんじゃないかと話していたんです。そこにあなたが現れるなんて、なんとも奇遇ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860305
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860305,
					"content": "「神使代行」？なんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860306,
					"content": "えっ、知らないのですか？綾華さんの手紙を読んで稲妻に戻られたのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860307
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860307,
					"content": "ん？手紙？なんの手紙だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860308,
					"content": "あっ、いいえ、気にしないでください。パイモンさん、「神使代行」について知りたいのですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860309
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860309,
					"content": "そうそう、それってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860310,
					"content": "「神使代行」は「演武伝心」の特殊な役割の一つです。これについて説明するには、この大会の由来も話さなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860311,
					"content": "「演武伝心」は稲妻の古き伝説から始まりました。伝説によると、遥か昔、稲妻で剣術を極めた武人は将軍様と謁見ができ、手合わせをする栄誉を得られたといいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860312
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860312,
					"content": "しかし、将軍様の実力はあまりにも人間を凌駕したものです。直接武人と勝負すれば、勝敗は一瞬で決してしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860313,
					"content": "そこで、将軍様は自身の眷属を武人を導く使者として遣わせました。その手合わせで、使者は武人を援護し、二人で将軍様と戦ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860314,
					"content": "将軍様は演武という形で、自らの技と稲妻を守る意志を民に伝えたことから、この大会は「演武伝心」と呼ばれるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860315
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860315,
					"content": "その後、「演武伝心」の伝説は剣術大会へと姿を変えます。神が技を授ける手合わせも、大会の最後に行われる「模擬試合」となりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860316,
					"content": "これを通じて、後世の人々は「演武伝心」の由来や、武芸に込められた意義を理解するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860317,
					"content": "大事な演目みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860318,
					"content": "そうですね。模擬試合では、将軍様が自ら参加することはありません。しかしながら、神の威厳を示すため、特別な使者を遣わし、自身に代わって参加させます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860319,
					"content": "「武人」役を演じるのは、もちろん大会の優勝者です。「神の眷属」役は官僚出身の剣士が演じます。そして、この役割を「神使代行」と呼ぶのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860320
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860320,
					"content": "今回、私が「神使代行」を務めさせていただくことになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860321
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860321,
					"content": "そうだったのか！この大会が人気な理由がやっとわかったぞ！綾華は稲妻の人たちの間で大人気だもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860322,
					"content": "そうですね。白鷺の姫君は祭事などの儀式に出席はしますが、その優れた剣術を間近で見る機会はそうありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860323
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860323,
					"content": "大衆向けの大会を開催するには、影響力のある方に広報大使になっていただかないと、と将軍様はおっしゃいました。ですから「神使代行」の役割が務まる人は綾華さん以外いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860324
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860324,
					"content": "あっ、こちらは八重堂の小野寺さんです。様々な催事の企画を担当していて、私たちの助っ人でもあります。綾華さんに「神使代行」を担当してもらうのも彼の提案です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860325
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860325,
					"content": "他にも、「対象者の拡大」や「話題作り」の面で彼は様々な提案をしてくれました。大会の人気を一気に高めてくれたのでとても助かっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860326
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860326,
					"content": "おおっ、これぞプロってやつだな！でも、その案って具体的になにをしたんだ？もう少し詳しく知りたいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860327,
					"content": "「対象者の拡大」というのは、より多くの人に大会に参加してもらうことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860328,
					"content": "今まで演武伝心の参加者は、稲妻の剣術流派に属する人でなければいけませんでした。しかし、今回は国籍や身分を問わず、武芸の心得さえあれば誰でも参加できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860329
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860329,
					"content": "また、試合で使用する武器も片手剣だけではなく、近接武器で、長さと重さが大会の基準を満たしものであれば問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860330
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860330,
					"content": "それから「話題作り」について、私個人の経験で一番有効的な方法は——投票を行うことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860331
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860331,
					"content": "投票？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860332
					]
				},
				{
					"id": 736860332,
					"content": "はい。「神使代行」は模擬試合で華麗な服を身にまといます。以前は将軍様が衣装を指定していましたが、今回は将軍様の許可を得て、選択権を観客に委ねました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860333
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860333,
					"content": "皆さんは「春櫻」や「秋葉」など、四季の風物詩をなぞらえた衣装の中から選んで投票します。神里さんにはもっとも票を得た衣装で模擬試合に参加していただく予定です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860334
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860334,
					"content": "投票は大会当日から始まりますが、うちの使用人たちは衣装がどういったものになるのかもう話し合っているんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860335
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860335,
					"content": "神里さんが「神使代行」を務めることに応じてくれたおかげで、これらの案は成立しました。もちろん神里さんにとって、これはかなりの重圧であると理解してはいますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860336
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860336,
					"content": "お気になさらないでください。剣術の普及に役立てるのなら、私にとっても光栄なことです。それに、小野寺さんが大会のために力を尽くしてくれていることは、誰もが認めていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860337
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860337,
					"content": "そんな、褒めすぎですよ。さて皆さん、私はこれから帰って投票の準備をしますので、お先に失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860338
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 736860338,
					"content": "旅人さんにパイモンさん、せっかく来てくださったのですし、ここの環境に馴れていただくためにも、千里さんと一緒に会場までご案内しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860339
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860339,
					"content": "やった！さっそく行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7368604,
			"completionStepIds": [
				7368606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368606",
							"2"
						],
						"stepId": 7368606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華",
					"柊千里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736860401,
					"content": "立派な会場だな…遠国監察にこんなところがあるなんて、知らなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860402,
					"content": "ここは勘定奉行の室内訓練場です。今回は千里さんのおかげで、この会場を借りることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860403
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860403,
					"content": "お気になさらないでください、綾華さん。お役に立てて私も嬉しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860404
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860404,
					"content": "千里、あれはなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860405,
					"content": "あっ、あれですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860406
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 736860406,
					"content": "旅人さん、あの…少しよろしいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860407
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860407,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860408
					]
				},
				{
					"id": 736860408,
					"content": "ええと、どこから話せば良いのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860409
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860409,
					"content": "「手紙」のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860410
					]
				},
				{
					"id": 736860410,
					"content": "はぁ…やはり貴方の目はごまかせませんね。実は、「神使代行」を担当してもらいたいという話をいただいた時、本当は少し不安だったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860411,
					"content": "小さい頃から公の場に顔を出してきたとはいえ、剣術大会の広報大使として、しかも華麗な衣装を着て演武に参加することは、これが初めてです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860412
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860412,
					"content": "過去に「神使代行」を担当してきた方は、どなたも稲妻の官僚で剣術に精通しているお方でした。その方々と比べて、私はまだまだ未熟だと思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860413
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860413,
					"content": "この役割をちゃんと果たせるかが心配で…だから手紙を書いて、貴方の意見を聞こうと思ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860414,
						736860415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860414,
					"content": "友達だから、気を遣う必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				},
				{
					"id": 736860416,
					"content": "はい、承知しております。しかしだからこそ、あの手紙を出さなかったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860417
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860417,
					"content": "今まで何度も助けていただいて、悩みもたくさん聞いていただきました。でもいつも貴方ばかりに頼っていたら、まるで「負けた」ような気がするのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860418
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860418,
					"content": "ふふっ、友達なのにおかしな考え方でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860419,
						736860420
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860419,
					"content": "おかしくはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860421,
					"content": "ありがとうございます。でも今日、貴方も大会に参加することを聞いて、とても嬉しく思っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860422,
					"content": "綾華…ってあれ、二人ともなに話してたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736860423,
					"content": "#旅人さんが大会に出ると聞いて嬉しい、と話していたのです。{M#彼}{F#彼女}の稲妻での人望をもってすれば、大会の知名度もますます上がるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 736860424,
					"content": "へへっ、こいつが出れば、絶対いい試合になると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
