			"dialogs": [
				{
					"id": 120480101,
					"content": "あっ、お客様、受付はこちらになります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120480102,
					"content": "こんなに人が大勢来るなんて…何か特別な日だったかしら？こうなるって知ってたら、人数制限をしてたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "柴葉紫"
				},
				{
					"id": 120480103,
					"content": "おおっ、江村一玄斎の件が解決したおかげか、お店が大繁盛してるぞ。紫と白音も体調がだいぶ良くなったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120480104,
					"content": "おはよう、旅人、パイモン。予約しに来たのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480105,
					"content": "おう！さっそく今日お願いできるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120480106,
					"content": "じゃあ、二人にもう一枚、特別招待券を用意するよ。うちの貴賓だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480107,
					"content": "やった！オイラ、今度は美味しい食事からでもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120480108,
					"content": "…おや、先日手を引くよう助言したばかりじゃったが、まさかこれほどまでに人で賑わっておるとは…あやうく繁盛店を捨てさせるところじゃったな。妾を恨んだりしておらぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480109,
					"content": "恨むも何も、はなから神子の助言なんて検討にも入れてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480110,
					"content": "その口ぶり、相変わらずじゃのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480111,
					"content": "またいきなり現れたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120480112,
					"content": "お早う、童たち。ゆうべの夜景はどうじゃった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480113,
					"content": "覗いてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "覗く？あの木は鳴神大社の下にあるのじゃぞ？まさか、鳴神大社を引っ越せとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480115,
					"content": "「宮司様」、ここにはどのような御用件で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480116,
					"content": "ふむ…ただの散歩じゃよ。ついでに天領奉行からの知らせを伝えにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480117,
					"content": "ゆうべ、瑞希のとこの一族が水中から引き上げたあやつじゃが、一命を取り留めたぞ。じゃが、精神が子供の頃にまで戻ってしまったようじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480118,
					"content": "その程度で済んでよかったよ…それから神子にもお礼を言わせて。昨日の件を無事解決できたのは、キミのおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480119,
					"content": "ほう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480120,
					"content": "な、何も言ってないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "キミとあたしの間で心の内を隠しきれないのは、いつも決まって神子のほうなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480122,
					"content": "キミに対する劣等感や対抗心といった感情はもちろんある。むしろ、この二つの感情があるからこそ、今の事業を経営する活力を得られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480123,
					"content": "劣等感があたしを常に冷静にさせ、対抗心があたしの背中を押し続けてくれる。こういう負の感情も今や自分の中では上手く扱えてるから、キミがそこまで気を遣う必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480124,
					"content": "はぁ…最初から互いにハッキリ言っておれば、童たちも行ったり来たりせずに済んだようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480125,
					"content": "旅人の行動にはちゃんと意味があったよ。「宮司様」の都合も考えないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480126,
					"content": "あの江村一玄斎は大勢の信者を集めた。彼の正体が明らかになる前に、鳴神大社の宮司様が軽率に介入して圧力をかけたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480127,
					"content": "騒がしい信者たちが鳴神大社の名誉にどれだけの影響を及ぼしてたかは計り知れない。だから、宮司様は表向きに口を出さなくてよかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480128,
					"content": "無論、妾もその可能性については考えておった。じゃが、やはり妾にとって気掛かりだったのは友の気持ち。だからこそ、あのような回りくどい方法を取ったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480129,
					"content": "神子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480130,
					"content": "相変わらず、面白いが可愛げのないやつじゃのう…やはり汝の悩みを妾が先回りして心配する必要なぞなかったようじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480131,
					"content": "…あたしだって悩みはある。でも、悩みにはそれぞれほぐし方があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480132,
					"content": "新しい招待券だよ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夢見月瑞希"
				}
			]
		},
