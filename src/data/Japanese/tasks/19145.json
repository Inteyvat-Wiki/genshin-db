			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "おばあさんとお孫さんに、鳴神主尊のご加護がありますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 191451602,
					"content": "ばあさんの目について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "あなたたちも気付きましたか。そうです、おばあさんは目がよく見えないんです。毎回ここまでいらっしゃるのも心配ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 191451604,
					"content": "でも、彼女は「何十年も歩いてきたんだから独りでも大丈夫よ」なんて言って、いつも私たちに迷惑をかけたがらなくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 191451605,
					"content": "幸い、山道にも神社の巫女がいるので、多少なりともおばあさんのお手伝いが出来るんですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 191451606,
					"content": "鳴神主尊様、おばあさんとお孫さんがご無事でありますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲城蛍美"
				}
			]
		},
