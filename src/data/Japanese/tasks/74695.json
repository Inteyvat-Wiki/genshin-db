					}
				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "こんにちは、トリスメギストスさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950102,
					"content": "おや？その名前を正確に言えるとは、どうやらわしらには共通の友人がいるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950103,
					"content": "コロンビーナというお嬢さんに、ここを勧められてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950104,
					"content": "あれはまったく、予測困難な娘だからね。おまえさんたちの出会いもさぞかし驚きに満ちておったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950105,
					"content": "まさにその通り。「予測困難」という評価にも同意する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950106,
					"content": "初めまして、俺はリオセスリだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950107,
					"content": "ああ、水の下を統べる公爵だね。会えて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950108,
					"content": "まさか偉大なる魔女の一人が俺のことを知ってたなんて、光栄の至りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950109,
					"content": "それとも、占星術師であるトリスメギストスさんは、俺が来るのもすでにお見通しだったのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950110,
					"content": "ふふ…お互いに素性を知っておるのなら、堅苦しい挨拶は抜きにしようじゃないか。わしのことはバーベロスと呼べばよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950111,
					"content": "なら、俺のこともリオセスリと呼んでくれ。今は公務時間外だからな、ただのフォンテーヌの一市民に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950112,
					"content": "さっき、通りがかりに焼きたての晶螺マドレーヌを見かけたんだ。魔女はお茶会で談笑するのが好きだと聞いてる。よかったら、これを受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950113,
					"content": "おや、確かにこれはわしらの茶会で大人気の菓子だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950114,
					"content": "わしがここに滞在し始めてから随分経つ。多くの者に予言を贈ってきたが、先に贈り物を受け取るのは初めてだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950115,
					"content": "感謝するよ、リオセスリさん。アリスたちと美味しくいただくとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950116,
					"content": "…聞こえたよ、バービー。絶対に私の分も残しておいてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950117,
					"content": "前みたいに、私が遅刻したからってニコが黙って全部食べ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950118,
					"content": "コホン！分かった分かった、今度こそ必ず残しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950119,
					"content": "まったく、おまえはどうしてこうもタイミングよくやって来るんだい。新しくできた友人の前で、魔女会の威厳を保つこともできやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950120,
					"content": "俺はこんなことであんたらの評価を下げたりはしないさ。それに、優れた能力を持つ人が活発な性格じゃいけないなんて決まりはないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950121,
					"content": "その通り！楽観的で朗らかな性格は、魔女会の入会条件の一つだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950122,
					"content": "そんな条件、初めて聞いたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950123,
					"content": "だって今思いついたんだもの！魔女会は世界に喜びをもたらす組織なんだから、そもそも私たち自身が明るく前向きでなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950124,
					"content": "俺の個人的な意見だが、あんたらが思うままに生活を楽しむことには賛成だ——当然、法や規律を犯さないってのが前提だが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950125,
					"content": "その前提は、アリスの前では脆く崩れ去るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950126,
					"content": "おっと、そいつは心配だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950127,
					"content": "ちょっと、まだいるんだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950128,
					"content": "大丈夫よ、安心して。私だって、メロピデ要塞の管理人の前で無茶なことをするほど愚かじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950129,
					"content": "それに…もし収監されたとしても、そっちは西風騎士団の反省室より広いでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950130,
					"content": "ハハッ、まさか単なる反省室で、伝説の魔女を閉じ込められるとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950131,
					"content": "あんたが素直に罰を受け入れるのは、きっと本性は謙虚で義理堅いからじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950132,
					"content": "大正解！よく分かったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950133,
					"content": "待て待て、リオセスリさん。これ以上、こいつを図に乗らせないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950134,
					"content": "機嫌がいい時のアリスは、何をしでかすか分かったもんじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950135,
					"content": "そうだそうだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "ああ！よく考えたら旅人は騎士団の栄誉騎士なんだし、反省室の威厳を守らないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746950138,
					"content": "魔女の逃走を栄誉騎士が阻止するのか？なかなか面白そうな演劇になりそうだ。ぜひ見物させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950139,
					"content": "おまえは騒ぎを煽る野次馬かよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746950140,
					"content": "それにしても、公爵がもう来てたなんて思わなかったぜ。おかげで水の下へ行く手間が省けたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746950141,
					"content": "これが占いの力ってやつかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "ああ、そろそろ本題に入らないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950143,
					"content": "さて、リオセスリさん。コロンビーナの顔を立てる意味でも、菓子の礼としても、「月諭のアルカナ」を一枚引いとくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950144,
					"content": "もしかすると、運命の贈り物がその中に隠されているかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950145,
					"content": "これは一種の予言かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950146,
					"content": "そうとも言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950147,
					"content": "それなら、フォンテーヌ人として真剣に向き合うべきだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950148,
					"content": "「真剣に向き合う」と言いながら、リオセスリは一番上のカードを一枚手に取った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "俺はこの手のカードにはあまり詳しくないんだが、これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950150,
					"content": "正位置の「皇帝」だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950151,
					"content": "その何かを言いよどんでる様子から察するに、これは悪い結果か？遠慮せず、はっきり言ってくれて構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950152,
					"content": "いや、むしろその真逆だよ。このカードは永遠の統制と揺るぎない権威を意味しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950153,
					"content": "もしこれが未来への道を象徴するなら、おまえさんはとっくに目的地に辿り着いておるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950154,
					"content": "だが…ヒヒッ、おまえさんの「運命」はこれからも滔々と前進し続け、絶えず変化するようだ。それはつまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950155,
					"content": "もしかして、変わるのは人じゃなくて環境…ってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950156,
					"content": "ああ…今のところは、その傾向にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950157,
					"content": "なら、俺は自分の勘にもう少し自信を持ってもよさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950158,
					"content": "以前、公務でナド・クライを訪れたことがあって、かなり見識を広めることができた。その後も、現地のニュースを気にかけるようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950159,
					"content": "そしてある夜、ひときわ明るい月を眺めながらふと思ったのさ。この世界は、変化を遂げつつあるんじゃないか…ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950160,
					"content": "正しくは、「この世の万物は常に変化し続けている」だね。そして巨大な変数が介入した後は、わしらは皆、未知を迎え入れる準備をしなければならないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950161,
					"content": "だが、このカードの結果から見るに、おまえさんはそれほど心配する必要はなさそうだ。環境がどう変化しようとも、おまえはそれに適応する、あるいは対抗する能力が備わっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950162,
					"content": "そいつは喜ばしいことだ。どうやら、あの一発は殴られ損じゃなかったってことかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950163,
					"content": "素敵な願いが込められた一撃だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "ただ好奇心から、かなり不躾な質問をさせてもらいたいんだが…聞いてもいいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950166,
					"content": "ちょっとずるいんじゃない？リオセスリさんにそんな風に言われたら、私たちの好奇心がそそられるに決まってるでしょ！あなたが言いたくなくなっても、絶対に聞き出してやるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950167,
					"content": "なら、単刀直入に聞こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950168,
					"content": "ずっと気になってたんだが、本当の予言ってのは一体どうやってその実現を保証してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950169,
					"content": "俺を例にしてみよう。今の占いによると、俺は長期的に安定した状態にあるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950170,
					"content": "だが、もし俺がこの予言を知った上で反逆心を起こし、常軌を逸した行動を取ったら、結果はどうなるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950171,
					"content": "例えば、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950172,
					"content": "メロピデ要塞を吹っ飛ばすとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "ああ、それにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950174,
					"content": "まだそんなことを考えてたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746950175,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950176,
					"content": "あっ、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950177,
					"content": "ふふっ、それは奇遇ね！凄腕の爆破専門家を紹介できるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950178,
					"content": "そして栄誉騎士は、その専門家に同行する保護者として、いざという時にあらゆる悪いことから守ってあげるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950179,
					"content": "…ほら、予言はこうして達成されるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950180,
					"content": "どうやら、随分と破壊力のある専門家みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950181,
					"content": "そして、とっても可愛い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "あっ、クレーのことだな！公爵は知らないかもしれないけど、クレーはアリスの娘なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746950183,
					"content": "ううん、正確には、「諸世界の大冒険者」「悪い悪い大魔王」「旧モンドの守護者」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950184,
					"content": "長すぎるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950185,
					"content": "…とにかく、大魔王アリスの最高にかわいい子供で、名実ともに「火花騎士」の——クレーだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950186,
					"content": "はぁ…やっぱり元の計画通り、ちゃんとしたパーティーを開いてみんなに紹介したかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950187,
					"content": "そうすれば、クレーがフォンテーヌに遊びに来るたびに、新しい友達と一緒にお茶会ができるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746950188,
					"content": "いい考えだ。その日が来るのを楽しみにしていよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950189,
					"content": "美味いお茶の誘いとあれば、断るわけにはいかないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 746950164,
					"content": "災難の後には、必ずいいことが待ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "反省室には畏敬の念を持ってよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
