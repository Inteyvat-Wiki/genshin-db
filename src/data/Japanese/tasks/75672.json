				]
			},
			"dialogs": [
				{
					"id": 756720101,
					"content": "こんなところでアシャが楽しそうにしてるぞ。それに…ベネットもいたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720102,
					"content": "#あっ、{NICKNAME}にパイモン！また会ったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720103
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720103,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720104
					],
					"speakerTitle": "「カラーリスト・アシャ」"
				},
				{
					"id": 756720104,
					"content": "ベネット、またのびのびリゾートに遊びに来てるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720105,
					"content": "#ああ、{NICKNAME}が覚えてるか分からないけど、前に手紙で言っただろ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720106
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720106,
					"content": "何か月もかけて、報酬がたんまりもらえる依頼をたくさんこなして、モラを十分貯めたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720107
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720107,
					"content": "ようやく願いがかなって、オヤジたちと友達を「のびのびリゾート」に招待できた。それで今、思いっきり遊んでたところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720108
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720108,
					"content": "オヤジたちも、ナタだとほとんど不運と無縁なオレを見て、すっげー感動してたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720109
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720109,
					"content": "ああ！嬉しいことは、みんなにも知ってもらわないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720110,
						756720111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720110,
					"content": "最高の知らせだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				},
				{
					"id": 756720112,
					"content": "もう一週間早くお前たちに会えてたら、みんなでメシでも食べたかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720113
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720113,
					"content": "まあ、お前たちがモンドにまた戻ってきた時にでも、安全な場所を探して「安心安全の洞窟ディナー」を楽しもうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720114
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720114,
					"content": "ん、待てよ？…ってことは、オヤジさんたちや友達はみんな帰って、おまえ一人でリゾートに残ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720115,
					"content": "ああ、ちょうどオヤジたちが遊び尽くした頃に、偶然にも「キャッツテール」のディオナが、しばらく出張するらしいって知らせが届いたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720116
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720116,
					"content": "オヤジたちは特製ドリンクをもっと飲んでおきたいってことで、休暇を延長せずに予定通りモンドへ帰ることにしたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720117
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720117,
					"content": "でも、心配しないでくれ。オレがここに残ったのは、不慮の事故とか船のチケットを盗まれたとか、そういう理由じゃない。助けを必要としてる友達に出会ったからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720118
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720118,
					"content": "オレたちが海辺で釣りをしてたら、「カラーリスト」って呼ばれてるアシャを何匹か見つけたんだけど、なんだか困ってたみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720119
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720119,
					"content": "オレのこれまでの経験からして、あいつらはきっと特別な宝物を探してるんだろうなって分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720120
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720120,
					"content": "うーん…「カラーリスト」っていう肩書きがあるくらいだから、宝物っていうのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720121,
						756720122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720121,
					"content": "超すごい絵の具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720123,
					"content": "ああ、そういうことだ！アシャたちはそこら中にラクガキする以外にも、絵の具を探してコレクションするのも好きだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720124
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720124,
					"content": "「カラーリスト・アシャ」たちは、とある秘境ですごく特殊な絵の具を見つけたらしくてさ…なんでも、浮遊する成分らしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720125
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720125,
					"content": "その絵の具は晶蝶みたいにあちこち逃げ回って、「カラーリスト」たちもどう扱えばいいか分からなかったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720126
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720126,
					"content": "そういうことなら、オイラたちも協力するぜ。秘境に入ってみれば、なにかわかるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720127,
					"content": "もしかしたら、これまでにも同じようなトラブルを解決したことがあるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720128,
						756720129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756720128,
					"content": "アシャが困ってるなら、助けないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720130,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720131
					],
					"speakerTitle": "「カラーリスト・アシャ」"
				},
				{
					"id": 756720131,
					"content": "よし！一緒に「カラーリスト」を手伝ってやろうぜ！オレは、お前たちのやり方に従うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720132
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720132,
					"content": "アシャたちが最高の絵の具を集めて、きれいな色を作り出せるといいな。これまでとは違った楽しさを、みんなに届けてくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756720129,
					"content": "特別な物を集めるのは得意だしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720122,
					"content": "貴重な絵の具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720111,
					"content": "何度聞いても嬉しいよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				}
			]
		}
	]
}