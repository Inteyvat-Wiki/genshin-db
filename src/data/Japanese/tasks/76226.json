			"dialogs": [
				{
					"id": 762260101,
					"content": "メイラ、見てくれ！オイラたち、おまえの絵を全部見つけてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260102,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 762260103,
					"content": "へへっ、遠慮するなって。その絵にはオイラたちも関わってるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260104,
					"content": "メイラの言葉が分かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "なんだよ、オイラたち一緒に何度も銀月の庭に行ってるんだから、メイラの言ってることがわかってもおかしくないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260106,
					"content": "じゃあ、メイラが絵をなくした理由は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "えっと…その…ちょっと整理させてくれ…メイラが言うには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260108,
					"content": "他の月霊が盗んだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260109,
					"content": "いや…それか、月のあの不思議な運搬装置が盗んだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260110,
					"content": "あるいは…コロンビーナが盗んだのかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260111,
					"content": "それはあり得ないでしょ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "うーん…？まさか、オイラの勘違いだったりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260113,
					"content": "ただの当てずっぽうでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "ふん、知らない言葉を勉強するのは簡単じゃないんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260115,
					"content": "オイラには優秀な先生が必要なんだ。機会があったら、コロンビーナにしっかり教えてもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
