			"dialogs": [
				{
					"id": 762260201,
					"content": "あれ、メイラじゃないか。まさか月で会うなんて、思いもしなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260202,
					"content": "コロンビーナが連れてきてくれたんだろ？月でおまえの展示会を開くって言ってたもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260203,
					"content": "そうだ、展示会といえば…おまえの絵はどこだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260204,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 762260205,
					"content": "どうしたんだ？まさか…なくしちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260206,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 762260207,
					"content": "どういうことだよ！ここは月なんだぞ、まさか盗まれた…わけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762260208,
					"content": "とにかく、まずはメイラの絵を探してあげようぜ。近くに落としちゃっただけかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
