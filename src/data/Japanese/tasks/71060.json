			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カタリナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "何？わざわざ休憩の邪魔をしに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591102,
					"content": "違うぞ。おまえ一人じゃ寂しいだろうと思って、話しに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710591103,
					"content": "一人でお酒を飲むのはつまらないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "…そう？ありがとう。あんたたちを見て…リュドヒカのことを思い出したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591106,
					"content": "彼女は心温まる人だった…あの頃、いつも私の傍にいて、何でも話してくれたわ…それに、私にしか言わないことも沢山あった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591107,
					"content": "はぁ、リュドヒカもここにいたらよかったのに…彼女は面白い人よ、あんたもきっと気に入ると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591108,
					"content": "リュドヒカ？誰のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "リュドヒカはね…私の友達。真面目そうに見えるけど、本当は面白くてバカなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591110,
					"content": "「壁炉の家」にいた頃、私たちは姉妹のように仲良しだった…いいえ、姉妹よりも親しいかもしれないわ。私にからかわれるのが好きで…私も彼女に色々面倒を見てもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591111,
					"content": "ふふ、とにかく、彼女は外でよくやっている気がする。それを思えば、私がここで負った傷なんか大したことじゃないって思うようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591112,
					"content": "彼女も真面目に任務を遂行しているといいわ…私のことなんて思い出さなくてもいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591113,
					"content": "リュドヒカ…稲妻にいるあの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591115,
					"content": "それって…そっか。彼女、バレたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591116,
					"content": "え…なんでわかるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710591117,
					"content": "彼女は…何とか脱出した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "そうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591120,
					"content": "はは…ならよかったわ。彼女も真面目に任務を遂行しているといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591121,
					"content": "もし彼女が自分の人生を生きるために、女皇陛下の意志に逆らったのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591122,
					"content": "…私のことを思い出さないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710591118,
					"content": "彼女はまだ生きていて、元気に過ごしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "話し相手になってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
