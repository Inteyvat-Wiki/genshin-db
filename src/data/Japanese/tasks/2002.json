			"dialogs": [
				{
					"id": 20021201,
					"content": "あれ？北斗はいないのか？まさか船に乗って帰ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021202,
					"content": "北斗姉様なら、凝光さんに呼ばれていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021203,
					"content": "今回の「南十字武闘会」の規模が、報告していたものより何倍も大きく、見て見ぬふりできなかったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021204,
					"content": "北斗姉様は「つまらない女だ」と愚痴をこぼしながら璃月港へと戻りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021205,
					"content": "あははっ、姉君と凝光殿のいざこざは、いつものことでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021206,
					"content": "ただ、北斗姉様は優勝者の誕生を見られなかったことをとても残念がっていました。璃月港に戻られる前も、ずっとそのことについて話していましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021207,
					"content": "実は神の目を盗んだのは、この大英雄が本来決勝戦で戦う相手だったのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021208,
					"content": "勝算がないと悟り、賞品を盗むという邪念が生まれたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021209,
					"content": "然らば、この「南十字武闘会」の結果もおのずと決まったも同然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021210,
					"content": "そ、そうだったのですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021211,
					"content": "では規則に則り、対戦相手は資格を失いましたので、優勝者は大英雄様となります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021212,
					"content": "こんな優勝の仕方、思ってもなかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021213,
					"content": "いえいえ、私は「名実伴った結果」だと思います。いま特別に用意した優勝牌をお渡ししますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "珠函"
				},
				{
					"id": 20021214,
					"content": "じゃあ、稲妻に行けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "そうであろうな。姉君は今いないが、あとで伝えておくでござる。姉君は決して約束を違えたりせぬからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021216,
					"content": "だが、稲妻へと続く海路は厳しく、雷雨が絶えず降り注ぐ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021217,
					"content": "果てしなく続く嵐は、雷電将軍が国を封鎖しようとする意志の表れであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021218,
					"content": "意志で天気まで変えられるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021219,
					"content": "璃月のモラクスが岩槍で孤雲閣を作ったように、雷電将軍もまた「俗世の七執政」、永遠の嵐を呼ぶことができる。驚くことではないでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021220,
					"content": "とにかく、「死兆星」号が稲妻に向けて出港するまでは時間がかかる。準備ができたらお主らに伝えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021221,
					"content": "この機に拙者もこの地を歩き回ってみたいでござる。璃月の広大な大地に、神の目を呼び覚ますきっかけがないかを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021222,
					"content": "きっと上手くいくさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021223,
					"content": "感謝する、お互いの旅に意味を見い出せることを願っているでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021224,
					"content": "最後に一つ忠告を——無尽の嵐の先に待ち受けているのは、お主らにとって最も困難な旅やもしれぬ、心せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
