		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "ふむ…まだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020202,
					"content": "まあいい、まずはあんたの入場から始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020203,
					"content": "全員静粛に。注目の大一番の始まりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020204,
					"content": "刺激的で緊張感あふれる「南十字武闘会」も、いよいよ決勝戦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020205,
					"content": "数多の劇的な試合の末、ついに二人の選手がこの舞台に辿り着いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020206,
					"content": "まず紹介するのはこちらの選手。会ったことはなくとも、その名は聞いたことがあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020207,
					"content": "#そう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}こそは、魔神オセルをも恐れさせ、ファデュイ執行官でさえ震え上がらせた、璃月に現れし異郷の英雄！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020208,
					"content": "おぉおおおおおっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "参加者"
				},
				{
					"id": 20020209,
					"content": "待ってました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "参加者"
				},
				{
					"id": 20020210,
					"content": "#準決勝ですでに{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}の素晴らしい戦いをみなも目にしたことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020211,
					"content": "本日の決勝戦は、その時をさらに上回るものとなるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020212,
					"content": "そして、もう一人の選手は…あぁ…まだ会場には来てないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020213,
					"content": "まったく、いったい何をやってんだ。決勝戦だし、他の試合みたいに棄権扱いにするわけにも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020214,
					"content": "すまないが、みんなもう少し待っててくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020215,
					"content": "時間を間違えた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "何はともあれ、会場に来てないのなら、この決勝戦は延期するしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020218,
					"content": "待ってくれ、何やら妙でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020219,
					"content": "姉君、賞品を確認しに参ろう。神の目が入った箱を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}、お主もついてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020216,
					"content": "怖気づいちゃった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
