			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"パイモン",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020402,
					"content": "ちっ…神の目がなくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020403,
					"content": "盗まれたのか？でもこんな真っ昼間から、いったい誰がそんなことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20020404,
					"content": "そもそも、いつ盗まれたのかもわからねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020405,
					"content": "まさか、どこぞの誰かにこのアタシが隙を突かれるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020406,
					"content": "急ぐ必要はない。どのような手段であろうと、自然の目は誤魔化せぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020407,
					"content": "ふむ…どうやら盗まれたのは今しがたのこと、まだ遠くへは行っておらぬようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020408,
					"content": "神の目は拙者が差し出した賞品、監視を疎かにし盗まれたのは拙者の責任だ。故に拙者が責任をもって取り戻すでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020409,
					"content": "分かった、そこまで言うなら、この件は万葉に任せる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020410,
					"content": "アタシはここに残って、武闘会を見に来た人たちに説明してこよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20020411,
					"content": "#うむ、{NICKNAME}、お主も共に来てくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020412,
					"content": "しょうがない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "でも、ここって島だぞ。追うって言っても、どこをどう追えばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20020415,
					"content": "拙者と共に来てくれ。もうじき「風」が吹くでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020413,
					"content": "まだ相手も来てないしいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"翔",
					"楓原万葉",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "この俺よりも足が速いとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020902,
					"content": "逃げるためせっかく船を用意したのに、まさか追いつかれるなんて思わなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020903,
					"content": "どれほど船が速かろうと、風の速度には追いつけまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020904,
					"content": "風？何を言ってやがるんだ…くそっ、分かったぞ。お前、神の目の持ち主だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020905,
					"content": "ちくしょう…俺にも神の目があれば…この神の目を光らすことさえできれば、お前らなんかに追いつかれないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020906,
					"content": "神の目とは関係ない。お主は「群衆」から姿を消すのが得意かもしれぬが、「自然」の目から逃れるすべを知らなかったようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020907,
					"content": "それに、逃走経路の選択にも隙が多い。また拙者が風を頼りに追うさなか、お主の得意気な高笑いが聞こえてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020908,
					"content": "言い換えれば、盗みの達人が持つべき3つの信条、「迅速」、「隠蔽」、「優雅」。お主はそれを何一つできておらんかったということでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020909,
					"content": "お、お前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020910,
					"content": "だがそれ以外に、拙者を一番失望させたのはその手にある神の目の状態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020911,
					"content": "——やはり、それはどのような「願望」にも反応するわけではないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020912,
					"content": "分かった分かった！今回は俺の負けだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020913,
					"content": "この神の目はずっと狙ってたものなんだ。今回の武闘会の参加者が、全員まともな流派すら持たないヤツらと聞いて申し込んだ。せっかく順調に決勝まで進めたっていうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020914,
					"content": "おまえが決勝戦の相手だったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20020915,
					"content": "俺の実力なら優勝は間違いないと思ったんだ！それなのに、突然お前らが現れて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020916,
					"content": "準決勝を見た瞬間分かったよ、俺に勝ち目はないって。でもここまで来たのに神の目を諦めるわけにいかないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020917,
					"content": "正当な方法がダメなら…みなの注目が北斗とお前に集まっている間に、過去に手を染めていた本業のやり方でと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020918,
					"content": "あれほど準備したのに、結局お前たちに追いつかれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020919,
					"content": "もう逃げ場はないから大人しくして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "くそっ、でも…やっぱり悔しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020923,
					"content": "まだ抵抗するなら、代償は大きくなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "それは脅しか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020928,
					"content": "分かった、だが約束は守ってもらうぞ！俺が持ってても光らなかったんだ、俺にとっちゃただのガラクタさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020929,
					"content": "そういうわけにはいかぬ。盗みを働いた罪は、海の規則に則り腕を切り落して償ってもらわなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020930,
					"content": "げっ！？うそだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020931,
					"content": "それに賞品を盗んで決勝戦に参加しなかった。「南十字」船隊の頭領北斗に恥をかかせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020932,
					"content": "どうやら、真っ赤に熱した鉄をお主の顔にあて、「盗人」の二文字を刻む必要があるでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20020933,
					"content": "おいおい、そこまでしなくてもいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20020934,
					"content": "くそっ、こんな残酷なヤツだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020935,
					"content": "話し合いがダメなら、やるしかねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔"
				},
				{
					"id": 20020921,
					"content": "賞品を返して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "でも、せっかく手に入れたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020925,
					"content": "言うことを聞けば何もしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "ほ、ほんとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20020927,
					"content": "賞品を返せば見逃す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
