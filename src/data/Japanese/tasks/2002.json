				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "く、くそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20021102,
					"content": "いやだ…やめてくれ、烙印だけは…！頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20021103,
					"content": "生死の狭間に陥り、全力を尽くそうとも神に振り向いてもらえぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021104,
					"content": "神の目を残して立ち去れ。拙者は気が変わった、お主への罰はなしとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021105,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20021106,
					"content": "どうした、もしかして自ら罰を受けたいと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021107,
					"content": "拙者は別に構わぬ、そのような武士道に則った覚悟は称賛に値するでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021108,
					"content": "いやいやいや、そんなわけないだろ。見逃してくれて感謝する、本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "翔"
				},
				{
					"id": 20021110,
					"content": "よく分かんなかったんだけど、脅しただけだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021111,
					"content": "そのような趣味はない、ただ神の目がまだあやつの手の中にあった故、最後の可能性を試してみたかったのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021112,
					"content": "人は窮地に陥った時、強大な力を発揮する。それが神の目を照らすきっかけになると思ったのだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021113,
					"content": "残念なことに、何も起こらなかったでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021114,
					"content": "つまり、最初からずっとそのために？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "そうでござるよ。光の消えた神の目に、もう一度光が灯るのか知りたかったのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021116,
					"content": "あやつが神の目を盗んだ時から、この「実験」に利用させてもらおうと決めていたでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021117,
					"content": "それに過去にも、幾多の方法を試してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021190,
					"content": "「主なき神の目が再び光を灯す」ことは、伝説でしか聞いたことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021191,
					"content": "だが、お主は複数の元素を同時に操れる。そんなものを目の当たりにすれば、不可能なことなどないと思うものであろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021192,
					"content": "さあ、お主も試してみるでござるよ。拙者の思い描く結果になるか確認したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021118,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "どうやら、なにも反応はないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021121,
					"content": "なるほど、お主でも無理であったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021122,
					"content": "気にするでない、こうなると予想はしていたでござる。これでこの神の目は、引き続き拙者と共にいることになるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021123,
					"content": "どうしてそんなに執着してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "そうだぞ、この神の目になにか特別な想いでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021126,
					"content": "それについては、ある故人の話をしなくてはならぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021127,
					"content": "だが拙者がやってきたことは、結局のところなんの意味も成さなかったでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021128,
					"content": "浪人の人生には、旅の「意義」や道すがらの花鳥風月以外にも、心に「道」があるのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021129,
					"content": "万葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20021130,
					"content": "ははっ、気まぐれに従ったまででござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021131,
					"content": "さあ、そろそろ戻るでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021132,
					"content": "うん、戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "では、もう一度拙者がお主に風の導きを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021134,
					"content": "もう少し気晴らしをしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "…拙者の心配はいらぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021136,
					"content": "だが、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 20021124,
					"content": "どうしても光らせたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
