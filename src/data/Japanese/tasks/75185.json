			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "ああ、腕の立つ旅人さんたちか。どうだい？まっくろタマゴは作ってみたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850702,
					"content": "作った。食べたら力が湧く感じがした！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "うんうん、そうだろう？あれには火山のエネルギーがたくさん詰まってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850704,
					"content": "毎日食べれば、体がどんどん丈夫になるって話だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850705,
					"content": "加熱しすぎで、気絶するところだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "ははっ、クセになる味だっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850707,
					"content": "慣れたら、食べられないってほどでもないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850710,
					"content": "まだだけど、次の機会に試してみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "ああ、それじゃ、旅の無事を祈ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				}
			]
