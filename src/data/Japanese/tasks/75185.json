			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "今、「火山卵チャレンジ」に挑戦すれば、アツアツのまっくろタマゴを味わえるよ！内容は至ってシンプル、あそこにある地熱噴出口を壊して、中の卵を取り出すだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				}
			]
		},
		{
			"id": 7518503,
			"completionStepIds": [],
