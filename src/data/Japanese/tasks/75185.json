					"ロント"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "まっくろタマゴって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "まっくろタマゴと言えば、うちの火山地帯でしか作れない絶品グルメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850303,
					"content": "鳥の卵を地熱噴出口に置いて、火山が噴出する燃素を利用してじっくりと焼く。それから絶妙なタイミングで取り出せば、最高のまっくろタマゴの完成だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850304,
					"content": "ただ、うっかり焼きすぎてしまうと、味が少し…かなり独特なものになってしまうけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
