				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "君たち、本当に見事な腕前だね！こんなに早くチャレンジをクリアするなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850402,
					"content": "どれどれ——おおっ、この真っ黒な色と濃厚な香り…これは食欲をそそるね。さあ、熱いうちに味わって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "ロント"
				},
				{
					"id": 751850403,
					"content": "それから、このレシピも持っていって。まっくろタマゴがまた食べたくなったら、それの通りに作ればいいから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロント"
				}
			]
		},
