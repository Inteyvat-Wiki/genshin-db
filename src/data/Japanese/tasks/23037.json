			"trigger": {
				"objectNames": [
					"ザカリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370501,
					"content": "最近なぜか患者が増えてきたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370502
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370502,
					"content": "マルフの件について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370503
					]
				},
				{
					"id": 230370503,
					"content": "マルフ？また何か難病に出くわしたのですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370504
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370504,
					"content": "マルフが困っている病気について説明する…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370505
					]
				},
				{
					"id": 230370505,
					"content": "やれやれ、何度も言ったのに。その程度の症状なら彼一人で十分治療できます。わざわざ私のところに来なくたっていいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370506
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370506,
					"content": "おそらくその患者が自分は重い病気だと信じ込んでいて、彼のような「村医者」を信じないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370507
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370507,
					"content": "患者を安心させるために、私に処方箋を頼んだんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370508
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370508,
					"content": "長年ずっとあそこで診療を続けるのも、苦労すると思いますよ…彼のために処方箋を書いてあげるから、メモしてくれますか、旅人君。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370509
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370509,
					"content": "えーっと、マルフが今回治したい症状はたしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370510
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370510,
					"content": "頭痛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370511
					]
				},
				{
					"id": 230370511,
					"content": "そうでした。頭痛には…前に彼に書いてあげた処方が使えますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370512
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370512,
					"content": "その処方にある生薬を煎じてから、<color=#00E1FFFF>ミント</color>を3つ加え…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370513
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370513,
					"content": "最後にミントを加えた薬湯を<color=#00E1FFFF>強火</color>でまた煎じる。だいたい…まあ、<color=#00E1FFFF>生薬が浮いてくるまで煎じ</color>ればいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370514
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370514,
					"content": "そうですね…あなたが忘れないように、書いておきましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370520
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370520,
					"content": "ザカリヤは処方箋を書いてくれた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230370515
					]
				},
				{
					"id": 230370515,
					"content": "ではすみませんが、この処方箋をマルフに届けてやってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370516
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370516,
					"content": "実際のところ、この処方箋は名目上は「薬」ですが、薬というよりはむしろ…うーん、何と言うべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370517
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370517,
					"content": "薬効はさほど強くないんです。栄養補給を中心とした一種の…サプリメントですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370518
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370518,
					"content": "だから完全に処方箋通りの薬が作れなくても、深刻な影響は出ません。せいぜい飲んでも効果がないというくらいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370519
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230370519,
					"content": "まあ、だから、マルフが自分で処方箋を調整すればいいのですけど。自信がないんですかねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				}
			]
		},
