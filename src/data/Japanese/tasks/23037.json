			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マルフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230370101,
					"content": "はあ、この病気は簡単には治らないな。やっぱりザカリヤ先生に助けてもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370102
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370102,
					"content": "重病人がいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370103
					]
				},
				{
					"id": 230370103,
					"content": "え？ああ、旅人くんか…別に重病というわけではないんだが、頭痛がひどい患者がいてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370104
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370104,
					"content": "薬を処方したんだが、あまり効かないようなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370105
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370105,
					"content": "他の薬を出せないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370106
					]
				},
				{
					"id": 230370106,
					"content": "コホン…それが無理なんだよ。今できる処方は、ほとんど一人で、手探りで見つけたもので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370107
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370107,
					"content": "ちょっとした病気やケガを治すくらいならいいが、ちょっと症状の重い病気になると、役に立たないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370108
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370108,
					"content": "だが幸い、城内で「ビマリスタン」を開業しているザカリヤ先生が、薬と処方箋を揃えておいてくれるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370109
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370109,
					"content": "そこで旅人くん、手伝ってもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370110
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370110,
					"content": "俺はまだ患者を診ないといけなくて、手が離せないんだ。代わりに城内に行ってザカリヤ先生から処方箋をもらってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370111,
						230370113
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370111,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370112
					]
				},
				{
					"id": 230370112,
					"content": "じゃあ頼んだよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370113,
					"content": "ザカリヤ先生は村に来てくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370114
					]
				},
				{
					"id": 230370114,
					"content": "たまに人を寄越して薬を届けてくれることはあるけど、ザカリヤ先生は忙しいから、村まで来てくれるような暇はないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370115
					],
					"speakerTitle": "マルフ"
				},
				{
					"id": 230370115,
					"content": "とにかく処方箋のことは頼んだよ、旅人くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マルフ"
				}
			]
		},
