			"dialogs": [
				{
					"id": 230200201,
					"content": "ラフィクが計算した船体材料の強度…確かに数字だけ見れば問題はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200202
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200202,
					"content": "でも、実際に進水したら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200203
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200203,
					"content": "ま、どうでもいいか。どうせ私の意見なんて聞かないだろうし…",
					"roleType": "TALK_ROLE_NPC",
