				"points": []
			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "おお！ありがとな、旅人。これは報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200502,
					"content": "しかしこの材料、予想以上に重たいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200503,
					"content": "とっとと建造を始めるぞ。こんな小さな船だ、いくらもしないうちに試験運航に入れるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200504,
					"content": "…浮き輪を用意しておいたほうがいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200505,
					"content": "おいおい、心配すんな。絶対に大丈夫だ、俺を信じろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				}
