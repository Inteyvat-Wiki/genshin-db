			"trigger": {
				"objectNames": [
					"ラフィク",
					"綺珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "…ですから、この部分の材料費をこんなに削るべきではないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200102,
					"content": "大丈夫だって、ここの強度は十分に足りてる。そこは何度も計算した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200103,
					"content": "はあ、計算では予測できない問題もたくさんあると言ったはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200104,
					"content": "何を言い争ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "おお、君か。あの船の設計について話し合ってたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200106,
					"content": "俺は船体強度を何度も計算して、安全性を確認したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200107,
					"content": "なのに綺珊は強度が不安だと言って譲らない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200108,
					"content": "あなたの言う「強度」は、あくまで机上の空論でしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200109,
					"content": "実際に船が進水したときに受ける力は、この数値をはるかに上回るはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230200110,
					"content": "理屈は分らんでもない…だが、手元のカネには限りがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200111,
					"content": "もっと高い材料を買うことになってみろ、そうなったら、せいぜい竜骨を作っておしまいだぜ…コホンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200112,
					"content": "とにかく！この船は俺のプランで進めるぞ。材料だってもう全部買ってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200113,
					"content": "旅人、もしよければ、材料の一部を先に運んでくれないか？俺一人じゃ運びきれなくてさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200114,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "じゃあ頼んだぞ、俺はここで計算を続ける。それが終わったら、残りの材料も運ぶよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200115,
					"content": "綺珊も造船に詳しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "そりゃそうだ。こと計算に関して言えば、俺より速いくらいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230200117,
					"content": "なんであいつ、ここで店員なんかやってるんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "ラフィク"
				}
			]
		},
