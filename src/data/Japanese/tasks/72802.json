			"dialogs": [
				{
					"id": 728020601,
					"content": "竺子はどこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020602,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "仕事だとしても、出発前は私たちに一声かけるはずよ。でも今日、あの子は何も言わずに立ち去ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020605,
					"content": "昨夜、あなたが離れた後、竺子は疲れたと言って、部屋に戻って寝たわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020606,
					"content": "夜が明けて、私たち夫婦が起きた時には、あの子はもう自分のベッドにはいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020607,
					"content": "娘の姿がどこにも見当たらなかったから、夫は遠くに探しに行ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020608,
					"content": "しかし、この辺りを全部探しまわったけど、娘の痕跡すらなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020609,
					"content": "あの子、また旅に出ちゃったのかしら？どうすればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020610,
					"content": "母さん、心配するな。後で探しに行くから、まず家で竺子の部屋を掃除しといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020611,
					"content": "竺子のやつ、窓を開けたままだったから、部屋に葉っぱが沢山入っちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020612,
					"content": "そうだ旅人、これが約束してた報酬だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020613,
					"content": "ああ、竺子は一体何をしているの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "満"
				},
				{
					"id": 728020603,
					"content": "竺子はまた仕事に出かけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
