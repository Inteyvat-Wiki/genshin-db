					"満",
					"曜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "明日のお昼ご飯、おかずは何種類がいいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020202,
					"content": "俺らの子はたくさん食べるようになった。多めに作っておけば問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020203,
					"content": "えっと、お前さんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020204,
					"content": "ここは竺子の家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "そうだが、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020207,
					"content": "竺子から頼まれた手紙を届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "手紙？どうして急に手紙を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020209,
					"content": "しかもこんなに長い…もう家に帰ってるんだから、言いたいことがあったら直接言えばいいのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020210,
					"content": "…え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "その…旅人、驚いているみたいね。うちの竺子はしばらく旅をしていたけど、今は家にいるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020213,
					"content": "帰っているのに、わざわざ人にお願いして手紙を送るわけないわ。人違いじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020214,
					"content": "ちょっと、母ちゃん。少し読んだけど、この筆跡と言葉遣いは、確かにうちの娘だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020215,
					"content": "手紙にも、すぐに戻る予定はないから、元気でいてくれって書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020216,
					"content": "どういうこと？あの子、旅人に手紙を頼んでいながら、こっそり帰ってきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020217,
					"content": "とにかく誤解があるみたいだ。彼女が帰ってきたら聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020218,
					"content": "旅人、あいにくうちの竺子は用事で外出してるんだ。戻ってきたらしっかり聞いてみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020219,
					"content": "もしよかったら、夜にも一度来てくれないか。竺子に説明してもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020220,
					"content": "いま彼女はどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "仕事で忙しいって、夕飯の後に急に出て行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020224,
					"content": "ええ、あの子は毎日早く出かけて夜遅く帰ってくるの。夜しか会えないから、一体何をしているのか分からないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020225,
					"content": "とにかく、明日の夜に来てくれ。あの子が間違っていたら、直接謝ってもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020226,
					"content": "遥々遠くから来たのに、ごめんなさいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020227,
					"content": "竺子のやつ、世話が焼けるんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020222,
					"content": "どうして夜なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "仕事で忙しいって、毎日、昼にご飯を食べ終わると急に出ていくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020211,
					"content": "竺子…帰ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "竺子の両親？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
