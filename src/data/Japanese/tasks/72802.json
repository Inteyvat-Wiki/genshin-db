			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "娘が帰った日…この手紙に記された日付よりも早いとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020302,
					"content": "誤解だと思うから、深く考えないで。それよりも、明日のお昼ご飯を何にするかを考えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "満"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
