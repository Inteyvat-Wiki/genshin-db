				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "うちの竺子は今いないから、夜にもう一度来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020402,
					"content": "夜になれば、戻ってくるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "満"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竺子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "竺子たちは家にいるはずだ。ノックしてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728020502,
					"content": "何か話しているみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "そういえば、以前保護した狸、今の様子はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020504,
					"content": "お前は優しいな。あの狸の傷は小さなもんだ。草むらにおいて行っても、自分で治せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020505,
					"content": "だってかわいそうだから。私、見ているだけで涙が出ちゃった。放っておくわけにはいかないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020506,
					"content": "まあ、良いことだし、面倒を見てやろうか。ただ、こいつはちょっと食べすぎだな。俺と同じくらい食べるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020507,
					"content": "門をノックする",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020509,
					"content": "この前の旅人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "ああ、この前の旅人か、ちょっと待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020511,
					"content": "こ、こんにちは！私は竺子です、はじめ…いえ…また会いましたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020512,
					"content": "ごめんなさい、家を恋しく思い過ぎて、手紙を渡した後にまた心が変わって、船で家に帰ってきちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020513,
					"content": "あはは…だから全部誤解だったの。ごめんなさい、遠くからわざわざ来てくれたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020514,
					"content": "稲妻に帰る方法があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "それは…個人的な方法があるの。気にしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020516,
					"content": "その、報酬は準備してあるから、受け取って。手伝ってくれてありがとう！じゃあ…あなたたちも忙しいと思うから、早く仕事に戻ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020517,
					"content": "竺子の話って矛盾してないか？稲妻に簡単に行き来できるんなら、始めっからどうしてオイラたちに頼んだんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728020518,
					"content": "璃月でのビジネスは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "ビジネス？なんのビジネス？私って璃月にビジネスがあったの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020522,
					"content": "…ああ、そういうのはただの財産で、家族に比べれば全くどうでもいいことよ。もう他の人に任せてあるの…はは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020523,
					"content": "おいおい、本当の竺子は璃月で仕事を探すだけでも精いっぱいなのに、一瞬でお金持ちになったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 728020524,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}はいったい何者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "も…もちろん竺子だよ！見た目は竺子、声も竺子。疑うところなんてないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020526,
					"content": "あなたねぇ！ちょっとしつこい…まあいいわ。明日も仕事があるから、とりあえず帰るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 728020527,
					"content": "あら、竺子！あの子ったら…急に怒り出しちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "満"
				},
				{
					"id": 728020528,
					"content": "旅人、すまない。あの子、きっと仕事で疲れてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020529,
					"content": "でも見た通り、確かに俺たちの娘だ。お前さんが持ってきた手紙について…彼女は本当に忘れてしまったのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020530,
					"content": "いずれにせよ、助けてくれたことは感謝する。報酬は…もう少し待ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020531,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "そんなことない。報酬くらい問題ないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020534,
					"content": "竺子のやつ、昼は仕事してるだろ？だが、彼女が毎日持って帰る給料がなんかおかしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020535,
					"content": "いつも変な種や果物とかで、モラを持って帰ったことは一度もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020536,
					"content": "あれも金にはなるが、売りに行く必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020537,
					"content": "お前さんのような旅人にとっても、報酬は直接モラを渡す方が便利だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "曜"
				},
				{
					"id": 728020538,
					"content": "明日、また来てくれ。その時にモラを渡す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曜"
				},
				{
					"id": 728020532,
					"content": "難しいのであれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "璃月の豪邸は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "豪邸？なんの豪邸？私って璃月に豪邸があったの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "竺子"
				}
			]
		},
