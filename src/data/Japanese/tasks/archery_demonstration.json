			"dialogs": [
				{
					"id": 220470101,
					"content": "また当てられなかった…一体どこに問題が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470102,
					"content": "弓の練習をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "あなたはこの前の…以前は、弓の手本を見せていただきありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470104,
					"content": "あなたのおかげで、今はもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470105,
					"content": "百発百中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "えっと、そこまでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470108,
					"content": "でも、今は10本中、5本は的に当てられるようになりました…あなたの指導のおかげです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470109,
					"content": "教官の要求にはまだ程遠いですが、引き続き頑張ろうと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470110,
					"content": "あっ、せっかくいらしたんですし、もう一度僕に手本を見せてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470111,
					"content": "あなたの手本を見ると、なんだか早く進歩できる気がするんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470112,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "ありがとうございます、勉強させていただきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470120,
					"content": "手本の件、よろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470114,
					"content": "この前の問題は解決した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "それって…姿勢が正しくない、力が足りてない、弓を握る手が安定してない…という問題でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470116,
					"content": "正直、まだ解決してる途中です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470117,
					"content": "しかしそれらの問題以外に、もっと心配なのが…仮に本当に戦場に出たとき、今まで学んできた技術をきちんと発揮できるかどうか不安です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470118,
					"content": "しかし、そのことを悩む前に、まずは技術をきちんと鍛える必要がありますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470119,
					"content": "手本の件、よろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470106,
					"content": "百歩穿楊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
