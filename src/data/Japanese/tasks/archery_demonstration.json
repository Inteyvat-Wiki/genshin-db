			"dialogs": [
				{
					"id": 220470401,
					"content": "あなたの射撃技術、以前と同じくとても洗練されたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470402,
					"content": "ちゃんと見えた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "はい、弓を握る姿勢も、弓を引く方法も…全部見えました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470404,
					"content": "しかし、なんと言うか…あなたの手本を見れば見るほど、自分とあなたの差を体感してしまいます…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470405,
					"content": "こ、この話はひとまず置いといて…これを受け取ってください、手本を見せてくれたお礼です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470406,
					"content": "僕はこのあと練習を続けます。次の目標は…10本中、7本的に当てること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				}
