			"dialogs": [
				{
					"id": 200010901,
					"content": "旅人、あいつらを追い払ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200010902,
					"content": "来てくれてありがとう。しかし、障害物がここにある限り、ここを抜けられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200010903,
					"content": "このままだと、せっかく取ったフルーツが全部腐ってしまうよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200010904,
					"content": "この障害物をなんとかしてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "クイン"
				},
				{
					"id": 200010905,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "ハハッ、じゃあよろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイン"
				},
				{
					"id": 200010906,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "あっ？なあ、最後まで助けてくれよ！君だけが頼りなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイン"
				}
