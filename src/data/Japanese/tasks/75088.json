			},
			"dialogs": [
				{
					"id": 750880101,
					"content": "どうだ、「光の刻印」の欠片は見つかったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キューニュオ"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キューニュオ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "ははっ、素晴らしい！これで「光の刻印」に書かれた金の模様を解読できる…報奨金は俺のものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880202,
					"content": "というか、もし今回も失敗してたら経費が底をついてしまっていたからな。まさにのるか反るかの瀬戸際だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880203,
					"content": "そうそう、君たちへの報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キューニュオ"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キューニュオ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "うーん、十分なサンプルさえあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880302,
					"content": "なあ、ぼそぼそひとりごと言ってる変なやつがいるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750880303,
					"content": "俺みたいなやつ、ナタ中にいるさ。むしろ、変なのは君たちのほうだ…用がないなら、研究の邪魔をしないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880304,
					"content": "今月は予算をオーバーしちゃったから、研究会が報奨金を出す研究課題をこなして補填するしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880305,
					"content": "研究でモラがもらえるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750880306,
					"content": "ああ、「龍の遺物研究会」はそういう組織さ。報酬があれば、みんなもよりいっそう研究に励めるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880307,
					"content": "だから、今回は「光の刻印」の解読に挑んでるってわけだ…これまで誰も成し得なかったことだからな…報酬もかなり美味しいんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880308,
					"content": "ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880309,
					"content": "ただ、なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750880310,
					"content": "「光の刻印」を解読するには、まず十分な数の「光の刻印」の欠片を集める必要があってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880311,
					"content": "…もし君たちが「光の刻印」の欠片を探してくれたら、報酬を渡す…どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880312,
					"content": "君たちは見るからに熟練の冒険者だ。こういう依頼は慣れっこだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880313,
					"content": "引き受けないことはないけど、でもおまえ、今月すでに予算オーバーなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750880314,
					"content": "ああ、すでにオーバーしてるんだから、額が多少増えたところで問題ないさ…「光の刻印」の欠片を手に入れて、中身を解読すれば、モラがたっぷりもらえるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880315,
					"content": "欠片を探すのは手伝うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "ああ、「本物」を探してくれさえすれば大丈夫だ。はぁ…今月ある商人から秘源遺跡で見つかったってやつを買ったんだけど、偽物だったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880318,
					"content": "それで、モラをガッツリだまし取られて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880319,
					"content": "それで予算が足りなくなっちゃったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750880320,
					"content": "そう…だから、「光の刻印」の欠片で挽回したいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880321,
					"content": "欠片探しは頼んだよ！見つかったらここに持ってきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880322,
					"content": "そうだな…三つ、いや、四つあれば十分だ。それ以上は報酬が払えないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880316,
					"content": "それが役に立つかどうかは保証しないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
