				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "やあ！「光の刻印」の欠片を持ってきてくれて本当に助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880602,
					"content": "ただ、解読の作業があまりはかどってなくてさ…燃素銘刻と似てるけど、やっぱり思った以上に難しいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "キューニュオ"
				},
				{
					"id": 750880603,
					"content": "でも、もう逃げ道はないからな…何とか解読してみせるぞ。ははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キューニュオ"
				}
			]
		}
	]
}