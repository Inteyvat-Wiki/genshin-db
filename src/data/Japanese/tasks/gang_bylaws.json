			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "ねえ、どうしよう？今日は『七聖召喚』で遊べないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431002,
					"content": "場所を変える？でも、橋の下以外で大人にバレないところって言ったら、どこだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431003,
					"content": "ああ…いっそ、宵宮姉さんに頼んで、占拠してる人を追い出すために花火を上げてもらうのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431004,
					"content": "それはよくないだろう。確かに先にぼくたちを追い出したのはあいつだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "瑛太"
				},
				{
					"id": 191431005,
					"content": "だから、悪いのはあいつだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "奏太"
				},
				{
					"id": 191431006,
					"content": "ねえ…そろそろ家に帰って、宿題をやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "由真"
				},
				{
					"id": 191431007,
					"content": "勉強しないでカードゲームばかりしてたら、<color=#00E1FFFF>橋の下にいる大人</color>みたいになっちゃうかもよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "由真"
				}
			]
		},
