					"nextDialogs": [
						191431102
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 191431102,
					"content": "わ、分かってる。実際、もう走れないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "守"
				},
				{
					"id": 191431103,
					"content": "今は走れないかもしれないが、たとえ回復してもまた逃げようなんて思うなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 191431104,
					"content": "思わない思わない！もう逃げないって！",
