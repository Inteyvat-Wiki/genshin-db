				},
				{
					"id": 200390405,
					"content": "ハハハッ、電気水晶は「驚雷」だからね、「オイル」の鍵はカエルだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "ティマイオス"
				},
				{
