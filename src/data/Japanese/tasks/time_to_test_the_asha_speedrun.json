			"dialogs": [
				{
					"id": 150480101,
					"content": "…そんな危険を背負わせるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480102,
					"content": "さっきと話が違うだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480103,
					"content": "すまない…確かに時間はないが、ゲストの安全が最優先なんだ。どうか理解してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480104,
					"content": "旅人、ちょうどよかった。このスタッフを説得してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480105,
					"content": "テストしてくれるやつを探してるみたいだったから、経験豊富な冒険者だって証明して、テストの責任も背負うって言ったんだ。そこまでは良かったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480106,
					"content": "「危機に陥った経験」について話したら、何を言ってもテストさせてくれなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480107,
					"content": "ご厚意にはほんとに感謝してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480108,
					"content": "ただ、橋を渡る時に足を踏み外して水に落ちてしまうようなら、もう少し穏やかなアトラクションのほうが…あっちのビーチチェアとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480109,
					"content": "はぁ、そりゃそうだけど…オレは確かに条件を満たした冒険者なんだ！今までのはただ…運が悪かっただけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480110,
					"content": "本当に力になりたいんだ。実力は確かだから、信じてくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480111,
					"content": "#{M#俺}{F#私}が証明するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "ナタを救った大英雄がそこまでいうなら…じゃあこうしよう。まずは相棒のアシャに最初のテストを行ってもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480114,
					"content": "その様子を一緒に確認すれば、ルートが事前にわかるだろ？すべてが順調に終わったら、二回目のテストは任せるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "ガウン"
				},
				{
					"id": 150480115,
					"content": "アシャ、それでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "アシャ"
				},
				{
					"id": 150480117,
					"content": "よし、じゃあ任せたぞ、相棒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150480112,
					"content": "#{M#俺}{F#私}が保証する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
