					"content": "ファデュイのルールに従う気なんてさらさらないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "ルールに従うつもりが無いのなら、消えてもらいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
