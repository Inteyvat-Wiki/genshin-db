				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "アナタたちの執行官、「傀儡」よ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "えっ？い、いつの間にそういうことになったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761071103,
					"content": "フン、その度胸だけは買ってあげましょう。ここまでわかりやすい嘘をつかれるなんて、ファデュイも舐められたものですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "「傀儡」に…雇われた特別研究員だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "特別研究員？あのお方の機械とクーヴァキに対する研究は素晴らしいもので、他の追随を許しません。そんなお方が特別研究員を雇うなんて考えづらいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "科学研究には協力が不可欠だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "それもそうですね。あのお方のために、私もフォンテーヌ科学院の研究報告を集めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "リスト"
				},
				{
					"id": 761071303,
					"content": "ところで専門家なら、この陸巡艇の修理なんて朝飯前ですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "#ええと…{M#俺}{F#私}は理論研究が専門で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "そうだったんですね。クーヴァキの理論研究は最も難解な学問です…すごいんですね！陸巡艇はどちらかと言うと応用型の学問が必要となりますし、確かに一緒にはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "リスト"
				},
				{
					"id": 761071403,
					"content": "ですが、「傀儡」様はここにはいません。よろしければ、アザリア上官に聞いてみてください。あの方なら今後どうすべきか知っているかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "もちろん、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "陸巡艇をコンコンガンガンと何回か叩いた。今度こそ完全に動かなくなってしまった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "えっ…壊れちゃったぞ。どうするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761071504,
					"content": "フン、怪しいと思っていました。本当の研究員ならこんなホラを吹くわけありません…！やっぱり偽物だったんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "#{M#俺}{F#私}は彼女の先生だったんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "へえ！私があのお方のためにフォンテーヌ科学院の研究報告を収集していたとき、あのお方はモッソ博士の研究成果を大層褒めておられましたが、まさかあなたが…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "リスト"
				},
				{
					"id": 761071603,
					"content": "コホン…そういうこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "その通りだぞ！モ、モッソ博士の名前がこんなところにも伝わってきてるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761071605,
					"content": "フン、私の知る限り、モッソ博士は三十年前に亡くなっています。あなたも同じところに送って差し上げますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リスト"
				}
			]
		},
		{
			"id": 7610717,
