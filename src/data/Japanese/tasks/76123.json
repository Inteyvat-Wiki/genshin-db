			"dialogs": [
				{
					"id": 761230101,
					"content": "う～ん、いい匂いがするぞ！また食事中か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230102,
					"content": "なんだ？月霊たちが一列に並んで——コロンビーナがスープを配ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230103,
					"content": "ちょっと待っててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230104,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "月霊"
				},
				{
					"id": 761230105,
					"content": "わぁ、おいしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230106,
					"content": "果物の甘さと爽やかさが引き立ってて…こんなスープは初めてだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230107,
					"content": "おかわりする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230108,
					"content": "二杯頼むぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230109,
					"content": "…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761230110,
					"content": "料理を覚えたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "うん、イネファから簡単なレシピを教えてもらって、何回か作ってみたの。月霊や動物たちも気に入ったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230112,
					"content": "何か困ったこととかない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "うーん、袖が大きすぎて鍋の縁に触れちゃうところかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230114,
					"content": "（料理とは関係ないか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "それから、スイーツ作りはちょっと苦手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230116,
					"content": "温度とか分量を正確に測るのって難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230117,
					"content": "（あまり料理したことはないみたい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "（お菓子作りを一人で覚えるのは大変かも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "よかったら手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "本当？じゃ、まずはクルムカケを作ってみたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230121,
					"content": "しばらくして…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "味見してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230123,
					"content": "（少しだけ口に入れる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230126,
					"content": "（すっぱ…！思わず顔がくしゃくしゃになる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "（でも、後から甘みが…慣れれば割といけるかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230129,
					"content": "合格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "なんだなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230132,
					"content": "パイモンも食べてみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230134,
					"content": "うっ、うあぁぁ！すっぱ！なにかの罰ゲームか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230135,
					"content": "ふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230136,
					"content": "でも、後味は悪くないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "後味だけよくてもしょうがないだろ！こんなに酸っぱいって分かってるなら、最初に言ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230138,
					"content": "てっきりイタズラかと思ったぜ。食べたあとの反応を見て楽しもうとしてるのかってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230139,
					"content": "もう一回作ってみるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230140,
					"content": "しばらくして…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "できた。どうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230142,
					"content": "（…うん！これならいける！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "すごくおいしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "ほんとか？オイラもオイラも！わぁ、すごくおいしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230146,
					"content": "ほかの人にもおすすめできそう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230147,
					"content": "バッチリだ！なんだ、誰かにあげるためだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230148,
					"content": "うん…友達にプレゼントしたくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230149,
					"content": "素敵なプレゼントだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "キミたちが初めてここに来た日のこと、覚えてる？料理を作ってくれたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230151,
					"content": "失った力に比べたら、食事で補えるエネルギーなんてほんのわずかだったけど…食べ終わった後、不思議と心が満たされたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230152,
					"content": "どうしてなのか、あの時は深く考えなかったけど…今なら分かる気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230153,
					"content": "料理には、作った人の心が込められてるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230154,
					"content": "それをいただくってことは、作ってくれた人の温かさや優しさも身体に取り入れること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230155,
					"content": "見返りを求められないからこそ、心から愛おしいって思えるし、同じ気持ちでしか返せないんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230156,
					"content": "なんだか照れちゃうな。あのときは、おまえの機嫌を取りたいって気持ちがちょっとだけあったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230157,
					"content": "でも、今は違うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "うん。でも、私も友達のために何かしてあげたい…とても幸せな気持ちになるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230160,
					"content": "クルムカケを届けに行くけど、付き合ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230161,
					"content": "ほかにもちょっとしたプレゼントを用意したの。あ、でも、気づかれないように届けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230162,
					"content": "なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230163,
					"content": "みんながやってくれてたみたいに、私も「サプライズ」をしてみたいの。受け取ったときの反応も見てみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230164,
					"content": "ふぅ、これで配達完了だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230165,
					"content": "みんなの反応も面白かったな。コロンビーナからのプレゼントだって全く気づいてないやつもいたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230166,
					"content": "アイノは夢中で食べてたね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "想定内の反応だったし、全然気にしてないよ。みんなが喜んでくれればそれでいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230168,
					"content": "でも、ラウマはテーブルに置かれたクルムカケと花輪を見て、コロンビーナからだって気づいたみたいだったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230169,
					"content": "花輪はともかく…食べるのがもったいなくて、クルムカケを十分間も見つめてたのには、さすがに呆れたけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230170,
					"content": "お供えするかと思っちゃった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "でも、ヤフォダを驚かせちゃったね…こっそり後ろに置いたのがよくなかったかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761230172,
					"content": "飛び上がってたもんね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "ヤフォダはもともと警戒心が強いからな。でも、アシュルが爪とぎに気づいて、かきかきしてるのを見て、ほっとしたみたいだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761230174,
