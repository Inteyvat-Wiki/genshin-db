			},
			"dialogs": [
				{
					"id": 705340101,
					"content": "なんでまたボードゲームを作らないといけないんだよ、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340102,
					"content": "旅人！びっくりした…君も「召喚王グランプリ」に参加しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "ああ、これは協会の冒険者の一人が設計したミニゲームでさ、聞くところによれば…七聖召喚と戦闘を組み合わせた新しいボードゲームらしいんだ。「巧賽タクティクス」って言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340106,
					"content": "今回の「召喚王グランプリ」の開催には、俺たちの協会も協力してるだろ？それで協会がそいつのデザインした「巧賽タクティクス」を気に入ったらしくて、イベントとして出してるってわけさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340107,
					"content": "カードゲームと戦闘をどう組み合わせたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "ハハハ、正直に言うと、俺もよくわからないんだ。ここにルールブックはあるが…見てくれ、こんなに分厚いんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340110,
					"content": "でも俺の理解する限りじゃ、「サイコロ」の使い方が「巧賽タクティクス」の肝になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340111,
					"content": "とにかく、プレイしてみたいなら、ここに来て体験してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェイン"
				},
				{
					"id": 705340108,
					"content": "組み合わせが想像できない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "どんなボードゲーム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
}