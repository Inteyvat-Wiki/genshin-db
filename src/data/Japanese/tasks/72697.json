			"completionStepIds": [
				7269701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269701",
							"2"
						],
						"stepId": 7269701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バートランド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#ふっふっふっ、{NICKNAME}、パイモン、来てくれたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970102,
					"content": "俺のおもちゃ城が、ついにオープンしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970103,
					"content": "おもちゃ城？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970104,
					"content": "オホンッ、もちろん、おもちゃ城と言っても、俺と「大工機」しかいないんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970105,
					"content": "ちょっと工程を改善したんだ。今はもう、あんな長時間待たなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970106,
					"content": "「瞬時に完成」とまではいかないが、「ちょっとしたら完成」となら言ってもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970107,
					"content": "わぁ、なんかすごそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970108,
					"content": "それと、「素材収集器」も改良した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970109,
					"content": "以前は一つの工程ごとに戻ってくる必要があっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970110,
					"content": "それじゃあ効率が悪いと思って、調整したんだ。今は、収集状況に応じて現在の工程が更新されるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970111,
					"content": "収集状況に応じて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970112,
					"content": "工程を更新？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970113,
					"content": "意味が分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "うーん、どう説明したらいいものか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970115,
					"content": "例えば、一つ目の工程で夕暮れの実を十個、二つ目の工程で水元素、三つ目の工程で水スライムを二体倒す必要があるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970116,
					"content": "この「素材収集器」を持って、夕暮れの実を十個収集したら、一つ目の工程に必要な材料がすべて集まったと判断される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970117,
					"content": "そしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970118,
					"content": "そうか、自動で二つ目の工程の収集モードに入るんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970119,
					"content": "その通りだ。「元素チャージ」のモードに切り替わり、水元素を補充する。そして水元素の補充が終わったら、また切り替わって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970120,
					"content": "三つ目の工程に入る…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "そうだ。あとは水スライムを二体倒すだけでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970123,
					"content": "たしかに、便利になったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970124,
					"content": "そうだろ。丸一晩かけてこれを改良したんだ。名付けて、究極三位一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970125,
					"content": "「素材収集器」って、本当にすごいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970126,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970128,
					"content": "でも、どうしてこの「素材収集器」をオイラたちに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970129,
					"content": "ははっ、俺はしばらく離島でしか行動できない…だから、材料を集められないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970130,
					"content": "そこで、君たちには引き続き手伝ってほしい。もちろん、おもちゃの売り上げの一部は、君たちに渡そう。それと、おもちゃも無料で一つあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970141,
					"content": "前にあげた引換券は覚えてるかい？あれを使えば無料で引換ができるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970142,
					"content": "君が作ったおもちゃだったら、どれと引き換えてくれても構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970131,
					"content": "いや、オイラたちが頑張って材料を集めても、おもちゃを売ったお金の大半はおまえの懐に入るんだろ！しかも、おもちゃも一つしかくれないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970132,
					"content": "#そんな虫のいい話があるか。行くぞ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970133,
					"content": "じゃあ…分け前を増やそう。おもちゃは二つ…いや…三つやってもいいぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970134,
					"content": "行こう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "四つ！四つだ！これ以上は無理だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970136,
					"content": "はぁ…本当はおもちゃを全部あげてもいいんだが、万国商会にまだ借金があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970137,
					"content": "可哀想だから許す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "はぁ…そうだな。オイラたちがおまえの手伝いをしたのもかわいそうだと思ったからだし…決して、分け前のモラと四つのおもちゃのためじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726970139,
					"content": "へへっ、二人とも、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970140,
					"content": "これで、ひと安心できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726970121,
					"content": "「コア活性化」の工程に入る…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}