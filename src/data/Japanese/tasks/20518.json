			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "また会ったね、元気にしてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180102,
					"content": "そうそう、今のところジリアンナは良くも悪くもなってない。悪くないのは、まだモンドを離れてないこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180103,
					"content": "良くないのは、彼女がシスターヴィクトリアに自分のことを告白したけど、ヴィクトリアはまだ何の動きも見せてないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180104,
					"content": "この件はどう終わるか、気長に待つしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180105,
					"content": "…なにするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "そんな怖い目で見ないでよ、悪者じゃないし。ジリアンナを助ける方法を君に教えたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180107,
					"content": "さあ、本題に戻るよ。今回君を呼んだのは、前回の件で「ちょっとした問題」が残ったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180108,
					"content": "簡単に言うと、君が宝盗団を倒したのはいいことだけど、「ジリアンナがモンドにいる」ということを明らかにしたと同じよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180109,
					"content": "宝盗団は裏切り者を放っておくわけがない。私の知る限り、モンド周辺には宝盗団の痕跡が複数あって、しかも見たことのないやつらばかりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180110,
					"content": "おそらくジリアンナを狙って、ついでに復讐するつもりでしょうね。こんな危険なやつらは、君に倒してもらうしかないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180111,
					"content": "そっちが悪いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "まあまあ、こっちだって命令通りに動いただけだから。あの方がどうしても君がいいって言わなきゃ、私も君に頼んだりしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180121,
					"content": "まあまあ、安心して、今回はちゃんとした報酬を用意したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180122,
					"content": "今回はあの方からモラをたくさんもらったからね。前回なんて自費だったもん…そうだ、宝盗団の位置を標記しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180123,
					"content": "じゃあ、モラに免じて、ジリアンナ、ルドルフ、そしてリリーとモンドを守る任務は任せたよ。頑張れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180113,
					"content": "自分でなんとかして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "そんな悲しいこと言わないでよ、君みたいに実力を持ってるわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180115,
					"content": "それは西風騎士団の管轄だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "それはそうだけど、ジリアンナのことを知ってる人は少ない方がいいって、あの方がそうおっしゃったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180117,
					"content": "それに、あの方は騎士団を巻き込むことを望んでない。なにせ…西風騎士団のやり方だと、余計大げさになりがちだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180118,
					"content": "たとえばホフマンとか、宝盗団がモンド周辺に現れたって聞いたら、きっとすぐに騎士団本部に報告するに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180119,
					"content": "もし騎士団がそのまま出撃したら、宝盗団も一目散に逃げるでしょ。宝盗団を一網打尽する計画も白紙に戻るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180120,
					"content": "だから、今回は君の「単独行動」で、効率よく倒してもらうしかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "ヴァル"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
