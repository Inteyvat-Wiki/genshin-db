			"trigger": {
				"objectNames": [
					"ホフマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "宝盗団め…隠れたきゃ隠れればいい…いつか俺に知られたら絶対許さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205180302,
					"content": "宝盗団の隠れ場所を知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "えっ？それはなんで…この地図詳しいな…どこでもらった？ヴァル？彼女が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205180304,
					"content": "…前に調べた場所とこんなに離れてるとは、あの宝盗団は一体何を企んでるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205180305,
					"content": "すまないが、ちょっと写させてもらうよ…これでいいな。すぐに確認してもらう、事実通りならすぐに撃退しに行くからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205180306,
					"content": "礼を言うよ、モンドのためにありがとう！宝盗団、今回は絶対逃がさないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
