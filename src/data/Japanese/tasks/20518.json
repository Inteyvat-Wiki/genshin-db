			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "おかえりなさい、速かったね。あの方が君に頼む理由が分かったような気がするよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180402,
					"content": "この件は西風騎士団に任せた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "西風騎士…あのね、言ったでしょ、騎士団に知られたら面倒だって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180404,
					"content": "君って意外とサボるのね…そうするかもしれないってあの方も言ったおかげで、対策はしておいたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180405,
					"content": "これからのことは大丈夫よ、私もすぐに行かないといけないわ、はあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180406,
					"content": "でも、君のこの行動はことを面白くするかもしれないって、あの方が言ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180407,
					"content": "なにせ、私が宝盗団の動向を報告したら明らかにおかしいし、あの方の身分も西風騎士を直接動かせないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180408,
					"content": "はい…受け取って。あの方の言葉でいうと、これは「風向きを変えてくれた」小さな報酬よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
