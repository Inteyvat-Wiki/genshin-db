					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "まだ準備してるの？うん、準備が終わってから出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180502,
					"content": "あの方は一体？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "どんなに聞いても、教えないわ。これはこの仕事の最低限のマナーだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180504,
					"content": "教えたって…その情報は「教える必要がある」から教えることになってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180505,
					"content": "あっ、そうだ、私が言った言葉、そのどれが教える必要がある言葉か考えてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205180506,
					"content": "目的は一体なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
