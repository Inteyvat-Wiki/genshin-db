			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "旅人さん、何かお手伝いが必要なことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110102,
					"content": "稲妻に行くことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "はい、すでにお聞きしております。南十字船隊の頭領と、稲妻へ向かう約束をしているのですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110105,
					"content": "確かにもう随分と日が経ちましたが、まだ私のところに情報は何も入ってきていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110106,
					"content": "探したぜ！あんたが姉御の見込んだっていう旅人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110107,
					"content": "待ってました！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "そうか、はははっ、そいつは良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110110,
					"content": "艦隊の補給作業がほぼ完了した、あとは人員を確認するだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110111,
					"content": "姉御にあんたを探すよう頼まれてな、あんたが船に乗ればすぐに出発できるみたいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110112,
					"content": "やっぱり北斗は約束を守るやつだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110113,
					"content": "もちろんさ、姉御の義理堅さはこんなもんじゃないぞ。出航したらあんたらも徐々に分かってくるはずさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110114,
					"content": "もう行かれるのですか？無事に出航できるみたいでよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110115,
					"content": "この先が星であろうと深淵であろうと、次の一歩を踏み出すのは良いことだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110116,
					"content": "では、またの機会にお会いしましょう。皆さんのご無事を祈っておりますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110117,
					"content": "キャサリンさん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "そうだな。ほとんど毎日会ってたから、名残惜しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110120,
					"content": "うふふ、でしたら、稲妻に着き次第、いち早く私を探し出してくださいね？私は鳴神島であなたたちをお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 20110121,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "やっぱり、稲妻にもキャサリンがいるのかよ！じゃあ、なんでこんな悲しげな雰囲気をかもしだしてたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110124,
					"content": "はははっ、璃月にもきちんとお別れをしてきな。船はもう孤雲閣に止まってる。ちゃんと伝えたから、俺は先に戻るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110125,
					"content": "おう、知らせに来てくれてありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110126,
					"content": "いいってことよ、じゃあ船でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110122,
					"content": "…そんな気はしてた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "寂しくなるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "噂をすれば連絡がきた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "南十字船隊について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "よぉ、やっと来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110302,
					"content": "かつては嵐でさえ止めることのできなかったこの「南十字船隊」を港に引き留めてるんだ、アタシがどれほどあんたたちの顔を立てたか言うまでもないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110303,
					"content": "お待たせ、姉御。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "はははっ、冗談さ。ちょうどいい時に来たな、出航準備がいま終わったところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110306,
					"content": "じゃあ、人も揃ったことだし、そろそろ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110307,
					"content": "雷雨に包まれし「永遠」の国へ向けて、出航だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110308,
					"content": "しゅっぱーつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110304,
					"content": "とても光栄に思います！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トーマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "やっと来た。「璃月の姉御」、待ちくたびれてたところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110702,
					"content": "それと二人の密航者…あっ、いや客人と言うべきか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110703,
					"content": "シーッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110704,
					"content": "あんたたちの将軍様のせいで、近頃は稲妻近海の雷雨と暴風が前よりも強くなってやがる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110705,
					"content": "もちろんアタシの船隊も大いに本領を発揮したが、それでも少し時間がかかっちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110706,
					"content": "そうだ、紹介しよう。こいつはトーマ、最近知り合った商売仲間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110707,
					"content": "よっ、君たちに会えることをずっと楽しみにしてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110708,
					"content": "トーマ、この二人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110709,
					"content": "紹介はいらない。異郷の旅人の名声は、外海の嵐だろうと防げないからね。とっくに耳に入ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110710,
					"content": "こんにちは、トーマ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "嬉しいこと言うなおまえ、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110713,
					"content": "ふむ、手間が省けたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}、トーマはもう長いこと離島で活動している、ここの顔役と言っても過言ではないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110715,
					"content": "何か困ったことがあればこいつを訪ねるといい。だが、もしこいつがあんたに不埒を働けば…次、稲妻に来た時、アタシがあんたの代わりにこいつをシメてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110716,
					"content": "アハハッ…安心してくれ、オレたちなら仲良くやれると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110717,
					"content": "そろそろ時間だ、アタシの船にはまだ「お尋ね者」が一人乗ってるからな。長居はできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110718,
					"content": "万葉のことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110719,
					"content": "また会おう！旅人、稲妻でどんな「荒波」に遭おうが、乗り越えてみせろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110720,
					"content": "もちろん、自信はある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "バイバーイ！元気でな～！北斗船長～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110723,
					"content": "それじゃ、まずは審査所で登録手続きを済ませよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20110724,
					"content": "えっ、稲妻のお偉いさんに会うのか？こっそりって言ったはずだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20110725,
