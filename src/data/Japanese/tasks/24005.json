					"nextDialogs": [
						240051102
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240051102,
					"content": "前はそんなことなかったよ？ロウのパパと一緒に勉強するようになってからああなったんだ。いつもしかめっ面して、何考えてるんだろうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240051103,
					"content": "うわぁ…パパと一緒だわ。ママが言うには、いつも何かと張り合ってるみたい、って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240051104,
					"content": "いったい何と張り合ってるんだろうね？もしかして…ロウのママとケンカしちゃったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240051105,
					"content": "まさか！パパとママはケンカなんてしたことないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240051106,
					"content": "オトナって不思議だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェルー"
				}
			]
