			"dialogs": [
				{
					"id": 240050401,
					"content": "ルイお兄さん！バブルオレンジ味のフライドポテトをいくつかくださいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050402,
					"content": "おや、ロウちゃん。すまないね…今日は港に人が多いせいか、バブルオレンジを切らしちゃったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "ルイ"
				},
				{
					"id": 240050403,
					"content": "ええっ？ずっと前から言ってたじゃない。せっかくお友だちを連れてきたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050404,
					"content": "ああ…スウィーティが多すぎて忘れてたよ…普通の味のフライドポテトなら残ってるよ。タダでいいから持っていきなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "ルイ"
				},
				{
					"id": 240050405,
					"content": "わかった。ありがとうルイおにいちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050406,
					"content": "バブルオレンジが足りないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "ええ、バブルオレンジさえあればすぐにソースを作れますけど。他の調味料は残っていますので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "ルイ"
				},
				{
					"id": 240050409,
					"content": "#やったぁ！{M#お兄さん}{F#お姉さん}、すごいわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050410,
					"content": "#ありがとう{M#おにいちゃん}{F#おねえちゃん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050411,
					"content": "なんだかすみません。いつも俺たちの面倒事に巻き込んじゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050412,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "そっかぁ…俺も見習わないとですね。ドルリューおじさんにも「君は頭が固すぎる」ってよく言われるんです。将来評論家になりたいなら、それじゃだめですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050415,
					"content": "コホンッ！えっと、こんな話は置いといて…俺はここで二人を見てるので、バブルオレンジのほうはお願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050413,
					"content": "ガッカリさせられないもん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "バブルオレンジを持ってきてあげようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
