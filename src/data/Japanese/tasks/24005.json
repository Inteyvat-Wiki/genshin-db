			"dialogs": [
				{
					"id": 240050601,
					"content": "これだけあれば十分ですよ。ではちょっとお待ちを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "ルイ"
				},
				{
					"id": 240050602,
					"content": "ルイはバブルオレンジソースを作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "さあ！揚げたてのバブルオレンジフレーバーのフライドポテトだ、待たせたね！お代はいらないよ、熱いから気をつけてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "ルイ"
				},
				{
					"id": 240050604,
					"content": "#やったあ！{M#お兄さん}{F#お姉さん}、それからヴェルーとオーレルも早く食べてみて。美味しいわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050605,
					"content": "そうだ、オーレル。パパには秘密よ？また説教されちゃうもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050606,
					"content": "ははっ…安心しろって。ドルリューおじさんはきっとフライドポテトなんかには興味ないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050607,
					"content": "おにいちゃん…その、僕は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050608,
					"content": "早く食べろよ。俺はあんまりこういうのは好きじゃないから、俺の分もやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050609,
					"content": "#えへへっ、じゃあいただきまーす！{M#おにいちゃん}{F#おねえちゃん}も早く食べなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050610,
					"content": "そうだ、ドルリューおじさんにコーヒーを買って行ってあげたいんだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050611,
					"content": "ちょっと、それはだめよ！ママからコーヒー禁止令が出てるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050612,
					"content": "パパがコーヒーを飲むと、一晩中咳が止まらなくなって、声も枯れちゃうのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050613,
					"content": "パパは「仕事のためだから」って言うけど、そんな苦しい思いをしなきゃいけない仕事なんてある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050614,
					"content": "…それって、ドルリューおじさんが言ってた優秀な「評論」を書くための代償ってやつなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050615,
					"content": "評論家って大変なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				}
			]
