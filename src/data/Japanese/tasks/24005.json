						],
						"pointId": 340100216
					}
				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "ここが「スチームバード新聞社」か。えっと…見た目は何の変哲もないみたいだけどな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050302,
					"content": "ごく普通の建物だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "わっ！ほんとに機械鳥がいる！すっごーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050305,
					"content": "でしょ？いつもパパと一緒にここで新聞を買うのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050306,
					"content": "パパは「スチームバード新聞」が大好きで、毎朝新聞に釘付けになって、一日中読み返してるの。たまに新聞を切り抜いて、ノートに張り付けて保存したりもしてるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050307,
					"content": "それってパパの投稿した「評論」なんだって。私やママに読んで聞かせることだってあるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050308,
					"content": "でもホントは好きじゃないのよね。だからいつも「へえ」とか「そうなんだ」とか「なるほど」とかで返すんだけど、全然気付いてないの。自己満足ってやつね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050309,
					"content": "「評論」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "簡単に言えば、あることについて、評論家自身の観点から意見を述べることですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050311,
					"content": "ロウのお父さんのドルリューおじさんは、フォンテーヌ科学院の科学者なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050320,
					"content": "それに彼は、「スチームバード新聞」に頻繁に「評論」を投稿する「評論家」でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050312,
					"content": "そ。だからパパってどんな事に対しても、長々と「評論」するのが大好きなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050313,
					"content": "ずーっと話してたと思ったら、急に何かを思いついたみたいに部屋にこもって原稿を書き始めるの。ご飯も食べずに、お茶ばっかり飲んでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050314,
					"content": "えぇ…自分の考えを発表するだけでお金が稼げるお仕事があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050315,
					"content": "ただ意見を発表するだけじゃ「評論家」とは言えないぞ。評価に値する評論を発表したいなら、まずはいくつかの要素を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050316,
					"content": "#え…ええっと…ヴェルー！それから{M#お兄さん}{F#お姉さん}、お腹空かない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050317,
					"content": "ルイお兄さんが最近バブルオレンジ味のフライドポテトを売ってるんだって。食べに行ってみましょうよ、あたしがごちそうしてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050318,
					"content": "あ…うん！おにいちゃんもそんな話はいいから、早く行こうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "ヴェルー"
