				{
					"id": 240050319,
					"content": "お前らなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050303,
					"content": "確かに何の変哲もないね…",
