				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "わぁ…あそこで水遊びしてみたいな。それとも体を洗っちゃおうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050202,
					"content": "そんなことしたら怒られるだろ。外から見てるだけにしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050203,
					"content": "でも、中に入れないならどうしてあんなにおっきな噴水を作ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050204,
					"content": "どんなにキレイでも、見てるだけじゃ普通の池と一緒だよ。ちっとも面白くないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050205,
					"content": "これは普通の噴水じゃないのよ。うーん…パパは普通の噴水について教えてくれたことがあったんだけど、なんて言ってたっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050206,
					"content": "「フォンテーヌ廷の都市美化事業の最大の目的は、納税問題を柔軟に解決することだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050207,
					"content": "——ちょうど今日、ドルリューおじさんが俺にそのことを説明してくれたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050208,
					"content": "話し方までパパとそっくり…どうりでパパはオーレルの事が気に入るわけね。いつも本をたくさん持ってきてお喋りしてるんだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050209,
					"content": "またおにいちゃんの訳わかんない話が始まったぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050210,
					"content": "ロウ、早く遊びにいこうよ。今日は勉強なんかしなくたっていいんだからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050211,
					"content": "うん、じゃあ他の場所を探してみよう！そうねぇ…新聞社がまだ開いてるかもしれないし、行ってみましょうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロウ"
				}
			]
		},
		{
			"id": 2400503,
