				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "おにいちゃん、早く早く！こっちだよ。あっちの大きい建物、まだ見てないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050102,
					"content": "ほらほら、ゆっくり歩け！また転ぶぞ。ロウだってあまり具合がよくないんだろ？風邪ひくんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050103,
					"content": "わあっ、オーレルってママみたいなこと言うのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050104,
					"content": "僕もおんなじこと思った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050105,
					"content": "お前らなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050106,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#こんにちは、{M#お兄さん}{F#お姉さん}！また会ったわね。今日はもう、かくれんぼはしてないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050109,
					"content": "正確に言うと「もう遊び終わった」だろ…それに、ノワールさんに叱られたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050110,
					"content": "ノワールお姉さんって仕事中はいつも厳しくて、説教するのが大好きなのよね。クッキーをあげたことだってあったのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050111,
					"content": "ま、どのみちちょっと疲れちゃったし。このあとオーレルとヴェルーを連れて街に出て、何か食べようと思ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050112,
					"content": "#{M#お兄さん}{F#お姉さん}も良かったらあたしたちと…えーと…何て言うんだったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050113,
					"content": "散歩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240050114,
					"content": "そう、あたしたちと散歩しましょうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050115,
					"content": "ねぇ、あそこの広場に行ってみようよ。噴水が見てみたいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240050116,
					"content": "じゃあロウ、道案内をよろしくね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "うん、それじゃあ…あそこの広場に行ってみましょ。噴水がとってもキレイなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロウ"
				},
				{
					"id": 240050117,
					"content": "じゃあみんな、道案内をよろしくね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
