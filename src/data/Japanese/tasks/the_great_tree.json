				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "やっぱりちゃんと世話をしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "きみは…うん、その様子からして旅人さんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270104,
					"content": "私はアムリタ学院の学生、ヤスミン。ここの「聖樹」を研究しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270105,
					"content": "この「聖樹」が重ねてきた年月は、オルモス港で食べられているすべてのビリヤニのご飯粒より多いんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270106,
					"content": "同時にこれは、教令院を下から支えています…その重要性は、タンドリーチキンの下に敷かれている野菜に匹敵するでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270107,
					"content": "どういう例えなの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "ですが同時に、もしこれに問題が起きれば、スメールシティも大きな災難に見舞われるということを意味します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270111,
					"content": "虫害に遭えば、屋根よりも大きなバッタが木から飛び出し…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270112,
					"content": "幹の成長が制御を失えば、大量の根っこが洪水のように地面から湧き出し、家々を破壊してしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270113,
					"content": "また、この「聖樹」が急速に枯れれば、倒れた幹がスメールシティの半分を押しつぶしてしまうでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270114,
					"content": "そ、そんなことが…！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "ええ、もちろん現在に至るまで、状況にまったく異常は見られませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270116,
					"content": "あなたが森でキノコ狩りをする時、あなたを襲うキノコンは、事前にそれを教えてくれませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270117,
					"content": "ですから、私のここでの研究や大樹の観察も、起きうる様々な事態への備えなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270118,
					"content": "ですがご覧の通り、私の思考は暝彩鳥のように俊敏ですが、体は星茸のように脆弱なのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270119,
					"content": "だから旅人さん、いくつかの「聖樹」の根の状況を記録するのを手伝ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270120,
					"content": "普段は冒険者を雇って同行してもらうんですが、現在彼らは忙しいようで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270121,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "学者はみんなそんな風に話すの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "え？私の例えのことですか？すみません、私のこれはずっと前からこうでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270124,
					"content": "学院でもたくさんの人にこの問題を指摘されましたが、すぐには変えられそうにありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270125,
					"content": "それではお願いします。私はここで待っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270108,
					"content": "パイモンなら分かる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "…本当に、偉大な樹なんだな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "パイモン"
				}
			]
		},
