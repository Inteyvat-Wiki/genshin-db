			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "おかえりなさい。聖樹の根の状況はいかがでした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230271102,
					"content": "ヤスミンに根の状況を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "…うん、生物がそこに集まっているということは、その土地に強い活力があることを示しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230271104,
					"content": "聖樹の根は安定して成長しているようですね。しばらく大きな問題は起こらないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230271105,
					"content": "唯一の心配は…周囲の水が富栄養化しすぎて、そこからより多くのキノコンが生まれないかということですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230271106,
					"content": "あ、これは報酬です。ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230271107,
					"content": "やはりラドプとファルシに周囲の元素濃度を監視してもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
		}
	]
}