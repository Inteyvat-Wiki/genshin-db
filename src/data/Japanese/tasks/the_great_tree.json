					"ヤスミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "旅人さん、偶然ですね。またお会いするなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270202,
					"content": "まだ研究してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "ええ、ラドプとファルシがデータ集めに忙しいので、私がこの仕事を続けるしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270204,
					"content": "でも、あの根の状況は現在どうなっているのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230270205,
					"content": "旅人さん、もし時間があれば、またあの根の状況の記録を手伝ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
		},
