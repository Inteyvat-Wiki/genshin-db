				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "ぼ、冒険者の人？依頼をもらいに来たの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140302,
					"content": "うっ…ちょっと待ってて、確かここにあるのは…「風の翼スピード勝負」、「サバイバル体験ガイド」、それから「自由登攀訓練」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140303,
					"content": "冒険者協会らしくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "分かってるよ！嵐姉さんにも言われたけど、本で見た「冒険」だってこんな感じでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140305,
					"content": "これらの依頼の他に、何を出せばいいというの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140306,
					"content": "たとえば、魔物退治とか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "あ、危ないよ。確かに璃沙郊の辺りは魔物がたくさんいるし、通行人にとって脅威だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140308,
					"content": "普通の人は絶対に倒せないし、怪我するかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140309,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "いいの？…じゃあ、お願いね。あとで嵐姉さんに報告して、絶対にいい報酬を支払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140311,
					"content": "冒険者は普通の人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "そうなの…？じゃあ、お願いね。あとで嵐姉さんに報告して、絶対にいい報酬を支払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				}
			]
		},
