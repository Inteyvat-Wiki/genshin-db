			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "なに？また何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 708140202,
					"content": "剣は見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "…覚えてくれたのね。残念ながら、まだ手がかりなしよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 708140204,
					"content": "私もまだまだ探さないといけないようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 708140205,
					"content": "関連する任務があったら、あなたにお願いするかもしれないから、その時はよろしく頼むわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
