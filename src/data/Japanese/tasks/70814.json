			"dialogs": [
				{
					"id": 708140501,
					"content": "あれ？もう戻ったんだ。依頼は完了したの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140502,
					"content": "完了した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "すごい…さっき冒険者協会に戻って、もう一度依頼を整理してみたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140504,
					"content": "魔物退治の依頼はたくさんあった。冒険者たちは普段そういうことしてるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140505,
					"content": "それと、魔物退治の他に、宝盗団に関する依頼もあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140506,
					"content": "それも冒険者たちの仕事なの？どちらかというと千岩軍の仕事だと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140507,
					"content": "冒険者も退治できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "そうなんだ、冒険者はなんでもやるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140511,
					"content": "では、ちゃんと報酬を用意しておくから、この依頼もお願いね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140512,
					"content": "なんで急に追加依頼が来るんだ！今まではなかったんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708140513,
					"content": "報酬もちゃんと追加するから！嵐姉さんにも話したから、依頼を完了してくれれば、報酬も多くするから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140514,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "じゃあ、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140516,
					"content": "これで一気に依頼を二つ消化できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140517,
					"content": "嵐姉さんが教えてくれた「冒険者に大人しく依頼を受けさせるコツ」は本物だったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				},
				{
					"id": 708140509,
					"content": "報酬が十分であれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "冒険者はすごいね…なんでもできるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "テンテン"
				}
			]
		},
