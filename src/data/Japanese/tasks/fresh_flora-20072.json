			"dialogs": [
				{
					"id": 200720101,
					"content": "前に雪山に置いてきたお花はどうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720102,
					"content": "1つだけ持って帰れた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "他のお花は持って帰れなかったの？うーん…雪山の状況は予測できるものじゃないし、仕方ないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720104,
					"content": "でも1つしかないとなると、比較はできないね。また機会を探して試すしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720105,
					"content": "手伝ってくれてありがとう、これは報酬だよ。今後も手伝ってもらうことがあるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
		{
			"id": 2007202,
