			},
			"dialogs": [
				{
					"id": 200720201,
					"content": "お花はどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720202,
					"content": "ごめんなさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "え？どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720204,
					"content": "うっかり花と箱を壊してしまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "こ、壊した！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720206,
					"content": "うぅ…あれはフローラが厳選したお花なんだよ。簡単には見つけられないきれいなお花なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720207,
					"content": "雪山ってそんなに危ないの？あなたのような冒険者でも、うっかり花を一箱も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720208,
					"content": "それでも手伝ってくれてありがとう。これを受け取って。フローラはお花のお世話をしなくっちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200720209,
					"content": "はあ…サラさんに教えてもらった方法をもう一回試してみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
		{
