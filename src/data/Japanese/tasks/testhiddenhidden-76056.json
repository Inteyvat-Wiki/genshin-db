			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トルホー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "すまねぇ、ボス…みんなに恥かかせちまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "ビエロフ"
				},
				{
					"id": 760560402,
					"content": "おいおい、ただの暇つぶしだぞ、気にするな。ビエロフはひとまず横で休んでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560403,
					"content": "君、なかなかいい動きするな！俺はトルホーだ、よろしく頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560404,
					"content": "#{M#俺}{F#私}は{NICKNAME}。よろしく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "どうやらかなりの手練れだな？これは真剣勝負しないと…気を取り直して、もう一回勝負だ！インカリ、君の番だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560406,
					"content": "ボスっていつも手こずってから私を思い出すんだよな…まったく困るよ。じゃあ、そちらの手練れさん、始めようか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "インカリ"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
