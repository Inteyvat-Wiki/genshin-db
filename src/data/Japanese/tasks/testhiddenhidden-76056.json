				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "ちょっとと言わず、何回でも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "ははっ、最高だ！やっぱり人との勝負じゃないと、そそらないよな。ビエロフ、ちょっと付き合わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560205,
					"content": "うっす、ボス！三手以内で、ケリつけてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ビエロフ"
				}
			]
		},
		{
			"id": 7605603,
