			"trigger": {
				"objectNames": [
					"トルホー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "ま、まさか負けるなんて…どこの誰とも分からないやつに敗れるなんて…こ、こんなことありえない…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "インカリ"
				},
				{
					"id": 760560502,
					"content": "ふむ、まさかインカリまで負けるとは…甘く見ていたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560503,
					"content": "ボスのせいじゃないよ。こんな強敵がたまたま通りかかるなんて、誰が予想できたってんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "ビエロフ"
				},
				{
					"id": 760560504,
					"content": "ボス！奴らを逃がしちゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "インカリ"
				},
				{
					"id": 760560505,
					"content": "単なる手合わせじゃなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "誤解しないでくれよ。インカリが言いたいのは、こんな簡単に負けを諦めるわけにはいかないってことさ。俺たちもそこそこ名の知れたトレジャーハンターだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}、俺から正式に挑戦を申し込む。今度は手合わせじゃなくて、本気でやり合わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560508,
					"content": "じゃあ、三人まとめて相手してあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "よし、遠慮なく行かせてもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トルホー"
				}
			]
		},
		{
			"id": 7605606,
