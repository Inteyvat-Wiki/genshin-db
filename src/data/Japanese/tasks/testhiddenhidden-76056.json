			"dialogs": [
				{
					"id": 760560601,
					"content": "まさか通りすがりのやつに負けるなんて…しかも三回も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "インカリ"
				},
				{
					"id": 760560602,
					"content": "いやいや、俺とお前が2回ずつ負けて、ボスが1回負けただけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "ビエロフ"
				},
				{
					"id": 760560603,
					"content": "#はは！負けは負けだ、考えたって仕方ない！{NICKNAME}は本当に強いんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560604,
					"content": "お前ら二人とも、普段は俺にすら勝てないんだからな。これで本物の強者がどんなもんか、思い知っただろ？もっと鍛え直せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "トルホー"
				},
				{
					"id": 760560605,
					"content": "俺はまぁ…そろそろ引退を考えないとな。ヴァイノの訓練場はまだ人を募集してるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トルホー"
				}
			]
		},
