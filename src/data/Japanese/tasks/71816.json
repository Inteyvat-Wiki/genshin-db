			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"黄衣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "フランシスに連絡した、貨物は無事届いたようだ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160502,
					"content": "いつ連絡したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "ははっ、気にするな。私たち運び屋は足が速いんだ、だから連絡に関することも…速いのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160504,
					"content": "手伝ってくれたおかげだ。もちろん報酬をやる。少し待ってろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160505,
					"content": "海灯祭でも休みがないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "この職業は決まった勤務時間なんてない。やれる時にやらなくてはな。海灯祭で家に帰れないのも仕方ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160507,
					"content": "君は旅をしているんだろ、霄灯を飛ばして、海灯祭を楽しむといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160508,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}はどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "1年中外を走り回ってるから、霄灯を作る時間なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160512,
					"content": "もし今霄灯があるならいいに越したことはないが、自分で作る時間がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160513,
					"content": "祭りの雰囲気はなくなるが、それも仕方ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160514,
					"content": "霄灯を準備してくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "ん？私のために霄灯を用意してくれるのか？本当に熱心な人なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160515,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "霄灯は飛ばした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "まだやってない、それをやる時間も余裕もないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "黄衣"
				}
			]
		},
