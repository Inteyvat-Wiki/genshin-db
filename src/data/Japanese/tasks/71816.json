			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フランシス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "これは…私が仕入れた貨物。おお、神よ、やっと届きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "フランシス"
				},
				{
					"id": 718160402,
					"content": "見たところ、貨物を運んでくれた君は、璃月の人じゃないみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "フランシス"
				},
				{
					"id": 718160403,
					"content": "親愛なる友よ、もう食したかは知らないが、璃月の美食は相当な物だ。騙されたと思って、試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "フランシス"
				},
				{
					"id": 718160404,
					"content": "さあ、貨物も届いたし、これで安心して美食を楽しめるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フランシス"
				}
			]
		},
		{
