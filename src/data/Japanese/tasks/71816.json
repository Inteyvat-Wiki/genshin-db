					"黄衣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "ここが貨物のある場所だ。この運搬用の熱気球を護送してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160202,
					"content": "でも先に言っておくが、この中は全部霄灯の原材料だ。とても脆い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160203,
					"content": "壊れたり、燃えたりしないようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160204,
					"content": "この道には、魔物や宝盗団が出没するから、十分気をつけろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160205,
					"content": "じゃあこの護送は頼んだ。フランシスのところまで届けたら、チ虎岩南西の橋で会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄衣"
				}
			]
		},
		{
