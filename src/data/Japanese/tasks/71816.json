					"黄衣"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "こんなのどうやって送るんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "旅人か、海灯祭が開かれている時に璃月に来るなんて、運がいいな。それに引き替え、私は運が悪い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160104,
					"content": "私たち璃月人には、海灯祭で霄灯を飛ばす伝統がある。毎年この期間になると、材料の運搬量も莫大に増えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160105,
					"content": "今年はさらに、運搬量が往年より大分増えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160106,
					"content": "私一人じゃどうにも…しかも今回の客はフォンテーヌから来た人で、璃月の状況に詳しくないからずっと急かしてくるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160107,
					"content": "ずっと人手を探してるんだが、中々見つからない。手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "よし！君みたいに潔い性格の人は嫌いじゃない。あの人もそうだったらどれだけよかったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160110,
					"content": "名前をなんて言うんだっけ…フラ…フランシスだったか。外国人の名前はあまり読めないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160115,
					"content": "手伝ってくれるのなら、貨物を預かってる場所に行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160116,
					"content": "具体的な場所は地図に記したよ。私は先に行ってるから、またあとで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160111,
					"content": "フォンテーヌの客商？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "そうだ、その…フラ…フランシス、本当に呼びにくいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160113,
					"content": "あんなに霄灯の材料を仕入れて何するのか知らないが…金を払ってくれた以上、やるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "黄衣"
				},
				{
					"id": 718160114,
					"content": "安心しろ、終わったら君にも報酬はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黄衣"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
