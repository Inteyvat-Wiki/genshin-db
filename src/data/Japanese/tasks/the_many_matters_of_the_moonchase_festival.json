					"琳陽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "うーん…もう少し宝箱を手配しなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640102,
					"content": "宝箱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "あら！？あなたは…旅人さんですか？あなたも「月逐い祭」へ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640104,
					"content": "まあそんなところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "ちょうどいい時にいらっしゃいましたね。月逐い祭を祝うため、我々冒険者協会では催しを準備している最中なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640106,
					"content": "どうでしょう、詳しく聞いてみますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640107,
					"content": "具体的にどんなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "月逐い祭では、我々冒険者協会が各地に「月逐い符」と呼ばれるものを配置しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640111,
					"content": "その月逐い符を見つけて協会に持って帰れば、報酬と引き換えることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640112,
					"content": "また、多くの冒険者を手配し、野外に宝箱を配置させました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640113,
					"content": "それらの特殊な宝箱には、協会が用意した数々のお宝がありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640114,
					"content": "この二つの催しに加え、協会では、己の限界に挑戦する冒険者さんのために、高難度の挑戦を用意しております！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640115,
					"content": "まあ具体的に言えば…魔物の拠点の殲滅なんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640116,
					"content": "これも月逐い祭と関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "…あはは…その…そう言わないでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640119,
					"content": "それらの魔物を倒せば、協会からも相応の報酬を差し上げます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640120,
					"content": "普段の依頼と変わらないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "うぅ、お願いします！月逐い祭では、皆さん祭りに行ってしまって、依頼を受ける人がいないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640122,
					"content": "どうでしょう…？あなたの実力なら、魔物なんて楽勝ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640123,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "ほ、報酬面ではがっかりさせません。ご安心を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640126,
					"content": "月逐い祭では、私はずっとここにいますので、何か問題があれば、直接私にお聞きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640127,
					"content": "ではお願いします、旅人さん。その…月逐い祭を楽しんでくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳陽"
				},
				{
					"id": 726640124,
					"content": "報酬を用意しておいて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "月逐い祭とまったく関係ない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "まさかまた雑用じゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "いいえ、違いますよ！今回のは冒険感たっぷりなものです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "琳陽"
				}
			]
		}
	]
}