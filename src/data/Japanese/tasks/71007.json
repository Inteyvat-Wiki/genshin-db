				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "絵の進捗はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "彫像の目が光り始めた時から、僕は彫像の横で絵を描いてるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070103,
					"content": "なんというか…一番完璧な絵は描けてないというか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070104,
					"content": "何か物足りない気がする…分かるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070105,
					"content": "たとえば料理、材料もレシピも問題はないけど…何かが足りないみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070106,
					"content": "ああ、僕もうまく表現できない。それにあの感覚がつかめないから、ずっと書き続けるしかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070107,
					"content": "ハハッ、自分で言うのも恥ずかしいけど、少し眩暈がしたから目を閉じて少し休もうとしたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070108,
					"content": "なぜか僕が目を閉じると、彫像の光る目が見えるんだ…僕の目の前にね。まるで生きてるみたいで、僕をじっと見つめるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070109,
					"content": "だ、だから僕はここに戻ったんだ。ここで休めばきっと彫刻の目は見えないはずだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070110,
					"content": "そうだ、この絵を受け取っておくれ。これは今まで僕が一番よくできた作品なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070111,
					"content": "ああ、僕の話はそんなに気にしないで。きっと僕は疲れてるんだ、少し休めばいいはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710070112,
					"content": "僕の絵、一体何が足りないんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		}
	]
}