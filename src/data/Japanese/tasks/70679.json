			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイガックス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "やあ！また会えるとは、本当に奇遇だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790102,
					"content": "#えーと、{M#君}{F#あなた}は…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "ガイガックスだ！ほら、風の行方のだよ…覚えてるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790106,
					"content": "そうそう、そんな名前だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706790107,
					"content": "完全に思い出した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "まったく覚えてないって顔をしてるがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790109,
					"content": "ま、そんな話はさておき、これを見てくれ。この「風の行方」のことなら覚えてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790110,
					"content": "以前、君がテストを手伝ってくれたとき、色々アドバイスしてくれただろ？どれもいいアイデアだったから、ほとんど採用させてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790111,
					"content": "そして、ルールや遊び方にもう一度…いや、正確には何度も手を加えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790112,
					"content": "分かりにくかったりしない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "安心してくれ。きっと新しくなった遊び方を気に入ってくれるはずだ。さっそくだが、ルールを簡単に説明させてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790115,
					"content": "まず、新しいバージョンの「風の行方」には、「発信機」というものを加えてみた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790116,
					"content": "レンジャーは「発信機」を四つ起動することで、ハンターに勝ち、勝利を手にできる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790117,
					"content": "一方、ハンターがやるべきことは…前と同じで、すべてのレンジャーを捕まえたら勝ちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790118,
					"content": "ただし、今回の「風の行方」では、レンジャーがハンターに捕まったら、そのまま退場するのではなく、「監視エリア」と呼ばれる場所に放り込まれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790119,
					"content": "一定時間経つか、もしくは他のレンジャーに助けてもらうことによって、捕まったレンジャーは「監視エリア」から逃げ出すことができる。そして、ハンターとの勝負を続けることができるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790120,
					"content": "ただし、一回捕まった人が再度捕まったら…今度こそアウトになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790121,
					"content": "ちょっと難しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "安心してくれ。複雑に聞こえるが、何回か遊んでみれば、すぐに覚えられるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790124,
					"content": "遊んでみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "よし！こっちに来てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790126,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "そうか。時間があったらまた来てくれ。俺はしばらくここにいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706790122,
					"content": "新しく追加されたルールが多すぎ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "変なルールとか付け足してないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "#{M#君}{F#あなた}は…風の行方の！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "ああ、ガイガックスだ！俺の名前よりも風の行方のほうが印象に残ってるのは、まぁ本望ではあるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "ガイガックス"
				}
			]
		}
	]
}