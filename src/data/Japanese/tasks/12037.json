					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉",
					"九条鎌治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#おや？お主であったか、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370602,
					"content": "やあ、君たちか。ちょうど先ほど「目狩り令」の廃止について話していたんだ。せっかくだから、君も一緒に聞いていってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370603,
					"content": "今回、楓原殿に来ていただいたのは、幕府側の友好を示すのが主な目的でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370604,
					"content": "これだけ情勢が明るくなったのも、君たちのおかげだ。僕もこれを機に、一族が犯した過ちを正すことができる。本当に感謝しているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370605,
					"content": "過去に積み重ねてきた矛盾や対立を正すために、将軍様も様々な方面から解決を図っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370606,
					"content": "三奉行の間では、これを機に、楓原家の名誉回復に繋げようという提案が出たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370607,
					"content": "楓原家に関することは、君も少しは知っているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370608,
					"content": "聞いたことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "簡単に説明すると、過去の稲妻には、将軍様の刀鍛冶技術を受け継ぎ、その名を轟かせた御用刀工が複数いたんだ。楓原家は、その中の一つだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370611,
					"content": "しかしある時、一部の刀工が裏切ってスネージナヤへと逃亡した。楓原家と神里家は管理不行き届きの罪に問われ、激しい動乱に見舞われたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370612,
					"content": "でも後に、この事件の背後にはファデュイという黒幕がいたことが判明した。故に、すべての責任を楓原と神里の両家に負わせるのは不適切であり、不公平とされてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370613,
					"content": "そして、楓原殿はまたも大きな功績を挙げた。そのため、その報賞だけでなく、過去の行き過ぎた処置への補償もすべきだと将軍様は考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370614,
					"content": "でも、刀工一族がまたファデュイから迫害を受けてしまう可能性もある。そのため、この件の調査結果は公表していない。それに関しては、どうかご理解いただけると助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370615,
					"content": "いや、こちらこそ、将軍様と幕府からのご厚意を受け取ることができるとは、実に喜ばしいでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370616,
					"content": "しかし、タダでそのご厚意を受けるわけにはいかないのであろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370617,
					"content": "それは考え過ぎだ、これは「補償」なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370618,
					"content": "名誉が元通りになれば、楓原家は刀鍛冶業を再開することができる。君も放浪を続ける必要がなくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370619,
					"content": "将軍様の庇護と幕府の支持の下、稲妻城で安定かつ豊かな生活を送れるようになるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370620,
					"content": "拙者は長きにわたって風雨の中を歩んできた故、大きな屋敷に住むのは性分に合わぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370621,
					"content": "しかし拙者の先祖たちは、楓原の名と彼らが受け継いだ刀鍛冶技術を誇りに思っていた。たしかに拙者にも、その先祖たちの名誉を正す責任がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370622,
					"content": "その感じだと、まだ少し躊躇しているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370623,
					"content": "ただ、これに同意してくれれば、近ごろ町で流れている君の噂と中傷も消えると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370624,
					"content": "噂と中傷？ここに来る途中、ずっと良い話ばっかで、みんなすごく褒めてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370625,
					"content": "一部の人にとって、「無想の一太刀」は無敵の存在なんだ。彼らは、楓原殿があの一太刀を受け止めたことを認めたくないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370626,
					"content": "あの時、楓原殿が風以外にも雷元素の力を使っているのを目撃した人がいた。そのせいで、「楓原万葉は邪眼を使った」という噂まで広まっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370627,
					"content": "えっ？でも、邪眼を使ったやつはすごい早さで老化するはずだろ。万葉はそんな風になってないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370628,
					"content": "ああ、でも彼らにとって、一人が同時に二種類の元素力を使うことのほうが理解できない出来事なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370629,
					"content": "このような噂は他にも多々ある。こうして世論の中心に置かれ、他の者に追逐され猜忌を抱かれるのは苦手でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370630,
					"content": "だが、もし幕府が拙者を支持してくれるのなら、この波風もすぐに止むやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370631,
					"content": "だから、前向きに考えてほしい。互いにとっていいことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370632,
					"content": "うむ、少し考えさせてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370633,
					"content": "この件に関する話し合いはひとまず置いておこう。それで、二人はどうしてここへ来たのでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370634,
					"content": "あっ、大事なことを忘れるところだった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370635,
					"content": "野外で会った襲撃者のことを楓原万葉に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "そのような危険人物が拙者を探している、と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370637,
					"content": "兄弟や姉妹はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "いや、いないでござる。正直拙者も戸惑っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370640,
					"content": "拙者の武技は家の者から教わったもので、元は刀試しに使われていたものであった。試し斬りの際、乱れなき太刀筋を描き、それぞれの刀の品質を公平に検証するために、修練を重ねてきたのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370641,
					"content": "それがやがて一族の試刀術となり、相応する技が生まれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370642,
					"content": "これは実用的な戦場武技とは至極異なるもの、偶然とは到底思えぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370643,
					"content": "だったら、気をつけたほうがいいと思うぞ。なんか変なやつだったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370644,
					"content": "うむ…かように攻撃的な者が他者に手を出せば、良からぬ結果を招きやすい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370645,
					"content": "だったら、すぐに人を手配して調査しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370646,
					"content": "よろしく頼む。拙者も、この件には興味がある。それに、先ほどのお主の提案を考える時間も必要でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370647,
					"content": "#拙者はまず{M#彼ら}{F#彼女ら}と襲撃者の件を調査し、その後お主に明確な答えを出そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370648,
					"content": "分かった、くれぐれも安全には気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120370649,
					"content": "では参ろう。その襲撃者を探すでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 120370638,
					"content": "同じ流派の弟子仲間はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "あまり覚えてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
