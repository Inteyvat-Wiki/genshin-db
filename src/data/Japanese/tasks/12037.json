				"points": []
			},
			"dialogs": [
				{
					"id": 120370201,
					"content": "オイラたち、稲妻に来てもうだいぶ時間が経ったと思わないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370202,
					"content": "今まで、ホントに色んなことがあったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370203,
					"content": "あっという間だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "それに、オイラたちの旅にも進展があったと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370206,
					"content": "で、次はどんなところに行くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370207,
					"content": "待って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "ん？どうした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370209,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "誰か来る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "記憶に残っているものがたくさんある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203704",
							"2"
						],
						"stepId": 1203704,
						"stateName": "QUEST_STATE_UNFINISHED"
