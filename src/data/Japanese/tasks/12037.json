			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"籠釣瓶一心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "ん？神の目を持っていないのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370402,
					"content": "どうやら、人違いだったようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370403,
					"content": "おい、こんなことするんだったら、事前にちゃんと確認しとけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370404,
					"content": "いや…探してるのが誰だろうと、急に人を襲うなんて危ないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370405,
					"content": "楓原万葉という者に、会ったことがあるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370406,
					"content": "お前と同じように、片手剣を扱う。聞いたところ、風元素の神の目を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370407,
					"content": "その人を探してどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "お前には関係ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370409,
					"content": "ふんっ、まあいい。お前も知らないようだな、時間の無駄だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370410,
					"content": "なんだよあいつ。変な刀を振り回すし、わけわからないぞ。しかも、謝罪の一つもないなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370411,
					"content": "あんなやつに万葉の情報を渡すもんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370412,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "だろ。まあ、たとえ正々堂々勝負したとしても、万葉はあいつに負けないと思うけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370416,
					"content": "でも万が一に備えて、今すぐ万葉に知らせてやろうぜ、気をつけろって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370417,
					"content": "実は少し思うことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "ん？なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370419,
					"content": "万葉と何か因縁がある人なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "因縁？あいつが万葉と知り合いだって言いたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370421,
					"content": "なんとなくだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "たしかに、そうかもしれないけど。でも、技なんてみんな同じ感じだろ。それだけじゃ根拠が薄いと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370424,
					"content": "とりあえず、万葉が危ない目に遭わないように、早く教えてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370425,
					"content": "最近、「南十字」船隊が離島で貨物を補充してるらしいぞ。万葉もきっとそこにいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370422,
					"content": "彼の技、万葉のに似てた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "珍しく気が利くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "おい、なに言ってんだよ！オイラはいつだって気が利くだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"潮兄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "こんにちは、万葉がどこにいるか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370502,
					"content": "なんだ、お前たちも万葉を探しに来たのか。どうやら、あいつは本当に凄いことをしたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370503,
					"content": "「も」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "ハハハッ、今回俺たちが小舟でここに来たのは、物資を補給するためだったんだが、港に入った途端、稲妻人が大勢押し寄せてきてな。万葉のことを聞いてきたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370505,
					"content": "以前の名椎の浜の戦いでは、姉さんもあんなに活躍したってのに、これほど人気にはなってなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370506,
					"content": "船隊の中での万葉は、これといって存在感があるわけじゃない。たまに姉さんの言うことを聞かないことだってある。姉さんは気にしちゃいないがな、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370507,
					"content": "えっ、万葉がなにをやったのか知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370508,
					"content": "少しは聞いてるぜ。例えば、雷電将軍の「無想の一太刀」を受け止めたとかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370509,
					"content": "それって凄いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370510,
					"content": "北斗が海山を滅ぼしたのと同じぐらい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "おっ、それなら分かりやすいぜ。ハハハッ、だったらあんなに人気なのも頷ける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370512,
					"content": "あいつはさっき天領奉行の人に呼ばれて行っちまったよ。何か重要なことで相談があるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370513,
					"content": "最初はあいつを捕まえに来たんじゃないかとも思ったが、凄く友好的な態度でな。なんだか、とても尊敬されているような感じだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370514,
					"content": "少し前だったら、まず考えられないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370515,
					"content": "幕府も友好を示したかったんだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "ありがとな。じゃあオイラたち、天領奉行府に行ってみるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120370518,
					"content": "おう、こっちは引き続き、話を聞きに来る人の対応でもしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "潮兄"
				},
				{
					"id": 120370516,
					"content": "雷電将軍の態度が変わったからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
