			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "そんなこと言ってるけど、この先には怪物がたくさんいるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200400502,
					"content": "フィンドのために周りの怪物を片付けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200400503,
					"content": "あの様子じゃ、本当にそのまま進んでしまうかもしれないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200400504,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "おう、真面目な人は助けてあげないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200400505,
					"content": "そこまで真面目になる人いる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "それは最悪の場合だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200400508,
					"content": "でもそうならないように、早く魔物を退治しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
