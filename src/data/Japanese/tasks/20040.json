					"フィンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "はあ、一体どうすればいいかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400102,
					"content": "あら…なんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400103,
					"content": "ここでなにを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "今望風海角にある監視塔に行こうとしてるの。海上に嵐が集まっているかどうか確認したくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400105,
					"content": "でもこの先には怪物たちがいるから…どうすればいいか考えてるところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400106,
					"content": "あっ、心配しないで、別に代わりに行ってほしいという意味じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400107,
					"content": "これは私の責任であり、私のこだわりでもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400108,
					"content": "自分でなんとかするから、気にしないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンド"
				}
			]
		},
