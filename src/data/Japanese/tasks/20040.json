					"フィンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "うん…今日も平和な一日ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400402,
					"content": "うちはヴァネッサ様の命を受けて、代々ここでモンドのために嵐を見張ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400403,
					"content": "バルバトス様のご加護があってから、モンドは嵐に襲われることはなくなって、監視塔も廃れていったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400404,
					"content": "それでも、監視塔に登って確認したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400405,
					"content": "大変だったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "ありがとう、でも私の「責任」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400407,
					"content": "できれば果たす時は永遠に来ないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400410,
					"content": "助けてくれてありがとう。この風車アスターを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400411,
					"content": "昔、一族は風車アスターの成長程度を元に、そのエリアの風力の強さを判断してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400412,
					"content": "全く風のない場所、または暴風に襲われる場所には、風車アスターは生息しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400413,
					"content": "モンドのような優しい風の中でだけ、風車アスターはすくすく成長するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400414,
					"content": "このままずっと成長していってほしいわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400408,
					"content": "大変な歴史だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "ええ、あの歴史がもう二度と繰り返さないでほしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "フィンド"
				}
			]
		},
