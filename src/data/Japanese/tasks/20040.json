			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "またなにか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400202,
					"content": "前はもう安全だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "え？風神に感謝しなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400204,
					"content": "あっ、いいえ、ごめんなさい、お礼を言うべき相手はあなただったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400205,
					"content": "この恩はどうすれば…あっ、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "フィンド"
				},
				{
					"id": 200400206,
					"content": "監視塔に来て。そこで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンド"
				}
			]
		},
		{
