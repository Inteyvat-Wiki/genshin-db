				]
			},
			"dialogs": [
				{
					"id": 150080501,
					"content": "たぶんこの辺りだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080502,
					"content": "見ろ、コホラ竜たちがあっちの岩に集まってくぞ。いったいなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080503,
					"content": "さあ…パーティーに飽きちゃったから、あっちにみんなを集めて、面白い話でもしてるのかな？コホラ竜の言葉は分からないから、何とも言えないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080504,
					"content": "えっ？「流泉の衆」のガイドは、みんなコホラ竜の言葉がわかるもんだと思ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080505,
					"content": "それ、誰に吹き込まれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080506,
					"content": "まあ、よく考えたら出鱈目に決まってるよな…ん？あれはなんだ？石の壁になにか…模様が出てきたぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080507,
					"content": "確か、色の変わる種類の苔があって、コホラ竜が放つ生理的信号に反応するって話を聞いたことがある。でも、苔が反応するためには、かなりの数のコホラ竜が必要なはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080508,
					"content": "なるほど、これが手がかりなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080509,
					"content": "写真を撮るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080510,
					"content": "光でコホラ竜がびっくりしちゃうかもしれないから、模写するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080511,
					"content": "模写が終わると、ムアラニが元の道に案内してくれたので、静かに戻ってきた。そして、ずっと待ってくれていたヴィランドラとカーリャにそれまでの経緯を伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "これで、第一関門は完璧に突破だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080513,
					"content": "なるほど。もし最初から竜の群れを追い払ってしまっていたら、手がかりも得られなかったわけだ…ふむ、やはり理論で説明できるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080514,
					"content": "カーリャさん、彼っていつもこうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080515,
					"content": "つい研究に夢中になってしまうようで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080516,
					"content": "とにかく、これであたしの判断は間違ってなかったって証明されたでしょ？あたしを信じる気になったなら、もう口答えはやめてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080517,
					"content": "…分かった。そのほうが時間を無駄にせずに済みそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080518,
					"content": "ムアラニって、チームをまとめるのが上手いんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080519,
					"content": "プロのガイドだからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "さてと、この手がかりから、次に向かう場所を決めないとね。この模様ってどんな意味なんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080521,
					"content": "ずいぶん抽象的だな。全然わからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080522,
					"content": "…あっ！もしかして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
