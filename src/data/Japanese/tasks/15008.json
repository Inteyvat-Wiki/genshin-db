			"dialogs": [
				{
					"id": 150080401,
					"content": "あった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080402,
					"content": "なにがだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080403,
					"content": "コホラ竜のパーティーに乱入するための鍵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080404,
					"content": "鼻が効くのなら、いくら頑張ってあの子たちの視線を避けて静かに近づいても、匂いできっとバレちゃうでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080405,
					"content": "でも、これがあれば問題解決だよ。この植物はコホラ竜と似た匂いがするから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080406,
					"content": "これから搾った液体を身体に塗り込めば、コホラ竜の鼻をごまかせるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080407,
					"content": "身体に塗るのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080408,
					"content": "大丈夫だって。美容効果もあるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080409,
					"content": "ムアラニは搾った液体を使って、匂いをカモフラージュしてくれた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "うーん…なんかぬるぬるしてるな。でも、たしかにコホラ竜の匂いがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080411,
					"content": "よし、完璧だね。じゃ、もっかい挑戦しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		},
