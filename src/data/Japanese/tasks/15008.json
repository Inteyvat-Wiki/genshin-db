			"dialogs": [
				{
					"id": 150080301,
					"content": "コホラ竜って警戒心が強いんだな。こんなんじゃいつまで経っても向こうに行けそうにないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080302,
					"content": "地図の情報から、手がかりは向こうの谷にあるという結論が出たなら、竜の群れを追い払えばいいんじゃないか？君たちの腕前なら不可能じゃないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080303,
					"content": "コホラ竜をこっちから傷つけちゃいけないって、部族の先輩たちに口を酸っぱくして言われてるの。そんな行為は不吉すぎるってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080304,
					"content": "第一、パーティーに乱入するだけでも失礼なのに、参加者たちを追い払うなんて、ひどすぎでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080305,
					"content": "そ、それはどういう理屈だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080306,
					"content": "では、ほかの方法を考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080307,
					"content": "う～ん…コホラ竜に気づかれずに谷に入る方法はきっとあるはず。一人で考えるのは非効率的だから、みんなで考えよう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080308,
					"content": "オイラも考えてみるぜ…う～ん、迂回するとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080309,
					"content": "地図を見る限り、手がかりはコホラ竜の群れの真ん中あたりにあるし、迂回したって、ほかのコホラ竜の群れに出会うかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080310,
					"content": "そうか…困ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080311,
					"content": "…カーリャさん、ヴィランドラさんのフォローに入る時くらいしか喋ってないけど、何かアイデアはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080312,
					"content": "わ、私ですか？そうですね…先輩がコホラ竜から手がかりを探すと決めたとき、私もコホラ竜について調べるのを手伝ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080313,
					"content": "すると、ある興味深い事実に気づきました——コホラ竜は聴覚によって獲物の方角を判断すると思われてきましたが、実は鋭い嗅覚の持ち主でもあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080314,
					"content": "役に立つかどうか、分かりませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080315,
					"content": "なるほど…そうか！それってすっごく重要な情報だよ、カーリャさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080316,
					"content": "カーリャでいいですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080317,
					"content": "じゃ、引き続き荷物の番をお願いね。旅人、パイモン、ついてきて。いい方法を思いついたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		},
