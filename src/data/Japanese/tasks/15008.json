			"dialogs": [
				{
					"id": 150080101,
					"content": "旅人、パイモン。こっちだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080102,
					"content": "ムアラニ、もう来てたのか。あっ、変なやつも来てるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080103,
					"content": "おはようございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080104,
					"content": "おはよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080105,
					"content": "いつ出発するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080106,
					"content": "ふふ、旅が始まる前からもう待ちきれないって急かす子供みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080107,
					"content": "早くやるべきことに着手したいだけだ…春の遠足とは違うってことは、君も分かってるだろ？お互い、プロらしく行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080108,
					"content": "心配しないで、あたしだってプロのガイドなんだから。コホン…じゃ、神秘の島への旅にレッツゴー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080109,
					"content": "おー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080110,
					"content": "まずは、この彫像なんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080111,
					"content": "おう、これがなにか重要な手掛かりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080112,
					"content": "ううん、「流泉の衆」の初代族長が神秘の島から帰ってきた時に建てたもので、ランドマーク的な存在なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080113,
					"content": "出発の前に彫像に触れて、ご先祖様にお祈りを捧げるの。そうすれば、神秘の島への旅がきっとうまくいくはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080114,
					"content": "…その説に理論的根拠はあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080115,
					"content": "理論的根拠？そんなのはないけど、先生から教わったの。神秘の島へ出発する時のマナーなんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080117,
					"content": "あはは、よくできました。専門外のことについて、とやかく言わないのも、プロの精神だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080118,
					"content": "いいだろう。だが、それじゃ論文には書けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080119,
					"content": "さあさあ、みんなで唱えましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080120,
					"content": "敬愛する先人よ…あなたがかつて成し遂げた偉業…その旅路を、今あたしたちは再び歩み出そうとしています。どうかこの出発を見届け、無事帰ってこられるよう見守ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080121,
					"content": "なんか、偉大な冒険が始まるって感じがするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080122,
					"content": "でしょ？ふふっ、気合を入れて、まずは一つ目の手がかりを探しに行きましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		},
