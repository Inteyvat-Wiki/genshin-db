				]
			},
			"dialogs": [
				{
					"id": 150080201,
					"content": "うわあっ、コホラ竜がいっぱいいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080202,
					"content": "やはり、一つ目の手がかりはコホラ竜と関係してるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080203,
					"content": "部族以外の人でも、地図の写本からたどり着くのはだいたい同じ結論。でもほとんどは、探す方向性が間違ってるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080204,
					"content": "初代族長は手がかりの部分に、特殊な記号を書き入れてるけど、それはあたしたちの部族がコホラ竜をマークするときの暗号なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080205,
					"content": "適当に一匹や二匹のコホラ竜を当たっても、手がかりは見つけられないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080206,
					"content": "さすがプロだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080207,
					"content": "だが、僕が調べた限り、コホラ竜は温泉を奪い合うときを除けば、あまり群れるのを好まないらしいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080208,
					"content": "「流泉の衆」のガイドしか知らない秘密を教えたげる。野外に棲息するコホラ竜は、定期的にこの先にある谷に集まるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080209,
					"content": "そうだなぁ…部族で定期的に催される集会みたいなものかな。その時期が終わったら、すぐに散っていくんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080210,
					"content": "ナタを頻繁に旅するガイドくらいしか、あんまり見られない光景かもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080211,
					"content": "そんなことがあるのか？メモしておかないと。論文の然るべき部分に書き足そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080212,
					"content": "地図を解読してみたけど、手がかりはあの谷の奥に隠されてると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080213,
					"content": "あっちに行くには、竜の群れを抜けないといけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150080214,
					"content": "そうだね…できるだけ、あの子たちに気づかれないように行動しなくちゃ。友達と集まってるところを、邪魔されたくないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080215,
					"content": "りゅ、竜の群れに近づかないといけないんですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150080216,
					"content": "コホン…協力すると約束した以上、双方が力を出し合うべきだ。しかし、カーリャはコホラ竜に襲われたばかりだから、あいにく都合が悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080217,
					"content": "だが僕は…なんら問題ない！カーリャにはここに残ってもらって、彼女の分の仕事は僕が肩代わりしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080218,
					"content": "ふふっ…そもそも全員で行く必要はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080219,
					"content": "誰かが残って荷物を見ないといけないしね。じゃあ荷物の番は二人に任せていいかな？旅人とパイモンはあたしについてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150080220,
					"content": "そうなのか。了解した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150080221,
					"content": "でも、君の後輩を思いやる気持ちは、ばっちり伝わってきたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		},
