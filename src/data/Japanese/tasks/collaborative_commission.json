			"dialogs": [
				{
					"id": 761290101,
					"content": "改めて——ネフェルさん、ヤフォダさん…協会へのご協力、ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 761290102,
					"content": "ただの協力なんだから、そこまで気を遣わなくていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290103,
					"content": "そうは言っても、ネフェルさんには感謝しないと。協会の…複雑な調査活動にご協力いただけたのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 761290104,
					"content": "冒険者協会からも人を出してもらって、こっちの活動を手伝わせたんだから、ウィンウィンってなものさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290105,
					"content": "これからも、よろしく頼むよ、サリーンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290106,
					"content": "ご安心ください。私たち冒険者協会は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 761290107,
					"content": "いえ、正確に申し上げると、私たちナド・クライ冒険者協会支部は、間違いなく信頼してくださって大丈夫ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 761290108,
					"content": "ふふ、見れば分かるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290109,
					"content": "（そうそうそう、いい感じ。姐さん、そのままそのまま…そう、そっちを見てて。頼むからこっちを見ないでくれよ——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290110,
					"content": "ヤフォダ、どうして黙ってるんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290111,
					"content": "（あー！こっち見ないでってば！掲示板は見ないで見ないで見ないで——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290112,
					"content": "え？あ、あたい？だって、特に言うこと思いつかなかったから…依頼をくれて、ありがとう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290113,
					"content": "ふふ、ヤフォダさんにも感謝いたします。あなたがいなければ、協会の業務は山積みになっていたことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "サリーン"
				},
				{
					"id": 761290114,
					"content": "いやいや…お金をもらった以上、ちゃんと仕事するのは当然のことだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290115,
					"content": "（はぁ、前に教えた話術、またすっかり忘れてるね…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290116,
					"content": "そうだ、せっかく来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290117,
					"content": "（やめて！せっかくいい雰囲気なのに。姐さん、見逃してよう！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290118,
					"content": "サリーンさん、最新の依頼を持ってきてもらえるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290119,
					"content": "ヤフォダ、一つ選んでみな。あんたが一番やるべきだと思う依頼をね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290120,
					"content": "よく考えて、ゆっくり選ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761290121,
					"content": "は…はい、ボス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761290122,
					"content": "（うわぁ～、もう！ダメ！だぁ～～！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		}
	]
}