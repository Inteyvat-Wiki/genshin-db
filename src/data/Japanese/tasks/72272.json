			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "お宝を売りたいんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "ん？うちはもう固定の仕入れ先があって、そういうのはやってないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720104,
					"content": "その感じからすると…とんでもない物みたいだな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720105,
					"content": "だったら…まずは物を見せてくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720106,
					"content": "龍骨花の露玉のことを御輿源一郎に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "うわー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720108,
					"content": "正直…その話は面白いと思うが…いくらなんでも突拍子がないというか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720109,
					"content": "これはもう…俺の理解を超えた類のものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720110,
					"content": "悪く思わないでくれ。なんだかんだ言って、俺もただの手芸品の作り手に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720120,
					"content": "じゃあ、八万モラならどうだ？それと刺身の盛り合わせを五つ追加しよう。この料理は安くないからちょうど良いだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720111,
					"content": "その値段でいいなら、お宝を買い取ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720112,
					"content": "これをどんなことに使うか教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "それは俺にも分からない。もう少し調べないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720114,
					"content": "上手くいったら、特別な根付に加工できるかもしれない。そうすれば、良い値段で売れるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720115,
					"content": "適正な価格だと思う、交渉成立。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "なら、モラを受け取ってくれ。俺はこいつをじっくり研究してみるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720117,
					"content": "少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "おう…お互い慎重に考えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "御輿源一郎"
				},
				{
					"id": 722720119,
					"content": "考えがまとまったら、また来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "御輿源一郎"
				}
			]
		},
