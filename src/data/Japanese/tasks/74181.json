			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"メロ·ランボロッソ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "メロ夫人！ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810102,
					"content": "あら？あなたたち…うちのダメ夫の小屋がこの辺にあると聞きまして、様子を見に来たのですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810103,
					"content": "そしたら意外な物を見つけまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810104,
					"content": "まさかこの写真を肌身離さず持っていたなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810105,
					"content": "へへっ、ロシェはメロ夫人のことをとっても気にかけてたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810106,
					"content": "前にメロ夫人を疑ったとき、ロシェだけは頑なに「妻は絶対に犯人じゃない」って言ってたぞ。あのときは一体どこからそんな勇気が出たのかわからなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810107,
					"content": "彼の精一杯の男気ってやつかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "あら？本当に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810109,
					"content": "本当だぞ！それにメロ夫人のペンダントを賭けで失ったって言ってただろ？あれウソなんだぜ。本当のことを言うのが気まずいだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810110,
					"content": "あのことなら、実は私もとっくに勘付いていましたわ。夫が嘘を言っているとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810111,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810112,
					"content": "私の夫にはダメなところがたくさんありますわ、肝は小さいし臆病者で捻くれています。でもあの人は堅実で、人に騙されることはあっても賭け事なんて絶対にしませんの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810113,
					"content": "面と向かって嘘だと突っぱねなかったのは、彼が自分から正直に話してくれるまで待ちたかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810114,
					"content": "へぇ…いい話だな…でも一体ロシェはどこに行ったんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810115,
					"content": "（しーっ…あそこをご覧なさい。彼は百パーセント、あの箱の中に隠れていますわ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810116,
					"content": "（えっ！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810117,
					"content": "（ゴホン…前と同じですわ。ケンカになると、夫はこっそりクローゼットに隠れるのです。私が知らないとでも思っているのかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810118,
					"content": "（彼を呼んでこようか？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "（いいえ、今日は見届けます。あの人がいつまで隠れていられるのかを。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810120,
					"content": "そうだわ。別件でお二人にお願いしたいことがありますの。カーブさんとトゥローザさんに会ったら伝えてくださるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810121,
					"content": "部屋を何室か片づけておきましたから、いつでも泊まりにきなさいと。もちろん、ランボロッソ家はお二人も歓迎しますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "メロ·ランボロッソ"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810123,
					"content": "うん、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "ああ…そうだな。じゃ、オイラたちはおいとまするぜ。ロシェが早く出てきて自分と向き合ってくれるといいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741810125,
					"content": "ありがとう。あなたたちも、今後どんな問題に出くわそうと、すんなりと答えを見つけられますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "メロ·ランボロッソ"
				}
			]
		},
