			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160401,
					"content": "ふぅ…終わった。これでどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160402,
					"content": "ふむ、なかなか良い出来じゃ。汝らの決意と努力が伝わってくるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160403,
					"content": "じゃあ、オイラたちはこれで雷電将軍に勝てるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160404,
					"content": "まあ…まったく敵わないじゃろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160405,
					"content": "おい！じゃあ全部無駄じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160406,
					"content": "ふふ、汝らは計画で最も重要な歯車なんじゃ。妾には考えがある、勝算がまったくないわけないじゃろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160407,
					"content": "そういえば…童よ、汝は抵抗軍をどう見る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160408,
						20160409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160408,
					"content": "正直に言うと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				},
				{
					"id": 20160410,
					"content": "うむ、確かに。たとえ幕府軍との正面対決で優勢を取ろうと、雷電将軍を前にした時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160411,
					"content": "神の目を神像に嵌められた者たちで結成された部隊では、為す術もないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160412,
					"content": "そんなこと言うなよ、こいつはまだ「メカジキ二番隊」の隊長なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160413,
					"content": "ふふ、蔑んでいるわけではない。むしろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160414,
					"content": "彼らが弱く、神の目を失った者たちであるからこそ、より大切にしたいと思う「意志」があるのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160415
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160415,
					"content": "とにかく、計画通りにいけば、少しは役に立つやつらじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160416,
					"content": "計画って…いったい何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160417
					]
				},
				{
					"id": 20160417,
					"content": "おっと…そろそろ時間じゃ、妾にはもう一人客人が来る。話の続きは<color=#00E1FFFF>鳴神大社</color>に戻ってからじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160418,
					"content": "なんでいきなりお客さんの接待に行くんだよ！まったく訳のわからないやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160409,
					"content": "雷電将軍の相手じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160410
					]
				}
			]
		},
		{
			"id": 201605,
			"completionStepIds": [
				201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201609",
							"2"
						],
						"stepId": 201609,
						"stateName": "QUEST_STATE_UNFINISHED"
