	"talks": [
		{
			"id": 201601,
			"completionStepIds": [
				201601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201601",
							"2"
						],
						"stepId": 201601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160101,
					"content": "妾の後に繰り返すんじゃ。「あーん——」、ほれはやく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160102,
						20160104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160102,
					"content": "「あーん——」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160103
					]
				},
				{
					"id": 20160103,
					"content": "うむ、なるほど。少なくとも脳に支障はきたしていないようじゃな。ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160106,
					"content": "やっとのことで、地面に埋もれておるような童を運んできたのじゃ。そうまでしたのに再起不能となっておっては、残念すぎるじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160107,
					"content": "うぅ、さっきから聞きたかったんだけど…なんかおまえの話し方とか雰囲気とか、オイラたちと最初に会った時とだいぶ違うような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160108,
					"content": "そうか？おそらく、あの巫女どもを下がらせたからじゃろう。それに、妾はずっとこんな感じじゃぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160109,
					"content": "人々が見せるのは、常に自分が見せたい姿だけなんじゃ。妾はその点についてよく知っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160110,
					"content": "じゃから、どの一面であろうとすべて本物の「自我」。ただ、人とはそれらを無意味に定義したがるものなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160111,
					"content": "さしあたって人間に属するこの社会において、妾も自分の好きなようにやっておるだけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160112,
					"content": "えっと、全然わからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160113,
					"content": "ふふ、もっと人間というものを研究するんじゃな、小さいの。汝にも分かる日が来るじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160114,
						20160115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160114,
					"content": "いったいどうやって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160116,
					"content": "オイラも気になるぞ！オイラあの時、旅人のことばっか見てたから、おまえがなにをしたのか全然わからなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160117,
					"content": "「鳴神大社の秘法」じゃ。あの散兵という者が一瞬にして地面に跪き、命乞いをしてきたと妾が言ったら、信じるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160119
					]
				},
				{
					"id": 20160119,
					"content": "ふふ、そのようなことを考えるより、どう妾に恩を返すか考える方が重要じゃぞ…そうは思わぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160120,
					"content": "でなければ、やはり頭になんらかの支障をきたしているかもしれぬな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160121,
					"content": "誠に感謝申し上げます。八重神子様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160122
					]
				},
				{
					"id": 20160122,
					"content": "とは言っても、それほど畏まる必要はない。妾が欲しいのは汝の行動じゃ。ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160123,
					"content": "汝は今…まだ「邪眼」のことについて考えている、そうじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160124,
						20160125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160124,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160126,
					"content": "安心せい。すでにあの海祇島の指揮官が手下を率いて掃討に出向いた。それに邪眼の使用を禁ずる重大な軍令も発せられておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160127,
					"content": "あの散兵という者も、拠点が露呈している状態で自らの同僚のため、無駄な抵抗をすることもないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160176
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160176,
					"content": "はぁ、時間があったら、あのファデュイどもの苦しむ姿をぜひ見てみたかったんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160128
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160128,
					"content": "珊瑚宮心海という女、実にやりおる。彼女に会ってきちんと話をしてみたいものじゃが…信仰の違いとは厄介なものじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160129,
					"content": "厄介？おまえは鳴神大社の宮司だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160130,
					"content": "これを汝に伝えたのは安心させるため以外にも…汝に頼み事があったからなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160131,
						20160132
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160131,
					"content": "何をやればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160133,
					"content": "汝…あやつに会ったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160134,
						20160135
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160134,
					"content": "雷電将軍のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160136,
					"content": "妾が言っているのは、その「人形」ではなく…「彼女」に会ったのかと聞いておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160137,
						20160138
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160137,
					"content": "それって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160139,
					"content": "そう。「自我」を維持するため、「一心浄土」で無限の冥想を続けている、本物の雷電将軍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160140
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160140,
					"content": "——その名は、「影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160141
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160141,
					"content": "それって、儀式にいたのは人形で、本物の雷電将軍はそのあとに会ったやつだったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160142,
					"content": "つまり、あのとき変わったのは「戦場」だけじゃなくて、「相手」も違ってたと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160143,
						20160144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160143,
					"content": "確かに微妙な差には気づいてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160145,
					"content": "あれこそ雷電将軍の「永遠」だからじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160146
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160146,
					"content": "この国の永遠を追い求めるには、まずは己が永遠に触れねばならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160147
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160147,
					"content": "肉体はやがて土に還り、「人形」がそれに代わる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160148
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160148,
					"content": "精神は摩耗からは逃れられぬ。あやつは自らの意識をその刀に宿し、冥想を用いてすべての障害を回避しているんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160149
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160149,
					"content": "じゃあ、あの刀で斬り開かれた空間が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160150,
					"content": "「一心浄土」、あやつの「心の世界」のようなもの。基本的には「自我」の存在のみを許す空間じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160151
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160151,
					"content": "自我の世界に閉じこもり、外の雑務はすべて、ただひたすら永遠へと突き進む人形に任せておる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160152
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160152,
					"content": "…それが、影が模索した永遠への道じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160153,
						20160154
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160153,
					"content": "鍾離先生も「摩耗」のことを言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160155,
					"content": "モラクスのことか？もう久しく会っておらぬ。璃月の神がそのような選択をするとはな、やはり面白い神じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160156
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160156,
					"content": "でも雷電将軍のやり方は、たしかに鍾離が言ってた問題を回避できるかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160157,
					"content": "ふふ、じゃが…あやつのやり方、まるで自らの部屋に閉じこもる拗ねた子供とそっくりじゃと思わぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160158
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160158,
					"content": "あやつの言う「永遠」はもうとっくに、あやつの思う「永遠」になっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160159
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160159,
					"content": "つまるところ…失うのが怖いんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160160
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160160,
					"content": "何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160161
					]
				},
				{
					"id": 20160161,
					"content": "汝と妾は…同じ立場におる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160162
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160162,
					"content": "汝は目狩り令から稲妻の民を救いたい、それは妾も同じじゃ。ただついでに、この国とあやつも救いたいのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160163
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160163,
					"content": "そして、ここが肝心なんじゃが——「一心浄土」が影の心の世界を表しているというのなら、そこであやつを打ち負かせば、あやつの意志を「変える」ことができるやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160164
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160164,
					"content": "それがおまえの考えた、目狩り令を廃止する方法か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160165
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160165,
					"content": "言葉で説得したり、抵抗軍の力で改革を起こしたりするんじゃなくて…直接、雷電将軍の心の世界を変えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160166
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160166,
					"content": "理解が早いな。ともかくこれこそ、稲妻が「暗黒の永遠」に陥る前に、それを正しい軌道に戻せる唯一の方法じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160167,
						20160168
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160167,
					"content": "でも何で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160169,
					"content": "まだ自分が特別なことを認識しておらぬのか？言ったはずじゃ、「一心浄土」は基本的に自我のみを許容する空間、汝がそこに行けたということはつまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160170
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160170,
					"content": "…あやつは汝に十分な関心を持っているということじゃ。あやつもきっと…永遠にとってこれほどまでに「不安定」な個体は見たことがなかったんじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160171
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160171,
					"content": "他のやつは入ったことないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160172,
					"content": "あの永遠の信徒が自我を閉じ込めた時から、今まで一度たりともなかった。それどころか、あの空間がどのようなものなのか知る者もおらぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160173
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160173,
					"content": "汝の存在は契機だけでなく、「鍵」でもあるんじゃ…やはり妾の期待通りじゃな、童よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160174
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160174,
					"content": "あれ、もう行くのか？どこに行くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160175
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160175,
					"content": "<color=#00E1FFFF>「対雷電将軍特訓」</color>。汝のために特別に用意したんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160168,
					"content": "#何で{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160154,
					"content": "摩耗は鍾離先生が引退した理由の一つ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160144,
					"content": "でも、なんでそんなことを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160138,
					"content": "あの「空間」にいた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160135,
					"content": "会ったけど、神像の儀式で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160132,
					"content": "#それが{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を助けた理由？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160125,
					"content": "その後どうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160115,
					"content": "どうやって散兵から助けてくれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160104,
					"content": "八重神子！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160105
					]
				},
				{
					"id": 20160105,
					"content": "ほう？すぐに妾が分かったということは、少なくとも脳に支障はきたしていないみたいじゃな。ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201604,
			"completionStepIds": [
				201604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
