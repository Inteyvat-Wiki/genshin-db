			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160501,
					"content": "さて、ここで話すとしよう。汝が気になっているであろう計画は、妾がずっと考えてきたものなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160502
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160502,
					"content": "計画を立てるにあたり、一番重要なことが何なのか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160503,
					"content": "ん、なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160504,
					"content": "——情勢を見極めることじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160505,
					"content": "目狩り令の発令は明らかに何者かによる誘導と言えよう、「人形の将軍」が持つ、永遠への執着を利用したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160506,
						20160507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160506,
					"content": "「散兵」の言ってた事がそれを証明してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				},
				{
					"id": 20160508,
					"content": "うむ、確かにそれが一番の裏付けとなっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160509,
					"content": "目狩り令の発令と執行を思い返してみると、法令の遂行に関与していたのは、常に天領奉行じゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160510,
					"content": "たしか綾華が言ってたぞ。目狩り令反対の書類を上に提出しても、天領奉行と勘定奉行がすぐに否決して、相談すらできなかったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160511,
						20160512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160511,
					"content": "天領奉行はファデュイと協力してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160513,
					"content": "ああ、もう明らかじゃな。社奉行以外の二つは、ファデュイと結託しておる。ふんっ、欲に目がくらんだ愚かな人間よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160514,
					"content": "つまり、現在ファデュイには「情勢を攪乱する者」が存在し、二つの奉行を籠絡して、邪眼を広めておる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160515,
					"content": "そして残念なことに、二つの奉行と雷電将軍の庇護により、その者のしっぽはまだ掴めておらぬ状況じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160516,
					"content": "じゃあ、どうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160517,
					"content": "切り口を稲妻人に変えるのがいいじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160518
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160518,
					"content": "妾は…天領奉行が謀反するよう仕掛ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160519,
					"content": "天領奉行が謀反するよう？なに言ってんだよ、天領奉行はもう裏切ってるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160520,
					"content": "ふふ、妾が言ったのは天領奉行が幕府を裏切ったことではない…ある者に今の天領奉行を裏切ってもらうのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160521,
					"content": "「彼女」を利用すれば、汝をきっと…雷電将軍の前へ導くことができるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160522,
						20160523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160522,
					"content": "回りくどい言い方はやめて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160524,
					"content": "幕府軍を率いる者じゃ。毎月この日になると神社にお参りに来る、今日の客人でもあるのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160525,
					"content": "そやつは…もう背後におるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160526,
					"content": "動くなッ！お尋ね者が堂々と神社に現れるとはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160527
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160527,
					"content": "抵抗はするなよ、大人しく奉行所に行ってもらう。ヤツを捕らえろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160528
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160528,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160529
					],
					"speakerTitle": "元助"
				},
				{
					"id": 20160529,
					"content": "九条…裟羅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160530,
					"content": "おっと、忘れたとは言わせぬぞ、ここは鳴神大社…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160531,
					"content": "ここで武力を行使すれば、将軍への不敬となろう…汝らの中でその罪を贖える者はおるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160532,
					"content": "チッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160533
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160533,
					"content": "八重宮司様、もしや…そのお尋ね者をかばっているので？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160534
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160534,
					"content": "友と語らっていただけにすぎぬ、かばうも何もない。まずは手下を引かせたらどうじゃ、話し合いはそれからじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160535,
					"content": "お前たち、下がれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160536
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160536,
					"content": "御意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160537
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 20160537,
					"content": "では、八重宮司様。神社でお尋ね者を匿うことも、将軍様への不敬となるのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160538
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160538,
					"content": "ふふふ…相変わらずじゃのう、九条裟羅殿。将軍への忠誠において、汝に敵う者はいないじゃろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160539,
					"content": "臣下として、将軍様に忠誠を誓うのは当然。そして武人として、将軍様の境地は私のずっと追い求めていたものでもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160540
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160540,
					"content": "たとえ雷電将軍が…いつか汝の神の目を奪うことになってもか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160541
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160541,
					"content": "目狩り令は将軍様の決断、私に不服はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160542
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160542,
					"content": "はぁ、ただ…忠誠も情勢によって打ち砕かれる。汝が何も分かっていないと言うべきか、唯一目が覚めている者というべきか。どっちじゃろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160543
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160543,
					"content": "その言葉がどういう意味か、直接おっしゃっていただけますでしょうか、宮司様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160544
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160544,
					"content": "目狩り令はファデュイに惑わされたものにすぎぬ、稲妻を陥れる悪政じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160545
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160545,
					"content": "そして、「盲目的に従っている者」は他でもない、汝らの当主、天領奉行——九条家の者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160546
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160546,
					"content": "それは、九条家が…幕府を裏切ったと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160547
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160547,
					"content": "そうじゃ、理解が早くて助かるのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160548
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160548,
					"content": "八重宮司様、その言葉は危険であるだけでなく、馬鹿げています。三奉行は古来より将軍様に仕え、忠誠を誓ってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160549
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160549,
					"content": "私は九条家へと養子に来て以来、この目で見てきたのです。天領奉行にいるのはすべて将軍様に忠実な者ばかり、特に当主の孝行様は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160550
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160550,
					"content": "あの方の「無想の一太刀」に対する崇拝は、いかなる者よりも勝ります。私の将軍様への敬意は、孝行様の万分の一にも満たないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160551
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160551,
					"content": "そんな当主が、将軍様の不利になることをするとでも言うのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160552
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160552,
					"content": "三日後じゃ…三日後またここに来るとよい、証拠を渡してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160553
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160553,
					"content": "宮司である妾は、人々が自分の信じたいことのみを信じるとよく知っておる。じゃから、汝の目に映らない部分は、ただ目をそらしているだけかもしれぬぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160554
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160554,
					"content": "であれば…妾が悪役を演じ、その皮を剥ぎ取り、汝に見せてやるしかなかろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160555
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160555,
					"content": "ふん…三日ですね、わかりました。しかし、もし証拠がなければ、九条家に対する憶測について謝っていただきましょう。それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160556
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160556,
					"content": "#…その時は{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}も連れていきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160557
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 20160557,
					"content": "ああ、よいぞ。三日後、汝のお越しをお待ちしておるぞ、お客人よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160558
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160558,
					"content": "びっくりした…九条裟羅がこんなところに来るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160559
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160559,
					"content": "ところで神子、さっき言ってた天領奉行が裏切った証拠…もうなにか見つけてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160560
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160560,
					"content": "分かりきったことを、もちろんないぞ。さっきは九条裟羅を説得するために、その場で思いついて言っただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160561
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160561,
					"content": "うぅ…やっぱり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160562
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160562,
					"content": "「神の意志を変える」こと自体、大きな賭けなんじゃ。神を相手に、完璧な勝算のある者などいるわけないじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160563
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160563,
					"content": "じゃあ、どうするんだよ。三日しかないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160564
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160564,
					"content": "証拠を手に入れるには、助っ人が必要じゃな。であれば今から…妾と共にその<color=#00E1FFFF>「専門家」</color>を起こしに行くとするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160523,
					"content": "その人は誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160524
					]
				},
				{
					"id": 20160512,
					"content": "勘定奉行もとっくに幕府を裏切ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160513
					]
				},
				{
					"id": 20160507,
					"content": "ファデュイが邪眼を広めるためかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160508
					]
				}
			]
		},
		{
			"id": 201606,
			"completionStepIds": [
				201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201608",
							"2"
						],
						"stepId": 201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160601,
					"content": "ここか？そこにある<color=#00E1FFFF>装置</color>はなんなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160602,
					"content": "雷電将軍の技が再現できる法器とでも言おうか。妾の記憶を頼りにそっくりに作ったものじゃ…あやつの武道が鈍っていなければな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160603
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160603,
					"content": "事前に技を学び、対策を立てれば、戦いも有利になるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160604
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160604,
					"content": "あやつの技に耐える練習をするといい。一度はあやつの手中から逃げられたのじゃから、これしき難しいことではないじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				}
			]
		},
		{
			"id": 201607,
			"completionStepIds": [
				201607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201607",
							"2"
						],
						"stepId": 201607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160701,
					"content": "けっこう練習したな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160702,
						20160703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160702,
					"content": "楽勝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160704
					]
				},
				{
					"id": 20160704,
					"content": "ところで、神子はなんでこんなに雷電将軍のことを知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160705,
					"content": "ほう、妾にそれを聞くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160706
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160706,
					"content": "そうじゃな…妾が「雷神の眷属」であるからじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160707
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160707,
					"content": "えっ！？トワリンとバルバトスのような関係なのか？全然そう見えなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160708,
					"content": "ふふ、その感じ、妾の「狐お姉さん」姿に興味があるような口ぶりじゃのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160709,
						20160710
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160709,
					"content": "見たい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160711,
					"content": "調子に乗るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160712
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160712,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20160713,
					"content": "気にすべき点は妾の姿ではなく、なぜ妾があやつと会わなくなったかじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160714
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160714,
					"content": "「永遠に変わらない国」、それは妾とあやつの夢じゃった。じゃが、妾はそれが完全なる「静止」を意味するとは思っておらんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160715
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160715,
					"content": "その時から、あやつは妾の手の届かぬ道を歩み始めたのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160716
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160716,
					"content": "影が「一心浄土」に踏み入る時、妾に別れの言葉もなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160717
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160717,
					"content": "妾の独り善がりなのかもしれぬが、それがあやつの、友情を永遠に保つ方法だったのじゃと妾は思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160718
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160718,
					"content": "別れを告げず、会うこともなく、妾たちの関係は永久にあの時のまま保たれる。少なくともあやつはそのように考えておるのじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160719,
						20160720
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160719,
					"content": "独り善がりなのは将軍の方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160721,
					"content": "まったく異なる二つの永遠の道に分かれた今、現状を維持し続けるのか、どんな犠牲を払ってでもあやつを正しい道に戻すのか、どちらかを選択することができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160722
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160722,
					"content": "妾は後者を選ぶことに決めたのじゃ。もし…「一心浄土」に閉じこもることが、あやつにとって永遠への道というのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160723
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160723,
					"content": "あやつを自我の世界から引き戻すことが、「永遠の眷属」である妾のすべきことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160724
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20160724,
					"content": "神子…いい友達だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160725
					],
