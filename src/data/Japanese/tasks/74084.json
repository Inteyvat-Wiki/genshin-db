					"nextDialogs": [
						740841217
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841217,
					"content": "うーん…まぁいいか…オイラたちを褒めてるみたいだけど、なんかおかしいような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841218,
					"content": "紫のやつ、すごい悪い、エリニュス、とてもメリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841219,
					"content": "わかった、まったく…おまえはオイラが見た中で一番特別なメリュジーヌだぞ…。そうだ、オイラの知ってるメリュジーヌは、ほとんどフォンテーヌ廷かメリュシー村で暮らしてるけど…おまえはどうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841220,
					"content": "フォンテーヌテイ？メリュシームラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841221,
					"content": "困ってそうだな…聞いたこともないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841222,
					"content": "フォンテーヌテイ、メリュジーヌ…メリュシームラ、メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841223,
					"content": "あ…エリニュス、パシーフ、おうち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841224,
					"content": "エリニュス、パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841225,
					"content": "待て、ここがおまえの家だって？つまり故郷を守ってるのか？",
