			"dialogs": [
				{
					"id": 740840605,
					"content": "見ろ！祭壇の隣にヴィシャップがいるぞ！寝てるのかな？気をつけようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840601,
					"content": "あれ？…ここ、どうして鍵がないんだ？もう祭壇が起動させられたとか？誰かに鍵を取られたんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840602,
					"content": "ガオーー！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "眠るヴィシャップ"
				},
				{
					"id": 740840603,
					"content": "まずい！ヴィシャップが目を覚ました！早く逃げよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840604,
					"content": "祭壇のそばでヴィシャップが体を揺らし、目を覚ました。両目には怒りと悪意が満ちている…\\nあなたたちは慌てて向こう岸へ泳いでいったが…ヴィシャップはしつこく追いかけてきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
