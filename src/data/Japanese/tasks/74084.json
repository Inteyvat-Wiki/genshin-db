					"nextDialogs": [
						740841245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841245,
					"content": "メリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841246,
					"content": "#{M#君}{F#あなた}は塗り絵ヒトに協力してるの？",
