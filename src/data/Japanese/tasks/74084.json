			"dialogs": [
				{
					"id": 740840801,
					"content": "…メリュジーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840802,
					"content": "パシーフ、おまえがどうしてここに？早くヴィシャップから離れろ、危ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840803,
					"content": "善良なパイモン、パシーフ！危険、メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840804,
					"content": "パシーフはヴィシャップの頭を撫で、暴怒のヴィシャップが大人しく俯いた。\\nそして口を開け、キラキラ光る雫を吐き出し、そのまま水中に飛び込んだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "鍵だ！鍵がヴィシャップの口の中に隠されてたんだ！しかも自分から鍵を吐き出すなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840806,
					"content": "青いやつ、いいもの、鍵、守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840807,
					"content": "青いやつって、さっきのヴィシャップ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "パシーフ、あのヴィシャップとは友達なのか？あいつが鍵を守ってくれてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840809,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840810,
					"content": "紫のやつ、鍵奪う…青いやつ、倒れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840811,
					"content": "む、紫のやつ？それって誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840812,
					"content": "#紫のやつ、わるいもの…青いやつ、パイモン、{NICKNAME}、いいもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840813,
					"content": "うーん…まぁいいか…オイラたちを褒めてるみたいだけど、なんかおかしいような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840814,
					"content": "紫のやつ、すごい悪い、エリニュス、とてもメリュジーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840815,
					"content": "つまり…この島に危害を加えたのはその紫のやつなのか？幸い、鍵はオイラたちが持ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740840816,
					"content": "#パイモン、{NICKNAME}、パシーフ！でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840817,
					"content": "鍵、鍵、鍵、広場、西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740840818,
					"content": "わかったぞ、パシーフ。慌てるな、これから西の広場へ行くからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
