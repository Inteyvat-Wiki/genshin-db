			"dialogs": [
				{
					"id": 740841201,
					"content": "…メリュジーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841202,
					"content": "パシーフ？どこから来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841203,
					"content": "トツゼン！パシーフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841204,
					"content": "おい、とにかく早くヴィシャップから離れろ、危ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841205,
					"content": "善良なパイモン、パシーフ！危険、メリュジーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841206,
					"content": "パシーフはヴィシャップの頭を撫で、暴怒のヴィシャップが大人しく俯いた。\\nそして口を開け、キラキラ光る雫を吐き出し、そのまま水中に飛び込んだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "鍵、鍵、パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841208,
					"content": "おお…ヴィシャップが自分から鍵を出した？まさか、おまえの言うことを聞くなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841209,
					"content": "青いやつ、いいもの、鍵、守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841210,
					"content": "青いやつって、さっきのヴィシャップ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841212,
					"content": "もしかしてあいつは鍵を守ってくれてたのか？おまえ、あのヴィシャップと友達か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841213,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841214,
					"content": "紫のやつ、鍵奪う…青いやつ、倒れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740841215,
					"content": "む、紫のやつ？それって誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740841216,
					"content": "#紫のやつ、わるいもの！青いやつ、パイモン、{NICKNAME}、いいもの！",
