			"dialogs": [
				{
					"id": 4260101,
					"content": "少し座って休もう！これからどうしたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260102,
					"content": "任務を行う",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "これなら簡単だ。左上のビックリマークをタップすると受けた任務を確認できるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260104,
					"content": "任務には難易度レベルがあるから、レベル差がありすぎると、大変なことになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260117,
					"content": "他に知りたいことは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260105,
					"content": "ぶらぶらする",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "違うエリアにおすすめの難易度レベルがあるんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260107,
					"content": "実力に合ったエリアで挑戦すると、効率よく実力を上げられるんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260108,
					"content": "冒険者協会のエルフィってやつはテイワット大陸に詳しいんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260109,
					"content": "彼女はモンドの商店街にいるから、おすすめのエリアがないか彼女に聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260110,
					"content": "強くなりたい",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "うん、それなら武器と貴重な聖遺物が必要だな",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260112,
					"content": "比較的に危険んだけど、秘境にはいいものがたくさんあると聞いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260113,
					"content": "もちろんモンドの商店街でも買えるんだ、お金に余裕があるならな",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260114,
					"content": "それから、武器と聖遺物は強化と突破ができるんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260115,
					"content": "それに関してはおまえが自分で研究するしかないな",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260116,
					"content": "そうだ、キャラのレベルも大事だぞ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4260118,
					"content": "特にない。先に帰っていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
