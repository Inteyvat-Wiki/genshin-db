				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "あとこの食材さえあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "ん？旅人か。今ちょうど「古代レシピ」について考えていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060104,
					"content": "少し前に雪山に入った探検隊がいてな、その中に俺の知り合いの冒険者もいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060105,
					"content": "その時、悪天候のせいで遠くまで行けなかったようだが、吹雪を避けるために偶然遺跡に入ってしまったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060106,
					"content": "遺跡の中は書物ばかり置いてあったが、その中にレシピも混じっていたんだ…それも保存状態もかなりよくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060107,
					"content": "その冒険者が俺にレシピを手渡して、「古代の美食」を再現してほしいと頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060108,
					"content": "正直に言うと、レシピに書かれたほとんどの材料も製作手順も今までに見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060109,
					"content": "だから、味の要になる特殊な食材をいくつか残して、あとは自分なりにレシピをアレンジしたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060118,
					"content": "特殊な食材を集めるのを手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060110,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "おぉ、威勢がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060113,
					"content": "誤って雪山に入った子イノシシが氷に閉じ込められている話を聞いたことがある。その肉なら…面白い味を出せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060114,
					"content": "だから、その凍った子イノシシを探して、「冷製鮮肉」を10個集めてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060115,
					"content": "冷製鮮肉って何…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "ああ、俺が凍った子イノシシの肉に付けた名前だよ。氷の中で新鮮な状態を維持している肉だから「冷製鮮肉」、いい名前だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060117,
					"content": "じゃあ頼んだぞ。食材が集まったら持って来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060112,
					"content": "どんな食材が必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
