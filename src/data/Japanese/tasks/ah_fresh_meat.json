			"dialogs": [
				{
					"id": 701060201,
					"content": "冷製鮮肉について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "なかなか良さそうな「冷製鮮肉」だな…うん、これで必要な食材はあと一つだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060203,
					"content": "「雪のイノシシ王」のことを耳にしたことはあるか？雪山の奥深くで暮らしている猛獣らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060204,
					"content": "前レシピで「雪のイノシシ王」の肉は上質で、どんな調理法にも合うのだと読んだことがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060205,
					"content": "旅人、もう一度頼めるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 701060206,
					"content": "報酬は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "心配するな、報酬は用意してある。では頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリス"
				}
			]
		},
