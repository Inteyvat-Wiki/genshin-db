			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#ありがとう、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270102,
					"content": "もともとブドウの様子を確認しに行こうと思ったが、まさかこんなことになるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270103,
					"content": "あっ、息子には言わないでくれ。あいつは西風騎士なんだ。普段から大変だろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270104,
					"content": "じじいのトラブルで困らせる必要はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270105,
					"content": "しかし近頃ワイナリーの周辺にはスライムがよく出るんだ。ブドウがスライムに荒らされないか毎日心配で、夜も眠れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270106,
					"content": "時間があったら、この辺のスライムを追い払ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "よかった、やっと少し休めるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200270108,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "はあ、本来なら俺が自分でやるべきなんだが…じじいはもう動けなくてな。若者、手を貸してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
				}
			]
		}
	]
