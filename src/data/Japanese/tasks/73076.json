				"objectNames": [
					"ナジブ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "へえ、「駄獣大王」？それって、あの巨大な駄獣のことでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "ナジブ"
				},
				{
					"id": 730760502,
					"content": "二日前、璃月に行ってたんだけどさ。層岩巨淵を通った時、そいつを見たよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "ナジブ"
				},
				{
					"id": 730760503,
					"content": "運よくあいつが寝てたから、忍び足で避けて難を逃れたんだ。寝てる姿は、ちょっとした丘みたいだったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "ナジブ"
				},
				{
					"id": 730760504,
					"content": "ん？見た場所？璃月は南の方だし、南のどっかだとは思うんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "ナジブ"
				},
				{
					"id": 730760505,
					"content": "…あれ？普通スメールから璃月に行くには、水路を使うよな。なんで層岩巨淵の方を通ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760506,
					"content": "そ、それは個人の勝手だろ。ほっといてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "ナジブ"
				},
				{
					"id": 730760507,
					"content": "さてと、知ってることは全部話した。僕は忙しいんだ…もうこれで勘弁してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジブ"
				}
			]
		},
