				"objectNames": [
					"アナヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "はい？「駄獣大王」ですか？…ああ。数日前の夜、森に行った時に見かけましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "アナヤ"
				},
				{
					"id": 730760602,
					"content": "あの夜は星一つ見えない曇り空でした。半分ほど歩いた所で、すぐ傍にいた小山みたいな黒い影が、地響きと共に襲い掛かってきたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "アナヤ"
				},
				{
					"id": 730760603,
					"content": "私はすぐに気を失って、意識が戻ったのは次の日でした。助けて下さった方によると、私は山のふもとに倒れていたそうです…運よく軽傷ですみましたけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "アナヤ"
				},
				{
					"id": 730760604,
					"content": "場所ですか…はっきりとは覚えてませんが、東の方だったかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナヤ"
				}
			]
		},
		{
