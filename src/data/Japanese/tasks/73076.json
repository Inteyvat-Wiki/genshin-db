			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "いやあ…自然の息吹を感じるなら、やっぱりスメールに限る。ハハッ、それに比べてフォンテーヌのむさ苦しいことといったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760102,
					"content": "ん？なんだい？何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760103,
					"content": "いや、ちょっとした好奇心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "そうそう。このテントに住んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760105,
					"content": "ああ、最近はずっとここに住んでるよ…ハハッ、そうか。フォンテーヌ人がスメールの野外でテントを張ってるのが、不思議なんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760106,
					"content": "どうしてこうなったか、じっくり説明してあげよう…あ、その前に、君たちの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760107,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760108,
					"content": "#{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#なるほど、{NICKNAME}とパイモンか。覚えたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760110,
					"content": "オレはサントン。見ての通りフォンテーヌ人さ…なぜスメールに来たのかって？そりゃもちろん、森が好きだからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760111,
					"content": "ずっと都会で生活してると、運動不足で体がなまって気持ちもだらける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760112,
					"content": "でも、広大な自然の中にいる時だけは、自分も自然や万物の一部だと思える。森は自然を身近に感じられる一番の場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760113,
					"content": "だからスメールに来たのさ。ここの森がテイワットでは一番だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760114,
					"content": "わかったような、イマイチわからないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760115,
					"content": "でも、スメールの森はすっごく危険なんだぞ。おっきいのからちっちゃいのまで、色んな魔物がうじゃうじゃいるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760116,
					"content": "危険だからいいのさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760117,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760118,
					"content": "危険じゃなきゃ、サバイバル感が出ないだろう！心配するな。オレは、実はフォンテーヌじゃちっとは名の知れたハンターなんだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760119,
					"content": "ってことは、森が好きっていうか、森で狩りをするのが好きなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760120,
					"content": "ふんっ、フォンテーヌから来たただの密猟者じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760121,
					"content": "介入したほうがよさそうだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "おいおい、勘違いすんなよ。密猟者なんかじゃないって…密猟は相当な重罪だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760124,
					"content": "フォンテーヌでは密猟で捕まると、一生を棒に振る羽目になる。オレにそんな勇気はないさ。フォンテーヌの狩りは、「害獣駆除」が大半なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760125,
					"content": "害獣…駆除？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760126,
					"content": "危険生物が民家に近づいたら、両方が怪我することになるだろ…だから、居住区からある程度離れたとこまで追い払うのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760127,
					"content": "そ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760128,
					"content": "ああ。そうすれば、危険生物の民家への侵入を防げるし、動物の方だって、人に日々の営みを邪魔されずにすむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760129,
					"content": "実はオレ、この辺に危険生物らしきものがいるって聞いて駆除の依頼を引き受けたんだ。だからここに住んでるってわけ。ハンターとして、黙って見てるわけにはいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760130,
					"content": "…まあ、個人的に危険生物にはちょっと興味が…ってのもあるけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760131,
					"content": "ほら、だって気になるだろ。「成長しすぎの巨大ワニ」なんか、子供たちからは「ゲーターキング」って呼ばれてる。まるで都市伝説から出て来たみたいだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760132,
					"content": "しょっちゅうこの辺の水域に出没するらしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760133,
					"content": "それに「子さらいリシュボラン虎のラージャ」とか「璃月に通ずる道を塞ぐ巨大駄獣」ってのもある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760134,
					"content": "「リシュボラン虎のラージャ」は西のジャングルにいるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760135,
					"content": "「駄獣大王」…おっと、つまり巨大駄獣を見て、腰を抜かした目撃者も複数いる。証言によれば、東の某エリアを徘徊していて、通りかかった人を襲うんだとさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760136,
					"content": "それ、めちゃくちゃ危険そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760137,
					"content": "だろ。もし遭遇したら、気をつけろよ…ん、君たち、何やらベテランハンターのオーラが漂ってるな。はは、余計な心配だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760138,
					"content": "道で危険生物に出くわしたら、オレの代わりに駆除しといてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760139,
					"content": "そしたら近所の人たちも、危険な目に遭わなくてすむ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760140,
					"content": "うん、もし出くわしたらね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "恩に着るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760142,
					"content": "近隣住民の安全、危険生物の安全、それにもちろん、君たち自身の安全にも注意してくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760143,
					"content": "おう、わかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760122,
					"content": "密猟は生態系を壊す行為！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
