				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "な、何？もう危険生物を退治しただって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760702,
					"content": "オレはまだ見つけてもいないのに…で、危険生物はものすごく強かっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760703,
					"content": "それなりに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "ハハッ、まだまだ余裕って感じだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760707,
					"content": "危険生物をみんな駆除できたと聞いて、心の底からほっとしたよ。でも…何でだろうな、自分の手で駆除できなかったのが悔しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760708,
					"content": "獲物を強力なライバルに奪われることなんか、何度も経験してきたはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760709,
					"content": "ハハハッ、次があったら絶対負けないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760710,
					"content": "こっちだって負けないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "そうだ、そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760712,
					"content": "でも、前も思ったんだけど、「危険生物の駆除」ってスメールではレンジャーの仕事だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760713,
					"content": "おっと、言ってなかったか？オレは依頼を受けたんだ…知り合いのレンジャーから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760714,
					"content": "詳しくは知らないけど、近ごろは「死域」の調査かなんかでレンジャーも忙しいらしくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760715,
					"content": "だから「危険生物の駆除」みたいな仕事はオレに回ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760716,
					"content": "なるほどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760717,
					"content": "今回は世話になったな！これは危険生物駆除の報酬だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760705,
					"content": "それはもう強かった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "へえ、この目で見てみたいもんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "サントン"
				}
			]
		},
