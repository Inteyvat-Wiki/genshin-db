			"dialogs": [
				{
					"id": 730760301,
					"content": "どうだい？危険生物には遭遇したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760302,
					"content": "危険生物に遭遇したら、オレの代わりに退治してくれよ…「危険生物の駆除」は、住民と動物双方にとってメリットがあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760303,
					"content": "「ゲーターキング」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "「ゲーターキング」は町の東の水域にいると聞いた…でもずる賢いらしくってさ、何回行っても会えずじまいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760305,
					"content": "「リシュボラン虎のラージャ」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "この辺りには「リシュボラン虎のラージャ」の伝説があるらしい。なんでも夜中になると、そいつが西の森から飛び出してきて、大人しく寝ようとしない悪ガキを連れ去るそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760307,
					"content": "後半は親から子供への脅し文句だろうけどな。「リシュボラン虎」が夜になると活発になるのは確かだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760308,
					"content": "夜中に道を急ぐ旅人が巨大な「リシュボラン虎」に遭遇して、暫く追いかけられたけど、無事だったって話も聞いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760309,
					"content": "「駄獣大王」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "野生駄獣の一部には縄張り意識の強い種がいてな、領地に侵入してくる者を攻撃するらしい。多分、それは「駄獣大王」も一緒なんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760311,
					"content": "奴の縄張りは、東側のとあるエリアだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760312,
					"content": "「駄獣大王」と呼ばれるくらいだ、一体どのくらいの大きさなんだろうな。ものすごく気になるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サントン"
				},
				{
					"id": 730760313,
					"content": "まだ調査中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "そっか。じゃあがんばってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サントン"
				}
			]
		},
