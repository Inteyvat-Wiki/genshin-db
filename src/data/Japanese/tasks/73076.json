						730760208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760208,
					"content": "#{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760209
					]
				},
				{
					"id": 730760209,
					"content": "#なるほど、{NICKNAME}とパイモンか。覚えたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760210
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760210,
					"content": "オレはサントン。見ての通りフォンテーヌ人さ…なぜスメールに来たのかって？そりゃもちろん、森が好きだからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760211
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760211,
					"content": "ずっと都会で生活してると、運動不足で体がなまって気持ちもだらける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760212
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760212,
					"content": "でも、広大な自然の中にいる時だけは、自分も自然や万物の一部だと思える。森は自然を身近に感じられる一番の場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760213
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760213,
					"content": "だからスメールに来たのさ。ここの森がテイワットでは一番だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760214,
					"content": "わかったような、イマイチわからないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760215,
					"content": "でも、スメールの森はすっごく危険なんだぞ。おっきいのからちっちゃいのまで、色んな魔物がうじゃうじゃいるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760216,
					"content": "危険だからいいのさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760217,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760218,
					"content": "危険じゃなきゃ、サバイバル感が出ないだろう！心配するな。オレは、実はフォンテーヌじゃちっとは名の知れたハンターなんだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760219
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760219,
					"content": "ってことは、森が好きっていうか、森で狩りをするのが好きなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760220,
					"content": "ふんっ、フォンテーヌから来たただの密猟者じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760221,
						730760222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760221,
					"content": "密猟は生態系を壊す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760223
					]
				},
				{
					"id": 730760223,
					"content": "おいおい、勘違いすんなよ。密猟者なんかじゃないって…密猟は相当な重罪だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760224
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760224,
					"content": "フォンテーヌでは密猟で捕まると、一生を棒に振る羽目になる。オレにそんな勇気はないさ。フォンテーヌの狩りは、「害獣駆除」が大半なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760225
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760225,
					"content": "害獣…駆除？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760226,
					"content": "危険生物が民家に近づいたら、両方が怪我することになるだろ…だから、居住区からある程度離れたとこまで追い払うのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760227
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760227,
					"content": "そ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760228,
					"content": "ああ。そうすれば、危険生物の民家への侵入を防げるし、動物の方だって、人に日々の営みを邪魔されずにすむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760229
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760229,
					"content": "実はオレ、この辺に危険生物らしきものがいるって聞いて駆除の依頼を引き受けたんだ。だからここに住んでるってわけ。ハンターとして、黙って見てるわけにはいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760230
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760230,
					"content": "…まあ、個人的に危険生物にはちょっと興味が…ってのもあるけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760231
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760231,
					"content": "ほら、だって気になるだろ。「成長しすぎの巨大ワニ」なんか、子供たちからは「ゲーターキング」って呼ばれてる。まるで都市伝説から出て来たみたいだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760232
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760232,
					"content": "#えっ、デカいワニ？{NICKNAME}、それってオイラたちが前に遭ったやつじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760233,
					"content": "なに？伝説の「ゲーターキング」は君たちがもう駆除してたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760234
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760234,
					"content": "「ゲーターキング」は奔流をかき分けて水面に現れるんだってな。それで突然隆起するように出てきて、河の水を遮断する巨大な中州みたいになるって聞いたぞ。ほんとにそうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760235,
						730760237
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760235,
					"content": "まさにその通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760236
					]
				},
				{
					"id": 730760236,
					"content": "そりゃすごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760240
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760240,
					"content": "どうりで君たち、さっきからベテランハンターのオーラを発してると思ってたんだよな。やっぱりオレの目に狂いはなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760241
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760241,
					"content": "当たり前だろ。オイラたち、いろんな修羅場をくぐってきたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760242,
					"content": "「ゲーターキング」、それに二匹の猛獣…「子さらいリシュボラン虎のラージャ」と、「璃月に通ずる山道を塞ぐ巨大駄獣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760243
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760243,
					"content": "「リシュボラン虎のラージャ」は西のジャングルにいるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760244
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760244,
					"content": "「駄獣大王」は噂によると巨大な駄獣らしい。こいつに驚かされた目撃者の証言によれば、やつらは東の某エリアを徘徊していて、通りかかった人を襲うんだとさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760245
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760245,
					"content": "それ、めちゃくちゃ危険そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760246,
					"content": "そうさ。もし出遭ってしまった時は、十分注意しろよ…ははっ、まあ「ゲーターキング」まで退治した君たちには、余計なお世話だったか。アハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760247
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760247,
					"content": "道で危険生物に出くわしたら、オレの代わりに駆除しといてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760248
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760248,
					"content": "そしたら近所の人たちも、危険な目に遭わなくてすむ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760249
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760249,
					"content": "うん、もし出くわしたらね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760250
					]
				},
				{
					"id": 730760250,
					"content": "恩に着るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760251
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760251,
					"content": "近隣住民の安全、危険生物の安全、それにもちろん、君たち自身の安全にも注意してくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760252
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760252,
					"content": "おう、わかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730760237,
					"content": "噂は大げさなとこもあるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760238
					]
				},
				{
					"id": 730760238,
					"content": "そ、そうなのか…何だかちょっとガッカリ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760239
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760239,
					"content": "でも、普通のサイズですらワニ退治は大変なのに、成長期が更に長い上、ずっと狡猾な「ゲーターキング」なんて危なすぎるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760240
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760222,
					"content": "#それなら{M#俺}{F#私}たちが何とかしなきゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760223
					]
				}
			]
		},
