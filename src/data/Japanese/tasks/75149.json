			"dialogs": [
				{
					"id": 751491101,
					"content": "キュ…キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491102,
					"content": "どうしたんだ？なんだか辛そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491103,
					"content": "ウルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491104,
					"content": "あれって…アビスなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491105,
					"content": "「その通りだ…アビスの魔物は、病のように聖都トゥランを蝕んでいる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491106
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491106,
					"content": "「このように酷い有様では、今更一つ一つ駆除してもキリがない。トゥラン聖山を丸ごと破壊する以外、奴らを止めるすべはないのかもしれぬ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491107
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491107,
					"content": "アビスの魔物を一体見たら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491108
					]
				},
				{
					"id": 751491108,
					"content": "「家中侵されていると思え…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491109
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491109,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491110,
					"content": "や、やめろよ、そんな恐ろしい話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491111,
					"content": "足を切り落とせば止められるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491112
					]
				},
				{
					"id": 751491112,
					"content": "なるほど、ならばあとはあいつらの足がどこにあるか探すだけだ！…とでも言うと思ったか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491113,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491114,
					"content": "「残念だったな、小さき者よ。アビスの魔物は足で移動しないものが大半だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491115
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491115,
					"content": "「…道を阻む『影に潜みし敵』を排除できぬ限り、聖山の心へ辿り着くことはできぬ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491116
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491116,
					"content": "「この破壊された町を元に戻すことはできぬが、少なくとも漆黒の魔物を居座らせることだけは避けねばならぬ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491117
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491117,
					"content": "待って、大きな炎の玉があるんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491118
					]
				},
				{
					"id": 751491118,
					"content": "そうだぞ！炎の玉は元々アビスと戦うために作られたものなんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491119,
					"content": "「大きな炎の玉…『擬似群星』のことか？あれは最初にアビスと接触した際に、共倒れを狙うことしかできぬ。失敗すれば、逆にアビスに侵蝕されてしまう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491120
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491120,
					"content": "「惜しいことに、この街は長い間封印されていた…街を安定させるためにも、『擬似群星』を動かすことはできない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491121
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491121,
					"content": "「龍に選ばれし者よ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491122
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491122,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491123,
					"content": "「聖山の心はトゥラン建国後に掘り起こされた一帯だ…そして原初なる『秘源の龍像』に守られている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491124
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491124,
					"content": "「聖山の心に入るには、許可がいる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491125
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491125,
					"content": "「ただ、あの秘源の龍像のエネルギーも侵蝕を受けている。何とか再起動せねばならない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491126
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491126,
					"content": "「それは…」警告、機能破損、停止まであと…「おや、どうやらこの機体も…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491127
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751491127,
					"content": "お、おい！アマル、許可ってなんだよ！まだ何も話してないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491128
					],
					"speakerTitle": "パイモン"
				},
				{
