					"id": 751490912,
					"content": "「体に欠損はない」ってなんだよ。はぁ…とにかく怪我がなくてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490915,
					"content": "うーん、火口の下にこんな広い空間があったなんてな…でも、なんでこんなに真っ暗なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490916,
						751490918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490916,
					"content": "パイモン、光れ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490917
					]
				},
				{
					"id": 751490917,
					"content": "わかった、頑張るぞ…って、光なんて出せるわけないだろ！こんな何もない場所で、オイラが出せるのは「怒り」くらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490920,
					"content": "とりあえず周りを探索してみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490921,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490918,
					"content": "パイモン、松明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490919
					]
				},
				{
					"id": 751490919,
					"content": "そんなに当たり前みたいに言われても、ないものはないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490913,
					"content": "ちょっと出て来ちゃった…「魂」が。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490914
					]
				},
				{
					"id": 751490914,
					"content": "冗談言う余裕があるなら、元気ってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "パイモン"
				}
			]
		},
