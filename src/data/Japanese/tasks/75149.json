			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「エカトル」",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490201,
					"content": "「先に言っておくが、ここは初めからこのように暗かったわけではない…確かに火山の『内部』であることに間違いはないが…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490202
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490202,
					"content": "「あの戦争が終わった後、街は破壊し尽くされた。したがって、大型機構の全機能を停止せざるを得なくなったのだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490203
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490203,
					"content": "戦争？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490204,
					"content": "「そうだ。残された龍の血族と人類の戦争であり、最初の炎を司る主が命を失った戦争でもある…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490205
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490205,
					"content": "「主を亡くしても、この都市だけは残った…いや、この都市も実は、遥か昔からすでに死んでいたのかもしれぬ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490206
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490206,
					"content": "「…かつて存在していた多くのものたちは、みなただの幻に過ぎなかったのかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490207
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490207,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490208,
					"content": "「お互い必要なものを手に入れるだけだ。小さき者よ——お前はここに来る必要があり、私はお前の力を借りて問題を解決する必要がある…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490209
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490209,
					"content": "「そしてお前たちは聖山の心を手に入れる必要がある…しかし残念ながら、かつての戦争で聖山の力は封印されてしまったのだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490210
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490210,
					"content": "「その封印の力は、私から見れば幼子を縛るか細き糸に過ぎぬ。しかし、誓約によれば、それを解くことができるのは『人間』だけ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490211
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490211,
					"content": "「面白いことに、この方法で聖山に侵入した哀れな子供達は、皆ほぼ同じ末路を辿った。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490212
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490212,
					"content": "「ははっ、いつも同じことの繰り返しだ…暴君の追随者どもが英雄に追い出され、長い放浪の末、その子孫がまた別の国の暴君を引きずり下ろす…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490213
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490213,
					"content": "「この世はまるで、人の手によって作りあげられた演劇だ。入り乱れる因果と恩讐が、交互に支離滅裂な歴史の舞台へと上がる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490214
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490214,
					"content": "「話が逸れたな…さあ、起動してくれ。この死に瀕した都市に、もう一度もがく機会を与えてくれ。今、この世でこれを起動する資格を持つのはお前だけだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「エカトル」"
				}
			]
		},
