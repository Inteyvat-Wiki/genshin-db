			"dialogs": [
				{
					"id": 751491001,
					"content": "#おっ、{REALNAME[ID(2)|SHOWHOST(true)]}、どうしたんだ？何か見つけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491002,
					"content": "グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491003
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491003,
					"content": "あっ、この彫像、前にクク竜に持ってかれた彫像だ。一緒に落ちてきたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491004,
					"content": "#なんか、丸くて…おっきな耳の{REALNAME[ID(2)|SHOWHOST(true)]}に見えるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491005,
					"content": "ガゥ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491006
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491006,
					"content": "えっ、似てないか？似てると思ったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491007,
					"content": "あ…動き出したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491008,
					"content": "ガ…ガガ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491009
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491009,
					"content": "セルフスキャン…関節部に少量の埃を確認…記憶媒体アクティブ化、言語…リモート抽出…介入許可…ガガ…性格モジュールを修正します…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491010
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491010,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491011
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491011,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491012
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491012,
					"content": "彫像じゃなくて、機械だったのか…よく見ると、確かに秘源装置に似てるな。それに、体の周りに漂ってる変な光、どっかで見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491013,
					"content": "あれっ、どうしたんだ？なんか動かなくなっちゃったぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491014,
					"content": "「わあっ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491015
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491015,
					"content": "うわーっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491016,
					"content": "「発声モジュールに問題はなさそうだな。さて、客人たちよ、私はお前たちをここでずっと待っていた…どうかしたか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491017
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491017,
					"content": "いきなり大声を出すなよ、びっくりするだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491018,
					"content": "「それはよかった。こういう登場のほうが印象に残る。でなければ、お前たちに無視されてしまうかもしれぬからな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491019
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491019,
					"content": "えっと、おまえは誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751491020,
					"content": "「私か？ああ——この体の名はエカトル。私のこともそう呼んでくれて構わないが、名はこの地で大した意味をなさぬ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491021
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491021,
					"content": "個体識別のための呼び名、変更申請は…記録により…あの戦争から百五十年後…名前を、戦死者リスト——エカトルに変更…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491022
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491022,
					"content": "「そうだ。あれ以来、私はエカトルと呼ばれるようになった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491023
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491023,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491024
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491024,
					"content": "「そうだ、私がお前を呼び寄せたのだ。さあ、聖山の心へ向かうのだ…手遅れになる前に。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491025
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751491025,
					"content": "「だがまだ焦る必要はない。まずはこのエカトルが目の前の闇を切り開こう…まだ疑問が残っているのは承知している。だがまずはついてきてくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「エカトル」"
				}
			]
		},
