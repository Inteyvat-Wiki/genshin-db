				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "「そういえば、まだ紹介してなかったな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490302,
					"content": "「だが気にするな。ようこそ、始まりの聖都ト{RUBY#[D]源火の地}ゥランへ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490303,
					"content": "うわぁ、火山の中ってこんな感じだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490304,
					"content": "ここって本当に火山の中なのか？オイラたちが火山に入った時、別の場所に転送されたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490305,
					"content": "グル…グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "「ここは紛れもなく聖山の中だ。しかし…この私でさえ、前にこの光景を見たのがいつだったかは覚えてはおらぬ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490307,
					"content": "「ああ…光に再び照らされて初めて分かった…これほどにも朽ち果てていたとは…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490308,
					"content": "エカトル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490310,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "「すまない。不必要な感傷に浸ってしまった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490312,
					"content": "媒体のエネルギーが低下しています…間もなくスリープモードに入ります…媒体を交換あるいは再接続してください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490313,
					"content": "「ははっ、放浪のエカトルも、もう長くはもたないらしい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490314,
					"content": "ええっ、エカトル…し、死んじゃうのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490315,
					"content": "「エカトルという名の者は、とっくの昔に亡くなっている…手短に話そう。トゥランの再起動には多くのエネルギーが必要だ。無駄にはできぬ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490316,
					"content": "「他の二つの『擬似{RUBY#[D]ツィツィミトル}群星』、そのうち一つの封印を解き…もう一つの…するのだ。さもなくば、中央の天軸は解放できぬ」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490317,
					"content": "「うっ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490318,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "…「大丈夫だ、また…いつか…会える…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490320,
					"content": "「はぁ…進め、龍に選ばれし者よ…ああ、肉体が生気を失う苦痛は、何年経っても…慣れぬな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490321,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "「エカトル」"
				},
				{
					"id": 751490323,
					"content": "纏ってた光が消えた…うぅ、エカトルが動かなくなっちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490324,
					"content": "やっぱり、オイラまだよく分かってないんだけど、あの声はエカトルだったのか？それとも他の誰かの声だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490325,
					"content": "いつか分かるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "そうだよな。さっき言ってた「擬似群星」って、もしかしてあの大きな炎の玉のことか？でも、じゃあ天軸は？なんなのかさっぱりわかんないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490328,
					"content": "うーん、とりあえずいろいろ回って、あいつの言ってたヘンテコなものを探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751490329,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "今はとりあえず進もう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
		},
