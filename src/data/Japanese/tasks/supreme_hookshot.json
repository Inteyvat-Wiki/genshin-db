					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "今日の直感によるとだな…うん、ザイトゥン桃にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310203,
					"content": "別段珍しいものでもないが、あれを釣り餌に使おうという者は滅多にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310204,
					"content": "悪いが、探してきてくれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カイヴァン"
				}
			]
