					"カイヴァン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "よぉ、その様子…旅人だな？こんなところでぶらぶらしてるとは、なかなか趣をわかってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310102,
					"content": "それとも君も釣り人で、ここの水場が気に入ったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310103,
					"content": "もしそうならお目が高い！いま君がいるのは、この辺りで一番の釣り場だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310104,
					"content": "そうなのか？でも、この近くで釣りをしてる人なんて見なかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230310105,
					"content": "それはもちろん、俺ならではの着眼点によるものだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310106,
					"content": "ここらで最も恐るべき漁師として、釣り場の選び方にもこだわりがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310107,
					"content": "ほ…本当なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "なんの収穫もないみたいだけど…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230310109,
					"content": "そこまで言うなら、かの「釣り針にある絶景」を見せてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310110,
					"content": "釣り針にある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "特別な材料を俺に渡してくれれば、釣り餌を作る。それを使って君の見たこともない「魚」を釣ってみせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310113,
					"content": "なんだか怪しいけど…手作りの釣り餌なんかで本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230310114,
					"content": "試してみてもいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "話が速いな！君みたいなやつは大好きだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310116,
					"content": "俺の釣り餌はベースとなる夕暮れの実と小麦以外に、霊性を注ぎ込むための材料が必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310111,
					"content": "絶景？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
