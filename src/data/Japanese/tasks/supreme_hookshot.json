			"dialogs": [
				{
					"id": 230310601,
					"content": "よし、材料がそろったぞ。唯一無二の釣り餌を作ってご覧に入れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310602,
					"content": "カイヴァンは慣れた手つきで釣り餌を作った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "さあ、釣りを始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310604,
					"content": "釣り針の沈む深さ、合格…水流の速さ、適切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310605,
					"content": "静かにしてろよ、水中の魚は敏感だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310606,
					"content": "岸辺の足音すら彼らを刺激するからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310607,
					"content": "#{M#俺}{F#私}は立ちっぱなし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "なら、安心して待つといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310610,
					"content": "カイヴァンがびしょびしょになった袋を釣り上げた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "なんだ、魚…じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230310612,
					"content": "確かに、こんな「魚」は見たことない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "やっぱりこうなったか…何も意外じゃないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310614,
					"content": "コホン…異郷人よ、心を広く持て。細かいところを一々気にするもんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310615,
					"content": "釣り針が水面から引き上げたのなら、それがなんであれ「魚」が釣れたとみなすんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310616,
					"content": "実を言うと、最も恐るべき漁師という二つ名は自称じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310617,
					"content": "何しろ、毎度こんな餌を食べない…というか、生き物でもないものを釣り上げられるんだからな。それはそれですごいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310618,
					"content": "ほかの漁師も俺を褒めてたぞ、唯一無二の才があるってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310619,
					"content": "慰めてるんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "ようするに、魚以外ならなんでも釣れるってことか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230310622,
					"content": "コホン！彼らがどう思っていようと、俺には関係ない。少なくとも…俺の釣り針は、必ず何かを釣り上げるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310623,
					"content": "今日がダメなら、また明日やればいい。いずれ、本当の意味で魚を釣り上げる日がくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310624,
					"content": "材料を探してくれてありがとう、これが報酬だ。俺は場所を変えて、引き続き釣りをするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310625,
					"content": "今度こそ…今度こそ、必ず大きな魚を釣ってやる！絶対にだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カイヴァン"
				},
				{
					"id": 230310620,
					"content": "皮肉では…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "パイモンは浮いてるから平気。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
