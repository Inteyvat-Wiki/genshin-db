		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "「…『刺明』の技を修練する。はからずも木の人形をすべて壊し…修繕の金もなく…良策が浮かぶ…藁を束ね人形にすればいい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080302,
					"content": "「藁を手に入れる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080303,
					"content": "「藁を束ねる。疲労甚だし。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080304,
					"content": "「…『刺明』の技を修練する。はからずも藁の人形をすべて壊す…やはり、まずは剣を習得しよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080305,
					"content": "続けて読む。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "「…閑につき、庭の雨を眺め、僅かに空腹を覚える…昨日の記憶をたどるうち、ふと悟る。剣を…（塗りつぶされている）これを『裁雨』と名付ける。後日、試そう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080308,
					"content": "「…裁雨の技の修練中、はからずも落下する。幸い怪我は軽く…そこで良策が浮かぶ。地面を掘り、杭の下に池を作れば、落ちても怪我を免れ、餌となる魚も養える…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080309,
					"content": "「…漁師に出会った際に、数十の魚を買った…これを調理すると、肥えており甚だ美味。これに匹敵する魚なし…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080310,
					"content": "（次の十数ページには、魚のさまざまな調理方法が詳細に記載され、挿絵が付いたものまである。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080311,
					"content": "「…裁雨の技の修練中、はからずも落下する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080312,
					"content": "「…習得。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080313,
					"content": "続けて読む。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "「…槍剣を使うこと（塗りつぶされている。横に三代目宗主の注釈あり：…使うこと指のごとし）…その至る所、すなわち正しき道理の形…しかし相手はこれを持たず…何を与え、何を告げよう？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080316,
					"content": "「…蔵書閣の改修。…を設け、…を待つ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080317,
					"content": "「…<color=#00E1FFFF>目</color>で観察し、<color=#00E1FFFF>四方の巻</color>を<color=#00E1FFFF>四方の閣</color>に合わせれば…できる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080318,
					"content": "（以降の数ページは塗りつぶされて読むことができない。横に三代目宗主の注釈あり：ここは後世の者に四方の書巻に目を通すよう奨励している。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080319,
					"content": "続けて読む。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "「…傷が癒える。白小三が羊料理を作って来訪。脂がのりて美味。その術を問う…相勝の技を伝授…よって、ここに記す。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080322,
					"content": "（以降の数ページは羊肉のさまざまな調理方法が詳しく書かれている。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "『古華手記』"
				},
				{
					"id": 711080320,
					"content": "もう読まない。ひどく塗りつぶされてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "もう読まない。修練の過程がまったくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "読むのをやめる。意味が分からなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
