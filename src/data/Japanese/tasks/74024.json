				},
				{
					"id": 740240704,
					"content": "無理だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "でも、スルアシーはすごく楽しそうにしてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240708,
					"content": "何はともあれ、心から感謝するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240709,
					"content": "お礼に、どうかこれを受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240710,
					"content": "キ、キラキラ光る宝石！金具まであるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240711,
					"content": "あはは、気に入ってもらえて何よりだよ。今後、もし何かほしいアクセサリーがあったら、いつでも私のところに来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240706,
					"content": "可能性がないわけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "まあ、マメールが使ってた絵の具だってかなり変だったしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "パイモン"
				}
