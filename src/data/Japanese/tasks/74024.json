			"dialogs": [
				{
					"id": 740240315,
					"content": "スルアシーは丁寧に材料を観察した後、返してくれた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240301
					]
				},
				{
					"id": 740240301,
					"content": "いずれにせよ、手伝ってくれて本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240302,
					"content": "#でも{NICKNAME}さま、あなたのものを勝手にもらうなんてできない。材料の名前さえ教えてくれれば、後は自分で探すから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240303,
					"content": "けど、この色って濃すぎないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240304,
					"content": "「太陽の色」って、もうちょっと薄い気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240305,
					"content": "薄いってことは、つまり白いってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240306,
					"content": "そういえば…たしかに太陽の色って、「金色」よりは「白」に近い気がするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240307,
					"content": "「白」か…でも、一体どんな材料を使えば、もっと薄い色を出せるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240308,
					"content": "水を混ぜたらダメ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "水を混ぜるのは…前にも試したことがあるけど、あまり理想的な仕上がりじゃなかったんだ。出来上がった絵の具はどんよりしてて、太陽のように明るい感じがしなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240310,
					"content": "だから可能なら、他の材料を使いたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240314,
					"content": "でも明るくて、白いものなら、普段からよく見てるはずだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240311,
					"content": "なんなら、パイモンの髪の毛で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "髪の毛じゃ絵の具は作れないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240313,
					"content": "いやいや、たとえ作れたとしても、勝手にオイラの髪の毛を抜いちゃダメだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "パイモン"
				}
			]
		},
