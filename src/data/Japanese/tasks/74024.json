					{
						"sceneId": 3,
						"position": [
							2408.11,
							252.736,
							4985.173
						],
						"pointId": 340300092
					},
					{
						"sceneId": 3,
						"position": [
							2408.264,
							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "ん？ここで一人でなにしてんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240102,
					"content": "うわっ！急に後ろから話しかけてこないでよ。研磨した粉を落とすところだったじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240103,
					"content": "粉？うーん、なんの粉だ、それ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240104,
					"content": "宝石だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240105,
					"content": "ほ、宝石？なんでここに宝石があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240106,
					"content": "宝石がないほうがおかしいでしょ？だって、ここは私が宝石を処理する工房なんだから。まだ正式な工房の名前はないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240107,
					"content": "ストレートに「スルアシー工房」とかにしようとも思ったけど、自分の名前を入れるのもどうかなって気がしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240108,
					"content": "宝石の処理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "つまり、宝石をいろいろな可愛いアクセサリーに変えたり…とかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240110,
					"content": "でも、当面の間は新しい依頼を受けることは無理なんだ。絵の具の製作に集中しないといけないから…まあ、宝石を使うことに変わりはないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240111,
					"content": "ほ、宝石で絵の具を作るのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240112,
					"content": "そうだけど、何か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240113,
					"content": "うぅ、なんだかすごく勿体ない気がするぞ…宝石がいらないなら、オイラにくれたらいいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240114,
					"content": "ところで、なんで絵の具を作ってるんだ？宝石でアクセサリーを作るのに、そんな工程は必要ないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240115,
					"content": "以前、絵を描くのが好きな子に言われたことがあるんだ。宝石のようにキラキラしてて、太陽のように光り輝く絵の具を作れないか、ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240116,
					"content": "そして先日、村が激しく揺れた時、彼女が私の妹を助けてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240117,
					"content": "だから、彼女の願いを叶えてあげたいと思ったんだ。「太陽のように光り輝く絵の具」を作って、彼女へのお礼にしたいと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240118,
					"content": "その子はもしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "…その、おまえの言う「絵を描くのが好きな子」って、もしかしてマメールっていう名前か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240120,
					"content": "…ん？そうだけど…あなたたちも知ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240121,
					"content": "この前、マメールと一緒に経験したことをスルアシーに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#も、もしかして…あなたはマメールと一緒にプーカを助けてくれた{NICKNAME}さまとパイモンさまなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240123,
					"content": "さ、さま…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240124,
					"content": "#この{M#俺}{F#私}がそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "本当にありがとう…！もし二人がいなかったら、恐らくプーカは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240127,
					"content": "もしよかったら、どうかこれを受け取って…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240128,
					"content": "（すごくきれいな宝石…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#{NICKNAME}、受け取ってもいいのかな？すごく高そうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240131,
					"content": "でも、あのマメールが他の人に頼みごとするなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240132,
					"content": "頼みごとっていうか、私に作れるかどうか聞いただけなんだ。でも、私が返事するよりも早く、あの子は逃げちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240133,
					"content": "まあ、たしかにマメールらしい行動だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240134,
					"content": "#ところで、{NICKNAME}さま、パイモンさま…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240135,
					"content": "二人にとって、「太陽の色に一番近いもの」って何かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240136,
					"content": "私も一生懸命太陽を観察してみたんだけど、その色を再現するためにどんな材料を使うべきか、よく分からなくってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240137,
					"content": "えーっと、「太陽の色に近いもの」か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240138,
					"content": "…黄金？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "ああ、カノティラも言ってたことがある。「黄金は太陽が流した涙」だとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240140,
					"content": "でも、黄金を絵の具に使うのは贅沢すぎないか？もっと普通の材料があると思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240148,
					"content": "とにかく、「太陽の色に近いもの」ならオイラたち見たことがあるはずだ。しかも、すごく身近なものかもしれないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240141,
					"content": "…太陽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "…なるほど、さすがだね。太陽の色に一番近いものは、確かに太陽そのものだもんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240143,
					"content": "でも、太陽を粉にするにはどうしたらいいんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240144,
					"content": "おい、したり顔でデタラメ言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240145,
					"content": "#なんなら、{M#俺}{F#私}の髪の毛で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240147,
					"content": "おい、どう考えても髪の毛で絵の具を作れるわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240130,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "「さま」とまでは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
