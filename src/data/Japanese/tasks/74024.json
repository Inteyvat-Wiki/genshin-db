			"dialogs": [
				{
					"id": 740240516,
					"content": "スルアシーは丁寧に材料を観察した後、返してくれた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "なるほど。この色があなたの言う「白」って色だね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240502,
					"content": "なんだか「太陽の色」とは正反対のような…もしかしたら「この正反対の色」を使ったら、もっといい感じになるのかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240503,
					"content": "「正反対の色」って…黒のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240504,
					"content": "「黒」…そう、「黒」で間違いない。さすがパイモンさま。太陽の色って、まさに「黒」のはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240505,
					"content": "なんか変な流れに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "でも、なんで黒だと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240509,
					"content": "太陽は金色だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "最後に、二人にもう一つお願いしてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240513,
					"content": "「黒」色のものを一つだけ持ってきてほしい。そしたら、「太陽のように光り輝く色」を作るのに、どんな材料を使うべきか分かる気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "スルアシー"
				},
				{
					"id": 740240514,
					"content": "ホントに探すのか？もはや太陽となんの関係もなくなってきてる気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240515,
					"content": "#でも、あいつに頼まれたことだし…{NICKNAME}、あいつのために「黒色のもの」を見つけてやろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240510,
					"content": "夜の太陽なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "夜の太陽だって黒じゃないだろ！——っていうか、夜に太陽が昇るわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740240506,
					"content": "さすがパイモンさま！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "おまえ、ヘンに便乗するなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "パイモン"
				}
			]
		},
