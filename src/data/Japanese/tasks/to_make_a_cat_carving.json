			"dialogs": [
				{
					"id": 220430301,
					"content": "ああ、これで足りるだろう。悪いな、せっかく神社に来たのに、手伝わせてしまって…これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430302,
					"content": "俺の木彫りの技術が上がってきたら、必ず君にも最高の木彫りを送ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430303,
					"content": "ふむ、どんな代理宮司様の木彫りを作ろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
