					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "木を使い果たしてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430102,
					"content": "おっ！旅人、ちょうどいい時に来たな。一つ手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "最近、代理宮司様の形をした小さな木彫りを作ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430106,
					"content": "それらの木彫りが完成したら、鳴神島に持っていって売ろうと思ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430107,
					"content": "もしかしたら、安定した収入にできるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430108,
					"content": "たぶん売れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "はははっ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430110,
					"content": "俺も代理宮司様の魅力には自信があるんだ。へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430118,
					"content": "まあ…雑談はここまでにして、本題に入ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430119,
					"content": "実は、最近練習に使ってた木彫りの木材が足りなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430120,
					"content": "旅人、悪いが「御伽材」という木材を10個集めてきてくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430121,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "ありがとう、旅人。本当に助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430126,
					"content": "御伽材を手に入れたら、俺のところに持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430123,
					"content": "そんなに必要なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "何せ練習を始めたばかりだからな…材料が多ければ多いほどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430125,
					"content": "じゃあ頼んだよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430111,
					"content": "どうして急に木彫りを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "それは…その、代理宮司様が俺にくれた「報酬」のことは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430113,
					"content": "ぜんぶ…瓶とか缶とかだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430114,
					"content": "見た目は古いが、鑑定してもらったところ、けっこう貴重で金になるものだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430115,
					"content": "だが、それらの物を金に換える過程は、本当に疲れるものだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430116,
					"content": "それに、こういう収入は不安定だ…代理宮司様がそれを俺にくれなくなったら、また失業したも同然じゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430117,
					"content": "だから、新たな商売の道を開拓していこうと考えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220430104,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
