			"dialogs": [
				{
					"id": 200280101,
					"content": "#ありがとう、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280102,
					"content": "僕は狩人だけど…スライムは無理なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280103,
					"content": "こいつらのせいで、また獲物を逃したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280104,
					"content": "他の狩人が僕と同じような目にあっていないといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280105,
					"content": "そうだ、この周辺を見てきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280106,
					"content": "気のせいか分からないけど、なんだか近頃…スライムが増えてきたような気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280107,
					"content": "もしスライムを発見したら、倒してほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "では頼むよ。僕も帰ったらドゥラフさんに報告するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280111,
					"content": "まだ酔っぱらってないといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 200280109,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "でも今この件を解決できる人は君だけだよ。清泉町のために、頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "臆病なモロー"
				}
