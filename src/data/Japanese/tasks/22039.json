			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "このままですと、商売を長く続けられませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "失礼しました。考え事でぼんやりしていました。あなたは着物を買いに来たのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390104,
					"content": "璃月の高級絹織物の在庫切れは続いていますが、新作の着物は揃っていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390105,
					"content": "璃月から仕入れていたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "はい、以前は「飛雲商会」の霓裳花を使った絹など、璃月の高級絹織物を仕入れていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390107,
					"content": "しかし、稲妻がこのような状況になってしまったため…ここ暫く仕入れることが出来ずにいます。今も、これまでの在庫を頼りにして、何とか商売を続けています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390108,
					"content": "店の絹織物は、ますます少なくなってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390109,
					"content": "元々は、自分で新しい柄を考案したり、もしくは新しい染料を使って斬新な着物を作ったりして、お客様を集めようとしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390110,
					"content": "しかし、「斬新」と言えるような染料は見つかりませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390111,
					"content": "旅人、世界中を旅して、見識が広いあなたにお聞きしたいです。「斬新」と言えるような染料を見たことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390112,
					"content": "たくさん見てきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "ほ、本当ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390114,
					"content": "できれば、斬新な染料を作れるような素材を私に見せてもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390115,
					"content": "報酬はちゃんと用意しますので、お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390116,
					"content": "染料だけでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "今の状況を考えると、染料くらいしか突破口が思い付きません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 220390118,
					"content": "「斬新」な染料にできる素材をご存じでしたら、持ってきてください。お礼はちゃんとします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小倉澪"
				}
			]
		},
