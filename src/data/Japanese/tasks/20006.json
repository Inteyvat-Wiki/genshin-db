			"dialogs": [
				{
					"id": 200060101,
					"content": "出前オーダー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060102,
					"content": "鹿狩りへようこそ…旅人？ちょうどよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060103,
					"content": "ごめんなさい、お腹がすいてるのは分かってますけど、少し手伝ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060104,
					"content": "清泉町のオーリンさんが<color=#00E1FFFF>ニンジンとお肉のハニーソテー</color>を注文したんですが、清泉町は最近スライムが出没するって聞いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060105,
					"content": "私じゃ行けないから…この料理を<color=#00E1FFFF>清泉町のオーリン</color>さんに届けてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060106,
					"content": "いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "戻ってきたら、お礼にごちそうしますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060109,
					"content": "お願いです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				},
				{
					"id": 200060107,
					"content": "お腹空いた、食事しに来ただけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "このお願いを聞いてくれたら、鹿狩りのスペシャルコースをご馳走しますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				}
			]
		},
