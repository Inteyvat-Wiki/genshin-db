			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "ありがとう、嫌なスライムだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "元気なオーリン"
				},
				{
					"id": 200060202,
					"content": "お腹が空いて力が出ない…そうでなければ、こんなやつら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "元気なオーリン"
				},
				{
					"id": 200060203,
					"content": "注文した料理を届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "うう…ニンジンとお肉の香りだ…もうちょっと早く食べていれば、スライムなんて吹っ飛ばせたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "元気なオーリン"
				},
				{
					"id": 200060205,
					"content": "まあ、いいや。はい、代金をサラさんに渡して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元気なオーリン"
				}
			]
		},
