				"points": []
			},
			"dialogs": [
				{
					"id": 722420401,
					"content": "まさか、海祇島の下にこんな巨大な空間があったなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420402,
					"content": "どうやら、オイラたちが目指すべき場所はあの真ん中のとこっぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420403,
					"content": "#よし、{NICKNAME}、慎重に進んでいこうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420404,
					"content": "近くに廃墟があるみたいだぞ。まずはそこから探索を始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420405,
					"content": "建物があるってことは、むかし人がいた証拠だ。人がいたんなら、なにかヒントになるようなことを書いた紙が残されてるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420406,
					"content": "まあ、そういう紙がたくさん残された場所のヒントって、たいてい意味がわからないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
