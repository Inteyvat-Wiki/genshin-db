			"dialogs": [
				{
					"id": 722420201,
					"content": "この扉に刻まれた五つの文字、これが「鍵紋」のパターンみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722420202,
					"content": "周りを見てみよう。今までの経験からして、またなにかやらないとダメっぽいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
