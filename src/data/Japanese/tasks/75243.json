			"dialogs": [
				{
					"id": 752430101,
					"content": "ああ！お客さん、ファデュイどもを追い払ってくれてありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752430102,
					"content": "あいつら、どこからともなく現れたかと思ったら、無言で私のポケットに手を伸ばしてきたんです！まるっきり強盗ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752430103,
					"content": "止めてくれたおかげで泣き寝入りせずに済みました…これはお礼です、どうか受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752430104,
					"content": "あっ、ご紹介が遅れましたが、ここはお日様きらきらモコモコ駄獣園です。おとなしいモコモコ駄獣が見られるほか、おもちゃもたくさん販売しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752430105,
					"content": "でもさっきの連中のせいでスタッフやお客さんたちが驚いて逃げてしまったから、急いで後始末に行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752430106,
					"content": "モコモコ駄獣園の見学をご希望でしたら、また明日いらしてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アロハ"
				}
			]
		},
