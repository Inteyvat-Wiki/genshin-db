			"dialogs": [
				{
					"id": 706900301,
					"content": "ん？もう全部の本を整理し終わったの？思ってたよりも早かったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900302,
					"content": "可愛い子ちゃんは、何か欲しいものある？あなたたちのおかげで、午後の時間が丸々空いたんだし、一緒に過ごすのもいいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900303,
					"content": "報酬について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "大丈夫、報酬はちゃんと渡すから安心して。でも、他にも気になっていることがあるんじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900306,
					"content": "あなたたちも気づいたでしょう？今回の本、名前から内容までどれも変わっているのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900307,
					"content": "それに、ここは北の大陸最大の図書館なのよ？聞いたこともない新しい本がこんなに届くなんて、本来ありえないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900308,
					"content": "考えられるとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900309,
					"content": "実はさっき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900310,
					"content": "ふふっ、どうやらお姉さんが知りたくない面倒ごとみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900311,
					"content": "とはいえ、もうこの世界に存在している書籍なんだし、図書館で保管する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900312,
					"content": "ここに置いておくほうが、外に流れて変な人の手に渡るよりずっといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900313,
					"content": "それじゃあ、これが報酬ね。今回もお疲れ様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900305,
					"content": "ここにある本について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
