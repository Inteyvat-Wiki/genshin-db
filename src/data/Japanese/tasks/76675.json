			"dialogs": [
				{
					"id": 766750901,
					"content": "あっ！大団長と栄誉騎士が帰ってきた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "ヴィンフリート"
				},
				{
					"id": 766750902,
					"content": "みんな、二人が戻ったぞ——さあ、出迎えだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "エックベルト"
				},
				{
					"id": 766750903,
					"content": "うわっ、こんなに歓迎してもらえるなんて…なんだか照れるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766750904,
					"content": "——数百メートル離れていても分かった！蒲公英酒の香りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "ライフヘルム"
				},
				{
					"id": 766750905,
					"content": "それも、アカツキワイナリーの特製品！ああ…懐かしい記憶が…蘇ってきた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "ヴィンフリート"
				},
				{
					"id": 766750906,
					"content": "えっと…つまり、オイラたちを出迎えたわけじゃないんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766750907,
					"content": "うん…まさに記憶にある通りの香りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "エックベルト"
				},
				{
					"id": 766750908,
					"content": "そうだな。モンドを離れて、もう何年も経つのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "ライフヘルム"
				},
				{
					"id": 766750909,
					"content": "アカツキワイナリーの酒がどんな香りだったか、忘れちまったかと思ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "ヴィンフリート"
				},
				{
					"id": 766750910,
					"content": "酒の香りは変わってない…だったら、故郷の清泉町も、きっと変わってないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "エックベルト"
				},
				{
					"id": 766750911,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "よかった。ありがとうございます、栄誉騎士さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "エックベルト"
				},
				{
					"id": 766750914,
					"content": "…おいおい、そう興奮するな。まだ戻ってきてないやつもいるだろ？全員揃ってから開ける。お前たちは先に宴の準備をしといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766750915,
					"content": "了解です！すぐに取り掛かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "ヴィンフリート"
				},
				{
					"id": 766750916,
					"content": "…なっ、言っただろ？酒を飲むことは、何よりもまっとうなことだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766750917,
					"content": "ふう…ニンジンとお肉のハニーソテーに…鳥肉のスイートフラワー漬け焼き…まさか、こんなにちゃんとしたモンドの料理をここで食べられるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766750918,
					"content": "そういえばファルカは？いないみたいだけど…どっかで酔っぱらってるとかじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766750919,
					"content": "そんな簡単に酔うはずない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "よし…あと一皿食べたら、オイラも探しに行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766750920,
					"content": "探してくるから、パイモンは食べてて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "うん、この目で見てきたから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
