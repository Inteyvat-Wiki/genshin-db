						766750503
					]
				},
				{
					"id": 766750503,
					"content": "よし、諦めるな。もう一回だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766750504,
					"content": "おしゃべりしたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "以前ノエルを指導した時、あいつは緊張で樽をめちゃくちゃに破壊しちまってな…その後は何も言わず、一人で黙々と掃除をしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766750506,
					"content": "そして時が経ち…あいつの掃除の腕は、騎士団随一のものになった。本人は気づいてないだろうが、これも一種の「進歩」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				}
			]
		},
