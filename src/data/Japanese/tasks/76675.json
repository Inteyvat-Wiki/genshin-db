							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "みんなに酒を持って来てくれた「主役」が、こんな所に何か用か?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751002,
					"content": "それはこちらのセリフ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "ん…実は俺の杯に入ってるのは「特製品」の中の「特製品」でな。一人でしか味わえない代物なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751005,
					"content": "——だが、見つかっちまったからには仕方ない。一杯分けてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751006,
					"content": "…やっぱりそうだと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "悪いな、特製品ってのは冗談だ！今、俺の周りに酒は一滴も無い。もし飲みたけりゃ、後でエルミネの所に行ってみろ。あいつなら山ほど持ってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751009,
					"content": "酔った仲間と拠点を夜の危険から守れるよう、必ず素面の者を一人は残しておく——遠征の初期に俺が立てたルールだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751010,
					"content": "間の悪いことに、今日はちょうど俺がその「素面当番」だったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751011,
					"content": "…あいつらが酔っぱらってる時に、俺まで酔うわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751012,
					"content": "本当に今日偶然、当番だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "さあな。運命ってのは、ままならないもんだ。もし到着が一日遅れてたら、今頃は俺が下で浴びるほど飲んでたかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751015,
					"content": "だが、本当に到着が遅れてたら、お前が偶然この拠点に立ち寄ることも、俺たちの酒宴に居合わせることも、こうして話すこともなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751016,
					"content": "どんな選択がどんな結果をもたらすのか…それはその時が来るまで誰にもわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751017,
					"content": "モンドから遠征に出た時も、ここまで来ることになるとは思ってなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751018,
					"content": "遠征の目的は…ワイルドハント？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "ああ…結果的にはな。だが出発した時、俺はテイワット全土を巻き込むアビスの災厄が、北の地に迫っていることだけは「知っていた」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751020,
					"content": "時間を使って準備はしたが…敵がどこに、どんな形で現れるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751021,
					"content": "…出発時点で、それらは未知数だった。道中で情報を集めて、あらゆる事態に備えるしかなかったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751022,
					"content": "それだけの情報で遠征に出たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "ふっ、飲み込みが早いな！だが残念ながら、敵はこちらの準備が整うのを律儀に待ってはくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751025,
					"content": "俺たちが躊躇してる間にも、アビスは無数の命を奪い続ける。一刻でも早く遠征に出れば、それだけ早く運命を変えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751026,
					"content": "——「遠征」に踏み切る理由としては、それだけで十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751027,
					"content": "さすが「北風騎士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "そうかしこまるな、「栄誉騎士」！お前だって同じだろ？お前の旅は多くの人の運命を変えてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751030,
					"content": "かつてはモンドやトワリンの運命を…今はナド・クライ、遠征軍…そして俺の運命を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751031,
					"content": "こうして焚き火を囲んで歌い、美酒を飲みながら未来を語れるのも…旅人、お前がいてくれたおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751032,
					"content": "#{M#俺}{F#私}って、本当にそんなにすごいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "…ははっ、誰にもわかりゃしないさ。運命ってのはそういうもんだからな。だが生きてる限り、希望は常にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751034,
					"content": "今夜飲めない酒も、明日には飲める——あいつらが俺のために一杯残しておいてくれるさ。生きてる限り、明日には美酒と仲間が待ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751035,
					"content": "さあ、乾杯しよう！明日に！そして希望に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 766751028,
					"content": "さすが「西風騎士団」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "「情報は作戦の基盤」って言ったのに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "蒲公英酒が届くこの日に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "アップルサイダーだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "一人でお酒を飲んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
