			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ファルカ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5921.365,
							283.763,
							9726.784
						],
						"pointId": 14164
