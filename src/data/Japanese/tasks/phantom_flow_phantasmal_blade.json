			"completionStepIds": [
				7265001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265001",
							"2"
						],
						"stepId": 7265001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"渋川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726500101,
					"content": "どうも。渋川と申す、武道流派「心流」の宗主じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500102
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500102,
					"content": "外国からの旅人とお見受けする。どうじゃ、「心流」に興味はあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500103,
						726500104
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500103,
					"content": "「心流」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500106
					]
				},
				{
					"id": 726500106,
					"content": "とにかく、これはわしの独創の技。岩蔵流、喜多院流、そして外国の「西風剣術」のような武器を扱う流派と違って、「心流」を磨き、また「心流」で武芸を磨くことがこの技の奥旨じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500107
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500107,
					"content": "若いころ海外を流浪し武道を研鑽した時に、ナタの者の「拳闘術」を観察したことがある。この流派の武道は練習をする時、仮想の敵と戦うのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500108
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500108,
					"content": "「仮想の敵」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726500109,
					"content": "「空想の友達」を殴るって意味だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500110
					]
				},
				{
					"id": 726500110,
					"content": "左様。敵の行動を空想し、その空想に対して反応を取る。現地の者に「影拳斗」と呼ばれるこの練習法を、わしは高く評価しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500111
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500111,
					"content": "「心流」はこのような修行を最大限に発揮した無制限格闘流派じゃ。わしの指導があれば、どんな仮想の敵も再現できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500112
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500112,
					"content": "スライムから落武者まで、スネージナヤの異人戦士でさえ可能じゃ。心流を心得ておれば、容易にそれと戦う場面を再現して、己の腕を磨ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500113
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500113,
					"content": "因みにじゃが、史上最強の生き物は恐らく「雷晶蝶」じゃな。岩蔵流先代の永胤が以前わしの「心流」を借りて人型の雷晶蝶に挑んだことあるのじゃが、十秒も持たなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500114
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500114,
					"content": "相手だけでなく、天気と装置、「地脈異常」までも、心流を通して再現できる。これほど実用的な技術もないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500115
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500115,
					"content": "心流ってそんなにすごいのか。なら、何で渋川さんが人を探してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726500116,
					"content": "わしの心流があまりにも…現実に近すぎてのう。仮想の敵と戦う時も、傷を負ったりする弟子がおって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500128
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500128,
					"content": "「心流」が幻想した「剣」は手足を切り落とす。そして、心流が幻想した「炎銃」も身を貫く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500117
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500117,
					"content": "じゃから、だんだんと、武道に専念しない者は怖がり心流を離れた。そして、武道馬鹿どもは心流を掴んではならぬから、わしに追い出されたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500118,
						726500119
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500118,
					"content": "そんなにすごいんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500120,
					"content": "いかにも。お主、心流と何らかの縁があるようじゃが、わしの「心流」を試してみてはどうじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500121,
						726500122
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500121,
					"content": "面白い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500124
					]
				},
				{
					"id": 726500124,
					"content": "とにかく、興味が湧いたら目の前の足場を心流の「土俵」と思うが良い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500125
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500125,
					"content": "わしが、お主にぴったりの「心流戦場」を作ってやるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500126
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500126,
					"content": "但し、怪我をするでないぞ。何せ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500127
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500127,
					"content": "「心流」は残酷なものじゃから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500122,
					"content": "興味ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500123
					]
				},
				{
					"id": 726500123,
					"content": "そうか。惜しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500124
					],
					"speakerTitle": "渋川"
				},
				{
					"id": 726500119,
					"content": "そんなに怖いんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500104,
					"content": "興味ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500105
					]
				},
				{
					"id": 726500105,
					"content": "#そう言うな。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}、立っている姿といい、乱れのない息といい、長年「武」の道を歩んできたに違いないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500106
					],
					"speakerTitle": "渋川"
				}
			]
		}
	]
}