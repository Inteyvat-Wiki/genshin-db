				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "オイラたちにここから飛び降りろとか言わないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430102,
					"content": "どうだろうね、キミたちにもっといい方法があればやめるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430103,
					"content": "ないとまずいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "どんな方法でも構わないから、下の湖の向こう岸に辿り着けば、実験完了だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430106,
					"content": "かかった時間と最高速度をもとに、分析と比較を行う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430107,
					"content": "湖の向こう岸、つまり雪山の湖を泳げってことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430108,
					"content": "条件を設定しない時、人は本当に最も合理的な方法で目標を成し遂げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430109,
					"content": "雪の中の湖に耐えられないと思う人もいれば、こういう寒さが好きな人もいるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430110,
					"content": "キミたちがどんな選択をしたとしても、実験の一部だし、ボクにとってちゃんと価値のあるものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430111,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "では頼むよ、キミの答えを楽しみにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430112,
					"content": "超能力テストより楽だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "そういう曖昧な返事が一番怖い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
							"2"
						],
						"stepId": 1104303,
						"stateName": "QUEST_STATE_UNFINISHED"
