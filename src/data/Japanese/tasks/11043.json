				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "お疲れ様、正直驚いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430302,
					"content": "さすが噂の旅人、キミのデータはモンドの平均値をはるかに上回ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430303,
					"content": "でもずっとオイラたちについてきたおまえも、大して息切れしてないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430304,
					"content": "ボク？実は錬金術を使って少し楽をしたんだ、まあそれは置いておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430305,
					"content": "もしテイワットの法則がキミに影響を与えてないなら、異世界文明に対する推測をいくつかできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430306,
					"content": "逆にテイワットの法則がキミに影響を与えたなら、影響がない場合の変化を推測することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430307,
					"content": "その中に含まれた可能性は実に面白い、何度も味わう価値があるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430308,
					"content": "しかし…おまえの研究の役に立つのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430309,
					"content": "ボクを困らせた問題は解決したよ。拠点に戻ったら、キミたちに面白いものを見せられるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430310,
					"content": "こんな風に何かを研究したことは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "その話をしたらキミは様々な変わったものと同類になるけど、それでもいいかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430312,
					"content": "黄金、石化古樹、通常の8倍の太陽——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430313,
					"content": "本質を探究する過程は人を夢中にさせる。残念なのは、そういう夢中になれる時間が常に短いことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430314,
					"content": "ボクはボクの全てをかけても構わないけど、サンプルは限られてるからね。未知が徐々に既知になると、そういう面白さも消えていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430315,
					"content": "最後はどれも夕暮れの実や、スイートフラワーのような存在になって、時間をかける価値もなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430316,
					"content": "だからあのヒルチャールの絵にも、あんなに違いがあったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430317,
					"content": "ああ、ボクはあの時、「時間をかける価値はない」と言っただろ。ボクにとってもう興味がなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430318,
					"content": "じゃあ、この実験が終わったら、オイラたちもあんな風に…えっと、ただのラフ画になるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110430319,
					"content": "それなら心配ないよ、キミたちはボクの協力者、この恩は忘れないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430320,
					"content": "さて、拠点に戻る前に、最後の項目、知能に関する実験を終わらせようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110430321,
					"content": "ついてきて、向こうにある遺跡に行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
