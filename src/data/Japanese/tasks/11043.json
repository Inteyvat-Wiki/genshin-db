	"talks": [
		{
			"id": 1104301,
			"completionStepIds": [
				1104301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
