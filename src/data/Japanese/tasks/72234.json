			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"樺山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "座り心地はどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340102,
					"content": "突然現れるなんて、びっくりした！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "ごめんごめん、わざとじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340104,
					"content": "僕は樺山。僕も、君が今座っているところによく座るんだ。そこは静かで、考え事に向いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340105,
					"content": "じゃあ、譲ろうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "あ、ありがとう。でもいいんだ。それよりも、君はよそから来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340107,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "ならばきっと色々見てきただろう。僕は外へ旅したことが無い、引っ越しの経験は豊富だけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340109,
					"content": "それ言っちゃうと思い出しちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340110,
					"content": "小さい時は引っ越しが多かったせいで、友達を作る機会があまりなかった。色んな景色を見てきたけど、ぼくにはそれを共有できる人がいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340111,
					"content": "僕が見てきた景色を、君にも見せてあげたい。そしてもし君がそこに旅しに行ったら、帰って感想を聞かせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340112,
					"content": "一つは狭間の街の一番高いところにある石門の下、一つは常夜霊廟の近くにある珊瑚に囲まれた空き地で、最後の一つは蛇心の地の残壁の近くにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340113,
					"content": "僕はその3か所に印をつけて、高いところ明かりを灯したから、簡単に見つかると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				}
			]
		},
		{
			"id": 7223402,
