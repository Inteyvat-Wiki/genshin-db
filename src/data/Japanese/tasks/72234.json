			"dialogs": [
				{
					"id": 722340301,
					"content": "おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340302,
					"content": "全部行ったんだね。博識の君なら、きっとどれも大したことないと思うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340303,
					"content": "とても独特でいいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "ああ、誰にも見せられてないのが残念だよ。でも、君の意見が聞けただけでも良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340306,
					"content": "これら以上に印象的な場所はたくさんあるだろう。ここは暗いし、食べ物もあまり種類がない。それに、ヴィシャップにも気をつけないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340307,
					"content": "でも長く住んでいると、この場所に愛着が湧いてくるんだ。そこで見たいくつかの景色は、今になっても恋しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340308,
					"content": "君も同じように感じたことない？こんな場所でも、長く居れば家の感じがするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340309,
					"content": "そうかもしれないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340312,
					"content": "…とにかく話を聞いてくれてありがとう。大したお礼はできないけど、これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340310,
					"content": "そう思わない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "まあまあかな。もっと壮大な景色を見たことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
