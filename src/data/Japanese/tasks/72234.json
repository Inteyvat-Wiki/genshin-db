			"dialogs": [
				{
					"id": 722340201,
					"content": "おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340202,
					"content": "まだ全部見つかってない？それは残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340203,
					"content": "もう一度説明しようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340204,
					"content": "一つは狭間の街の一番高いところにある石門の下、一つは常夜霊廟の近くにある珊瑚に囲まれた空き地で、最後の一つは蛇心の地の残壁の近くにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340205,
					"content": "僕はその3か所に印をつけて、高いところ明かりを灯したから、簡単に見つかると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				}
			]
		},
		{
