					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201509,
					"content": "部族が報告を待ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201510
					]
				},
				{
					"id": 732201510,
					"content": "うん…もうちょっとだけ時間をちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201511
					],
					"speakerTitle": "ジェイド"
				},
				{
