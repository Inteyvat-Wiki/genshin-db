					"nextDialogs": [
						732201506
					]
				},
				{
					"id": 732201506,
					"content": "君がもし気にしないなら、もうちょっとここにいたいの…ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201507,
						732201509
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201507,
					"content": "（やっぱり邪魔しないでおこう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201508
					]
				},
				{
