	"talks": [
		{
			"id": 7322006,
			"completionStepIds": [
				7322006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322006",
							"2"
						],
						"stepId": 7322006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェイド",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200601,
					"content": "ごめん…なんて言えばいいのか、わからなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200602
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200602,
					"content": "時が流れるのを忘れたように、すべてが止まってる。何でかわからないけど、この変な風景に驚くことさえ忘れちゃって…ただただ穏やかな気持ちなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200603
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200603,
					"content": "こんなところで、死んだ神と共に永遠に眠るなんて…はぁ、父さんたちがあたしのそばを離れることがなかったらよかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200604
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200604,
					"content": "永遠にここに留まって…時間に忘れ去られることがありませんようにってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200605
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200605,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200606
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200606,
					"content": "初めて入った時、私たちは欠片の力を邪魔して、安定を維持する装置を破壊してしまった…ここはいつか崩れて、黄砂に飲み込まれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200607
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200607,
					"content": "その時が来れば、女主人が残された、この静止したオアシスを維持する力も消滅する…これは変えられない結末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200608
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200608,
					"content": "うん…わかってる。少なくともその前に、そうなる前に…父さんと母さんは再会できた。まるで、決して互いに離れることはないみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200609
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200609,
					"content": "いつの日か、あたしもここに戻ってくるんだろうね…全部の冒険に飽きて、「家」と呼べるあらゆる場所を離れた後にさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200610
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200610,
					"content": "その時が来たら、平然と「ただいま！」って言ってさ、それから、父さんと母さんと一緒に眠るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200611
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200611,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200612
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200612,
					"content": "ジェイド…その日はまだまだ遠い先だぞ！今は…えっと…今、ジェブライラはきっと喜んでると思う。仏頂面だけど、きっと喜んでると思うぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200613,
					"content": "ありがとう、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200614
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200614,
					"content": "#{NICKNAME}も、小さなわがままを叶えられるまで付き合ってくれて、ありがとう…今はもうちょっと父さんと母さんのそばにいたいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200615,
						732200617
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200615,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200616
					]
				},
				{
					"id": 732200616,
					"content": "うん…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200617,
					"content": "忘れずに帰って来てね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200618
					]
				},
				{
					"id": 732200618,
					"content": "あたしのことは気にしないで…あとで追いかけるから。はぁ、今はまだここに住みつくのにいいタイミングじゃない。そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				}
			]
		},
		{
			"id": 7322008,
			"completionStepIds": [
				7322008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322008",
							"2"
						],
						"stepId": 7322008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェイド",
					"バベル",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200801,
					"content": "無事戻りました、バベル主母。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200802
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200802,
					"content": "「永遠のオアシス」の秘密を解き明かし、部族のために通路を開いてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200803
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200803,
					"content": "この度はチャンスを与えて下さってありがとうございます。これで父さんと母さんの長年の願いが叶いました…父さんたちは、タニットのご庇護を受けてないにもかかわらず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200804
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200804,
					"content": "かしこまる必要はない、我が娘よ。あんたの願いは、ずっと覚えていた。子供たちの願いを叶えてあげることは、主母であるあたしの責任でもあるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200805
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200805,
					"content": "ありがとうございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200806
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200806,
					"content": "よし、ジェイド。じゃあ、アザリクのことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200807
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200807,
					"content": "主母のご判断は正しかったです…あいつは裏切り者に違いありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200808
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200808,
					"content": "えっ。ってことは、アザリクが裏切るって、もうとっくに分かってたのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200809,
					"content": "いや、今までは疑ってただけだったんだけど、ずっと注意して見てはいたんだ…でもまさかこんなにも早く手の内を明かすだなんて思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200810
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200810,
					"content": "バベル主母が警告してくれていたのに、あの時はあの人を信じるほうを選んじゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200811
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200811,
					"content": "主母、こちらが彼がファデュイと結託していた証拠です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200812
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200812,
					"content": "ジェイドはアデルフィの手紙をバベル主母に渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732200813
					]
				},
				{
					"id": 732200813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200814
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200814,
					"content": "どうか悲しまないでください、バベル主母…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200815
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200815,
					"content": "うむ…やつに下心があることは察していたが、この手で処すことができなかったのは少し心残りだよ…かつてはあれほどやつを重用していたのにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200816
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200816,
					"content": "でも今、部族の状況はだんだん危うくなってきてる…大事に育ててきた子たちを二人も失ってしまった今、これからの部族のことは、あんたに頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200817
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200817,
					"content": "へえ…ってことは、ジェイドは昇進したってことか？おめでとう、ジェイド！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200818,
					"content": "昇進だって？ハハっ…そんな言葉は砂漠ではあんまり聞かないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200819
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200819,
					"content": "あたしたち砂漠の民に、役人みたいな階級はないし、気にしないのさ。担当する責務が多ければ多いほど、将来より大きな権力を握る可能性がある——ただそれだけの話だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200820
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200820,
					"content": "ジェイド…タニットの未来はあんたにかかってる。部族の者たちの希望を裏切らないでおくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200821
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200821,
					"content": "部族の、って…あたしもタニットの人間だと認めてくださるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200822
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200822,
					"content": "バカな子だね。何があったって、あんたはタニットの娘だよ。あんたの体にはあたしたちと同じ血が流れてる。あたしはいつだってそう思ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200823
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200823,
					"content": "はい…ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200824
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200824,
					"content": "うーん、なーんか引っかかるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200825,
					"content": "#{NICKNAME}、この前、なにか怪しいものを見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200826,
						732200845
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200826,
					"content": "峡谷にある廃棄された拠点について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200827
					]
				},
				{
					"id": 732200827,
					"content": "オアシスに他の族人を派遣して死なせた後、「禁忌」を言い訳にその後来た者たちの進入を禁止した——そうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200828
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200828,
					"content": "それを黙って私たちを危ない地に行かせたのは、どういうことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200829
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200829,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200830
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200830,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200831
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200831,
					"content": "敬愛するリルパァールよ、ご不便をおかけし、誤解を生んだことについてはお詫び申しあげたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200832
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200832,
					"content": "タニット部族がジュラバドの遺跡と「永遠のオアシス」の在処を探り始めたのは、確かに最近のことじゃない…これまでも多くの族人を派遣してきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200833
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200833,
					"content": "今、これらの場所と地形を確定できているのも、彼らの探検の賜物です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200834
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200834,
					"content": "ただ、リスクがあまりにも大きかったために、生き残った人は十分の一もおらず、調査で分かることもほとんどなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200835
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200835,
					"content": "それであたしはこういった行動を止めて、これらの場所を禁忌のエリアとしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200836
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200836,
					"content": "裏切り者のアザリクも…チームを率いてあれらの峡谷と遺跡を探索した…彼があんたたちのために道を開いてくれると信じていたんだが…まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200837
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200837,
					"content": "それは…教えてもらってませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200838
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200838,
					"content": "あんたたちなら無事戻ってきてくれると、最初から分かっていたからさ。あんたはあたしの信頼する、次の世代の子供だよ、ジェイド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200839
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200839,
					"content": "あんたの勇気も、あんたの強さと知恵も、あんたの族人や友に対する真摯さ優しさも、全部見てきたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200840
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200840,
					"content": "あたしの娘も、砂漠にさらわれていなければ、きっとあんたとそっくりになっていたはずだよ。どんな危険にも負けず、どんな砂嵐にも飲み込まれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200841
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200841,
					"content": "だから、こうしてあんたを信じ、あんたのために祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200842
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200842,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200843
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200843,
					"content": "…ごめんなさい、バベル主母。あたし、失礼なことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200844
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200844,
					"content": "いいや、誤解や不安を招いてしまったあたしのほうこそ、許しを請うべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200864,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200865
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200865,
					"content": "申し訳ございません、我が主。私の考えすぎでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200866
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200866,
					"content": "#誤解が解けてよかった。{NICKNAME}、あんたは貴賓だ。タニット部族はいつでもあんたらを歓迎するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200867
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200867,
					"content": "敬愛する「ジンニーの主」よ、どんな要求でも遠慮なく申し付けていただきたい。できるだけそれを満たして差し上げよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200868
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200868,
					"content": "どんな要求でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200869
					]
				},
				{
					"id": 732200869,
					"content": "どんな要求でも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200870,
						732200873,
						732200876
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200870,
					"content": "報酬にモラがほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200871
					]
				},
				{
					"id": 732200871,
					"content": "そう来なくっちゃな！モラだぜ、モラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200872
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200872,
					"content": "よし、これがあんたへの報酬だ。それと…ジェイドが世話になったね、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200881,
					"content": "さて、あんまり引き止めちゃいけないね。協力してくれてありがとう、「ジンニーの主」よ…またタニット部族に来てくれるよう願っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200882
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200882,
					"content": "何しろ、あたしたちはあんたとリルパァールの導きに頼っているのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200873,
					"content": "記念品がほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200874
					]
				},
				{
					"id": 732200874,
					"content": "ええっ、モラはいらないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200875
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200875,
					"content": "タニットとの友情は記念すべきものだ。我々のささやかな気持ちを、ぜひ受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200876,
					"content": "代わりにジェイドの誕生日会で乾杯しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200877
					]
				},
				{
					"id": 732200877,
					"content": "おお、オイラの分も忘れないでくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200878
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732200878,
					"content": "え…？ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200879
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200879,
					"content": "ぷっ…それがあんたたちよそ者の伝統かい？いいだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200880
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200880,
					"content": "それじゃあ覚えとくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200845,
					"content": "裏切り者の手紙について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200846
					]
				},
				{
					"id": 732200846,
					"content": "アザリクとアデルフィが裏切った理由は、あなたが「裏切り者の娘」であるジェイドを大事にして後継者にしたからだと、手紙には書いてある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200847
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200848
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200848,
					"content": "それから、「北方の人間」との交流を任せたにもかかわらず、部族にいる「よそ者」の関係者を意図的に排除しただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200849
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200849,
					"content": "あなたたちの隠語は分からないけれど、先ほどの話がどういう意味だったのか…とても気になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200850
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732200850,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200851
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200851,
					"content": "敬愛するリルパァールよ、ご不便をおかけし、誤解を生んだことについてはお詫び申しあげたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200852
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200852,
					"content": "しかしながら、タニット部族の経営と生存は、他方面との貿易なくしては維持できない。その中には北のやつらも含まれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200853
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200853,
					"content": "部族の色んな仕事で忙しくて、彼らの企みについては予測できなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200854
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200854,
					"content": "その後、彼らのもたらすものは利益よりもリスクのほうが大きいと気づいて…仕方なく内部から裏切り者を粛清したのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200855
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200855,
					"content": "これもジェイドが必要な理由の一つです。この子はいつも揺るぎなく、部族のために裏切り者を排除できる。あの子の忠誠心と能力があたしはとても気に入ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200856
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200856,
					"content": "それは…教えてもらってませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200857
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200857,
					"content": "あんたたちなら無事戻ってきてくれると、最初から分かっていたからさ。あんたはあたしの信頼する、次の世代の子供だよ、ジェイド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200858
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200858,
					"content": "あんたの勇気も、あんたの強さと知恵も、あんたの族人や友に対する真摯さ優しさも、全部見てきたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200859
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200859,
					"content": "あたしの娘も、砂漠にさらわれていなければ、きっとあんたとそっくりになっていたはずだよ。どんな危険にも負けず、どんな砂嵐にも飲み込まれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200860
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200860,
					"content": "だから、こうしてあんたを信じ、あんたのために祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200861
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732200861,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200862
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200862,
					"content": "…ごめんなさい、バベル主母。あたし、失礼なことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200863
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732200863,
					"content": "いいや、誤解や不安を招いてしまったあたしのほうこそ、許しを請うべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "バベル"
				}
			]
		},
