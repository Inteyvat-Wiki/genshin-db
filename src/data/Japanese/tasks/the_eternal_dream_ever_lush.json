			"dialogs": [
				{
					"id": 732201201,
					"content": "私の女主人は…ここにはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201202
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201202,
					"content": "でも、私はここで自分の欠片を見つけた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201203
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201203,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				}
			]
		},
		{
			"id": 7322013,
			"completionStepIds": [
				7322013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322013",
							"2"
						],
						"stepId": 7322013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェイド",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732201301,
					"content": "光る欠片がリルパァールの魔瓶に入っていくにつれて、あなたは自身の力も少し引き抜かれていくような感じがした…しかしすぐに、温かい感覚があなたを満たした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732201302
					]
				},
				{
					"id": 732201302,
					"content": "ジンニーの恍惚としたまなざしに、あなたは紅玉で作られた宮殿と花園を見た…幾千万もの花が咲き、幾千万もの鳥がさえずっている。\\nジンニーたちは女主人の賢い従者であり、演奏家であり、そして給仕人だ。\\n彼女の花園で、狂った僧侶と落ちぶれた旅の者はお酌をする水仙と踊り、ブドウのツタの娘の血を飲む…\\nここはこの世に唯一無二の花園であり、かつて花の女主人の住居であった場所。そして今は、彼女の眠る陵墓となっている…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201303
					]
				},
				{
					"id": 732201303,
					"content": "「薔薇は炎のように咲き誇り、夜鶯の命を灯す。蝋燭は輝いて微笑むが、蛾に災いをもたらす。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201304
					]
				},
				{
					"id": 732201304,
					"content": "彼女が手を伸ばすのが見えた。その肌は月明かりのように透き通っている。あなたは彼女の顔を見た。そのえも言われぬ麗しさを。美しい一人ひとりのジンニーはまるで彼女の花びらのようで、その一つひとつの香りはすべて、彼女から来たものであったようだ…\\nそして、彼女と目が合った——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201305
					]
				},
				{
					"id": 732201305,
					"content": "そこには何もなかった。\\nあるのは、無限に広がる虚空のみ。その中に落とされたあなたは、恐怖を感じてやまなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201306
					]
				},
				{
					"id": 732201306,
					"content": "意識がだんだんはっきりとしてきた。ジェイドが手を握って、心配してくれているようだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201307
					]
				},
				{
					"id": 732201307,
					"content": "気が付いたんだね…大丈夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201308
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201308,
					"content": "今のは…はぁ、何でもない。とにかく無事でよかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201309
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201309,
					"content": "なにを見てたんだ…？なんだか長い夢を見てたみたいだな。びっくりしたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201310,
						732201311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732201310,
					"content": "「花の女主人」だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				},
				{
					"id": 732201312,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201313
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201313,
					"content": "あの方はもうここにはいません。あいつは私たちを騙したのです——私たち全員を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201314
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201314,
					"content": "何言ってるの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201315
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201315,
					"content": "いいえ、何でも。遥か昔の契約が取り消されただけ。私は…自由になったのだと思うけれど…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201316
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201316,
					"content": "砂海の王はかつて私たちと約束しました。花の女主人はここに眠り、そしていつかここで目覚めると…しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201317
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201317,
					"content": "おかしい…女主人は既に亡くなりました。あいつは私を…私の族人を騙したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201318
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201318,
					"content": "狂ったようにあいつのことを恨むはずでした。この砂漠のためにも、女主人の死のためにも…かつてあいつを愛し、仰ぎ見たのと同じくらい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201319
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201319,
					"content": "しかし…恨む原動力を失ってしまいました…どうしてこうなったのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201320,
						732201321
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201320,
					"content": "これが「自由」になるということかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201322,
					"content": "そうですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201323
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201324
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201324,
					"content": "ふん、利口ぶって…私の主は相変わらずあなたで、私たちの契約はまだまだ終わりはしません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201325
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201325,
					"content": "行きましょう。ジェイドが待っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201326
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201326,
					"content": "ね…いい場所を見つけたの、あそこだよ。先に行くね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201327
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201327,
					"content": "君も後から絶対来てよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201321,
					"content": "愛憎に頼らなくてよくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201311,
					"content": "ここの遥か昔の風景だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				}
			]
		},
