					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732201101,
					"content": "わあ…砂漠の真ん中にこんなところがあるなんて、思わなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732201102,
					"content": "あれ？地下から出てきた頃って、もうすでに日が傾いてたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732201103,
					"content": "いや…ここは女主人の楽園、水と空がつながる永遠のひと時、そして「からくり」と「慈愛」が絡み合った時間。この時こそが永遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201104
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732201104,
					"content": "うぅ…なに言ってるのかわからないけど、それが、ぜんぶ静止しちゃって動かなくなってる理由なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732201105,
					"content": "だから、父さんや母さんも…ここを帰る場所にしていたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201106
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732201106,
					"content": "そうとは言っていないけれど…はぁ…好きに理解していい、かわいそうな娘よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リルパァール"
				}
			]
		},
