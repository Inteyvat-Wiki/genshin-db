			"dialogs": [
				{
					"id": 223030101,
					"content": "商売って難しいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "ん？ああ、酒場の商売が難しくなったって言ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030104,
					"content": "こういう飲食店を長い間やってると、メリットもデメリットもたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030105,
					"content": "メリットは、時間が経つにつれ有名になる。有名になれば、お金も入ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030106,
					"content": "デメリットはいつか飽きられてしまう。店が大きくて、品物の種類がたくさんあれば問題はないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030107,
					"content": "うちみたいな小さな酒場はどうもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030108,
					"content": "お客さんもだんだん飽きてきて、あまり来なくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030109,
					"content": "そういえば、モンドの酒市場もかなり繁盛してると聞いた。蒲公英を使った「蒲公英酒」がとても有名らしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030110,
					"content": "蒲公英が酒に使えるかは分からないが、やってみるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030111,
					"content": "すまないが、モンドに行って蒲公英を持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030112,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "頼んだよ、報酬は支払うさ。璃月の人に二言はないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030114,
					"content": "蒲公英酒か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "なんだ？酒の味が変わってるのか？この酒はモンドで人気があるって聞いたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030116,
					"content": "でも蒲公英酒の配合のまま作ってもきっと売れないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "徳貴"
				},
				{
					"id": 223030117,
					"content": "とにかく<color=#00E1FFFF>蒲公英</color>を持ってきてくれないか。璃月のやり方で作ってみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "徳貴"
				}
			]
		},
