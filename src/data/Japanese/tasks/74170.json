			"trigger": {
				"objectNames": [
					"ブリコール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "おお！また戻って来たのか。まあ、僕もだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701702,
					"content": "科学院に報告したら、資産を回収するついでに、ここが能力開拓のトレーニング場として適してるかどうか評価するよう指示されてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701703,
					"content": "はぁ、確か前にも似たようなことがあったよ。事務官が一時期、みんなを連れて潜水訓練をしようと燃えててさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701704,
					"content": "僕からしたら、何の意味もないことだけど…ま、仕事は仕事だし、任務はちゃんとこなさないとね…それはそうと、この場所が変な…いや、独特な構造をしてるのは確かだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701705,
					"content": "そこで、アンカーの複製品をあちこちに配置してみた。あっ、アンカーといってもただの模型だから、危険なものじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701706,
					"content": "僕が今考えてるのは、<color=#00E1FFFF>指定時間内に建物内にあるアンカーの複製品をすべて回収</color>する、っていう訓練方法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741701707,
					"content": "どうだい、試してみないか？挑戦をクリアしたら、もちろん報酬も渡すよ。調査に協力してくれたお礼にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブリコール"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
