			"dialogs": [
				{
					"id": 741700210,
					"content": "挑戦のことは置いといて、クトロについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "フォンテーヌ科学院から除名されても反省してなかったようだね。本当に頭の固いやつだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741700212,
					"content": "まあ、もうあいつの保証人になってくれる人はいないだろうし、二度と悪だくみはできないはずさ…だから、あなたたちも安心してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブリコール"
				}
			]
		},
