			"trigger": {
				"objectNames": [
					"ブリコール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "お見事！どうやら、この挑戦は大丈夫そうだな！これで安心して提案書を科学院に提出できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741700402,
					"content": "ただ、ここの資産の確認がまだ終わってないから、また戻ってくることになりそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "ブリコール"
				},
				{
					"id": 741700403,
					"content": "何はともあれ、協力してくれてありがとう！そうだ、報酬を渡さないとね。旅が順風満帆であることを祈っているよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブリコール"
				}
			]
		},
