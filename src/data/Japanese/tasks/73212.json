					"nextDialogs": [
						732120904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120904,
					"content": "ジェイドの指示だって言うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120905
					]
				},
				{
					"id": 732120905,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120906,
					"content": "あいつらの言うことを信じるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120907,
					"content": "ジェイドがそんなことをする理由はない。",
