			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バベル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121101,
					"content": "いらっしゃい、尊き「ジンニーの主」よ。何か用でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121102
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121102,
					"content": "ユフトゥンのキャラバンが「反逆者」に襲われた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121103
					]
				},
				{
					"id": 732121103,
					"content": "そうか…珍しいことでもない。雪国から来た北方の人間は、我々の領土に浸透していっている。やつらの誘惑に駆られ、我々を裏切った者も少なくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121104
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121104,
					"content": "そういった輩の工作によって、略奪事件が時々起きるんだ。数ヶ月前からこんな状況でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121105
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121105,
					"content": "あっ…すまない、話を遮るつもりはなかったんだ、続けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121106
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121106,
					"content": "#その「反逆者」が{M#俺}{F#私}たちに目をつけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121107
					]
				},
				{
					"id": 732121107,
					"content": "ああ、キャラバンの調査を終えたら、突然現れたエルマイト旅団に襲撃されたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121108,
					"content": "そう…ひどい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121109
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121109,
					"content": "どうやら…アデルフィとアザリクを失ってもなお、我々に牙を剥く犬共がいるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121110
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121110,
					"content": "ひとまず、あんたたちにはここで休息を取りながら心身を癒してもらおう。あんたたちの身の安全については、あたしが自ら指示する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121111
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121111,
					"content": "それと、ジェイドはまだ外で部落の任務を行ってる。彼女が帰ってきたら、あんたたちと共に今回の一件を調査させよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121112
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121112,
					"content": "それまでに、あんたたちを襲撃した犯人を全力で探すつもりだ…安心していい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121113
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121113,
					"content": "えっと…まだあるんだ！オイラたちを襲った悪者はオイラたちを知ってるみたいだった！この部落の人かもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121114,
					"content": "その可能性はなくはない…だが、大丈夫だ。あんたたちは客人として保護を受けることになる…ここにいる限り、あんたたちを傷つける者はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121115
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121115,
					"content": "もしもタニット部落であんたたちを困らせるようなやつがいたら、如何なる者であっても、この主母であるあたしがとことん追及する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121116
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121116,
					"content": "しばらく休んでいてくれ。反逆者の事件については、全力で調べるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121117
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121117,
					"content": "それとジェイドのことも。彼女が帰ってきたら、すぐあんたたちに知らせてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121118
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121118,
					"content": "おう、バベル主母、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121119,
					"content": "遠慮する必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				}
			]
		},
