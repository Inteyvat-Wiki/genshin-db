			"trigger": {
				"objectNames": [
					"ユフトゥン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120101,
					"content": "あっ、「ジンニーの主」…き、き、来たのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120102
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120102,
					"content": "ちょうど一つ頼みたいことがあるんだ。ひ、一つ…急用なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120103,
						732120105
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120103,
					"content": "そう慌てないで、聞いてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120104
					]
				},
				{
					"id": 732120104,
					"content": "ああ、ゆっくり話して大丈夫だぞ。オイラたち手伝うから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120107,
					"content": "品物が一口、一口、一口…なくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120108
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120108,
					"content": "三口も品物がなくなったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120109,
					"content": "いや、ひ、ひと、一口…なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120110
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120110,
					"content": "よそ者から仕入れてる「豊沃の恵」が、け、結構経ったのに、ま、まだ届いていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120111
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120111,
					"content": "き、北方の人間の仕業かもしれない…バベル主母が反逆者をそ、捜索するとか言って、やつらを追い詰めてるからだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120112
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120112,
					"content": "アデルフィとアザリクがいなくなってから…やつらの活動も増えてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120113
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120113,
					"content": "い、いや、余計な話はやめよう。「豊沃の恵」を運送するキャラバンが、哨兵に見つかったのは、こ、このエリアだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120114
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120114,
					"content": "品物をさ、探してくれないか。もしくは、せ、せめ、せめて…キャラバンの残した手がかりだけでも探してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120115
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120115,
					"content": "分かった。手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120116
					]
				},
				{
					"id": 732120116,
					"content": "キャラバンは消えちゃったのか？聞いた感じ、悪者の強奪に遭ったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120117,
					"content": "ど、ど、どうもありがとう。この肉を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120118
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120118,
					"content": "気にするなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120105,
					"content": "何を手伝えばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120106
					]
				},
				{
					"id": 732120106,
					"content": "そう慌てないでくれ、ゆっくり話して大丈夫だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
