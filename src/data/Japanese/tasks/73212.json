			"dialogs": [
				{
					"id": 732120501,
					"content": "（潰れた空き缶がひとつある。まだ完全に砂で埋まってないことから、少し前に誰かが捨てたもののようだ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 732120502,
					"content": "見ろ！この空き缶、まだ砂に埋まりきってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120503,
					"content": "交易路に物資が散乱してる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "なんか怪しいな…他にも道の途中に落ちてる物があるかもしれないから、先に進んで探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120505,
					"content": "交易路に沿って探してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "ああ…道の途中に物が捨てられてるかもしれない。先に進んで探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
