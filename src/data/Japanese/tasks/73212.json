					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120401,
					"content": "旅人！やっほー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732120402,
					"content": "一緒に冒険してくれてありがとう。両親のことも…感謝するね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732120403,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "へへっ、バベル主母から他の任務を指示されてなかったら、君と一緒に砂漠の冒険に行けたんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732120405,
					"content": "他にも面白い場所をたくさん知ってるから、時間があったら案内するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 732120406,
					"content": "でもあいにく、今はタイミングが悪いんだ。北方の人間と手を組んだ反逆者があたしたちの領地を虎視眈々狙ってるから…やつらの動向を偵察しないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				}
			]
		},
