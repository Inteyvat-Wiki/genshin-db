			},
			"dialogs": [
				{
					"id": 732121701,
					"content": "尊きジンニーの主よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121702
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121702,
					"content": "前回の襲撃事件については、いま調査を進めているから安心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121703
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121703,
					"content": "タニット部族の内部での安全は保証するが、砂漠に出てからは…十分に気を付けることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121704,
						732121711,
						732121714,
						732121721
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121704,
					"content": "「永遠のオアシス」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121705
					]
				},
				{
					"id": 732121705,
					"content": "タニット部族を代表して、あんたたちとジェイドの貢献に改めて礼を言わせてもらおう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121706
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121706,
					"content": "「永遠のオアシス」は子供たちにとって重要なだけでなく、タニット部族にとって信仰の中心的な存在だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121707
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121707,
					"content": "それを擁する者は、「オアシスの女王」ナブ·マリカッタ様の王座を擁するも同義…これは彼女の子孫にとっては、重要な意味を持つことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121708
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121708,
					"content": "どんな価値があるのか…いまいち分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121709
					]
				},
				{
					"id": 732121709,
					"content": "ははっ、何の価値もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121710
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121710,
					"content": "…非常に価値があるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121711,
					"content": "最近、ジェイドは忙しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121712
					]
				},
				{
					"id": 732121712,
					"content": "ああ、「永遠のオアシス」を我々が制した以上、それを狙う悪者どもが近づくのを阻止しなければならない。タニットは今や「永遠のオアシス」の守衛なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121713
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121713,
					"content": "その任務に最適な人材は、ジェイドをおいて他にいないだろう。あの子にとって自分の親を守ることにもなるから。そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121714,
					"content": "反逆者について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121715
					]
				},
				{
					"id": 732121715,
					"content": "我々が「永遠のオアシス」に通じる道を開いたから、それを知った反逆者たちがまたうようよと動き始めたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121716
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121716,
					"content": "やつらにとって、我が女神は至高の権力の象徴であり、無限の財をもたらす存在…あたしはそのような冒涜が許せない。たとえ女神が眠っているのだとしても。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121717,
						732121719
					],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121717,
					"content": "女神は再び目を覚ますと思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121718
					]
				},
				{
					"id": 732121718,
					"content": "無論信じている…いずれ必ず、女神様はその神形を復元し、我々を花の国土へといざなってくださるはず。それまでは、あたしが…タニットがその意志を代行する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121719,
					"content": "そこには行ったけど、女神はいなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121720
					]
				},
				{
					"id": 732121720,
					"content": "女神様はそこに「居る」。あんたたちに「見え」ないだけで、そこに「居る」んだ。女神様は永遠に「居る」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				},
				{
					"id": 732121721,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121722
					]
				},
				{
					"id": 732121722,
					"content": "達者で、尊き「ジンニーの主」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バベル"
				}
			]
		}
	]
