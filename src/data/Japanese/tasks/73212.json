			"dialogs": [
				{
					"id": 732120301,
					"content": "どう、な、な、なにか見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120302
					],
					"speakerTitle": "ユフトゥン"
				},
				{
					"id": 732120302,
					"content": "まだ失踪したキャラバンの行方を探してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120303
					]
				},
				{
					"id": 732120303,
					"content": "は、は、早く調査してくれ、この通り頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ユフトゥン"
