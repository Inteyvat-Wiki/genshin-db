			"dialogs": [
				{
					"id": 732120801,
					"content": "（一枚の完全な状態の絨毯。上にはタニット部族のマークが縫い付けられており、不気味な染みが点々と広がっている…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120802
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 732120802,
					"content": "この絨毯…おかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "うーん…高級な絨毯が、なんでこんなところに捨てられてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120804,
					"content": "略奪と抗争があったのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120805
					]
				},
				{
					"id": 732120805,
					"content": "ああ…その可能性はあるな…それで全部説明がつくし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120806,
					"content": "キャラバンと強盗がここでやり合って、その勢いで一部の物資が破損してしまった。で、一部の壊れてない物資は、片付ける間がなくて放棄された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120807,
					"content": "パイモンの推理はなかなか的を射てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120808
					]
				},
				{
					"id": 732120808,
					"content": "ふふ～ん！さすがオイラだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120809,
					"content": "そして、キャラバンと強盗は走っては殴り合い、殴り合っては走りを繰り返し…そのせいで潰れた箱や缶が道の途中に散乱してたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120810,
					"content": "うん、これで筋が通るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120811,
					"content": "まったく筋が通ってない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120812
					]
				},
				{
					"id": 732120812,
					"content": "えっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120813,
						732120814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120813,
					"content": "あのゴミは品を手に入れた後に捨てたもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				},
				{
					"id": 732120815,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120816,
					"content": "道中に争いの痕跡はなかったからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120817
					]
				},
				{
					"id": 732120817,
					"content": "そういうことか…ふふん、オイラの推理も別にかけ離れてはなかったな…当たらずとも遠からずってとこか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120818,
					"content": "あれ…でも、なんかしっくりこないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120819,
						732120820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120819,
					"content": "どこが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "えっと…これらの手がかりって、あまりにもわざとらしいと思わないか？オイラたちを誘導するために狙って並べたみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120822,
					"content": "う～ん…考えすぎじゃないかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "おい！見ろ、あそこに馬車があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120825,
					"content": "ほぼ原型が分からない…でも上にはタニット部族のマークがあるぞ…薄っすらだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120826,
					"content": "よし、これでなにがあったか分かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120827
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120827,
					"content": "見ろよ、この馬車は明らかに待ち伏せされて、物資を全部奪われてる。ユフトゥンのところに戻って報告しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120828
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120828,
					"content": "うん、帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120829
					]
				},
				{
					"id": 732120829,
					"content": "二人のお客さん、すまんがちょっとお待ちを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120830
					],
					"speakerTitle": "エルマイト旅団の刺客"
				},
				{
					"id": 732120830,
					"content": "えっ…おまえら誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120831
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120831,
					"content": "俺たちはジェイドの仲間だ、ご苦労さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120832
					],
					"speakerTitle": "エルマイト旅団の刺客"
				},
				{
					"id": 732120832,
					"content": "そうなのか。ジェイドの仲間ならオイラたちの仲間も同然だな！ちょうどこっちも用が済んだところだから、一緒に帰ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120833,
					"content": "ハハッ、そう慌てるな。お客さんも急いで帰ることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120834
					],
					"speakerTitle": "エルマイト旅団の刺客"
				},
				{
					"id": 732120834,
					"content": "待った、パイモン…彼らはどこかおかしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120835
					]
				},
				{
					"id": 732120835,
					"content": "ジェイドから、君たちにはもう少し砂漠に留まっていてほしいと頼まれてね…俺たちは君たちを「もてなす」よう、ジェイドに頼まれたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120836
					],
					"speakerTitle": "エルマイト旅団の刺客"
				},
				{
					"id": 732120836,
					"content": "ジェイドの厚意を裏切らないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120837
					],
					"speakerTitle": "エルマイト旅団の刺客"
				},
				{
					"id": 732120837,
					"content": "えっ…？旅人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120838,
					"content": "隠れて、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120839
					]
				},
				{
					"id": 732120839,
					"content": "わ、分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732120823,
					"content": "確かに、まだ証拠が揃ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120820,
					"content": "パイモンの直感が働く時間だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120814,
					"content": "身を軽くするために捨てたんだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				}
