			"dialogs": [
				{
					"id": 732121601,
					"content": "うぅ…ちゃんとした品はなにひとつ残ってないぞ…ったく、なんなんだよ！ヒルチャールのやつらひどすぎないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121602,
						732121604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121602,
					"content": "いや、これはヒルチャールの仕業じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121603
					]
				},
				{
					"id": 732121603,
					"content": "えっ…？でも…ヒルチャールの拠点がここにあるんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121606,
					"content": "馬車がまだ見つかってないから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121607
					]
				},
				{
					"id": 732121607,
					"content": "あっ…確かに！ここに馬車の残骸はないし…ヒルチャールの拠点にも馬車の部品らしき物は見当たらなかった…おかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121610,
					"content": "道に沿って進んでみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121611
					]
				},
				{
					"id": 732121611,
					"content": "ああ…そうだな。ヒルチャールじゃないとすれば、いったい誰なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121608,
					"content": "見て、拠点に馬車がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121609
					]
				},
				{
					"id": 732121609,
					"content": "確かに！もしキャラバンを襲ったのがヒルチャールだとすれば、やつらはその場でゆっくり馬車を分解するはずだよな。けど、馬車やその部品らしき物は見当たらなかった…おかしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732121604,
					"content": "いや、略奪はここで起きた訳じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121605
					]
				},
				{
					"id": 732121605,
					"content": "でも、ヒルチャールの拠点が道のど真ん中にあるんだぞ？ほら、ここを遮れば追い剥ぎにはもってこいだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "パイモン"
				}
			]
		},
