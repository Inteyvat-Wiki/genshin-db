				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"経綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "だめだ…やはり支援が必要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300202,
					"content": "魔物の拠点は片付けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "そうか、ありがとう。しかしまた新しい状況が起きた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300204,
					"content": "元々軽策荘周辺にいるのは、普通の魔物だと思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300205,
					"content": "何人かで魔物の拠点を片付けて、次に進もうとした時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300206,
					"content": "となりの森から突然、ヒルチャール·岩兜の王が現れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300207,
					"content": "私たちが反応する前に、すでに襲われて、けが人が多く出てしまった…そこでやむを得ず撤退したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300208,
					"content": "あの魔物の脅威は大きすぎる、放ってはおけない。しかし他の場所を片付けてる人たちがまだ戻ってきてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300209,
					"content": "旅人、あの魔物を倒してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300210,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "じゃあ任せたよ。本当に悪いね…私たちの役目なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300212,
					"content": "けがした人は大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "迅速な治療のおかげで、大事には至ってない…しかししばらくは動けないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300214,
					"content": "だから旅人よ、君にあの魔物を倒してきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300215,
					"content": "本当に悪いね…私たちの役目なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "経綸"
				}
			]
		},
