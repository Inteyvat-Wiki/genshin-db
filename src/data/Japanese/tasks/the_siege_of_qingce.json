			"dialogs": [
				{
					"id": 411300601,
					"content": "どうだ、あの魔物を倒したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300602,
					"content": "倒したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "よかった…これでやっと安心できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300604,
					"content": "ありがとう、旅人。これを受け取ってくれ、私からの礼だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300605,
					"content": "しかしなぜ軽策荘付近にこんな魔物が、おかしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300606,
					"content": "まあいい、どうであれ、このことを総務司に報告しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300607,
					"content": "総務司がもっと人員をくれればいいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "経綸"
				}
			]
		}
