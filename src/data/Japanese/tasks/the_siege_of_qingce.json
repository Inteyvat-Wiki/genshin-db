			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"経綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "旅人、ここ、ここだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "また軽策荘の事なんだけど、空から降る隕石のせいで、軽策荘近くの魔物が暴れてる。軽策荘は今にもあいつらに囲まれそうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300106,
					"content": "軽策荘は私たちが守ってるから問題はないが、城からの物資支援は外から来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300107,
					"content": "今のこの状況、総務司から護送をたくさんつけられるはずもない…もし魔物の大群に遭えば、物資も危険だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300108,
					"content": "だから、私たちで考えた…遠くには行けないが、軽策荘近くの魔物は私たちでなんとか片付けようと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300109,
					"content": "そうすれば、物資を届けにきてくれた人も少しは楽になる。しかし以前の偵察で、周囲の魔物がすごく多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300110,
					"content": "私たちだけでは、魔物の拠点を迅速に片付けるのは難しい。時間をかけすぎたら、軽策荘に危険が起きるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411300111,
					"content": "旅人、私たちのために魔物を片付けてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "経綸"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
