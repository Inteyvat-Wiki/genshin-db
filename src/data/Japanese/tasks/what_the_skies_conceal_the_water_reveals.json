				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "ふう…生き返った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131102,
					"content": "なあ、眠ってた時、夢を見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131103,
					"content": "ああ、見たよ！大変だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131104,
					"content": "大変な夢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131105,
					"content": "山の上にいる夢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "なぜ分かる？高くて寒い雪山だった…あんな高い山は見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131109,
					"content": "雪山で何をしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131110,
					"content": "分からない。夢の中の俺は山頂まで登ろうってことしか考えてなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131111,
					"content": "山頂にいいものでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131112,
					"content": "さあな？自分でもらしくないと思ったんだ。理由はうまく言えないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131113,
					"content": "登りたいからとかじゃなく？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "なんというか…誰かが俺を操って、登らせてるような感覚だった。変だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131115,
					"content": "まさか、闇の心かしら？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411131116,
					"content": "自発ではなく、無意識に生まれた願望、確かに精神支配に似てますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411131117,
					"content": "もう慣れてるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "そういえば、寒いとか歩けないとか言ってた人たちも…雪山にいるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131120,
					"content": "みんな同じ夢を見てる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "不思議だ…早く<color=#00E1FFFF>モナ</color>に知らせないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131118,
					"content": "それ同じ意味なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "雪原にいる夢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "雪原じゃない、雪山だ。高くて、寒かった…眠っている間、山の麓にいる夢を見てたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "高六"
				}
			]
		},
