					"speakerTitle": "大黄"
				},
				{
					"id": 411131403,
					"content": "おっ、探してくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131404,
					"content": "でもさっきまで眠っていたから、話を聞くなら優しく聞いてあげてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "大黄"
				},
				{
					"id": 411131405,
					"content": "不幸な人よ、お見舞いに来たわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411131406,
					"content": "はぁ…腹が減ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131407,
					"content": "大丈夫か？腹がすごく減ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131408,
					"content": "あ、ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131409,
					"content": "何が食べたい？教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "郷土…料理…が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "高六"
				},
				{
					"id": 411131412,
					"content": "軽策荘の郷土料理、<color=#00E1FFFF>軽策の作物を使った料理</color>だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411131410,
					"content": "料理を作ってあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
