					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "一番簡単な占いを使ってたとしても…あの人が「ファデュイの執行官」だってことは分かります！危険すぎます、どこで知り合ったんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130716,
					"content": "あの少年がファデュイの執行官！？なんという危険人物…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130717,
					"content": "まさか執行官だったとは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "近付いてきたのは何か目的があるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130719,
					"content": "それに彼は強い！想像以上の実力者だってことは、一目見れば分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130720,
					"content": "認めたくありませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130721,
					"content": "占星術の天才、モナ様よりもお強いと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130722,
					"content": "ま、まさか！実力では負けるかもしれませんが、占星術なら私の圧勝ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130723,
					"content": "そういえば、望舒旅館の周りにもファデュイがいたよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130724,
					"content": "やつらも隕石のことを調べてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130725,
					"content": "何やら陰謀が隠されているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130726,
					"content": "あっ、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130727,
					"content": "あっ！まさか、隕石はファデュイの仕業なんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130728,
					"content": "パイモン！先に言わないでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130729,
					"content": "えへへっ…ごめん、ついうっかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130730,
					"content": "でも、隕石を召喚する術があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "星を墜落させるとか、ありえないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130732,
					"content": "オズヴァルド·ラフナヴィネス、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411130733,
					"content": "可能性はあると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130734,
					"content": "同等の代価を投じれば、不吉な種はどんな場所でも芽生えてくる…ファデュイ、覚えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411130735,
					"content": "奇跡が起こる可能性もありますぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130736,
					"content": "群星の使者、我が優秀なる部下よ！闇の侵蝕からあなたを守るため、部下を貸してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411130737,
					"content": "私のことですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130738,
					"content": "いやいや、今の戦闘力のままで十分バランスがいいとオイラは思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130739,
					"content": "私を甘く見てます？私はかなり強いんですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130740,
					"content": "あなた以上に信頼できる方はいません。しかし、お嬢様はあなたが心配なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130741,
					"content": "必要ありません。むしろ、あなたたちの方が危険なので、私が守ってあげたいくらいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130742,
					"content": "モナは優しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "きゅ、急にどうしたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130746,
					"content": "まずはトラブルを解決しましょう。悠長に構えていたら、また<color=#00E1FFFF>巨大な隕石</color>が落ちてきますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130744,
					"content": "フィッシュルは優しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "あ、当たり前でしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "フィッシュル"
				}
			]
		},
