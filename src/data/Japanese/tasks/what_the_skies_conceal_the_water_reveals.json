				"objectNames": [
					"経綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "冒険者協会の者だけど、この辺りは隕石の影響を受けたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130202,
					"content": "冒険者！ちょうどよかったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411130203,
					"content": "ここ数日、隕石がたくさん落ちてきて大変だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411130204,
					"content": "<color=#00E1FFFF>田んぼ</color>に落ちると収穫ができないし、<color=#00E1FFFF>家の前</color>に落ちると出入りもできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411130205,
					"content": "隕石をなんとかできないだろうか？本当に邪魔なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "経綸"
				},
				{
					"id": 411130206,
					"content": "軽策荘も大変そうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "仕方ない、やってやるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
