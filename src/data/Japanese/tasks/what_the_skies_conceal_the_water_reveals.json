			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "モナ！おかげで隕石をたくさん片付けられたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130102,
					"content": "あ、ちょうどよかったです！お願いしたいことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130103,
					"content": "この隕石が誰かの命ノ星座だって言ったのは覚えてますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130104,
					"content": "星々が突然墜ちる、普通ではありえませんが、ただ事実として起こりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130105,
					"content": "この謎を解くには、命ノ星座の主を調べる必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130106,
					"content": "隕石の影響を受けた者は雪山の夢を見ると言っていましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130107,
					"content": "未知なる高山、雪に覆われた地…ドラゴンスパインのような知られた場所でもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130108,
					"content": "皆さんが全く同じ夢を見たのか、また夢の中でどんな場所にいたのか、それが重要です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130109,
					"content": "夢に関する情報を集めてきてくれませんか。情報が多いほど真相は掴みやすいですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130110,
					"content": "なら、人の多い場所に行って調べないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130111,
					"content": "あと患者たちの話も聞かないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130112,
					"content": "私は干渉を受けない場所にいないといけませんから、調査はお願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130113,
					"content": "まだ行ってない場所とかあるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130114,
					"content": "璃月には<color=#00E1FFFF>軽策荘</color>という場所があります…「人の多い場所」ではありませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130115,
					"content": "望舒旅館のように、患者を受け入れる場所にされている可能性があるかと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オズ"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
