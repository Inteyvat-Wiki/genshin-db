			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "モナ、聞いてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130702,
					"content": "高くそびえ立つ雪山、そこから闇が芽生えているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411130703,
					"content": "雪山？それだけですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130704,
					"content": "みんな同じ雪山の夢を見てた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "高くそびえ立つ、見たことのない雪山、とても寒くて、夢の中の人たちはみんな山頂まで登ろうとしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130706,
					"content": "山頂まで登ろうとする…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130707,
					"content": "一体、どんな人が山を登ろうとしていたのでしょう？その上、他人に影響を与えてしまうほど強い念などありえるのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130708,
					"content": "雪山に迫害を受けて死んだ者がいるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411130709,
					"content": "もしくは…雪山への挑戦を渇望する者でしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411130710,
					"content": "もう一度やってみます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130711,
					"content": "見えました！新たな情報です。その人物の名は…<color=#00E1FFFF>レーナルト</color>です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130712,
					"content": "えっ！？もう分かったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411130713,
					"content": "だから私は天才だって言ってるではありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411130714,
