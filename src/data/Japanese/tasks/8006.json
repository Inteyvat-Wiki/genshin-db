			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "質素なヒルチャールの集落だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80060402,
					"content": "うぅ、ここにもかわいそうなヒルチャールがいるぞ。それに、もう動いてないやつも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80060403,
					"content": "ハールヴダンがオイラたちに見せたかったのは、これなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80060404,
					"content": "どちらにせよ、調べる価値はある。ここ一帯を調査するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
