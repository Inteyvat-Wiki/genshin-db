				{
					"id": 80060602,
					"content": "いや、違う…気を付けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80060603,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80060604,
					"content": "な、なにが起きたんだ！？前にあった真ん中の部屋から放たれた光か？うぅ、目が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80060605,
					"content": "まだ異変は続いている。どうやらアビスが動き出したようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80060606,
					"content": "ダインスレイヴ…なんとも執念深いやつだ。しかも、殿下の血縁者と再び手を組むとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80060607,
					"content": "前回、転移網の確認が遅れ、お前をここに送ってしまったのは…失態だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80060608,
					"content": "ふっ、逃げるばかりの臆病者だった貴様が、俺の正面に立つとはな…何が貴様にそのような勇気を与えた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80060609,
					"content": "我々は殿下のご意志を貫き、邪魔者を排除しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80060610,
					"content": "そして、此度こそ…民を苦しめ続ける呪いを、すべて取り除く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80060611,
					"content": "あいつらを苦しめているのは貴様たちのほうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80060612,
					"content": "あのヒルチャールたちには呪い以外、何も残っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80060613,
					"content": "もう退きはせぬ。さあ、来い、ダインスレイヴ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80060614,
					"content": "そのくだらない意志とやらのために、命を賭けてまで時間を稼ぐ必要があるのか？ふん、死に急ぐのであれば、望み通りにしてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				}
			]
		},
