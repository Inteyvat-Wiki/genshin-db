					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "ゆっくりできたかい？気になる人と、気になる話を全部話せたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950502,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "じゃあ、もう少し休むといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950506,
					"content": "カテリンド、落ち着いて聞いてくれ。君を尊重していないわけじゃない…冗談でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950507,
					"content": "——君のお姉さんは、死んでいないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950508,
					"content": "お墓があったんですよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950509,
					"content": "お姉ちゃんの姿も、刻まれていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950510,
					"content": "でも…誰も埋葬されていないって可能性もあるんじゃないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950511,
					"content": "オイラだってカテリンドのお姉ちゃんが無事だといいなと思うけど、それは流石に楽観的すぎないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950512,
					"content": "お姉ちゃんから貰った最後の手紙にも、決心したって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950513,
					"content": "命を絶つとは書かれてなかった…そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950514,
					"content": "でも、とても遠い場所へ行くとありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950515,
					"content": "彼女は言っていた。年を取る前に世界を巡るのが夢なのだと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950516,
					"content": "きっと、「遠い場所」というのは言葉通りの意味なんだよ。ヒルダは療養所を出て、世界を巡る旅に出たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950517,
					"content": "お姉ちゃん…あなたにはそんなことまで話していたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950518,
					"content": "彼女はいつも明るくて、みんなと仲良くやっていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950519,
					"content": "でも、私たちに身寄りがないってことは、話していなかったみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950520,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950521,
					"content": "これは考え得る、一番ひどい可能性ですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950522,
					"content": "あの人がこの世を去ることで三人、四人もの人々が心を痛めるのなら、その重さは悲しみに打ち勝てたのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950523,
					"content": "でも、もう姉の周りには私しか残ってなかったんです。私なら理解して、許してくれるだろうって…きっと、分かってたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950524,
					"content": "きっとそんなことない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950525,
					"content": "慰めはいりません。子供のころは両親もいて…みんなで幸せに暮らしてました。その楽しい思い出だけで、私たちは大人になるまで頑張れたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950526,
					"content": "でも、大人の世界は本当に厳しかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950527,
					"content": "私は昔から引っ込み思案で、働いている時も、人付き合いでうんと疲れちゃうんです。小さい頃は、社交的なお姉ちゃんならうまくやれると思ってましたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950528,
					"content": "お姉ちゃんも大人になってからは、いつも疲れた表情を浮かべていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950529,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950530,
					"content": "君たちにはまだ未来がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950531,
					"content": "婚約者がいたことも、聞いてないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950532,
					"content": "姉の婚約者は、面白くて優しい人でした。むしろ悪い人だったら、よかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950533,
					"content": "彼の家系は短命でした。遺伝性の奇病で、みんな若くして亡くなってしまうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950534,
					"content": "風神がモンドを素晴らしく作りすぎたせいで、うちの家系のような本来途絶えるべき血筋まで続いてしまったんだ——そんな冗談を、たまに言ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950535,
					"content": "その後、彼は世界を救いにいくとか言って、どこかへ行ってしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950536,
					"content": "世界を救う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950537,
					"content": "私たちの世界が今もこうして続いているのは、もしかしたら本当に、彼がどこかの片隅で世界を救ったからかもしれないですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950538,
					"content": "「永い時の中で、全員に愛され、全員を愛さなければ、世界は悲哀に沈んでしまう。」——あなたたちは、そう言ってましたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950539,
					"content": "ごもっともだと思います。儚い命には、愛する資格なんてないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950540,
					"content": "彼は人生をかけて姉を愛そうとしましたが…結局、姉の心をひどく傷つけただけでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950541,
					"content": "そして、最終的に姉は山奥の療養所…私たちの下にある、呪われた療養所に追いやられてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950542,
					"content": "僕にはそんな話、一度もしてくれなかったよ…すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950543,
					"content": "これを聞いてもまだ、お姉ちゃんが生きているという推測を曲げないつもりですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950544,
					"content": "ああ。彼女はここで、とあることをしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950545,
					"content": "僕の弱さ故に、彼女は生き続けなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950546,
					"content": "イストリアさん…非難するつもりはないんです。でも…あなたは長い歴史の中で、あまりに多くの苦難を目にしすぎてしまったんじゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950547,
					"content": "世界を何度も飲み込める悲しみの砂は、ほんの一掬いだけで、私が送るような平凡な人生を覆い隠してしまうんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950548,
					"content": "私とお姉ちゃんのことを、あなたは…きっと理解できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950549,
					"content": "どうすれば、地上に戻れますか？私みたいな取るに足らない存在は、永遠には値しません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950550,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950551,
					"content": "どうしました、イストリアさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950552,
					"content": "…かつてここは地上と断絶されていて、ここを離れることなんて絶対に不可能だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950553,
					"content": "でもニヒリットが堕天した後は、みっちゃんに君たち現世の人を、神殿と地上の間で行き来させる能力が備わったらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950554,
					"content": "でも、選ばれてここにやって来た人間を連れ出すことはできない。なぜなら、みっちゃんは守護者の幼体そのもので、自身に刻まれた規{RUBY#[D]ルール}則には抗えないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950555,
					"content": "ええっ？みっちゃんはニヒリットと同じような存在だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950556,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950557,
					"content": "地上へ降りるには、記憶と知識をすべて捨てる覚悟で、一番高い場所へ登るしかない。そうすることで、会えるんだ。昔はここの女神に…今は、メランタに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950558,
					"content": "僕は君たちと一緒に降りられない。だからせめて、送り届けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950504,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "イストリア"
				}
			]
		},
