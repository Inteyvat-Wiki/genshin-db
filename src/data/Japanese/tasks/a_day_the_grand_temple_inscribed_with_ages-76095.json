						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "イストリア、三つのエリアはほぼ解放できたぜ。人もだいたい救出できたしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950302,
					"content": "カテリンドの失くした物も全部見つかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950303,
					"content": "おお、本当にありがとう。ニヒリットのやつ…開眼してから人を見る目に磨きがかかったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950304,
					"content": "今度はそっちが上に行く方法と代償について話す番だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950305,
					"content": "ちょっとした冒険が必要とか、ちょっとモラが必要とかなら全然いいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950306,
					"content": "あと、カテリンドを下に送る方法も教えろよな。あいつの用事はもう済んでるんだしさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950307,
					"content": "もちろんさ。だが、ひとまず休んでくれ。詳しいことは明日説明するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950308,
					"content": "わかったぞ。でもここ、ベッドも食べるものもないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950309,
					"content": "ここでは欲望が止まるんだ。ほら、ここにこんなに長くここにいるのに、お腹も空いてないし、眠くもないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950310,
					"content": "ええっ！じゃあオイラ、なにして休めばいいんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950311,
					"content": "ここには古今東西の奇人や異才がいるから、彼らとおしゃべりしてみるのも面白いと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950312,
					"content": "#なるほどな。でも、オイラはなにがなんでも寝るぞ。眠くなくても{NICKNAME}の頭の上で寝てやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950313,
					"content": "カテリンド…十分休んだら、話をしたい。以前、考える時間が欲しいと言っていた件についてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950314,
					"content": "後で僕のところに来てくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 760950315,
					"content": "わかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}、パイモン。十分休めたら、僕のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イストリア"
				}
			]
		},
