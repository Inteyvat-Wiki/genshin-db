						],
						"pointId": 266
					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}さん、パイモン、ありがとう。最後にあなたたちと知り合えて本当によかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950102,
					"content": "へへっ、むしろオイラたちと一緒にいたせいで、こんなことに巻き込んじゃったような気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950103,
					"content": "っておい、「最後に」ってどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950104,
					"content": "危険な冒険ばかりでしたけど、たくさんの不思議な物を見ることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950105,
					"content": "そう思うと、悪くなかったなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 760950106,
					"content": "はぐらかすなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760950107,
					"content": "はぐらかしてないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カテリンド"
				}
			]
		},
		{
			"id": 7609503,
			"completionStepIds": [
				7609503
			],
