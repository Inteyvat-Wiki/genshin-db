					"孫宇",
					"小鳥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "頭痛を治すために取ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "兄さん、薬がほしいなら私が取って来ればいいのに、どうして知らない人に頼むの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010603,
					"content": "それに、この人の正体も知らないし、何かあったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010604,
					"content": "…小鳥、助けてくれた者にそんなことを言ってはならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010605,
					"content": "ありがとう、お礼を受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010606,
					"content": "受け取ったら早く行きなさい。風に吹かれたら兄さんの頭痛がまたひどくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010607,
					"content": "兄さん、あそこなら風避けできるし、砂糖水を温めてあげるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小鳥"
				}
			]
		},
