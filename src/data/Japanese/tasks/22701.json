					"content": "君、少し止まってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010102,
					"content": "君の身のこなしを見たが、私たちと同じ武を学ぶ者だろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
