			"dialogs": [
				{
					"id": 227010701,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の喉を治すために取ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "ちょっと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010703,
					"content": "…私はそんなに弱くないし、喉も痛くないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010704,
					"content": "でも、これらの清心は兄さんの頭痛を治すのにちょうどいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010705,
					"content": "小鳥、ちょっと聞いてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010706,
					"content": "兄さん、風のない場所で少し休んでて、あとで砂糖水を温めてあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010707,
					"content": "あんた、これを受け取ってさっさと消えなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小鳥"
				}
			]
		},
