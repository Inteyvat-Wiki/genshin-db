			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "話したいことがあるならどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "兄さんがあんたに話かけてやってるの、ちゃんと答えなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010203,
					"content": "小鳥、私から先に話をかけたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010204,
					"content": "こいつも仙人との縁を求めに絶雲の間に来たかもしれないでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010205,
					"content": "まあまあ、小鳥はここで少し休め。この者と少し話してくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010206,
					"content": "兄さん、話があるなら、ここですればいいじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010207,
					"content": "ただの雑事だ、小鳥の耳に入れなくていい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010208,
					"content": "フン、きっと古華派のことでしょ…分かった、聞いてほしくないなら聞かないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 227010209,
					"content": "では、君、私と共にあちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
