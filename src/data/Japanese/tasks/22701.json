					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "ここでいいだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010402,
					"content": "一体どうした…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "はあ、私の妹弟子小鳥のことだ。私たちは毎日一緒に稽古してたから、彼女の腕も私に負けてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010404,
					"content": "しかし今回絶雲の間に来る道はかなり大変で、彼女は数日前に風邪を引いて、喉を痛めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010405,
					"content": "君にはすぐそこの崖から清心を三つ取ってきてほしいんだ。それを水に浸けると喉にいいらしいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010406,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "では頼む。小鳥を一人にすることはできないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010408,
					"content": "どうして彼女に内緒にしてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "見苦しいところを見せたな。小鳥のやつは幼い頃から負けず嫌いで強がりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010410,
					"content": "もし彼女の前で薬を取ってきてほしいと頼んだら、きっと彼女は薬を飲んでくれないはずだ。だから内緒にしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010411,
					"content": "彼女を置いて一人で薬を取りに行くのも怖いし、だから君に頼むしかなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
