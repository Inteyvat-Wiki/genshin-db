			"dialogs": [
				{
					"id": 227010501,
					"content": "戻ってきたな、君に頼んだことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010502,
					"content": "持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "これでいい。ありがとう、どうかお礼を受け取ってほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 227010504,
					"content": "ん？どうしてこんなに清心を持ってるの？兄さん、また頭痛なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小鳥"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
