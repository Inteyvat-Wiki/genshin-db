			"dialogs": [
				{
					"id": 721520101,
					"content": "「…ここはかつて大海賊林蔵が宝を保管していた地。仲間たちが最後の宝箱をいくつか運び出した…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "宝盗団のノート"
				},
				{
					"id": 721520102,
					"content": "「…だが林蔵は生前、とても狡猾で、島に様々な印を残した…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "宝盗団のノート"
				},
				{
					"id": 721520103,
					"content": "「…目くらましかもしれないし、本当にお宝があるのかもしれない。確かめるには、前に進み自分で探求するしかない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "宝盗団のノート"
				},
				{
					"id": 721520104,
					"content": "「…すでに印をいくつか見つけた。林蔵の宝をすべて掘り起こしに行く。もう待ちきれない！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "宝盗団のノート"
				},
				{
					"id": 721520105,
					"content": "うーん…長い…「お宝」以外の字はまったく読みたくないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721520106,
					"content": "ん…？お宝！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "パイモン"
				},
				{
