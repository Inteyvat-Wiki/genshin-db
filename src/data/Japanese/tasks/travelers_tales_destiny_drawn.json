			"dialogs": [
				{
					"id": 727380101,
					"content": "うむ…そんなところじゃ。軽く掃除すればよい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380102,
					"content": "おや？童よ、奇遇じゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380103,
					"content": "奇遇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "おや、「また面倒事を押し付けてきそうだ」とでも考えてそうな顔をしておるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380106,
					"content": "安心するがよい。たった今、社の改修を終えて、新しい業務を始めようとしていたところじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380107,
					"content": "まだ公表しておらぬのに汝がやってきたのじゃから、奇遇といえるじゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380108,
					"content": "ほれ、妾の横にある賽銭箱が見えるか？願い事をする場所が増えたのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380109,
					"content": "もうおみくじがあるけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "それは違う。おみくじは運勢を占うもの、これは…「願い事」をするためのものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380111,
					"content": "目を閉じて願いを心に思い描く。そして、その願いを絵馬に書き、横の絵馬掛けに吊るす。そしたら、願いが叶うかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380112,
					"content": "どんな願いでもいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "もちろん。じゃが、具体的にどれくらい実現するかは、神様次第といったところじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380114,
					"content": "妾は役立たずの宮司じゃからのう。せいぜい人間関係の面で、何か策を出してやることくらいしかできぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380115,
					"content": "新しい友達に会えたら嬉しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "それが汝の願いであれば、試してみるがよい。ほれ、この「みくじ短冊」を持っていけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380118,
					"content": "これは「おみくじ」を書く時に残ったものじゃ、汝にくれてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380119,
					"content": "願い事をそこに書いてからお祈りすると、もっと効果があるかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380120,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "おや、妾が嘘をついたことがあったか？早く、願い事をしに行くがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380122,
					"content": "願いを書いた「みくじ短冊」を絵馬に貼り付け、最後に絵馬掛けに吊るす…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380123,
					"content": "これで、完了じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380124,
					"content": "うむ、心が込もっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380125,
					"content": "本当に効果あるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "さあ、引き続き頑張るがよい。ちゃんと目を見開いておくことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380127,
					"content": "もしかしたら、汝が会いたい人は、どこかのラーメン屋でラーメンを食べておるかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 727380116,
					"content": "旧友たちに会うのも悪くない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "待って、その言い方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}