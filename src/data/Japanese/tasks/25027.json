					"ミル·ヌイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "パッカのやつ…本当に話の分からねぇ野郎だぜ！あいつは俺の音楽の理想を理解してないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270102,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "えっと、あんたは…旅人か？俺はミル·ヌイ、よろしくな。ミュージシャンをやってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270105,
					"content": "もし「花歌レコード」に行ったことがあるんなら、ポップスのコーナーで俺の作品を見たことがあるはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270106,
					"content": "俺のアルバムには、「ポップス」に対する俺なりの解釈が込められてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270107,
					"content": "だがパッカのやつだけは俺の音楽をちっとも分かっちゃいない。俺の音楽は「ポップス」っていうよりも「童謡」に近いだなんて言いやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270108,
					"content": "どんなに説得しても、必ず俺のレコードを童謡コーナーに置きやがるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270109,
					"content": "いや…確かに子どもたちには人気だよ。子どものプレゼントに買っていく親もいるしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270110,
					"content": "で、でもよ…子どもは一番鋭いリスナーなんだからな！部族全体で見ても子どもはたくさんいるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270111,
					"content": "俺のアルバムがたくさんの子どもたちの間でそんなに流行ってるなら…やっぱり！ポップスコーナーに置くべきだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270112,
					"content": "まぁ、確かに一理あるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "だろ？フン、やっぱりパッカに見る目がないってことだよな。次の新曲ができたら、あいつも絶対に降参するはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270115,
					"content": "俺はパッカの音楽センスが信じられない…なぁ旅人、あんたは音楽について詳しいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270116,
					"content": "うーん…音楽なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "何か楽器はできるか？歌でもいいぜ、鼻歌でもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270118,
					"content": "なんでも得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "それはよかった！あんたなら、絶対俺の音楽理念を理解してくれると信じてるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270122,
					"content": "俺の新曲作りを手伝ってくれそうな、あんたみたいな人を探してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270123,
					"content": "心配すんなって。報酬ならたっぷり用意するからさ。絶対損はさせないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270124,
					"content": "よし。じゃあ直感で教えてくれ。俺がサイコーな音楽を創作するためには、まずどうすればいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270120,
					"content": "何もできない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "大丈夫！あんたみたいな人だけが心から音楽を楽しめるんだ。きっと客観的かつフェアに評価してくれるはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270113,
					"content": "確かに「キッズポップス」と言えるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "音楽の理想って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
