			"dialogs": [
				{
					"id": 250270401,
					"content": "前にいる鳥たちを見ろ、実に素晴らしい！あの鳴き声…素材として使えるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270402,
					"content": "でも、数匹じゃ、鳴き声が小さすぎる。もし後で群れを見つけられたら、その鳴き声を録音したいところだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270403,
					"content": "待った、あそこにいるのはコホラ竜の群れだな。爪で石をひっかく音が聞こえたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270404,
					"content": "…あいつらは警戒心が強いから近づけない。今度部族の専門家に素材集めを手伝ってもらうとするか。彼らはこういうのが得意だしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270405,
					"content": "あれは…力比べをしてる最中の部族の戦士たちだな。よしよし、こういうリアルな戦闘音はすごくいいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270406,
					"content": "おい！そこで見てるのは誰だ！ケンカ売ってんのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "荒っぽい部族の戦士"
				},
				{
					"id": 250270407,
					"content": "いや、俺達はただ、素材集め…を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250270408,
					"content": "素材集め？なら心ゆくまで取材させてやろうじゃねえか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "荒っぽい部族の戦士"
				},
				{
					"id": 250270409,
					"content": "#た、助けて！{NICKNAME}、この人を止めてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				}
			]
