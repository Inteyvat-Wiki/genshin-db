					"nextDialogs": [
						250271602
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250271602,
					"content": "音楽の理想はどうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271603
					]
				},
				{
					"id": 250271603,
					"content": "#{NICKNAME}、また会えて嬉しいぜ。音楽の理想についてだが、まあ…突破口を精一杯探してるみたいな感じさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
