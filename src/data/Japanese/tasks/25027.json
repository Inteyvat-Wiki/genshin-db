					"ハロア·ヌイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "わあ！また新曲が出たのね。竜の赤ちゃんたちもきっと大喜びだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "ハロア·ヌイ"
				},
				{
					"id": 250270302,
					"content": "ミル·ヌイのアルバムについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "私、ミルおじさんの曲が大好きなの。でも、うちの竜の赤ちゃんたちなんか、もっとお気に入りよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "ハロア·ヌイ"
				},
				{
					"id": 250270304,
					"content": "みんながはしゃいで大暴れしてると、ママがミルおじさんの曲を流すの。それであっという間に落ち着くんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "ハロア·ヌイ"
				},
				{
					"id": 250270305,
					"content": "うーん、でもおじさんの曲って長すぎて歌詞が覚えられないのよね。だからあの子たちに歌って聴かせてあげられないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "ハロア·ヌイ"
				},
				{
					"id": 250270306,
					"content": "ふふっ、ミルおじさんにはもっと短い歌詞を書いてもらいたいわ。そうしたら私が毎日歌ってあげられるもの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハロア·ヌイ"
				}
			]
		},
