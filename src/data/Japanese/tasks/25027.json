				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "ミルさん、また新曲を出したんだ。うーん…買おっかなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "マヒナ·ヌイ"
				},
				{
					"id": 250270202,
					"content": "ミル·ヌイのアルバムについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "ん？彼のアルバムは最高だよ！ハロアや竜の赤ちゃんたちのお気に入りなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "マヒナ·ヌイ"
				},
				{
					"id": 250270204,
					"content": "はしゃいじゃって寝ない時は、いつもミルさんの『おお、春よ』をあの子たちに聴かせるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "マヒナ·ヌイ"
				},
				{
					"id": 250270205,
					"content": "あの子たち、聴いてるうちに眠っちゃって、しかも朝までぐっすりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "マヒナ·ヌイ"
				},
				{
					"id": 250270206,
					"content": "まあ…でもハロアは「もっと激しい曲がいい」っていつも言ってるけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "マヒナ·ヌイ"
				},
				{
					"id": 250270207,
					"content": "ミルさんがもっと賑やかな感じの曲を出してくれたらいいんだけどな。そしたらハロアもきっと喜ぶだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マヒナ·ヌイ"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
