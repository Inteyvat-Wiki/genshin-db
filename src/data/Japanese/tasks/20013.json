					"speakerTitle": "ジャック"
				},
				{
					"id": 200130205,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "はあ、君のようになれば、僕も偉大な冒険者になれるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130206,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "頼む！僕の偉大なる冒険の旅はここで終わらせるわけにはいかないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
