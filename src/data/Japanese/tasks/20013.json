				{
					"id": 200130301,
					"content": "ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130302,
					"content": "スタンレーさんが冒険した場所に行ってみようと思ったけど、まさか途中でこいつらに出くわすなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130303,
					"content": "やっぱり僕は弱いんだ。スタンレーさんだったらこいつらを全員倒せるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130304,
					"content": "君が一緒に冒険してくれたら…いや、他人にばかり頼るわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130305,
					"content": "冒険を再開するよ。これは君にあげる。食料としてたくさん取ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200130306,
					"content": "まあ、これは「食料」とは言えないかな、ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
