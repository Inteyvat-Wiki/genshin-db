				{
					"id": 220230301,
					"content": "ああ！間違いありません！こ、これこそが夢にまで見た故郷の味…まさに…うう…感動です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230302
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230302,
					"content": "ありがとうございます！これほど美味しいものを食べることが出来て、私もやる気が出てきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230303
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230303,
					"content": "これはお礼です、あなたのこれからの旅が順調でありますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
