			"dialogs": [
				{
					"id": 220230201,
					"content": "もう戻ってきたのですか？まさか正体を隠した料理人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230202,
					"content": "うぅ…もう待ちくたびれました。一口でも食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230203,
					"content": "ごゆっくりどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "さっき話した料理は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "モラミート、干し肉の炒め鍋、お肉と野菜のシチューだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220230206,
					"content": "決めたら湯雯さんに渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
