			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "うぅ…璃月料理が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "あなたは？その格好…あなたが旅人ですね。失礼しました、私はただ故郷が懐かしくなってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230104,
					"content": "璃月料理が食べたいって言ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "え？もしかして…璃月料理を作れるのですか？助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230119,
					"content": "そ、それでは早速お願いします。本場の璃月料理を食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230120,
					"content": "悩みますね…私が今一番食べたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230121,
					"content": "そう！お肉！お肉をたくさん食べたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230122,
					"content": "繊細な食感、お肉の脂と璃月独特の調味料が融合し、絶好の香りを漂わせる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230123,
					"content": "そのようなお肉を想像しただけで、鳥肌が立ってきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230124,
					"content": "とにかく、お肉が食べたいです！お肉を使った璃月料理を作ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230105,
					"content": "何かお困りごとでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "まずは自己紹介させてください。私の名前は湯雯。璃月の歴史学者で、稲妻の特徴的な風習や民話を調査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230107,
					"content": "現地での情報収集がほぼ終わり、璃月に帰る予定でした。しかし、稲妻の鎖国令が原因で、ここに留まらざるを得なくなってしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230108,
					"content": "しかし実は、運が良かったとも思っています。何故なら今稲妻は、歴史的な瞬間を迎えていると感じているからです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230109,
					"content": "今のこの状況は、必ずテイワットの歴史に大きな足跡を残すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230110,
					"content": "そのような歴史を自分の目で確かめ、全てを正しく記録し、子孫へと残すことこそが歴史学者の使命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230111,
					"content": "しかし…どんなにやりがいのある仕事でも…私のお腹を満たすことはできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230112,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "お腹が空いた…というわけではありませんが、フフッ、稲妻の料理も美味しいとは思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230114,
					"content": "ここの「天ぷら」が特に好きです。ただよく考えてみますと…衣を包んで油で揚げただけのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230115,
					"content": "長い間稲妻料理しか食べていないので、璃月料理が食べたくなりました。しかし、本場の璃月料理が食べられるお店はなかなか見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230116,
					"content": "先日、勢いで冒険者協会に行って「料理依頼」を出したのですが、なかなか引き受けてくれる人がいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230117,
					"content": "試してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
