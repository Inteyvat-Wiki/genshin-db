			"dialogs": [
				{
					"id": 220230801,
					"content": "肉料理か。どれを作ればいいんだろうな？あの人の代わりにオイラたちが選んでやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220230802,
					"content": "そうだな…オイラが好きな肉料理は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220230803,
					"content": "璃月風モラミート！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230804
