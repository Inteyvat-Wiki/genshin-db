						220230812,
						220230814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220230808,
					"content": "モラミートにする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230809
					]
				},
				{
					"id": 220230809,
					"content": "いいと思うぞ！じゃあさっそくモラミートを作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220230810,
					"content": "干し肉の炒め鍋にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230811
					]
				},
				{
					"id": 220230811,
					"content": "よーし！じゃあさっそく干し肉の炒め鍋を作って、湯雯さんに食べさせてあげよう！",
