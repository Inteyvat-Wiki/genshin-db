					"nextDialogs": [
						220230807
					]
				},
				{
					"id": 220230807,
					"content": "えへへ、オイラのセンスを信じろ！さあ、早く一つ選ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230808,
