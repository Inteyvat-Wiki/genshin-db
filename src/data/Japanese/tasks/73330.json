				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ",
					"マルコゾフ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "ほら、そこの腹黒人間、さっさとここから離れたほうがいいワ。我ら花霊の伝統と秘密は、汝らが勝手に触れていいモノではないノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733300702,
					"content": "花霊？花霊だと！なんと摩訶不思議な体験！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300703,
					"content": "#おお！それに{M#精悍な少年}{F#可愛らしいレディー}と、こちらは{M#彼の}{F#彼女の}…ペットですかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300704,
					"content": "わっ！なんて失礼なやつだ！オイラはこいつの最高の仲間なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733300705,
					"content": "仲間…おお、もちろん、もちろん！最高の仲間、なんと美しい響きか！私も子供の頃から「最高の仲間」に憧れていたものです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300706,
					"content": "#{M#精悍な少年}{F#可愛らしいレディー}よ、しかし「最高の仲間」は二人も必要ないのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300707,
					"content": "どういうこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "いえ、私が言いたいのはですね…いかに君だろうと、今の状態は…いささか贅沢がすぎるんじゃないかということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300711,
					"content": "不公平ではありませんか…ですからここはひとつ、花霊を私に譲ってはいただけないでしょうか。花霊への待遇については、その役割を全うさせますから、どうかご心配なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "マルコゾフ"
				},
				{
					"id": 733300712,
					"content": "無礼者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733300713,
					"content": "なんて理不尽なやつだ、全然話が通じないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733300714,
					"content": "世の中には会話よりも効果的な手段があるワ…聡明なる我が「謁賛主」なら、私の言っている意味が分かるデショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733300715,
					"content": "つまり、あいつをボコボコにしてやろう、ってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733300716,
					"content": "フン、白フラは引っ込んデ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733300708,
					"content": "仲間が増えるのは歓迎だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "そんなのあり得ないぞ！ぜーったいダメだ、おまえの「最高の仲間」はオイラだけだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}