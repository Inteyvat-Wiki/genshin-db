			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "いい感じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "いつも気づくと高いところを飛んでいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}！探したんだよ！この前あげた風の翼はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810104,
					"content": "結構、楽しんでるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810105,
					"content": "けど、飛行免許はまだ持ってないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810106,
					"content": "飛行免許？なんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810107,
					"content": "名前のまんまなんだけど、その飛行免許を持っている人だけが、このモンド城内を飛行できるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810108,
					"content": "#えっ…{NICKNAME}、もう結構飛んでるぞ…そんな話、全然聞いたことない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810109,
					"content": "毎日あちこち飛んでたから、みんなの目に留まったみたいだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810110,
					"content": "えへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810111,
					"content": "じゃあ、今日は飛行免許を届けにきてくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810112,
					"content": "まさか！騎士にだってちゃんと規則があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810113,
					"content": "飛行免許はテストに合格してから騎士団が発行するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810114,
					"content": "今日は試験官として、あんたの飛行免許のテストを監督しに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810115,
					"content": "風の翼を渡したのはわたしだからね、責任を持たないと——きっと、ジンさんもそう言うし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810117,
					"content": "ちょっとくらいズルしても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "自力で合格する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "テスト…なんか面倒だな。でも、アンバーが試験官なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810118,
					"content": "そんな目で見ないで、絶対にダーーメだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810120,
					"content": "#うん、{NICKNAME}なら楽勝だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810121,
					"content": "それに簡単な試験だから安心して。風魔龍を撃退した時の飛行ができれば問題ないはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810122,
					"content": "でも、規則と飛行基準は守らないとダメだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810123,
					"content": "この『飛行指南』をあげる。覚えなくてもいいけど、理解はしておいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810124,
					"content": "たとえば、二人で風の翼を使うのは禁止とか、重い荷物を持って飛ぶのは禁止とか、風スライムを使った飛行は禁止とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810125,
					"content": "とにかく、よく読んでおいて。リサさんに魔法を教えてもらった時だって、わたしも厚い本をたくさん読んだんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810126,
					"content": "ぶ厚いな…仕方ない、とりあえず読んでみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810127,
					"content": "うん！読み終えたら風立ちの地に来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4810401,
					"content": "西風騎士団の『飛行指南』、タイトルからして難しそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810402,
					"content": "とりあえず読んでみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "寓話みたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "ロマンチックだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "いい話だったな…けど、騎士団の『飛行指南』って…こんな感じなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4810604,
					"content": "とにかく、アンバーのところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}