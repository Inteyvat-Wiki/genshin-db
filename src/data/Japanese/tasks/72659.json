			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726590101,
					"content": "「海中月」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590102
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590102,
					"content": "「海中月」ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590103
					]
				},
				{
					"id": 726590103,
					"content": "あっ、こんにちは！君がその…冒険者協会から来た釣り人なんだね？私は鯨井椛、稲妻の漁師よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590104
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590104,
					"content": "すでに釣り協会から君のことについて聞いてるよ。今日会ってみて、若くて才能のある人だと分かった。やっぱり私は間違ってなかったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590105
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590105,
					"content": "私は近ごろ伝説の大魚を探してるの。「海中月」といって、伝説では、人々の願いを叶えることができるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590106
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590106,
					"content": "えっ——願いを叶える大魚！オイラの好きな伝説の物語だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726590107,
					"content": "うん、みんなはただの物語だと思うかもしれないけど…私は本当のことだと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590108
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590108,
					"content": "なぜなら、何年か前、私は「海中月」に本当に遭遇したから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590109
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590109,
					"content": "じゃあ願いは叶った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590110
					]
				},
				{
					"id": 726590110,
					"content": "まあ…そうと言ってもいいわね。詳しいことを説明すると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590111
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590111,
					"content": "何年か前、それぞれの願望をもとに、私は嘉瑋とナンタックという二人の友達と一緒に海に出て、伝説の「海中月」を捕まえに行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590112
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590112,
					"content": "だけどその旅路は順調なものじゃなく、私たちは雷雨に見舞われた。漁船はなんとか持ちこたえたけど、コンパスが完全に壊れて、私たちは未知の海域で遭難してしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590113
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590113,
					"content": "何日か経っても、家に帰る方法を見つけられず、真水も底を突いた。みんな口には出さなかったけど、心の中では絶望しきっていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590114
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590114,
					"content": "しかもある日の夜中、嘉瑋のやつ…こっそり遺書を書いて、漂流瓶に入れて海に投げようとしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590115
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590115,
					"content": "彼は私たちがまだ寝ていなかったことを知らなかった。私たちがそれに気付いて、彼を止めたの。そしてその時、海面の下に巨大な影が現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590116
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590116,
					"content": "その影は淡い光を放ち、星のように輝いていたの。まるで、月を砕いて海に落としたかのようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590117
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590117,
					"content": "あれが「海中月」だったのかな？行き場のなかった私たちは、慌てて願ったよ。その場所から無事帰れますようにと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590118
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590118,
					"content": "そう、あとは君にも分かるわよね。私たちは生き残った。あの影は、まるで魔力があるかのように遠くへと泳ぎ、私たちはそれに続いた。それが、私たちの帰った道だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590119
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590119,
					"content": "わぁ——すごく感動できる伝説物語だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726590120,
					"content": "これは本当のことよ！私を信じて。私たちは必ずもう一度それを見つけるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590121
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590121,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590122
					]
				},
				{
					"id": 726590122,
					"content": "まずは私の二人の旧友を訪ねるといいわ。彼らは経験豊富な漁師だから、彼らの手助けがあればだいぶ楽になるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590123
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590123,
					"content": "<color=#00E1FFFF>嘉瑋は璃月港にいる</color>。その時帰ってからまだどこにも行ってないのは知ってるわ。彼もきっと「海中月」に会いたいと思ってるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590124
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726590124,
					"content": "ナンタックはあれから海洋作家になったって聞いたわ。君たちが嘉瑋に会ったら、ナンタックがどこにいるか聞いてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
		{
			"id": 7265902,
			"completionStepIds": [
				7265902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
