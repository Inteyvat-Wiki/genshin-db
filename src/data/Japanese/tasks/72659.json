				"points": []
			},
			"dialogs": [
				{
					"id": 726590201,
					"content": "海は美女と同じで、たまに会えればそれでいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590202
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590202,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が嘉瑋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590203
					]
				},
				{
					"id": 726590203,
					"content": "ああ、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590204
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590204,
					"content": "おお——「海中月」！「海中月」のことか！あの時の経験は、本当に印象深いものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590205
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590205,
					"content": "鯨井のやつ、やっぱり忘れてなかったんだな。それもそのはず、あいつの願いは…うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590206
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590206,
					"content": "だったら、俺も君たちを精一杯祝福しよう。成功を祈ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590207
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590207,
					"content": "えっ？オイラたちはおまえを誘いに来たんだ。一緒に行かないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726590208,
					"content": "はぁ、むかし海に出た時に、危うく命を失くしかけたんだ…海ってのはな、美女と同じで、たまに会うだけでいいんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590209
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590209,
					"content": "それに、もう家庭を持つ男として、家族を放っておくわけにはいかないだろ？夫としての責任を全うしないといけない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590210
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590210,
					"content": "あれほど努力して、汗水たらして、やっと…あんな寛大で裕福な嫁と結婚できたんだ！だから、すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590211
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590211,
					"content": "旧友ががっかりすると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726590212
					]
				},
				{
					"id": 726590212,
					"content": "そんなこと言わないでくれ…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590213
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590213,
					"content": "俺は加入できないが、他の方法で君たちを手助けしよう。俺の釣り技術と経験をすべて君たちに授ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590214
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590214,
					"content": "「海中月」は伝説の生き物だ。簡単に釣れるもんじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590215
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590215,
					"content": "だから、俺の訓練を受け、俺の意志を引き継ぎ、神秘的な大魚を追ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590216
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590216,
					"content": "そうだ、君たち、ナンタックを探してるんじゃないか？慌てなくても、あいつは冬眠中の老いたウミガメのように、ずっとモンドにいるよ。確か、本を書いてるって言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726590217
					],
					"speakerTitle": "嘉瑋"
				},
				{
					"id": 726590217,
					"content": "だから今はまず、俺から繰り出される鬼の釣り訓練に集中するんだ！訓練が終わったあとに彼を訪ねればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉瑋"
				}
			]
		},
