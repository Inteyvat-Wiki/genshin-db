			},
			"dialogs": [
				{
					"id": 100040601,
					"content": "ふぅ、やっと片付いたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040602,
					"content": "おばばは、終わったら三通目の手紙を開けるようにと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040603,
					"content": "ですが儀式は成功していません…開けるべきでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040604,
					"content": "オイラ、おまえたち師弟の考え方が分かってきた気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040605,
					"content": "「終わったら開けろ」って言われただけで、成功したかどうかは指定されてないだろ？だから、開けてもいいと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040606,
					"content": "確かに。どうせ、おばばはろくなこと書いていない気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040607,
					"content": "「この文章を読んでいるということは、確かに試したということだね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040608,
					"content": "「まさか、本当にあれを試すとは…ヒッヒッヒッヒッ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040609,
					"content": "お——ば——ば——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040610,
					"content": "「カーンルイアには星海の湖が多数存在していて、空間的に不安定なところがある。だから、物理的ではない方法で天蓋バリアを貫通するほうが、成功しやすいんだよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040611,
					"content": "「それに、あそこは秘匿性が高く、人跡まれな地下に位置している。仮に失敗しても、周囲への被害が比較的少なくて済む。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040612,
					"content": "「わしの弟子であるおまえなら、偽りの空の外をさまようアビスの魔物にも、きっと対処できると信じている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040613,
					"content": "「勝てなくとも、逃げ切ることはできるだろう。おまえの逃げ足の速さは、なかなかのものだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040614,
					"content": "「あぁ、我ながら天才的だ。水占の術は雰囲気の面で、『渇』を癒す知恵とぴったり対応している。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040615,
					"content": "「実際の運用では、水占の盤も偽りの空の乱れを抑えてくれた。アリスは一体どうやってわしに勝つつもりなのか、本当に分からん——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040616,
					"content": "モナに続きは見なくていいと言われた。残りの数千字はおばばの自慢話だから、と。\\n観測結果を整理した後、みんなはモンドに戻った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
