							452.578,
							52.995,
							6035.06
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "ふぅ～、夏の思い出がいっぱい詰まった方法で来ると、気分もさっぱりするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040202,
					"content": "ここが地下の古国——カーンルイアの門なんでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040203,
					"content": "きっとその裏には、多くの秘密や悲しみが隠されているのでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040204,
					"content": "二通目の手紙を読んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040205,
					"content": "そうしましょう。えっと…番号が二の封筒は…これですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040206,
					"content": "「経典を解するは道を見るにあらず。智の水をもって知恵の渇きを癒やすべし——スメールの古い言葉だ。この地には『焚真の天象』と呼ばれる現象がある。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040207,
					"content": "「でも『焚真の天象』は、あまりにも真理を渇望したため、最終的に燃え上がってしまった。『渇真』と呼んだほうが、本質に近いかもしれん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040208,
					"content": "「地下の古国の記録によると、カーンルイアには鏡のように澄んだ地底湖がいくつかあり、真の宇宙の星々を映していたのだそうだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040209,
					"content": "「これはまさに、水によって開かれた『渇真の天象』が、偽りの空を越え、外の宇宙とつながっているからだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040210,
					"content": "そういうことでしたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040211,
					"content": "「偽りの空を突き抜けて初めて、宇宙の星々の引力や影響を観測できる。そして、これら世界の外のパラメータをもって初めて、世界の運命を算出できるんだよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040212,
					"content": "「カーンルイアの門の前で、『渇真の天象』を一度開くこと——これがわしの与える課題だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 100040213,
					"content": "後は、おばばが算出した儀式と方法ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040214,
					"content": "そうみたいだな。この惑星の軌道とか符文とかのことは、オイラさっぱりわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040215,
					"content": "モナ、今すぐ試してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040216,
					"content": "認めたくはありませんが、頭の中でおばばが開発した儀式のパラメータを計算してみたところ、どうやら本当に可能なようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040217,
					"content": "今、私はやる気も気合も十分です。それに、このまま戻れば一日分の宿泊費を無駄にしてしまいます。今やらずして、いつやるというのですか！始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040218,
					"content": "すべての恒星に通じる使者たちよ、黄と赤の道を治める放浪者たちよ、そして天上の輝ける兄たちよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040219,
					"content": "空虚の洞、曲がりくねった道。私、アストローギスト・モナ・メギストスは、ここに水をもって調和を配す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040220,
					"content": "知恵と真理をもって渇きを癒す。私、アストローギスト・モナ・メギストスが、星々の顕現を命ずる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040221,
					"content": "う、うまくいったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040222,
					"content": "うわっ、なんかいっぱい魔物が出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100040223,
					"content": "どうやら完全には成功しなかったようですね。結果としては、ほんの一瞬開いただけで、この魔物たちは「渇真の天象」を通って現れたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 100040224,
					"content": "ああ、本当に腹が立ちますね。真実の星空を少しも見られませんでした。こうなったら、あなたたちに怒りをぶつけるしかありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
