			},
			"dialogs": [
				{
					"id": 751080101,
					"content": "料理を作るって言ったけど、どんな料理がいいんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080102,
					"content": "たしか、前にプクプク獣の「ウーウーブドウ」に魚肉をやったことがあったよな。魚料理ならいけるんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080103,
					"content": "#プクプク獣と{REALNAME[ID(2)|SHOWHOST(true)]}に喜んでもらえるもの…「魚のミントソースグリル」とか、ナタっぽくていいかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080104,
					"content": "それなら得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "よし、それじゃ始めよう。オイラも一緒に考えてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080107,
					"content": "深く切り込みを入れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "オイラもそうした方がいいと思うぜ。そのほうが味がしみ込みやすいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080111,
					"content": "塩を多く入れたほうが美味しくなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#おう、口に入れた瞬間の濃厚な味は、プクプク獣も{REALNAME[ID(2)|SHOWHOST(true)]}もきっと気に入ってくれるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080115,
					"content": "ミントソースは多ければ多いほどいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "ひんやりとした口当たり、きっと気に入ってくれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080119,
					"content": "唐辛子は絶対に欠かせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "適度な辛さは、食欲を刺激するもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080123,
					"content": "強火で一気に、外カリカリ中ふわふわ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "へへっ、すっごく美味しそうだな！よだれが出そうだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080127,
					"content": "#素晴らしい調理を経て、プクプク獣と{REALNAME[ID(2)|SHOWHOST(true)]}のための特製焼き魚が完成した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "弱火でじっくり、柔らかくジューシーに！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#へへっ、さすが{NICKNAME}の門外不出の焼き魚レシピだな…これを得意料理のレパートリーに加えて、みんなにも食べてもらおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080121,
					"content": "フォンテーヌの生き物は辛いのが苦手かも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "でも、スパイスがないとなんか物足りない気がしないか？ちょっとだけ入れてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080117,
					"content": "水中にいるプクプク獣はミントが苦手かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "それは違うと思うぞ。水に浸かってたプクプク獣が陸に上がったら、きっと体が渇いて熱くなると思うんだ。ミントソースを入れたほうが体を冷やせるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080113,
					"content": "塩はそんなにいらない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "そうだな、この後もほかの調味料を入れるから、塩をいっぱい入れる必要はないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080109,
					"content": "浅く切り込みを入れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "いいと思うぜ！味は薄めにして、魚肉本来の食感を残した方が、プクプク獣にとって食べやすいかもしれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751080105,
					"content": "作り慣れてはいないけど大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
