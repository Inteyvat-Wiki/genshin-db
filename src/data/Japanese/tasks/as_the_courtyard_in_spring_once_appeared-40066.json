			"dialogs": [
				{
					"id": 400660301,
					"content": "わぁ、また違う空間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400660302,
					"content": "前回と同じく、万葉殿だけがいませんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400660303,
					"content": "よし、ここはアタイたちに任せとけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原景春",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "…これでよし。万葉、ちょうどいいところに来てくれた。見ろ、この石をどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660602,
					"content": "精巧で趣深いでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400660603,
					"content": "ははは、これは本にあった山の景色なのだ。異国には雲の中にそびえ立つような、名のある山がたくさんある。機会があれば、外に出て見てみたいものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660604,
					"content": "父上にその気さえあれば、いつでもお行きになれよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400660605,
					"content": "そんなことを言ってはならぬ。この父は楓原家の現当主だ。今や楓原家は衰退したが、やるべきことは昔と一つも変わらぬのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660606,
					"content": "ただ…そうだな。このように父上の道を貫き、没落した家に全てを捧げることに、果たして意味はあるのであろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660607,
					"content": "父上、拙者には…分かりませぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400660608,
					"content": "…万葉、一つだけ覚えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660609,
					"content": "家族は大切なものであるが、ゆめゆめ縛られてはならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660610,
					"content": "人のため、家はあるのだ。己が楽しく暮らせねば、家族を幸せにすることもできまいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660611,
					"content": "過去の一件は家に大きな影響を与えたが、それは子孫にまで負わせねばならぬような重荷ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660612,
					"content": "…もしいつか、其方が退屈な人生に飽いたら、全てを置いて外に出なさい。生活に縛られるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400660613,
					"content": "あい分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉",
					"楓原景春"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "拙者には解せぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661102,
					"content": "万葉、約束を忘れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661103,
					"content": "本当にすべてを諦めるのでござるか？確かに今は大変な時ではあるが、父上には拙者がいるであろう。拙者は何の役にも立たぬのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661104,
					"content": "確かに父上ならば、拙者の歳にはすでにお祖父様のお力になっておられただろう。拙者が無能なあまり、父上を失望させたのでござるか、それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661105,
					"content": "万葉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661106,
					"content": "…はぁ、其方にそのようなことで己を責めさせるとは、父として失格だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661107,
					"content": "楓原家は、過去の過ちのためにあまりにも多くの代償を支払った。そしてついに、其方の曽祖父様の代から今に至るまで、この翳りを抜け出せなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661108,
					"content": "刀鍛冶は我が一族の責務であるが、家業だけがお主の全てではないのだ。それは忘れてくれるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661109,
					"content": "ケガをした獣が罠から抜けようとすれば、挟まれた後ろ足を切り捨てる苦痛に耐えねばならぬ。もしそれを損と思うならば罠を離れずともよいが、恐らくそれはより致命的な結果を招くであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661110,
					"content": "もうよいのだ、万葉。当主でありながら一族を復興できず、其方に名門士族の若君としての暮らしを与えてやれなかった。なのに、其方は拙者を責めぬ。父はもう、それだけで充分なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661111,
					"content": "何世代にも渡った苦痛は…今日で終わりにしよう。これからは、重荷を降ろして生きてゆくのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661112,
					"content": "家業を捨てる悪名は、この父が背負えばよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "楓原景春"
				},
				{
					"id": 400661113,
					"content": "…父上…やめてくれ。当主としての能力がないなどという悪名を、父上が背負うべきではござらぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661114,
					"content": "それに、もしその日が本当に来たら、拙者も矢面に立つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661115,
					"content": "しばし待たれよ。楓原家はいずれ拙者が継ぐのでござろう。その時になれば、拙者が片づければよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
