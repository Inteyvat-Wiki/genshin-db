						"stepId": 4006617,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉",
					"フィッシュル",
					"オズ",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661701,
					"content": "やっぱり、またここに閉じ込められてたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400661702,
					"content": "はは、これも法則によるものかもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661703,
					"content": "オイラたち、また幻境の迷宮に入ってしまってたんだ。でも今回はなんだか、前回とちょっと違ったような気がするけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400661704,
					"content": "今回見聞きしたものを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "人気はすっかり減り、調度品も昔のような華麗さではなかったと…ふむ、無理からぬことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661706,
					"content": "お主らが見たのは恐らく、衰退の一途を辿る楓原家でござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661707,
					"content": "でも、幻境の中の万葉はなんだか、まるで影みたいだった。とにかく、今のおまえとはちょっと違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400661708,
					"content": "それには、わたくしも同意するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400661709,
					"content": "今の万葉殿と比べれば、あの幻影は多くの迷いを抱え、重い運命に悩んでおられるようでしたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400661710,
					"content": "確かに、重い運命を背負っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400661711,
					"content": "それは今の拙者が成長したということ。皆に未熟な己を見られようとは、恥じ入るばかりでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661712,
					"content": "稲妻を離れてから、拙者は長く各地を流浪していた。しかしそれは悪いことばかりでもござらん。そのおかげで成長できたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661713,
					"content": "昔の自分に会えれば良かったのであるが。今の拙者を見れば、あの頃の拙者にもきっと分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400661714,
					"content": "——人生の道のりは長い。それゆえ、拙者は旅に出るのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
