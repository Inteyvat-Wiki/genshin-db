				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661401,
					"content": "いや、違う。見た目はそんなに違わないけど…オイラたちの声が聞こえてないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400661402,
					"content": "こいつは多分ただの幻影で、オイラたちと一緒に来た万葉じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4006617,
			"completionStepIds": [
				4006617
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006617",
