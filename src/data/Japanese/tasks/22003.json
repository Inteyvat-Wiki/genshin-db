			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "ん？何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030502,
					"content": "言笑が作ったご飯を届けにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "いい匂いがすると思ったら、あの料理人の腕前は確かだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220030504,
					"content": "ありがとう。ついでに彼にも礼を伝えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
