			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "飯は届けたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030602,
					"content": "届けた。ありが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "ふん、もういい、どうせありがとうとか、つまんないことを言ってただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030604,
					"content": "もう聞き飽きた、何がありがとうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030605,
					"content": "そんなことを言ったり、釣りをしたりする暇があるなら働いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030606,
					"content": "ちぇっ、お前にそんなことを言ってどうする。ほら報酬だ、もらっとけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
