			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "早く行きな。じゃなきゃ、また面倒事が起こる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030402,
					"content": "なんであの人に届けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "聞いてどうする？あいつはずっと一人だ。この璃月港での知り合いは俺だけだから、ここにしかただ飯を食いに来れないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030404,
					"content": "理由？そんなの俺の勝手だ。もういいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030405,
					"content": "もし俺があいつをほっとけば、あいつがまた荻花洲で暴れたらどうする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030406,
					"content": "まだここにいるのか！さっさと行け！ぐずぐずするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
