			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "ふん、よくもただ食いができるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "俺？ただ食い野郎の飯を作っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030104,
					"content": "仕事もせずに毎日フラフラしやがって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030105,
					"content": "釣りに行っても、大したものも釣れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030106,
					"content": "俺がいなきゃ、あいつはいずれ旅館の外で死んでるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030107,
					"content": "もういい、どうせ言ってもあいつは聞かないふりをするだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030108,
					"content": "手が空いているんなら、野菜を持ってきてくれるか？ちょっと野菜が足りないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030109,
					"content": "少しだけで足りる。<color=#00E1FFFF>絶雲の唐辛子</color>と<color=#00E1FFFF>ハスの花托</color>を一個ずつでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "おう、あったらすぐ戻ってきてくれ、料理を急いで仕上げるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030112,
					"content": "旅館に野菜がいっぱいある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "あれは旅館の主人が出したお金だ。ただ食い野郎が金を払ったことがあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030114,
					"content": "これも全部俺のおごりだ…ふん、あいつに借りがあるわけでもないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030115,
					"content": "いいから、早く行ってこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
