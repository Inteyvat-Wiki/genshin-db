			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "ここで待ってろ。料理できたら、持って行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030302,
					"content": "なんだその顔。もちろん、ただでとは言わないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030303,
					"content": "いいから、これ持って行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 220030304,
					"content": "あいつの名前は<color=#00E1FFFF>江雪</color>、ずっと水辺で釣りをしている。見ればすぐわかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "言笑"
				}
			]
		},
		{
