					}
				]
			},
			"dialogs": [
				{
					"id": 740610401,
					"content": "はぁ、はぁ、お二人さん。ふぅ——間に合いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610402
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610402,
					"content": "そんなに息を切らしてどうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610403,
					"content": "廃棄された生産エリアでの作業を終わらせて、急いで走って来たんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610404
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610404,
					"content": "頼んでいた用事は済みましたか？手紙はもう出せたんですよね？あぁ、よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610405,
						740610406
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610405,
					"content": "手紙の署名は純白のスズランだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				},
				{
					"id": 740610407,
					"content": "ああ…あのお嬢さんはそういった名前を使っているんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610408
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610408,
					"content": "いいでしょう、本当のことをお話しします。あの手紙は、実はあるお嬢さんに頼まれたものなんです。病気で苦しんでいたので、私が代わりに出してあげることにしたんですよ。しかも報酬もなしに！君たちへの報酬は私の自腹になります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610409
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610409,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610410,
						740610411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610410,
					"content": "手紙の内容を見るに重病そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610412,
					"content": "きっと外に出る際、手紙を取り違えたんでしょう。まずい、これじゃ息子の誕生日に間に合わなくなります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610413
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610413,
					"content": "…ん？送る手紙を間違えたのか？おまえってやっぱり噂通り、不運なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610414,
					"content": "これが私の運命なのかもしれません。はぁ、私はそろそろ戻ります。手紙を取りに行かないと…まだ間に合うといいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610415
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610415,
					"content": "こちらがお二人への報酬です。お手伝いいただき、ありがとうございました。私は息子に手紙を出さなければならないので、ここで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610416
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610416,
					"content": "おい…ああ、もう行っちゃったぞ！まだ聞きたいことがたくさんあったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610417,
					"content": "まあでも、特別許可券はもらえたし問題ないか。…って、あれ！？たったこれだけ？こんなんじゃ、一食分も買えないじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610418,
						740610420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610418,
					"content": "今夜は空腹確定だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610419
					]
				},
				{
					"id": 740610419,
					"content": "イヤだぞ、お腹空いた。ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610420,
					"content": "もう一回、列に並ぶ依頼を受ける？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610421
					]
				},
				{
					"id": 740610421,
					"content": "それだったら、まだ腹ペコのほうがマシだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610411,
					"content": "その話、本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610406,
					"content": "#{M#君}{F#あなた}が純白のスズラン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				}
			]
