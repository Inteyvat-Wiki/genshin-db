				]
			},
			"dialogs": [
				{
					"id": 740610201,
					"content": "どなたか助けてくれませんか？お願いします。哀れな私に救いの手を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610202
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610202,
					"content": "どうしたんだ？大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610203,
					"content": "ああ、神様！やっと優しい人に巡り合えました。その…実は明日、息子の誕生日なので手紙を送りたいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610204
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610204,
					"content": "しかし手紙を外へ送るには、並ばなくてはなりません。でも、私にはその時間がなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610205
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610205,
					"content": "ん？どうしてだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610206,
					"content": "生産エリアで重大な事故が発生したんです。すぐ現場に行って処理しなければなりません。それで、誰かに代わりに並んでほしいんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610207
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610207,
					"content": "はぁ…これもすべて私の自業自得だと分かっています。で、でも、息子にはなんの罪もありません。どうして私のせいで、息子が悲しい目に遭わなければならないんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610208
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610208,
					"content": "私はただ息子に手紙を書いて、父さんが誕生日を忘れてないことを…父さんが愛していることを伝えたいだけなのに。残念ながら、私にはそれすらできないようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610209
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610209,
					"content": "#うぅ、可哀そうだな。{NICKNAME}、助けてやろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610210,
					"content": "ほ、本当ですか？今、それほど手持ちに余裕はありませんが、必ず相場に見合った報酬をお支払いしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610211
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610211,
					"content": "相場？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610212
					]
				},
				{
					"id": 740610212,
					"content": "はい、私も代わりに並んだことがあるので、相場を知っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610213
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610213,
					"content": "別に気にしなくていいぞ。報酬は大して重要じゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610214,
					"content": "本当にありがとうございます！お優しいですね。そういえば、まだお名前を伺っていませんでした。私はデサンブル、お二人は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610215
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610215,
					"content": "#オイラはパイモン、こいつは{NICKNAME}だ。一緒に冒険してる仲間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610216,
					"content": "#これが送りたい手紙です。そこにいるルッツという人に直接渡してください。パイモンに{NICKNAME}、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610217
					],
					"speakerTitle": "デサンブル"
				},
				{
					"id": 740610217,
					"content": "へへっ、安心してオイラたちに任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610218,
					"content": "デサンブルは手紙を渡すと、急いで立ち去った。\\n長時間経ってからふと気づいた——まばらに並んでいた人の列が、まるで固まっているかのように進んでいないことに。\\nそして、とある二人の会話が後ろから聞こえてきて、あなたたちの興味を引いた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740610219
					]
				},
				{
					"id": 740610219,
					"content": "はぁ、遅いな。空気も悪いし、息が詰まりそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610220
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610220,
					"content": "若いの、ここに並ぶのは初めてかい？ここの行列は長いことで有名でな。メロピデ要塞じゃ誰もが知ってることさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610221
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610221,
					"content": "何しろ、ルッツは文字を打ちながら尾ひれを付け足すクセがある。みんな、チェックにかなりの時間がかかるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610222
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610222,
					"content": "かなりの時間？あぁ、なんてこった。もう足が棒になりそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610223
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610223,
					"content": "ははっ、気を失わないように、せいぜい気張れよ。万が一気絶でもしたら、明日はまた最初から並び直しだ。三回並んでもなお、まだ手紙を送れなかった人もいるくらいだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610224
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610224,
					"content": "三回も？なんてツイてないやつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610225
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610225,
					"content": "だろう？三回並んで、三回とも失敗するなんて偉業をなしたのは彼だけだ。だから皆、彼を不運なデサンブルって呼んでるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610226
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610226,
					"content": "もし興味があるのなら、詳しく話してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610227
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610227,
					"content": "いや、正直なところ、今はそういう気分じゃなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610228
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610228,
					"content": "まあまあ、そう言わずに。元気を出してくれ。オホンッ、これは一昨日のことだ。うだるような暑さの午後だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610229
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610229,
					"content": "いいって言ってるのに…はぁ、分かったよ。続けてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610230
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610230,
					"content": "あの午後、デサンブルが私のところに来ると、「明日、手紙を送るために並ばなきゃいけないから、特別許可食堂での配膳の仕事を代わってほしい」と言ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610231
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610231,
					"content": "面倒だから、引き受けるつもりなんてなかったんだが…あまりに悲しそうな顔をして、こう言ってきたんだ——「前回はうっかり寝坊して、並び損ねた」ってね。そして、息子は今も手紙を待ってると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610232
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610232,
					"content": "結局、同情しちまって手伝うことにしたんだ。で、昨日仕事を終えた後、何があったと思う？あいつはまた、仕事を代わってくれる人を探してたんだ。手紙を送らなきゃっていう同じ理由でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610233
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610233,
					"content": "どういうことかあいつに聞くと、先日の教訓から早起きはしたが、今度はトラブルがあって手紙を出せなかったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610234
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610234,
					"content": "まさか…間違った列に並んだとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610235
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610235,
					"content": "それよりもっと面白い話さ。早朝から並ぶために食事も取らずにいたら、午後まで持たなかったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610236
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610236,
					"content": "やせ我慢で何とか乗り切ろうとしたが、突然目の前が暗くなって、パタンと倒れちまったんだと。目が覚めたら、もう終わってたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610237
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610237,
					"content": "はははっ、そんなやつがいるなんてな！…いや待った、そういえば自分もまだご飯を食べてない。やばい、お腹が鳴り出した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610238
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610238,
					"content": "今のって、あのデサンブルのことだよな？ここに並ぶのがそんなに大変だなんて…食べ物を持っててよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610239,
						740610241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610239,
					"content": "そうだね。幸いパイモンもいることだし！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610240
					]
				},
				{
					"id": 740610240,
					"content": "うう～ん？褒められてるみたいだけど、なんか別の意味を含んでるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610243,
					"content": "長い行列に並んでいる時間は退屈で、あなたたちは徐々に自分の任務を忘れていった。\\nここにいる数少ない人たちの少し騒がしいおしゃべりだけが、時の流れを思い起こさせる。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740610244
					]
				},
				{
					"id": 740610244,
					"content": "クラクラしてきた…まさか、俺も手紙を送るのが明日になってしまうのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610245
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610245,
					"content": "これで腹ごしらえするといい。ここに並ぶときは、携帯食と水を用意するのが常識だ。次からは忘れんようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610246
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610246,
					"content": "あ、ありがとう。でも大げさだな…本当にそれって、ここの行列に並ぶときの常識なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610247
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610247,
					"content": "ふん、いいか新入り、よく聞け。ここはメロピデ要塞で最も過酷な戦場だ。あの鉄拳闘技場だって、ここほどじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610248
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610248,
					"content": "あぁ、でもこれはいくら何でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610249
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610249,
					"content": "列に並ぶ者は皆、綿密な計画を立ててるんだ。休憩用の椅子を持ってくる者もいれば、入口で徹夜して待つ者もいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610250
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610250,
					"content": "れ、列に並ぶだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610251
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610251,
					"content": "若いの、これはただの列じゃない——そう、戦争なんだ！誰もが力を尽くしてる！あの不運なデサンブルでさえ、数多の作戦を用意してるほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610252
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610253
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610253,
					"content": "しかし残念ながら、その作戦をもってしても、デサンブルは失敗の運命から逃れることができなかった。さっき生産エリアから戻ったとき、デサンブルが列から離れて特別許可食堂に向かっていくのを見てな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610254
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610254,
					"content": "だから、どうして列に並ばないのかって聞いたら、なんて答えたと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610255
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610255,
					"content": "これまでの経験にこだわりすぎた結果、最も重要なこと——つまり、送ろうとしてる手紙を持ってくるのを忘れたんだとよ！だから、最初からやり直すしかないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610256
					],
					"speakerTitle": "陽気な男"
				},
				{
					"id": 740610256,
					"content": "…なんだか話を聞いてたら、その人と会ってみたくなってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610257
					],
					"speakerTitle": "疲れた男"
				},
				{
					"id": 740610257,
					"content": "うわっ…手紙を忘れたのかよ？デサンブルのやつ、本当にツイてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610258,
						740610259
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610258,
					"content": "だったら、渡されたのはいったい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610260
					]
				},
				{
					"id": 740610260,
					"content": "あっ、そうだった！手紙はオイラたちが持ってるんだよな？うーん、ちょっと訳がわからなくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610261
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610261,
					"content": "手紙を確認してみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610262
					]
				},
				{
					"id": 740610262,
					"content": "どれどれ…うわっ！こ、怖いぞ、なんだよこれ…誕生日ともデサンブルとも、まったく関係ないじゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610263,
						740610264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610263,
					"content": "（つじつまが全然合わない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610265
					]
				},
				{
					"id": 740610265,
					"content": "#{NICKNAME}、もうすぐオイラたちの番だ。とりあえず手紙を出そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610266
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740610266,
					"content": "苦痛に満ちた待ち時間はついに終わり、これですべてが報われる。\\nしかし、まだ解放されたわけではない。なぜなら、心にはまだ疑問が残っているからだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740610264,
					"content": "（あとで必ず聞かないと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610265
					]
				},
				{
					"id": 740610259,
					"content": "手紙を渡されたでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610260
					]
				},
				{
					"id": 740610241,
					"content": "パイモンはいつもお腹が空いてるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610242
					]
				},
				{
					"id": 740610242,
					"content": "へへっ、お腹を満たすことは大事なことだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610243
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
