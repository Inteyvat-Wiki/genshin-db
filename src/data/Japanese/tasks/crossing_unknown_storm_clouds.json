				"points": []
			},
			"dialogs": [
				{
					"id": 726540101,
					"content": "手がかりをありがとうございます、今なら遺跡機械の位置を確認できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540102,
					"content": "ですがその前に、他に処理してもらいたいことがありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540103
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540103,
					"content": "近くに分散している雷元素の特異点が精確な定位を邪魔しています、これら特異点の位置を教えてあげますので…解決して欲しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540104,
					"content": "前と同じく、サンプルを持ってきてもらえば…もちろんサンプルは私の研究に使いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540105
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540105,
					"content": "その他には…何といっても私たち、商船なんですから、商業的価値も研究したくて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540106,
					"content": "今のところ、成果はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726540107
					]
				},
				{
					"id": 726540107,
					"content": "そうですね…あなたが渡してくれたサンプル、上手く利用すれば「南十字」は機動力に頼らずとも、簡単に雷雨を避けられることになるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540108
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540108,
					"content": "こうなれば、稲妻への道もより強固で効率よくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540109
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540109,
					"content": "しかし…「鎖国令」は将軍の意志ですから、私たちがこうしているのは彼女の機嫌を損ねることに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540110,
					"content": "ああ、もちろん一番直接的な研究成果は、雷元素異常の増殖物の「寿命」と「年齢」から、雷元素異常の範囲と源を算出することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540111
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540111,
					"content": "源は私たちの注文の目標、謎の古代機械生命体ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540112
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540112,
					"content": "アッハハ、ごめんなさい…興奮しすぎました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726540113
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726540113,
					"content": "さて、最後の踏査です、いざ出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				}
			]
		}
	]
}