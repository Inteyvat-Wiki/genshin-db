			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}さん、パイモンさん、こんにちは。お食事はお済みですか？今日は何かご予定はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040702,
					"content": "この辺りを見てまわってるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "そうだったのですね。各地を巡って写真機でさまざまな瞬間を収めるのは、とても良いリラックス方法です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040705,
					"content": "ですが、写真機を検出できません。出かけるときに慌てて、どこかに写真機を忘れてきてしまったのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040703,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
		},
