			"trigger": {
				"objectNames": [
					"イネファ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{NICKNAME}さん、パイモンさん、こんにちは。お食事はお済みですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040102,
					"content": "イネファ？どうして屋根の上にいるんだ？まさか…雲の形を観察して、雨が降る確率を計算してるとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765040103,
					"content": "現在…想定外の任務を遂行中です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040104,
					"content": "本来であれば、アイノのリストにある「高精度ギア」と「特製六角ボルト」を購入するだけだったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040105,
					"content": "工房に帰る途中…予測不能な強盗事件に遭ったのです——猛禽類が一羽飛んできて、目にもとまらぬ速さで、特製ボルトを奪い去っていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040106,
					"content": "つまり、屋根の上からその鳥を探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "そうです。猛禽類の習性を鑑みるに、屋根の上は一時的な着地点になり得ます。視覚スキャンと音声探知を全方位に行うことで、ターゲットの位置を特定しようとしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040108,
					"content": "ですが、未だ有効な痕跡を観測できていません。大まかに推測するに、考えられる可能性は二つ——目標がすでに追跡範囲から外れた、あるいは「獲物」をより人目のつかない場所に持って行ったか、です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040109,
					"content": "予備プランを起動——指定された仕入れ先に戻り、同型番のボルトを購入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040110,
					"content": "そういえば…貴方たちも高い場所にいますね。ということは、もしかして…動物を追跡しているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040111,
					"content": "そういうわけじゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "おう！オイラたち、見晴らしのいいところでナシャタウンの全体を撮ろうと思ってたんだ——賑やかで活気に満ちてる様子を記録したくってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765040114,
					"content": "でも、まさかここで「泥棒」探しをしてるイネファに会うなんて思わなかったぞ！これもレアな「サプライズ」ってやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765040115,
					"content": "せっかくだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "ええ、構いません。立ち位置と体の向き、推奨する表情を提供してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040118,
					"content": "#「私が屋根の上に登り、ここで貴方たちに会って、{NICKNAME}さんに写真を撮ってもらう」というこの一連の出来事が起こる確率は、あの鳥がネジを返しに来る確率よりも低いでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040119,
					"content": "この「サプライズ」を、ぜひ正確に記録してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040116,
					"content": "イネファの写真を撮ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
