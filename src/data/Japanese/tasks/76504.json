			"dialogs": [
				{
					"id": 765040801,
					"content": "良いアイデアは思いつきましたか？焦る必要はありません。美しいものほど、辛抱強く探す価値があるのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040803,
						765040802
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040803,
					"content": "大丈夫、今から撮るね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040804
					]
				},
				{
					"id": 765040804,
					"content": "かしこまりました。ですが、写真機を検出できません。出かけるときに慌てて、写真機を忘れてきてしまったのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				},
				{
					"id": 765040802,
