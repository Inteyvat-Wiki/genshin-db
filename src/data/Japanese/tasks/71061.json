			"dialogs": [
				{
					"id": 710610201,
					"content": "「触媒」のエネルギーをザマランに分けてあげた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "うわっ、キノコ頭が光ったぞ！これじゃあ「蛍光キノコ頭」だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610203,
					"content": "#{NICKNAME}に称賛を、パイモンに称賛を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610204,
					"content": "#{NICKNAME}とパイモンのおかげで、ザマランは再び命の輝きを得た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610205,
					"content": "だが油断はまだできない。ザマランは知ってる。邪気の根源は、まだ消えていない。邪気は再び襲い掛かってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610206,
					"content": "えっ、じゃあどうすればいいんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610207,
					"content": "うわっ、黒泥だ。これがキノコ頭の言ってた「邪気」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#{NICKNAME}に称賛を、パイモンに称賛を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610302,
					"content": "ザマランの呼びかけに応答してくれた者は、誰もいない。多足類と四足類は言うまでもないが、二足類も、ザマランの助けを求める叫びを無視した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610303,
					"content": "#真の智者だけが、ザマランの呼びかけに応えてくれる。パイモンは智者で、{NICKNAME}も智者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610304,
					"content": "二足歩行の中でも優れた存在、ザマランの称賛を受け取るがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610323,
					"content": "へへん、オイラは「智者」パイモン、甘く見るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610305,
					"content": "大したことじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#いつの日か、{NICKNAME}とパイモンも、ザマランやザマランの同族と同等の存在になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610307,
					"content": "ん？それってどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610308,
					"content": "多足類は四足類に劣り、四足類は二足類に劣り、二足類も無足類に劣る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610309,
					"content": "#{NICKNAME}とパイモンは生まれつき欠陥を持って生まれたが、これからの努力で運命を変えることも不可能ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610310,
					"content": "蛍光キノコ頭のくせに、生意気だぞ！この蛍光キノコ、料理にしてやろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610311,
					"content": "鳥肉と野生キノコの串焼きも悪くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "綺麗なキノコは人を騙すし、毒がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "パイモンは食欲旺盛。今日はキノコを食べ、明日もキノコを食べ、百日後にはパイモンはパイモンでなく、キノコになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610314,
					"content": "#うぅ、{NICKNAME}、キノコ頭の言ってること、怖いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610315,
					"content": "ふむ、パイモンはユーモアがわからないやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610316,
					"content": "どこがユーモアなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610317,
					"content": "ザマランは邪気から抜け出せたが、同族は未だに苦しんでいる。しかし今のザマランには力がない。昔のように弱者を庇うこともできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610318,
					"content": "#ザマラン、{NICKNAME}に頼みがある。どうか慈悲を、自らを救えぬ弱者を救ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610319,
					"content": "#つまり、他にも元気のなさそうなキノコがあるのか？{NICKNAME}、助けてあげようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610320,
					"content": "まあせっかく来たし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "ついでならいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "じゃあ、さっそく出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610207,
					"content": "うわっ、黒泥だ。これがキノコ頭の言ってた「邪気」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
