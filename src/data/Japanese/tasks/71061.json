			"dialogs": [
				{
					"id": 710610401,
					"content": "#{NICKNAME}に称賛を、パイモンに称賛を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610402,
					"content": "恐縮だが、二足類にはこんな言葉がある。「人助けは最後までやり通す」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610403,
					"content": "また使い走りさせるつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "#でも{M#君}{F#あなた}は人じゃなくてキノコだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "二足類のその知恵、智者という称号をえるにふさわしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610406,
					"content": "共に大地の恵みを浴びて生きている者同士。助け合うのは当然のこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610407,
					"content": "どうかこれを、「才慧の加護」受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610408,
					"content": "「才慧の加護」を手に入れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "うわぁ…なんだこれ、怪しそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610410,
					"content": "ここにはまだ、微かに邪気が空中を漂っている。ザマランは感じ取ることができるが、根源がどこにあるかはわからない。水路に沿って探索すれば、きっと何か見つかるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}、邪気の根源に対して「才慧の加護」を使えば、ザマランの同族が問題を片づけてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610412,
					"content": "邪気の根源…確かに、放っておくわけにはいかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "…どうして自分でいかないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}はパイモンよりもユーモアがわかるようだ。ザマラン、足がない。{NICKNAME}、足がある。足が必要な仕事は、足のある者が行うべき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610415,
					"content": "それに、ザマランは、もっと重要な使命を負っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610416,
					"content": "もっと重要な使命って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#今回は力を使い過ぎた。{NICKNAME}とパイモンとの会話は楽しかったが、今は休眠が必要。力を蓄え邪気に抗う。同族を影で支え、繁栄を手伝う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610418,
					"content": "#{NICKNAME}に祝福を、パイモンに祝福を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "ザマラン"
				},
				{
					"id": 710610420,
					"content": "おい、キノコ頭、おいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}、キノコ頭はもう寝ちゃったみたいだ。オイラたちも行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710610207,
					"content": "うわっ、黒泥だ。これがキノコ頭の言ってた「邪気」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
