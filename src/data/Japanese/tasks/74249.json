			"dialogs": [
				{
					"id": 742490101,
					"content": "またしてもギヨタンさんにお茶とお菓子を用意させてしまって、すまないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490102,
					"content": "いいのよ。先日の千霊映影祭でも、フリーナ監督にはお世話になったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490103,
					"content": "いやいや、頑張ったのは役者のみんなだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490104,
					"content": "フリーナさんは、もう役者として活躍するつもりはないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490105,
					"content": "うーん…絶対にやらないというわけじゃないよ。ただ、今は裏方に回っていたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490106,
					"content": "実を言うと、フォンテーヌで暮らしていた頃から、人々に愛される大スターとしてアナタのことを知っていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490107,
					"content": "ちょっ…ストップ、ストップ！僕の演技を見て育ったなんて言わないでおくれよ。それを言われるたびに、気恥ずかしくなるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490108,
					"content": "いえ、そういうわけじゃないの。ワタシが言いたいのは、フォンテーヌを離れる時に、光栄にも当時のフリーナさんを見る機会があったってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490109,
					"content": "でも今回アナタと接してみて、やっぱり今のフリーナさんのほうが素敵だと感じたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490110,
					"content": "えっ…？今の僕が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490111,
					"content": "ええ。舞台の上のアナタはいつも気を張っているように見えたわ。でも、今は随分とリラックスしているみたいだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490112,
					"content": "ハハッ…そう言ってもらえると嬉しいよ。実は僕も、今の生活のほうが気に入っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490113,
					"content": "逆に、ギヨタンさんはどうなんだい？フォンテーヌを離れたあの頃と比べて、今の生活は楽しめているかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490114,
					"content": "まあ、そうね。けど、どちらかというと、それは心境の変化によるものよ。正直に言うと、フォンテーヌという故郷をずっと恋しく思っていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490115,
					"content": "他の国より何かが優れているというわけじゃない。ただ、この国にはワタシたちの思い出が詰まっているから…ここでの生活は、時に水のように穏やかで、時に新鮮な驚きに満ちているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490116,
					"content": "最近になってようやく、物事の良い面に目を向けられるようになったの。きっと、他の国に住む人たちも多かれ少なかれ、自分の国をそういう視点で見ているんじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490117,
					"content": "そうだね——いいことを言うじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490118,
					"content": "お茶会の作法には反するけど…フォンテーヌに乾杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490119,
					"content": "ふふ…故郷に乾杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
