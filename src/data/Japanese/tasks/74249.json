			"dialogs": [
				{
					"id": 742490201,
					"content": "お茶を楽しみながらのんびりと過ごす…こんな時間がずっと続くといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742490204,
					"content": "うん。楽しい時間が過ぎるのは、本当にあっという間だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 742490203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
}