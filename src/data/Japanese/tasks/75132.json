			"dialogs": [
				{
					"id": 751320601,
					"content": "ああ、異邦の勇士よ…あなたが成し遂げたすべてを…私は感じ取れます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320602,
					"content": "素晴らしき勇士よ、侵蝕された力も夜神の国に戻り、夜魂たちが喜んでいるのを感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320603,
					"content": "さて…これをお渡ししましょう。偉業を成し遂げた者は報酬を得るべきです。どうぞお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラクガキの中の意志"
				}
			]
		}
	]
