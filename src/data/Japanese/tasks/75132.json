			"dialogs": [
				{
					"id": 751320501,
					"content": "漆黒の敵が徘徊するところ、そしてすべてを侵食する敵に、くれぐれもご用心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320502,
					"content": "異邦の勇士よ…聞きたいことはありますか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320503,
					"content": "英雄の壁画について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "東側の光り輝く木の揺れる洞窟の中で、ウォーベンを持った語り部がこう言いました——過去の物語には恐怖が潜んでいると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320505,
					"content": "もしかしたら、その暗影が物語を利用し、逃げる道を探しているのかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320506,
					"content": "謎海の上について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "西側の霧に覆われた島は、かつて祭祀の聖地であり、ずっと昔、イクトミ竜族と契約を結んだ者の住む場所でもありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320508,
					"content": "しかし、その中から泥が湧き出し、聖地は漆黒の深穴と化したあげく、封印され忘れ去られました…ああ、あの狡猾な敵は簡単には諦めないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320509,
					"content": "色褪せた霧について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "かつてオシカ・ナタと呼ばれた古都が滅びた際に生じた汚れた霧であり、本来は封印されたものです…しかし、歳月と忘却は大敵と言わざるを得ません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320511,
					"content": "もしも…ああ…もしも誰かが、再びあの色褪せた霧を消し去ってくれたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "ラクガキの中の意志"
				},
				{
					"id": 751320512,
					"content": "特にない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "ああ…どうかお忘れなきよう。くれぐれも…お気を付けください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラクガキの中の意志"
				}
			]
		},
