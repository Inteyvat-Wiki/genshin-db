						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 705420101,
					"content": "にゃ…にゃお？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420102
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420102,
					"content": "猫同士の挨拶ってこんな感じでしょうか？あまり似てなかったかもしれませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420103
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420103,
					"content": "ニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420104
					],
					"speakerTitle": "「雪大福」"
				},
				{
					"id": 705420104,
					"content": "「雪大福」、どうやら全然理解してないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420105,
					"content": "で、モナは猫語に挑戦してるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420106,
						705420107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420106,
					"content": "モナ先生、発音が違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				},
				{
					"id": 705420108,
					"content": "おい！「ガオー」だと、トラとかライオンみたいになっちゃうだろ。猫を驚かせてどうすんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420109,
					"content": "#{NICKNAME}、パイモン！あの噂は事実だったんですね。本当に「ネコモコの城」で働いているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420110
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420110,
					"content": "働いてるって言えるほどじゃないぞ。オイラたち、ヴァレリナとロサリアを手伝ってるんだ。どちらかというと…コンサルタントだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420111,
					"content": "へへっ！聞くからにすごそうな肩書きだろ、コンサルタントって！ふふん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420112,
					"content": "ところで、「偉大なる占星術師のモナ」は、猫を引き取りに来たのか？まさか、星象の観察を手伝わせる気なんじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420113,
					"content": "そうですね…私の星象学への理解からすれば、たしかに星象を読み解けるよう猫ちゃんに教えるのは難しいことではないと思います。なんなら…猫ちゃんに原稿を書いてもらうことだってできるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420114
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420114,
					"content": "（雪大福をチラっと見る）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420115
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420115,
					"content": "（まっすぐ雪大福を見る）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420116,
					"content": "ニャッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420117
					],
					"speakerTitle": "「雪大福」"
				},
				{
					"id": 705420117,
					"content": "コホンッ、やはりやめておきましょう。星象を理解したとしても、その奥深さを分かりやすい言葉で書けなければ、私の卓越した見解を読者に伝えられません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420118
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420118,
					"content": "原稿執筆のアシスタントが欲しいなら、もう一度フォンテーヌに行って、スチームバード新聞のスタッフを説得したほうがいいでしょう。あるいは、タイプライターが使えるメリュジーヌを探してモンドに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420119
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420119,
					"content": "もし本当に猫を飼ったとしても、せいぜい一緒に遊んでリラックスしたり、学術研究の疲れを癒やしてもらったりするくらいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420120
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420120,
					"content": "あっ、タチの悪い飼い主になってはいけませんね。自分が疲れてるのに、猫たちも疲れさせるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420121
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420121,
					"content": "この部屋に入るまでは、猫たちとの交流がこんなにも楽しいものだとは思いませんでした…皆さんには、ずっとこうして楽しく過ごしてほしいものです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420122
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420122,
					"content": "へへっ、どうやらモナは飼い主としてのいい心構えを持ってるみたいだな。おまえに猫を任せたら、みんなもすっごく安心できそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420123,
					"content": "ですが聞いたところによると、いつも部屋中を跳び回ったり、家具を噛んだり引っ掻いたりするとてもヤンチャな猫もいるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420124,
					"content": "もし私の原稿や占星関連の資料を台無しにされたら、大変なことになってしまいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420125
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420125,
					"content": "貴重な本を台無しに…そんな恐ろしいこと、オイラも考えたくないぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420126,
					"content": "「雪大福」はおとなしそうですが、私の言っていることがあまり理解できていないようです…私たちはあまり波長が合わないのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420127
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420127,
					"content": "言うことを聞いてくれる猫がいないか、もう少し観察しなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420128
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420128,
					"content": "それから、猫ハウスやキャットフードなどの出費も計算しないと。あまり贅沢は出来ませんが、猫に苦しい思いをさせるわけにもいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420129,
						705420130
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705420129,
					"content": "大丈夫、ゆっくりやっていこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420131,
					"content": "そうだぞ。ヴァレリナが言ってたぜ、今後はもっとたくさんの野良猫を引き取るって。今いい猫が見つからなくても、何度でも遊びに来て、また見てみるといいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705420132,
					"content": "ニャ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「雪大福」"
				},
				{
					"id": 705420130,
					"content": "これから猫はもっと増えていく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420107,
					"content": "「ガオー」ってやってみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				}
			]
		}
	]
}