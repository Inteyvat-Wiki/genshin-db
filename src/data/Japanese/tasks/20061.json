			"dialogs": [
				{
					"id": 200610101,
					"content": "ハトに関して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610102,
					"content": "このハトたち、いっそおつまみにしたほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "ここで伝書ハトを飼ってるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610105,
					"content": "何故か分からないが、最近このハトたちがどんどん頼りにならなくなってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610106,
					"content": "手紙をなくすか、ずっと地面に止まって飛ばないかのどちらかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610111,
					"content": "時間があったら、さっき飛ばしたハトを見に行ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "頼んだよ。もしハトたちが地面でサボってたら、追っ払ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610109,
					"content": "ハトに嫌われる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "大丈夫だ、ハトは記憶力が弱いから、すぐに忘れるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 200610112,
					"content": "意外とハトが好きなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				}
			]
		},
