			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "小童二人がここで何をしておる？お前らもわしを「石植え」爺だと、笑いに来たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040102,
					"content": "わしは元気だ。村人の心配なぞいらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040103,
					"content": "うわ、いきなりそこまで敵視しなくてもいいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040104,
					"content": "誤解だ。オイラたちはアアル村の人間じゃないし、笑いに来たわけでもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040105,
					"content": "ただの通りすがり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "通りすがりだと？ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040110,
					"content": "普段は知り合いしかここには来やせん。あいつらはここの苗畑は諦めろとか、村に帰ろとか言ってくるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040111,
					"content": "それに何人かのクソガキが、よくここに来てはいたずらをしていきおる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040112,
					"content": "お前たちのような格好は初めて見るな。若造たちは何者だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040113,
					"content": "肉親を探している旅人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "そうだ。この目標のために、オイラたちは長い道のりを歩いてきたんだぞ。冒険しながら探してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME}は、正義感のあるやつなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040119,
					"content": "オイラたちは一人暮らしの老人をいじめるなんてこと、絶対しないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040120,
					"content": "だからじいちゃん、心配するな。オイラたちは悪いやつじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040121,
					"content": "コホン、若造相手に謝るのは小恥ずかしいが、わしがよく見ておらんで、悪かったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040122,
					"content": "若造たちよ、このアファンは心から詫びる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040123,
					"content": "若いのに、自力で生きとるとは大したもんだ。わしの若い頃より立派だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040124,
					"content": "さっき言っとったことが本当ならば、ひとつお前たちに依頼してもいいか。わしじゃ解決できん問題があるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040125,
					"content": "おっ？これは仕事の依頼ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040126,
					"content": "どんな問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "わしは二か所、苗畑を切り開いた。ここはそのうちの一つだ。もう一つは村の西の方にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040128,
					"content": "だが、わしも年を取って、この頃は一人で世話しきれんでな。何日も行っとらんうちに、もう一つの苗畑が真っ黒い変なやつに荒らされてしもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040129,
					"content": "とても危険で、危く帰ってこれんところだった。それで、あの地に行くのがずっと怖いのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040130,
					"content": "今の一番の望みは、これからも花を育てられるように、苗畑の土をよくしたいということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040131,
					"content": "#複雑じゃなさそうだな。どうだ？{NICKNAME}。この依頼、引き受けてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040132,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "苗畑は村の西にある。道を間違えんでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040134,
					"content": "大丈夫だって、安心しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040116,
					"content": "世界を探索する冒険者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "そうだ。オイラたちは高い山や、大きい湖をたくさん越えて、スメールにやってきたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040118,
					"content": "オイラたちは…あれ、なんていったっけ。えっと…気宇壮大な冒険者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040107,
					"content": "ここで花を植えている人がいると聞いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "そうだ。わしが植えたのは花だ。石ころなぞではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040109,
					"content": "さっきはてっきり…ああ、どこから話せばいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "アファン"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アファン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "お前ら、戻ってきたのか。苗畑の調子はどうだった？まだ救えそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040402,
					"content": "もう解決したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "死域で起きたことをアファンに伝えた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "なるほど、そういうことがあったのだな。何だっていきなり、土からあんなにたくさん黒いものが出て来たかと思えば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040405,
					"content": "よしよし。これで安心して種を植えられるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040406,
					"content": "この三つの種が発芽して開花して、また新しい種になれば、それをまた畑に植える。そうすれば、ここは花いっぱいになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040407,
					"content": "えっと。これって…変な形の石か…？これで花が咲くのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040408,
					"content": "アファンじいちゃん。これ、どこから買ってきたんだ？まさか騙されてないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040409,
					"content": "チビ助は優しい子だな。だが大丈夫、これはモラでは買えん花の種なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040410,
					"content": "この三つは化け…コホン…ある友人がくれた大事な種だ。普通の果物や花の苗とは違うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040411,
					"content": "ますます怪しくなってきたぞ。アファンじいちゃん、いったいなにを育ててるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040412,
					"content": "ふふ。これはある友人からの頼みでな。彼の願いなのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040413,
					"content": "変な答えだな…これって育てられるものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040414,
					"content": "チビ助、お前に言ってもわからんだろう。またの機会に来てみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040415,
					"content": "ここは今は空っぽだが、この苗畑にある三つの種はいつか発芽して開花するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040416,
					"content": "こいつらが沢山生えて…はは、その時には絶対立派になるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040417,
					"content": "まあいい。依頼したからには、報酬はちゃんと支払うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040418,
					"content": "受け取ってくれ。多くはないが、それで全部だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "アファン"
				},
				{
					"id": 732040419,
					"content": "ふぅ。依頼完成だ。半日走り回ったらお腹がすいてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040420,
					"content": "#走り回ったのは{M#俺}{F#私}だけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "オイラだってずっと話してやってたじゃないか。話すのだって、結構エネルギーを消耗するんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040422,
					"content": "#ケチケチするなよ、{NICKNAME}。報酬で美味しいものを食べて自分に褒美をやろうぜ。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040423,
					"content": "報酬はどれくらいあるかな？なにが食べられそうか、早く見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040424,
					"content": "見てみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "へえ、モラより、食べ物のほうが入ってるな…シャワルマサンドにタフチーンに…それから野菜がいっぱい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040426,
					"content": "でもこれはいくらなんでも多すぎるぞ。オイラたち…アファンじいちゃんの一日分の食料をもらっちゃったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040427,
					"content": "アファンじいちゃんは一人で村の外に住んでて、大変そうだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040428,
					"content": "モラはまだしも、食料までもらっちゃうと。うぅ…ちょっと重く感じてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040429,
					"content": "それに、石みたいな種を植えて、それが…願いとか言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040430,
					"content": "一人暮らしが長すぎて、幻覚でも見てるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732040431,
					"content": "考えるほど心配になってきた。時間があったら様子を見に行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
