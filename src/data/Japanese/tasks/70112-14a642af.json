			"dialogs": [
				{
					"id": 701120201,
					"content": "よくやった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120202
					],
					"speakerTitle": "ジョセフス"
				},
				{
					"id": 701120202,
					"content": "どっちを褒めてるのか、よくわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 701120203,
					"content": "それじゃあ次は、事物の相互作用について考えてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "ジョセフス"
				},
				{
					"id": 701120204,
					"content": "元素反応、長距離力に短距離力…それと、干渉を避けることも忘れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "ジョセフス"
				},
				{
					"id": 701120205,
					"content": "なに言ってんだ？もう、わけわかんないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
