			"dialogs": [
				{
					"id": 701120101,
					"content": "そうだデクスター、もう昔とは違う。お前もそろそろ子供時代の終わりを迎えるべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "ジョセフス"
				},
				{
					"id": 701120102,
					"content": "お前も洗礼を受けて、大人しか知らないことを学ぶんだ。いいか、みっちゃん、一度しか教えないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "ジョセフス"
				},
				{
					"id": 701120103,
					"content": "なんだか遺言みたいな言い方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 701120104,
					"content": "最後の授業だ。まずは俺と一緒に読むぞ。「元素の分類」。やってみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョセフス"
				}
			]
		},
