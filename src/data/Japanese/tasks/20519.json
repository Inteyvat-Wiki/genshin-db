					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "まだ準備してるの？うん、準備が終わってから出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190402,
					"content": "あの方は一体？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "どんなに聞いても、教えないわ。これはこの仕事の最低限のマナーだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190404,
					"content": "教えたって…その情報は「教える必要がある」から教えることになってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190405,
					"content": "あっ、そうだ、私が言った言葉、そのどれが教える必要がある言葉か考えてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190406,
					"content": "目的は一体なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "目的…あの方の目的は、私にも分からないわ。でも、きっと彼もモンドを守るために動いてると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190408,
					"content": "うん…きっとそうよ、こういう大事になると、さすがに「趣味」で動くわけがないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190409,
					"content": "あら、いけない、そういうことは私が勝手に考えていいことじゃないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				}
			]
		},
