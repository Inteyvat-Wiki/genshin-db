					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "おかえりなさい、速いわね。あの方が君に頼む理由が分かったような気がするよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190202,
					"content": "報酬をちょうだい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "冷たいね…はい、報酬を受け取って。私だってただの使い走りだから、ちょっとは話に付き合ってよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190204,
					"content": "褒め言葉どうも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "どういたしまして。報酬を受け取って、それと…今後もよろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
