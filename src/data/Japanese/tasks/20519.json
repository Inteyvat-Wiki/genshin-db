			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190101,
					"content": "また会ったね、元気にしてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190102
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190102,
					"content": "そうそう、今のところジリアンナは良くも悪くもなってない。悪くないのは、まだモンドを離れてないこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190103
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190103,
					"content": "良くないのは、彼女がシスターヴィクトリアに自分のことを告白したけど、ヴィクトリアはまだ何の動きも見せてないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190104
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190104,
					"content": "この件はどう終わるか、気長に待つしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190105
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190105,
					"content": "…なにするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190106
					]
				},
				{
					"id": 205190106,
					"content": "そんな怖い目で見ないでよ、悪者じゃないし。ジリアンナを助ける方法を君に教えたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190107
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190107,
					"content": "さあ、本題に戻るよ。今回君を呼んだのは、前回の件で「ちょっとした問題」が残ったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190108
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190108,
					"content": "簡単に言うと、君が宝盗団を倒したのはいいことだけど、「ジリアンナがモンドにいる」ということを明らかにしたと同じよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190109
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190109,
					"content": "宝盗団は裏切り者を放っておくわけがない。私の知る限り、モンド周辺には宝盗団の痕跡が複数あって、しかも見たことのないやつらばかりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190110
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190110,
					"content": "おそらくジリアンナを狙って、ついでに復讐するつもりでしょうね。こんな危険なやつらは、君に倒してもらうしかないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190111,
						205190113,
						205190115
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190111,
					"content": "そっちが悪いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190112
					]
				},
				{
					"id": 205190112,
					"content": "まあまあ、こっちだって命令通りに動いただけだから。あの方がどうしても君がいいって言わなきゃ、私も君に頼んだりしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190113,
					"content": "自分でなんとかして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190114
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190114,
					"content": "そんな悲しいこと言わないでよ、君みたいに実力を持ってるわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190115,
					"content": "それは西風騎士団の管轄だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190116
					]
				},
				{
					"id": 205190116,
					"content": "それはそうだけど、ジリアンナのことを知ってる人は少ない方がいいって、あの方がそうおっしゃったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190117
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190117,
					"content": "それに、あの方は騎士団を巻き込むことを望んでない。なにせ…西風騎士団のやり方だと、余計大げさになりがちだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190118
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190118,
					"content": "たとえばホフマンとか、宝盗団がモンド周辺に現れたって聞いたら、きっとすぐに騎士団本部に報告するに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190119
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190119,
					"content": "もし騎士団がそのまま出撃したら、宝盗団も一目散に逃げるでしょ。宝盗団を一網打尽する計画も白紙に戻るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190120
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190120,
					"content": "だから、今回は君の「単独行動」で、効率よく倒してもらうしかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190121
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190121,
					"content": "でも…あの宝盗団がモンドの近くまで来るなんて、西風騎士団もとうに気付いて、行動を準備してるかもしれないわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190122
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190122,
					"content": "まあ、それは私たちの知ったことではないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190123
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190123,
					"content": "まあまあ、安心して、今回はちゃんとした報酬を用意したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190124
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190124,
					"content": "今回はあの方からモラをたくさんもらったからね。前回なんて自費だったもん…そうだ、宝盗団の位置を標記しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190125
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 205190125,
					"content": "じゃあ、モラに免じて、ジリアンナ、ルドルフ、そしてリリーとモンドを守る任務は任せたよ。頑張れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				}
			]
		},
