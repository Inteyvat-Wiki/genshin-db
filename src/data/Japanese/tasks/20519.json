				"objectNames": [
					"ホフマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "…宝盗団…おやっ、すまない！何か用事でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205190302,
					"content": "宝盗団がモンド周辺で活動してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "宝盗団？ちょうど宝盗団の追跡に向かおうとしているんだ。あいつら、モンドに近づくなんて、一体なにを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205190304,
					"content": "まあ、理由がどうあれ、きっと悪いことに決まってる。今回は人手をたくさん投入したから…その報告を対応する暇がしばらくないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 205190305,
					"content": "でも報告は記録しておく。例の宝盗団のことが終わったら、上に報告するよ。報告、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
