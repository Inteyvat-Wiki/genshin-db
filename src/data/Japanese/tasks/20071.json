			},
			"dialogs": [
				{
					"id": 200710401,
					"content": "こっちだよ、ほら来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710402
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710402,
					"content": "雪山に置いてきたお花のことは覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710403
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710403,
					"content": "もう1日経ったし、冷蔵保存の効果を確認したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710404
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710404,
					"content": "雪山に行ってお花を取ってきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710405,
						200710407
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710405,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710406
					]
				},
				{
					"id": 200710406,
					"content": "じゃあお願いね。フローラはここで待ってるから、早く戻って来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710407,
					"content": "どこに置いたかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710408
					]
				},
				{
					"id": 200710408,
					"content": "忘れたの？<color=#00E1FFFF>七天神像のそば</color>、<color=#00E1FFFF>山中の水辺</color>、それと<color=#00E1FFFF>洞窟の近く</color>だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710409
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710409,
					"content": "地図に標記してあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		}
	]
