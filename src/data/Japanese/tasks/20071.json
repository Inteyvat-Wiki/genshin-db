			"dialogs": [
				{
					"id": 200710301,
					"content": "前に雪山に置いてきたお花はどうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710302
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710302,
					"content": "今回の分も含めて全部ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710303
					]
				},
				{
					"id": 200710303,
					"content": "全部持ってきたの？よかった。早く見せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710304
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710304,
					"content": "ふふ、うまくいったみたい。うん…この方法はいいかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710305
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710305,
					"content": "でも、雪山はモンドから離れすぎね。毎回あなたに頼むわけにもいかないし、何か方法を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710306
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710306,
					"content": "とにかく、手伝ってくれてありがとう。これはお礼だよ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
