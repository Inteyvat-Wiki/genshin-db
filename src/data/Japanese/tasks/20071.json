			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "お花はどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710202,
					"content": "ごめんなさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "え？どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710204,
					"content": "うっかり花と箱を壊してしまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "こ、壊した！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710206,
					"content": "うぅ…あれはフローラが厳選したお花なんだよ。簡単には見つけられないきれいなお花なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710207,
					"content": "雪山ってそんなに危ないの？あなたのような冒険者でも、うっかり花を一箱も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710208,
					"content": "それでも手伝ってくれてありがとう。これを受け取って。フローラはお花のお世話をしなくっちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200710209,
					"content": "はあ…サラさんに教えてもらった方法をもう一回試してみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
