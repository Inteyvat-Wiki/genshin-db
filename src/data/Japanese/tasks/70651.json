			"dialogs": [
				{
					"id": 706510101,
					"content": "むっ、どうやら鉱石が足りないようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510102
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 706510102,
					"content": "鉱石集めに関して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706510103
					]
				},
				{
					"id": 706510103,
					"content": "鉱石？何か作るつもりか？武器か？それとも鎧なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510104
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 706510104,
					"content": "もし鉱石を集めたいなら、俺はいい場所を知っているぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 706510105,
					"content": "だが鉱石にも色々ある。一般的に使われている鉄の塊。扱いやすい白鉄の塊。優れた品質の水晶の塊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 706510106,
					"content": "それと魔晶の塊と呼ばれる鉱物だ。品質もよく、とても上等なものをつくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワーグナー"
				}
			]
		},
