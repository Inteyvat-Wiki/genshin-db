			},
			"dialogs": [
				{
					"id": 790580101,
					"content": "これは『絶境高飛』の撮影でボツとなったシーン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580102,
					"content": "本来構想した物語は、神秘的な洞窟に閉じ込められた水形幻霊が、本の中に隠した道具を頼りに逃げ出す話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580103,
					"content": "しかし、これはイディアさんに却下された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580104,
					"content": "確かに、水形幻霊は道具なんかなくとも洞窟から出られる。わざわざ道具を本の中に隠すというのも意味が分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580105,
					"content": "だが、これは絶対にウケるアイデアのはずだ。この考えをもっとちゃんとイディアさんに伝えることができれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580106,
					"content": "しかし、はぁ…まずは<color=#00E1FFFF>近くのヒルチャールに盗まれた道具の本</color>を取り返さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790580107,
					"content": "——「監督」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "撮影地の備考"
				}
			]
		},
