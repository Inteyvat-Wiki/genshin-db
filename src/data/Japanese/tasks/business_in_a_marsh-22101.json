			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "キリがないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "はあ、ここで旅館を開くのは大変ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010104,
					"content": "気のせいかもしれませんが…この周りの怪物が増えてきた気がするんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010105,
					"content": "近寄ってきたりはしませんが、お客様が通る道に千岩軍が四六時中警備できるわけでもありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010106,
					"content": "もしお時間がありましたら、旅館の周囲にいる怪物を片付けてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "アハハ、さすがですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010113,
					"content": "あなたに頼んでばかりで申し訳ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010114,
					"content": "解決しましたら、報酬はちゃんとお支払いしますので、ご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010115,
					"content": "では、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010108,
					"content": "この旅館…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "こんなところで旅館を開くと、自ずとこういう問題も起こるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010111,
					"content": "でも、それで旅館がなくなったら、お客様の休む場所がなくなるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010112,
					"content": "かなり大変ですが、旅館があること自体はいいことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				}
			]
		},
