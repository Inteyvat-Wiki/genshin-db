			"dialogs": [
				{
					"id": 221010201,
					"content": "どうです？周辺の怪物は倒しましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "急がなくて大丈夫です。あの怪物たちはせいぜい通行人の邪魔をするだけですし、旅館に入ったりしませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010204,
					"content": "入ってきたとしても…私が追い払いますので、ご心配なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010205,
					"content": "アハハ、この郊外で旅館を開くのですから、護身術くらいできて当然ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
