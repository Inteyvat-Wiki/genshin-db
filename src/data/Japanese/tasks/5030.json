				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "ああ、あんたらか！会えてよかったよ。いつぞやは勇気をくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "ウトゥロンク"
				},
				{
					"id": 50300802,
					"content": "ナタでは、アビスと戦うことを栄誉と見ている人が多い。けど冷静さを欠いて、知らないうちに窮地に陥ってしまう人もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "ウトゥロンク"
				},
				{
					"id": 50300803,
					"content": "あんたらの言う通りだった。戦うのはもちろん大切だが、自分の命も同じく大切だ。愛する人のために戦ってるからこそ、その人たちと再会するために命を大事にしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "ウトゥロンク"
				},
				{
					"id": 50300804,
					"content": "その考えを戦友たちに伝えたら、みんな頷いてたよ。おかげで戦闘中も冷静になって、いい戦果も出せた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "ウトゥロンク"
				},
				{
					"id": 50300805,
					"content": "本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウトゥロンク"
				}
			]
		},
		{
			"id": 503009,
