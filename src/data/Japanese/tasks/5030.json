					"キスプ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "どうしよう、人手も薬も足りません。未熟な私では、対処できないケガばかりです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "キスプ"
				},
				{
					"id": 50300102,
					"content": "もっと専門知識を持った人がいれば…ダメダメ、今は落ち込んでいる場合ではありません。気を引き締めなくては！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キスプ"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
