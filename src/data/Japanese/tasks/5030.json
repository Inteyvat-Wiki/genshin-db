				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アウィナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "運ばれてくるクイクさんを見たけど…お気の毒に。素敵なお医者さんだったし、将来の明るい方だったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "アウィナ"
				},
				{
					"id": 50300202,
					"content": "仕事で協力することも多くてね。彼女、薬の品質にこだわってて、患者を治すために自腹を切ることもあったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "アウィナ"
				},
				{
					"id": 50300203,
					"content": "モラを稼ぐより、経験を積むことが大事だって教えてくれたこともあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "アウィナ"
				},
				{
					"id": 50300204,
					"content": "最も優れた医術を身につけてこそ、誰よりも多くの人を、そして一番救いたい人を救えるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "アウィナ"
				},
				{
					"id": 50300205,
					"content": "惜しい人を亡くしたよ。医者は自分を救うのが難しいとはよく言ったものね…あんなに優秀な人を、ナタは失うことになるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アウィナ"
				}
			]
		},
