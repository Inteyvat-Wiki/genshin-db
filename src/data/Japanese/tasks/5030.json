			"dialogs": [
				{
					"id": 50300301,
					"content": "薬はあとどのくらい残ってるかしら？まだ足りそう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "マヤウェル"
				},
				{
					"id": 50300302,
					"content": "いえ、もう底をつきました。非常用のものがまだ少しありますが、医者と戦士たちのために残しておいたものですので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "キスプ"
				},
				{
					"id": 50300303,
					"content": "ええ、そうよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "マヤウェル"
				},
				{
					"id": 50300304,
					"content": "なら、私の分を出してちょうだい。",
