			"dialogs": [
				{
					"id": 721310101,
					"content": "独特な形をした石灯籠。不穏なエネルギーを放っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721310102,
					"content": "これは…石灯籠？なんでこんなところに石灯籠があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721310103,
					"content": "ん？なにか書いてあるぞ、見てみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721310104,
					"content": "「同僚の皆さん、この鎮め物に何か疑問がある場合、無想刃狭間にいる梶さんにご相談を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721310105,
					"content": "字の感じからして、書かれたのはつい最近のようだ。下には書き殴られた字で数行書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721310106,
					"content": "「役に立てなくて申し訳ない。昨日、天領奉行から緊急疎開令を受けた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721310107,
					"content": "「縁があったらまたいつか、『祟り神』の引き起こしたことについて相談しよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721310108,
					"content": "この梶さんっていう人が石灯籠と関係してるみたいだ。無想刃狭間に行って聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
