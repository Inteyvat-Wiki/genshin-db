			"dialogs": [
				{
					"id": 200460301,
					"content": "旅人、アナのことを頼むよ。あの子、最近少しはしゃぎすぎてる気がするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460302
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200460302,
					"content": "冒険者になってほしくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460303
					]
				},
				{
					"id": 200460303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460304
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200460304,
					"content": "妹の夢は尊重してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200460305,
					"content": "病気が治って、やっと自分の夢を追うチャンスを手に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200460306,
					"content": "アナの兄として、俺は…全力でそれを応援するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200460307,
					"content": "ただ、それだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		}
	]
