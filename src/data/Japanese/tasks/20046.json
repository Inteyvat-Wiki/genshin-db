			"dialogs": [
				{
					"id": 200460101,
					"content": "よし…今日も任務完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460102,
					"content": "やる気満々だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "もちろん。だって冒険者をやるのって、本当に面白いもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460104,
					"content": "でも…えへへ、依頼をこなす時、まだちょっと慣れないことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460105,
					"content": "旅人さん、また私と一緒に依頼を受けてもらえないかな？他にもあなたに教わりたいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460108,
					"content": "じゃあ、出発しよう。今日の依頼は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460109,
					"content": "うん…また運搬用の熱気球の護送…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460106,
					"content": "一緒に行こうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "いいの？えへへ、聞いてみたいことがまだまだあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "アナ"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
