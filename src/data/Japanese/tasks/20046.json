			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "終わった！ありがとう、旅人さん。今回の護送はすごく順調だったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460202,
					"content": "でも、冒険者が普段受けてる依頼って、いつもこんな感じなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460203,
					"content": "他の依頼も…あるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "なんか、色々言いたそうな顔だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460207,
					"content": "そ、そうなんだ…よし！私も頑張らなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460208,
					"content": "お金をいっぱい稼いだら、お兄ちゃんとお父さんとお母さんを連れて、みんなで旅行に行くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460209,
					"content": "お兄ちゃんは昔から旅行に行きたがってたの。でも…私が病気になっちゃったから、ここに残って私の面倒を見てたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460210,
					"content": "今は私も病気が治って、冒険者になった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460211,
					"content": "えへへ、お兄ちゃんの夢を叶える時が来たってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200460205,
					"content": "これから分かるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "えっ…なんでそんな疲れた表情をしてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "アナ"
				}
			]
		},
		{
			"id": 2004603,
