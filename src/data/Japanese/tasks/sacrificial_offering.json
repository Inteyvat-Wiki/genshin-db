			},
			"dialogs": [
				{
					"id": 721070401,
					"content": "言霊の使い方は、「惟神」の血筋が途絶えたことにより、失われました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070402
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070402,
					"content": "…あっ、すみません、あなたたちに気づきませんでした。「追憶のレンズ」は任せましたよ。それを持って、世界を見てみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲城蛍美"
				}
			]
