			"dialogs": [
				{
					"id": 721070201,
					"content": "これでよし！疲れたぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070202,
					"content": "疲れたのはこっちなのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070203
					]
				},
				{
					"id": 721070203,
					"content": "そんな小さいこと気にするなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070204,
					"content": "あれ、中に本がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070205,
					"content": "んん？む、難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070206,
					"content": "ぜんぶ読んだけど、まったくわからなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070207,
					"content": "まあいっか、専門家に聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070208,
					"content": "神とか鬼とか、そういった内容だったから…鳴神大社に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7210703,
			"completionStepIds": [
				7210707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210705",
							"3"
						],
						"stepId": 7210705,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210707",
							"2"
						],
						"stepId": 7210707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
