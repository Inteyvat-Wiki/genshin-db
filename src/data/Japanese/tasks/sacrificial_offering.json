			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"稲城蛍美"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070301,
					"content": "こんにちは、遠くからいらした旅人さん。「鳴神大社」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070302
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070302,
					"content": "悩みや願いがあるのなら、ここでおみくじを引いてみてはいかがでしょう。雷神様が祝福をくださいますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070303
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070303,
					"content": "なるほど、状況は理解しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070304
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070304,
					"content": "「神櫻大祓」は重要な儀式です。確かに関連の記載があります。ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070305
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070305,
					"content": "ですが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070306
					]
				},
				{
					"id": 721070306,
					"content": "ですが、具体的な方法はすでに失われてしまっているんです。あなたが持っている『要略』も、とても貴重な史料なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070307
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070307,
					"content": "失われてしまった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070308
					]
				},
				{
					"id": 721070308,
					"content": "まさかファデュイがやったのか？重要なことって聞くと、あいつらが裏で動いてるとしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070309,
					"content": "あっ、いえ、違います。不適切な保管による湿気や虫などが原因です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070310
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070311,
					"content": "はい、本当に残念ですが、数々の史料が失われてきました。八重様と神里様も以前それで苦悩されていましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070312
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070312,
					"content": "「言霊」についても、少し知っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070313
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070313,
					"content": "おう、じゃあ解き方をオイラたちに教えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070314,
					"content": "申し訳ございません。鎮め物を封印する「言霊呪法」は、特定の呪文ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070315
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070315,
					"content": "…言霊は、呪文をかけた者がその時に決めた単語なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070316
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070316,
					"content": "えっ？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070317,
					"content": "呪文は…その人が適当に考えたものってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070318,
					"content": "そういうわけではありません。一般的に言って、このような言霊には規則があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070319
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070319,
					"content": "詳しく教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070320
					]
				},
				{
					"id": 721070320,
					"content": "はい…本ではこう書かれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070321
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070321,
					"content": "第一句は自身の稲妻での威名。そのなんとかに「勅使」の二文字を加えたものです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070322
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070322,
					"content": "第二句は自身の力の根源の説明。例えば、「団子」、「ラーメン」、「娯楽小説」など。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070323
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070323,
					"content": "なるほど。たしかにどれも力の根源になるものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070324,
					"content": "ただの例えです。記載されていたものでは、「陰陽博暁」などがありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070325
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070325,
					"content": "そして第三句は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070326,
						721070327
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070326,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070328
					]
				},
				{
					"id": 721070328,
					"content": "はい…その通りです。第三句の内容は自由に決めることができるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070329
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070329,
					"content": "すでにこれほど長い時が経っていますので、おそらくこの世に第三句を知る者はいないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070330
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070330,
					"content": "じゃあ、どうするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070331,
					"content": "お面の巫女お姉さんの頼み…それにこの大地が…ぜんぶ終わっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070332,
						721070333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070332,
					"content": "焦らないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070334
					]
				},
				{
					"id": 721070334,
					"content": "はい、これがお二人の役に立つかと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070335
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070335,
					"content": "これは、<color=#00E1FFFF>「追憶のレンズ」</color>です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070336
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070336,
					"content": "「追憶」？なにかの思い出が詰まったものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070337,
					"content": "お二人は博識ですので、「写真機」については知っていますよね。異国フォンテーヌで生産された、映像を残せる器物です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070338
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070338,
					"content": "遥か昔、離島が建設されて間もない頃、当時の柊家当主である弘嗣様が異国の奇妙的な商品を取り入れ、貿易拠点を作ることで利益を得られると証明しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070339
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070339,
					"content": "例えば、スネージナヤから「高炉」を取り入れ、天守に隣接する柊家の旧宅を「温泉」に改築し、大御所様へと贈りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070340
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070340,
					"content": "さらに「狐斎宮様」が柊家に授けた退邪の鏡を「レンズ」として、フォンテーヌに思い出と記憶を記録できる写真機を作らせたのです。そして感謝のしるしとして、それを大社に贈りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070341
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070341,
					"content": "年月が経つにつれ、写真機本体の機能は失われました。しかし、狐斎宮様の祝福を得たレンズだけは、特殊な場所で見えざる物を見ることができたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070342
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070342,
					"content": "私たちはそのレンズを取り出し、「追憶のレンズ」と名付けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070343
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070343,
					"content": "お二人は「櫻」のために奔走していると聞きました。そしてお話を聞き、あなたたちは信用できる方々だと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070344
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070344,
					"content": "これをお二人に託します。どうか有効に使ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070345
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070345,
					"content": "そんな重要なもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070346
					]
				},
				{
					"id": 721070346,
					"content": "お二人は異郷から来られたのですよね。稲妻人は万物に魂があると信じています。石にも、木にも記憶があると。ならば百年ただ置かれてるだけの物も、さぞ悔しい気持ちを抱いていることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070347
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070347,
					"content": "大社の中で眠るより、縁のある方に授け、この数百年間で変化した世界を見せてあげてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070348
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070348,
					"content": "問題ない！オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070349,
					"content": "伝説によると、狐斎宮様が消えたあと、鳴神島にいた彼女の眷属である<color=#00E1FFFF>「地狐」</color>が、各地で像と化し彼女が帰るのを待っているそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070350
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070350,
					"content": "もし妙な形をした、小さな狐の像を見かけましたら…<color=#00E1FFFF>「追憶のレンズ」</color>を通して観察してみてください。普段見られないものが見られえるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070351,
						721070352
					],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070351,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070353
					]
				},
				{
					"id": 721070353,
					"content": "雷神のご加護があらんことを。お願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稲城蛍美"
				},
				{
					"id": 721070352,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070353
					]
				},
				{
					"id": 721070333,
					"content": "まだ話は終わってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070334
					]
				},
				{
					"id": 721070327,
					"content": "適当に考えたやつ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070328
					]
				}
			]
		},
		{
			"id": 7210704,
			"completionStepIds": [],
