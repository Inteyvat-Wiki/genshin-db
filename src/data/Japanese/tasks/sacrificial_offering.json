			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070101,
					"content": "狐神像…そうだ、紺田村と同じ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070102,
					"content": "でも、神像の中にある鎮め物が見えないぞ…まさか、どっかに隠されてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070103,
					"content": "またなにか厄介な<color=#00E1FFFF>秘密</color>でもあるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070104,
						721070106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070104,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たち…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070105
					]
				},
				{
					"id": 721070105,
					"content": "へへ、オイラたち良いコンビだよな。村長のじいさんもそう言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070107,
					"content": "待て！ここに字が書いてあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070108,
					"content": "<color=#00E1FFFF>「言霊をもって鎮め物をここに封印する。」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070109,
					"content": "ん？どういう意味だ？他にもなにか書いてあるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070110,
					"content": "「封印が解かれないことを願う。あなたから何年も音沙汰がないが、もし封印が解かれ、大祓が行われるなら、その者があなたであってほしい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070111,
					"content": "「第三の言霊はあなたがよく言っていたことだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070112,
						721070113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070112,
					"content": "難しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070114
					]
				},
				{
					"id": 721070114,
					"content": "どれどれ…「小生の後任者であれば、言霊を解く前に、まだ一手行う必要がある。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070115,
					"content": "「御霊には四魂、巴には三重。ここに<color=#00E1FFFF>三名の式神</color>を残し守護せん。<color=#00E1FFFF>それらが集いし時</color>、次へと至る。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070116,
					"content": "「この鎖はそれほど有用なものではないが、力のない賊を防ぐのには十分だろう」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070117,
					"content": "…えっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070118,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070119
					]
				},
				{
					"id": 721070119,
					"content": "オイラたち、ぜったいにこれを解決しなきゃだめだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070120,
					"content": "じゃないとオイラたち、「力のない賊」と同等になっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721070113,
					"content": "続きはまだある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070114
					]
				},
				{
					"id": 721070106,
					"content": "何も起きないといいんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070107
					]
				}
			]
		},
		{
			"id": 7210702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
