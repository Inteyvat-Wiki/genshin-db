				"objectNames": [
					"ジャカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "人違いですよ…師匠はカーネイで、私はジャカです…捕まえたいのは師匠のほうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640402,
					"content": "師匠のようなぬいぐるみは、私には作れっこないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640403,
					"content": "誰かに捕まったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "えっ…？あいつらの仲間じゃないんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640405,
					"content": "そんなわけないだろ、見てなかったのかよ？オイラたちがあいつらを追い払ったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752640406,
					"content": "そうだったんですか？やった！私はついに自由の身なんですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640407,
					"content": "もちろん、家に帰っていいぞ。でも…一体どういうことなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752640408,
					"content": "この連中はどこからかやって来て、リゾートのおもちゃを偽造してるんです。でもその品質はお粗末で、私の師匠のカーネイを捕まえて顧問にしようと秘かに企んでいたようですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640409,
					"content": "何を間違えたのか、私が捕まってしまって…絵の具の技術についてはまだ師匠から三日しか教わってないのに…とても要求通りにはできませんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640410,
					"content": "何はともあれ、本当にありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640411,
					"content": "アザカ、家に帰ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "ジャカ"
				},
				{
					"id": 752640412,
					"content": "～～～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザカ"
				}
			]
		}
	]
