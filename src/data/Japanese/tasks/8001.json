							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "さっきのアビスの魔術師…オイラたちを待ち伏せてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010202,
					"content": "いや、ヤツらはただ遺跡守衛の残骸から、何かを探そうとしていただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010203,
					"content": "そうなのか…そういえば旅人もよくそうやって探してるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010204,
					"content": "「混沌の装置」とか、「混沌の回路」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010205,
					"content": "それは重要な素材！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "少なくとも、そのような平凡な物ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010208,
					"content": "俺がこの近くを調査していたのは、アビスの魔術師がこの遺跡を頻繁に出入りしていたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010209,
					"content": "ヤツらは遺跡守衛の残骸から、ある「特別な貴重品」を探しているらしい。それを遺跡へと持ち帰ろうとしているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010210,
					"content": "しかし、あの様子を見るにまだ見つかっていないようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010211,
					"content": "じゃあ、どうしてさっき捕まえて詳しく聞き出さなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010212,
					"content": "ディルックさんがやってたね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "もちろん、あんなヤツらに慈悲を施すつもりはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010215,
					"content": "ただ、このことはアビス教団にとって、何か重要な意味があるような気がしてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010216,
					"content": "その真相は、拷問程度で吐くようなものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010217,
					"content": "言い換えれば、アビスの魔術師は拷問などを遥かに超えた恐怖に直面しているのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010218,
					"content": "恐怖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "な…なんか鳥肌が立ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010221,
					"content": "ここで時間を無駄にはできない。先に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010219,
					"content": "遺跡にあるものと関係が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "遠慮する必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "探してたのは別の物だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "ここ一帯はアビス教団だけじゃなくて、遺跡守衛の動きも活発みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010302,
					"content": "アビスの魔術師が潜伏してる場所に遺跡守衛もいるのは、ただの偶然か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010303,
					"content": "この世に偶然などない、全ては遥か古に撒かれた種によるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010304,
					"content": "あの酒場で貴様が現れたのと同様に…時間はその種を芽生えさせる要素でしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010305,
					"content": "#でも{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}のことは偶然聞いただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "気にする必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010308,
					"content": "アビス教団と遺跡守衛の関係も、もちろん偶然によるものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010309,
					"content": "同じ樹木より生えた枝と言ってもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010310,
					"content": "樹木？枝？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010311,
					"content": "ヤツらは皆、500年前に滅びた古国——「カーンルイア」で誕生したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010312,
					"content": "えっ？カーンルイアだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010313,
					"content": "そうか…アビス教団と遺跡守衛は、カーンルイアが滅びた後の残党だったってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010314,
					"content": "でもカーンルイアって、凄く古い国の名前だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010315,
					"content": "あ、そうだ。旅人にも説明しなきゃな。「カーンルイア」っていう国は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010316,
					"content": "「カーンルイア」なら知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010318,
					"content": "カーンルイアにいた記憶があるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "記憶？でも、あの国は500年前に滅びてるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010320,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010321,
					"content": "人は誰しも、秘密を抱えている。貴様が俺に深く聞かなかったように、俺も貴様のことを深く聞くつもりはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010322,
					"content": "しかし、貴様に話す意思があるのならば聞こう——貴様が見たカーンルイアとは、どんな光景だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010323,
					"content": "（もう隠し通せそうにない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "あの時の話にそんな経緯があったのか…オイラはてっきり、話の始まりは見知らぬ神との遭遇からかと思ってたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010327,
					"content": "#ふむ…この世界に来た時、隕石の中から{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}に呼び覚まされたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010328,
					"content": "#どうやら、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんの方が先に目覚めてたみたいだな。どれくらい先だったかは分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010329,
					"content": "#そして貴様の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}は、カーンルイアの滅亡が天変地異を引き起こすと言い、一緒にテイワットを去ろうと、そう言ったのだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010330,
					"content": "「カーンルイアの滅亡」？本当にそんなことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010331,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "貴様たちが経験したそれは…500年前の出来事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010334,
					"content": "どうやらこの世界で初めて目覚めたのも、それと同じ時期のようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010335,
					"content": "#つまり…おまえの{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんは先に目覚めてたから、この世界のこともおまえより知ってたってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010336,
					"content": "そしてその後、見知らぬ神によって貴様たちの行く道が阻まれたと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010337,
					"content": "その話ならオイラも聞いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010338,
					"content": "…そうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010339,
					"content": "貴様が目覚めた時、「カーンルイア」という地名については何も知らず、ただ急いでこの世界を去ろうとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010340,
					"content": "しかし今、テイワットを少しずつ知っていくうちに、あれが「カーンルイアが滅亡した戦い」だと考えるようになった、そうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010341,
					"content": "そういえば、旅をしている間、古い書物をたくさん調べてたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010342,
					"content": "モンドや璃月の各地で集めた書物に対して、「あまり役に立たない」とか言ってたし…なにか探してるようだったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010343,
					"content": "#それって、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんを探すために、カーンルイアについて調べてたんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010344,
					"content": "あれは「七神」に次ぐ手がかりだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "なるほどな。七神を探したいなら、七国を巡ればいいけど、カーンルイアは500年前に滅亡したから、今はもうなくなってるもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010347,
					"content": "カーンルイアについては、俺の方が詳しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010348,
					"content": "カーンルイアは神を持たない国——神は死んでも去ってもない。ただ最初からカーンルイアの歴史には存在しなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010349,
					"content": "あれは人類によって建てられた強大な国であり、人々はその輝かしい繁栄と文明に誇りを持っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010350,
					"content": "神が…存在しない…国…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010351,
					"content": "そして、貴様の記憶にもあるように——全てが、神によって滅ぼされた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010352,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010353,
					"content": "500年前、神々が降臨し、カーンルイアを滅ぼした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010354,
					"content": "「人類の誇り」も、雑草のように神々の庭から駆除された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010355,
					"content": "そんな…歴史の本にも載ってないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010356,
					"content": "ひどい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "ふむ、このまま過去のことを話しても、気が削がれるだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010359,
					"content": "（でも次にウェンティと鍾離先生に会ったら…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "まずは先に進もう。貴様が知りたがっていることは、進みながら教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010360,
					"content": "（きちんと聞く必要がある。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#危険な世界だ…早く{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_KONG]}を見つけないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "「一つの地名」という手がかりだけだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "確かにそう言っていた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "（ダインとカーンルイア…賭けてみるか。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "#（{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を呼び覚ました人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "（それと、目覚めた後に見た火の海…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "なんだか…よく分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "う～ん、アビスの魔術師の体から出てきたこの呪符…もしかして、なにかの「メッセージ」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010402,
					"content": "ふむ、この気配「アビスの使徒」と関係しているようだな。アビスの魔術師から出てきたということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010403,
					"content": "おそらく、ヤツらの行動に関わる内容が記載されているのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010404,
					"content": "でも、この文字全然読めないぞ。カーンルイアの文字なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010405,
					"content": "#「…敵の信仰を薪とし、崇高なる{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}様に栄光の火を灯さん…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010406,
					"content": "そ、それが…メッセージの内容か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010407,
					"content": "「——『運命の織機』、原初の計画。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010408,
					"content": "どうやら…「アビス」共はある計画を実行しているようだ。そして、その鍵となるのが…「運命の織機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010409,
					"content": "まだ初期段階のようだが、いろいろと試行錯誤をしているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010410,
					"content": "「運命の織機」？えっと…「運命を織る機械」ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010411,
					"content": "アビスの魔術師はあの遺跡から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "たしかに、あの不気味な遺跡、見るからにその計画と関係がありそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010414,
					"content": "ダイン、メッセージには他になにが書いてあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010415,
					"content": "今読んでいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010416,
					"content": "ふむ…複雑で理解できない部分もあるが、狂気に満ちた計画であることは確かだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010417,
					"content": "どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010418,
					"content": "一言で言えば、計画の初期段階は「渦の魔神」オセルと関係している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010419,
					"content": "「渦の魔神」！あの海の中にいる魔神だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010420,
					"content": "前に仕留め損ねた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "でも、オセルになにをしようとしてるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010423,
					"content": "まさか、トワリンと同じように？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "その事件については俺も知っている。アビス教団が「龍災」でやったこともな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010425,
					"content": "結果を見れば、貴様たちはすでにアビス教団の計画を一度阻止したことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010426,
					"content": "この前は「神の眷属」で、今回は「古の魔神」か…うーん、標的がどんどん大きくなってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010427,
					"content": "「アビス」は今回も、トワリンの時みたいに騙したり魔術を使ったりして、オセルを腐食させようとしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010428,
					"content": "いや…この「メッセージ」によれば、今回の計画はさらに進んだものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010429,
					"content": "精神の改造に限らず——「耕運機」を製造する技術により、オセルの肉体を改造しようとしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010430,
					"content": "そ…そんなことできるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010431,
					"content": "まさか…アビス教団のヤツら…「究極殺人兵器·機械魔神烏賊」を作ろうとしてるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010432,
					"content": "たぶんそうみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "今となっては、カーンルイアの文明を識る者は少ない。それがどの程度のものか判断するのも難しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010435,
					"content": "だが、アビス教団がカーンルイアの失われた文明を追い求め——その意志と執念だけで動いていることは確かだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010436,
					"content": "どうやら、「穢れた逆さ神像」をもとに、オセルの体を機械魔神に改造するとこのメッセージには書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010437,
					"content": "そして「最古の耕運機の目」は…神像の手のひらにあるエネルギーの「新たなコア」となるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010438,
					"content": "最古の耕運機の目？…あっ！オイラ分かったぞ！アビスの魔術師がずっと探してたのは、それだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010439,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010440,
					"content": "まだ見つかってない、時間はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "話がどんどん複雑になってきたな。でもやっぱり…あの不気味な七天神像と関係があったってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010443,
					"content": "ああ。メッセージによれば、その「目」を「穢れた逆さ神像」の手のひらに置けば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010444,
					"content": "「天空の島にある神座を揺るがす」力を、新たに誕生した魔神に与えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010445,
					"content": "（天空の島…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "…この計画…スケールが大きすぎてわけがわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010448,
					"content": "でも、「最古の耕運機」がどこにあるのか誰も分からないんだよな？だったら…まずは「神像」から調査してみるのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010449,
					"content": "あの神像、風神像だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "ああ、吟遊野郎はいつも場所を転々としてるから、<color=#00E1FFFF>西風教会</color>に聞いた方が早いだろうな。なにか分かるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010452,
					"content": "大聖堂か…ふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010453,
					"content": "ダイン、どうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010454,
					"content": "気にするな、先を急ごう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010450,
					"content": "西風教会で聞いてみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "（神座を揺るがす…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "先に見つけよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "あだ名が長い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "群玉閣で鎮圧された…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "逆さの神像と関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "あそこを見ろ、遺跡守衛とアビスの魔術師がいるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010502,
					"content": "さっき、遺跡守衛は全部カーンルイアから来たって言ってたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010503,
					"content": "それって、カーンルイアには守らなきゃいけない遺跡がたくさんあったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010504,
					"content": "いや、「遺跡守衛」という名は現代人がその「印象」から勝手につけたものだ。500年前の人々はそう呼んでいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010505,
					"content": "現在は遺跡守衛などと呼ばれているが、当時のカーンルイアでのコードネームは、「耕運機」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010506,
					"content": "耕運機？変な名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010507,
					"content": "農業機械だったの！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "貴様たちが考えているものではない。「耕運機」とはあくまでもコードネーム。当時のカーンルイア人は兵器にコードネームを使用していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010510,
					"content": "「土地は農具で耕すものではない、鉄と血で争奪するものだ。」——この理念をもとに、「耕運機」が誕生した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010511,
					"content": "鉄と血で土地を争奪？カーンルイア人が言う「土地」って…なんだか不穏な雰囲気がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010513,
					"content": "カーンルイアが滅亡した今、主を失った「耕運機」は制御不能になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010514,
					"content": "長い時を彷徨い、このテイワット大陸に点在している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010515,
					"content": "他の滅びた文明と共鳴するかのように、古代遺跡の中を只々彷徨っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010516,
					"content": "なんか…かわいそうだ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010517,
					"content": "500年も彷徨い続けるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "これ以上深く話しても、貴様たちには何の意味もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010521,
					"content": "何はともあれ、今のヤツらは「脅威」だ。全て片付けた方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010518,
					"content": "苦しみから…解放してあげよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "おう、おまえはよくやってるとオイラは思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010508,
					"content": "でもあの殺傷力のある武器は一体…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}