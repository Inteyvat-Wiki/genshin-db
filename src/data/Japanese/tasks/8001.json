				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "再会は…俺が想像していたよりも早い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010102,
					"content": "あっ、ダインだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010103,
					"content": "その顔、何やら不気味なものにでも遭遇したようだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010104,
					"content": "まさか、遺跡の中で「アビスの使徒」に会ったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010105,
					"content": "なんで分かったんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010106,
					"content": "俺は「アビスの使徒」を追跡していたんだ。もちろん、ここで貴様たちに会うのは想定外だったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010107,
					"content": "実は、使徒だけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "逆さの神像…手中のアビスエネルギー…いや、そんなものは俺も見たことがない。だが…あらかた予想はつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010110,
					"content": "まずは貴様たちが見たことを話せ。アビスエネルギーがあった遺跡の底から逃げた後のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010111,
					"content": "そのあと、遺跡の出口で突然現れた「アビスの使徒」に道を阻まれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010112,
					"content": "オイラたちはそいつと戦ったんだ。もしかしたら、まだ近くにいるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010113,
					"content": "なるほど、これは千載一遇のチャンスだ。俺について来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80010114,
					"content": "わかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "行こう！ダインが手伝ってくれるなら、謎がいっきに解けるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80010115,
					"content": "いや、雇用主はこっちだったような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "遺跡にはもっと不気味なものが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
