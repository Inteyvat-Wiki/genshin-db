			},
			"dialogs": [
				{
					"id": 761960201,
					"content": "ドロータ！どうしてここにいるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960202,
					"content": "リンネア、ちょうどいいところに来たわね！今、みんなに月落銀の素晴らしさを説明していたところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960203,
					"content": "月落銀よ、月落銀…月下の世界にキミより完璧な宝石があるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960204,
					"content": "見て！非の打ちどころのない造形、珠玉のような滑らかな手触り！そして、このカラフルな白さ、比類なき元素との親和性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960205,
					"content": "私の心の中では、キミに匹敵するのは空に浮かぶ月だけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960206,
					"content": "確かに、月落銀はとても綺麗な鉱石ですね。私も標本用にいくつか収集してますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960207,
					"content": "そうでしょう！やっぱり、キミなら分かってくれると思ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960208,
					"content": "でも、月落銀のことを一番分かってるのは絶対に私なんだから！キミが協会の顧問だとしても、この座は譲らないわよ、ふふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960209,
					"content": "そうそう、いつもはキミが冒険者に講義してるけど、今日は私がキミをテストしてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960210,
					"content": "ここに三つの月落銀があるの。残念ながら、そのうち二つにはわずかな欠陥があって、もう一つは私の秘蔵品で、月落銀の中の月落銀よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960211,
					"content": "どれが最も完璧な月落銀か、見分けられるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960212,
					"content": "よく見せてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960213,
					"content": "左の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960214,
					"content": "（あれ？ルミは何を…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960215,
					"content": "これです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960216,
					"content": "リンネアでも間違えることがあるのね。実はこれ、目立たないところにほんの小さな傷があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960217,
					"content": "うぅ、参りました…でも、次はこんなにあっさり負けませんからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960218,
					"content": "いいわ、いつでも付き合ってあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960232,
					"content": "ドロータが主催した月落銀鑑賞大会に成り行きで参加して、楽しいひとときを過ごした…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "みんながこんなに盛り上がってくれるなんてね。残念だけど、素敵な時間はあっという間に過ぎちゃう…そろそろ片付けを始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960233,
					"content": "手伝います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960234,
					"content": "助かるわ！ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960231,
					"content": "もう少し考えさせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960220,
					"content": "真ん中の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960221,
					"content": "（ルミはこれが気に入ったみたいだね。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960222,
					"content": "これです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960223,
					"content": "ああ、キミも感じるでしょ！完璧なものから放たれる、抗えない魅力を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960225,
					"content": "右の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960226,
					"content": "（あれ？ルミは何を…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960227,
					"content": "これです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960228,
					"content": "リンネアでも間違えることがあるのね。実はこれ、目立たないところにほんの小さな傷があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960229
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960229,
					"content": "うぅ、参りました…でも、次はこんなにあっさり負けませんからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960230
					],
					"speakerTitle": "リンネア"
