				]
			},
			"dialogs": [
				{
					"id": 761960301,
					"content": "確認してください。漏れはないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960302,
					"content": "うん——問題ないわ、ちゃんと揃ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960303,
					"content": "月落銀を並べて、地面に面白い模様を描いてるのを見ましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960304,
					"content": "そうなの！結構工夫したんだから。こうした方が、みんなの月落銀への興味をもっと引き出せると思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960305,
					"content": "そういえば、ナタの民話にこんな話があるって聞いたんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960306,
					"content": "星に住んでた少女が大地に落ちた後、空に戻るために大地に巨大なラクガキを残しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960307,
					"content": "その後、空にいるお父さんの太陽は彼女のお願いを見つけて、彼女を空に連れ戻したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960308,
					"content": "もしかしたら、お父さんの太陽もドロータが並べた模様を見て、月落銀のファンになってくれるかもしれませんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960309,
					"content": "あはは！もしそうなったら、私は最高の月落銀広報大使ってことね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960310,
					"content": "でもそれよりも、鳥に狙われないか心配なの。ほら、カラスとかってキラキラした物が好きでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960311,
					"content": "確かにそうですね。それにカラスだけじゃなくて、クンクンモグラとか宝盗イタチにも気をつけないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960312,
					"content": "それと、ルミにもね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "ドロータ"
				},
				{
					"id": 761960313,
					"content": "あはは、そうでした！ルミにも注意しないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761960314,
