			"dialogs": [
				{
					"id": 700270101,
					"content": "ちょうどいいところに来てくれた。「プルシナスパイク」の修理は順調だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270102,
					"content": "この部品さえあれば、最速で修理できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270103,
					"content": "少し集めた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "ありがとう。本当に助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270105,
					"content": "この部品さえあれば、最速で修理できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270106,
					"content": "ただ他にも、君と相談しておきたいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270107,
					"content": "君が部品を集めている間、「プルシナスパイク」の内部構造を詳しく調べたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270108,
					"content": "とても巧妙な構造でな、さすがあのプルシナ先輩が作った精密な機器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270109,
					"content": "わずかな調整でも全体の機能に大きく影響する。だから意図した通りの効果が得られるかどうか、とても不安だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270110,
					"content": "念のため、君にテストをお願いしたいんだ。テストで得たデータを基に、さらなる調整を行う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270111,
					"content": "こうして「プルシナスパイク」の効果を確実に引き出す。そうしないと、特異体との戦闘時に故障してしまったら取り返しのつかないことになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270112,
					"content": "慎重だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "今回は初めて「プルシナスパイク」を実用するから、慎重に進めた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270115,
					"content": "じゃあ、君にテストをお願いする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700270113,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
