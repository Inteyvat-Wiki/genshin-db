					}
				]
			},
			"dialogs": [
				{
					"id": 740340601,
					"content": "よお、アイオーヌ。息せき切って、何の用だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340602
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340602,
					"content": "ディフォールさん、実はですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340603
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340603,
					"content": "アイオーヌはこれまでの経緯を詳しく話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340604
					]
				},
				{
					"id": 740340604,
					"content": "俺に助けを求めるのはお門違いじゃないのか。この通達書のキモは「秘密保持」だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340605
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340605,
					"content": "いえ…主語は「この通達書」だと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340606
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340606,
					"content": "文法的には確かにそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340607
					]
				},
				{
					"id": 740340607,
					"content": "おい、いま大事なのはそこじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340608,
					"content": "慎重でよろしい。だが、この通達書にはサインしかねるな。どう考えても、これはガッティーノが主導すべき仕事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340609
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340609,
					"content": "ガッティーノさんが、あなたにやってもらえと仰ったので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340610
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340610,
					"content": "はぁ？俺に？どうしろっていうんだよ？メガホンを持って出勤してくる職員全員に呼びかけろとでも言うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340611
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340611,
					"content": "「あの、皆さん！情報漏洩防止のため、写真機の持ち込みは禁止されています。絶対に持ち込まないでください！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340612
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340612,
					"content": "それとも何百枚も通達書をコピーして、職員全員がコーヒー片手に読めるように各人のデスクに配りゃいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340613
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340613,
					"content": "ガッティーノみたいに秘密を洩らしたやつを捕まえて懲らしめることなんて、俺にはできない。俺たちにできるのは、誰も読まない通知を出すことくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340614
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340614,
					"content": "でも、ガッティーノさんのサインはもうもらってあるんです。ほら、ここに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340615
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340615,
					"content": "おいお前、「協力者」ってのがどういう意味がわかってんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340616
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340616,
					"content": "えっと…指示通りに動いてくれる人でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340617
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340617,
					"content": "「少なくとも、自分に主たる責任はない」って意味なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340618
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340618,
					"content": "俺は絶対、この通達書にはサインしない。どうしてもうちの部署でやれっていうんなら、マネヴァルが直接頼みに来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340619
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340619,
					"content": "ディフォールは怒りながら立ち去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340620
					]
				},
				{
					"id": 740340620,
					"content": "こ、声のでかいやつだなあ。口を挟む隙もなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340621,
					"content": "だから、あの方は気性が荒いと言ったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340622
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340622,
					"content": "これからどうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340623
					]
				},
				{
					"id": 740340623,
					"content": "心配はご無用です。ロアルテさんに頼みましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
