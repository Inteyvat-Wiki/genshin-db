					}
				]
			},
			"dialogs": [
				{
					"id": 740340501,
					"content": "おや、アイオーヌさん。奇遇ですね。今日の仕事終わりにコーヒーでもいかがです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340502
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340502,
					"content": "お気持ちは嬉しいんですけど、今日は「秘密業務」をお願いしたくて来たんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340503
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340503,
					"content": "「秘密業務」…？はて、そんな仕事がありましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340504
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340504,
					"content": "多分ご存知ないと思います。私も今朝、書類を受け取ったばかりなので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340505
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340505,
					"content": "これは、珍しいこともあるものですね。今日はまだ『スチームバード新聞』に目を通していなかったので、情報をつかみ損ねてしまったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340506
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340506,
					"content": "秘密の業務が、なんで『スチームバード新聞』に載るんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340507,
					"content": "ははは。記者というのは、共律庭内部の我々よりも先に情報を伝達するものなのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340508
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340508,
					"content": "まぁ当たり前と言えば当たり前の話です。それが彼らの稼業なのですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340509
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340509,
					"content": "ええ…ちょっと言ってることの意味がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340510,
					"content": "その話は一旦置いておいて、仕事の件なんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340511
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340511,
					"content": "アイオーヌはこれまでの経緯を詳しく話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340512
					]
				},
				{
					"id": 740340512,
					"content": "なるほど、確かにそうした通達は必要でしょうね。以前にもデスク周りのインテリアを自慢するために、デスクの写真を撮ったお馬鹿さんがいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340513
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340513,
					"content": "彼は「写真機愛好家協会」のメンバーでしてね、撮った写真を他の会員に見せていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340534
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340534,
					"content": "しかし会員の中に記者がいて、共律庭内部の通知文書らしきものが写っていることに気がついてしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340514
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340514,
					"content": "他にも魚だらけの共律庭の夕食に不満を抱いた輩のリークした情報が、翌日の『スチームバード新聞』に載ったこともありましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340515
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340515,
					"content": "そんなことまで秘密にしなきゃいけないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340516,
					"content": "大した情報じゃないように思えるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340517
					]
				},
				{
					"id": 740340517,
					"content": "どんなことであれ、内部情報ですから、当然外部に漏らしてはいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340518
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340518,
					"content": "フォンテーヌ廷の人たちは共律庭を笑いものにする機会を虎視眈々と狙っているのですから、油断は禁物です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340519
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340519,
					"content": "向こうは我々が何をしようと一切関心はないでしょうがね。彼らはどんなことでもいいから…ふぅ…笑いたいだけなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340520
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340520,
					"content": "えっと、つまり…今回の通達書は、そちらで引き受けてくださると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340521
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340521,
					"content": "ですが人事関連の規定によれば…ディフォールさんの部署のほうが、通達を出すのにふさわしいようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340522
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340522,
					"content": "通達で秘密保持の原則を伝えることも重要ですが、いかにそれを周知させるかということのほうがより重要ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340523
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340523,
					"content": "ディフォールさんがメインで、うちはサポートに回ったほうがいいと思いますよ。そのほうが効率的だし、秘密も守れるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340524
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340524,
					"content": "ガッティーノはサラサラと書類の協力者欄にサインをした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340525
					]
				},
				{
					"id": 740340525,
					"content": "でもガッティーノさん、この件は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340526
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340526,
					"content": "こういう急ぎの仕事を先延ばしにしてはいけませんよ。さあ、早くディフォールさんのところへお行きなさい。日々の業務で彼の忍耐力が尽きてしまう前にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340527
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340527,
					"content": "私も秘密保持の原則について調べておきますから。通達が正式に出たら、うちの部署も全力でサポートしますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340535
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340535,
					"content": "さあ、早く探しにお行きなさい！私はまだ…他の仕事をやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340536
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340536,
					"content": "ガッティーノは大股で離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340528
					]
				},
				{
					"id": 740340528,
					"content": "え？ガッティーノさん、ちょっと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340529,
						740340530
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340529,
					"content": "行っちゃった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340531
					]
				},
				{
					"id": 740340531,
					"content": "ガッティーノさんの能力を思い知ったでしょう？彼があらゆる業務を適切に処理できるのは、面倒な仕事を引き受けないからなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340532
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340532,
					"content": "能力って、責任逃れをする力のことだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340533,
					"content": "しょうがない…ディフォールさんのところへ行きましょう。どうぞ、こちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340530,
					"content": "あっという間にいなくなったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340535
					]
				}
			]
		},
