			},
			"dialogs": [
				{
					"id": 740340901,
					"content": "機密に関する業務は、お前たちの部署で仕切るのが当然だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340902
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340902,
					"content": "つまり、今後我々の取り扱う業務は、人事に関係していたとしてもあなた方に知らせる必要はないわけですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340903
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340903,
					"content": "拡大解釈するな。それとこれとは別問題だろうが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340904
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340904,
					"content": "別問題かどうかは、私には判断しかねます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340905
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340905,
					"content": "また…僕のせいでこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340906,
						740340907
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340906,
					"content": "怖いよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340908
					]
				},
				{
					"id": 740340908,
					"content": "#{NICKNAME}…オイラたち外に出てようか。大人のケンカは怖すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340909,
					"content": "はいはい、二人とも落ち着け！そんなつまらないことでケンカするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340910
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340910,
					"content": "どこがつまらないと言うのです。これは共律庭全体に関わる一大事ですよ。この件は、私の一存では決めかねます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340911
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340911,
					"content": "確かに、機密はどれも大事だ。ガッティーノのところ以外に、この件を仕切れる部署はないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340912
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340912,
					"content": "どうしてそう、どっちが仕切るかで揉めるんだ？俺は、別にメインもサブも決める必要はないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340913
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340913,
					"content": "え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340914
					]
				},
				{
					"id": 740340914,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340915
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340915,
					"content": "ロアルテさん、それはどういう意味です？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340916
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340916,
					"content": "ちょっと思考回路についていけないんだが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340917
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340917,
					"content": "二人とも、経験豊富なベテランだろ？まずは複雑な業務を分担して、シンプルにしてしまおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340918
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340918,
					"content": "写真機による情報漏洩の防止は、ガッティーノさんにお任せするのが妥当だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340946
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340946,
					"content": "だが余計な仕事をする必要はない。いつも通り、機密を洩らした者を捕まえてくれればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340919
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340919,
					"content": "写真機持ち込み全面禁止の周知という厄介な仕事は、ディフォールさんにしか処理できないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340920
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340920,
					"content": "強制力のない俺たちの言うことなんて、誰が聞くと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340921
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340921,
					"content": "いやいや、その点は心配いらんさ。強制力は、ガッティーノさんの部署が持てばいい。君には「通達」というより、「提案」の仕事をお願いしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340922
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340922,
					"content": "その「提案」をでかでかと印刷して、共律庭の入口に貼るんだ。その下に写真機による情報漏洩の例を付け加えれば、万事オッケー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340923
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340923,
					"content": "前に聞いた話となにも変わってない気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340924,
						740340925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340924,
					"content": "腑に落ちない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340926
					]
				},
				{
					"id": 740340926,
					"content": "あの…ロアルテさん、よくわからないのですが、それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340927
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340927,
					"content": "私も賛成です。無駄のない見事なプランですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340928
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740340928,
					"content": "えっ、ええ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340929
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340929,
					"content": "提案書か？ふっ、それならお手の物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340930
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340930,
					"content": "よし、これで全員の合意がとれたな。アイオーヌくんは改めて文書を作成して、二人に見てもらえ。では…各自仕事に戻るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340931
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340931,
					"content": "ガッティーノとディフォールは互いに目を見合わせ、それぞれの持ち場に戻った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340932
					]
				},
				{
					"id": 740340932,
					"content": "ロアルテさん、私がヘマをしたせいでご迷惑おかけして…申し訳ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340933
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340933,
					"content": "そんなに自分を責めるな、君のせいじゃない。少なくとも100％君が悪いとはいえないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340934
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340934,
					"content": "どうして二人とも急に提案を受け入れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340935
					]
				},
				{
					"id": 740340935,
					"content": "わかりません…何がなんだか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340936
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340936,
					"content": "そうだぞ。なんであの二人は急にケンカをやめたんだ？取っ組み合い寸前だったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340937
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340937,
					"content": "それは、二人が何に一番こだわっているかを見極めたからだ。彼らが余計な仕事を増やすのが嫌で、ごねていたと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340938
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340938,
					"content": "——それは違う。他の部署に仕事の口出しをされるのも、大きな責任を負うのも嫌だったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340939
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340939,
					"content": "その問題を解決したから、それなりに納得して仕事を始める気になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340940
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340940,
					"content": "でも…さっき仰っていたプランだと、お二人とも責任を負うことになりますよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340941
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340941,
					"content": "そこんとこも、ベテランのガッティーノさんとディフォールさんなら、よくわかってるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340942
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340942,
					"content": "共律庭という大きな組織の中じゃ、一人ひとりが責任を負わねば仕事ってのは回らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340943
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340943,
					"content": "責任の重さは調整できても、責任を逃れることはできない。どうしても拒否したいなら…面倒が振りかからないよう祈るほかないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340944
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340944,
					"content": "まぁそんなに深く考えずとも、アイオーヌくんにもそのうちわかる。いま君がすべきなのは急いで「提案書」を書き上げて、俺に見せることだ。いいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340945
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740340945,
					"content": "はい、ロアルテさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340947
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340947,
					"content": "ロアルテは急いで離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340948
					]
				},
				{
					"id": 740340948,
					"content": "はぁ、また徹夜だ…コーヒーを買ってこないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340949,
						740340952
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340949,
					"content": "しょっちゅう徹夜するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340950
					]
				},
				{
					"id": 740340950,
					"content": "しょっちゅうってほどじゃ…ただ…もう徹夜には慣れっこなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340951
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340951,
					"content": "何はともあれ、仕事が終わればいいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340954
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340954,
					"content": "はぁ…ただ時々考えるんです。私がやっている仕事に意味はあるのかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340955
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340955,
					"content": "毎日タイプライターを打って、書類を作って、上から下への伝言ゲーム…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340956
					],
					"speakerTitle": "アイオーヌ"
				},
				{
