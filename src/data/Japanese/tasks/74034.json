						"position": [
							-4.946,
							0,
							4.838
						],
						"pointId": 29
					}
				]
			},
			"dialogs": [
				{
					"id": 740340701,
					"content": "アイオーヌ、何やらあまりよくない話みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340702
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340702,
					"content": "はい、そうなんです。正確には、「機密」の話をしに来たんですけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340703
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340703,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340704
					]
				},
				{
					"id": 740340704,
					"content": "そりゃおもしろい。で？「機密」の話ってのは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340705
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340705,
					"content": "アイオーヌはこれまでの経緯を詳しく話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340706
					]
				},
				{
					"id": 740340706,
					"content": "それは確かにあり得るな。ここの職員は機密の重要度に対する認識が甘いようだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340707,
						740340708
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340707,
					"content": "そんなに認識が甘いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340709
					]
				},
				{
					"id": 740340709,
					"content": "教えるのはガッティーノたちの仕事だ。共律庭を行き交う書類は、全部あいつらが重要度別に分けて印をつける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340710
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340710,
					"content": "——聞いた感じじゃ、いい制度に思えるだろ？だがあいつらは手間を省くために、全部の書類をいずれかの「機密」に振り分けてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340711
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340711,
					"content": "先週も、カルシックスがエピクレシス歌劇場でスピーチをしたとき、新作オペラについて話した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340712
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340712,
					"content": "そう長いスピーチじゃないが、聴衆は多かった——その原稿は新聞にまで掲載された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340713
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340713,
					"content": "大勢の前で話したんだったら、みんな知ってるよな？それが機密扱いされるわけはないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340714,
					"content": "そう思うだろ？だがそれでも、ガッティーノは絶対「機密」に指定するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340715,
						740340716
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340715,
					"content": "大事な内容が含まれてたとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340717,
					"content": "変だろ？公衆の面前で発表したスピーチ原稿は「機密」指定するくせに、それより前の下書きについては放置なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340718
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340718,
					"content": "カルシックスは自分でスピーチ原稿が書けないから、いつも誰かに代筆させてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340742
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340742,
					"content": "書類に署名をして、どうでもいい形容詞にいくつか手を入れる…あいつがやったのはそれだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340719
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340719,
					"content": "でもその修正前の下書きは、カルシックスさんのオフィスのデスクに積みっぱなしになってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340720
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340720,
					"content": "それがガッティーノの守りたい秘密なんだとしたら、あいつはなんでそれを機密に指定しないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340721,
						740340722
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340721,
					"content": "それも秘密を守る一種の方法、とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340723,
					"content": "まさか！あいつら、楽することしか頭にないんだ。ガッティーノは、あらゆるものを機密扱いするのが秘密の保持に最も有効だと思ってやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340724
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340724,
					"content": "だがそれじゃ、どれが本当に守るべき秘密なのかわからなくなるだろ？あいつ自身もそうなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340725
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340725,
					"content": "まあでも、水を隠したければ、湖に入れればいい——そういうやり方も間違ってないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340726
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340726,
					"content": "じゃあフォンタを隠したければ？お前は湖をフォンタ湖にでもするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340727
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340727,
					"content": "#フォンタ湖…へへ…オイラそこで泳ぎたいぞ。フォンタって美味しいよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340728,
						740340729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340728,
					"content": "パイモン、大事なのはそこじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340731
					]
				},
				{
					"id": 740340731,
					"content": "それで…通達書は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340732
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340732,
					"content": "アイオーヌ、これは人事に関わる仕事だから、俺のところに来て正解だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340733
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340733,
					"content": "だがその前に、ガッティーノにこの機密の重要度を判断してもらってくれ。前に言った通り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340743
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340743,
					"content": "正式に仕事を始める前に、隠す対象がフォンタなのか水なのか、確かめる必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340734
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340734,
					"content": "お前は同僚だ、困らせる気はない。この件に関しては、うちの部署もちゃんと協力するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340735
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340735,
					"content": "ディフォールは通達書を手元に引き寄せると、のろのろと協力者の欄にサインした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340736
					]
				},
				{
					"id": 740340736,
					"content": "よし、さっさとガッティーノのところに行ってこい！人事の大事件だ。事前に他のやつらにも知らせておかないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340737
					],
					"speakerTitle": "ディフォール"
				},
				{
					"id": 740340737,
					"content": "ディフォールさん、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340744
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340744,
					"content": "ディフォールは振り向きもしないで去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340738,
						740340739
					]
				},
				{
					"id": 740340738,
					"content": "行っちゃった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340740,
					"content": "ふぅ、今のがディフォールさんです。気性が荒くて、切れ者ではあるんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340741
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340741,
					"content": "仕方ない、ガッティーノさんに会いに行きましょう。どうぞ、こちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740340739,
					"content": "あっという間にいなくなったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340729,
					"content": "あとで飲みに行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340730
					]
				},
				{
					"id": 740340730,
					"content": "約束だぞ。破ったら許さないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740340722,
					"content": "うーん…入念に検討した結果？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340716,
					"content": "うーん…それってなにか理由があるのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340708,
					"content": "「機密の重要度」を誰も教えないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340744
					]
				}
			]
		},
