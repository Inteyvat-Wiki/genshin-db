			"dialogs": [
				{
					"id": 3930101,
					"content": "この全てが終わったら、今日の出来事を詩にしようと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930102,
					"content": "いろいろあった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "うん、きっとこの詩は『ヴァネッサの物語』のように、モンドの人々にずっと謳われるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930105,
					"content": "あの詩は、私も幼い頃から大好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3930106,
					"content": "#では、{NICKNAME}…今日の調子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3930107,
					"content": "私は最高の状態を整えてきた。きっとみんなの力になれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3930108,
					"content": "ジン団長は頼もしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "そういえば、ディルックの旦那も最後までついてきてくれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930111,
					"content": "最初は巻き込まれただけの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930112,
					"content": "…えーっと…部外者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930113,
					"content": "秘密を共有してくれた君たちに、僕は信頼を返しただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3930114,
					"content": "ディルックの理由は「信頼」か。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "そして、ジン団長の理由は「責任」かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930116,
					"content": "で、吟遊野郎は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930121,
					"content": "「自由」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930122,
					"content": "自由…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930123,
					"content": "君たちがモンドに来た時、モンドは「自由の都」だって誰かに言われなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930124,
					"content": "アンバー…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "あははっ、あの子も自由人だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930126,
					"content": "モンドは「王」の統治がない浪漫の城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930127,
					"content": "そして、モンドの人々は七国で最も自由な民だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930128,
					"content": "だから、かつてモンドを守った龍もそうであってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930129,
					"content": "「この都市が君を裏切った」と、彼を騙そうとする人がいちゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930130,
					"content": "彼に「この都市を守ることが君の永遠の義務だ」と、そう強いる人もいちゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930131,
					"content": "彼には、自由に生き方を選べる権利があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930132,
					"content": "ウェンティ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930133,
					"content": "#では、{NICKNAME}、モンド千年の風が君と共にあらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930134,
					"content": "ボクは前回と同じように、君に「風」元素の力を導くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3930135,
					"content": "「前回」って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "なるほどな！どうりで知ってる声だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930136,
					"content": "やっぱり、あの時の声は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "ジン団長の理由は「責任」か。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "そして、ディルックの旦那の理由は「信頼」かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930119,
					"content": "で、吟遊野郎は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3930120,
					"content": "ウェンティはどうなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "安心して、こちらも絶好調だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "ウェンティとももう仲間だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
