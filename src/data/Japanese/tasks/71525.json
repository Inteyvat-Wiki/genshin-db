			"dialogs": [
				{
					"id": 716662101,
					"content": "素晴らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662102,
					"content": "荒瀧派の得意とする虫相撲は、これほどまでに激しい戦いに発展するんですね。うん、確かに人を惹きつける物語を作り、話すことができそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662103,
					"content": "田饒舌大兄、たかじけない。楽しい戦いだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662104,
					"content": "「かたじけない」だよ、鬼王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716662105,
					"content": "コホンッ！細かいことは気にすんな！とにかく、田饒舌大兄の助力に感謝する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662106,
					"content": "荒瀧派親分様もお疲れ様です。私は大会期間中、引き続き虫相撲を見学し、取材させてもらいます！どうぞ皆さんで思う存分楽しんでください、私のことはお構いなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662107,
					"content": "本当に礼儀正しい相手だったな、俺様は頭が痛ぇぜ。虫相撲以外の知識でも勉強になった気分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662108,
					"content": "どうやら今回の「荒瀧煌々虫相撲大修行」、良い幕開けとなったみたいだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
