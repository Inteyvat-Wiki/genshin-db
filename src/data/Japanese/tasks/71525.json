			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「次回のお話もお楽しみに」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-336.767,
							200.419,
							-709.591
						],
						"pointId": 7026
					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "皆さん！私、田饒舌が「荒瀧煌々虫相撲大修行」のために正式な告知板を持ってきましたので、お受け取りください。こちらが今回の催しの許可証でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662002,
					"content": "おお！これは…牛使い野郎の「赤紅一杵」か？だいぶ誇張してるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716662003,
					"content": "いいじゃねぇか！！俺様の傑作ほどではないにしろ…見ろよ、この構図、この線！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662004,
					"content": "そして堂々たる気迫！完全に虫相撲の強者としての俺様の威圧感を体現してるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662005,
					"content": "そこの…えっと…璃月の人にはどんな敬称を使うんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662006,
					"content": "「大兄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716662007,
					"content": "それだ！そこの大兄、良い絵だ！荒瀧派として…感謝の限りッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662008,
					"content": "滅相もありません、荒瀧派親分様。私、田饒舌は一介の講談師に過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662009,
					"content": "この告知絵はですね、総務司のとある女性が描いたものです。彼女は普段、煙緋さんの世話になっていて、このような催しがあると聞き、自ら申し出て素敵な作品を創られたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662010,
					"content": "煙緋さんの贈り物だったんだな！大恩人はここまで想定していたのか？神みてぇな洞察力だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662011,
					"content": "「花角玉将」さんから聞きましたが、「荒瀧煌々虫相撲大修行」は志の高い修行であり、非凡な意義をお持ちだそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662012,
					"content": "私は虫相撲の専門家ではありませんが、以前からこれに関連する講談をたくさん聞いていたので、ずっと挑戦してみたかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662013,
					"content": "もしかしたら、そこからヒラメキを得て、良い物語を書いて街の皆さんに聞かせることができるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "「次回のお話もお楽しみに」"
				},
				{
					"id": 716662014,
					"content": "虫相撲には才能も重要だ。例えば「空を翔ける白鉄チビ助」様は始めたばかりなのに、並外れた実力を発揮できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716662015,
					"content": "田饒舌大兄が虫相撲の楽しさを理解してくれたら、講談の形で大いに告知してもらえるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716662016,
					"content": "良いこと尽くめだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716662017,
					"content": "それじゃ、田饒舌大兄…なんて言うんだっけか…ど、どうかご指導を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
