			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "うちはもうちょいここに残るわ、心の花火大会がまだ終わってへんのや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140102,
					"content": "まぁせやけど、もっとお喋りしたいっちゅうなら付き合うてもええで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140103,
					"content": "この後は何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "子供たちと一緒に「袋貉」を探すかな、待たせてもうとるし、宵宮姉さんが約束を破るわけにもいかんやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140105,
					"content": "あと、花火大会の感想をみんなから聞かんとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140106,
					"content": "これから先も、きっと世話になるやろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140107,
					"content": "それとあんたとパイモンちゃんにも、世話になったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140108,
					"content": "花火代って高い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "あんたらなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140110,
					"content": "タダでええよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140111,
					"content": "元々うちが押し付けたもんやし、散々迷惑かけといてモラを払えなんて言われへんよ、ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140112,
					"content": "悪いし、遠慮するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#気にせんといてぇな、水臭いなぁもう。せや、等価交換や！あんたが家族を見つけたら、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんに「長野原花火屋」を紹介してくれへんか。そしたら、うちもお客さんが一人増えるやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140114,
					"content": "#うちもいつか、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんに会うてみたいなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140115,
					"content": "もし天領奉行がまた嫌がらせに来たら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "もういっぺん、しばいたる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140117,
					"content": "——ははははっ、冗談や冗談。前に言うたやろ、うちは奉行の人たちと付き合いがあるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140118,
					"content": "詫びを入れて、罰金を払えば何とかなるやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120140119,
					"content": "あんたらこそ気ぃ付けや。次こないなことがあっても、うちみたいに無鉄砲になったらあかんで、ひひっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		}
	]
}