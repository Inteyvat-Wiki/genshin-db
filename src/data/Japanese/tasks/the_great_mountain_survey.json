				{
					"id": 701040301,
					"content": "どう？ビーコンを設置してくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040302,
					"content": "置いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "この報酬は君へのお礼よ。手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040304,
					"content": "はあ、この数のビーコンで一体どれくらいのデーターを観測できるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイスター"
				}
			]
		},
