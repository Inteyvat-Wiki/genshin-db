			"trigger": {
				"objectNames": [
					"アイスター"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "ビーコンは見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040202,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "見せてみて。間違いない、私のビーコンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040204,
					"content": "これは…やっぱり魔物にいたずらされたようだね。幸いなことに、まだ修理できるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040205,
					"content": "はあ、それでもしばらくは使い物にならないよ…仕方ない、やれるだけやってみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040206,
					"content": "まだ手元にいくつかビーコンが残ってるの。山に設置するのを手伝ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040207,
					"content": "どこに置くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "引き受けてくれるの！ありがとう、場所を地図にマークしておくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040215,
					"content": "よし、地図にマークしておいたから、ビーコンをそこに設置してきてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040216,
					"content": "ビーコンを置くときは、地面より高い位置に置いてね。その方がより観測結果が正確になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040209,
					"content": "どうして自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "自分で行くのは…探検隊ですら魔物に手も足も出なかったの、私一人で行くのは無理だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040211,
					"content": "すぐには他の探検隊も見つかりそうにないし、待っていてはきりがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040212,
					"content": "だからもう君にしか頼めないの。あっさりビーコンを回収した君の腕なら信用できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040213,
					"content": "この件は任せたよ。報酬も用意しておくからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701040214,
					"content": "そうだ、ビーコンを設置してほしい場所を地図にマークするよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "アイスター"
				}
			]
		},
