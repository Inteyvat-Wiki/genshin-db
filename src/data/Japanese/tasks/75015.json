			"dialogs": [
				{
					"id": 750150401,
					"content": "#じゃじゃーん！さすが{NICKNAME}、この生意気な魚を捕まえたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150402,
					"content": "思ったんだけど、一度に餌を全部撒いて、魚が満腹でひっくり返って勝手に浮いてきたら、それも「釣り」って言えるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150403,
					"content": "キュ…キュウ…",
