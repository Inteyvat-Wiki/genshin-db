					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#うわっ！まだ焼けてないぞ。{NICKNAME}が作ってくれるまで待たないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150407,
					"content": "焼き魚を作り、みんなでお腹いっぱい食べた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "この焼き魚、なんかいつもよりうまい気がするな。さすがはオイラが釣った魚だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150410,
					"content": "さすがパイモン。これからは全部任せるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "ええっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150412,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#働かずに食べるのはダメなんだぞ！魚が食べたいなら、今度は{REALNAME[ID(2)|SHOWHOST(true)]}も手伝わないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150414,
					"content": "キュー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "こういう時になると、とぼけるよな。まったく！",
