			"dialogs": [
				{
					"id": 750150501,
					"content": "ふう、やっと片付けが終わったな。それじゃ、釣りを始めようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150502,
					"content": "へへっ、絶対に大きな魚を釣り上げてみせるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150503,
					"content": "しかし残念なことに、水面は全く動かず、波も立たなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "うーん…ここの水質が良すぎるせいか？魚たちが全然出てこようとしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150505,
					"content": "勝利はすぐ目の前！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "そうだな、「勝利はすぐ目の前！」…って、まだ始まったばっかだし、勝利はまだまだ遠いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150507,
					"content": "こんなときに安易に励ますなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150511,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "あと少し！あと少しでいける！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "おい、こんな時に喋っちゃダメだろ…まったくもう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150514,
					"content": "どうしたどうした？うわっ！釣り竿が動いてるぞ。大物かな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150515,
					"content": "#なんだ、魚じゃなくて漂流瓶か。しかも釣り場の木板に糸で縛りつけてるなんて…そういえば、{NICKNAME}もよく変なものを釣ってくるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150516,
					"content": "魚以外のほうが多く釣れる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "#{NICKNAME}だってよく変なものを釣ってるだろ。せっかく釣れたんだから、中に入ってるものを見てみようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150518,
					"content": "釣りにハマってる人って、なんかすごいんだな。もしかして、今のごちゃごちゃしたものって、この二人が残したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150519,
					"content": "これを使って連絡を取ってるみたいだし…やっぱこの瓶は戻してあげようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150520,
					"content": "うぅ、次はちゃんと魚が釣れるといいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150521,
					"content": "釣り竿がグンと沈み込み、激しく揺れ始めた。\\n尋常ではない重さの「大物」ががっちりと針にかかっていた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "やっと食いついた！今度こそ大物だ、上がってこい～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150523,
					"content": "上がってこい～！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "キューキュー！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#ずいぶん苦しそうなパイモンを見て、\\nあなたは{REALNAME[ID(2)|SHOWHOST(true)]}と一緒にパイモンを抱えた…\\nしかし、釣竿の向こうから更にすごい力が伝わってきた！",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "「ブチッ」という音とともに、魚が針から外れてしまった…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "うっ！きっと大物だったから、針から外れたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150528,
					"content": "くっ…あいつ…まだのうのうと水面を泳ぎ回ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150529,
					"content": "キュウ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "海は危ないからダメだぞ！それに、おまえが魚に追いつけるわけないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150531,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#{NICKNAME}、あの魚、なんとかして捕まえられないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150508,
					"content": "あと少し！気を抜かないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "うーん、魚が餌に食いつくタイミングって、スイートフラワーの中から突然トリックフラワーが現れるみたいに、全く予測できないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150510,
					"content": "ただただ待ち続けるしかない——待つしか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "パイモン"
				}
			]
		},
