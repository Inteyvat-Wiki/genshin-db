					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}もそう思うのか？へへっ、じゃあ、今度一緒に試してみようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750150405,
					"content": "キュイ…",
