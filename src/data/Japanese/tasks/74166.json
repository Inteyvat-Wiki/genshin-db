			"dialogs": [
				{
					"id": 741660401,
					"content": "ここはメロピデ要塞の特別許可食堂です。毎日ここで無料のサービス食を一食いただけるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660402,
					"content": "唯一の問題は、メニューが「お任せ」ってところですかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660403,
					"content": "へん、それだけか？そんな情報、ここへ来た初日にすぐ聞いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660404,
					"content": "まぁ慌てずに。一つ裏情報があるんですよ。実はここでサービス食をいただく時、ブランにとある秘密の合言葉を伝えると、伝説の謎グルメがいただけると言うんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660405,
					"content": "えっホントか？合言葉ってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660406,
					"content": "合言葉の内容については、残念ながら私も知らないんです。またあとで来ましょう、今は他を探索するべきです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660407,
					"content": "そりゃオイラの台詞だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660408,
					"content": "まぁ細かいことは気にせずに。次の場所は劇団三枚券です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "おかしな人"
				}
			]
		},
