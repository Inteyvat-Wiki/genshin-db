			"dialogs": [
				{
					"id": 741660301,
					"content": "さて、どうするか決まりましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660302,
					"content": "絶対にタダ！約束だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660303,
					"content": "もちろん、もちろん。間違いなく「タダ」ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660304,
					"content": "さぁさぁ、私と一緒にメロピデ要塞を回ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "おかしな人"
