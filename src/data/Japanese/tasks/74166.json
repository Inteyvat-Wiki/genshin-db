				},
				{
					"id": 741660602,
					"content": "まさか、ここにも変な噂があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660603,
					"content": "いえ、ありませんよ。ただ、ここはすごく嫌いな場所なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
