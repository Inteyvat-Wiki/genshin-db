			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "そこのあなた。そうそう、あなたですよ！ちょっとこっちへ来てごらんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660202,
					"content": "ん？オイラたちのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660203,
					"content": "やあ、お二人さん。ひと目でよそから来たってすぐにわかりましたよ。メロピデ要塞のことをまだよく分かってないんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660204,
					"content": "私に会えて幸運でしたね。私はメロピデ要塞で最も善良な「住民」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660205,
					"content": "今日は特別に私がメロピデ要塞を案内してあげましょう。ああ、もちろん「タダ」なのでご心配なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660206,
					"content": "この辺のことは詳しいから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "まぁまぁ、そう言わずに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660208,
					"content": "ご自分では詳しいと思っていても、私の案内を聞いたら新たな発見があるかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660209,
					"content": "この世にそんなうまい話なんてあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "そりゃあもちろん。私はメロピデ要塞で最も善良な「住民」だと言ったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660211,
					"content": "うぅ…初対面でいきなり親切にしてくるなんて、なんか怪しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660212,
					"content": "ははっ、そう構えることはありませんよ。でしたらまずはお二人でご相談なさってください。私はここで待っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660213,
					"content": "相談が済んだら私のところに来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "おかしな人"
				}
			]
		},
