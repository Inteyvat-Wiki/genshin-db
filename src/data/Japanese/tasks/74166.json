			"dialogs": [
				{
					"id": 741660501,
					"content": "ここは劇団三枚券の所在地です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660502,
					"content": "えっ？それで終わりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660503,
					"content": "何も思いつきませんか？劇団と言えば演劇でしょう！そして演劇と言えばロマン！ロマンと言えば愛ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660504,
					"content": "噂によれば、毎日ここで観劇していれば、真実の愛が見つかるそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660505,
					"content": "そんな噂があるのか？だったらみんなここに来るべきなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660506,
					"content": "それはそうなんですが、前提としてあなたがメロピデ要塞の囚人、または看守でないことが条件なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660507,
					"content": "それじゃあ誰も真実の愛ってやつに出会えないじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660508,
					"content": "それが問題と言えるかもしれませんね。まぁとにかく、次の目的地に向かいましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "おかしな人"
				}
			]
		},
