					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660606,
					"content": "それは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741660607,
					"content": "仕事したくないからです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660608,
					"content": "私はただ働くのがイヤで、空腹でパンを盗み有罪判決を受け、ここに来たんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660609,
					"content": "なのに、どうしてメロピデ要塞に来てまで仕事しなきゃいけないんですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660610,
					"content": "「すべての仕事が私を駄目にする！」これが私の人生のモットーなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "おかしな人"
				},
				{
					"id": 741660611,
					"content": "うわ…こいつがここにいると、なんか変になるぞ。早くここを離れて次の場所に行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
