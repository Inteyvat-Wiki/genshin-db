		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鉄弘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "待ってくれ！層岩巨淵は禁止区域だから、旅人は…きっ、君は！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460202,
					"content": "しまった、逃げるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710460203,
					"content": "パイモン、騒がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "ははははっ…すまん、驚かせてしまったようだな。命の恩人を忘れるわけがない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460207,
					"content": "俺もここ最近、護衛に来たんだが…まさかここで恩人に出会えるとは、なんて巡り合わせなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460208,
					"content": "恩人…？オイラたち、なにかいいことしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710460209,
					"content": "何を言うんだ！みなが海中の魔物と戦っていた時、俺も群玉閣にいたんだ。ちょっとした傷を負ってな…この間治ったばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460210,
					"content": "君は俺を覚えてないかもしれんが、俺は君のことを忘れない。共に戦った仲間たちも、みんな璃月に傾けてくれた努力を見届けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460211,
					"content": "層岩巨淵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "二年前、鉱洞で原因不明の事故があって、七星によって封鎖されたんだ。幸い、鉱夫たちはほぼ全員無事に避難できたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460213,
					"content": "ただ、残念なことに、こんなに大きなところが閉山して生産停止になるとな。労働者たちも補助金を使って、別の方法で生計を立て始めた…はぁ、一度散り散りになってしまうと、なかなか再会できなくなるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460214,
					"content": "あっ、すまん、話題がずれた。ここに来るのは用事があってのことだろう。引き留めはしない。もし何かあったら、沐寧に直接会いに行くといい。彼は入り口の拠点にいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460215,
					"content": "えっと…君を信用しないわけじゃないが、これが俺の責務でな。——もう聞き飽きたかもしれないが、ここで違法なことをしないようにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "鉄弘"
				},
				{
					"id": 710460216,
					"content": "安心しろ、なんたって、オイラたちなんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710460204,
					"content": "#{M#俺}{F#私}のこと知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "バレた、逃げろ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}