			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "名を聞いても？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860102,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "承知した、その名を覚えておこう。では、武者の誇りをかける覚悟はできたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860104,
					"content": "えっ、いきなりどういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "うん？お前は決闘に来た武者ではないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860107,
					"content": "そんな話、まったく聞いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "何だと？「孤刀争逐」のことを知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860109,
					"content": "そんなはずは…知らせは貼っておいたというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860110,
					"content": "それ、どこに貼ってあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726860111,
					"content": "ここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860112,
					"content": "そんなとこに貼っても意味ないだろ。こんな宣伝で人が来るのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726860113,
					"content": "ふん、社奉行が「容彩祭で刀を振り回すのは不適切だ」と言ったからだ。俺は離島で決闘するのを禁じられた上に、チラシを貼ることさえ禁止された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860114,
					"content": "それゆえ、ここを決闘の場として選んだ。チラシも近くに貼るしかない状況だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860115,
					"content": "だが、試合を申し込みに来た武者はすでに四人いる。お前を加えれば、五人になるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860116,
					"content": "#それでもここに来る人がいるなんて、変わったやつもいるんだな。そういえば、{NICKNAME}はなんでここに来たんだっけ。オイラ、なんで来たか全然覚えてないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726860117,
					"content": "決闘のことを知らずにこの島へと辿り着くとは。お前はきっと、強い武道精神を持った勇士に違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860118,
					"content": "武に熱い想いを抱く者が引かれ合うのは、この世の常というもの。驚く必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860119,
					"content": "どこの世界にそんな常識があんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726860120,
					"content": "ふふ、どうだ？参加する気はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860121,
					"content": "もし他の四人の参加者に勝てたら、もちろん賞金をやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860122,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "承知した。では、ゆっくりと考えるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726860105,
					"content": "いやいや、失礼します。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}