			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "これはある力が含まれた結晶だ…リサ、これの構造分析を頼めるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700402,
					"content": "ええ、ちょっと確認するわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700403,
					"content": "結晶の中に穢れた不純物があるわ。でも、これ以上は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700404,
					"content": "ごめんなさい、今はまだ結論を出せないわ。少し時間を頂戴、禁書エリアで資料を探してくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700405,
					"content": "ああ、ではリサ、その研究は任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700406,
					"content": "ええ、何か進展があったら、みんなに知らせるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700407,
					"content": "まぁ、あまり古代の文献には期待しないで。それに——いたっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700408,
					"content": "あっ…くっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700409,
					"content": "結晶の中の不純物に近づくと、痛みが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700410,
					"content": "なるほど…これは「神の目」との相互排除ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700411,
					"content": "この穢れの力は、わたくしたちの体内にある元素の力と相殺しあうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#でもおかしいわ、{NICKNAME}も元素の力を使いこなせるのに、影響を受けないのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700415,
					"content": "（可愛い子ちゃん…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "分かった、そうしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "とにかく、この結晶は可愛い子ちゃんに持っていてもらおうかしら。わたくしたちが持っていても痛みが増すだけですもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3700417,
					"content": "…不思議な現象だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700418,
					"content": "これら君自身の特殊性について、何か心当たりは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700420,
					"content": "そうだろうと思った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700421,
					"content": "#では、{NICKNAME}、無理な願いではあるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700422,
					"content": "西風騎士団の栄誉騎士の爵位と…代理団長の感謝の気持ちを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700424,
					"content": "西風騎士団の…栄誉騎士！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700426,
					"content": "それから、この謎の答えを探すのに、もう一度力を貸してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700427,
					"content": "風魔龍の暴走、変わった結晶…その答えはきっとモンドの平和とも関係があると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700428,
					"content": "真実に辿り着けるように、風の加護が君にあらんことを願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700429,
					"content": "何か新しい発見があったら、ここに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 4820221,
					"content": "わたしが<color=#00E1FFFF>マークしたルート</color>通り、ゴールまで飛んでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "アンバー"
				}
			]
		}
	]
}