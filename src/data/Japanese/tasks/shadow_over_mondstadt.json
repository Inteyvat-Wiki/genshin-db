			"dialogs": [
				{
					"id": 3700201,
					"content": "うん？あれはジン団長だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700202,
					"content": "誰かと話してるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700203,
					"content": "話が終わったら挨拶しとくか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700204,
					"content": "…それが我々の立場だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700205,
					"content": "直ちに風魔龍を滅ぼすことができないのなら、モンドの防衛を「ファデュイ」に渡したほうがよいかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700206,
					"content": "モンドの龍災はなんとかなる。我々があのケダモノを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700207,
					"content": "「ケダモノ」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700208,
					"content": "おや？代理団長殿は違うとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700209,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700210,
					"content": "貴国の外交官には、もう少しまともな態度を示していただきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700211,
					"content": "モンドの四風守護、その一つを「処理」したいだと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700212,
					"content": "西風騎士の前でそういう戯言はやめていただきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700213,
					"content": "はっ…はははっ…戯言など滅相もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700214,
					"content": "よかろう、今日の協議はここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700215,
					"content": "今回の成果は「双方が誠実に建設的な意見を交わした」、それでいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700216,
					"content": "事実通りに…記録させてもらう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "アナスタシア"
				},
				{
					"id": 3700217,
					"content": "#ああ、{NICKNAME}、おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700218,
					"content": "協力ありがとう。おかげでモンド周辺の元素循環はやっと落ち着いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700219,
					"content": "風魔龍の襲撃による余波も、一段落ついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700220,
					"content": "しかし、使節団側の圧力はもう無視できないほど大きくなっている……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700221,
					"content": "使節団？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700222,
					"content": "外交の使節団か…璃月港から？それとも稲妻城から？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700223,
					"content": "スネージナヤ、七神の中で氷神を祀る国家からだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700224,
					"content": "その使者には名前があってだな…ファデュイ、聞いたことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700225,
					"content": "あー、「ファデュイ」か、聞いたことあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700226,
					"content": "でも、あまりいいイメージはないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3700227,
					"content": "風魔龍を殺すことが正しいと、私は思わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700228,
					"content": "それに、氷の神が率いる「ファデュイ」は風神眷属の力を望んでいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700229,
					"content": "それが見え見えなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700230,
					"content": "「力」といえば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#どうかしたか、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700232,
					"content": "騎士団のみんなに見せたいものがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "うん？ああ、騎士団本部に戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3700234,
					"content": "こんなところで…大事な話をすべきではないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
