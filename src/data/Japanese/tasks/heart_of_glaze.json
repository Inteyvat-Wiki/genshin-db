			"dialogs": [
				{
					"id": 10230301,
					"content": "わあ——ここが<color=#00E1FFFF>「黄金屋」</color>か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230302,
					"content": "見た目も立派だけど、中はもっと豪華だな！しかも…あちこちモラだらけだ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230303,
					"content": "テイワットのモラが全部ここで作られてるなら…少しくらい失敬しても、バレたりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230304,
					"content": "やめた方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "罠だったのか、危なかった！助かったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230307,
					"content": "貰えなくても、至近距離で眺めるのは大丈夫だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230308,
					"content": "できれば中で眠りたいなぁ！モラのお布団、いい夢が見れそうだ、へへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230309,
					"content": "まずは「仙祖の亡骸」を確認しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "そうだ、大事な用があるんだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230312,
					"content": "…にしても、静かすぎないか？「仙祖の亡骸」は大事なものだろ、警備とかいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230313,
					"content": "#——えっ！？{NICKNAME}、見ろ、なんだあれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230314,
					"content": "千岩軍だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "みんな気絶してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "…うっ、嫌な予感がする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230317,
					"content": "早く「仙祖の亡骸」の状況を確認しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230310,
					"content": "ここの雰囲気…少し変わってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "そう簡単に盗めたら大問題になってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
		{
			"id": 102305,
