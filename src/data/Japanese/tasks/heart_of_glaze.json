				"points": []
			},
			"dialogs": [
				{
					"id": 10230201,
					"content": "「案内人」としての使命を果たしたのに、なぜ自ら火中に飛び込むんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230202
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230202,
					"content": "ん？誰だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230203,
					"content": "君たちが「ファデュイ」なら、女皇から報酬を貰えるかもしれないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230204
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230204,
					"content": "残念ながら、今の君たちはただの邪魔者だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230205,
						10230208
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230205,
					"content": "どうしてここを知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230206
					]
				},
				{
					"id": 10230206,
					"content": "どこから話そうかな？遠回りは俺のスタイルじゃなかったんだけど、まさか璃月に着いた途端に岩神が死んで、その亡骸まで隠されるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230207
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230207,
					"content": "でも君たちの「送仙儀式」のおかげで、面倒事になる前に情報を掴めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230211,
					"content": "ハッ…モラの製造を止めてまで「仙祖の亡骸」を隠すだなんて…七星も本気だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230212,
					"content": "ま、まさかおまえも「神の心」を狙ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230213,
					"content": "ファデュイの第十一位の執行官として、俺は氷の女皇の意志に従う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230214
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230214,
					"content": "女皇が欲するものは、必ず手に入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230215,
						10230216
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230215,
					"content": "許さない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230217,
					"content": "誰かの許しはいらない。本気なら俺を止めてみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230218
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230218,
					"content": "取引や駆け引きの時間は終わった…小細工を使うのは好きじゃないが、女皇のために俺は我慢したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230219
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230219,
					"content": "ここからは、もっと単純で楽しいことをしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230220,
					"content": "「戦い」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230221
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230221,
					"content": "戦い？まさかケンカが好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230222,
					"content": "ハハハッ、そうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230223
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230223,
					"content": "「淑女」はモンドの大聖堂で神を襲い、そして足早に姿を消した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230224
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230224,
					"content": "君と戦うよりも氷雪で君の行動を封じたのは、戦いの音で騎士たちが集まるのを忌避したからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230225
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230225,
					"content": "強者に対して、彼女は利益や勝ち負け、その後の影響を優先する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230226
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230226,
					"content": "だが俺が「執行官」になった最大の楽しみは、強者と戦える点にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230227
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230227,
					"content": "モンドの時みたいに、思い通りにはさせないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230228,
					"content": "ああ、やってみるといいさ。旅人、俺は君を殺さない。俺は戦闘の快楽を味わいたいだけなんだ、付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230229
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230229,
					"content": "君は俺に勝てない、だから勝ち負けではなく、俺と同じ戦いを楽しめばいい。そう言えば理解できるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230230
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230230,
					"content": "勝てない？それはどうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230231
					]
				},
				{
					"id": 10230231,
					"content": "ハハハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230232
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230232,
					"content": "よしっ！君もその気なら、俺を楽しませてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230216,
					"content": "「仙祖の亡骸」に近づけさせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230208,
					"content": "まだ遅くはない、阻止してみせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230209
					]
				},
				{
					"id": 10230209,
					"content": "君たちのおかげで俺は苦労せず、ここを見つけられたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230210
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230210,
					"content": "今さら俺を止めようと？無駄だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
