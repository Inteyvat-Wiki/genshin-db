			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "ふう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230502,
					"content": "あっ、元通りになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230546,
					"content": "そろそろ…落ち着かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230503,
					"content": "さっきの「魔王武装」は体への負担が大きい。そのせいで考える余裕もなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230504,
					"content": "よくよく考えれば、君たちが先に「神の心」を奪う可能性は確かにない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230505,
					"content": "「神の心」の件は…君たちと無関係なんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230506,
					"content": "そうだ、だから違うって言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230507,
					"content": "旅人、今日君が見せた実力は、モンドで「淑女」が君に下した評価よりもずっと強い。どうしてかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230508,
					"content": "（7つの元素を集めてるから…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "その様子じゃ、心当たりはあるんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230511,
					"content": "はぁ、俺には言えないか。どうやら、この好奇心は抑えておくしかないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230512,
					"content": "君との戦いはとても良かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230513,
					"content": "俺にとって強さを追求する者はみんな理解し合う友だ、まあ友情の形はやり合うことになるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230514,
					"content": "変わった価値観だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230515,
					"content": "さて、今はそんな世間話は一旦置いて、任務に戻らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230516,
					"content": "——「神の心」がここにないのなら…最初から「仙祖の亡骸」の中には存在しないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230517,
					"content": "というより、「仙祖の亡骸」自体、目をくらます手段かもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230518,
					"content": "うん？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230519,
					"content": "岩王帝君は死んでない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "おそらくね。それが本当なら…面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230522,
					"content": "さすが商業の都の守護神、「契約以外の小細工」にも詳しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230523,
					"content": "となると、「予備プラン」を使うしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230524,
					"content": "予備プラン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230525,
					"content": "弱者に影響を及ぼすから、本来だったら使いたくないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230526,
					"content": "所詮、この世界は強さを追求する者のためにあるからね。弱者を気にしている余裕なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230527,
					"content": "それにファトゥスは「手段」を選ばない。子供だって嫌いなものを食べなきゃいけない時があるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230528,
					"content": "それで…一体なにをするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230529,
					"content": "「孤雲閣」の下で眠る魔神を呼び覚ます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230530,
					"content": "魔神！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>「渦の魔神」、オセル</color>。魔神戦争で「岩の魔神」モラクスに敗れ、海中に封印されてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230532,
					"content": "そんな魔神が、神のいない璃月港を襲ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230533,
					"content": "俺たちをさんざん弄んだ岩王帝君様も、これ以上見て見ぬふりはできないだろうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230534,
					"content": "…で、でも、魔神戦争は2000年前に終わったんだぞ！七神しかいない今、昔の魔神をどう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230535,
					"content": "「呼び覚ます」手段があるに決まってるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230536,
					"content": "あーっ！「禁忌滅却の札」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230537,
					"content": "お、思い出したぞ！「ファデュイ」がそれを研究してるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10230538,
					"content": "研究場にも行った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "その通り、君たちに渡したのは、この研究の副産物だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230541,
					"content": "これほどの力を持つ「禁忌滅却の札」に、女皇がくれた「執行官」の力…岩の槍による封印を一時的に解除するのも、できなくはないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230544,
					"content": "俺にとって、上古魔神の力を使うこと自体面白くないし、俺の信条にも欠けるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230545,
					"content": "あの岩神だけでなく、君たちまで動かないといけなくなるって考えると…それなりに面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230539,
					"content": "本物を「コピー」しようとした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "亡骸は偽物だってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "（かつての力が戻りつつあるから…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}