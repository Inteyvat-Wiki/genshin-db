			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#あら、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270402,
					"content": "エスコフィエ、久しぶりだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "今日の私は調理担当ではないの。ただの味見役よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270405,
					"content": "サヴァナが新メニューを出したいと言うから、味をみてあげているの。でも…もう五回も作り直させているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270406,
					"content": "火加減が数秒ずれて食感を損なっているか、調味料が多くてスパイスが主張しすぎているか…そのどちらかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270407,
					"content": "エスコフィエはやっぱり厳しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "当然よ！料理は科学なの。友人だからといって、評価を甘くするわけないでしょう？彼女とお客様に対して責任を持つなら、むしろ厳しくあるべきだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270409,
					"content": "実は、ちょっとお願いがあるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "…こんな時に？もし、どこかに公開するつもりの写真なら、日を改めたほうがいいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270412,
					"content": "最高の仕上がりにするには、背景を吟味し、光と角度を入念に調整する必要があるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270413,
					"content": "記念撮影がしたいだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "…まあいいわ。六回目を完成させるまでには、まだ時間がかかるでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270416,
					"content": "それじゃあ、貴方の新しいレンズと彼女の新メニュー、どちらがより良い結果を出せるか見せて頂戴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 745270414,
					"content": "新しいレンズの性能も試せるしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "#{M#君}{F#あなた}の写真を撮らせてもらえないかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "新しいレシピを研究してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
}