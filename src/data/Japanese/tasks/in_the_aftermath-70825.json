			"dialogs": [
				{
					"id": 708250401,
					"content": "はあ、人手がもっとあればいいのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250402,
					"content": "城内の西風騎士は何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "城の防衛や様々な補修工事、それから細かい仕事とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250404,
					"content": "とにかく今騎士団にいる人はみんな忙しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250405,
					"content": "彼らと比べると、門番の仕事はかなり楽だがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250406,
					"content": "冒険者協会に協力してもらおう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "とっくに協力してもらってるぞ。最初の怪我人捜索から、野外の魔物の監視まで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250408,
					"content": "魔物が城のほうに集まった時も、冒険者たちが情報を提供したおかげで、迎撃計画ができたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250409,
					"content": "今彼らも城内の様々な仕事に協力してる。彼らがいなかったら、西風騎士団もここまでやってこれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 708250410,
					"content": "そういえば、きちんとサイリュスさんに礼を言わないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
