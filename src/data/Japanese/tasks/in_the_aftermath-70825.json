					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "ありがとう。お前さんがいてくれて助かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "ホフマン"
				},
				{
