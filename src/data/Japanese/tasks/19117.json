			"dialogs": [
				{
					"id": 191170106,
					"content": "ワン！ワウゥ～ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170107,
					"content": "おっと！危うく噛まれるところだった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170108,
					"content": "いい加減、腹ペコだろ、そろそろ何か食べてもいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170109,
					"content": "たとえオレについてくる気がなくとも、何か口にするくらいいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170110,
					"content": "まさか食べ物に毒があるのを疑ってるのか？なら、オレが先に味見してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170121,
					"content": "ほら、問題ないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170111,
					"content": "トーマ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "ほら、少し食べな。ちょっとだけでいいから、そしたら今日はもう邪魔しないから、ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170114,
					"content": "ワン！ワンワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "忍犬"
				},
				{
					"id": 191170115,
					"content": "全然、食べ物を食べてくれない…それに、なんだか落ち着きがない様子だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170116,
					"content": "海に何かあるのか？それとも周りに何か警戒するものがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170117,
					"content": "あの魔物のせい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "この辺りの魔物に攻撃されたということかい…？それも、なくはないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170119,
					"content": "人間も危険な状況だと食べ物が喉を通らなくなる。この子のために周りの魔物を倒してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170120,
					"content": "#付き合ってくれてありがとう、{NICKNAME}。じゃあ、ここを少し片づけようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トーマ"
				},
				{
					"id": 191170112,
					"content": "すごく頑張ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
}