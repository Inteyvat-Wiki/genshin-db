			"dialogs": [
				{
					"id": 760761101,
					"content": "こんにちは、友よ。再びお墓の中で会えて、嬉しい限りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761102,
					"content": "自分が目にした「誓いのランプ」と、そこに記されていた謎の言葉をフリンズに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "「風が目覚め、落ち葉を載せて旅に出る」…これはライトキーパーに入る時に立てる、誓いの言葉です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761104,
					"content": "ライトキーパーは日頃から自分のランプを持ち歩いており、よほどの状況でない限り、ランプを手放すようなことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761105,
					"content": "主のいないランプは、不幸の象徴です。とても悔やまれます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761106,
					"content": "ですが、こうした避けられない運命があることは、誓いを立てた時から皆理解しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761107,
					"content": "彼らのためにできることがあるとしたら、彼らの誓いを覚えておくことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760761108,
					"content": "「希望の灯火を守り抜く」…それが彼らの最大の願いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
		}
	]
}