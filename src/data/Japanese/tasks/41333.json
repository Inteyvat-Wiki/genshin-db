			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鉄塊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330601,
					"content": "これはすごくいい！じゃあ準備もできたし…紫微を…探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
