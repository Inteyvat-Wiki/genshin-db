		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紫微"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "この角度…この星座…犬に似てる…どんな名前にしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330702,
					"content": "あら、鉄塊じゃない。私に何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330703,
					"content": "えっと…その…璃月港の外を歩いてたら、偶然いい場所を見つけて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330704,
					"content": "いい場所？星が見える場所なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330705,
					"content": "あぁ、星が見えるいい場所だ。霄灯を飛ばすのにもぴったりなんだ、もう準備してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330706,
					"content": "ほら、俺が自分で書いた…詩もあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330707,
					"content": "「シャベルと鉱石がぶつかり、無数の火花が飛び散る。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330708,
					"content": "…具体的に何を言ってるのかは分からないけど、結構面白い詩だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330709,
					"content": "でも霄灯に書かれた願い事は他の人に見せちゃいけないの、御利益がなくなるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330710,
					"content": "それで、今日は私になんの用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330711,
					"content": "その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330712,
					"content": "霄灯を飛ばすいい場所を見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "霄灯を？ごめんなさい…実は今ちょうど霄灯がない場所を探してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330715,
					"content": "霄灯が照らす光で星が見えなくなるから、できれば遠ざかりたくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330716,
					"content": "でもありがとう、私はもう少し向こうに行くね。あなたたちの思い出に残る海灯祭になるといいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "紫微"
				},
				{
					"id": 413330717,
					"content": "あっ…あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330718,
					"content": "行っちゃった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "大丈夫…ちゃんと言わなかった俺が悪いんだ。紫微はただ詩の意味が分からなかっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330721,
					"content": "心配するな、めげないさ。いつの日か…必ず思いが伝わるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330722,
					"content": "旅人、手伝ってくれてありがとう。これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330723,
					"content": "はぁ、せめてこの霄灯を飛ばすか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330719,
					"content": "めげないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "彼と一緒に霄灯を飛ばそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
