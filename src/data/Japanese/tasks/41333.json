			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "「鉄塊と紫微がめぐり逢い」…いやいやそれだと直接すぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330202,
					"content": "場所は見てきてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330203,
					"content": "もう見てきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "そんなに早く？さっそく見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330205,
					"content": "ふむ…どれどれ…一つは独特の風景で、もう一つは情緒のある風景…まさに「前から見れば緩やかな、横から見ると険しけり」…次の一句はなんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330206,
					"content": "…まあいい、正面から見て堂々としてる方がいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330207,
					"content": "よし、分かった！どっちを選ぶか決めたよ…旅人、もう一つお願いがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330208,
					"content": "俺の兄弟が、女の子といる時はお菓子を用意した方がいいって言うんだが、何を用意すればいいかおすすめはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330209,
					"content": "チ虎魚焼き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "チ虎魚焼き…脂っこすぎないか…やっぱり杏仁豆腐にした方が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330212,
					"content": "そうそれ、杏仁豆腐、ぴったりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330213,
					"content": "旅人、杏仁豆腐を一つ用意してくれないか。俺は引き続き詩を考えるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330214,
					"content": "「火花が飛び散る」…よし、いい句が思いついた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330211,
					"content": "杏仁豆腐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
