			"trigger": {
				"objectNames": [
					"鉄塊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "「九天玄羅仙人漫天飛座」…綺麗だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330102,
					"content": "星を見てるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "あ…いや、せっかくの海灯祭だろ？雰囲気に合ったものを見るべきじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330104,
					"content": "この日のために詩も習ったんだ。今の女の子たちはこういうのが好きだって聞いてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330105,
					"content": "紫微もきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330106,
					"content": "詩を書いた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "ゴホッゴホッ…紫微から星座の名前を聞いたんだ…まあ、どれも響きのいい名前ばかりだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330109,
					"content": "だからほら、感謝の気持ちを表すために！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330110,
					"content": "自作の詩を霄灯に書いて、紫微と一緒に飛ばして…お菓子を食べたり、歌を歌ったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330111,
					"content": "——そしたらさ！上手くいくだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330112,
					"content": "上手く…いく？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "ゴホンッ！その…祭りの雰囲気が、上手く出来上がるって意味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330114,
					"content": "とにかく、いい雰囲気で、人も少なくて、景色が綺麗な場所を探したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330115,
					"content": "他の人に聞いて、候補を2つ見つけたんだ…ほら、この2か所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330116,
					"content": "他の兄弟たちは、皆この2つの場所で霄灯を飛ばしたことがあるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330117,
					"content": "でも俺はまだ詩を作らないと…走り回ったらアイデアを忘れてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330118,
					"content": "俺の代わりに見てきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330119,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "手伝ってくれてありがとう！じゃあ頼むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄塊"
				},
				{
					"id": 413330107,
					"content": "紫微？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
