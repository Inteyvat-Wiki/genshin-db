							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"パイモン",
					"岡崎陸斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "童よ、来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310402,
					"content": "神子、なんでオイラたちの到着を待たずに食べ始めてるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310403,
					"content": "それは…汝らがおごってくれるからに決まっておろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310404,
					"content": "一番高い料理と一番美味い酒をタダでいただけるんじゃ、居ても立っても居られなくなるのは当然じゃろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310405,
					"content": "店主、この二人を覚えておくんじゃぞ。会計はこやつらが持つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310406,
					"content": "あいよっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "岡崎陸斗"
				},
				{
					"id": 120310407,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310408,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "どうしたんじゃ二人とも、早く席につかんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310410,
					"content": "これを食べてみよ。セイライ島の近くにしか生息しない魚じゃ。釣れた後、夜通しで稲妻城へと運ばれてきたものじゃ、とても新鮮じゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310411,
					"content": "もしくはこれを飲むか？こんな高級な名酒、普段では飲むのも惜しい一品じゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310412,
					"content": "もちろん酒を飲まなくてもよい。果汁もたくさんあるぞ、どの値段のものも一通り揃っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310413,
					"content": "おい…神子、ひどいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310414,
					"content": "前にここで原稿を書いた時は、ただの串焼きしか食べさせてくれなかったじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310415,
					"content": "ん？そうじゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310416,
					"content": "確かにそうだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "ほう、それが何じゃ？この間、妾におごると言ったのは汝らじゃったろう？それに、妾のような貴賓をもてなさぬのは、心が痛むことじゃと思うが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310419,
					"content": "でも、これってすごく高いんだろ。オイラたちが払えない可能性とか考えないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310420,
					"content": "ふふっ、それなら大丈夫じゃ、問題なく払えるぞ。妾たちが以前書いたあの小説、近頃また重版してのう。汝らの原稿料もたんまりと入ったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310421,
					"content": "な、なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310422,
					"content": "まさか！くぅぅ…あの時の表情、オイラたちをだますためだったんだな！最初からオイラたちの原稿料を使うつもりだったんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310423,
					"content": "油断した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "ふふっ、汝らの今の姿、実に滑稽じゃぞ。はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310426,
					"content": "ああ、そうじゃ。この前の無月の夜、願い事をしても何も起こらなかったから、まじない系の小説はもう流行らなくなったそうじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310427,
					"content": "じゃから『旅人の奇妙な冒険』の最新章は、新しい案を考えなくてはならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310428,
					"content": "締め切りはもうすぐじゃ。頼んだぞ、「先生」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310424,
					"content": "策にはまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "串焼きと油揚げしかなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
