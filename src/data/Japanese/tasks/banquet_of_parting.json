			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "童たち、来てくれたか。うむ、時間ぴったりじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310102,
					"content": "ふんっ、原稿料のためなんだ。来るしかないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310103,
					"content": "神子、「百鬼夜行」の手伝いって、なにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310104,
					"content": "正直オイラたち、百鬼夜行がなんなのかすらわかってないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310105,
					"content": "「百鬼夜行」と聞くと恐ろしいものに聞こえるやもしれぬが、ざっくりと言えば、ただの妖たちの集いじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310106,
					"content": "その昔、妖たちは宴を開き、溺れるほど酒を飲んだ…妖力で空を飛び、その様は月の明かりさえも遮るほどであった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310107,
					"content": "じゃが現在、地脈から溢れ出た妖の記憶は力が弱く、空を飛ぶことさえままならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310108,
					"content": "そこで、妾があやつらのために聚霊儀式を行い、散逸した記憶を集合させるつもりじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310109,
					"content": "さすれば、あやつらは鳴神大社の上空へと集うことじゃろう。そして力尽きたあと、満足してあるべき場所へとやつらは帰る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310110,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "実は、儀式の前準備はもうとっくに終わっておる。妾が小説に書き加えた呪文と「無月の夜」を覚えておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310112,
					"content": "たしか、「無月の夜」に「狐お姉さんの秘伝術」を唱えるんだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310113,
					"content": "そうじゃ、あの本に書いたのは願いを叶えるためのまじないではない、地脈の記憶を鎮める術じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310114,
					"content": "その時が来たら、みなであやつらを送ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310115,
					"content": "#{M#俺}{F#私}は何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "妾はじきに儀式の準備に取りかかる。そこで汝には、二つのことをしてもらいたい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310117,
					"content": "まず、神社の巫女たちに下山するよう告げること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310118,
					"content": "百鬼夜行が行われれば、大量の妖の記憶が鳴神大社の上空を舞う。万が一、誰かに憑依でもされたら、後々厄介になるからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310119,
					"content": "その後、妾は儀式を始め、妖の記憶を集める。この過程は時間がかかるゆえ、その間、汝らには影向山のふもとで魔物の動向を探ってきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310120,
					"content": "普段の散り散りとなった記憶であれば危険はないが、力が集まれば、魔物たちにも影響を与えてしまうやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310121,
					"content": "やつらは本能で山へ登ろうとするじゃろう。汝らには、それを阻止してきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310122,
					"content": "おう、わかったぜ。で、そのあとはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310123,
					"content": "ふむ、そのあとか…神社へ戻り手伝いをしながら、近くで妖を見るのも悪くないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310124,
					"content": "よし、それじゃあ出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
