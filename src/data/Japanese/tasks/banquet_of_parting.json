			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻紀",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "下山を？宮司様の命令ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310202,
					"content": "そうなんだ。これから行う儀式がおまえたちの体に影響を与えるかもしれないから、神子が山を下りるようにって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310203,
					"content": "そうなのですね…すぐに手配いたします。あなた方はどうなさるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310204,
					"content": "オイラたちはあいつの手伝いをしたあと、ここに戻ってきて一緒に儀式をやるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310205,
					"content": "神子が心配だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "宮司様は、あなた方をとても信頼されているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310208,
					"content": "以前まではこのような重要な儀式を行う際、宮司様はそばに誰一人として置きませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310209,
					"content": "では、儀式のほうはお願いいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310210,
					"content": "安心しろ、オイラたちは強いからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310206,
					"content": "妖怪が見たいから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
