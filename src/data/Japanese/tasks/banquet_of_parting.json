					"nextDialogs": [
						120310805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120310805,
					"content": "来たぞっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
