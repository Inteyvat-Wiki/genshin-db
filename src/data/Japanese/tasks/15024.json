						],
						"pointId": 9383
					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "ふぅ…やっと出てこれたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240702,
					"content": "君たちはやはり、使命を背負える者のようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240703,
					"content": "推測の検証はできた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "ああ、できたよ。君たちはあそこで特別なウォーベンをたくさん見たね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240705,
					"content": "おう、確かに見たぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240706,
					"content": "あそこにあるものに類似する、先祖が残した特別なウォーベンを細かく研究したことがあるんだ。すると、普通のウォーベンにはない「色」があることが分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240707,
					"content": "その「色」は私でさえ、特殊な手段を使わないと、存在を認識できない非常に不思議なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240708,
					"content": "しかし、生まれながらにして、この「色」を認識できる人が存在する——これも君たちを試した理由の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240709,
					"content": "そういえば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240710,
					"content": "先ほどの空間は、そのような特別なウォーベンを保管している場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240711,
					"content": "数百年前、ウィツィリンという大シャーマンがその保管室を封印した。よそ者が許可なく侵入すれば、中に閉じ込められるようになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240712,
					"content": "封印は今も機能していて、その具体的な原理は私も把握していない。だが、それを起動したり解除したりする方法を見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240713,
					"content": "閉じ込められたら最後、外部からの助けがない限り、脱出はほぼ不可能だ。ただし、大シャーマンと同じように「色」を識別する力を持っているとなると、話は変わってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240714,
					"content": "じゃあ、さっきの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "やはり君にはその能力が…ということは、イクトミ竜の族親は毎回、その能力を持つ者を見分けて、人を選んでいるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240717,
					"content": "おまえの秘密っていったいどんだけあるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240718,
					"content": "でも、その力があっても、ウォーベンの作り方なんてなんにもわかってないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240719,
					"content": "心配することはない。特別なウォーベンと普通のウォーベンを作る技術を比べてみたが、最も重要な違いは染料と染色方法の二つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240720,
					"content": "そして、私の推測が正しければ、特別なウォーベンの肝は特殊な染料。それを手に入れるには、君たちの力が必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240721,
					"content": "染色は…染料さえ手に入れれば問題ないだろう。私の言うとおりにやってくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240722,
					"content": "…おう、じゃあ、その時になったら頼んだぜ、族長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240723,
					"content": "それでは、君たちの能力で必要な染料を探してもらえるかい？私はその間に染料を試すウォーベンを用意しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240724,
					"content": "まずは試作品で、私の推測を検証する。成功したら、正式に作り始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240725,
					"content": "全てが終わったら、お礼として豪華な報酬を用意するつもりだ。どうだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240726,
					"content": "力には責任が伴うからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "おう、報酬もな！そうだ、報酬においしいものは入ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240728,
					"content": "今回の件は謎煙の主にとって、大きな意味を持っている。感謝を表すために、多額のモラを用意するつもりだよ。食べ物など言うまでもあるまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240729,
					"content": "やったぜ！ところで、その染料はどこで探せばいいんだ？ナタ中を探し回るわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240730,
					"content": "もちろんだ。これまでの研究で、染料が存在するかもしれない場所を一ヶ所見つけてある。それに、もう案内人も手配している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240731,
					"content": "案内人は外に待たせてあるから、準備ができたら、いつでも出発できるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240715,
					"content": "あの「色」は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
