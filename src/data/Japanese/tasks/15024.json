					"content": "確かに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240905,
					"content": "あそこ、なにか光ったぞ！旅人、見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240906,
					"content": "ここから出る方法は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "本来、見えないものを見ることかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
