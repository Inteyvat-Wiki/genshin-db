			"dialogs": [
				{
					"id": 150240101,
					"content": "あれ？神像の後ろになにか隠れてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240102,
					"content": "なんだ、イクトミ仔竜か。かわいいな…でも、なんでこっちをじっと見てるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240103,
					"content": "旅人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240104,
					"content": "（ここは…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150240106,
					"content": "#（{M#君}{F#あなた}は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150240108,
					"content": "うぅ…いったいどれくらい経ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240109,
					"content": "さっき、あのイクトミ仔竜と目が合った瞬間、変な空間に引きずり込まれたんだよな？あと、でっかいイクトミ竜も見たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240110,
					"content": "#{M#俺}{F#私}も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "一体なんなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240112,
					"content": "どうしたんだ、旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240113,
					"content": "見て…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "あっ！さっきのイクトミ仔竜だ。どこかに案内しようとしてるみたいだぞ。冒険者なら、ぜったい真相を突き止めなきゃな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240116,
					"content": "行こう、パイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "呼んでるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
