			"dialogs": [
				{
					"id": 150240301,
					"content": "こんにちは！あー、えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150240303,
					"content": "オイラの言ってること、分かるのかな？なんか、ボーっとしてるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240304,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150240305,
					"content": "わかってたら、ごめんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240306,
					"content": "何者だ？族親に向かって無礼だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150240308,
					"content": "…なるほど、かしこまりました。さっきはすまなかったな。君たちが招待された客人だというのなら、心を込めてもてなそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240309,
					"content": "自己紹介が遅れたが、私はカホロム、謎煙の主の祭司の一人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240310,
					"content": "こちらは現イクトミ竜の大族親——偉大なるトラポポックティズテトル様、わが謎煙の主の生きるトーテムであらせられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240311,
					"content": "長い名前だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240312,
					"content": "普段はみんな、トラポ様と呼んでいる。君たちもそう呼ぶといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240313,
					"content": "変わった誘われ方をした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "ああ、族親の能力のことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240315,
					"content": "なぜそんな能力をお持ちなのか、数百年も生きてこられたトラポ様の秘密は、祭司をもってしても分からないのだ。客人が困惑するのも無理はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240316,
					"content": "だが、一つだけ確かなことがある。トラポ様は君たちに重要なお告げを下した。そこで、君たちには試練を受けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240317,
					"content": "お告げ？試練？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240318,
					"content": "よければ、一緒に族長のところへ行ってくれないか。きっと私よりも族長のほうが君たちの疑問に答えられるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240319,
					"content": "おう…わかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240320,
					"content": "準備ができたら、声をかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240401,
					"content": "このウォーベンを使えば、族長のいる「黒曜石の祭場」にすぐたどり着ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240402,
					"content": "驚くことはない。これは我々の部族が使っている数多くある秘術のうちの一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カホロム"
				}
			]
		},
