			"dialogs": [
				{
					"id": 150240901,
					"content": "すっごい量のウォーベンだぞ。ほかの部族で見たものもいくつかあるけど、確かこれって歴史上の出来事を記録するものだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240902,
					"content": "このウォーベン、すごく特別な感じがしないか？ほかのよりずっと大きいぞ。どんなことが記録されてるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240903,
