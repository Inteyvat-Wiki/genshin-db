					{
						"sceneId": 3,
						"position": [
							-1644.502,
							15.092,
							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "わあっ、今のなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240502,
					"content": "あれは祭司の日常業務の一つだ。先祖の魂と繋がり、啓示を得ようとしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240503,
					"content": "族長はあちらにいらっしゃる。君たちのことを伝えてくるから、少し待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240504,
					"content": "なんというか、謎煙の主ってやっぱり不思議な感じだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240505,
					"content": "待たせたな。族長のところまで案内しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150240506,
					"content": "君たちがお告げによって選ばれた人だね？私は謎煙の主の現族長、ビラムだ。迎えに出られず申し訳ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240507,
					"content": "で、デカい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240508,
					"content": "生まれつき常人離れした体格でね。怖がらないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240509,
					"content": "いやいや！ただ驚いちゃっただけなんだ。ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240510,
					"content": "「お告げ」って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "子細はカホロムから聞かせてもらったよ。君たちの疑問は当然のものだ。外から来た者が「お告げ」について何も知らないというのも無理からぬ話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240512,
					"content": "長い歴史の中でこれまで「お告げ」で選ばれたのは、謎煙の主の者だけだった。外部の者が選ばれるのは、今回が初めてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240513,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240514,
					"content": "「謎煙の主」には古くから伝わる伝統がある。それは、部族の歴史を記録するウォーベンを作ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240515,
					"content": "同族の歴史だけでなく、他の部族の伝説や英雄の功績も記録する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240516,
					"content": "数千年もの間、私たちはそうしてきた。それを自分たちの使命だと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240517,
					"content": "だが、ナタ全土に影響を与えるような大きな事件は、極めて特殊なウォーベンで記録する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240518,
					"content": "そしてそのウォーベンは、イクトミ竜の大族親が指定した者のみが完成させられるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240519,
					"content": "イクトミ竜の族親が地脈の大きな変化に気づいて、お告げを下し、そのウォーベンを作る者を示す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240520,
					"content": "ってことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240521,
					"content": "現族親のトラポはもっと早くから地脈の変化に気づいていたはずだ。だが、君たちが来てようやく、ウォーベンを作る者を指定した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240522,
					"content": "なるほど…でも、そのウォーベンの作り方なんて、オイラたち知らないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240523,
					"content": "そうだろう、と予想はしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240524,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240525,
					"content": "トラポは約二百年前に族親を後継し、その役割も引き継いだ。そしてこれまで、トラポによって選ばれた者たちは皆、特殊なウォーベンの作り方など知らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240526,
					"content": "じゃあ、この二百年間の歴史の大事件は、なんにも記録されてないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240527,
					"content": "いや、選ばれた者たちはみなウォーベンを作り上げた。だが、自分が作ったのではなく、「神の贈り物」だと言うのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240528,
					"content": "えっと…謎煙の主ってやっぱり謎が多いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240529,
					"content": "そこがまさに困っている点でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240530,
					"content": "歴史を記録するという大事なことを、「神の贈り物」などという謎めいたものにしか頼れないのでは…とても心もとないのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240531,
					"content": "うーん、謎煙の主の族長がこんなことを言うなんて、ちょっと意外だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240532,
					"content": "そう思うのも致し方ないかもな。君たちからすれば、謎煙の主とは謎めいていて、言葉で説明できないものばかり崇める存在なのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240533,
					"content": "その点、私は確かに謎煙の主において異類だ。謎煙の主の族長でありながら、伝統の変革を掲げている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240534,
					"content": "私は様々な謎を究明することに力を注いでいるんだ。そうすれば、明確なルールを定めることができ、部族の伝承を長く守り続けられるだろうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240535,
					"content": "おおっ、なんかすごそうだな…じゃあ、「神の贈り物」がなんなのかわかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240536,
					"content": "いや…長いこと調べてきたが、「神の贈り物」について分かったことは何一つない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240537,
					"content": "例のウォーベンで記録しなければならないような大事件は、片手で数えられるほどだ。それぞれの間隔も数十年以上あった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240538,
					"content": "次のお告げが下される時には、族長はすでに代替わりしていてな。この件を事細かに調べられる機会などなかったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240539,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240540,
					"content": "事の全貌こそ分からなかったが、進展が全くなかったわけではない。ただ、選ばれた人物に、推測を検証してもらう必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240541,
					"content": "だから試練を受けてほしいと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "ああ。だが、この試練は私の推測を検証するためのものだ。君たちをそれほど煩わせはしないし、もちろん危険にさらすこともしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240543,
					"content": "具体的にはどんな試練なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "試練の地まで案内してから説明しよう。申し訳ないが、この「覆魂の羽織」を脱ぐの待ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240545,
					"content": "これは歴代の族長から受け継いだ聖物でね。祭祀の時にだけ着るものなんだよ。さっきまで祭祀中だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240546,
					"content": "そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240547,
					"content": "ビラムは羽織を脱ぎ、祭司に慎重に渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "さあ、ついておいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240549,
					"content": "そこのウォーベンが見えるかい？それに触れれば、秘密の空間に入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240550,
					"content": "試練というのは、方法を見つけて、その空間から脱出するというものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240551,
					"content": "それだけでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150240552,
					"content": "試練を甘く見ないほうがいい。万が一、長い時間が経っても脱出できないようなら、君たちが戻れるよう、私が手を貸す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240553,
					"content": "その場合、お告げは謎のままになってしまうがね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150240554,
					"content": "とりあえずやってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "ああ。そのウォーベンに触れて、試練を始めるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ビラム"
				}
			]
