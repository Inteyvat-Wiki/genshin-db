			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「花角玉将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "なるほど、そうか…もう一回戦おう。お前の虫相撲の技を必ず見切ってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360202,
					"content": "試合の勝敗なんて、もはやどうでもいい。気が済むまで戦おうじゃないか。どうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360203,
					"content": "滅多にお目にかかれない気の合う相手だ。たった数分で終わらせるなんて、惜しいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360204,
					"content": "ハッ！どんどん来やがれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360205,
					"content": "だが…俺様の虫相撲の技を見切るだと？寝言を言ってんじゃねぇぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360206,
					"content": "俺様の腕のほうが上だと認めりゃあ、何回だって付き合ってやんぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360207,
					"content": "うーん、牛使い野郎と「花角玉将」のやつ、ずっと盛り上がってるな。満足するまで、虫相撲をやらせておこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
