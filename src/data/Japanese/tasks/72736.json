			"trigger": {
				"objectNames": [
					"「花角玉将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "すごいじゃないか、大したもんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360102,
					"content": "まさか、荒瀧派が虫相撲の強者をこんなにも破るとは。お前らも虫相撲に独特の理解を持ってるようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360103,
					"content": "これまでの偏見を撤回しよう。これからは尊敬を払うべき相手と認めて、全力で戦ってやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727360104,
					"content": "牛使い野郎、親分のおまえの出番だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727360105,
					"content": "前にオイラが言ったことは気にしなくていいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727360106,
					"content": "出陣せよ、「真剣虫相撲大鬼王」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "ガーッハッハッハッ！当然だ！最後の対決も、この俺様が勝たせてもらうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360109,
					"content": "お前が手下どもをどう指導したかは知らねぇが、もう結果は分かり切ってる。そう、この俺様が率いる荒瀧派のほうが上だってことはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360110,
					"content": "覚悟しやがれ！「花角玉将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727360107,
					"content": "大激戦、鬼王対玉将！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
