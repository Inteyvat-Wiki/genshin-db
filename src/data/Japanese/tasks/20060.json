			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "待って…ふむ、オイラたちが持ってるスイートフラワーはもう足りるはずだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200600402,
					"content": "そのまま<color=#00E1FFFF>ジリアンナ</color>のところに持っていくか？それとももう少し探すか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
