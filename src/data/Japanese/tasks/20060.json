				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "こんにちは！君が持ってるのはスイートフラワーだよね。突然で申し訳ないけど、一つ売ってくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600502,
					"content": "父さんの咳がひどいんだ。ジリアンナさんに咳止めの配合を教えてもらったけど、必要な材料が彼女のところになくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600503,
					"content": "こっちも薬を作りに行くんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "そ、そうなんだ。ではやめておこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600505,
					"content": "引き留めてしまってすまない。早く大聖堂に行くといい、ジリアンナさんはまだいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600506,
					"content": "スイートフラワーは簡単に見つけられる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "ん？そ、それはわかってるが、まだ門番の仕事があるから、行けないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600508,
					"content": "ジリアンナさんのところにも昼休憩に急いで行ったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "ゲイル"
				},
				{
					"id": 200600509,
					"content": "いいや、君も薬を作りに行くんだろ…引き留めてしまってすまない。早く大聖堂に行くといい、ジリアンナさんはまだいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲイル"
				}
			]
		},
