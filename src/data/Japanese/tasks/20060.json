					"ジリアンナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "薬ができたわ。でもこの薬は一時的に症状を緩和するだけで、完治するためには薬のほかに安静も必要よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600802,
					"content": "何回もそう言い聞かせたけど、毎回全く相手にされないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600803,
					"content": "さあ、薬をトゥナーさんに持って行って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600804,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600805,
					"content": "いいえ、責任を果たしただけだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600806,
					"content": "手間をかけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600807,
					"content": "平気よ…はあ、もし誰かがトゥナーさんの世話をしてくれたら、ずっと薬を飲む必要もないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジリアンナ"
				}
