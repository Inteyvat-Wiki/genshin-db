			"trigger": {
				"objectNames": [
					"トゥナー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "こんにちは。息子のゲイルを知ってるかい？ケホケホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "ああ、大丈夫だ。大した問題はないが、持病が治らなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600104,
					"content": "この前<color=#00E1FFFF>教会</color>で見てもらったが、シスターたちも治せなくて、症状を緩和する薬だけもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600105,
					"content": "はあ、俺はこの歳だからな、長くは歩けない。今まではモコやヘイリーに薬を取りに行ってもらっていたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600106,
					"content": "ちょうど今日用事があるらしくてな…ケホケホッ…<color=#00E1FFFF>ジリアンナ</color>さんには話しておいたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600107,
					"content": "材料を持っていけば、薬を作ってくれるはずだ。<color=#00E1FFFF>スイートフラワー三つ</color>があればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600109,
					"content": "ケホッ…では頼むぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600112,
					"content": "スイートフラワー三つを持って、大聖堂でジリアンナさんに薬をもらってくれ。<color=#00E1FFFF>ゲイルには知らせるな。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600113,
					"content": "教会は西風騎士団とも関係があると聞いた。あいつは西風騎士だからな、自身の言行に注意しないといけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600114,
					"content": "俺のために何か間違いを犯すとまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600115,
					"content": "話に付き合ってもらってすまない。気を付けて行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600110,
					"content": "息子のゲイルに行ってもらおう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "トゥナー"
				},
				{
					"id": 200600111,
					"content": "ああ、あいつは今外で頑張ってるからな、心配されたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "トゥナー"
				}
			]
		},
