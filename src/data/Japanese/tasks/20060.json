			"dialogs": [
				{
					"id": 200600701,
					"content": "トゥナーさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600702,
					"content": "薬を作りにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "あら？モコとヘイリーだって聞いたけど、今日はあなたなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "ジリアンナ"
				},
				{
					"id": 200600704,
					"content": "材料は集めたよね、ちょっと確認するね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジリアンナ"
				}
			]
		},
		{
