			"dialogs": [
				{
					"id": 745250401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250402,
					"content": "厳しい表情だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "お前か。いや、今日の調査任務はもう終わった——この辺りに異常はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250405,
					"content": "ただ、さっき通り過ぎていったエルマイト旅団の様子が気になっただけだ。なぜか元気がなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250406,
					"content": "旅で疲れてるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "俺の推測だが、経済的な理由だろう。あこぎな手段ではモラを「得るまいと」すれば、エルマイト旅団ならぬ「モラナイヨ」旅団になってしまうわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250409,
					"content": "#{M#俺}{F#私}も金欠だから、モラをモラうの手伝って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "もちろん構わない。だが、モラが発生する仕事の手伝いでただ立っているだけというのは「モラ」ルに欠けるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250412,
					"content": "雷元素を操り、見た者が「雷さんだあ！」と驚く写真になるよう協力しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250413,
					"content": "…いいアイデアだね。しっかり収めるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "ああ。決定的瞬間を逃すなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セノ"
				},
				{
					"id": 745250410,
					"content": "写真を撮らせてくれないかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "ミッションに失敗したとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "犯人を追ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
