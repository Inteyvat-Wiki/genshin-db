				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "ふむ…悪くない味だ。さすがは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000702,
					"content": "さすがは…妾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "その通り。この3つの料理を経て、妾の作った「からくり調理神器」も、実用性が検証された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000705,
					"content": "火加減の制御と食材の収集という二大問題を解決すれば、この神器は「楽々調理」が可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000706,
					"content": "そうだ、この「獣肉シチュー」の調理法を受け取るといい。中に書かれている肉類は、すべて獣肉を指している。忘れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000707,
					"content": "雪山は非常に寒い、お前を何度もここに来させるわけにはいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000708,
					"content": "普段この料理を作る時は、普通の獣肉で構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000709
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000709,
					"content": "妾のために食材を集めてきてくれて感謝する、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000710
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000710,
					"content": "妾も「からくり調理神器」を持って洞府へ戻り、改良を施す。ここで別れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000711
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000711,
					"content": "そうだ、もし妾が他に手伝ってほしいことがあった場合…またお前に頼むかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000712
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000712,
					"content": "その時は、断らないでほしい。妾はお前を信じているし、お前の実力を認めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000703,
					"content": "さすがは妾の「からくり調理神器」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				}
			]
