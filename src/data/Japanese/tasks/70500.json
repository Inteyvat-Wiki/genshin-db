				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000501,
					"content": "これは…なんの肉だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000502,
					"content": "冷製鮮肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "冷製鮮肉…名前は確かにそれっぽいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000504,
					"content": "ふむ…品質も良い。だが肉の状態からするに、弱火で溶かさなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000505,
					"content": "幸い、妾の設計した「からくり調理神器」は解凍機能も備わっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000506,
					"content": "その神器なんでもありだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "そうでもないぞ？足りない機能ももちろんある。例えば、自動で食材を集める機能や、自動で火加減を調整する機能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000508,
					"content": "この神器は、まだまだ改良が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000509,
					"content": "さあ、雑談もここまでにして、食材が集まったのなら今すぐ神器を起動しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000510,
					"content": "火加減はお前に任せるぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000511,
					"content": "準備ができたら、妾に言うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000512,
					"content": "仙人、やっぱりすごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "仙力を褒めるより、この「からくり調理神器」を褒めてほしかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
