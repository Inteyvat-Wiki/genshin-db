			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "氷天雪地、玉樹瓊枝…寂しくも冷たき地よ。妾の三つ目の料理、確かにこの情景に合ったものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000102,
					"content": "今回はどんな料理を作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "ふむ…聞くが、「煮」という調理方法を聞いたことはあるか？妾が調理手法を読んでいた時に偶然見つけたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000104,
					"content": "それに、興味があってな。その調理方法を中心にし、「獣肉シチュー」という調理法を書いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000105,
					"content": "妾の「からくり調理神器」を使えば、この料理はそう難しくない。だが「獣肉シチュー」は、肉がとても重要だ。使う獣肉は、良質なものでなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000106,
					"content": "そのため、妾は神器を起動し、食材の気配を辿ってここまで来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000107,
					"content": "だがここは吹雪が強く、行動が容易ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000108,
					"content": "旅人、お前の冒険経験なら、雪山など取るに足らないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000109,
					"content": "妾のために、食材を見つけて来てはくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000110,
					"content": "#3つ目のレシピは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}にちょうだい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "もちろんお前を忘れておらぬ。ではこのことは頼んだぞ、妾はここで待つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000112,
					"content": "ふむ、神器が急に止まった。まさか周囲が寒すぎるせいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000113,
					"content": "再起動を試みよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000114,
					"content": "からくり調理神器…起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000115,
					"content": "これでいいだろう…旅人、この気配を辿り、必要な食材を集めてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000116,
					"content": "寒くて飛べないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "戯言を！妾の権能を甘く見るな！妾はただ、ただ…ここで神器を修理したいだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705000118,
					"content": "早く行くといい、妾をあまり待たせるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
