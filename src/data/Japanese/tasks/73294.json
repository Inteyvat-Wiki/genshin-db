			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "ううう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940102,
					"content": "#なんか、調子悪そうだな…きっとお腹が空いてるんだ！{NICKNAME}、食べ物を分けてあげようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940103,
					"content": "グルメで彼に力を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "別にえこひいきで言ってるわけじゃないからな。おまえの料理は本当にうまいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940107,
					"content": "倒れている人にテイワット風目玉焼きをあげた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "い！生き返った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940109,
					"content": "うわっ…こいつ本当にお腹が空きすぎてたんだな。これっぽっちの目玉焼きで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940110,
					"content": "これは本当に生き返る美味しさだ…はぁ、目玉焼きがこんなに美味しいと知っていたら…あいつからあの不思議な鳥の卵を買っておくべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940111,
					"content": "不思議な鳥の卵ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940112,
					"content": "その卵を食べれば一日の悪運を帳消しにできるんだってさ。あの時買っておけばなぁ…待てよ、十二個買ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940113,
					"content": "うぅ…なんかうさんくさい話だな、インチキ商売なんじゃないのか？——それにしても、どうしておまえはこんなところに一人でいたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940114,
					"content": "俺は…ええと…アイデア探しにスメールに来たフォンテーヌの有名画家だ。俺のことはジュリアンと呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940115,
					"content": "こんなところでアイデア探し？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "他にもっと良いところがあるんじゃないのか？もっと景色が良くて、もっと安全なところとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940119,
					"content": "それに、本当にフォンテーヌから来た画家なら、なんで手ぶらなんだよ？あっ…もしかして、実はおまえ、ファデュイのスパイなんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940120,
					"content": "過激な推理だな！一体どんな人生を送ってきたら、そんな推理ができるようになるんだ。俺は確かに画家だ…ただの画家。他の何者でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940121,
					"content": "ええと、俺はもう十分インスピレーションを受けたから、フォンテーヌに帰ろうとしていたところだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940122,
					"content": "まさかスメールの気候がこんなにも乾燥しているなんて。来る途中で通った沈玉の谷では、まだ湿気があったのに…スメールに足を踏み入れた途端、砂が多くなって、風まで強くなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940123,
					"content": "やっぱり湿気のある環境の方が慣れているから、帰りは水路で少し違う風景を見てみようと思ったんだ。だけど途中で筏がバラバラに壊れてしまって、恥ずかしながら、俺もカナヅチで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940124,
					"content": "フォンテーヌで生きるのすら大変そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "その通り、問題は泳げないことだけじゃないんだ…はぁ、まあいい。水辺に休める場所を見つけたから、まだ使える茶葉が残っているはずだ…お礼に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940126,
					"content": "お茶をご馳走してくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940127,
					"content": "ああ、もちろん…もちろんだ！目玉焼きの恩を返すために、君たちへ…そういえばまだ二人の名前を聞いていなかったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940128,
					"content": "そうだ、自己紹介を忘れてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME}とパイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "うん、いい名前だ。とにかく、お茶をご馳走するよ。キャンプはすぐそこだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940130,
					"content": "正義の使者とその従者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#{NICKNAME}と最高の仲間——パイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940132,
					"content": "キンキラキンとギンギラギン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#金ピカの{NICKNAME}と銀ギラのパイモンだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940117,
					"content": "自分で自分を「有名」って言うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "たしかに変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940105,
					"content": "ははっ、パイモンじゃあるまいし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "なんだよ！誰だって一回や二回は、腹ペコすぎて気絶したことがあるものだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
