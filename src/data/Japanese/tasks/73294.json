		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "質素すぎるだろ！これってキャンプって言えるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940502,
					"content": "でもここら辺は景色が素敵だろ？砂浜に来るとすごく開放的な気分になって、フォンテーヌに居た頃よりも気持ちいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940503,
					"content": "フォンテーヌで一体どんな生活を送ってたんだよ…有名画家の暮らしのイメージとは随分違うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940504,
					"content": "実はフォンテーヌにある俺の住処はすごく小さかったんだ。その、つまり…俺は名誉なんか気にしないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940505,
					"content": "冒険者のキャンプですらここより豪華だぞ。あれ？これ…おまえ、動物の仲間でもいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940506,
					"content": "えっ…俺には動物の仲間なんていないよ。大方、ここに立ち寄った冒険者が置いて行ったんだろ。ところで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940507,
					"content": "ちゃんともてなしたいのは山々なんだけど、不幸なことに大半の荷物があの時水に落ちてしまって…でも俺は泳げなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940508,
					"content": "水に落ちた俺の荷物を探してくれないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940509,
					"content": "水浸しの荷物を拾ってどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "一応丁寧に包んであったんだ。でも中にあるものは…はぁ、なくなってたら仕方がない。平気さ、また描けばいいんだ…また…描けば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732940511,
					"content": "#うっ…なんかすごく可哀想だぞ…{NICKNAME}、手伝ってやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732940512,
					"content": "ここには君たちしか頼れる人がいないんだ…俺はここでお茶を淹れて待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリアン"
				}
			]
		},
