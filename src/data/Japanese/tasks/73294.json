			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "変だな、こんなところにどうして犬がいるんだ？しかもなにかを守ってるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941002,
					"content": "（警戒している）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732941003,
					"content": "賢そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "ワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732941007,
					"content": "そういえば、さっきジュリアンのキャンプにペット用の皿があったよな？あれ、こいつのだったんじゃないのか？おかしいぞ、どうしてジュリアンは動物の仲間なんていないって言ったんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941008,
					"content": "クーン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732941009,
					"content": "犬はキャンプの方へ走り去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "逃げちゃったぞ…あとでジュリアンに聞いてみようぜ。今は…この砂の下になにが埋まってるのか、確認しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941005,
					"content": "どこから来たんだろう？野良犬かな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "ウゥー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "犬"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
