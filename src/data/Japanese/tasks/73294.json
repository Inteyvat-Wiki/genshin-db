			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "戻ってきたぞ…あ！やっぱりジュリアンのペットなんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941202,
					"content": "グルルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732941203,
					"content": "…こいつ！ペッパーめ…俺に吠えやがったな。誰がお前に食べさせてやってると思ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941204,
					"content": "（名前があったのか！でも、こいつ正気か？なんで犬と喧嘩してるんだよ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941205,
					"content": "（仲が良さそうだね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "（これのどこが仲いいんだよ！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941244,
					"content": "なあ…ジュリアン！おまえの失くしたもの、全部取り戻したぞ。ところで、「ペッパー」はおまえのペットだろ？なんでさっきオイラたちに嘘ついたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941209,
					"content": "恩を仇で返すようなやつと一緒にいろって言うのか？だったらまだ獣域ハウンドと仲間になった方がマシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941210,
					"content": "あんまり関係が長持ちしそうにないね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "そうだぞ、行き倒れるような普通の人間が獣域ハウンドに会ったりしたら、それこそテイワット風目玉焼き一つでどうにかなる問題じゃないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941212,
					"content": "そういえばこいつ、さっき砂浜でキャンバスを守ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941213,
					"content": "キャンバスを隠そうとしたのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "ほんとか？悪い犬だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941217,
					"content": "バウ！バウッ！（抗議しているようだ）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "犬"
				},
				{
					"id": 732941218,
					"content": "どの面下げて吠えてるんだ？お前とこの道に来てなかったら、元の道でフォンテーヌに帰れただろうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941219,
					"content": "あれ？さっきは水路の景色が見たくて水路を選んだって言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941220,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941221,
					"content": "…はあ、しょうがない。実はスメールの風景なんて見る間もなく、こいつにここまで連れてこられたんだ。ここいらの道はぐにゃぐにゃ曲がりくねっていて、迷わないでいるのは至難の業だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941222,
					"content": "なるほど、そうだったのか。だったら最初からオイラたちにそう言えばよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941223,
					"content": "ええと…何と言うか…有名画家のメンツみたいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941224,
					"content": "おまえが言葉に詰まる時って、毎回デタラメを言ってオイラたちを誤魔化そうとしてるんじゃないかって気がするんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941225,
					"content": "#でもスメールの風景が見たいなら、オイラと{NICKNAME}は景色のいい場所を知ってるから、案内してやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941226,
					"content": "そ、それはいいよ。せっかくのご厚意だけど…でも、ええと…俺も有名な画家だから、真に書くべき風景は自分で発見すべき、というか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941227,
					"content": "そうだ、お茶を淹れてあるから、まずはお茶にしよう。ついでに、まだ目玉焼きがあるなら、もらえないかな？お茶請けってことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941228,
					"content": "なんでお茶に目玉焼き…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#そうだぞ、{NICKNAME}は得意料理がいっぱいあるんだからな！他のにしようぜ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941232,
					"content": "デザートと一緒にジュリアンが淹れたお茶を楽しんだ。\\n何とも言えない味がした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "このお茶…ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941234,
					"content": "ああ、友達から買ったんだ。潜在的な知恵を引き出す効果があると言っていた。俺は美味しいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941235,
					"content": "そんな友達を持ってなくて良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "どうして？友達を持つのはいいことだろ。今回スメールに来たのも、友達の助言を受けたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941240,
					"content": "今日は本当に世話になったね。これぐらいの報酬で満足して貰えたかどうか分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941241,
					"content": "気にするなって。それよりも景色選び…本当に手伝わなくていいのか？また道に迷いそうな気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941242,
					"content": "巡礼の道…コホン、その…旅の意義は自分の足で歩くことにある…もうこれ以上二人の手を煩わせることはないよ、自分で十分対処できるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941243,
					"content": "そこまで言うなら…しょうがないな。もう行き倒れたりするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941237,
					"content": "もう一杯くれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#{NICKNAME}…おまえの舌、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941239,
					"content": "ハハハ、ごめんね。ケチるわけじゃないけど、まだしばらくスメールに滞在するから、少し自分にも残しておきたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "ジュリアン"
				},
				{
					"id": 732941230,
					"content": "「調子に乗るな。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "うっ…でもお茶だけじゃ、やっぱり物足りない気がするぞ…なにか美味しいものを作ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941215,
					"content": "キャンバスが奪われないように守っていたのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "でもオイラたちに見つかったら、すぐ逃げていったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732941207,
					"content": "（お酒の匂いはしないんだけどね…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "（普段からこうってことか？ううっ…考えただけで最悪だぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}