			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディシア",
					"ドニアザード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240101,
					"content": "うーん、前に立てたプランでは…あとはなにを買うんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240102,
					"content": "あっ…いい匂いだな…「獣肉のビリヤニ」だ！ちょっと買っていこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240103,
					"content": "プランにはなかったはずだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240104
					]
				},
				{
					"id": 130240104,
					"content": "じゃ、じゃあ今追加するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240105,
					"content": "へえ、旅人とパイモンじゃないか。まさかこんなところで会えるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240106
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240106,
					"content": "こんにちは、久しぶりだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240107
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240107,
					"content": "わぁっ！またおまえたち二人組か。ディシア、おまえって砂漠に戻ったんじゃなかったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240108,
					"content": "はは、ボディガードの仕事を辞めただけで、喧嘩したってわけじゃないんだぜ。ドニアザードとはいい友達だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240109
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240109,
					"content": "フーマイ家はまだ人手を募集してるし、報酬も手厚い。あたしにしたって仲間たちにしたって、断る理由はないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240110
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240110,
					"content": "ここ数日、ディシアはうちの仕事を引き受けてくれてたの。だからそのままうちに泊まってもらってるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240111
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240111,
					"content": "お父さまもお母さまもとても喜んでるわ。前にディシアがいなかった時なんか、まるで家族がいなくなったようだ、なんて言ってたもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240112
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240112,
					"content": "そりゃ大げさすぎますよ。旦那様と奥様はいつもほんとに親切で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240113
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240113,
					"content": "仕事は終わったし、ちょっと買い物したら旅団に戻る予定だったんだけどさ、旦那様がどうしてもあと一泊していって欲しいと仰って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240114
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240114,
					"content": "もう二、三日泊まっていったっていいじゃないの。お父さまがまだディシアに得意料理を振舞ってないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240115
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240115,
					"content": "あたしが暇に耐えられない人間だって、お嬢様は知ってるでしょうが。気にすんなって、また機会はあるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240116
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240116,
					"content": "おまえはすごいな…「得意料理」って聞いても、ちっとも動揺してないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240117,
					"content": "あ、そうだ。前に、今度砂漠に連れて行ってくれるって約束したでしょ。今日出発するのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240118
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240118,
					"content": "まだ見ていないところがたくさんあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240119
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240119,
					"content": "申し訳ないが、今日はまだダメだ。旅団には処理しなきゃならないことも残ってるし、最近は砂漠のほうも物騒だしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240120
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240120,
					"content": "今日も先延ばしにする気ね？前回もそうだったわ、前々回も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240121
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240121,
					"content": "ごめんごめん、もうちょっと時間をくださいよ。ちゃんと手配しておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240122
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240122,
					"content": "分かったわ。でも、単なるわがままじゃないのよ。実はその…ある種のカンみたいなもの、というか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240123
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240123,
					"content": "今回うちに来てくれた時から、ディシアが妙に焦っていて、落ち着かない様子でいること…私気づいてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240124
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240124,
					"content": "何か困ったことがあって、それで私たちの約束を何度も先延ばしにしてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240125
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240125,
					"content": "いやいや、お嬢様の考え過ぎですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240126
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240126,
					"content": "それじゃ、約束できる？友達っていうのは、お互いに嘘をついてはいけないのよ。ディシアが頷いてくれるなら、私はこれ以上聞かないことにするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240127
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240127,
					"content": "でも、もし本当に何かあるなら、ちゃんと私に教えて。何とかして、あなたを助けるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240128
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240128,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240129
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240129,
					"content": "ドニアザードの言う通りなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240130,
					"content": "はぁ、お嬢様ときたら、まったく手に負えないぜ。どんなこともあんたには隠し通せないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240131
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240131,
					"content": "傭兵界隈のことなんか、お嬢様は知る必要がないと思ってた。知ってもいいことはないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240132
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240132,
					"content": "リスクを避けて利をとる、弱肉強食の世界——こことはだいぶ違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240133
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240133,
					"content": "でも、私たちは親友でしょう。ディシアの悩みが分からなかったら、サポートしたり手助けしたりできないじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240134
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240134,
					"content": "お嬢様…そこまでこだわる必要なんかないでしょうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240135
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240135,
					"content": "…はぁ、本当に参ったな。じゃあ場所を変えよう…ここはあまりよくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240136
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240136,
					"content": "ここにしよう。なるべく人目を引かないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240137
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240137,
					"content": "エルマイト旅団はかなり人が多いし、構成も複雑だ。あたしみたいに、モラを稼ぐためにあちこちで仕事を探している傭兵がそこら中にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240138
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240138,
					"content": "あたしのいる旅団は「熾光の猟獣」って名前で、規模は大きくない。だが、うちが受け入れてるのはみんな気骨のある、義理堅い連中ばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240139
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240139,
					"content": "けどな、モラのためなら道徳だってきれいさっぱり捨てられるような旅団もある。中でも一番悪名高いのは、「神王のレリクス」って旅団だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240140
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240140,
					"content": "神…王？エルマイト旅団のやつらにとっての、神様で王様って言えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240141,
						130240142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240141,
					"content": "キングデシェレトでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				},
				{
					"id": 130240143,
					"content": "そう、あんたらは「アフマルの目」とやり合ったことがあるって聞いた。あいつらは「神王のレリクス」に付属する旅団の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240144
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240144,
					"content": "おう、神の缶詰知識を売ってたあの旅団だな！確かに、いいやつらとは思えなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240145,
					"content": "「神王のレリクス」はいくつもの似たような旅団で構成されてて、本部が上から下までをぜんぶ管理してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240146
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240146,
					"content": "本来なら、やつらとは一切関わりたくないところだが…今回騒ぎを引き起こしたのは、「アフマルの鬚」って旅団なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240147
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240147,
					"content": "…ひげ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240148,
					"content": "あごひげのことだよ、多分な。バカな名前だってことは言わなくても分かってるぜ。あたしも昔から大嫌いだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240149
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240149,
					"content": "だが要点は——それがクセラ…オヤジの旅団ってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240150
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240150,
					"content": "ええ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240151,
					"content": "言いにくかった理由は少し分かってきたわ…でも彼らが一体何をしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240152
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240152,
					"content": "詳しいことはやっぱり言わないでおくよ、お嬢様。とにかく、やつらはかなり多くの暴力沙汰を起こした…百件以上か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240153
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240153,
					"content": "そんなにたくさん！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240154,
					"content": "ああ。それに現場の状況もかなり凄惨だ。やつらは金品を全部奪った後、口封じに人を殺すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240155
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240155,
					"content": "被害者はキャラバンや一般人にとどまらず、他の傭兵団にまで及んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240156
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240156,
					"content": "もう敵と味方の区別すらしてないのね。モラルがないにもほどがあるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240157
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240157,
					"content": "この件に関して、「神王のレリクス」の内部がどういう態度でいるのかは分からないが、ここ数年やつらはますます大胆になってきてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240158
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240158,
					"content": "このまま見て見ぬふりをしていれば、あたしの旅団も、アアル村の人たちも、いずれはやつらに狙われるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240159
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240159,
					"content": "はぁ…オヤジのやつ…ここ数年、いったい何考えてんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240160
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240160,
					"content": "おまえのオヤジって、そんなに恐ろしいやつなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240161,
					"content": "人は変わるもんさ。記憶じゃ、前からろくでなしではあったけど、一線を超えるようなことはしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240162
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240162,
					"content": "高い評価とは言えないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240163,
					"content": "はぁ…そうじゃなきゃ、「アフマルの鬚」を出て、オヤジと関係を断つわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240164
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240164,
					"content": "オヤジは大雑把で、すごく騒がしくて、適当なやつだ。毎日毎日まともなこともせずに酒を浴びるほど飲んで…それにスケベだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240165
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240165,
					"content": "旅団の成員たちと一緒になって、よく一晩中はしゃいでたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240166
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240166,
					"content": "うわ、悪夢みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240167,
					"content": "お母さまは？彼らを止めないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240168
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240168,
					"content": "…残念だけど、母親が誰なのかあたしは知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240169
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240169,
					"content": "あっ…ごめんなさい、ディシア。私そんなつもりじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240170
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240170,
					"content": "気にしなくていいさ、お嬢様。傭兵にはあたしみたいなやつが多いんだ。オヤジがスケベだって言ったろ？あたしはそうやって生まれたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240171
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240171,
					"content": "オヤジもあたしの母親が誰なのか分からないと言った。母親もあたしに会いに来たことは一度もなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240172
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240172,
					"content": "オヤジはいつも「父さんがいれば大丈夫だ」なんて言ってたが、ほとんどのことは旅団のみんなに任せて、オヤジは物語を語ってくれる程度だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240173
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240173,
					"content": "でもオヤジはセンスがほんとになくて、物語のレパートリーは少ないわ、古くて時代遅れのものばっかりだわでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240174
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240174,
					"content": "砂城の勇者が森にいる巨竜を倒したとか、傭兵があらゆる困難を乗り越えて、反乱軍から姫を救い出した、とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240175
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240175,
					"content": "どれもありきたりな童話だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240176,
					"content": "ああ。一回や二回ならまだ新鮮に感じられるかもしれないが、十回目や二十回目にはもう聞き飽きてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240177
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240177,
					"content": "でもオヤジは飽きもせず、むしろどんどん夢中になって、旅団にいる仲間たちまで呼んで芝居をさせたりしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240178
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240178,
					"content": "用意してくれるおもちゃも、物語の中の道具とか、鎧とか…それに盾、それからおもちゃの剣ばっかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240179
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240179,
					"content": "後になってようやく分かったよ——オヤジはあたしのために物語を語ってたんじゃなくて、あいつ自身がそうやって遊ぶのが好きだったんだってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240180
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240180,
					"content": "わぁ…変なやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240181
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240181,
					"content": "でも心根は悪くなさそうだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240182
					]
				},
				{
					"id": 130240182,
					"content": "まあな。子供の頃は幼稚な人だとは思ってたが、どうしようもないやつだって思ったくらいで、嫌いとまでは言えなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240183
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240183,
					"content": "でも——大人になってから、「神王のレリクス」のしてきたことをたまたま知ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240184
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240184,
					"content": "略奪、脅迫、暴力、詐欺——そんなすべての悪行が、組織の中で自慢の種になってるなんて、思いもしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240185
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240185,
					"content": "オヤジや旅団のやつらは英雄なんかじゃなくて、物語の中じゃ倒されるべき悪人だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240186
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240186,
					"content": "まさか見せさえしなければ、あたしが永遠に分からないとでも思ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240187
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240187,
					"content": "あなたの気持ち、分かるような気がするわ。現実との落差を感じてしまったのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240188
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240188,
					"content": "そうだな…でも大丈夫さ、お嬢様。もう過去のことだからな。オヤジと大喧嘩した後はあたしが出ていって、それ以来一度も戻ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240189
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240189,
					"content": "今回、調査に関わることにしたのも、オヤジに何か感情を抱いてるからじゃない。単に周りの人を守りたいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240190,
						130240191
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240190,
					"content": "問題は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240192,
					"content": "うん、仲間たちが色んなところから情報を集めてる。報告のほとんどは暴力沙汰だが、違法取引に関するものもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240193
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240193,
					"content": "そうなのね…でもそれってとても危険なんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240194
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240194,
					"content": "まあな、でも傭兵の一生は常に危険と隣り合わせさ。あたしはこういう生き方を楽しんでるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240195
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240195,
					"content": "でも、あなたのことを大切に思っている人にとって、それはとても重い負担になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240196
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130240196,
					"content": "だから、あんたに言うつもりはなかったんですよ、お嬢様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241101
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241101,
					"content": "ど、どうしよう？二人とも一理あるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130241102,
					"content": "ディシアと一緒に行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241103
					]
				},
				{
					"id": 130241103,
					"content": "え？あんたまで巻き込まれる必要はないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241104
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241104,
					"content": "こいつはすごいんだぞ、ドニアザード。こいつとディシアが手を組めば、こんなことは「パッと」解決だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130241105,
					"content": "#うん…分かった、{M#彼}{F#彼女}がいてくれれば確かに安心できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241106,
						130241107
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130241106,
					"content": "安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130241108,
					"content": "じゃあ、私はシティであなたたちからの情報を待っているわ。どうか無事でいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241109
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130241109,
					"content": "心配してくれてありがとな、お嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241110
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241110,
					"content": "それじゃ出発しよう。まずはキャラバン宿駅に行って「熾光の猟獣」へ——あたしの仲間たちに会いに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241107,
					"content": "で、できる限りやってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130240191,
					"content": "なぜ彼らが突然多くの悪事を働き始めたか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240142,
					"content": "アフマル。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				}
			]
		},
		{
			"id": 1302402,
			"completionStepIds": [
				1302402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302402",
							"2"
						],
						"stepId": 1302402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハルン",
					"ヒシャム",
					"ハラフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240201,
					"content": "おう、ディシア、戻ってきたか。この二人は君の友達か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240202,
						130240204
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240202,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240203
					]
				},
				{
					"id": 130240203,
					"content": "はは、こんにちは。気楽にしてくれよ、こっちはこれといったこだわりなんてのはないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240206,
					"content": "新しいやつらもいることだし、俺から「アフマルの鬚」について簡単に説明させてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240207
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240207,
					"content": "やつらはやり方を選ばず、自分の仲間たちを直接、モラを巻き上げるターゲットにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240208
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240208,
					"content": "それも、普通の傭兵団だけじゃない。同じ「神王のレリクス」に属する旅団も、やつらに襲われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240209
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240209,
					"content": "凶暴で残酷な獣でさえ己の血肉と群れを守るのに、あいつらは全然気にしちゃいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240210
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240210,
					"content": "そう。傭兵から価値のあるものを奪ったら、やつらは他の旅団や、闇市の商人にそれを転売する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240211
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240211,
					"content": "一部のモラは食糧や武器と交換され、すぐに次の暴力行為に使われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240212
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240212,
					"content": "ひどすぎるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240213,
					"content": "ああ、だから俺たちも気になってるところなんだ——やつらがこんなにモラを渇望してる理由は何なのかってことがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240214
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240214,
					"content": "この前、ヒシャムと一緒にやつらを尾け、商人に化けてやつらとやり取りした。そしたら、案の定とんでもないことが分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240215
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240215,
					"content": "——「財物を奪う」というよりは「内輪揉め」だな、あれは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240216
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240216,
					"content": "待て、「内輪揉め」だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240217
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240217,
					"content": "そうだ。被害者の中で、「神王のレリクス」に属する旅団の比率がとても高いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240218
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240218,
					"content": "単にモラ目当てなら、相手は誰でもいいわけで、こんな風に明確な目標を狙う理由はないはずだ。でも、内輪揉めだと解釈すれば、辻褄が合う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240219
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240219,
					"content": "だが残念ながら、やつらは口がとても堅くてね。これ以上の情報は得られなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240220
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240220,
					"content": "ただ、「アフマルの鬚」が活発に動いてたここ数年で、「神王のレリクス」の勢力はどんどん削がれていってるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240221,
						130240222
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240221,
					"content": "そんなに凄腕のやつらなの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240223,
					"content": "確かにおかしい。こっからの調査はあたしたちに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240224
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240224,
					"content": "でも、あたしがいなかったこの数日間のうちに、あんたらが直接話を聞き出しに行ってたなんてな。あまりにも危険すぎやしないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240225
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240225,
					"content": "まあ、気にするな。これは君の親父さんの旅団だろ？俺たちは君よりも心配してるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240226
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240226,
					"content": "そう、それに、あんたがしてきた危険なことのほうがよっぽど多いだろ。あんたに比べれば、オレたちのしたことなんか大したことじゃないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240227
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240227,
					"content": "二人が取引に出かけている間に、俺は被害者の拠点を確認しに行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240228
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240228,
					"content": "生存者はおらず、生き残った者はみんな逃げた後だった。拠点に価値のあるものは何も残っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240229
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240229,
					"content": "ヒシャム、ハラフ、あんたたちも来たのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240230
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240230,
					"content": "あんたが帰ってくるのを見かけてな。すぐ駆け付けてきたんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240231
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240231,
					"content": "そっちの新しい友達は一見まだ未熟そうだけど——ただならぬオーラを感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240232
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240232,
					"content": "あんたのそばにはすごい助っ人がいるみたいで、オレたちも安心さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240233
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240233,
					"content": "オイラは？オイラはどうなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240234,
					"content": "あ、あんたも一緒に行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240235
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240235,
					"content": "もちろんだぞ！オイラはこいつの一番大切なガイドなんだからな！こいつがどこに行こうがオイラはついていくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240236,
					"content": "そ、それじゃディシア…彼女の面倒をよく見てやれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240237
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240237,
					"content": "オイラのことをバカにしてるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240238,
					"content": "ははは、こう見えてもこいつは今まで数々の危険な場所に行って、最後にはいつも無事でいたんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240239
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240239,
					"content": "たとえ偶然だったとしても、ここまで偶然が積み重なれば、相当なもんだって言えるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240240
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240240,
					"content": "そうだったのか。オレとしたことが、見た目で人を判断してしまったな、ハハ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240241
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240241,
					"content": "そうだ、ディシア。時間があったらお前のスケジュールを副団長に教えてやれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240242
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240242,
					"content": "この間の新人募集の時、みな「熾鬣の獅子」の名前目当てにやってきたのに、ちょうどお前が留守で、ここにいたのは男ばっかりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240243
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240243,
					"content": "副団長はあちこち駆け回ったんだが、結果は芳しくなくて、残ってくれるやつはあまりいなかった。とても悲しんでいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240244
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240244,
					"content": "悪い悪い、またいい酒でも何本か持って行くよ。こないだは急いでたから、わざわざ帰ってくるのも面倒でさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240245
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240245,
					"content": "でも、そいつらの選択は正しいと思うぜ。ディシアがいなけりゃ、確かにここは魅力的な場所じゃないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240246
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240246,
					"content": "副団長が何とかして、何人かイケメンや美人さんを捕まえて来てくれたらよかったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240247
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240247,
					"content": "よせよ。前に女性の傭兵を二人呼んできた時なんか、あんたらどいつもこいつもトウガンみたいに座ったままで、息もできなくなってただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240248
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240248,
					"content": "本当に不気味な沈黙だったぜ。彼女たちは入団するつもりだったのに、あの食事の後は怖がって逃げちまってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240249
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240249,
					"content": "そ、そんなことはもういいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240250
					],
					"speakerTitle": "ヒシャム"
				},
				{
					"id": 130240250,
					"content": "こんなことがあったのか？俺は知らないが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240251
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240251,
					"content": "あの時君はいなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240252
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240252,
					"content": "いなかっただと？こんな千載一遇のいい時を逃してしまった上に、お前らは誰もこのことを教えてくれなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240253
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240253,
					"content": "まあまあ、分かった、分かったって。後で教えるから、暴れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240254
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240254,
					"content": "いや、誤魔化せると思うなよ。それにヒシャム、お前もだ。早く来い、詳しく教えろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240255
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130240255,
					"content": "おまえたちって…いつもこんな感じなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240256,
					"content": "ハハハ、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240257
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240257,
					"content": "傭兵の間には細かいルールなんかないのさ。思いついたことは何でも言う…すっごく自由だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240258
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240258,
					"content": "もしキレるようなことがあれば、罵ってやればいい。それでも気が済まねぇなら、直接手を出したっていいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240259
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240259,
					"content": "みんなそんなこと気にも留めないから、すぐ過ぎ去っていく。不満を表に出せず、永遠に交流を断ち切っちまうよりはマシだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240260
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240260,
					"content": "だからあいつらと話してる時は、あたしも手加減しないんだ。笑うべき時は笑って、罵るべきときは罵る——すっごく気持ちいいぜ。フーマイ家にいる時は、そんなことできないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240261
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240261,
					"content": "おい、あんたら。ケンカは後にして、まずは情報をくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240262
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240262,
					"content": "聞いてるのか、ハラフ、先に仕事を済ませろ。俺はルートマップを描いてみたんだ——この場所でやつらが盗品を売るのを手伝ってるキャラバンを止めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240263
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240263,
					"content": "まずはどこかに隠れるといい。夜になれば必ず犯人も盗品も全部押さえられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240264
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240264,
					"content": "分かった、ありがとな。他のやつにもよろしく伝えといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240265
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240265,
					"content": "安心してくれ、君も気を付けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130240222,
					"content": "ますます理解できなくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240204,
					"content": "命を預けてもいい友達だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240205
					]
				},
				{
					"id": 130240205,
					"content": "ほう？なら俺たちと一緒だな、はは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "ハルン"
				}
			]
		},
		{
			"id": 1302403,
			"completionStepIds": [
				1302403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302403",
							"2"
						],
						"stepId": 1302403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240301,
					"content": "どうやらここみたいだな。まずは隠れて、機を見計らおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240302
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240302,
					"content": "衝突することになるかもしれないから、気を付けないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240303
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240303,
					"content": "安心しろって、こいつはケンカ上手だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240304,
					"content": "ハハハ、もちろんそんなことは心配してないさ。「やり過ぎないように」気を付けないとって意味だよ。情報も得なくちゃいけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240305
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240305,
					"content": "やつらが来たようだ。準備はできてるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240306
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240306,
					"content": "速戦即決。やつらが反応できる前にやっちまおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				}
			]
		},
		{
			"id": 1302405,
			"completionStepIds": [
				1302405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302405",
							"2"
						],
						"stepId": 1302405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サタール",
					"ディシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240501,
					"content": "ち、ちくしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240502
					],
					"speakerTitle": "サタール"
				},
				{
					"id": 130240502,
					"content": "お、お前は…「熾鬣の獅子」！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240503
					],
					"speakerTitle": "サタール"
				},
				{
					"id": 130240503,
					"content": "ほう？長々説明しなくて済みそうだな。さっさと言え、「アフマルの鬚」とはどういう関係だ。やつらの狙いは何だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240504
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240504,
					"content": "ふん、モラをもらって仕事をする以上、傭兵が雇い主の情報を守るのは基本的な原則だ。俺が吐くとでも思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240505
					],
					"speakerTitle": "サタール"
				},
				{
					"id": 130240505,
					"content": "素人相手ならそんな言葉も効果的かもしれないが、結局あんたはモラを稼ぐために自分の信用と評判を守りたいだけだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240506
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240506,
					"content": "だが、商売をするには他にも色んなものが必要だな——例えば、その手や足、そしてあんたの目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240507
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240507,
					"content": "五秒だけ時間をやるよ。雇い主の情報が本当にそれほど重要なことか、よく考えてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240508
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240508,
					"content": "おいおい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240509,
						130240510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240509,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				},
				{
					"id": 130240511,
					"content": "冗談を言ってるんじゃないぞ。どうすれば人が一番苦しむのか、あたしはよく分かってるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240512
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240512,
					"content": "残り二秒だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240513
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240513,
					"content": "ふん、手を煩わせる必要なんてねぇよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240514
					],
					"speakerTitle": "サタール"
				},
				{
					"id": 130240514,
					"content": "おい！？あんた気が狂ったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240515
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240515,
					"content": "こいつ、自分の舌を噛みやがった！早く、貨物の中に薬がないか探してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240516
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240516,
					"content": "ディシアが応急手当をして、サタールの口内の出血は収まった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130240517
					]
				},
				{
					"id": 130240517,
					"content": "はぁ、予想外だったぜ。幸い舌の状況はひどくない…痛みで気絶しただけらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240518
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240518,
					"content": "なんでそんなことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240519,
					"content": "こいつと威勢を張り合うつもりだった。そこらの傭兵と同じように、苦もなくこいつから情報を聞き出せると思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240520
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240520,
					"content": "まさか、こんなキツい方法を使ってまで、情報を守ろうとするとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240521
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240521,
					"content": "どうするんだ？こいつ、もう気絶しちゃったぞ…目を覚ますのを待つのはいいけど…でも、やっぱりこれ以上続けるのはやめておこうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130240522,
					"content": "ああ、安心しろ。こいつみたいなやつから聞き出そうとしたって時間の無駄だ。それに、そんなことしたらまた自分を害そうとするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240523
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240523,
					"content": "ここに貨物がたくさん置いてある。調べてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240524
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240524,
					"content": "——悪いと思ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130240510,
					"content": "ディシアは加減が分かってるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				}
			]
		},
		{
			"id": 1302411,
