	"talks": [
		{
			"id": 1302401,
			"completionStepIds": [
				1302401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302401",
							"2"
						],
						"stepId": 1302401,
						"stateName": "QUEST_STATE_UNFINISHED"
