			},
			"dialogs": [
				{
					"id": 130242101,
					"content": "だから——ディシアが連れてきたあの二人の女性は、「熾鬣の獅子」と並び称されるほどのスーパー傭兵だったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130242102
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130242102,
					"content": "あの三人が一緒にいると、迫力が半端ないんだぞ。あの時俺はビビってただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130242103
					],
					"speakerTitle": "ハルン"
				},
				{
					"id": 130242103,
					"content": "情けないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130242104
					],
					"speakerTitle": "ハラフ"
				},
				{
					"id": 130242104,
					"content": "だ、黙れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハルン"
				}
			]
		},
