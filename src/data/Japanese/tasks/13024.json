				"points": []
			},
			"dialogs": [
				{
					"id": 130241101,
					"content": "ど、どうしよう？二人とも一理あるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130241102,
					"content": "ディシアと一緒に行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241103
					]
				},
				{
					"id": 130241103,
					"content": "え？あんたまで巻き込まれる必要はないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241104
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241104,
					"content": "こいつはすごいんだぞ、ドニアザード。こいつとディシアが手を組めば、こんなことは「パッと」解決だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130241105,
					"content": "#うん…分かった、{M#彼}{F#彼女}がいてくれれば確かに安心できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241106,
						130241107
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130241106,
					"content": "安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130241108,
					"content": "じゃあ、私はシティであなたたちからの情報を待っているわ。どうか無事でいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241109
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 130241109,
					"content": "心配してくれてありがとな、お嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241110
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241110,
					"content": "それじゃ出発しよう。まずはキャラバン宿駅に行って「熾光の猟獣」へ——あたしの仲間たちに会いに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				},
				{
					"id": 130241107,
					"content": "で、できる限りやってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				}
			]
		},
