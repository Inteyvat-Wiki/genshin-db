			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "「今これを読んでいるあなたこそ、私が求めていた人です」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270202,
					"content": "「私たちは戦争は童話や伝説の中だけでの出来事だと思っていました。でも今、私たちは全員大御所様の怒りに怯えています」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270203,
					"content": "「私たちがよく行っていた砂浜は封鎖されました。それでも、なんとかしてこの手紙を流したのです」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270204,
					"content": "「これについて心配したり責めたりしないでください。あなたと共に冒険していた私にとって、これくらい造作もないことです」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270205,
					"content": "「あなたの返信を待っています、一言でも構いません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
