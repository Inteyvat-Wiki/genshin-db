			"dialogs": [
				{
					"id": 701270101,
					"content": "「今これを読んでいるあなたこそ、私が求めていた人です」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270102,
					"content": "「これは何通目の手紙でしょう？この手紙はどこまで流れ、どこに辿り着いたのでしょう？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270103,
					"content": "「再び会う機会があれば、もう一度岩港の山、北国の吹雪、それと蒲公英と酒の話を聞かせてください、いいでしょう？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701270104,
					"content": "「あなたの返信を待っています、昔と同じように」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
