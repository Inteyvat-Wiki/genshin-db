				]
			},
			"dialogs": [
				{
					"id": 740670401,
					"content": "おっ、また会ったな。実は自分と賭けをしてたんだ——ここに来てくれるのが、君たちか他の人かってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670402,
						740670404
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670402,
					"content": "勝ったの、負けたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670403
					]
				},
				{
					"id": 740670403,
					"content": "ははっ、勝つにせよ負けるにせよ、どっちも私さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670406,
					"content": "なんで拡声器であんなことしたんだよ？ガルヴァーヤに捕まったら、マズいんじゃないか？おまえ、あいつのことが怖いんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740670407,
					"content": "怖いだって？そんなわけないだろう。ただ捕まったら面倒ってだけさ。それに彼女はほとんど管理エリアにいる。特別な理由がない限り、生産エリアのトラブルには首を突っ込まないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670408
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670408,
					"content": "それから、どうして拡声器であんなことをしたのかというと——ここでの暮らしがあまりにも退屈だからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670409
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670409,
					"content": "今ならテイヤールの気持ちが分かるよ。彼もきっと生活があまりに退屈だったから、ああやってしょっちゅう楽しみを探してたんだろうな。言ってみれば、私は彼の真似をしてるだけに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670410
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670410,
					"content": "君たちにだって、そういう友達がいるだろう？頭の中が奇妙な考えでいっぱいで、たまにどう反応したらいいか分からない、ヘンなことをしでかす友達が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670411,
						740670412
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670411,
					"content": "確かにいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670413,
					"content": "う～ん、おまえの考えってよくわからないな。ここでの生活が退屈で、しかもそういう友達がいるんだろ？だったら、どうしてさっさとメロピデ要塞から出ていかないんだよ？もしかして、実はおまえって重罪人なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740670414,
					"content": "いや、出ていこうと思えば、いつでも出ていけるんだ。でも私は、自分の意志でここに残ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670415
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670415,
					"content": "だって、ここでの暮らしは外よりずっといいだろ？天気の心配をしなくていいし、生活も規則正しい。それに…複雑な問題だって考えずに済む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670416
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670416,
					"content": "あのラノールって娘がなんともうらやましいよ。もし私が彼女だったら、絶対にここを離れるなんて選択はしないだろうな。外の世界を知らないままでいたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670417,
						740670419
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670417,
					"content": "#それは{M#君}{F#あなた}が外の世界を知ってるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670418
					]
				},
				{
					"id": 740670418,
					"content": "まあ、それは確かにそうだな。判断するには、比較対象が必要だ。君の言う通りだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670421,
					"content": "でもここにずっといたら、友達に会えないんじゃないか？友達がこっちに来てくれない限りは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740670422,
					"content": "いや、ここにいることは別に問題にはならないんだ。問題は、もう友達はいないってことのほうなんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670423
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670423,
					"content": "はぁ、この手の話題は正直苦手なんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670424
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670424,
					"content": "まだ彼らがいた頃——私たちの研究はあまり注目されておらず、経費の申請にも苦労していた。けどそれでも、その日々を辛いと思うことはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670425
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670425,
					"content": "ただその後、予想外のことや事故が相次いで起きた…サー·ビュトールは病死。それに中央実験室は爆発してしまった。テイヤールも、その事故で亡くなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670426
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670426,
					"content": "クビになった人もいたよ…まあ、彼の話はやめておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670427
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670427,
					"content": "とにかく、どれも私じゃどうしようもないことだった…けどね、メロピデ要塞での生活は簡単なんだ。私じゃ対応できないような問題もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670428
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670428,
					"content": "あったとしても、私以外の誰かが心配してくれる、ははっ。だから、今の生活には何の不満もない。ただ…誰かと昔の話がしたいだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670429,
						740670430
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670429,
					"content": "その気持ち、分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670431,
					"content": "今日は君たちと話ができてよかったよ…ありがとう。この特別許可券をやろう。ラグ＆ボーンショップで一杯おごったとでも思ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670432
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670432,
					"content": "#乾杯、{NICKNAME}——さあ、そこの小さなレディも笑ってくれ。いい一日を過ごせるよう祈ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670430,
					"content": "#{M#君}{F#あなた}の選択を尊重するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670419,
					"content": "軽々しく他の人を評価しないほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670420
					]
				},
				{
					"id": 740670420,
					"content": "ああ、それもそうだな。私も彼女のことをよく知ってるわけじゃないし、本人がどう考えてるのかも分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740670412,
					"content": "いや、いないかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670404,
					"content": "どうして自分と賭けなんてしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670405
					]
				},
				{
					"id": 740670405,
					"content": "いい質問だ。でも答えは簡単——ここじゃ、こんな無意味な賭けに付き合ってくれる人がいないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "クランツ"
				}
			]
		}
	]
}