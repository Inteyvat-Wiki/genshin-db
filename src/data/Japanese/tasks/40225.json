			"dialogs": [
				{
					"id": 402250201,
					"content": "積み荷下ろしの指示が終わると、北斗と一緒に見本市会場へとやってきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "ここか？——いい場所だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250203,
					"content": "手が空いたら、遠距離誘導のテストを手伝ってくれ。スリル満点で楽しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
		}
