					}
				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "この船って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250102,
					"content": "死兆星号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "こいつは船隊の第二艦さ。死兆星号は孤雲閣で巡回中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250104,
					"content": "北斗！ああ…確かに「遠洋を縦横無尽に駆ける傭兵の親玉」だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250105,
					"content": "ハハッ、初対面じゃあるまいし、仰々しい呼び方はやめてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250106,
					"content": "その、これには訳があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250107,
					"content": "突っ立ってないで、座って話そう。今お茶を持ってこさせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250108,
					"content": "そうだったのか。あの秘聞の館の主人とも付き合いがあるなんてな。テイワット中を巡ってるだけあって、大した人脈だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250109,
					"content": "へへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250110,
					"content": "そうだ、登録のことなんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "あっ！忘れるところだったぞ。出展情報を登録しなきゃいけないんだ。出展者と、どんなものを取引するつもりかも教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250112,
					"content": "出展者は、アタシと店番するやつらが何人かだな。他の連中は船に残る。取引に出すものは…こいつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250113,
					"content": "これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250114,
					"content": "ずっと前から、凝光は帰終機の改良に着手してたんだ。この第二艦にも、あいつが改良した型の一つが装備されてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250115,
					"content": "この型の帰終機は、遠距離誘導を通じて目標を正確に攻撃できる。威力も半端ないし、この見本市では引っ張りだこになること間違いなしだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250116,
					"content": "こんな物、売ってもいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250117,
					"content": "ハハッ、心配無用さ。千岩軍の最新型は、これよりずっと改良されてる。こいつはもう型落ち品なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250118,
					"content": "…まぁ、ネフェルが言ってた通り、ここの取引は「何でもあり」らしいし、いいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250119,
					"content": "でも、こんなもの誰が買うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "心配いらないわ。ナド・クライ見本市にはテイワット各地から買い手が集まるもの。きっと大口客が釣れるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250121,
					"content": "夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250122,
					"content": "悪い悪い、荷降ろしに気をとられて、こいつも船に乗ってるって言い忘れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250123,
					"content": "あれ？夜蘭も出展するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250124,
					"content": "調査でナド・クライに来る必要があって、乗せてもらっただけだから、登録はいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250125,
					"content": "久しぶりね、旅人。秘聞の館の主人によろしく伝えておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250126,
					"content": "今回は何をしに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "仕事よ。詳しくは話せないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250128,
					"content": "このカオ、「これ以上聞くな」ってことか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402250129,
					"content": "だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "それじゃあ、私はお先に。用事が済んだら、みんなに一杯奢ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402250131,
					"content": "ははっ、その時はナド・クライの味をじっくり楽しませてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 402250132,
					"content": "登録できたぜ。会場まで案内するから、ついてきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
