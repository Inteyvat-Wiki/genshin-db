				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10020501,
					"content": "さて、本題に戻ろう——旅人よ、来訪の理由を述べよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020502,
					"content": "実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10020503,
					"content": "言語道断…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020504,
					"content": "実に嘆かわしいッ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020505,
					"content": "璃月七星…失望したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020506,
					"content": "「迎仙儀式」の途中で帝君が暗殺された上に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020507,
					"content": "帝君が暗殺された後…儀式を見に来ていた一般人に容疑を被せたと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020509,
					"content": "旅人よ、汝が濡れ衣を着せられていることは理解した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020510,
					"content": "我に一つ案がある。しかし、我の独断では危うい、仙人たちに知らせる必要があるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020511,
					"content": "その「禁忌滅却の札」を持って、我の言葉を伝えに行くとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020512,
					"content": "誰に伝えればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "どこに行けばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "理水畳山真君、留雲借風真君、この二人はここにおるが、会えるかどうかは縁次第だ——流れに身を任せるとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020515,
					"content": "それともう一人、降魔大聖の護法夜叉がおる。彼の者には「望舒旅館」に行けば会えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "削月築陽真君"
				}
			]
		}
	]
