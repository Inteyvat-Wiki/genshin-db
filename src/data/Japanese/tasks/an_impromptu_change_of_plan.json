			"dialogs": [
				{
					"id": 10020201,
					"content": "何者だ？なぜ勝手に「絶雲の間」に入った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020202,
					"content": "ある人に頼まれて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "これを見てほしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "「禁忌滅却の札」…これは久しぶりに見たな。俗世の人の手にまだ残っておったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020205,
					"content": "我は三眼五顕仙人、削月築陽真君だ。旅人よ、なぜこの地を訪れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020206,
					"content": "実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10020207,
					"content": "犯人がいたぞ！こんなところまで逃げていたとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "千岩軍隊長"
				},
				{
					"id": 10020208,
					"content": "隊長、これ以上「絶雲の間」には入れませんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "千岩軍兵士"
				},
				{
					"id": 10020209,
					"content": "し、仕方ないだろ、犯人を捕らえるのが最優先だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "千岩軍隊長"
				},
				{
					"id": 10020210,
					"content": "…騒々しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020211,
					"content": "彼らを送り返せ。だが殺生をしてはならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "削月築陽真君"
				}
			]
		},
		{
