			"dialogs": [
				{
					"id": 40190401,
					"content": "ん？君たち…どうして戻ってきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "クスト"
				},
				{
					"id": 40190402,
					"content": "クスト！ラヴェリューヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190403,
					"content": "おいおい、まさかまた捕まったわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "ラヴェリューヌ"
				},
				{
					"id": 40190404,
					"content": "えっ？そういうわけじゃないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190405,
					"content": "くそ！あの騒ぎに乗じて逃げたかと思ったのに。数少ない脱獄者の一人かと思ってたが、まさか…そもそも逃げてなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "クスト"
				},
				{
					"id": 40190406,
					"content": "あはは…悪いな、オイラたちちょっと用事があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190407,
					"content": "まあまあ、そんなことより無事で何よりだ。こいつな、ずっと二人のことを心配してたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "ラヴェリューヌ"
				},
				{
					"id": 40190408,
					"content": "僕だけじゃないだろ？君だって、同じだったじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "クスト"
				},
				{
					"id": 40190409,
					"content": "ははっ、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "ラヴェリューヌ"
				},
				{
					"id": 40190410,
					"content": "ここ数日、厨房の手伝いを俺もしてるんだ。さっきクストと一緒に働いてた時、こいつニンジン相手にぶつぶつ言っててな。「あの二人、大丈夫なのか？まだ生きてるよな？」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "ラヴェリューヌ"
				},
				{
					"id": 40190411,
					"content": "そういう時は、いつも「大丈夫だ。きっとどこかで何か飲みながら、景色でも堪能してるに違いない。」って返事してやってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "ラヴェリューヌ"
				},
				{
					"id": 40190412,
					"content": "ふん！同じ監獄で過ごしてるんだ…気にかけてやるのは別に普通のことだろ？それにこいつら、僕の話を聞くのが大好きだったしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "クスト"
				},
				{
					"id": 40190413,
					"content": "この二人…思ったよりずっと親切で面倒見がいいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190414,
					"content": "最近のサービス食もきっと美味しいはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "…へへっ、二人とも、今度たらふく食いに来てくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クスト"
				},
				{
					"id": 40190415,
					"content": "二人のおかげで食堂ももっと良くなるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
