			"dialogs": [
				{
					"id": 40190601,
					"content": "またこの牢屋に戻って来たな。でも、オイラたちはもう囚人じゃないし、気分もちょっと違ってくるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190602,
					"content": "なんだか胸を張れるような気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "そうだな。でも実際のところ、オイラたちってそもそも悪いことしてないし、いつだって胸を張っていいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190604,
					"content": "再び自由を手に入れた気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "おう！自由な感じって、本当に特別だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190606,
					"content": "パイモンも何か言いたいんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "えっ？なんでわかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "パイモン"
				},
				{
