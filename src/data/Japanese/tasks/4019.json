			"dialogs": [
				{
					"id": 40190501,
					"content": "ジュリエ！看護師長から聞いたけど、お昼ご飯を食べてないんですって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40190502,
					"content": "ん？ああ、仕事が忙しくてうっかり忘れてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40190503,
					"content": "もう、いくら忙しいからって…あれ？あなたたち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40190504,
					"content": "ジュリエ、ルールヴィ、無事だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190505,
					"content": "ああ、ここ最近はかなりバタバタしてるけどね。君たちは大丈夫だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40190506,
					"content": "#ありがとう、{M#俺}{F#私}たちも大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "おまえたちは？まだ医務室の秘密通路の先にある、あの巨大な船の研究をしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190508,
					"content": "ええ。でも、この秘密を知っているのは私たちだけですから、絶対に他言無用ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40190509,
					"content": "医務室が混んでる時はとても面倒だが…まあ、それでも公爵の執務室を通るよりマシさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40190510,
					"content": "あなたがよく医務室でサボっているのも事実ですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "ルールヴィ"
				},
				{
					"id": 40190511,
					"content": "君だって、しょっちゅういるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "ジュリエ"
				},
				{
					"id": 40190512,
					"content": "おまえたち船作りなんか口実で、本当は一緒にいたいだけなんじゃないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190513,
					"content": "ありえない！（ありえません！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリエ"
				}
			]
