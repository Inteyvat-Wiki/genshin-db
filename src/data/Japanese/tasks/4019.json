			"dialogs": [
				{
					"id": 40190101,
					"content": "看護師長～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190102,
					"content": "旅人、パイモンちゃん、戻ったのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190103,
					"content": "大丈夫？ケガしてない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190104,
					"content": "安心して、大丈夫だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "おう、ピンピンしてるぞ！おまえたちは？あれだけ大騒ぎだったんだから、どこもかしこもメチャクチャになってるだろ？大きな問題はなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190106,
					"content": "ケガをした人が少しいるけど、全体的に見ると大したことはないのよ。ヌヴィレットさんがここに来てくれたおかげね。一時的にだけど、危機を抑えることができたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190107,
					"content": "キミたちも、助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190108,
					"content": "でもヌヴィレットのやつ、なんで自分の力が必要だってわかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190109,
					"content": "ヌヴィレットさんは水元素と強く共鳴できるから。増水した海から巨大な波紋を感じ取ったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190110,
					"content": "囚人たちの手当てをしてた時、あのボム·ブラザーズから聞いたんだけど、危険も顧みずに下層部へ走って行ったんだって？こうしてキミたちが無事なのを確認できて、ようやく一安心できそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190111,
					"content": "もし急いでなかったら、ここに泊まっていってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190112,
					"content": "何か食べたいものがあれば、いつでもウチに言ってね。ウォルジーさんに用意するよう頼んであげる。それと疲れてたら、医務室を使って自由に休んでくれていいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 40190113,
					"content": "ちょうどウチもキミたちの顔の筋肉をもっと観察したかったの。キミたちの楽しそうな笑顔ってとても魅力的で、すごく素敵なのよ。ウチ、それをもっと見ていたくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				}
			]
		},
