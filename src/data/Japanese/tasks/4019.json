			"dialogs": [
				{
					"id": 40190301,
					"content": "シャバに出た囚人がまた戻って来るとはな？どういう風の吹き回しだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190302,
					"content": "メロピデ要塞の状況を確認しに来たんだ！大丈夫そうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190303,
					"content": "大した問題はない。ヌヴィレットさんが厄介な問題をいくつか解決してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190304,
					"content": "そんなにすごいんなら、あいつにここに残ってもらうよう説得すればよかったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190305,
					"content": "ほう、そいつはナイスアイディアだな。一つの水溜まりのために法廷全体を捨てるよう、最高審判官を一緒に説得しようじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190306,
					"content": "それはさすがに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "慌ただしく降りてきた挙げ句、お茶を一口も飲まずに帰っていった。まあ、看護師長からのプレゼントだけは受け取ったみたいだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190308,
					"content": "本当に忙しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190309,
					"content": "それとクロリンデさんも帰った。同様に看護師長のプレゼントを持ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190310,
					"content": "プレゼントってミルクセーキか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190311,
					"content": "ヌヴィレットさんのはそうだ。クロリンデさんに渡してたのはリップクリームだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190312,
					"content": "えっ？ずいぶん違うんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190313,
					"content": "クロリンデさんはヌヴィレットさんほど忙しくない上に、健康を維持できてるのが理由だろう。それに、看護師長はレディに美容品をプレゼントするのが好きだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190314,
					"content": "そうだ、あんたらへのプレゼントもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190315,
					"content": "看護師長からか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190316,
					"content": "いや、俺からだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190317,
					"content": "メロピデ要塞での仕事を終えたからには、いつでも水の上に戻れる。だが、あんたらが使ってたあの牢屋は、刑期が終わるまで好きに使ってくれて構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190318,
					"content": "本当にいいのか？じゃあ、まだまだ住んでもいいってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190319,
					"content": "食事は付く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "ああ、あんたらには食堂を無料で開放しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 40190321,
					"content": "へへっ、やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190322,
					"content": "刑期が終わる日になったら、俺のところまで手続きしに来るのを忘れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				}
			]
		},
