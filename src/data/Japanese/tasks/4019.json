			"dialogs": [
				{
					"id": 40190201,
					"content": "さっ、このカードのマークを当ててみて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190202,
					"content": "えっと…威張る猫かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190203,
					"content": "あっ、二人とも来てくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190204,
					"content": "旅人、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190205,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190206,
					"content": "おう、フレミネもだいぶ良くなったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190207,
					"content": "うん、みんなのおかげで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190208,
					"content": "その！ぼ…ぼく、勇気を出してクロリンデさんにお礼を言ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190209,
					"content": "おお！あいつ、どんな反応してた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190210,
					"content": "その、大丈夫って言われた…人を助けるのをあんまり大したことだと思ってないみたい。何か恩返しをしようとも思ったけど、お返しはいらないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190211,
					"content": "フレミネに余計な気を使わせたくないんだと思う。そんなに気にする必要はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190212,
					"content": "そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190213,
					"content": "そうだ！オイラたち歌劇場に行ったんだけど、そこで「召使」に会ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190214,
					"content": "「お父様」に？何か言われた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190215,
					"content": "意味深なことを言われたな…いずれ共に手を組む日が来るはずだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190216,
					"content": "ちょっと意外だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "「お父様」の君たちに対する態度は、僕たちが予想してたものよりも友好的だったみたいだね…よかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190218,
					"content": "旅人、「お父様」を信じてほしい。「お父様」には「お父様」なりの責務がある。必要な時が訪れれば、惜しみなく力を貸してくれるから。その中には、もちろん君も含まれてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190219,
					"content": "うん、「お父様」はとてもすごいお方だから、信頼して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190220,
					"content": "あっ、そういえば、「召使」がリネのことを強がりだって言ってたぞ。「他の者に頼ることをもっと学んでほしい」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190221,
					"content": "あはは…その通りだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190222,
					"content": "うん、「お父様」が言いそうなこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 40190223,
					"content": "ちょっと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 40190224,
					"content": "しばらく、ここに残るの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190225,
					"content": "たぶん、そうなると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190226,
					"content": "よかった。一緒にお茶会ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190227,
					"content": "おっ、いいな！じゃあオイラ、ケーキをもっと食べたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 40190228,
					"content": "「もっと」ってことは、上でも美味しいケーキを食べてきたんだ。そう、良かったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 40190229,
					"content": "次は私たちと一緒に、お茶を味わいながらデザートを食べましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネット"
				}
			]
		},
