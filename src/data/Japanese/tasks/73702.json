				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "前に会った時と比べたら、ずいぶん顔が明るくなったみたいネ。訓練は順調？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020102,
					"content": "はい。今回の振り返りを経て、いくつかの気づきを得ることができマシタ。今なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020103,
					"content": "花霊の勇者の称号にふさわしい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020104,
					"content": "い…いいえ、まだ最後の訓練が残っていマス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020105,
					"content": "全ての任務を完遂した上で、先輩に認められて初めて「二本角の花冠」を有する資格があるのだと思いマス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020106,
					"content": "あらあら、反抗期を卒業したっていうのは、本当だったのネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020107,
					"content": "せ、先輩、どうしてそんなことをまだ覚えていらっしゃるんデスか。早く忘れてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020108,
					"content": "ふふっ、何はともあれ、元気を取り戻してくれたようで何よりだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}とパイモン、ソルシュに「二本角の花冠」がふさわしいかどうか、二人には最後まで見届けていただけるかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020110,
					"content": "私は最終地点で待っているワ。では後程ネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "トゥニギの黒淵…ここが災厄の中心ネ。全てが止まっちゃってるケド…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020602,
					"content": "当時の状況が想像に難くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "周りにある巨大な結晶…ウェネトの何倍も大きいぞ！その難題解決の大任を、これからソルシュが担うことになるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020604,
					"content": "それがまさに、花霊の勇者として担うべき責任なんじゃない？ソルシュ自身もそれを望んでいるでショウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020605,
					"content": "そうは言っても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020606,
					"content": "私が頼りにならないって言うノ？フン、この期に及んで、まだ白フラにバカにされてるなんテ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020607,
					"content": "わー、あの威張りまくりのソルシュが復活したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020608,
					"content": "いいのやら悪いのやら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "はぁ…この頃ずっとこうやって一緒に過ごしてきたのに、まだ完全には信頼してもらえてなかったのかしら？さっきのは根拠のナイ自信じゃないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020610,
					"content": "コホン、念のため言っておくケド、過去の自分は間違ってたって分かってるからネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020611,
					"content": "過去の私は行動よりも名声のほうが重要だと思っていた。でも、それじゃ本末転倒だって、今ならわかるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020612,
					"content": "「シームルグ」が自らの犠牲によって神鳥となったように、私も自身の行動によって花霊の勇者として認められて、人々に賞賛されたいノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020613,
					"content": "それに、先輩ご指定の訓練を全部クリアしたんだカラ、私が勇者の称号にも、「二本角の花冠」にもふさわしいってコトは、先輩だって認めないわけにはいかないデショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020614,
					"content": "霊光の決定に、もちろん異議はないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020615,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020616,
					"content": "あら、私に異議を唱えてほしかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020617,
					"content": "い…いえ…すんなりと先輩に認めていただけるとは、思っていなかったものですカラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020618,
					"content": "ちょっとぐらい意地悪を言うと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "おやまあ、私はそんな意地悪な長老じゃないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020620,
					"content": "あ、そうだ。勇者の責務については…まだ花冠から関連知識を得られていマセン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020621,
					"content": "私がまだ勇者として未熟だからでしょうカ？もしかして、ほかの訓練を受ける必要が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020622,
					"content": "そうネェ…確かに勇者の称号は花霊の伝統の一部だけれど、その責務は時代とともに変わるものヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020623,
					"content": "ハイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020624,
					"content": "簡潔に言えばネ、具体的に何をすべきか、どんな基準で合否が判断されるのか、決まった規則はないの。通常、霊光の決定が最終的な判断になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020625,
					"content": "えっ？ということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020626,
					"content": "私が「二本角の花冠」を没収するなんてコトはないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020627,
					"content": "頭頂部が寒くなるのを心配せずにすむね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "ポイントが違うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020633,
					"content": "分かったワ！これもテストのうちなのネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020634,
					"content": "ソルシュ、何が分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020635,
					"content": "白フラってば、ほんっと忘れっぽいんだカラ。さっきも言ったじゃない！この訓練の目的は行動力や洞察力を鍛えるためだけじゃナイ——過去の自分の間違いを認識するコトも大事だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020636,
					"content": "どうせ結果が変わらないカラと言って、訓練を軽んじたら、二の舞を演じるコトになるじゃナイ？だからきっと、これは先輩からの最後のテストなんだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020637,
					"content": "名実伴った花霊の勇者にとっては、なんてコトない。だってこれは先輩から信頼されてるって証だもノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020638,
					"content": "ソルシュに見抜かれてしまうとはネ。霊光に選ばれた花霊だけのことはあるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020639,
					"content": "#ソルシュが変わったのは…{NICKNAME}とパイモンのお陰かしらネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020640,
					"content": "ハイ！我が「謁賛主」とその仲間の白フラは、確かに有能な人材デス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020641,
					"content": "#私だけでも余裕、と申し上げたいところデスが…{M#彼ら}{F#彼女たち}の協力があれば、「焚真の天象」を消すコトだって大した問題ではナイでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020642,
					"content": "それは頼もしいワ。ミヒルとラシュヌも力になってくれることを忘れずにネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020643,
					"content": "先輩、安心して私にお任せください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020644,
					"content": "全部ズルヴァーンの計画通り、って感じがするけど…まあ、ソルシュが元気になったならそれでいいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020629,
					"content": "しないのかな、それともできないのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "霊光の選択が最終決定だって、ズルヴァーンも言ってたもんな。たとえズルヴァーンでもその決定を簡単には変えられないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020631,
					"content": "ふふ…どうかしらネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020632,
					"content": "うぅ…ちょっと怖くなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7370207,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ",
					"ズルヴァーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "かつてのトゥニギの黒淵…過去の災厄の中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020702,
					"content": "まさかソルシュが本当に「焚真の天象」を消せるなんて…これで見事、問題解決だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020703,
					"content": "「焚真の天象」を消すコトも花霊の勇者の責務のうちだワ。ソルシュはやるべきことをしたまでヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020704,
					"content": "ミヒルとラシュヌの協力のお陰だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "おう！オイラたちも大いに貢献したけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020706,
					"content": "あら、我が「謁賛主」に白フラ、この主役を忘れてもらっては困るわヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020707,
					"content": "わー、あの威張りまくりのソルシュが復活したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020708,
					"content": "はぁ…この頃ずっとこうやって一緒に過ごしてきたのに、まだ完全には信頼してもらえてなかったのかしら？さっきのは根拠のナイ自信じゃないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020709,
					"content": "コホン、念のため言っておくケド、過去の自分は間違ってたって分かってるからネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020710,
					"content": "過去の私は行動よりも名声のほうが重要だと思っていた。でも、それじゃ本末転倒だって、今ならわかるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020711,
					"content": "「シームルグ」が自らの犠牲によって神鳥となったように、私も自身の行動によって花霊の勇者として認められて、人々に賞賛されたいノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020712,
					"content": "それに、先輩ご指定の訓練を全部クリアしたんだカラ、私が勇者の称号にも、「二本角の花冠」にもふさわしいってコトは、先輩だって認めないわけにはいかないデショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020713,
					"content": "霊光の決定に、もちろん異議はないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020714,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020715,
					"content": "あら、私に異議を唱えてほしかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020716,
					"content": "い…いえ…すんなりと先輩に認めていただけるとは、思っていなかったものですカラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020717,
					"content": "ちょっとぐらい意地悪を言うと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "おやまあ、私はそんな意地悪な長老じゃないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020719,
					"content": "あ、そうだ。勇者の責務については…まだ花冠から関連知識を得られていマセン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020720,
					"content": "私がまだ勇者として未熟だからでしょうカ？もしかして、ほかの訓練を受ける必要が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020721,
					"content": "そうネェ…確かに勇者の称号は花霊の伝統の一部だけれど、その責務は時代とともに変わるものヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020722,
					"content": "ハイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020723,
					"content": "簡潔に言えばネ、具体的に何をすべきか、どんな基準で合否が判断されるのか、決まった規則はないの。通常、霊光の決定が最終的な判断になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020724,
					"content": "えっ？ということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020725,
					"content": "私が「二本角の花冠」を没収するなんてコトはないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020726,
					"content": "頭頂部が寒くなるのを心配せずにすむね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "ポイントが違うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020732,
					"content": "分かったワ！これもテストのうちなのネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020733,
					"content": "ソルシュ、何が分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020734,
					"content": "白フラってば、ほんっと忘れっぽいんだカラ。さっきも言ったじゃない！この訓練の目的は行動力や洞察力を鍛えるためだけじゃナイ——過去の自分の間違いを認識するコトも大事だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020735,
					"content": "どうせ結果が変わらないカラと言って、訓練を軽んじたら、二の舞を演じるコトになるじゃナイ？だからきっと、これは先輩からの最後のテストなんだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020736,
					"content": "名実伴った花霊の勇者にとっては、なんてコトない。だってこれは先輩から信頼されてるって証だもノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020737,
					"content": "ソルシュに見抜かれてしまうとはネ。霊光に選ばれた花霊だけのことはあるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020738,
					"content": "#ソルシュが変わったのは…{NICKNAME}とパイモンのお陰かしらネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020739,
					"content": "ハイ！我が「謁賛主」とその仲間の白フラは、確かに有能な人材デス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020740,
					"content": "#私だけでも余裕、と申し上げたいところですが…{M#彼ら}{F#彼女たち}の協力があれば、「焚真の天象」を消すことだって大した問題ではないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020741,
					"content": "この短期間でソルシュがこれほど大きく変わるなんてネ…本当に頼もしくなったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020742,
					"content": "ハイ！勇者の責務範囲内のコトなら、何でもお任せください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 737020743,
					"content": "全部ズルヴァーンの計画通り、って感じがするけど…まあ、ソルシュが元気になったならそれでいいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020728,
					"content": "しないのかな、それともできないのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "霊光の選択が最終決定だって、ズルヴァーンも言ってたもんな。たとえズルヴァーンでもその決定を簡単には変えられないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737020730,
					"content": "ふふ…どうかしらネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 737020731,
					"content": "うぅ…ちょっと怖くなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}