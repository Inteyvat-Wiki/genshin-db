	"talks": [
		{
			"id": 7370201,
			"completionStepIds": [
				7370201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370201",
							"2"
						],
						"stepId": 7370201,
						"stateName": "QUEST_STATE_UNFINISHED"
