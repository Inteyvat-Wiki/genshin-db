							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_LESS",
						"rawParams": [
							"73100",
							"33"
						]
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"4"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#アランミナリ聞いたよ。ナラ{NICKNAME}がヴァーナで「腕を披露」したって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000302,
					"content": "#「お宝」はもう「箱」に入れたの。ナラ{NICKNAME}は「宝箱」を開けていいよ。「遠慮はいらない」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#ナラ{NICKNAME}もパイモンも、遅ーい！アランミナリの「宝箱」は、とっくに準備ができてたよ。アランミナリ、一緒に長く長く待ってたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000402,
					"content": "アランナラの友達、「宝箱」はもうギュウギュウだから、開けていいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#たくさんのアランナラがアランミナリに教えてくれたよ、ナラ{NICKNAME}とパイモン、いい事いっぱいしたってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000502,
					"content": "アランミナリはとっくに知ってたよ。その褒め言葉たちが、森の枝を越えて、静かに流れる川を渡って、そよ風と一緒に、アランミナリの「ハッピーな我が家」に届いたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000503,
					"content": "#だから、アランミナリは今回も「箱」をギュウギュウにして、ナラ{NICKNAME}が開けるのを待ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000504,
					"content": "#アランニムバからキラキラも届いたから、アランミナリ、「箱」に入れたの。ナラ{NICKNAME}、気に入るかなあ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000505,
					"content": "アランニムバは戻ってきてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "うん、アランニムバは根の深い大樹と違って、止まらないアランナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000507,
					"content": "えっ…じゃあ、アランミナリはずっと独りでここにいたのかよ。寂しいって思わないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731000508,
					"content": "「寂しい」ってどういう意味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000509,
					"content": "えっと…その、独りぼっちの時、仲間が恋しいって感じ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731000510,
					"content": "ヴァナラーナにはいっぱいアランナラがいるから、アランミナリは全然「寂しい」じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000511,
					"content": "でも、アランヤマとアランニムバは、ヴァナラーナから離れちゃった。昔、三つのアランナラは一緒にいて、何をやっても楽しかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000512,
					"content": "アランヤマのアランラカラリは強くて、弱いナラじゃ破れないほどだったの。アランニムバはお絵描き上手で、いろんなものを描いて、綺麗だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000513,
					"content": "でも今は、アランミナリとアランミナリの「宝箱」しかいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000514,
					"content": "アランミナリ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731000515,
					"content": "平気なの。アランミナリにはたくさんの「宝箱」があるから。ナラがどうして、箱を開けるのが好きなのかは、わからないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000516,
					"content": "でもアランミナリは「宝箱」のオーナーだから、「宝箱」が好きなナラたち、アランミナリのことも好きになってくれるよね、そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000517,
					"content": "でも、アランミナリはこれ以上「お宝」を持ってないの。うぅ…「箱」はしばらく、腹ペコ生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000518,
					"content": "#アランミナリの「宝箱」は空っぽになるけど、ナラ{NICKNAME}はこれからもアランナラの友達でいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
