					"アランミナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#アランミナリお腹いっぱい、「宝箱」お腹ペコペコ。ペコペコ、よくないの。ナラ{NICKNAME}とパイモンはいっぱい歩くから、ペコペコ。だからキノコをたくさん食べて、元気になるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
