			"dialogs": [
				{
					"id": 731000601,
					"content": "#アランミナリ、まだ準備できてないの！「宝箱」もまだお腹いっぱいじゃないから、ナラ{NICKNAME}とパイモンは、「のらりくらり」してていいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000602,
					"content": "うぅ、違う、「ぶらつく」だった。そしたら、助けが必要なアランナラに出会うかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
			"id": 7310007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
