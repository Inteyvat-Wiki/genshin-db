			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#ナラ{NICKNAME}は「宝箱」を開けたい？でも…ヴァーナにはまだ、助けを必要としてるアランナラがいっぱい。金色のナラがアランナラを助けてくれたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 731000102,
					"content": "アランミナリはギュウギュウに詰まった「宝箱」、用意する！アランニムバから送られてきた「お宝」も一緒に、「箱」いっぱいになるまで食べさせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#金色のナラは、アランナラを助けたいいナラって、アランミナリは知ってるの。だから、アランミナリの「宝箱」は、ナラ{NICKNAME}にあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランミナリ"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
