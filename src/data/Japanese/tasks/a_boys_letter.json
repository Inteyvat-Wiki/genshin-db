			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドゥラフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "はあ、あの子はどうしてるのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "ん？ああ、ちょうどよかった、前回の手紙を覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020104,
					"content": "時間があったら、この手紙をシスターグレイスに届けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020105,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020107,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "あんな事故があったから、もうハトを使えないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020109,
					"content": "それに俺が自分で手紙を届けにモンドに行ったら、きっとあの子に会ってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020110,
					"content": "はあ…これ以上は聞かないでくれ、この手紙は頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドゥラフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "ん？まだ行かないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020202,
					"content": "手紙について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "…昔の話しか書いてないよ。お前は読んでないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020204,
					"content": "読んでないなら読まなくていい、くだらないことばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020205,
					"content": "あの子って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "そんなことを気にしてどうするんだ。橋でハトに餌を与えてる子供、覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020207,
					"content": "彼、ティミーだ。…ある原因で、今は会いづらいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020208,
					"content": "これで満足か？早く手紙を届けに行ってくれ、でないとシスターグレイスがまた変なことを考えてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "おかしいわ、手紙が届いてないなんて、まさか何か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020302,
					"content": "ドゥラフからの手紙を届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "ん？どうしてあなたが？いつもならハトが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020304,
					"content": "ハトが事故？清泉町ってば本当に…毎日「事故」だらけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020305,
					"content": "届けてくれてありがとう。今お礼を用意するから、少し待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020306,
					"content": "手紙について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "読んだのかしら？平気よ、大した秘密じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020308,
					"content": "ドゥラフさんの言葉を借りると、それは「昔の話」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020309,
					"content": "ただ、そういう「昔の話」はいつまでも忘れられないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020310,
					"content": "この「昔の話」って一体…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "聞きたいの？まあ、あなたは信頼できるし…でも、内緒にしてくれるって約束してもらわないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020312,
					"content": "約束する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "…ティミーの父親は、ドゥラフさんの親友だった。彼らは一緒に狩りに行って、お酒を飲んで、一緒に冒険してたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020317,
					"content": "騎士団の警告を受けた回数も、シスターヴィクトリアに忠告された回数も数知らず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020318,
					"content": "ティミーが生まれて、彼の父親はやっと大人しくなった。「父親は息子の見本だから」って言って、お酒をやめて、真面目に仕事するようになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020319,
					"content": "それで、ティミーが悪いことを覚えてしまうって言って、ドゥラフさんにもお酒をやめるように説得していたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020320,
					"content": "本当に我慢できない時、彼らは代わりにアップルサイダーを一気飲みしてた、私もたまに一緒に飲んでたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020321,
					"content": "でも、ある日の狩りで、ティミーの父親はひどい怪我を負ったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020322,
					"content": "すぐに大聖堂に運ばれて、私たちも全力で治療したけど…残念なことに、彼は亡くなったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020323,
					"content": "その後、ドゥラフさんはティミーを私に託して、清泉町に戻って狩人の仕事を再開した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020324,
					"content": "彼は毎月手紙とお金を送ってくるけど、どうしてもティミーに会おうとしないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020325,
					"content": "でも、最近になって真実をティミーに教えたいって言うようになった。はあ、彼に一体何があったのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020326,
					"content": "ティミーに真実を教えたくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "ええ、ティミーには教えたくないわ、まだ子供だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020328,
					"content": "ティミー自身は自分はもう大人だって言って、ノーラやグローリーの世話も手伝ってくれるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020329,
					"content": "でも…こういう残酷な真実、あの子が受け入れられるわけがないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020330,
					"content": "あの子が十分大人になるまで、真実を受け入れられるようになるまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020331,
					"content": "騙し騙しでも、あの子には幸せな子供時代を過ごしてもらいたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020341,
					"content": "でもティミーも成長してるわ。考えてること、聞いてくる質問もどんどん多くなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020342,
					"content": "あの子の相手をするのがどんどん難しくなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020343,
					"content": "ノーラに言われたわ、ティミーが彼女を連れて、一緒に父親へのプレゼントと手紙を用意するってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020344,
					"content": "しかし最近、ティミーは塞ぎこんでるようで、ボーっとしてることも多くなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020345,
					"content": "もし時間があったら、ティミーの状況を見てきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020346,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "では、お願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020348,
					"content": "どうして自分で見に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "恥ずかしい話…絶対にティミーに真実を教えないって言ったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020350,
					"content": "あの子が父親に手紙を書くって言う度に、気が弱くなるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020351,
					"content": "いつか我慢できなくなって、真実を全部教えてしまうんじゃないかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020352,
					"content": "…でもそんなことは絶対に許されない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020353,
					"content": "だから、代わりにティミーに会ってきてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020332,
					"content": "一生誤魔化せるわけがない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "…ええ、分かってるわ。でもティミーはまだ子供よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020334,
					"content": "私は…ティミーには幸せな子供時代を過ごしてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020335,
					"content": "そうしたら、今後彼がどんな苦しい思いをしたとしても、少なくとも美しい思い出はその慰めになってくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020336,
					"content": "真実を知って何がいけない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "ふう…あなたがそう考えるのは普通よね、だってあなたはいろいろ経験して、十分勇敢で、強いから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020338,
					"content": "しかし、あなたがこれほど強くなるまで、苦しい思いもたくさんしたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020339,
					"content": "ティミーはまだ幼いわ。私のわがままだけど、あの子には知ってほしくないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020340,
					"content": "…いい思い出になる幸せな子供時代を与えたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020313,
					"content": "善処する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "はあ、あなたったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 201020315,
					"content": "…でも、あなたの品格を信じるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "グレイス"
				}
			]
		},
