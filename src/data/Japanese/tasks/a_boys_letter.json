			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "…何も帰ってこない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020402,
					"content": "ハトの餌やり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "今日はもうしたよ。そしてまたお前になんかされる前に、ハトたちには飛んで行ってもらったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020404,
					"content": "今は手紙を書いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020407,
					"content": "グレイスママが言ってた、パパに時間があったら、ハトを使って手紙を送ってくれるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020408,
					"content": "でも一度も手紙をもらったことがない…パパの仕事が忙しすぎるからかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020409,
					"content": "だから、パパが忙しくて手紙を書けないなら、ボクが書けばいいって思ったんだ。ついでにプレゼントも入れて…でも、どんなプレゼントがいいんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020410,
					"content": "そうだ、<color=#00E1FFFF>蒲公英</color>にしよう。モンドの人ならみんな蒲公英が好きだってグレイスママが言ってたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020411,
					"content": "時間があったら、<color=#00E1FFFF>蒲公英</color>を探してきてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020412,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "やった！ありがとう…お前もたまには優しいんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020414,
					"content": "他のものにしないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "そうしたいけど、重すぎると、ハトが飛べなくなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020416,
					"content": "それにパパは遠い場所で働いてるから、ハトも長い時間飛ぶだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020405,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "パパに手紙を書いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "ティミー"
				}
			]
		},
