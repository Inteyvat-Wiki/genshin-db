					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020602,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "よかった、これでいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020604,
					"content": "蒲公英の種を手紙に入れて…閉めて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020605,
					"content": "これでよし！へへっ、パパが手紙をもらったらきっと喜ぶと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020606,
					"content": "でも…手紙を届けるハトじゃないと届けられないって聞いた…それに、パパの住所も知らないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020607,
					"content": "そうだ！清泉町のドゥラフさんは手紙を届けられるハトを飼ってるってグレイスママが言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020608,
					"content": "ドゥラフさんはパパのことも知ってるみたいだし、きっとこの手紙の送り方も知ってるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020609,
					"content": "えっと…ボクの代わりにこの手紙をドゥラフさんに渡してくれないかな？パパへの手紙を送りたいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 201020610,
					"content": "あと、中身は見ないでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				}
			]
		},
