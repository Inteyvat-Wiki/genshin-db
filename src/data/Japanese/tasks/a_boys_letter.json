					"nextDialogs": [
						201020707
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020707,
					"content": "仕方ない、俺が保管しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020717,
					"content": "さあ、手紙は俺が保管する…もう出したということにしておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020718,
					"content": "きっと親友も理解してくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020719,
					"content": "ありがとう。どうかこのことはティミーに内緒にしてほしい。お前ならきっとできる、そうだろ？少なくとも…このお礼に免じて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020708,
					"content": "燃やそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "ハハハッ、お前は冒険者らしくなったな、効率的だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020710,
					"content": "だが、俺は冒険者じゃない、普通の狩人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020711,
					"content": "手紙は燃やさない、開けることもない。きちんと保管するさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020712,
					"content": "代わりに保管するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "お前が？まさか、俺の親友はまだ死んでないって思ってるわけじゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020714,
					"content": "…まあ、お前がいろんな場所を回り続ければ、いつか彼と会うかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020715,
					"content": "かつての俺もそう思って、行動したんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 201020716,
					"content": "最終的に現実を認めたよ。俺の親友はもういないって現実をな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "ドゥラフ"
				}
			]
