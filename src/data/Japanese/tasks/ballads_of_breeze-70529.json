			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リジー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "こんにちは！風花祭へようこそ。ちょうどいいところに来たね。ここでは「そよ風のバラッド」っていうミニゲームを開催してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290202,
					"content": "このゲームでは、あなたはモンド城の吟遊詩人のように美しい曲を演奏できるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290203,
					"content": "吟遊詩人と比べられるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "安心して！このゲームは…その…多くの人に試遊してもらったから大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290206,
					"content": "楽器が何よりも苦手って人でも、少なくとも一曲は演奏できるから…えっと…悪くない曲を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290207,
					"content": "私と西風騎士団を信じて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290208,
					"content": "集中してリズムにのれば、きっといい曲が弾けるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290209,
					"content": "風の中で美しいメロディーに耳を傾ける…そうすれば、悩みごとだってすべて忘れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290210,
					"content": "だったら、吟遊詩人は一番悩みがないはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "あはは、それはどうだろ。この曲にお金を払ってくれる人はいるかなって、無意識に心配しちゃってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290212,
					"content": "あなたの場合は…下手なりにでも、ただ楽しく演奏すればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290213,
					"content": "あっ…今のは聞かなかったことに！このゲームの遊び方はもう分かったかな？興味があったら、ぜひやってみてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290214,
					"content": "もちろん、自分の楽器で曲を演奏することもできるよ。もし楽器を持っていなかったら、こっちで貸してあげることもできるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290215,
					"content": "へへ…たくさん楽器を用意してあるんだ。それぞれ弾き心地も違うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290216,
					"content": "まずはどの楽器で演奏したい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290217,
					"content": "風吹きのライアー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "その楽器がいいんだね、いいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290221,
					"content": "そうだ！もう一つ伝えることがあるの！ちょっと待ってて、今ノートを見るから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290222,
					"content": "えーっと…うん…みんなが素敵な曲を演奏できるように、今回は特別に「チューニング」の段階を入れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290223,
					"content": "簡単に言うと、楽器をベストな状態に調節することだね…とても簡単だから安心して。えっと、まずは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290224,
					"content": "はい！これでできた。楽器はベストな状態になったよ…譜面も用意したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290225,
					"content": "あとはあなたさえ良ければ、いつでも演奏を始められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リジー"
				},
				{
					"id": 705290218,
					"content": "鏡花の琴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "綺宴の鼓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "うまく演奏できるかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}