	"talks": [
		{
			"id": 7601301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7601301",
							"2"
						],
						"stepId": 7601301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィーナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760130101,
					"content": "#ああ、{NICKNAME}！また会えたね！やっぱりこれって月光が繋げてくれた「運命」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130102,
						760130106,
						760130141
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130102,
					"content": "#{M#君}{F#あなた}の処分について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130103
					]
				},
				{
					"id": 760130103,
					"content": "ふふん、ラウマ様はラフタルおばさんよりも融通が効くからね！事情を説明したら、一分くらい沈黙してたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130104
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130104,
					"content": "その後、書庫に行ってアンローズを手伝って、文献を整理したり祈祷の詩を書き写してほしいって頼まれたの。私が心を正すまでは、もうナシャタウンで働かなくていいって！最高のご褒美でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130105
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130105,
					"content": "#そうそう！ここ数日祈祷歌を書き写してたら、アイラ様の言ってたことの意味が分かってきたよ！やっぱり、{NICKNAME}は幸運をもたらす存在だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130106,
					"content": "この前の出来事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130107
					]
				},
				{
					"id": 760130107,
					"content": "何か聞きたいコトとかある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130108,
						760130137
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130108,
					"content": "アイラが言ってたことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130109
					]
				},
				{
					"id": 760130109,
					"content": "ふふん、それは私に聞いて正解だね！私、ここ数日ずっと考えてたんだ。アイラ様の言葉はいつ記録されたのかなとか、「毒蛇」ってなんだろうとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130110
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130110,
					"content": "#全部分かったよ！{NICKNAME}、覚えてる？映像の中で、アイラ様は相手のことを「ソロヴィ」って呼んでたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130111
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130111,
					"content": "あれはね、間違いなくライトキーパーの創設者——スネージナヤ貴族出身の「ソロヴィ」だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130112
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130112,
					"content": "記録によると、アイラ様はソロヴィの頼みで北の<color=#00E1FFFF>エンブラの柱</color>ヘ向かい、アビスの災いを鎮めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130113
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130113,
					"content": "「新月の乙女は、彼が来訪することを知っていたのか、彼のために暗闇を払う明かりを…」——まあ、とにかく彼を手伝ったってことだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130114
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130114,
					"content": "だから、あの方の言ってた「毒蛇」って、アビスのことじゃないかな。これって、完璧な推理じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130115
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130115,
					"content": "#「ルヴィア」については…うーん、{NICKNAME}は<color=#00E1FFFF>ヒュペルボレイア</color>って知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130116,
						760130126
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130116,
					"content": "聞いたことある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130117
					]
				},
				{
					"id": 760130117,
					"content": "#さっすが{NICKNAME}！話が早いよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130118
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130118,
					"content": "霜月の子はそのヒュペルボレイアの末裔なんだ。だから、五百年前——つまり、月の{RUBY#[D]クータル}少女が誕生するまでの間、ずっとヒュペルボレイアの古い祭儀を執り行ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130119
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130119,
					"content": "「詠月使」は聖女アイラ様が最初に使い始めた称号。それまで、祭儀を執り行うリーダーは「大司祭」と呼ばれていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130120
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130120,
					"content": "「ルヴィア」は、アイラ様が霜月の子の信仰を改革する前に、ヒュペルボレイアの末裔を率いていた最後の「大司祭」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130121
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130121,
					"content": "月の{RUBY#[D]クータル}少女がまだ生まれていなかった時代、月光の{RUBY#[S]クーヴァキ}祝福も日に日に尽きていくばかりだった時代に、彼女はヒュペルボレイアの古の儀式を保つため、神を冒涜する罪を犯した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130122
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130122,
					"content": "その後、彼女は記憶から消し去られた…つまり彼女に関する記録が抹消されたんだ。だから詳細は私にもわからないけど…ざっくり言うと外の悪いやつらと結託して、罪のない多くの人を陥れたってことみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130123
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130123,
					"content": "噂によると、アイラ様が生まれる前なんか、とある信者がスネージナヤの軍官と恋に落ちたってだけで、人を派遣して、駆け落ちした二人を…とかね。ひどいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130124
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130124,
					"content": "とにかく、アイラ様は彼女から「霜月の子」を受け継ぎ、ヒュペルボレイアの祭儀を廃止して、私たちには全身全霊で月光を敬虔に信仰するようにって命じたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130125
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130125,
					"content": "#ほんとは、この名前を知っていいのは司祭以上の信者だけなんだけど…{NICKNAME}は例外だよね？うん、きっと大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130126,
					"content": "よく分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130127
					]
				},
				{
					"id": 760130127,
					"content": "おっけー、じゃあ最初から説明するね！大丈夫、私は頼りになる司祭だからね！月の秩序を受け継ぐ…えっと、とにかく、ちゃんと説明するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130128
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130128,
					"content": "ヒュペルボレイアは既に滅亡した古代国家で、私たち「霜月の子」は、その国から流れ着いた遺民の末裔なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130129
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130129,
					"content": "私たちの先祖は多くの古い祭儀を受け継いできたけど、その儀式はみんな月の{RUBY#[D]クーヴァキ}祝福があって初めて効果が出る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130130
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130130,
					"content": "ルヴィアっていうのは、アイラ様が霜月の子の信仰を改革する前に、霜月の子を率いていたすっごく悪い大祭司なわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130131
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130131,
					"content": "でも、その時はまだ月の{RUBY#[D]クータル}少女が生まれていなかったから、月光の{RUBY#[S]クーヴァキ}祝福も希薄で、効果が出ない儀式も多かったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130132
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130132,
					"content": "儀式が昔みたいに進められるようにって、彼女はたくさんの悪事を働いて、霜月の子以外の悪者と結託して、多くの人を傷つけた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130133
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130133,
					"content": "悪い大祭司が具体的に何をしたのかは、私にも知らないんだけど。とにかく、彼女の行いは既に歴史の記録から完全に消されちゃった。それくらい悪い人ってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130134
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130134,
					"content": "噂によると、アイラ様が生まれる前なんか、とある信者がスネージナヤの軍官と恋に落ちたってだけで、人を派遣して、駆け落ちした二人を…とかね。ひどいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130135
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130135,
					"content": "その後、彼女から「霜月の子」を受け継いだアイラ様は、ヒュペルボレイアの祭儀を廃止して、私たちには全身全霊で月光を敬虔に信仰するようにって命じたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130136
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130136,
					"content": "#ほんとは、この名前を知っていいのは司祭以上の信者だけなんだけど…{NICKNAME}は例外だよね？うん、きっと大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130137,
					"content": "あの剣について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130138
					]
				},
				{
					"id": 760130138,
					"content": "ああ、心配しないで！あの剣のことなら、ラウマ様にも伝えておいたよ。アイラ様があなたに贈るって言ったなら、好きに使って構わないってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130139
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130139,
					"content": "でも…はぁ、すっごく羨ましい！伝説では、アイラ様はまさにこの剣を使って、生まれてくる月の{RUBY#[D]クータル}少女に最初の銀の血液を捧げたって言うんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130140
					],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130140,
					"content": "#祝福を受けた無垢の剣で、純粋な者だけが扱えるんだって…{NICKNAME}は、やっぱり神に愛されてるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィーナ"
				},
				{
					"id": 760130141,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130142
					]
				},
				{
					"id": 760130142,
					"content": "うん、じゃあまた！いってら——コホン、えっと、月光が前途を照らさんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィーナ"
				}
			]
		},
		{
