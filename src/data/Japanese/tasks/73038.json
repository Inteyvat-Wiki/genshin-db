			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランラナ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380101,
					"content": "アシュヴァッタの樹…おかしい。アシュヴァッタの樹はここにはないはず。金色のナラ、白いふわふわ…アランラナは知らない。でもどこかで会った気もする。キミたちは誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380102
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380102,
					"content": "アランラナ、ほんとに忘れちゃったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380103,
					"content": "#オイラはパイモン、こいつは{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380104,
					"content": "#{M#俺}{F#私}たちはアランラナの友達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380105
					]
				},
				{
					"id": 730380105,
					"content": "うん。アランラナはキミたちを信じる。キミたちからは善良な雰囲気を感じる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380106
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380106,
					"content": "アランラナは理解した。心に穴みたいなものがある。大事な記憶が逃げ出したんだ。でもアシュヴァッタの樹に会って、キミたちに会って、また色々分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380107
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380107,
					"content": "さっき見たけど、キミたち「ビージャの実」を手に入れたね？友達を助けるため、アランラナはいろんなことを忘れた。それでアシュヴァッタの樹に実をつけてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380108
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380108,
					"content": "アランラナは賢いな…「友達」のこと、まだ覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380109,
					"content": "覚えてない。でもいい。キミたちはビージャの実を持ってる。それこそキミたちがアランラナの信じる友達であり、アシュヴァッタの樹が認めたナラである証拠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380110
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380110,
					"content": "お願い。ビージャの実をアランラナの助けたい友達に届けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380111,
						730380113
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380111,
					"content": "分かった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380112
					]
				},
				{
					"id": 730380112,
					"content": "アランラナも一緒に行こう！友達も、きっとおまえに会いたがってるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380115
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380115,
					"content": "アランラナはやめておく。アランラナはもう忘れた。アランラナが自分を忘れたと知ったら、友達が悲しむ。アランラナは友達を大事にしないと思われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380116
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380116,
					"content": "アランラナが助けようとしてる友達は、すごくいい人…いいナラだ。アランラナがそいつを忘れても、きっとまた友達になろうって言ってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380117,
					"content": "だから一緒に行こう。な？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380118,
					"content": "…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380119
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380119,
					"content": "分かった。アランラナはキミたちを信じる。キミたちは友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380113,
					"content": "一緒に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380114
					]
				}
			]
		},
