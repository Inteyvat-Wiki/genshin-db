			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "これ、アランラナのアランラカラリ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380202,
					"content": "この子が、アランラナの友達のナラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380203,
					"content": "#ああ。じゃあ、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380204,
					"content": "（ビージャの実を使おう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
