			"trigger": {
				"objectNames": [
					"ラナ",
					"パイモン",
					"アランラナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380301,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380302
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380302,
					"content": "意識が戻った…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380303,
						730380304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380303,
					"content": "聞こえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				},
				{
					"id": 730380305,
					"content": "#あれ？私、また寝ちゃったんですね…ここは？{NICKNAME}、パイモン、無事でよかった！死域にやられてないか心配してたんですよ。それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380306
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380306,
					"content": "アランラナ？アランラナだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380307
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380307,
					"content": "やあ、ナラの友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380308
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380308,
					"content": "ずっとずっと待ってたんだよ…ずっとずっと、あなたに会う日を夢見てた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380309
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380309,
					"content": "森で迷子になった夢を見たの。家の方角もパパやママの居場所も分からなくて泣き続ける私の声を聞いて、あなたが来てくれた。そして歌を聞かせてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380310
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380310,
					"content": "それで私たちは親友になった。私はしょっちゅう森に来てはあなたと遊んだ。あなたは私に花をくれて、いろんなこと、たくさんの森の秘密を教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380311
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380311,
					"content": "星茸はお星さまが地上に落とした影だよとか、サウマラタ蓮が咲くのを見たら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380312
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380312,
					"content": "サウマラタ蓮が咲くのを見たら、次に月が昇るまで幸運が続く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380313
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380313,
					"content": "そう、それ！それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380314
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380314,
					"content": "私はヴィマラ村のみんなのために、早く大人になって頼りがいのあるレンジャー長になりたいと夢見た。でも頼りがいのある大人は、森の精霊の童話を信じない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380315
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380315,
					"content": "私はあなたを忘れる夢を見た。アランナラの物語は、イッサムたちが信じてる子供のおとぎ話だと思い込んだの。森は木が生い茂るだけの場所、魔法なんかないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380316
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380316,
					"content": "さっき目覚めた時、あなたを忘れてたらどうしようと思ってすごく怖かった…でもそれはただの夢だった！またあなたに会えて、ほんとによかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380317
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380317,
					"content": "アランラナ、どこ行ってたの！ずっと待ってたんだよ、あなたが森に連れてってくれるのを…あなたと一緒にいる時にしか見えない、謎めいた秘密の森に行きたかったんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380318
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380318,
					"content": "ごめん。アランラナはもう忘れてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380319
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380319,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380320
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380320,
					"content": "えっと…ラナ、アランラナを責めないであげてくれ。実はさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380321,
					"content": "「…おまえを捜してる時に、アランラナに遭遇したんだ。」とアランラナに説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380322
					]
				},
				{
					"id": 730380322,
					"content": "マウティーマ稠林の菌、雨の果ての戦闘。遺跡巨像の内部、薔薇の小曲。兄妹を演じるアランナラ、愉快なウツァヴ祭の光景…\\nアランナラと過ごした日々の物語を、ゆっくりラナとアランラナに語って聞かせた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730380323
					]
				},
				{
					"id": 730380323,
					"content": "忘れてたのは、私の方だったんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380324
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380324,
					"content": "ビージャの実は記憶が凝縮してできたもの…二人で遊んだ記憶はアランラナにとってすごく大切なものだったんだろう。だから治療の途中で、昔の思い出がよみがえったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380325,
					"content": "#{NICKNAME}、パイモン…ありがとうございます。私のせいで、大変な思いをさせてしまいましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380326,
						730380328
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380326,
					"content": "ううん、色々得るものも多かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380327
					]
				},
				{
					"id": 730380327,
					"content": "ああ、そうだな！それに感謝するなら、アランラナやアランマにしてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380329,
					"content": "ありがとう…ごめんね、アランラナ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380330
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380330,
					"content": "ううっ…私、あなたのこと忘れちゃってた…私のこと、嫌いになったよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380331
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380331,
					"content": "分からない。アランラナはもう忘れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380332
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380332,
					"content": "でも、いいんだ。覚えてた頃のアランラナが、記憶を捨てることを選んだ。今のアランラナは分かった。キミは一番大事なナラ、思い出よりずっと大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380333
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380333,
					"content": "えっと…こんな風に言うと、アランラナに失礼かもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380334,
					"content": "#アランラジャたちが言ってた。アランナラはすごく長生きだって。だからまだまだこれから、いっぱい楽しい思い出が作れると思う。オイラと{NICKNAME}みたいにさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380335,
					"content": "ええ…私たちには、まだまだ時間があります。また一緒に森の大きさ、世界の広さ、未来の壮大さを知ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380336
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380336,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380337
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380337,
					"content": "#マラーナ…死域の問題は、私が眠っている間にほぼ解決してくださったんですね。{NICKNAME}、パイモン、それにたくさんのアランナラたち…本当にありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380338
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380338,
					"content": "ちょっとワガママですけど、アランラナと一緒に旅ができたらなぁ…なんて。でもヴィマラ村の子供たちがまた危険な目に遭ったらと思うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380339
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380339,
					"content": "忘れるとこだった。まだ悪党の問題が解決してないんだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380340,
					"content": "悪党の正体なら、目星がついてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380341
					]
				},
				{
					"id": 730380341,
					"content": "えっ、誰のことだ？う～ん、なんでオイラは知らないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380342,
					"content": "で、誰なんですか？ここを出る前に、きっちり懲らしめてやらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380343,
						730380344
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380343,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380345,
					"content": "分かりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380346
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380346,
					"content": "#私、{NICKNAME}を信じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380347
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380347,
					"content": "ただ、こんな風に言うのも変ですけど…その悪党がもたらしたのって、悪いことばかりじゃないんです。子供たちが迷子にならなかったら、私も森のパトロールを増やしたりしなかったですし——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380348
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380348,
					"content": "パトロールを増やさなかったら、あの時あの場所でキノコンに遭うこともなかった。あなたとパイモンはまっすぐで優しくて、困ってる人を放っておけないタイプだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380349
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380349,
					"content": "#だから、私は{NICKNAME}やパイモンと知り合えた。色々手伝ってもらって、助けてもらった上に、大事な友達にまで再会させてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380350
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380350,
					"content": "#ありがとう、{NICKNAME}。ありがとう、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380351
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380351,
					"content": "いいってことよ！でも「ラナお姉さん」がいなくなったら、イッサムやカブス、スダッベが悲しむだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380352
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380352,
					"content": "#あの子たちは本当は強い子なんですよ。それに{NICKNAME}{M#お兄さん}{F#お姉さん}とも知り合えましたし。私だってそのうち戻ってきますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380353
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380353,
					"content": "#そう、絶対に戻ってくる。そして、あの子たちにたくさんの物語を話して、アランラナをみんなに紹介します。前に{NICKNAME}を紹介したみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380354
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380354,
					"content": "そっか…ならよかった。もう戻らないつもりかと思って心配したぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380355
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380355,
					"content": "アランラナ、私と一緒に旅してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380356
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380356,
					"content": "アランラナもそうしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380357
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380357,
					"content": "あなたは私のために、いろんなことを忘れた。でもパイモンの言う通り、私たちはまた一緒にたくさんの思い出を作って、あなたの心に空いた穴を塞げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380358
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380358,
					"content": "私はラナ、友達になってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380359
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380359,
					"content": "うん。ナララナ、今までも、これからもずっと友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380360
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380360,
					"content": "ん？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380361
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380361,
					"content": "ラナの胸から、心弾むような暖かく、細かくて明るい光が放たれる。\\n彼女は試しに手で遮ろうとしたが、光源はまるで意識があるかのように彼女の手に入り込んだ。\\n光がゆっくりと消えていった後、彼女の手に現れたのは、精緻な装飾品であった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380362
					]
				},
				{
					"id": 730380362,
					"content": "神の目だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380363
					]
				},
				{
					"id": 730380363,
					"content": "こういう場面を直接に見るのって初めてだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380364
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380364,
					"content": "神が私の願いを聞き届けてくださったんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380365
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380365,
					"content": "#よし、これがあれば旅行中も安心ですね！死域の残党に遭遇しても、自分で解決できます。私の戦う姿が、{NICKNAME}みたいに恰好よければいいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380366
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380366,
					"content": "まだやることがいっぱい残ってますし、みんなにも挨拶しないと。それにティナリ先輩にも、旅行の件を伝えないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380367
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380367,
					"content": "#パイモン、アランラナ、ありがとう。{NICKNAME}、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380368
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380368,
					"content": "#ありがとう。金色のナラ{NICKNAME}、パイモン。アランラナは覚えてないけど、キミたちはきっといいナラだ。アランラナをナララナに引き合わせてくれて、嬉しかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380369,
						730380372
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380369,
					"content": "#{M#君}{F#あなた}たちに出会えてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380370,
						730380371
					]
				},
				{
					"id": 730380370,
					"content": "どうか気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380373,
					"content": "ラナ、アランラナ…旅の無事を祈ってるぞ。あと、オイラたちのこと忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380374
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730380374,
					"content": "「吹き荒れる風に耐え、雪を振り払い、身を震わせるような寒さを乗り越え、茹だるような炎天下を歩む…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380375
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380375,
					"content": "#昔、こんな詩を聞いたことがあります。次に会う時には、きっと今より強くなっていますから。{NICKNAME}、パイモン、絶対また会いましょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380376
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730380376,
					"content": "また必ず会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730380371,
					"content": "旅でたくさんの収穫があるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380372,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380344,
					"content": "まだ具体的な証拠はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380328,
					"content": "お礼なら、アランラナやアランマに言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380329
					]
				},
				{
					"id": 730380304,
					"content": "もう大丈夫そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				}
			]
		}
	]
}