			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランファラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "ん？アンタか。久しぶりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220302,
					"content": "あれ？ここはどこだ？どっかの洞窟か…ンン、頭がくらくらする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220303,
					"content": "おまえ、誰だ？なんでこんなとこで寝てるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220304,
					"content": "オレは誰だ…うっ、めまいがする。えーっと…オレの名前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220305,
					"content": "オレはアランファラ。へへっ、思い出せた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220306,
					"content": "おまえがアランファラか！どこ行ったのかと思ったら、この洞窟に隠れて寝てたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220307,
					"content": "アランファラ…アンタら、オレの名前を知ってるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220308,
					"content": "あれ、ナラ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220309,
					"content": "ぱっちり目が覚めたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220310,
					"content": "完全に目が覚めたみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "ううっ、まだ準備できてないんだ。オレをお粥にしないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220312,
					"content": "え？誰がおまえをお粥にするって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220313,
					"content": "い、妹が言ってたんだ。そうやってぼんやりしてたら、そのうち悪いナラに捕まってお粥にされちゃうよって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220314,
					"content": "アランファラおいしそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "うわああああっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220316,
					"content": "#おい{NICKNAME}、悪い冗談はよせ！アランファラ、誰もおまえをとって食ったりしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220318,
					"content": "…ほんとに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220319,
					"content": "ほんとだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220320,
					"content": "ほんとにほんと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220321,
					"content": "#嘘じゃないってば。オイラはパイモン。こっちのデカいのはナラ{NICKNAME}。アランパカティに頼まれておまえを捜しに来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220322,
					"content": "アランパカティ？アイツ、元気？オレ、ここでどれだけぼんやりしてたんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220323,
					"content": "どれだけ？それ、確か前にも聞いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220324,
					"content": "えーっと…たくさんのお月様が昇って沈むよりもずーっと前のときからで、種から出た芽が大木になるくらいの時間。アランパカティがなん体分の高さだっけ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220325,
					"content": "七体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#おお、さすが{NICKNAME}！記憶力がいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220329,
					"content": "ええっ、いつの間にそんな？これはまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220330,
					"content": "とにかく、事情を聞いてくれ。もうすぐウツァヴ祭が始まるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220331,
					"content": "アランファラにこれまでの経緯を説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "そうか、ウツァヴ祭か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220333,
					"content": "うん。だからアランパカティもおまえに帰って来てほしいんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220334,
					"content": "いやぁ…でもまだ「お料理修行」が終わってないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220335,
					"content": "あれ？さっき睡眠中だっただろ。オイラはてっきり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220336,
					"content": "「睡眠」？ああ、ただ昔のことを思い出してただけ。そこまでヤバい状態じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220337,
					"content": "アランナラにとって、寝るのはヤバいことなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220338,
					"content": "うーん…なんていうか、命の危険にさらされた時、オレたちは「休眠」する。それから全部の記憶と夢を一粒の「種」に凝縮させるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220339,
					"content": "危険が去って縁があれば、その種は森に帰れる。それが巡り合わせのいい時に育って、またアランナラになるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220340,
					"content": "何だか大変そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "でも、知ってる。ナラには睡眠が必要なんだろ。オレにも昔、ナラの友達がいたから。アンタと同じ金色のナラさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220345,
					"content": "昔、アイツとここに「新鮮極上の果実」を摘みに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220346,
					"content": "#だからオレはずっとここで実を獲ってる。もし{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}が戻ってきたり、新しいナラの友達に会ったりしても、一緒に実が食べられるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220347,
					"content": "今回もいっぱい「新鮮極上の果実」を摘んだ…あれ、何でこれしか残ってないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220348,
					"content": "さっき道端に夕暮れの実が散乱してたぞ。あれ、全部おまえの落とし物だったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220349,
					"content": "そんなに落としてたのか…うーん、まぁいいか。ふふっ、新鮮でおいしい果物はまだ残ってるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220350,
					"content": "けど…何でそんなにいっぱい落としたんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220351,
					"content": "お兄ちゃんたちと一緒に「お料理修行」の旅に出た。でもみんな、新鮮な果物が一番ウマい食材だってことを知らないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220352,
					"content": "でも果物を摘んでる最中に…そう、果物を摘んでるときだ。急にどでかい怪物が現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220353,
					"content": "大怪物は、背の高さがアランファラ五つ分。尻尾が長くて、歩くと大地がぐらぐら揺れる。しかもちょっと「マラーナ」に似た雰囲気なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220354,
					"content": "それにめちゃくちゃ屈強だ。多分アランマやアランバリカでも、力を入れないと倒せないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220355,
					"content": "ええ？あいつらってそんなに強かったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220356,
					"content": "ああ。でも、オレはそこまで強くない。だから、ここに隠れるしかなかった。思い出に浸りながら、奴が去るのを待った。それで、はっと気づいたら、アンタたちがここにいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220357,
					"content": "あんなに怖い大怪物が外にいるんなら、出かけたくない。許せ、「妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220358,
					"content": "ダメだぞ。ウツァヴ祭も近いんだから、帰らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220359,
					"content": "ウツァヴ祭は楽しみだけど、洞窟を出たら命にかかわる…ぐぅっ…楽しいウツァヴ祭のために苦しむなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220360,
					"content": "ぐぅ～すぴ～ぐぅ～すぴ～ナラヴァルナ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220361,
					"content": "あ、コイツ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220362,
					"content": "#{NICKNAME}、どうする…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220363,
					"content": "大怪物をやっつけよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "…怖いっていっても、風魔龍ほどじゃないだろ。アランナラが風魔龍に出遭ったら、なんて表現するだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220366,
					"content": "「アランファラ百万体分の大きさ！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "「尻尾から頭に行くと月が昇って落ちる！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220368,
					"content": "とにかく外に出て、そいつをやっつけにいくか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220364,
					"content": "うわぁ、大怪物！こわいっ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "すごく便利なシステムだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "パイモンも種になれるかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "おまえ、オイラになんか不満でもあるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220327,
					"content": "パイモンは記憶力がいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220317,
					"content": "アランファラをお粥にする人なんていないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
