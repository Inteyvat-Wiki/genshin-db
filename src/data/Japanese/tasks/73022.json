			"dialogs": [
				{
					"id": 730220101,
					"content": "おーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220102,
					"content": "ぐぅ～すぴ～ぐぅ～すぴ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220103,
					"content": "おーい！おっすー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220104,
					"content": "うんうん。いい実だ。ぐぅぅ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220105,
					"content": "くそっ、全然起きない。えっと…そうだ、アランパカティが言ってたな。<color=#00E1FFFF>草元素の力</color>を使えば、こいつを元に戻せるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220106,
					"content": "#{NICKNAME}、任せたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
