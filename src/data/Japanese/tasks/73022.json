			"dialogs": [
				{
					"id": 730220501,
					"content": "ぐぅ～すぴ～ぐぅ～すぴ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220502
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220502,
					"content": "アランファラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220503,
					"content": "ん？なんだ、パイモンか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220504,
					"content": "#そうだよ。いっこ報告しに来たんだ。外の「大怪物」は、{NICKNAME}がやっつけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220505,
					"content": "#おおっ、大怪物ほどでかくないナラ{NICKNAME}に、そんな力があったとはな。すごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220506,
					"content": "大したことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "よし、じゃあ出発だ。いいナラ、一緒に果物を食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220507,
					"content": "かなり手ごわかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
			"completionStepIds": [
				7302204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302204",
							"2"
						],
						"stepId": 7302204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランファラ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "そうだな…じゃあ「新鮮極上の果実」を調理するか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220602,
					"content": "「新鮮極上の果実」って、普通の果物とどこが違うんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220603,
					"content": "ナラにとっては、果物はみんな同じに見えるんだろ。でも、実は違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220604,
					"content": "「新鮮極上の果実」は、強い木にだけ実る。強い木は風が吹く頃、最初に歌を歌うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220605,
					"content": "頑丈な木が生んだ子供、それがオレたちへのプレゼント…つまり「新鮮極上の果実」ってこと。ナラの友達が言ってた。この果物はお腹の中で歌を歌ってるみたいにおいしいって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220606,
					"content": "へえ、この果物でどんな美味しいものができるか楽しみだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220607,
					"content": "アランファラはすぐさま調理に取り掛かった…\\n果物をいくつかに切り分けて…\\nそれから、その中のいくつかを渡してくれた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "そうしてみんなで、新鮮な果物を味わった。\\n予想通りというべきだろうか、確かにジューシーな果物の味がした。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "最高だ。ありがとうな、頑丈な木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220610,
					"content": "ちょっと待った。これって「料理」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220611,
					"content": "「新鮮極上の果実」自体が最高級の「至高のごちそう」だ。手を加えなくても、パーフェクトな味わいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220612,
					"content": "ごちゃごちゃ言ってないで、食べれば分かるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220613,
					"content": "確かに美味しいな。なんだろう、果物を食べてるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220614,
					"content": "だって果物そのものだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "確かにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220616,
					"content": "アンタたちナラにも、果物を切ってお皿に並べて、それを木の上に置いた料理があるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220617,
					"content": "ええ？…ええっと、それはフルーツの盛り合わせだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220618,
					"content": "フルーツの盛り合わせって、料理って言えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220619,
					"content": "言えるんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "ええ、フルーツの盛り合わせを料理っていうのは違う気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220623,
					"content": "むむ…形式にこだわるのはよせ。ウマい食材を探す、それだって料理に含まれてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220624,
					"content": "食材を探す過程で森のいろんな所に行って、森と親しむ。これぞまさに「お料理修行」の本質さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220625,
					"content": "そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220626,
					"content": "そうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220627,
					"content": "「新鮮極上の果実」を摘んで、「至高のごちそう」も作った。これで今回の「お料理修行」は終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220628,
					"content": "これで堂々とヴァナラーナに帰れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220629,
					"content": "#はぁ…大怪物に洞窟に追いやられて、ナラ{NICKNAME}やパイモンがいなかったら、ウツァヴ祭に出られない所だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220630,
					"content": "おまえも早いとこ、ヴァナラーナに戻るんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220631,
					"content": "確かにそうだな…ウツァヴ祭を逃したら、妹に叱られる…考えるだけでゾッとするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220621,
					"content": "言わないかなあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "だよな。なんの手も加えてないのに…料理って言うのは変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "パイモン"
				}
			]
		},
