				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "ん？アンタか。久しぶりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220202,
					"content": "あれ？ここはどこだ？どっかの洞窟か…ンン、頭がくらくらする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220203,
					"content": "おまえ、誰だ？なんでこんなとこで寝てるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220204,
					"content": "オレは誰だ…うっ、めまいがする。えーっと…オレの名前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220205,
					"content": "オレはアランファラ。へへっ、思い出せた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220206,
					"content": "おまえがアランファラか！どこ行ったのかと思ったら、この洞窟に隠れて寝てたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220207,
					"content": "アランファラ…アンタら、オレの名前を知ってるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220208,
					"content": "あれ、ナラ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220209,
					"content": "ぱっちり目が覚めたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220210,
					"content": "完全に目が覚めたみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "ううっ、まだ準備できてないんだ。オレをお粥にしないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220212,
					"content": "え？誰がおまえをお粥にするって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220213,
					"content": "い、妹が言ってたんだ。そうやってぼんやりしてたら、そのうち悪いナラに捕まってお粥にされちゃうよって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220214,
					"content": "アランファラおいしそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "うわああああっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220216,
					"content": "#おい{NICKNAME}、悪い冗談はよせ！アランファラ、誰もおまえをとって食ったりしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220218,
					"content": "…ほんとに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220219,
					"content": "ほんとだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220220,
					"content": "ほんとにほんと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220221,
					"content": "#嘘じゃないってば。オイラはパイモン。こっちのデカいのはナラ{NICKNAME}。アランパカティに頼まれておまえを捜しに来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220222,
					"content": "アランパカティ？アイツ、元気？オレ、ここでどれだけぼんやりしてたんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220223,
					"content": "どれだけ？それ、確か前にも聞いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220224,
					"content": "えーっと…たくさんのお月様が昇って沈むよりもずーっと前のときからで、種から出た芽が大木になるくらいの時間。アランパカティがなん体分の高さだっけ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220225,
					"content": "七体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#おお、さすが{NICKNAME}！記憶力がいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220229,
					"content": "ええっ、いつの間にそんな？これはまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220230,
					"content": "とにかく、事情を聞いてくれ。もうすぐウツァヴ祭が始まるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220231,
					"content": "アランファラにこれまでの経緯を説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "そうか、ウツァヴ祭か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220233,
					"content": "うん。だからアランパカティもおまえに帰って来てほしいんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220234,
					"content": "いやぁ…でもまだ「お料理修行」が終わってないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220235,
					"content": "あれ？さっき睡眠中だっただろ。オイラはてっきり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220236,
					"content": "「睡眠」？ああ、ただ昔のことを思い出してただけ。そこまでヤバい状態じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220237,
					"content": "アランナラにとって、寝るのはヤバいことなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220238,
					"content": "うーん…なんていうか、命の危険にさらされた時、オレたちは「休眠」する。それから全部の記憶と夢を一粒の「種」に凝縮させるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220239,
					"content": "危険が去って縁があれば、その種は森に帰れる。それが巡り合わせのいい時に育って、またアランナラになるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220240,
					"content": "結構大変そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "でも、知ってる。ナラには睡眠が必要なんだろ。オレにも昔、ナラの友達がいたから。アンタと同じ金色のナラさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220245,
					"content": "昔、アイツとここに「新鮮極上の果実」を摘みに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220246,
					"content": "#だからオレはずっとここで実を獲ってる。もし{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}が戻ってきたり、新しいナラの友達に会ったりしても、一緒に実が食べられるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220247,
					"content": "今回もいっぱい「新鮮極上の果実」を摘んだ…あれ、何でこれしか残ってないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220248,
					"content": "さっき道端に夕暮れの実が散乱してたぞ。あれ、全部おまえの落とし物だったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220249,
					"content": "そんなに落としてたのか…うーん、まぁいいか。ふふっ、新鮮でおいしい果物はまだ残ってるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220250,
					"content": "けど…何でそんなにいっぱい落としたんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220251,
					"content": "お兄ちゃんたちと一緒に「お料理修行」の旅に出た。でもみんな、新鮮な果物が一番ウマい食材だってことを知らないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220252,
					"content": "でも果物を摘んでる最中に…そう、果物を摘んでるときだ。急にどでかい怪物が現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220253,
					"content": "大怪物は、背の高さがアランファラ五つ分。尻尾が長くて、歩くと大地がぐらぐら揺れる。しかもちょっと「マラーナ」に似た雰囲気なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220254,
					"content": "それにめちゃくちゃ屈強だ。多分アランマやアランバリカでも、力を入れないと倒せないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220255,
					"content": "ええ？あいつらってそんなに強かったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220256,
					"content": "ああ。でも、オレはそこまで強くない。だから、ここに隠れるしかなかった。思い出に浸りながら、奴が去るのを待った。それで、はっと気づいたら、アンタたちがここにいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220257,
					"content": "そういえば、オイラたちも来る途中で「遺跡ドレイク」に遭ったぞ。どでかい怪物ってアイツのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220258,
					"content": "ナラはアイツをそう呼ぶのか…？多分そう。そうに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220259,
					"content": "もう片付けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#おおっ、大怪物ほどでかくないナラ{NICKNAME}に、そんな力があったとはな。すごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220265,
					"content": "よし、じゃあ出発だ。いいナラ、一緒に果物を食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220260,
					"content": "うわぁ、大怪物！こわいっ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "…そんなに怖かったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220262,
					"content": "うんうん。ナラもあれが恐ろしい怪物だって、分かってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730220263,
					"content": "#大丈夫だって。おまえに会う前に、{NICKNAME}が大怪物をやっつけたから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220241,
					"content": "すごく便利なシステムだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "パイモンも種になれるかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "おまえ、オイラになんか不満でもあるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220227,
					"content": "パイモンは記憶力がいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730220217,
					"content": "アランファラをお粥にする人なんていないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
							"2"
						],
						"stepId": 7302207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
