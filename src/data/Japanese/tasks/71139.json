							2414.79
						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "あれ？霊淵じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390303,
					"content": "おっと、ごめん！狩りをしてたのか？うっかり邪魔しちゃったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390304,
					"content": "狩りはしていない。汝らに邪魔もされていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390305,
					"content": "えっ、それじゃ…ぼーっとしてたのか？たとえば、美味しそうな物のことを考えてたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390306,
					"content": "汝のことは別に考えていない。他に考えごとをしていたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390307,
					"content": "考えごと…待った、今の前半の台詞はどういう意味だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390308,
					"content": "#{NICKNAME}の以前の問題について考えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390309,
					"content": "「人間の活動も自然の掟の一部なら、人間をどう思うか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390310,
					"content": "浮錦と蛇が去った後、集落を構成する人間とはあまりにも長い間接触してこなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390311,
					"content": "でも、マオくんだって人間だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390312,
					"content": "#マオは集落に所属する人間であって、集落を構成する人間ではない。汝は{NICKNAME}とともに旅の仲間を「構成」しているが、{NICKNAME}に「所属」しているわけではないだろう。そこが違うのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390313,
					"content": "マオくんは社会秩序の一部じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "まだ完全には秩序の一部になっていない。秩序によって徹底的に塗りつぶされるまでは、人間の子供というのは皆そうだ。ちょうど自然のようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390317,
					"content": "集落を構成する人間とは久しく接触していない。嫌悪からか、それとも恐れからか、あるいはその両方か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390318,
					"content": "彼らが自然の土地を自分のものにしたから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "さあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390321,
					"content": "「我々」と「彼ら」の間には明確な線引きはないのかもしれない。だが、そうだと言い切ることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390322,
					"content": "人間の子供が妾と共に過ごす。妾の同族には幼子もいるが、その子もまた好奇心から人間と共に過ごす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390323,
					"content": "えっ？同族の幼子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390324,
					"content": "その子は山でいかにも人間らしい人間と出会った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390325,
					"content": "ゆえに、汝の問いには今すぐ答えられないのだ。これからも人間を観察し続ける必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390326,
					"content": "妾には理解できないことが山ほどあるのだ。約束通り汝の質問に答えられるようになるまで、理解を試みるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390319,
					"content": "彼らの為に浮錦は犠牲になろうとしたから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "そうとは限らないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "おい！そんな意味わかんない話しないでくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マオくん",
					"オートモンターニュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "大山の話を聞いて、フォンテーヌの「歌劇」は僕らの芝居とそう変わらないと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "マオくん"
				},
				{
					"id": 711390402,
					"content": "騎士だとか、魔法使いだとか、勇士だとか、悪龍だとか。それに誰かに殺され、誰かを殺し、最後にはみんな死んじゃうでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "マオくん"
				},
				{
					"id": 711390403,
					"content": "重要なのは結末じゃなくて過程よ、過程！すべての悲劇がアクションものとは限らないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711390404,
					"content": "他にもさ、大山がさっき言ってた「礼無理やの魔像」ってすごく面白そうだよね！あ、藍とどっちが大きいんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "マオくん"
				},
				{
					"id": 711390405,
					"content": "えっ？「アラン」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711390406,
					"content": "そうだ、大山には藍の話をしてなかったね…「礼無理や」の魔像のことをもう少し詳しく話してくれたら、藍のことも聞かせてあげるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マオくん"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮錦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "うわぁ～！いつの間にかこんなにたくさん仙力を集めてたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390502,
					"content": "#さすがは{M#俺}{F#私}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "浮錦が前に言ってた話だと、この仙力を「祀{RUBY#[D]スーロン}瓏」に注げるはずだ。そうすれば来年の翹英荘はきっと大豊作だろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390506,
					"content": "その時には、羅おじにたーーーーっくさんごちそうを用意してもらおう！そうだな、たとえば茶葉のお菓子に、仔鳩、大肉団子の醤油煮、蜜汁チャーシュー、それからそれから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390507,
					"content": "そうだ、沈玉茶もな！覚えておかないと…ん？だ、誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390508,
					"content": "ふ、浮錦！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390509,
					"content": "ふふっ、すまんの、驚かしてしもうたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390510,
					"content": "人の姿に戻れるようになったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390511,
					"content": "そうじゃ。コホン…言うたじゃろ、そんな大したケガではないから、しばらく休めば一番気に入っとる姿に戻れるとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390512,
					"content": "#おぬしらには感謝するぞ。我が休んでおる間、祀{RUBY#[D]スーロン}瓏のためにこうも多くの仙力を集めてくれた。{NICKNAME}とパイモンは来年の豊作のために誰よりも貢献してくれたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390513,
					"content": "#フフン、この{M#坊ちゃんには朝飯前だよ}{F#お嬢様には朝飯前ね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "人の姿を取り戻したってことは、もう真っ暗な場所に閉じこもる必要もないだろ？これからなにかしたいことはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390516,
					"content": "うむ…具体的にはまだ考えておらん。ひとまずはこの辺を歩いてみるかの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390517,
					"content": "今の茶を味わい、今の芝居を見て、今の人々に会う…ふふ。「今」を強調してばかりですまんの。嫌われ者の堅物老人のようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390518,
					"content": "だが「今」という言葉がとても好きなんじゃ。昔はできなかったことが「今」ではできるからのう。過去に実現できなかったこと、たくさんの約束を、「今」ならなせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390519,
					"content": "この後、帰離集へ行ってみて、それから璃月港へ行き、彼女たちが言う愛らしい人々というのを見てみたい。それに薬君にも会いたいのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390520,
					"content": "連れて行ってあげようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "だな、浮錦はこう言ってたろ？「清水を長時間離れることはできない」「仙家の茶釜がないと遠い所へは行けない」とかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390522,
					"content": "ふふっ…覚えていてくれた上に、助けを申し出てくれるとは感謝するぞ。じゃが、ひとまずは沈玉の谷でしばらくゆっくりしたい。我が家の景色をしっかりと楽しむのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390523,
					"content": "遠出に関しては、そうじゃな…うむ、マオが大きくなるまで待つことにしようかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390524,
					"content": "長すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711390525,
					"content": "冗談じゃよ！とにかく、まずしばらくはここに留まるつもりじゃ。霊淵も一緒に出掛けないかと、ついでに誘ってみようかの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390526,
					"content": "#そうじゃ、{NICKNAME}！おぬしが去る前にもう一つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390527,
					"content": "霊淵も我も、おぬしらには多大な面倒をかけた。我の仙力も少しは回復したことだ。心からの祝福を贈らせておくれ。おぬしらのこの先の旅路が順調であることを願って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390528,
					"content": "ふふっ。よし！これでもう何も心配はないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390529,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#では今一度…ありがとう、{NICKNAME}にパイモン。我のため、沈玉の谷のためにしてくれたことすべてに感謝を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390530,
					"content": "特に変化はないような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "何しろ「福運」とはすぐに目に見えて現れるものではないからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390514,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#さすが{NICKNAME}{M#坊ちゃん}{F#お嬢様ね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "おい！もうずいぶん経ってるだろ。いい加減、そのおかしな話し方はやめろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7113906,
