			},
			"dialogs": [
				{
					"id": 711390601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390602,
					"content": "霊淵、どうしたのじゃ？そんなにじっと見つめて、我の体に変な物でもついておるかの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390603,
					"content": "妾はただ…いや、何でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390604,
					"content": "汝と蛇が共に頼んだとしても、妾は二度と人間の姿にはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711390605,
					"content": "ふふ、そんなこと頼んだことがなかろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390606,
					"content": "…まあよい。行こう。茶畑の今の姿を見に行くのではなかったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霊淵"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
