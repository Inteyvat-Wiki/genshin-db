			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エウルア",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220701,
					"content": "これね、追っている間にコピーを作られたかどうかまでは分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220702
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220702,
					"content": "少なくとも、彼らの操り人形である伯父さんがいなければ、モンドに攻め入ることも容易にできないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220703
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220703,
					"content": "ファデュイがおまえの伯父さんを頼る必要なんてあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220704,
					"content": "確かに、でも操り人形を通してモンドを支配するのではなく、単純に攻めるだけならこんな回りくどいやり方をしていなかったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220705
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220705,
					"content": "いかにファデュイでも、今すぐ攻め込んでくるとは思えないわ。そうなったら、彼らの相手はモンドだけにとどまらないもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220706,
						101220707
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220706,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}もそう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				},
				{
					"id": 101220708,
					"content": "とりあえずこのことは、私から代理団長に報告しておくわ。きっと彼女がきちんと処理してくれるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220709
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220709,
					"content": "ところで、どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220710
					]
				},
				{
					"id": 101220710,
					"content": "そうだぞ、現れるタイミングがバッチリだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220711,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220712
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220712,
					"content": "以前、私の追っていたファデュイを君たちに撃退されて、手柄を奪われたでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220713
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220713,
					"content": "だから今回は君に復讐するために来たのよ。手柄を奪われたのなら、奪い返すってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220714,
						101220715
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220714,
					"content": "やっぱり「復讐」のためだったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220716,
					"content": "へへっ、ここまで長い時間一緒にいると、おまえの話もだんだんと分かってくるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220717,
					"content": "本当は薄々気づいてたんだろ。こっちになにかトラブルが起きるかもしれないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220718,
					"content": "それでオイラたちとおまえの伯父さんを心配して、小隊を引き連れて来たってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220719,
					"content": "復讐しに来たの！勝手に私の意思を曲げないでちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220720
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220720,
					"content": "ふんっ、でも小さいの、見た目は賢くなさそうなのに、意外と頭が働くわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220721
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220721,
					"content": "この恨み、覚えておくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220722
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220722,
					"content": "見た目は賢くないって、どういうことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220723,
					"content": "二人とも、これで私たちは深いかたき同士になったわね、覚えてなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220724
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220724,
					"content": "君たちが灰になっても、絶対に忘れないんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220725
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220725,
					"content": "これからは「かたき同士」だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220726
					]
				},
				{
					"id": 101220726,
					"content": "おう、かかってこい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220727,
					"content": "あははっ、その意気よ。じゃあ私は地図を騎士団に持って帰るから、後のことは私に任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220728
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220728,
					"content": "おう、また会おうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220729,
					"content": "もちろんまた会えるわ。次会う時、私をがっかりさせないでよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220715,
					"content": "じゃあ、これでチャラだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220707,
					"content": "それだと本末転倒だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				}
			]
		},
