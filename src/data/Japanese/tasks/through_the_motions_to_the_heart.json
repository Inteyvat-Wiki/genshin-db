			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シューベルト",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220301,
					"content": "おや？どうしてマスクを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220302,
						101220303
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220302,
					"content": "知らない人に見られたくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				},
				{
					"id": 101220304,
					"content": "そうだな、あやつらの実力が相当なものであろうとも、モンドにおいては我々の地位の方が上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220305
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220305,
					"content": "そうなれば、確かに容易に正体を晒すべきではないな、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220306
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220306,
					"content": "おまえの機転が効いたおかげで、怪しまれずに済んだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220307,
					"content": "では引き続き進もう、彼らには貴様が私の客人であると説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220303,
					"content": "これこそ貴族の礼儀作法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				}
			]
		},
		{
			"id": 1012204,
			"completionStepIds": [
				1012207
