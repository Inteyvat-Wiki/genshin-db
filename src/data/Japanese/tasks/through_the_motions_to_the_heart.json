				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220601,
					"content": "離せ！自分で歩ける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220602
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220602,
					"content": "どうやら間に合ったようね。確かにファデュイがたくさんいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220603
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220603,
					"content": "あれっ、君もここにいたの。調査は終わった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220604,
						101220605
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220604,
					"content": "楽勝だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				},
				{
					"id": 101220606,
					"content": "まさか、こやつの礼儀作法は全部お前が教えたのか？しかし、お前はそんなこと気にもしていなかったはずだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220607
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220607,
					"content": "それに、一族の仕来たりを部外者に教えるなど言語道断！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220608
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220608,
					"content": "あぁ、そんなこともあったっけ。それで？そうしちゃいけない理由でもあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220609
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220609,
					"content": "お…お前は一族のタブーを犯した！私がずっと準備してきた計画を台無しにしたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220610
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220610,
					"content": "伯父さんが凄く力を注いでいたのは分かっているわ。でもこれはやってはいけないこと、もちろんそれくらい知っているはず。西風騎士として、見過ごすわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220611
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220611,
					"content": "まだ西風騎士などと…たわけが！いいか、私はお前の伯父だ！お前はローレンス家の人間で、一族の栄光を取り戻すことに専念すべきなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220612
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220612,
					"content": "今ならまだ許しを請うチャンスをやろう。そこの西風騎士を全員やっつけて私と来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220613
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220613,
					"content": "そうすればお前のために話を通し、やり直す機会を与えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220614
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220614,
					"content": "ちょっと意味が分からないわ。西風騎士に西風騎士をやっつけろって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220615
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220615,
					"content": "もう一度言う、お前は西風騎士などではない、我ら一族の末裔だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220616
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220616,
					"content": "ローレンス家の血が流れている貴族だ！一族の意志に従わなければならない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220617
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220617,
					"content": "…でも、今の今まで、私がいつ一族の意志に従ったというの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220618
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220618,
					"content": "お、お前…！大逆無道な奴め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220619
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220619,
					"content": "怒るべきなのは私の方だと思うけど。自分がローレンス家の一員であると知りながら、モンドの安全を脅かすことをしようとしているなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220620
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220620,
					"content": "一体どれほどの人に迷惑をかけるか、そしてこの事を鎮めるために私がどれほどの人から恨みを買うか、考えたことある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220621
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220621,
					"content": "私に説教しようというのか！？この私に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220622
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220622,
					"content": "そうよ、説教しているの。伯父さんが最も大切にしているローレンス家の名においてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220623
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220623,
					"content": "私は伯父さんが言っていた「栄光」の時代を経験したことがない。それに対する一族の強い固執も理解できないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220624
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220624,
					"content": "それでも物事の良し悪しを判断するくらいの能力はある。「自由」がモンド人にもたらす意義もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220625
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220625,
					"content": "——ローレンス家は、絶対に、伯父さんが考えているようにはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220626
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220626,
					"content": "くっ、くぅ…ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220627
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220627,
					"content": "なんておぞましいんだ！一族の恥晒しめ！よもや一族にお前みたいな大逆無道な化け物が現れるとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220628
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220628,
					"content": "情緒不安定になってるぞ。優雅さの欠片もないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220629,
					"content": "何を言っているか分からないわ。彼を連れて行ってちょうだい。私と栄誉騎士はまだやるべきことがあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220630
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220630,
					"content": "君たちが動いたということは、もう決定的な証拠を掴んだということでいいのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220631,
						101220632
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220631,
					"content": "ファデュイは城の防衛地図を持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220633,
					"content": "さっきこっそり見たんだけど、おまえの伯父さんが西風騎士の見回りルートと色んな情報を全部地図に書き込んでたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220634,
					"content": "はぁ、ただの自堕落な中年かと思っていたけど、まさかここまで執着していたなんて。この一件はしっかり覚えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220635
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220635,
					"content": "ひとまず、その地図を回収しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 101220632,
					"content": "ファデュイは危ないことを計画してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220633
					]
				},
				{
					"id": 101220605,
					"content": "展開が早すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220606
					]
				}
			]
		},
		{
			"id": 1012207,
			"completionStepIds": [
				1012214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012214",
							"2"
						],
						"stepId": 1012214,
