			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"セルゲイ",
					"シューベルト",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220501,
					"content": "（こいつ、どこかで会ったような…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220502
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220502,
					"content": "こいつは？信用できない者を勝手に連れて来るのはやめてもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220503
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220503,
					"content": "#私の新たな盟友だ。ローレンス家の名に誓って、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}を信じてもらって構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220504,
						101220505
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220504,
					"content": "よろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220506
					]
				},
				{
					"id": 101220506,
					"content": "我々の計画は機密なんだ。部外者を参加させるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220507
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220507,
					"content": "それに最近、騎士団に外の人間が加入したと聞く、モンド周辺で活発に行動しているらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220508
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220508,
					"content": "#それは有り得ない。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は旧貴族の礼儀作法にも詳しい、私も{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}に敬意と信頼を表す必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220509
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220509,
					"content": "騎士団の人間はこの種のことを否定し続けてきた。こんなにも完璧に礼儀作法を弁えるなど絶対に不可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220510
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220510,
					"content": "その小さいのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220511
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220511,
					"content": "オイラが…どうかしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220512,
					"content": "もういい！私の言うことすら信用出来なくなったのか？誰のおかげでモンドで行動できているのか忘れたわけじゃないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220513
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220513,
					"content": "ローレンス家の支援がなければ、とっくに騎士団に追い出されていただろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220514
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220514,
					"content": "貴様は私の友を侮辱した、今すぐ心から詫びてもらう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220515
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220515,
					"content": "ちぇっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220516
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220516,
					"content": "分かった、あんたがそこまで言うなら、もう何も言うまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220517
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220517,
					"content": "本題に入ろう。約束していたモンド城の防衛地図は持ってきたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220518
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220518,
					"content": "（えぇ！さっそくそんな生々しい取引を！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220519,
					"content": "ああ、当然ここにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220520
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220520,
					"content": "どれどれ…えっと、なんでこんなに見づらいんだ？線がくねくねしている…それにこの四角や丸はなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220521
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220521,
					"content": "何だと？それは私が長時間かけてコツコツと描いたものだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220522
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220522,
					"content": "それにそれは四角や丸ではない！西風騎士を表すマークだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220523
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220523,
					"content": "はぁ、まあいい。見づらいが、どうにか理解はできる。この情報が正しいという保証はあるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220524
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220524,
					"content": "当然だ、安心するがいい。それと、ローレンス家の旗を騎士団本部の屋上に掲げる約束を忘れるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220525
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220525,
					"content": "あの建物の所有権、並びにこの街全体の管理権はローレンス家の物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220526
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220526,
					"content": "ああ、互いに利のある取引なんだ、利益の駆け引きをするつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220527
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220527,
					"content": "この情報は存分に使わせてもらう。そうだ、外交に影響を及ぼさないためにも、如何なる場合でも我々の身分を明かさないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220528
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220528,
					"content": "安心しろ、このことは私と貴様、そして私の友人のみが知ることだ。他には誰もいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220529
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220529,
					"content": "その時が来たら私は騎士団本部の屋上から、モンドに対する奴らの軟弱な統治を批判してやる。全ての市民は今一度このローレンスに屈服するのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220530
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220530,
					"content": "クッハハハ、帰ってきた、私は帰ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220531
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220531,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220532
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220532,
					"content": "最後に一つだけ忠告だ。軽率な行動はよせ。ではこれで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220533
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220533,
					"content": "ではこれで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220534
					]
				},
				{
					"id": 101220534,
					"content": "ではこれで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220535,
					"content": "急にどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220536,
						101220537
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220536,
					"content": "もう隠す必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220538
					]
				},
				{
					"id": 101220538,
					"content": "#モンド城西風騎士団栄誉騎士{NICKNAME}、そしてその最高の仲間、パイモン！おまえたちの邪悪な計画を、打ち砕きに来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220539,
						101220540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220539,
					"content": "…誇張しすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220541
					]
				},
				{
					"id": 101220541,
					"content": "わ、私を騙したな！我々が誇る礼儀作法と優雅さで、私の信頼を騙し取ったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220542
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220542,
					"content": "そういうことを盲目的に信頼する方が悪いんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220543,
					"content": "長きに渡り計画してきたのに、こんなことでバレるなど…待っていろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220544
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220544,
					"content": "はぁ、やはりこうなったか。最初からこんなバカな貴族を信用すべきじゃなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220545
					],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220545,
					"content": "しかし、情報は確かに手に入れた。時間を無駄にはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セルゲイ"
				},
				{
					"id": 101220540,
					"content": "そんなに大げさにしなくていい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220541
					]
				},
				{
					"id": 101220537,
					"content": "正体を明かそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220538
					]
				},
				{
					"id": 101220505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220506
					]
				}
			]
		},
		{
			"id": 1012206,
			"completionStepIds": [
				1012212
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
