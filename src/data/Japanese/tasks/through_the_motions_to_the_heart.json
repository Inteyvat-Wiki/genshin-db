			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダレル",
					"シューベルト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220401,
					"content": "待った、この者たちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220402
					],
					"speakerTitle": "ダレル"
				},
				{
					"id": 101220402,
					"content": "話す必要はないと思うが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220403
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220403,
					"content": "私が連れてきたんだ、客人に決まっているだろう。客人に無礼を働けば、ローレンス家からの咎は避けられないと思え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220404
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220404,
					"content": "しかし、このことは機密中の機密。用心に越したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220405
					],
					"speakerTitle": "ダレル"
				},
				{
					"id": 101220405,
					"content": "貴族の行いを貴様が指図するな。これ以上の無駄口は御免だ、道を空けろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220406
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220406,
					"content": "偉そうに…こいつに何ができるって言うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220407
					],
					"speakerTitle": "ダレル"
				},
				{
					"id": 101220407,
					"content": "分かった、入れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダレル"
				}
			]
		},
		{
			"id": 1012205,
			"completionStepIds": [
				1012209,
				1012217
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
