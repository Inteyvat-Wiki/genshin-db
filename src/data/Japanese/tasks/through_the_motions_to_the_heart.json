			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"シューベルト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220101,
					"content": "（テントはボロボロだけど、すごく立派な椅子が一つだけある…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220102,
					"content": "（これも貴族のこだわりの一つなのか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220103,
					"content": "また貴様たちか？しつこいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220104,
						101220106
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220104,
					"content": "貴族は寛大だと聞きました。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220105
					]
				},
				{
					"id": 101220105,
					"content": "「寛大」…悪くない。ふむ、そうだとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220108,
					"content": "いいだろう、私も心が狭いわけではない、以前の無礼は水に流そう。何か話があるのであれば、聞いてやらなくもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220109
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220109,
					"content": "（うわっ、すっごく上から目線だ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220110,
						101220112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220110,
					"content": "その前に、抗争の意志をお見せします。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220111
					]
				},
				{
					"id": 101220111,
					"content": "なるほど、同志であったか。「抗争」——即ち無能な騎士団に抗うこと。貴様、大義を弁えておるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220114,
					"content": "いいだろう、元から私の本意は貴様の品格を試すこと。やはり、貴様もその道を歩む者であったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220115
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220115,
					"content": "（試してたのかよ！？回りくどいやつだな！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220116,
					"content": "ふむ、礼儀作法については合格だ。この短期間でよもやここまで進歩するとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220117
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220117,
					"content": "その言葉遣い、一体どこから学んだのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220118,
						101220119
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220118,
					"content": "貴族の方からの教え。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220120,
					"content": "なるほど、聡明だな。モンドの愚民どもと比べ、実に逸材である。貴族の血統であれば無限の未来があったはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220121
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220121,
					"content": "そうだ、オイラたち手土産を…えっと、ゴホンッ…些細な贈り物を、どうぞ、受け取って…ください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220122,
					"content": "なんと、これは…「漬け野菜肉炒め」！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220123
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220123,
					"content": "外面を取り繕っただけでなく、しっかりと内面も磨いてきたか。今の若者でも、やろうと思えばできるではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220124
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220124,
					"content": "ちょうど長いこと食べていなかっ…いや、ゴホンッ、食事の時間だ、ありがたく頂く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220125
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220125,
					"content": "あぁ、香ばしい。やはりこの味だ、変わっていない。この酸っぱさ——これこそが、貴族にのみ理解できる味である。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220126
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220126,
					"content": "ほぅ…そんなに言われると味が気になってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220127,
					"content": "いいだろう、貴様たちの誠意は受け取った。ここまでしたのは、何か私に用事があるからなのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220128
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220128,
					"content": "ローレンス家が計画を練ってると聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220129
					]
				},
				{
					"id": 101220129,
					"content": "そこまで知っているのか？それは我々一族の機密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220130,
						101220131
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220130,
					"content": "助力したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220132,
					"content": "ふむ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220133
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220133,
					"content": "いいだろう。その礼儀作法、将来有望な逸材であることは間違いない。信頼に値すると見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220134
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220134,
					"content": "では私について来い、ちょうど今人手が必要だったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220135
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220135,
					"content": "どこに行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220136
					]
				},
				{
					"id": 101220136,
					"content": "遠方から来た友に会いに行く。彼らならローレンス家の栄光を取り戻す手助けをしてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220137
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220137,
					"content": "礼儀作法だけでオイラたちを信用したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220138,
						101220139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101220138,
					"content": "やっぱり少し警戒しよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220140,
					"content": "さあ、ついて来い。それで何もかも分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220139,
					"content": "これが旧貴族の「こだわり」なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220131,
					"content": "貴族のためにこの些細な力を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220119,
					"content": "友から教わり、理解し、応用した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220112,
					"content": "この一会は、まるで光を浴びるかのよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220113
					]
				},
				{
					"id": 101220113,
					"content": "なるほど、同志であったか。「光」——即ち貴族の栄光。貴様、実に忠義であるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "シューベルト"
				},
				{
					"id": 101220106,
					"content": "つかぬことをお伺いしますが。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220107
					]
				},
				{
					"id": 101220107,
					"content": "「つかぬこと」…悪くない、相応しい言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "シューベルト"
				}
			]
		},
