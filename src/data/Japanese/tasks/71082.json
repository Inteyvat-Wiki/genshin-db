			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「唐無仇」と自称する者"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "ん？どうした、また臭の宝掘りゲームに騙されたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820102,
					"content": "言ったはずだろう、あの宝掘りは、<color=#00E1FFFF>良いものほど、周りにあるタル爆弾の数が多いんだ。逆に言えば、悪いものほど周りが安全ってわけだ。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820103,
					"content": "今度こそ覚えたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「唐無仇」と自称する者"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「唐無仇」と自称する者",
					"何爺",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "宝盗団の残党め、ふっ…最近キノコが食べられなかったせいで、体の具合が芳しくないんだ。そうでなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820202,
					"content": "お前なんざ、とっくに殴り倒していたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820203,
					"content": "この老いぼれた賊め、俺が植えた琉璃…じゃなくて清心のことをキノコと言って、いきなりそれらを口に入れるだなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820204,
					"content": "コホンッ…一体、一体何の理由があってそんなことをするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820205,
					"content": "あっ、何爺に侠客、なんでケンカしてるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820206,
					"content": "お、俺はキノコ肉を探してて。だが、彼らは俺を鉱区に入れてくれないんだ。だから、俺はここへ来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820207,
					"content": "やっとのことでここにキノコが生えてることに気付いたのに。手を伸ばした途端、攻撃してきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820208,
					"content": "#我が古華派後継者の修行場に侵入してくるとは。この花は俺以外には、英雄の{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820209,
					"content": "それと英雄のパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820210,
					"content": "それと英雄のパイモン、俺たち三人以外、誰にも手を出すことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820211,
					"content": "宝盗団の残党め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820212,
					"content": "老いぼれた賊め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820213,
					"content": "まあまあ、何爺、唐無仇はもう足を洗って、宝盗団の仕事はしないんだ。それに、彼が植えたのはキノコじゃくてお花だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820214,
					"content": "ん？そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820215,
					"content": "よく見ろよ、これは清心だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820216,
					"content": "はぁ、本当に清心だったのか。やっぱり少しめまいがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820217,
					"content": "それに唐無仇、まさかおまえ、まだ琉璃百合大花園を作ろうとか、思ってないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820218,
					"content": "ここで大きな琉璃百合大花園を作る。素晴らしい景色になると思わないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "「唐無仇」と自称する者"
				},
				{
					"id": 710820219,
					"content": "もうケンカするなよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710820220,
					"content": "はぁ、行くとするか、キノコもないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710820221,
					"content": "あの厄介者がいなくなって、やっと花を植えることを研究できるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「唐無仇」と自称する者"
				}
			]
		}
	]
}