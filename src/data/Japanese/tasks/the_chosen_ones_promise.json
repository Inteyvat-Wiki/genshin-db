			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380102,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#よかったぞ。{NICKNAME}がな…えっと、うまく言えないけど、夢の中で{REALNAME[ID(2)|SHOWHOST(true)]}が変なやつと一緒にいるのを見たんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380104,
					"content": "天蛇の船で変なやつに会わなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380105,
					"content": "ウ…ウルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "えっ？どっちなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380107,
					"content": "キュ…キュキュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "うーん、さっぱりわからないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380109,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}が無事ならそれでいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "そうだな。でもポーナは？あいつはどこ行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380111,
					"content": "キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "はぐれちゃったのか？それともポーナって本当に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380113,
					"content": "ポーナは物語の登場人物なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "そうか…そうだよな。普通の人間は何百年も生きられないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380115,
					"content": "でも、少なくとも彼女の冒険をやり遂げた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "おう、今回の冒険をしっかりアピールしてやるって約束したからな。オイラたちが天蛇の船を見つけたって情報が知れ渡ったら、きっとポーナも有名な冒険者になれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380117,
					"content": "次は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "次は火山に行って「あの人」を探そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "どういうことかきっちり調べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380120,
					"content": "なあ、あいつが「盗炎の賢者」だったりしないか？これまではいつもあいつがメッセージを残してくれただろ。ますます気になってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380121,
					"content": "色んなやつに化けられるって言ってたし、たとえ会ってもわからないかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380122,
					"content": "グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#やっぱり{REALNAME[ID(2)|SHOWHOST(true)]}も気になるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380124,
					"content": "#よし、象徴物もそろったし、みんなで火山に行って、すべての秘密を解き明かそう。{REALNAME[ID(2)|SHOWHOST(true)]}の呪いを解いてやるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751380125,
					"content": "ごめんな、ポーナ。「通牒の金盤」はオイラたちがもらってくぞ。全部わかったら、おまえにも教えてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
