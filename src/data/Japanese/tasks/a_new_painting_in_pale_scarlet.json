			},
			"dialogs": [
				{
					"id": 400570401,
					"content": "まだ時間があるけど、これからどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570402,
					"content": "皆さん、ここにいらしたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570403
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570403,
					"content": "あれ、綾華と吟遊野郎じゃないか…なんでおまえたちが一緒にいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570404,
					"content": "実は先ほど、容彩祭会場で開かれる生け花稽古場の手配をしていたのですが、花器から奇妙な紙切れを見つけたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570405
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570405,
					"content": "そのとき、こちらの吟遊詩人の方がそばにいらっしゃって。ここ数日、似たようなものを他にも見つけているのだと聞き、二人で貴方がたを探していたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570406
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570406,
					"content": "でもこのお嬢さんが見つけた紙切れは、ボクたちが前に見つけたものと、ちょっと違うんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400570407,
					"content": "こちらです、ご覧ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570408
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570408,
					"content": "今までのは詩の長さもみんな同じくらいだったのに、今度のは二言で終わってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570409,
					"content": "短い二言だけど、タイトルの横に書かれている訳でもなければ、紙の真ん中に書かれているという訳でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570410
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570410,
					"content": "この字の配置はまるで、この二言以外に、紙にはまだ他の内容があると告げているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570411
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570411,
					"content": "この詩を言葉通りに解釈すると、「紙を水に入れれば、真実が自ずと浮かび上がる」となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570412
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570412,
					"content": "それで一つ思い出したんだけど…僕の家には古代の不思議な話をまとめた古い書籍があるんだ。その本によると、水に触れると現れ、乾くと消える特殊な墨汁があるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570413
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570413,
					"content": "じゃあ、試してみる？ちょうどこの近くに池があるみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
