	"talks": [
		{
			"id": 4005701,
			"completionStepIds": [
				4005703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005703",
							"2"
						],
						"stepId": 4005703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "旅人にパイモン、元気にしていたでござるか。容彩祭には道案内の者がいると聞いたが、まさかお主らであったとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570102,
					"content": "えへへ。オイラたちも、まさか万葉が、容彩祭の客人として稲妻に帰ってくるなんて思わなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570103,
					"content": "実を言うと、招待状をもらった時は、拙者も不思議に思った。しかし長く外を流離っていたゆえ、この機に故郷に帰り、故人を偲ぶのもいいと考えたのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570104,
					"content": "万葉、さっき遠くからおまえを見かけたとき、なにか探してるみたいだったけど、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570105,
					"content": "先程みなと共に船を降りた時、突然近くにとても軽い足音を聞いたのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570106,
					"content": "あれは決して一般乗客の足音ではなかった。しかし拙者が振り返った時、その者はすでに消えており…残ったのは、桟橋から聞こえた「ポツン」という音のみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570107,
					"content": "相手の姿は見えなかったが、足元に奇怪な紙切れを見つけたのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570108,
					"content": "その紙って、もしかして詩が書かれていたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570109,
					"content": "おや、どうしてそのことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570110,
					"content": "ここ数日で起きたことを万葉に伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "よもやそのようなことが起きていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570112,
					"content": "万葉、紙を見せてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "うむ、もちろんでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570114,
					"content": "このまえ見た葵の翁の詩では、最後に「赤人」のことが書いてあったけど…やっぱり今回のは赤人についての物語みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570115,
					"content": "えっと、つまり——赤人は赤色の印章を使うのが好きだったから、この雅号になった。だけど、盗作行為が将軍にバレてしまって追放された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570116,
					"content": "なんて言うか、今回の物語はなんだか不吉だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570117,
					"content": "今までのも良かったとは言えないけどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "拙者は別に良くない物語だとは思わないでござるよ。拙者もかつては幕府の指名手配人であった。赤人と大して変わらぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570119,
					"content": "この物語の赤人は悪いことをやったんだから、将軍に追放されたのは自業自得だ。万葉とは全然違うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570120,
					"content": "おまえはどう思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570121,
					"content": "物語に出てきた「印章」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "うむ。先程、署名を書くのが遅いことを悩んでいる友人がいると話していたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570124,
					"content": "璃月と稲妻においては、確かに「印章は署名に相当する」と言われている。これは良い方法になるやもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570125,
					"content": "船で海を渡っていた頃、暇つぶしに彫刻などをしていたでござる。もしも印章を作るのであれば、拙者も力を貸せるであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570126,
					"content": "おお、やったな！じゃあ早速、アルベドに相談しに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570122,
					"content": "行秋の助けになるかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
		{
			"id": 4005702,
			"completionStepIds": [
				4005704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005704",
							"2"
						],
						"stepId": 4005704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "アルベド、行秋を手伝う方法を見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570202,
					"content": "先程の話をアルベドに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "やはり五歌仙の物語はまた現れたか…そんな方法まで一緒とは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570204,
					"content": "印章…ふむ、そうだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570205,
					"content": "確かに効率の高そうな方法だね。それなら、行秋は筆跡の問題に悩まなくて済む。しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570206,
					"content": "「しかし」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "行秋は以前、すでにサインを読者に公開したことがある。もし今回の新刊で印章を使えば、誠意が足りないと思われてしまうんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570209,
					"content": "ボクにもう一つ、考えがある。もちろん印章もそのうちの一部だ。今から烏有亭へ向かい、みんなと相談してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570207,
					"content": "何か問題でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
		{
			"id": 4005703,
			"completionStepIds": [
				4005706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005706",
							"2"
						],
						"stepId": 4005706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570301,
					"content": "さあ、頑張ってください、枕玉先生！今日書かれた字は目まぐるしい進歩を遂げています。きっと昨日の特訓が効いたんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570302
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570302,
					"content": "うぅ…だめだ、もう腕が上がらない…こうなることが分かっていれば、今までも書道の授業で小説を読んだりしなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570303
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570303,
					"content": "先ほど10分も休憩したところですよ、もう少し頑張ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570304
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570304,
					"content": "主任…さすが我々の中で最も恐ろしい原稿催促をするお方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570305
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570305,
					"content": "ええ、道理で八重様は面倒な作者に対して、いつも最後には主任を出向かせるのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570306
					],
					"speakerTitle": "村田"
				},
				{
					"id": 400570306,
					"content": "恐ろしいぜ…ちょっと見ない間に、行秋がまるで魂の抜け殻みたいな感じになっちゃってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570307,
					"content": "編集主任、実は先程いい方法を見つけたんだ。みんなが直面しているこの苦境から、抜け出せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570308
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570308,
					"content": "璃月と稲妻では印章が広く使われていて、一般的にサインと同等のものとして扱われる。この考えを応用すれば、サインをより簡単にすることができるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570309
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570309,
					"content": "もちろん、印章だけでは不十分だ。だから、二つの要素でサインを構成するのはどうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570310
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570310,
					"content": "まずは個人の印章、これは枕玉先生のサインを模型にして作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570311
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570311,
					"content": "同時に、ボクが枕玉先生に美しくかつ書きやすいものをデザインする。先生は、それぞれの小説にそのデザインを書くだけでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570312
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570312,
					"content": "そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570313
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570313,
					"content": "ええ、この方法なら問題ないでしょう！作者の直筆も入っていますし、見た目も間違いなく良いものになりそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570314
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570314,
					"content": "本当か？つまり、僕は助かったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570315,
					"content": "主任、思ったんですが、以前現場でのサイン販売を諦めたのって、作家先生のサインに時間がかかってしまうことを考慮したからですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570316
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570316,
					"content": "ですがこの形でのサインなら、現場でサイン販売ができるんじゃないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570317
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570317,
					"content": "それに、すべての作家先生がこの形を採用すれば、枕玉先生のサインだけが浮いてしまうという事態も防げるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570318
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570318,
					"content": "ああ。キミたちさえよければ、ボクも喜んで他の作家先生にサインをデザインしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570319
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570319,
					"content": "印章の彫刻は、拙者に任せるでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570320
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570320,
					"content": "それでは今から、新刊即売会に出席される他の二名の作家先生に、連絡して参ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570321
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570321,
					"content": "暫くすると、二名の作家がやって来た…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570322
					]
				},
				{
					"id": 400570322,
					"content": "白亜先生にサインを作っていただけるなんて、光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570323
					],
					"speakerTitle": "聡美"
				},
				{
					"id": 400570323,
					"content": "俺の筆名は複雑だから、サイン販売には向かなかったんだ。これでやっと夢が叶う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570324
					],
					"speakerTitle": "勘解由小路家健三郎"
				},
				{
					"id": 400570324,
					"content": "よかった、みんなこの案に賛同してくれたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570325,
					"content": "何日にも渡って、枕玉先生にはご苦労をお掛けしてしまい、本当に申し訳ございません。どうぞごゆっくりお休みになってください。後の事は、我々にお任せを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570326
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570326,
					"content": "すでにサインの終わった小説については、今後八重堂のイベントで、特別特典として使わせていただきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570327
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400570327,
					"content": "ふぅ…これでやっと…解決ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570328
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400570328,
					"content": "みんなのおかげで、僕も小野寺さんも苦境から抜け出すことができたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570329
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400570329,
					"content": "えへへ、やっと自由になれたな。外に行って新鮮な空気でも吸ってこいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
