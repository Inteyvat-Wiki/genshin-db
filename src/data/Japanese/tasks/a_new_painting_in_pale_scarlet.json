			},
			"dialogs": [
				{
					"id": 400575101,
					"content": "小野寺さん、後で即売会の変更を八重様に報告してきてください。この案なら、きっと八重様も気に入ってくださいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575102
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575102,
					"content": "あなたは頭の回転が速い。あとはもう少し落ち着いて行動を取れるようになれば、きっと将来は大事を成せるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575103
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400575103,
					"content": "ありがとうございます、主任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400575104
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400575104,
					"content": "これが俗に言う「災い転じて福となす」ってことかな？新刊即売会が「サイン即売会」になるなんて、読者の人たちもきっと喜ぶよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "村田"
				}
			]
		}
	]
