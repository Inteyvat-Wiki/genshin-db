			},
			"dialogs": [
				{
					"id": 400570501,
					"content": "紙切れをおそるおそる水の中に入れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570502
					]
				},
				{
					"id": 400570502,
					"content": "おお、見ろ！紙に文字がたくさん浮かんできたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570503,
					"content": "なにが書かれてるか見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570504,
					"content": "えっと…墨染が赤人の歌集を手に入れ、歌集を小川に浸した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570505,
					"content": "すると、盗作だと言われていた歌の筆跡が溶け出していった…ん？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570506,
					"content": "印刷技術がまだ発達していなかった過去の時代では、手書きの文字は湿気によって簡単に滲んでしまうものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570507
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570507,
					"content": "ですので文字を長く保つため、特殊な墨汁で書くか、書いた後に防水の塗料を塗っていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570508
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570508,
					"content": "特製の墨汁は作るのが大変でしたし、塗料のほうも楽な方法ではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570509
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570509,
					"content": "それでも、赤人の歌集は将軍様へ献上するための重要なものですから、きっと二つの方法のうちどちらかを使っていたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570510
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570510,
					"content": "しかし、その盗作だと言われていた歌には赤人の印章が無かっただけでなく、水にさらされた時の状態も、もともと紙にあった他の文字とは大きく異なっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570511,
						400570512
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570511,
					"content": "この歌は赤人のものじゃなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				},
				{
					"id": 400570513,
					"content": "じゃあ、赤人は悪いことをしてないのに、誰かに陥れられたってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570514,
					"content": "ああ。これこそが、墨染の物語がボクたちに伝えたかった真実だろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570515
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570515,
					"content": "哀しい物語だったけど、おかげで「赤人」と「墨染」の絵の内容が決まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570516
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570516,
					"content": "万葉、それに綾華。モデルになってくれる気はないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570517,
					"content": "もちろん構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570518
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400570518,
					"content": "拙者もよいでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570519
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400570519,
					"content": "よし！じゃあこれで、一気に二枚の肖像画が描けるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400570520,
					"content": "うん、それに四つの物語が集まった。五歌仙の物語も、これでやっと完成だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400570512,
					"content": "誰かが後から付け足した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				}
			]
