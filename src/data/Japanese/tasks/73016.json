			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランバリカ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "ナラ…と飛んでるヤツ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160302,
					"content": "#そう、オイラが空飛ぶパイモン。こいつは{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160303,
					"content": "おまえがアランバリカだろ？ところで、オイラたちをちっとも怖がらないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160304,
					"content": "金色のナラ…アランパンドゥの気配がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160305,
					"content": "ああ。だってオイラたち、アランパンドゥに言われて来たからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160306,
					"content": "悪意は感じない。アランバリカに手を下したいなら、大鉄塊が動いてた時がチャンスだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160307,
					"content": "確かにな。「アランナラの危機に乗じて」…って、いやいや、オイラたちそんなことしないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160308,
					"content": "どうしてしない？アランバリカが敵なら、挟み撃ちにするのがいいだろう。狩りのときにも使える手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160309,
					"content": "うーん…確かに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160310,
					"content": "パイモン、一本取られたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "…いや、とにかく！オイラたちが「アランナラの危機に乗じる」なんてこと絶対ないんだってば！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160312,
					"content": "だってアランナラは友達だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#そうそう、そうだぞ！アランナラは友達なんだ。オイラと{NICKNAME}が、友達を裏切るような真似、するはずないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160314,
					"content": "フン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160315,
					"content": "あれ…なんで不満そうな顔してるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160316,
					"content": "パイモンの第一印象が悪かったみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "でもオイラ、なんかマズいことやらかしたか？…うーん…アランナラって捉えどころがないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160320,
					"content": "そういえば、アランバリカの「アランラカラリ」は最強だって、アランパンドゥが言ってたぞ。さっきもそれで遺跡守衛を倒したんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160321,
					"content": "パイモンはアランラカラリを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160322,
					"content": "…お、おう！当然だろ！あの…あれだよな！すっごい強い…力みたいなやつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160323,
					"content": "フン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160324,
					"content": "うわぁん！またバカにされた気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160325,
					"content": "そろそろ本題に入ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "うん…オイラたちは、ヴァルナ神器の修理を手伝いに来たんだ。ここにヴァルナ神器の「枝」と「葉っぱ」があるはずなんだけど、見当たらないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160327,
					"content": "「枝」と「葉っぱ」というよりは、「根っこ」といった方が近い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160328,
					"content": "えっ？そうなのか？でもアランパンドゥが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160329,
					"content": "ヴァーナ全体に広がる「根系」があるから、ヴァルナ神器はヴァーナから力を得られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160330,
					"content": "ふーん…言われてみればそうかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160331,
					"content": "それに、「根っこ」は地下にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160332,
					"content": "ここの石や鉄の塊は、アランナラのものじゃない。地下に行きたいなら、まずは鉄塊を倒すことだ。鉄の塊は強いが、金色のナラも弱くはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160333,
					"content": "#当然だろ。{NICKNAME}は今までいっぱい「大鉄塊」を倒してきたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160334,
					"content": "へえ？それなら、アランバリカにもナラの腕前を見せてもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160335,
					"content": "あれ！？土の中に潜っていったぞ…あっ！まさかもう遺跡守衛のとこに行っちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}、早く追いかけようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160318,
					"content": "きっと誰に対してもこんな感じなんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "なんで…？見た目はかわいいのに、扱いづら過ぎるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランバリカ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "大鉄塊は片付いたな。これで、水を流せば地下まで行けるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160702,
					"content": "でも、久しぶりに来たら、何もかもが変わってる。地下にも大鉄塊がいるかもしれない。鉄の臭いがする。嫌な臭いだ。気をつけた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160703,
					"content": "#ナラ{NICKNAME}は強いから大丈夫。でもパイモンは、アランナクラと同じくらい弱い。キノコに食われないように気をつけろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160704,
					"content": "うっ…アランバリカが強すぎるんだよ！今までいろんなアランナラに会ったけど、一撃で遺跡守衛を倒せるヤツなんていなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160705,
					"content": "パイモンはアランナラについて何も知らない。アランダーシャなら、目を閉じて開くだけで大鉄塊をやっつけている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160706,
					"content": "かつて、アランダーシャのアランラカラリは、とてもすごかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160707,
					"content": "かつて？じゃあ今は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160708,
					"content": "今…アランダーシャは、今はもういない。だからアランバリカはもっとアランラカラリを修練しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160709,
					"content": "オイラも「アランラカラリ」が使えたらなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160710,
					"content": "そしたら、戦闘はパイモンに任せるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#へへっ、オイラが{NICKNAME}を守ってやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160712,
					"content": "パイモン、がんばれ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "オイラに全部、どーんと任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160718,
					"content": "パイモンは夢見がち。それがいいことかどうか、アランバリカにはわからない。でも、これから石の装置を探して水を流さないと、地下には行けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160719,
					"content": "アランナラは土に潜れる。でも、水には潜れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730160720,
					"content": "#わかったぞ。じゃあ{NICKNAME}、この辺を探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160714,
					"content": "パイモンには無理だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "やろうと思えば、なんだってできるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730160716,
					"content": "そう言う人って、大抵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "安全な場所でごはんを食べて休憩してから、もう一回アランバリカに教えてって頼んでみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
