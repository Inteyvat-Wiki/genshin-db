			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランバリカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "え…全部壊れてる…？1つも動かないぞ。うわっ、びっくりしたあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161002,
					"content": "ふふんっ、なんだ。ただの錆びた鉄の塊じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161003,
					"content": "今のヴァーナは危険。パイモンも油断したら、ひどい目に遭うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161004,
					"content": "うっ…アランバリカ、手厳しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161005,
					"content": "パイモンが油断しすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "そうか？じゃ…じゃあ、オイラもアランバリカみたいにシャキッとしたら、強くなれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161007,
					"content": "パイモン、他人より自分に厳しくなりなよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "よし、明日から自分に厳しくするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161009,
					"content": "とにかく、石の「枝」はここだろ。次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161010,
					"content": "石を三つ探して、こちらに向ければいいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161011,
					"content": "うっ、先に言われちゃったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161012,
					"content": "そういえば、アランバリカの話し方は、アランパンドゥと全然違うな。比喩をまったく使わないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161013,
					"content": "でもその方が分かりやすい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "確かに、はっきり言ってくれた方が分かりやすいよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161017,
					"content": "アランパンドゥは考えるのが得意。でも、アランバリカにできるのは守ることだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161018,
					"content": "アランパンドゥは昔、ナラヴァルナと一緒にヴァーナを守った。黒くて汚い不吉な泥を追い払って、ヴァルナ神器を治した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161019,
					"content": "#ナラヴァルナはずっと前にいなくなった。ウツァヴ祭にも、きっと{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は来ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161020,
					"content": "アランパンドゥも知っているはず。長い長い時間が経って、一粒の種が天を衝くほどの大木に育った。…ヴァーナを出て行ったナラは、二度と戻ってはこない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161021,
					"content": "でも、アランパンドゥはまたヴァルナ神器を治そうとしてる。ヴァーナのため、ウツァヴ祭のため、そしてナラヴァルナのために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161022,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161023,
					"content": "#アランバリカは、ナラヴァルナに会ったことがない。でも{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}のことは、ヴァーナが知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161024,
					"content": "アランバリカは、アランパンドゥみたいに考えるのは得意じゃない。ただ、アランバリカが強ければアランナラを守れる、ヴァーナを守れる。それだけは分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161025,
					"content": "ナラヴァルナはもういない。でも、アランナラにだってヴァルナ神器は治せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161026,
					"content": "#うんうん！オイラと{NICKNAME}って助っ人もいるしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161027,
					"content": "#ここの鉄の臭いは、どこかおかしい。ナラ{NICKNAME}、頼んだぞ。アランバリカはここで待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161028,
					"content": "アランバリカは一体なにを察知したんだろうな…？まぁ、森のことはアランナラが一番よく知ってるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}、とにかくこの辺に点在する三つの「葉っぱ」を探そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161015,
					"content": "アランナラっぽくないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "でも、「アランナラっぽい」ってなんだ？うーん…分かんないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "パイモン"
				}
			]
		},
