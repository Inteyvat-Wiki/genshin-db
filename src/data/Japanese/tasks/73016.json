			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "ふぅ…びっくりしたぁ。アランバリカがいてくれて助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161502,
					"content": "パイモン、言ったはずだ。油断してると、痛い目に遭う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161503,
					"content": "うっ…オイラが悪かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161504,
					"content": "遺跡「守衛」なんだから、きっと動くはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "確かに。守衛なのに動かないのはおかしいよな？奴らにとって、オイラたちは侵入者なわけだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161506,
					"content": "#ナラ{NICKNAME}とパイモンはヴァーナの侵入者でも、アランバリカは違う。つまりメガトン大鉄塊は分からず屋だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161507,
					"content": "メガトン大鉄塊が分からず屋なら、アランバリカが分からせてやるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161508,
					"content": "うぅ…オイラは物分かりのいい良い子になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161509,
					"content": "約束だよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "当たり前だろ！明日から…いや、今からそうするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161511,
					"content": "#ここの石を覚醒させられるのは、アランナラだけ。ナラ{NICKNAME}、パイモン、あとのことはアランバリカに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161512,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161513,
					"content": "これでヴァルナ神器の修理にまた一歩近づいたな！修理が終わったら、アパーム叢林の中を漂ってる胞子もいなくなる…うっ、考えただけで鼻がムズムズしてきたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161514,
					"content": "ヴァルナ神器は雨水を浄化できる。黒い雨やたくさんの「胞子」とも、お別れだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161515,
					"content": "でもキノコは…生き残るはず。パイモン、油断してるとアランナクラみたいにキノコに食われかけるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161516,
					"content": "おう…気をつけるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730161517,
					"content": "#ここにはもう、アランバリカは必要ない。アランパンドゥのいる「休憩所」に戻る。ナラ{NICKNAME}とパイモンも、一緒に来るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161518,
					"content": "じゃあ一緒に行こうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
				{
					"id": 730161519,
					"content": "ああ。ヴァーナは危険。一緒に行った方が安全だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730161520,
					"content": "他に用がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161521
					]
				},
				{
					"id": 730161521,
					"content": "#ナラ{NICKNAME}、パイモン、油断は禁物だぞ。アランムフクンダ様、どうかこの者たちをお守りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランバリカ"
				}
			]
		},
