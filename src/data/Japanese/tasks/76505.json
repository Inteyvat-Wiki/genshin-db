			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァレサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}さん、パイモンちゃん？奇遇だね～！ナド・クライに向かったとは聞いてたけど、まさかこんなに早く再会できるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050102,
					"content": "オイラも見間違いかと思ったぜ！ヴァレサ、なんでこんな遠くまで来たんだ？もしかして旅行か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765050103,
					"content": "えへへっ、そんなところ！うちの果樹園で使う農機を仕入れるために来たんだぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050104,
					"content": "お父さんがナド・クライにはいいものがたくさんあるって言ってたの。果物をもっと元気に育てられるだけじゃなくって、わたしの仕事も今より楽になるんだってぇ。これでもっとたくさんの時間を睡眠…とトレーニングに使えるよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050105,
					"content": "しかも、ナタにはない美味しいものがたくさんあるって気づいたんだぁ！ここ数日、用事以外の時間はほとんど食事に使ってるよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050106,
					"content": "でも、もうじき帰る日が来ちゃうんだよねぇ。もうちょっと居たいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050107,
					"content": "だから、ラストチャンス！ってことで、まだ食べてないものをもっともっと食べて、見たことのないものを見て回ろうと思ってるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050108,
					"content": "#きみたちは何してるの？よぉし、当ててみるね…無敵の大英雄{NICKNAME}さんのことだし、ここでも正義のために戦ってる、とか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050109,
					"content": "この辺りを見てまわってただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "へへっ、そうなんだ～！わかるわかる、新しい土地に来ると、なんでも新鮮に見えるよね～！面白い場所を全部写真機でパシャパシャって撮りたくなっちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050112,
					"content": "…ああっ！わたしもここで食べた美味しいものを撮っておけばよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050113,
					"content": "そうすれば、ナタに戻ってもアトリーおじさんに再現してもらえたかもしれないのに～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050114,
					"content": "グルメ専門のカメラマンになれそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "へへっ、ほんとぉ？グルメ専門のカメラマン…なんだか素敵だね～！毎日美味しいものと一緒で、それをすっごく魅力的に撮ることを仕事にできるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050116,
					"content": "グルメを撮影する前に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "えっ、わたしを撮りたいの？ほんとにいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050119,
					"content": "わ、わたしの髪、ボサボサじゃない？口元にソースついてないよね？あわわ、今日二人に会うって知ってたら、昨日買ったアクセサリーをつけてきてたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050120,
					"content": "そのままでも可愛いよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "わかった！じゃ…じゃあ、よろしくね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 765050121,
					"content": "ヴァレサの楽しんでるところを撮りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "ヴァレサの写真を撮ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
