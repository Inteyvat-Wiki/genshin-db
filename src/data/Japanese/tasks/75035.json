			"dialogs": [
				{
					"id": 750350101,
					"content": "えっと…もしかして、クラハウ師匠か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350102,
					"content": "確かにそれが私の名前だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "クラハウ"
				},
				{
					"id": 750350103,
					"content": "へへっ、やっぱりおまえが采風をしてるジュエリーマスターだったんだな。オイラたち、イミシュの紹介で来たんだ！さっき、木をじっと見つめてたけど、それも采風の一環なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350104,
					"content": "ええと、実は…いや、今はもうどうでもいいんだ。はぁ、君たちは何か用事でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "クラハウ"
				},
				{
					"id": 750350105,
					"content": "#美しい宝石を持ってきたから、{REALNAME[ID(2)|SHOWHOST(true)]}のために加工してほしいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350106,
					"content": "#へへっ、{REALNAME[ID(2)|SHOWHOST(true)]}、早く宝石を出してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350107,
					"content": "キュー！キュー——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "えっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350109,
					"content": "#鳥の羽ばたく音が聞こえる…\\n気がつくと、{REALNAME[ID(2)|SHOWHOST(true)]}の手から宝石が消えていた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "ウゥ、キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "ほ、宝石は？さっきまであった宝石はどこに行ったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350112,
					"content": "鳥に持っていかれたみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "そんな…！このあたりの鳥は物を盗むのか？礼儀知らずだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350114,
					"content": "キュウ！キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "実は、さっき言おうとしていたのはそのことなんだ。たとえ宝石が盗まれていなくても、加工はできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "クラハウ"
				},
				{
					"id": 750350116,
					"content": "なぜなら、私の道具もその忌々しい鳥たちに盗まれたからね！だからさっきから、どの鳥に道具があるのか、一つ一つ丹念に見ていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "クラハウ"
				},
				{
					"id": 750350117,
					"content": "#そ…そんなことが…？ひどい鳥だな。{NICKNAME}、急いで宝石を取り戻そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350118,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "私の道具も忘れずに——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クラハウ"
				}
			]
		},
