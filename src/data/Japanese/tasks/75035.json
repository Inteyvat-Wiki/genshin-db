			"dialogs": [
				{
					"id": 750350301,
					"content": "いらっしゃい。宝石の加工はもう終わったよ。クラハウ師匠からあなたたちに手渡しするよう頼まれてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 750350302,
					"content": "あれ？クラハウ師匠、今日もいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350303,
					"content": "うん、また采風に行ったよ。ちなみに、道具が盗まれないように、背中に背負える錠を作ったんだって。うーん…うちの彫刻道具を盗んで売ろうとするやつなんて、本当にいるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 750350304,
					"content": "違うぞ！それは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350305,
					"content": "（…待てよ、イミシュはまだ鳥に盗まれたことを知らないのか…じゃあ、師匠の顔に泥を塗るわけにはいかないな！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350306,
					"content": "それは…やっぱりそういう方法で盗もうとするやつがいるんじゃないか…？ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350307,
					"content": "とにかく…宝石はもらっとくぜ！この形、すっごくきれいだな。さすが師匠の作品だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350308,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も気に入ってるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750350310,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}の代わりに礼を言うよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "えへへっ、気に入ってくれて何よりよ。感謝の気持ちはクラハウ師匠にちゃんと伝えとくから、また来てね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イミシュ"
				}
			]
		},
