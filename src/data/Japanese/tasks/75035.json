					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#あれ、ここに戻ってきてから、{REALNAME[ID(2)|SHOWHOST(true)]}が興奮してるみたいだ。なにかオイラと{NICKNAME}に話したいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750351209,
					"content": "キュウ…",
