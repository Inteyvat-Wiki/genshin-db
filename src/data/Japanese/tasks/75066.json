							10047.26
						],
						"pointId": 10048
					}
				]
			},
			"dialogs": [
				{
					"id": 750660501,
					"content": "すぐにここから離れろ。もたもたしていると間に合わなくなるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660502
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750660502,
					"content": "間に合わなくなる？なぜ…？そうだ、冒険団は全滅したんだ。一人残らず…あの漆黒の巨獣に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660503
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750660503,
					"content": "私は、人々を避難させるよう指示されたんだ。せめて皆をここから逃がさないと。「花翼の集」がもうすぐ支援に来るはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660504
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750660504,
					"content": "私が邪悪な魔物どもを倒したら、残りの人たちは光の降り注ぐ大地に帰れる…だが、なぜ私はここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660505
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750660505,
					"content": "声が…ううっ、耳元でこだまする声がどんどん大きくなってくる。滝…滝に戻らないと。滝の…ところに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660506
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750660506,
					"content": "勇士よ、お前たちも早くここを離れた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		}
	]
