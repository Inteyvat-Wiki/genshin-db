		{
			"id": 7902312,
			"completionStepIds": [
				7902313
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902313",
							"2"
						],
						"stepId": 7902313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エフカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790231201,
					"content": "これは…そう、これだ！記章にある傷、しっかり覚えてるぞ…ん？ここが割れてるみたいだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231202
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231202,
					"content": "あっ、あの時、ヤコヴが投げたせいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231203
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231203,
					"content": "どうりで変わった場所にあったわけだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231204,
					"content": "なるほど、そうか。はははっ、まさか海辺にあるとはな、よかった…お前たち、本当にありがとう！お前たちみたいな親切なやつ、この世にそうそういないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231205
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231205,
					"content": "#いや、待った、お前ら…{NICKNAME}とパイモンじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231206
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231206,
					"content": "#そう、{M#俺}{F#私}がその{NICKNAME}だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231207
					]
				},
				{
					"id": 790231207,
					"content": "で、オイラがそのパイモンだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231208,
					"content": "くっ、そうか…お前らに捕まった以上、仕方がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231209
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231209,
					"content": "私の父はかつてこう言った、「敵に捕まり屈辱を味わうよりも、正義のために惜しむことなく死を選ぶ、一族のために誉れを選ぶべきだ」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231210
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231210,
					"content": "うわぁ、なんだか怖そうな人だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231211,
						790231212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231211,
					"content": "そんなこと言う人は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				},
				{
					"id": 790231213,
					"content": "それに安心しろ。オイラたちが聞きたいのは、おまえがどうしてここにいるのかってことだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231215
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231215,
					"content": "父は…「敵に情報を渡すことは、裏切りである。我が一族に、生き永らえるために裏切る者はなし！」とも言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231216
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231216,
					"content": "厳しすぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231217,
					"content": "確かに厳しすぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231218
					]
				},
				{
					"id": 790231218,
					"content": "父の教えの通りなら…お前らに捕まっただけでなく、手助けまでされた俺は、なんと恥ずべき存在か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231219
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231219,
					"content": "正直に言うと、この屈辱のせいで今は泣きわめきたいくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231220
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231220,
					"content": "ああ、ああ、わかったって。胸を張って言うようなことでもないし、そんな大声出すなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231221,
					"content": "だが、父はこうも言っていた。「人から受けた恩は必ず返すべし」とな。しかし、その言葉は今…矛盾してしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231222
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231222,
					"content": "だから、俺は決めた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231223
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231223,
					"content": "なにを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231224,
					"content": "自分の意志に従い、すべて教えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231225
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231225,
					"content": "急に適当になってないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231226,
					"content": "俺の名はエフカ、装置の信号テストをやっていた…く、それに関する記憶は曖昧だが、とにかくそのために、この島へやって来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231227
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231227,
					"content": "ああ、そうだ。ヤコヴ…俺はヤコヴと一緒に行動していた。この前、あいつと大ゲンカしてな…その時、あいつはこの記章を投げ捨てたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231228
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231228,
					"content": "それから…ヤコヴが妙なところに足を踏み入れて…そして消えるのを見た。もう二度とあいつに会えないかもしれないと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231229
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231229,
					"content": "だから、ここであいつを見つける方法を探していたんだ…そしたら、なぜか頭の中で「ブーン」という音がして、先ほどのような状態になってしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231230
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231230,
					"content": "足を踏み入れると消えちゃうって…まさか、金リンゴ群島の怪談かなにかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231231,
						790231232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231231,
					"content": "恐ろしき歪んだ罠！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231233,
					"content": "えぇ、そんなんじゃないだろ…もしかしたら、前に見たあの奇妙な装置の道みたいなもんかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231234,
					"content": "もしそうだとしたら、開けられるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231235,
					"content": "お前たちは、あれを開けられるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231236
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231236,
					"content": "できるはできるけど、でもなんでおまえを助けないといけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231237,
					"content": "そう、ファデュイなのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231238
					]
				},
				{
					"id": 790231238,
					"content": "もしあれを開けて、ヤコヴを見つけられたら何でも話そう…あっ、執行官様たちの悪口以外な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231239
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231239,
					"content": "うっ、こんなにあっさり話が進むなんて、まるでオイラが悪役みたいじゃないか…それにおまえ、父親からの教えはどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231240,
					"content": "元々、ヤコヴがあんな目に遭ったのは俺のせいだ…時には原則や教えよりも、もっと大切なものがあると…俺はそう思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231241
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231241,
					"content": "#よし！それじゃ、{NICKNAME}、やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790231232,
					"content": "姿なき人食い魔物！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231233
					]
				},
				{
					"id": 790231212,
					"content": "父親失格！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231213
					]
				}
			]
		},
