			},
			"dialogs": [
				{
					"id": 790232001,
					"content": "（レコーダーから流れてくる音が、かつての温かい言葉を蘇らせる…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232002
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790232002,
					"content": "あっ…どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232003
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790232003,
					"content": "ヤコヴ、おい、起きろ！どうして、こんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232004
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232004,
					"content": "おまえも似たような感じだったんだぞ。記章のことをずっとぶつぶつ呟いてた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232005,
					"content": "あっ、そうだ、あの記章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232006
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232006,
					"content": "ほら、ヤコヴ、お前の記章だ。この前、お前が怒りに任せて投げたやつだが、見つかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232007
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232007,
					"content": "これは、お前とお前の父上が共に手に入れた栄誉だろ。そして今、お前の手に戻った…どうだ、ヤコヴ、正気を取り戻したか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232030
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232030,
					"content": "どうして…どうして僕を、一人にするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232008
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790232008,
					"content": "まだ正気に戻ってないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232009,
					"content": "これは、こいつの目を覚まさせるものじゃないのか…だったら、一体何を望んでるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232010
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232010,
					"content": "おまえもこいつの欲しいものが分からないのか…仲間なんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232011,
					"content": "お…俺は…栄誉こそがこいつの一番大事なもんだと思ってたんだ。だが、それは違ったようだな。ただの…思い込みだったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232012
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232012,
					"content": "こいつはこれを父親との緊急任務で手に入れてな。だが、父親は帰らぬ人となってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232013
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232013,
					"content": "それに、こいつは生まれた時に、母親を亡くしてる…父親まで失ったこいつは、一人ぼっちの孤児になってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232014
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232014,
					"content": "はぁ…俺より若いのに、手にした栄誉は俺よりも勝っていた。多分、俺はこいつに嫉妬してたんだと思う…そのせいで、どう付き合えばいいか分からなかったんだ。唯一、参考にできそうだったのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232015
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232015,
					"content": "自分のお父さんとの付き合い方じゃないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232016,
					"content": "恥ずかしながら、その通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232017
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232017,
					"content": "それじゃあ、むしろ問題が起こらないほうがおかしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232018,
					"content": "我々の拠点は海域の真ん中の島にある。ヤコヴはこんな状態だし、今すぐそこへ連れて行ってやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232019
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232019,
					"content": "あっ、そうだ、俺たち…俺たちはペルシーコフ研究員の指示を受けて、ここで信号テストをしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232020
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232020,
					"content": "聞いた話によると、ある執行官様がスメールで新たな知識を得たらしい。その技術を利用すれば他人と意識を繋ぎ、エリア一帯に影響を及ぼせるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232021
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232021,
					"content": "あまり期待されていなかったんだが、ペルシーコフ研究員は強引にこの実験を推し進めた。そして海域の各エリアで、俺たちに装置の信号テストをさせたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232022
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232022,
					"content": "ペルシーコフ研究員の実験は上手くいっているのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232023
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232023,
					"content": "ふふんっ、オイラたちがここにいるんだから、ファデュイの実験結果なんて聞くまでもないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232024
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232024,
					"content": "当然、失敗した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790232025
					]
				},
				{
					"id": 790232025,
					"content": "そうか。はは、ペルシーコフ研究員は、恐らく痛い目を見ることになるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232026
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232026,
					"content": "俺が知ってるのはこれだけだ。それと以前、他のメンバーと約束したんだが、テスト任務が完了したら拠点で落ち合うことになってる。その拠点は海域の真ん中の島にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232027
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232027,
					"content": "あっ、このまえ会ったファデュイのことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232028
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790232028,
					"content": "そうか、もうあいつらに会ったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232029
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790232029,
					"content": "はぁ…ヤコヴのこの様子をアガシャが見たら、きっと俺を責めるに違いない…しかし、いずれにせよ、急いでヤコヴを連れて帰らなければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				}
			]
		},
