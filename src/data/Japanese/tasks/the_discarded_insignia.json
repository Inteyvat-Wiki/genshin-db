			},
			"dialogs": [
				{
					"id": 790230101,
					"content": "俺のせいだ…俺のせいであいつは、ああなってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230102
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230102,
					"content": "いや、必ず…必ず記章を取り戻して…あいつに渡すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230103
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230103,
					"content": "あのファデュイ、なにぶつぶつ言ってるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230104,
					"content": "おい、ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230105,
					"content": "記章、記章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230106,
						790230107
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230106,
					"content": "様子がおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				},
				{
					"id": 790230108,
					"content": "うぅ、なんだか気になるぞ…どうして前鋒軍の雷ハンマーがここにいるんだ？なにか悪いことでも企んでるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230109,
					"content": "#{NICKNAME}、おまえはこいつのことをどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230110,
					"content": "突進攻撃にだけ注意すればいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230111
					]
				},
				{
					"id": 790230111,
					"content": "確かに、雷ハンマーの突進は怖いよな…って、違う、そういうことじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230112,
					"content": "オイラが聞きたかったのは、こいつを正気に戻して、ここでなにをしてるのかを聞くべきかどうかって話だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230113,
					"content": "確かに気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230114
					]
				},
				{
					"id": 790230114,
					"content": "だろ？ファデュイが一人で「記章、記章…」なんて呟いてさ。なにかを探してるみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230115,
					"content": "こんな姿、滅多に見ないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230116,
					"content": "でも、どうしてこうなっちゃったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230117,
					"content": "あの装置のせいかもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230118
					]
				},
				{
					"id": 790230118,
					"content": "そうだな。ファデュイもあの機械の影響を受けたみたいだ。でも、どうすればこいつを正気に戻せるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230119,
					"content": "あの記章を…必ず、必ず取り戻さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230120
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230120,
					"content": "#どうやら記章を探してるみたいだな…{NICKNAME}、記章を探してあげようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230107,
					"content": "会話が成立しない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				}
			]
		},
