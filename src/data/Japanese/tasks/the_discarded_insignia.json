			"dialogs": [
				{
					"id": 790230501,
					"content": "ここにこんな島があるなんて…妙だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230502
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230502,
					"content": "この前、俺たちが調査した時は、こんな島なかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230503
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230503,
					"content": "エフカ…どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230504,
					"content": "いや、何でもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230505
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230505,
					"content": "どうやら、ヤコヴもこの島に来たみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230506,
					"content": "そうだ、ヤコヴ！早くヤコヴを見つけないと、ヤコヴ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230507
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230507,
					"content": "うわぁ、いきなり大声を出すのはやめろって言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230508,
					"content": "すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230509
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230509,
					"content": "#ここは安全な場所だし、そうビクビクしなくても大丈夫だぞ。よし、{NICKNAME}、まずはヤコヴを探そうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
