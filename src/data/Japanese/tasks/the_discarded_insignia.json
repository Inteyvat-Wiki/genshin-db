			},
			"dialogs": [
				{
					"id": 790231501,
					"content": "装置を開ける方法はまだ見つからないのか…あっ、いや、催促してるわけじゃない。どうした、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231502,
						790231504,
						790231508
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231502,
					"content": "どうして群島に来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231503
					]
				},
				{
					"id": 790231503,
					"content": "それはもちろん、誇りある使命を果たすためだ。具体的な内容は…まあ、ヤコヴを見つけたらまた話そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231504,
					"content": "あの記章…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790231505
					]
				},
				{
					"id": 790231505,
					"content": "あの記章は俺のものじゃないのに、詳しいのは変だってか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231506
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231506,
					"content": "あれはヤコヴのものだ。昔、あいつは父親と一緒に任務に赴いたんだが、戻ってこられたのはあいつだけだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231507
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231507,
					"content": "あの記章は、その任務の後に手に入れたんだ…俺は、あいつが手に入れた栄誉が羨ましくてな、何度も借りては眺めていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790231508,
					"content": "さよなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
