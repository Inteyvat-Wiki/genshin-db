			"dialogs": [
				{
					"id": 790230601,
					"content": "（レコーダーから流れてくる音が、かつての温かい言葉を蘇らせる…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230602
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790230602,
					"content": "あっ…どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230603
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790230603,
					"content": "ヤコヴ、おい、起きろ！どうして、こんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230604
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230604,
					"content": "おまえも似たような感じだったんだぞ。記章のことをずっとぶつぶつ呟いてた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230605,
					"content": "あっ、そうだ、あの記章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230606
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230606,
					"content": "ほら、ヤコヴ、お前の記章だ。この前、お前が怒りに任せて投げたやつだが、見つかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230607
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230607,
					"content": "これは、お前とお前の父上が共に手に入れた栄誉だろ。そして今、お前の手に戻った…どうだ、ヤコヴ、正気を取り戻したか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230608
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230608,
					"content": "どうして…どうして僕を、一人にするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230609
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790230609,
					"content": "まだ正気に戻ってないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230610,
					"content": "これは、こいつの目を覚まさせるものじゃないのか…だったら、一体何を望んでるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230611
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230611,
					"content": "おまえもこいつの欲しいものが分からないのか…仲間なんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230612,
					"content": "お…俺は…栄誉こそがこいつの一番大事なもんだと思ってたんだ。だが、それは違ったようだな。ただの…思い込みだったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230613
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230613,
					"content": "こいつはこれを父親との緊急任務で手に入れてな。だが、父親は帰らぬ人となってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230614
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230614,
					"content": "それに、こいつは生まれた時に、母親を亡くしてる…父親まで失ったこいつは、一人ぼっちの孤児になってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230615
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230615,
					"content": "はぁ…俺より若いのに、手にした栄誉は俺よりも勝っていた。多分、俺はこいつに嫉妬してたんだと思う…そのせいで、どう付き合えばいいか分からなかったんだ。唯一、参考にできそうだったのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230616
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230616,
					"content": "自分のお父さんとの付き合い方じゃないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230617,
					"content": "恥ずかしながら、その通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230618
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230618,
					"content": "それじゃあ、むしろ問題が起こらないほうがおかしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230619,
					"content": "我々の拠点は海域の真ん中の島にある。ヤコヴはこんな状態だし、今すぐそこへ連れて行ってやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230620
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230620,
					"content": "あっ、そうだ、俺たち…俺たちはペルシーコフ研究員の指示を受けて、ここで信号テストをしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230621
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230621,
					"content": "聞いた話によると、ある執行官様がスメールで新たな知識を得たらしい。その技術を利用すれば他人と意識を繋ぎ、エリア一帯に影響を及ぼせるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230622
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230622,
					"content": "あまり期待されていなかったんだが、ペルシーコフ研究員は強引にこの実験を推し進めた。そして海域の各エリアで、俺たちに装置の信号テストをさせたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230623
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230623,
					"content": "ペルシーコフ研究員の実験は上手くいっているのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230624
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230624,
					"content": "ふふんっ、オイラたちがここにいるんだから、ファデュイの実験結果なんて聞くまでもないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230625,
					"content": "当然、失敗した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230626
					]
				},
				{
					"id": 790230626,
					"content": "そうか。はは、ペルシーコフ研究員は、恐らく痛い目を見ることになるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230627
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230627,
					"content": "俺が知ってるのはこれだけだ。それと以前、<color=#00E1FFFF>他のメンバー</color>と約束したんだが、テスト任務が完了したら拠点で落ち合うことになってる。その拠点は海域の真ん中の島にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230628
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230628,
					"content": "あいつらは今、<color=#00E1FFFF>北にある二つの島</color>にいるはずだ…任務の進み具合からして、おそらく<color=#00E1FFFF>北西側の島</color>だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230629
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230629,
					"content": "はぁ…ヤコヴのこの様子をアガシャが見たら、きっと俺を責めるに違いない…しかし、いずれにせよ、急いでヤコヴを連れて帰らなければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				}
			]
		},
		{
			"id": 7902308,
			"completionStepIds": [
				7902301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
