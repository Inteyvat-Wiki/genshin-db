			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"エフカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230801,
					"content": "俺のせいだ…俺のせいであいつは、ああなってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230802
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230802,
					"content": "いや、必ず…必ず記章を取り戻して…あいつに渡すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230803
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230803,
					"content": "おい、ここでなにしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230804,
					"content": "記章、記章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230805
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790230805,
					"content": "こっちに見向きもしないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230806,
					"content": "もっと大きい声で！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230807
					]
				},
				{
					"id": 790230807,
					"content": "こいつ、あきらかにオイラたちの声が届いてないぞ。いくら大声出しても無駄だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230808,
					"content": "アガフィアに最初会った時もこんな感じだったよな。あの時は、写真の入った懐中時計を渡したら、正気を取り戻したはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230809,
					"content": "もしかしたら前鋒軍の雷ハンマーにも、装置の影響を打ち消して、正気に戻してくれるなにかがあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790230810,
					"content": "#なんだか記章を探してるみたいだし…{NICKNAME}、記章を探してあげようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
