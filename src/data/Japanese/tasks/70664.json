	"talks": [
		{
			"id": 7066401,
			"completionStepIds": [
				7066401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066401",
							"2"
						],
						"stepId": 7066401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏朗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706640101,
					"content": "毎回毎回、俺に面倒な仕事を押し付けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640102,
						706640103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640102,
					"content": "#あれ？{M#君}{F#あなた}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				},
				{
					"id": 706640104,
					"content": "おお、お前か！ここで会うなんて思わなかった、奇遇だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640105,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640106
					]
				},
				{
					"id": 706640106,
					"content": "はぁ、前回のあの変な秘境…覚えてるだろう？あの、内部構造が人の心によって変わる秘境のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640107,
					"content": "お前のおかげで俺は秘境に入り、たくさんの情報を得た。そしてあの秘境が消えた後、俺は嵐姉に報告をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640108
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640108,
					"content": "お前の助けがあったから、俺はちょっとしたサポートしかしていないと、何度も彼女に説明したのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640109,
					"content": "嵐姉は俺の仕事を認めたとか言って、チームを連れてこの未知の秘境を探索してこいって言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640110,
						706640111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640110,
					"content": "悪くない話だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640112,
					"content": "どこがいいんだよ。俺はただの普通の冒険者だ。自由気ままに、好きなことをしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640113
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640113,
					"content": "稼ぎは多くないけど、自由は何ものにも代えがたい。でも嵐姉が肩書きを押し付けてきて、俺も断れなくて。はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640114,
					"content": "それより見てくれ、この扉。この向こうには、また奇妙な秘境が広がってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640115,
					"content": "そして、中に「風域」がたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640116,
					"content": "#{M#俺}{F#私}が知っている、あの「風域」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640117
					]
				},
				{
					"id": 706640117,
					"content": "そうそう。野外にあるあれだ…風がヒューヒューと吹く風域だよ。冒険者たちは風の翼を使う時、風域の力を借りればさらに高く飛べる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640118,
					"content": "でも、この秘境の「風域」はとても複雑だ。時に風域は互いに干渉しあい、飛行を阻むエリアを作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640119,
					"content": "風の翼の操作が得意な冒険者を何人か探索に行かせたけど、しばらくすると戻されてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640120
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640120,
					"content": "彼らの話によると、この秘境には装置がある。装置を起動すると、風域の状況も変わるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640121
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640121,
					"content": "でも彼らがその装置の役目を解明する前に、大量の魔物が現れた。彼らは撤退するしかなかったそうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640122,
					"content": "だが、それらの装置を活用すれば、この秘境を上手く探索できるのではないかと、俺たちは考えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640123,
						706640124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640123,
					"content": "探索に行ったことはあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640125,
					"content": "それは…お前も知っての通り、俺はその…身体能力が低くてな。風の翼もうまく操れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640126
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640126,
					"content": "普通の飛行ならまだしも、この秘境の風域の状況では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640127
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640127,
					"content": "俺が探索に行っても、あちこち吹き飛ばされて、最終的に魔物の群れの中に落ちるだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640128
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640128,
					"content": "旅人、お前の実力は前回の件で分かった。お前は身体能力も抜群で、頭の回転も速い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640129
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640129,
					"content": "よかったら、この秘境を探索してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640130
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640130,
					"content": "報酬は心配ない。前回のように、ちゃんとたっぷり用意するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640131,
						706640133
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640131,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640132
					]
				},
				{
					"id": 706640132,
					"content": "よかった。それじゃ頼んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640133,
					"content": "宝物はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640134
					]
				},
				{
					"id": 706640134,
					"content": "それは俺にも分からない。俺たちはあまり探索できなかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640135
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640135,
					"content": "まあでも…安心しろ！探索で発見した宝物は、お前がそのまま受け取ってくれていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706640136
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640136,
					"content": "じゃあ頼んだよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706640124,
					"content": "先陣を切ったりしなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640125
					]
				},
				{
					"id": 706640111,
					"content": "いいことだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640112
					]
				},
				{
					"id": 706640103,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706640104
					]
				}
			]
		}
	]
}