			"trigger": {
				"objectNames": [
					"千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "「玲瓏霄灯図」へようこそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570102,
					"content": "な…なに図？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "「玲瓏霄灯図」、やってみる？簡単だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570104,
					"content": "後ろの屏風は見えるかな？それと前にある3つの灯も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570105,
					"content": "この灯は特別に作ってもらったものなんだ。光をつけると、異なる図案を映すことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570106,
					"content": "それに、正しい方法でこの3つの灯を回せば、完成された図案を形成することもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570107,
					"content": "まぁ…百聞は一見に如かずだから、とりあえずやってみて。基本操作に慣れたら、詳しい遊び方を教えるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "覚えが早いね。基本の原理は分かったと思うから、本番を始めていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570202,
					"content": "難しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "そんなことないよ。どう回せばいいか、もう分かったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570204,
					"content": "本番の時は、この3つの灯を回して、屏風に映した図案を正確に組み合わせればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570212,
					"content": "事前に組み合わせる図案を教えるから、灯を回すのは…自分で考えてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570205,
					"content": "組み合わせた後は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "気づいてるか分からないけど、実はその屏風は、璃月の「地図」になってるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570207,
					"content": "正しい図案を組み合わせて、地図に映せば、私たち冒険者協会が用意した「宝」を見つけられるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570208,
					"content": "教会からたくさんの人にお願いして、宝を設置したんだよ。時間は結構かかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570213,
					"content": "宝に関しては…私の向こうにあるのと同じように、場所さえ分かれば簡単に見つかるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570209,
					"content": "もう図案は調整してある、今日の図案は<color=#00E1FFFF>「琉璃百合」</color>だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570210,
					"content": "そうだ、「玲瓏霄灯図」の図案は夜になると見えやすいから、夜に来た方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "千"
				},
				{
					"id": 413570211,
					"content": "それに、これらの灯は教会が特別に作ってもらった物だからね…こんなに綺麗な灯、じっくり見ないともったいないと思うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
		},
