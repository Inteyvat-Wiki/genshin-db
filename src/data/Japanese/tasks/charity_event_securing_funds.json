					"ゲオルグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182401,
					"content": "その値段…少しばかり厳しいが、旧知の仲ということで飲んでやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				}
			]
		},
		{
			"id": 7051825,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
