			"trigger": {
				"objectNames": [
					"ベルンハルト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "待ってくれ！名高い栄誉騎士、そして「テイワットのガイド」パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180102,
					"content": "どうか手を貸してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180103,
					"content": "んんっ！オイラをそうやって呼ぶやつが現れるなんて、とうとうオイラの称号も世間に広まりはじめたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180140,
					"content": "待てよ…おまえ、なんだか見覚えがあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180104,
					"content": "騎士団本部のホールで会ったことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "そう、僕は西風騎士のベルンハルト。ヘルター隊長率いる後方支援部隊に属している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180106,
					"content": "最低限の礼儀として、まずは君と十分な友好関係を築くべきだとは思ったんだが…時間がなくて、この通り厚かましくお願いしに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180107,
					"content": "今回のチャリティーショップを救うために、手を貸してほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180108,
					"content": "救う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "チャリティーショップ…たしかジン団長が言ってたよな。なにかトラブルでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180110,
					"content": "実は、西風騎士団はブリュー祭期間中に出店を計画していて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180111,
					"content": "厳しい環境で暮らす子供たちやお年寄りのために、屋台の収益をチャリティー活動に使う予定なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180112,
					"content": "担当者は抽選で決まるんだが…たまたま僕が選ばれた。そこでチャリティーショップを成功させるために、色んな人に相談に乗ってもらっていたんだ、ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180113,
					"content": "僕は普段、倉庫での作業と運送の仕事ばかりやっていてね。何を売るかでさえ頭を悩ませていたのに、ましてやお店の経営なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180114,
					"content": "だから、君たちの手をぜひとも貸してほしいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180115,
					"content": "困っていることは分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "そうそう、そんなにかしこまらなくてもいいんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180118,
					"content": "つまり、モンドの子供とお年寄りのためにチャリティーショップをやるってことだよな。すっごく立派なことだと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180119,
					"content": "それにこいつは栄誉騎士だし、オイラも騎士団とは付き合いが長いからな。協力してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180120,
					"content": "力になりたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "本当か、ありがとう！じゃあ、さっそく手短に説明しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180123,
					"content": "イベントが始まる前に、まずはお店を運営するための基本資金となる<color=#00E1FFFF>「ブリューゼリー」</color>を用意する必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180124,
					"content": "近隣の酒造業者に酒造りの材料を売れば、「ブリューゼリー」がたくさん手に入る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180125,
					"content": "他にも、一部外国のお客さんの中には、ブリュー祭の期間中に飲み物を大量に仕入れようとする人がいる。そういった人たちは、注文を手伝ってくれる代理人を探していてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180126,
					"content": "長期的な協力関係を築くためにも、この類のお客さんは気前がよく、酒造業者と価格の交渉をする余地もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180127,
					"content": "その差額が、僕たちへの謝礼になるんだ。しかも、同額の「ブリューゼリー」と交換することもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180128,
					"content": "つまり、オイラたちの仕事は酒造業者にお酒造りの材料を提供することと、外国のお客さんのために値切りをすることだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180129,
					"content": "なら、思ってたよりも簡単そうだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180130,
					"content": "全部得意なこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "ほ、本当か？それは良かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180132,
					"content": "実はすでに依頼が来ていてね——スメールのシェヴァマさんの注文で、<color=#00E1FFFF>「バケーションサイダー」五十箱</color>だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180133,
					"content": "そのドリンクは<color=#00E1FFFF>ゲオルグ</color>さんが店主をやってる、<color=#00E1FFFF>「エンジェルズシェア」の屋台</color>で買える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180134,
					"content": "ゲオルグさんは優しいんだけど、損をしたがらない。ゲオルグさんの気分を損ねないように、価格交渉の時はよく考えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180135,
					"content": "僕は引き続き屋台の準備をするよ。十分な「ブリューゼリー」が用意できたら、またここに戻ってきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180136,
					"content": "それと屋台に必要な材料は僕が用意するから、気を使わなくても大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180137,
					"content": "すでに仕入先へは連絡してある。資金の準備ができ次第、材料を送ってもらえる予定だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180138,
					"content": "よし、手分けして行動開始だ！屋台の準備はおまえが、資金調達はオイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180139,
					"content": "ああ、二人とも助かるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705180121,
					"content": "何をしたらいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "誰にでも苦手なことはあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゲオルグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "ゲオルグさん、こんにちは！オイラたちシェヴァマさんの代理人で、「バケーションサイダー」を五十箱注文したいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180202,
					"content": "ああ、シェヴァマさんか？うちの常連客だな。注文の数はいつもと同じようだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705180203,
					"content": "単刀直入にいこう、今年はいくら出すつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "旅人、パイモン、ここにいたんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180302,
					"content": "あっ、バーバラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180303,
					"content": "こんにちは、バーバラ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "うん、ハッピーブリーズブリュー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180306,
					"content": "ブリュー祭は、モンドでもっとも賑やかなお祭りの一つなんだ。この時期に会えるなんて嬉しいよ。ぜひブリュー祭を楽しんでいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180307,
					"content": "そういえば、ゲオルグさんに聞いたんだけど、「ブリューゼリー」を集めてるんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180308,
					"content": "それで、ちょっと気になったんだけど、もしかして騎士団のチャリティーショップのお手伝いをしてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180309,
					"content": "そうだぞ。オイラたちも騎士団の一員だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180310,
					"content": "オープンに向けて、あちこち走り回って資金調達をしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180311,
					"content": "営業を開始した後にどんなトラブルが起きても、きっとオイラたちなら乗り越えられるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180312,
					"content": "さすが頼りになるね！えへへっ、あなたたちの助けがあれば、きっと今までにないくらい成功すると思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180313,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "以前、騎士団が小規模のチャリティーイベントを開いた時に、私もお手伝いに行ったことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180315,
					"content": "とはいえ、その内容はお店の前で歌うことだったんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180316,
					"content": "そうだ！あの時、吟遊詩人のウェンティにばったり会って、一曲一緒に即興で歌ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180317,
					"content": "彼の奏でるメロディーはとても古風で優雅でね、最初は雰囲気を壊すのを恐れて、あえて小声で歌ってたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180318,
					"content": "でも彼がハーモニーで私を導いてくれたの。そのおかげで、すぐに感覚を掴めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180319,
					"content": "結果的にお客さんに喜んでもらえたし、商品もよく売れたから良かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180320,
					"content": "バーバラと吟遊野郎って、コラボしたことがあったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180321,
					"content": "聞いてみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "それが残念だけど、今回は時間の都合がつかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180323,
					"content": "ブリュー祭期間中、西風教会は景色がキレイな場所で特別に合唱を披露することになってるの。私もリハーサルに参加する必要があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180324,
					"content": "大丈夫、頑張ってきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "おう、どっちもやりがいのある仕事だし、お互い頑張ろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180327,
					"content": "二人ともありがとう！ここで歌うことはできないけど、他のところで力になれるよう工夫してみるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180328,
					"content": "えーっと…みんなにあなたたちのお店を紹介するのはどうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180329,
					"content": "例えば…大きなポスターを用意したり、チラシを配ったりとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180330,
					"content": "あっ、キャッチコピーもちゃんと考えないと！それからサインも入れたほうが誠意が伝わるよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180331,
					"content": "うーん、それともやっぱり一人ひとりに声を掛けるべきかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180332,
					"content": "おおっ、バーバラが宣伝してくれたら、店の知名度も一気に上がるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180333,
					"content": "そこまでしなくても。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "これくらい気にしないで。それにそんな風に言われると、ちょっと恥ずかしいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180336,
					"content": "もう少し考えてみて、他の人にも宣伝のアドバイスを聞いてみるね！それじゃあ、旅人にパイモン、またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180337,
					"content": "その…騎士団と教会のみんなもきっと、あなたたちのことを誇りに思ってるはずだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 705180338,
					"content": "おう！一緒に頑張ろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180339,
					"content": "これでさらにやる気が出てきたぜ！オイラたちも、もっと頑張らなきゃな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705180334,
					"content": "無理しないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "チャリティーショップの方は任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "ハッピーブリーズブリュー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
