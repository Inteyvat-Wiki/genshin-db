			},
			"dialogs": [
				{
					"id": 705182501,
					"content": "すまんが、そんな低い額では到底無理だ。注文したいんなら、俺が提示する額で買ってもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				}
			]
		},
		{
			"id": 7051826,
			"completionStepIds": [
				7051805
			],
