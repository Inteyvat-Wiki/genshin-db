				"objectNames": [
					"ゲオルグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182301,
					"content": "いつもの値段とほぼ同じだな、悪くない。交渉成立だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				}
			]
		},
		{
			"id": 7051824,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
