					"ゲオルグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182601,
					"content": "いつも通り、直接シェヴァマさんの店に届くよう手配する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182602
					],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705182602,
					"content": "安心しな。この領収書は忘れず保管しておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182603
					],
					"speakerTitle": "ゲオルグ"
				},
				{
					"id": 705182603,
					"content": "よし、資金調達を続けようぜ。なるべく早く十分な量の「ブリューゼリー」を集めよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705182604,
					"content": "方法は自由、十分な資金を集められればいいってベルンハルトが言ってたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705182605,
					"content": "外国のお客さんからの注文が入れば、謝礼がもらえる。そうすれば、酒造業者にあんなたくさんの材料を売らなくて済む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705182606,
					"content": "でも念のため、ひとまず他の酒造業者を調べてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
