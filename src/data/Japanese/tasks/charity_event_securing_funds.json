			},
			"dialogs": [
				{
					"id": 705182201,
					"content": "今年は豊作で、酒造りのコストが例年よりずっと低かったとはいえ、それでもその値段はちょっと飲めないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲオルグ"
				}
			]
		},
		{
			"id": 7051823,
