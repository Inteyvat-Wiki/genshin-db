			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マージョリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "いらっしゃい！ここのお宝は全て一点物ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040102,
					"content": "見たことないものがたくさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205040103,
					"content": "ふふっ、もちろんですよ。どれもこれも冒険者たちが世界各地から見つけてきた珍品ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040104,
					"content": "どうですか？気になるものはありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040105,
					"content": "なんだか高そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "そんなことないですよ。そうだ、言い忘れてました。ここは物々交換がメインで、モラは受け取りません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040108,
					"content": "私、最近特殊な工芸品を作ろうと思ってて、でもその装飾に大量の<color=#00E1FFFF>「風の印」</color>が必要なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040109,
					"content": "<color=#00E1FFFF>「風の印」</color>を持ってますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040110,
					"content": "いくつか持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "ふふ、あなたの冒険はもう風神に認められてるみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040114,
					"content": "それはともかく、<color=#00E1FFFF>「風の印」</color>をお持ちなら、店の商品と交換できますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040115,
					"content": "商品を選ぶ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "それはなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "一種の印ですよ。風神は認めた冒険者にそれを贈るんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040106,
					"content": "値段を見るのが怖い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050403",
							"2"
						],
						"stepId": 2050403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マージョリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>「風の印」</color>はモンドのいろんな場所に出現しますから、足りないと思ったら探してみるといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040302,
					"content": "本当に装飾に使うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "そうそう。風神からの贈り物なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205040304,
					"content": "ははっ、鋭いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040305,
					"content": "説明するとかなり複雑になっちゃうので、装飾と言ったほうが分かりやすいかなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040306,
					"content": "<color=#00E1FFFF>「風の印」</color>を使うと決めたのにはちゃんと理由がありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040307,
					"content": "できたら見せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "ええ、きっと驚きますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040312,
					"content": "またいらっしゃい。次は<color=#00E1FFFF>「風の印」</color>をたくさん持って来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040313,
					"content": "それと、なにか珍しい宝物を見つけた時も、是非ここに持って来てください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 205040309,
					"content": "なんかあやしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "でもすごい気になってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205040311,
					"content": "ふふ、未知の要素があったほうがドキドキするでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "マージョリー"
				}
			]
		}
	]
}