			"dialogs": [
				{
					"id": 745290401,
					"content": "#あら、{NICKNAME}。こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290402,
					"content": "こんにちは、シトラリ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "失礼ね。ワタシだって、たまには散歩くらいするのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290405,
					"content": "それに、昨夜占ってみたら、今日外に出るといいコトがあるって出たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290406,
					"content": "ほら、家を出たとたん、いいコトが舞い込んだでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290407,
					"content": "じゃあ、もう一つサプライズ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "別に構わないけど…ワタシ、八重堂の新刊を徹夜で読破したトコなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290410,
					"content": "…ちょっと見てよ？クマ、もうちゃんと消えてるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290411,
					"content": "うん、大丈夫だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "ホントに？騙したらタダじゃおかないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290414,
					"content": "それと言っておくけど、キレイに撮ってくれなかったら、その写真は没収よ。残せるのは一番イケてる一枚だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 745290412,
					"content": "むしろ輝いてるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "#{M#君}{F#あなた}の写真を撮らせてもらえない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "家で寝てないなんて珍しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
