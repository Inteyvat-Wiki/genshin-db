	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "う～む、写真を撮ってから詩を詠むべきか…はたまた、詩を作ってから写真を撮るべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320102,
					"content": "いや…違うな。どちらも同じようなものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320103,
					"content": "何をぶつぶつ言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "ん？ああ、ナタの風景を題材に詩を詠もうとしていたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320106,
					"content": "でも、ここの景色は璃月と大きく違う。ナタの歴史にも詳しくないから、どうしたもんかと悩んでいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320107,
					"content": "それに僕は詩を詠むことに関してド素人。韻もうまく踏めないから、簡単なものすら詠むのに一苦労でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320108,
					"content": "はぁ、でもここまで来たからには、手ぶらで帰るわけにもいかない。でないと「取材に行ったのに失敗したんだ」って総務司の同僚に言われてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320109,
					"content": "総務司で働いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "まあ…そんなところだ。少し前に総務司の依頼を受けて、土地の測量をしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320111,
					"content": "はぁ、実際は人を連れて、土地に変化がないか、地図を修正する必要はないか、璃月を見て回るだけだったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320112,
					"content": "一通り走り回ったもんだから、疲れて死にそうになったよ。靴底も何度破けたことか…だから休暇を取って、気晴らしに出かけることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320113,
					"content": "ただ、あの時は何を考えてたのか…休暇申請書に「詩を詠みたくなったため、外の世界を取材してきます」って書いてしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320114,
					"content": "まさか、休暇申請を審査する人が「詩が上手く書けるよう、幸運を祈る」って律儀に返してくれるとは…それで、半月も休暇をもらってしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320115,
					"content": "いいことじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "いいことだって？いやいや、休暇に入ることを…総務司の全員に知られてしまったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320119,
					"content": "はぁ、確かにナタは楽しいよ。景色はいいし、食べ物だって美味しい。それに面白い生き物もたくさんいる。特に竜の赤ちゃんがとっても可愛くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320120,
					"content": "でも、詩は一文字たりとも出てこない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320121,
					"content": "せっかく写真機を借りて取材に来たっていうのに、全然活用できていないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320122,
					"content": "自然の風景を撮るだけならまだしも、お店や人物を撮るとなると、見るに堪えない出来でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320123,
					"content": "手伝ってあげようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "ほ、本当かい！？助かるよ、ありがとう。とにもかくにも、素材がなければ詩は詠めないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320126,
					"content": "そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320124,
					"content": "写真なら得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "詩は上手く書けた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "いいや。でも…僕が休暇を取ってナタに取材に行くことは、総務司の全員に知られてしまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320104,
					"content": "詩を詠んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
			"completionStepIds": [
				2503206,
