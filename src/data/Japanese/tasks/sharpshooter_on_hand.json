			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "おかえり。写真は撮れたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320602,
					"content": "撮れたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "へぇ…これはまた良く撮れてる。僕の助手よりずっと上手だ。彼は観測地点の写真を撮るとき、なんべんも撮り直してたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320604,
					"content": "もし君が土地の測量に付き添ってくれてたら、きっと写真機を何台も壊さずに済んでただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320605,
					"content": "この写真、詩に使えそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "たぶん…使えるだろう。ほら、たとえ詩が詠めなかったとしても、この写真を絵はがきにできるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320607,
					"content": "その裏に祝福の言葉を書いて、総務司に送るんだ。それを受け取ったら、あいつらだって何も言えないはずさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320608,
					"content": "コホンッ…でも、それはあくまで最終手段。その前に、まずはどうやって詩を詠むか考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320609,
					"content": "風雨…いや、風雲を起こす五部族…待った、ナタにはいくつ部族があるんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				}
			]
		},
		{
