			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "そうだ！「流泉の衆」にある店の看板が、なかなか特徴的だと聞いた。確か「ジャンベ楽器店」という店があるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
