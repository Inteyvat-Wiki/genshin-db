			},
			"dialogs": [
				{
					"id": 401730301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730302,
					"content": "（逃げられた。は、恥ずかしい…さっき、すんごい自信満々に言っちゃった。ああぁ！ワタシのイメージが…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730303,
					"content": "（どうやら、谷中ってやつは逃げ上手みたいね。あのコたちを納得させる理由を考えないと…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730304,
					"content": "シトラリ！谷中を捕まえたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730305,
					"content": "洞窟には、ばあちゃんだけだ。捕まってないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730306,
					"content": "…ワタシが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730307,
					"content": "わざと逃がしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730308,
					"content": "でも体にはマークを付けて、この近くに現れたら、すぐに追跡できるようにしてあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730309,
					"content": "なるほど。洞窟を離れたふりをして、こっそり待ち伏せしようとしたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730310,
					"content": "おおっ！こないだ、オロルンを捕まえたときと同じ方法だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730311,
					"content": "でも、シトラリはなんで谷中が来るってわかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730312,
					"content": "燼寂海の地図と弓の欠片をわざと机に置いて、エサをまいたのよ。それが谷中の目的かもしれないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730313,
					"content": "ワタシたちが離れて、しばらくしないうちにワナが発動したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730314,
					"content": "えっ？本当にワナがあったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730315,
					"content": "もちろんよ。キミたちには反応しないようになってるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730316,
					"content": "ほら、言っただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730317,
					"content": "谷中さん、本当にぼくを利用してたのか…燼寂海の情報が欲しかっただけなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730318,
					"content": "ええ。どうしてアイツが欠片を拠点に残したのか、ずっと気になってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730319,
					"content": "燼寂海の場所の情報を手に入れた時、欠片はただのエサだったって分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730320,
					"content": "ルラはゼッタイに問題を起こすし、部族もルラのコトを放っとくわけがない。つまり、必ず誰かが助けにやって来る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730321,
					"content": "なるほど！あいつは本当に釣りをしてたんだな！実力者をおびき出して、欠片を霊視させるために！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730322,
					"content": "ええ。そして引っかかったのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730323,
					"content": "ごめん、僕だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730324,
					"content": "それに、ばあちゃんも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730325,
					"content": "このっ！ワタシはキミのためを思って…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730326,
					"content": "とにかく、谷中は狡猾なやつだ。そして、一番リスクの低い方法を選んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730327,
					"content": "たしかに。もし直接シトラリを訪ねてたら、一発でバレるもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730328,
					"content": "そういえばシトラリ、なんで谷中を逃したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730329,
					"content": "コホン…だって、あいつって逃げるのが上手でしょ。捕まえておくためには、全力を出さないといけない。でも、この場所で騒がしくするとナニかと不都合なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730330,
					"content": "もしかして場所が悪かったか、ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730331,
					"content": "最初はルラを助けるために、あえてスピリットが比較的多い場所を選んだんだ。だから「狂気の賢者」の縄張りにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730332,
					"content": "狂気の賢者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730333,
					"content": "そう。カベの向こうにいてね、起こすと面倒なのよ。それで一旦手を引いたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730334,
					"content": "それでも、いいお知らせもあるのよ。地図と欠片は全部取り戻した。ワタシだってやる時はやるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730335,
					"content": "よかったぜ。谷中はなんにも持っていけなかったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730336,
					"content": "ただ…悪いお知らせもあって、たぶんアイツはもう地図を見ちゃったのよ。燼寂海が消えたトコロは別にヒミツじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730337,
					"content": "えっ？ちょっと心配だな。まさかそいつ、なにか企んでるんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730338,
					"content": "安心して。行方はちゃんと追っておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730339,
					"content": "それとルラ、もしキミさえ良ければ、地図と欠片を旅人にあげたいの。このコのこれからの旅に役立つかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730340,
					"content": "もちろんいいとも！旅人がもらってくれるなら文句なんてないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730341,
					"content": "すごく貴重なものなんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "どうせこっちはみんな興味ないもの。それに、もし本当に燼寂海の場所を示してるなら、キミみたいな冒険者はゼッタイ見逃せないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730343,
					"content": "これはあくまで黒曜石の老婆のカンだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730344,
					"content": "あの、シトラリ大祭司さま、もう一つ聞いていいですか？ぼくは今でも霊感音痴なんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730345,
					"content": "ナニ寝ぼけたコト言ってるの？キミはちゃんとワタシの幻術に気づいたでしょ？わざと見破られるようにしたとはいえ、霊感音痴に分かるようなものじゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730346,
					"content": "オロルン、時間があったら、このコにいろいろ教えてやってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730347,
					"content": "どれだけ吸収できるかは、ルラ、キミの実力次第よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730348,
					"content": "良かったな。人生って本当に不思議だ。前に進み続ければ、いつかは「肥料」に出会えるかもしれないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730349,
					"content": "僕はうれしいよ、ルラ。これからは一緒に頑張ろう。僕も君も立派なキャベツになれるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オロルン"
				}
			]
		},
