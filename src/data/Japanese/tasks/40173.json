			"dialogs": [
				{
					"id": 401730101,
					"content": "みんな集まったみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730102,
					"content": "よう、シトラリ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730103,
					"content": "族長から儀式用の剣を借りてきたの。これがないとできないコトがあるのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730104,
					"content": "今日何をすべきか、ちゃーんと覚えてるでしょうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730105,
					"content": "もちろんだぜ。ルラが目覚めるのを待つんだよな。起きたら、一体なにがあったんだって問い詰めてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730106,
					"content": "僕もばあちゃんに言われた通り、必要なものを全部用意してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730107,
					"content": "バッチリね。おしゃべりはこれくらいにして、始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730108,
					"content": "シトラリは「厄水の災い」という名の儀式用の剣を召喚した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "秘されし煙のうちより、捧げたてまつらん。月無き夜には星々を、風の無ければ夢の花輪をたてまつらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730110,
					"content": "死の主に捧げたてまつる。落ちよ、落ちよ、ただ落ちよ。三度、帰りて、また三度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730111,
					"content": "うわぁ——なんかの呪文か？急に寒くなったぞ！なにか来るのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730112,
					"content": "静かに。ばあちゃんを邪魔してはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730113,
					"content": "我ら祭司たる王の裔、遠き昔の契りによりて、夜の帳を引き裂かん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730114,
					"content": "我、シトラリがここに告ぐ。我が名はアー・クルバティ、我は末地の主なり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730116,
					"content": "見ろ…！ルラのスピリットが戻ってきた。体に向かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730117,
					"content": "燧石の刃を持ちて、夜の帳に突き立てん。未だ亡者にあらぬ魂を我が名において追放す。\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730118,
					"content": "ルラよ！我が命に従いて、炎天の大地、汝の道へと戻れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730119,
					"content": "う…うまくいったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730120,
					"content": "うぅ…あれ？ここは…？あなたたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730121,
					"content": "うわあっ——黒曜石の老婆！じゃなくて…シトラリ大祭司さま！どうかお許しを！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730122,
					"content": "このガキンチョ、自分がナニをしでかしたのか、よーく分かっているようね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730123,
					"content": "あとちょっとで戻れなくなるところだったのよ？自分を抜け殻にして、そんなに面白い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730124,
					"content": "も、申し訳ありません…罰を受けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730125,
					"content": "あら？ホンキかしら？なら早く家に帰って両親に別れを告げるコトね。こう言うのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730126,
					"content": "「父さん、母さん、さようなら。抜け殻としての人生が楽しいから、石像になって、百年間、黒曜石の老婆の家の門番をするんだ。」ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730127,
					"content": "嫌です！本当にすみませんでした！助けてくださってありがとうございます、シトラリ大祭司さま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730128,
					"content": "フン、お礼は孫に言ってちょうだい。このコが異変に気付いてなかったら、クビを突っ込まなかっただろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730129,
					"content": "礼はいい、ルラ。口ではああ言っているが、ばあちゃんも僕たちも責めたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730130,
					"content": "君は騙されたんだろ？悪いのは、すべて谷中ってやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730131,
					"content": "いや…谷中さんは関係ないよ。ぼくがやってみたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730132,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730133,
					"content": "スピリットが多く残ってる物を媒体にする方法を教えてくれたのは確かに谷中さんだけど、やるって決めたのはこのぼくだ。あの人はぼくを騙したりなんてしていないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730134,
					"content": "ごめん、全部ぼくのせいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730135,
					"content": "フン、かなり洗脳されちゃってるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401730136,
					"content": "えっと…じゃあ、あの欠片はそいつが持ってきたものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730137,
					"content": "ああ、燼寂海と関係のある宝物だと言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730138,
					"content": "どう見てもおまえを利用してるじゃないか！そんなの、おまえに霊視をさせるために決まってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730139,
					"content": "でも、ぼくは霊感音痴だからなんの巫術も使えない…そんなぼくをどうやって利用するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730140,
					"content": "ぼくみたいな人は、ただ座って瞑想しても一生スピリットを感知できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730141,
					"content": "でも、谷中さんは別の方法で無理やり巫術を使えるようにすれば、例えば自分に大量のスピリットを浴びせれば、それを捉えるチャンスがあるかもしれないって。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730142,
					"content": "そんな方法、無茶だろ！シトラリがいなかったら、本当に戻れなくなってたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401730143,
					"content": "ごめん…本当に申し訳ない…でも、みんな才能があるのにぼくだけ何もできなくて…ぼくはただ、みんなと同じになりたかっただけなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "ルラ"
				},
				{
					"id": 401730144,
					"content": "気持ちは分かる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730145,
					"content": "大して努力しなくても立派なキャベツになる種もあれば、どれだけ頑張っても芽が出ない種もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730146,
					"content": "理由は僕も分からないけど、たぶんそれが人生ってやつなんだろう。どうにもできないことは、たくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730147,
					"content": "こんなことを言っても役に立たないかもしれないけど。でも、受け入れるしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401730148,
					"content": "ひとまず、お話はここまでにしましょう。まずはマトーラのところで検査してもらわないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
