					}
				]
			},
			"dialogs": [
				{
					"id": 711350201,
					"content": "うわぁ～！いつの間にかこんなにたくさん仙力を集めてたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350202,
						711350203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350202,
					"content": "#さすがは{M#俺}{F#私}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350205
					]
				},
				{
					"id": 711350205,
					"content": "浮錦が前に言ってた話だと、この仙力を「祀{RUBY#[D]スーロン}瓏」に注げるはずだ。そうすれば来年の翹英荘はきっと大豊作だろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350206,
					"content": "その時には、羅おじにたーーーーっくさんごちそうを用意してもらおう！そうだな、たとえば茶葉のお菓子に、仔鳩、大肉団子の醤油煮、蜜汁チャーシュー、それからそれから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350207,
					"content": "沈玉茶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350208
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350208,
					"content": "そうだ、沈玉茶もな！覚えておかないと…ん？だ、誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350209,
					"content": "ふ、浮錦！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350210,
					"content": "ふふっ、すまんの、驚かしてしもうたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350211
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350211,
					"content": "人の姿に戻れるようになったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350212,
					"content": "そうじゃ。コホン…言うたじゃろ、そんな大したケガではないから、しばらく休めば一番気に入っとる姿に戻れるとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350213
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350213,
					"content": "#おぬしらには感謝するぞ。我が休んでおる間、祀{RUBY#[D]スーロン}瓏のためにこうも多くの仙力を集めてくれた。{NICKNAME}とパイモンは来年の豊作のために誰よりも貢献してくれたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350214,
						711350215
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350214,
					"content": "#フフン、この{M#坊ちゃんには朝飯前だよ}{F#お嬢様には朝飯前ね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350216
					]
				},
				{
					"id": 711350216,
					"content": "人の姿を取り戻したってことは、もう真っ暗な場所に閉じこもる必要もないだろ？これからなにかしたいことはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350217,
					"content": "うむ…具体的にはまだ考えておらん。ひとまずはこの辺を歩いてみるかの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350218
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350218,
					"content": "今の茶を味わい、今の芝居を見て、今の人々に会う…ふふ。「今」を強調してばかりですまんの。嫌われ者の堅物老人のようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350219
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350219,
					"content": "だが「今」という言葉がとても好きなんじゃ。昔はできなかったことが「今」ではできるからのう。過去に実現できなかったこと、たくさんの約束を、「今」ならなせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350220
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350220,
					"content": "この後、帰離集へ行ってみて、それから璃月港へ行き、彼女たちが言う愛らしい人々というのを見てみたい。それに薬君にも会いたいのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350221
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350221,
					"content": "連れて行ってあげようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350222
					]
				},
				{
					"id": 711350222,
					"content": "だな、浮錦はこう言ってたろ？「清水を長時間離れることはできない」「仙家の茶釜がないと遠い所へは行けない」とかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350223,
					"content": "ふふっ…覚えていてくれた上に、助けを申し出てくれるとは感謝するぞ。じゃが、ひとまずは沈玉の谷でしばらくゆっくりしたい。我が家の景色をしっかりと楽しむのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350224
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350224,
					"content": "遠出に関しては、そうじゃな…うむ、マオが大きくなるまで待つことにしようかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350225
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350225,
					"content": "長すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711350226,
					"content": "冗談じゃよ！とにかく、まずしばらくはここに留まるつもりじゃ。霊淵も一緒に出掛けないかと、ついでに誘ってみようかの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350227
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350227,
					"content": "#そうじゃ、{NICKNAME}！おぬしが去る前にもう一つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350228
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350228,
					"content": "霊淵も我も、おぬしらには多大な面倒をかけた。我の仙力も少しは回復したことだ。心からの祝福を贈らせておくれ。おぬしらのこの先の旅路が順調であることを願って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350229
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350229,
					"content": "「良茶を摘みて、杯交わす。白花が露を凝縮し、翠葉は煙垂らす。」\\n「時代は移ろい、歳月は穏やかに。此の想い胸に秘め、永遠に忘れまいと誓う。」\\n「時を共にし、安らぎを分かち合わん。汝還るまで、琴をつま弾こう。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711350230
					]
				},
				{
					"id": 711350230,
					"content": "ふふっ。よし！これでもう何も心配はないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350231,
						711350232
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350231,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350234
					]
				},
				{
					"id": 711350234,
					"content": "#では今一度…ありがとう、{NICKNAME}にパイモン。我のため、沈玉の谷のためにしてくれたことすべてに感謝を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350232,
					"content": "特に変化はないような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350233
					]
				},
				{
					"id": 711350233,
					"content": "何しろ「福運」とはすぐに目に見えて現れるものではないからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350234
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711350215,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350216
					]
				},
				{
					"id": 711350203,
					"content": "#さすが{NICKNAME}{M#坊ちゃん}{F#お嬢様ね}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711350204
					]
				},
				{
					"id": 711350204,
					"content": "おい！もうずいぶん経ってるだろ。いい加減、そのおかしな話し方はやめろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711350205
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}