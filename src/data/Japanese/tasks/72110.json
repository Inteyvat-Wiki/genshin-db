	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩蔵光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "俺はなぜ道場から離れ、九条様の指南役となったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100102,
					"content": "柳葉と岡崎、それに三船…なぜ俺から離れたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岩蔵光造"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岡崎寅衛門",
					"柳葉嵐士"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "…今、足りていないのは岩蔵光胤の刀だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100202,
					"content": "岩蔵家に代々受け継がれている「薄縁満光天目」のことか。当時お前と久仁彦が引き取られたばっかりの時、先代の永胤さまに気づかれないうちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100203,
					"content": "俺たちはもう「破門」された身です。「さま」をつける必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100204,
					"content": "しかし、岡崎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100205,
					"content": "「『情』と『義』が天秤の両方にかけられる時、本物の剣士は『義』の道しか歩めない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100206,
					"content": "師匠がこんなことを言ったのなら、彼は俺たちを破門するのは嫌だが、他に選択の余地がないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100207,
					"content": "それは当然のことでしょう。でも彼は将軍の刀になって目狩り令を貫くことを決めたから、俺たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100208,
					"content": "俺たちは自分なりの仁義の道を選ぶしかないのだ。「本物の剣士が『義』の道しか歩めない」のだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100209,
					"content": "それなのに、師匠の仁義も負けてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100210,
					"content": "ああ、久仁彦の仇だけではく、他のみんな、それに岩蔵光胤の仇も、全部討ちます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100211,
					"content": "これは、我々破門された元門下生の仁義です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100212,
					"content": "これも師匠のご加護かもな。一人目の仇が俺らのとこにやって来るとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100213,
					"content": "#ああ。{NICKNAME}、お前だよな。お前のこと、とっくに聞いてたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100214,
					"content": "剣士の世界では、血でのみ「血」を浄化できる。岩蔵流「免許皆伝」に立ち向かう準備、もうできただろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岡崎寅衛門"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩蔵光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "俺はなぜ道場から離れ、九条様の指南役となったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100302,
					"content": "柳葉と岡崎、それに三船…なぜ俺から離れたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100303,
					"content": "岩蔵流の門下生、すでに会った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "そうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100305,
					"content": "今時、岩蔵流を名乗る人がまだいるのか。宗主は物にならない人なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100306,
					"content": "岩蔵光造だ。ここで剣術の指南役を務めている。お前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100307,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "三船、丹波…彼らに会ったのかい？岡崎兄弟も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100309,
					"content": "それと片山。彼は勝負をする前に、試合に名を付けるのが好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100310,
					"content": "「将来本物の剣豪になったら、すべての試合は本に書かれるものだ」って。はははっ、本当に突拍子もない発想だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100311,
					"content": "そうだ、それにあの島田だ。「永胤」から「光胤」へ、時代が移り変わっても、「初伝」を突破できなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100312,
					"content": "彼らは将軍様の「目狩り令」を理解できないため、逃げ道を選んだようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100313,
					"content": "過去彼らに剣術を教えた頃のこと、懐かしいな。俺はなぜ閉館して軍に入ったのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}、彼らの腕前はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100315,
					"content": "残念だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100318,
					"content": "#では、{NICKNAME}、お前の師匠は誰なんだ？土門？それとも渋川の流派？まさか鳴神本人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100319,
					"content": "「我流」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100321,
					"content": "岩蔵流も、とうとう俺の代で没落してしまったか。自ら教えた弟子は、師匠もいない人に試合で負けるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100322,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "そうか、分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100324,
					"content": "お前の流派は何であろうと、もうどうでもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100325,
					"content": "岩蔵流も、とうとう俺の代で没落してしまったか。自ら教えた弟子は、試合で流派も名乗らない人に負けるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100326,
					"content": "大成はしていないが、俺は一応岩蔵流の宗主だ。剣客として、「岩蔵光胤」と呼ばれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100327,
					"content": "秘剣の心得はもう覚えていない、「神の目」も将軍様にお渡しした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100328,
					"content": "…だが、この失墜に甘んじず、逆らった道を歩むならば、",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "岩蔵光造"
				},
				{
					"id": 721100329,
					"content": "不器用でも、お前に負けたあの門下生たちの仇を討つ人情が俺にはまだある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
