	],
	"talks": [
		{
			"id": 7368901,
			"completionStepIds": [
				7368901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368901",
							"2"
						],
						"stepId": 7368901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アナトール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736890101,
					"content": "はぁ、実験を再現できる条件がまったく揃ってないじゃないか。パトリック、助けたくないわけじゃないが、今回は自分で何とかしてもらうしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890102
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890102,
					"content": "いい方法も思いつかないし、何か美味しいものでも食べに行くかな。そうだ、腌篤鮮、腌篤鮮を食べに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890103
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890103,
					"content": "ふーん、でも腌篤鮮を食べられるとこってここからかなり遠いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890104,
					"content": "それもそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890105
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890105,
					"content": "うわっ、君たち何者だ？こんな誰も人が来ないところにいるなんて…ちょっと怪しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890106
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890106,
					"content": "えっ、そんな怪しいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890107,
						736890108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890107,
					"content": "パイモン、どうしてこんなところに！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				},
				{
					"id": 736890109,
					"content": "うっ、おまえだってオイラと一緒にここにいるだろ。どうしておまえまで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890110,
					"content": "腹が立ってきたぞ。どう言い返してやるか…そうだ、オイラたちがここにいるのは確かに怪しいけど、フォンテーヌのやつがここにいるのだって怪しいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890111,
					"content": "…え、本当に？他の人から見たら、僕って怪しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890112
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890112,
					"content": "フォンテーヌ人だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890113
					]
				},
				{
					"id": 736890113,
					"content": "#そうだそうだ！オイラと{NICKNAME}はあちこち冒険してるんだし、ここに来るのは別に普通のことだぞ。フォンテーヌ人のおまえのほうがよっぽど怪しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890114,
					"content": "#それもそうだな…ふむ、あちこち冒険してる{NICKNAME}…君の名前は{NICKNAME}というのか。じゃあ、飛んでる君は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890115
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890115,
					"content": "オイラの名前はパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890116,
					"content": "ああ、じゃあ僕も自己紹介をしよう。僕はフォンテーヌ科学院のエンジニアでアナトール。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890117
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890117,
					"content": "実は、はるばるフォンテーヌから来たのも、フォンテーヌ科学院のお偉方の意向でね。ある研究のためなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890118
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890118,
					"content": "璃月グルメの研究か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890119,
					"content": "璃月グルメ、ふふ…あっ、いや、科学院は機械とエネルギーを研究する機関なんだ。でも、グルメを研究する部署もいいな、ぜひ設立してほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890120
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890120,
					"content": "おっと、本題に戻そう。実はフォンテーヌ科学院の同僚が、鉱石や元素力の研究をずっとしてるんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890121
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890121,
					"content": "そうだ。君たち、よくここらを歩いてるなら、知ってるかもしれない。パトリックっていうんだが、知ってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890122,
						736890125
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890122,
					"content": "知らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890123
					]
				},
				{
					"id": 736890123,
					"content": "確かに知らないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890124,
					"content": "はぁ、パトリック…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890128,
					"content": "パトリックの研究には、ある特定の璃月の鉱石が大量に必要なんだが、予算と実験場所の経費などが原因で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890129
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890129,
					"content": "実験を行えなかったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890130,
					"content": "ああ…ある日、彼は残りの実験経費と実験機材を持ち出して姿を消した。フォンテーヌ科学院に耐えかねて夜逃げしたって、みんなそう言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890131
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890131,
					"content": "先に言っとくけど、僕は彼が研究を完成させられると信じてたんだ。裏で悪口なんかも言ってない。噂話ばかりしてるやつらとは違うからね。コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890132
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890132,
					"content": "とにかく、少し前に彼は生きてフォンテーヌ科学院に戻ってきた。それどころか、研究課題の実験結果まで持ち帰ってね。ああ、なんと涙ぐましい研究魂だろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890133
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890133,
					"content": "パトリックの話によると、彼は璃月を訪れてすぐその場で実験を行ったそうだ…想像を絶する多くの困難を乗り越え、ようやくその研究課題を終わらせたらしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890134
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890134,
					"content": "おお、それならよかったじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890135,
						736890137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890135,
					"content": "ああ、何もかもが上手くいったと思ったさ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890136
					]
				},
				{
					"id": 736890136,
					"content": "ここまでは、まあ後輩を称えるいい話なんだが…はぁ、この「だが」に続くことのほうが大事なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890139,
					"content": "ここで実験をしたこと自体が規則違反だったのさ…でも僕にも分かるよ。通常の手続きを踏むとなると、いろいろと複雑な申請書やら説明を書くのに半月はかかってしまうだろうからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890140
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890140,
					"content": "もちろん、実験の過程を照合する人もいない。それに、彼の出したデータがあまりに詳しすぎた…書類審査の段階で「捏造されたかのように詳細…」ってなってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890141
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890141,
					"content": "データが詳しかったのは、現地の冒険者協会の協力があったからと、パトリックは何度も弁解したけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890142
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890142,
					"content": "上の者はそういうのを信じない。だから形式上、彼のデータを検証するために、誰かが照合実験をしなければならなくなったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890143
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890143,
					"content": "うーん…つまり、照合実験をするために、わざわざフォンテーヌからここまで来て、パトリックがやったことをもう一回やる不運なやつが必要ってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890144,
					"content": "で、その不運なやつって誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890145,
					"content": "そうだね、その不運なやつってのは誰なんだろうね。あはは…その不運なやつってのが僕なのさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890146
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890146,
					"content": "パトリックはいい人だし、僕も彼のために検証をしてやりたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890147
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890147,
					"content": "でもいざここに辿り着くと、条件に合う鉱石が簡単に見つかっても、一人で実験を完成させるのはほぼ不可能だと分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890148
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890148,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890149,
					"content": "パトリックが一人で実験を完成させたから、僕も一人でやらなければならないと、そうみんな考えてるんだろう…ふん、憎たらしい機関だ。吹っ飛んでいい気味さ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890150
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890150,
					"content": "ふ…吹っ飛んだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890151
					]
				},
				{
					"id": 736890151,
					"content": "ふっ、そうさ、フォンテーヌ科学院では以前、ある実験のひどい暴走によって、大爆発が起きたんだ。だが、それでも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890152
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890152,
					"content": "理不尽な手続きと複雑すぎる管理体系は消えなかった。それどころか、ますます「精勤」するようになってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890153
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890153,
					"content": "はぁ…データ検証の実験なんてやめよう。申請した経費を使い切れなかったら、来年の予算が削減されることになるが…それなら、もういっそのこと璃月で美味しいものでも食べに行ったほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890154
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890154,
					"content": "だから、腌篤鮮とかなんとか言ってたんだな。そんな事情があったのか…うーん、でもそれじゃあ、パトリックはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890155,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890156
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890156,
					"content": "#ここで君たちに会えなかったら、諦めてたところだろう。でも、各地を冒険してる{NICKNAME}と…それからパイモンがいれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890157
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890157,
					"content": "どうか、どうか僕を手伝ってほしい。この実験を完成させてくれ。君たちにはきっとその力がある…それが僕には分かるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890158
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890158,
					"content": "報酬なら、往復の経費を除いてまだ三割くらい残ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890159
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890159,
					"content": "#別にその経費が欲しいからってわけじゃないけど、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890160,
						736890162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890160,
					"content": "はいはい、すべてはパトリックのために！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890161
					]
				},
				{
					"id": 736890161,
					"content": "おまえならそう言ってくれると思ったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890164,
					"content": "ああ、助かるよ二人とも。ふぅ…じゃあ、実験の内容を説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890165
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890165,
					"content": "パトリックが残した記録によると、「振晶」という名の鉱石が存在するらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890166
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890166,
					"content": "「振晶」中の「発振晶」が特定の刺激を受けるとエネルギーを放出し、「受振晶」の共鳴を引き出すそうだ。両者は「映射関係」にあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890167
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890167,
					"content": "その「映射関係」は何やら…力とか、共鳴とかを発生させて、ある種の…えっと、特定の対象に影響を及ぼすらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890168
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890168,
					"content": "う～ん？アナトール、本当にパトリックの記録をちゃんと読んだのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890169,
					"content": "とにかく、大体そんな感じのものだ。オホンッ、作り物の用語なんかただの飾りにすぎない…実験にとって、データだけが真実だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890170
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890170,
					"content": "まあ要約すると、君たちには「振晶映射」の影響のもと、実験場で戦ってもらいたいんだ。いいだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890171
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890171,
					"content": "#最初っからそう言ってくれればいいのに！おう、安心しろ。戦闘に関しちゃ、{NICKNAME}は得意だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890172,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890173
					]
				},
				{
					"id": 736890173,
					"content": "よし！では、これより実験を開始する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890174
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890174,
					"content": "ただ、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890175
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890175,
					"content": "おい、どうしたんだよ。なんでまた急にため息なんかついてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890176,
					"content": "腌篤鮮が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890177
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890177,
					"content": "もう腌篤鮮のことは忘れろって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890162,
					"content": "#じゃあ、パイモンの分の報酬も{M#俺}{F#私}に！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890163
					]
				},
				{
					"id": 736890163,
					"content": "ふん…ったく、ケチだな。そういう意味じゃなかったのに！コホンッ…手伝いはするけど、その経費もちゃんと報酬としてもらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890137,
					"content": "#それは{M#君}{F#あなた}とどう関係があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890138
					]
				},
				{
					"id": 736890138,
					"content": "ああ、ちょっと複雑な話になるんだが、この後の展開はかなり残念なことになっていてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890125,
					"content": "ちょっとだけ覚えがあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890126
					]
				},
				{
					"id": 736890126,
					"content": "よく覚えてないけど、確かにこの辺で鉱石をいじってるフォンテーヌ人に会ったことあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736890127,
					"content": "おそらく、それは彼で間違いないだろう。ああ、不運なパトリック…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "アナトール"
				},
				{
					"id": 736890108,
					"content": "確かにパイモンは怪しい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				}
			]
		}
	]
}