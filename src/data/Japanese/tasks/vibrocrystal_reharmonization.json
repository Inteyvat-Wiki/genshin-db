{
	"id": 73689,
	"type": "WQ",
	"name": "振晶、再び映射",
	"description": "フォンテーヌのとあるエンジニアが、何か奥深い研究をしているらしい…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5123,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
