			"dialogs": [
				{
					"id": 751501501,
					"content": "あっ、秘源の龍従だ…あれ、こいつほかのやつらよりでっかくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501502,
					"content": "ウルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501503,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501504,
					"content": "へへっ、また会ったな！さっき別れたばかりなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501505,
					"content": "…申し訳ございません。私のデータベースに皆さまの情報の記録はございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501506,
					"content": "ここへたどり着いた人類は…ここ五百年、いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501507,
					"content": "えっ、おまえは「アマル」でも「エカトル」でもないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501508,
					"content": "…確かにそれを識別名としている個体も存在します。しかし、その個体の中に私は含まれておりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501509,
					"content": "何か誤解があるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501510,
					"content": "私はシウコアトル様の情報記録のために作られたプロトタイプで、名前はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501511,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "いえ、名前がないわけではありません。私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501513,
					"content": "私は唯一知能を持つことを許された、非領主の龍従です。シウコアトル様がお亡くなりになられてからも、私は最も基本的な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501514,
					"content": "都市の最低限の整備と情報の記録を任されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501515,
					"content": "…しかし、影に潜みし敵の侵入により、記録の一部が失われてしまいました。したがって、今は自分の名前に関するデータがないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501516,
					"content": "うぅ、人違いだったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501517,
					"content": "お気になさらず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501518,
					"content": "うーん、このロボット、デカい割には頭が固そうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}、やっぱりあの機械の中から話しかけてきてたやつとは別人みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501520,
					"content": "でも…情報の記録を担当してるって言ったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501521,
					"content": "何か知ってないか聞いてみようぜ！例えば…うーん、「聖山の心」への行き方とか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751501522,
					"content": "これが秘源の龍従が導くってことなのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501523,
					"content": "じゃあ、いろいろ聞いてみよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				}
