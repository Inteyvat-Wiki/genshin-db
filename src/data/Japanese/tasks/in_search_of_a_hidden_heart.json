			"dialogs": [
				{
					"id": 751501301,
					"content": "ほかにご質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501302,
					"content": "聖山の心に入る方法は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "聖山の心の入口は新しく発掘された入口にあり…火山の底に続く裂け目は秘源の龍像に守られています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501304,
					"content": "また、聖山の心に立ち入るには、例外なく「許可」が必要です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501305,
					"content": "そうすることで初めて聖山の心、すなわち「ウィツィロポチトリ」…守る…あの秘源の龍像の許可が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501306,
					"content": "許可はどこでもらえるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "契約とシウコアトル様の命令によると、聖山の心、つまりは「ウィツィロポチトリ」に入るには…一族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501308,
					"content": "「審議の庭」にて申請を行った後、「許可」が下りるまでお待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501309,
					"content": "秘源の龍像は何のエネルギーで動くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "検索中…応答可能なデータ項目がありません…アビスの侵蝕により、多くのデータが失われています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501311,
					"content": "アビスの影響を排除し、データを回収できれば、必要項目を検索できる可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501312,
					"content": "回収可能なデータが残されている可能性のある地点をマークします。この地点のアビスの侵蝕を排除し、データの保管領域を復元してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501313,
					"content": "ほかにご質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751501314,
					"content": "もう大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "かしこまりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源の龍従"
				}
			]
