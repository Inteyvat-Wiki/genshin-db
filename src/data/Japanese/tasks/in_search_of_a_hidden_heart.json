			"dialogs": [
				{
					"id": 751500401,
					"content": "聖山の心に入る方法は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "聖山の心の入口は、再建されたトゥランの都市の中心にあります。安定した実験環境を確保するために、シウコアトル様は地底を掘り進め…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751500403,
					"content": "そこで対アビスの最終兵器を作りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751500404,
					"content": "しかし、それも「封印」のせいでアビスの最深部の侵蝕を受け、結果的に街を占拠されてしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751500405,
					"content": "聖山の心の入口は、聖都の裂け目の下…つまり「影に潜みし敵」の侵蝕が最も進んだ場所にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源の龍従"
				}
			]
		},
