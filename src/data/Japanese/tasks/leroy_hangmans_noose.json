						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "君たちの執着度合いから察するに、このまま大人しく帰るつもりはなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540702,
					"content": "てっきり執律庭に通報でもするかと思っていたが、君たちはそうしなかった。どうやら自分たちなりの考えを持っているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540703,
					"content": "どうしてブノワさんを拘束してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "実を言うと、僕は少し君たちを尊敬し始めているんだ。その力を適切な場所に活かせば、かなりの傑物になれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540706,
					"content": "まぁ残念だけど、この件についてはそうはいかないがね。まったく、怖いもの知らずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540707,
					"content": "脅す相手を間違えてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "ほう？自分の置かれている状況をまったく理解していないのか、それとも自分が正義を執行しているとでも思っているのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540709,
					"content": "そういえば…さっき新聞に載っていた溺死した商人の名前、ブランデッドと言ったな。ああ、とにかく口の達者なやつだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540710,
					"content": "知っているか？彼は溺死したのではなく、実は何者かに暗殺されたあと、湖に沈められたと新聞で報道されているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540711,
					"content": "マレショーセ·ファントムは長いこと調査をしたが、彼が何者かに殺害されたことと、彼を殺害した者は万死に値するということしか分からなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540712,
					"content": "さて、ニュース記事でもそう書かれているが、実際の状況はどうなのか…殺人犯のほうが万死に値するのか、それとも彼自身が万死に値するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540713,
					"content": "ふむ…これは複雑な問題だな。すぐには答えが出なさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540714,
					"content": "いかん、話がそれてしまったな。とにかく、これは僕たちが話すこととは何ら関係がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540715,
					"content": "一体なにが言いたいんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540716,
					"content": "あることをよく理解もせずに軽率に動くのは愚かな行為であり、悪い結果を招く可能性があると言いたいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540717,
					"content": "悪事に無関心でいることのほうが愚かだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "はは…もし違う状況で出会っていたら、僕たちはいい友人になっていたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540720,
					"content": "君の考え方は僕好みだが、僕にもやらなければならないことがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540721,
					"content": "大目に見てやるのはこれが最後だ。次に君たちが僕の家の近くをうろついていたら、手を下すことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540722,
					"content": "アトーズは訳の分からないことを言うと、その場を去った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "彼の奇妙な態度に驚いたあなたは、この件に対して自分はどんな立場を取るべきか、考えを巡らせた。すると…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "裏の窓からガラスを軽く叩く音が聞こえ、かすかな「キイッ」という音とともに、一枚のメモが窓からひらりと落ちてきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "そのメモには茶色の字が書いてある。かなり慌てていたのか、コーヒーを付けて書いたもののように見える…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "おい、なんて書いてあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540727,
					"content": "ブノワじいちゃんからだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540728,
					"content": "シーッ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "…ご、ごめん。とにかく、猫のフードボウルから目を離さないようにして合図を待とうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540718,
					"content": "#悪事に対して{M#俺}{F#私}は怯まず行動する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "ブノワさんとは一体どんな関係なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
