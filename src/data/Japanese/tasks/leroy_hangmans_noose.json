						],
						"pointId": 7534
					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#見ろよ、{NICKNAME}。この魚肉、新鮮だし地面もきれいだ。誰かが掃除したばかりに違いないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540802,
					"content": "やっぱりブノワじいちゃんの家には誰かいるんだ。様子を探ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540803,
					"content": "…彼の言うことも一理あるな。ずっと姿を消しているわけにもいかない。散歩なんかで時おり姿を見せる必要があるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540804,
					"content": "少なくとも、隣人が執律庭に通報するのを防げるはずだ。銃士隊が来るのは望ましくないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540805,
					"content": "お父さん、外に出て散歩がしたいでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540806,
					"content": "い…いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741540807,
					"content": "もちろんよ。それだけじゃなく、私たちも喜んでお散歩に付き合ってあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540808,
					"content": "助けを求める機会を与えないように、こちらも気をつけねば。例の二人がずっとここを見張っているようだからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540809,
					"content": "お父さんはそんなことしないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540810,
					"content": "ねぇお父さん、執律庭に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540811,
					"content": "「執律庭」がなんだって…？声が小さすぎてよく聞こえないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540812,
					"content": "出かけようとしてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "よし、なら距離を取って尾行しようぜ。今度こそブノワじいちゃんと話す方法を見つけなきゃだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540814,
					"content": "うん、そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "よし！じゃあ行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540816,
					"content": "お父さん、どうかしら？ちょっとは気持ちが晴れてこない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540817,
					"content": "お前さんたち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741540818,
					"content": "ブノワじいちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540819,
					"content": "…わ、わしを助け…いや、助けるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741540820,
					"content": "ふふっ、お父さんったら何を言ってるのかしら？助けるとか助けないとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540821,
					"content": "ああ、あなたたちだったの。お父さんがわざわざ声をかけたのは、知り合いだったからなのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540822,
					"content": "…いや、違う！わしらは知り合いでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741540823,
					"content": "違うの？そんなわけないでしょう。彼らはわざわざここであなたを待ってたんだから、お父さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540824,
					"content": "親切にも私たちのために新聞を届けてくれて、サーンドル河で昔の隣人、スノッドグラスに会って話もしていたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540825,
					"content": "あなたたちってとっても仲がいいんでしょう？お父さんは昔からずっと子供が好きだったものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540826,
					"content": "私も子供を愛してるけど、お父さんほど無私にはなれないわ。自分の子供が一番だもの…でも娘はいなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540827,
					"content": "一体何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "私とアトーズはお父さんの子供なの。お父さんは私たちを愛していて、それは私たちも同じ。そんなの当たり前でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540831,
					"content": "モルティシア、今日は天気が良くて散歩日和だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540832,
					"content": "そうね、アトーズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540833,
					"content": "今日のスチームバード新聞を読んだか？興味深いニュースがたくさん載っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540834,
					"content": "いいえ、まだ読んでないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540835,
					"content": "一つは、不幸にも亡くなった老人に関する記事——彼は目撃者のいない状況で強盗に遭い、誤って崖から転落して亡くなったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540836,
					"content": "そうなの？それはひどい話ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540837,
					"content": "もう一つは不幸にも溺死した商人の記事だ。酒を飲みすぎて千鳥足のまま湖に向かい、そのまま溺れ死んだらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540838,
					"content": "まあ…本当にかわいそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540839,
					"content": "さらに一番興味深い記事が、一人のお節介なお人好しがいて…そいつが誤って薬を飲み間違えてしまったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540840,
					"content": "毒薬を病気の治療薬だと思って飲んでしまい、ひどく苦しみながら死んでいったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540841,
					"content": "まあ…人の死に方って色々あるのね。もっと聞かせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540842,
					"content": "…す、すまない…もうあんなことはせんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741540843,
					"content": "お父さんったら何を言ってるの？別にお父さんを責めてるわけじゃないわ。それより、しばらく歩き回って疲れたでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540844,
					"content": "アトーズ、家に帰ってお父さんに新聞の内容を聞かせてあげましょ。お父さんはいつもたくさん新聞を取ってたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540845,
					"content": "そうだな。おしゃべりはもう十分だ、帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741540846,
					"content": "さ、戻りましょ。大好きなお父さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741540829,
					"content": "どうしてこんなことを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "お父さんと散歩に出てきたことを言ってるの？これは娘として当然の義務よ。でないと、お父さんからもらった愛情に応えることができないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "モルティシア"
				}
			]
		}
	]
}