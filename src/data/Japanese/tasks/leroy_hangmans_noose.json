			"dialogs": [
				{
					"id": 741540201,
					"content": "んん？おかしい！オイラでさえどこが変だかわかるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}は頭がいいだろ。これからどうすればいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540203,
					"content": "彼は助けを求めたけど、助けるなとも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "なら、もう一回ブノワじいちゃんの家の近くに行ってみるか？たしか裏側の窓のところに変な箱があったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540208,
					"content": "あの中に、おまえの推理を証明してくれるなにかが隠されてるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741540204,
					"content": "あの夫婦はおそらくサーンドル河出身…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "彼らの反応からして、何か隠してるはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "いくつか推理はしたけど確証はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
