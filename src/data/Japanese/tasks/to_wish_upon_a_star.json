			"dialogs": [
				{
					"id": 750210101,
					"content": "ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210102,
					"content": "…うわっ！びっくりした…落ちちゃったらどうするんだよ！まだ隠し能力に目覚めてない今の俺は、ただの子供にすぎないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210103,
					"content": "あっ、ごめん、わざとじゃなかったんだ。でも…隠し能力って…？なんかすごい必殺技とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210104,
					"content": "隠し能力なんだから、それが一体何なのか、俺にわかるわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210105,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "それより、星の欠片を見つけて来てくれない？俺、普段からカカママの手伝いをしてるから、小遣いは結構あるんだ。このモラは全部あげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210108,
					"content": "#頼みごとがあるんなら、まず名前くらい言ってくれよな。ちなみに、オイラはパイモンで、こいつは{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210109,
					"content": "今どき、名前なんてただのコードにすぎない…他の人たちにオルコって呼ばれてるから、あんたたちもそう呼んでいいぞ。それじゃ、星の欠片探しの件、手伝ってもらえる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210110,
					"content": "うーん、そもそも、星の欠片って一体なんなんだ？そう簡単に見つかりそうにないものに聞こえるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210111,
					"content": "星が空から落ちてくるときに散らばる欠片だよ。全部見つけて元の場所に戻せば、失われた力を取り戻すことができるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210112,
					"content": "#ほら、空から落ちてきた星がすぐあそこにあるでしょ。あそこに行けば、星の欠片の手がかりが見つかるはずだよ。優しい{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}、手伝ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210113,
					"content": "わかったわかった、手伝ってもいいぞ。でも、星の欠片とか失われた力って、なんか小説の中の話みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210114,
					"content": "あんたたち、クイールとウククの物語を聞いたことないのか？だったらこれやるよ。もう父ちゃんが何回も読んでくれたから、俺はもう丸暗記してるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210115,
					"content": "今はそんなことより、一緒に行って見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210106,
					"content": "子供なのに、変な理屈を言うね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
