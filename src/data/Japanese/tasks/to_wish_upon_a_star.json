				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "ふぅ——俺一人だったら絶対降りられなかったよ、ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210302,
					"content": "これが空から落ちてきた星なのか？近くで見ると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210303,
					"content": "なんだか体から謎の力が湧いてきた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "えっ！？本当かよ？って、まだ散らばった欠片を見つけてないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210305,
					"content": "にしても、本当にここに欠片の手がかりがあるのか？なんの見当もつかないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210308,
					"content": "次はどうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210309,
					"content": "怪力に頼るしかないだろ。<color=#00E1FFFF>テペトル竜並みの力で叩きつければ</color>、散らばった欠片の在り処がわかるかもしれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210310,
					"content": "#ほとんどの問題は力づくで解決できるって、父ちゃんが言ってたんだ。でも俺、まだ力に目覚めてないし、自分の竜もない…だから頼むよ、{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210306,
					"content": "この石、変だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "たしかに独特だな…でも、謎の力とかは感じないぞ…オイラが鈍感なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "パイモン"
				}
			]
		},
