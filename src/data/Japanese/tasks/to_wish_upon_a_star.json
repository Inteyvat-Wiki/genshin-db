			},
			"dialogs": [
				{
					"id": 750210701,
					"content": "うわっ！すっげー、星の欠片を全部見つけたんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210702,
					"content": "普段からカカママの手伝いをして、小遣いをたくさん貯めてるんだ。このモラは全部あげるから、星の欠片を譲ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210703,
					"content": "星の欠片？これが何に使うものか知ってるのか？それより、なんで子供がこんなところに一人でいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210704,
					"content": "他の人たちにオルコって呼ばれてるから、あんたたちもそう呼んでいいぞ。今どき、名前なんてただのコードにすぎないけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210705,
					"content": "俺は星の欠片を集めるためにここに来たんだ。ほら、下にあるでっかい石、見えるでしょ。あれが空から落ちてきた星だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210706,
					"content": "#散らばった欠片を戻せば、失われた力を取り戻すことができるんだ…ねぇ、頼むよ、{M#お兄ちゃん、お姉ちゃん}{F#お姉ちゃんたち}。俺はホントにこれらの星の欠片が必要なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210707,
					"content": "なんか怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "うーん…でも、一応手がかりにはなるかもな。試してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210711,
					"content": "にしても、星の欠片とか失われた力とか、なんか小説の中の話みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210712,
					"content": "あんたたち、クイールとウククの物語を聞いたことないのか？だったらこれやるよ。もう父ちゃんが何回も読んでくれたから、俺はもう丸暗記してるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210713,
					"content": "今はそんなことより、一緒に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210714,
					"content": "オルコとともに「落ちてきた星」のそばにやってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "#ねえ、{M#お兄ちゃん}{F#お姉ちゃん}、早く散らばった欠片を星に戻してよ！俺…どんな能力に目覚めるんだろう？もしかして、空を飛べたりして…えへへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210709,
					"content": "そんなうまい話、なおさら渡せないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "相手はただの子供なんだから、そこまでこだわる必要はないんじゃないか？それに、その話が本当かどうか、試したらわかるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "パイモン"
				}
			]
		},
