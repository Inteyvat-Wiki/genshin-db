					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "これで全部だよな？今回の依頼は思ってたよりずっと簡単だったな！でも、本当にそんな不思議なものなのか…？ちょっと前まで半信半疑だったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210502,
					"content": "パイモンも隠し能力に目覚めたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#おう！超強力な宝箱探知能力とか、一撃で魔物を倒せるスーパーパワーとか持ってれば、すっごく便利だろ！{NICKNAME}は欲しくないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210504,
					"content": "もっと力がほしい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "おおっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750210508,
					"content": "#ねえ、{M#お兄ちゃん}{F#お姉ちゃん}、早く散らばった欠片を星に戻してよ！俺…どんな能力に目覚めるんだろう？もしかして、空を飛べたりして…えへへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750210506,
					"content": "もう十分強いから要らないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "えっ？よく聞く話だと、力を追い求める道に果てはないんじゃなかったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "パイモン"
				}
			]
		},
