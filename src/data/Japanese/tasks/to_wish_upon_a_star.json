			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}、なにか不思議な力は感じるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211302,
					"content": "特に何も感じないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "このデカい石も、なにも変わらないな。不思議な光を出したり、ガタガタ震えたり、割れたりもしてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211304,
					"content": "うーん、さっきの秘文が間違ってたのか？それっぽい感じだった気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211305,
					"content": "でも、遺跡探索のときもたまにこういうことあるよな。パスワードとか暗号を間違えただけで、仕掛けが全然反応しなくなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211306,
					"content": "おっかしいな…これさえすれば、隠し能力が解放されるってある人に言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211307,
					"content": "この話を教えてくれた人はね——秘文を唱えた途端、目を覆いながら苦しそうな声を出して…その後すぐに宝石の価値を見極める「魔眼」を手に入れたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211308,
					"content": "わあ、かっこいい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "ん？なんか、胡散くさいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211311,
					"content": "あっ！やっと見つけた。もう、このおバカさん！どうしてこんなところまで来ちゃったの！なかなか見つからないから、お父さんが家で心配してるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211312,
					"content": "父ちゃんにはご飯の時間になったら帰るって言ったのに…なんでわざわざカカママに知らせるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211313,
					"content": "生意気言わないの！隣のお二人さんも、下でぐずぐずしてないで、早く上がってきなさい。いつまでも下にいると、何が起こるかわからないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211314,
					"content": "オルコを連れて地上に戻り、事情を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "はぁ、この子が言ってることなんて、子供の妄想よ。付き合ってくれたあなたたちも大変だったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211316,
					"content": "この子は小さい頃からお母さんがいなくて…お父さんも目が不自由で、きちんと面倒を見てくれる人がいないの。だからとてもいたずらっぽいところがあるのよ。私は隣人として何か力になりたいとは思うけど、さすがに限界もあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211317,
					"content": "そんなことだろうと思ってたぜ！石の欠片を集めるだけで不思議な力が手に入るなんて、そんなうまい話、あるわけないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211318,
					"content": "いたずらなんかじゃない…父ちゃんのためだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211319,
					"content": "このおバカさんったら、人の言うことなんて、ちっとも聞かないのね。今回は無事だったけど、もし大変なことになってたらどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211320,
					"content": "まあ、いいわ。とにかく、おとなしく私と一緒に帰りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211321,
					"content": "#わかった。でもその前に…{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}、約束通り、このモラは全部あげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211322,
					"content": "受け取ってあげてね。この子には約束を守る人になってほしいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211323,
					"content": "そこまで言うなら…ありがたく受け取っておくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211324,
					"content": "うん、もしかしたらまた頼むかもしれないしね。今回うまくいかなかったからって、次もうまくいかないわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211325,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750211326,
					"content": "この子ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "カカママ"
				},
				{
					"id": 750211327,
					"content": "#行こう、カカママ。父ちゃんが心配して待ってるから。それじゃ、優しい{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}、バイバイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルコ"
				},
				{
					"id": 750211310,
					"content": "その症状、どっかで聞いたことあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
