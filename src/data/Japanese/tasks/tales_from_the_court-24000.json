						240000302
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 240000302,
					"content": "「外部支援者情報登録票」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000303
					]
				},
				{
					"id": 240000303,
					"content": "リーヴァがどんな目に遭ったかを話し、記入用紙を分けてもらいたいことを説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000304
					]
				},
				{
					"id": 240000304,
					"content": "パレ·メルモニアを相手にしてると、こういう事は日常茶飯事なんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000305
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 240000305,
					"content": "ちょうど余ってるのが一枚あるから、届けてあげてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000306
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 240000306,
					"content": "ただ…パレ·メルモニアの事務効率に対しては、彼も変な期待を抱かないほうがいいと思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000307
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 240000307,
					"content": "仮に申請が受理されても正式な支給までかなり待たされるし、催促したって意味がないから。はぁ…",
					"roleType": "TALK_ROLE_NPC",
