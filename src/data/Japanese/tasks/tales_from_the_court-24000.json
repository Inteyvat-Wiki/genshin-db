						],
						"pointId": 4415
					}
				]
			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "もう一度言う——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000102,
					"content": "リーヴァさん、あなたの要求はよくわかるし、できる限り力になってあげたいけど、この申請内容は…ほら、見てくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000103,
					"content": "担当者はクラピエさんでしょ？あなたが提供したこれまでの書類は全部彼がまとめて提出するんです。つまり、担当者以外は処理しようがないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000104,
					"content": "クラピエさんはいま外回りに行ってるからオフィスにいないし…あなたの持って来てくれた書類にも彼の公印がないと、精算処理に回せなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000105,
					"content": "ハッ…！これで三度目だぞ。やる気はあるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000106,
					"content": "リーヴァさん、落ち着いて…クラピエさんのいるオフィスって、二人だけで回してるんですよ。もう一人はモントワさんっていうんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000107,
					"content": "もうお歳で定年前だから、最近はずっとオフィスにいないんです。もちろん給料も受け取ってないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000108,
					"content": "わかった、なら自分でそのオフィスに行く。そのモントヴァって人にハンコをもらって自分で押すさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000109,
					"content": "ごめんなさい、リーヴァさん…それはできないの。規則違反っていうのもあるけど、公印が入ってる棚の鍵はクラピエさんが持ってるから、結局彼じゃないと取り出せないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000110,
					"content": "それに私にも他にやらなきゃならない仕事があって…でも信じてください！クラピエ先生は絶対今日中に帰ってくるから、確実に処理してもらえるようにします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000111,
					"content": "わかったよ…それでは失礼、コーネリアさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000112,
					"content": "ええ。あなたもお気をつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 240000113,
					"content": "コーネリアは慌ただしく去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "今日もだめだったか…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000115,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "大したことじゃない。無駄足を踏んで、貴重な半日を台無しにしてしまっただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000118,
					"content": "クラピエって野郎にはウンザリだ！パレ·メルモニアが私たちの工房でいくつかクロックワークを注文していったんだが、まだ支払いがない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000119,
					"content": "最初に彼を訪ねた時は、「今は月末で月次会計監査があるから、来月頭にならないと出金できない」と言われて申請を断られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000120,
					"content": "二度目に来た時は「捺印用のインクを切らしているが、インク供給元の倉庫で火事があったので別の所から調達しないといけない」と言われてハンコを押してくれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000121,
					"content": "そして三度目には、この外部支援者情報登録票が更新されたからもう一度記入しろと言ってきた。だがそれも、用紙を切らしているから、明日にならないとダメだとさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000122,
					"content": "それで今日その用紙を取りにきたら、やつは不在だというじゃないか。くそっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000123,
					"content": "あら…リーヴァさん、何か悩み事？私にお手伝いできることはあるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000124,
					"content": "ラミアさん、ちょうどよかった。実はこんな状況なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000125,
					"content": "リーヴァは長々と事の経緯を話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "クラピエさんね…確かに付き合うには手を焼きがちな相手ではあるけど、彼は今日、本当にエリニュス島に行っていて、パレ·メルモニアにはいないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000127,
					"content": "でも、彼がどこにいようと関係ないわ。とりあえず例の用紙を手に入れましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000128,
					"content": "ん？しかしクラピエさんは用紙を切らしていると言っていたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000129,
					"content": "私に任せて。たしかパレ·メルモニアと長い付き合いのお店たちも、あなたと同じ状況に遭ったことがあったはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000130,
					"content": "それで彼らは、一定期間おきにパレ·メルモニアに来て、必要になるかもしれない記入用紙や書類をもらっていくの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000131,
					"content": "そうすることで、書類の記入や提出を手っ取り早く済ませられるでしょう。それだけじゃないわ。記入用紙や書類に変更があるかどうかも、いち早く知ることができる…まさに「備えあれば憂いなし」ってところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000132,
					"content": "も、もしかして用紙がなくなったのもそのせいなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000133,
					"content": "とにかく、きっと予備の最新版用紙を持っているお店があるはず。彼らの所に行って聞いてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000134,
					"content": "あなたが何度も無駄足を踏んだことを知れば、きっと彼らも手を貸してくれると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000135,
					"content": "そうね、パレ·メルモニアの業務終了時間までに用紙を手に入れて、記入してから、またクラピエさんのオフィスに届けないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000136,
					"content": "旅人さん、リーヴァさんに手を貸してあげてもらえない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000137,
					"content": "どうか手を貸してくれ、旅人！これ以上この件を片付けられなければ、私は今日も眠れない夜を過ごす羽目になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 240000138,
					"content": "わ、わかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "二か所のお店に行って、最新版の「外部支援者情報登録票」をもらってきてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000141,
					"content": "そうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000142,
					"content": "エスタブレさんの鍛冶工房、それからカロンさんの時計店に行ってきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000143,
					"content": "先日、エスタブレさんはパレ·メルモニアの街灯を修理してくれたし、カロンさんはパレ·メルモニアの時計を直してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000144,
					"content": "二人ともパレ·メルモニアの職員ではないけど、しょっちゅうパレ·メルモニアから仕事をもらってきてるから、きっと手元に「外部支援者情報登録票」を残してるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000145,
					"content": "じゃあよろしくね。私とリーヴァさんも手分けして他のお店に聞いてみるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラミア"
				},
				{
					"id": 240000139,
					"content": "#でも、{M#俺}{F#私}は何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
			"id": 2400002,
			"completionStepIds": [
				2400002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400002",
							"2"
						],
						"stepId": 2400002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エスタブレ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "ったく面倒だね…これっぽっちの報酬でさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000202,
					"content": "「外部支援者情報登録票」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "リーヴァがどんな目に遭ったかを話し、記入用紙を分けてもらいたいことを説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "はぁ、リーヴァのやつもついてないね。でも…アタシも予備は持ってないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000205,
					"content": "パレ·メルモニアで街灯を修理した時に店の子を一人、手伝いとして連れていったんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000206,
					"content": "でもあの子はほとんど役に立たなかったから、「外部支援者情報登録票」には名前を書かなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000207,
					"content": "でも、いざその用紙を提出しようとしたらさ、クラピエが「全員分必ず記入するように」って言うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000208,
					"content": "しかも正確に書かないと、「計り知れない深刻な結果」になるとまで言い放ったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 240000209,
					"content": "ほんの一人書かなかっただけで、どんな「深刻な結果」になるってんだか。無茶苦茶だよ…",
					"roleType": "TALK_ROLE_NPC",
