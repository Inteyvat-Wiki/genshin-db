			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天おじ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180601,
					"content": "天おじに視察の詳細を話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180602
					]
				},
				{
					"id": 110180602,
					"content": "ゴホッゴホッ…ふむ、大体わしの予想した通りだったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180603
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180603,
					"content": "単刀直入に聞くわ。知易の計画における考えが、天おじととても似ていたことには何か理由があるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180604
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180604,
					"content": "お前さんたちに候補者の名簿を渡したとき、実は言ってなかったことがある。お前さんたちの判断に影響を与えてしまうかもしれないと思ってな。だが、今ならそれも話していいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180605
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180605,
					"content": "あの三人はかつて、わしのもとで学んだことがある者たちなんだ。わしに似ているところがあっても、おかしくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180606
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180606,
					"content": "だが乾瑋は商業で忙しくしておったし、明博も総務司でやるべき仕事があった。あの二人と比べると、知易はもっとも長い間わしのそばにいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180607
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180607,
					"content": "へぇ、そうだったのか。天おじは、どんなきっかけであの三人と知り合ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180608,
					"content": "乾瑋はある旧友からの推薦で、明博には仕事をしておったときに目をつけた。知易は…ははっ、意外な巡り会いだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180609
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180609,
					"content": "最初は釣り友として偶然知り合ったんだが、それがだんだん親しくなって、色んな話題を話すようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180610
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180610,
					"content": "知易は貧しい家の出身でな、両親も早くに亡くしている。だがあいつは才能に秀でていて、何事も学ぶのが早かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180611
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180611,
					"content": "あいつを見て、若い頃の自分を思い出したんだ。釣りについても、ちょっとした助言をしただけで、すぐ理解していたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180612,
						110180613
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180612,
					"content": "「友達」みたいな関係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				},
				{
					"id": 110180614,
					"content": "ああ。気づかないうちに、こんな高みまで成長してくれた。今思うと、本当に感慨深いよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180615
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180615,
					"content": "若者が成長していく中、わしは老いてしまった。時間は過ぎるのが早すぎる…やはり生老病死は、誰にとっても避けられないものなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180616
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180616,
					"content": "あら、天おじはまだまだ元気だし、あと何年か仕事できると思うけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180617
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180617,
					"content": "お前さんはまったく…慰めてくれんでもいい。気力が足りなくなったのも、そう悪いことじゃない。肩の荷を下ろせれば、ただの爺さんのように、自由に釣りに行けるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180618
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180618,
					"content": "天おじは釣りが好きなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180619,
					"content": "暇つぶしがしたい時は、釣りが一番さ。釣ったばかりの魚はすごく新鮮で、水辺でさっと処理するだけで、美味しい魚スープになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180620
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180620,
					"content": "新鮮な魚スープ！わぁ、聞いただけで美味そうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180621,
					"content": "そうだろう？それにちょっと前、知易もベテランの漁夫から特別なレシピを購入したらしくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180622
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180622,
					"content": "近頃は釣りに行くと、いつも知易が下処理を済ませた副材料を持ってきてくれるんだ。それを加えると、より美味くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180623
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180623,
					"content": "何度も味わいたい美味しさだが…この老いぼれじゃ、あと何回飲めることやら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180624
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180624,
					"content": "きっとまだまだ何回も飲めるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180625
					]
				},
				{
					"id": 110180625,
					"content": "次はオイラも連れてってくれよ！オイラも飲みたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180626,
					"content": "話を戻すけど、天おじ。報告を聞いて、結論は出たのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180627
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180627,
					"content": "お前さんに視察を任せたからには、お前さんの判断を信じよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180628
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180628,
					"content": "もし、知易とわしの考え方の類似についてお前さんたちが聞いてこなければ、わしも三人との関係について言及するつもりはなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180629
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180629,
					"content": "選考は公平を期すべきもの。このような外的要素はすべて無視し、候補者の才能や能力を徹底的に調査したうえで、結論を出してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180630
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180630,
					"content": "くれぐれも…「徹底的な調査」を忘れずにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180631
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180631,
					"content": "分かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180632
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180632,
					"content": "行きましょう、場所を変えて話したいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180633
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180633,
					"content": "それじゃあ天おじ、オイラたちは先に行くな。体に気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180634,
					"content": "夜蘭と共に茶室の外に出た…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180635
					]
				},
				{
					"id": 110180635,
					"content": "うーん…やっぱり知易で決まりでいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180636,
					"content": "だってほら、計画書もよくできてるし、話上手だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180637,
					"content": "急がなくてもいいわ。視察に時間制限はないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180638
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180638,
					"content": "えっ、もしかしてまだなにかテストがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180639,
					"content": "それはないわ、彼ら本人に対する視察は終了した。でも、一つ君たちに教えておいてあげるわ——目に見えるものが真実とは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180640
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180640,
					"content": "情報に関する仕事で最も禁忌なのが、当事者からしか情報を得ないことよ。真実の外側には、常に霧がかかっている。だから、様々な道で情報を集めないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180641
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180641,
					"content": "文淵、商華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180642
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180642,
					"content": "はっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180643
					],
					"speakerTitle": "文淵"
				},
				{
					"id": 110180643,
					"content": "何でもお申し付けください、夜蘭様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180644
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180644,
					"content": "急に知らない人が現れた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180645
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180645,
					"content": "驚かせちゃったかしら？この二人は私の部下、文淵と商華よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180646
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180646,
					"content": "腕利きの助手として、普段は近くに目を配らせてるの。こうして必要に応じて、各種任務に就いてもらってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180647
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180647,
					"content": "商華は商業に精通していて、交渉で情報を得ている。文淵は、よく演説から情報を得ているわ。この場にはいないけど、二人以外にもう一人、武沛って部下もいるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180648
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180648,
					"content": "あのデカブツ、海上で長いこと任務をやってるみたいだが、大丈夫なのか？あいつは泳げなかったと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180649
					],
					"speakerTitle": "文淵"
				},
				{
					"id": 110180649,
					"content": "けっ、あいつは運がいいから、あれしきの波どうってことないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180650
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180650,
					"content": "商華、各商会に赴いて、乾瑋の背景事情を調べてくれるかしら。文淵、君は璃月総務司へ行って、明博の仕事記録を調査してきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180651
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180651,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180652
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180652,
					"content": "えっ？知易はいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180653
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180653,
					"content": "知易？もちろん彼は最も有力な候補者として、私たちが直々に調査するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180654
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180654,
					"content": "まずは埠頭に行きましょう。あそこは人も多いし、色んな情報が行き交う場所よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180655
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180655,
					"content": "情報っていえば、「万有商舗」の博来に聞いてみるのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180656
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180656,
					"content": "あいつはいつも北埠頭で商売をしてるから、なにか情報を聞いたことがあるかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180657
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180657,
					"content": "なるほど、悪くないわね。彼に聞いてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180613,
					"content": "「家族」みたいな関係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				}
			]
		},
		{
