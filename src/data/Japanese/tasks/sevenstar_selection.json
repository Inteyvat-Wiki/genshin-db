			},
			"dialogs": [
				{
					"id": 110181701,
					"content": "そういえば、今回の視察官がどなたか、ご存知でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181702
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181702,
					"content": "いや、知らない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181703
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181703,
					"content": "俺も知らない。まあ、ちゃんとものの分かった人であることを願うよ。素人に視察されるのだけは御免だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "乾瑋"
