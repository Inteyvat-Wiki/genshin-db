			},
			"dialogs": [
				{
					"id": 110180901,
					"content": "（知易の計画書。内政、外交、監査など様々な方面が考慮されており、とても詳しく書かれている。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180902
					],
					"speakerTitle": "知易の計画書"
				},
				{
					"id": 110180902,
					"content": "（「問題の解決」が中心となっており、それぞれの問題に明確な解決策が出されている。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180903
					],
					"speakerTitle": "知易の計画書"
				},
				{
					"id": 110180903,
					"content": "（ぶ厚すぎて、流し読みするしかない…）",
					"roleType": "TALK_ROLE_NPC",
