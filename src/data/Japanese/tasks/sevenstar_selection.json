			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180101,
					"content": "#{NICKNAME}、パイモン、久しぶり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180102
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180102,
					"content": "あっ、慧心！久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180103,
					"content": "こんなところで会うなんて奇遇だな。仕事は順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180104,
					"content": "君たちや甘雨先輩のおかげで、だんだん慣れてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180105
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180105,
					"content": "でも最近、仕事中に気が散ってしまいがちで、落ち着かないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180106
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180106,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180107
					]
				},
				{
					"id": 110180107,
					"content": "えっと…話すと長くなるんだけど…父上が…身体のことを理由に、「天枢」を辞任することになって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180108
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180108,
					"content": "えっ——天おじになにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180109,
					"content": "正確には、父上曰く、体の不調はないらしいんだけど、気力が落ちてきてるって言うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180110
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180110,
					"content": "「誰しもいつか老いる日が来る」って、よくそう言ってたけど…実際に顔のしわがどんどん深くなっていくのを見ていると、やっぱりなんとも言えない気持ちになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180111
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180111,
					"content": "そうだ、父上はいま岩上茶室の二階にいるから、よかったら会って行ってあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180112
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180112,
					"content": "父上は君たちのことをすごく気に入ってるみたいだから、もし話をしに行ってくれたらきっと喜ぶと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180113
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180113,
					"content": "そうだな！じゃあ、はやく行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1101803,
			"completionStepIds": [
				1101803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101803",
							"2"
						],
						"stepId": 1101803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天おじ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180301,
					"content": "天おじ！遊びに来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180302,
					"content": "おっ？これはまた珍しい客だ、歓迎するよ。慧心や、下にいる店長に、新しく届いた茶を淹れてくるよう頼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180303
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180303,
					"content": "聞いたところによると、お前さんたちは色んな場所に行ってるらしいな。わしもお前さんたちの冒険譚を、ぜひ聞いてみたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180304,
						110180305
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180304,
					"content": "それより天おじの体が心配。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				},
				{
					"id": 110180306,
					"content": "もう慧心から聞いているようだな…だが心配するな、体は大したことないんだ。歳月人を待たずと言ってな、ただの老いさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180307
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180307,
					"content": "年を重ねるにつれ、色んな事が思うようにこなせなくなってな。ここ最近は、気力もめっきり減ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180308
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180308,
					"content": "みなはわしを高く評価してくれているが、ボケないうちに、天枢の座を次に譲ろうと考えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180309
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180309,
					"content": "天枢の座を譲るのって…面倒なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180310,
					"content": "璃月七星の中でも、天枢は比較的特殊な存在なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180311
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180311,
					"content": "歴代の天枢はほとんど公には出ず、その多くは背後で策を考える裏方だった。公開選考に向く役職じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180312
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180312,
					"content": "それに、候補者ができるだけ各方面や勢力からの影響を受けないようにしたい。だから、審査や任命は比較的内密に行われるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180313
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180313,
					"content": "そんな訳で、一般的に天枢の後任と言うのは、前任天枢の意見と残りの七星による承認によって決まるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180314
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180314,
					"content": "つまり…天おじが候補者を推薦して、刻晴や凝光たち七星が任命するってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180315,
					"content": "そうだ。だが今のわしの体調を考えると、候補者を一人一人選別する余裕はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180316
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180316,
					"content": "まあ、心配する必要はない。このために、能力の秀でた視察官を特別に連れてきた。そういえば、お前さんたちも既に彼女に会ったそうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180317
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180317,
					"content": "ん？誰のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180318,
					"content": "あら、ひどいわね…この間会ったばかりなのに、もう私のことを忘れちゃったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180319
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180319,
					"content": "夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180320,
					"content": "そうよ。天おじに頼まれて、私が三名の候補者を調査することになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180321
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180321,
					"content": "#{NICKNAME}、君も一緒に来ない？次の天枢と事前に知り合える、またとない機会よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180322
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180322,
					"content": "うーんと…おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180323,
						110180325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180323,
					"content": "良い機会だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180324
					]
				},
				{
					"id": 110180324,
					"content": "だよな、オイラもそう思うぜ！七星と良い関係を築くのって、悪くないことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180328,
					"content": "じゃあ、それで決まりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180329
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180329,
					"content": "そういえば天おじ、あなたは普段、光の当たらない裏で策を企てるのが好きみたいだけど、私も闇の中での行動には慣れてるわ。私も天枢になれる素質があると思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180330
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180330,
					"content": "えっ！夜蘭も天枢になりたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180331,
					"content": "わしは構わんが、お前さんは凝光とも長い付き合いだろう。彼女がお前さんを簡単に手放すとは思えんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180332
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180332,
					"content": "ふむ、ではこうしよう…もし視察の結果、資格のある者が誰もいなければ、お前さんを推薦しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180333
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 110180333,
					"content": "いいわ。ま、このことは別に急ぐ必要はないものね。それと、視察についてはすでに手配してあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180334
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180334,
					"content": "あとで、一階で会いましょう。それまで…君たちは話の続きでもしてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180335
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180335,
					"content": "それから代金はいらないわ。岩上茶室の「新たな主」として、質の良いお茶ぐらいはご馳走させて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180336
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180336,
					"content": "天おじと最近の冒険について話したあと、茶室の入り口に戻った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180337
					]
				},
				{
					"id": 110180337,
					"content": "話は済んだかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180338
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180338,
					"content": "天おじ、元気なさそうで…ずっとうとうとしてたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180339,
					"content": "ええ。こんなことを言うのは気の毒かもしれないけれど、今の天おじの精神状態じゃ、これほど複雑な仕事をこなすのは無理ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180340
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180340,
					"content": "天おじの推薦した候補者は全部で三名。乾瑋、明博、知易よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180341
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180341,
					"content": "乾瑋は豪商の生まれよ。明博は璃月総務司に勤めていて、最後の知易は学を求めて旅をしているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180342
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180342,
					"content": "なんとなく覚えておいて…まあ、忘れてしまっても大丈夫なんだけどね。あとで、月海亭で直接彼らを視察するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180343
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180343,
					"content": "乾瑋、明博、それから知易…どうにか覚えたけど、「視察」ってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180344
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180344,
					"content": "その話は、月海亭に着いてからにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180345
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180345,
					"content": "気合を入れておいて。これは七星交代という一大事…どんなに些細なことも見逃すことはできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180346
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180346,
					"content": "わかった！ちゃんと目をかっぴらいて行くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180325,
					"content": "興味ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180326
					]
				},
				{
					"id": 110180326,
					"content": "たしかに…次の天枢が誰になろうと、オイラたちとは関係ないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180327,
					"content": "でも、天おじがどんなやつを候補者に選ぶのか、オイラちょっと気になるぞ！やっぱり見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180305,
					"content": "体は大丈夫なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				}
			]
		},
		{
			"id": 1101804,
			"completionStepIds": [
				1101804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101804",
							"2"
						],
						"stepId": 1101804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乾瑋",
					"明博",
					"知易",
					"夜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180401,
					"content": "立ちっぱなしで足がしびれてきた…まったくあの視察官は何を考えてるんだ。こんなに大事な場に、椅子すら用意してないなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180402
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180402,
					"content": "色んなやつと接してきたが、立ったまま待たされるなんてこれが初めてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180403
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180403,
					"content": "ふむ、俺は…別になんとも思わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180404
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180404,
					"content": "それは、あんたがそういう扱いに慣れてしまったからだ。いつもそんな風に現状を受け入れてると、この先何も変えられなくなるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180405
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180405,
					"content": "お前というやつは、どうしてそう…理不尽なことを言うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180406
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180406,
					"content": "まあまあ二人とも、こんな些細なことで争うなんて、割に合いませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180407
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180407,
					"content": "乾瑋さん、確かに言い過ぎですよ。明博さんもあまり気にしないで…こんなに長く立ちっぱなしで待たされたら、誰だって少しは苛立ちを覚えるものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180408
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180408,
					"content": "別に立って待たなければならないという決まりはないんだし、いっそのこと、近くの商会から椅子を借りてくるのはどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180409
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180409,
					"content": "それもいいかもな。あそこの椅子の材質はあんまり良くないが、使えるだけマシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180410
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180410,
					"content": "夜蘭と一緒に視察現場に着いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180411
					]
				},
				{
					"id": 110180411,
					"content": "どうやら、候補者たちはすでに三人とも揃っているようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180412,
					"content": "つまり今の三人が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180413
					]
				},
				{
					"id": 110180413,
					"content": "ええ、すぐに彼らと正式に会うことになる。でもその前に、まずは今回の視察の流れを君に説明するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180414
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180414,
					"content": "視察は大きく二つに分けられる。「時事方略」と「現場問答」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180415
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180415,
					"content": "前者では、彼らに璃月の発展計画を提出してもらう。後者は、私たちが直接面と向かって彼らに質問をするってことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180416
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180416,
					"content": "璃月の発展計画を書くのには時間がかかるだろうから、あらかじめ彼らに言っておいたわ。これが彼らの提出して来た報告書よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180417
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180417,
					"content": "うわぁ、一冊だけぶ厚いのがあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110180418,
					"content": "ついでに言っておくと、彼らには一つ要求をしてあるわ。誰が天枢になろうと、自分が立てた計画内容はきちんと実行すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180419
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180419,
					"content": "よほどのことがない限り、計画書の内容を変更することは許されない。だから、今ここにある三つの書類は、彼ら三人の「立場」を表しているのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180420
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180420,
					"content": "まだちょっと時間があるから、目を通しておいて。彼らに対する第一印象を持っておくといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180421
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180421,
					"content": "私はここで待ってるから、読み終わったら言ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
		{
			"id": 1101806,
			"completionStepIds": [
				1101806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101806",
