				}
			]
		},
		{
			"id": 1101810,
			"completionStepIds": [
				1101810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101810",
							"2"
						],
						"stepId": 1101810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110181001,
					"content": "もう読み終わったの？何か感想は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181002
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181002,
					"content": "なんか、みんな真面目だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181003,
					"content": "当然よ。天枢の選考に関わることだから、みんな全力を出し切っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181004
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181004,
					"content": "何より、ひとたび着任すれば、その計画に従って業務を執り行うことになるから悔いは残したくないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181005
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181005,
					"content": "夜蘭はどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181006
					]
				},
				{
					"id": 110181006,
					"content": "ふふっ、まだ秘密。「現場問答」が終わってから、じっくり話し合いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181007
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181007,
					"content": "もう候補者を連れてきていいわよ。一人ずつ、まずは乾瑋からね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181008
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181008,
					"content": "かしこまりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181009
					],
					"speakerTitle": "礼安"
				},
				{
					"id": 110181009,
					"content": "礼安が乾瑋を連れてきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181010
					]
				},
				{
					"id": 110181010,
					"content": "ほう？あんたら二人が今回の視察官か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181011
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181011,
					"content": "これほど重要なことは凝光様が直々に視察するだろうとは思っていたが、まさか俺の知らない顔が来るとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181012
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181012,
					"content": "俺の計画書はもう読んだんだろ？何か理解できないところがあったら、俺に聞くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181013
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181013,
					"content": "な、なんて上から目線なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181014,
					"content": "悪いな、別に意図があってのことじゃない。ただ事実を述べているだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181015,
						110181016
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181015,
					"content": "その話し方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				},
				{
					"id": 110181017,
					"content": "留雲借風…その仙人を知ってるのか？ふむ…そうか思い出したぞ。あんたが、みんながうわさにしてたあの旅人なのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181018
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181018,
					"content": "名のあるやつなら、それなりに才能もあるんだろう。もしかしたら俺の構想を理解できるかもな…ふんっ、まあ、あまり期待はしていないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181019
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181019,
					"content": "夜蘭が乾瑋に一通り質問したあと、明博を呼んだ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181020
					]
				},
				{
					"id": 110181020,
					"content": "あっ…俺の番か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181021
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181021,
					"content": "ええ、簡単に自己紹介してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181022
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181022,
					"content": "俺は明博、総務司に所属している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181023
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181023,
					"content": "総務司で仕事をした時間は、九年と…五か月…三日になる。これまで…二千三百四十七件の案件を取り扱ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181024
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181024,
					"content": "まだ十二件が処理途中で…およそ…十六日後にすべて解決する予定だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181025
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181025,
					"content": "現在は、都市計画に関わる仕事をしながら、勘定明細の受け取りと検査をしている。勘定は三つの部分に分けられていて、それぞれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181026
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181026,
					"content": "なんか、たまに言葉がつっかえてるのは、オイラの気のせいか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181027
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181027,
					"content": "自己紹介はそこまででいいわ。直接質問するわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181028
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181028,
					"content": "あ、ああ…すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181029
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181029,
					"content": "夜蘭はなんとか一通りの質問を終えると、知易を呼んだ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181030
					]
				},
				{
					"id": 110181030,
					"content": "こんにちは。ふぅ…正直、本当に緊張しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181031
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181031,
					"content": "お二方はどんなことがお聞きになりたいのでしょうか？視察と言うことですから、出来る範囲ですべてお答えいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181032
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181032,
					"content": "君の計画書は様々な分野に言及しているけれど、君自身はそれほど多くの事業をやったことがないみたいね。自分の計画をきちんと達成できると保証できるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181033
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181033,
					"content": "容赦ない質問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181034
					]
				},
				{
					"id": 110181034,
					"content": "そのような疑問を抱かれるのも、ごもっともだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181035
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181035,
					"content": "ですが計画に関しては、自信があります。私はかつて、数多くの場所を視察してきました。現地の専門的な方とも交流を行い、結論を導き出したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181036
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181036,
					"content": "もちろん、異なる問題が複雑に入り交じれば、それぞれの結論も衝突する。ですので私が求めたのは「均衡」、つまりすべての問題の中から「最適解」を見つけることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181037
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181037,
					"content": "じゃあ、その導き出した答えが本当に「最適解」かどうかは、どうやって判断するつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181038
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181038,
					"content": "計画を実行する前は、同僚や月海亭の秘書たちが評価をしてくれるでしょう。計画を実行した後は、最終的にどうなったかがそのまま結果となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181039
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181039,
					"content": "私の判断が間違っていた場合は、相応の責任を取るつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181040
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181040,
					"content": "悪くない答えね。では、次の質問にいきましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181041
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181041,
					"content": "夜蘭が一通り質問をすると、知易は去っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181042
					]
				},
				{
					"id": 110181042,
					"content": "なんか付き合いやすそうなやつだったな！話もよくまとまってたし、すごく聴きやすかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181043,
						110181044
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181043,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181045,
					"content": "これで、簡単なまとめができそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181046
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181046,
					"content": "君も見た通り、乾瑋は見識が広く、計画書に書かれた案も的を射ているものが多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181047
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181047,
					"content": "でも、とても傲慢で頑固な性格。周りの人の気持ちは考えそうにないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181048
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181048,
					"content": "明博の計画はより包括的で、安定していたわ。非常に繊細で、細かいところにまで目を配る性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181049
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181049,
					"content": "でも彼は乾瑋とはまったくの真逆ね。口下手で、人との交流においては弱々しい印象があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181050
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181050,
					"content": "おお、たしかにその通りだったな。さすが夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181051
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181051,
					"content": "最後は知易。彼の計画は非常に詳細で、確実な方策もある。これほど幅広い分野に心を配れる人はなかなかいないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181052
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181052,
					"content": "これは表面的に取り繕われたようなものじゃない。よほど力を注がないとできないことよ。それに謙虚で穏やかだから、人付き合いの方も問題はなさそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181053
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181053,
					"content": "でも私が特に興味深いと思ったのは、彼の意見の多くが天おじと同じだったことよ。もし知易が着任すれば天おじも安心できそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181054
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181054,
					"content": "やったぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181055
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110181055,
					"content": "さあ、行きましょう。戻って天おじにこれを伝えるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181044,
					"content": "特にどうとも思わなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181016,
					"content": "もしかして留雲借風の弟子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				}
			]
		},
