				]
			},
			"dialogs": [
				{
					"id": 706780301,
					"content": "へえ、パフォーマンスも順調みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780302
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780302,
					"content": "もしお客さんが新しい「パフォーマンスのコツ」…つまり、「かっこよくて優雅な姿勢」を学びたいなら、友情の証として、宝箱から獲得したおもちゃの勲章と交換しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780303
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780303,
					"content": "友情っていいもんだよな。この単語を聞いただけで、心も胃袋も暖かくなる気がするよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780304,
						706780306
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780304,
					"content": "友情は確かにいいもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780305
					]
				},
				{
					"id": 706780305,
					"content": "オイラもそう思うぜ！「胃袋も暖かく」ってところがちょっと気になるけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706780308,
					"content": "話を戻すけど、おもちゃの勲章と交換って言ってたよな…おもちゃなのに、そんな価値があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706780309,
					"content": "「信じる」ことさえできれば、おもちゃの勲章は黄金だって超える価値を持つようになる。それこそが幻想の魔法のコツなんだって、魔女の姉ちゃんがよく言ってた。俺にはよく分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780310
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780310,
					"content": "まあ、「パフォーマンスのコツ」も魔女の姉ちゃんに願い事をすることで手に入る知識だから、姉ちゃんがそれでいいならいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780311
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780311,
					"content": "うぅ、それでも安心できないぞ…だって、物語じゃよくあるだろ？軽い気持ちで魔法使いに願い事をしたら、後から払えない代償を求められたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706780312,
					"content": "お客さん、何の心配もないって。第一、そもそも魔女と魔法使いは違う。それに、代償には「おもちゃの勲章」を支払うんだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780313
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780313,
					"content": "そ、そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706780314,
					"content": "そうさ。それに…魔女に願い事をするのはこの俺なんだから、仮に他の代償が必要だとしても、払うのは俺だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780315,
						706780316
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780315,
					"content": "…どうしてそんなに誇らしげなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780317,
					"content": "俺もお客さんのパフォーマンスが好きだから、やり甲斐があるさ。あれ、そういえば、物語の本の白紙ページはあと何枚だっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780318
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780318,
					"content": "あっ、二人は心配しなくていいぞ。たとえ今の分がすべてが埋まったとしても、後からまた新しい白紙が追加されるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780319
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780319,
					"content": "楽しみにしてるぞ。すべてのページが物語に満たされる日を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706780316,
					"content": "何だか申し訳ないな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780306,
					"content": "胃袋を暖かくしてくれる最高の仲間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780307
					]
				},
				{
					"id": 706780307,
					"content": "最高の仲間の話になるたびに、「非常食」ネタを持ち出そうとするなよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "パイモン"
				}
			]
		},
