					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706785102
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706785102,
					"content": "もしよかったら、もう一回舞台に上がってパフォーマンスを披露してくれ。報酬として宝箱からおもちゃの勲章がもらえるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子オオカミ"
