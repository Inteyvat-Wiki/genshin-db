				"points": []
			},
			"dialogs": [
				{
					"id": 220330701,
					"content": "点心か。どれを作ればいいんだろうな？あの人の代わりにオイラたちが選んでやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330702,
					"content": "そうだな…オイラが好きな点心は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330703,
					"content": "安くて美味しい米まんじゅう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330704,
					"content": "見た目が印象的なハスの花パイ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330705,
					"content": "柔らかで弾むような歯ごたえの三色団子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330706,
					"content": "パイモンが食べたいだけでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "えへへ、オイラのセンスを信じろ！さあ、早く一つ選ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330708,
					"content": "米まんじゅうにする",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "いいと思うぞ！じゃあさっそく米まんじゅうを作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330710,
					"content": "ハスの花パイにする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "よーし！じゃあさっそくハスの花パイを作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330712,
					"content": "三色団子にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "よし！じゃあさっそく三色団子を作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330714,
					"content": "もう少し考える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "そうか。決めたらさっそく作って湯雯さんに渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
