			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "うぅ…璃月料理が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330802,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "あなたは？その格好…あなたが旅人ですね。失礼しました、私はただ故郷が懐かしくなってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330804,
					"content": "璃月料理が食べたいって言ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "え？もしかして…璃月料理を作れるのですか？助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330819,
					"content": "そ、それでは早速お願いします。本場の璃月料理を食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330820,
					"content": "悩みますね…私が今一番食べたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330821,
					"content": "点心が食べたいです。伝統的な璃月の甘い点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330822,
					"content": "最近目を閉じると、まるで夢を見ているかのように、素敵な点心の王子様がやってくるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330823,
					"content": "お焦げの長靴、豆腐の帽子をかぶり、米まんじゅうの羽毛を身に付け、ハスの花パイの扇子を手にする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330824,
					"content": "変なかっこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "彼は町の点心屋から現れ、爽やかな香りを漂わせながら、私の前を通り過ぎていった…その香りは心に刻んだかのように、今もはっきりと覚えています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330827,
					"content": "お願いします、点心の王子様を連れてきてください！お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330825,
					"content": "お米と小麦粉がもったいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "何かお困りごとでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "まずは自己紹介させてください。私の名前は湯雯。璃月の歴史学者で、稲妻の特徴的な風習や民話を調査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330807,
					"content": "現地での情報収集がほぼ終わり、璃月に帰る予定でした。しかし、最近稲妻には大事件が頻発していて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330808,
					"content": "今の稲妻は、歴史的な瞬間を迎えていると感じました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330809,
					"content": "今のこの状況は、必ずテイワットの歴史に大きな足跡を残すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330810,
					"content": "そのような歴史を自分の目で確かめ、全てを正しく記録し、子孫へと残すことこそが歴史学者の使命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330811,
					"content": "しかし…どんなにやりがいのある仕事でも…私のお腹を満たすことはできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330812,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "お腹が空いた…というわけではありません。フフッ、稲妻の料理もとても美味しいので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330814,
					"content": "ここの「天ぷら」が特に好きです。ただよく考えてみますと…衣を包んで油で揚げただけのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330815,
					"content": "長い間稲妻料理しか食べていないので、璃月料理が食べたくなりました。しかし、本場の璃月料理が食べられるお店はなかなか見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330816,
					"content": "先日、勢いで冒険者協会に行って「料理依頼」を出したのですが、なかなか引き受けてくれる人がいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330817,
					"content": "試してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
}