			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330101,
					"content": "うぅ…璃月料理が食べたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330103
					]
				},
				{
					"id": 220330103,
					"content": "あなたは？その格好…あなたが旅人ですね。失礼しました、私はただ故郷が懐かしくなってしまったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330104,
						220330105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330104,
					"content": "璃月料理が食べたいって言ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				},
				{
					"id": 220330118,
					"content": "え？もしかして…璃月料理を作れるのですか？助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330119
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330119,
					"content": "そ、それでは早速お願いします。本場の璃月料理を食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330120
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330120,
					"content": "悩みますね…私が今一番食べたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330121
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330121,
					"content": "点心が食べたいです。伝統的な璃月の甘い点心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330122
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330122,
					"content": "最近目を閉じると、まるで夢を見ているかのように、素敵な点心の王子様がやってくるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330123
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330123,
					"content": "お焦げの長靴、豆腐の帽子をかぶり、米まんじゅうの羽毛を身に付け、ハスの花パイの扇子を手にする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330124,
						220330125
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330124,
					"content": "変なかっこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330126,
					"content": "彼は町の点心屋から出てきました。爽やかな香りを漂わせ、私の前を通り過ぎていった。その香りは心に刻んだかのように、起きている今もはっきりと覚えています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330127
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330127,
					"content": "お願いします、点心の王子様を連れてきてください！お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330125,
					"content": "お米と小麦粉がもったいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330105,
					"content": "何かお困りごとでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330106
					]
				},
				{
					"id": 220330106,
					"content": "まずは自己紹介させてください。私の名前は湯雯。璃月の歴史学者で、稲妻の特徴的な風習や民話を調査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330107,
					"content": "現地での情報収集がほぼ終わり、璃月に帰る予定でした。しかし、稲妻の鎖国令が原因で、ここに留まらざるを得なくなってしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330108,
					"content": "しかし実は、運が良かったとも思っています。何故なら今稲妻は、歴史的な瞬間を迎えていると感じているからです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330109,
					"content": "今のこの状況は、必ずテイワットの歴史に大きな足跡を残すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330110,
					"content": "そのような歴史を自分の目で確かめ、全てを正しく記録し、子孫へと残すことこそが歴史学者の使命なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330111,
					"content": "しかし…どんなにやりがいのある仕事でも…私のお腹を満たすことはできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330112
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330112,
					"content": "お腹が空いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330113
					]
				},
				{
					"id": 220330113,
					"content": "お腹が空いた…というわけではありませんが、フフッ、稲妻の料理も美味しいとは思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330114
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330114,
					"content": "ここの「天ぷら」が特に好きです。ただよく考えてみますと…衣を包んで油で揚げただけのもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330115
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330115,
					"content": "長い間稲妻料理しか食べていないので、璃月料理が食べたくなりました。しかし、本場の璃月料理が食べられるお店はなかなか見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330116,
					"content": "先日、勢いで冒険者協会に行って「料理依頼」を出したのですが、なかなか引き受けてくれる人がいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330117
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330117,
					"content": "試してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				}
			]
		},
		{
			"id": 2203302,
