							"2203303",
							"2"
						],
						"stepId": 2203303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "ああ！間違いありません！こ、これこそが夢にまで見た故郷の味…まさに…うう…感動です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330302,
					"content": "ありがとうございます！これほど美味しいものを食べることが出来て、私もやる気が出てきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330303,
					"content": "これはお礼です、あなたのこれからの旅が順調でありますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203304",
							"2"
						],
						"stepId": 2203304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "おや、このお味…璃月の料理でも稲妻の料理でもないですね。新鮮なお味です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330402,
					"content": "私が食べたかった料理ではありませんが、新鮮な味を楽しめたので、とても満足です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330403,
					"content": "旅人、ありがとうございます。これはお礼です、受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203305",
							"2"
						],
						"stepId": 2203305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "あら？こ、これも稲妻料理なのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330502,
					"content": "私が依頼した料理ではないと思うのですが…まあ、いいとしましょう。この料理で、お腹いっぱいになりましたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330503,
					"content": "とにかく感謝します、旅人。これを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2203306,
			"completionStepIds": [
				2203306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203306",
							"2"
						],
						"stepId": 2203306,
