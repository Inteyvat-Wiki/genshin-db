					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "え？こ、この料理…味がなんだか…微妙です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330602,
					"content": "微妙というよりも…奇妙と言った方が正しいのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330603,
					"content": "このような料理を作り出せるなんて、あなたの料理の腕も…なかなか独特なのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330604,
					"content": "お疲れ様でした！お礼を受け取ってください。この料理は…後でゆっくりといただきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
