				"points": []
			},
			"dialogs": [
				{
					"id": 220330201,
					"content": "もう戻ってきたのですか？まさか正体を隠した料理人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330202,
					"content": "うぅ…もう待ちくたびれました。一口でも食べさせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220330203,
					"content": "ごゆっくりどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "さっき話した料理は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "えーっと…米まんじゅう、ハスの花パイと三色団子だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220330206,
					"content": "決めたら湯雯さんに渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 2203303,
			"completionStepIds": [
				2203303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
