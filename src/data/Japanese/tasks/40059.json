			},
			"dialogs": [
				{
					"id": 400595401,
					"content": "万葉、なんでこんなところにいるんだ？会場に行かないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595402,
					"content": "海風にあたっているのでござるよ。会場の賑やかな雰囲気は、性に合わぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595403
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595403,
					"content": "万葉、本当に大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595404
					]
				},
				{
					"id": 400595404,
					"content": "ふふっ、やはりまだ拙者を心配していたのでござるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595405
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595405,
					"content": "かたじけない。しかし案ずるでない。以前みなの前で言った言葉は、決してその場しのぎのものではないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595406
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595406,
					"content": "ふむ、例えば目の前にあるこの見慣れた港口も…かつては船が停泊するようになるなどと考えもしなかったでござろう？昔ここにあったのは、招かざる客を警戒する勘定奉行の役人のみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595407
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595407,
					"content": "しかしそれが今、こんなにも賑やかになっているではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595408
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595408,
					"content": "他の国から稲妻へ来る者がいるだけでなく、海祇島との交流も増えてきている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595409
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595409,
					"content": "そうだな。今の稲妻は、もう昔とは全然違うよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595410,
					"content": "拙者が思うに、もしかすると拙者たち人間も、この国と同じなのかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595411
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595411,
					"content": "費やす時間は違えど、その身に負った重荷を下ろせる時が、いつか必ず来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595412
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400595412,
					"content": "それを本当に下ろした時、風と共に前へ行けるのであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				}
			]
		},
