			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400595101,
					"content": "旅人、パイモン、来たんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595102
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595102,
					"content": "サイン販売は順調？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595103
					]
				},
				{
					"id": 400595103,
					"content": "ああ、君たちのおかげでとても順調に進んで、読者たちも大いに満足してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595104
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595104,
					"content": "行秋…オイラの気のせいかもだけど、なんかおまえ…ずっと周りを気にしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595105,
					"content": "気のせいではないさ。恥ずかしながら、璃月から来た客がいないかと警戒しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595106
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595106,
					"content": "僕はあくまでも、商品の投資価値を見極めるという名目で稲妻へ来ている。もしも僕を知る者に見られたら、父上にも隠し通せないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595107
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595107,
					"content": "幸い、今日は小説を買いに来てくれる沢山の読者が列を作っているから、一般の観光客はほとんど寄ってこないんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595108
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595108,
					"content": "そうだ、実は阿旭も、僕がここへ来た本当の目的を知らないんだ。もし彼に会ったら、僕のために内緒にしておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595109
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595109,
					"content": "分かった、安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595110
					]
				},
				{
					"id": 400595110,
					"content": "ありがとう。すまないが、まだ読者が待っているから、今はあまりゆっくり話していられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595111
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595111,
					"content": "あとで、黒主の肖像画の除幕式が始まったらまた会おう。",
