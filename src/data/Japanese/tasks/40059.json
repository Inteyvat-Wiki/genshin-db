			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400590101,
					"content": "やあ、旅人にパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590102
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400590102,
					"content": "なあアルベド、最後の黒主の肖像画、なんで布で隠されてるんだ？オイラ、おまえの描いた黒主がどんなのか見たかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400590103,
					"content": "慌てることはない。少ししたら肖像画の除幕式が行われるからね、その時に見られるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400590104,
					"content": "この肖像画はボクの自信作なんだ。これを完成させるため、特別にある人を訪ねて、貴重なアドバイスをもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590105,
						400590106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400590105,
					"content": "何か謎が深まってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400590107
					]
				},
				{
					"id": 400590107,
					"content": "フフッ、そうかい？除幕式までにはまだ時間があるから、会場を回ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400590106,
					"content": "何か怪しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400590107
					]
				}
			]
		},
		{
			"id": 4005910,
			"completionStepIds": [
				4005910
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005910",
							"2"
						],
						"stepId": 4005910,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"平山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591001,
					"content": "皆さん、ようこそ「光華容彩祭」へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591002
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591002,
					"content": "容彩祭は、無事本日、最終段階を迎えることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591003
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591003,
					"content": "只今より、モンドからお招きした画家、白亜先生による五歌仙最後の肖像画——『黒主』を公開いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591004
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591004,
					"content": "き、緊張するな…なにを描いたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591005,
					"content": "それではご一緒に、三、二、一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591006
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591006,
					"content": "これはいったい…どうして背景しかないのでしょう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591007
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591007,
					"content": "白亜先生に限って、描き忘れはあり得ないでしょうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591008
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591008,
					"content": "この絵の創作理念について、先生ご自身にお聞きしてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591009
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591009,
					"content": "この度は、五歌仙の肖像画を描かせていただくことになり、とても嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591010
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591010,
					"content": "五歌仙は古くから稲妻に伝わる伝説の人物。かつては詩歌で名を轟かせ、そしてやがて彼ら自身も作品に描かれ、数々の物語の主人公となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591011
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591011,
					"content": "現存する資料を見ていくうちに、これらの物語において、「黒主」の身分は非常に多種多様なものであることが分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591012
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591012,
					"content": "それだけでなく、個人の章節がないにもかかわらず、彼はまるで五歌仙物語の「裏の主人公」のような存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591013
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591013,
					"content": "こうは考えられないだろうか。黒主に対する考えは、一人一人のクリエイターによって異なるものだと。だから、ボクも黒主の想像をこの場のみんなに任せたいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591014
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591014,
					"content": "容彩祭は、一人一人が創作を通して、心の中にあるものを表現する場なのだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591015
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400591015,
					"content": "さすがアルベド！ああやって説明することで、すぐにみんなを納得させたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591016,
					"content": "へへ、これでオイラたちの容彩祭での冒険も、円満に終わったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591017,
						400591018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591017,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591019
					]
				},
				{
					"id": 400591019,
					"content": "ん？まだなにか忘れてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591020,
					"content": "うーん…あっ！！そういえば五歌仙物語を残した人を、オイラたちまだ探し出せてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591021,
					"content": "でも、考えがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591022
					]
				},
				{
					"id": 400591022,
					"content": "本当か？はやくオイラに聞かせてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591023,
					"content": "#まずその人は{M#俺}{F#私}たち全員のことを知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591024
					]
				},
				{
					"id": 400591024,
					"content": "うんうん、そうだよな。じゃないと、毎回うまい具合に紙を渡したりできないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591025
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591025,
					"content": "それに、その人は楓原家と関係がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591026
					]
				},
				{
					"id": 400591026,
					"content": "そうだな。物語は、行秋のことについてだったけど…本当の目的はオイラたちが万葉の家の秘密を解き明かすための誘導だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591027
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591027,
					"content": "わかったぞ！物語を残したのは、きっと「あいつ」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591028
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591028,
					"content": "よし！さっそく真相を解明しに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591018,
					"content": "何か忘れてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591019
					]
				}
			]
		},
		{
			"id": 4005911,
			"completionStepIds": [
				4005911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005911",
							"2"
						],
						"stepId": 4005911,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591101,
					"content": "綾人、五歌仙物語を残したのって、やっぱりおまえだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591102,
					"content": "ひどいぞ！みんな知ってる仲なのに、オイラたちをいじくり回すなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591103,
					"content": "ふふっ、実は本日ここへ来たのは、貴方がたに事の次第を説明するためだったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591104
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591104,
					"content": "ふんっ、どう説明するか聞いてやろうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591105,
					"content": "まず、事の発端はとある偶然でした。ある日の夜、八重様が行秋さんと編集さんが本を運んでいるのを見かけたのです。面白いと思われた八重様は、彼らをからかうように持ちかけてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591106
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591106,
					"content": "えっ、きっかけは神子だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591107,
					"content": "うぅ…たしかに神子がやりそうなことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591108,
					"content": "ええ。ですがその後、五歌仙物語を通して情報を与え、貴方がたが楓原家の秘密を探るようにと誘導したのは、確かに私です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591109
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591109,
					"content": "そのような方法を取ったのは、やむを得ないことだったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591110
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591110,
					"content": "やむを得ない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591111
					]
				},
				{
					"id": 400591111,
					"content": "以前、「ある事」をきっかけにして、楓原義慶が残した盆栽の中に、白紙の紙切れが隠されているのを発見しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591112
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591112,
					"content": "それがただの紙切れでないことは分かっていましたが、紙の秘密を解き明かすのには時間がかかりました。そう——水に濡れた時のみ現れる墨汁です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591113
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591113,
					"content": "楓原義慶が手紙に残したことは、神里家や楓原家の末裔たち、そして何よりも楓原万葉にとって、とても重要なものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591114
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591114,
					"content": "楓原一族はかつて神里家の配下にあったのに、私の先祖は当時、彼らを守ることができなかった。ゆえに、私にも彼を気にかける義務があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591115
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591115,
					"content": "彼には真相を知る権利がありますが、しかし…秘密に触れることは危険と隣り合わせでもある。私は、彼に真相を知る「意志」と「能力」があるかどうか、見極める必要があったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591116
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591116,
					"content": "もちろん、私の知った真相を言葉で彼に伝えることもできました。ですが、もし彼に知る「意志」がなかった場合、真実は彼の負担になったことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591117
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591117,
					"content": "それに、相応の「能力」がなければ、真実は見つけられない。もしその程度なのであれば、危険からは遠のいていたほうが彼の身のためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591118
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591118,
					"content": "楓原義慶もこれを考慮して、このような方法で情報を残したのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591119
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591119,
					"content": "しばらくの間、私はこのことをどう伝えるべきか悩んでおりました。『沈秋拾剣録』が密かに運ばれて行った、あの夜まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591120
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591120,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591121,
					"content": "じゃあなぜ他の人まで巻き込んだの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591122
					]
				},
				{
					"id": 400591122,
					"content": "そうだぞ。万葉だけじゃなくて、オイラたちまでおまえの計画に引きずり込まれたじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591123,
					"content": "ふふふっ、やはり貴方の目は誤魔化せませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591124
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591124,
					"content": "私は、この一件が貴方がたにとっても、価値のあるものであると判断したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591125
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591125,
					"content": "そしてそれ以上に、万葉と綾華が真相を見つけた時、彼らのそばに信頼できる友がいてほかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591126
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591126,
					"content": "それらの友は、冷静な判断ができるよう守ってくれる人々であり、困難に遭遇した時に手を差し伸べてくれる存在でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591127
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591127,
					"content": "それに、将来貴方がたも、同じ敵に直面するかもしれませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591128
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591128,
					"content": "「国崩」って誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591129
					]
				},
				{
					"id": 400591129,
					"content": "もう、心の中に答えがあるのではないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591130
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591130,
					"content": "それにこの答えは、あの「黒主」の肖像画に隠されていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591131
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591131,
					"content": "肖像画の近くに人がいなくなったら、ご自分の目で見てきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591132
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591132,
					"content": "真実を明らかにする方法については…もう幾度も使っているので、お分かりでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 4005915,
			"completionStepIds": [
				4005914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005914",
							"2"
						],
						"stepId": 4005914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591501,
					"content": "もう夜遅いし、周りに誰もいなくなったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591502,
					"content": "綾人が言った何度も使った方法って、水をかけることだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591503,
					"content": "あっ！これ…散兵だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591504,
					"content": "まさかとは思ったけど、こいつが当時の黒幕だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591530,
					"content": "肖像画の近くに人がいなくなったら、ご自分の目で見てきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591531
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591531,
					"content": "真実を明らかにする方法については…もう幾度も使っているので、お分かりでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591505
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591505,
					"content": "最後にもう一つ、話しておきたいことがございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591506
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591506,
					"content": "先ほど、「ある事」がきっかけで盆栽に気付いたと話しましたね。その詳細を貴方がたにも話しておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591507
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591507,
					"content": "あれは、将軍様が鎖国令を撤回したばかりの頃のこと。天領奉行で何かの事件が起きたというのが耳に入りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591508
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591508,
					"content": "証拠品や盗品が保管されていた倉庫に、泥棒が入った形跡を見つけたのです。けれど、何も消えてはいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591509
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591509,
					"content": "私はこれを普通の事件だとは思えず、天領奉行の九条裟羅にこう伝えました——当分の間は、何もなかったかのように振る舞い、倉庫の警備を強化したり場所を変えたりしないでほしいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591510
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591510,
					"content": "そして私は終末番に倉庫を見張らせました。すると、やはり何者かが倉庫に忍び込み、楓原家の物を物色している姿を見つけたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591511
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591511,
					"content": "まさか、そいつもあれを探して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591512,
					"content": "その者を少し泳がせましたが、結局何も見つけられなかったようで船で稲妻を出て行きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591513
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591513,
					"content": "なんで捕まえなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400591514,
					"content": "ふふっ、秘密を守る一番いい方法は、秘密がないふりをすることだと思いませんか？それにその者の正体も、決して推測が難しいというわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591515
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591515,
					"content": "その者が稲妻を離れた後に、私も本格的に楓原家の物品を調査しました。そしてあの盆栽の中に、あれらの紙切れを見つけたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591516
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591516,
					"content": "すぐに、これらの紙こそが、侵入者が探していた「秘密」だと確信しました。まあ、あの者も「秘密」が本当にあるかどうかは確信がなかったと思いますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591517
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591517,
					"content": "さて、最後の質問です——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591518
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591518,
					"content": "楓原義慶が書き記した経験の中で、どの部分が正真正銘守られるべき秘密だと思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591519,
						400591520,
						400591521
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591519,
					"content": "一族が陥れられたことを楓原義慶が知ってる事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				},
				{
					"id": 400591522,
					"content": "ふふっ、この問題に関しては、私もまだ答えが出せていません。これは宿題として、未来の貴方に託しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591523
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591523,
					"content": "今は、容彩祭をゆっくり楽しんでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591520,
					"content": "犯人の名が国崩だと楓原義慶が知ってる事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				},
				{
					"id": 400591521,
					"content": "相手が楓原義慶を見逃した事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				}
			]
		},
		{
			"id": 4005951,
			"completionStepIds": [
				4005903
