			},
			"dialogs": [
				{
					"id": 400595201,
					"content": "旅人さん、パイモンさん。ごきげんよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595202
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595202,
					"content": "あっ、綾人！やっとおまえに会えたぜ。すごく忙しいみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595203,
					"content": "やるべきことが多く、なかなか抜け出せませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595204
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595204,
					"content": "幸い、容彩祭は順調で、此度の三奉行での協力体制もうまくいきました。これで、やっと少し休めそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595205
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595205,
					"content": "私とお兄様から、お二人にお礼を申し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595206
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595206,
					"content": "ふむ、トーマ…遅いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595207
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595207,
					"content": "トーマを待ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595208
					]
				},
				{
					"id": 400595208,
					"content": "はい。せっかくお兄様の時間があるようですので、今日は本を買いに連れて行ってもらう約束をしたのです。しかしお兄様がお財布を家に忘れてしまったので、今トーマに取りに行ってもらっているところで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595209
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595209,
					"content": "綾人にもおっちょこちょいなところがあるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595210,
					"content": "うふふ、お兄様は日頃からお勤めが忙しいので、公務を離れられるのは滅多にないことなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595211
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595211,
					"content": "それゆえ、たまに見られるそそっかしいお兄様の姿は、私とトーマからしたら貴重なのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
