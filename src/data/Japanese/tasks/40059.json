					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400595301,
					"content": "童たち、楽しんでおるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595302
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595302,
					"content": "なんでおまえたち二人が一緒にいるんだよ！それに、なんで今の今まで話をしてたのに、オイラたちが近づいた途端にやめるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400595303,
					"content": "なに、汝らの気のせいじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595304,
					"content": "ボクたちはお酒のおつまみについて話していたんだ。君たちだってそんなの興味ないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595305
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400595305,
					"content": "うむ、おつまみと言えば、油揚げがいいと思うのじゃがのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595306
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595306,
					"content": "もういいよ！たとえこの二人がなにか企んでいたとしても、オイラたちには絶対教えてくれないんだろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
