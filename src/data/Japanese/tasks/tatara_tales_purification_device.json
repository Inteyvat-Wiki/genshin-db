			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "まだ少し時間が必要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160102,
					"content": "データは集めた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "お前か。データの収集はまだだ。もう少し時間がかかると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160104,
					"content": "この時間を使って、応急浄化器を設計するとしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160105,
					"content": "応急浄化器とは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "俺の応急技術を集めたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160109,
					"content": "前に話した計画通り、ファデュイと「祟り神」、この二つの厄介な問題を同時に対処する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160110,
					"content": "お前なら、きっとファデュイのヤツらを倒せると信じている。もちろん俺は「祟り神」の方を対処する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160111,
					"content": "この応急浄化器は、「祟り神」の対処をするための装置だ。この装置の製作には、お前の助けが必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160112,
					"content": "何を手伝えばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "この装置を「御影炉心」の中で機能させるには、特殊な材料が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160118,
					"content": "「晶化骨髄」のように、不活化の「祟り神」の力を含む結晶がちょうどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160119,
					"content": "実はかの有名な「玉鋼」の秘密は、製錬時に特殊な方法でこの材料を加えることで、鋼鉄の強度を大幅に向上させる点にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160120,
					"content": "もちろん、この「特殊な方法」は企業秘密なんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160121,
					"content": "確かこの近くに結晶鉱物があるはずだ。「晶化骨髄」を3つ集めてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160122,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "それじゃあ、「晶化骨髄」を3つ頼む。全部集めたら、俺のところに持って来てほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160113,
					"content": "正式な名前が別にあるかと思ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "「応急浄化器」が正式な名前だが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160115,
					"content": "あ…製品コードと製造年月日の正式コードのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160116,
					"content": "こういう応急措置に、そういったのはいらないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160107,
					"content": "それも「緊急措置」の一種？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "まあな。ただ通常の顧客対応では、この技術を提供してないんだがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
