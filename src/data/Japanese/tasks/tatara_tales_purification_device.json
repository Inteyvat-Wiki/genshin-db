			"dialogs": [
				{
					"id": 721160401,
					"content": "ありがとう。これで基本の構築には十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160402,
					"content": "ここからは、ビーコンが十分なデータを集めるのを待つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160403,
					"content": "データが手に入ったら、これらデータに基づいて装置の微調整を行う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721160404,
					"content": "すべての準備が整ったら、この件を徹底的に解決して行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
