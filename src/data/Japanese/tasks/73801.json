				"points": []
			},
			"dialogs": [
				{
					"id": 738010301,
					"content": "デーヴァーンタカ山の南っていっても…かなり範囲が広いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010302,
					"content": "ここは見晴らしがいいな。誰か来ないか、ここで待とう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010303,
					"content": "パイモンとしばらく待つことにした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738010304
					]
				},
				{
					"id": 738010304,
					"content": "おい、あっちから誰か来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010305,
					"content": "やけに遅かったな。何か厄介事でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010306
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010306,
					"content": "…ごめん。誰かが箱をひっくり返したみたい。私たちのことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010307
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010307,
					"content": "ちっ、バレたか？…いや、最近「上」から誰か来たという話は聞かない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010308
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010308,
					"content": "多分…ニカじゃない？あの子たち最近、遊びに連れて行けってしつこいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010309
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010309,
					"content": "おい…だから言っただろ。必要以上に地元の人間と仲良くするなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010310
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010310,
					"content": "でも、みんないつも親が家にいないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010311
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010311,
					"content": "まぁいい。とにかく、今日ここを出て行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010312
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010312,
					"content": "出て行く？つまり…スメールを離れるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010313,
					"content": "助っ人もなしにあの計画は…本当に成功するの？「上」の奴らに知られたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010314
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010314,
					"content": "余計な心配をするな…第一、お前はまだこんなことを続けたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010315
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010315,
					"content": "毎日ビクビクして、いつも誰かに警戒されて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010316
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010316,
					"content": "ファデュイを抜けたいなら、今日が最後のチャンスだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010317
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010317,
					"content": "わ、分かってる。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010318
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010318,
					"content": "あいつら…ファデュイを抜けたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010319,
					"content": "行ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010320
					]
				},
				{
					"id": 738010320,
					"content": "うん、でも油断するなよ。あいつらはまだファデュイなんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
