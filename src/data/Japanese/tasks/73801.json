			},
			"dialogs": [
				{
					"id": 738010401,
					"content": "ふっ、やっと姿を現したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010402
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010402,
					"content": "気づいてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010403
					]
				},
				{
					"id": 738010403,
					"content": "ずっと同じ場所で盗み聞きしてただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010404
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010404,
					"content": "風が吹いた時、お前が隠れていた茂みの様子だけ、明らかに周りと違ったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010405
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010405,
					"content": "さ、さすがファデュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010406,
					"content": "金髪と…隣にいる変な妖精。お前らが報告書に載っていた「旅人」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010407,
						738010408
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010407,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010410
					]
				},
				{
					"id": 738010410,
					"content": "ここに来たってことは、箱の中身を見たんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010411
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010411,
					"content": "まさか、アレクサンドラの機転がほんとに役立つとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010412,
						738010413
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010412,
					"content": "#{M#君}{F#あなた}たち、一体何が狙い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010414,
					"content": "…お前たちも聞いた通り、俺とアレクサンドラはファデュイを抜けるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010415
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010415,
					"content": "そんな目で見るなよ。俺たちは権力のあるお偉いさんじゃなければ、前線で働く戦闘員でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010416
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010416,
					"content": "スパイなんてのは、せいぜい適当な場所で使いっ走りにされるのが関の山…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010417
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010417,
					"content": "俺たちみたいな奴は掃いて捨てるほどいるが、その中で役目を与えられるのはほんの一握りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010418
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010418,
					"content": "にもかかわらず、「ファデュイ」の一員というだけで、みなに警戒されながら一生を送らなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010419
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010419,
					"content": "そんなのは耐えられない。ここで人生を無駄にするくらいなら、思い切ってファデュイを抜けた方がましだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010420
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010420,
					"content": "だが、ファデュイから足を洗うのは簡単じゃない。誰かに知られたらきっと…ひどい目に遭わされる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010421
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010421,
					"content": "だから「死んだふり」をする計画を立てたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010422
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010422,
					"content": "でも、それには説得力のある人に、私たちの「死」を証明してもらう必要があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010423
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010423,
					"content": "旅人、お前は俺たちの間でも有名人だ。それに…幸い、ファデュイとは何かと因縁がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010424
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010424,
					"content": "お前が「ファデュイ」2人の死を見届けてくれるなら、何も言うことなしだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010425,
						738010428
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010425,
					"content": "#{M#俺}{F#私}が来るって確信があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010426
					]
				},
				{
					"id": 738010426,
					"content": "確信はなかったが、お前が来るまで待つつもりではいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010427
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010427,
					"content": "我慢強さは、俺の数少ない長所の1つだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010431,
					"content": "旅人、事情は洗いざらい話した。協力するかどうかは、君が決めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010432
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010432,
					"content": "協力してくれるなら、報酬はたっぷり支払う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010433
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010433,
					"content": "その報酬だけど、私とプレヴァが堅気の仕事で稼いだお金だから、心置きなく受け取って。本当よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010434
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010434,
					"content": "そう…私は子供たちに夕飯を作って、服をつくろって、お話を聞かせて、遊びに連れて行くの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010435
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010435,
					"content": "プレヴァは狩りをして、獲物をさばく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010436
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010436,
					"content": "ファデュイを抜けたら、そういう仕事で生きて行くつもり。それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010437
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010437,
					"content": "アレクサンドラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010438
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010438,
					"content": "え…ああ、そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010439
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010439,
					"content": "とにかく、選ぶのはそっちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010440,
						738010442
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010440,
					"content": "協力するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010441
					]
				},
				{
					"id": 738010441,
					"content": "恩に着る、旅人。報酬ははずむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010447,
					"content": "そうと決まれば、善は急げだ。手分けして準備するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010448
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010448,
					"content": "アレクサンドラ、そっちはお前に任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010449
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010449,
					"content": "旅人は俺について来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010442,
					"content": "#{M#俺}{F#私}が裏切るのが怖くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010443
					]
				},
				{
					"id": 738010443,
					"content": "そうなったら必死で抵抗して…結局、死ぬことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010444
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010444,
					"content": "結末としては大差ない。だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010445
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010445,
					"content": "報酬が多いといいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010446
					]
				},
				{
					"id": 738010446,
					"content": "心配するな。たっぷりはずむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010447
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010428,
					"content": "#もし今日、{M#俺}{F#私}が来なかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010429
					]
				},
				{
					"id": 738010429,
					"content": "一旦帰って、お前が来るまで計画を続けるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010430
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010430,
					"content": "ずっと前から準備してきたんだ。少しくらいの遅延はどうってことない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010431
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010413,
					"content": "#さっきの話、わざと{M#俺}{F#私}たちに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010414
					]
				},
				{
					"id": 738010408,
					"content": "#{M#俺}{F#私}たちをはめた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010409
					]
				},
				{
					"id": 738010409,
					"content": "安心しろ。俺たちはそこまで暇じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010410
					],
					"speakerTitle": "プレヴァ"
				}
			]
		},
		{
			"id": 7380105,
			"completionStepIds": [
				7380105
			],
