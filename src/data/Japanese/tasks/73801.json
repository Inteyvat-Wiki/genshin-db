			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010201,
					"content": "わっ、箱が開いたぞ！意外と簡単だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010202,
						738010203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010202,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				},
				{
					"id": 738010204,
					"content": "うううっ、とにかく…中身を確かめてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010205,
					"content": "中身は…古着がいっぱいだ。それに便箋もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010206,
					"content": "なにか書いてあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010207,
					"content": "「デーヴァーンタカ山の南、古き船が港を離れる」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010208,
					"content": "これ、どういうことだ？山の中に船なんてあるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010209,
						738010210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010209,
					"content": "暗号かな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010211,
					"content": "うーん…じゃあ、オイラたちも行ってみるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010210,
					"content": "ファデュイは何か企んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010203,
					"content": "この箱、まさかあの2人のファデュイと関係してるのか…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				}
			]
		},
		{
			"id": 7380103,
			"completionStepIds": [
				7380103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
