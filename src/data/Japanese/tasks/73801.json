			"dialogs": [
				{
					"id": 738010801,
					"content": "ごめん…ゲホゲホッ…プレヴァ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010802
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010802,
					"content": "しゃべるな。今手当てしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010803
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010803,
					"content": "ううっ…うっ…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010804
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010804,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010805
					]
				},
				{
					"id": 738010805,
					"content": "あの…キノコを摘みに…ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010806
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010806,
					"content": "アレクサンドラさんが最近…元気なかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010807
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010807,
					"content": "だからみんなで相談したんだ。おいしいものを作って、アレクサンドラさんを驚かせようって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010808
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010808,
					"content": "前にアレクサンドラさんに連れて来てもらった時、ここで沢山おいしいキノコをとったんだ。だから…1人で行ってみようと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010809
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010809,
					"content": "そしたら迷子になって、たくさんのキノコに囲まれちゃったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010810
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010810,
					"content": "アレクサンドラさんは…僕を助けようとして…ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010811
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010811,
					"content": "ゲホッ…だ…大丈夫だってば。ニカ…私は…大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010812
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010812,
					"content": "…旅人、計画は変更だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010813
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010813,
					"content": "アレクサンドラは重傷だ。もう他のファデュイは、俺たちが無断で町を出たことに気づいてるだろう。いま彼女を連れて戻っても、捕まって尋問にかけられるだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010814,
						738010815
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010814,
					"content": "#{M#君}{F#あなた}たちの計画は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				},
				{
					"id": 738010816,
					"content": "ふっ…この状況を逆手に取るしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010817
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010817,
					"content": "さっきここに来る途中、エルマイト旅団の一団がこっちに向かっているのを見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010818
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010818,
					"content": "旅人、このチビを連れて森を抜けろ…そしてエルマイト旅団に引き渡すんだ。俺はアレクサンドラを連れてここを離れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010819
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010820
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010820,
					"content": "さっき決めた通りに口裏を合わせてくれ。どうやら、嘘がまことになりそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010821
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010821,
					"content": "エルマイト旅団の連中は、俺たちがここで悪行を働くファデュイで、ニカを助けたのはカモフラージュか何かだと思うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010822
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010822,
					"content": "俺たちが魔物に襲われたとしても、自業自得の一言で終わりだ。それ以上は追求しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010823
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010823,
					"content": "ううっ…アレクサンドラさん…僕、もう絶対いたずらしないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010824
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010824,
					"content": "…このチビも今は混乱してる。俺たちの話なんざ覚えちゃいないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010825,
						738010826
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010825,
					"content": "#でも、{M#君}{F#あなた}たちは人助けのために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010827,
					"content": "俺を信じろ。「勇敢なファデュイの自己犠牲」は信じ難いが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010828
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010828,
					"content": "「邪悪なファデュイの自業自得」なら、すんなり受け入れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010829
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010829,
					"content": "最初に俺とアレクサンドラの話を盗み聞きしていた場所は覚えてるよな？もし…俺たちが無事に逃げられたら、あそこに手紙を置いておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010830
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010830,
					"content": "#{M#君}{F#あなた}たちは最初から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010831
					]
				},
				{
					"id": 738010831,
					"content": "チャンスは一度しかないから、用心深く進めないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010832
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010832,
					"content": "とにかく、アレクサンドラを助けないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010833
					]
				},
				{
					"id": 738010833,
					"content": "旅人、私は平気…ゲホッ…まだ頑張れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010834
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010834,
					"content": "…このチャンスを逃して、ファデュイに戻るくらいなら…いっそのこと…ゲホッ…ゲホゲホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010835
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010835,
					"content": "アレクサンドラさん、どこへ行くの？一緒に帰ろう！みんな捜してるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010836
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010836,
					"content": "ニカ…あのね、この旅人さんがあなたを連れてってくれるわ…ゲホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010837
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010837,
					"content": "私は…ここで少し休んでから戻る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010838
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010838,
					"content": "で…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010839
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010839,
					"content": "今まで私が嘘をついた？ゲホゲホッ…お願いだから、言うことを聞いて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010840
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010840,
					"content": "うっ…うえぇん…わ、分かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010841
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010841,
					"content": "じゃあ旅人、お願いね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010842,
						738010843
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010842,
					"content": "すぐ戻ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010844,
					"content": "じゃあ頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010843,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010826,
					"content": "#でも、{M#君}{F#あなた}たちに悪意はなかったのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010815,
					"content": "#{M#君}{F#あなた}たちはどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				}
			]
		},
