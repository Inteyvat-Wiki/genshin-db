			},
			"dialogs": [
				{
					"id": 738010501,
					"content": "ここだ。旅人、計画はシンプルだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010502
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010502,
					"content": "俺ら2人…あー、よからぬ企みを抱くファデュイが、森に来て悪事を働く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010503
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010503,
					"content": "君は…義憤にかられたとか、正義を執行しようとしたとか、そんな理由で俺たちの悪行を止めようとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010504
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010504,
					"content": "戦闘の途中で俺とアレクサンドラは逃げようとするが…その時、突然魔物が襲来して、俺たちはやられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010505
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010505,
					"content": "お前は魔物が多すぎて撤退するしかなく、人を連れて戻ってきた時には、俺とアレクサンドラの姿はもうなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010506
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010506,
					"content": "とまぁ、こういう段取りだ。どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010507,
						738010509
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010507,
					"content": "よく練られた計画だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010508
					]
				},
				{
					"id": 738010508,
					"content": "あんまり派手にしても逆効果だからな…より自然な死を演出するために、色々苦労したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010512,
					"content": "それにしてもアレクサンドラの奴、遅いな…魔物の餌を仕掛けるだけで、こんなに時間がかかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010513
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010513,
					"content": "アレクサンドラさん！アレクサンドラさん！ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010514
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738010514,
					"content": "あ、あっちで人の声がするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010515,
					"content": "まずい。アレクサンドラに何かあったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010516
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010516,
					"content": "おい、ちょっと！なにしに行くんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010517,
					"content": "急いで追いかけよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010518
					]
				},
				{
					"id": 738010518,
					"content": "一体なにがあったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010509,
					"content": "すごく…ファデュイらしい末路だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010510
					]
				},
				{
					"id": 738010510,
					"content": "ああ。外で情報を集めるファデュイの「スパイ」には、ままありがちな死にざまさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010511
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010511,
					"content": "もっとも、そんな消え方はしたくないから、この計画を立てたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "プレヴァ"
				}
			]
		},
		{
			"id": 7380108,
