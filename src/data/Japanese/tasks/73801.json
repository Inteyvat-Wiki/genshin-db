					"content": "ん？そこにいるのは誰だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010903
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738010903,
					"content": "ニカ…それに旅人じゃないか、なんでここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010904,
						738010905
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738010904,
					"content": "ちょっとニカを預かって！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010906
					]
				},
				{
					"id": 738010906,
					"content": "急いでるんだ！ニカを頼んだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738010907,
					"content": "はぁ？ちょっと待て、話が全然見えないんだが…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738010905,
					"content": "この先で人が襲われてる！",
