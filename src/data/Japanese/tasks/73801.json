			},
			"dialogs": [
				{
					"id": 738010101,
					"content": "…新しい商談はまとまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010102
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010102,
					"content": "安心して。古い貨物船の荷揚げは終わったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010103
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010103,
					"content": "船のことは漏れてないか？<color=#00E1FFFF>載っていた貨物は…</color>ちゃんと隠しただろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010104
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010104,
					"content": "ええ、厳重に隠した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010105
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010105,
					"content": "でも…交換した古い貨物はどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010106
					],
					"speakerTitle": "アレクサンドラ"
				},
				{
					"id": 738010106,
					"content": "今すぐ捨ててしまえ。新しいブツが手に入ったんだ…使い古しにもう用はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010107
					],
					"speakerTitle": "プレヴァ"
				},
				{
					"id": 738010107,
					"content": "ほ、ほんとに大丈夫なの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アレクサンドラ"
				}
			]
		},
		{
