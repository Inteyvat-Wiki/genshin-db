					"nextDialogs": [
						738011002,
						738011003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738011002,
					"content": "アレクサンドラ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011004
					]
				},
				{
					"id": 738011004,
					"content": "どこにいるんだー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738011005,
					"content": "やめろ、あんまり叫ぶと魔物が寄って来るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011006
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011006,
					"content": "ニカから事情は聞いた。アレクサンドラとプレヴァは、ファデュイだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011007
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011007,
					"content": "普段接してる時は、いい奴らだと思ってたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011008
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011008,
					"content": "アレクサンドラさんはいい人だよ！プレヴァさんは怖いけど…でもいい人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011009
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738011009,
					"content": "おい、あいつらはファデュイだぞ。善人のふりをしてるが、裏じゃ何を考えてるか分からない連中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011010
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011010,
					"content": "ファデュイの「功績」は、俺も色々聞いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011011
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011011,
					"content": "奴ら、この場所で何か企んでるのかもしれないぞ？ニカを助けたのだって、体の良いカモフラージュに過ぎないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011012,
						738011013
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011012,
					"content": "彼らは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738011014
					]
				},
				{
					"id": 738011014,
					"content": "どうしてそう言い切れる？…それにしても、あいつらが見当たらないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011015
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011015,
					"content": "怪我人を連れてたんだろう？…俺の経験からすると、魔物にやられたってことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011016
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011016,
					"content": "ベラトさん、お願い！もっと捜して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011017
					],
					"speakerTitle": "ニカ"
				},
				{
					"id": 738011017,
					"content": "悪いなニカ、大勢で来たんなら森中を捜索することもできたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011018
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011018,
					"content": "今は俺1人しかいないんだ。魔物はともかく、ファデュイまでいるとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011019
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011019,
					"content": "コホン…とにかく旅人、ひとまず町に戻ろう。団長に報告して判断を仰いでから、次の行動に移りたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011020
					],
					"speakerTitle": "ベラト"
				},
				{
					"id": 738011020,
					"content": "ベラトはニカを連れて立ち去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738011021
					]
				},
				{
					"id": 738011021,
					"content": "プレヴァが予想した通りの反応だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011022
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738011022,
					"content": "でもあいつら…ほんとに逃げられたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738011023,
					"content": "しょうがない。オイラたちも戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738011024
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 738011024,
					"content": "脱走に成功したら、自分たちが元いた場所に手紙を置いておくってプレヴァが言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
