			"trigger": {
				"objectNames": [
					"ヴィクトリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "ちゃんと反省しているのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230102,
					"content": "何を反省するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "毎日たくさんの人がここに来て、犯した罪を告白し、神様の許しを求むの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230104,
					"content": "でも口先だけ反省しても行動に移さないと、時間の無駄じゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230105,
					"content": "たとえばニムロドさん、お酒を飲みすぎたことで何回も懺悔しにきたけど、何の改善もされていないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230106,
					"content": "時間があったら、彼の近況を確認してきてくれないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "そうだ、もし彼がまたお酒を飲んでいたら、証拠を持ってきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230109,
					"content": "何度注意しても改めない人には…やはり「教訓」が必要だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230110,
					"content": "酒を飲むことは「罪」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "お酒を飲むことは「罪」じゃないけど、お酒を飲むことによって他人を困らせたら、それは「罪」となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230112,
					"content": "もしみんなが自分勝手な行動するようになったら、このモンドはいつか大きい苦悩に包まれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230113,
					"content": "だから「罪」の芽は摘まないと。さあ、早くニムロドさんの状況を確認してきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトリア"
				}
			]
		},
		{
