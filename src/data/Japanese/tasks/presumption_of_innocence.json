					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230902,
					"content": "ニムロドは頑張って禁酒してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "頑張って禁酒…そうなのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230904,
					"content": "でも証拠はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "大丈夫よ。お酒を飲んだ証拠がない限り、彼は反省してるということにしておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230906,
					"content": "証拠がない限り、みんなは無実だと信じているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230907,
					"content": "しかし…いつも様々な証拠が彼らの「罪」を証明する…笑えるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230908,
					"content": "これはお礼よ、受け取りなさい。あなたたちが「懺悔」しに来る日が訪れないことを祈ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトリア"
				}
			]
