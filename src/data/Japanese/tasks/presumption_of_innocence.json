					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "フン、やはりね…想定済みよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230404,
					"content": "過去に何があっても、本当の苦しみを知らない人は、何も学ばないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230405,
					"content": "はい、これはお礼よ、受け取りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200230406,
					"content": "ニムロドさんの「返礼」についてもきちんと考えておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトリア"
				}
			]
