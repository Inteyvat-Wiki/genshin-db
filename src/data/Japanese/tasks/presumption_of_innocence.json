			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "ハハハッ、毎日の楽しみは酒だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200230202,
					"content": "禁酒するって言ってなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "あっ！？ビックリした…女房かと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200230204,
					"content": "ちょっとだけ飲んでもいいじゃないか。俺は一日中働いたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 200230205,
					"content": "もう一杯飲んだら帰るから…ユーリの買い物もそろそろ終わるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニムロド"
				}
			]
		},
		{
