					"nextDialogs": [
						200230302
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 200230302,
					"content": "ニムロドについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "彼、今日は何時間も飲んでたよ。ほら、これが彼の伝票だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 200230304,
					"content": "このままだと、ユーリさんを呼んでくるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 200230305,
					"content": "借りる？できないわけではないが、なにに使うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャールズ"
				}
			]
		},
