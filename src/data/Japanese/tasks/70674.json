				"points": []
			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "今度はモンドに現れるなんて、どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740102,
					"content": "宏朗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "旅人！ここで会えるなんて、なんとも奇遇だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740105,
					"content": "今の状況については…隣にあるこの扉を見れば、だいたい理解できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740106,
					"content": "前回みたいな秘境がまた現れた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "そう。前回の秘境は旅人が探索を手伝ってくれたおかげで、多くの貴重な資料を手に入れることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740109,
					"content": "ただ…協会も各所を調べてくれてはいるが、外部からはこれ以上有益な情報を得られないようでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740110,
					"content": "探索の人員を増やそうと他の協会にも協力を要請したけど、その矢先に秘境が消えてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740111,
					"content": "そして今日、こうしてモンドに突如現れたというわけさ…モンドの冒険者協会の仲間が知らせてくれてね、俺はすぐに駆けつけたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740112,
					"content": "もう探索は始まってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "もちろん。秘境が目の前にあるというのに、退く理由なんてどこにもないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740114,
					"content": "この秘境の「原理」は、そう変わっていない。以前と同じで、中に入った人の思いによってデザインされた何かが現れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740115,
					"content": "ただ、探索中に発見したんだが…この秘境はなんと、「敵」を生み出すことができるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740116,
					"content": "それらの「敵」はこちらを攻撃でき、攻撃された側もリアルな痛みを感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740117,
					"content": "なんというか…現実の「戦闘」とほぼ変わらなくてね。冒険者たちも、このことに強い興味を抱いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740118,
					"content": "けど冒険者の中には、自分の思いによってデザインされた「敵」に勝てない人もいるようだ。そういった人は、他の人に助けてもらっているよ、まったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740119,
					"content": "コホン！説明はここまでにして…旅人、もしよかったら、また俺らと一緒にこの秘境を探索してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740120,
					"content": "うん、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "ハハハ、本当に良かった！お前の協力があれば、俺らの仕事も大いにはかどるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740122,
					"content": "危険な目に遭ったりしないかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "えっと…警戒さえ怠らなければ、お前の腕なら問題ないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740124,
					"content": "とにかく、ぜひこの秘境の探索を手伝ってほしい。お前の協力があれば、俺らの仕事も大いにはかどるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏朗"
				},
				{
					"id": 706740107,
					"content": "#{M#君}{F#あなた}が研究してるあのタイプの秘境？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "これって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}