			},
			"dialogs": [
				{
					"id": 715130101,
					"content": "#こんにちは、{NICKNAME}にパイモン！海灯祭を祝して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130102
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130102,
					"content": "おう！おまえも海灯祭を楽しんでるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130103,
					"content": "海灯祭を祝して！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130104
					]
				},
				{
					"id": 715130104,
					"content": "って、待った。オイラたちを知ってるのか？おまえは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130105,
					"content": "うちは絵星、「南十字」船隊の航海士だよ。今回の海灯祭では、船隊に関するいくつかのイベントを準備してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130106
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130106,
					"content": "北斗の姉御からあなたたちのことは聞いたよ。すごく勇気のある豪傑だって、尊敬しちゃうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130107
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130107,
					"content": "「死兆星」号に関する質問があったら、ぜひうちに聞いてね。うちの知ってることなら、できる限り詳しく教えるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130108
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130108,
					"content": "おお、やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130109,
					"content": "オイラたち、「死兆星」号についてもっと詳しく知りたいんだ。もし聞きたいことが見つかったら、おまえに聞きに来るぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130110,
					"content": "そういえば、今の「死兆星」号は海鮮料理がたくさんあって、それに装飾品で溢れてるよな。街中と同じくらい盛り上がってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7151302,
			"completionStepIds": [],
