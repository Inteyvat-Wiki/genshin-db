					"絵星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130201,
					"content": "#久しぶり、{NICKNAME}にパイモン！海灯祭を祝して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130202
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130202,
					"content": "おう！絵星も海灯祭を楽しんでるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130203,
					"content": "海灯祭を祝して！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130204
					]
				},
				{
					"id": 715130204,
					"content": "オイラたち、「死兆星」号に海鮮料理がたくさんあって、装飾品で溢れてるのを見たぞ！街中と同じくらい盛り上がってるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7151303,
			"completionStepIds": [
				7151301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151301",
							"2"
						],
						"stepId": 7151301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"絵星"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715130301,
					"content": "悪くないでしょ！装飾はすべて姉御が選んだの。働いてるみんなにも、祭りを過ごしている感覚を味わってほしいんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130302
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130302,
					"content": "それだけじゃないよ。今回は海灯祭の前に、姉御が船のみんなへボーナスを出してくれたの。その上、盛大な宴を何回も開いてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130303
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130303,
					"content": "宴の料理はどれも評判のお店から取り寄せたものでね。うちらがよく行く万民堂の他に、新月軒や琉璃亭みたいな大きなところもあったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130304
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130304,
					"content": "みんなたーっくさん食べて、とても満足したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130305
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130305,
					"content": "オイラも見てみたかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130306,
					"content": "おお～、祭りのボーナスに、盛大な宴まで？いいなぁ…まさか北斗に、そんな気遣いのできる一面があったなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130307,
					"content": "姉御はね、船隊の事務を完璧にこなしてるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130308
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130308,
					"content": "うちら船員に手厚い賃金をくれるだけじゃなく、前回の祭りではうちらの家族にまで贈り物を届けてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130309
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130309,
					"content": "あとこの前、姉御が天権様から商業情報を入手して、「南十字」船隊の経営戦略を改善したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130310
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130310,
					"content": "そのおかげで船隊の収入が大幅に増えて、うちらへの報酬も上がってね。これで船員たちもベストな状態で色んなことに挑戦できるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130311
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130311,
					"content": "これから入ってくる新人が「南十字」船隊の仕事環境がこれほど良いものだって知ったら、それだけでやる気が出るだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130312,
						715130313
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130312,
					"content": "挑戦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				},
				{
					"id": 715130314,
					"content": "えっ？海灯祭期間中は、みんな休みじゃないのか？まさか、おまえたち…休日勤務しないといけないとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130315,
					"content": "安心して、それはないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130316
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130316,
					"content": "姉御が事前に全員の意向を聞いてくれたの。それで、一部の船員は早めに休暇を取って、残りは数日遅れて休暇を取るよう手配したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130317
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130317,
					"content": "そのおかげで、みんな十分な休暇が手に入ったし、「死兆星」号をここに寂しく放置することもなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130318
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130318,
					"content": "それでね、うちの休みは前者のほうだったの。元気いっぱいな状態で仕事に戻って、今はうちの訓練試験「煙海巡廻」の計画を練ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130319
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130319,
					"content": "えんかい…なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130320,
						715130321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130320,
					"content": "新しい挑戦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130322,
					"content": "うん、そうなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130323
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130323,
					"content": "ここ二年、璃月港の海上貿易の量は目まぐるしいほど増えていてね。だから、船員もたくさん加入したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130324
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130324,
					"content": "航海には、忍耐力と勇気と洞察力において高い技術が要求される。安全に船を操るには、十分な訓練が必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130325
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130325,
					"content": "そのためには、総務司が定めた「四大証」と「五小証」の計九種ある航海関連資格証の取得、そして二年にわたる海上訓練と実習をしないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130326
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130326,
					"content": "九種の資格？それに二年の訓練？それって難易度が高すぎないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130327,
					"content": "厳しい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130328
					]
				},
				{
					"id": 715130328,
					"content": "まあでも、海に出て対処しきれない問題に遭遇するより、緻密な準備をしたほうがいいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130329
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130329,
					"content": "一般的な航海に必要な訓練科目は、総務司がほとんど手配してくれるの。それに、難易度もそれほど高くないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130330
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130330,
					"content": "もちろん、商船によっては危険な海域を通らないといけないこともある。だから、船員たちにもっといろいろな訓練をしてほしいって意見もあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130331
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130331,
					"content": "そこで、厳しい海況への対応をたくさんしてきた「南十字」船隊が、総務司と協同で強化版の航海訓練を実施することになったってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130332
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130332,
					"content": "これらの訓練を通過できた船員は、「危険海域通行資格」の認証と、総務司が用意した報酬を獲得できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130333
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130333,
					"content": "うちは周辺海域の状況をもっともよく知ってるから、姉御からこの訓練試験の企画を任されてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130334
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130334,
					"content": "あっ、そういえば…あなたたち二人ってウェーブボートの操縦が得意なんだよね？試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130335
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130335,
					"content": "それでもし良ければ、訓練内容の良いところと悪いところを見てくれないかな。それをうちに言ってくれたら、すぐに改善するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130336
					],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130336,
					"content": "うーん、たしかにオイラも、とてつもなく危険な海域を航行するのに、どれだけ高い技術が必要なのか見てみたいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130337,
					"content": "それに報酬もあるなら、やらない手はないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715130338,
						715130339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715130338,
					"content": "どんなものか見せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130340,
					"content": "うん、その意気だよ！それじゃ、「煙海巡廻」のルートを記してあげるから、がんばってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絵星"
				},
				{
					"id": 715130339,
					"content": "船員ならではの試練！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130340
					]
				},
				{
					"id": 715130321,
					"content": "新人と関係があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130322
					]
				},
				{
					"id": 715130313,
					"content": "新人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715130314
					]
				}
			]
		}
	]
}