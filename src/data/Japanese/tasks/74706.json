			"dialogs": [
				{
					"id": 747060101,
					"content": "…これは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060102,
					"content": "まだちょっと足りないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060103,
					"content": "コロンビーナ…それにフリーナ？おまえら、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747060104,
					"content": "フリーナ監督と一緒に…「キャスティング」中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060105,
					"content": "間違いではないね。ただ、僕たちが選ぼうとしてる役者は、水槽の中の魚だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060106,
					"content": "魚も演技できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747060107,
					"content": "今どき、動物の役者だって珍しくないだろう？イメージに合う魚を一匹選んで、雰囲気を引き立てるためのカットをいくつか撮ろうと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060108,
					"content": "はぁ、一通り見てみたけど…なかなかいいのが見つからないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060109,
					"content": "旅人とパイモンに頼んでみる？なんでも解決してくれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060110,
					"content": "オイラたちのことを信じてくれるのは嬉しいけど…これに関しては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747060111,
					"content": "もっと魚を見つけてこようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "そうか！このアクアリウムはキミたちが経営しているんだったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060114,
					"content": "てことは、これから水に入るときに、ちょっと気にかけておけばいいってことか？それなら確かに難しくなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747060115,
					"content": "じゃあ、決まりだ！後で雰囲気に合う魚のイメージを伝えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747060116,
					"content": "じゃあ、キミたちは「スカウト」だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747060117,
					"content": "おまえ、フリーナからいろんな言葉を教わったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747060112,
					"content": "潜ってこようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
}