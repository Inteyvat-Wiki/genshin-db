						4671207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4671207,
					"content": "うーん！思ったより美味しい！君やっぱりセンスあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671208
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4671208,
					"content": "へへへっ、そうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4671209,
					"content": "君の腕なら、もっと難しい料理に挑戦してみてもいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4671210,
					"content": "私の荷物に生の食材がまだ少しあるから、君にあげるわ。料理のお礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4671211,
					"content": "え？いいのか？おまえが食べるもの無くなっちゃうぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4671212,
					"content": "大丈夫よ、<color=#00E1FFFF>野外探検</color>で食材はたくさん手に入るから。君たちも周りをよく観察することね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4671213,
