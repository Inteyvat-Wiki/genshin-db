			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "次は何作ろうかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670102,
					"content": "ん？君たちも冒険者なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670103,
					"content": "通りすがりの旅人だよ。料理の準備か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4670104,
					"content": "旅人さんね、いらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670105,
					"content": "私はリン、冒険者協会所属、サバイバルのプロよ。見ての通り、料理を研究してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670106,
					"content": "「腹が減っては冒険が出来ぬ」というのが「サバイバルの心得」の第一項目だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670107,
					"content": "ピクニック！オイラも大好きなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4670108,
					"content": "オイラの仲間も料理が得意だぞ。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4670801,
					"content": "簡単なものしかできない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "そうなの？鍋の準備はできてるから、腕前を見せてみて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670803,
					"content": "サバイバルのプロ直々の指南を受けられるチャンスはめったにないわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4671001,
					"content": "キノコと肉が桶に入ってるから、それで<color=#00E1FFFF>「鳥肉と野生キノコの串焼き」</color>を作って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リン"
				},
				{
					"id": 4670901,
					"content": "そう、料理は好きだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "おお！鍋の準備はできてるから、腕前を見せて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "リン"
				},
				{
					"id": 4670903,
					"content": "こうやって切磋琢磨しながら料理できる機会は珍しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "リン"
				}
			]
		},
