						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "あ…ヤフォダさん？どうしてここに？あの…ネフェルさんは今空いてないのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260202,
					"content": "（ネフェル姐さんがよかったってか…ふん、これくらいのことならあたい一人で十分だ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260203,
					"content": "いや、あたいはボスに言われて手伝いに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260204,
					"content": "え？い、今なんて…？まさかネフェルさんは既に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260205,
					"content": "あんたはずっと「霜月の子」へ行きたいと思ってた、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260206,
					"content": "だから、リーリキと仲良くなって、「霜月の子」を案内してもらいたいとおもってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260207,
					"content": "えっ！？ネフェルさん、知ってたのか？絶対誰にも言わず、心に留めてきたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260208,
					"content": "（今こそ、あの決めセリフを！うーん、ネフェル姐さんはなんて言ってたっけ…えっと…あっ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260209,
					"content": "ゾンパイコさん。秘密を守りたいんなら、「秘密を守っている」ことを隠す方法も学ばないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260210,
					"content": "じゃないと、いくら心の中に「壁」を築いても、簡単に穴が開いてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260211,
					"content": "はぁ…故郷にいた頃は、何も隠し事なんてなかったのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260212,
					"content": "（…決まった！練習の甲斐があったな、へへへへへ——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260213,
					"content": "まあいい。そこまでわかってるんなら、頼まれてくれないか？俺は外国人だし、いきなりリーリキさんのとこに行くのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260214,
					"content": "大丈夫だよ。リーリキはとても親切だし、訪問者が外国人だろうと人外だろうと、優しく迎え入れてくれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260215,
					"content": "えっ？そうなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260216,
					"content": "いや…でも、やっぱりいきなりお邪魔するのは気が引けるな。あの、もし彼女と知り合いなんだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260217,
					"content": "もちろん知り合いだよ。ちょうど今、食事も配り終えた頃だろうし…行こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260218,
					"content": "あっ…ボスが、今回はタダでいいって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260219,
					"content": "ありがとう、ヤフォダさん…！すぐに支度してくるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゾンパイコ"
				}
			]
		}
	]
}