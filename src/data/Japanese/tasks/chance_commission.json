				]
			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "ヤフォダさん？それから…ゾンパイコさん。何か用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260102,
					"content": "俺…えーと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260103,
					"content": "「霜月の子」に行ってみたいらしいんだけど、緊張するから、あんたに手伝ってもらいたいんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260104,
					"content": "そ、そう！そうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260105,
					"content": "こんにちは、リーリキさん！お会いできてうれしいよ。あ…これはナタから持ってきた…化石の標本だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260106,
					"content": "ありがとうございます。でも…ゾンパイコさん、初めましてでもありませんのに。そんなにかしこまらないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260107,
					"content": "えっ？どうして俺のことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260108,
					"content": "前に食事を配っていた時、近くで見ていたでしょう？行ったり来たりしていましたけど、列には並びませんでしたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260109,
					"content": "並ぶのが恥ずかしかったのかと思って…それで、こっそりあなたの分を残していたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260110,
					"content": "でも…一度も食事を取りにきたことはありませんでしたね。もし今日来なかったら、私から、何か助けが必要か聞こうと思っていましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260111,
					"content": "そ…それは…すまなかった！どう声をかければいいか迷ってたものだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260112,
					"content": "…それじゃあ、リーリキさん。さっそくだけど「霜月の子」を訪ねてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260113,
					"content": "ええ、どうぞ。「霜月の子」にはもともと外部から来たお客さんもいますから。でも、何をするおつもりなんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260114,
					"content": "写真を撮って、資料を調べて、あと、できれば…伝説について誰かに聞いてみたいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260115,
					"content": "俺はナタの「龍の遺物研究会」の会員なんだ。研究に関係する資料が見つけられたらいいなと思ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260116,
					"content": "ああ…では、本を見たいということですね？それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761260117,
					"content": "楽しそうに話してるみたいだし、今回の依頼はこれで終わりにするよ。あたいもボスに報告しないとだしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761260118,
					"content": "ありがとう、ヤフォダさん！あの…料金はちゃんと支払うからさ。さすがにタダってわけにはいかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260119,
					"content": "ネフェルさんにもよろしく伝えといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761260120,
					"content": "もちろん、じゃああたいはこれで。二人でごゆっくり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
