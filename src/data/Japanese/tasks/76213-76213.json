			"dialogs": [
				{
					"id": 762130101,
					"content": "あれ？こっちの部屋、本で塞がれてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762130102,
					"content": "書を探しておるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130103,
					"content": "うーん…本を探してるってわけじゃないんだけどな。ただ、この中になにがあるのか、ちょっと気になって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762130104,
					"content": "横から回り込めそうだよ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "それでは、中には入れん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130106,
					"content": "書を移さん、書を移さん。さもなくば、則ち至らざるなり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130107,
					"content": "どういうこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "書を移さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130109,
					"content": "「書を移さん」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "書の在らぬをもって、すなわち書を移すなり。老僧はただ見るのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130111,
					"content": "それじゃ、みっちゃんの力を借りてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "まっすぐ進むのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				}
			]
		},
