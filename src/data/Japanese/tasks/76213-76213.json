			},
			"dialogs": [
				{
					"id": 762130201,
					"content": "夢幻の花を、わざわざ掴もうとする必要はない。千年かけて理を究明しようとも、一心が生じなければ、何も悟れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130202,
					"content": "#それで…{F#君}{M#あなた}は本を探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "ここに来たのは初めてか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130204,
					"content": "え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "なら、既に分かっておろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130208,
					"content": "わ…分かるって、何を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "眠りたければ即ち眠り、分かりたければ即ち分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130211,
					"content": "今は帰るがよい。世界が終わる時、それに従い帰るがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130209,
					"content": "どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "来たことあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "初めてだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "さっぱり分からない、さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "まっすぐ進むのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				}
			]
		}
