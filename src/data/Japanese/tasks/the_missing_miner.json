			"dialogs": [
				{
					"id": 710570133,
					"content": "後ろから急に声が聞こえた。\\n「へへへ…キノコ肉…へへへ…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "お前たち、へへへ、何でこんなところにいるんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570102,
					"content": "うわっ！こいつ顔色が変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570103,
					"content": "#それに{NICKNAME}、こいつ、音もなく後ろから近づいてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570104,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570105,
					"content": "違うと思うけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "へへへ…お前たち…何でここにいるんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570107,
					"content": "お前たちも、食糧を全部食べてしまったのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570108,
					"content": "#もしかして、{M#君}{F#あなた}は何爺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "あ…なんだ？若者よ、お前たちの言ってることが、よく聞こえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570110,
					"content": "オイラたちが聞いてるのは！おまえは何爺なのかってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570111,
					"content": "おお、そうだ、へへへ、俺は何爺だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570112,
					"content": "もしかして…お前たちも俺と同じようにここに閉じ込められて、食糧を全部食べてしまったんじゃないか…ああ、お前もついてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570113,
					"content": "へへへ、でも大丈夫、ここに食べ物があるぞ…腹が減っただろう…へへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570114,
					"content": "そういえば、確かにお腹が空いたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570115,
					"content": "キノコ肉をみだりに食べてはいけない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "そ、そうだな。こいつ、様子も顔色も…変だし、もしかして怪しいキノコ肉を食べたんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570118,
					"content": "キノコ肉？へへへ、キノコ肉はうまいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570119,
					"content": "ほら、何爺のキノコ肉をお前たちに分けてやろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570120,
					"content": "へへへ、キノコ肉…え、そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570121,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570122,
					"content": "キノコ肉がなくなった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570123,
					"content": "キノコ肉なんかどうでもいいだろ、一緒に拠点に戻ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570124,
					"content": "だめだ、キノコ肉がなくなった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570125,
					"content": "キノコ肉がないと、歩く力が出ない。俺はどこにも行かない…キノコ肉がなかったら…ここで食べられる物は何もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570126,
					"content": "キノコ肉があれば、どこにでも行ける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570127,
					"content": "そ、それじゃ、そのキノコ肉はどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570128,
					"content": "キノコ肉…へへへ…キノコ肉がどこにあるのか、俺は知ってるぞ。キノコ肉を採りに行こう。そうすれば力も出てくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570129,
					"content": "この近くにある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570130,
					"content": "#しょうがないな、{NICKNAME}、キノコ肉を探してやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570131,
					"content": "そうするしかなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "キノコ肉…へへへ…大きなキノコ肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570116,
					"content": "危ないものを食べちゃだめ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
