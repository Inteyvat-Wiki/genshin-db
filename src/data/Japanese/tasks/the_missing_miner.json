			"dialogs": [
				{
					"id": 710570201,
					"content": "一撃で終わらせたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570202,
					"content": "何爺…強いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570203,
					"content": "へへへ…キノコ肉、キノコ肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570204,
					"content": "キノコ肉を食べた後は、腰も痛くなくなって、手に力も入った。へへへ、何歳も若返った気分だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570205,
					"content": "キノコ肉の魔物はキノコ肉よりうまい。大きければ大きいほどうまくなる…へへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570206,
					"content": "もしかして、何爺はキノコ肉を食べたから、こんなにすごくなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}、食べれば強くなれるみたいだぞ、オイラたちも食べようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570208,
					"content": "#{M#君}{F#あなた}はキノコ肉が食べたいだけでしょ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "どんな味がするのか気になるだけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570212,
					"content": "でもこれで、何爺もオイラたちと一緒に戻ってくれるはずだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570213,
					"content": "キノコ肉…へへへ、うまい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570214,
					"content": "何爺！オイラたちと一緒に拠点に戻ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570215,
					"content": "あ？一緒に？いいよ、お前たちも一緒に食べよう。さあ、このキノコ肉を、へへへ、乾燥させたら長持ちするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570216,
					"content": "一緒に拠点に戻ろうって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570217,
					"content": "キョテンに戻る？キョテンってどこだ。でもいいよ…へへへ…キノコ肉を食べたから、俺はどこにでも行ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570218,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}、早く何爺を瑾武姉さんのところに連れ戻そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570210,
					"content": "食べちゃだめ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "わ、分かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "パイモン"
				}
			]
		},
