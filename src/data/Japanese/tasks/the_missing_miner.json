			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"何爺",
					"瑾武",
					"パイモン",
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570601,
					"content": "キノコ肉…へへ…たくさん食べた、キノコ肉を、小さいキノコ、キノコの魔物、大きいキノコ…へへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570602
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570602,
					"content": "何爺？あんた、顔色が変だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570603
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570603,
					"content": "はぁ…あんたやっぱり生きていたんだね！あんたの家族にお斎に呼ばれたけどね。あの時あたしは言ったんだよ、遺体も見ていないのに、お斎なんかに行くかって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570604
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570604,
					"content": "あんた、顔色が悪いね。鉱区ではきっと大変だったろう。でも、生きていてくれて何よりだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570605
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570605,
					"content": "生きているのはいい！生きているキノコはうまい…へへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570606
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570606,
					"content": "何爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570607
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570607,
					"content": "見つけた時はもうこんな風になってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570608,
					"content": "狂ってるみたいで…キノコが食べたいってずっと騒いでたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570609,
					"content": "キノコ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570610
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570610,
					"content": "層岩巨淵の下の環境は、普通の人間にとっては非常に危険なんだ。生えているキノコや植物も人に害を及ぼすかもしれない。だから、輝山庁は鉱夫たちがそういったものを食べることを厳禁していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570611
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570611,
					"content": "だけどここ数年何爺はずっと鉱区の中にいたから、そうするのも仕方なかったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570612
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570612,
					"content": "何爺がこんな風になってしまって、彼の家族にはどう説明すればいいのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570613,
						710570614
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570613,
					"content": "キノコなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				},
				{
					"id": 710570615,
					"content": "そういえば、ヘディーヴなら何か方法があるかもしれないね。彼はスメールの学者だから、キノコに詳しいはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570616
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570616,
					"content": "あんたたち、ここでしばらく待っててくれるかい。あたしはヘディーヴを呼んでくる。彼に何爺の様子を見てもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570617
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570617,
					"content": "キノコ肉…キノコ肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570618
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570618,
					"content": "はぁ、何爺は元に戻れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570619,
					"content": "このままだったら、帰ったとしても、家族は喜べないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710570620,
					"content": "レポートを書いている途中なのに、こんなところまで引っ張ってきて。瑾武、君が探検隊の安全責任者だからと言って、俺の研究の進捗を遅らせるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570621
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570621,
					"content": "君たちへの報酬の一部を減らす案について、真剣に検討するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570622
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570622,
					"content": "報酬のことなんかどうでもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570623
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570623,
					"content": "それより、この人の様子を見てくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570624
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570624,
					"content": "耳が痒いよ…へへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570625
					],
					"speakerTitle": "何爺"
				},
				{
					"id": 710570625,
					"content": "え？この人は誰だい！どうしてこんなに変わった顔色をしているんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570626
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570626,
					"content": "#{NICKNAME}、君が連れ帰ってきた人なのか？君はいつも不思議な出来事に遭遇するらしいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570627
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570627,
					"content": "それで…彼を見つけた時はどんな状況だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570628
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570628,
					"content": "ヘディーヴに何爺のことを説明した…\\nヘディーヴは何爺を注意深く調べた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570629
					]
				},
				{
					"id": 710570629,
					"content": "大丈夫だ、大したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570630
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570630,
					"content": "ほら、彼はずっと耳が痒いって言っているだろう。それはこのキノコの胞子が聴道に入ったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570631
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570631,
					"content": "この真菌…えっと、つまりこのキノコは、長期間食べると確かに気を狂わせるんだが、体への影響はさほど大きくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570632
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570632,
					"content": "それはつまり、何爺は元に戻れるってことなのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570633
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570633,
					"content": "俺は彼の体にある真菌を取り除いた。それに、混乱した精神を落ち着ける薬も作った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570634
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570634,
					"content": "ゆっくり休みさえすれば、元に戻る可能性は大きい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570635
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570635,
					"content": "それじゃ、薬の代金は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570636
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570636,
					"content": "薬の原材料は安いものだ。この程度のモラじゃ、新月軒で一ヶ月続けて食べることくらいしかできない。そんなに高くはないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570637
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570637,
					"content": "えっと…何とかしてモラを集めるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570638
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570638,
					"content": "そのくらいのモラはいいんだよ。それより、この事例を俺のレポートに加えられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570639
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570639,
					"content": "層岩巨淵でこの特殊なキノコを見つけた時、このキノコを長期的に食べたらどうなるか研究してみたかったんだ…だが、実験を手伝ってくれる助っ人が見つからなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570640,
						710570642
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570640,
					"content": "助っ人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570641
					]
				},
				{
					"id": 710570641,
					"content": "つまり、キノコを食べる人だ。みんなこのキノコを避けていてね。大きな害はないと知っていても、試したいと思う人はいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570644,
					"content": "でも…層岩巨淵の環境は特殊だからね。環境による影響もあるかもしれない。とにかく、この薬を飲んでゆっくり休めば、元に戻れる可能性は大きい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570645
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570645,
					"content": "ならよかったよ…後で何爺を地上まで送ってあげるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570646
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570646,
					"content": "彼が回復したら家に連れて帰る。それに、彼の仲間たちにも伝えておかないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570647
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570647,
					"content": "何爺は大先輩なんだよ。身のこなしも素早くて、新入りの若者たちの面倒もよく見てくれてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570648
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570648,
					"content": "彼が失踪した時…みんな、岩王帝君は何故助けてくれなかったんだと思ったよ。どうしてあんな人が報われないんだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570649
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570649,
					"content": "彼が帰ったと知れば、みんなも喜ぶだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570642,
					"content": "実験対象だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570643
					]
				},
				{
					"id": 710570643,
					"content": "そう言ってもいいだろう。でもこのキノコは以前から分析されていて、体や精神に不可逆的なダメージを与えることはないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710570614,
					"content": "キノコの研究をしている人はいないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				}
			]
		},
