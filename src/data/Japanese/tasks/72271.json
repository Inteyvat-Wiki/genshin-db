			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "お宝を売りたいんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "また何か貴重なものを見つけたの？見せてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710104,
					"content": "龍骨花の露玉のことを琳琅に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "あなたの言う通りなら、これはとんでもなく古い物になるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710106,
					"content": "ただ…少し見てみたけど、特別なところは何もなかったわ。長期的に使ってみないと判断が難しいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710107,
					"content": "私の感覚では、少し誇張されているように感じるわね。それに…失敗した者の言い訳に過ぎない可能性もありえる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710108,
					"content": "あっ、気にしないで。深く考えずに言っただけだから、聞き流してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710122,
					"content": "骨董品の業界において、こういうのは至って普通のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710109,
					"content": "それよりも、密封状態で保存してなかったみたいね。表面に少し傷がついてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710110,
					"content": "これだと、値段も少し落ちるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710123,
					"content": "八万モラならどう？それに加えて、オリジナル料理の実り豊かを五つおまけするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710111,
					"content": "結構いい値段だと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710112,
					"content": "これをどんなことに使うか教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "私はこれの効果よりも、その背景にある物語のほうに価値を感じているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710114,
					"content": "港にいる講談師や歌劇家、それから玉京台にいる貴人たちに、興味を持ってもらえると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710115,
					"content": "それか、店の受け付けに貴重な骨董品の一つとして展示できるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710116,
					"content": "適正な価格だと思う、交渉成立。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "決断が早いわね、モラを受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710118,
					"content": "もし今後もこのようなお宝があったら、いつでも歓迎するわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710119,
					"content": "少し考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "ええ、貴重なお宝だから、慎重に考えるのも当然のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710121,
					"content": "考えがまとまったら、また声をかけてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
