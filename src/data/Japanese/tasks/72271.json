					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "どう？決まったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710203,
					"content": "うちでは八万モラとオリジナル料理の実り豊か五つで買い取るわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710204,
					"content": "売るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "毎度あり、モラを受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710206,
					"content": "もし今後もこのようなお宝があったら、いつでも歓迎するわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
