						722111126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111126,
					"content": "私は詳しい組み合わせを考えるから、海草を3つ準備してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111127,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "じゃあお願い。海草を3つ、見つかったら私に渡して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111129,
					"content": "どうやって作るかもう分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "少し考えがあるわ。でもまだ全部は分かってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722111131,
					"content": "まずは海草を3つよろしくね。頼んだわ。",
					"roleType": "TALK_ROLE_NPC",
