			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "こんにちは、「木南料亭」へようこそ。何かご注文は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110203,
					"content": "寝子のご飯について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "「寝子」？その名前、もしかして猫なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110205,
					"content": "寝子を知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722110206,
					"content": "いいえ、違うわ。ただ、その名前は猫の名前って感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110207,
					"content": "凄い直感だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "そんなことよりも、事の経緯は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722110209,
					"content": "セイライ島に…浅瀬神社があって、その神社に喋る猫が！？それで、その猫があなたたちに料理をお願いした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110210,
					"content": "え？えっ！ホント？そんなの聞いたことない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110211,
					"content": "ほ、本当…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "セイライ島でしょ？機会があったら必ず見に行くわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110214,
					"content": "その…寝子のご飯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "あっ…そうだね。肝心なことを忘れてた…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110216,
					"content": "うぅ…猫ってご飯を気に入るかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110217,
					"content": "難しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722110218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110219,
					"content": "む、難しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "これは「木南」家に対する挑戦だね！きっと乗り越えてみせるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110221,
					"content": "魚肉、獣肉、海草、米を使って猫でさえ魅了する美食を作る。私に任せて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110222,
					"content": "オ、オイラも食べたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722110223,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も食べたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "いいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110226,
					"content": "私は詳しい組み合わせを考えるから、海草を3つ準備してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110227,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "じゃあお願い。海草を3つ、見つかったら私に渡して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110229,
					"content": "どうやって作るかもう分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "少し考えがあるわ。でもまだ全部は分かってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110231,
					"content": "まずは海草を3つよろしくね。頼んだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 722110224,
					"content": "じゃあ任せた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "自分で見てくるといい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
