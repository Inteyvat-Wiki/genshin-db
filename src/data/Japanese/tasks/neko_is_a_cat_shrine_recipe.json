					"speakerTitle": "パイモン"
				},
				{
					"id": 722111123,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も食べたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
