					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "悦子、これからどこに探索に行けばいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110102,
					"content": "ふぅ…ちょっと一休みしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110103,
					"content": "ん？君たちだったの。私たちに何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110104,
					"content": "頼りになる料理人について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "セイライ島で料理人を探してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110106,
					"content": "事の経緯はこうなんだ。寝子が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722110107,
					"content": "寝子さまが…君たちに食料を用意してほしいって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110108,
					"content": "あっ…クソッ！僕に料理の才能があったら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722110109,
					"content": "ということは、君たちは…「これらの食材で、猫が好きな料理を作れる」料理人を探してるってことね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110110,
					"content": "そうね…料理人…料理人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110111,
					"content": "あっ、それなら稲妻城の「木南料亭」へ行って、木南杏奈さんを訪ねてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110112,
					"content": "木南さんは人柄もよくて、料理の腕も間違いない。手助けしてくれると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110113,
					"content": "ありがとう、行ってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "どういたしまして。私と大祐は引き続き探索計画を練るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110115,
					"content": "ふふ、この神社が本当に賑やかになるといいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722110116,
					"content": "そうなれば、君と寝子が費やした時間も無駄ではなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				}
			]
		},
		{
