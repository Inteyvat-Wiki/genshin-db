			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "もうここには慣れた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "一緒にお話ししない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "何かやりたいことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "うん、とっても気に入ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901510,
					"content": "モンド城とはまた違った景色で、私にはすごく新鮮なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901511,
					"content": "歌を練習する時も気兼ねなく声を出せるから、他の人の迷惑にならなくて安心なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901512,
					"content": "バーバラの歌声は迷惑にならないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "それならよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901514,
					"content": "そう言ってくれるのは嬉しいけど…他の人の気持ちも考えなくちゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901515,
					"content": "とにかく、ここに誘ってくれたことすごく感謝してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901517,
					"content": "うん、ここに誘ってくれたことすごく感謝してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901518,
					"content": "もう少し、ここに居たいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901520,
					"content": "あっ、いいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901521,
					"content": "えヘヘ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901522,
					"content": "どうして急に笑ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "あっ、ふいに気づいたんだけどね。もう随分長いことこうして友達と気兼ねなく話してなかったなぁって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901525,
					"content": "なんだか、すごく幸せを感じるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901526,
					"content": "些細なことでも満足できるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "いつも他の人の気持ちを考えてるよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "うーん…そういうことなのかなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901528,
					"content": "でも、悪いことじゃないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901529,
					"content": "些細なことで満足できるってことは、すぐ元気になれるってこと。その元気を他の人に分ければ、きっと幸せを感じてもらえるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901531,
					"content": "それは当たり前のことだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901532,
					"content": "いつもみんなにはお世話になってるんだもん、私も頑張ってその優しさに応えなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901533,
					"content": "さすがバーバラ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "うぅ、そんなに褒めないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901535,
					"content": "褒められてばかりだと…成長できなくなっちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901537,
					"content": "最近、新しい曲の練習をしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901538,
					"content": "でもまだ細かいところが上手くできなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901539,
					"content": "2番のサビのキーを一つ上げるかどうか、ダンスにまだ改善の余地があるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901541,
					"content": "「全力で応援」するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "すごく光栄な役だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "よかったら、練習を見てアドバイスしてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901543,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901544,
					"content": "えっと…上手くできないところがあっても笑わないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901545,
					"content": "何度も悩んだ末に、勇気を振り絞ってあなたに見てもらうって決めたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901547,
					"content": "笑わないから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "もしあなたに笑われたら、ここじゃどこに隠れたらいいか分からないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901549,
					"content": "ふぅ…よし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901550,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 9901551,
					"content": "公演、開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				}
			]
		},
