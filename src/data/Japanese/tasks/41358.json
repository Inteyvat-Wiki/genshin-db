					"content": "宝は全部見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "全部見つけた？宝を探すのが得意なんだね…みんな灯を少し回しただけで帰っちゃうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580204,
					"content": "全ての宝が見つかったのなら…これを報酬として渡すよ。海灯祭を楽しんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				}
			]
