				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "「玲瓏霄灯図」へようこそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580102,
					"content": "あれ？この灯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "君か、ちょうどよかった。前に君が灯を解いたから、他の物に取り替えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580104,
					"content": "どう？試してみる？今回のは前より簡単にはいかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580105,
					"content": "図案が複雑になったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "いや、図案は簡単なままだよ、前と同じく3つに分かれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580107,
					"content": "今回難しいのは、「灯を回す方法」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580112,
					"content": "そうだ、今回組み合わせる図案は<color=#00E1FFFF>「モラ」</color>だから、しっかり覚えてね。正確な図案ができたら、宝を探してくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千"
				},
				{
					"id": 413580108,
					"content": "灯を回す方法が難しくなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "へへ、今回の灯は3つとも<color=#00E1FFFF>「連動」</color>してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580110,
					"content": "簡単に言えば、一つの灯を回すと、他の灯も回るかもしれないということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "千"
				},
				{
					"id": 413580111,
					"content": "さあ、自分で体験してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "千"
				}
			]
		},
