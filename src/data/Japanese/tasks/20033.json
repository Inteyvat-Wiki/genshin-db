					"アンソニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "旅人さん！見て見て、この服どうかな？似合う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330102,
					"content": "その服…まさか！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "そう！冒険者協会の試験に合格して、正式な冒険者になったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330104,
					"content": "かっこいい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "えへへ、ありがとう。お兄ちゃんにも試験を受けてもらおうと思ったんだけど、どうしても嫌みたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330107,
					"content": "俺は冒険に興味がないんだ…それに、二人とも冒険者になったら、誰が父さんと母さんの世話をするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330108,
					"content": "じゃあお父さんもお母さんも連れて、世界中を旅しようよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330109,
					"content": "お前なぁ…。わかったわかった、もういいから、冒険者になったからにはきちんとやり遂げるんだぞ。家のことは俺がやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330110,
					"content": "だけど！安全にはくれぐれも気を付けろよ。特にケガとか、過労とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330111,
					"content": "分かってるって！じゃあ、依頼をこなしてくるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330112,
					"content": "旅人さん、私と一緒に来ない？冒険者に関すること、もっともっとあなたに聞いてみたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330113,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "えーっと、じゃあ…今回の依頼は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330116,
					"content": "運搬用の熱気球の護送！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200330114,
					"content": "出発しよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "おめでとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
