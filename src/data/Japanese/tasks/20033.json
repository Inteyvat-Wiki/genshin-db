			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンソニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "旅人、アナのことを頼むよ。あの子、最近少しはしゃぎすぎてる気がするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330302,
					"content": "冒険者になってほしくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330304,
					"content": "妹の夢は尊重してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330305,
					"content": "病気が治って、やっと自分の夢を追うチャンスを手に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330306,
					"content": "アナの兄として、俺は…全力でそれを応援するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200330307,
					"content": "ただ、それだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		}
	]
