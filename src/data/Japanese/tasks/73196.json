			"dialogs": [
				{
					"id": 731961401,
					"content": "プスパカフェの所有権について。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961402,
					"content": "元のオーナーは3年前の砂漠探検中に行方不明になったことが判明し、現在このカフェは上位機関であるヴァフマナ学院の管理下に置かれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961403,
					"content": "判決——請求者の取り下げにより無期限停止中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
