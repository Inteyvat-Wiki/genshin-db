			"dialogs": [
				{
					"id": 731961701,
					"content": "「前置きはしないことにいたしますわ、どうせサングマハベイ様の名前は聞いたことがあるでしょうから。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961702,
					"content": "「とにかく、最近は飛べない毛布を仕入れましたわ。まあ、スライカ家のものよりはマシですわね。ご購入はお早めに！購入ルートはいつも通りですわ、うふふっ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961703,
					"content": "「おい！ほどほどにしておけよ、ドリー！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
