			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "本店は「カゼニの失われた黄金像」の買取を希望しています。価格は交渉可能です、当店のオーナーまでご連絡ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731960802,
					"content": "また、関連情報をお持ちの方は、メナケリーショップのコレクター、ハリードにご連絡いただければ、相当な謝礼を差し上げます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
