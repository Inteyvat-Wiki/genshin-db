				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "「過去には使い切れないほどの富があった。だが、どう使っても心に安らぎをもたらすことはできなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961002,
					"content": "「今回の旅を経験した後、一枚のモラも残ってないが、心は穏やかだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961003,
					"content": "「その話が聞きたいのなら、野菜屋台に来るがいい。もちろん、野菜を買ってくれるならなお良い。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
