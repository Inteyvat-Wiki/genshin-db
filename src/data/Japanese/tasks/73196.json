			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "消費者の苦情により、アニ洗染は服の窃盗の疑いがあるため、現在封鎖されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961302,
					"content": "調査によると該当染料屋は現在もぬけの殻であり、何も残っていないようです。現在、被害者の紛失品の回収に努めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
