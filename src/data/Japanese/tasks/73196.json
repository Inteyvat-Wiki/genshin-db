					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "本行はスメールに事務所を開設することにしました。乞うご期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731960402,
					"content": "業務の申請なら、ヴィクトルから璃月支店へ代行をご依頼ください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731960403,
					"content": "ローンのご相談は、「お伺いした」デットエージェントまで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319605",
