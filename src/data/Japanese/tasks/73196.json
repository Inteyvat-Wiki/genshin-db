			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "本店は日用品を取り扱っており、各商品は店長本人が直々に把握しておりますので、品質に関する心配は不要です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731960702,
					"content": "「親父、ちょっと金を貸してくれ。最近デーツの値段が急激に上がるという知らせを聞いたんだ、きっとこれでがっぽり稼げるはずだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
				7319608
			],
