			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "優れた品質と手頃な価格。身の回りのすべては、ジュート香料店にて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731960602,
					"content": "今購入すると、特典も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319607",
							"2"
						],
						"stepId": 7319607,
