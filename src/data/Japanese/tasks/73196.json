				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "人生の幸福を希求して故郷を離れ、遠く離れた地を探検する。今すぐ「冒険著協会」に入会しよう！初月会費はたったの5モラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961602,
					"content": "真の知識は実践でしか得られない。たとえ長い旅の果てにこの世を去るとしても、生きることに人生を浪費するよりは尊いものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961603,
					"content": "「よく見て、これは冒険者協会ではない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961604,
					"content": "「何だと！一年ほど会費を払ってしまったぞ。まだ取り戻せるか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
