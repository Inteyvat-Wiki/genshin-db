			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "「グランドバザールと言ったら、見逃してはいけないのはズバイルシアターだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961502,
					"content": "「そしてズバイルシアターで最も見逃せないものは、ニィロウさんのダンスだ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "告知板"
				},
				{
					"id": 731961503,
					"content": "「スメールに来てニィロウさんの花神の舞を見なかったら、一体何のために来たのかわからないぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告知板"
				}
			]
		},
