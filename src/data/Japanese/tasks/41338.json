					"content": "この二つの飛行道路はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380502,
					"content": "悪くなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "よかった！これで千岩軍に申請できるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380504,
					"content": "こんなに面白い冒険、きっとたくさんの人が冒険者協会に入りたいと思ってくれるよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380505,
					"content": "そうだ、これはあなたへのお礼だよ。受け取ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				}
			]
