				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"テンテン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "うーん…なんで人が来ないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "旅人！聞いてよ…協会が海灯祭の祭り雰囲気にあやかって、冒険者を募集しようとしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380104,
					"content": "千がなんとかかんとか図…っていう遊び方を考えたって聞いたから、私も後れを取り戻さなきゃって思ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380105,
					"content": "だから、「冒険初体験」っていうイベントを考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380106,
					"content": "簡単にいえば、霄灯を目印にして、空中に飛行道路を作り上げるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380107,
					"content": "それで、このイベントに参加した人に「風の翼」を広げてもらって、霄灯に沿って飛んでもらうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380108,
					"content": "冒険のワクワク感を味わえて、璃月の風景も一望できて、霄灯もすぐそばにある。こんないいことってないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380109,
					"content": "二つの飛行道路を設計したんだけど、千岩軍から安全性を確かめるために、試しに飛んでみる必要があるって言われて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380110,
					"content": "あなた、冒険の経験が豊富なんだよね？も、もしよかったら、安全性を確かめてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380111,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "手伝ってくれてありがとう。じゃあ天衡山に行こう。一つ目の飛行道路はそこから始まるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				}
			]
		},
		{
