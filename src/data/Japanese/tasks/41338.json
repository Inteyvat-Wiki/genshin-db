				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "ここがゴール地点だよ。凄く手馴れてるね…どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380302,
					"content": "祭りの雰囲気があった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "えへへ、当然だよ。私が特別に用意した霄灯だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380305,
					"content": "じゃあ次の飛行地点に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テンテン"
				},
				{
					"id": 413380303,
					"content": "霄灯が綺麗だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
