			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "うむ…それでいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000102,
					"content": "旅人、ちょうどよかった。今さっき神器の調整が終わったところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000103,
					"content": "これが…「からくり調理神器」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "ああ。この神器は妾が直々に設計したものだ。使いどころは無限にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000107,
					"content": "この調理用神器を作るため、妾は無数の古い書類を調べた。そして、「調理」におけるいくつかの重要な点を把握した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000108,
					"content": "一、食材を探すこと。調理において、食材は非常に大事なものだ。数え切れないほどの料理人たちが、希少な食材を探すために苦労して旅に出ることもある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000109,
					"content": "妾の神器は、その難題を解決することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000110,
					"content": "この神器を起動すれば、自動で調理に最も適した食材を探し、その食材の気配を表記する。料理人はその道を進むだけでよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000111,
					"content": "自動で取ってくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "それは、コホン…まだ研究が浅いため…どうすれば鍋が山道を自動で駆けていけるのか、解決できていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000113,
					"content": "二、調理すること。妾は神器の中に無数のからくりを設置した。食材を入れるだけで、自動で作ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000114,
					"content": "どうして自動で処理できるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "それは…それぞれの調理手法に合わせた数値や、様々な食材の対処方法を設置しているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000116,
					"content": "その中の奥深さは、短い言葉で表すことができない、非常に複雑なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000117,
					"content": "また、妾の経験からして、調理の時に最もイライラすることは「調理器を洗うこと」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000118,
					"content": "楽しく食事をした後に、残り物を片付けるのは実に無粋だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000119,
					"content": "その神器は売り物なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "ハハッ、妾の神器は安くないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000121,
					"content": "それに、この神器は妾の仙力で動いている、買って帰っても使えないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000125,
					"content": "雑談はここまでにしよう。妾は神器を作りながら、料理の調理法を研究してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000126,
					"content": "そして神器を作り終えた今、それと同時に前代未聞の美食もいくつか研究した。この「からくり調理神器」で試してみようと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000127,
					"content": "今回呼んだのは、手伝ってほしいことがあるからだ。食材を探し、調理法通りに料理を作ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000128,
					"content": "一つ目の料理は、「文心豆腐」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000129,
					"content": "この料理は豆腐を千切りにする必要がある…この神器の「包丁さばき」が試せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000130,
					"content": "食材は…豆腐、ハム、タケノコ、鳥肉を使う。すでに甘雨に頼んで食材を用意した、ここにある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000131,
					"content": "ん？タケノコはどこに？以前ここに置いたはずだが…まさか神器を調整するのに夢中で、何かに盗まれたことに気付かなかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000132,
					"content": "ふん、まあいい…ちょうどお前に、「からくり調理神器」の食材を探す能力を見せてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000133,
					"content": "からくり調理神器…起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000134,
					"content": "旅人、神器は妾が起動しておいた。その気配を辿り、妾のほしいタケノコを集めてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000122,
					"content": "なんでこの神器を作ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "目的は…この世のからくりの道を探求するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000124,
					"content": "それに、この神器があれば、料理も楽に作れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000105,
					"content": "どうやって使うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "ふっ、そう慌てるな。心配しなくても、ゆっくり説明してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
