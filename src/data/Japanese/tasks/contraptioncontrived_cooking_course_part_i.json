		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "後のことは神器に任せろ。だが旅人、火加減の調整はお前に任せるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000304,
					"content": "火加減は自動で調整できないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "それは…以前かまどを内蔵し、火加減の調整を試みたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000306,
					"content": "「からくり調理神器」の必要とする炎は普通のものではない…妾が直々に操作する仙力の炎でなければならないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000307,
					"content": "その位の仙火を内蔵すれば、神器の部品が焼かれてしまう可能性がある。それでは元も子もないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000308,
					"content": "今ある最も合理的な解決方法は、仙火を装置外部に置くことだ。ただ、それだと火加減を調整してもらう必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 715000309,
					"content": "旅人、これは非常に重要なことだ。火加減の調整は任せたぞ。準備ができたら妾に言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
