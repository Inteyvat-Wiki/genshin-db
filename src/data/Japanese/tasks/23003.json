				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "おう、旅人！…いや、金運の申し子、幸運の使者よ！また会えたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030202,
					"content": "この前、お前が選んでくれた「千金料理」を食べたおかげで、取引所では一人勝ちだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030203,
					"content": "買った銘柄を今日見てみたが、全部、大当たりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030204,
					"content": "ほれほれ、ランバド酒場に行くぞ！お礼に、今日はなんでも好きなものをおごってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "お前たちには世話になった。今日はじゃんじゃん好きなものを頼むといい！ハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030402,
					"content": "大儲けしたみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030403,
					"content": "一般人には大金だろうが…このハティム様にとっちゃ、はした金みたいなもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030404,
					"content": "俺は取引所で何十年も勝負してきたベテランだ。先物に興味があるなら、ちょっとした秘訣を教えてやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030405,
					"content": "それが、この前約束したボーナスだ。まぁそう遠慮するな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030406,
					"content": "えぇ、ボーナスってそれかぁ？そんなの別に欲しくないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030407,
					"content": "#だって{M#俺}{F#私}たち、先物取引なんてしないし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "いやいや、もちろんモラはきちんと支払う！だが、それよりこのハティム様のアドバイスの方がよほど価値があると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030409,
					"content": "じゃあ…いっこ質問だけど、ほんとにスライムの先物取引ってあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030410,
					"content": "べ、別にお金儲けがしたいわけじゃないぞ！ちょっと、聞いてみただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030411,
					"content": "うーむ、先物取引の対象になるのは、市場で流通している商品だ。つまり、スライムの液体が市場で小麦粉やミルクくらい大量に流通していれば、取引対象になることもありえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030412,
					"content": "前にも言った通り、スライムの液体を先物取引の対象にしようとすれば、野外のスライムは根こそぎ狩られかねない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030413,
					"content": "スライムを専門に飼育して、スライムの液体を持続的に大量生産する集団や個人が出現するかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030414,
					"content": "そうなれば、スライムの液体の価格も高騰するかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030415,
					"content": "うぅ…スライムの液体を買うだけなのに、やけに複雑なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030416,
					"content": "#や、やっぱり直接{NICKNAME}にスライムを倒してもらおう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030417,
					"content": "金運の申し子、お前はなにか質問はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030418,
					"content": "どうやって「千金料理」を考案したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "おお、さすがだな。ズバッと金儲けの神髄に切り込んできやがった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030420,
					"content": "「考案」したというか…「千金料理」は長きにわたる先物人生の「賜物」というべきだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030421,
					"content": "先物取引は常に波乱万丈だ…だが「千金料理」があれば、投資という船の舵をがっちり握っていられる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030422,
					"content": "結局根拠はないんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "おっと、話はあとだ。ほら！どんどん食え！今後も、どうかよろしく頼むぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030425,
					"content": "シャワルマサンドは食ったか？スメールの郷土料理なんだ、食べとかないと損だぞ！ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030426,
					"content": "ハティムに美味しいご飯をご馳走してもらった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "どうにか安心したいだけでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "「蓄財の地」で…「千金料理」を食べたというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030702,
					"content": "結局大損だ！…おかしいだろ！この市場には、ルールもへったくれもないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030703,
					"content": "ハティム！ずっと捜してたんだぞ。大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230030704,
					"content": "お前たちか…お、俺は…大丈夫、元気だ…ほら見ての通り、ぴんぴんしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030705,
					"content": "ただ、取引で負け越しただけだ…ゲホゲホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030706,
					"content": "ご、ごめん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "いや、お前のせいじゃない…気にするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030708,
					"content": "もちろん、俺のせいでもない…全部、この腐りきった市場のせいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030709,
					"content": "道理もなにもあったものじゃない！暴落するときはするし、高騰するときは…高騰…しないのだ、なぜか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030710,
					"content": "ああ…まったく、俺ときたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030711,
					"content": "このカリミの偉大なる富豪、ハティム様が先物市場を征服できないなど…否！あってはならないのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030712,
					"content": "こんなに大損したのに…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "ふんっ、よいのだ。予備資金ならまだまだある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030714,
					"content": "たとえ手元の資金が尽きたとしても、金に換えられる資産などごまんとある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230030715,
					"content": "待っていろよ、カリミ取引所。このハティム様のリベンジをな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				}
			]
		}
	]
}