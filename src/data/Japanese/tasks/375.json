			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "はぁ、やはり君でもダメだったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750102,
					"content": "わ、わかってたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3750103,
					"content": "#まあ、騎士団のスーパールーキーの{NICKNAME}の実力を見たかっただけだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750104,
					"content": "それにほら、勇者が村に伝わる宝剣を手にする——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750105,
					"content": "こんな展開、詩にするにはぴったりじゃないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750106,
					"content": "なんか失礼だぞ、吟遊詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3750107,
					"content": "誤解しないで、これはモンドに対して失望しているんだよ。勇者相手に宝剣をケチるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750108,
					"content": "さて、ちゃんとした方法で借りるのは無理みたいだから、別の手を使うしかないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750110,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "自由意志を尊重して、君の意見を聞こう。どう盗ればいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750112,
					"content": "盗みはしたくない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "さあ、話そう。好きなだけ話すことこそ、自由ってものだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750113,
					"content": "はははっ、君、最初からそれはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750114,
					"content": "真面目に言うとさ、ボクより君のほうが向いてると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750115,
					"content": "だってボクは歌うこと以外、長所といえる長所はないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750116,
					"content": "それにボクは一人ぼっち、捕まったら冤罪を晴らしてくれる人もいない。きっと重罪に問われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750117,
					"content": "泥棒して捕まったなら、別に冤罪じゃないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3750118,
					"content": "#でも{NICKNAME}は違う。君はモンドに貢献した、騎士団の未来のスターだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750119,
					"content": "ミスしてもちゃんと説明したら、誤魔化せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750140,
					"content": "それに、ここの守衛たちは夜になると帰っちゃうらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750141,
					"content": "タイミングをちゃんと狙えば、ミスをしたくてもできないと思うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750120,
					"content": "ミスを前提に考えるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3750122,
					"content": "さっき自分がバルバトスだって言った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750123,
					"content": "確かにそう言った気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750125,
					"content": "神なら、見て見ぬふりはできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "だから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750126,
					"content": "おや、それはどうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3750128,
					"content": "神じゃなくても、トワリンを助けたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#{NICKNAME}の過去に関して、機会があったらまた教えるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3750130,
					"content": "「天空」を持って帰る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "「別れ」はもう見たくないから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "ウェンティ"
				}
			]
		},
