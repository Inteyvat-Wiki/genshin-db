			"dialogs": [
				{
					"id": 206030501,
					"content": "すぐに戻ってきたな。どうやら大したことはないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206030502,
					"content": "活動してる魔物がたくさんいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "何？魔物がいる、しかも数が増えてるだと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206030504,
					"content": "おかしいな、前にモンドを攻撃してきた魔物のほとんどは撃退されたし、なぜまだモンドの近くにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206030505,
					"content": "まさか何か企んで…いかん、冒険者たちを呼び戻して依頼を再発行しないとな。油断禁物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206030506,
					"content": "野外でうろつく魔物に秘密調査するのは冒険者協会の専売特許だぞ…そろそろ冒険者協会の実力を見せる時だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206030507,
					"content": "そうだ、これは君への報酬だ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
		}
	]
