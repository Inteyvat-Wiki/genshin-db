				"objectNames": [
					"ブロック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "あら、戻ってきたの。獣肉は準備できた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000702,
					"content": "持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "どれどれ…大丈夫みたい、確かに新鮮だわ。主にこの獣肉を使って、それと「風の味」を表現する材料を少し準備すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000704,
					"content": "さて、「風の味」の材料と言えば…当然「蒲公英の種」を思いつくわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000705,
					"content": "旅人、蒲公英の種を少し集めてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000706,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "お願いするわ。私はまず獣肉を処理してくるから、蒲公英の種を集めたら、持ってきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブロック"
				}
			]
		},
