				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "ありがとう、これで材料が揃ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000902,
					"content": "ご苦労様、これはあなたへの報酬よ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000903,
					"content": "さて一体どうやって「風の味」を表現するのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000904,
					"content": "蒸す、煮る、焼く、揚げる…はぁ…やっぱり、食材元の味をメインに、料理ができあげてから蒲公英の種を加えよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブロック"
				}
			]
		},
