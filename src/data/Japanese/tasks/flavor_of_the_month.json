			"trigger": {
				"objectNames": [
					"ブロック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "どうした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "実は風花祭に合わせて新しい料理を開発しているの。主題は「風の味」、今食材を準備しているところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000203,
					"content": "でも、エレンに明冠峡谷で新鮮なお肉を狩るようお願いしたのに、もうずいぶん経ったけどまだ帰ってこないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000204,
					"content": "このままだと食材の鮮度が落ちてしまうかもしれないわ。旅人、明冠峡谷へ行って確認してくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708000205,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "お願いするわ。戻ったら最新の料理を食べさせてあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブロック"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080006",
							"2"
						],
						"stepId": 7080006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エレン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "た、助かった…本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000602,
					"content": "誤算だった、イノシシを狩るだけだったのに、こんなにしんどいとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000603,
					"content": "ブロックの依頼した食材について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "ブロックから頼まれたの？あぁ…実は彼女が欲しがってた新鮮な獣肉はもう捕れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000605,
					"content": "でもイノシシを追う時に油断して、近くの魔物に気づかれたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000606,
					"content": "イノシシは狩れたけど、魔物にも囲まれちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000607,
					"content": "旅人さん、この肉をブロック届けてもらえるかな？僕は先に街に行って教会で傷を診てもらわないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 708000608,
					"content": "はぁ、またこうなってしまった。ドゥラフさんにまた叱られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エレン"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
