					"nextDialogs": [
						708001502
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001502,
					"content": "肉は持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "よかった！あれ？シュースターは…危険に遭ってないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001504,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "よかったわ、大事にならなくて…あとで料理ができたら、彼にもあげるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001506,
					"content": "ところでこの「冷製鮮肉」、確かに普通の肉と違うわね。この材料を使えば、「ピキーン」っていう感じの料理ができるかもしれないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001507,
					"content": "でも、料理に「風の味」を加えるには、蒲公英の種を使う必要があるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001508,
					"content": "でもそれだと普通の肉料理とあまり変わらないし、まだ決定的な材料が欠けてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001509,
					"content": "そうだ！実はあの対決のあと、香菱に何回か会ったの。彼女から「キノコとスライム炒め」っていう料理を聞かされたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001510,
					"content": "こういう材料は、まだ使ったことがないの…でも、目新しい料理を作るには、普通じゃない材料を使わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001511,
					"content": "旅人、もしよかったら、蒲公英の種とスライムの液体を用意してきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001512,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "じゃあ頼んだわ。私はここでレシピについて考えているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブロック"
				}
			]
