				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "い、生き返った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001302,
					"content": "君が火を起こしてくれたのか…頼もしい旅人さん…本当に、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001303,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "だいぶ暖かくなったよ、よかった…実は依頼でここに「冷製鮮肉」を取りに来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001305,
					"content": "最初は雪山の周囲で探してみるつもりだったけど、うっかり火種をなくして迷子になってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001306,
					"content": "もし君が来なかったら、どうなっていたか…本当にありがとう",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001307,
					"content": "ブロックの依頼について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "ブロックに頼まれたのか…きっと待ちくたびれているだろう。でもこの肉をあそこに運ぶ力なんてもう残ってない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001309,
					"content": "悪いけど、この「冷製鮮肉」を届けてきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 708001310,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "ありがとう。僕は麓にある拠点で、温かいスープを飲んでくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怖がっているシュースター"
				}
			]
		},
