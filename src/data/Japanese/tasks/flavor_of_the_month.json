			"dialogs": [
				{
					"id": 708001001,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "あなたは…覚えているわ。あなたは香菱の助手、そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001003,
					"content": "この前の対決は凄かった、今でも覚えているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001004,
					"content": "この前は香菱に負けたけど、今回は「風の味」を感じさせる料理を創り出して、もう一度香菱に勝負を挑むつもりよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001005,
					"content": "この料理のために、特別に冒険者にお願いして雪山から「冷製鮮肉」を調達してくるよう頼んだの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001006,
					"content": "でもそのシュースターという冒険者、まだ帰ってこないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001007,
					"content": "雪山は危険だと聞いているけど、もしかしたらあの冒険者、危険に遭遇したのかもしれない…お願いだけど、探しに行ってくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 708001008,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "ありがとう。雪山は寒いから、火を起こして暖を取ることを忘れずにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブロック"
				}
			]
