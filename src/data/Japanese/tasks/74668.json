			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "あれ？七天神像が今、急に光ったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680102,
					"content": "変だな…今までこんなことあったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680103,
					"content": "七天神像が光るのはいつものこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}、気分が悪くなったりしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680108,
					"content": "あれ？み…水が語りかけてくる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "なんだ、話せるなら大丈夫そうだな。冗談まで言えるみたいだし、問題なさそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680112,
					"content": "でも、あの光が出てから周りの空気がうるおった気がする…もしかして、さっきの水元素のおかげなのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680113,
					"content": "へへっ、そういえばフォンテーヌでは、元素の力をうまく使うことで水中をスイスイ～って泳げるんだってな。水の中に落ちたお宝を拾えるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680114,
					"content": "お宝を引き揚げる仕事は、おまえに任せるな…オイラは水の上で見張りをしててやるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680115,
					"content": "一人で水に入るのはさびしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "うぅ…で、でも水に入るのは怖いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680118,
					"content": "少しでも気を抜いたら、水流に巻き込まれるかもしれないだろ。それで頭がくらくらしたら、飛べなくなっちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680119,
					"content": "モンドでおまえに会う前みたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680120,
					"content": "じゃあ、また釣り上げてあげるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "…ほ、ほんとか？だったら、一緒に水に入ってもいいぞ。いいか、絶対に約束は守ってくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680116,
					"content": "パイモンだってできる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "わあっ！今ならエラ呼吸ができそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "だったら、まずはエラがないとだな。ったく、元気そうだし、心配して損したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746680105,
					"content": "水が吹き出たとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "おお、さすがは水神の国だな。七天神像まで水を吹き出すのか…って、そんなわけないだろ！あの光は、どう考えても普通じゃなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}