			"dialogs": [
				{
					"id": 220010301,
					"content": "#ここだ、キャプテンはここにいる、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010302,
					"content": "君、なんで海賊を連れてきたんだ。ボクとルルが逃げられるように時間稼ぐべきだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220010303,
					"content": "なんでお前がルルと逃げて、オレが海賊の足止めをしなければならない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010304,
					"content": "お前を海賊に渡して、オレとルルが逃げても同じだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010305,
					"content": "君ね…北斗姉さんが言ってたよ、友達を裏切ってはいけないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220010306,
					"content": "じゃあ、キャプテンだけ逃げていいっていうのも、北斗姉さんが言ったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010307,
					"content": "君…もうハスの花托を分けてあげない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220010308,
					"content": "いるかよ、そんなもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010309,
					"content": "急に喧嘩が始まった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220010310,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、気にしないで、いい方法があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010311,
					"content": "あの二人はハスの花托が大好きだから、美味しいものを食べれば大人しくなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010312,
					"content": "ハスの花托を持って来てくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010313,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、早く戻ってきてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010315,
					"content": "二人の好物はハスの花托じゃないはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "#うーん…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}じゃあ何が好きなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010317,
					"content": "とりあえず、ハスの花托を持ってきて。このままにしておけないよ。",
					"roleType": "TALK_ROLE_NPC",
