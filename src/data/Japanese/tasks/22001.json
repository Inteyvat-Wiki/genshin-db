			"dialogs": [
				{
					"id": 220010101,
					"content": "モンちゃん、今日はオレがキャプテンをやる番だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010102,
					"content": "ルル、ボクはもう何日もキャプテンをやったから、そろそろ飛くんの番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220010103,
					"content": "でもモンちゃんのキャプテン、すごくよかったよ。まだ続けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220010104,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}たち何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ゲームやっているの。もともとオレがキャプテンをやるはずだったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010106,
					"content": "でもルルはモンちゃんのキャプテンがいいっていつも言っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010107,
					"content": "ああ、ルルいつもこうだ…でも、あいつが良ければ、まぁ、いいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010108,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、もう一回海賊をやってもらっていい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010109,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "結局、今回も接客係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220010113,
					"content": "#前回のように、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}準備が終わったら来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "飛"
				},
				{
					"id": 220010111,
					"content": "良い人をやりたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "はあ、オレもキャプテンをやりたかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "飛"
				}
			]
		},
