			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"伝次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "どうやら祝賀会の準備もそろそろ終わるようですね。しかし宴が始まる前に、私の方から簡単な演説をしなくてはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230102,
					"content": "うぅ…心海のエネルギー、足りるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230103,
					"content": "ご安心を、まったく問題ありません。あなたたちのおかげで、エネルギーがとても速く回復しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230104,
					"content": "よかった！オイラたちも応援してるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230105,
					"content": "皆さん、お疲れ様です。本日は祝賀会へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230106,
					"content": "ついに、我々と幕府軍の戦争は終わり、目狩り令の廃止も見届けることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230107,
					"content": "稲妻の未来がどうなるのか、私には予測できません。しかし私は明日、天領奉行と和平交渉を進め、海祇島の平和のために最善を尽くします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230108,
					"content": "皆さんのご尽力があったからこそ、このような困難な戦いに勝つことができました。皆さんには感謝しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230109,
					"content": "この祝賀会はここにいるすべての方に用意したものです。苦労して勝ち取ったこの勝利を、しっかりと楽しみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230110,
					"content": "うぉおおお——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "伝次郎"
				},
				{
					"id": 120230111,
					"content": "宴も順調で、何の問題も起きなくて本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230112,
					"content": "人は楽しい気持ちになると、誰かに打ち明けたいという気持ちが高まる傾向にあるようです。私のために、もう少し情報を集めていただいてもよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230113,
					"content": "「天領奉行とファデュイの結託」について、未だに決め手となる証拠がありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230114,
					"content": "明日の交渉で、何か起きないか心配なのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230115,
					"content": "わかった、オイラたちが調査してくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
