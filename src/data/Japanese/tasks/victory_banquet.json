			"dialogs": [
				{
					"id": 120230501,
					"content": "珊瑚宮様のおかげで、海祇島に今の平和がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230502,
					"content": "最近、何か起きた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "最近？そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230504,
					"content": "俺たちにとって一番の出来事といえば、海に出て魚を捕れるようになったことかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230505,
					"content": "戦争をしてた時は海上に戦船がたくさんあったから、近くで小魚やエビを捕ることしかできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230506,
					"content": "収穫がほとんどない時もあって、みんな腹を空かせてたよ。子供がそれで泣いているのに、どうすることもできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230507,
					"content": "毎晩、腹がうめき声を上げ、眠ることもできず、そのまま夜が明けたこともある。それが今は、ようやく少しずつ良くなってきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230508,
					"content": "聞いたよ、メカジキ二番隊の隊長なんだってな。この戦いに勝つために手を貸してくれて本当にありがとう。さっき捕ったばかりのこの魚を君にあげよう、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230509,
					"content": "いやいや、気にすんなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230510,
					"content": "ははっ、いいんだ。君がいなかったら、俺たちはまだ腹を空かせてたかもしれない。恩はしっかりと返す、そう珊瑚宮様に教えられてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "平井"
				},
				{
					"id": 120230511,
					"content": "#わかった。じゃあ、これは受け取っておくよ、ありがとな。{NICKNAME}、他の人にも聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
