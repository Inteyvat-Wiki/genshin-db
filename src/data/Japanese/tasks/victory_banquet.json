			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "うわ…この人、すごくお酒くさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230202,
					"content": "ん？お前はたしか…「メカジキ二番隊」の隊長！そうだったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230203,
					"content": "海祇島に戻って来てたのか、てっきり小隊を見捨てて一人で逃げたのかと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230204,
					"content": "オイラたちが逃げるもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230205,
					"content": "ふん、どうだか。平和やら安定やら…みんな、そんなことばっか口にしてるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230206,
					"content": "抵抗軍にとって一番大事なことがなんなのか、忘れてないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230207,
					"content": "「戦う意志」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "そうだ。お前にまだ抵抗軍の兵士たる資格があるかどうか、俺が試してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230209,
					"content": "俺に勝ったらお前たちの質問に答えてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230210,
					"content": "うぅ…なんかこの人とは会話がしづらいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230211,
					"content": "#どうする、{NICKNAME}？やるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230212,
					"content": "うん、負けない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "ふん…そういうことは、俺に勝ってから言うんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "高善"
				},
				{
					"id": 120230213,
					"content": "すべて洗いざらい吐いてもらおう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
				1202312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
