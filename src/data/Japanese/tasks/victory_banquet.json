			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "…とにかく、そういうことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230402,
					"content": "天領奉行とファデュイの結託は、そいつらがでっち上げたことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230403,
					"content": "和平交渉を滅茶苦茶にして、戦争を続けるのが目的らしい…それに、オイラたちがなにをやっても、もう間に合わないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230404,
					"content": "そうだったのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230405,
					"content": "心海…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "大丈夫です、ご心配をおかけしてしまいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230408,
					"content": "このことは私のせいでもあります。私がもっと早く彼らの気持ちに気づけていたら、こんなことにはなりませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230409,
					"content": "高善が言っていた「間に合わない」、何を指しているのかおおよその予想はつきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230410,
					"content": "和平交渉は明日ですが、双方の侍衛はすでに交渉地点に到着し、周囲の安全を確認している状況です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230411,
					"content": "高善のような主戦派が、それら侍衛に紛れて交渉の場を壊そうとしているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230412,
					"content": "じゃあ、どうするんだよ。オイラたちが今からそこに行って、侍衛を交代させるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230413,
					"content": "いえ、それでは妥当性に欠けます。第一に、私たちが新しい侍衛を連れて中立地帯へ向かえば、余計な警戒をさせてしまうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230414,
					"content": "それに主戦派の兵士たちが早々に計画を実行し、天領奉行の侍衛を攻撃して、戦争を引き起こしてしまう可能性もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230415,
					"content": "何より、このことに参与している海祇島の兵士の数が分からない以上、人員を変えても結局意味がないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230416,
					"content": "なんだか複雑だな…じゃあ、もう方法はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230417,
					"content": "ご心配なく。ことが起きた以上、私が対策を考えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230418,
					"content": "兵士たちの考えは間違っているとはいえ、すべて彼らのせいということではありません。いずれにせよ、彼らの命をどう守るのか、その方法を考えなくては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230419,
					"content": "明日、またここで会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120230406,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
