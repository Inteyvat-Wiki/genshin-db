			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"高善"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "強い…さすが珊瑚宮様が選んだお方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230302,
					"content": "お前にはまだ戦う意志が残っているようだ…もしかしたら…お前なら俺たちを理解できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230303,
					"content": "メカジキ二番隊の隊長…俺たちの仲間になってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230304,
					"content": "まずは何が起きたか教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230306,
					"content": "「天領奉行とファデュイの結託」は、俺たちが流したガセだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230307,
					"content": "そ、そんな！心海がずっと心配してたことなのに、おまえたちの嘘だったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230308,
					"content": "どうしてそんなことするんだ？一歩間違えれば、また天領奉行と戦争になっちゃうんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230309,
					"content": "そう、それこそが俺たちの望む結末だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230310,
					"content": "和平交渉？ふん、そんなことばかり考えてたら海祇島に未来はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230311,
					"content": "天領奉行が考えを変えないと誰が保証できる？雷電将軍が次の目狩り令を発令しないと誰が保証できるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230312,
					"content": "我々抵抗軍に最も必要なのは、戦う意志だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230313,
					"content": "天領奉行と雷電将軍は信じるに値しない、信じられるのは自分自身のみ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230314,
					"content": "お前もそう思うだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230315,
					"content": "それも一理あるけど、なんだか言ってることに少し違和感が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230316,
					"content": "ただ戦いたいだけでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "そうだぞ。そんなこと言って、結局ぜんぶ憶測じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230318,
					"content": "そういった憶測のせいでガセ情報をでっち上げて、たくさんの人が待ち望んだ平和を壊そうとしてるっていうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230319,
					"content": "何も知らんくせに俺に説教するな！お前らに何が分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230320,
					"content": "戦いに勝つため、俺たちはずっと極限まで戦う意志を貫いてきた。それを今さら、もう意味がないだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230321,
					"content": "俺たちに武器を下ろさせ、一般人のように生活しろと言われても、そんなことできるわけないだろ？目を閉じると見えてくるんだよ…戦場で犠牲になった仲間の姿が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230322,
					"content": "あいつらの姿が脳裏に焼き付いて離れないんだ…だから俺は、絶対に天領奉行と目狩り令を許さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230323,
					"content": "お前と俺たちは同志ではなかったようだ…このことを珊瑚宮様に言いたいのなら好きにしろ。だが、俺たちを止めようとするのなら…もう間に合わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230324,
					"content": "間に合わない？どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "高善"
				},
				{
					"id": 120230326,
					"content": "うぅ…無視を決め込んでるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120230327,
					"content": "#どうしよう{NICKNAME}、緊急事態だ。早く心海に伝えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
