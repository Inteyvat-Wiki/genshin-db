				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "今日、海で網を投げるときにうっかり落としてしまったよ。あんなに大きな網だっていうのに…ま、どうでもいいか、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460302,
					"content": "俺も仕事でしくじっちまったが、賊を数人取り逃したところで何の問題もねえよな、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460303,
					"content": "おい！おまえらの悪夢のせいで、紫と白音が消化不良を起こしちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460304,
					"content": "なんだこのチビ？スゲー怒ってるぞ。面白いな、くく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460305,
					"content": "面白いね、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460306,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460307,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460308,
					"content": "この二人、おかしいぞ。オイラですら、ちょっと言い方が強かったかなって思ったのに、ぜんぜん怒らないなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460309,
					"content": "あたしが話してみるよ。…二人とも、ゆうべ秋沙銭湯で夢の調整をしてもらったこと覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460310,
					"content": "なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460311,
					"content": "そんな覚えないが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460312,
					"content": "うん…じゃあ、最近悪夢を見たことは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460313,
					"content": "なに言ってんだ？人に悪夢を見せるものがこの世にあるわけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460314,
					"content": "そうだね、ありえない。普通の人が悪夢を見るわけないさ。海を眺めて、花見するだけで、人生は十分素晴らしいっていうのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460315,
					"content": "どういうことだ？この二人、ゆうべのことを覚えてないみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460316,
					"content": "けどこの感じからして、こいつらが悪夢を見るとこなんて想像できないな…まさか、あの江村一玄斎ってペテン師じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460317,
					"content": "いや、この精神状態は妙だよ…旅人、パイモン、気をつけて。ちょっと特殊な手段を使う必要がありそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460318,
					"content": "これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460319,
					"content": "どうやら彼らの潜在意識は今、遊離状態にあるみたいだね。この状態なら「夢入り」と似た方法で潜在意識に潜れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460320,
					"content": "くそっ！絶対に逃がさねえぞ、てめえら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "薄田",
					"speakerSubtitle": "怒る薄田"
				},
				{
					"id": 120460321,
					"content": "波が強すぎる。このまま陸にいよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "海彦",
					"speakerSubtitle": "怖がる海彦"
				},
				{
					"id": 120460322,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460323,
					"content": "見ての通り、彼らの「悩み」は消えてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460324,
					"content": "薄田さんは、衝動的で怒りっぽい性格みたいだ。そのせいでよく過激な行動を取ってしまい、本人も悩んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460325,
					"content": "海彦さんは、ある災難で死にかけたことから、波を恐れるようになり、海に出ることを拒むようになった。おそらく、彼の生計にも大きな影響を与えてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460326,
					"content": "彼らの負の感情は強制的に心から剥がされ、潜在意識の中を漂ってる。だから「喜び」だけが表に出てるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460327,
					"content": "でも、抑えられた感情はそのまま熟成されていく。やがて、紫たちにも消化できない悪夢となってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460328,
					"content": "どうしてこんなことに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "おそらく江村一玄斎は、あたしたちが思ってる以上に手ごわい相手みたいだね。もしかすると、本当に人間の感情に影響を与える力があるのかもしれない。だからこれまでずっと、誰も「ペテン」を見破れなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460330,
					"content": "昨日キミたちがここに来たとき、何かおかしな点はなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460331,
					"content": "いや、二人とも普通だったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460332,
					"content": "しいて言えば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "昨日の奇妙な夢を思い出し、それを瑞希に話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "そんなことがあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460335,
					"content": "あの時はあまり気にしなかったけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "まさか…早く江村一玄斎を見つけないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460337,
					"content": "瑞希、どうしたんだよ、急に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460338,
					"content": "江村一玄斎はただの人間じゃない。「指導」を受けた人たちも、みんな彼の被害者なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460339,
					"content": "元凶である江村一玄斎を早くどうにかしないと、被害者たちの人格は元に戻らなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460340,
					"content": "そんな…！おい、江村一玄斎はいつ来るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460341,
					"content": "ああ？急にどうした？いつ来るかなんて関係ないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460342,
					"content": "いつでもいいさ、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460343,
					"content": "くぅ～、ぜんぜん会話にならないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460344,
					"content": "本当は、ゆうべのことを覚えてるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460345,
					"content": "話したくないのは、キミたちを困らせた悪夢が、今の「喜び」とあまりにも相容れないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460346,
					"content": "ちょっと思い出しただけで、心を引き裂かれるような、得体の知れない違和感に襲われる…そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460347,
					"content": "…それ以上言わないでくれ。考えさえしなければ、いくらかマシなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460348,
					"content": "それが江村一玄斎がキミたちに残した潜在的な危険だ。けど今ここで、キミたちの自己欺瞞を責めるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460349,
					"content": "さっきの質問にちゃんと答えてくれればね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460350,
					"content": "分かった…でも本当に知らないんだ。さっき俺たちも聞いたが、今日は来ないとしか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "薄田"
				},
				{
					"id": 120460351,
					"content": "ああ。たしか、昨日は疲れすぎたからって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "海彦"
				},
				{
					"id": 120460352,
					"content": "またあたしを避けてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460353,
					"content": "どうやら、役に立つ情報は聞けそうにないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460354,
					"content": "キミたち、江村一玄斎の家がどこにあるかは調べた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460355,
					"content": "昨日聞いてみたけど、受付の人も知らないみたいだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460356,
					"content": "それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460357,
					"content": "瑞希、今なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "二人の悪夢を知った今、たしかに紫と白音を治せるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460360,
					"content": "じゃあ、先に治してあげて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "…もうここまで案内してもらったんだ。これ以上、面倒を掛けるわけにはいかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460363,
					"content": "オイラたち、またあの施術を受けたくて楽しみにしてたんだ！瑞希がずっとあいつのことを気にかけてたら、いつになっても受けられないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460364,
					"content": "だから、瑞希が落ち着いて秋沙銭湯の経営を再開できるようになるまで手伝うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460365,
					"content": "…紫と白音の状況からして、迷ってるヒマはなさそうだね。じゃあ、もう一度キミたちにお願いするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460366,
					"content": "でも、ひとつだけ約束してくれる？もし江村一玄斎を見つけても、手を出さず見張るだけにして。まずは人を遣ってあたしに知らせてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460367,
					"content": "キミたちを、危険な目に遭わせたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460368,
					"content": "心配いらないぞ。オイラたち、これまでたくさん敵を倒してきたからな。江村一玄斎なんて、敵じゃないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460369,
					"content": "パイモン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460370,
					"content": "わ、わかったよ。必ず知らせるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460371,
					"content": "うん。それじゃ行動に移ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460372,
					"content": "瑞希の不安をやわらげるために、あんな大口叩いたんだよな？でも、見つからなかったらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460373,
					"content": "あの二人からも…これ以上はなにも聞き出せそうにないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460374,
					"content": "彼らに聞いたところで意味はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "神子？あっ、思い出したぞ。オイラたちが昨日ここに来れたのも、あいつがサラッと場所を言ってくれたからだったよな。たしかに色々知ってるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460377,
					"content": "善は急げだ、さっそく鳴神大社に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460375,
					"content": "でも神子なら知ってるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "#江村一玄斎は{M#俺}{F#私}が探す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "紫と白音を治せる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
