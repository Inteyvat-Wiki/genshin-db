			"dialogs": [
				{
					"id": 120460201,
					"content": "瑞希～！予約しに来たんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460202,
					"content": "あぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120460203,
					"content": "しんど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "柴葉紫"
				},
				{
					"id": 120460204,
					"content": "えっと、どうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460205,
					"content": "それが朝起きてから、この様子で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 120460206,
					"content": "…深刻な消化不良だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460207,
					"content": "えっ？もしかしてゆうべ、悪夢を食べすぎたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460208,
					"content": "そのようなことは…昨日、施術を受けたのは旅人さんとパイモンさんを除いて、あと二人しかいませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "藍川丞"
				},
				{
					"id": 120460209,
					"content": "ってことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460210,
					"content": "うん、あの二人の悪夢に問題があるんだと思う。夢喰い獏の消化に影響を与える要素は、悪夢の数と強さにあるんだけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460211,
					"content": "これほど強烈な悪夢を普通の人が持ってるわけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460212,
					"content": "うぷっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120460213,
					"content": "早く消化させないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460214,
					"content": "どうしたらいいんだ？オイラたちも手伝うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460215,
					"content": "白音と紫の消化を助けるには、あの二人を見つけて、悪夢の原因を突き止める必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460216,
					"content": "キミたちは昨日、彼らと話したんだよね？どこにいるか心あたりは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120460217,
					"content": "えっと…そういえば、もう一度江村一玄斎の指導を受けるって言ってたぞ。今日も同じ場所にいるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460218,
					"content": "案内して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夢見月瑞希"
				}
			]
		},
		{
