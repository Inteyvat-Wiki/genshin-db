						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "神子のやつ、いつもはここにいるはずだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460402,
					"content": "童たちよ、おみくじでも引きに来たのか？或いは、友を訪ねに来たんじゃろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460403,
					"content": "うわっ！いつの間に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460404,
					"content": "また会ったね、「宮司様」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "その言い方、妾の旧友に少し似ておるな…？前置きは不要じゃ、その様子からして急用じゃろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460406,
					"content": "ある人について聞きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "昨日、あれだけ分かりやすく手がかりを教えたというのに、まだ見つかっておらんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460409,
					"content": "やっぱり、あれってわざとだったんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460410,
					"content": "…それはさておき。助けを求めに来たからには、まずは事情を説明してくれてもよいのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460411,
					"content": "実はオイラたち、昨日教えてもらった場所に行ったんだけど、あいつの尻尾を掴めなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460412,
					"content": "もうあそこには姿を見せないと思う。世間から身を隠して修行してるって聞いたけど、どこを探せばいいのかさっぱりで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460413,
					"content": "はぁ…昨日の場所を突き止めるだけでも骨が折れたというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460414,
					"content": "あっ、でもオイラたちも新しい情報を手に入れたぞ。江村一玄斎は、瑞希がむかし施術したやつみたいだ。たしか名前は…江村中弥って言ったっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460415,
					"content": "なに？あやつが…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460416,
					"content": "知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460417,
					"content": "八重堂が読者からお便りを募集したのは、同じ趣味を持つ仲間たちと愉しく語らうためじゃった…それをあやつは急に現れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460418,
					"content": "「悩みを広めるやつ」と「悩みを取っ払う専門家」が、同一人物じゃと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460419,
					"content": "これまでの調査からして、間違いないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460420,
					"content": "良かろう。その者を探したいなら、この場所に行ってみるとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460421,
					"content": "こんな場所に…ここって、ほんとに人が住めるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460422,
					"content": "以前、あやつは小説を数十冊、八重堂に注文したことがあってな。その時の住所がここじゃった。じゃが、着払いを指定されたがゆえに——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460423,
					"content": "倉庫側はイタズラを疑い、この注文を断ったのじゃ。この件をあやつは例の読者お便りで批判してきおった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460424,
					"content": "今にして思えば、かような性格の持ち主じゃからこそ、そういった場所にしか住むことができぬのかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460425,
					"content": "なるほど…やっぱり神子に会いに来て正解だったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460426,
					"content": "旧友の役に立てたら良いが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460427,
					"content": "つまり、瑞希を助けたいってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460428,
					"content": "瑞希が「秋沙銭湯」に多くを費やしてきたのは知っておる。あそこに危機が訪れた今、友として心配するのは当然じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460429,
					"content": "昨日のおまえの様子からして、てっきりケンカを売りに来たのかと思ったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460430,
					"content": "瑞希から聞いておるだろう？妾とは競合相手じゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460431,
					"content": "同窓だった頃より、あやつは妾のことをずっとそう見てきた。妾が鳴神大社の宮司となった今、あやつもきっと秋沙銭湯で自分を証明したいと考えておるのじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460432,
					"content": "今後を左右する経営問題を妾に頼らねばならぬとなれば…旧友の心情を察してやるべきというものじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460433,
					"content": "珍しい気遣いだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "ふふっ、褒め言葉として受け取っておくぞ。あやつは他人を気にかけてばかりじゃ。たまには誰かに気にかけてもらう必要もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460435,
					"content": "神子の都合が悪いのなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "流石じゃな、察しが良い。ほれ、来る時はあんなに慌てておったのに、雑談してる暇なんてあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120460438,
					"content": "そうだった！早く瑞希に知らせようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120460436,
					"content": "#{M#俺}{F#私}が助けるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "江村一玄斎の居場所を知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
