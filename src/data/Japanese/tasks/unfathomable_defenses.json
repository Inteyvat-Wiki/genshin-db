			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鉄骨双刀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "お前らか、世間知らずのネズミどもが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "鉄骨双刀"
				},
				{
					"id": 400840402,
					"content": "ずいぶん大口を叩くんだな！なんでそう思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840403,
					"content": "キノコンに余計な思い入れを抱くとは、なんという弱さ——滑稽にすぎる！これは最強のテイマー、ハニヤー様の理念に背くものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "鉄骨双刀"
				},
				{
					"id": 400840404,
					"content": "最強のテイマー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840405,
					"content": "#ハニヤーの考えは{M#俺}{F#私}たちが正す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "無駄な妄想を！軟弱な者など、ハニヤー様と対戦する資格はない！お前らはここで脱落するのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鉄骨双刀"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008406",
							"2"
						],
						"stepId": 4008406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "旅人、パイモン！私、勝ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840602,
					"content": "よかったな、レイラ！参戦の目標を無事に達成じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840603,
					"content": "おめでとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "あなたたちも、あの連戦連勝の「鉄骨双刀」を倒したって？…でも、何だか、嬉しくなさそうだね…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840605,
					"content": "なんというか…相手が薄情なやつでさ、おかしいことばかり言うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840606,
					"content": "レイラに対戦中の出来事を話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "そうだったんだ…何だかちょっと…可哀想なテイマーだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840608,
					"content": "可哀想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "うん。だってその人はハニヤーさんのことを知らずに、朦朧とした印象で彼女を推測し、真似してたんでしょう。ハニヤーさんがこのことを知れば、きっと同じように悩むと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840610,
					"content": "それにそのテイマーは、厳しい考えで自分が損をしただけじゃないでしょう。他の選手の精神まで影響を与えてしまったんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840611,
					"content": "うん、おまえの考え方ってすごくいいよな！みんながおまえと同じなら、大会はもっと和んでて楽しい雰囲気だっただろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840612,
					"content": "私の目標がそこまで高くないからってだけかも…テンテンヨーヨー獣を連れ帰って一緒に暮らせるなら、私は満足なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840613,
					"content": "さて、次は私たちの勝負だね。勝敗なんてどうでもいいから、友好的に楽しくバトルしよう。友達同士の磨き合いだと思ってくれればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840614,
					"content": "うん、そうしよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "よし！テンテンヨーヨー獣とポコポコビーニー、どっちがすごいか、見ものだぜ！勝ったほうは負けた方に奢りだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840616,
					"content": "楽しそうな約束じゃが、妾は何か重要な会話を見逃したかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840617,
					"content": "神子！やっと会えたぞ！この間はなにも言わずに去ったから、オイラたちはまだ手がか…コホンッ、相談したいことがあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840618,
					"content": "妾も悩んでおったぞ。遊び気分で参戦したはよいが、準決勝まで入ってしもうた。仕方なく、時間を作って左右加たちの取材に付き合っておったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840619,
					"content": "汝らについては心配せずとも、きっと仲の良い対戦ができよう。こっちは少し真面目に対応せねばのう…何せ相手は、その偏執的なやつじゃから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840620,
					"content": "確かに…まさか、八重お姉さんがハニヤーさんと対戦することになるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840621,
					"content": "ポジティブに考えようぜ。もしかしたら、神子がハニヤーを倒してくれる可能性もあるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400840622,
					"content": "そしたら直接ハニヤーを説得はできなくなるけど…神子がここで負けるのも嫌だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008408,
