					"八重神子",
					"ハニヤー",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841001,
					"content": "あれ…対戦がもう終わったのか？この重い空気…神子が勝ったか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841002,
					"content": "おや、汝らの対戦も終わったか？結構時間がかかったところを見ると、接戦じゃったんじゃろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841003
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841003,
					"content": "へへっ、その気楽そうな口ぶりじゃ、きっと楽勝だったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841004,
					"content": "うむ、確かに何の懸念もない対戦じゃったぞ。妾と「百雷遮羅」はたったいくつかのワザで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841005
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841005,
					"content": "ハニヤーに負けたのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841006
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841006,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841007,
					"content": "その散漫な態度…私をからかってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841008
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841008,
					"content": "ふふっ、滅相もないぞ、ハニヤー。何せ、汝の意志は非常に強い…ある種を破滅させようとするほどじゃ。汝のような相手をからかうわけにはいかぬのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841009
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841009,
					"content": "じゃが、この道を貫こうとするなら、途中で見た景色が想像しておったものと違うことに気付くじゃろう。その時、その執念はどうなるじゃろうな？ふふっ、楽しみにしておるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841010
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841010,
					"content": "余計なお世話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841011
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841011,
					"content": "ほう？早くも逃走とは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841012
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841012,
					"content": "対戦に負けたのは八重お姉さんだけど、よりショックを受けたのはハニヤーさんだったってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841013
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841013,
					"content": "それが、ますます面白い展開になってきたんじゃ。対戦が開始してすぐ、百雷遮羅が炎1を傷つけてしまってのう…ハニヤーは明らかに焦ったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841014
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841014,
					"content": "妾はただ、あやつが自らを欺いておるという事実を口にしただけじゃったんじゃが…心理的な防衛線はあっという間に崩れて、意外に脆いもんじゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841015,
						400841016
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841015,
					"content": "自分を欺く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				},
				{
					"id": 400841017,
					"content": "もしかして、ハニヤーは自分で言ってるほど冷たいヤツじゃなかったのか？実は、あいつも炎1のことを心配してて、神子の前でそれがバレた…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841018,
					"content": "その通りじゃ。今はあやつの心に入る絶好の機会じゃ。そしてその心を変えられるのは、童たちだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841019
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841019,
					"content": "でも、ハニヤーはもう遠くまで行ったし、どこを探せばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841020,
					"content": "あやつは今、きっと疑念の最中じゃろう。今まで冷静沈着だった己が、一体何の影響を受けて動揺したのか、とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841021
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841021,
					"content": "その答えは汝ら三人にかかっておる。あやつの行く場所を、汝らは知っておるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841022,
						400841023
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841022,
					"content": "#{M#俺}{F#私}、パイモン、レイラ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841024,
					"content": "私が旅人とパイモンに初めて会った場所、かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841025
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841025,
					"content": "よく考えたら、ハニヤーの顔色が悪くなったのは、レイラがキノコンを日常生活に連れ戻り、重要な仲間にするって言った時だったよな…レイラの直感、当たってるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841026
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841026,
					"content": "早く追いかけよう！ハニヤーとちゃんと話そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841027
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841027,
					"content": "レイラちゃんは残るがよかろう。ハニヤーを助けたい気持ちは分かるが、あやつは汝が対処できるタイプの人間ではない。ここは童たちに任せるのがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841028
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841028,
					"content": "確かに…私が要らないことを言ってハニヤーさんを刺激したら、かえって悪いことになるかも。それに体力不足で速さについていけずに、半分くらい行ったところで倒れそうになるかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841029
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841029,
					"content": "まだ行かぬか、童？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841030,
						400841031
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841030,
					"content": "これが今まで集めてきたもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841032,
					"content": "ほう、思った以上に収穫があったようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841033
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841033,
					"content": "では妾も汝に、「幸運」の祝福を与えよう。今度顔を合わせた時には、また汝らに妾の見解を話すとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841031,
					"content": "確認と分析をお願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841023,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841016,
					"content": "心理的な防衛線？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				}
			]
		},
		{
			"id": 4008412,
			"completionStepIds": [
				4008411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008411",
							"2"
						],
						"stepId": 4008411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841201,
					"content": "ん？どうしてここに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841202
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841202,
					"content": "オイラたち、炎1の痕跡を辿ってここまで来たんだ。おまえのさっきの様子が心配でさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841203,
					"content": "えっ、待てよ…おまえ、炎1を慰めてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841204,
					"content": "皮肉よね…炎1がキノコンじゃなくて、普通の動物だったらよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841205
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841205,
					"content": "さあ、次会う時は決戦よ。何か言いたいことがあるなら、私を倒してから言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841206,
						400841207
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841206,
					"content": "#{M#君}{F#あなた}の考えを知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				},
				{
					"id": 400841208,
					"content": "その言い方、狐の女が予測していたのとまったく同じだわ…君たちは確かに単純で、善良ね。だけど、物事を理想的に考えがち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841209
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841209,
					"content": "私が言ったところで君たちは理解できないと思うから、これを見てちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841210
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841210,
					"content": "これは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841212,
					"content": "これは私のご先祖様が残したノートよ。当時、彼らは雨林でキノコンの攻撃を受け、多くの重傷者が出た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841213
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841213,
					"content": "この事件は、当時は特筆する価値がないとみられたのね…何の記録にも残っていなかったわ。けれど、私の家族は私が子供の頃からそれを繰り返して読み、キノコンの脅威について教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841214
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841214,
					"content": "そんなことがあったとはな…どうりでキノコンを敵視するわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841215,
						400841216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841215,
					"content": "#確かに{M#君}{F#あなた}の生い立ちは知らなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841217,
					"content": "そうだぞ、こんな過去があるなら、なおさらこの大会の意図が分かるはずだろ？「叡智宝珠」は人をキノコンの共存を可能にするんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841218,
					"content": "「叡智宝珠」がキノコンを穏やかにさせる、なんて…そんな単純な話じゃないわ。前にも村にやって来た学者がいて、似たようなアイテムで実験をしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841219
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841219,
					"content": "でも結局、全員失敗して逃げたわ。今の「叡智宝珠」だって、キノコンの凶暴な本性を一時的に抑えることしかできないんだもの。このアイテムを取り除けば、キノコンは十分脅威になり得る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841220
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841220,
					"content": "それに、宝珠の「理性増加」によってキノコンの元素力は異常に活発になり、周囲の環境に影響を及ぼしてしまう。強い体を持たない者が宝珠を使うと、すぐに具合が悪くなってしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841221
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841221,
					"content": "元素力の異常…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841222
					]
				},
				{
					"id": 400841222,
					"content": "まさか、最近のレイラの咳も、「叡智宝珠」のせいなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841223,
					"content": "言わなくたって分かるはずよ。カウトリヤは学術に夢中な気狂いで、自分の影響力を拡大することだけを考えながらキノコンの大会を宣伝している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841224
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841224,
					"content": "あのエルヒンゲンも風向きに応じて舵を取るやつよ。カウトリヤの研究成果を見込んで、大金をかけてこの大会を宣伝し、人々のキノコンに対する警戒心を緩めようとしてるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841225
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841225,
					"content": "ともかく私は、彼らを信じないわ。狂暴なキノコンが人と共存することも信じない。でも、引退した無名な傭兵である私の声を聞いてくれる人なんて誰一人としていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841226
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841226,
					"content": "私はただ、ルールに従って勝ち残り、欲しい結末を手に入れることしかできないの。絶対に彼らを止めて見せるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841227
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841227,
					"content": "最初は君たちも手伝ってくれるんじゃないかと期待したけど、どうやら私が甘かったようね。——君たちがどう思おうと、私がどう思われようと、私は君たちを倒して、踏み越えて見せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841228
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841228,
					"content": "ハニヤー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841229
					]
				},
				{
					"id": 400841229,
					"content": "このノートは私の過去のようなものよ。煮るなり焼くなり好きにして。どうせ決戦の日、私はすべてのキノコンをこの世から取り除くことを宣言するわ…炎1もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841230
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841230,
					"content": "私の過去とさよならするの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 400841216,
					"content": "だけど今の状況は違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841207,
					"content": "#{M#君}{F#あなた}の偏見を取り除きたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				}
			]
		},
