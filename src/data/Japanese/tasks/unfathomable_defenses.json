				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841301,
					"content": "うぅ、結局負けちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841302
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841302,
					"content": "でも…あなたも仲間たちも今までで一番良かったよ、テンテンヨーヨー獣！私、嬉しいよ…本当に満足！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841303
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841303,
					"content": "あなたたちも、ありがとう！私とテンテンヨーヨー獣のバトルは完璧な終わりを迎えた。もしあなた以外の人に倒されてたら、ちょっと悔いが残っちゃってたかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841304
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400841304,
					"content": "レイラとテンテンヨーヨー獣も強かったぞ！もうちょっとで圧倒されるとこだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841305,
					"content": "勝敗なんか気にせず、キノコンたちの才能を思いきり発揮させて対戦する…この感じ、最高に気持ちよかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841306,
					"content": "これが大会のあるべき姿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841307
					]
				},
				{
					"id": 400841307,
					"content": "そうだな…他の対戦でも今みたいに、他のことなんか気にせずすんだらよかったのにな。さて、神子はまだハニヤーと戦ってるんだよな？オイラ、すごく心配だ！早く様子を見に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008414,
			"completionStepIds": [
				4008414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008414",
							"2"
						],
						"stepId": 4008414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鉄骨双刀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841401,
					"content": "バ、バカな！ありえない…まさか、訓練が緩すぎたのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841402
					],
					"speakerTitle": "鉄骨双刀"
				},
				{
					"id": 400841402,
					"content": "うぅ…倒せたけど、なんだか喜べないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008415,
			"completionStepIds": [
				4008415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008415",
							"2"
						],
						"stepId": 4008415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841501,
					"content": "ついに説得できなかったか。これで、対戦でハニヤーを倒す一択しかなくなったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841502,
						400841503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841502,
					"content": "少なくとも、本心は聴けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				},
				{
					"id": 400841504,
					"content": "ハニヤーは、前にもキノコンによる災害を阻止しようとした学者がいるって言ってたよな？ノートに詳細があるみたいだから、もう一度読んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841506,
					"content": "これって、ハニヤーの先祖が集めた…学者たちの研究記録だったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841507,
					"content": "うぅ、この部分は難しいな。字が汚いし、専用用語もたくさんある…ぜんぜん読める気がしないぞ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841508,
					"content": "あっ、待てよ。見覚えのある単語みたいだ…えっと、そうだ！ドリーから貰った資料にあったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841509,
						400841510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841509,
					"content": "ノートと資料には関係があるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841511,
					"content": "おう！資料の断片とノートの内容を慎重に照らし合わせて、解読できるか試してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841512,
					"content": "捕獲装置？枯れポーション？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841513,
						400841514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841513,
					"content": "捕獲装置はキノコンを穏やかにする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841515,
					"content": "なるほど…ハニヤーの先祖を襲ったキノコンたちは、そのポーションのせいで理性を失ってたんだな…そして、学者たちが捕獲装置を作ったのは、狂暴化したキノコンを捕まえるためだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841516,
					"content": "それに今の「フラワーゼリー」は「枯れポーション」の進化版で、「叡智宝珠」だってカウトリヤの発明じゃなかったってこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841517,
					"content": "つまり、カウトリヤは捕獲装置をもとに、ちょっといじっただけなんだな！あの嘘つきめ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841518,
						400841519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841518,
					"content": "嘘つきめ！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841520,
					"content": "でも、カウトリヤはなんのために、これほど「叡智宝珠」の宣伝に力を入れてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841521,
						400841522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841521,
					"content": "先人の実験を終わらせたいのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841523,
					"content": "それなら、早くエルヒンゲンに、カウトリヤのやつに資金援助をしちゃダメだって伝えないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841524,
					"content": "ハニヤーに関しては…当時先祖を襲ったキノコンが薬で刺激されてたことを、まったく知らないみたいだぞ。そりゃ、キノコンが許せないって思うはずだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841525,
					"content": "心配するな、ポコポコビーニー。おまえはフラワーゼリーのせいで狂暴化したりしないって信じてるぞ！「叡智宝珠」を止めた後も、おまえはいい子でいられたんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841526,
					"content": "あれ？オイラの言うこと、分かるようになってないか？おまえ、ますます賢くなったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841527,
						400841528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841527,
					"content": "待って、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841529,
					"content": "えっ？いつからだ！全然気づかなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841530,
					"content": "ってことは、今のポコポコビーニーは、本当にオイラたちと共存できてるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841531,
						400841532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841531,
					"content": "一緒にいた時間がこの子に影響した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841533,
					"content": "へへっ、だから言ったじゃないか！オイラはハニヤーの「キノコンがまた暴走する」って推測には絶対納得しないぞ！キノコンの中にはいいキノコンもいる。ポコポコビーニーみたいに人の感情がわかるキノコンだっているんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841534,
					"content": "まああいつも、中には一理あることを言ってたけどな…「叡智宝珠」は万能じゃないって。その欠点がある限り、キノコンの仲間はずっと普通の人のそばにはいられないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841535,
					"content": "これからも、ポコポコビーニーと一緒に旅ができると思ってたのに…なんとかならないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841536,
						400841537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841536,
					"content": "仲間たちと適切な距離を保ちながら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841538,
					"content": "うん…残念だけど、今はそうするしかないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841539,
					"content": "決戦までまだ時間があるし、教令院にカウトリヤのことを報告するか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841540,
						400841541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841540,
					"content": "カウトリヤの勢力がまだ把握できていない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841542,
					"content": "確かに…これほどの大イベントをやるからには、きっと長い間計画を練ってきたんだろうしな。もしあいつのやったことを暴こうとしてるのがバレたら、あいつに警戒されちゃうよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841543,
					"content": "まあとにかく、決戦の日は全力を出すぞ！まずはハニヤーを倒して意地を張らないようにさせるんだ。それからエルヒンゲンを説得して、一緒にカウトリヤの計画を暴く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400841541,
					"content": "軽率な行動は控えておこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841537,
					"content": "一緒に宝珠の改良方法を探していこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841532,
					"content": "阿吽の呼吸ができた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841528,
					"content": "「叡智宝珠」が動いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841522,
					"content": "自分の能力を証明したいのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841519,
					"content": "まあ、意外でもないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841514,
					"content": "枯れポーションはキノコンを狂暴化させる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841510,
					"content": "両方の情報を合わせてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841503,
					"content": "少なくとも、ノートを手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				}
			]
		}
	]
}