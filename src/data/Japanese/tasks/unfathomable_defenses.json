				"points": []
			},
			"dialogs": [
				{
					"id": 400840801,
					"content": "少し緊張するけど、わくわくするね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840802
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840802,
					"content": "みんな、固くならないで。テンテンヨーヨー獣が率いてきたあなたたちチームは沢山の困難を乗り越えてきたんだもん、実力は十分だよ！さあ、全力を出してね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840803
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400840803,
					"content": "それじゃ行くぞ！レイラ、テンテンヨーヨー獣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
