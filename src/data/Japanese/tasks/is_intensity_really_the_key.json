			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "だ、誰か手を貸してくれないか！人が気を失ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780202,
					"content": "#ま、まずいぞ！マスターが気絶したみたいだ！オイラたちも早く助けに行こうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "マスターは熱さにやられて気を失っただけで、特に大きな問題はないようだ。旅人たちの助けもあって、気絶したマスターはユルフに連れて行かれた…\\nどうやらマスター自身の「烈力」も、さらなる高みを目指す必要がありそうだ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
