			"dialogs": [
				{
					"id": 751780101,
					"content": "こんにちは～！えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780102,
					"content": "#なんと圧倒的な「烈力」だ…！さすがは伝説の{NICKNAME}とパイモンだな！遠路はるばるやって来たってことは、「豊穣の邦最強」の称号を競いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780103,
					"content": "「豊穣の邦最強」？ここって普通の「戦士の挑戦」じゃないのか？あっちには人がたくさん並んでるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780104,
					"content": "はははっ、あいつらがお前たちと肩を並べるなんて無理な話さ。「最強」の名を手にするには、「最強」を倒すしかない。凡人には到底届かない領域なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780105,
					"content": "だから、いい時に来たな！…と言いたいところだが、残念…実に残念だ。お前たちは間が悪かった。今のマスターにこの世の雑事に構っている暇はない。しばらくの間は直接会える機会はないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780106,
					"content": "「最強」の人は、どこにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "ほう——？お前、自ら乗り込んで勝負を挑むつもりか？いい度胸じゃないか！よし、マスターの居場所を教えてやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780110,
					"content": "あの険しい修行の道に沿って進めば、「烈力の水」に満ちた山地が見えてくるはずだ。そこへ行けばもしかしたら、「最強」の姿を目にすることができるやもしれん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780107,
					"content": "そっか、じゃあここで待つよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "確かに、確かにな。「烈力」と「烈力」はいずれ引き寄せ合い、「最強」と「最強」は必ず相まみえる。待つという選択もまた、一つの道だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルーシー"
				}
			]
		},
		{
			"id": 7517802,
