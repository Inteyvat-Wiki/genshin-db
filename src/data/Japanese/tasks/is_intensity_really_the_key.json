			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "異邦の勇士よ、どうだ？「最強」への道は見つけられたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780502,
					"content": "「最強」の人の居場所について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "山を登っていけば、「烈力の水」に満ちた山地が見えてくるはずだ。そこへ行けばもしかしたら、「最強」の姿を目にすることができるやもしれん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルーシー"
				},
				{
					"id": 751780503,
					"content": "まだ探してる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "確かに、確かにそうだ！",
					"roleType": "TALK_ROLE_NPC",
