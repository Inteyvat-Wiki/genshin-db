					"content": "不思議な燃素を使ってみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "範囲が広すぎる！どう考えてもむりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781009,
					"content": "なにか、もっと現実的な方法はないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781010,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#ちょっとまて！{REALNAME[ID(2)|SHOWHOST(true)]}、勝手に動き回るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781005,
					"content": "火山には溶岩がたくさんあるはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "おお！そういうことか！ちびに穴を掘ってもらって、火山の熔岩で温泉を温めるってことだな？なかなかいい方法だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781007,
					"content": "キュウ！キュウ！キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#いや、熔岩なんか使ったら大惨事になるぞ！もっと真面目に考えろよ！ほら、{REALNAME[ID(2)|SHOWHOST(true)]}も信じちゃってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "パイモン"
				}
			]
