			"dialogs": [
				{
					"id": 751780701,
					"content": "「冷たい」！なんて「冷たさ」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "マハン"
				},
				{
					"id": 751780702,
					"content": "えっ、えっ！？冷たい？どこが冷たいって？おまえ、温泉に浸かってるのにか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780703,
					"content": "足りん！まだまだ足りん！こんな冷たさで「最強」と呼べるものか！「豊穣の邦」の、いや、「ナタ最強」になるには、こんな「烈力」ではまだまだ足りん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "マハン"
				},
				{
					"id": 751780704,
					"content": "え？また座ったぞ？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780705,
					"content": "「烈力」が足りないんだと思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "「烈力」ってなんなんだよ？オイラ、おまえの言ってること全然分かんないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780709,
					"content": "#おお、よかった！君たちがあの有名な冒険者{NICKNAME}とパイモンだね、助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780710,
					"content": "な、なんだ？なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780711,
					"content": "ここにいる彼は、マスターが言う「最強」の道を目指して、温泉修行に没頭しているそうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780712,
					"content": "しゅ、修行？温泉の中でか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780713,
					"content": "そ、そうなんだよ…僕も正直信じがたいけど…でも、これが『烈泉道』っていう武道書で、マスターが学んだものらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780714,
					"content": "本にはこう書かれてるそうだよ。「烈泉の道」に従って修行をすれば、いつか自分の「烈力」だけで<color=#00E1FFFF>冷たい水を沸騰</color>させられるようになる、ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780715,
					"content": "それだけじゃなくて、この本にはたくさんの強者のことも記録されてるんだ。ある人は一晩で山を素手で貫き、またある人は石を素手で握って宝石に変えたって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780716,
					"content": "#そんなすごい武術があるなんてびっくりだぞ！もし{NICKNAME}もそれを習得できたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780717,
					"content": "わー、小説に出てきそうな設定。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "君たちはこの本を馬鹿馬鹿しいと思うかもしれない。でも、これはマスターが「謎煙の主」の本の山から掘り出した、貴重な一冊なんだ。そして何よりも、マスター本人がこれを深く信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780720,
					"content": "マスターは烈泉の道を実践するために、わざとこの特別な温泉…いや、「冷泉」を選んだんだ。極限の「冷泉」を、純粋な「烈力」の力だけで、極上の「温泉」に変えるために！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780721,
					"content": "ほ、ほんとだ。温泉なのに水が全然暖かくないぞ！でも…こんな冷たい水にずっと浸かってたら、どんなにすごい人でも病気になっちゃうだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780722,
					"content": "はぁ…病気にならないとしてもダメなんだ！「戦士の挑戦」はもう何日も止まったままで、みんなマスターの帰りを待ってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780723,
					"content": "でもマスターは、途中で投げ出すのは「烈力」のある者のすることじゃないって言っててさ。だから、泉の水が沸騰するまでは、彼も絶対にここを離れないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780724,
					"content": "それに、近くにいる管理人も温泉が冷えた原因を突き止められなくてさ…はぁ、こんな時、熟練の冒険者がいてくれたらな…ちゃんと報酬も用意してるんだよ。ほら、こんなにたくさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780725,
					"content": "「流泉の衆」に言えば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "（お、おい…すぐに断るなって！まずは報酬がどれくらいあるか確認しようぜ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780728,
					"content": "コホン、安心しろって、ちゃんと温泉を温めてみせるから！それに、マスターが冷えた温泉のせいで体調を崩すのを、見過ごすわけにはいかないだろ？優秀な冒険者ってのは、困ってる人を助けるもんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780729,
					"content": "よかった！じゃあ、君たちにお願いするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "ユルフ"
				},
				{
					"id": 751780730,
					"content": "よしきた！ここでオイラたちからの朗報を待ってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751780726,
					"content": "お金で買収するつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "まさか、本気で信じたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "立ったらもっと寒くなるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "そういうことだったのか、だから震えてるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "パイモン"
				}
			]
		},
