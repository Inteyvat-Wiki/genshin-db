			"dialogs": [
				{
					"id": 751780901,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}、こんにちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780902,
					"content": "元気がないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "えっと…さっきと比べても、まだちょっと冷たい気がする…こんなに大変なことになっちゃって、帰ったらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780905,
					"content": "大丈夫、もう少し待ってみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "うん、分かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 751780903,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#うん…気をつけて、{NICKNAME}{M#お兄さん}{F#お姉さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
