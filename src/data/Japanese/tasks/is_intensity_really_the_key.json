			"dialogs": [
				{
					"id": 751781401,
					"content": "あれ、コホラ仔竜？どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781402,
					"content": "——キオキオ！やっぱりここにいたんだ…！も、もしきみたちが出てこなかったら、わ、わたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781403,
					"content": "ケガとかしちゃったらどうするの？もう、次からは勝手にいなくならないでよ、うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781404,
					"content": "な、泣くなよ。ほら、仔竜も元気だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781405,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "うん、だ、大丈夫…。わ、わたしはリナシャ。「流泉の衆」で…普段はコホラ仔竜のお世話をしてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781407,
					"content": "コホラ仔竜のお世話？すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781408,
					"content": "そ、そんな、わたしなんて全然だよ…わたしがパイモンお姉ちゃんみたいにできてたら、あの子たちも迷子にならなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781409,
					"content": "もしかしたらみんな噴出口で遊んでるんじゃないかって思ってたんだけど、やっぱりそうだったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781410,
					"content": "温泉が冷えたのは、コホラ仔竜たちが燃素の噴出口を塞いでたからだったんだな。どうりで管理人でも気付けないわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781411,
					"content": "パ、パイモンお姉ちゃん！実は…まだ二匹の竜の仲間が見つかってないんだ。その子たちもきっと、あの燃素噴出口の中に隠れて遊んでるんだと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781412,
					"content": "大丈夫、安心してくれ！水温を調節するついでに、コホラ仔竜たちも連れ戻してくるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781413,
					"content": "うん、パイモンお姉ちゃんがいるなら安心だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 751781414,
					"content": "へへっ、当然だろ？オイラは伝説の冒険者だからな！こんなの朝飯前だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751781415,
