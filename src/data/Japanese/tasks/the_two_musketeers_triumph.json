				]
			},
			"dialogs": [
				{
					"id": 401360301,
					"content": "発表いたします。第一回千霊映影祭「フリーナ」賞を獲得したのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "会場の司会者"
				},
				{
					"id": 401360302,
					"content": "『二銃士』です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "会場の司会者"
				},
				{
					"id": 401360303,
					"content": "オイラたちだ！ほんとにオイラたちが獲ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360304,
					"content": "おめでとうございます、グザヴィエさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360305,
					"content": "まさか、お…俺が…皆さん、本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360306,
					"content": "フフン、フォンテーヌのエンタメ界を見る僕の目に狂いはなかったことが証明されたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360307,
					"content": "それでは『二銃士』のプロデューサー·グザヴィエさん、ステージへどうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "会場の司会者"
				},
				{
					"id": 401360308,
					"content": "ありがとうございます…我々の作品を認めてくださったことに、心から感謝いたします。この場で、特にお礼を申し上げたいのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360309,
					"content": "時が経つのは早いものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360310,
					"content": "ええ。シュヴルーズから銃の持ち方を教わったのが、ほんの二、三日前のことのように思えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360311,
					"content": "またフォンテーヌに来てくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360312,
					"content": "もちろんです。私はこの街が好きですもの。新しいものが見きれないほどありますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360313,
					"content": "シュヴルーズも稲妻に来てくださいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360314,
					"content": "…今までそんなこと考えもしなかった。だが、これから考えてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360315,
					"content": "貴方が訪れるのをお待ちしております。その時はぜひうちに遊びにいらしてください。お茶菓子をご馳走いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360316,
					"content": "ああ、また連絡を取り合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360317,
					"content": "君の望み通りってわけね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360318,
					"content": "貴方もそろそろ稲妻に戻るべきでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360319,
					"content": "「小倉屋」のほうはどうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360320,
					"content": "万事順調ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360321,
					"content": "じゃ、彼女によろしく伝えといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360322,
					"content": "承知しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360323,
					"content": "島に雷雨が降らなくなったそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360324,
					"content": "争いもなくなりました。平和で安定していますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 401360325,
					"content": "それはよかった。生地を干すのにぴったりなお天気になったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360326,
					"content": "——名前を挙げたすべての方々に、もう一度感謝の意を。あなたたちがこの舞台まで連れてきてくれました。これは皆さんと一緒に作った映影です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360327,
					"content": "またメンバー全員の賛同を得て、正式にグザヴィエ撮影クルーを「ガンズフィルムカンパニー」と名づけました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360328,
					"content": "おお、ああやって高らかに叫ぶとかっこいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360329,
					"content": "では続いて「ガンズフィルムカンパニー」の皆さま、ステージでの記念撮影にお集まりください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "会場の司会者"
				},
				{
					"id": 401360330,
					"content": "おっ！記念撮影の時間まで用意してあるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360331,
					"content": "フリーナ監督、あなたこそがこのトロフィーを掲げるのに相応しいお方だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360332,
					"content": "え？い、いやだよ…そんな恥ずかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360333,
					"content": "監督ほどふさわしい人はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360334,
					"content": "ええ、適役です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 401360335,
					"content": "フリーナしかいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "あきらめなさいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "千織"
				},
				{
					"id": 401360337,
					"content": "準備はよろしいですか？3、2、1…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "会場の司会者"
				},
				{
					"id": 401360338,
					"content": "ガンズフィルムカンパニー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
