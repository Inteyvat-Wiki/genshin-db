				]
			},
			"dialogs": [
				{
					"id": 401360201,
					"content": "…移送任務完了。この三人をよろしく頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360202,
					"content": "この後、用があるようだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360203,
					"content": "ああ、急いでパーティーに向かわなくてはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360204,
					"content": "こいつはまた珍しい。新しい趣味にでもハマったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360205,
					"content": "今回はちょっと特別というだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360206,
					"content": "シュヴルーズ、公爵～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360207,
					"content": "祭りってのはいいもんだ。ここですら賑やかになるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360208,
					"content": "それが千霊祭というものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360209,
					"content": "ああ。看護師長なんか栄養満点なスペシャルミルクセーキを用意してたぞ…ヘルシーさもまたスペシャルなやつをな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360210,
					"content": "仕事の話をしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360211,
					"content": "もう話は終わった。リオセスリさんへの「挨拶」も済ませた。…だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360212,
					"content": "はっきりと返事をした覚えはないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360213,
					"content": "でもノーとも言わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360214,
					"content": "そうだ、いい考えがある。彼らに一人一部ずつ新聞を配ろう。たとえば、一面に二十年前の出来事が載ってる新聞とかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360215,
					"content": "そしたら一人、不運に見舞われるやつが出るだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360216,
					"content": "そして二人は、英雄扱いされることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360217,
					"content": "英雄といえば、あんたら二人は俺に何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "リオセスリ"
				},
				{
					"id": 401360218,
					"content": "ええと、オイラたちが来たのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360219,
					"content": "私をパーティーに誘いに来たんだろう？今日が何の日か忘れてはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 401360220,
					"content": "へへっ、じゃあ急いで行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360221,
					"content": "公爵、またな！よい千霊祭を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360222,
					"content": "ああ、あんたらもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リオセスリ"
				}
			]
		},
