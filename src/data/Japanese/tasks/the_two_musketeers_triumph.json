			"dialogs": [
				{
					"id": 401360101,
					"content": "それからしばらくして…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "グザヴィエ、なんだか久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360104,
					"content": "ああ、二人とも！いやもう、あれから目の回るような忙しさだったからな。編集が終わったら、次は宣伝と上映の仕事が始まって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360105,
					"content": "今日は授賞式だろ？オイラたちの映影は「フリーナ」賞をもらえるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360106,
					"content": "僕は90%はいけると思っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360107,
					"content": "フリーナ！もう会場に来てたのか。一番乗りだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360108,
					"content": "他のみんなももうすぐ来るさ。そうだ、グザヴィエ。賞で思い出したけど、キミが僕らのチームに名前をつけるべきじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360109,
					"content": "え？まだ受賞できるかも分からないんですよ…そ、そんなタヌキの皮算用みたいなことはとても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360110,
					"content": "いいや、目を見開いて、歌劇場から出てくる人たちの反応を見てごらんよ！みんな「良かった」と言ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360111,
					"content": "自分でも分かってるくせに。歌劇場のスタッフがきっとキミに会いに来て、映影の上映回数を増やしたいって言ってくるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360112,
					"content": "今回の興行収入の利益で、ちゃんとした映影会社だって作れるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360113,
					"content": "でも、これは自分一人の功績じゃありません。善良な紳士淑女の皆さんの血と汗の結晶があったからです。一人で名前を決めるなんてことできませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360114,
					"content": "とにかく、よく考えておきなよ。みんなも賛成してくれると思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401360115,
					"content": "分かりました…でもその前に…旅人にパイモン、悪いがメロピデ要塞に行ってきてもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360116,
					"content": "え？まだ授賞式が残ってるのに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360117,
					"content": "二人に我らがヒロイン、シュヴルーズさんのお迎えを頼みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360118,
					"content": "最近、ずっと彼女の姿を見かけてなくてな…今日の授賞式を知らせる機会がなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360119,
					"content": "だが今日、銃殺事件の犯人を特巡隊隊長が自らメロピデ要塞に移送するらしい。そう新聞に書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 401360120,
					"content": "へえ、そうだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360121,
					"content": "お安いご用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "よし！グザヴィエはここで待っててくれ。がんばっていい名前を考えとけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401360123,
					"content": "了解だ。じゃあよろしく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
