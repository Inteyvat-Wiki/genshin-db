			"dialogs": [
				{
					"id": 721180501,
					"content": "最近ファデュイの行動がますます怪しくなってきた。核心のあるエリアに集まりつつあるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180502,
					"content": "あいつらが何か良からぬことを企んでなければいいが…または、俺たちの手に負えないようなことをしないでほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
