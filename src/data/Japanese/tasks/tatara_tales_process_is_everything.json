					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "よし、見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180402,
					"content": "運がいい、「御影炉心」の状況は安定してるし、周囲の「祟り神」のエネルギーも濃くはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180403,
					"content": "この濃度なら、俺の装置も耐えられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180404,
					"content": "「祟り神」のエネルギーを全て浄化するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "この装置にそれができるのなら、俺はとっくに特許を出してる。今は一部エリアのエネルギーを下げることしかできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180406,
					"content": "だが、「御影炉心」が停止し、自動的に再起動のプログラムが立ち上がらないのは、濃度の高い「祟り神」のエネルギーに包まれてるからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180407,
					"content": "「祟り神」の濃度が最も高いところを探し出し浄化すれば、核心が再び動き出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180408,
					"content": "そうすれば、「御影炉心」も再起動するはずだ。その後は俺たちの不安も消える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180409,
					"content": "これが俺の考えた計画の全容だ。ただその前に、少し準備をする必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
