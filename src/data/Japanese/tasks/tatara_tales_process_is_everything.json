			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "やっと！完成した。製作に必要な仕様をまだ覚えていてよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180102,
					"content": "これから「祟り神」を浄化しに行けばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "すぐにでもこの件を終わらせたいが、くれぐれも「祟り神」には気を付けてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180104,
					"content": "それと一部の材料がどうしても見つからなかったから、代わりの材料を使ってる。だから、この装置をあまり過信しすぎると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180105,
					"content": "えっと…「一部状況では、期待通りの運用を実現できない可能性がある」とでも言うべきか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180106,
					"content": "普通の使用なら問題ないと思うが、この装置の状態だと、想定外の状況には耐えられないだろう。もし激しい揺れがあれば、部品が飛び出すかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180107,
					"content": "だから、この装置を中に運ぶ前に少し準備をする必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180108,
					"content": "まずは「御影炉心」の付近で、データを記録してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180109,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "では頼んだ。俺はここで待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180111,
					"content": "そんな慎重にならないといけないのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "もちろん。これでも多くの手順を省略してるんだ。もしヴロワさんの手順通りにやっていたら、少なくともあと一週間はかかってたかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721180113,
					"content": "とにかく、今回の一件は特殊だ、慎重に行こう。俺は特別検討チームの代表として…今より臨機応変に行動する権限を俺たちに与える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
