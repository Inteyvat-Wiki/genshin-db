			"dialogs": [
				{
					"id": 205160101,
					"content": "あいつ、またどこに行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160102,
					"content": "アナまた遊びに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "お前もまたかよみたいな顔するよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160104,
					"content": "最近のアナは言うことを聞かなくてな、隙があるとすぐ外に行っちゃうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160105,
					"content": "まだ病気が完治してないというのに、お前も一緒に探してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160106,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160115,
					"content": "そうだ、風神像を見てみたいって、アナに言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160116,
					"content": "確か、シスターグレイスもよくそこにいるはずだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160117,
					"content": "何か見てるかもしれないから、彼女に聞いてみるといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160108,
					"content": "ちゃんと探した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "探したよ、城外にも行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160110,
					"content": "見つからないから頼んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160111,
					"content": "アナの好きな食べ物は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "ああ、アナはな…おい！妹は猫じゃないって言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160113,
					"content": "それにあいつの好物はたくさんあるんだ、数え切れないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205160114,
					"content": "さあ、早く探してきてくれ、ここで待ってる。一周探して、俺はもうぐたぐただよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "アンソニー"
				}
			]
		},
