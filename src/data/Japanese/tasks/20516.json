						205160503
					]
				},
				{
					"id": 205160503,
					"content": "わっ、ビックリした！どこから来たの？どうしてここにいるって分かったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 205160504,
					"content": "ここなら誰も分からないと思ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 205160505,
					"content": "あっ、そうだ、シスターグレイスが教えたんだね、シスターずっとここにいるもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 205160506,
					"content": "昔私が飲んでた薬も、シスターが送ってくれたものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 205160507,
					"content": "シスターグレイスはいい人だね、でも私はずっとモンドにいたくないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 205160508,
					"content": "分かったよ、お兄ちゃんが私を探してるんでしょ。すぐ戻るよ、心配はかけないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
