			"dialogs": [
				{
					"id": 205160401,
					"content": "あの子、ずっと病気だったはずよね？どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160402,
					"content": "女の子を見かけたり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "ふう…アナのことでしょ？上を見てみなさい、風神像の手の上にいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160404,
					"content": "彼女がこっちに走ってきた時、あの子は病気のはずなのにいつ元気になったのかって気になったんだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160405,
					"content": "ボーっとしてたら、もう風神像の手の上に登ったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160406,
					"content": "…怒ってない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "怒る？…ええ、少しはね。でも、あの子は今まで病魔に苦しめられてたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160408,
					"content": "こうして元気な姿が見れて、怒りたくても怒れないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 205160409,
					"content": "でも、上は風が強いから、風邪を引くと大変…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
