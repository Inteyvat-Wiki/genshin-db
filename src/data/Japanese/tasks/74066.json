			"dialogs": [
				{
					"id": 740660201,
					"content": "——「交渉の芸術」…？う～ん、タイトルを見た感じつまらなさそうだな！オイラは読まな…って、あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660202,
					"content": "見ろよ、中に紙が一枚挟まってるぞ？えーと…「受付窓口で特別許可食堂の満足度アンケート調査に参加すると、特別許可券をもらえるチャンス…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660203,
					"content": "「特別許可券」…おお！これ見ろよ？特別許可券がもらえるだって！思わぬ収穫ってやつだな。さっそく行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
