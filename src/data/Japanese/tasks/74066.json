			"dialogs": [
				{
					"id": 740660901,
					"content": "（よし準備できたぞ！かかってこい！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660902,
					"content": "第一問、特別許可食堂のメニューの価格について、今の低い水準で維持するのは合理的だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660903,
					"content": "（えっと——これはどう答えればいいんだ？どれどれ…あった！この「万能の方程式」を試してみるか。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660904,
					"content": "（この本によると、「心から同意する。ただ…」っていうフレーズは、どんな状況でも使えるみたいだぞ。たとえ相手がアビスの魔術師でも、うまく交流できるらしいぜ。なんだかすごそうだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660905,
					"content": "合理的だと思う。パイモンは気に入ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "えっ…？あんなまずいもん、タダでもいらないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660907,
					"content": "もし、いつか食費が底をついたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "うーん…そう言われるとやっぱり…い、いや！あれを食べるくらいなら、オイラは腹ペコのほうがマシだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660918,
					"content": "コホンッ、ちょっといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660919,
					"content": "ん？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660920,
					"content": "ルールでは、このアンケートは即答してもらうようお願いしてるの。次の質問に行くわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660921,
					"content": "わ、わかった…ルールだったら仕方ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660922,
					"content": "第二問、食事時間に特別許可食堂から支給される食事の量は適切だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660923,
					"content": "買いはするけど…でも本当にまずいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660924,
					"content": "はい。テイワットのミントより多い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "だったら、オイラはミントのほうがまだいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660926,
					"content": "そう？じゃあ、今日はミントサラダで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "いやだ！オイラどっちも食べたくないからな！うぅ…鳥肉のスイートフラワー漬け焼きが恋しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660928,
					"content": "ねえ…アンケートに戻っていいかしら？「はい」と記入しておくわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660935,
					"content": "はぁ…疲れた。じゃあ、次の質問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660936,
					"content": "第三問の前にもう一度言っておくけど、このアンケートは即答でお願いしてるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660937,
					"content": "じゃあ第三問、食事がランダムで出てくる今のシステムに面白味はある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660938,
					"content": "ちょっとは味にこだわってほしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660939,
					"content": "心から同意するわ。ただ…ランダムで出される食事は、これから何を食べるか全然分からないというサプライズを味わえるじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660940,
					"content": "そっか…そう言われてみると、確かに面白い気がしてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660941,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "ん？どうしたんだよ？モングラーヌさんの言うこともわかるだろ？納得しないほうが難しいと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660943,
					"content": "コホンッ、即答でお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660944,
					"content": "面白い。おみくじを含めて面白い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "そうだな！毎回おみくじがあるから、くじを引いてる感じがしてとてもよかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660946,
					"content": "「頑張って働けば、成功が待っている！」ってすごく素敵だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660947,
					"content": "ガイドの仕事って確かに大変だもんね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660957,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660958,
					"content": "第四問、特別許可食堂での嗜好品の販売は合理的だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660959,
					"content": "（えっ？あれ？なんで急にしゃべりが早くなったんだ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660960,
					"content": "（「声が大きい者が勝つ」？「誘導質問術」？いや、どっちも違うな。じゃあ…やっぱり「万能の方程式」を使うか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660961,
					"content": "（いや…これらの質問は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "コホンッ、考えすぎずに、会話も控えてちょうだい。さっきも言ったように、直感で即答してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660964,
					"content": "合理的だと思う。なぜなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "はい、回答ありがとう。じゃあ、最後の質問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660968,
					"content": "無視された？オイラたちの答えはどうでもいいっていうのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660969,
					"content": "ここまでの質問の回答をもとに答えてちょうだい。特別許可食堂の現状に対する満足度は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660970,
					"content": "ここまでの質問ってなんだっけ？あんまりよく覚えてないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660971,
					"content": "大丈夫よ。だったら「満足」と答えればいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660972,
					"content": "わかった…でも、なんだか違和感があるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660973,
					"content": "ちなみに…「不満」と答えた場合、特別許可券はもらえないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660974,
					"content": "そんなのあんまりだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660975,
					"content": "では、そちらの方は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660976,
					"content": "うぅ、無視すんなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660977,
					"content": "満足してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "はい、ご協力ありがとう。皆さんの支援は私たちが進歩するための原動力よ。さっ、こちらにサインして特別許可券を受け取って。そちらの知能型飛行マシナリーもサインしたら受け取っていいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660983,
					"content": "えっ？オイラの分もあるのか！？参加してないのにいいのかよ？——っておい、オイラはパイモンだ！飛行マシナリーなんかじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660984,
					"content": "ええ。私たちの原則はすべての意見を尊重すること。だから全員もらえ…全員と全マシナリーがもらえるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660985,
					"content": "だから、オイラは飛行マシナリーじゃなくて、パイモンだって言ってるだろ！無視すんなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660986,
					"content": "分かったわ…貴重な時間を節約するために、アンケートの記入を代行させてもらうわね。心配しないで、特別許可券の配布枚数に差は生じないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660987,
					"content": "答えはすべて「満足」でいいわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660988,
					"content": "おう！特別許可券！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660989,
					"content": "じゃあ、ここにサインだけお願い。あとは私に任せればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660990,
					"content": "やったぞ！特別許可券がもらえて、手間も省けるなんてな。それじゃ、よろしくな。モングラーヌさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660991,
					"content": "ええ、ご協力ありがとう。はい、特別許可券をどうぞ。また次のアンケートもお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660992,
					"content": "特別許可券を受け取った後、あなたとパイモンはモングラーヌと別れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#なあ、{NICKNAME}…今思い返してみるとさ、モングラーヌさんってオイラたちの答えを全然気にしてなかったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660994,
					"content": "アンケートの質問の内容に原因がある思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "うーん、そうだよな。あのアンケートってやっぱり変だったぞ。それに…モングラーヌさんもすごい疲れてたみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660996,
					"content": "「交渉の芸術」は失敗に終わったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "なにが「交渉の芸術」だよ。こんな本、やっぱり全然役に立たないじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660998,
					"content": "うん、本のせいだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "だろ！おまえも本に問題があると思ったんだな？でもまあ、特別許可券は貰えたし、今回はこれでいっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740661000,
					"content": "ううん、パイモンのせい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "ええっ？でも、オイラは本に書いてあった通りにやったんだぞ。ほら、「だから私はとにかく大声で…」って。やっぱり本のせいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740661002,
					"content": "心から同意する。ただ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "おい、ごまかすなよ！なにが「交渉の芸術」だよ。この本、やっぱり全然役に立たないじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660978,
					"content": "完全に不満。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "いやいや、やっぱ「満足」って答えとこうぜ。特別許可券のためにさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660980,
					"content": "「満足」ね？分かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660981,
					"content": "満足してるけど、ただ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "合理的じゃない。どうせなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "心から同意する。ただ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "（これは…「誘導質問術」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "面白くない。食べたい物を食べられないし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "…いっつも変な味ばっかだしな。どこにサプライズがあるのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "パイモン"
				},
				{
