			"dialogs": [
				{
					"id": 740660301,
					"content": "受付窓口は…おっ、ここだな！さっそく運試しといこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660302,
					"content": "モングラーヌさん、こんにちは～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660304,
					"content": "（うわっ——気難しそうなやつだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660305,
					"content": "（「交渉の芸術」を使ってみたら？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "（そっか、そうだったな！この本がこんなところで役立つとは思わなかったぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660307,
					"content": "どれどれ…あった！「機先を制して相手を気迫で圧倒できれば…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660308,
					"content": "これだな！相手を気迫で圧倒する！なるほど、要するに大声で話せばいいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660309,
					"content": "おーい！モングラーヌさん、こんにちは——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660310,
					"content": "…聞こえてるわ。ご用件は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660311,
					"content": "お？本当にうまくいったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660312,
					"content": "へへっ、モングラーヌさん、オイラたち満足度アンケート調査を受けに来たんだ！あっ、オイラはこいつの付き添いだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660313,
					"content": "#（心配するな、{NICKNAME}。この本があるんだ。こっそり読んで教えてやるぞ！とにかく…ええと、オイラの指示どおりにすれば大丈夫だ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660314,
					"content": "また本に挟んであるお知らせを見て来た人ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660315,
					"content": "おう！そうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740660316,
					"content": "一体、何枚挟んだのかしら…実は…はぁ、なんでもないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660317,
					"content": "コホンッ、少し待ってね…まずはルールを説明するから。——今回のアンケートは全部で五問。それぞれ直感ですぐ答えてちょうだい。考えずに即答でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "モングラーヌ"
				},
				{
					"id": 740660318,
					"content": "分かった？準備ができたら始めるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モングラーヌ"
				}
			]
		},
