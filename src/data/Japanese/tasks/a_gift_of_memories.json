			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}！早く早く！こっちに来てくれ！すっごくいいものを見せてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000102,
					"content": "じゃじゃーん！見ろよ、このいろんな物が売られてる市場で、苦労して手に入れたお宝だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000103,
					"content": "この写真機…なんだか味があるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "これを売ってた不思議な店主によると、この写真機はフォンテーヌの超有名な写真家——ピエール・ルブランが数十年前に使ってたものらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000107,
					"content": "これで撮った写真はどれも大人気で、よく『スチームバード新聞』の一面を飾ってたみたいだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000108,
					"content": "#{NICKNAME}もこのすっごい写真機を使えば、世に名を残せるぐらいの名作を撮れるかもしれないだろ！もしかしたら、高値で売れる可能性だってあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000109,
					"content": "この写真機…かなり高かったでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "えへへっ、大丈夫だぞ！オイラ、「へそくり」をそれなりに貯めてるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000111,
					"content": "#{NICKNAME}が喜んでくれるなら、これしきのモラ、どうってことないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000116,
					"content": "ありがとう、パイモン。気に入ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "えへへ！気に入ってくれてよかったぜ！ちょうど新しい土地に来たことだし、面白いものをいっぱい見れるはずだよな。それを片っ端から撮ってやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000119,
					"content": "新しいアルバムもちゃんと用意してあるぞ。気が利くだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000120,
					"content": "よーし、一緒に面白い場所を探しに行こうぜ！出発しんこーう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000117,
					"content": "これでいい写真を撮れるよう頑張るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "悪徳商人に騙されたりしてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "安心しろ！詐欺られないように、すっごく頼もしい機械技師に見てもらったからな。写真家のルブランが使ってたもので間違いないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000114,
					"content": "しかも、その機械技師が写真機を解体した時、内部に小さくルブランのイニシャルが彫ってあったんだ。動かぬ証拠だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000115,
					"content": "ふふん！それに、オイラはおまえのガイドとして頼りになる存在だからな。やるときはやるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765000104,
					"content": "パイモン、骨董品でも売ろうとしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "違うぞ！これはおまえのために用意したサプライズプレゼントだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}