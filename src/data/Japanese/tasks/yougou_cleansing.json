			"dialogs": [
				{
					"id": 721050401,
					"content": "封印は解かれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050402
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050402,
					"content": "それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050403,
					"content": "すごく深い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050404
					]
				},
				{
					"id": 721050404,
					"content": "では、失礼ながらあなたには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050405
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050405,
					"content": "ここに飛び込んでいただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050406,
						721050407
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050406,
					"content": "それはちょっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050409
					]
				},
				{
					"id": 721050409,
					"content": "この下なんかすごく怖そうで、飛び込んだら大変なことになりそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050410,
					"content": "ご心配なく、神櫻は穢れを多く蓄積していますが、「大祓」を行う人の気配を感じ取ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050411
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050411,
					"content": "最後の瘴気を祓うため、彼女はあなたを安全に着地させることでしょう。私が保証します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050412
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050412,
					"content": "本当にだいじょうぶか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050413,
					"content": "私を信じてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050414
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050414,
					"content": "下に行ったあとは、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050415,
					"content": "一言で言えば、あなたの武勇を見せつけるだけで大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050416
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050416,
					"content": "蓄積した穢れは影向山の最深部で特大の「腫瘍」を形成しており、今は神櫻の根によって抑制されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050417
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050417,
					"content": "機会を見計らい、瘴気の腫瘍を攻撃してください。そしてそれが攻撃を受ければ、全力で抗うことでしょう。あなたの行動を妨げるために妖物を生む可能性もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050418
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050418,
					"content": "その間、以前解除した5つの封印のように、周囲の装置を使用し、神櫻の根の抑制を強化する必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050419
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050419,
					"content": "そうすれば神櫻もあなたに協力し、攻撃の機会を作ってくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050420
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050420,
					"content": "聞いた感じ、なんだか怖そうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050421,
						721050422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050421,
					"content": "もっと厄介なのを相手にしたことある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050423,
					"content": "あなたの実力を信じています。では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050424
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050424,
					"content": "一緒に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050425
					]
				},
				{
					"id": 721050425,
					"content": "戦いが終わり次第、下であなたと合流し、「大祓」の締め作業を行います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050426
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050426,
					"content": "本当に申し訳ございません。以前言ったように…体の状況のせいで、これを行うことが私にはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050427
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050427,
					"content": "ご理解ください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050428
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050428,
					"content": "それは仕方ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050429,
					"content": "では…準備は整いましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050430,
						721050432
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050430,
					"content": "準備できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050431
					]
				},
				{
					"id": 721050431,
					"content": "はい、前へ進み、「神櫻大祓」の最後の一手をお願いします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050434,
					"content": "浄化について、何かお聞きしたいことがありましたら、いつでも私にお聞きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050435
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050435,
					"content": "これが…最後の最後です。どうかお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050432,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050433
					]
				},
				{
					"id": 721050433,
					"content": "そうですか…何はともあれ、ここの穢れを封じていた結界は解かれました。できれば、早急に解決をお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050422,
					"content": "怖い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050407,
					"content": "パ、パイモンなら飛べるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050408
					]
				},
				{
					"id": 721050408,
					"content": "おい！なに言ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050409
					],
					"speakerTitle": "パイモン"
				}
			]
		},
