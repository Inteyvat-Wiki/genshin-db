						721050302
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050302,
					"content": "では、準備は整いましたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050303
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050303,
					"content": "待て！その前に、一つ質問させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050304,
					"content": "どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050305
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050305,
					"content": "この前、時が来たら、すべてを明らかにするって言ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050306,
					"content": "ええ、確かに。ですができれば、「神櫻大祓」が終わったあとにしてもよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050307
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050307,
					"content": "今も神櫻が苦痛を訴えているのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050308
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050308,
					"content": "ただ確かに、失礼ですよね…お二人にはこれほどまで力をお貸しいただいたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050309
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050309,
					"content": "本当に申し訳ございません。どうかご理解を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050310,
						721050311
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050310,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				},
				{
					"id": 721050312,
					"content": "ふん、仕方ないな。約束はきちんと守れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050313,
					"content": "ふふ、もちろんです。ご理解いただきありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050314
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050314,
					"content": "では、結界を解きます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050315
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050315,
					"content": "「…東には鯨淵、西には燼海。南には炎光、北には弱水…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050316
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050316,
					"content": "「…千の枝をもって、災厄を祓わん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050311,
					"content": "信じる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				}
			]
		},
