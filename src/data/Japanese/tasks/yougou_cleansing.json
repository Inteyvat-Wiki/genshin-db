			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050202
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050202,
					"content": "お面の巫女お姉さん、戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050203,
					"content": "お疲れ様です。雷櫻の根と枝が、お二人の功績を私に伝えてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050204
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050204,
					"content": "大変恐れ多いのですが、お二人に伝えなければならないことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050205
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050205,
					"content": "どうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050206
					]
				},
				{
					"id": 721050206,
					"content": "なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050207,
					"content": "紺田村で最初の鎮め物を取った時、私はあなたを「運命の人」と呼びました。しかしその時、私はあなたの徳と勇気を完全に信用したわけではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050208
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050208,
					"content": "「大祓」が進むにつれ、あなたは私の浅はかさと愚かさを証明するだけでなく、私の期待をはるかに超えていきました。そのため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050209
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050209,
					"content": "残念としか言えません。もし当時、「狐斎宮」のそばに、あなたのような方がいたら、あるいは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050210
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050210,
					"content": "あるいは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050211
					]
				},
				{
					"id": 721050211,
					"content": "いえ、なんでもありません。余計なことを言ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050212
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050212,
					"content": "これでもう終わったな。それで、報酬は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050213,
						721050215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050213,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050214
					]
				},
				{
					"id": 721050214,
					"content": "その前に、まだ一つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050217,
					"content": "「神櫻大祓」には、まだ最後にやることがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050218
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050218,
					"content": "まだあるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050219,
					"content": "この地を守り、穢れを吸収する代価として、瘴気が根や枝に蓄積されるのです。あなたは結界を解き、穢れが成す妖物を撃退しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050220
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050220,
					"content": "すべての雷櫻は影向山の「神櫻」の側枝であり、あの5つの木の根はその中でも大きなものとなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050221
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050221,
					"content": "それらが吸収した穢れは、実は影向山深くにある神櫻にまで影響しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050222
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050222,
					"content": "つまり、肝心なのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050223
					]
				},
				{
					"id": 721050223,
					"content": "はい。「神櫻大祓」で一番肝心なのがこの最後の一手、神櫻の結界を解き、神櫻の根に蓄積した瘴気を祓うことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050224
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050224,
					"content": "えっ！神櫻って鳴神大社にあるんだろ？あそこで妖魔と戦ったら、混乱が起きるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050225,
					"content": "ふふ、それは考えすぎですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050226
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050226,
					"content": "神櫻の根は影向山の奥深くに封印されています。大社とは相当離れているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050227
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050227,
					"content": "本当にだいじょうぶか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050228,
					"content": "ご心配なく。私を信じてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050229
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050229,
					"content": "お面の巫女お姉さんがそこまで言うなら、仕方ないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050230,
					"content": "ありがとうございます。では、さっそく行動に移りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050215,
					"content": "まだ終わってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050216
					]
				},
				{
					"id": 721050216,
					"content": "はい。さすが5ヶ所の結界を軽々解いた方ですね。雲を突き抜ける月明かりのように、物事を見透かす目をお持ちのようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				}
			]
		},
