					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050101,
					"content": "「えっ！」…って、あれ？オイラてっきり、花散里さんが背後に現れるのかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050102,
					"content": "そういえば、これが5つ目の木の根で最後だったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050103,
					"content": "オイラ、最後の1ヶ所が終わったら、前と同じように「シュパッ！」って感じで花散里さんが現れて、お宝をくれるのかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050104,
					"content": "「シュパッ！」って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050105
					]
				},
				{
					"id": 721050105,
					"content": "だから、「シュパッ！」だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050106,
					"content": "でもまあ、これで「神櫻大祓」も終わったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050107,
						721050108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050107,
					"content": "楽勝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				},
				{
					"id": 721050109,
					"content": "たしかにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050110,
					"content": "もう鳴神島をぜんぶ渡り歩いたと思ったら、最後は海底にまで行くなんてな！すっごく疲れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050111,
						721050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050111,
					"content": "疲れたのはこっちだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050112
					]
				},
				{
					"id": 721050112,
					"content": "おい！オイラは全力でおまえのことを応援してたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050114,
					"content": "この前、お面の巫女お姉さんが言ってたよな。5つの木の根を浄化したら、彼女に会いに行けって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050115,
					"content": "#ふふん、きっと報酬をくれるんだな。{NICKNAME}、彼女に会いに紺田村の井戸の下にある結界へ行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050116,
					"content": "正直、狸のごはんじゃないならなんでもいいけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050113,
					"content": "まあまあかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050114
					]
				},
				{
					"id": 721050108,
					"content": "色々と経験できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				}
			]
		},
		{
			"id": 7210502,
