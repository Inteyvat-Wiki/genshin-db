			},
			"dialogs": [
				{
					"id": 721050501,
					"content": "浄化について、何か聞きたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050502,
						721050507,
						721050522
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050502,
					"content": "何をすれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050503
					]
				},
				{
					"id": 721050503,
					"content": "底に到達すれば、根に絡まっている「腫瘍」を見つけることができます。それは穢れが長年蓄積してできた核ですので、それをどうにか消滅させてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050504
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050504,
					"content": "それが攻撃を受ければ、全力で抗うことでしょう。あなたの行動を妨げるために妖物を生むこともあります。しかし、あなたにとっては何も問題ないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050505
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050505,
					"content": "その間、以前解除した5つの封印のように、周囲の装置を使用し、神櫻の根の抑制を強化する必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050506
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050506,
					"content": "そうすれば神櫻もあなたに協力し、攻撃の機会を作ってくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050507,
					"content": "「腫瘍」って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050508
					]
				},
				{
					"id": 721050508,
					"content": "簡単に言えば、土地に蓄積した穢れの集合体です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050509,
						721050512
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050509,
					"content": "ファデュイみたいな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050510
					]
				},
				{
					"id": 721050510,
					"content": "魚人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050511
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050511,
					"content": "「人魚」のことをおっしゃっているのでしたら、私も少しは聞いたことがあります。ですが人魚は穢れではありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050515,
					"content": "何はともあれ、この大地には痛みが、苦痛が、怨念があります。想像はできませんが、もしかすると戦争がいつの日か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050516
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050516,
					"content": "戦争が起きれば、多くの痛み、苦痛、悪念をもたらします。そして、それらは穢れを蓄積し、大地に危害を加え、すべてを悪化させるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050517
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050517,
					"content": "（どうやら知らないみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050518
					]
				},
				{
					"id": 721050518,
					"content": "穢れが蓄積すれば…疫病が蔓延り、悪鬼が出現します…想像するのも恐ろしいことですので、この話はここまでにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050519
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050519,
					"content": "以前聞きましたが、それらの「穢れ」を片付けるために、各地で様々な方法があるようです。例えば、璃月には仙家、方士などがいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050520
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050520,
					"content": "それに対し、雷櫻の根は「払拭」の力で、穢れを吸収します。そしてその一部の穢れが、根を通って影向の底に集まるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050521
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050521,
					"content": "時が経つと、あのような「腫瘍」になります。この腫瘍を片付けることこそ、「神櫻大祓」の目的です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050512,
					"content": "アビス教団みたいな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050513
					]
				},
				{
					"id": 721050513,
					"content": "アビス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050514
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050514,
					"content": "それが何かは分かりませんが、おそらくそれも暗黒の穢れたものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050522,
					"content": "じゃあ、行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050523
					]
				},
				{
					"id": 721050523,
					"content": "はい。浄化について、何かお聞きしたいことがありましたら、いつでも私にお聞きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050524
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050524,
					"content": "これが最後の最後です。どうかお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				}
			]
		},
		{
			"id": 7210506,
			"completionStepIds": [
				7210506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210505",
							"3"
						],
						"stepId": 7210505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210506",
							"2"
						],
						"stepId": 7210506,
						"stateName": "QUEST_STATE_UNFINISHED"
