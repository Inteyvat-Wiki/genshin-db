			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050601,
					"content": "これで、すべてが終わりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050602
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050602,
					"content": "神櫻が背負う苦痛もやっと解消されたことでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050603
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050603,
					"content": "人の子…見事です。あなたはやはり「運命の人」でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050604
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050604,
					"content": "#ふぅ、本当に厄介な戦いだったぜ！オイラが普段鍛えてたおかげだな、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050605,
						721050607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050605,
					"content": "ありがとう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050606
					]
				},
				{
					"id": 721050606,
					"content": "なんだよ、そんな真剣になるなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050608,
					"content": "最初に約束していた報酬は、後ほど用意しておきます。焦らないでくださいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050609
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050609,
					"content": "ちょっと待て！前に約束しただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050610,
					"content": "「神櫻大祓」が終わったら、お面の巫女お姉さんが自分に関することを教えてくれるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050611,
					"content": "ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050612,
						721050613,
						721050614
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050612,
					"content": "同じく知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050615,
					"content": "そうだぞ。じゃないと、オイラたちに申し訳ないと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050617
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050617,
					"content": "分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050618
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050618,
					"content": "今気づいたのですが、まだお二人の名前をお聞きしていませんでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050619
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050619,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050620
					]
				},
				{
					"id": 721050620,
					"content": "オイラはパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050621,
					"content": "#{NICKNAME}様、パイモン様…良い名前ですね。心に銘じておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050622
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050622,
					"content": "えへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050623,
					"content": "以前にも言ったように、私は「狐斎宮」の記憶を引き継いでいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050624
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050624,
					"content": "そこが気になるとこだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050625,
					"content": "「狐斎宮」は元々白辰の血筋で、雷神と同行し、稲妻の民を守っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050626
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050626,
					"content": "ですが最後、私ですら知らない遥か昔の災厄で、「狐斎宮」は鳴神島を守るために、漆黒の災厄と戦って飲み込まれたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050627
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050627,
					"content": "しかし、彼女の結界に守られていた人々は大勢いました。単純に「記憶」を引き継いだ私が言うべきことではないのですが、その記憶については誇りに感じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050628
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050628,
					"content": "花散里は彼女の眷属なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050629
					]
				},
				{
					"id": 721050629,
					"content": "前にも言ってた、「天狐」、「地狐」みたいなものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050630,
					"content": "そういえば、以前たしかに山頂の鳴神大社で似たような仙狐の気配を感じました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050631
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050631,
					"content": "しかし違います。私は彼女の眷属ではありません、むしろ逆とも言えるでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050632
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050632,
					"content": "彼女を飲み込んだ災厄は、最後には断ち切られましたが、彼女の思念や記憶は鳴神島の大地に戻ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050633
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050633,
					"content": "あなたは「神櫻大祓」を行う途中、何体もの「落武者」を斬りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050634
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050634,
					"content": "うぅ…それって、幽霊みたいな武士のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050635,
						721050636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050635,
					"content": "楽勝だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050637,
					"content": "あれらの妖物は穢れが凝集してできたものです。そして、その形態は時代の思念や記憶によって左右されるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050638
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050638,
					"content": "もしできるのなら、誠実に答えていただきたいことがあります。もしかして、今の稲妻は、戦火に包まれているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050639
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050639,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050640
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050640,
					"content": "#（…どうする、{NICKNAME}？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050641,
						721050643
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050641,
					"content": "（正直に言おう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050642
					]
				},
				{
					"id": 721050642,
					"content": "そ、そうみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050644
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050644,
					"content": "そうですか。やはり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050645
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050645,
					"content": "あなたから、雷櫻の根を浄化する時に現れた妖物が「落武者」だと聞いた時、なんとなく気づきました。彼女が自分の信じる道を歩いている限り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050646
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050646,
					"content": "…話は戻りますが、私は…私「花散里」は「狐斎宮」様の記憶が凝集してできた穢れです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050647
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050647,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050648,
						721050649
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050648,
					"content": "うすうす気づいてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050650,
					"content": "以前お二人と共に同行した時に戦いに参加できず、申し訳ございません。私自身が穢れですので、他の穢れた妖物を浄化することはできないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050651
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050651,
					"content": "彼女の記憶は強大なもので、漆黒の災厄でさえ、完全にそれを消滅することはできませんでした。災厄が敗れたあと、それは穢れと化し、大地に流れたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050652
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050652,
					"content": "そして、私が誕生しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050653
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050653,
					"content": "#前に「狐斎宮」のそばに{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}がいたらって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050654
					]
				},
				{
					"id": 721050654,
					"content": "はい。そうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050655
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050655,
					"content": "もし「狐斎宮」のそばにあなたのような方がいれば、彼女は生き残れたのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050656
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050656,
					"content": "もし彼女があなたに会うことができたら、どれほど素晴らしかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050657
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050657,
					"content": "しかし、こう考えざるを得ません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050658
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050658,
					"content": "「もしそうだった場合、私が彼女の記憶を引き継いで生まれることも、あなたに会うこともなかったでしょう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050659
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050659,
					"content": "「追憶のレンズ」で見たのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050660
					]
				},
				{
					"id": 721050660,
					"content": "はい、過去の私です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050661
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050661,
					"content": "始めは、私もどうすればいいか分かりませんでした。しかし記憶が蘇るにつれ、自身の出生を把握し、自分の責務を理解したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050662,
						721050663
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050662,
					"content": "それってつまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050665
					]
				},
				{
					"id": 721050665,
					"content": "私の責務は鳴神島を守り、瘴気を祓い、「神櫻大祓」を行うこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050666
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050666,
					"content": "お面の巫女…花散里さん自身が「穢れ」で、「神櫻大祓」の目的が穢れを消滅することなら、つまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050667
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050667,
					"content": "おまえも消滅しちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050668
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050668,
					"content": "はい…消滅という言葉はいささか過ぎる気はしますが、結論から言って、その通りですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050669
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050669,
					"content": "どうしてこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050670
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050670,
					"content": "ふふ、このことに気づいた時、私も不安を抱きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050671
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050671,
					"content": "ですが、あなたたちに出会い、今の稲妻のことを聞いて、だんだん受け入れていったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050672
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050672,
					"content": "五百蔵が生きていたこと。惟神によって石に封印されましたが、落ち込んでもいなく、「狐斎宮」を恨んでいるわけでもありませんでした…よね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050673
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050673,
					"content": "昔ほどいい生活ではないにしろ、紺田村の紺田、柴門の一族が現在まだ存在すること。大社の稲城弥里も昔は彼女の友達でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050674
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050674,
					"content": "この人たちは、当時災厄が起きた時に彼女が守った人々の末裔なのです。彼らが無事で、血筋を残してきたことを彼女が知れば、きっと誇りに思うでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050675
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050675,
					"content": "しかし…当時「狐斎宮」が柊勘定頭弘嗣に送った法器が壊されたのには、少し動揺しましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050676
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050676,
					"content": "少しって程度じゃなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050677
					]
				},
				{
					"id": 721050677,
					"content": "ふふ、その通りですね。失態でした。いずれにせよ、様々な形で最後はあなたの手に渡り、とても嬉しく思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050678
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050678,
					"content": "…これは「花散里」として気持ちなのか、それとも「狐斎宮」としてなのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050679
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050679,
					"content": "彼女の心意と私の心意は混ざり合っています。以前は、私が彼女にとって消滅すべき対象だったということに、時に悩みを感じておりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050680
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050680,
					"content": "ですが今は…気持ちも楽になった気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050681
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050681,
					"content": "あなたと同行でき、とても嬉しく思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050682
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050682,
					"content": "それどころか、あなたがいたからこそ、ここへ来ることができました。そのおかげで、私は最後の責務を果たせました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050683
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050683,
					"content": "花散里さん、本当に行っちゃうのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050684
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721050684,
					"content": "はい。ありがとうございました、パイモン様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050685
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050685,
					"content": "#では、僭越ながら…{NICKNAME}様、パイモン様、どうか私から一言、言わせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050686
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050686,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050687
					]
				},
				{
					"id": 721050687,
					"content": "「惑わされず、動揺せず、己が信ずる道を歩け。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050688
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050688,
					"content": "「狐斎宮」が最後の別れの時に言ってくれた言葉です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050689
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050689,
					"content": "「白辰の血筋」を持っていると主張する資格が私にはありません。ですが、もし「狐斎宮」様がここにいたら、きっとあなたを祝福してくれると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050690
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050690,
					"content": "彼女の言葉が——いえ、私の言葉が、多かれ少なかれ未来のあなたのために、嘘と悪を払いのけることを祈っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050691
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050691,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050692
					]
				},
				{
					"id": 721050692,
					"content": "ふふ、どういたしまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050693
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050693,
					"content": "では、引き換えに…最後のわがままを言わせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050694
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050694,
					"content": "「狐斎宮」は短歌を好んでいました。私は彼女の記憶を引き継ぎ、彼女の知る千百十一首もの短歌を知っています。ですが、彼女のような素晴らしい趣は持ち合わせていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050695
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050695,
					"content": "しかしなぜでしょう、一つこの状況にぴったりなのを思い出したのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050696
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050696,
					"content": "「別れの日、朝露のよう、いつかまた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050697,
						721050698
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050697,
					"content": "花散里さん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050699,
					"content": "#ありがとうございました。さようなら、お二人に会えて嬉しかったです…{NICKNAME}様、パイモン様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050700
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050700,
					"content": "「千の枝をもって、災厄を祓わん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050701
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050701,
					"content": "「…ここに、浄化の終を宣言せん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050698,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050663,
					"content": "そこまでして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050664
					]
				},
				{
					"id": 721050664,
					"content": "必要なことでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050665
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050649,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050643,
					"content": "確かにそうみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050644
					]
				},
				{
					"id": 721050636,
					"content": "すごく怖かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050613,
					"content": "すごく大変だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050614,
					"content": "色々な目に遭った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050607,
					"content": "うん。ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050608
					]
				}
			]
		}
	]
}