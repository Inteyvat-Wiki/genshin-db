	"talks": [
		{
			"id": 1203201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203201",
							"2"
						],
						"stepId": 1203201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "この先、稲妻には数多くの試練が待ち構えているでしょう。ですが、私にはその準備がもうできています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320102,
					"content": "「試練」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "鎖国令を解除すれば、必然的に様々なものに影響します。利益のみで害がないとは言い切れません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320104,
					"content": "例えばすでに予測できるものが、他国による稲妻の商業への影響です。これは私が次に取り組むべきものとなるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320105,
					"content": "影は本当に真面目じゃのう。妾がいま考えておるのは、鳴神大社で入場券を販売するか否かだというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320106,
					"content": "あなたという人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320107,
					"content": "神の眼差しについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "眞の眼差しは常に稲妻の民にありました。それが彼女の責任であると、昔の私はそう考えていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320109,
					"content": "しかし今になってやっと、その眼差しに称賛と期待が込められていたのが分かりました。責任とは別に、彼女はそれを喜びとしていたのです。彼女は人々を愛していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320110,
					"content": "過去の人々は眼差しを向けるに値した。それは現在と未来の人々においても同じことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320111,
					"content": "ええ、私はもう彼らの情熱と夢を無視することはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320112,
					"content": "何百年も続いた戦いについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "正直言って、あれは終わりの見えない苦痛でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320114,
					"content": "果てしない戦いを前にした時、常に精神を研ぎ澄ませる必要があります。少しでも気を緩めれば、将軍の刀が私の命を奪っていたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320115,
					"content": "今までの経験と見聞がなかったら…そして刀に力がこもっていなかったら…敗れていたのは私だったはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320116,
					"content": "これについては、あなたのおかげでもありますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320117,
					"content": "神櫻が負った傷について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "安心してください。もちろん忘れてはいませんよ。天領奉行と社奉行には私から伝えておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320119,
					"content": "ただ魔物の脅威以外にも、神櫻から他のものが漏れ出ないかが心配です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320120,
					"content": "それはまだはっきりとは言えぬ。記憶以外にも、地脈には多くのものが入っておるからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320121,
					"content": "あなたも当事者なんですから、怠けないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320122,
					"content": "八重神子が影を自分の神だって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "汝よ、当人の前でふざけたデマを言うでない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320124,
					"content": "この世には、そう軽々しく何度も口にしてはならぬ言葉がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320125,
					"content": "妾を裏切ることがどんな代価を払うことになるのか、そんなもの知りたくはないじゃろう？妾の言ったあれは汝と妾だけの秘密じゃ、よいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320126,
					"content": "何の話をしているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120320127,
					"content": "なんでもない、油揚げが食べたくなっただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320128,
					"content": "他に聞きたいことは特にない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}