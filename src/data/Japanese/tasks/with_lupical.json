			"dialogs": [
				{
					"id": 100080101,
					"content": "レザー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080102,
					"content": "懐かしい匂い…お前たちか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080103,
					"content": "最近、どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080104,
					"content": "へへっ、うまくいってるぜ。そうだ、レザー。オイラたちが来たら、王狼がいなくなっちゃったけど、なにを話してたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080105,
					"content": "狩りをする。オレは…領主を説得してた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080106,
					"content": "狩り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080107,
					"content": "（もしかして、これがレザーの「課題」なのか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080108,
					"content": "もしかして狼たちは、また食べるものがなくなったから、狩りを始めるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080109,
					"content": "トラバサミをもらおう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "違う…今回の狩り…腹減ってるからじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080112,
					"content": "今回は…敵を殺すため。黒狼の群れ…縄張りを占領…変な臭い、どんどん広がる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080113,
					"content": "森を浄化…敵を狩る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080114,
					"content": "それで、王狼はオッケーしてくれたのか？あの時、王狼はこう言ってたろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080115,
					"content": "えっと、どんな感じだっけ…コホンッ、「レザー、おまえは討伐に加わるな。これは狼の問題だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080117,
					"content": "あ、悪気はなかったんだ…ごめんな、レザー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080118,
					"content": "大丈夫。オレ、「ルピカ」と一緒。それに、師匠…領主と話す方法、教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080119,
					"content": "リサさんが教えてくれた…領主と話す方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080120,
					"content": "あっ、わかったぞ！説得する方法のことだな。じゃあ、さっきもう王狼を説得したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080121,
					"content": "うん、話すの、すごく疲れる。でも…うまくいった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080122,
					"content": "あの頑固なデカ狼を説得するなんて、すごいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080123,
					"content": "黒狼の群れは、世界の敵。師匠が言ってた…これは、狼の問題じゃない。世界の問題。師匠、正しい。領主も…認めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080124,
					"content": "でも…だから、狼たちは関わらない。これは…「オレ」と「黒狼の群れ」との戦い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080125,
					"content": "へへっ、じゃあオイラたちも手伝おうぜ！あの変な獣域ハウンドたち、前から気に入らなかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080126,
					"content": "あ…ありがとう。お前たちが助けてくれたら…きっとうまくいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080127,
					"content": "でも、どうやって狩りを始めればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080128,
					"content": "オレたち…獲物を罠に追い込むみたいに、黒狼の群れ、ここに追い込む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080129,
					"content": "領主が…閉じ込めてくれる。オレたちで…片付ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080130,
					"content": "…準備できたら、話かけてくれ。そしたら、狩り、始める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080401,
					"content": "今すぐ行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "イノシシは十分大きくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
