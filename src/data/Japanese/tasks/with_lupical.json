							-403.607
						],
						"pointId": 5
					},
					{
						"sceneId": 20301,
						"position": [
							2107.804,
							254.285,
							-402.662
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "危なかった！狼たちが手伝ってくれて助かったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080302,
					"content": "ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080303,
					"content": "獣域ハウンドを、たくさん足止めしてくれた…敵を追い払ってくれてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080304,
					"content": "でも…これ、狼の問題じゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080305,
					"content": "へへっ、レザーが「ルピカ」を助けたいのと同じで、「ルピカ」もおまえを危険な目に遭わせたくないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080306,
					"content": "北風の王狼に「これは『ルピカ』の問題じゃない、世界の問題だ！」って言って、駆けつけてくれたのかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080307,
					"content": "うん、「ルピカ」は…「ルピカ」だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080308,
					"content": "オレは人間の「ルピカ」、狼じゃなくてもいい…「ルピカ」を助けられるなら、それでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 100080309,
					"content": "その通りだぞ、レザー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100080310,
					"content": "王狼が同意してくれたのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
