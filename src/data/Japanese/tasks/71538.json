			},
			"dialogs": [
				{
					"id": 715380101,
					"content": "旅人、海灯祭を祝して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380102,
					"content": "えっと…なにか事件でも起きたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "無理やり休暇を与えられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380105,
					"content": "無理やり…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "執律庭の規定によれば、年度の終わりまでには全員が休暇を全て消費しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380107,
					"content": "でも、今年度の休暇日集計後、私が一日も休暇を取っていないことに気づかれた。それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380108,
					"content": "特巡隊って大変なんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "いや、特巡隊には交代休暇制度がある。だが私は特巡隊の隊長として、常駐しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380111,
					"content": "それに、対応すべき緊急事態もあり、いつの間にか…休暇のことを忘れていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380112,
					"content": "もともと休暇など、私にとってはどうでもいいことだ。いっそ休みなどなくていいと言ったら、急に全員が騒ぎ出して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380113,
					"content": "これはハッキリ明文化された規則なのだから、特巡隊が規則を破るわけにはいかないなどと言って、絶対休みを取るよう言われたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380114,
					"content": "特巡隊によく来る共律官までが横やりを入れてきて、船のチケットまで取られてしまった。璃月はちょうど海灯祭の時期だから、休暇を過ごすならここがいいと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380115,
					"content": "とはいえ、璃月は確かにいい場所だ。翹英荘から帰ってきたばかりだが、あそこの茶葉で作ったお菓子はどれも美味しかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380116,
					"content": "お菓子を大量に買ったから、うちの者たちにも食べてもらいたい。璃月の風習に従って、祝灯状も贈り物に添えたいのだが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380117,
					"content": "こういうのは得意ではなくてな。どうやってもおかしな感じになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380118,
					"content": "旅人はどう作ればいいか、分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 715380119,
					"content": "アドバイスしてあげる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "特巡隊の人ってみんなそんな感じなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "仕事しにきたように見えないけど…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
