				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "実験データからすると、今回の発明品も無事完成だ。ご協力ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120102,
					"content": "ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120103,
					"content": "ほら、上手くいくって言ったでしょ。フェルロイス先輩はこの分野の天才なんだから、リモートで砲台を操作するくらい、きっと朝飯前よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120104,
					"content": "そ、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120105,
					"content": "じゃあ早速、次の発明品も作りはじめましょう！今ちょうど気になっているものがあるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120106,
					"content": "なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120107,
					"content": "空を探索できる飛空艇はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120108,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120109,
					"content": "それか、地底の奥底まで掘り進むことができるスーパードリルは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120110,
					"content": "ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120111,
					"content": "なんだか、わざとフェルロイスを困らせてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745120112,
					"content": "どれも難しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "フォンテーヌ科学院を三度も断ったフェルロイス先輩なら、科学院に出来ないものも作れるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120114,
					"content": "もちろんだ。ただ、その…ちょっと厄介なだけで、大した問題ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120115,
					"content": "はぁ、でもやっぱり急に欲しくなくなっちゃった。空を飛ぶのも地面に潜るのも、考えただけでつまらない。空の上は寒いし、地下は息苦しいし、楽しくなさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120116,
					"content": "あ、ああ、そうだね。私もそう思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120117,
					"content": "じゃあ、普段使える発明品を何か作ってもらえない？そうだ！朝たっぷり寝たいから、自動朝食調理器は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120118,
					"content": "それなら出来そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745120119,
					"content": "やっぱりわざとだったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "うん、設計を考えておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "フェルロイス"
				},
				{
					"id": 745120121,
					"content": "やったー！じゃあ作ってくれるってことね。出来なかったら、今度から私の朝ご飯はフェルロイス先輩に作ってもらうことにするから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "シェニー"
				},
				{
					"id": 745120122,
					"content": "なんだそれは…とにかく安心してくれ。そういう小さな発明品は絶対にできる。なにせ私はこの分野の「天才」だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルロイス"
				}
			]
		},
