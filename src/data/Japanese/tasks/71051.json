			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "水辺に置いた奇妙な物について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "うん？あれを水辺に置いてくれたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500803,
					"content": "どうだ？何か特別な反応はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500804,
					"content": "ヴィシャップ·岩が出てきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "ヴィシャップ·岩？あれを水の中に入れたらヴィシャップ·岩に変わったって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500806,
					"content": "ああ、それはあれがヴィシャップに変化したのではなく、ヴィシャップ·岩があれを見て泳いできたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500807,
					"content": "びっくりした。もしこれを水に入れるとヴィシャップ·岩に変わるなら、俺の世界観の支柱が崩れ去ってしまうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500808,
					"content": "あれは一体…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "簡単な話なんだが、どう説明すればいいのかな。そうだな、そのヴィシャップ·岩に何か特別なところはなかったかい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500810,
					"content": "例えば、元素付着の属性が水だった、とか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500811,
					"content": "そうだったかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "読みが当たったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500816,
					"content": "あのヴィシャップ·岩は水元素を操ることができるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500817,
					"content": "層岩巨淵の地下水は水元素の含有量が高いから、特に密集している場所には君が釣り上げた水草のようなものが生まれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500818,
					"content": "ヴィシャップ·岩も、もちろん水に親しむ生物であれば層岩巨淵に生きている他のやつらも同じだ——水元素を多く含むこの水草を食べることで、自分の力を上げている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500819,
					"content": "だから、あれの正体は…水元素を多く含む水草だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500820,
					"content": "ただの水草か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "うん、水草なんだ。でも元素の含有量がそんなに高い水草と言うのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500822,
					"content": "純粋で巨大なエネルギーが水源に影響を及ぼさない限り、普通の環境では生えることはまずない…何より、これらの水草は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500823,
					"content": "いつか意識を芽生えさせて元素生物になるかもしれない。研究する価値はあるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500813,
					"content": "見なかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#まさか解決するスピードが速すぎて気付かなかったのか…すごいね、さすが伝説の{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500815,
					"content": "でも俺の推測が正しければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "ヘディーヴ"
				}
			]
		}
	]
}