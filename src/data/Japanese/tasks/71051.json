			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500501,
					"content": "奇妙な物について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "うん？これは君が……釣った、のか？ふむ…一見した限りだと、これは釣りの時に使う釣り餌のように見えるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500503,
					"content": "釣りでこんな物を釣れるものなのか…？アニサ先輩は海祇島で毎日のように釣りをしているにも関わらず、何の成果もなかったようだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500504,
					"content": "さすが君、と言うべきか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500505,
					"content": "えーっと、こいつは…恐ろしい量の水元素を含有しているように感じられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500506,
					"content": "そう言えば確かに、層岩巨淵の地下水の元素含有量は異常に高いな…もしかして、こいつらが地下水の中に生えているせいなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500507,
					"content": "だが、これを水から出すと元素がなくなってしまうんだ。水辺に置かないと効果が出ないのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500508,
					"content": "水辺に置く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "水辺に置いて水元素で活性化させれば、その効果も分かるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500510,
					"content": "ではそうだな、これを活性化せてくれ。君が釣り上げたものだからね。何かあったら教えてくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500511,
					"content": "もし研究価値があるようなら、報酬を支払おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				}
			]
		},
		{
			"id": 7105008,
			"completionStepIds": [
				7105104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
