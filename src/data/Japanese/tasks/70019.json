			"dialogs": [
				{
					"id": 700190101,
					"content": "Yoyo dala si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190102
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700190104,
					"content": "太陽が消え、一生目覚めず、死にたい…って言ってる。なんでそんなに苦しんでるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700190106,
					"content": "うーん、少しでも慰めてあげられるように、欲しい物をあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
