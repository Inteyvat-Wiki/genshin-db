				"objectNames": [
					"「船頭」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "川のこちら側…銀の木…銀の草原…銀の石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740102,
					"content": "あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "おや…お客さんか？船に乗るかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740105,
					"content": "ふむ、よく見ると外の人だったか…だめだね、これはいけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740106,
					"content": "だめ…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "月へ向かう銀色の船は、君のために用意したものではない…足を踏み入れ、私の船を汚すことはしないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740109,
					"content": "おやおや…霧はとっくに消えている…まだ船に乗っていないのは誰だい…金色の屋敷の女主人が怒ってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740110,
					"content": "船…？どこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "ふふ…銀色の船さ。太陽と山の子孫の船さ。みんな家に帰る、月明かりに照らされる屋敷へ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740112,
					"content": "しかし…ある子供は道に迷い、今も船に乗れずにいる…女主人が怒ってしまう、大変だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740113,
					"content": "手助けはいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "さあ、早く船に乗るといい…迷わず、名残惜しまず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「船頭」"
				},
				{
					"id": 721740114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の話を聞いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "何を言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
