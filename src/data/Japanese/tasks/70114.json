			"dialogs": [
				{
					"id": 701140101,
					"content": "まさかサンドローネさんが、こうしてモンドまで足を運んでくれるなんて。大変だっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140102,
					"content": "「数秘配列」の研究では、世話になったからね。その時のお礼を直接言いたかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140103,
					"content": "気にする必要はなかったのに。もともとこの課題はボクの専門外の分野だし、完成させたのはサンドローネさんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140104,
					"content": "ワタシ一人の功績じゃないわ、みんなのおかげよ…ところで、ドゥリンの姿が見えないわね。アナタ、アイツの保護者みたいなものでしょ？てっきり、アナタにべったりなんだと思っていたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140105,
					"content": "保護者か…そうとも言えるかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140106,
					"content": "でも最近の彼は、みんなの会話に溶け込めるようになってきているから、毎日どう過ごすかは自分で決めてもらっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140107,
					"content": "心配じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140108,
					"content": "少しはね。前は単独で行動して、少し個性的な人たちと接した後は、決まって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140109,
					"content": "おかしなことを覚えたり、変な口癖を真似したりしてた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140110,
					"content": "うん、その通りだよ。サンドローネさんも似たような経験があるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140111,
					"content": "ふっ、言うまでもないでしょ？痛いほど分かるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140112,
					"content": "ファルカ団長と会った後は、時々ドゥリンをスクロースのところに連れて行くんだ。研究を手伝いながら、落ち着いてもらうために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140113,
					"content": "そしてジン団長と長く過ごしすぎた時は、クレーのところに遊びに行かせてる。肩の力を抜く方法を思い出してもらうためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140114,
					"content": "アナタも本当に大変なのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140115,
					"content": "これも家族のためだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140116,
					"content": "サンドローネさんのほうは、どうしているんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140117,
					"content": "はぁ？ワタシには、そんなことを気にかけてる余裕なんてないわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140118,
					"content": "でも、性根が悪くない限り、たとえどんな影響を受けようとも、最終的にはあるべき姿に戻っていくものだとワタシは思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 701140119,
					"content": "へえ…いい観点だね。ボクもその考え方を取り入れてみようかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
