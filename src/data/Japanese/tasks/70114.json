			"dialogs": [
				{
					"id": 701140201,
					"content": "サンドローネさん、招待してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "うん、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 701140203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
			]
		}
	]
