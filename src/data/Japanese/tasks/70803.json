			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"うっかりパラド",
					"ジョエル",
					"ジョセフ",
					"サイリュス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "あれ？この人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030102,
					"content": "まさかジョエルのお父さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "おっ！来てくれたか、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030105,
					"content": "紹介するよ、この方はジョセフさんで、ジョエルのお父さんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030106,
					"content": "お父さん！この人がさっき話した旅人さんだよ。ボクのために色々手伝ってくれたんだ。雪だるまも一緒に作ってくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708030107,
					"content": "ジョエルから話は聞いたよ。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030108,
					"content": "再会できてよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "そうだな、本当によかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030111,
					"content": "今回はパラドのおかげだ！よくやった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708030112,
					"content": "今回？パラドは前にも何かやったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030113,
					"content": "俺が以前、雪山で人影を見たことを覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030114,
					"content": "その日、君たちが一緒に雪山に入って魔物を倒してくれた後、俺は近くで捜索を始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030115,
					"content": "だけど、捜索してる時、うっかり山から転がり落ちてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030116,
					"content": "こ、転がり落ちた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030117,
					"content": "幸い、下の雪の層が厚くて、ケガはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030118,
					"content": "それで、帰り道を探そうとした時、突然隣から何か物音がしたと思ったら、誰かが急に飛び出してきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030119,
					"content": "その時は、彼が俺の探していた人だと気づかず、俺と同じように山に入って救出に参加してる冒険者だと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030120,
					"content": "だけど話をしていくうちに、彼が多くのことを覚えてないことと、自分の名前すら知らないことに気づいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030121,
					"content": "でも雪山は寒すぎて、そんな細かいことを考えてる余裕がなかった。だから話は拠点に戻ってからにしようって彼に伝えたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030122,
					"content": "拠点に戻ると、ジョエルの姿が見えた。ジョエルが彼を見るとまるで凍り付いたかのように固まって、それから大声でこう叫んだ「お父さん！」と。彼はその時に色んなことを思い出したらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030123,
					"content": "お父さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708030124,
					"content": "ジョエル、お父さんはここだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030125,
					"content": "ジョセフさん、本当に他のことを思い出せないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030126,
					"content": "『イノシシプリンセス』、それと雪山でエサをあげた狐たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030127,
					"content": "すまない、そのほかは覚えがない。頭にケガを負ったせいかもしれない。だがそれすらも分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030128,
					"content": "私が目を覚ました時、体中血まみれだった。荷物も失くしてしまい、身分を証明するものもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030129,
					"content": "仕方なく洞窟に入り、落ち着いてゆっくりとケガが治るのを待ったよ。足のケガが良くなってからは、狩りの本能を頼りに生き延びてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030130,
					"content": "お父さん…本当に心配したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708030131,
					"content": "大丈夫だジョエル、泣くな。お父さんはもうどこにも行かない、ずっとお前のそばにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030132,
					"content": "ジョセフさんは、これからどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 708030133,
					"content": "私は…今は家族と一緒にいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 708030134,
					"content": "戻れて本当によかった。この件も完璧な結末を迎えたな、ハハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708030135,
					"content": "だが、パラド。捜索の途中で崖から転がり落ちるなんて、まだまだ冒険能力を上げる必要があるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708030136,
					"content": "協会に戻ったら、きちんと鍛え直してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708030137,
					"content": "えっ？サ、サイリュス会長…俺は手柄を立てたでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030138,
					"content": "帰るぞ！協会へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708030139,
					"content": "会長！勘弁してくださいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708030109,
					"content": "無事でよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "大きなジョエルだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}