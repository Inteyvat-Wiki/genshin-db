					},
					{
						"sceneId": 3,
						"position": [
							-1894.07,
							203.1,
							2509.819
						],
						"pointId": 8863
					},
					{
						"sceneId": 3,
						"position": [
							-1895.499,
							203.1,
							2511.822
						],
						"pointId": 9287
					},
					{
						"sceneId": 3,
						"position": [
							-1894.113,
							203.1,
							2512.025
						],
						"pointId": 9288
					}
				]
			},
			"dialogs": [
				{
					"id": 401660501,
					"content": "…さあさあさあ、こちらがお求めの品ですわ。どれも上質なものを揃えましたからご心配なく、うふふふ。あと新しく仕入れた品もありますの。いかがかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660502
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660502,
					"content": "えっ、要らない？ええ、ええ、構いませんとも。またお越しくださいまし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660503
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660503,
					"content": "ドリー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660504,
					"content": "あらあら、どちら様かと思えば、私の大事な、大事なお客さんじゃありませんの？んん？そちらは…アアル村のガーディアン、キャンディスさんですね？オホホ、これはまたまたステキなお客さんですこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660505
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660505,
					"content": "さてさて、ご用件は何でしょう？私、砂漠では怪しい取引なんて、怪しい取引なんてしていませんけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660506
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660506,
					"content": "いえ、誤解なさらないでください。ドリーさんにお伺いしたいことがあって訪ねたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660507
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660507,
					"content": "あら、情報をお求めで？何なりとお聞きくださいまし！私、情報の取引が一番好きですの。かさばらないし、倍の値段で…ああ、いえいえ、免税…免税対象でもありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660508
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660508,
					"content": "実は今朝、変わった宝石を購入しまして。これを加工した人がどこで原石を手に入れたのか、商人にお聞きしたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660509
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660509,
					"content": "ちなみに、その方の名前はメモしてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660510
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660510,
					"content": "人探しですわね？ふむ、手間がかかるタイプですので、それなりのモラが必要になりますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660511
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660511,
					"content": "もちろん、万能と名高いドリーさんが直接石の由来を調べてくださっても構いません。相応の報酬はお支払いしますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660512
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660512,
					"content": "（利益は少ないですが、人探しは大した手間じゃありませんわ…宝石を加工している知人たちに聞けば済むでしょう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660513
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660513,
					"content": "そんなこと言われても…この類の情報は企業ヒ・ミ・ツですから、調べるのも一苦労です、一苦労、一苦労ですの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660514
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660514,
					"content": "よろしければ、値段をご提示いただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660515
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660515,
					"content": "あらま、潔いですわね！ちょいとお待ちくださいまし…交通費に、差し入れ代、それからそれから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660516
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660516,
					"content": "二十万モラ、二十万モラでいかがかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660517
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660517,
					"content": "んげっ…高すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660518,
					"content": "申し訳ありませんが、ご提示の額では予算を超えてしまいます。もう少し安くしていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660519
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660519,
					"content": "…ま、構いませんわ！人情味のあるアアル村の方には、思い切って譲ってあげましょう。そちらの希望価格をご提示くださいまし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660520
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660520,
					"content": "五万モラでどうでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660521
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660521,
					"content": "な、何ですって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660522
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660522,
					"content": "（うわっ…さっきよりも容赦ない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660523
					]
				},
				{
					"id": 401660523,
					"content": "どうしましたか？砂漠での相場を言っただけですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660524
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660524,
					"content": "無理無理、ぜーったい無理、無理ですわ！こんな商売をしてたら、破産してしまいますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660525
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660525,
					"content": "そうですか…仕方がありませんね。では三万モラでどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660526
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660526,
					"content": "へっ？えっ？ん？私の聞き間違いじゃありませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660527
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660527,
					"content": "そちらのキャラバンがアアル村を訪れた際の安全を保障し、一部税金も免除します。いかがでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660528
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660528,
					"content": "えっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660529
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660529,
					"content": "（いや…最近のアアル村にはビジネスチャンスがゴロゴロ転がっていますし、ガーディアンの後ろ盾まで貰えるなら…確かに悪くない取引ですわ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660530
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660530,
					"content": "（フン…キャンディスさん、ひょっとしてアアル村のために交易を行おうと…？恐ろしい女ですわ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660531
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660531,
					"content": "コホン…へへ…分かりましたわ！今回はタダ働きのつもりでお引き受けします！さぁ…オホン…三万モラで承りましたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660532
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660532,
					"content": "本当ですか？さすがスメールきっての大商人。その器量と見識は噂どおりですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660533
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660533,
					"content": "も…もちろんですとも！アアル村のガーディアンとの友好関係を築くために、損を、損を覚悟でお受けいたしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660534
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660534,
					"content": "それでしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660535
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660535,
					"content": "ストップストーップ！三万モラでもう決まりですの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660536
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660536,
					"content": "（はぁ…宝石職人へのおもてなしは、五百モラの屋台料理で済ませるしかありませんわね…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660537
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660537,
					"content": "情報を集める時間が必要ですので、また明日来てくださいまし！このタイプの依頼は手間が、手間がかかりますの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660538
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 401660538,
					"content": "本当にありがとうございます、ドリーさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660539
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660539,
					"content": "旅人さん、せっかくスメールに来たのですから、オルモス港をゆっくり散策されてはどうでしょう。先ほど買った物は私が預かりますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660540
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660540,
					"content": "そうか？オイラたち、特に何もしてないのになんか悪いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660541,
					"content": "そんなことはありません。私のほうこそ、付き合わせてしまって申し訳ありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660542
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660542,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660543
					]
				},
				{
					"id": 401660543,
					"content": "ふふ、相変わらず気さくなお方ですね。あなたたちに、神様のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660544
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660544,
					"content": "ドリーさんも、すべてが順調にいきますように。では、また明日お伺いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660545
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660545,
					"content": "はぁ…ええ、また明日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				}
			]
		}
	]
}