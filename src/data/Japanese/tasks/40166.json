			"dialogs": [
				{
					"id": 401660401,
					"content": "たしか、フルーツ店はあそこだったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660402,
					"content": "うっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660403
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660403,
					"content": "キャンディス！大丈夫か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660404,
					"content": "…っ！危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660405
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660405,
					"content": "…えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660406
					],
					"speakerTitle": "ハティス"
				},
				{
					"id": 401660406,
					"content": "キャンディスは勢いよく飛び出すと、箱の下敷きになりそうになった子供を助けた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660407
					]
				},
				{
					"id": 401660407,
					"content": "お怪我はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660408
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660408,
					"content": "う…うん…ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660409
					],
					"speakerTitle": "ハティス"
				},
				{
					"id": 401660409,
					"content": "何かあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660410
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660410,
					"content": "あそこの箱が急に倒れてきたんだけど、キャンディスがこの子を助けてやったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660411,
					"content": "君、お父さんとお母さんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660412
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660412,
					"content": "パパとママは…港の酒場に…あたし、退屈だったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660413
					],
					"speakerTitle": "ハティス"
				},
				{
					"id": 401660413,
					"content": "もう大丈夫ですよ。遊ぶときは周りに気を付けてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660414
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660414,
					"content": "…早く親のとこに戻りな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660415
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660415,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660416
					],
					"speakerTitle": "ハティス"
				},
				{
					"id": 401660416,
					"content": "ここに箱を置いたのは誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660417
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660417,
					"content": "お…俺だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660418
					],
					"speakerTitle": "クトビ"
				},
				{
					"id": 401660418,
					"content": "道路脇に重いものを積むなと言ったはずだ！一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660419
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660419,
					"content": "す、すまない！さ…最近荷物が増えてきて、倉庫に置き場がなかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660420
					],
					"speakerTitle": "クトビ"
				},
				{
					"id": 401660420,
					"content": "ああ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660421
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660421,
					"content": "すぐ退かすよ！次からは気を付けるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660422
					],
					"speakerTitle": "クトビ"
				},
				{
					"id": 401660422,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660423
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660423,
					"content": "助かったよ。俺の監督不足だ。キャンディスさんがいなかったら、大事故になりかねなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660424
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660424,
					"content": "お気になさらないでください。ここ一帯の安全を守ることはきっと大変でしょう。ましてやお祭りの時期ですから。お手数ですが、引き続き気を配っていただければ助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660425
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660425,
					"content": "花神誕祭の間は、目がいくつあっても足りないぐらいだ。あっ、誤解しないでくれ。キャンディスさんのアドバイスはしかと胸に刻んでおこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660426
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660426,
					"content": "買い物中だったんだろ？これ以上邪魔はしないでおくよ。じゃ、祭りを楽しんでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660427
					],
					"speakerTitle": "シャム"
				},
				{
					"id": 401660427,
					"content": "キャンディス、さっきはすごかったぞ！箱が倒れる前に走り出してたよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660428,
					"content": "まるで箱が崩れるのを知ってたみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660429
					]
				},
				{
					"id": 401660429,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660430
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660430,
					"content": "実は…そういった「未来」が見えたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660431
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660431,
					"content": "えっ？未来を予知できるってことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660432,
					"content": "ええ…先ほどのコンロの事故も、その場面が見えました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660433,
						401660434
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660433,
					"content": "「予知の目」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				},
				{
					"id": 401660435,
					"content": "この琥珀色の左目を特別に思ったことはありません。これまで変わった光景を見たことだってありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660436
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660436,
					"content": "しかし、今朝からしきりになんらかの場面が見えるようになったのです。そして、数秒後には現実に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660437
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660437,
					"content": "ほかの人は知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660438,
					"content": "いえ…この現象が「予知」かどうか、まだ確信はありませんし、みんなに余計な心配を掛けたくはありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660439,
						401660440
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660439,
					"content": "なんで今朝からなんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660441,
					"content": "特には何も…いつも通り、一日の仕事の手配を終え、神様にお祈りを捧げてから、待ち合わせの場所に向かいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660442
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660442,
					"content": "しいて言うなら、道端で綺麗な宝石を買ったことぐらいでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660443
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660443,
					"content": "おぉ、たしかに綺麗だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660444
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660444,
					"content": "でも、なんだか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660445
					]
				},
				{
					"id": 401660445,
					"content": "あなたも気づきましたか？宝石から特殊な元素の痕跡を微かに感じます。実はそれが気になって買うことにしたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660446
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660446,
					"content": "「予知」が宝石と関係してるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660447,
					"content": "その可能性はあると思います。もしよかったら、宝石を手に持って試してみてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660448
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660448,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660449
					]
				},
				{
					"id": 401660449,
					"content": "何も起きない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660450
					]
				},
				{
					"id": 401660450,
					"content": "そうですか…誰にでも起こる現象ではないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660451
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660451,
					"content": "何らかの条件が必要なのかもしれません…それとも、アフマル様の民であることと関係しているのでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660452
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660452,
					"content": "ほかのやつに聞いてみるのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660453
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660453,
					"content": "花神誕祭の準備で忙しい時期ですから、できればこういったことでお手を煩わせるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660454
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660454,
					"content": "それに、ちょうどここ数日は任務も多くありませんし、自分で調査すれば済むことです。これも「ガーディアン」たる私の責務でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660455
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660455,
					"content": "#{M#俺}{F#私}たちも手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660456
					]
				},
				{
					"id": 401660456,
					"content": "ありがとうございます。あなたがいてくれたら、私も安心です。まるで夜に仲間と焚き火を眺めているかのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660457
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660457,
					"content": "とりあえず、買い出しを済ませてから石の情報を集めましょう。石の出所については、商人に聞けば教えてくれるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660458
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660458,
					"content": "「商人」といえば、あの情報通の大商人がいるよな？モラをガッツリ持ってかれるだろうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660459
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660459,
					"content": "もしかして、「ドリー」という名の方でしょうか？アアル村でも、その噂は耳にしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660460
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660460,
					"content": "そうそう！ただ、モラに目がないやつだから、値切り交渉は無理しないほうがいいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660461
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660461,
					"content": "キャンディスと一緒に、買い物リストにあるフルーツを買い揃えたあと…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660462
					]
				},
				{
					"id": 401660462,
					"content": "店主たちにドリーの居場所を教えてもらった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401660440,
					"content": "今朝、何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660434,
					"content": "本当にそんな能力が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				}
			]
		},
		{
			"id": 4016605,
