			"dialogs": [
				{
					"id": 401660201,
					"content": "あれ？あそこにいるのって、ティナリとコレイじゃないか？ディシアとキャンディスもいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660202,
					"content": "みんなに挨拶しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660203,
					"content": "…各自の担当は覚えたね？じゃ、手分けして行動しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660204
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660204,
					"content": "もう一回念を押すけど、絶対にあの方に気づかれないよう、気をつけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660205
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660205,
					"content": "心配すんなって。あたしたち傭兵は、秘密を守ることを命よりも大切にしてるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660206
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660206,
					"content": "おそらく、そのような事態にはならないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660207
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660207,
					"content": "ただの例え話だよ。あたしの言いたいことは分かるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660208
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660208,
					"content": "うぅ…やっぱりちょっと心配だな。絶対に口を滑らせはしないけど、もし何の前触れもなく背後に現れて、もしそれに気づけなかったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660209
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401660209,
					"content": "よう、みんなここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660210,
					"content": "うわああっ！あ、あたし何も知らないし、何も話してない。秘密を隠したりなんか、絶対にしてないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660211,
						401660212
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401660211,
					"content": "絶対に秘密を隠してる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660213
					]
				},
				{
					"id": 401660213,
					"content": "…落ち着いて、コレイ。まずは誰が来たのかくらい確かめないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660214
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660214,
					"content": "おっ、旅人にパイモン！ここで会えるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660215
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660215,
					"content": "#{M#俺}{F#私}もみんなに会えて嬉しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660216
					]
				},
				{
					"id": 401660216,
					"content": "へっ？なんだ、お前たちだったのか、ふぅ…びっくりした。授業中にぼーっとしてたら、後ろに師匠が立ってたときよりも焦ったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660217
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401660217,
					"content": "花神誕祭に参加するため、スメールに戻ってきたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660218
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660218,
					"content": "おう！お祭りの間は盛り上がるだろうし、せっかくなら、友達と一緒に過ごしたいなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660219,
					"content": "うん、教令院でもいろんな準備を進めてるって先生から聞いたよ。今年はクラクサナリデビ様の誕生日を盛大に祝ってあげようとしてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660220
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660220,
					"content": "かつて教令院が犯した過ちに対する、ささやかな償いって意味もあるんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660221
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660221,
					"content": "へへ、オイラたち、タイミングばっちりだな。楽しいものをたくさん見て、美味しいものをたらふく食べられそうだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660222,
					"content": "それはそうと、さっきはなんの話をしてたんだ？秘密とかなんとか、こそこそ話してたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660223,
					"content": "近くに——いい？誰にも言わないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660224
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660224,
					"content": "実はクラクサナリデビ様のためにサプライズを用意しようと考えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660225
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660225,
					"content": "わぁ～！バースデーサプライズってやつか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660226,
					"content": "ええ、ディシアの提案なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660227
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660227,
					"content": "ん？ああ、ドニアザードと話してたらふと思いついたんだ。花神誕祭って、毎年似たり寄ったりだろ？今年はちょっと特別な企画があってもいいと思ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660228
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660228,
					"content": "ドニアザードもいいアイデアだって言ってくれたし、みんなに相談したら話がサクサク進んでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660229
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660229,
					"content": "サプライズだから、知ってる人は少ないほうがいい。なにせ知恵の神が相手だからね。ちょっとしたことで勘づかれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660230
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660230,
					"content": "そうだな！で、いつまでこんな風に話さなきゃいけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660231,
					"content": "ぷっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660232
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401660232,
					"content": "コホンッ！とにかく、ここ数日手が空いてる友人たちに準備を手伝ってもらうことにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660233
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660233,
					"content": "それで？具体的にはなにをするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660234,
					"content": "クラクサナリデビ様はキャンディがお好きらしいから、そこをポイントにサプライズの内容を考えようと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660235
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401660235,
					"content": "フロート車のパレードのあとは、誕生日パーティーに誘うつもりだ。だから、ハフト・スィーンとかも外せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660236
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660236,
					"content": "デザインのほうはカーヴェに任せてある。今のところ、僕たちは食材と飾りを買い揃えればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660237
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660237,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660238
					]
				},
				{
					"id": 401660238,
					"content": "そうそう、ここまで話を聞いちゃったんだし、オイラたちも手を貸すぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660239,
					"content": "だったらキャンディス、さっき買い出しを手伝ってほしいって言ってたよな？ほら、渡りに船ってやつだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660240
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660240,
					"content": "ええ、最近はあまり砂漠から出ていませんから、この辺の相場や品を見極められる自信がなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660241
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660241,
					"content": "ぜひ同行させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660242
					]
				},
				{
					"id": 401660242,
					"content": "ご迷惑でなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660243
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660243,
					"content": "水臭いこと言うなって！むしろみんなの役に立てて、オイラたちにとってもサプライズだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660244,
					"content": "おっ、パイモン、ずいぶん口が上手くなったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660245
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660245,
					"content": "では、お言葉に甘えさせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660246
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401660246,
					"content": "よし、決まりだな！飾りはあたしとドニアザードが担当する。パーティー会場はティナリに任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660247
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401660247,
					"content": "なんだかワクワクしてきたぞ！さっそく行動開始だ！ナヒーダに素敵な誕生日プレゼントを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660248,
					"content": "しーっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660249
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401660249,
					"content": "あっ…そうだった、興奮してつい…しーっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401660212,
					"content": "白状したほうがいいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660213
					]
				}
			]
		},
