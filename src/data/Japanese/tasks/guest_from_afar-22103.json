					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "急いでちょうだい。あの方は神出鬼没だから…いつ戻るからわからないもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030204,
					"content": "彼が手を出したら、この旅館は本当に休業になってしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
