			"dialogs": [
				{
					"id": 221030101,
					"content": "面倒ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "あら、お客さん？ごめんね、最近旅館の周りが少しおかしくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030104,
					"content": "すでに複数のお客さんが怪物に襲われて、そのせいで商売しにくるお客さんも少なくなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030105,
					"content": "このままだと、本当に大変なことになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030106,
					"content": "うーん、その、旅人よね…周りを見てきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030113,
					"content": "とにかく、お願いね、報酬はちゃんと払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030108,
					"content": "怪物が怖い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "怪物が怖い？いや、怪物自体は大したことないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030111,
					"content": "怪物のせいで…あの方の機嫌を損ねるようなことがあったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030112,
					"content": "彼が怪物と戦う時は、場所も人も気にしなくなるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
