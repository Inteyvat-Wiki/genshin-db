					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "よかった…これで安心できるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030304,
					"content": "約束の報酬よ、受け取ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030305,
					"content": "「あの方」は誰かって？あら…見たことないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030306,
					"content": "時々旅館の最上階にいるから、会ったことはあるかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 221030307,
					"content": "まあ、会ったとしても、声をかけない方がいいわ。彼は一人が好きだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
