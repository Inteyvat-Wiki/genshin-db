			"trigger": {
				"objectNames": [
					"バシマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "そこのあなたさま、生論派学者であるこのバシマがあなたさまにお願いいたします。どうかそう急いで離れようとなさらず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280102,
					"content": "肩の力を抜き、頭を空っぽにして、わたくしの言葉に耳をお貸しくださいませ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280103,
					"content": "ヤマガラが一番可愛い！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280104,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280105,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "ヤマガラは確かに可愛いけど、バシマは学者なんだよな？根拠もなしにそんなこと言って、激しい議論になったりしないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280107,
					"content": "オイラの印象じゃ、学者はみんな発言には慎重だよな。もしオイラが学者なら、軽い気持ちで…ええと…「エビのポテト包み揚げが一番美味しい！」なんて、絶対に言える気がしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280108,
					"content": "なにか、こう、前提を加えないとだろ。例えば「最近の璃月料理の中だと、オイラはこの料理が一番食べたい」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280109,
					"content": "#{M#俺}{F#私}は言える！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#うわぁ！{NICKNAME}、突然どうしたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280113,
					"content": "本気で言ってるんだとしても、そんな大声で言わなくてもいいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280114,
					"content": "おほほほ！ええ、まさにそういうことでございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280115,
					"content": "学者だからこそ、日常生活の一分一秒を全て議論の場にしたり、一言たりとも間違わないように気をつけたりなんてごめんですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280116,
					"content": "どうせわたくしを四六時中見張っている人なんていませんから、一言くらい不用意に言葉を発しても、減るものではございません。そこまでびくびくする必要なんてないのですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280117,
					"content": "ですが、一番大切な思いは、絶対に大きな声で叫び、大胆に打ち明けていくべきございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280118,
					"content": "もし、あなたさまがたもこのテーブルゲーム「カラコロ！チュンボール」を遊んだことがおありでしたら、必ずわたくしと同じように、ヤマガラが一番かわいい！と、叫びたくなるはずですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280119,
					"content": "カラ…コロ…チュンボール？後ろのテーブルにあるやつのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280120,
					"content": "そうですわ。このゲームを遊んでいただければ、心の底からヤマガラの可愛さに開眼されることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280121,
					"content": "しかも、これは「ヴェルーリヤ·ミラージュ」の正式なアトラクションの一つですから、ゲームでハイスコアを取れた場合は、報酬もありますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280122,
					"content": "そこまで言われると、ちょっと気になってきちゃったぞ。しかも上手ければ、報酬もあるんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280123,
					"content": "#{NICKNAME}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735280124,
					"content": "やってみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "おほほほ！思い切りが良うございますわね！ではどうぞ、ご存分にお楽しみくださいませ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バシマ"
				},
				{
					"id": 735280125,
					"content": "ヤマガラの可愛さがどれほどのものか！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "パイモンが一番可愛い！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "以上！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}