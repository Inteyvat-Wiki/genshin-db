				7052001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052001",
							"2"
						],
						"stepId": 7052001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ベルンハルト",
					"マーツ",
					"ポリーン",
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705200101,
					"content": "栄誉騎士とパイモン！いい知らせだ！僕たちに新たな助っ人が加わった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200102
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705200102,
					"content": "この二人の店主はチャリティーショップのことを聞いて、仲間になりたいと思ったらしい。しかも収益も寄付するつもりだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200103
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705200103,
					"content": "えっ？寄付するって、本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200104,
					"content": "いいんだいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200105
					],
					"speakerTitle": "マーツ"
				},
				{
					"id": 705200105,
					"content": "収入源が増えれば、助かる人も増えるだろ。俺とポリーンさんも黙々と自分だけ稼ぐより、そのほうがいいと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200106
					],
					"speakerTitle": "マーツ"
				},
				{
					"id": 705200106,
					"content": "今年のブリュー祭はお客さんが例年よりも多いので、早めに売上目標を達成できました。だからもう十分満足ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200107
					],
					"speakerTitle": "ポリーン"
				},
				{
					"id": 705200107,
					"content": "あなたたちがお年寄りと子供たちのために駆け回っているのを見て、私たちも協力したいと思ったのです。あまり気にしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200108
					],
					"speakerTitle": "ポリーン"
				},
				{
					"id": 705200108,
					"content": "本当にありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200109
					]
				},
				{
					"id": 705200109,
					"content": "ああ、なんだか心が温かくなってきたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200110,
					"content": "となると、名前を変えないとな！よし…「西風ヒューヒューチャリティー連盟」にしようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200111,
						705200112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200111,
					"content": "西風が強くなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200113
					]
				},
				{
					"id": 705200113,
					"content": "力を合わせて、今回のチャリティーイベントを成功させよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200114,
					"content": "店主二人が加わり、チャリティーイベントの規模が拡大した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200115
					]
				},
				{
					"id": 705200115,
					"content": "寄ってらっしゃい見てらっしゃい。「西風ヒューヒューチャリティー連盟」の特製料理に、日用雑貨、それからお花はどうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200116,
					"content": "おっ！見ろよ、アルベドが来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200117,
					"content": "やあ、元気かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200118,
						705200119
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200118,
					"content": "いらっしゃい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200120,
					"content": "アルベドもなにか買いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200121,
					"content": "必要なものは特にないけど、キミたちが騎士団の店を管理していると聞いて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200122
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200122,
					"content": "ちょうどティマイオスとの研究に進展があってね、その完成品を少し持ってきた。チャリティーイベントに対するちょっとした支援だと思ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200123
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200123,
					"content": "わざわざ支援しに来てくれたのか！オイラ、感激したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200124,
					"content": "どれどれ…ボトルに入ってるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200125,
					"content": "特製酔い覚ましポーションだよ。酔いを早く覚まし、頭痛を効果的に和らげることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200126
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200126,
					"content": "これを必要としている人に試供品として配ってみてくれ。そうすれば、より多くのお客さんを惹きつけられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200127
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200127,
					"content": "こんなにすごいもの、相当苦労して作ったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200128,
					"content": "おや？長い間、ボクの実力を見せてこなかったからかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200129
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200129,
					"content": "昔のボクなら、このような研究にあまり興味なかったかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200130,
					"content": "しかし、錬金術の成果物で人々の生活を便利にするのは、素晴らしいことだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200131
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200131,
					"content": "そうだな！オイラ酔っ払ったことはないけど、想像はできるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200132,
					"content": "お酒を楽しんだ後に足を滑らせて湖に落ちたり、石につまづいて転んだりしたら、せっかくの良い気分も台無しだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200133,
					"content": "#{M#俺}{F#私}たちもタダで受け取ることはできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200134
					]
				},
				{
					"id": 705200134,
					"content": "そうだ、この店の料理を持って帰って、クレーと一緒に食べてくれよ。オイラたちのおごりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200135,
					"content": "ああ、じゃあ遠慮なくもらっていくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200136
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200136,
					"content": "まさか、これほど見事な商才を持っていたなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200137
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200137,
					"content": "料理店の立地が絶妙だ。祭りの雰囲気に合っているだけでなく、役割分担も合理的だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200138
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200138,
					"content": "他の騎士団メンバーが担当していたら、きっと普通の雑貨しか売っていなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200139
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200139,
					"content": "おっ、アルベドに褒められたぜ。オイラ、酔い覚ましポーションを飲んだみたいに気分がいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200140,
					"content": "でも、アルベドって意外とチャリティーショップに詳しいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200141,
					"content": "ああ。以前、騎士団がチャリティーイベントのために雑貨を集めた時、風景画を十数枚ほど提供したことがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200142
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200142,
					"content": "アルベドの絵なら、きっと高く売れるだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200143,
					"content": "パイモンの考えは、一般的な商人と似ているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200144
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200144,
					"content": "確かにボクの絵を独特だと思い、投資価値を見出して、高額で購入してくれる人もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200145
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200145,
					"content": "以前のオークションで、ボクのスケッチの売り上げが良かったから…アリスさんも何かを感じ取ったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200146
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200146,
					"content": "彼女は独自のルートでボクの作品にある認定を授けてくれた…確か「特許」という名前だったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200147
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200147,
					"content": "その後、多くの画家がボクの風景画を模倣して、モンドによく飾られるようにもなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200148,
						705200149
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200148,
					"content": "なんとなく見た覚えがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200150,
					"content": "アリスさんの「特許」のルールでは、画家はその類の風景画を売るたびに、報酬の何割かをボクに支払わなければならないことになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200151
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200151,
					"content": "だがお金の行き先に興味はない、その管理は騎士団に任せている。富はボクの目的じゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200152
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200152,
					"content": "もし何に使えばいいかと聞かれたら…うん、アリスさんが壊したものの修繕費に充てればいいと答えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200153
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200153,
					"content": "でも、結局はチャリティー活動に使ったと聞いているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200154,
						705200155
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200154,
					"content": "チャリティーに参加したことがないのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200156,
					"content": "さすがはアルベドと言うべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200157,
					"content": "結果は本意から逸れたものだったけど、予想外の収穫を得られたし、ボクも少しずつそれを受け入れたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200158,
						705200160
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200158,
					"content": "よかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200159
					]
				},
				{
					"id": 705200159,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200162,
					"content": "じゃあ、そろそろボクは工房に帰るよ。商売がうまくいくことを祈ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200163
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200163,
					"content": "協力してくれてありがとな。アルベドも研究、頑張れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200164,
					"content": "アルベドのために、お持ち帰り用の料理を作った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705200165
					]
				},
				{
					"id": 705200165,
					"content": "時間があったら、また遊びに来いよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705200160,
					"content": "絵を学びたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200161
					]
				},
				{
					"id": 705200161,
					"content": "もちろん、喜んでボクの経験を共有するよ。でも…うん、やっぱりたくさん練習するのが一番だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705200162
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705200155,
					"content": "偶然にも同じ目標を達成している…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200156
					]
				},
				{
					"id": 705200149,
					"content": "アルベドの絵だったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200150
					]
				},
				{
					"id": 705200119,
					"content": "久しぶり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705200120
					]
				},
				{
					"id": 705200112,
