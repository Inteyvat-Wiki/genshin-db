				"objectNames": [
					"嵐姉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "全然違うわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "…どうやらあなたは本当に暇なのね。強いからか、それとも弱いからか分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100104,
					"content": "まあ、今まで私の依頼を全部クリアしたから、弱いことはないはずだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100105,
					"content": "どうせ暇なら、私の依頼を受けてみたらどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100106,
					"content": "でも今回の目標はちょっと危ないかもしれないわ。「遺跡ハンター」、どう？受ける？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "自信あるのね、私の兄と同じ…あなたの将来が楽しみだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100113,
					"content": "さあ、雑談はここまでにしましょう。具体的な場所は帰離原よ。ちゃんと準備するようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100114,
					"content": "倒した後に、「剣」に関する何かがあったら、持ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100115,
					"content": "…もしなかったら、そのまま帰ってきていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100116,
					"content": "とにかく、お願いね。今回こそ…見つけられるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100108,
					"content": "今回も「剣」と関係ある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "ええ、遺跡ハンターを倒した後、「剣」に関するものも探してみてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100111,
					"content": "でも今回の目標は遺跡ハンター、かなり手強いわよ。ちゃんと集中したほうがいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100112,
					"content": "「剣」に関するものは、あったらいいけど、なくても平気よ。遺跡ハンターさえ倒してくれたら、ちゃんと報酬は支払うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
