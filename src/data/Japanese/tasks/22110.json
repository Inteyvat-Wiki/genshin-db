						221100202
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "大丈夫、「遺跡ハンター」みたいな相手は、慎重に準備したほうがいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
