			"dialogs": [
				{
					"id": 221100301,
					"content": "どう？倒した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100302,
					"content": "倒した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "遺跡ハンターまで倒したとはね…誰から見ても、あなたは十分な実力者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100304,
					"content": "…「剣」に関するものはないのね？…想定内よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100305,
					"content": "それよりご苦労様。今まで私の依頼を受けてくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100306,
					"content": "「蔵鋒」、一体どこにあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100307,
					"content": "きっと見つかるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "…私を慰めてるの？ううん、そんなの挫折のうちに入らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100310,
					"content": "いつになっても、それがどんな場所であろうと…私はあの剣を見つけ出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100311,
					"content": "調査範囲を広げるから、今後もまたお願いするかもしれないわ。安心して、ちゃんと報酬は用意しておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100316,
					"content": "まあいいわ、報酬よ、受け取って。私は次の依頼を選ぶから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100317,
					"content": "…「蔵鋒」、私は必ずあなたを見つける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100308,
					"content": "これらの依頼は「剣」と関係なさそうだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "それは、「剣」に関する依頼を全て受けたけど…何も見つからなかったからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100313,
					"content": "そして、兄が…剣まで捨てたってことは彼は相当危険な状況にあってたと私は思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100314,
					"content": "だから私はほかの依頼を受け始めた。十分危険なところで「蔵鋒」を探す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221100315,
					"content": "でも、危険な依頼は数が多くて、私一人じゃ手が回らなくなってきた。だからあなたに頼んだの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "嵐姉"
				}
			]
		}
	]
