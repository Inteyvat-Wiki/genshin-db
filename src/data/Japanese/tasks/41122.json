				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "ん？どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220302,
					"content": "今の状況を伝える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "隕石のことは知ってるよ。でも…私たちまだ隕石が落ちる様子を見たことないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220304,
					"content": "ウィルが隕石を見るいい場所があるって言うから、ここに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220305,
					"content": "城の中からも見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "でも城の中だと、高いところに行かないと見えないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220307,
					"content": "護衛のおじさんたちは絶対高いところに行かせてくれないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220308,
					"content": "あそこのおじさんなら手伝ってくれる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "え？あの変なおじさんのこと？でも前に話してきたとき、凄く怖かったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220310,
					"content": "ずっと一緒に帰ろうって言ってきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220311,
					"content": "でも、もしあの人が私たちを高いところに連れていってくれるなら…帰ってもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "ジル"
				},
				{
					"id": 411220312,
					"content": "でもやっぱりウィルにも言って、元々ウィルが決めたことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジル"
				}
			]
		},
