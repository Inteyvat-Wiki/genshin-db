			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マイク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "こんにちは。僕に何か用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220202,
					"content": "この命令書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "命令書？本当ですね、見てみます…城に戻って事務の処理を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220204,
					"content": "城に戻るのはいいのですが、あちらにいる二人の子供は見えますか？彼らが城に帰りたがらないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220205,
					"content": "彼らの保護者がどこに行ったのかは知りませんが、僕が強引に連れていくこともできませんので、ここでずっと見守っているしかないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220206,
					"content": "この状況で僕が城に戻って、あの子たちに何かあったらどうしますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220207,
					"content": "はぁ、何回も説得したのですが、僕の話を聞かなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220208,
					"content": "よかったら…僕の代わりに説得してみますか？君の話なら聞くかもしりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220209,
					"content": "あの子たちを説得できたら、僕も安心して帰れます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "マイク"
				},
				{
					"id": 411220210,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイク"
				}
			]
		},
		{
