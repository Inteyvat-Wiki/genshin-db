					"ホフマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "ふむ、どうやら他の方法もないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "お前さんか。それがな…この頃空から降る隕石は、お前さんも見ただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220104,
					"content": "運よくモンド城に隕石は落ちてないが、城外はもうめちゃくちゃだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220105,
					"content": "多くの人が城内に避難して、中には眠っている人も。城内の仕事が片付けられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220106,
					"content": "だから外で任務を実行している騎士たちを呼び戻して、城内の仕事をやらせようと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220107,
					"content": "しかし彼らも野外にいてな、騎士団も彼らを探す人手はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411220108,
					"content": "もしよかったら、この命令書を彼らに持って行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "ホフマン"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
