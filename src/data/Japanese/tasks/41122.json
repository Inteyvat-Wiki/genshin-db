			"dialogs": [
				{
					"id": 411220601,
					"content": "こんにちは、なにかお困りかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220602,
					"content": "この命令書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "命令書？見せて、ふむ…城に戻れと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220604,
					"content": "すまない、この命令は後で実行するよ。今はもっと重要なことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220605,
					"content": "隕石の影響を受けてか、この付近の魔物が狂暴になって危険なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220606,
					"content": "この地域の安全を保障するために、魔物を片付けないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220607,
					"content": "ここは人がいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "人がいないからこそ、魔物を倒すことに集中できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220609,
					"content": "この事はとても重要なんだ、終わるまで俺はここを離れないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220610,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "それは助かる。ここの魔物の集落は一つじゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220613,
					"content": "手分けして魔物を片付けよう。各自片付けたらここに来て集合だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリー"
				},
				{
					"id": 411220611,
					"content": "一緒に片付けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
