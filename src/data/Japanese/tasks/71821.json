					"宏宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "何でこんな仕事を任されたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "旅人のお前は知らないかもしれないが、海灯祭の霄灯は回収しないといけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210104,
					"content": "霄灯は飛ばす時こそ綺麗だが、その後が非常に面倒なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210105,
					"content": "作りの甘い霄灯は、途中で壊れてしまって、中の浮生の石だけ飛んでしまう事もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210106,
					"content": "風のせいで、変な隙間に挟まったりもする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210107,
					"content": "安全面の懸念も存在するし、璃月の景観にも悪い影響を与えてしまう。だから総務司は、霄灯の回収を手配するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210108,
					"content": "今年は俺の番ってわけさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210109,
					"content": "しかし海灯祭で放たれる霄灯の数は多い…祭りの最終日にまとめて片付けるのは、とてもじゃないけど無理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210110,
					"content": "だから皆が霄灯を飛ばしてる内に、隅っこに落ちてる霄灯や、壊れた霄灯を回収しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210111,
					"content": "だがそれでも、俺一人じゃ間に合いそうにない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210112,
					"content": "旅人、もしよかったら回収できる霄灯がないか、確認してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210113,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "場所を地図に記したから、よろしく頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
