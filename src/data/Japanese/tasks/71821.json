				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "どうだ、回収できた霄灯はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210302,
					"content": "霄灯を3つ回収した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "ありがとう。そこの霄灯は回収するのが面倒なんだよ、毎回死ぬほど疲れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "宏宇"
				},
				{
					"id": 718210304,
					"content": "おかげさまで少し楽になった。そうだ、報酬を受け取ってくれ。ご苦労だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏宇"
				}
			]
		},
