			"trigger": {
				"objectNames": [
					"瞬拳阿凌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "なんてことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210202,
					"content": "なぜここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "あぁ…師匠が最近新しい蹴り技を発明したんだ、とても凄いんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210204,
					"content": "しかし私はまだ誠実さと基礎が全く足りてないから、その蹴り技は教えてくれないらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210205,
					"content": "そこで思いついたんだが、この海灯祭の期間に、霄灯を贈って機嫌を取れば、教えてもらえるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210206,
					"content": "しかし浮生の石が全く見当たらなくて…やっとのことでそこに挟まれている霄灯を見つけ、中身の浮生の石を取ろうとした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210207,
					"content": "そしたらこの有様だ…くっ、霄灯はあきらめた、君にあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "瞬拳阿凌"
				},
				{
					"id": 718210208,
					"content": "魔物ごときにここまでやられるとは、私もまだまだだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瞬拳阿凌"
				}
			]
		},
