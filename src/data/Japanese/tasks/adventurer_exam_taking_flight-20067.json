					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "旅人さん…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670104,
					"content": "この前あなたに教わってから、すごく真面目に練習したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670105,
					"content": "ジャックにも模擬試験をやってもらったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670106,
					"content": "結果は…、不合格だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670107,
					"content": "何がいけないのか全然わからない…旅人さん、もう一回指導してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670108,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "じゃあお願いね、旅人さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670111,
					"content": "えっと…まず一つ目の質問ね。飛行する時、一つの風の翼を最大何人で一緒に使える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200670109,
					"content": "（この前の返答が間違ってたのかな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
