			"dialogs": [
				{
					"id": 760430101,
					"content": "「流浪の輪」の件だが、あたしの記憶が正しければ当時は結論が出なかったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430102
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760430102,
					"content": "ああ。キャラバンの商品は盗まれて、容疑者は容疑を否認したまま、人を殴り殺して逃げたんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430103
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430103,
					"content": "二人とも元海賊で、もとは仲間だったそうだよ。十年もの間何事もなく過ごしていたのに、最後はこんな形で終わるなんて、何ともため息が出る話さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430104
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760430104,
					"content": "でもさぁ姐さん、そんなのナド・クライじゃ珍しい話じゃないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430105
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430105,
					"content": "ふっ…よくあることだからって無価値とは限らない。手がかりってのは何でもないところに隠れてるもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430106
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760430106,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430107
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430107,
					"content": "ヤフォダ、「文使い」から話を聞きな。見落としていた細部の情報がいろいろ手に入るはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760430108,
					"content": "わかったよ、姐さん。あたいに任せといて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
		{
			"id": 7604302,
			"completionStepIds": [
				7604302
			],
