					{
						"sceneId": 3,
						"position": [
							1678.52,
							236.034,
							9517.342
						],
						"pointId": 360700178
					}
				]
			},
			"dialogs": [
				{
					"id": 760430201,
					"content": "クリエッカ、ヒラーム。調子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430202
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430202,
					"content": "へえ、君の口からそんな言葉が聞けるなんてな。挨拶なんて普段はしないじゃないか、アナグマちゃん。誰かにおびき出されたか？それとも、誰かをおびき出そうってのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430203
					],
					"speakerTitle": "ヒラーム"
				},
				{
					"id": 760430203,
					"content": "はいはい、先輩のことはほっといて。おかげさまで相変わらずよ。それで、何か用なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430204
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430204,
					"content": "ああ、「流浪の輪」のことを聞きたくってさ。けっこう大騒ぎになっただろ？でも、結局商品を盗んだ犯人は捕まらなかったって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430205
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430205,
					"content": "君が誰を犯人だと思うかによる、って言いたいところだけど…当時、告発されたハルクは自分は無実だって主張してたわ。大騒ぎを起こした末、ジュヤニという人を殴り殺しちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430206
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430206,
					"content": "二人とも昔は海賊船に乗ってた仲間だったらしいんだけど、事故で仲間はほとんど死んで、船も失った…それで、二人して「流浪の輪」に入ったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430207
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430207,
					"content": "ハルクはジュヤニを殺して、すぐに逃げた。まさかあんなことが起こるなんて、誰も思ってなかったわ…ハルクはジュヤニとは旧知の仲だったし、彼の面倒もよく見ていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430208
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430208,
					"content": "ハルクはレンポ島の北部に逃げて悪さを続けてるって聞くけど。はぁ…あの辺を通るたび、いつもヒヤヒヤものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430209
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430209,
					"content": "あの回廊を通る孤独なルートを選ぶ文使いはお前くらいさ。みんな、たとえ杞憂だとしても…想像しうる危険はできるだけ避けようとするものだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430210
					],
					"speakerTitle": "ヒラーム"
				},
				{
					"id": 760430210,
					"content": "はいはい…先輩の言う通り。でも、そういえば最近は噂を全く聞かなくなったわね。他の場所に潜んでるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430211
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430211,
					"content": "でもさっきの言い方…ハルクが犯人じゃないって思ってるやつもいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430212
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430212,
					"content": "ええ、いくつか疑問点が残るのよ。あの時、窃盗事件の犯人として彼が疑われた理由は、商品が盗まれてからすぐに「フラッグシップ」で湯水のようにお金を使って他人に食事をおごっていたからなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430213
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430213,
					"content": "加えて、自分が重要な取引先と契約を結んだことでキャラバンのオーナーにえらく評価されて、結構な額のボーナスをもらえたから将来は安泰だ、なんて豪語してたらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430214
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430214,
					"content": "でも、「流浪の輪」の人に聞いたらそれは彼の手柄じゃないって話になって…もしそうなら、ボーナスっていうのもきっと嘘。何か別の資金源があったはずってことになって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430215
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430215,
					"content": "でも、それって直接的な証拠にはならないだろ。うーん、やつの出自のせいで、不当に疑われた部分もあったんじゃないのか？もともと海賊だったわけだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430216
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430216,
					"content": "それが原因じゃないと言ったら嘘になるわ。でもジュヤニだって元海賊だったのよ。ただ、二人の評判はまったく違っていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430217
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430217,
					"content": "その時、みんなから疑われたハルクは逆にジュヤニのことを犯人だと主張したの。ジュヤニが、キャラバンの商品を少しずつ運び出しているのをこの目で見たんだ…って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430218
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430218,
					"content": "さらには、ナシャタウンにあるジュヤニの家に行けば何か分かるはずだと大声で叫んだの。でもジュヤニはきっぱりと否定したし、周囲の人たちもハルクの言い分を信じようとはしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430219
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430219,
					"content": "つまり…みんなは、ハルクがジュヤニに濡れ衣を着せようとしたって思ったわけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430220
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430220,
					"content": "そうよ。結局ハルクが商品を転売していた証拠は見つからなかったんだけど…過失とはいえ、ハルクはジュヤニを殺して逃げてしまったから。それで、この件はうやむやにされたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430221
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430221,
					"content": "うーん、なんか見落としてる気がするんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430222
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430222,
					"content": "アナグマちゃん、君の見立ては正しい。錆びた金属を繋ぎ合わせたのは思いやりや善意ではなく、無意味な恐怖だった。でも、恐怖は火じゃないから、金属を溶かすことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430223
					],
					"speakerTitle": "ヒラーム"
				},
				{
					"id": 760430223,
					"content": "「流浪の輪」は行き場のない者たちを留める象徴だった。だけど、劣等品は釘にはなれない。それは必要な時にボロボロにされるだけの存在だ。そして、腐食というのは一晩で起こることじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430224
					],
					"speakerTitle": "ヒラーム"
				},
				{
					"id": 760430224,
					"content": "先輩の言ってることはよく分からないけど、キャラバンのオーナーも不運だったわよね。「流浪の輪」が出自を問わない集団だったことは、君も知ってるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430225
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430225,
					"content": "「流浪の輪」は、複雑な事情を抱える人々にもチャンスを与えてた…この十年間、キャラバンはハルクのことを他の人たちと同じように扱ってきたらしいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430226
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430226,
					"content": "…そうだよ！どうして今なんだ？ハルクは「流浪の輪」で十年間も平穏に過ごしてきたのに、なんで今になって急に昔の仕事に手を出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430227
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430227,
					"content": "苦労してやっと手に入れた新しい人生だろ。なんでそれを、自分の手で壊そうとするんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430228
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430228,
					"content": "（もしあたいだったら…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430229
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430229,
					"content": "さあね。もしかしたら、本当はこの十年間ずっと悪事を働き続けていてバレなかっただけかもしれないし、今がジュヤニを消す絶好の機会だと思ったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430230
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430230,
					"content": "町中に噂は流れてるけど、納得できる言説なんてない。だって、肝心のハルク自身が行方不明なんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430231
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430231,
					"content": "それに、たとえ商品窃盗事件が実際に彼とは無関係だったのだとしても、その後に犯した罪はよっぽど重いわ。今さら戻ることもできないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430232
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430232,
					"content": "それもそうだな。いずれにしても、やつは自分のしたこと対して代償を払わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430233
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430233,
					"content": "よし、聞きたいことは大体聞けたよ。サンキュー、邪魔したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430234
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760430234,
					"content": "いえいえ。私たちも「秘聞の館」には色々とお世話になってるし、これくらいなんてことないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430235
					],
					"speakerTitle": "クリエッカ"
				},
				{
					"id": 760430235,
					"content": "アナグマちゃん、警戒を緩めるんじゃないぞ。錆びた金属に傷つけられないようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヒラーム"
				}
			]
		}
	]
}