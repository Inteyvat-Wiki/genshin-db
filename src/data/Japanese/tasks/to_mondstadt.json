				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "ふふん、どうです？これがあなた達の師匠の実力ですよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010502,
					"content": "すさまじい戦闘だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "占星術師にとって、これしきのことお茶の子さいさいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010505,
					"content": "占星術の前で嘘は無意味。「運命」と「真実」とは、星空を見れば一目瞭然なんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010506,
					"content": "詳しく知ろうとすればそれなりに時間は掛かりますが、大雑把なことであれば一目で見抜けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010507,
					"content": "でも、今まで結構失敗してなかったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010508,
					"content": "それは、テイワットの星空では「此世」の運命と真実しか映らないからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010509,
					"content": "あなたたちに関することは全て曖昧で、この私でも正確に見抜くことができません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010510,
					"content": "ですから、向こうの継承者と会うことで両者の知識が合わされば、あなたの運命もはっきりと見えるようになるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010511,
					"content": "楽しみにしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "フフッ、いずれにせよ、あなたにとってはメリットしかない旅です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010514,
					"content": "さて、十分休めましたし、このまま<color=#00E1FFFF>モンド</color>まで休まず行きますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010515,
					"content": "はぁ、馬車があったら良かったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010516,
					"content": "最初に疲れてないって言ったのはそっちでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010512,
					"content": "期待しすぎないでおこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "強盗を見抜くなんて、すごい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
