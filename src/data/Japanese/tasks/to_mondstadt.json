			"dialogs": [
				{
					"id": 105010301,
					"content": "私のことは気にしないでください、そもそも食欲そんなにないですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010302,
					"content": "ほんのちょっとだけお腹空いてますけど…全然平気なんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
