					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "あら、どうしましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010202,
					"content": "厨房を貸してほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010203,
					"content": "友人に特別な料理をご馳走したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "なるほど、それなら大丈夫ですよ。食材さえ用意していただければ、自由に使っていただいて構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010206,
					"content": "見たところ、お客様は料理の腕に自信がおありですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010207,
					"content": "もちろん、「美味しそうな」料理が得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "ははっ、さすがですね。実は一つアドバイスがありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010211,
					"content": "お客様の服装からして他国の方ですよね。せっかく璃月に来たんですから、璃月の料理に挑戦してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010212,
					"content": "ここに「月菜」の定番料理「黄金ガニ」のレシピがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010213,
					"content": "カニに小麦粉をつけて揚げ、揚げ終わったらショウガやニンニクと一緒に炒めれば完成です。盛り付けたカニは、まるで黄金の上で寝ているかのように見えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010214,
					"content": "…お、黄金ガニ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010215,
					"content": "手間がかかりそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#黄金ガニ！{NICKNAME}、黄金ガニ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010218,
					"content": "分かった分かった、黄金ガニにしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "へへっ、早速作ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010221,
					"content": "おまえの料理センスなら、きっと簡単に——覚えられるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010219,
					"content": "…パイモンのために覚えよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "モナのためわざわざ料理を覚えるのも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "いや、そこまで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "ははっ、謙虚ですね。実は一つアドバイスがありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 105010204,
					"content": "友人に手料理をご馳走したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
