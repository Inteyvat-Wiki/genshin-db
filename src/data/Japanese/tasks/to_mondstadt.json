					],
					"speakerTitle": "毓華"
				},
				{
					"id": 105011208,
					"content": "ってことは…えっと——そ、そうめんをください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011209,
					"content": "そうめんですね、かしこまりました。お掛けになってお待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "毓華"
				},
				{
