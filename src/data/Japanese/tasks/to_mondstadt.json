			"dialogs": [
				{
					"id": 105011501,
					"content": "うん？こ、この香りは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011502,
						105011504
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011502,
					"content": "そうめんのトッピングだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011503
					]
				},
				{
					"id": 105011503,
					"content": "こんな贅沢なトッピングがあるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011506,
					"content": "わかりました。弟子が私のために頑張ってくれたのです、無下にはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011507,
					"content": "…ななっ！すっごく美味しいです！ここ最近食べた料理の中で一番美味しいですよ、これ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011508,
					"content": "あ、えっと、その…コホン、まさかここまで料理が上手だったとは、師匠として鼻が高いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011509,
					"content": "空腹が満たせたなら良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "璃月料理の美味しさは、さすがと言うべきですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011512,
					"content": "そう考えると、値が張るのも頷けます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011513,
					"content": "いえ、なんでもありません、なんでもありませんよ。お腹もいっぱいになったことですし、そろそろ出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011514,
					"content": "ここから北に行けば<color=#00E1FFFF>石門</color>に着きます。そのまま進めばモンドの国境です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011515,
					"content": "一体、どれほどの深い知識が私たちを待っているのでしょうか？ふふふっ、今から楽しみですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 105011510,
					"content": "嬉しそうに食べてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "モナのために作った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
					"id": 105011505,
					"content": "そ、そうなんですか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
