			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "やっとモンドに着きました。はぁ、疲れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010402,
					"content": "偉大で深い知識を求める道のりは、楽じゃありませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010403,
					"content": "オイラは疲れてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010404,
					"content": "あなたは飛んでるじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010405,
					"content": "なんだ、占星術師って大したことないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010406,
					"content": "それはあなたが占星術に幻想を抱きすぎてるからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010407,
					"content": "やあ、君たちもここで休憩かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010408,
					"content": "ん？誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 105010409,
					"content": "ああ、私たち兄弟は商人だ。璃月で商売を終えて、今からモンドに帰るところなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010410,
					"content": "君たち疲れてるみたいだし、私たちが予約した馬車がもうすぐ来るから一緒にどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010411,
					"content": "確かに少し疲れた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "代金は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "ハハッ、では私たちと一緒に来るといい。ちょうど帰り道の話し相手が欲しかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010414,
					"content": "ついでだし、金はいらないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010415,
					"content": "必要ありません、他に用がなければさっさと消えてくれますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010416,
					"content": "えっ？こちらのお嬢ちゃんは…急にどうしたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010417,
					"content": "下手な芝居はやめたらどうですか、強盗さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010418,
					"content": "弱そうな相手を見つけたら上手いこと馬車に乗せて、荒野で身ぐるみを剥がすつもり、ですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010419,
					"content": "な、何を言ってるんだ！？人の親切を無駄にするだけじゃなく、根拠のないことまで言うなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010420,
					"content": "こちらから願い下げだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010421,
					"content": "では、あなたたちが身につけている物の中から、強盗で得た物を言い当てましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010422,
					"content": "不服なら、被害者を呼んできて確認すれば一発で分かることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010423,
					"content": "もし私が間違えていたら、お詫びに2万モラあげます。逆にもし私が正しかったら、あなたたちには璃月港の刑務所に入ってもらいますけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010424,
					"content": "どうします？まともな商人なら別に構いませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010425,
					"content": "お、お前…ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010426,
					"content": "俺様を怒らせやがって！この小娘が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010427,
					"content": "どうやって知ったかは分からないが、お前を殺せばこの秘密を知るものは誰もいない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "タイラー"
				},
				{
					"id": 105010428,
					"content": "モナ、危ない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "彼女を傷つけさせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "心配はいりません、ただの強盗です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 105010431,
					"content": "さっき、占星術師を「大したことない」と言いましたよね…ちょうど良い機会です、師匠の実力を見せてあげます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
		{
			"id": 1050105,
			"completionStepIds": [
				1050109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
