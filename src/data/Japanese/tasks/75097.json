				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "おぉ、来た来た…おなじみの、七天神像と繋がる感覚だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970302,
					"content": "今まで七天神像が反応しなかったのは、やっぱり夜神の国にいるあの悪者のせいだったんだな！七天神像も大変だったろうな…よく頑張ったな、七天神像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970303,
					"content": "ま、共鳴する力は、おまえがくれたわけじゃないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970304,
					"content": "炎神と一緒に戦った時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "#あの時は本当に心配したぞ…でも、さすが{NICKNAME}、無事に勝てたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970306,
					"content": "アビスの魔物も倒せたし、七天神像も元通りになって、ほんとによかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
