					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "…うーん、やっぱりおかしいぞ。今も七天神像から元素力をもらえないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970202,
					"content": "うぅ…七天神像になにが起きたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970203,
					"content": "長い間メンテナンスされていないのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "触ったらちゃんと光るのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970205,
					"content": "おーい、七天神像…おまえ、ちゃんと仕事してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970208,
					"content": "まったく手がかりがないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970206,
					"content": "ナタが特別だからかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "そういえば、ナタはずっとアビスの影響を受けてるみたいだよな。まさか、それが原因なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "パイモン"
				}
			]
		},
