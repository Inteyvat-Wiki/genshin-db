			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "あれ？ナタの七天神像…なんだかちょっと変じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970102,
					"content": "はじめての神像に触れるときって、もっと強烈な…なんていうか…「ポワーン」って感じがあっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970103,
					"content": "そうでもないと思うけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "う～ん、変な気がするんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970108,
					"content": "ええと、なんていうか…他の神像に触れたときは、もっと安定した繋がりができた気がするんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970109,
					"content": "でも、今回はスイッチを入れただけみたいな、押したら光るだけって感じがして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970110,
					"content": "そうだ！今まで神像に触れたら元素の力を感じてただろ。今回はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970111,
					"content": "炎元素の…えーっと…元気いっぱいな、情熱的な感じはするか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970112,
					"content": "（身体の中の変化を感じ取ってみよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "えっ、少しもないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970115,
					"content": "なんだかおかしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970113,
					"content": "（…思ってたような「熱」は感じない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "#実は毎回{M#俺}{F#私}が「ポワーン」って言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "そ、そうだったのか！？じゃあ、「ポワーン」を言い忘れちゃっただけか。次からは気をつけろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750970107,
					"content": "ってそんなわけないだろ！七天神像に触るとき、自分で効果音をつけるやつがいるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
