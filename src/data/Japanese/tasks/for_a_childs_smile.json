				"points": []
			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "あっさりと見つかってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250502,
					"content": "まだまだ経験不足だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "ここならバレないと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250505,
					"content": "いつもぼくが追っている妖魔たちは、どいつも隠れるのが上手なんだ。ヤツらが今までどんな場所に潜んでいたか、まとめてあるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250506,
					"content": "ここみたいに四方が囲まれていて埃が積もるような場所は、光も差さないから妖魔が隠れるのに最適なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250507,
					"content": "かくれんぼと妖魔退治を結び付けるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "だが、あまり参考にならなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250511,
					"content": "見つかったからには、負けを認めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250512,
					"content": "簡単な遊びではあるが、参加しているうちに面白くなってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250513,
					"content": "また一緒にやろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "ああ、もっとたくさんの友人を集めてまたやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250517,
					"content": "さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250515,
					"content": "重雲が鬼じゃなくてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "はは、お前の言う通りだ。ぼくが鬼だったら、2時間あっても見つけられなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250509,
					"content": "バレバレだったけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "くっ、緊張しすぎて一番大事なことを忘れてしまっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 190250503,
					"content": "…なんでここに隠れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
