			"dialogs": [
				{
					"id": 210310201,
					"content": "痕跡が全然ないけど…ここの魔物を倒したのは、一体誰なんだろう。もしかして…他の冒険者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210310202,
					"content": "うぅ…気になるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210310203,
					"content": "でもまあ、魔物は全部倒されてるし、戻ってこのことを淮安に教えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
