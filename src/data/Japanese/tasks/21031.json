					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "はぁ…何とかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "あなたでしたか。はぁ…あのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310104,
					"content": "最近旅館の経営がうまくいっていて、泊まりにいらっしゃるお客様も増えてきています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310105,
					"content": "静かな時間を過ごしたいと言って一人でいらっしゃるお客様もいれば、家族を連れて旅行にいらっしゃるお客様もいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310106,
					"content": "はぁ、旅館がうまくいっているのはいいことなのですが、この近くでうろついている魔物がたくさんいましてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310107,
					"content": "子供が外に遊びに行ったり、お年寄りが散歩しに出かけたりした時、あの魔物たちに出会いでもしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310108,
					"content": "そんなことが起きるのを防ぐために、旅館の周りにいる魔物を追い払わなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310109,
					"content": "しかし、私一人では多くの魔物を追い払うことができなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310110,
					"content": "旅人さん、手伝ってくれませんか？もちろん、報酬は弾みますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310111,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "それではお願いしますね。前からいくつか魔物の拠点があることに気付いてはいるのですが、中には危ない魔物もたくさんいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310116,
					"content": "それに、旅館の近くまで来て、そこに拠点を作っている魔物たちもいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310117,
					"content": "うわー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310118,
					"content": "そうですね、危険な魔物たちは私がなんとかしますから、旅館の周りの魔物はあなたにお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310119,
					"content": "魔物たちを追い払ったら、また旅館で策を練りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310120,
					"content": "この魔物たち、本当に厄介ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}はかなりの実力者のはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "私ですか？それは…恐縮です、まずまずといったところですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310114,
					"content": "でも私一人では、あの魔物たちを全部倒せないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "淮安"
				}
			]
		},
		{
