			"dialogs": [
				{
					"id": 210310401,
					"content": "戻りましたか、いやはや…あの魔物たちはなかなか手強いですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310402,
					"content": "あの魔物を全部倒したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "ははは、一苦労でしたよ。やはり年を取ってから、思うように動けなくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310404,
					"content": "あなたもあの魔物たちを片付けたのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310405,
					"content": "魔物の拠点について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "魔物は全て倒されていて…しかし拠点に人影は見えなかったと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310407,
					"content": "それはおかしいですね。もしかして、通りかかった冒険者が、あの魔物を倒したのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 210310408,
					"content": "とにかく、見回りに行ってくださり、ありがとうございました。報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
