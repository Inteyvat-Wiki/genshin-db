					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "魔物に遭遇したから、始末しただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "魈"
				},
				{
					"id": 210310305,
					"content": "このあたりは安全じゃない。お前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "魈"
				},
				{
					"id": 210310306,
					"content": "気を付けるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "ああ。我は他に用があるから、もう行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
