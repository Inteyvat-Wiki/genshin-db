			},
			"dialogs": [
				{
					"id": 710120101,
					"content": "「風が新たな物語を運び、時間はそれを神話にする。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "ボロボロの刻字"
				},
				{
					"id": 710120102,
					"content": "どういう意味だ…全然分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710120103,
					"content": "うーん、でも、ここは何か秘密がある気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710120104,
					"content": "周りを見てみよう、もしかしたら何か手がかりがあるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101215",
							"3"
						],
						"stepId": 7101215,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "「風が新たな物語を運び、時間はそれを神話にする。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "ボロボロの刻字"
				},
				{
					"id": 710120202,
					"content": "あのノートに書いてある日時計は、おそらくこれだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710120203,
					"content": "でも、この日時計は一体どこが違うんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710120204,
					"content": "うーん…もう一度あのノートを確認しようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘンリーモートン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "うん？旅人、ここに何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121002,
					"content": "狂風のコアについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "狂風のコア？私はずっとここにいたけど、そういったものは見ていないな。激しい風はさっき吹いていたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121004,
					"content": "でも狂風のコアは絶対いなかった。あんなデカいやつが現れたら、私は絶対忘れないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121005,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "信じてくれよ、私の研究を邪魔するやつが現れたら、私は絶対忘れないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121009,
					"content": "正確に言うと…私の友達と研究している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121010,
					"content": "私の友達も学者だ、かつて一緒にスメール教令院で勉強していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121011,
					"content": "その後、彼は考古学者として世界各地を考察に行った。そして私はスメール教令院で学問を続けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121012,
					"content": "彼がモンドに来た時、モンドの千風の神殿を考察しているって彼に言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121013,
					"content": "「お前の故郷の秘密を見つけたら、最初にお前に教えるさ」って言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121014,
					"content": "しかしその後、彼との連絡が途切れた。友達を探してほしいとサイリュスに手紙を送った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121015,
					"content": "けど何の情報も入らなかったから、私はスメールでの勉強を中止し、一人で帰ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121016,
					"content": "しかし此処も日時計以外、何の手がかりもなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121017,
					"content": "あの島の日時計について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "何！？同じ日時計があるって？しかも海上の孤島に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121019,
					"content": "あ、思い出した。天気がいい時に見たことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121020,
					"content": "待って、あの島にある日時計の隣に…ノートがあったって？まさかあいつあの島に行ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121021,
					"content": "ありがとう、機会があればあの島に行ってみる。今はここの研究をしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "ヘンリーモートン"
				},
				{
					"id": 710121022,
					"content": "私は研究に戻る。もし興味があれば、私のノートを見てみて、そこに置いてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "ヘンリーモートン"
