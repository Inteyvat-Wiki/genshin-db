			"trigger": {
				"objectNames": [
					"サラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "分かった、すぐに出発するね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4890102,
					"content": "おっ、アンバーだ！もしかして依頼の件かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890103,
					"content": "あっ、あんたたちも来てくれたんだ。今から出発するところだよ。ヒルチャールの討伐はこの偵察騎士に任せて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4890104,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890105,
					"content": "サラさん…どうしたの？安心して、偵察騎士の実力は本物なんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4890106,
					"content": "あっ、ごめんなさい、実力を疑ったわけじゃないの。お店のオーダーがあまりにも多くて、ちょっと困ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890107,
					"content": "今もまた変なオーダーが来たんです。それでパーティー用のお料理を準備することに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890108,
					"content": "えーっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4890109,
					"content": "何か手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "料理なら手伝えるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "えっ、いいの？お手伝いしていただけるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890112,
					"content": "よかったぁ…あなたは「鹿狩り」の恩人です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890113,
					"content": "あ、あれっ…わたしの見せ場が取られた気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4890114,
					"content": "じゃあ、この新しいオーダーはあなたにお任せしますね。まずは食材集めから始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890115,
					"content": "#でも…{NICKNAME}…大丈夫なのか？料理の味とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890116,
					"content": "そこは気にしないでください。これは「鹿狩り」の名誉に関わる戦いです、あれこれと選り好みはいたしません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890117,
					"content": "た、戦い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890118,
					"content": "それじゃあ、<color=#00E1FFFF>スイートフラワー三つと鳥肉三つ</color>お願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890119,
					"content": "さあ、早く準備してください。アンバーさんもお願いしますね。ここで待ってますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890120,
					"content": "お、おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				}
			]
		},
