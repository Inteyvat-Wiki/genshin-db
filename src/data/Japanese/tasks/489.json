			"dialogs": [
				{
					"id": 4890301,
					"content": "鳥肉のスイートフラワー漬け焼き、はい、確かに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890302,
					"content": "くんくん…いい香り！料理がお上手なんですね、頼んでよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890303,
					"content": "あと…<color=#00E1FFFF>ニンジンとお肉のハニーソテー</color>もお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>ニンジンとお肉のハニーソテー</color>！確かこの前、アンバーと一緒に食べたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890305,
					"content": "はい、「鹿狩り」の看板メニューなんです。「鹿狩り」の誇りがぎゅっと詰まってます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890306,
					"content": "騎士団の会食でも、よくご注文をいただくんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890307,
					"content": "では、<color=#00E1FFFF>ニンジンとお肉のハニーソテー</color>のレシピを教えますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890308,
					"content": "おいおい、「鹿狩り」の看板メニューのレシピをそう簡単に教えて大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890309,
					"content": "あなたの料理の腕なら、「鹿狩り」の看板に泥を塗るようなことはありませんから大丈夫ですよ、ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890310,
					"content": "<color=#00E1FFFF>ニンジンとお肉のハニーソテー</color>が一つ完成したら、こちらに持ってきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				}
			]
