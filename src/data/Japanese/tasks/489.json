			"dialogs": [
				{
					"id": 4890201,
					"content": "食材を持ってきたんですか？確認しますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890202,
					"content": "うん、合ってますね、食材は揃いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890203,
					"content": "じゃあ…7番卓からのオーダーです、<color=#00E1FFFF>鳥肉のスイートフラワー漬け焼き</color>を一つお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 4890204,
					"content": "完璧に旅人のことを料理人扱いしてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4890205,
					"content": "「鹿狩り」の手伝いをしてくれるんでしょう？出来立ての美味しいのをお願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				}
			]
		},
