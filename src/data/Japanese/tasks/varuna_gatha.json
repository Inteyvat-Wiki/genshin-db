				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#ナラ{NICKNAME}、ありがとなのです。この先はアランパンドゥに任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141502,
					"content": "でも、かなり久しぶりです。うまくいくかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141503,
					"content": "ええっ！？失敗する可能性もあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141504,
					"content": "前はうまくいったのです。今回は分かりません。前とその前は太陽が昇っても、次も昇るかは誰にも分からないのとおんなじです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141505,
					"content": "次に太陽が昇ったとき、パイモンは初めて「あ、太陽が昇った」と言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141506,
					"content": "うえーん…こわいぞぉ…万が一太陽が昇らなかったらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141507,
					"content": "#パイモン、安心してください。ナラ{NICKNAME}はナラヴァルナとおんなじ、太陽のような金色。それに勇敢なナラです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141508,
					"content": "#ナラヴァルナは月と太陽を取り戻してくれました。ナラ{NICKNAME}にもきっとできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141509,
					"content": "#…うん！オイラも{NICKNAME}を信じる。{NICKNAME}なら、どんな困難も乗り越えられるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141510,
					"content": "ドーンと任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "でもここは、アランパンドゥに任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141512,
					"content": "お——これは…成功か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141513,
					"content": "はい。ここの枝と葉っぱは治ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141514,
					"content": "やったな！それにしても…アランナラのダンス、面白すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141515,
					"content": "パイモンもアランナラに習ってみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "それいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141517,
					"content": "パイモンは食べすぎ。運動した方がいいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#ううっ！運動は、{NICKNAME}にくっついてあちこち飛び回るだけで十分だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141519,
					"content": "でもこれだけじゃ、ヴァルナ神器は治らないんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141520,
					"content": "ヴァーナにはこういうのがあと三か所点在してます。アランバリカは強いから、多分大丈夫…でもアランナクラとアランコンティがとても心配です。異常な雨のせいで、ヴァーナの危険が増しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141521,
					"content": "#オイラと{NICKNAME}が、みんなの様子を見て来ようか。だってヴァルナ神器が治らなきゃ、安心してウツァヴ祭ができないんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141522,
					"content": "#パイモンとナラ{NICKNAME}の協力があれば、ヴァルナ神器はきっと治るのです。ヴァーナも昔のような活気を取り戻すハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141523,
					"content": "アランナクラは<color=#00E1FFFF>ヤスナ幽境</color>へ行きました。ヴァーナの奥深くに、アランナラがナラヴァルナを記念して作った場所があります。でも「キノコン」と「胞子」のせいで、ずっと足は遠のいたまま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141524,
					"content": "アランナクラは土や種と一緒にいるのに慣れているのです。土から生まれたものに詳しいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141525,
					"content": "無事に会えたら、アランパンドゥの名前を伝えれば、怖がらせずにすむのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141526,
					"content": "へえ、どうやら気の弱いアランナラみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141527,
					"content": "#アランバリカのアランラカラリは強いです！でも…やっぱりパイモンとナラ{NICKNAME}に様子を見に行っていただけたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141528,
					"content": "#アランバリカは<color=#00E1FFFF>ダーリ遺跡</color>にいるのです。あそこは鉄のにおいがひどくて…パイモンとナラ{NICKNAME}も気をつけてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141529,
					"content": "うん、気をつけるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "アランコンティは夢の入口がある<color=#00E1FFFF>夢の林</color>にいるのです。ナラになじみがないので、隠れちゃうかもしれません。そのときは我々の音楽を奏でてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141531,
					"content": "そういえば前にアランナラの楽譜をもらったな。アランコンティが見つからなかったら、音楽を演奏してみるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141532,
					"content": "アランパンドゥは「休憩所」で、ヴァーナの状況を観察してるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141533,
					"content": "アランナクラ、アランバリカ、アランコンティがみんな了解して、枝と葉っぱが治ったら「休憩所」で落ち合いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141534,
					"content": "#金色のナラ、勇敢なナラ。アランムフクンダがナラ{NICKNAME}を守ってくれるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141535,
					"content": "わかったぞ！オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランパンドゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "うわぁ！さっきのあれなんだ！？壮観だな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141702,
					"content": "#ナラ{NICKNAME}とパイモンはいま知りました。あれがヴァルナ秘宝です。ヴァルナ神器はもっと奥、根と同じ深さのところにあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141703,
					"content": "オイラたち、ナラヴァルナを甘く見すぎてたな。まさかこんなにデカいとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141704,
					"content": "この力はあなどれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "黒い雨が降る前、ナラヴァルナがヴァーナに来る前、アランムフクンダと草木の王がヴァルナ神器を作り、雨水がたくさんのものを生み出しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141706,
					"content": "黒い雨と黒い土、それにたくさんの良くないものがヴァーナを滅茶苦茶にしたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141707,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}に会うまで、あんなに勇敢なナラを見たことがありませんでした。太陽のように眠る霧を追い払い、アランナラと一緒にヴァルナ神器を治しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141708,
					"content": "今、ナラヴァルナはヴァナラーナにいません。アランムフクンダもヴァナラーナにいません…でもアランナラはまたヴァルナ神器を治さなければなりません。ウツァヴ祭のため、ヴァーナのため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141709,
					"content": "オイラたち、前にアランラジャやアランマと一緒に祭りの準備をするって約束したんだ。ほら、ナラも大勢で薪を拾えばたき火の火は高くなるってことわざ、あるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141710,
					"content": "フギュ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141711,
					"content": "あ、いやいや違うぞ！オイラは、ナラが大勢いれば物事がスムーズに進むって言いたかったんだ！怖がるなよ、火は関係ない。一切関係ないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141712,
					"content": "パイモン、そういうのを「藪蛇」っていうんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "うぅ…せっかくスメールに来たことだし、物知りってとこをアピールしようと思ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141714,
					"content": "#アランパンドゥは怖くありません。パイモンは親切です。ナラ{NICKNAME}と同じ、ナラヴァルナと同じ、アランナラの仲間なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141715,
					"content": "アランナクラ、アランバリカ、アランコンティは、アランパンドゥと一緒にヴァルナ神器を治すつもりです。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141716,
					"content": "「胞子」と「キノコン」が多すぎて、どうにもなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141717,
					"content": "アランパンドゥには、アランバリカみたいにすごいアランラカラリはないです。「キノコン」は異常な雨のせいで狂暴になったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141718,
					"content": "ちょい待った。「アランラカラリ」って…前にアランラナが言ってたマラーナを防げるっていうやつか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141719,
					"content": "アランラカラリが強いと、「キノコン」を追い払えます。アランパンドゥのアランラカラリは弱い…だから「キノコン」には太刀打ちできないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141720,
					"content": "え？アランラカラリってそんなことができるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141721,
					"content": "きっと何かの能力の総称だろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#ナラ{NICKNAME}はパイモンより賢いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141723,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141724,
					"content": "アランナラによって、持ってるアランラカラリは違うのです。でもアランナラはみんな、ヴァーナの草木からアランラカラリを操る能力をもらっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141725,
					"content": "アランバリカのアランラカラリは強いです。大きな「キノコン」、それに鉄の大きいナラにだってひるみません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141726,
					"content": "鉄の大きいナラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141727,
					"content": "#鉄の大きいナラは大きいです。ナラ{NICKNAME}と同じ、二つの手と、二つの脚があります。でも目は一つだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141728,
					"content": "あ、それって遺跡守衛だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141729,
					"content": "パイモン、冴えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141731,
					"content": "あ！そこの木の上にも「キノコン」が…アランバリカなら勝てます。でもアランパンドゥはダメです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141732,
					"content": "#ナラ{NICKNAME}も「キノコン」が怖くないです。アランラカラリは使いませんが、とても強いです。強風が木の葉を吹き飛ばすみたいに、ピューッ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141733,
					"content": "#放っておけば、「胞子」と「キノコン」は増え続けます…ナラ{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "アランパンドゥ"
				},
