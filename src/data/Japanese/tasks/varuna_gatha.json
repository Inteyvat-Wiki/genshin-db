			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランパンドゥ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "あ、ナラだ。金色のナラ、勇敢なナラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140302,
					"content": "#オイラはパイモン。こいつは{NICKNAME}だ。ヴァナラーナじゃみんなでウツァヴ祭の準備をしてるっていうのに、なんでおまえだけぽつんとこんなところにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140303,
					"content": "アランパンドゥには大事な仕事があるのです。ウツァヴ祭のため、アパーム叢林のため、ナラヴァルナのため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140304,
					"content": "ってことは、おまえがアランパンドゥか。でもナラヴァルナって？どっかで聞いたことのある名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140305,
					"content": "#ナラヴァルナ…{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はナラ{NICKNAME}とおんなじ。金色で勇敢なナラです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140306,
					"content": "月や太陽が見えなくなると、ヴァーナでは大木ですら牙をむく風に葉を咬み落とされ、黒い雨に枝を侵食されてしまうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140307,
					"content": "ヴァーナの痛みがガサッと泥沼に落ちて、鉄や塩のにおいだらけになったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140308,
					"content": "うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140309,
					"content": "でも、何度か陽が落ちて昇った頃、ナラヴァルナがやって来たのです。金色のナラは、金色の言葉を話したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140310,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}とアランナラは一緒に月と太陽を取り戻しました。ヴァルナ神器がヴァーナの痛みを洗い落とすと、それきり黒い雨は降りませんでした。鉄や塩の臭いも消えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140311,
					"content": "ヴァナラーナのみんなはナラヴァルナに感謝したのです。みんなは太陽や土、雨露と同じように、ナラヴァルナを愛したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140312,
					"content": "へえ、すごいぜ！そいつはきっといいナラだったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140313,
					"content": "#でもさ、ふふん、ナラ{NICKNAME}だってたくさん人助けをして、感謝されてるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140314,
					"content": "#アランパンドゥも、きっとナラ{NICKNAME}を気に入ると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140315,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}がヴァナラーナを離れたあと、たくさんのものが泥の中から生まれて、また泥の中へ帰っていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140317,
					"content": "ヴァルナ神器の枝や葉っぱは力をなくし、ヴァルナ秘宝は驚いた雀の群れのようにバタバタと羽を震わせ、大量の雨が降り注ぎ異変が起きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140318,
					"content": "走るキノコがヴァーナに棲みついて、辺りは未知の種でいっぱいになったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140319,
					"content": "…それってキノコンと胞子のこと？でもヴァルナ神器とヴァルナ秘宝ってのはなに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140320,
					"content": "めちゃくちゃ強い武器とか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140321,
					"content": "ワルカを一刀両断できる刀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "いくらなんでもそれは凄すぎだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140327,
					"content": "#ううん…違う違う。ナラ{NICKNAME}もパイモンも間違いなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140328,
					"content": "高い所に行きましょう。アランパンドゥが教えてあげるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730140323,
					"content": "武器じゃないのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "じゃあなに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730140325,
					"content": "水でできた羽付きアランナラ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "水の幻形生物でもないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "パイモン"
				}
			]
		},
