			},
			"dialogs": [
				{
					"id": 730141001,
					"content": "ここが「休憩所」か。アランナラがいた痕跡があるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141002,
					"content": "ここからヴァルナ神器を見ると、さらに壮観だな。うーん…かなりの威圧感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141003,
					"content": "パイモン、巻き込まれないように気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "そんなことあるわけないだろ！…多分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141005,
					"content": "約束したのです。ヴァルナ神器の枝や葉っぱが治ったら、「休憩所」で落ち合おうと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141006,
					"content": "それからヴァルナ神器の根をかじる悪い虫を追い払って、ヴァルナ神器を治すのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141007,
					"content": "さっき言ってたヴァルナ神器の「枝」と「葉っぱ」って、一体なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141008,
					"content": "ヴァルナ神器の枝や葉っぱは、ヴァーナの至る所にあります。それがヴァルナ神器に力をもたらし、黒い雨を良い雨に変えて、誕生の雨を降らせるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141009,
					"content": "雨水が小川に流れ込み、小川が湖に流れ込むように、枝と葉っぱが一滴一滴をヴァルナ神器に集めるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141010,
					"content": "今のヴァルナ神器は昔とは違います。折れた小枝が雨水を防いでいるかのように、雨水が小川に流れ込まないのです。小川がなければ、湖は枯れてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141011,
					"content": "うーん…なんかピンとこないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141012,
					"content": "パイモンがはらぺこなのと同じってこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "ふむ、確かにごはんを食べないとやる気が出ないよな。つまりヴァルナ神器は腹ペコだからすねてるってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141014,
					"content": "そうじゃないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "そっか。腹ペコだと拗ねる気力もわかないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141021,
					"content": "とにかく、今は「枝」と「葉っぱ」を治さなきゃいけないんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141022,
					"content": "#はい。アランパンドゥがパイモンとナラ{NICKNAME}を案内するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730141016,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "荷運びの途中で通せんぼされたみたいな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "障害物を全部取り除かないと、前に進めないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141019,
					"content": "って、違う道を通ればいいだけだろ！誰がそんなルートを設定したんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730141020,
					"content": "確かに。誰がルートを設定したんだろうね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
			]
		},
