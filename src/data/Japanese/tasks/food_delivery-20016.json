			"dialogs": [
				{
					"id": 200160101,
					"content": "出前オーダー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160102,
					"content": "旅人！ちょうどよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160103,
					"content": "ごめんなさい、お腹空いていますよね。でも少し手伝ってほしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160104,
					"content": "最近出前のオーダーが増えてきて、いつもはオーダーをエリアごとに分けてから、注文者のタグをつけるようにしてますけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160105,
					"content": "この<color=#00E1FFFF>ドドリアン海鮮スープ</color>のタグをうっかりなくしてしまって、注文者が清泉町にいることしか分からないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160106,
					"content": "この<color=#00E1FFFF>ドドリアン海鮮スープ</color>を清泉町に届けて、誰が注文したか探してくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160107,
					"content": "いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "戻ってきたら、お礼にごちそうしますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160109,
					"content": "お願いです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				},
				{
					"id": 200160110,
					"content": "お腹空いた、食事しに来ただけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "このお願いを聞いてくれたら、鹿狩りのスペシャルコースをご馳走しますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サラ"
				}
			]
		},
