			"dialogs": [
				{
					"id": 230100301,
					"content": "これはとてもよいミントだ。少し待っていてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100302,
					"content": "ジャファルは他の食材を出して料理を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "これが君の持ってきてくれた食材で作った「ミントビーンスープ」だよ。さあ、召し上がれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100304,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "気にしないで。まずはこの美味を堪能しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100306,
					"content": "僕にとって、美味しいものを食べる時間は、面倒な課題や研究をすべて忘れさせてくれるものなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100307,
					"content": "そうして自分の思考を…音も立てず流れる、静かな小川の流れに任せる…これが僕の休みかただ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100308,
					"content": "さあ、君もじっくり味わってくれ。これで、君の頭の中も落ち着くといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャファル"
				}
			]
