					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100704
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100704,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100705
					]
				},
				{
					"id": 230100705,
					"content": "気にしないで。まずはこの美味を堪能しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100706
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100706,
					"content": "僕にとって、美味しいものを食べる時間は、面倒な課題や研究をすべて忘れさせてくれるものなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100707
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100707,
					"content": "そうして自分の思考を…音も立てず流れる、静かな小川の流れに任せる…これが僕の休みかただ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100708,
					"content": "さあ、君もじっくり味わってくれ。これで、君の頭の中も落ち着くといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャファル"
				}
			]
		},
