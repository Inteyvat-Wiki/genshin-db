			"dialogs": [
				{
					"id": 230100801,
					"content": "そこの人、なにか焦っているようだけど、悩み事でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100802,
					"content": "まあ色々と…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "ふむ…疲れているにも関わらず、急がねばならない焦燥に駆られているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100804,
					"content": "その問題についてまだ悩んでいる最中にも関らず、一刻も早く答えを出す必要に迫られているとみた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100809,
					"content": "少し、僕に付き合ってはくれないか。一緒に座って、美味しいものでも食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100810,
					"content": "あちこち走り回るのは人生の常とはいえ…荒れ狂う川の水も、静かな小川では音も立てず流れるという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100811,
					"content": "どれだけ忙しいとしても、休むことを忘れてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100812,
					"content": "そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100813,
					"content": "僕と一緒に「シャワルマサンド」を食べないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100814,
					"content": "モラは要らない。ただ獣肉を1つ手に入れてくれればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100815,
					"content": "どんな方法で手に入れた獣肉でも構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100816,
					"content": "いいね、獣肉を1つ手に入れてくれればいいんだ。簡単だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100805,
					"content": "いや、別に大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "うん、それならいいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100807,
					"content": "でも、そんなに急いでいるんだ。やはり、何か解決すべき問題があるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "ジャファル"
				},
				{
					"id": 230100808,
					"content": "…どんな問題を抱えているのかはわからないけど、1つ提案がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "ジャファル"
				}
