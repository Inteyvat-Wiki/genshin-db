			"dialogs": [
				{
					"id": 755050201,
					"content": "ここだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050202
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050202,
					"content": "ほらね、アビスに汚染されたミツムシは、普通のよりだいぶおっきいっしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050203,
					"content": "でっかいな…危なくないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050204,
					"content": "安心して。アビスに汚染されてても、習性は変わってないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050205,
					"content": "特大サイズの虫取り網を作ってきたんだ。はい、持ってて。これでミツムシを捕まえるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050206,
					"content": "あ、そうだ。キィニチが言ってたけど——アビスのミツムシが活動するエリアには、決まってある特別な実が見つかったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050207,
					"content": "実には、ミツムシを麻痺させる成分が含まれてるらしい。それを虫取り網に塗り付ければ、ムシの動きを簡単に抑えられると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050208,
					"content": "ん？その周りじゃ体が麻痺しちゃうんだろ？なのに、なんでわざわざ近くにいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050209,
					"content": "ウチもそう思った。不利な環境に敢えている動物なんて、初めて見たよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050210,
					"content": "だよな？もしかして、ミツムシの汚染って、誰かの仕業なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050211,
					"content": "パイモン、嗅覚が鋭くなったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "フン、おばかなガイドでも成長するもんだけど、オイラはもともと賢いからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050213,
					"content": "残念だけど、再三探しても人為的な痕跡は見つからなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050214,
					"content": "とりあえず、ミツムシの謎の習性とでも考えておくしかないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050215,
					"content": "だな。まずはミツムシを捕まえようぜ。これ以上病気になる人が増えたらまずいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050216,
					"content": "虫捕り隊、出撃だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
