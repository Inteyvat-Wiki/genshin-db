					{
						"sceneId": 3,
						"position": [
							-1372.812,
							169.291,
							7665.692
						],
						"pointId": 350400242
					},
					{
						"sceneId": 3,
						"position": [
							-1373.609,
							169.233,
							7665.231
						],
						"pointId": 350400243
					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "おお、シロネン！こんなところで会えるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050102,
					"content": "よっ、パイっち、旅人。ウチの家の前で会うのがそんなに珍しい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050103,
					"content": "あ、いや、大事件を解決したばかりだから、てっきり、どっか立派な木の上で何日かはのんびり寝てるのかなって思っててさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050104,
					"content": "ははっ、確かにそうしようかなとも思ったけど、みんなが復興作業で大忙しの時期に、ウチだけサボるわけにもいかないっしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050105,
					"content": "復興作業をしてたってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "ほら、これ見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050107,
					"content": "わぁ！きれいな宝石だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050108,
					"content": "貴重なものじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "そう。でも、それだけじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050112,
					"content": "最近市場に出回ってる、特殊な模様の燃素蜜珠なの。燃素蜜珠ってのは、燃素ミツムシが分泌するもので、別に珍しいものじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050113,
					"content": "でも、こーゆー変わった模様の燃素蜜珠は、希少性が高くてかなりの値がつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050114,
					"content": "なんとなくわかるぞ…宝箱を見つけたときも、外側の模様がすごそうだと「おおっ」ってなるもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050115,
					"content": "ははっ。まあとにかく、それでウチもいくつか買ってきたんだよ。でも、数日したら、隣に置いてあった鉢植えが枯れちゃってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050116,
					"content": "最初はあまり気にしてなかった。もともと植物育てるのなんか得意なほうじゃないしね。でもそのあと、部族に体調を崩した人たちがいるってカチーナから聞いたわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050117,
					"content": "しかも、そのほとんどはチョウエンのジュエリーショップのお客さんらしい。オーナーのチョウエンも被害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050118,
					"content": "えっ？ってことは…この宝石と関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050119,
					"content": "そう踏んでる。そんで蜜珠を砕いてみたら、なんと中にはアビスのエネルギー閉じ込められてたってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050120,
					"content": "ただ、濃度はめちゃくちゃ低いし、蜜珠の外殻に包まれてるから、外からはほとんど分からないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050121,
					"content": "体調を崩した人たちはどんな状況？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "心配ないよ。幸い濃度が低かったから、そんなに酷い症状は出てない。眠気に襲われたり、疲れを感じやすかったりって程度かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050123,
					"content": "ウチとカチーナは普段から鍛えてるし、全然影響ナシ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050124,
					"content": "ふぅ…S級でよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050125,
					"content": "S級？ひどい被害だってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050126,
					"content": "「スライム級」のSだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "へへっ、やっぱりおまえはオイラのことをよく分かってるな。ほらさ、スライムの被害ってそんなにひどくないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050128,
					"content": "あはは、さすが最強コンビだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050129,
					"content": "でも、スライムが怖くてブルブル震えるやつもいるわけだし、やっぱ放っておくわけにはいかないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050130,
					"content": "だね。すでに族長に状況を報告して、市場に出回っている変わった模様の蜜珠を回収して処分してもらうことにしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050131,
					"content": "元からも絶たないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "同感。さっきも言ったけど、燃素蜜珠は燃素ミツムシの産物だから、元を絶つとすればそこでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050133,
					"content": "こういう調査に関してはキィニチがプロだから、あいつに聞いてみてて。昨日ちょうど連絡が来たんだけど、アビスに汚染されたミツムシを見つけたんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050134,
					"content": "「懸木の民」と「流泉の衆」の近くにもそのミツムシの痕跡が見られたって。もうムアラニにも知らせてくれてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050135,
					"content": "まー、あっちの部族の人たちは宝石にあんま興味ないし、大した影響はなかったみたいだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050136,
					"content": "そっか…アビスにちなんだ問題はまだまだ残ってたんだな。地道に取り除いてくしかないってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050137,
					"content": "ミツムシをどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "捕まえて浄化するつもり。その程度なら、ウチにもミツムシの生命に危険が及ばないように浄化できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050139,
					"content": "キィニチがミツムシが集まってる場所をマークしてくれたから、集落の周辺に向かおうと思ってたとこだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050140,
					"content": "あっ、二人も一緒に来る？ミツムシを捕まえるのもけっこー面白いと思うよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050141,
					"content": "カチーナも誘ったんだけど、他の仕事で忙しいんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050142,
					"content": "サボりたいだけでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "えー、木の上で寝っ転がって高みの見物決め込む気なんてないって。ちゃんと働く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050144,
					"content": "冗談だよ、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "サンキュ、退屈しなくて済みそ。じゃ、いこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050146,
					"content": "喜んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "サンキュ、退屈しなくて済みそ。じゃ、いこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050148,
					"content": "面白くなさそうだし、やめとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "えぇ～ウチ一人じゃつまんないよ…プレゼントも用意してるのになー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050150,
					"content": "おっ！報酬もあるのか！？なんだなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050151,
					"content": "キラッキラのめっちゃきれいなやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050152,
					"content": "#わぁ、モラ！{NICKNAME}、儲けるチャンスだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050153,
					"content": "さっきのは冗談だよ。出発しよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "ははっ、じゃあ行こ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050155,
					"content": "モラがもらえるなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "ははっ、じゃあ行こ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050110,
					"content": "なんか変な感じがする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "さすがだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "シロネン"
				}
			]
		},
