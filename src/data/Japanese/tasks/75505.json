			"dialogs": [
				{
					"id": 755050301,
					"content": "ふぅ…捕まえた。こいつ、デカいけど、わりと簡単に捕まってくれたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050302,
					"content": "逃げようとしてるとこを除けば、全然危なくないな。虫取り網と実も使えてるみたいだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050303,
					"content": "はは。とはいっても、アビスに汚染されてるんだから、油断禁物ね。魔物が引き寄せられてくるかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050304
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050304,
					"content": "おう！それと、あのタイミングよく出てきた実のことも警戒しないとだよな。もしオイラなら、絶対に敵に近づいたりしないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050305,
					"content": "#どう見てもこれはミツムシの本能に逆らってるよな。{NICKNAME}、やっぱりここは怪しいぞ。絶対に警戒を怠るなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050306,
					"content": "すっかりプロの顔だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050307
					]
				},
				{
					"id": 755050307,
					"content": "へへっ、おまえから学ばせてもらったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755050308,
					"content": "ふわぁ～…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050309
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050309,
					"content": "今日は付き合ってくれてありがとね。とりあえず、ミツムシ密集地帯は一つ潰せたし、そろそろ休もっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050310
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755050310,
					"content": "これからしばらくよろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				}
			]
