				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "#ありがとう、{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260302,
					"content": "止まり木の調子もいいみたい。今回の祭典はきっとうまくいくと思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260303,
					"content": "楽勝だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "すごく怖かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#ふふん、なんてったって、オイラと{NICKNAME}はいろんなものを見てきたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260306,
					"content": "#それじゃあさ、{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}とパイモンは、どこから来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260307,
					"content": "#前に「稲妻」とか、「鳴神島」のことは聞いたことあるけど、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}たちも稲妻の人なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260308,
					"content": "どちらかというと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "おう！オイラたち、たしかに鳴神島から来たけど…あっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260310,
					"content": "マウシロを探しに来てたことを忘れてたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260311,
					"content": "凄く遠いところから来た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "ああ、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260314,
					"content": "すごい！龍の上に乗れるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260315,
					"content": "座り心地はよくなかったけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "大したことじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "すごいなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260318,
					"content": "世界は広いんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260319,
					"content": "まさか、「霧海」の外にそんなたくさんの場所があって、人がいっぱいいるだなんて…いつか外に行けたら、その場所を見に行きたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260320,
					"content": "他の人はいつも、霧から離れたら魂がさまようことになるって言うんだ。でも霧があるおかげで、外の暗闇が鶴観に入ってこられないんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260321,
					"content": "でも僕、ここの外から来た人とたくさん出会ってきた。だから、寂海にも人が住んでるって知ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260322,
					"content": "機会があったら一緒に見に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "うん、約束だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260324,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、先に行ってていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722260325,
					"content": "祭典が終わったら、一緒に鶴観の外を見に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722260326,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルー"
				}
			]
		},
