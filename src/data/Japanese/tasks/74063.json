					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "あれ？なんでここに写真機が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630202,
					"content": "「スクープあるところに写真機あり」——って聞いたことない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630203,
					"content": "聞いたことあるような。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "私が今作った言葉なんだけど、どこで聞いたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630205,
					"content": "はぁ、やっぱりこの世に新しいものなんてないのね。何を言っても、何を書いても…それは他の人のマネになってしまうんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630208,
					"content": "写真機はあるけど、スクープはどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "スクープは…釣りみたいなものよ。辛抱強く待って、正確なタイミングで正しい判断をすることで初めて、大きな魚が釣れ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630210,
					"content": "あ、いえ、大きなスクープが釣れるって言いたかったの。あれ？それもなんか違うかも。まあいっか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630211,
					"content": "素人っぽいね。記者じゃないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "ブッブー、不正解！私はアマチュアの記者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630222,
					"content": "ところで、アマチュア記者がどうしてこんなところにいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630223,
					"content": "先輩から与えられた課題をこなすためよ——「メロピデ要塞の看守のリアルな仕事風景を写真機に収める」っていうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630224,
					"content": "でも、規則通りに関連書類を用意してたら時間があまりにもかかっちゃってね…これを見れば分かると思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630225,
					"content": "ネリーは書類の山を取り出した。様々な項目とサインがびっしり書いてあり、目を通しただけでめまいがしてきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "この一連の手続きを済ませてたら、看守の当直時間を逃しちゃって。釣りに例えるなら、今は釣れる魚がいない状態ってわけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630227,
					"content": "えっ？でもここの看守って、別に一人だけじゃないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630228,
					"content": "うん。でも、どうせなら白金秘蔵型を釣りたいじゃない？基礎能力型とか水域清掃員とかだと、ちょっとインパクトに欠けるし…それにそんなんで課題をクリアしても、先輩は絶対褒めてくれないと思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630229,
					"content": "成果が欲しいなら、選り好みしないほうが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "そうよね、自分の実力を受け入れないと。それに実力を超えた魚を釣ろうなんて考えちゃいけない…うぅ、私ってダメな漁師…あ、いや違った、ダメなアマチュア記者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630234,
					"content": "よし、弱音を吐くのはここまでにして、元気を出さないと！もしお二人の都合がよければ…ちょっと手伝ってくれないかな？ね、お願い！報酬は払うから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630235,
					"content": "き、切り替えが早いな…手伝いの内容にもよるけど、まずはなにをしてほしいか教えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630236,
					"content": "あそこにいる看守が見える？彼の名はグランヴィル。私の見立てだと、彼に関するスクープはメンテマシナリーの態勢制御者と同等の価値があると思うの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630237,
					"content": "彼の写真を撮れば、きっと良い記事が書けるはず。そうすれば、先輩も何も言うことないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630238,
					"content": "でもあの人、全然こっちに来ないのよ！だからさ、写真を撮るのにベストな位置まで連れてきてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630239,
					"content": "自分で状況を説明して、来てもらえば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "そんなことしたら、きっとカメラが気になって固いポーズを取っちゃうわ。それって不自然になっちゃうでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630243,
					"content": "私の作戦はこうよ——まずは拡声器をオフにする。そしてグランヴィルに、拡声器が故障したから見てもらいたいって報告するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630244,
					"content": "そうすればきっと、メロピデ要塞の看守が活躍する瞬間を捉えることができるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630245,
					"content": "課題をクリアできるかは、この作戦にかかってるの！お願い、助けて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630246,
					"content": "#難しくはなさそうだな。{NICKNAME}、助けてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630241,
					"content": "写真機を持って、彼のところに行けば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "えっと…こっちの背景のほうがピッタシなのよ。それに、もし彼が写真機に気づいたら、きっと気になって、固いポーズを取っちゃうわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630230,
					"content": "頑張って待ち続けて。じゃあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "も、もう行っちゃうの？本当に？その…助けてくれたりは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630232,
					"content": "えっと…白金秘蔵型を望んでるんだろ？でも、オイラたちの手でそれを出せるわけじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630213,
					"content": "#スクープはさておき、{M#俺}{F#私}も釣りが好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "本当？よかったぁ。実は私、釣りに関しては初心者でね。ちょうど聞きたいことがあったの。例えば、メンテマシナリーを釣って噛まれたりしたら…君はどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630215,
					"content": "そのまま逃がす。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "なるほど。それが君の選択なのね。ふむ、参考になったわ。覚えておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630220,
					"content": "…って、どうして急に釣りの話になってるの？会話をリードするのがとても上手なのね！どうやらアマチュア記者として、まだまだ学ぶべきことがたくさんあるみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630221,
					"content": "釣りの話はおまえが先に始めたんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630216,
					"content": "ボコボコにして分からせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "料理してパイモンに食べさせる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#おい！{NICKNAME}の料理の腕は信じてるけど、あれはどう見ても食べられるもんじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630206,
					"content": "聞いたことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "おお！じゃあ、今はじめて聞いたってことだ？もし他のところでこの言葉を使う場合は、必ず引用元をつけるようにね！引用元は「私」だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "ネリー"
				}
			]
		},
