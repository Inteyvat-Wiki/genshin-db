			"dialogs": [
				{
					"id": 740630501,
					"content": "これで先輩から出された課題はクリアしたわ。私も一人前の記者になれるわね！ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630502
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630502,
					"content": "どうやら、リアルな良い写真を撮れたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630503,
					"content": "ええ。ほら、見てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630504,
					"content": "リアルっていうか、アートっぽい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "オイラには理解できないアートだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630508,
					"content": "ほ、本当にこんなんでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630509,
					"content": "何か問題でも？私はうまく撮れてると思うんだけど。こんな写真が撮れるなんて、先輩は予想してないでしょうし、きっとびっくりしてくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630510,
					"content": "おまえの評価基準がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740630511,
					"content": "ほら、これこそまさに「本質よりもシンボルのほうがその意義を上回る」っていうものよ。先輩ならきっと、その裏の意味を理解してくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630512,
					"content": "とにかく、手伝ってくれてありがとう。これが報酬よ。へへっ、次は釣りができる場所でおしゃべりできるといいわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネリー"
				},
				{
					"id": 740630506,
					"content": "リアルすぎて、今にも動き出しそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "うぅ、ずっと見てたらめまいがしてきそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "パイモン"
				}
			]
