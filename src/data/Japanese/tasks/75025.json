					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750250111,
					"content": "#パイモンと一緒に休憩場所を見つけ、{REALNAME[ID(2)|SHOWHOST(true)]}が遊び終わるのを待った。",
