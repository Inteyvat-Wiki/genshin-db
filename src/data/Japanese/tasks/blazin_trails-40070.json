			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"灼火の心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "なあ、島の中に植物や水脈を失ってる山があるんだけど、それらを復活させる方法を知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400700402,
					"content": "それなら力になってくれそうな花を知っておる。この上に仲間の氷封の心が住んでいる、彼女に聞いてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "灼火の心"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"氷封の心",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "あなたたち、いったい何者？どうして私のところへ来たのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400700502,
					"content": "こんにちは。アタイたち、島の山にある水脈を開通させたくて、あんたの力を借りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400700503,
					"content": "山を？ああ、なるほど…あなたたちも、大音楽家になりたいのね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400700504,
					"content": "えっ？そうだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400700505,
					"content": "ああ、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400700506,
					"content": "だったら、私たちは同じ志を持つ仲間ね。たとえ私の力が微かなものであろうとも、あなたたちのためになるならいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400700507,
					"content": "私の花びらを取って、旋律の交わる先に埋めてみてちょうだい。そうすれば、地下に沈んだ山脈が音楽を響かせようと隆起するはず。音楽がある限り、大地の隅々にまで生命は流れるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400700508,
					"content": "…ああ、ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"モナ",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701002,
					"content": "ついに、この時が来たぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701003,
					"content": "みんな、アタイは前、思いもよらない人とライブしたいと願った。そして今日、その答えをこの島で見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701004,
					"content": "それは、かつてこの島を巨大な楽器に変えた人だ。名前も顔も知らないけど、そいつは間違いなくテイワットでもっとも偉大な音楽家の一人だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701005,
					"content": "まさか、こんな楽器に出会えるなんて思わなかったぜ。潮の満ち引きを利用して音を奏でるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701006,
					"content": "ロックを弾くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "いや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701008,
					"content": "この音楽はソウルメイトへと贈るもんだからな…原住民に合わせた方法で合奏するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701009,
					"content": "今日はロックじゃなくて、新しいもんを見せてやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701010,
					"content": "…ふぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701011,
					"content": "どうだ？なかなかいい響きだったろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701012,
					"content": "ええ、素晴らしかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701013,
					"content": "かような音の調べ、聞いたことがない。実に興味深いものでござった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701014,
					"content": "それになんだか上品だったな！それから、えーっと、なんていうか…とにかく、今までとぜんぜん違ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400701015,
					"content": "個性を感じる演奏だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "へへっ、あんがとな、みんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701018,
					"content": "これでアタイの願いも叶った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701019,
					"content": "他にやりたいことはないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701020,
					"content": "ああ、ねぇな。今夜はぐっすり眠れそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701021,
					"content": "皆、これでしばらく時間が空いたと思う。そこで一つ提案があるのでござるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701022,
					"content": "ファデュイの拠点に行って、もう一度状況を確認しようと思うのだが、どうでござろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701023,
					"content": "おや？あなたたちもファデュイの拠点を見つけていたのですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701024,
					"content": "ふむ、まさかお主も？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701025,
					"content": "私は天才占星術師ですからね。それに前にも言いましたが、水占の盤が少し回復してきています。今なら占いで、ここの状況を感じ取ることだってできますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701026,
					"content": "えっ？ここにもファデュイがいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701027,
					"content": "ええ。それから、今日フィッシュルと別れる際にこのことを伝えておきましたから、彼女の心配はいりません。仮にファデュイに遭遇していても、身を隠すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701028,
					"content": "なるほど、それではこちらも情報を共有しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701029,
					"content": "上陸時に見たファデュイの拠点と奇妙な装置のことを伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "奇妙な装置に、取り乱すファデュイ…それがあの幻境と関係しているということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400701031,
					"content": "断言はできない。だが、まったく無関係とは思えぬでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400701032,
					"content": "確かに可能性はあるな。なら、さっそく拠点に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701016,
					"content": "味のある演奏だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
