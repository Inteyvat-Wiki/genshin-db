						400701612
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701612,
					"content": "はぁ…まずは行ってみましょう。手がかりがあるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
