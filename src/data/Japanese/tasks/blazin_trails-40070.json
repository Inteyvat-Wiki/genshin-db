			"dialogs": [
				{
					"id": 400701901,
					"content": "花びらを埋めてきたけど、何か感じたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701902,
					"content": "ええ…感じたわ。太陽が照り、海が宝石のように輝き、波がクリーム色の砂浜を打つ様を。砂粒が海へと流れ、また押し戻されていたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400701903,
					"content": "…岩に降り立った海鳥が優しくつつき、リズムを奏でている。ドンドン、ドンドンと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400701904,
					"content": "音楽だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701905,
					"content": "音楽…そう言えば、この島そのものが巨大な楽器だったわね。あなたも音楽家なら、その中に秘められた特別な意味を理解できるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "氷封の心"
				},
				{
					"id": 400701906,
					"content": "潮風や波の花、潮の満ち引きが奏でる音楽は、この世界で一番ロマンチックなもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400701907,
					"content": "みんな、アタイのライブを聞いてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
