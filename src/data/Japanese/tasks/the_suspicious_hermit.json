			"dialogs": [
				{
					"id": 761140201,
					"content": "あのー、ごめんくださ～い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140202,
					"content": "ドーヴェントさ～ん、いるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140203,
					"content": "…誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140204,
					"content": "「秘聞の館」から来たヤフォダだ。あんたに聞きたいことがあってきたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140205,
					"content": "…そこから聞いてくれれば答える。病気で起き上がれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140206,
					"content": "（おかしいな、ホラガイ団の子供たちがドーヴェントさんに字を教えてもらってたときは、優しい声だったって言ってたのに…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140207,
					"content": "（声がかすれてるぞ。病気のせいって感じにも聞こえないけどな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140208,
					"content": "大丈夫か？病状が重いんなら医者を呼んでやってもいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140209,
					"content": "…大丈夫だ。しばらく寝てりゃ良くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140210,
					"content": "そうか、じゃあ容態が回復したらナシャタウンに戻れよ。あんたの友達も心配してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140212,
					"content": "（…なんで黙ってるんだ？部屋の中から足音が聞こえたけど…足どりは重そうだな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140213,
					"content": "最近、ほとんど外に出てないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140214,
					"content": "…修行に集中するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140215,
					"content": "服装も昔とかなり違うらしいじゃないか。そんなにたくましい体つきだったなんて思わなかったって言ってるやつもいたぞ。隠者のローブを着てた時は全然わからなかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140216,
					"content": "えーと、そのクーヴァキを遮断するマスクも…流行ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140217,
					"content": "…外の雑音を遮断するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140218,
					"content": "それも修行のためなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140220,
					"content": "じゃあ、この前ここを訪ねてきた行商人が、その後どこへ行ったか知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140221,
					"content": "…知らん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "ドーヴェント"
				},
				{
					"id": 761140222,
					"content": "そ、そっか…それじゃああたいは失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140223,
					"content": "（なんでか分からないけど、これ以上聞いたらやばそうな予感がしたぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140224,
					"content": "（なるほど、聞いてたとおりだな。まるで別人みたいだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140225,
					"content": "（収穫が少なすぎる。このまま帰ってボスに報告するわけにもいかないし…近くでもう少し注意深く調べてみるか。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
