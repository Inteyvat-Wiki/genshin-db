			"dialogs": [
				{
					"id": 761140301,
					"content": "（ん？これは…まだ焼け残ってるみたいだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140302,
					"content": "（ドーヴェントさんは負傷した冒険者の面倒を見てたって聞いたけど…どうやら最近のことみたいだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 761140303,
					"content": "（なんでこれを燃やしたんだろうな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
