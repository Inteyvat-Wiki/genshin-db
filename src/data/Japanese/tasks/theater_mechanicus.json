				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "き、「機関棋譚」を試してみて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560102,
					"content": "何それ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "あ…ああ！いらっしゃいませ！こちらは、璃月開発の新しい遊戯、「機関棋譚」だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560104,
					"content": "簡単に言うと、机の上で遊べる「遊戯」で、璃月の瑞錦さんが発明したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560105,
					"content": "私は…瑞錦さんの話によれば、「海外運営」の1人かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560111,
					"content": "えっと…「運営」…「権」？を入手したら、瑞錦さんが「機関棋譚」と経営に関するアドバイスを一式送ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560112,
					"content": "遠国監察に差し押さえられたんだけど…「機関棋譚」を持ち出すのにすごい苦労したんだからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560113,
					"content": "遠国監察がなんでこれを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "外国からのものは一旦差し押さえる主義なんだよね、遠国監察は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560115,
					"content": "この件はここまでにして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560116,
					"content": "机の上にある置物を見てみて、全部「機関棋譚」に使う道具なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560117,
					"content": "璃月っぽくない？はは、全部、瑞錦さんの手紙通りに、人に依頼して作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560118,
					"content": "机まで依頼して似たようなものにしたよ…すごくお金がかかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560119,
					"content": "それに、瑞錦さんのアドバイスを参考に、新しい遊び方も追加した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560120,
					"content": "う…こう言っても分からないだろうから、とりあえず1局試してみて。そうしたら、すぐ理解できるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560121,
					"content": "「機関棋譚」を試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "ええ、楽しんでくれるといいな。新しい「機関棋譚」、絶対にがっかりさせないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560123,
					"content": "他に用事がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "ああ、空いたらまた来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560106,
					"content": "ここにも「機関棋譚」があるとは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "いらっしゃっ…あれ？「機関棋譚」を知ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560108,
					"content": "あ…分かった、璃月で遊んだことあるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560109,
					"content": "瑞錦さんが海灯祭の期間に宣伝していたと聞いたけど…確かに効果はあったみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726560110,
					"content": "私は…瑞錦さんの話によれば、この「機関棋譚」の稲妻地域の「海外運営」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "駒形"
				}
			]
		}
	]
}