			},
			"dialogs": [
				{
					"id": 230240101,
					"content": "やっと来てくれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240102,
					"content": "ばっちりのタイミングだ、準備は万端だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230240103,
					"content": "やけに嬉しそうだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "もしかして、この間の薔薇が咲きそうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230240105,
					"content": "そうだ、わはは！これも全部お前たちのお陰だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240106,
					"content": "この薔薇はまだ咲いていないけど、全体の形状を見る限り、とても生命力が強そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230240107,
					"content": "旅人、興味があるなら間近で観察してみないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240108,
					"content": "わはは…もしかすると、お前の目の前でほころぶかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240109,
					"content": "それはしっかり見届けないとね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "ほ、本当か？こんな短い時間で花が咲くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230240111,
					"content": "オイラ、すごく楽しみだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
