			"dialogs": [
				{
					"id": 230240201,
					"content": "かがんで近寄ってみてくれ。そうすれば細部までしっかり見えるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240202
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230240202,
					"content": "薬草農家の二人と一緒に、まだ咲いていない薔薇をじっと観察した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "ぴ、ぴくりともしないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230240204,
					"content": "変化が見えない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "いやあ…薔薇も君の前では、照れくさくて咲けないのかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "ガルゲン"
				},
				{
					"id": 230240207,
					"content": "だが、薔薇の成長パターンからすると…遅くとも明日には大輪の花を咲かせるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240208,
					"content": "旅人、明日また来てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240205,
					"content": "脚がしびれた…",
