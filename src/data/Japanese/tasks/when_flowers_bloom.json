					"nextDialogs": [
						230240404
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240404,
					"content": "めでたし！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "ちゃんと咲いて、オイラたちも嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230240406,
					"content": "ふう…これでやっと、「ビマリスタン」に期日通り納入できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "ヴァルダン"
				},
				{
					"id": 230240407,
					"content": "この薔薇がみんなの役に立つといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァルダン"
