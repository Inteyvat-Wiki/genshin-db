			"dialogs": [
				{
					"id": 708150601,
					"content": "嘉義も、急に帰らなくなるとはのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150602,
					"content": "あの子は1年数回しか会えないのに、もう少し考えてほしいのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150603,
					"content": "きっと璃月港のためだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "嘉義は毎年ああ言っておるが、もう何度も言っても変わらんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150605,
					"content": "きっと仕事のためだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "それでも娘のことを考えてほしい。六はすぐ大人になるからのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150607,
					"content": "彼が村に戻った時、六が外で働くことになったら悲しいではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150608,
					"content": "あの親子はなかなか一緒になれないのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
