			"trigger": {
				"objectNames": [
					"六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "なんでついてきてるの？璃月港に行くって言ったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150802,
					"content": "魔物がいたら遠回りにするから、気付かれることはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150803,
					"content": "私はもう大人だし、子供じゃないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150804,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の父さんから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "父さんが私に？父さんが送ってほしいって言ったの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150806,
					"content": "どうせまたおもちゃでしょ…凧とか人形とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150807,
					"content": "好きじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "…好きだよ。父さんからもらったもの、嫌いなわけがないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150809,
					"content": "でもずっとそういうものしか好きじゃないなら、ずっと子供のままでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150810,
					"content": "そういうものばかり遊んでると、いつになっても冒険者になれないし、「神の目」ももらえないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150811,
					"content": "「神の目」で何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "「神の目」があればいろいろできるでしょ、お金稼ぎとかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150813,
					"content": "そしたら父さんも璃月港で働かなくていいし、ずっと一緒にいられるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150814,
					"content": "ほら、今「神の目」を持ってないから…自分で璃月港に行くこともできないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150815,
					"content": "でも、父さんがプレゼントを君たちに渡したわけだし、私が今言ったら父さんに迷惑をかけるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>私もプレゼントを用意して</color>、父さんを驚かせようと思ったけど…プレゼントは渡せなくなるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>誰か代わりに持って行ってくれたら</color>…いいや、戻るね。道は分かるから、ついてこなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "六"
				}
			]
