				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "あの子、一体どこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150502,
					"content": "六ちゃんについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "おや、あなたたちも六を探してるのかい？あいにく、どこに行ったか私も知らないのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150504,
					"content": "数日前、璃月港にいる六の父親はもうすぐ帰れると手紙をくれたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150505,
					"content": "六は喜んでのう、父さんに贈り物をしたいと言って子供たちを連れて花や果物を取ったりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150506,
					"content": "しかし数日前、仕事があるから戻れないとあの子の父親がまた手紙をよこしたのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150507,
					"content": "あの子は拗ねてしまってのう、父さんが帰ってこないなら自分で璃月港に行くと言い出したのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150508,
					"content": "ただの冗談かと思ったら、今日本当にいなくなってしまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150509,
					"content": "みんなが探しに行っておるんじゃ。あなたたちも時間があったら、一緒に探してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150510,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "では頼むよ。はあ、あの子ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150512,
					"content": "どこに行ったか心当たりは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "あの子は遠く行ってないはずじゃが、野外は危険じゃからのう…早く探しに行ってほしいじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
