			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "はあ、本来ならあと3日くらいで帰れるはずだがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 708150402,
					"content": "使わなかった休みも入れて、少なくとも1週間娘と一緒にいられる予定だったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 708150403,
					"content": "千岩軍の休みが全てなしにされて、休み中の者も全て呼び戻されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 708150404,
					"content": "俺の経験からすると、少なくとも1カ月内は軽策荘に帰れなくなる。なんてことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉義"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
