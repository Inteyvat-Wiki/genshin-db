				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "私を軽策荘に連れ戻しに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150702,
					"content": "若心おばあさんが心配してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "フン、やっぱりね、私は戻らないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150706,
					"content": "璃月港に行って父さんに会うって、村のみんなに言っておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "六"
				},
				{
					"id": 708150707,
					"content": "父さんに会って、話したらすぐに戻るから、心配ないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "六"
				},
				{
					"id": 708150704,
					"content": "渡したいものがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "いらないよ、どうせ子供騙しのものでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "六"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
