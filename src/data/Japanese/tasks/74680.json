	"talks": [
		{
			"id": 7468001,
			"completionStepIds": [
				7468001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468001",
							"2"
						],
						"stepId": 7468001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エレーヌ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3421.75,
							449.586,
							4453.235
						],
						"pointId": 340100476
					}
				]
			},
			"dialogs": [
				{
					"id": 746800101,
					"content": "「千霊映影祭」め…本当に…よくもやってくれたわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800102
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800102,
					"content": "…このままじゃ、締め切りまでにプロジェクトを完了させるなんて夢のまた夢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800103
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800103,
					"content": "うぅぅ…あぁぁ…！！！今回はボスに叱られるだけじゃすまない…きっと殺されるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800104
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800104,
					"content": "こいつ、なんで一人で勝手に泣き出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800105,
					"content": "医者を呼んだほうがいいかな…？でも、フォンテーヌに心の病を診てくれる医者なんているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800106,
					"content": "ううっ…いつからそこにいたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800107
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800107,
					"content": "お気遣いどうも。でも今の私に必要なのは…瀕死状態の私のキャリアを蘇らせてくれる医者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800108
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800108,
					"content": "それは医者の仕事じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800109,
						746800111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800109,
					"content": "たかが仕事でしょ？転職しちゃえ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800110
					]
				},
				{
					"id": 746800110,
					"content": "ちょっと！転職なんて死ぬよりキツいんだから。今までに習得したことが全然役に立たなくなって、また学び直さないといけなくなるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800113,
					"content": "こうやって話してても仕方ないし、まずは詳しく説明してくれよ。どんな問題が起きたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800114,
					"content": "…技術的な問題だから、ちょっと説明が難しいわね。どうまとめればいいのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800115
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800115,
					"content": "簡単に言うわね——私は「千霊映影祭」の器材供給業者のエンジニアで、エレーヌっていうの。撮影器材の開発を任されてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800116
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800116,
					"content": "うちの依頼主がね、映影の効果を追求するために、映影機を載せたまま素早く移動ができる「スタビライザードリー」が必要だって言ってきたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800117
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800117,
					"content": "しかも、その「スタビライザードリー」には集団でのシーンを遠景で撮るために役者の姿をしたマリオネットや動物模型まで載せないといけないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800118
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800118,
					"content": "そうすれば、高速で動いている間も安定して役者を撮影できる上に、大量の役者を雇うコストを削減できるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800119
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800119,
					"content": "それだけじゃなくて、彼らはそれぞれの足場の金額は写真機一台の三分の一以内で、三十年以上持つものを作ってくれって言ってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800120
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800120,
					"content": "そんな注文があるかよ！すっごい達人の職人だって、「安くて使いやすくて、そのうえ耐久性に優れた道具」なんてそうそう作れないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800121,
					"content": "私は作ったわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800122
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800122,
					"content": "どうせ依頼主には逆らえないもの。向こうは前にももっと無茶なことを言ってきてた…その時だって、私は命を削ってその要求に応えたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800123
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800123,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800124
					]
				},
				{
					"id": 746800124,
					"content": "…じゃあなにを心配してるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800125,
					"content": "テストする人がいないのよ！苦労して製品を完成させたのに、全体テストが終わらないんじゃ、プロジェクトは完成したとは言えないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800126
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800126,
					"content": "マシナリーの原理をある程度理解していたり体力があったりする試験者は、みんなもう「千霊映影祭」のもっと重要なものを点検するために雇われちゃってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800127
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800127,
					"content": "テストの終わってない製品を依頼主に納品して、もし大きな問題でも見つかったら…私は十倍の金額を弁償しないといけないのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800128
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800128,
					"content": "私はここで自分の作った製品を売りながら、助けてくれる外部の人を探し続けるしかないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800129
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800129,
					"content": "最終的に大赤字になっても、受け入れるしかないわ…ボスが結んだ契約だけど、十倍の賠償をすることになったら私が個人的に責任を負うことになってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800130
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800130,
					"content": "それなら、テストの内容を教えて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800131
					]
				},
				{
					"id": 746800131,
					"content": "#そうだな。そんなに難しくないテストなら、オイラと{NICKNAME}が簡単なことを手伝ってやれるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800132,
					"content": "難しくないように聞こえるでしょうけど、実際にやってみるとそう簡単じゃないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800133
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800133,
					"content": "最高速度での「スタビライザードリー」の動作状況を確認するために、「近づく人をすべて避ける」っていう受動的運動モードにしてみたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800134
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800134,
					"content": "試験者はフィールド内で「スタビライザードリー」を追いかけて、できるだけ短い時間でより多くのドリーを目標エリアまで追いやる必要があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800135
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800135,
					"content": "私みたいに体力のない人間は、「スタビライザードリー」をちょっと追いかけただけでもすぐ息切れしちゃうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800136,
						746800137
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800136,
					"content": "なんだ、簡単だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800138,
					"content": "おまえがそう言うなら安心だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800139,
					"content": "相手はたかが装置だろ？へへ、オイラたちの走りを見てろよ。ひょっとしたら、オイラたちのほうが追い越しちゃうかもしれないぞ。限界までテストするのなんか、オイラたちにとってはエクストリームイージーモードだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800140,
					"content": "ええ？本気？君たちそれ、本気で言ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800141
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800141,
					"content": "そそそ、それならっ！お金を払うわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800142
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800142,
					"content": "あっ、手間賃っていうなら…オイラたちも遠慮しないけどさ！でも今の状況であんまりいっぱい受け取るのは良心がとがめるっていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800143,
					"content": "試験者に支払う通常の賃金分、モラを払ってくれればそれでいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800144,
					"content": "神の手だわ…！君たちは、死亡寸前の私のキャリアを蘇らせてくれるお医者様、スーパードクターよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800145
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800145,
					"content": "テストフィールドは街のそばの誰もいない秘境にあるの。じゃあ二人に任せたわよ！このエレーヌ、感謝してもし尽くせないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800146
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800146,
					"content": "長いこと仕事してきたけど、ようやくツキが回ってきた…！これで明日、ボスに殺されずに済むわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800147
					],
					"speakerTitle": "エレーヌ"
				},
				{
					"id": 746800147,
					"content": "あー…この仕事が終わったら、ボスを変えたほうがいいかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746800137,
					"content": "走ればいいんでしょ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800138
					]
				},
				{
					"id": 746800111,
					"content": "仕事は大事…何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746800112
					]
				},
				{
					"id": 746800112,
					"content": "あんな大げさに叫んでるのを見ちゃったからには、なにもしないわけにはいかないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746800113
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}