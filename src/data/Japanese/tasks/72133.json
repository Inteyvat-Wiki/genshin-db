			"completionStepIds": [
				7213301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213301",
							"2"
						],
						"stepId": 7213301,
						"stateName": "QUEST_STATE_UNFINISHED"
