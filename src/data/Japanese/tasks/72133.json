			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"梶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721330101,
					"content": "やあ！申し訳ないが外国の人、少し話を聞いてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330102,
					"content": "どうした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330103
					]
				},
				{
					"id": 721330103,
					"content": "この島にあまり長居しない方がいい。最近、「祟り神」の影響範囲がどんどん広まってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330104,
					"content": "「祟り神」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330105
					]
				},
				{
					"id": 721330105,
					"content": "そうだ。珊瑚宮の人に島にある蛇の残魂の鎮め物を壊されてから、「祟り神」がこの島全域に広がったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330106
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330106,
					"content": "お前も見た通り、空を覆い隠す暗い雲も、止まない雨も、全部「祟り神」の仕業だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330107,
					"content": "この間、鉱夫たちが次々と倒れて、気を失い、他の島へと流れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330108,
					"content": "みんな去ってしまった、この島には住民が数人しか残ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330109,
					"content": "でも皮肉なことに、「祟り神」のおかげで、幕府と抵抗軍の戦いが前ほど苛烈なものではなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330110,
					"content": "ふん、そもそもあいつらの戦いによって大御所様の鎮め物が壊されてなければ、島はこんな混乱してなかっただろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330111
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330111,
					"content": "奉行やら、龍やら蛇やら、俺と何の関係がある！戦いについての意見なんて、一度も聞かれたことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330112
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330112,
					"content": "なら、なんでここにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330113
					]
				},
				{
					"id": 721330113,
					"content": "なんでって？ここは俺の家だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330114
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の家族は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330115
					]
				},
				{
					"id": 721330115,
					"content": "家族は安全な場所にいる、心配ありがとう。家族は俺が迎えに来るのを待ってることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330116
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330116,
					"content": "自分から島を離れたいと思う人なんていない。ここにいればみんな家族だ、けど別の場所へ行ったら、他の人のところで働かなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330117
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330117,
					"content": "だから誰かがここに残り、ここを綺麗にして、彼らが家に帰れるようにしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330118
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330118,
					"content": "はぁ、困った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330119
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330119,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330120
					]
				},
				{
					"id": 721330120,
					"content": "どこぞの子が急に手伝うなんて言ってきたら、笑ってしまいそうになるが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330121
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330121,
					"content": "しかし、外国の旅人がこんな遠い稲妻まで来るとは、きっと凄腕の持ち主だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330122
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330122,
					"content": "率直に言うと、俺はあそこの鎮め物のことで悩んでいてな。お前にあれを直す方法を見つけて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330123
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330123,
					"content": "ここの雰囲気がこんなに悪いのも、きっと鎮め物が壊されたからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330124
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330124,
					"content": "ただ鎮め物に近づく時は、くれぐれも気をつけてくれ。あれを見ていると、お前に力を放ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330125
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330125,
					"content": "それは無害だけど、不穏な力なんだ。何だか…拒否されるかのような感じがしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330126
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330126,
					"content": "鎮め物は何かが欠けているようだ。欠けている物を付ければ修復できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330127
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330127,
					"content": "もちろん、それは俺の推測に過ぎないけど…どこに問題があるかは正確には分からない状況だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330128
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330128,
					"content": "だから、手伝ってくれるというなら、鎮め物の修復を頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330129
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330129,
					"content": "ただ、そうは言ってもあまりここに長居はしない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		}
	]
}