			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "手紙は置いた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240602,
					"content": "置いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "それでいいわ。これで宝盗団はあれらの情報を元に侵入計画を立てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240604,
					"content": "そしれ彼らにあげた「最高の侵入時間」は、夜から朝までの間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240605,
					"content": "あと「最高の侵入地点」は…もちろん一つよ。私が地図にマークしてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240606,
					"content": "これでいいわ。私たちは宝盗団が一網打尽になるのを待ちましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240607,
					"content": "もし西風騎士に見つかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "うん…君の言う通りね。合法な手段じゃないから、西風騎士に見つかったら面倒ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240609,
					"content": "でも、そんなことは起きないってあの方が保障してくれたし。一応…信じましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240612,
					"content": "さあ、夜に入ったら、のこのこやってきた宝盗団を全部倒してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240610,
					"content": "現れなかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "絶対に現れる、安心して。これはあの方が自ら作った計画、問題ないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "ヴァル"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112408",
							"2"
