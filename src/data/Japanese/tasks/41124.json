			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "あら、やっと来た。待ったわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240202,
					"content": "なんで待ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "そんなに冷たくしないでよ。大事な用事を頼みたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240204,
					"content": "あの隕石はあなたも見たわね。モンド城には落ちてないけれど、外はもう大慌てよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240205,
					"content": "モンド城が混乱に落ちている中、それに乗じて悪巧みをしている人たちがいるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240206,
					"content": "宝盗団…のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "あら、さすが百戦錬磨の冒険者ね。鋭いじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240212,
					"content": "すでに西風騎士が警戒を上げたけど、何せ他の問題も多くて、完全な警備はできていないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240213,
					"content": "お金のためなら何でもする宝盗団は、この隙を狙って「荒稼ぎ」しようとしているでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240214,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "あら、あっさりと引き受けてくれたわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240216,
					"content": "アハハ、どうやら、あの方が教えてくれた方法は使う必要がなかったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240222,
					"content": "簡単に言うと…モンド城周辺を偵察していた宝盗団のメンバーは、すでにあの方が捕えたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240223,
					"content": "そいつによると、3隊ほどの宝盗団が悪巧みをしているとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240224,
					"content": "そこで私たちは、「最高の侵入地点」を宝盗団のために用意したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240225,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "君がやるべきことは簡単。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240232,
					"content": "偵察に来た宝盗団は、慎重にことを運ぶために、直接戻って報告ではなく、情報を手紙に記して報告する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240233,
					"content": "しかもいざという時のために、三人偵察に向かわせてきてる。それも三人別々に分かれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240234,
					"content": "でも、その三人が全員あの方に捕われたなんて、あいつら絶対思いもつかないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240235,
					"content": "偵察からの報告を受けてから、計画を作成する。最高の侵入地点のために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240236,
					"content": "でも今回は、あの方がすでに侵入地点をあいつらのために用意した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240237,
					"content": "この三つの手紙をあげるわ。これらを三か所の約束場所に置いてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240238,
					"content": "置いたら、ここに戻って私に言って。後のことは…その時に言うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240226,
					"content": "宝盗団が言ったことを信じるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "アハハ、中々考えがあるわね。安心して、宝盗団にそんな骨がある者はいないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240228,
					"content": "あいつら、ただ金銭に群がるチンピラよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240229,
					"content": "「私たちと組めばもっとお金が、じゃないと破産させられる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240230,
					"content": "このことを叩き込めば、すぐに素直になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240217,
					"content": "西風騎士たちが片付ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "あら、やっぱりそう言うのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240219,
					"content": "安心して、あの方から予算はたくさん貰ったから、報酬は少なくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240220,
					"content": "依頼の途中で獲得した物も、自分で取っといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240221,
					"content": "それに、この事は君じゃないとだめなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240208,
					"content": "ヒルチャール…のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "アハハ、何考えてるの、ヒルチャールはそんなことできないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240210,
					"content": "城の周辺に来たら、西風騎士にやっつけられるるだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 411240211,
					"content": "私が言った悪巧みしている人たちは、宝盗団よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "ヴァル"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
