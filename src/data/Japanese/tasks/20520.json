				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "ふぅ…随分温まったよ。ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200402,
					"content": "なぜここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "はあ、依頼のためだよ…難しい依頼があって…そのせいでずっとこの拠点にいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200404,
					"content": "いつも暇しているのもよくないから、何かして時間を潰そうと思っていたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200405,
					"content": "その時、拠点にいるシェフのハリスに雪山に「冷製鮮肉」を探してきてほしいと頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200406,
					"content": "凍った子イノシシを探せばいい、雪山の奥まで入らなくても大丈夫、そうハリスが言ってたもんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200407,
					"content": "特に難しい任務でもないだろうと、引き受けてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200408,
					"content": "元々、こうやって少しずつ自分を鍛えて雪山の環境に慣れようと思っていたしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200409,
					"content": "そうやって雪山に慣れてから…あの錬金術師のお嬢さんの依頼を終わらせるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200410,
					"content": "しかし、雪山に入ってすぐに道に迷い凍り付いてしまうところだった。お前に会えてよかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200411,
					"content": "引き受けたことを後悔してるよ…依頼も完成できなかったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200412,
					"content": "旅人…お前は相当雪山に慣れているようだな、手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200413,
					"content": "頼む、「冷製鮮肉」を1つだけ探してきてくれ。1つあれば依頼を達成できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200414,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "助かるよ。ハリスが言っていた凍った子イノシシがいる場所を地図にマークしておいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200416,
					"content": "俺は先にふもとの拠点に行って待ってるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トミー"
				}
			]
		},
