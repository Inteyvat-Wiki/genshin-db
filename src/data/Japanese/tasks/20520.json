						205200502
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200502,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "助かるよ。これが「冷製鮮肉」か？冷たい以外に特に変わった点はないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200504,
					"content": "まあいい、これで依頼達成だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200505,
					"content": "ありがとうな、旅人。お前がいなかったら、どうなっていたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200506,
					"content": "これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トミー"
				}
			]
		},
