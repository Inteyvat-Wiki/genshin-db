			"dialogs": [
				{
					"id": 205200101,
					"content": "た…旅人…た…た…助けて…くれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200102,
					"content": "…突然どうした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "た…頼む、何か温まる物を持って来てくれ…こ…凍えそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200104,
					"content": "そ、それか…何か温かい料理でもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "トミー"
				},
				{
					"id": 205200105,
					"content": "た…頼むよ、もう限界だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トミー"
				}
			]
		},
