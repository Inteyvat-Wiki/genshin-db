			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "若紫に会った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720502,
					"content": "「四方八方の網」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "「四方八方の網」…いい響きね。でも、あの術は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720504,
					"content": "本当に人の外形を捉えられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "それは…不可能よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720506,
					"content": "そのような陰陽術はただ記載されているだけで、具体的な使い方はとっくに失われているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720507,
					"content": "若紫にあげた術は、動物の外形しか捉えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720508,
					"content": "どうして若紫に教えなかったの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "私はただ、若紫にあるメッセージを世間に届けてもらいたいだけなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720510,
					"content": "「万端珊瑚探偵所の所長は、惟神陰陽術を参考に、人に真実を語らせる網の研究を誰かに頼んでいる」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720511,
					"content": "失われた惟神陰陽術、万端珊瑚探偵所、それと動物の外形を確実に捉える網。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720512,
					"content": "これらの要素が合わされば、現実味を帯びている凄そうな「巷の伝説」になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720513,
					"content": "普通の人にとっては、単なる「巷の伝説」という面白い話に過ぎない。けれど、何か企んでる犯人にとっては、そう簡単に忘れられる話ではないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720514,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "それと、もう一つの理由は…若紫が「最強の陰陽術式」をくれってしつこく言ってきたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720516,
					"content": "そんなものはないって言ったけど、全然信じてくれなかったわ。仕方なく、この陰陽術で彼女をごまかしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720517,
					"content": "若紫が誰にも言わなかったらどうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "それはない。若紫が秘密を守ったことは一度もないからね。若紫のことならもう知り尽くしてるわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720519,
					"content": "とにかく、協力してくれてありがとう。これは礼として受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720520,
					"content": "もう若紫が新しい陰陽術式を聞いて来ないといいんだけど…私は探偵であって陰陽師じゃないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
