			"trigger": {
				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "どう、使い慣れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720402,
					"content": "一度使っただけで壊れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "うーん…まあそれも仕方ないことだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720404,
					"content": "前にも言ったけど、あの術式は動物の外形を捉えることができる。でも、それを具現化するには、他の媒体が必要なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720405,
					"content": "あの術式をこの「四方八方の網」に組み込んだから、外形を捉えることや具現化に必要な媒体は、この網自身が担うようになってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720406,
					"content": "複雑すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "要するに、一つの網は一度しか使えないってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720408,
					"content": "これは今のところ、まだ解決できてない難題なの。媒体が再利用できないと、とんでもないコストになっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720409,
					"content": "私は引き続きこの網について研究するよ。一日も早くこの問題を解決できるように頑張る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720410,
					"content": "もし、「四方八方の網」が必要なら、遠慮なく言ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720411,
					"content": "それと、その…この網は今は動物しか捕まえられないけど、それでも作るのが大変なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720412,
					"content": "だから…えへへ、今度この網が欲しかったら、ちょっとだけ「材料費」をもらうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720413,
					"content": "安心して！君は珊瑚の友人だから、決して多くは取らないよ。適正な価格で提供するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				}
			]
		},
		{
			"id": 7267205,
