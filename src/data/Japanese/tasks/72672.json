				"objectNames": [
					"若紫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "これでよし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720202,
					"content": "あの…若紫さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "こんにちは、私に何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720204,
					"content": "「四方の網」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "あっ、思い出した。君があの旅人だよね？珊瑚から聞いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720206,
					"content": "君の「四方の網」の使い方が実に巧妙で、たくさんのヒントを得られたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720207,
					"content": "改良したって聞いたけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "そうだよ。へへっ…珊瑚から新しい術式をもらったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720209,
					"content": "その術式で網を改良したんだ。だからこの網の名前も「四方八方の網」に変わったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720210,
					"content": "珊瑚が言うには、この術式は生き物の外形を捉えることができるみたい。そして物体を媒介として、その生き物を具現化することも可能だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720211,
					"content": "しかも、この陰陽術式を極めると、人間の外形をも捉えられるらしいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720212,
					"content": "捉えた人間の外形は質問に答えることができて、決して嘘をつかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720213,
					"content": "こういう術って、珊瑚みたいな探偵にとっては、最強の道具とも言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720214,
					"content": "だからこそ、彼女もその術式を私にくれたんだと思う。この網を改良するためにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720215,
					"content": "あっ！他の人には内緒だよ！君は珊瑚の友人だから教えたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720216,
					"content": "そ、そんなに凄いものなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "えっと…それはまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720219,
					"content": "どんな方法で改良しても、この網は動物の外形しか捉えられなくて、人間にはちっとも役に立たないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720220,
					"content": "旅人、君もこの網を試してみてよ。もしかしたら…君の使い方がまたヒントをくれるかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720221,
					"content": "はい、この網はもう君の物だよ。名前は「四方八方の網」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720222,
					"content": "それを使って動物を捕まえてみてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若紫"
				},
				{
					"id": 726720217,
					"content": "改良は成功したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
