					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "若紫ったら…影狼丸のことを教えるんじゃなかったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "旅人、こんにちは。あの「四方の網」のことはまだ覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720104,
					"content": "この前の事件が解決した後、君のことを友人にも話したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720105,
					"content": "彼女の名前は若紫、自分のことを…まあ…「設計者」と呼んでいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720106,
					"content": "若紫は、この網に関する君の操作方法を聞いた後、とても啓発されたらしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720107,
					"content": "あの「四方の網」を改良するために、新たな術式を見つけて欲しいって、ずっと私に言ってるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720108,
					"content": "仕方ないから、その古書からある術式を見つけて、彼女にあげたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 726720109,
					"content": "旅人、もし興味があったら、若紫のところに行ってみて。もう改良できてるかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
