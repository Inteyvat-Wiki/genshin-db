			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランジット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737040101,
					"content": "よーし、今日も新たな希望に満ちた一日だ！さ、二人とも今すぐ出発するか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040102
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040102,
					"content": "新たな希望って…じゃあ、エンシェントヴィシャップとの交流は失敗したってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737040103,
					"content": "失敗したとは…言ってくれるね。ケンカだって、一種の交流なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040104
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040104,
					"content": "その視点で見れば、私たちは素直で深い交流をした仲。その過程で互いの立場を充分に理解したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040105
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040105,
					"content": "こんな言葉があるだろ——「雨降って地固まる」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040106,
						737040108
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040106,
					"content": "こうなる予想はしてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040107
					]
				},
				{
					"id": 737040107,
					"content": "それでも、何事も試さないと分からないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040110,
					"content": "要するに、まだ諦めてないってことだよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737040111,
					"content": "ああ。それに実を言うと、マッシュラプトルに乗ってスメール中を旅するのが、子供の頃の夢の一つだったんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040112
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040112,
					"content": "けど大人たちは、馬鹿な夢を持つのはやめなさいとしか言ってくれなかった。レンジャー長に聞いても、難しい顔をしながら危険な真似はよせと言う始末…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040113
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040113,
					"content": "だから、私は非現実的な夢を諦め、他の子供たちと同じように大人になった。唯一思い切ったことをしてるのは、食材のチョイスだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040114
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040114,
					"content": "たまに思い出すことがあるよ、子供の頃にそんな夢を持ってたなって。でも、それは手の届かないところにある幻想のようで…まるで伝説の中のアランナラみたいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040115
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040115,
					"content": "もしアランナラが本当にいたら、私にも彼らが見えた時期があったのだろうか？もしあったなら、一体いつから見えなくなって、いつ忘れてしまったのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040116
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040116,
					"content": "私がナタにいたとき、こんな物語を聞いた——クントゥルっていうやつが、父の犯した過ちのせいで、太陽に嫌われたという話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040117
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040117,
					"content": "「太陽に好かれないクントゥル」は部族でも嫌われていて、もちろん仲間になってくれる竜もいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040118
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040118,
					"content": "だが彼は落ち込まず、父に対しても、運命に対しても愚痴ひとつこぼさなかった。そして、努力で証明してみせた。自分は一族の一番強い戦士にも劣らないってことをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040119
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040119,
					"content": "最後に、彼は勇気と知恵を駆使して偉業を成し遂げた。イクトミ竜に仲間として認められただけでなく、一族の英雄にもなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040120
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040120,
					"content": "彼の物語を聞いて、私も子供の頃の夢を取り戻す勇気が湧いてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040121
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040121,
					"content": "そんな理由があったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737040122,
					"content": "だから、マッシュラプトルと正面から「交渉」するのは君に頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040123
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040123,
					"content": "結局オイラたちにやらせるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737040124,
					"content": "今の私の実力では、マッシュラプトルの相手なんて到底務まらないからね…けど、ちゃんとサポートはする。何かあったら、いつでも呼んでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040125
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040125,
					"content": "さあ、さっそく行こうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040126,
						737040127
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040126,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737040127,
					"content": "他に用事があるから、またあとで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040128
					]
				},
				{
					"id": 737040128,
					"content": "ああ。じゃあ、ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランジット"
				},
				{
					"id": 737040108,
					"content": "ケンカしてるのはこっちだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040109
					]
				},
				{
					"id": 737040109,
					"content": "さすがは本物の冒険者だよ。素人の私でも分かる。君、だいぶケンカ慣れしてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "ランジット"
				}
			]
		}
	]
}