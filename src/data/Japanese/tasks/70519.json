			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ベルンハルト",
					"モナ",
					"フィッシュル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705190201,
					"content": "ベルンハルト、資金をたっぷり集めてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190202,
					"content": "もう終わったのか？なんという手腕だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190203
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190203,
					"content": "準備はすべて整った。残すは開店だけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190204
					]
				},
				{
					"id": 705190204,
					"content": "よし、僕のほうも仕入先との商談が終わったところだ。少し待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190205
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190205,
					"content": "ベルンハルトは仕入れ先に「ブリューゼリー」を渡し、ほどなくして店の準備が完了した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190206
					]
				},
				{
					"id": 705190206,
					"content": "どうだ、いい感じだろ？もし何か他にも案があったら、いつでも店の装飾を変えてくれて構わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190207
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190207,
					"content": "おお、いい感じの、立派なお店だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190208,
					"content": "よし、オイラが店の名前をつけてやるぞ。そうだな…「西風ザーザーショップ」にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190209,
						705190211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190209,
					"content": "パイモンっぽい名前だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190210
					]
				},
				{
					"id": 705190210,
					"content": "それって褒め言葉だよな！ベルンハルト、他にオイラたちにできることはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190213,
					"content": "資金調達は大変な仕事だし、きっと疲れてるだろ？細かな雑務は全部僕に任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190214
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190214,
					"content": "代わりに、君たちはその幅広い知識を使って、経営方針や営業方法、サービスの特徴や品質管理などを考えてほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190215
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190215,
					"content": "こういった専門的な話は他の店主から聞いたんだが、実はよく理解できていなくってね。でも重要であることは確かだから、君たちに決めてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190216
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190216,
					"content": "つまり、オイラたちが店主としてお店の戦略を立てて、おまえが店員として、具体的な仕事を担当するってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190217,
					"content": "そういうこと。僕は体を使うのが得意だからね、まさに「道具」として使ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190218
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190218,
					"content": "すごい覚悟だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190219
					]
				},
				{
					"id": 705190219,
					"content": "おいおい、そこまでする必要はないぞ。オイラたち、別に悪徳店長ってわけじゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190220,
					"content": "ベルンハルトは先に休んどけよ。オイラはこいつと経営戦略について話し合っとくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190221,
					"content": "これまでの経験をもとに、パイモンと店に並べる商品を検討し、経営にあたっての要点を話し合った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190222
					]
				},
				{
					"id": 705190222,
					"content": "よし、要点ははっきりしてるな。目標は「フェア最高の料理店」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190223,
					"content": "さあ、ベストな状態で、最初のお客さんを迎えるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190224,
					"content": "いよいよ営業開始！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190225
					]
				},
				{
					"id": 705190225,
					"content": "旅人とパイモン？まさか、こんなところで会うとは思いませんでした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190226
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190226,
					"content": "モナとフィッシュルじゃないか！おまえたちもフェアに遊びに来てたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190227,
					"content": "ふん！冥冥の裡に覚えた予感により、メギストス卿を連れて凡俗の佳節を視察しに来た甲斐があったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190228
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190228,
					"content": "このありふれた秋日に、常理より外れし機があるとは…実に素晴らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190229
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190229,
					"content": "お嬢様は喜びの声を抑えておられますが…あなた方にお会いできて、とてもご機嫌なようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190230
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190230,
					"content": "オ…オズ！変に誇張しないでくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190231
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190231,
					"content": "コホン、やはり私から説明しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190232
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190232,
					"content": "先日、皇女殿下がいい夢を見られたそうで、近々何か幸運なことが起こるのではないかと、私のところへ占星術のアドバイスをもらいに来たんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190233
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190233,
					"content": "その際、ブリュー祭が盛り上がっていることを耳にし、一緒に行かないかと誘ってくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190234
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190234,
					"content": "もちろん喜んで承諾しましたよ。執筆の締め切りに間に合わせるために、祭りのセールでちょうど色々と仕入れる必要がありましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190235
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190235,
					"content": "実は、皇女殿下が教えてくれていなければ、私はブリュー祭が開催されたことすら気づかなかったでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190236
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190236,
					"content": "メギストス卿、今の話は補足する必要があるわ、あの夢は九日も前のものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190237
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190237,
					"content": "その間、メギストス卿から返事がずっと来なかった。だから、わたくしが直々にあなたの邸宅を訪問したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190238
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190238,
					"content": "待ってください…九日？あれからもう九日も経っていたのですか！？早すぎません！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190239
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190239,
					"content": "でも、今回の執筆はメギストス卿にとって極めて重要なもの、わたくしも大目に見てあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190240
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190240,
					"content": "ですが、メギストス卿も注意されたほうがよろしいかと。郵便箱がびっしりと詰まっていたら、音信不通になっていると勘違いされる方も少なくありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190241
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190241,
					"content": "モナは学問の研究に没頭するあまり、時間も人に返事するのも、それからこんな盛大なお祭りがあることも忘れちゃってたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190242,
						705190243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190242,
					"content": "外界に惑わされないことも、たまには重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190244,
					"content": "と…とにかく、時間がありません！早く必要なものを買いに行かないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190245
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190245,
					"content": "そういえば、あなたが自分の店を開いているとは思いませんでした！しかも、私が一番注目している料理店だなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190246
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190246,
					"content": "実は人に頼まれてな。へへっ、オイラたちのお店をよろしく頼むぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190247,
					"content": "買いたいものはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190248
					]
				},
				{
					"id": 705190248,
					"content": "そうですね…おすすめの…その…おつまみはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190249
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190249,
					"content": "もちろん、いっぱいあるぞ！えーっと、メニューには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190250,
					"content": "ん？待てよ…おつまみ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190251,
					"content": "まさか、執筆がうまく行かないからって、お酒でも飲み始めたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190252,
					"content": "そういえば、お嬢様がよく訪問されていたので、そのせいでかなり遅れが出ているのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190253,
						705190255
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190253,
					"content": "モナ、気をしっかり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190254
					]
				},
				{
					"id": 705190254,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190257,
					"content": "いえ、お酒も訪問も、どちらも関係ありません！そう驚かないでください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190258
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190258,
					"content": "以前、皇女殿下の得意料理、冷製肉盛り合わせをごちそうに…失礼、「祈聖シンフォニー」でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190259
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190259,
					"content": "その味はこれまでに味わったことのないもので、一口噛むごとにちゃんとお肉の満足感があり、気付けば完食をしていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190260
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190260,
					"content": "まあ…お客さんに料理を楽しんでもらうのも、料理人にとってはひとつの評価だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190261
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190261,
					"content": "冷製肉盛り合わせは本当に素晴らしいものです。エネルギーの補給ができ、長期保存も可能。一般的には、おつまみとして食べられるものなんですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190262
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190262,
					"content": "価格を除けば、他のすべての面において「満足サラダ」に勝っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190263
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190263,
					"content": "しかし考えてみてください、ブリュー祭はお酒をテーマとしたもの。つまり、おつまみを割引価格で買うことができるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190264
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190264,
					"content": "まさに、これは天が与えし贈り物。しっかりと手にしないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190265
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190265,
					"content": "歓喜の声を上げなさい、メギストス卿！あれはわたくしが旅の合間に思い付いた作品にすぎない。極上の料理を堪能する機会はまだまだあるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190266
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190266,
					"content": "まだ本領を発揮していない、とお嬢様はおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190267
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190267,
					"content": "ええ、分かっています！皇女殿下の腕前は、あの時の料理を遥かに超えているものでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190268
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190268,
					"content": "ただ、臣下の私が皇女殿下に料理を頼むなんて…いや、つまり家に来た客人に料理をお願いするなんてこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190269
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190269,
					"content": "せめて、サラダ以外の品を用意できれば…お口に合うものを出せたかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190270
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190270,
					"content": "えっ？モナはそんな風に思ってたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190271
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190271,
					"content": "こういう時は「先を読んでいた」とか、「大局を見据えていた」とおっしゃったほうが、お嬢様にお似合いかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190272
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190272,
					"content": "コ、コホン！その通りよ！メギストス卿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190273
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190273,
					"content": "わたくしが認めた者として、あなたは星空の秘密を知り尽くしているはず…わたくしを悦ばせる必要はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190274
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190274,
					"content": "別に、いつもこんなに忙しくしている訳ではないんです…それに時間の余裕がある時に他の分野を学ぶのは、なにも大変なことではありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190275
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190275,
					"content": "それなら——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190276
					]
				},
				{
					"id": 705190276,
					"content": "おう、オイラたち「西風ザーザーショップ」に任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190277
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190277,
					"content": "うちにはそのまま食べられるおつまみだけじゃなく、少し調理するだけで食べられるものもあるぞ。それぞれちょっとずつ買うのがオススメだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190278
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190278,
					"content": "ちなみに、少し調理するだけで食べられるほうは、失敗しにくいし、作るのもすぐ慣れるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190279
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190279,
					"content": "難しい料理は、忙しくない時にでも挑戦すればいいと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190280
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190280,
					"content": "もちろん、モナの家に行って教えてやってもいいぞ！旅人は料理がうまいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190281
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190281,
					"content": "お安い御用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190282
					]
				},
				{
					"id": 705190282,
					"content": "おお、それはいいアイデアですね！これなら多少値が張ろうとも構いません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190283
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190283,
					"content": "メギストス卿、あなたの傑作を心待ちにしているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190284
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190284,
					"content": "それから、パイモン殿の助言を念頭に置き、合理的に予定を立てるのがよろしいかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190285
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 705190285,
					"content": "ええ、今に見ていてください。今度私の家に来た時、格段に美味しいものをごちそうしますので！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190286
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 705190286,
					"content": "モナは必要なものを買い、礼を言うと、フィッシュルとオズと共に満足そうな笑みを浮かべて帰って行った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190287
					]
				},
				{
					"id": 705190287,
					"content": "えへへっ。「西風ザーザーショップ」の初収益だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190288,
						705190289
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190288,
					"content": "決して多くはないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190290,
					"content": "そうだな！お客さんが気に入った商品を買う姿を見たら、オイラもうれしくなってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190291
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190291,
					"content": "誰かが必要としている商品を売るって、こういうことなんだな。店主の仕事って案外楽しいかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190292
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190292,
					"content": "よし、この調子で、店の名を轟かせてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705190289,
					"content": "大きな意味がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190290
					]
				},
				{
					"id": 705190255,
					"content": "皇女殿下、人に迷惑を掛けたのでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190256
					]
				},
				{
					"id": 705190256,
					"content": "えっ、ええ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190257
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 705190243,
					"content": "羨ましい集中力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190244
					]
				},
				{
					"id": 705190211,
					"content": "他に手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705190212
					]
				},
				{
					"id": 705190212,
					"content": "おい、オイラがつけた名前を無視するなよ！せめて頷くぐらいしろって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190213
					],
					"speakerTitle": "パイモン"
				}
			]
		},
