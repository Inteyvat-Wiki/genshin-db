					"content": "名高い栄誉騎士、そして「テイワットのガイド」パイモン！今回のチャリティーショップを救うために、手を貸してほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190302
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705190302,
					"content": "ベルンハルトを手伝ってチャリティーショップを用意した",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190303
					]
				},
				{
					"id": 705190303,
					"content": "お疲れだ！さて、営業開始にしよう！",
					"roleType": "TALK_ROLE_NPC",
