			"dialogs": [
				{
					"id": 745280401,
					"content": "お前か。旅路が、また交わったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280402,
					"content": "スカーク、久しぶりだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "この世界に残された「傷跡」を観察している。あの爆発がここを廃墟に変えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280405,
					"content": "だが今、人々は廃墟の上に新たな物を築き上げている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280406,
					"content": "万物には終わりがあるが、衰亡の後には可能性の萌芽が生まれるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280407,
					"content": "前回会った時よりも、力がついたな。鍛錬を怠らなかったと見える…良いことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280408,
					"content": "実は、ちょっとお願いがあるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "写真だと？この世界にとって、私はただの通りすがりだ。存在した証など、残す必要はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280411,
					"content": "#{M#俺}{F#私}にとっては通りすがりなんかじゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "…なら、好きにするがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280414,
					"content": "私はここにいる。いつでも始めてかまわない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 745280412,
					"content": "再会はいつだって、大切な思い出だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "#{M#君}{F#あなた}の写真を撮らせてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
