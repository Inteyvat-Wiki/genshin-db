				},
				{
					"id": 250290208,
					"content": "キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290209,
					"content": "訓練の調子はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "うーん…前よりもだいぶ高いところまで登れてるから、「よくなってる」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290211,
					"content": "ただ、山を登る時の動きがちょっと不慣れな感じってだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290216,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、もう一度お手本を見せてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290217,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "#ありがとう！今度こそちゃんと{M#お兄ちゃん}{F#お姉ちゃん}の動きを覚えるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290219,
					"content": "チーカもちゃんと見とくんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290220,
					"content": "キュッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290223,
					"content": "#それじゃあ、よろしくね、{M#お兄ちゃん}{F#お姉ちゃん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290224,
					"content": "僕たちは下から見て、タイムを測るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290225,
					"content": "キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290221,
					"content": "今度こそちゃんと見て覚えてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "もちろん。チーカと二人で目を凝らして、絶対にどんな動きも見逃さないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290212,
					"content": "着々と元気になってるみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "もちろん！僕は世話が上手だってお母さんも言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290214,
					"content": "チーカはすごく成長したよ！前よりもずっと高いところまで登れるようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "トゥラテ"
				},
				{
