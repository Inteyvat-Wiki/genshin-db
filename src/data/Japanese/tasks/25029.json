					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#ん？あっ、こんにちは、{M#お兄ちゃん}{F#お姉ちゃん}！今、山登りの訓練をしてるんだ！",
					"roleType": "TALK_ROLE_NPC",
