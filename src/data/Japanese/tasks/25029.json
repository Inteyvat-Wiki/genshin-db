			"dialogs": [
				{
					"id": 250290101,
					"content": "大丈夫だよ、元気出して。体がよくなってから、頑張って訓練すれば、きっとすぐに山頂まで登れるようになるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290102,
					"content": "キューン…キューン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290103,
					"content": "お腹すいた？食べ物持ってきてあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290104,
					"content": "キュイ…キュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290105,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "仲間のチーカと遊んでるの。チーカはまだ小さいけど、大人になったらきっと他のユムカ竜と同じくらい強くなるってお母さんが言ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290107,
					"content": "キュー…キュキュッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290108,
					"content": "そんなに落ち込まないで。チーカはちょっと体が弱いだけなんだから。それに、前まで病気だったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290109,
					"content": "美味しいものいっぱい食べて、僕と一緒にたくさん訓練すれば、きっと強くなるってお母さんが言ってたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290110,
					"content": "キュー？キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290111,
					"content": "（チーカを撫でる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "キュー…キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290119,
					"content": "ごめん、しゃべりすぎちゃった。もうすぐ訓練の時間だから、先におやつを食べちゃお。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290120,
					"content": "これはお母さんが特別に作ってくれたドライフルーツだよ！果物を大きな鍋でよく炒めて、いい匂いのスパイスをたっくさん振って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290121,
					"content": "砂糖と花びらもたくさん入れて…とにかく、めちゃくちゃ美味しいんだ！分けてあげるね…あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290122,
					"content": "ドライフルーツは？かばんに入れてたはずなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290123,
					"content": "…キュー、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290124,
					"content": "あっ！チーカ！もしかして全部食べちゃったの？走れなくなるから食べ過ぎちゃだめって言ったじゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290125,
					"content": "キュ、キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290126,
					"content": "食欲があるのはいいこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "キュッ、キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290129,
					"content": "そうなの？じゃあ…僕もチーカみたいにたくさん食べて早く大きくなって、お母さんをお手伝いする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290130,
					"content": "よし、じゃあ、訓練しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290131,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290132,
					"content": "今日は…山登りをしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290133,
					"content": "キュイ、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290134,
					"content": "この前と同じだからそんなに難しくないよ。頑張ろうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290135,
					"content": "…キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290136,
					"content": "そういえば、ヤワルのおじちゃんがちゃんとした訓練にはちょうどいい「訓練目標」が必要だって言ってたっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290137,
					"content": "強い冒険者に目標を決めてもらえたらなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290138,
					"content": "#{M#俺}{F#私}は強いほうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "本当？じゃあ…僕を手伝ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290141,
					"content": "一緒に登ろうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "#待って待って、{M#お兄ちゃん}{F#お姉ちゃん}が本当にすごい人だったら、僕たちじゃついていけないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290144,
					"content": "僕たちは下から見て、タイムを測るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290145,
					"content": "全力で、最高スピードで山頂まで登って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290146,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290142,
					"content": "よし、じゃあついてきて——用意…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "強い冒険者ならここにいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "たくさん食べれば早く大きくなれる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "病気って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "わかんない…お母さんなら知ってるかも！お母さんが連れて帰ってきた時、チーカは病気で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290115,
					"content": "ご飯も食べられなかったし、動くこともできなくて、僕が毎日薬を水に溶かして飲ませてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290116,
					"content": "そのあと病気は治ったんだけど、まだ体が弱くて、ほかのユムカ竜みたいに崖を自由に行き来できないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290117,
					"content": "それでチーカはずっと落ち込んでて。僕、チーカの力になりたいよ！元気になって、ほかのユムカ竜よりも強くなってほしいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "トゥラテ"
				},
				{
					"id": 250290118,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "チーカ"
				}
			]
		},
