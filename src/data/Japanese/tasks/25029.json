					"nextDialogs": [
						250290203
					],
					"speakerTitle": "チーカ"
				},
				{
					"id": 250290203,
					"content": "へへっ、元気いっぱいだ！じゃあ、今日も頑張ろっか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
