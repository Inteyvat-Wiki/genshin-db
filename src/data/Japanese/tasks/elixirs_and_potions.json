			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "やっとうちのこと思い出してくれたん？それに友人を連れてきたっちゅうことは…その人も付き合うてくれるん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590302,
					"content": "うぅ、もう少しその言い方どうにかならないのかよ…恥ずかしいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590303,
					"content": "えっと、実は…オイラたち「丹剤宗匠」を探してるんだ。その人について、なにか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590304,
					"content": "あら、別件でここに来たん？少しがっかりやわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590305,
					"content": "せやけど、うちの秘密を聞き回っとるやなんて、それはそれで嬉しいわぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590306,
					"content": "秘密？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "えっ！まさか鶯が「丹剤宗匠」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590309,
					"content": "少し会わないうちにまた賢くなったんやねぇ。ふふっ、可愛いわぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590310,
					"content": "ぜんぜん予想してなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590311,
					"content": "「丹剤宗匠」がこんなにも若いとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590312,
					"content": "アルベド先生の雰囲気とはまた違うけど、底知れぬ何かを感じる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590313,
					"content": "あんたたちの真剣な表情を見るに、どうやら難題を抱えてるようやな。よかったら、うちに話してみぃひんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590314,
					"content": "なんか分からないけど、予想外の方向に話が進んでる気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590315,
					"content": "ティマイオスと共に「煙霰丹剤」の研究課題を鶯に説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "せやったんか。こちらの錬金術師さんは「煙霰丹剤」を研究しとるんやな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590317,
					"content": "せやけど残念ながら、あんたたちを失望させてしまうかもしれへんなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590318,
					"content": "あんたたちが調べとる「煙霰丹剤」は、うちが伝統的な製法で作った、ただの香膏や。錬金術とは全く関係があらへんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590319,
					"content": "香膏？それって、クリーム状の香料だよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590320,
					"content": "ええっ！「煙霰丹剤」なんていかにもすごそうな名前してるのに！？それに「人を強くする」って本には書いてあったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590321,
					"content": "ふふっ、それもうちの古法香膏が人気やからやろな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590322,
					"content": "昔の文筆家は、「薫陶」っちゅう言葉を強調してこれのことを書いとった。長くこの香膏の香りに包まれていると、人の気質や心に変化が出てくるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590323,
					"content": "うちの古法香膏を使うと、その人の気質が一変する。魅力は倍増し、物事に接する時も自信が増すんや。人間関係はどんどん良うなって、事業繁栄、生活も順風満帆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590324,
					"content": "まるで仙人の丹薬をつこうたかのように、運気はうなぎ登り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590325,
					"content": "結果、うちの古法香膏には詩的な名が付けられた。その効果を称賛するような詩まで書れたんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590326,
					"content": "そういうことだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590327,
					"content": "いや、そんなはずは…まさか、あの本に書いてあった論文が間違っていたのか？それとも、僕の詩に対する解釈が間違っていたと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590328,
					"content": "えっと、「丹香悠遙煥儀質」…これの意味は、「煙霰丹剤」によって人の威厳と潜在的な素質を引き出すという意味のはず…そうだよね、鶯さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590329,
					"content": "ちゃうちゃう、「儀質」っちゅうんは、人の風格や気質を表す一つの単語やで。この詩は、古法香膏を使うことで立ち振る舞いが一新されるっちゅう意味や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590330,
					"content": "まあ、無理もあらへんわ。詩っちゅうんは奥が深いもんやしな。情報を分析するなら言葉を紐解いて断片的に解釈するんやなく、全体の文脈にも注意を払わなあかんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590331,
					"content": "言葉を紐解いて分析する方法は、なんにでも通用するわけではないと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590332,
					"content": "しかし、あの本には「煙霰丹剤」の奇跡とも言える実例がたくさん載っていた。その効果は僕の想像を遥かに超えるもので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590333,
					"content": "ワクワクするような不思議なことは、いつやって魅力的に見えるもんや。人知の及ばんもんに惹かれるのと一緒。逸話を記録した本も、芸術的な表現で描いとっただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590334,
					"content": "まあ、筆者からの褒め言葉みたいなもんやね。ふふっ、嬉しいわぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590335,
					"content": "そんな…嘘だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590336,
					"content": "つまり、ティマイオスが参考にした資料は、香膏の効果を誇張していただけで…こいつも詩の意味を誤解していた。その結果、「煙霰丹剤」を錬金術で作るすごい薬剤だって思い込んじゃったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590337,
					"content": "なんとなく予想してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "ということは、僕の研究課題は完全に間違った理論を基にしていたってことかい！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590340,
					"content": "ああ、また研究に失敗するなんて。無駄なことをしてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590341,
					"content": "あらあら、そう落ち込まんといてぇやぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590342,
					"content": "「温故知新」っちゅう言葉があるやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590343,
					"content": "もしかしたら、香膏を作る古い方法が新たな道を開く手がかりになるかもしれへんよ。そこから、理想の薬剤を作れるかもしれへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590344,
					"content": "たしかに、始まりこそ間違ってたけど、ティマイオスは自分なりに解釈して、ここまで来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590345,
					"content": "鶯もこう言ってるし、ひとまず挑戦してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590346,
					"content": "予想外の収穫があるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "そうだね…錬金術は奥深い学問だ。失敗したのだって、別にこれが初めてじゃない。気を取り直して、切り替えていかないとね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590348,
					"content": "それにいつもは資料をきちんと解読できるんだ。今回はたまたまさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590349,
					"content": "たとえ、伝説の不思議な薬剤を作ることができなくても、既存の錬金薬剤を改良することだって立派な成果だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590350,
					"content": "鶯さん、旅人、さっそく合成台のところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590338,
					"content": "こうなる予感はしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "嬉しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
