			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティマイオス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590101,
					"content": "あともう少しだ…何としてでも、九時間以内に「煙霰丹剤」を一つ作らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590102
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590102,
					"content": "ティマイオス？そんな真剣な顔をして、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590103,
					"content": "あっ、君たち！久しぶりだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590104
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590104,
					"content": "悪いけど今、「煙霰丹剤」を作成中でね。しばらく合成台は使えないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590105
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590105,
					"content": "「煙霰丹剤」？聞いたことないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590106,
					"content": "そうかもね。なにせ、これはここ数年で現れた不思議な薬剤でね。無名の学術書を読んでいる時に、僕もその存在を知ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590107
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590107,
					"content": "著者によると、「煙霰丹剤」の起源は璃月らしい。それを使うことで、使用者の力を倍増させることができるそうだ。こんなすごい効果を持った薬は、きっと錬金術の粋を集めたものに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590108
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590108,
					"content": "「煙霰丹剤」は璃月でも高く評価され、「丹香悠遙煥儀質」と褒め称える記述も見られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590109
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590109,
					"content": "だから今、それについて詳しく調べているんだ。もし「煙霰丹剤」を作成できれば、僕の錬金術への理解は少なくとも十年は進む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590110
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590110,
					"content": "十年も！？そんなすごいものなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590111,
						716590112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590111,
					"content": "その本の内容が正しいのが前提条件になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				},
				{
					"id": 716590113,
					"content": "安心してくれ！この本の著者は博識なことで有名でね。素晴らしい論文をいくつも書いてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590114
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590114,
					"content": "錬金術は本当に不思議な学問だよ。古代の技術を紐解きながら、現代の研究成果を取り入れ、日々進化し続けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590115
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590115,
					"content": "だから、僕はあらゆる資料を集めているんだ。その中から錬金術に役立つ知識を洗い出すことで、今まで課題を進めてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590116
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590116,
					"content": "ティマイオスって本当に挫けないし、ひたむきだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590117,
					"content": "もし二人が協力してくれたら、今回の研究は間違いなくアルベド先生に認められるものになる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590118
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590118,
					"content": "そして、これを機にアルベド先生の助手になるのだって夢じゃない。先生の拠点にこもって、より奥深い研究をするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590119
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590119,
					"content": "#どうする、{NICKNAME}？ティマイオスを手伝ってやるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590120,
						716590121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590120,
					"content": "合成台が使えるようになるためにも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590122,
					"content": "おう、こいつを助けてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590123,
					"content": "本当にありがとう！この礼は必ずするから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590124
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590124,
					"content": "そうだ、「煙霰丹剤」の試作ができ次第、二人にはその効果を体験させてあげよう。きっと、すぐに強くなれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590125,
						716590126
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590125,
					"content": "礼なんて気にしなくてもいいのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590127,
					"content": "薬で強くなるよりも、オイラは美味しい物のほうが嬉しいけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590128,
					"content": "ああ、それくらいお安い御用さ！成功したら、十分な報酬を出すだけでなく、二人の好きなレストランで美味しい食事をご馳走するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590129
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590129,
					"content": "ホントか！約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590130,
					"content": "ティマイオスに協力し、伝説の「煙霰丹剤」を作成することになった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590131
					]
				},
				{
					"id": 716590131,
					"content": "やっぱり、僕の知る技術だけでは、「煙霰丹剤」を作れそうにないんだ。ここは専門家に知恵を借りるしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590132
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590132,
					"content": "たとえば、アルベドとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590133,
					"content": "ダメダメ！それだけは絶対にダメだ。それじゃあ試験中に、先生に答えを聞くようなもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590134
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590134,
					"content": "もしアルベド先生に、薬剤の一つもまともに作れないと知られたら、ますます僕のことを認めてくれなくなってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590135
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590135,
					"content": "そ、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590136,
					"content": "スクロースに聞いてみたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590137
					]
				},
				{
					"id": 716590137,
					"content": "確かに、スクロースさんの錬金術への理解は、僕よりも遥かに優れている。だけど、彼女の専攻分野は「煙霰丹剤」とかけ離れていてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590138
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590138,
					"content": "それに、彼女は普段の研究で忙しいから、さすがに邪魔はできないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590139
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590139,
					"content": "それなら、リサさんに聞いてみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590140
					]
				},
				{
					"id": 716590140,
					"content": "リサさんは最近、図書館の本を整理しているらしくてね。その作業がなかなか大変みたいだ…邪魔をしたら、リサさんの機嫌が悪くなるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590141
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590141,
					"content": "とにかく！彼女の邪魔はしないでおこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590142
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590142,
					"content": "それじゃあ、どうするんだよ？まったく方法がないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590143,
					"content": "方法は…まだある。ただモンドじゃなくて、璃月にね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590144
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590144,
					"content": "僕が読んだ本には、「閑暇たる宗匠は近隣に身を隠し、漂う薫の風は岩の港を包む」と書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590145
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590145,
					"content": "「薫の風」、これは璃月で「南風」を意味すると聞いた。つまり、「煙霰丹剤」を作り出した「丹剤宗匠」は、璃月港の南の地域に住んでいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590146
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590146,
					"content": "その「丹剤宗匠」に直接話を聞ければ、一番手っ取り早いだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590147
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590147,
					"content": "そこで、二人には僕と一緒に璃月まで付いてきて欲しいんだ。その、僕はあそこのことにあまり詳しくないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590148,
						716590149
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590148,
					"content": "この詩の意味…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590150,
					"content": "もちろん！僕の情報分析能力を信じてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590151
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590151,
					"content": "璃月まで行くのか…遠いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590152,
					"content": "そうだ！璃月の料理は相当美味しいんだろう？もし上手くいったら、そのまま璃月で食事をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590153
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590153,
					"content": "おおっ、ナイスアイデアだぜ！オイラは賛成だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590154,
					"content": "だったらオイラは…「万民堂」の看板料理をぜんぶ注文して食べるぞ！「万民堂」の料理は、何度食べても飽きないからなっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590155,
						716590156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590155,
					"content": "いくらモラが必要になると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590157,
					"content": "心配いらない。研究成果…いや、二人に助けてもらう恩に比べたら、それくらいのモラは大したことじゃないさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590158
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590158,
					"content": "それじゃ、さっそく出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590156,
					"content": "ティマイオスの貯金が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590149,
					"content": "本当に理解したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590126,
					"content": "何かを利用してまで強くなる必要はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590121,
					"content": "ティマイオスの学術のためにも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590112,
					"content": "その予想が正しいのが前提条件になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				}
			]
		},
		{
