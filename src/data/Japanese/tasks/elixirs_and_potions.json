			"dialogs": [
				{
					"id": 716590601,
					"content": "こんにちはっ！「丹剤宗匠」って人がこの辺りに住んでるらしいんだけど、知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590602,
					"content": "「丹剤宗匠」？聞いたことないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590603
					],
					"speakerTitle": "千"
				},
				{
					"id": 716590603,
					"content": "「宗匠」の称号を得られるのは、かなり優秀な人に限られてるんだろ？私みたいな一般人が知るはずもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590604
					],
					"speakerTitle": "千"
				},
				{
					"id": 716590604,
					"content": "そっか…じゃあ、他をあたってみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
