					"弘毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590701,
					"content": "こんにちはっ！オイラたち、チ虎岩に住んでるっていう「丹剤宗匠」を探してるんだけど、どこにいるか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590702,
					"content": "すまない、俺は近所の人のあだ名に詳しくなくてね。あだ名じゃなければ分かるんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590703
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590703,
					"content": "こういうのは、「春香窯」の鶯に聞いてみるといいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590704
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590704,
					"content": "たしかにそうだな！鶯ならこういうのに詳しそうだ。彼女に聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7165951,
			"completionStepIds": [],
