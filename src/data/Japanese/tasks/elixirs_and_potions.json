			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティマイオス",
					"鶯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590401,
					"content": "古法香膏を作るんは、かなり手間がかかるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590402
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590402,
					"content": "恋人の肌に触れるかのように、優しぃく花のつぼみを剥がす。そして、花びらを丁寧に積み上げていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590403
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590403,
					"content": "薄い花びらは上に、厚い花びらは下に。適度な隙間を空けて、潰していく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590404
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590404,
					"content": "杵はあまり強う握らへんでもええ。手首の力を抜いて、一定の間隔で動かす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590405
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590405,
					"content": "すると花びらから汁が漏れ出てきて、濃厚な香りが漂ってくる。杵の底が完全に濡れたら、速度をいい感じに上げるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590406
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590406,
					"content": "あ、えっと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590407
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590407,
					"content": "しゅ、鶯さんの言葉遣いはなんというか…その…独特…そう独特だなぁ！でも、とりあえず意味は大体理解できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590408
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590408,
					"content": "原料を慎重に扱い、容器に入れる順番や液体に浸すタイミングに注意する。そうすることで、火加減を正確にコントロールすることができると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590409
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590409,
					"content": "高級な錬金薬剤を作る時も同じだ。こういった細かいことろに注意を払わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590410
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590410,
					"content": "あんた、飲み込みが早いなぁ。せやけど、香膏を作るには、それだけでは足らへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590411
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590411,
					"content": "一部の香膏では「昇華効果」が極めて重要なんや。そのためには、適切な材料を加える必要がある。例えば、ミントと星螺を粉にしたものとかやな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590412
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590412,
					"content": "そうすることで、香膏の香りがたちまち周囲に広がり、人を気持ち良うしてくれるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590413
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590413,
					"content": "ただし、「昇華効果」が強すぎると、香膏がすぐになくなってまうから注意や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590414
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590414,
					"content": "昇華…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590415
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590415,
					"content": "そうだ！この古法香膏の特性は、ちょうど僕が考えていたものの役に立つかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590416
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590416,
					"content": "空中を漂う薬剤は、使用者と環境の両方に作用する。そうすれば、普通のオイルよりも高い効果を発揮してくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590417
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590417,
					"content": "それに、昇華速度を適切にコントロールすることで、持続時間も普通のオイルより長くなる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590418
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590418,
					"content": "この考えを基に研究すれば、きっと上手くいくはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590419
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590419,
					"content": "学術的な話だと、完全にオイラたち蚊帳の外だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590420,
					"content": "二人の邪魔をしないでおこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590421,
					"content": "鶯の指導のもと、ティマイオスは改良型錬金薬剤を作り始めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590422
					]
				},
				{
					"id": 716590422,
					"content": "おおっ、いい香りだな！においを嗅いでるだけで、なんだか気分が爽やかになって、力がみなぎってくるような感じがするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590423,
						716590424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590423,
					"content": "確かに元気が出る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				},
				{
					"id": 716590425,
					"content": "成功した！やっと上手くいったぞ！古法香膏の製法を取り入れた、新たな錬金薬剤の完成だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590426
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590426,
					"content": "鶯さんの指導があったからこそ、こんなにも短時間でコツを掴むことができた。おかげでいい薬剤を作ることができたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590427
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590427,
					"content": "あまり謙虚すぎると、ちゃんとした評価を得られなくなってまうで。あんたの知識と理解があってこそ、成功したんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590428
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590428,
					"content": "ほな…次はあんたの作品に名前をつけへんとな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590429
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590429,
					"content": "そうだな…うん、「煙霰ポーション」にしよう！鶯さんの香膏と錬金薬剤の特性を合わせたものだ、これこそ相応しい。きっと学術の歴史に名を残すだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590430
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590430,
					"content": "あらまあ、そら嬉しいわぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590431
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590431,
					"content": "けど、「煙霰丹剤」とあんま変わってなくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716590432,
					"content": "こほんッ、話を戻そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590433
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590433,
					"content": "旅人、君にこの「煙霰ポーション」を使ってみてもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590434
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590434,
					"content": "今の「煙霰ポーション」には、まだ改善の余地があるはずだ。この薬剤の効果を実際に試してみてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590435
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590435,
					"content": "空気の流れが比較的緩やかな場所であるほど、この「煙霰ポーション」は効果を発揮できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590436
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590436,
					"content": "璃月には、誰も近寄らない秘境があると聞いた。そこなら、理想的な実験場として使えるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590437,
						716590438
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590437,
					"content": "人助けは最後までやり通す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590439,
					"content": "それじゃあ、頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590440
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590440,
					"content": "僕はしばらくここにいるよ。君のフィードバックを基に「煙霰ポーション」を改良しようと思う。それに、鶯さんと学術的な意見交換もしたいしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590441
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590441,
					"content": "ええ知らせを待っとるでぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯"
				},
				{
					"id": 716590438,
					"content": "興味が湧いてきた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590424,
					"content": "確かに不思議な効果がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				}
			]
		},
