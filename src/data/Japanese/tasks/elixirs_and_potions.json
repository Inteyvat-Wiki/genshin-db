				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590201,
					"content": "さて、一度地図を見てみよう…璃月港の南部は「チ虎岩」って言うんだよね？伝説の「丹剤宗匠」は、その辺りに住んでるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590202
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 716590202,
					"content": "着いたぞ、ここが「チ虎岩」だ！この辺りを探してみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
