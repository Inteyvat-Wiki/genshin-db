			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大祐",
					"悦子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "あっ！こんにちは、今日は何してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120202,
					"content": "寝子のために彫像を作ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "…えっ？彫像？ここで？本当に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120204,
					"content": "ぼ、僕、彫像の作り方を勉強してくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120205,
					"content": "間に合わないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "またその寝子が君たちに頼んだの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120207,
					"content": "そういえば、たたら砂で事故が起こってから、たくさんの職人が仕事を探してたわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120208,
					"content": "以前、それに関する依頼が協会にもたくさん入ってた。私の知る限り、まだたたら砂で仕事を探してる人たちがいるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120209,
					"content": "前に協会の依頼を執行してた時、似たような拠点を見たわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120210,
					"content": "もし気になるのなら、そこに行ってみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120211,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "ふふ…気にしないで、大したことじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120215,
					"content": "私も、あの神社が賑やかになったらどうなるか…見てみたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120216,
					"content": "特にあの「響」って人…寝子があれほどまで気にかけるなんて、いったいどんな人なんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120217,
					"content": "さあ、ここで私の独り言を聞いてないで、早く職人を探してきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120218,
					"content": "まあ、君たちの見つけた職人が石の彫刻を作れるかどうかについては…ふふ、君たちの運次第ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120219,
					"content": "悦子、実は君も寝子さまを手伝いたいんでしょ？あははっ、君ってやっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120220,
					"content": "大祐、調査計画は書き終えたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722120221,
					"content": "うっ！す、すぐ終わるから…本当にごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				},
				{
					"id": 722120212,
					"content": "悦子さん普段となんか違う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "どうして？私から君たちに情報をあげることが、そんなに変かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "悦子"
				}
			]
		},
