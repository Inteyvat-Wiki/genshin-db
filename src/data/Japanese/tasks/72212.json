			"dialogs": [
				{
					"id": 722120401,
					"content": "帰ってきたか。その人間が石人間にゃのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120402,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が連れてきた職人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "え？えっ！猫…猫がしゃべった！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120405,
					"content": "にゃにゃ、そんなに驚くことにゃのか…うちがしゃべるのがそんなに変か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120406,
					"content": "別に驚くことじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "いやいや！これは君たちにとって、なんでもないことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120409,
					"content": "別に普通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "いったい何を経験してきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120411,
					"content": "まあまあ、雑談はそこまでにするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120412,
					"content": "とにかく、石人間、主は石をうちの姿と同じにすることはできるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120413,
					"content": "えっ？石人間？俺のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120414,
					"content": "石…ああ、石の彫刻のことか。やってみることはできるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120415,
					"content": "本当か？それはよかったにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120416,
					"content": "そうか…何はともあれ、仕事があるのはいいことだ。今まで猫の下で働いたことはないが…報酬の話は…また今度でもいいだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120417,
					"content": "ふむ、俺は少し準備作業をしてくる。この島には石が多くある、良いものを選ばなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120418,
					"content": "その、君のことはどうやって呼べばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120419,
					"content": "うむ、うちはこの「浅瀬神社」の代理宮司、寝子にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120420,
					"content": "背が高くて石が叩ける人間、主がうちをどう呼ぶかは、好きにするといいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120421,
					"content": "そうか？じゃあ…代理宮司様と呼ぶことにする。なんたって雇い主だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120422,
					"content": "「やといぬし」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120423,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120424,
					"content": "じゃあ、俺は近くで石を探してくるよ。君たちはここで、雑談でもするといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120425,
					"content": "猫の下で働く…なんだか新しい感覚だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722120426,
					"content": "大島さん、もう報酬のことは全然考えてないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722120407,
					"content": "猫が言葉を話してるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "そう、石人間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
