			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "はぁ、一体いつになったら仕事が見つかるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120302,
					"content": "君たちは…俺に会いに来たのか？何の用だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120303,
					"content": "石の彫刻は作れる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "本当か…？よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120306,
					"content": "自己紹介がまだだったな…俺は大島純平、以前はたたら砂で仕事をしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120307,
					"content": "あの事故のあと、俺は他の者たちと一緒にあそこを離れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120308,
					"content": "だが…今になってもまだ作業再開の知らせが来ていない。だからずっとここにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120309,
					"content": "石の彫刻を作れる人を探してるんだよな？俺は専門的なことはあまり知らないが、ちょっとした彫刻なら作れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120310,
					"content": "どんな彫刻を作りたいんだ？教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120311,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "えっと、喋る猫が君たちに、石の彫刻を作らせるよう頼んで…それで職人を探してる…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120313,
					"content": "信じないわけじゃないんだが…ちょっと…ありえないと思ってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120314,
					"content": "他のことは置いといて…たとえ俺が君たちに応じても…その「代理宮司」様はどうやって報酬を支払うんだ？タダ働きは御免だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120315,
					"content": "それは安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "（ほ、本当に安心していいのか…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722120317,
					"content": "そうか。だが…なんだか騙されてるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120318,
					"content": "だが…まあいい、どうせ暇なんだ、とりあえず行ってみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120319,
					"content": "本当に報酬を払ってもらえるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 722120304,
					"content": "石の彫刻が作れる職人を探してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
