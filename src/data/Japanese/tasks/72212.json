				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "ちょうどいい時に来たにゃ。手伝ってほしいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "うちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120104,
					"content": "神社のそばに、高くて大きくて、うちと同じ姿をした石を置きたいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120105,
					"content": "ど、どこにそんな石があるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722120106,
					"content": "彫像のことだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "とにかく、うちが欲しいものは、あの遠い島にある狐の石と同じにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120108,
					"content": "あの島には狐の石がたくさんあって、いつかうちにもあげたいと響が言っていたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120109,
					"content": "響が欲しいものなら、きっと良いものだと思うにゃ。だから、その石を主らにお願いしたいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722120110,
					"content": "彫刻はやったことない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "うーん、どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722120112,
					"content": "そうだ、大祐に聞いてみよう！あんなに猫が好きなら、寝子のために彫刻を学んでくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722120113,
					"content": "大祐に手伝ってもらおう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "そうだな！あんなに猫が好きなら、なにか役に立てるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221202",
							"2"
						],
						"stepId": 7221202,
