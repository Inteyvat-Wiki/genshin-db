			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アーンショウ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000601,
					"content": "もっと簡単な仕事だと思ったのに、あいつらワガママすぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000602,
					"content": "これで分かっただろう。ワガママなやつは、しっかりしつけんといかんのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000603,
						740000605
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000603,
					"content": "花を踏むなって規則は覚えてるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000604
					]
				},
				{
					"id": 740000604,
					"content": "#{NICKNAME}も飛べたらいいのにな。地面に足つけて歩くって大変だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000607,
					"content": "疲れたのなら、少し休んでから出かけるといい。ちょうどラタトゥイユ·タッセスを作ったところだ。あんたたちも食べていけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000608
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000608,
					"content": "おお、おいしいご飯にありつけるぞ！あっ…えっと、やっぱいい…遠慮しとく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000609,
					"content": "ん？わしの腕が信用できんか？他のものは別としても、ラタトゥイユ·タッセスはわしの得意料理だぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000610
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000610,
					"content": "食べたら、しつけがなってないって思われそうだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000611,
					"content": "これは労働の対価だ。腹が減っては何事もできん。そうだ、あんたたちは冒険者だったな…ならば、なおさらしっかり腹ごしらえしておけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000612
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000612,
					"content": "それと依頼の規則に従って、正式な報酬は後ほど支払うとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000613
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000613,
					"content": "へへっ、そういうことなら遠慮なく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000614,
					"content": "老人に室内へ招かれ、野暮ったいラタトゥイユ·タッセスを食べた。シチューの温もりが体にしみわたり、疲れが吹き飛んだ気がした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740000615
					]
				},
				{
					"id": 740000615,
					"content": "働いたあとのご飯はまた格別だな！しかもこのラタトゥイユ·タッセス、なんていうか…家庭の味がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000616,
					"content": "食材と調理方法が平凡だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000617
					]
				},
				{
					"id": 740000617,
					"content": "平凡だけどおいしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000618,
					"content": "当たり前だ。うちの偏屈な娘ですら、ほめちぎってたくらいだ。喧嘩の最中でも、シチューの匂いをかげば大人しくテーブルについたもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000619
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000619,
					"content": "今は匂いも届かんほど遠くにいるがな。きっと、家に帰る道すらきれいさっぱり忘れたんだろうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000620
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000620,
					"content": "そっか…あっ、オイラたち人捜しもできるぞ。娘さんの特徴を教えてくれたら、居場所を見つけられるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000621,
					"content": "旅の途中で会えたらの話だけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000622
					]
				},
				{
					"id": 740000622,
					"content": "ありがとう、あんたたちはいい子だな。ただ、娘は自力で捜せんこともない。以前も手紙は何通か送ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000623
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000623,
					"content": "だが、娘は自分に一切非がないと思いこんでおる。でなきゃ、里帰りもせず手紙だけ送ってくるなんてことはせんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000624
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000624,
					"content": "だから、娘の手紙は開封すらせんかった。動物は聞きわけがなくとも仕方ないが、あいつは大の大人だ。それでいいはずがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000625
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000625,
					"content": "そういえば、最近はめっきり音沙汰もない…手紙を送るだけ無駄だと思ったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000626
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000626,
					"content": "とにかく、人を雇ってまで娘を連れ戻したいとは思わん。自分から謝りに来るか、もう二度と戻らん覚悟を決めるか、好きにすりゃいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000627
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000627,
					"content": "そ、そっか…おじいちゃんがそう言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000628,
					"content": "なんにしても、勇者たちを連れ戻してくれてありがとう。大した報酬は払えんが…まだ少しラタトゥイユ·タッセスが残っている。持っていくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000629
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000629,
					"content": "冒険者はよく野宿するんだってな？ちゃんと腹いっぱい食べて暖かくするんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000630
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000630,
					"content": "おう！おじいちゃんの脚の傷も早く治るといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000631,
					"content": "身体には気をつけて、がんばれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000605,
					"content": "パイモンにも規則が必要かもね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000606
					]
				},
				{
					"id": 740000606,
					"content": "オイラのどこがワガママなんだよ…って違う！オイラは聞きわけのないペットじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7400007,
