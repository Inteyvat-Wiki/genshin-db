			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラノール",
					"アーンショウ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000701,
					"content": "この任務…想像以上に厄介だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000702,
					"content": "ガーデンの巨人は本当に紫の花が好きだし、いつもうるさく言ってくるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000703
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000703,
					"content": "聞き分けの悪い子をしつけるのは早い方がいい、手遅れになる前にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000704,
						740000706
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000704,
					"content": "パイモン、分かった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000705
					]
				},
				{
					"id": 740000705,
					"content": "え？関係ないだろ！オイラは聞き分けの悪い子供じゃないからな！フン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000708,
					"content": "遊び疲れただろう？今日もラタトゥイユ·タッセスを作ったから、座って一緒に食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000709
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000709,
					"content": "#そうだよ！{NICKNAME}{M#お兄}{F#お姉}ちゃん、パイモンお姉ちゃん、一緒に食べよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000710
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000710,
					"content": "#よーし！ラノールがそう言うんだ、{NICKNAME}、お言葉に甘えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000711,
					"content": "うん、いただきます。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000712
					]
				},
				{
					"id": 740000712,
					"content": "みんなラノールの友達だ、遠慮は要らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000713
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000713,
					"content": "屋内に招待され、垢抜けてはいないが美味しいラタトゥイユ·タッセスを楽しんだ。\\n食卓で旅の見聞を話すと、老人は面白がり、少女はケタケタと笑った。\\n笑い声の中で楽しい時間が過ぎていく…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740000714
					]
				},
				{
					"id": 740000714,
					"content": "どう？おじいちゃん、ウォルジーおじさんより美味しく作るでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000715,
						740000716
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000715,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000718
					]
				},
				{
					"id": 740000718,
					"content": "#{NICKNAME}{M#お兄}{F#お姉}ちゃん、パイモンお姉ちゃん分からない？私も手伝ったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000719
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000719,
					"content": "今はちょっとしたお手伝いしかできないけど、おじいちゃんには「経験を積めば自分と同じくらい美味しいラタトゥイユ·タッセスが作れるようになる」って言われたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000720
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000720,
					"content": "#へへ、その時には{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}にも食べてもらうからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000721
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000721,
					"content": "約束だぜ！楽しみだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000722,
					"content": "そんじゃ、長らくお邪魔したから、そろそろおいとまするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000723,
					"content": "…もう行っちゃうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000724
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000724,
					"content": "ラノール、わがままを言うな、この人たちもすることがある、あんたと遊んでばかりもいられんのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000725
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000725,
					"content": "うぅ…わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000726
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000726,
					"content": "そんなに悲しむなよ…機会があればまた会える！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000727,
					"content": "本当に？じゃあ次はキャタピィお兄ちゃんも一緒に来てくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000728
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000728,
					"content": "それは…その可能性もなきにしもあらず、だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000729,
					"content": "わかった、次に会うまでに面白い話をたくさん用意しておくからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000730
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000730,
					"content": "うんうん、あいつはきっとラノールの話を楽しみにしてるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000731,
					"content": "ラノールの面倒を見て、遊んでくれてありがとう。ここにラタトゥイユ·タッセスがまだ残っているから、道中で食べるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000732
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000732,
					"content": "冒険者はよく野宿するんだってな？腹いっぱい食べて暖かくしろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000733
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000733,
					"content": "ああ！アーンショウじいちゃんとラノールも元気でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000716,
					"content": "ほぼ一緒かな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000717
					]
				},
				{
					"id": 740000717,
					"content": "やっぱりアーンショウじいちゃんの作ったラタトゥイユ·タッセスのほうが美味しいな、何というか、家庭的な味がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000706,
					"content": "悪い子はガーデンに閉じ込めちゃうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000707
					]
				},
				{
					"id": 740000707,
					"content": "ふふん、オイラは花を踏むことはないし、魔法使いにお願いしなくても高い塀を越えられるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
