				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アーンショウ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000101,
					"content": "この大バカ者どもめ…わしの言うことが聞けんのか！山の向こうでも街でも、どこへでも好きなところへ行くがいい。二度とわしの前に姿を現すな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000102
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000102,
					"content": "お、おい…なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000103,
					"content": "ふんっ…別に大したことじゃない。勇者がまた逃げ出した。いつものことだ。この前も「検査」と聞いた途端、外に飛び出していった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000104
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000104,
					"content": "今回は王子と姫も一緒だ。この前、花畑の手入れをしてた時につまづいて怪我をしてなければ、あいつらを懲らしめるくらい造作もなかったというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000105
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000105,
					"content": "あんたたちは登山客か？ひと休みしたいなら、ひとまず部屋に入っていてくれ。あのバカどもを連れ戻したら、対応するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000106,
						740000108
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000106,
					"content": "そう、テイワットの山を完全踏破する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000107
					]
				},
				{
					"id": 740000107,
					"content": "そんな目標、いつ立てたんだよ？オイラは聞いてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000110,
					"content": "#とにかく、まずは自己紹介をしようぜ。オイラはパイモン、こっちは{NICKNAME}、冒険者だ。人捜しだったら、今までもいっぱいしてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000111,
					"content": "おじいちゃん、足が不自由なんだろ？人捜しならオイラたちに任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000112,
					"content": "冒険者なら…なぜ緑色の制服を着ておらんのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000113
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000113,
					"content": "あれは別に強制ってわけじゃないぞ。なんていうか…オイラたちはベテランの冒険者だから、好きな格好をしてオッケーなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000114,
					"content": "ほう、そうかい。ベテランの冒険者なら、報酬も上乗せせんといかんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000115
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000115,
					"content": "わしのことはアーンショウと呼んでくれ。あんたたちが手伝ってくれるのなら、それに越したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000116
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000116,
					"content": "おう！で、人を捜せばいいんだよな？えーっと、勇者に王子、あと姫だっけ？なんか変わった名前だな…子供のあだ名か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000117,
					"content": "犬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000118
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000118,
					"content": "ふ～ん、犬か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000119,
					"content": "…ん？犬の名前なのか？な、なんていうか、メルヘンチックな名前だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000120,
					"content": "娘がつけたんだ。あの子が泣いて駄々をこねんかったら、あんなひ弱な動物は飼わんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000121
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000121,
					"content": "子犬の頃は間抜けでかわいらしかったが、大きくなった今じゃヤンチャな駄犬だ。ちょっと厳しくしつけたら、すぐに反抗して逃げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000122
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000122,
					"content": "そう遠くまでは行っとらんはずだが、とにかく連れ戻さんといかん。立派な勇者が歯の検査におびえるとは…まったくとんだ笑い種だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000123,
						740000125
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000123,
					"content": "お腹が空いたら戻ってくるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000124
					]
				},
				{
					"id": 740000124,
					"content": "もしかすると野生の血が騒いで、山に帰って一流の狩人になるかもしれないぞ！いや、それはそれで結構おもしろいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000127,
					"content": "ならん、規則は規則だ。一度味をしめると、歯止めが利かなくなって堕落するだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000128
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000128,
					"content": "で、でもただの犬だろ？そんなに厳しくする必要あるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000129,
					"content": "身近に悪い見本がいるからな。うちのバカ娘は何年も前に出ていったきり帰ってこん。勇者たちもその後に続いてくれていたら、手間が省けたんだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000130
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000130,
					"content": "だがバカ娘が帰ってきた時に、泣いてせがんだ犬がみんないなくなっていたら、また喚くに違いない。まあ、しょせんは自分がまいた種だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000131,
						740000132
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000131,
					"content": "（家庭に問題があるのかな。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000133
					]
				},
				{
					"id": 740000133,
					"content": "ふぅん…とにかく、そいつら全員を連れ戻せばいいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000134,
					"content": "…そうだ。山は危険だ…夜になると特にな。あいつらは自分の弱さを知らんのだ。たとえ嫌でも、家のほうが安全に違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000135
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000135,
					"content": "勇者は北に向かって、ずっと駆けていった。もう老犬だというのに、遊びたくてしょうがないらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000136
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000136,
					"content": "しかも道端に食べ物が落ちていたら、そこからテコでも動かない。妙な情けは無用だ。変なものを食って腹でも壊したら、困るのはあいつ自身だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000137
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000137,
					"content": "どうしても動かないとねばったら、心を鬼にして<color=#00E1FFFF>そのどこで手に入れたのか分からない食べ物を奪ってくれ</color>。そうすれば、あいつも帰る気になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000138
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000138,
					"content": "あとの二匹はそう遠くへは行かず、庭で暴れ回ってる。犬小屋に連れ戻してくれたら、それでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000139
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000139,
					"content": "#なーんだ、ぜんぜん簡単そうだな？オイラと{NICKNAME}に任せとけ。おじいちゃんはここで待ってろ。すぐ戻ってくるからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000140,
					"content": "<color=#00E1FFFF>囲いの中にある花は、絶対に踏んではならんぞ。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000141
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000141,
					"content": "#おう、気をつけるぞ。<color=#00E1FFFF>花を踏まないように</color>、だな？オイラも{NICKNAME}も、動きは機敏だから大丈夫だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000132,
					"content": "（余計な詮索はやめておこう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000133
					]
				},
				{
					"id": 740000125,
					"content": "日が暮れたら戻ってくるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000126
					]
				},
				{
					"id": 740000126,
					"content": "結局、自分の家が一番だもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000108,
					"content": "ただの通りすがり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000109
					]
				},
				{
					"id": 740000109,
					"content": "絶対「そこに山があるから」なんて理由で、最初の目的を変えたりしないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000110
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7400002,
			"completionStepIds": [
				7400006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7400006",
							"2"
						],
						"stepId": 7400006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"ラノール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000201,
					"content": "#わぁ！{NICKNAME}{M#お兄}{F#お姉}ちゃんとパイモンお姉ちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000202
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000202,
					"content": "ラノールとアーンショウじいちゃん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000203,
					"content": "新しい家には慣れた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000204
					]
				},
				{
					"id": 740000204,
					"content": "#違うよ違うよ、{NICKNAME}{M#お兄}{F#お姉}ちゃんったら。ここは新しい家じゃなくて古い家だよ。キャタピィお兄ちゃんもそう言ってたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000205
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000205,
					"content": "おじいちゃんの作るラタトゥイユ·タッセスは美味しいの！わたしも教えてもらってるけど、まだ時間がかかりそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000206
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000206,
					"content": "時間はたっぷりある、ゆっくり覚えればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000207
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000207,
					"content": "そうだ、「キャタピィお兄ちゃん」は一緒じゃないのか？まだ直接礼を言えてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000208
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000208,
					"content": "あいつはまだ用事があって、別行動中なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000209,
					"content": "そうか、実に残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000210
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000210,
					"content": "パイモンお姉ちゃん、わたしを忘れちゃったのかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000211
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000211,
					"content": "まさか！忙しくて来れないだけだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000212,
					"content": "えっと…おまえたち約束しただろ？次に会ったら、あいつは前の話の続きを聞かせてくれるし、おまえも面白い話をいろいろ準備したんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000213,
					"content": "うん…だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000214
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000214,
					"content": "コホン、勇者のやつめまたどこに行ったんだ。ラノール、勇者を連れ戻してきておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000215
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000215,
					"content": "外で遊び回って汚れているだろうから、戻ってきたら洗ってやれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000216
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000216,
					"content": "えー！外で遊ばせてあげようよ、ずっと家にいて退屈してたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000217
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000217,
					"content": "あれが遠くへ行って戻ってこなかったり、森の怪物に捕まったりしたら、べそべそ泣くのはあんただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000218
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000218,
					"content": "う…じゃ、じゃあやっぱり連れ戻して洗ってあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000219
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000219,
					"content": "ちょうど王子と姫も庭で遊んでいるから、二匹とも家に入れてやりなさい。きっと泥まみれだろうから、あとでわしが洗ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000220
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000220,
					"content": "#わかった。じゃあ{NICKNAME}{M#お兄}{F#お姉}ちゃん、それにパイモンお姉ちゃんは先に休んでて、ちょっと待っててね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000221
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000221,
					"content": "一緒に行かないか？メロピデ要塞を探検した時みたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740000222,
					"content": "#{NICKNAME}{M#お兄}{F#お姉}ちゃんとパイモンお姉ちゃんと一緒に探検？嬉しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000223
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000223,
					"content": "うーん…じゃあ今回の探検は「勇者救助作戦」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000224,
						740000226
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000224,
					"content": "勇者は自分で助かる方法を考えきゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000225
					]
				},
				{
					"id": 740000225,
					"content": "でも本当は犬、しかも老犬だから、若き勇者であるわたしたちが泥の中から助けてあげなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000228
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000228,
					"content": "一緒に行くなら、勇者がそこらへんのものを食べないように見てやってくれ。おそらくまた北の小屋で遊んでいるだろうから、少し北に向かえば見つかるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000229
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000229,
					"content": "わかった、<color=#00E1FFFF>帰りたくないって駄々をこねたら、餌で釣れば</color>大人しく帰ってくるよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000230
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000230,
					"content": "分かればよろしい。それから<color=#00E1FFFF>塀の中の花を踏まないように</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000231
					],
					"speakerTitle": "アーンショウ"
				},
				{
					"id": 740000231,
					"content": "#パイモンお姉ちゃんなら心配無用だよね！わたしと{NICKNAME}{M#お兄}{F#お姉}ちゃんは気を付けるから、おじいちゃん、安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000232
					],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000232,
					"content": "#{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、パイモンお姉ちゃん、行きましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラノール"
				},
				{
					"id": 740000226,
					"content": "王子と姫の名前は入れないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000227
					]
				},
				{
					"id": 740000227,
					"content": "そうだ…でも全部名前に入れたら長すぎるもん。「勇者救助、ついでに王子と姫も連れ戻す」とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000228
					],
					"speakerTitle": "ラノール"
				}
			]
		},
