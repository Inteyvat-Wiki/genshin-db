				"points": []
			},
			"dialogs": [
				{
					"id": 756650101,
					"content": "こんにちは。「竜の遠征隊補給ステーション」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650102
					],
					"speakerTitle": "ヴィネシュ"
				},
				{
					"id": 756650102,
					"content": "わぁ、仔竜がいっぱいいるぞ！みんなで海風草を探しに行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756650103,
					"content": "海風草を探すチームはもう出発したわ。時間がもったいないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650104
					],
					"speakerTitle": "ヴィネシュ"
				},
				{
					"id": 756650104,
					"content": "ここの「子供たち」も手伝いたいって言うんだけど、イファ先輩やカクーク先輩からいくら教えてもらっても、海風草を理解できないみたいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650105
					],
					"speakerTitle": "ヴィネシュ"
				},
				{
					"id": 756650105,
					"content": "それでもこの熱意に応えて、イファ先輩はこの子たちを遠征に行かせることにしたのよ。遠征先で何をするかは、この子たち次第。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650106
					],
					"speakerTitle": "ヴィネシュ"
				},
				{
					"id": 756650106,
					"content": "大好物のグレインの実を探してもよし、宝探しをしてもよし——とにかく、安全に気をつけて無事に帰ってきてくれればそれでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650107
					],
					"speakerTitle": "ヴィネシュ"
				},
				{
					"id": 756650107,
					"content": "なるほど。こいつら、嬉しそうだな。悪い魔物もたくさんいるから、気を付けるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756650108,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756650109
					],
					"speakerTitle": "活発なテペトル仔竜"
				},
				{
					"id": 756650109,
					"content": "ここでは遠征に参加する仔竜を指導してるわ。興味があるなら、見学してって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィネシュ"
				}
			]
		}
	]
}