						710580554
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580554,
					"content": "#ちなみに、ちなみにだけど…！{NICKNAME}、ちょっと待って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580555
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580555,
					"content": "うぅ…なんでもない、ただ…あんたなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580556
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580556,
					"content": "日を改めて私のところに来てほしいの…もしよかったらだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580552,
					"content": "自分の基準で人に要求したらだめだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580553
					]
				},
				{
					"id": 710580537,
					"content": "#既に知ってるかもしれないけど、{M#俺}{F#私}は{NICKNAME}。",
