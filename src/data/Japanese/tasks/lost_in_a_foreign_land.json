						710580552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580551,
					"content": "パイモン、落ち着いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580553
					]
				},
				{
					"id": 710580553,
					"content": "ふん！",
					"roleType": "TALK_ROLE_NPC",
