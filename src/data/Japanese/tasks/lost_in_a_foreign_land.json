			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カタリナ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "こほん…ふぅ…ちょっと待って…！あなたは誰？どうしてここに…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580102,
					"content": "それに…どうして攻撃してきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580103,
					"content": "それはこっちのセリフだぞ！おまえがこんなところでコソコソしてるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580104,
					"content": "#{M#君}{F#あなた}が悪い人だから。そっちから言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "…カタリナ、カタリナ·スネージヴナ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580106,
					"content": "名前は私たちが守っているものの中で価値が一番低い情報。これ以上のことは言えないわ、ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580107,
					"content": "えっと…オイラたちは状況を聞いてみただけで、おまえを問い詰めるつもりはないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580108,
					"content": "ごめん、ごめん。これは私が教えられるすべての情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580109,
					"content": "どうしてファデュイがここで活動してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580111,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "なんだよ！コソコソと、悪いやつらめ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580113,
					"content": "ふふ、そうよ。私たちはそんな悪いやつだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580114,
					"content": "さて、質疑応答の時間はここまでよ…私たち、大変なことになっちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カタリナ"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
