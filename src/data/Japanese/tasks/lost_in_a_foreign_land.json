			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カタリナ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "ありがとうね…何より、あんたに後ろから刺されなかったのが嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580202,
					"content": "それはこっちのセリフ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "ぷっ…あんたがファデュイにどんな先入観を持っているのかは知らないけど、こんなところで話すのはまったくロマンチックじゃないわ…話があるなら私の隠れ家に来なさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580207,
					"content": "カタリナはその場から立ち去った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "ええ？あいつはファデュイだぞ。あいつをこのまま逃していいのか？千岩軍に渡さなくてもいいのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580206,
					"content": "ふん…分かったよ。まあいいか、別にオイラたちもケガはしてないし、あいつを許してやるとするか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580203,
					"content": "ファデュイは誰に対しても疑り深いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カタリナ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "やっぱり来たわね。好きな場所に座って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580502,
					"content": "ここには…えっと…紅茶はなくなったし…砂糖ももうない…うん、牛乳は、オエッ——もう腐ってる。後で捨てなきゃ…本当にごめんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580503,
					"content": "でも炎水ならたくさん残ってるわよ…お菓子には硬いクッキーもある、それに酸っぱいジャムも残ってるし…うん、茶会を開くには十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580504,
					"content": "わぁ…！おまえたちは炎水なんて強い酒で茶会をやってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580505,
					"content": "そうだけど、変かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580506,
					"content": "えっと…やっぱり遠慮しておくね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "どうしたの？へへ、ここではお酒を飲んだって誰にも何も言われないんだから、畏まらないでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580510,
					"content": "何がしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "「適切なタイミングで食べ物と情報を共有することで、質問する人の口を塞ぐことができます。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580513,
					"content": "…私たちのハンドブックにはそう書いてあるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580514,
					"content": "でも、情報は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "ん？今教えたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580516,
					"content": "なんだよ…なにか言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580517,
					"content": "「『ファデュイ先遣隊訓練ハンドブック』付録4-4、第32条：適切なタイミングで食べ物と情報を共有することで、質問する人の口を塞ぐことができます。」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580518,
					"content": "命を助けてくれたものね、秘密の訓練ハンドブックの内容まで教えてあげたわよ！ふふん、誠意は十分でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580519,
					"content": "それを知ってなんの役に立つんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580520,
					"content": "ふふ、冗談はここまでにしましょう…本当に、助けてくれて感謝してるわ。この好意を誤解しないでほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580521,
					"content": "うぅ…おまえらが今までやってきたことを考えると、ファデュイが好意を持ってるなんて信じないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580522,
					"content": "何を企んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "外部の人がファデュイの理念を理解できないのは、分かっているわ。でも、理念とか立場を抜きにすれば、私たちも普通の人間だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580524,
					"content": "…それに、目的がなんだろうと、私たちは、最後の決戦のために準備をしているだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580525,
					"content": "最後の決戦…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "ええ、最後に私たちが直面するのは、共通の強大な敵と、逃げ場のない長い夜よ…スネージナヤの国民はみんなこの警告を受け入れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580527,
					"content": "だから、この冷酷な世界のために、人類が流したすべての血と涙は無意味なものじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580528,
					"content": "乾杯する？ふん、分かった分かった、私が飲むわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580529,
					"content": "悪行を働くことの言い訳をしているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "そうかもね…私は知らないし、気にしてもいないわ。あんたが解釈したいなら、理由を説明してあげないこともない…ただし、それは私なりの理由だから、あんたは気に食わないかもしれない。それだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580534,
					"content": "うぅ…なんでいきなり真面目に話し始めたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580535,
					"content": "ちなみに、私はもう自己紹介をしたわよ。あんたたちの名前はまだ聞いていないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "オイラはパイモン！聞いたことあるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580539,
					"content": "ああ！あんたたちの名前…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580540,
					"content": "ふふんっ！どうだ？きっとテイワット大陸中に轟いてるんだろう、そうだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580541,
					"content": "ごめん、どっちも初耳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580542,
					"content": "え——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580543,
					"content": "気に障ったらごめんね。でも私たちは遥か前からここに配備されたの。補給線から流れてくる情報以外、地上のことはほとんど何も知らない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580544,
					"content": "え…！それってつまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580545,
					"content": "その補給線がだいぶ前から断たれてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580546
					]
				},
				{
					"id": 710580546,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580547
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580547,
					"content": "茶会の時間はここまで！私は休むから、ごめんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580548
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580548,
					"content": "おい！まだ何も食べてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580549
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710580549,
					"content": "さっさと出なさいよ！私の炎水に文句言ったくせに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580550
					],
					"speakerTitle": "カタリナ"
				},
				{
					"id": 710580550,
					"content": "あんなもの、飲めるようなものじゃないだろ！",
