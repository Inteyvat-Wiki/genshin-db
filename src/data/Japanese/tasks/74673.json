					}
				]
			},
			"dialogs": [
				{
					"id": 746730101,
					"content": "ちびっこ、俺は本当にダイビングはできないんだ。見ろ、潜水服も着てないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730102
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730102,
					"content": "はぁ…いくらそうやって飛び跳ねても、一緒に潜るわけにはいかないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730103,
						746730104
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730103,
					"content": "ウルマンもフォンテーヌに来てたんだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				},
				{
					"id": 746730105,
					"content": "#{NICKNAME}、それにパイモン！こんなところで会えるなんて、奇遇だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730106
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730106,
					"content": "相変わらず仙霊に好かれてるんだな。それに…前よりもっと仙霊との交流に慣れた感じがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746730107,
					"content": "仙霊が何て言っているのか通訳して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730108
					]
				},
				{
					"id": 746730108,
					"content": "おいおい、からかうなよ。俺だってこいつが何を言いたいのかなんて、分からないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730109
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730109,
					"content": "フォンテーヌへは商売をしに来ただけなんだが、水辺を散歩していたら急に、また小さな仙霊につきまとわれてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730110
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730110,
					"content": "俺ももう慣れっこだから、後をついて行ってやった。山を越え、峠を越えて、さらに船まで漕いだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730111
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730111,
					"content": "で、普通はそれでぴょんぴょん跳ねて、何かが埋まっている場所を教えてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730112
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730112,
					"content": "だが…こいつは水中に潜っていくんだ。それもどんどん深く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730113
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730113,
					"content": "——俺はダイビングなんてできない！それに噂だが、この水中には海流のほかにも、色々と危険があるらしくてな…俺は船の上で、こいつが帰ってくるのを待つしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730114
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730114,
					"content": "ところが、あの小さいやつはめげずに俺をあちこち連れて行くんだ…俺は本当にダイビングはできないんだって、分かってくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730115,
						746730117
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730115,
					"content": "フォンテーヌの特色は味わえた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730116
					]
				},
				{
					"id": 746730116,
					"content": "ああ、たっぷりな。友好的で、情熱的で、善良で…家に帰ることを忘れさせるお国柄だな。はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730119,
					"content": "ってことは、きっとまたオイラたちに行ってくれっていうんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746730120,
					"content": "その通りだ！話が早い。ありがたいことに、お前たちはここの人たちの影響をあまり受けていないらしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730121
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730121,
					"content": "「我が親愛なる」フォンテーヌ人の話し方には、もううんざりしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730122
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730122,
					"content": "だいたい二十単語の中に敬称が二つ、比喩が三つ、形容詞が六つも入るんだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730123,
						746730124
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730123,
					"content": "#{M#俺}{F#私}はいつも率直だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730125,
					"content": "くそ…俺まで影響を受けてる気がするな…さあ、このノートを持っていけ。あのちびっこが連れて行ってくれた場所を全部記してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730126
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730126,
					"content": "前と同じように、古鉄銭を見つけたら持ってきてくれ。高値で買い取ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730127
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730127,
					"content": "#じゃあ{NICKNAME}、パイモン。この協力がうまくいくことを願ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730124,
					"content": "#確かに{M#俺}{F#私}はレトリックには詳しくないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730117,
					"content": "魔物との遭遇にはもう慣れっこかとばかり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730118
					]
				},
				{
					"id": 746730118,
					"content": "確かに慣れてはいるがな。だが…陸なら踵を返して逃げられるが、水中で魔物に出くわしても、俺は全然泳げないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 746730104,
					"content": "#{M#君}{F#あなた}ってやっぱり仙霊に縁があるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				}
			]
		}
	]
}