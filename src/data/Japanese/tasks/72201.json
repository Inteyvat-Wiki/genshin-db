				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "はぁ…道行く人よ…お恵みを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "年寄りの嘆きに耳を傾けてくれてありがとう…さあ…こっちへ、話を聞いておくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010105,
					"content": "私は今まで…幸運な日なんて一度もなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010106,
					"content": "私が生まれた時、出産の儀式を執り行った祭司様が灯油を倒し、叔母の長髪をすべて焼き切ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010107,
					"content": "そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "その後、私は奇妙な病にかかり、四肢が思うように動かなくなった。さらにその後、私はゆりかごから落ちてしまい、肋骨を6本折った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010109,
					"content": "少し大きくなると、ある日叔父がキノコを喉につまらせ、父が助けようとした時にシャベルを私の頭にぶつけた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010110,
					"content": "またある時は、大事にしていたヤマガラを鵜猿獣に食われ、その鵜猿獣はイノシシにぶつかり崖に落ちた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010111,
					"content": "その後、好きだった女の子は間違って祭司様を雷鳥様に捧げてしまい、島を追い出された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010112,
					"content": "成人になると、私が醜いという理由で祖母が亡くなり、すぐに祖父も亡くなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010113,
					"content": "その後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010114,
					"content": "家族は心の拠り所だったんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "ああ、家族と言えば…成人した時、巫医から私には子供は持てないだろうと言われた。なぜなら、私の体にはあれがあったからだ…少し待て、今見せてやる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010116,
					"content": "嫌だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "はぁ…もう一つ最後の話を聞いておくれ…この哀れな老人への最後の手伝いとして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010119,
					"content": "どうぞ、話して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "以前、妻を埋葬する際に、金の指輪を墓に落としてしまい、一緒に埋めてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010122,
					"content": "あれは私の最後の財産だ…しかし私に掘り出す勇気はない…彼女の魂を怒らせてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010123,
					"content": "#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に墓を掘れと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "君は外の人間だ…何をやっても不思議ではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010125,
					"content": "ああ、いや…私が言いたいのは、外の人間なら、現地の魂を怒らせることはないということだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010126,
					"content": "チライ社殿に行ってきてくれ…彼女の墓は神祠のそばにある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010120,
					"content": "変な話題にならなければいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "もうこの話題はおしまい！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
