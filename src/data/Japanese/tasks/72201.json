			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "ハハハハハハッ…アハハッ…アハハハハッ！！おっと…息が続かんわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010202,
					"content": "ハハハハッ涙が止まらない！！雀よ、お前にも見せたかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010203,
					"content": "怒った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "ハハハッ、すまないね。怒らないでくれ、これはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010206,
					"content": "私と妻は昔からいたずらをするのが好きだったんだ。どれも重複したものはなく、みんなも楽しんでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010207,
					"content": "しかしその後、妻が大病を患い、早死にしてしまった…その時彼女が言ったんだ、「私の墓の前で正直者をからかってくれ。そうじゃないと、魂も休まることができない」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010208,
					"content": "雀の願いを叶えるために…どうだ、結構うまかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010209,
					"content": "実につまらない冗談だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "おいおい、島の外から来た人、そんなつまらないことを言うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010213,
					"content": "私の得意芸を見たくないとは…本当につまらないわい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010214,
					"content": "もう行く！じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レロ"
				},
				{
					"id": 722010210,
					"content": "これは命に関わること！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "もうデタラメを信用する気はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
