					"フェリックス·ユーグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "パーフェクト！美しい…！君の理解力と器用さは、私の予想をはるかに超えるものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150202,
					"content": "はぁ…だが、『スチームバードデイリー』には馬鹿げた記事もいくつかあってな、君のことをこう比喩していたんだ。まるで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150203,
					"content": "まるで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "まるで…剣で相手を言い負かす…まっすぐな勇者だとな…ふっ…ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150206,
					"content": "馬鹿馬鹿しい、なんと愚かな！まったく、記事を書いた記者のやつらめ！君は鋭く、スマートで、謙虚な…そういうまっすぐな勇者だと言うのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150207,
					"content": "今度時間があったら、手紙で苦情を出してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150208,
					"content": "そうだ、この装置を受け取ってくれ。暇なとき、退屈しのぎになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150209,
					"content": "私は…ふむ…そろそろ璃月へ向かう旅費を集めなくては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150204,
					"content": "続けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
