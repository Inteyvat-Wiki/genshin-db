				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "素晴らしい！「からくり械画」の部品が六つも！あとは、これらをすべて再び組み合わせるだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150102,
					"content": "全部組み合わせるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "ああ、そうだ。この六つの小型「からくり械画」の部品は、再び組み合わせることができる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150104,
					"content": "一つの…巨大なものに！つまり、美しい大型「からくり械画」にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150105,
					"content": "さあ、あとはこれを組み合わせるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150106,
					"content": "鍛造とか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "いや、いやいやいや。絶対にありえない。私の機械は、金属のガラクタとは違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150109,
					"content": "すべてのパーツは、簡潔に、巧妙に、組み合わせられる。まるで…そう、まるで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150110,
					"content": "コホンッ、まあいい。比喩は得意じゃないんだ。そういったインスピレーションはすべて、グザヴィエに持っていかれてしまったんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150111,
					"content": "とにかく、試してみてくれ。面白いと感じてくれること請け合いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705150107,
					"content": "他の工程は必要ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
