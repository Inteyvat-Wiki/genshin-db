					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "あっ！蒲公英が！全部飛んでっちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420103,
					"content": "何してるの！この蒲公英せっかく育てたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420104,
					"content": "遠くに撒いてあげようと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "ここは町中よ！すぐ壁に当たって遠くになんていけないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420106,
					"content": "これでもっと多くの蒲公英が咲く…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "だったら蒲公英の種を持って城外で飛ばせばよかったじゃない！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420108,
					"content": "うぅ…せっかく育てたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420109,
					"content": "ま…まだ蒲公英が必要なら、城外で採ってくれば？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207420110,
					"content": "それに…この蒲公英の種だってあなたに採ってもらったやつで、大切に育てたのに…どうしてこんなことするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
