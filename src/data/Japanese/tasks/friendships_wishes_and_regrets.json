					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120802,
					"content": "よし、これで出来たわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120803,
					"content": "霄灯の中に私たち5人の名前を入れたわ。毎年行われる海灯祭でも、名前を入れた霄灯を一つ用意してるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120804,
					"content": "この先どんなことが起ころうとも、たとえ歩む道を違えようとも、この習慣が続く限り、私たちは変わらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120805,
					"content": "狼兄貴のことは、これ以上何も聞かないって、さっき3人で相談して決めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120806,
					"content": "もしそういう機会があるんなら、俺たちは元気にやってると伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120807,
					"content": "それから、昔に言ったことは、もう全部実現したっていうのもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120808,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "ありがとう、オイラたちがしっかり伝えるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120811,
					"content": "こんなに良い友達を持って、狼兄貴もきっと喜んでくれるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120809,
					"content": "こっちもこれ以上聞かない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
