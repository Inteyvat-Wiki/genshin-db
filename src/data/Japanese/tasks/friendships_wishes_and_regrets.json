			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "予想外のことばっかで、オイラもうついていけないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120102,
					"content": "こんな形で狼兄貴を見つけるなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "そこは私の想像通りだったね。前に言ったでしょ？この世に悪鬼なんてそういないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120105,
					"content": "彼は何かのきっかけで無妄の丘を離れ、そして何かが原因となり戻れなくなったんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120106,
					"content": "なんかその説明、無理やりすぎないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120107,
					"content": "実は…そうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120108,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120109,
					"content": "ふふん、さすが私！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120110,
					"content": "僕はただ、友達が元気かどうか気になったから、璃月港に来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120111,
					"content": "悪いことやいたずらなんかしてないよ！人を驚かすなんてことも絶対にない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120112,
					"content": "前に無妄の丘へ肝試しに来た人がいて、その人が璃月港から来たのを聞いたから、その人の後をついて行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120113,
					"content": "あのかわいそうな洛成だね、どうりで誰かにまとわりつかれてる気がして悪夢を見てたわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120114,
					"content": "え？ぼ、僕気づかれてた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120115,
					"content": "じゃないと、あんなに怯えないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120116,
					"content": "どうして孟を訪ねなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "そうだぞ、胡桃と孟が必死に探してたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120118,
					"content": "実は僕、璃月港に来たことなかったから、道に迷っちゃって。みんなのところに辿り着けなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120119,
					"content": "ああ、そういえば、狼兄貴は小さい頃から方向音痴だったな。俺たちがいなきゃ、自分で下山もできないくらいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111120120,
					"content": "そんなしょうもない理由だったのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120121,
					"content": "幽霊は飛べるだろ、飛べば道が見つかったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120122,
					"content": "こ、怖いんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120123,
					"content": "高すぎて、怖い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120124,
					"content": "うんうん、そうだった。小さい頃、山から下を見るのも怖がってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111120125,
					"content": "ははは、お前やっぱり全然変わってないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111120126,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "人前に出ちゃだめだって知ってたんだけど、璃月港は人が多すぎるから、どこかに隠れるしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120129,
					"content": "ただその時、この地脈鎮石に引き寄せられて、ここに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120130,
					"content": "お前が悪鬼になってなくてよかった、本当に、よかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111120131,
					"content": "私の専門家としての判断を信じてって言ったでしょ。さてと、あとはこの迷子を無妄の丘に連れて行ったら全部解決だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120132,
					"content": "ですが、さっきあいつは友達を見に来たと言ってました。多分俺だけじゃなくて、小五、木木、聡子の3人のことも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "孟"
				},
				{
					"id": 111120133,
					"content": "じゃあ…それなら、狼兄貴の願いを叶えるために送別儀式でもやろっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120134,
					"content": "私と孟は狼兄貴を無妄の丘に連れて行くから、あなたは幼馴染の3人から自身を象徴する物を貰ってきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120135,
					"content": "みんな友達なんだし、直接ここに呼べばいいじゃないか？それか、狼兄貴を連れて行くとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120136,
					"content": "それは…だめだよ。驚かせちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "狼兄貴"
				},
				{
					"id": 111120137,
					"content": "一般人は関わらない方がいいって言ったでしょ。知らないことは、知らないままでいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120138,
					"content": "だから、物を貰いに行く時、このことがバレないように注意してね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡桃"
				},
				{
					"id": 111120127,
					"content": "「狼兄貴」って呼ぶのやめよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "狼兄貴は悪鬼じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "こんにちは、オイラたちのことを覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120202,
					"content": "君たち…悪いけど、往生堂にやっかいになることなんて本当にないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120203,
					"content": "孟の話を聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "ああ、僕と孟は幼馴染でよく遊んでたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120206,
					"content": "でも、なぜか彼は往生堂に入ったんだ。正直言って、あそこの堂主は変わった人なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120207,
					"content": "まあ、彼には彼なりの理由があるんだろうけどさ。だって僕たちの中で彼だけが、まだ狼兄貴のことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120208,
					"content": "そうだ、狼兄貴のことは彼から聞いてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120209,
					"content": "うん、全部聞いたぞ。じゃあさ、もし仮に狼兄貴になにか一つ物をあげられるとしたら、なにを選ぶ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120210,
					"content": "か、仮にだぞ！本当に渡せるなんてことは、ないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120211,
					"content": "（分かりやすい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "そうだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120214,
					"content": "僕だったら、彼のために料理を作るかな。彼は辛いものが好きだったんだ。通常の何倍も辛い椒椒鶏が大好物でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120215,
					"content": "そうだ、もし絶雲の唐辛子を持って来てくれたら、作ってあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120216,
					"content": "小さい頃に食べてた味だから、きっと喜ぶはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120217,
					"content": "分かった、少し待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120212,
					"content": "（いつも通りのパイモンだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "孟から昔からの友達だと聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
			"completionStepIds": [
