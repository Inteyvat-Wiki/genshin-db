					"小五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "うん、これなら足りると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120302,
					"content": "じゃあ、椒椒鶏を作ってくるよ。君たちは他の人のところにも行くんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120303,
					"content": "他の人のが終わったら、僕も料理を渡すから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120304,
					"content": "おう、分かったぞ、じゃあ後でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120305,
					"content": "（あれ？どうして知ってるんだ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1111204,
			"completionStepIds": [
				1111204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111204",
							"2"
						],
						"stepId": 1111204,
						"stateName": "QUEST_STATE_UNFINISHED"
