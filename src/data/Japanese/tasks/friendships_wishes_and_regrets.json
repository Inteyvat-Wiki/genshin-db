			"dialogs": [
				{
					"id": 111120501,
					"content": "あれ？おまえたちも来てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120502,
					"content": "一緒に集まって昔話をしてるんだ、僕たちの長年の習慣だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "小五"
				},
				{
					"id": 111120503,
					"content": "俺たちの故郷は、災害のせいで崩落した。帰るところがもうないんだ。だから故郷の人がいるところを故郷だと思うようにしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120504,
					"content": "二人から聞いたわ、自身を象徴する物を探してるんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120505,
					"content": "私はいま璃月港の霄灯職人をやっているの。私を象徴するものは、その霄灯くらいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120506,
					"content": "先日、何個か高品質な浮生の石片を手に入れたの、それが埠頭の倉庫にあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120507,
					"content": "もう管理員に話は通してあるから、悪いけどそれを持ってきてくれないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "聡子"
				},
				{
					"id": 111120508,
					"content": "#どうやら、説明する必要もなかったみたいだな。{NICKNAME}、早く持ってこようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
