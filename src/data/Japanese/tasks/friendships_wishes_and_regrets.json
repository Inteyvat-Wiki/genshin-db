			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木木"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "また君たちか。はぁ、往生堂の商売には興味ないと言ったはずだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120402,
					"content": "今回は孟からの紹介なんだ、おまえたち友達だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120403,
					"content": "ああ、それは確かだが…そういえば最近、往生堂に入ったと聞いたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120404,
					"content": "理由は大方察しがつく、俺たちの幼馴染だった狼兄貴のことが原因だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120405,
					"content": "そう簡単に納得することはできないと分かってる。過去を忘れるっていうのは容易なことじゃない、俺もそうだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120406,
					"content": "それで、君たちは狼兄貴のことでここに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120407,
					"content": "鋭いな！まだなにも言ってないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120408,
					"content": "ははっ、これでも商人なんでね。人の機微に関しては敏感なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120409,
					"content": "皆は俺のことを鈍感だと言うが、この商売を続けているうちにそれも少しは改善できた。最初の頃はヘマばっかしてたがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120410,
					"content": "これを君たちにあげるよ。これは俺たちが小さい頃、夢見てた豪華なおもちゃ箱だ。その頃は金がなくて買えなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120411,
					"content": "今は商売が上手くいって、こういう箱を何十個だって買える。昔の夢も叶ったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120412,
					"content": "うわっ、これがお金持ちってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120413,
					"content": "ははっ、俺にとってそれは思い出の象徴でもある。それを夢見ていたからこそ、今の俺たちがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120414,
					"content": "そうだ、見たところ、俺の次は小五と聡子のところに行くんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120415,
					"content": "うん、小五にはもう会ったから、今から聡子のとこに行くところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111120416,
					"content": "おう、聡子なら、あとで緋雲の丘の空中通路で会う予定だ。埠頭に向かう階段の上だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "木木"
				},
				{
					"id": 111120417,
					"content": "俺は少し用事を済ませてから行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木木"
				}
			]
		},
