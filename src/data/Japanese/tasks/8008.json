				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "鉱夫さん、依頼の報告をしに来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80080102,
					"content": "おお、あんたたちか！良かった、戻って来れたんだな！モラを払ったとはいえ、よくよく考えてみると、あんな不気味なところに行かせてしまったから心配してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080103,
					"content": "もし何かあったりでもしたら、俺の良心は痛みに痛んで、一生後悔することになってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080104,
					"content": "大丈夫だって、オイラたちを誰と思ってるんだ！ほら、こうして無事に帰って来ただろ？しかも、ちゃんと調査も終わらせてきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80080105,
					"content": "なんと、そいつはすごいな！で、下はどんな様子だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080106,
					"content": "あっ、えっと…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80080107,
					"content": "ヒルチャールたちが老後の生活を送ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "老後の生活？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080111,
					"content": "と…とにかく、そこへ行ったヒルチャールはもう攻撃してこないから、鉱夫さんたちも彼らを邪魔しないでやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80080112,
					"content": "そういうこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "ああ、俺たち鉱夫は面倒事が一番嫌いだからな、こっちから手を出すことはまずないだろう。それに、俺たちの目には光り輝くものか、黄金色のものしか映らないから安心しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080115,
					"content": "お、おう…それなら大丈夫そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80080116,
					"content": "まあ、あんたたちが報告してくれたことは、正直よく分からないが…二人が大丈夫だと言うのなら、作業を再開してもいいってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080117,
					"content": "ありがとう！二人のおかげで俺たちも一安心だ！礼を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玥輝"
				},
				{
					"id": 80080113,
					"content": "安心していい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "下はヒルチャールたちの理想郷だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "理想郷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "玥輝"
				}
			]
		}
	]
