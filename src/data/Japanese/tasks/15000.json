							8480.643
						],
						"pointId": 8567
					}
				]
			},
			"dialogs": [
				{
					"id": 150000101,
					"content": "#こんにちは！あたしはフニ。{M#お兄ちゃんとお姉ちゃんは}{F#お姉ちゃんたちは}、竜の赤ちゃんを探しに来てくれたんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000102
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000102,
					"content": "オレはトバ。オレの勘が正しけりゃ、助っ人ってのはお前たちのことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000103
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000103,
					"content": "ん？えっと、よろしくな？でもオイラたち、ただの通りすがりなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000104,
					"content": "えっ、友達を呼んで手伝ってもらうことにしたって、山下おじちゃんが言ってたのに…二人のことじゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000105
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000105,
					"content": "山下っていう友達はいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000106
					]
				},
				{
					"id": 150000106,
					"content": "…なんかよくわかんないけど、勘違いしてるんじゃないか？オイラはパイモンで、こいつは旅人っていうんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000107,
					"content": "勘違い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000108
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000108,
					"content": "マズい、フニ。きっと騙されたんだ。あのメガネ、やっぱ嘘つきだったんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000109
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000109,
					"content": "じゃあ、竜の赤ちゃんたちはどうすればいいの…もうあんまり時間がないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000110
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000110,
					"content": "いったん落ち着いてくれ。竜の赤ちゃんがどうしたって言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000111,
					"content": "最近、集落が物騒でね…パパの竜に不幸なことがあったんだ。その竜はナンナって名前で、赤ちゃんが三頭いるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000112
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000112,
					"content": "でも、その出来事の後に赤ちゃんたちが怯えて、どこかに行っちゃって…だから、あたしたち心配で探しに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000113
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000113,
					"content": "お父さんの竜か…お父さんは手伝ってくれないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000114,
					"content": "パパは集落で「長老」のような役を任されてて、廻焔の夜の準備をしてるの。その準備ってすっごく重要だし、赤ちゃんよりも優先すべきことだから、パパに内緒で出てきたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000115
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000115,
					"content": "すぐに見つけられると思ったのに、さっきおじちゃんにあれこれ聞かれたせいで、だいぶ時間を使っちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000116
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000116,
					"content": "くそっ、あのメガネ、人の心ってもんがないのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000117
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000117,
					"content": "そうカッカすんなって。あんま手間のかかることじゃなさそうだし、手伝ってやるぜ。オイラたちって、親切心ってもんを大切にしてるからな。だろ、旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000118,
					"content": "もちろん。竜の赤ちゃんはこの辺にいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000119
					]
				},
				{
					"id": 150000119,
					"content": "痕跡をいくつか見つけたから、そうだと思う。近くの崖の上に隠れてるはずだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000120
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000120,
					"content": "任せて。そう時間はかからないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000121
					]
				},
				{
					"id": 150000121,
					"content": "#本当に？じゃ…じゃあお願いするね。旅人の{M#お兄ちゃん}{F#お姉ちゃん}、パイモンお姉ちゃん、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000122
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000122,
					"content": "へへ！崖は結構険しいから、気をつけてくれよ。部族の人だって、そう簡単には登れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トバ"
				}
			]
		},
