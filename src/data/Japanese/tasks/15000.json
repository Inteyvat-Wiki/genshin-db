				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "キュ～…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "ポチチ",
					"speakerSubtitle": "ユムカ竜の赤ちゃん"
				},
				{
					"id": 150000402,
					"content": "竜の赤ちゃんがいたぞ！あれ？隣にいるのって…アハウじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000403,
					"content": "なんだ、我が従者の悪友ではないか？山の下から我輩の勇姿を目撃して、わざわざ貢物を届けに来たのか？どうやら先日会ったとき、我輩の華麗な姿がその心に深く刻まれたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000404,
					"content": "困ったものだ。さあ、我輩の足に口づけするといい。偉大なる聖龍クフル·アハウを崇めることを許そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000405,
					"content": "おまえ…キィニチの手下だろ？なに勝手なこと言ってんだよ？前に会ったときよりも面倒なやつになってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000406,
					"content": "た、たわけ！手下とはなんだ！？我輩は龍の頂点に立つ、烈炎の国の至高なる領主だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000407,
					"content": "この前はキィニチがどーしてもと頭を下げるから、汝らに言葉をかけてやったのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000408,
					"content": "なんだよ。キィニチに閉じ込められてたくせに。よく言うぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000409,
					"content": "領主様、山の上で何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "フン、そうでなくてはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000413,
					"content": "我輩は従者の懇願に応え、先日からウィッツトラン付近で起きたアビスの事件を調べているのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000414,
					"content": "アビスの事件！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000415,
					"content": "そこの小さな爬虫類を見たか？その母親——中くらいの爬虫類はアビスの力に侵され、錯乱状態に陥り、我輩の従者の一族を、そして自分の子孫を襲った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000416,
					"content": "そんな…そいつは今どうなってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000417,
					"content": "下等な爬虫類がアビスに長く抗えると思うか？もちろん、夜神の国へと旅立った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000418,
					"content": "なんと弱い生き物だ…崖から飛び降りて、命を絶ったという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000419,
					"content": "崖から飛び降りた…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000420,
					"content": "空飛ぶ白いアリンコ、その疑問の数々を書き殴ったような間の抜けた顔はよせ。偉大なる聖龍クフル·アハウは、誰かさんの願いを叶える泉ではないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000421,
					"content": "誰が空飛ぶ白いアリンコだ！このぉ…おまえにヘンなあだ名をつけてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000422,
					"content": "ん？近くから微かにアビスの気配を感じる。邪悪な術師が隠れているに違いない。もし怪しげなよそ者に出くわしたら、じっくり尋問しなければな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000423,
					"content": "怪しげなよそ者って…遠まわしにオイラたちのことを言ってるんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000424,
					"content": "フンッ！「下僕の心を以て領主を量る」とは！汝らが我が従者の悪友でなければ、とっくにボコボコのボコであったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000425,
					"content": "崇めるのが目的でないなら、さっさと去るがいい！偉大なる聖龍クフル·アハウは、用事を済ませなければならないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アハウ"
				},
				{
					"id": 150000411,
					"content": "手下くん、山の上で何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "領主と呼ぶのだ！この偉大なる聖龍クフル·アハウを怒らせるつもりか？汝の罪は、廻焔に千年焼かれる刑に値するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "アハウ"
				}
			]
		},
		{
			"id": 1500005,
			"completionStepIds": [
				1500007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1500007",
							"2"
						],
						"stepId": 1500007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フニ",
					"トバ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2373.144,
							259.097,
							8480.769
						],
						"pointId": 9113
					},
					{
						"sceneId": 3,
						"position": [
							-2375.592,
							259.064,
							8479.979
						],
						"pointId": 9114
					},
					{
						"sceneId": 3,
						"position": [
							-2374.284,
							259.103,
							8478.566
						],
						"pointId": 9115
					},
					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "えっ！こんなに早く戻ってくるなんて、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000502,
					"content": "#赤ちゃんが無事でよかったぁ。これで安心してお家に帰れる。{M#お兄ちゃん、お姉ちゃん}{F#お姉ちゃんたち}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000503,
					"content": "これくらい気にしなくていいぞ。大した手間じゃなかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000504,
					"content": "#ずいぶん高い山を登ったから、きっと大変だったでしょ。{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}の格好を見た感じ、ここの人じゃないよね？よかったら、あたしの家で休んでかない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000505,
					"content": "おう、「懸木の民」のおもてなしを見せてやろうぜ！さっきのメガネと違って、すごくいいやつだし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000506,
					"content": "あれ？その口ぶりからして、そいつも外から来たやつだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000507,
					"content": "うん、ナタの服装じゃなかった…今思い返してみると、やっぱり怪しかったね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000508,
					"content": "怪しいよそ者ってことか…まさか、アハウが言ってたのって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000509,
					"content": "詳しく聞かせてくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "あのおじちゃんに興味があるの？もちろんいいよ、えっとね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000511,
					"content": "おじちゃん、もうたくさん物語を教えたでしょ…いつになったら赤ちゃんを探しに行ってくれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000512,
					"content": "もう一つ教えてくれ。今度はあの炎の話をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000513,
					"content": "巨大な透明の炎は五百年、千年、あるいは数え切れない年月の間ずっと燃え続けていると、おじちゃんは聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000514,
					"content": "「廻焔」のことだな！古名の「マリ{RUBY#[S]廻焔}ポ」はその伝説から生まれたんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000515,
					"content": "おおっ、古名の起源なのか？すごいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000516,
					"content": "うん、すべての古名には起源となる伝説があるんだよ。伝説によると、廻焔はナタ大同盟の時代に現れたものなの。暴君オチカンがナタの統治と、それから反対する者を鎮圧するときに使ったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000517,
					"content": "廻焔は普通の炎と違ってね、火をつけられた人は背中に焼けるような痛みを感じるけど、すぐには死なないんだ。でも絶対に、振り返っちゃいけないんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000518,
					"content": "振り返ってはいけない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000519,
					"content": "振り返ったら、すぐ燃えて灰になっちゃうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000520,
					"content": "おお…服や荷物だけならまだしも、人間そのものを燃やすとはなんとも残忍だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000521,
					"content": "でしょ。背中を燃やした上に、振り返っちゃいけないなんて、ひどすぎるよね？オチカンって、ほんと暴君だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000522,
					"content": "だが、そういう伝説では、誰かが立ち上がって反旗を翻すのがお決まりだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000523,
					"content": "おっ、分かってんじゃん、メガネのおっちゃん。その通りだぜ。立ち上がったのは我ら「懸木の民」の祖先、ユパンキ様だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000524,
					"content": "うん。ユパンキ様は当時の軍事用品の管理官で、暴君のオチカンと、最初の炎神シュバランケ様とは友人だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000525,
					"content": "そんなユパンキ様は、オチカンの残酷な統治をよく思ってなかったんだ。廻焔をこっそり盗んで、暴君の軍隊に投げつけたの。その勢いは誰にも止められなくて、兵士たちは全員燃えて灰になったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000526,
					"content": "こうして、ご先祖様は人々を解放した。けど、街から脱出するときに後ろからオチカンの声が聞こえたのか、ユパンキ様は振り返っちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000527,
					"content": "そこにあったのは、焼け焦げた街と力尽きた兵士、そして燃え盛る炎だけだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000528,
					"content": "次の瞬間、彼の瞳に映ってた炎が急に飛び出して、ご先祖様を呑み込んでしまうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000529,
					"content": "振り返って一目見ただけなのに、灰になるまで燃えちまうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000530,
					"content": "それは果たして、炎を盗んだ代償なのか…それとも振り返ったからなのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000531,
					"content": "さあな。けどユパンキ様の炎は他のよりずっと激しくて、百日間燃え続けたらしいぜ。それは最終的に、地脈に大きな穴を開けたんだとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000532,
					"content": "で、炎は「シュッ」と真っ暗な夜神の国に落ちて、今も燃え続けてるんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000533,
					"content": "大人たちが言うには、その炎は往生の道を照らすものなんだって。それに死者はその炎を受け入れて焼かれないと、清浄な身で来世を迎えられないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000534,
					"content": "まるで一生を振り返って審問を受けるかのように…だからそれは「ユパンキの廻焔」って呼ばれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000535,
					"content": "ほほう…なんと詩的な物語だ！それで、夜神の国でその炎を見られるのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000536,
					"content": "知らないよ…だって、ただの伝説でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000537,
					"content": "その古名を継承した人はいるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000538,
					"content": "もちろん。例えば「廻焔の夜」で祀られた英雄ブルキナとかな。まあ、その人は五百年も前の人だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000539,
					"content": "うん。今この古名を継いでるのは、キィニチお兄ちゃんだよ…「マリポ」のキィニチ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000540,
					"content": "キィニチ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000541,
					"content": "そろそろいいだろ？メガネのおっちゃん。もう物語をたくさん教えたし、赤ちゃんを探してきてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000542,
					"content": "ああ…でも廻焔の伝説では振り返っちゃいけないとあるだろう？だから、過去の話を振り返るのはやめよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000543,
					"content": "そうだ。そのキィニチとかいう人のことを教えてくれ。そこが重要なんでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000544,
					"content": "ん？どうした、トバ。今にも人を責めそうな目をして？いけないぞ、それは大人の特権なのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000545,
					"content": "おじちゃん…嘘をついたら…死んだ後、廻焔に焼かれちゃうんだからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000546,
					"content": "それはこの国の炎だ、よそ者には効かないだろう？おじちゃんはここの人じゃないんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000547,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000548,
					"content": "待った…ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000549,
					"content": "いいか、子供たちよ。タダで物語を聞くつもりはない。おじちゃんは二人の友達を呼んだんだ。うん…報酬はその二人が払おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000550,
					"content": "思いっきりこき使ってやってくれ。遠慮はいらないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000551,
					"content": "本当か？そうだ、メガネのおっちゃんの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000552,
					"content": "ふむ、山の下で出会ったのだから、そうだな…おじちゃんの名前は「山下」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000553,
					"content": "友達って、本当なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000554,
					"content": "ああ、信じられないなら振り返ってみてくれ。その二人はもう来ているぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000555,
					"content": "えっ？どこどこ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000556,
					"content": "って、あれ…おじちゃんがいない！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000557,
					"content": "めちゃくちゃ怪しいやつだな…なんか古名のことを色々探ってるみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000558,
					"content": "だろ！おのれクソメガネ、騙しやがって！今に見てろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000559,
					"content": "でも、あのおじちゃんはただ物語を聞いてきただけだし、危ない人じゃないんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000560,
					"content": "う～ん…旅人、一応キィニチに知らせたほうがいいんじゃないか？あのうざったいアハウが調べてるとはいえ、なんだか頼りない気がするし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000561,
					"content": "あれ？二人もキィニチお兄ちゃんを知ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000562,
					"content": "別に親しいわけじゃないけど、会ったことあるぜ！それに、一緒にご飯を食べたこともあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000563,
					"content": "いいなぁ！オレ、キィニチお兄ちゃんとしゃべったことないんだ。お兄ちゃんって部族の竜狩り人で、スッゲー古名を持ってるし、とにかく格好いいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000564,
					"content": "うんうん！でも、あたしのパパはそんな好きじゃないみたい。あんまり関わらないようにって言われてるんだ…きっとお兄ちゃんの傍にいる、あのデカくて偉ぶってるやつのせいだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000565,
					"content": "あっ！それってクフル·アハウってやつだろ！あの態度、ほんと腹立つよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150000566,
					"content": "でしょ！キィニチお兄ちゃんがあいつを仲間にした理由が分からないよ。どうしてあたしじゃダメなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000567,
					"content": "ヤバイ！フニ、外に出てもうだいぶ時間が経ってるぞ。そろそろ帰らないと怒られる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "トバ"
				},
				{
					"id": 150000568,
					"content": "#そうだね！じゃあ…{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}、この道に沿って進めばあたしたちの集落に着くから。もし立ち寄るなら、必ず家に遊びに来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000569,
					"content": "あっ、それと困ったことがあったら、助けるようパパに言っとくよ。待ってるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "フニ"
				},
				{
					"id": 150000570,
					"content": "#んじゃ{M#お兄ちゃん、お姉ちゃん}{F#お姉ちゃんたち}、またな～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トバ"
				}
			]
		},
