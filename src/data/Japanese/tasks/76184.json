			"dialogs": [
				{
					"id": 761840101,
					"content": "やあ、珍しいこともあるもんだね。まさか君のお茶会に招待される日が来るなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840102,
					"content": "アナタがもう少しお茶会のマナーをわきまえていれば、これまでにも何度か招待を検討していたかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840103,
					"content": "同感だ。私たちと顔を合わせるたびに手合わせを申し込むのはやめたまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 761840104,
					"content": "うちの兄貴や姉貴みたいなことを言うね。でも、しょうがないだろう？昔、野外で師匠の特訓を受けていた時には何も言われなかったんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840105,
					"content": "まあいいわ。こうして集まれる機会もそう多くはないのだから、今は心からこの時を楽しみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840106,
					"content": "おや？彼女は君の新作かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840107,
					"content": "「ファジオ」——多機能汎用支援型自動マシナリーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840108,
					"content": "そうか、プロンニアは本当にもう修理できないんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840109,
					"content": "気にしないで。ワタシは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840110,
					"content": "一度くらい戦ってみたかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840111,
					"content": "…そう言うと思ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840112,
					"content": "あのデカいのは見た目からして強そうだったけど、こっちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840113,
					"content": "…彼女が弱そうに見えるとでも言いたいのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840114,
					"content": "えーっと…アハハ、そうじゃないよ。ただ、あの大きなプロンニアに比べると強そうに見えないってだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840115,
					"content": "ふん、プロンニアはもともと算術マシナリーなのよ。あの戦闘能力は、演算能力に影響が及ばない範囲で追加したものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840116,
					"content": "でも、ファジオは複雑な術式を処理する必要がないわ。つまり、彼女の演算能力はすべて、戦闘モジュールの処理に回せるということね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840117,
					"content": "じゃあ…プロンニアより強いってことか？信じられないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840118,
					"content": "あら、そこまで疑うなら確かめてみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840119,
					"content": "先に言っておくけど、壊れても修理代は払わないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840120,
					"content": "ワタシだって、治療費なんて払わないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761840121,
					"content": "（はぁ…やはりこうなってしまったか。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 761840122,
					"content": "（はむはむ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
