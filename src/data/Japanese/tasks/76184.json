			"dialogs": [
				{
					"id": 761840301,
					"content": "いいお茶会だね。こんなことなら、もっと前から参加しておくんだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840302,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "じゃあ、また。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 761840303,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
