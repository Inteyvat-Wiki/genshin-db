			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ルー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "ここの止まり木も完了したな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270302,
					"content": "すごい！これが本物の冒険者かぁ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270303,
					"content": "…昔、他にもここに人が来たことあったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270304,
					"content": "#でもみんな、{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}とパイモンほどすごくはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270305,
					"content": "他の人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270306,
					"content": "うん、マウシロを探しに来た人がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270307,
					"content": "たぶん、墨田さん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "でも、マウシロってなんなんだ？鶴観の人の楽器って聞いたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270310,
					"content": "うーん、たしかに音が鳴る道具ではあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270311,
					"content": "霧海では前がよく見えないでしょ？だからみんな、マウシロで自分の位置を知らせるようにしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270312,
					"content": "大声を出すとうるさいし、喉にも良くないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270313,
					"content": "たしかに、なにも見えないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270314,
					"content": "でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270315,
					"content": "お父…マタおじいちゃんが言ってたけど、マウシロの音は霧の中でさまよってる魂を家まで導くことができるんだって。だから、すごく重要なものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270316,
					"content": "えっ？そんなに重要なものだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270317,
					"content": "だから、祭典で必要なんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#うん。{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}とパイモンも、きっと祭典を楽しんでもらえると思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270319,
					"content": "じゃあ、先に行ってて！僕はもう少し木の下にいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270320,
					"content": "大丈夫か？この辺には魔物がいるかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270321,
					"content": "大丈夫だよ、心配しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270308,
					"content": "どうりでキャサリンが高難度っていうだけあるな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
