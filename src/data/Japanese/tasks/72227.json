			"trigger": {
				"objectNames": [
					"ルー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}が戦ってる姿、すごくかっこよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270102,
					"content": "ルー！ここにいたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270103,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "大丈夫だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270106,
					"content": "あの魔物たち…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "さっきの怪物がどうやって来たかはわからないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270109,
					"content": "たしかに、ここの生き物じゃなさそうだったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270110,
					"content": "うん。前はここにあんなのいなかった。それから、毛むくじゃらの人とか、大きな機械とかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270111,
					"content": "昔はここに「鵜猿獣」っていう動物がいたんだ。温厚な性格で、とても美味しくってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270112,
					"content": "聞いたことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "そっか。いつの間にか、ここにいた鵜猿獣もぜんぶいなくなってたんだ。そしたら、あいつらが現れたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270114,
					"content": "「霧海」の外から来たのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270115,
					"content": "外にはヒルチャールとかの魔物がいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "なんか危なそう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270117,
					"content": "確かにすごく危険。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "でも、冒険ってすっごく面白いんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270120,
					"content": "僕も冒険してみたいなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270121,
					"content": "ルーが大きくなったら、立派な冒険者になるだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270122,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "ルー"
				},
				{
					"id": 722270123,
					"content": "じゃあ、ここの止まり木もオイラたちに任せとけ。魔物がいるから、ルーだと危ない目に遭うかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722270124,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "でも、冒険はすごく面白い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "ケガとかない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
