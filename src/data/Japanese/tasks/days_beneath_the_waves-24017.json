			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イヴス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170601,
					"content": "あのケチめ、フンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170602,
						240170608,
						240170612
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170602,
					"content": "ゴールドマンについてもう少し教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170603
					]
				},
				{
					"id": 240170603,
					"content": "彼は俺のボスで、俺みたいに何の才能もなく、力仕事しかできない人を雇って働かせてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170604
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170604,
					"content": "あいつ、フォンタで頭がいっぱいなくせに、口うるさくて、とんだケチ野郎でな！クソほどある労働ルールとやらを絶対に守らなきゃいけないって、俺たちに強要しやがる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170614
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170614,
					"content": "それに仕事用の潜水服は、やつからの「貸出し品」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170605
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170605,
					"content": "ルールに違反したり、潜水服が破れたりしたら、弁償までさせられるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170615
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170615,
					"content": "つまり、もし仕事中にヘマでもしようものなら、あのケチに弁償額を払って、雇い続けてくれるように頼まなきゃいけない！ちくしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170606
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170606,
					"content": "やつのことを知ってどうすんだよ。まさか、あいつに会いにでも行くのか？頼むから、お前の名声のためにも、あいつからは離れたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170616
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170616,
					"content": "やつは恥知らずだ。だから周りにも、同じ悪趣味の連中が集まるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170607
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170607,
					"content": "お前はあいつと絶対に関わるなよ。泥沼の泥をかき除いて、きれいな水と入れ替えるのは、そう容易にできることじゃないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170617
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170617,
					"content": "清らかな池を泥のひと塊で汚すのは、いとも簡単なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170608,
					"content": "#{M#君}{F#あなた}の仕事って大変だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170609
					]
				},
				{
					"id": 240170609,
					"content": "ははっ、その通りさ。でも、これが俺の唯一の稼ぎ口なんだ。俺は頭もよくないし、他の能力もない。だからと言って、悪事に手を染めたくはないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170618
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170618,
					"content": "パンのために悪事を働くぐらいなら、腹を空かせたほうがマシさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170610
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170610,
					"content": "今の仕事は確かに大変だけど、少なくとも夜はしっかり眠れている。誰かに恨まれて、寝てる間に包丁で目を刺されたりする心配をしなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170611
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170611,
					"content": "この点においては、ゴールドマンよりもマシな人生を歩んでるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170612,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170613
					]
				},
				{
					"id": 240170613,
					"content": "ああ、引き揚げる件は頼んだぞ、優しい若者よ。俺は引き続きこの潜水服を直さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				}
			]
		},
		{
			"id": 2401707,
