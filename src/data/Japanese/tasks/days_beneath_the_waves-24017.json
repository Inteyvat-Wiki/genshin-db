				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イヴス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "あの欲張りめ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170203,
					"content": "潜水服はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "お前だったか！お前に会えたことは、今日一番の幸運だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170205,
					"content": "お前は知らないだろうが、ゴールドマンのやつ、また俺たちをいじめる新しい方法を考えついたみたいでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170206,
					"content": "計算がうまい人を雇って、それぞれが毎日どれだけ引き揚げたか数えさせてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170222,
					"content": "そしてやつはその「計算結果」に基づいて、俺たちに毎日その量を引き揚げろって押し付けたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170207,
					"content": "俺たちも疲れる時だってあるだろう。怪我したり、腹が減ったり、へばったりもするから、毎日あんな大量に引き揚げられるわけじゃないのに…ゴールドマンは全然聞く耳を持たない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170223,
					"content": "引き揚げた量がその「計算結果」に達してなかったら、俺たちはやつに罵られ、給料まで引かれる始末さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170208,
					"content": "でも、それはあの計算担当の人のせいじゃない。彼はフィネガンという名前で、同情心のある人だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170209,
					"content": "彼は計算のかたわら、俺たち一人一人に毎日具体的にどんな仕事をしてるか尋ねてくれた。ある日、俺たちの話を聞き終わった彼は、計算を済ませた後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170224,
					"content": "突然、彼は立ち上がると、ゴールドマンの部屋に押し入ってやつに向かって怒鳴ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170210,
					"content": "こう言ったんだ。「…これは非常識だ。彼らは生きた人間であって、マシナリーなんかじゃない！」ってな…俺に聞こえたのはこれだけだったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170211,
					"content": "…その後、彼はゴールドマンの部下によって水たまりの中に投げ込まれちまった…俺たちは彼を引っ張り上げたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170212,
					"content": "それで彼は涙まで流しながら、俺たちに謝ってくれたのさ。俺たちは彼を恨んだりはしない。俺たちと同じように、彼もただゴールドマンに虐げられた被害者の一人に過ぎないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170213,
					"content": "彼は、必ず俺たちのために正義を取り戻すって約束してくれたけど…彼が再びあの泥沼に戻ってほしくないと、俺たちは心から願ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170214,
					"content": "今日の仕事は、あとどれぐらい掛かりそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				},
				{
					"id": 240170216,
					"content": "まだ結構かかりそうだな。いつ終わるか分かんないけど、できるだけ給料を引かれないためにも、できるところまでやっとかないと…それに仕事を続けるには、誰かから潜水服を借りる必要もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170217,
						240170218
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170217,
					"content": "手を貸してあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170219,
					"content": "本当か？また手伝ってくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170220
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170220,
					"content": "お前はマジで俺の救世主だ。ゴールドマンにお前の人徳の半分でもあったらいいのに…あ、すまん、あの豚をお前と比べたりするんじゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170221
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170221,
					"content": "前回と同じように位置をマークしておいたから、手分けして探そう。はぁ、借りてきた潜水服も壊さないように気をつけないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170218,
					"content": "仕事を手伝ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170215,
					"content": "今日の仕事は、どれぐらい残ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				}
			]
		},
		{
