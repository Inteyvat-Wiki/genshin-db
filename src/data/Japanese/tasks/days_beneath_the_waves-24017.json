			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イヴス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170701,
					"content": "はぁ…マジでついてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170702
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170702,
					"content": "モノは売れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170703
					]
				},
				{
					"id": 240170703,
					"content": "お前か。はぁ、実はこっそり買い手を探してたのに、ゴールドマンのやつが突然俺の部屋に押し入ってきてな。アクセサリーを全部かっさらって行ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170704
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170704,
					"content": "もし俺に働いてもらう必要がなかったら、やつはきっと俺をボコボコに殴ってたんだろう…二ヶ月分の給料が飛んじまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170716
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170716,
					"content": "今年の仕事を全部完了したら、給料を払ってくれるって言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170705
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170705,
					"content": "はぁ…もういい。俺みたいなバカに幸運が訪れるわけがない…ゴールドマンはお前んとこに行ってないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170706,
						240170709
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170706,
					"content": "来てないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170707
					]
				},
				{
					"id": 240170707,
					"content": "ならよかった。俺がやられるのは構わんけど、やつがお前に迷惑をかけるのは嫌なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170708
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170708,
					"content": "お前が手伝ってくれたことは誰にも言ってない。なんとなくだけど、もし誰かに言ったら、あのケチにチクりそうな気がしてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170711,
					"content": "それはそうとして、今日はどうしてもお前に頼まないといけないことがある。潜水服はまだ直せてないのに、ゴールドマンのやつに催促されまくっててな。この数日で遅れた仕事を全部間に合わせろって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170712
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170712,
					"content": "仕方なく、他の人の潜水服を借りて、急いで仕事をしたけど…どうしても間に合わない。だから、お前に頼むしかないんだ。どうか、もう一回助けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170713,
						240170714
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170713,
					"content": "いいよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170715,
					"content": "ありがとう。位置をマークしてあげるから手分けして探そう。仕事が終わったら、また潜水服を直すとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170714,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170709,
					"content": "彼が来たら、しっかり教育してあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170710
					]
				},
				{
					"id": 240170710,
					"content": "あの豚とは絶対に関わるな。やつは卑劣で恥知らずなんだ！お前のような尊敬に値する人は、やつと知り合うべきじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "イヴス"
				}
			]
		}
	]
}