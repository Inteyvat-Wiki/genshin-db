					"イヴス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170101,
					"content": "ふぅ…ったく…なんでこんな目に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170102,
						240170103
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170102,
					"content": "#{M#君}{F#あなた}は潜水士？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				},
				{
					"id": 240170104,
					"content": "ああ、こうやって潜水服を着てるだろ。何か手伝ってほしいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170105
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170105,
					"content": "もしそうなら、残念な知らせだ…しばらくダイビングは無理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170106
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170106,
					"content": "このエリアの水中は環境がひどすぎる。少し深くまで潜ると、海流がひどく乱れているうえに、大量の水草やらゴミやらに足を取られっぱなしでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170107
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170107,
					"content": "ちょっと油断した隙に足が金属パイプに引っかかって、潜水服が破れちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170108
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170108,
					"content": "幸い、岸からそう遠くなかったから、必死で泳いで岸まで上がってこれたよ。潜水服は破れたけど、足を怪我してなかっただけよかった…病院に行く金なんかないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170109
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170109,
					"content": "だが、ゴールドマンに指示された仕事はできなくなっちまった…それに、あのケチに弁償するよう言われるかもしれない。なんて不運な日だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170110,
						240170112
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170110,
					"content": "怪我してなくてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170111
					]
				},
				{
					"id": 240170111,
					"content": "…お前、慰めるのがうまいな。でも確かにその通りさ。この丈夫な身体を除けば、俺には何の取柄もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170116,
					"content": "はぁ…とにかく、お前には何も力は貸せない。早く潜水服を直して、ゴールドマンに指示された水中のゴミを引き揚げなきゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170117,
						240170118
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170117,
					"content": "#{M#俺}{F#私}が手伝ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170119,
					"content": "気持ちはありがたいけど、潜水は一般人にできるような仕事じゃない。それに、お前に払うモラも持ってないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170120,
						240170121
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170120,
					"content": "#{M#俺}{F#私}、潜水できるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170122,
					"content": "…はぁ、だめだ…この潜水服の穴は大きすぎる。すぐに修復するのは無理だな。今はお前に頼むしかなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170127
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170127,
					"content": "お前は優しいな。きっと誰もがお前と仲良くなりたがるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170123
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170123,
					"content": "ゴールドマンの欲張りめ、きつい仕事ばかりさせやがって。探す物は一番深い水底に沈んでたり、土の中に埋もれてたり、そんなのばっかだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170128
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170128,
					"content": "捜索地点に印をつけよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170124
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170124,
					"content": "よし、捜索地点の印をつけておいた。しっかり頼んだぞ。潜水服にこんな大きい穴が空けちまって…いったいいくら弁償させられるんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170121,
					"content": "#安心して、{M#俺}{F#私}に任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170118,
					"content": "#よければ…{M#俺}{F#私}が引き揚げようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170112,
					"content": "ゴールドマンって誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170113
					]
				},
				{
					"id": 240170113,
					"content": "あいつは、フン…俺のボスだ。俺みたいに何の取柄もなくて、力仕事しかできない人を雇って仕事をさせてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170114
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170114,
					"content": "あいつ、フォンタで頭がいっぱいなくせに、口うるさくて、とんだケチ野郎でな！クソほどある労働ルールとやらを絶対に守らなきゃいけないって、俺たちに強要しやがる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170125
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170125,
					"content": "それに仕事用の潜水服は、やつからの「貸出し品」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170115
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170115,
					"content": "ルールに違反したり、潜水服が破れたりしたら、弁償までさせられるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170126
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170126,
					"content": "つまり、もし仕事中にヘマでもしようものなら、あのケチに弁償額を払って、雇い続けてくれるように頼まなきゃいけない！ちくしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "イヴス"
				},
				{
					"id": 240170103,
					"content": "さっきまでダイビング中だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				}
			]
		},
		{
			"id": 2401702,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
