				"points": []
			},
			"dialogs": [
				{
					"id": 736780101,
					"content": "旅人、来てくれたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780102
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780102,
					"content": "良いお知らせがあるんだ。この前、雪のイノシシが生存している確実な証拠を一つ見つけただろ。さっき指導の先生から手紙があって…僕の論文テーマが、学院で通ったらしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780103
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780103,
					"content": "わ、順調そうだな。おめでとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736780104,
					"content": "うん。良い始まりにはなったけど、研究はこれからだ。長く続きそうだから、僕もモンドに長期滞在する準備をしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780105
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780105,
					"content": "次の課題は、雪のイノシシがどのルートを辿って雪山を離れ、林に現れたのかを突き止めることなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780106
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780106,
					"content": "この前見つけた痕跡から分かる限りじゃ、あいつらはドラゴンスパインの西側から下山して、アカツキワイナリーの辺りを通って清泉町へと向かったと、僕は推測してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780107
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780107,
					"content": "この推測が正しければ、僕たちはこの近くであいつらの痕跡を見つけることができるはずだから、今日の目標はこの件について調べることなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780108
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736780108,
					"content": "なるほどな。ところで、隣にいる狩人の格好をしたおじさんは誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736780109,
					"content": "こんにちは。俺はワルターだ。最近はアカツキワイナリー付近のセキュリティを担当してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780110
					],
					"speakerTitle": "ワルター"
				},
				{
					"id": 736780110,
					"content": "君たちが雪のイノシシを探してるのは、エドモンドのやつから聞いた。今日は俺と一緒に行動しよう。こっちも人手不足だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780111
					],
					"speakerTitle": "ワルター"
				},
				{
					"id": 736780111,
					"content": "はあ、昨日はイノシシが付近の農家に入ったせいで、住民が飼っていたハトやアヒルが驚かされて飛んでいっちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780112
					],
					"speakerTitle": "ワルター"
				},
				{
					"id": 736780112,
					"content": "旅人、後で狩りに行くとき、もしその小動物たちを見つけたら、それらを捕まえて帰ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780113
					],
					"speakerTitle": "ワルター"
				},
				{
					"id": 736780113,
					"content": "わかった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780114
					]
				},
				{
					"id": 736780114,
					"content": "お前は狩人が使うような狩りの道具も使えると聞いたから、この辺にいくつか用意してある。勝手に使ってくれて構わない。準備が出来たら行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736780115,
						736780116
					],
					"speakerTitle": "ワルター"
				},
				{
					"id": 736780115,
					"content": "準備できた。行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736780116,
					"content": "ちょっと待って、まだ他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736780117
					]
				},
				{
					"id": 736780117,
					"content": "ああ、急がなくていい。ここで待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワルター"
				}
			]
		}
	]
}