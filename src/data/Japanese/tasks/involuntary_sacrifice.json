				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "そうね、彼らは目的のためならなんでもやるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000102,
					"content": "七神、魔神、悪龍…これらに関する古き者どもですら、彼らは平気で標的にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000103,
					"content": "それにしても、よりにもよってアビス教団を狙うだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000104,
					"content": "あら、旅人じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000105,
					"content": "あれ？なんで甘雨が嵐姉さんのところにいるんだ？なにか頼みたい依頼でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000106,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000107,
					"content": "今、宝盗団について話し合っていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000108,
					"content": "そうなの、見境のない宝盗団といえども、「アビス」に関わってはいけないことくらい分かってるはずなのに…あれは邪悪すぎるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000109,
					"content": "ですが近頃、モンドと璃月一帯にいる宝盗団の南と北を代表する2人の頭が手を組み、何やら大きな計画を練っているようなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000110,
					"content": "宝盗団…南と北を代表する2人の頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000111,
					"content": "人呼んで、「南の長姉」と「北の怪鳥」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000112,
					"content": "あっ！「怪鳥」はオイラも覚えてるぞ。たしかモンドでアンバーと一緒に戦ったよな…でも「南の長姉」って誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000113,
					"content": "長姉って、一番年上の姉ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "そう、璃月一帯の宝盗団をまとめる人物よ。団員からは「姉貴」と呼ばれているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000117,
					"content": "彼女の盗賊としての才は、まさに盗みの神の恩恵を受けていると信じる人もいるほどでね。だから「神の長姉」とも呼ばれてるそうよ…まあ、ただの噂だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000118,
					"content": "とにかく、宝盗団が過去に誰にも発掘されていない遺跡を発見したことと、その遺跡がアビス教団によって厳重に守られていることは事実です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000119,
					"content": "とても危険なため普通は手を引くのですが、宝盗団は宝を手に入れることしか考えておらず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000120,
					"content": "下っ端を囮にアビス教団の戦力を分散し、精鋭を一人送り込んで宝を盗む、といった計画を立てているようなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000121,
					"content": "しかも、その計画のためにわざわざフォンテーヌから、「姉貴」と「怪鳥」がとある「大宝盗家」を招いたらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000122,
					"content": "「大宝盗家」？なんだかすごそうな肩書きだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000123,
					"content": "ええ、この筋では伝説の人物よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000124,
					"content": "宝盗団にとっての「大宝盗家」は、冒険者たちにとっての「大冒険者」と同じくらい尊敬される立場にあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000125,
					"content": "例えば大冒険者アリスさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "あなたたちもあの『テイワット観光ガイド』の作者を知ってるの？そう、「大宝盗家」は彼女と同じくらい尊敬される人物なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000129,
					"content": "だから、南と北の宝盗団をまとめる2人の頭の力をもってしても、彼を計画に招き入れるのは容易じゃなかったらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000130,
					"content": "今の璃月は、大きな変革を迎えている最中にあります。ですから総務司も千岩軍も、宝盗団の処理をする余裕がありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000131,
					"content": "しかし私の直感では、「アビス」と関わるものには未知なる脅威が潜んでいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000132,
					"content": "ですので、こうして冒険者協会へと依頼をしていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000133,
					"content": "せっかく来たんだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "おう、その依頼、オイラたちが引き受けるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000136,
					"content": "本当ですか、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 80000137,
					"content": "やっぱり頼りになるわね。それじゃあ、気をつけていってらっしゃい。依頼の細かな部分は協会に任せておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000134,
					"content": "「アビス」の脅威は見過ごせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "例えば大冒険者スタンレーさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "あら？モンドであの人に会ったことがあるの？そう、「大宝盗家」は彼と同じくらい尊敬される人物なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 80000114,
					"content": "宝盗団で「姉貴」と呼ばれている人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "よく知ってるわね。どうやら過去に宝盗団と接触したことがあるみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
							"2"
						],
						"stepId": 800004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "あれ…人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000202,
					"content": "もしかして…アイツが「大宝盗家」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000203,
					"content": "あの姿勢…なにかに「お祈り」してるみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000204,
					"content": "！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000205,
					"content": "あ…あれって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000206,
					"content": "あれは…七天神像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "な、なんで七天神像が…逆さに吊るされてるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000209,
					"content": "それに、神像って確か…宝珠を持ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000210,
					"content": "でも…この神像の手にあるものって…なんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000211,
					"content": "うぅ…なんか気味が悪くなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000212,
					"content": "そこの「大宝盗家」も全然動かないし。ま、まさかもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000213,
					"content": "お、おい、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80000214,
					"content": "（反応がない、息もしてないようだ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "…し、死んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "パイモン"
				},
				{
