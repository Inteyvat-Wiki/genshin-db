			},
			"dialogs": [
				{
					"id": 766840101,
					"content": "では…取引成立か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840102
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840102,
					"content": "成立だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840103
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840103,
					"content": "取引成立？オイラ、何か大事な話し合いを聞き逃しちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840104,
					"content": "正式な言い方をすると、ある覚書への署名に合意したところだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840105
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840105,
					"content": "『射撃手の能力向上に関する合同訓練覚書』だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840106
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840106,
					"content": "チャスカさんを特巡隊に入れるのは、彼女の故郷であるナタに計り知れない損失をもたらすことになる。賢明な判断ではないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840107
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840107,
					"content": "特巡隊が時計のように安定して機能しているのも、シュヴルーズ隊長の日々の指揮があってこそだ。シュヴルーズ隊長がいなければ、フォンテーヌは大変なことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840108
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840108,
					"content": "我々の目標を達成するには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840109
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840109,
					"content": "これまでにない協力体制が必要だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840110
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840110,
					"content": "なんだか…やけに息ぴったりだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840111,
						766840112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840111,
					"content": "思考がシンクロしてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840113
					]
				},
				{
					"id": 766840113,
					"content": "要するに、シュヴルーズ隊長と話し合った結果、三ヶ月以内に「交換長期研修」を開始できるよう、準備を進めることにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840114
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840114,
					"content": "これで負担を最小限に抑えつつ、特巡隊、「花翼の集」、そして西風騎士団の連携を強化できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840115
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840115,
					"content": "ええと…それって、その言葉の通り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840116,
					"content": "お互いに代表を派遣しあって、「花翼の集」の戦士はフォンテーヌに、特巡隊の隊員はナタに滞在するってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840117,
					"content": "その通りだ。しかし実際に行うとなると、「互いに客人を招く」という単純な話ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840118
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840118,
					"content": "代表者の選出、宿の手配、日々のカリキュラム、模擬訓練と実地演習のスケジュール、経費の調整…あらゆる細部にわたって、体系的な計画を練る必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840119
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840119,
					"content": "それに、それぞれの弱点を見極め、的確に訓練しなければならない。例えば、ナタの戦士は、統率を取ることをあまり重視しておらず、フォンテーヌの射撃手は、敵味方共に動きが生じる射撃の実践経験が皆無に等しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840120
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840120,
					"content": "だから、ナタの戦士は小隊に編成し、厳格に役割分担をして行動させる。そして特巡隊の射撃手は、低空飛行するクク竜に肩を掴まれた状態で、目標を射撃させるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840121
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840121,
					"content": "すっごく難しそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840122,
						766840123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840122,
					"content": "実現出来たら、すごい効果が期待できそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840124
					]
				},
				{
					"id": 766840124,
					"content": "計画されている訓練では、モンドの優秀な装備を使用することになる。そのため、西風騎士団側の代表も必要だ。研修で得られた成果はすべて、彼らと共有しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840125
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840125,
					"content": "あっ、ありがとうございます、シュヴルーズ隊長！ご提示いただいた見積もりは、十分すぎるほどです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840126
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766840126,
					"content": "今回の演習において、「可視榴弾」および一連の装備は正常に機能しました。契約に基づき、今後は定期的に納品いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840127
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766840127,
					"content": "代表を派遣する件につきましても、騎士団に報告し、上官より正式に返答させていただきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840128
					],
					"speakerTitle": "ヘドウィグ"
				},
				{
					"id": 766840128,
					"content": "正式な書類を用意しよう。良い知らせを待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840129
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840129,
					"content": "最後に、話題を「射撃推理」に戻そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840130
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840130,
					"content": "シュヴルーズ隊長。今回の結果に満足してくれたようで何よりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840131
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840131,
					"content": "#ああ、{NICKNAME}が提供してくれた数々の素晴らしいデータが対照群となり、最後のピースも埋まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840132
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840132,
					"content": "今回の演習で、あらゆるレベルの射撃手を網羅した、大量の弾道計画思考サンプルを得られた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840133
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840133,
					"content": "これは、従来の射撃に関する教材、さらには射撃手を育成する教官用のハンドブックまでもを改良し、指導効率を倍増させられるほどのものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840134,
						766840135
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840134,
					"content": "次の演習にも呼んでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840136
					]
				},
				{
					"id": 766840136,
					"content": "お前なら、そう言ってくれると信じていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840137
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840137,
					"content": "いずれその時が来たら、真っ先にお前に手紙を送ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840138
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 766840138,
					"content": "その射撃の腕なら、次回は教官を担当してもらうのもよさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840139
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 766840139,
					"content": "へへっ！モンドにフォンテーヌ、それにナタの仲間の訓練を手伝えるなんて、すごいことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840140,
					"content": "オイラたちが関わった教材からすごい戦士が育って、そいつらが魔物を撃退して、みんなを守れたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840141,
					"content": "自分で悪いやつらを追い払った時と同じくらい誇らしいに違いないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766840135,
					"content": "こういう演習なら、喜んで協力するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840136
					]
				},
				{
					"id": 766840123,
					"content": "弱点を集中して鍛えるのは、確かに効果的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840124
					]
				},
				{
					"id": 766840112,
					"content": "お互い満足できるプランを編み出したんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840113
					]
				}
			]
		}
	]
}