			"dialogs": [
				{
					"id": 726550101,
					"content": "やっと目標の位置を見つけ出しました！嬉しい、船に帰れる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550102,
					"content": "え——？もう終わった気分になってるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726550103,
					"content": "そんなことありません。私たちの目標まであと一歩です。早速出発して、遺跡機械を捕獲しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550104,
					"content": "さっきはあのまま、船に帰るかと思ったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726550105,
					"content": "まあいいや、オイラたちも行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
