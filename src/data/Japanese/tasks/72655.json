			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "ハハ、ここです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550202,
					"content": "ここにも地下の遺跡が…うっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550203,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "な、何でも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550206,
					"content": "あれ、具合でも悪いのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726550207,
					"content": "アハハ、普段あまり船から降りてこなかったんで、遺跡の入り口を見たらそわそわしてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550208,
					"content": "そわそわするほどじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726550209,
					"content": "はい、あの…、姉御の注文も待ってるし、旅人さんも遺跡の中が気になるでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550210,
					"content": "だから、ここは経験豊かな旅人さんが先陣を切ってはいかがです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550211,
					"content": "しょうがない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "まったく、オイラたちで行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726550204,
					"content": "何か見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
