			"dialogs": [
				{
					"id": 726550301,
					"content": "どうしました、ウォーミングアップでも必要ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550302,
					"content": "遺跡について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "船の機関士なんで、陸地の歴史には詳しくありません。ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550305,
					"content": "でもこの遺跡は、確か500年前の厄災と関わりがあるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550306,
					"content": "私も小さい頃にお年寄りの船員から聞いたんですけど、海も陸地もアビスの侵襲から逃れることができなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550307,
					"content": "まあ、私にとってはおとぎ話のようなものなんですけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550308,
					"content": "この目で見たものだけが、真の恐ろしさですからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726550303,
					"content": "謎の機械について…",
