			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"亀井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "この料理はすごいんだぞ、びっくりするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210102,
					"content": "私が作ったこの料理も負けませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210103,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "おお、旅人か。パルヴァネとジュリーが食材調達に出かけて、俺たちは料理を作るつもりだったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210105,
					"content": "どんな料理にするか、宗久のおじさんと少し意見が分かれてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210106,
					"content": "そこで、宗久のおじさんと料理対決をして、今日の料理を決めることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210107,
					"content": "俺は璃月の伝統料理「真珠翡翠白玉湯」を作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210108,
					"content": "では私は自慢の「串焼き三種」を作りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210109,
					"content": "手助けは必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "もし時間があれば、審判役として、料理の味を評価してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210113,
					"content": "だが、俺たち二人とも四人分の料理を準備しないといけないから、手が空かないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210114,
					"content": "評価する前に、先に料理の準備を手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210115,
					"content": "もちろん、お前さんは一人だから、興味のある方を選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210116,
					"content": "旭東は手が足りてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "俺なら心配いらないぜ。昔、璃月で飲食店をやっていたからな。四人分くらいは問題ないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210118,
					"content": "ただ、もし助っ人がいれば、料理をもっと丁寧に作れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210122,
					"content": "とにかく、どちらか興味のある方についてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210123,
					"content": "旭東を手伝う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "おう！宗久のおじさん、覚悟しておけよ。俺の料理でびっくりさせてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210125,
					"content": "そう簡単にやられはしませんよ。ぜひ、全力できてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210126,
					"content": "宗久のおじさんを手伝う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "ありがとうございます。旭東さん、気を付けてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210128,
					"content": "問題ないぞ、かかってこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210119,
					"content": "宗久のおじさん、手伝いは必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "大丈夫です、あなたの判断にお任せしますよ。私がまだ幕府にいた頃は、よく数人分のおつまみを作っていました。今回は四人分ですから、当時よりも楽ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210121,
					"content": "しかし、もし手を貸して下さるのなら、もっと美味しい料理が作れるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210111,
					"content": "審判が必要だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "ははは、さすがに鋭いな。その通り、料理の味を評価する審判役が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"亀井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "そろそろ完成するな。感謝するぞ、旅人。美味そうな香りがしているし、問題なさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210202,
					"content": "味はどうかな…おおっ、いい感じだ！食材がほどよく煮込まれていて、香りも濃厚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210203,
					"content": "まさに「完璧な真珠翡翠白玉湯」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210204,
					"content": "宗久のおじさん、調理は順調か？旅人に味見してもらったらどうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210205,
					"content": "実は、失敗してしまいました。始める時に、鳥の卵が足りないことに気付いたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210206,
					"content": "すぐに近くの森で採ってきたものの、他の食材の理想的な調理期限を過ぎてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210207,
					"content": "このように鮮度が低い食材で作った「串焼き三種」は、もう良い料理とは言えません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210208,
					"content": "このような過失を犯すとは実にお恥ずかしい。料理においては、さらなる修行を重ねる必要がありますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210209,
					"content": "今回の勝負は私の負けです。しかし、次回は必ず旭東さんに勝ちます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210210,
					"content": "頑張れ、おじさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "ははっ、俺に勝つのは容易ではないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210212,
					"content": "そうだ。旅人、これを受け取ってくれ。俺とおじさんに付き合ってくれて感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210213,
					"content": "次に料理対決する時も、必ず来てくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210214,
					"content": "美味しいと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "いいえ、たとえ料理でも、常に「極致」を追求しなければ。「まあまあ」で満足してはいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210216,
					"content": "さもなければ、料理の道を進むことなどできません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210217,
					"content": "そ…その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210218,
					"content": "そ…その通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "料理の道は武芸の道と似ています。同時に、人としての道のようでもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210220,
					"content": "その意気だ！頑張れよ、宗久のおじさん、あははっ、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210221,
					"content": "あー…実は俺…こういう真面目な人間が苦手なんだ…ジュリーに任せたいところだが、彼女はどこに行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210222,
					"content": "返事に困ってたね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "コホン…とにかく、今回はご苦労様。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210224,
					"content": "旭東さん、料理について質問したいのですが、お時間はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210225,
					"content": "え？ああ！じ、時間ならある！今でもいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
							"2"
