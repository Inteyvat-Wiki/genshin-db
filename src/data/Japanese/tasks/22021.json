			},
			"dialogs": [
				{
					"id": 220210701,
					"content": "手伝っていただき、感謝します。この「串焼き三種」という料理は、作り方は簡単ですが、食材の鮮度に注意しなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210702,
					"content": "必要な食材はほとんど準備できましたが、鳥の卵だけ少し足りないような…念のため、新鮮な鳥の卵を二つ探してきてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210703,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "ではよろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210705,
					"content": "どうして作れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "私が幕府にいた頃は、同僚たちのおつまみとして、このような料理をよく作っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210707,
					"content": "しかし今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210708,
					"content": "過去の話はこの辺にしておきましょう。鳥の卵は頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210709,
					"content": "ここで食材を調理していますので、鳥の卵を見つけたら、早めに持ってきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
