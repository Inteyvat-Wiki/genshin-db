			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"亀井宗久",
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "では。このすばらしい香りと見た目…この「串焼き三種」は「串焼きの極致」とも言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210302,
					"content": "く、串焼きの極致？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "ははは、完璧な「串焼き三種」という意味です。もうだいぶ時間が経ったので、旭東さんの「真珠翡翠白玉湯」も出来上がるころでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210304,
					"content": "お待たせ。これが俺の「真珠翡翠白玉湯」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210305,
					"content": "材料の調理時間を上手く配分できなかったから、スープが若干煮詰まってしまった。だが味は悪くないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210306,
					"content": "試食させてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210307,
					"content": "うむ、確かに少々焦げたような味がしますが、幸いにも料理全体を台無しにはしていません。ちょっとした欠点にはなってしまっていますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210308,
					"content": "ははっ、ちょっと焦りすぎたのかもな。次はこんなことを防ぐため、あらかじめ食材を準備しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210309,
					"content": "今回は俺の負けだ。だが、次回は絶対にこんな凡ミスなんて犯さないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210310,
					"content": "油断したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "ははは…そうだな、ちょっと油断したらおじさんに負けちまった。次はもっと真剣にやらないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210312,
					"content": "そうだ。旅人、これを受け取ってくれ。俺とおじさんに付き合ってくれて感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210313,
					"content": "次に料理対決する時も、必ず来てくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210314,
					"content": "おじさんの「串焼きの極致」の勝ち。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "く、串焼きの極致？なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210316,
					"content": "完璧な「串焼き三種」という意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210317,
					"content": "「極致」とは「最高の状態」ということ。まあまあな出来に満足せず、常に極みを追求しなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210318,
					"content": "常に極みを追求しないと、料理の道を進むことなど不可能なのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210319,
					"content": "そ…その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210320,
					"content": "そ…その通り！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "料理の道は武芸の道と似ています。同時に、人としての道のようでもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210322,
					"content": "旭東さん、こちらへ。私から「極致」へと至る道を説明して差し上げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210323,
					"content": "え？ちょ…ちょっと待ってくれおじさん。旅人、早く先にこれを受け取ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210324,
					"content": "あー…実は俺…こういう真面目な人間が苦手なんだ…ジュリーに任せたいところだが、彼女はどこに行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220210325,
					"content": "料理の「極致」へと至る道を学んできて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "旭東さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220210327,
					"content": "ん？お、俺を呼んだか？すぐ行くぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
