			"dialogs": [
				{
					"id": 735340901,
					"content": "ダルマキールティが言っていた「凄腕の友人」というのは、あなたのことだね？私はピユシュ。建築業に従事している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "ピユシュ"
				},
				{
					"id": 735340902,
					"content": "以前カーヴェさんからあなたの名前を聞いたことがあったが…こうやって会えたのも何かの縁だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "ピユシュ"
				},
				{
					"id": 735340903,
					"content": "後ほどの夢の中には、私が設計したプロジェクトが出てくるだろう。あの悪夢を、初対面の人に見せたくはないが…はぁ、仕方ないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピユシュ"
				}
			]
