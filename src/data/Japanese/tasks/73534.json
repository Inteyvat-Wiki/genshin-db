			"dialogs": [
				{
					"id": 735340501,
					"content": "初めまして、僕は樋口鉄矢だ。稲妻の小説家で、妖怪をテーマにした小説を書いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "樋口鉄矢"
				},
				{
					"id": 735340502,
					"content": "最近、原稿が行き詰ってて、焦燥感に駆られてるんだ。心が落ち着く方法なら、何でも試すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "樋口鉄矢"
				},
				{
					"id": 735340503,
					"content": "僕の症状に合わせて作られた夢境ということは、個人的な嗜好が反映されてるかもしれない。夢の中で変なものを見せてしまったらすまないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樋口鉄矢"
				}
			]
		},
