			"dialogs": [
				{
					"id": 735340701,
					"content": "おぉ、お前さんが夢境実験のボランティアか。若くて頼もしいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "ニテーシュ"
				},
				{
					"id": 735340702,
					"content": "私のことはニテーシュと呼んでくれ。素論派の遊学者だが、今はフォンテーヌに常駐する形で勤務している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "ニテーシュ"
				},
				{
					"id": 735340703,
					"content": "年を取ると、いろんな症状に見舞われる。若者よ、どうか夢の中でその原因を突き止めてくれるとありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニテーシュ"
				}
			]
		},
