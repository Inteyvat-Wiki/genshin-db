			"dialogs": [
				{
					"id": 735340301,
					"content": "こんにちは。これから一緒に夢境に入ることになるけど、よろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "幼光"
				},
				{
					"id": 735340302,
					"content": "私は璃月から来た鏢師の幼光よ。この間、護送の途中で穢れに遭って以来、よく眠れてなくて…だから、助けを求めに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "幼光"
				},
				{
					"id": 735340303,
					"content": "もし夢境療法で悪夢を見ずに済んだら、すごく助かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "幼光"
				}
			]
		},
