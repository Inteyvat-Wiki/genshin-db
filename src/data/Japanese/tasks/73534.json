			"dialogs": [
				{
					"id": 735340101,
					"content": "やあやあ、君が夢境療法を施してくれるのか？どんな夢を見ることになるのかは、正直、俺にも分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "コリンウッド"
				},
				{
					"id": 735340102,
					"content": "俺はモンドの出身なんだがな、これと言った趣味はなくて…強いて言うなら、酒を飲むぐらいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "コリンウッド"
				},
				{
					"id": 735340103,
					"content": "だが、時々飲み過ぎてしまって、失敗しちまったりするんだ。今回はよろしくな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コリンウッド"
				}
			]
		},
