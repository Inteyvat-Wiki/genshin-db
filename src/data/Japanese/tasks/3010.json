			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "オ、オイラ全部思い出したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100102,
					"content": "…よかった、今回は適応が早かったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100103,
					"content": "昨日の夜更け…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "オイラたちアーカーシャを外したのに、それでもあの音が聞こえてきたぞ。あれはいったいどういうことなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100105,
					"content": "他の形でアーカーシャ端末を埋め込まれた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "でもこれで、オイラたちが同じ日から抜け出せないのが、アーカーシャと関係してるってことがわかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100108,
					"content": "もしもアーカーシャがみんなの英知を「盗もう」としてるのなら、なんでこんな状況を作り出したんだろう…う～ん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100109,
					"content": "実験台にいるマウスが、そのような扱いを受けている理由を知るのは、確かに困難極まりないことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100110,
					"content": "オイラたちをマウスに例えるのかよ。だったらおまえはなんなんだ、ナヒーダ？おまえはまだオイラたちに正体を言ってないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100111,
					"content": "うん…私は、「月」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100112,
					"content": "月？それってオイラたちがやった占いの結果じゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100113,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "私が誰であるかを知っても、真実を知る手助けにはならないわ。そんなことより、もっと他のところに注意力を使いなさい。じゃないと、手がかりを見逃してしまうわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100115,
					"content": "うぅ…わかったよ。昨日はディシアがたくさん助けてくれたし、今日もまずはディシアに会いに行こうぜ。ちょうど、あの人さらいたちが現れる時間だしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100106,
					"content": "アーカーシャ端末を外したと思ってただけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "ここにいたのか。人さらいはあたしが片付けた。お嬢様にケガがないといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100202,
					"content": "待って、何かおかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "あれ…ディシア…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100204,
					"content": "どうした？二人とも、なぜあたしをじっと見つめている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100205,
					"content": "な、なんでケガをしてないんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100206,
					"content": "は？どういう意味だ。あんな軟弱な人さらい相手に、どうしてあたしがケガをしなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100207,
					"content": "その大剣、使い慣れてないはずだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "シーッ…なんであんたが大剣のことを知ってるんだ。あたしは誰にも言っていないはずだ。それに、そのことはお嬢様に知られたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100210,
					"content": "やっぱりディシアも記憶がなくなってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100211,
					"content": "さっきの戦いで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "変なところ…しいて言うなら、そうだな…あたしが大剣を変えたのはあんたたちも知っているが、新しい大剣だっていうのに妙に手に馴染むんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100214,
					"content": "まるで…こいつを使って数えきれないほど戦いを経験してきたかのようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100215,
					"content": "つまり、頭の中にはこいつを使って戦った記憶はないけど、身体のほうにはある…ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100216,
					"content": "ああ。傭兵や武人にとって、「身体に刻まれた記憶」こそもっとも重要なものだ。頭で一つ一つ覚えているような技は、ただの付け焼き刃に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100217,
					"content": "旅人、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100218,
					"content": "まさか昨晩アーカーシャを外したから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "そうだな、なんか希望が見えてきた気がするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100221,
					"content": "もしかして、もう抜け出せたのかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "おお！そうだな、これまでの「花神誕日の輪廻」の中じゃ、こんな状況ありえなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100223,
					"content": "今日が終ったら、すべてが分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "何を言っているのか分からないが、まだ危険が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100225,
					"content": "危険がまだ残っている、だからオイラたちにドニアザードを休める場所まで連れていかせて、おまえは人さらいの共犯者を探しに行く、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100226,
					"content": "どうしてあたしの言おうとしたことを…読心術か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30100227,
					"content": "まあ、早く取りかかろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100219,
					"content": "事象の変化が初めて起きた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "何か変なところはなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "本当は少しケガを負うことになってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "…ふぅ、やっと夜になったぜ。結局あのこと以外に変化はなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100302,
					"content": "ナヒーダ、実は今日、いつもは人さらいを撃退した後にケガを負うディシアが、今日だけケガをしてなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100303,
					"content": "これって「花神誕日の輪廻」が終わったってことじゃないか？ドニアザードもこれで助かるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100304,
					"content": "そう？そのような進展があったの、悪くないわね。なら、今日はゆっくり休むといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100305,
					"content": "おい、なんだよそのどっちつかずの返事は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100306,
					"content": "明日はやって来る、このことは誰にとっても当たり前のことよ。でも、本当に明日が来るかどうか知ることができるのは、明日のあなただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100307,
					"content": "今日が何回繰り返されたのか？今日の次が昨日である可能性はないか？明日という言葉が、そもそも始めから捏造された概念なのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100308,
					"content": "もしかしたら、この世界はすべてがまやかしで、この大陸の歴史もただの長い「花神誕祭」に過ぎないのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100309,
					"content": "うぅ、もうこの話はやめにしよう…ただでさえ頭が疲れてるっていうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100310,
					"content": "ふふっ…だから、明日になったら自ずと分かるわ。今日は無意味に脳を使うなということね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100311,
					"content": "しっかりと心身を休めてちょうだい。パーッとトイレにでも行けばいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100312,
					"content": "ん？なんだって？オイラの聞き間違いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100313,
					"content": "あら？人はトイレに行った後、清々しい気持ちになるっていうでしょ。だからそれを勧めたのだけど、変だったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30100314,
					"content": "えっと…あまりにもおかしくて常識はずれだから、なにを言えばいいのかわからないぞ…さっきまでなんか難しい道理を説いてたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30100315,
