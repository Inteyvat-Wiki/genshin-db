			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シェフケット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230101,
					"content": "ああ！先ほどあの、背中にキノコが生えたイノシシを狩った方…ちょっとよろしいですか。ご相談したいことがあるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シェフケット"
				}
			]
		},
		{
			"id": 7302303,
			"completionStepIds": [
				7302303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302303",
							"2"
						],
						"stepId": 7302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"シェフケット",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230301,
					"content": "ああ、お二方、お邪魔してすみませんが、ひとつ相談がありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230302
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230302,
					"content": "さっき狩っていらっしゃったキノシシの肉を少し分けてもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230303
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230303,
					"content": "キノシシ…さっきの、背中にキノコが生えたイノシシのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230304,
					"content": "そうですそうです、その背中にキノコが生えたイノシシです。あのイノシシはよくスメールの泥沼で泥浴びをするんですが、その時に胞子が毛に付着してキノコに成長するんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230305
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230305,
					"content": "はは、キノコが成長する過程でイノシシの体はスカスカになるなんて噂もありますが…キノシシの肉は特別なキノコの香りがして高く売れるんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230306,
						730230307
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230306,
					"content": "ちょっと気持ち悪い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				},
				{
					"id": 730230308,
					"content": "ハハ、それはただの噂ですよ。冬の間やエサがない時、キノシシはお互いの背中のキノコをかじって飢えを満たせるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230309
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230309,
					"content": "そしてキノコの方も、イノシシの移動に合わせて、色んな場所に胞子を撒くことができる…実際のところ、健全な共生関係にあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230310
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230310,
					"content": "ああ、すみません、自己紹介がまだでしたね。私はシェフケットと申します。お二人は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230311
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230311,
					"content": "オイラはパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230312,
					"content": "#{NICKNAME}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230313
					]
				},
				{
					"id": 730230313,
					"content": "#なるほど、{NICKNAME}さんとパイモンさんですね…覚えました。先ほどお二人がキノシシを狩っていた時の身のこなしを見て、ただ者ではないと分かりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230314
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230314,
					"content": "実を申しますと、私は野外生物の研究をしているんですが、その…まったくキノシシを捕まえられないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230315
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230315,
					"content": "私が近づくだけで、あいつらはサッと遠くに走り去るか、私を地面に叩きつけていく…こんな有様では、研究も始められない内に私の腰がやられてしまうでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230316
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230316,
					"content": "そこで、キノシシを軽々と片付けたお二人にどうかお願いしたいのですが、倒したキノシシの肉を買い取らせてもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230317
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230317,
					"content": "この肉って、なにか特別なのか？見た感じ、普通のイノシシ肉と変わらないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230318,
					"content": "いやいや、変わらないかどうかは、調べればきっとはっきりします！どうか売ってください。十分にお支払いしますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230319
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230319,
					"content": "（キノシシの肉を渡す…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230320
					]
				},
				{
					"id": 730230320,
					"content": "ああ、本当にありがとうございます。これで調査を続けられます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230321
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230321,
					"content": "シェフケットがやってるのは、一体なんの調査なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230322,
					"content": "普通の生態調査ですよ。時には動物を捕獲して、その成長状況を調べたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230323
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230323,
					"content": "たった一体の個体を調べるだけで、一定期間の群れ全体の成長状態が分かるのは、とても不思議なことですけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230324
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230324,
					"content": "シェフケットは本当に動物が好きなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230325,
					"content": "ええ、わ…私はずっと好きなんです。長く研究して来ましたからね。スメールの森の生態系は、とても魅力的です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230326
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230326,
					"content": "よし、キノシシの肉は解決しました。次は「暝彩鳥」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230327
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230327,
					"content": "#{NICKNAME}、あなたたちは暝彩鳥を見たことがありますか？<color=#00E1FFFF>アパーム叢林の南方向</color>によく出没する、とても美しい鳥なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230328
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230328,
					"content": "あれもスメール特有の鳥類で、教令院の学者もよくあれを使って情報をやり取りしています…長距離を飛ぶことができるにもかかわらず、雨が苦手で、雨が降ると隠れてしまうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230329
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230329,
					"content": "さて、私はそろそろ行きますね。暝彩鳥は、できれば私一人で捕まえたい…はは、いつまでも人に頼っていてはダメですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230330
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230330,
					"content": "でも…コホン、その…もしよろしければ、私のことも心に留めておいていただけませんか？暝彩鳥を捕獲された暁には、喜んで買いますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230307,
					"content": "ちょっとホラー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				}
			]
		},
		{
			"id": 7302308,
			"completionStepIds": [
				7302308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302308",
							"2"
						],
						"stepId": 7302308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"シェフケット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230801,
					"content": "あ、おまえはあの「調査人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230802,
					"content": "調査人って…はは、私の名前はシェフケットです。以前お会いしたでしょう？キノシシの肉を売っていただいた時に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230803,
						730230805
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230803,
					"content": "そうだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230804
					]
				},
				{
					"id": 730230804,
					"content": "そうだよ！普通のイノシシ肉より高く買い取ってくれたじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230807,
					"content": "というかシェフケット、どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230808,
					"content": "ははは、お恥ずかしながら、まだ調査を続けている、というところで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230809
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230809,
					"content": "調査に必要な暝彩鳥がまだ一匹も捕まらず…進度はお察しの通りです。鳥が捕まらないだけならまだしも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230810
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230810,
					"content": "まだしも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230811,
					"content": "エルマイト旅団に遭遇しまして…会話を交わす間もなく、あいさつ代わりに武器を向けてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230812
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230812,
					"content": "そっか…そういえば、この前エルマイト旅団のやつら、オイラたちをおまえと間違えてたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230813,
					"content": "ええ？そうですか…はは、そんなことになったのも…きっと私が暝彩鳥を保護する行為が、彼らに理解されないからです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230814
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230814,
					"content": "はぁ…エルマイト旅団の人たちは、この森の暝彩鳥を自分たちの財産だと思っているに違いありません。それで私のサンプル採集を敵視しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230815
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230815,
					"content": "なにしろ、暝彩鳥の羽はかなり高価な商品になりますからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230816
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230816,
					"content": "ご存知ですか？暝彩鳥は森の中で自分の姿を隠すために、こんな鮮やかな色に成長するんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230817
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230817,
					"content": "しかしその結果、多くの人間がこの美しい羽を得るために狩りをするようになりました。悲しい話です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230818
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230818,
					"content": "可哀想だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230819,
					"content": "エルマイト旅団に出会った時、私はあなたたちのように勇敢にはなれず…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230820
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230820,
					"content": "そうだ。あなたたちが仕留めた暝彩鳥の羽を、私に売ってもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230821
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230821,
					"content": "前回と同じように、十分にお支払いしますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230822
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230822,
					"content": "（暝彩鳥の羽を渡す…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230823
					]
				},
				{
					"id": 730230823,
					"content": "ははっ、暝彩鳥の羽も手に入った…これで、これで私の調査も大半が終わりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230824
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230824,
					"content": "ですが、この羽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230825
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230825,
					"content": "どうした？その羽じゃなにかダメだったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730230826,
					"content": "いえ、この羽で大丈夫なのですが、ちょっと品質が…ああその、この地域の暝彩鳥の成長状况が、あまり良くないように思えるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230827
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230827,
					"content": "別の場所で、もっと暝彩鳥の羽を集める必要がありますね。そうすれば、暝彩鳥の群れ全体にいったい何が起きているのか分かるでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230828
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230828,
					"content": "<color=#00E1FFFF>アパーム叢林の北方向</color>に別の暝彩鳥の群れがいると聞きました。そこへ行って暝彩鳥の痕跡があるかどうか確かめてみないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230829
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230829,
					"content": "#うん、また行かなければ！縁があればまたお会いしましょう、{NICKNAME}さんとパイモンさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730230805,
					"content": "確かそんなこともあったような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230806
					]
				},
				{
					"id": 730230806,
					"content": "あ、思い出した。動物好きなシェフケット！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7302312,
			"completionStepIds": [
				7302312
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302312",
							"2"
						],
						"stepId": 7302312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"オルハン",
					"パイモン",
					"パムーク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231201,
					"content": "やめろやめろ！ここで勝手に暝彩鳥を狩るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231202
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231202,
					"content": "うむ、やはり！お前たちだな。最近悪さをしては逃げ回っている密猟者は！また私の暝彩鳥を狩る気か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231203
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231203,
					"content": "ふん、暝彩鳥はおまえのものじゃないだろ？おまえがこの暝彩鳥を飼ってるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231204,
					"content": "そうではない。だが、私の暝彩鳥と言ったら、それは私の暝彩鳥だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231205
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231205,
					"content": "それは私が見張っている暝彩鳥なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231206
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231206,
					"content": "見張ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231207,
					"content": "そうだ。私はオルハン——三十人団の命を受けて、この暝彩鳥が集まる場所を密猟者から守っている見張り番だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231208
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231208,
					"content": "信じられんか？なら、この三十人団の治安官が署名した命令書を見るがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231209
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231209,
					"content": "オルハンが示した証書には、確かに三十人団の署名があった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231210
					]
				},
				{
					"id": 730231210,
					"content": "ええ？オイラたちが聞いてた話と違うぞ…最近、暝彩鳥を捕まえて生態調査をやってるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231211,
					"content": "そんな活動はない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231212
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231212,
					"content": "…もしかして、シェフケットに騙されたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231213,
					"content": "シェフケット…はぁ、またシェフケットのやつか。草神よ、哀れみたまえ！お前たちは完全にやつに騙されたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231214
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231214,
					"content": "やつはレンジャーの格好をして人を騙しているが、実際は宝盗団と手を組んで珍しい動物の素材を横流ししている馬鹿野郎なのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231215
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231215,
					"content": "そ、そんなことって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231216,
						730231217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231216,
					"content": "認めざるを得ないね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				},
				{
					"id": 730231218,
					"content": "やつに騙された冒険者は一人や二人ではない。それにやつは冒険者に手を出させておきながら、自分は後ろに隠れているから、陸ウナギのように捕まえづらい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231219
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231219,
					"content": "#どうしよう、{NICKNAME}。オイラたち、もういっぱい暝彩鳥を狩っちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231220,
						730231223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231220,
					"content": "牢屋飯の栄養バランスに期待しよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231221
					]
				},
				{
					"id": 730231221,
					"content": "イヤだー！三十人団に捕まるのはイヤだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231222,
					"content": "…そんな深刻になるな。暝彩鳥の群れは巨大で、特別希少な種というわけでもない。お前たちも知らずにやったのだから、捕らえられるほどのことではないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231228,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231229,
					"content": "「だが、罰金を減らすことは許されない」…と言いたいところだが…コホン、お前たちに罪を償う機会をやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231230
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231230,
					"content": "罪を償う機会？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231231,
					"content": "そうだ。理由は分からんが、シェフケットは大量の暝彩鳥の羽を必要としている…私たちはそれでやつをおびき寄せることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231232
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231232,
					"content": "例えば…「<color=#00E1FFFF>アパーム叢林の東方向</color>の山の上に、大量の暝彩鳥が生息している」——そんな情報を流せば、やつは引っかかるに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231233
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231233,
					"content": "しかし、あいつは極めて狡猾だ。我々が少しでも表立って動けば、警戒して逃げ出すだろう。そこでお前たちが必要なのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231234
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231234,
					"content": "#うむ…その、なんだったか？金髪の方が{NICKNAME}で、飛んでいる小さいのが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231235
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231235,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231236,
					"content": "#うむ、{NICKNAME}とパイモン。我々のためにシェフケットと接触してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231237
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231237,
					"content": "分かったぜ。あいつもオイラたちを見れば、ちょっとは警戒を解くだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231238,
					"content": "その通りだ。我々は待ち伏せしておくから、足止め役は頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231239
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231239,
					"content": "うまくいったら…そうだな、大声で「お前のやってることは全部知ってるぞ！」と叫んでくれ。それを合図に我々がやつを捕らえる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231240
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231240,
					"content": "どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231241
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231241,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231242
					]
				},
				{
					"id": 730231242,
					"content": "善は急げだ。我々はこれから情報を広めに行く。スメールシティへは私が。フェリット、お前はガンダルヴァー村を頼む。ついでにあの辺りに宝盗団と結託している人間がいないか探りを入れてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231243
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231243,
					"content": "パムーク、ヴィマラ村の付近は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231244
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231244,
					"content": "任せてください、ボス。偽情報を流してきますので、ご安心を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231245
					],
					"speakerTitle": "パムーク"
				},
				{
					"id": 730231245,
					"content": "ようし、今度こそあの密猟野郎をお縄にするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231246
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231246,
					"content": "#お前も頼むぞ、{NICKNAME}。必ずやつを引っ張り出すのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231223,
					"content": "今すぐスメールを出る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231224
					]
				},
				{
					"id": 730231224,
					"content": "仕方ない。まだ探索していないスメールの地域は、また後から来るしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231225,
					"content": "逃げると言うなら見過ごすわけにはいかん。それに、最近ますますひどくなった密猟行為に対処するため、この近くは三十人団の人間だらけだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231226
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231226,
					"content": "イヤだー！三十人団に捕まるのはイヤだぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231227
					]
				},
				{
					"id": 730231227,
					"content": "…そんなに緊張するな。暝彩鳥の群れはまだ巨大で、特別希少な種というわけでもない。お前たちも知らずにやったことだ。捕らわれるほど深刻なことではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231217,
					"content": "やっぱりシェフケットに騙されたか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				}
			]
		},
		{
			"id": 7302314,
			"completionStepIds": [
				7302314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302314",
							"2"
						],
						"stepId": 7302314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シェフケット",
					"パイモン",
					"オルハン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231401,
					"content": "#やあ、{NICKNAME}とパイモン…ここに来たということは、あなたたちもこの辺に暝彩鳥の住み家があるという噂を聞いたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231402
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231402,
					"content": "しかし、ここは普通、暝彩鳥が好む環境ではありませんね。どうしてここに住んでいるのか…これは研究に値する課題かもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231403
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231403,
					"content": "シェフケット…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231404,
					"content": "はは、どうしました？ははあ、私が暝彩鳥の羽を買うのかどうか聞きたいんですね。そうでしょう、暝彩鳥の羽は高価ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231405
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231405,
					"content": "「お前のやってることは全部知ってるぞ！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231406
					]
				},
				{
					"id": 730231406,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231407
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231407,
					"content": "突然どうしたんです？私が調査のために重ねてきた苦労を分かってくれたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231408
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231408,
					"content": "#（あれ、おかしいな。なんでエルマイト旅団のやつら、出てこないんだ？オルハンと約束したのに…{NICKNAME}、オイラがやってみるよ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231409,
					"content": "「おまえのやってることは全部知ってるぞ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231410,
					"content": "どうしてパイモンまで…ええ、そうです。これは全部私がすべきことです。それに、あなたたちもこれまで沢山助けてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231411
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231411,
					"content": "調査の過程は確かに大変ですが、そのすべてに意味があります。これもすべて、森の動物たちのため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231412
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231412,
					"content": "それは森の動物たちのためじゃなくて、自分のためだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231413,
					"content": "#{M#君}{F#あなた}のやってることは全部知ってるぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231414
					]
				},
				{
					"id": 730231414,
					"content": "その瞬間、オルハンが林の奥から急いで飛び出してきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231415
					]
				},
				{
					"id": 730231415,
					"content": "そうだ、シェフケット！三十人団は正式に、レンジャーを偽った罪、冒険者を唆して密猟させた罪、宝盗団と結託した罪などでお前を逮捕する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231416
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231416,
					"content": "なんだよオルハン、やっと来たのかよ。オイラたち合図を叫びすぎて喉が枯れるところだったじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231417,
					"content": "これは、ちょっとした事故で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231418
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231418,
					"content": "エルマイト旅団の人間がどうしてここに？合図？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231419
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231419,
					"content": "私のやったことを全部知っている、とはそういう意味だったのか…ちょっと感動してたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231420
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231420,
					"content": "大ウソつき！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231421,
					"content": "大人しくお縄につけ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231422
					]
				},
				{
					"id": 730231422,
					"content": "ああ、気づくべきだった。あなたたちはとっくにエルマイト旅団と…ふん、ここに暝彩鳥がいるという情報も、あなたたちが流したんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231423
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231423,
					"content": "その通り。お前は罠にかかったのだ、シェフケット。人を騙し続けたお前が、騙される日が来るとは思わなかっただろう！三十人団がお前にたっぷり罰をくれてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231424
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231424,
					"content": "…はぁ、今さら申し開きはしませんよ。私はスメールの動物が本当に好きですが、好きなだけでは何の役にも立たないこともあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231425
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231425,
					"content": "私は教令院に入れず、それでも毎日、実のない調査を続けていました。しまいには、いつも森をぶらついている変人だと他人に思われて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231426
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231426,
					"content": "私にはモラが必要だった…調査のためにも、陰で私の悪口を言う人間の口を閉じさせるためにも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231427
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231427,
					"content": "だから、自分の一番知っている動物に手を出したというのか？ふん、愛する動物を知るために、その動物たちに大きな被害を出したのでは本末転倒ではないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231428
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231428,
					"content": "やむを得なかったんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231429
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231429,
					"content": "これ以上言葉を弄するな！私はお前のたわごとなどに耳は貸さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231430
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231430,
					"content": "大ウソつきも、ついにお縄だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231431,
					"content": "ところでオルハン、なんで来るのがこんなに遅れたんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231432,
					"content": "ああ、それは…フェリットとパムークがなかなか帰ってこなくてな。探しに行っても見つからなくて、考えた挙句、一人で先にここに来たんだ。はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231433
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231433,
					"content": "でも、ぴったりのタイミングではなかったか？ほら、早く来るよりぴったり来た方がいい、というやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231434,
						730231435
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231434,
					"content": "頼りにならないな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				},
				{
					"id": 730231436,
					"content": "ふふ…なんだ。エルマイト旅団の人間がたくさん待ち伏せしているのかと思ったら、あなた一人だけですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231437
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231437,
					"content": "捕まったフリをして後で逃げようと思いましたが…ふん、そんな必要もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231438
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231438,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231439,
					"content": "まさか、そのエルマイト旅団の一兵卒ごときで、私を捕まえられるとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231440
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231440,
					"content": "運が悪かったですね。今日はちょうど宝盗団との約束の取引の日でしてね、やつらが近くに潜んでいるんです。仲間を呼べるのはあなたたちだけではありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231441
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231441,
					"content": "さあ、そいつらを片付けておしまいなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231435,
					"content": "もう少し遅れてたら来る必要なかったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				}
			]
		},
		{
			"id": 7302316,
			"completionStepIds": [
				7302316
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302316",
							"2"
						],
						"stepId": 7302316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェリット",
					"パムーク",
					"パイモン",
					"オルハン",
					"シェフケット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "あなたたちは宝盗団をすべて片付けた。\\nそこへフェリットとパムークも駆けつけた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "ボス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "フェリット"
				},
				{
					"id": 730231603,
					"content": "すみません、来るのが少し遅れました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "パムーク"
				},
				{
					"id": 730231604,
					"content": "なにが少し遅れただよ。全部終わっちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231605,
					"content": "いやー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "フェリット"
				},
				{
					"id": 730231606,
					"content": "お前らどこへ行ってたんだ！探しても探しても…うわっ、全身酒臭い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231607,
					"content": "へへ、こいつは情報を流す最善の方法でして、酔ったフリをして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "フェリット"
				},
				{
					"id": 730231608,
					"content": "そして嘘の情報を流すんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "パムーク"
				},
				{
					"id": 730231609,
					"content": "完全に酔っぱらってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#お前ら…もし{NICKNAME}がいなければ、私は宝盗団にぶちのめされていたかもしれないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231611,
					"content": "#しかしまさか、{NICKNAME}がこんなにも簡単に宝盗団を全滅させるなんてなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231612,
					"content": "#当然だよ。{NICKNAME}はすごいんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231613,
					"content": "道理で、前にお前たちを止めようとした時、簡単に投げ飛ばされたわけだ。しかしこれは…私の想像をちょっと超えていたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231614,
					"content": "褒めすぎだって！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#さてシェフケット、お前が頼りにしていた宝盗団は私たち…いや{NICKNAME}に叩きのめされた。何か言いたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231617,
					"content": "わ、私が…こんなにも多くの動物たちを密猟したのは、実は子供のころのトラウマが原因なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231618,
					"content": "聞いてください…あれはまだ私が年端もゆかぬ少年だった頃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "シェフケット"
				},
				{
					"id": 730231619,
					"content": "そんな話、誰も聞かない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "よし、こいつを捕まえたから、お前たちが唆されて暝彩鳥を狩ったことは帳消しだ。次はちゃんと信じる相手を選ぶんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231622,
					"content": "最初から私の話を聞いていれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231623,
					"content": "なんだよ。あの時はおまえがすぐ攻撃してきたんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231624,
					"content": "む、そうだったな…私も焦りすぎた。次からはもう少し冷静になろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231625,
					"content": "まあ、次がないことを祈るがな。お前たちも気を付けろよ。人の言うことを何でも信じるんじゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "オルハン"
				},
				{
					"id": 730231626,
					"content": "分かってるって！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "気を付けるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730231628,
					"content": "オルハンはシェフケットを押し立てて去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "作り話はやめて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231615,
					"content": "それ以上褒めると調子に乗っちゃうよ！",
					"roleType": "TALK_ROLE_PLAYER",
