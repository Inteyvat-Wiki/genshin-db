				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "「星辰天君」様を見たか？本当に神々しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000402,
					"content": "これで父上の病もきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000403,
					"content": "「星辰天君」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "あんなものを見せられて疑う奴はいない。あれは正真正銘の仙人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000405,
					"content": "以前、寝たきりの父上のために薬を頂戴したことがあってな、「不卜廬」の物とはまるで違った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000406,
					"content": "薬から漂う淡い霧が何より仙術っぽかったね！霧氷花がついてたってのもあるかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000407,
					"content": "とにかく仙人の薬はすごいんだ、父上の病もきっと治る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "男性信者"
				},
				{
					"id": 111000408,
					"content": "父上の命と比べたら「星辰天君」様に捧げた骨董品なんて、安いものだろ…な！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "男性信者"
				}
			]
		},
		{
