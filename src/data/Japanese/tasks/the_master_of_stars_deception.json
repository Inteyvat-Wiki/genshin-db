					"女性信者"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "毎日が希望に満ち溢れている気がします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "女性信者"
				},
				{
					"id": 111000502,
					"content": "「星辰天君」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "あなた達も「星辰天君」様の「信者」ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "女性信者"
				},
				{
					"id": 111000504,
					"content": "婚約者が蒸発してから、毎日がつらくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "女性信者"
				},
				{
					"id": 111000505,
					"content": "「星辰天君」様の仙法を試したんです。彼の肖像画を燃やした灰を、日の出の瞬間海に吹き散らすんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "女性信者"
				},
				{
					"id": 111000506,
					"content": "そしたら、なんだか彼が私の所に帰ってきた気がしたんです。本当です！あれは絶対気のせいなんかじゃなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "女性信者"
				},
				{
					"id": 111000507,
					"content": "ですので、持参金を全て「星辰天君」様に捧げました。だって彼が夫を帰らせてくれていなかったら、こんなお金持ってても何の意味もありませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "女性信者"
				}
			]
		},
		{
