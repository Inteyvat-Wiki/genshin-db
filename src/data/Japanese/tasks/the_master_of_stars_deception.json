			"dialogs": [
				{
					"id": 111001001,
					"content": "こんにちは！オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111001002,
					"content": "礼には及ばぬ。魔を退治し世を救うは仙人の本分、言及する価値もなし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001003,
					"content": "おっと？君たちは見慣れない顔だね、吾輩はてっきり「信者」のものかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001004,
					"content": "通りすがりの旅人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#オイラはパイモン！こっちはオイラの仲間{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111001006,
					"content": "なるほど、では吾輩も名乗るのが礼儀であろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001010,
					"content": "ゴホンッ…吾輩は「掇星攫辰天君」、信者たちには「星辰天君」と呼ばれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001011,
					"content": "世を救うため下界に降りてきた。ここで会ったのも何かの縁、願いがあるなら吾輩に言ってみるがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001012,
					"content": "願い？おまえ…人の願いを叶えられるのか？オイラはてっきり璃月の仙人はケンカだけが取り柄かと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111001013,
					"content": "ハハッ、「天君」は「真君」よりも上の仙位だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001014,
					"content": "自分で自分を褒めるのは吾輩の信条に欠ける。信者に吾輩のことを聞いてから判断するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111001007,
					"content": "こっちも仙人の道を探している。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#オイラはパイモン！こっちはオイラの仲間{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111001009,
					"content": "同志であったか、では吾輩も名乗るのが礼儀であろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "掇星攫辰天君"
