					"商人信者"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "「星辰天君」様がいれば、千岩軍なんていなくてもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "商人信者"
				},
				{
					"id": 111000602,
					"content": "「星辰天君」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "私は商人なんだが、以前仕入れた商品が非常に高価なものでな、その時「星辰天君」様に同行を依頼したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "商人信者"
				},
				{
					"id": 111000604,
					"content": "「星辰天君」様が呪符を使ったおかげか、道中魔物の影も形もなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "商人信者"
				},
				{
					"id": 111000605,
					"content": "依頼費は確かに高かったが…「迎仙」も簡単なことではない、お前たち他国の人からしたら、理解しがたいものかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "商人信者"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
