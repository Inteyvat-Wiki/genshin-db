			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "この邪気まみれのやつら、普通のヒルチャールより厄介だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000302,
					"content": "おい、あっちを見ろ、人がたくさん集まってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000303,
					"content": "おお…あの仮面のやつ見たか？あいつの周りにいたヒルチャール、怯えて逃げてったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000304,
					"content": "もしかして「仙人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "魈と同じ仙人ってことか？言われてみれば…魈も同じような仮面をかぶってたことがあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000307,
					"content": "さっきのあいつの「やり方」、なんだか魈よりも仙人っぽかったぞ。話を聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000305,
					"content": "見た感じ「仙家法術」みたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
