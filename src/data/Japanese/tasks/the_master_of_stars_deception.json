			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"掇星攫辰天君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "どうだった？信者だから多少誇張してたとは思うが、全て本当のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000802,
					"content": "心理的なものばっかだったような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "ははは…君も冗談が好きだな。昔、偉大な仙人がいてな、「量子」と呼ばれていた彼の言葉にこんなものがある——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000804,
					"content": "「万物は全てにおいて繋がっており、『心理効果』とは『魂魄』と『結末』を結ぶ因縁…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000805,
					"content": "つまり彼らの願いはすでに、実現に向けて順調に進んでいる、分かったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000806,
					"content": "…さっぱり分からない。簡単に言うと、あいつらの願いは叶ったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000807,
					"content": "そういうこと、賢いな君は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000808,
					"content": "そういえば…もう一つ疑問が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000809,
					"content": "なんだい？言ってごらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000810,
					"content": "どうして仮面をかぶってるのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "吾輩は…世を渡り、善行で世を救う。面倒事が起きないよう、正体を隠してるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000815,
					"content": "なるほど、なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000816,
					"content": "では二人の願いを聞こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000817,
					"content": "家族の行方を知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "うん…それはきっと悲しい過去があったのだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000824,
					"content": "…いいだろう、その願い、叶えられなくもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000825,
					"content": "ただ、少し…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000826,
					"content": "少し…なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000827,
					"content": "仙道は「悟性」に従う、もし吾輩の意図が分からないのなら、願いを叶えることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000828,
					"content": "どうしよう、なに言ってるかさっぱり分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000829,
					"content": "どうやら何か見返りをあげないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "なるほど！仙人に助けてもらうにはそれなりの対価が必要だって、さっきの信者たちも言ってたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000832,
					"content": "でもオイラたち、あまりお金になるものは持ってないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000833,
					"content": "おまえは「神の目」すらないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000834,
					"content": "神の目を売る人はいないと思うけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "あっ！オイラたちで美味しいものを作ってやるのはどうだ？美食の誘惑に勝てる人はいないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000837,
					"content": "パイモンの世界ではね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "そうだ、美味しいのを作ろう！これなら絶対にいけるぜ、へへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000840,
					"content": "じゃあ早速「万文集舍」に行って、何か最新の流行レシピを探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000838,
					"content": "美味しいもの！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "そうだね、残念だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "どうやらモラをあげないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "神に匹敵する力がほしい。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "力を持てば、様々なことを解決できる。しかし吾輩が気になるのは、なぜ神にこだわるかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000821,
					"content": "大金持ちになりたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#えぇ！おまえの{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}はいいのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000823,
					"content": "ふむ、それも人の性。見た所璃月の民でもないようだが、璃月のモラへの欲望が移ったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "掇星攫辰天君"
				},
				{
					"id": 111000811,
					"content": "仮面をとってくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "おい！失礼じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000813,
					"content": "はは、これには事情があってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "掇星攫辰天君"
				}
			]
