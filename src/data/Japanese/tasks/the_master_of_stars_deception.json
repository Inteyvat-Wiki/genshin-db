					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#オイラの気のせいか？{NICKNAME}…あのヒルチャールなんだか変だぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000102,
					"content": "体から…邪気が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "これまで見てきたヒルチャールも魔物ではあるけど、あんなの見たことない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000106,
					"content": "あっ！この辺りって「望舒旅館」の近くだよな、お客さんに被害が出たら大変だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000107,
					"content": "#見た以上放っておくこともできないし…退治しよう、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111000104,
					"content": "そわそわしている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "うーん、まさかあいつの体から出てる黒くて怪しいもやもやのせいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
