			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴニエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "百三十六…よし、あと十四回で、休めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230202,
					"content": "何か手伝う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "助け？いやいや、結構だ。鍛錬するのに人の助けを借りるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230204,
					"content": "鍛錬して強くたくましい体と精神を手に入れれば、長官のように不滅の軍団に加わり、栄誉ある兵士になれるのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230205,
					"content": "…………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230206,
					"content": "おっと、紹介を忘れていたな。この方が私の教官だ。彼の試験に合格すれば、晴れて抜擢してもらえることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230207,
					"content": "これって彫像じゃないの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "民よ、何を言っているのだ？レムリア人はみなこのような姿をしているではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230209,
					"content": "どうだ、試してみるか？この石柱を同時に壊すことができれば、最初の試験は合格だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230213,
					"content": "この石柱を甘く見ないほうがいいぞ。これだけ鍛錬を続けている私でも、拳一つで破壊できるのは石柱一本だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230210,
					"content": "試験ってどんな試験？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "もちろん戦闘試験だ。たとえ抜擢されて不滅の身体を手に入れたとしても、戦闘の技能は自己鍛錬を通してしか習得できないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230212,
					"content": "どうだ、試してみるか？この石柱を同時に壊すことができれば、最初の試験は合格だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "ヴニエ"
				}
			]
		},
