					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230402,
					"content": "君はすごいな。もしかして、過去に神王の軍団にいたことがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230403,
					"content": "…………",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "ヴニエ"
				},
				{
					"id": 742230404,
					"content": "長官も君のことを絶賛している…私もまだまだ鍛錬せねばな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴニエ"
				}
			]
		},
