			"dialogs": [
				{
					"id": 761910301,
					"content": "本当に銀色のカピバラなんだ。染色でも見間違いでもないし…すごく珍しいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910302,
					"content": "一生懸命ナタを探しても見つからなかったけど、まさか密輸業者に捕まっていたなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910303,
					"content": "でも、怪我はないみたい…へへっ、銀色のカピバラが、まさかこの目で見られるとはね。ちょっと触ってもいいかな、普通の個体との違いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910304,
					"content": "…熱っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910305,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 761910306,
					"content": "忘れるところだったよ、君は鍋の中にいるんだよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910307,
					"content": "もしかして、ナタの液体燃素に慣れてるおかげで、これくらいの温度は平気なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910308,
					"content": "とにかく、私と一緒に戻りましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910309,
					"content": "♪～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カピバラ"
				}
			]
