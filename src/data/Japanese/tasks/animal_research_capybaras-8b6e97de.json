			"dialogs": [
				{
					"id": 761910201,
					"content": "何度も言っただろ、目をかっ開いてしっかり見張っとけって！これはとっておきの極上品で、スネージナヤ・グラードのお得意様直々の依頼なんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910202,
					"content": "お前ときたら、俺の下についてから、急に改心でもしたのか？情けをかけて、逃がしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910203,
					"content": "兄貴、話を聞いてくれよ！俺のせいじゃねぇんだ、あのヒルチャールが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "イェーロ"
				},
				{
					"id": 761910204,
					"content": "ヒルチャールだぁ？よくそんな言い訳ができたもんだな！俺たち宝盗団の面子を潰す気か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910205,
					"content": "勝てないんだ、兄貴、マジで勝てないんだよ！あの青いのと緑のやつら、デットエージェントより容赦ないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "イェーロ"
				},
				{
					"id": 761910206,
					"content": "（この二人が密輸業者みたい…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910207,
					"content": "…そこにいるのは誰だ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910208,
					"content": "ちょっと、ルミったら！まだ出番じゃないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910209,
					"content": "何だ？…こいつはまた、随分と珍しいのが出てきたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910210,
					"content": "おい、小娘が相手ならお前でも勝てるだろ？あれも十分レアものだ、代わりの品にするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "アイホマ"
				},
				{
					"id": 761910211,
					"content": "へい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "イェーロ"
				},
				{
					"id": 761910212,
					"content": "ルミにまで手を出すなんて！あなたたちのような人が、宝盗団の名声を汚してるんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761910213,
					"content": "えっ、宝盗団に名声なんてあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "イェーロ"
				},
				{
					"id": 761910214,
					"content": "余計な話をすんじゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイホマ"
				}
			]
		},
