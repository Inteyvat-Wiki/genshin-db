			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フリーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705320101,
					"content": "うーん…このカードも入れて…あれ？何枚か余ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320102
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320102,
					"content": "あっ、旅人！ごめんなさい、デッキのことを考えてて、あなたがいるのに気付かなかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320103
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320103,
					"content": "私は「召喚王グランプリ」の開催を手伝うよう、冒険者協会から依頼された冒険者なの。担当しているのは…えっと…特殊なルールを採用したカード対戦でね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320104
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320104,
					"content": "私たちはこれを「ゼロ·アワー召喚」って名付けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320105,
						705320106
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320105,
					"content": "結局は普通のカードゲームなんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				},
				{
					"id": 705320107,
					"content": "いえいえ、「ゼロ·アワー召喚」は民間で開催している大会なの。特別なルールがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320108
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320108,
					"content": "簡単に説明すると、参加者は事前に組んだデッキじゃなくて、こっちが用意した八つの不完全なデッキから三つ選んで、対戦に使うデッキを構築して参加するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320109
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320109,
					"content": "この三つのデッキの中には、新しく追加されたばかりのカードもあるよ。どう使うかは…うん、あなたの腕次第だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320110
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320110,
					"content": "あとは通常の対戦とルールは変わらないから安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320111
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320111,
					"content": "デッキを組むのにいいアイデアが思い浮かばない場合は、こっちで組んであげてもいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320112
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320112,
					"content": "そのデッキが使えるかどうかは…ふふっ、保証はできないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320113
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320113,
					"content": "とにかく、自分で選んでデッキを組むのをお勧めするよ。だって、あなたはそのデッキを使って、他の人と対戦するんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320114
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320114,
					"content": "腕に自信があるなら、他の「召喚王グランプリ」開催エリアでも、引き続き「ゼロ·アワー召喚」に参加できるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320115
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320115,
					"content": "あっ、もちろん妙なプレッシャーとかは感じなくて大丈夫。「ゼロ·アワー召喚」は参加するだけで、対戦の結果を問わずに素敵な報酬がもらえるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320116
					],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320116,
					"content": "それじゃあ旅人、興味があったらぜひ参加してみてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーダ"
				},
				{
					"id": 705320106,
					"content": "「召喚王グランプリ」と同じっぽいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				}
			]
		}
	]
}