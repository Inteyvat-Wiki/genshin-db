					"好奇心旺盛なパチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "冒険に完璧なプランはありえない！これ以上ぐずぐずして、いつになったら進展を得られる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410102,
					"content": "完璧なプランがなくても、万全な準備は必要だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200410103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "私は古代遺跡を研究する学者で、千風の神殿を考察したいんだけど、戦いはあまり得意じゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410105,
					"content": "ドゥーランさん、自分は冒険者だから、神殿調査の任務を全部担当するって言ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410106,
					"content": "ドゥーランさんが悪いって言ってるわけじゃないし、あの遺跡守衛が厄介なのも分かる。だけど、彼は打ち合わせと称して、ただ私を引き留めたいだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410107,
					"content": "研究、調査、調整、そしてまた調査、研究、調整…もう耐えられないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410108,
					"content": "さっきまた新たな手がかりを見つけたらしく、神殿の横に怪物の拠点があるって言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410109,
					"content": "お願い！怪物の拠点を一掃してきてほしい！神殿に入ることができなくても、せめて彼の口を塞いでおきたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410110,
					"content": "わ、分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "代わりにドゥーランと打ち合わせしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "気遣いありがとう、でもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200410113,
					"content": "そんな打ち合わせより、魔物退治のほうがずっと楽よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "好奇心旺盛なパチ"
				}
			]
		},
