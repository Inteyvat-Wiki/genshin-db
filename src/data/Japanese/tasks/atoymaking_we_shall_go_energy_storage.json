				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "バートランド！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME}とパイモンか。ちょうどいいところに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950103,
					"content": "俺が発明した唯一無二のマシン…「大工機」が、君の集めた素材を処理し終えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950104,
					"content": "結果はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "この俺が作ったマシンだ、問題はない！こう見えて、フォンテーヌでしっかりと腕を磨いてきたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950106,
					"content": "俺もれっきとしたフォンテーヌ人だ。精密機械を作るのと操作する点において、俺たち以上に詳しい者などこの世にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950107,
					"content": "前回は、ちょっと慌ててただけなんだ。それに、試運転の材料を集めてくれる人もいなかった。だから爆発した。だが、今回は違う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950108,
					"content": "そ、そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950109,
					"content": "もし今回のおもちゃまで爆発したら、俺の残された貯金と人生も爆発することになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950110,
					"content": "俺のことは信じなくてもいい。だが、残りの人生を賭けた俺の覚悟だけは信じてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950111,
					"content": "オイラ、おもちゃの製造がこんなに覚悟のいる仕事だと思わなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950112,
					"content": "さあ、次の工程に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950113,
					"content": "だがその前に質問しよう。三つの工程のうち、すでに終わっているのは「原材料収集」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950114,
					"content": "では、次に行うのは「コア収集」と「チャージ収集」、どっちだと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950115,
					"content": "「コア収集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "おめでとう…と言いたところだが不正解だ。もし本当にコアを収集していたら、俺の人生を破滅に導いた功績は、君のものになっていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950117,
					"content": "正解は、「元素チャージ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950121,
					"content": "とにかく…「元素チャージ」を行うには、「素材収集器」を持って元素の影響を受け続ける必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950122,
					"content": "例えば、水元素を収集したければ、「素材収集器」を持ったまま川に一定時間いればいい。雷元素を収集したければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950123,
					"content": "雷に打たれればいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950124,
					"content": "そう、君たちは冒険者だからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950125,
					"content": "冒険者の強靱さを信じているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950126,
					"content": "信じてるって強靱さのことだったの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "本当のことを言うと、元素生物に触れるのがもっとも良い方法なんだ。以前、稲妻を旅した時に、元素生物がよく出没する場所を三つほど調べておいた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950128,
					"content": "もし助手が見つからなかったら、自分でこっそりそこに行って、元素生物に触れるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950129,
					"content": "それはさすがに危険だと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950130,
					"content": "でも、今は君たちがいる。そこに行って、元素生物を探してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950131,
					"content": "「元素チャージ」は任せたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950118,
					"content": "「チャージ収集」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "ふははっ、惜しいな。正しくは「チャージ収集」ではなく「元素チャージ」だ。まさか、どっちも不正解だなんて思わなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950120,
					"content": "ムカつく笑い方だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
