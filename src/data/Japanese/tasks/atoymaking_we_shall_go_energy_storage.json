			"dialogs": [
				{
					"id": 726950201,
					"content": "ふむ…素材収集器の工程を終えるたびに素材を取り込まなければならないとしたら、一回の製造で三往復することになる。それだと、素材集めに手間がかかりすぎてしまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950202,
					"content": "改善する方法を考えなくては。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バートランド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "どうだ、素材収集器の動作は問題ないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950302,
					"content": "全然問題なし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "この「素材収集器」は俺の自信作なんだ。この前みたいに原材料を収集するだけでなく、今回のように元素力を蓄えることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950304,
					"content": "実は、この「素材収集器」の名前を変えようと思ってるんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950305,
					"content": "「素材収集器」でいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726950306,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "そうか、ちょっとオシャレさに欠けると思ったんだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950309,
					"content": "まあいい。「素材収集器」を俺に渡してくれ。今回も試作工程には観察が必要だ。元素力に関わることは特にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950310,
					"content": "おそらく、「大工機」にある元素反応が安定してからでないと、次の工程には進めないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950311,
					"content": "その時になったら、また頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726950307,
					"content": "一番合ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}