			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "よっ！そこの金髪の異郷人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820102,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "うむ…その金髪、見覚えがある…まさか君は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820105,
					"content": "そうだ！前回の「百人一揆」で大活躍した「黄金の旋風」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820106,
					"content": "黄、黄金の旋風…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "前回は、会場の片隅で参加者を眺めながら、一番盛り上がるシーンを撮ろうと思っていた。そして君は草刈りの黄金の旋風のように、すべての敵を一掃した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820108,
					"content": "お世辞はいいから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "実は最近、「百人一揆」を開催してる連中がまた現れたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820114,
					"content": "「百人一揆」ってなんだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "爽快な戦いを通して、慶祝をしたり、不運を取り除いたりする乱闘大会だ。武士も魔物も、身分を問わず、純粋なる熱血で戦いを繰り広げる祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820116,
					"content": "勝ち残った勝者は、さまざまな宝物を獲得できるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820117,
					"content": "主催者や後援者は誰なのかは、まだ謎のままだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820119,
					"content": "とにかく、こういうことは公で話してはいけない。ついて来てくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820118,
					"content": "なるほど、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "…もっと褒めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "コホッコホッツ…「もしも剣豪に匹敵する動体視力を持つ観客がいたならば、すぐに分かっただろう。金髪の異邦人が繰り出した術は、古武術の中でも禁術とされている、『ゴウランガ大竜巻』であると！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820111,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "これは、君の勇姿を参考にして書いた物語だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820103,
					"content": "何か依頼があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268202",
							"2"
						],
						"stepId": 7268202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "着いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820202,
					"content": "この怪しそうな扉の中に入れば、今回の会場だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820203,
					"content": "興奮してきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "今回のルールも前回とほとんど同じだ。そして世界各地から、戦いに飢える魔物、冒険者、戦士たちが舞台で大いに力を振るう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820206,
					"content": "この前と同じように、君も志を共にした仲間や戦友と参戦してみるといい。なんと言っても「百人」だから、人が多いほどいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820207,
					"content": "期待してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820208,
					"content": "今回も参加しないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "俺か？俺は傍観者の身分で、君を応援するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820210,
					"content": "俺の目的は面白い格闘系小説を書くことで、君みたいな眩しい戦士になる訳じゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820211,
					"content": "そして、君こそが格闘場で最も輝く星だと、俺の直感が教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820212,
					"content": "がんばる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "ああ。今回も必ず眩しい剣の舞を披露してくれると信じてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726820213,
					"content": "期待して見てて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "面倒くさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}