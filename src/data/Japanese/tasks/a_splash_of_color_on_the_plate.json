			"dialogs": [
				{
					"id": 756730101,
					"content": "カラーリストのアシャは満足してくれたみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730102,
					"content": "オレたち、変わったアシャを助けて、また一つ挑戦を達成できたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730103,
					"content": "絵の具集め大成功だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730104,
					"content": "アシャのやつ、もうなにかひらめいたのか？今すぐにでも描きたそうにしてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730105,
					"content": "ひらめきは湧くのも消えるのも一瞬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#あっ、自分で集めた宝物も結構残してたのか…これは全部{NICKNAME}とパイモンへのお礼にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730108,
					"content": "今度来た時は、カラーリストのアシャの新しい傑作が見られるかもしれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730109,
					"content": "普通のアシャでもすごく綺麗な色を出せるんだから、特別なアシャなら…うーん、想像もつかないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730110,
					"content": "どんな色を生み出すのか、楽しみになってきたぞ…普通の言葉じゃ言い表せないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730111,
					"content": "燃素とか、月とか、星空の奥深くの色…って感じか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730112,
					"content": "ああ、かもしれないな！これからも冒険の途中で困ってるやつを見かけたら、全力で助けてやらないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730113,
					"content": "そうだな！いつか、思いがけないお返しがあるかもしれないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756730114,
					"content": "#{M#俺}{F#私}もベネットに賛成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "あ、でも…見返り目当てで助けるんじゃ、本末転倒か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730117,
					"content": "たとえ報酬がなくてもトラブルを解決して、困ってた友達が喜んでる姿を見て、物事がいい方向に進むのを見届ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730118,
					"content": "オレ、この感じが大好きだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベネット"
				},
				{
					"id": 756730115,
					"content": "とても満たされた気分になるよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "一番冴えてる時を逃したくないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}