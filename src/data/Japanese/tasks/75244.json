			"dialogs": [
				{
					"id": 752440302,
					"content": "そうだ…！本当にありがとう。こいつがあれば、安心して釣りができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440303,
					"content": "これは俺が特別にあつらえてもらったヘルメットだ。銃弾も防げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440307,
					"content": "考えすぎだよ。ただの釣りでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "前に岸辺で釣りをしていた人が、遠くから矢や銃のようなもので目を撃ち抜かれたことがあったんだ。危ないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440305,
					"content": "なんでもナド・クライからやってきた盗賊の内輪もめだったとか…まあ分からないが。そういう前例がある以上、俺たちも用心するに越したことはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "ルエンティ"
				}
			]
		},
