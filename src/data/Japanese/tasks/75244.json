			"dialogs": [
				{
					"id": 752440101,
					"content": "よう、あんたも釣りに来たのか？釣りをするなら、頑丈な帽子をかぶれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440106,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "じゃないと危ないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440107,
					"content": "#でも{M#君}{F#あなた}はかぶってないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "それが理由で話しかけたんだ…俺のは風に吹き飛ばされてしまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440104,
					"content": "悪いが、探すのを手伝ってもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440108,
					"content": "なんで自分で探しに行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "自分で探しに行くには、釣り竿を置かなきゃならん。釣り竿を持っていたら、探しに行けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "ルエンティ"
				},
				{
					"id": 752440109,
					"content": "だから頼むよ、助けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルエンティ"
				}
			]
		},
