			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "また隠れてんのか？この辺にはなにもないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 748000402,
					"content": "あそこに警備ロボがいるでしょう？ほら、すぐそこに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000403,
					"content": "あれが…どうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "しーっ、急いで逃げないと。ほ、ほら、だって警備ロボが暴走したらどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000406,
					"content": "それか…あれのエネルギーコアが急に爆発したり、遠隔操作で攻撃してきたりするかもしれないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000407,
					"content": "でも、まったく問題なさそうだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "だ、だから怖いのよ。正常な装置が突然暴走して、罪もない人が巻き込まれるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000409,
					"content": "もしそうなったとしても、誰も責任は取ってくれない。首謀者すら見つからない可能性だってある…そんなの危なすぎるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000410,
					"content": "もうどっか行ったから、隠れなくて大丈夫だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 748000411,
					"content": "あれ？暴走は…しなかったの？意外ね…また命拾いしたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000412,
					"content": "そんな事件、起こるわけわけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "私ね、「ただの事故に見せかけた、犯罪トリック」についてアイデアを考えてるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000415,
					"content": "あ、待って。首謀者が見つからず…誰も個人では責任を負えない事件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000416,
					"content": "あっ！アイデアが湧いてきたわ。早く、カフェに急ぎましょう。忘れないうちにメモしないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000417,
					"content": "ちょっと待てって！急に誰かに石を投げられて、転んじゃうかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 748000413,
					"content": "暴走する可能性なんて元からないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "えっと…それで？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
