			"dialogs": [
				{
					"id": 748000501,
					"content": "そうね…ここはこうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000502,
					"content": "コーヒーが冷めちゃうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "こっちはもう全部飲み終わったけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#うん、ここまで送ってくれて助かったわ。ありがとう、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000505,
					"content": "送ったって言っても…実際はおまえの後ろを歩いただけで、なんにもしてないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 748000506,
					"content": "悪いことは何も起きてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "#{M#君}{F#あなた}も危険な目には遭わなかったよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "そうね、私の考えすぎだったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000509,
					"content": "このコーヒー、おいしいわ、はは…は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000510,
					"content": "…ねえ、誰かに毒を盛られたりしてないわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000511,
					"content": "…コホンッ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "少し、考えることから離れようか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "ったく、なんだよそれ。オイラたち全部飲んだけど、ぴんぴんしてるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 748000514,
					"content": "ううん、多分…毒の盛り方が特別なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000515,
					"content": "犯人はまず、私たちのコーヒーに一つ目の毒を入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000516,
					"content": "その薬だけなら、飲んでも体には一切影響が出ないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000517,
					"content": "で、その薬を全部飲んだ私たちがここを出て帰宅するとき、犯人が密かにあとをつけてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000518,
					"content": "私たちが寝た隙に部屋に忍び込み、水筒に二番目の薬を入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000519,
					"content": "次の日に持って出た水筒の中身を私たちが飲むと、二つの薬が相互作用を起こすんだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000520,
					"content": "そうしたら、私たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "ギハーロ"
				},
				{
					"id": 748000599,
					"content": "突然、早足で誰かが近づいてきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "いったい何の話をしてるんだ、お客さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 748000522,
					"content": "コーヒー？毒？私の店でそういった冗談はやめてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 748000523,
					"content": "他のお客さんに迷惑をかけたら、出て行ってもらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 748000524,
					"content": "店主、説明させて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "#彼女は{M#俺}{F#私}の友達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "アルエにギハーロのことを話した。聞き終えた店主は、呆れた感じで離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
