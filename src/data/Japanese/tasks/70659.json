					"ガイガックス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "こんにちは、「風の行方」を試してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590102,
					"content": "「風の行方」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "いい質問だ。「風の行方」はモンドの歴史が詰まったゲームのことなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590104,
					"content": "モンド城には昔、「貴族」がいたことは君も知ってるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590105,
					"content": "彼らはモンド城で横暴を繰り返し、多くの人を苦しめた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590106,
					"content": "そんな貴族たちの横暴に抵抗するために、勇敢なモンド人たちが集まり、秘密の反抗組織を形成したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590107,
					"content": "その勇敢な者たちはモンドで活動を続け、貴族たちを手こずらせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590108,
					"content": "しかし、貴族たちもすぐさまその者らを鎮圧するための手先を訓練した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590109,
					"content": "こうして、反抗組織と貴族たちの決闘がモンド各地で繰り広げられたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590110,
					"content": "「風の行方」は、そんな壮大な歴史に基づいて作られたゲームなんだ！昔はとても人気があったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590111,
					"content": "昔は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "ああ、最近の若者たちはもう「風の行方」に興味ないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590113,
					"content": "でもこのまま「風の行方」が廃れていくのは嫌なんだ。だから、元のルールを少し改編して、よりわかりやすく面白くした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590114,
					"content": "それ以外にも、新しいゲームマップを用意した。これならもっと多くの人に興味を持ってもらえるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				}
			]
		},
		{
