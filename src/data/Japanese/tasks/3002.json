				"points": []
			},
			"dialogs": [
				{
					"id": 30020301,
					"content": "サウマラタ蓮はこの近くに生えてるはず。手分けして探そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020302
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020302,
					"content": "君たちは四つ採ってきてくれたらいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020303
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020303,
					"content": "充分な薬草が採れたら、この近くで落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
