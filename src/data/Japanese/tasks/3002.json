			"dialogs": [
				{
					"id": 30020701,
					"content": "それにオイラたち、実は前にも同じような状況の人に手を貸したことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020702
