	"talks": [
		{
			"id": 300201,
			"completionStepIds": [
				300201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300201",
							"2"
						],
						"stepId": 300201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020101,
					"content": "君たちか、ちょうど探しに行こうとしてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020102
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020102,
					"content": "あれ、ティナリがなんでここにいるんだ？コレイは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020103,
					"content": "コレイの様子を見に来たんだ。簡単に言えば、病気になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020104
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020104,
					"content": "病気？まさか…あっ。ひょっとして、昨日のオイラのせいなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020105,
					"content": "心配しなくていい。おちびちゃんがここまで深刻な事態を引き起こすことはできないよ。これはコレイの持病なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020106
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020106,
					"content": "まあ実を言えば、確かに君たちが来たこの数日、コレイは興奮しすぎて自分の体の状況に気付かなかったっていうのもあるけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020107
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020107,
					"content": "はぁ…無理もない。何しろ、コレイはもう長いこと友達に会っていなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020108
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020108,
					"content": "ティナリ、コレイはいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020109,
					"content": "場所を変えようか。彼女は薬を飲んで寝たばかりだから、静かに休ませてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 300202,
			"completionStepIds": [
				300203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300203",
							"2"
						],
						"stepId": 300203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020201,
					"content": "さあ、さっきの話の続きをしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020202
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020202,
					"content": "実は、君がいわゆるモンドの栄誉騎士だってことは、さっきコレイが話してくれた。璃月と稲妻での正義感ある行動についてもちょっとは知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020203
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020203,
					"content": "でも、先に言っておくけど、コレイに関することを君たちに教えるのは、君たちの身分や経験とはまったく関係ない。理由は一つ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020204
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020204,
					"content": "コレイに頼まれたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020205
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020205,
					"content": "正直言うと、コレイの過去を君たちに教えるのには賛成できないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020206
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020206,
					"content": "コレイ曰く、君たちが友達として誠実に接してくれたから、コレイも同じように君たちに接するべきなんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020207
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020207,
					"content": "ティナリ、コレイはなんの病気にかかってるんだ？「持病」って言ってたけど、まさかずっと前から病気だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020208,
					"content": "そうだ。コレイはまだ小さい頃に、「魔鱗病」という病を患ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020209
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020209,
					"content": "「魔鱗病」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020210,
					"content": "これはスメール特有の疾患でね。患者の体に灰色がかった黒いウロコ状組織が現れることから、その名が付けられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020211
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020211,
					"content": "最初は皮膚が変化した部分に少ししびれを感じる程度なんだけど、症状が進行すると手足の指に力が入らなくなり、時には感覚がなくなることもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020212
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020212,
					"content": "そして段々患者は自分の体を制御できなくなり、やがては完全に動けなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020213
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020213,
					"content": "それ、けっこう怖くないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020214,
					"content": "「自分の体を制御できない」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020215
					]
				},
				{
					"id": 30020215,
					"content": "待った、まさかこの間コレイがうっかりしたのも、原因は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020216,
					"content": "うん、魔鱗病の影響だよ。だからコレイにはなるべくものを持たせず、自分を傷つけさせないようにしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020217
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020217,
					"content": "その疾患って治るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020218
					]
				},
				{
					"id": 30020218,
					"content": "適切な治療方法をとれば、病気の進行を効果的に抑制することはできるよ。でも、残念だけど魔鱗病を完治させる方法はまだない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020219
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020219,
					"content": "だけど、昔コレイの母親に「魔鱗病」を根治できる方法があるって嘘をついて、コレイを「ファデュイ」って組織に引き渡した人物がいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020220
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020220,
					"content": "なに、ファデュイだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020221,
					"content": "ファデュイを知ってるんだね。説明する手間が省けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020222
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020222,
					"content": "とにかく、コレイを僕に預けた人が言うには、彼女はファトゥスの「博士」という人のところに送られたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020223
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020223,
					"content": "そいつがどんな治療方法をとったのかは知らないけど、彼女の魔鱗病はその時、確かに抑えられてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020224
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020224,
					"content": "だけどファデュイのところで過ごした日々は、彼女にとって決して愉快な思い出じゃなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020225
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020225,
					"content": "彼女は強い。ずっと楽観的に振る舞ってるけど、未だに人から触れられたとき、恐怖を感じてしまうことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020226
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020226,
					"content": "コレイはずっと、たくさんの苦しみに耐えてきたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020227,
					"content": "そうだパイモン、コレイからの伝言がある。昨日君を驚かせたことを謝りたいらしい。それから、「ごめんなさい、ずっと病気のことを黙ってて」とも言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020228
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020228,
					"content": "コレイはなんにも悪いことしてないじゃないか。謝る必要なんかないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020229,
					"content": "うん。その言葉は、次コレイに会うとき自分で伝えてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020230
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020230,
					"content": "彼女は、自分には友情を得る資格がないって思い込んでた。僕の弟子に二度と同じような苦しみを与えないであげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020231
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020231,
					"content": "おう、ティナリ。任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020232,
					"content": "コレイは大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020233
					]
				},
				{
					"id": 30020233,
					"content": "まあ、ひどくはないよ。今回倒れたのはここ数日、体力の消耗が激しかったからだ。薬も飲ませたし、ちょっと休めば治ると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020234
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020234,
					"content": "でも、コレイがガンダルヴァー村に来た当初は、確かに今よりずっとマシだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020235
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020235,
					"content": "あの時、彼女はレンジャーの仕事に興味津々でさ、知識も学びたがってた。だから加わってもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020236
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020236,
					"content": "でも最近は体力がかなり落ちてきてる。適度な運動はずっと必要だけど、やっぱり長距離の巡回はもう、やめておいた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020237
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020237,
					"content": "さあ、これでコレイの状況はもう全部説明したよ。これから彼女の薬草を採りに行かなくちゃいけないから、話はここまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020238
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020238,
					"content": "#{M#俺}{F#私}たちも一緒に行っていい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020239
					]
				},
				{
					"id": 30020239,
					"content": "連れて行ってくれ、ティナリ。オイラたちもコレイのためになにかしたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020240,
					"content": "…まあいっか。だけど雨林は危険だし、旅人も療養中なんだから、道中は僕の指示通りに動いてね。いい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020241
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020241,
					"content": "ああ、わかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020242,
					"content": "じゃあ行こう。採りに行くのは、「サウマラタ蓮」って植物だ。魔鱗病患者の体力を回復してくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 300203,
			"completionStepIds": [
