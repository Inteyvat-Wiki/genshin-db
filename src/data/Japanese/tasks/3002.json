			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アミル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020501,
					"content": "まさかここで会えるとは。ガンダルヴァー村に帰って、ティナリさんを探そうとしていたところだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020502
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020502,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020503
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020503,
					"content": "ついさっき、「死域」を見つけたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020504
					],
					"speakerTitle": "ナスリン"
				},
				{
					"id": 30020504,
					"content": "「死域」？君たちのルートは一週間前に徹底して片づけたばかりなのに、こんなに早く現れるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020505
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020505,
					"content": "具体的な場所は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020506
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020506,
					"content": "すぐ先にある谷の奥だ。今回出現した場所は、河谷の狭いエリアをほぼ塞いでたから、すぐ戻ってティナリさんを探すことにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020507
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020507,
					"content": "半径は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020508
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020508,
					"content": "すまない、そこまではよく見えなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020509
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020509,
					"content": "今日はチームに神の目を持ってる人がいなかったし、死域はまだ拡張し続けてるみたいだったので、あまり近づかなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020510
					],
					"speakerTitle": "ナスリン"
				},
				{
					"id": 30020510,
					"content": "うん、その判断は正しい。今すぐ片付けに行くから、君たちはこの二人をガンダルヴァー村まで連れて戻ってあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020511
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020511,
					"content": "待てよ、ティナリ。なんでいきなりオイラたちを帰らせるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020512,
					"content": "ああ、スメールに来たばかりじゃ、この状況も分からないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020513
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020513,
					"content": "スメールの雨林では今、一部エリアに独特な異変が起きてるんだ。そのエリアを「死域」と呼んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020514
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020514,
					"content": "「死域」は植物を枯らすだけじゃなく、動物や人の命まで奪う可能性がある。だから神の目がない者は、近づいちゃだめだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020515
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020515,
					"content": "そういうことなんだ。この前、雨林には危険なエリアが存在すると言ったのも、君たちを脅かすためじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020516
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020516,
					"content": "神の目を持つ者——つまり元素力を操れる者だけが、一定時間死域の侵蝕に耐えられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020517
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020517,
					"content": "そう、だから俺たちみたいな一般レンジャーはただ死域を見つけ、位置を記録してティナリさんのようなプロに任せるのが仕事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020518
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020518,
					"content": "何しろ、死域の内部に足を踏み入れ、死域を除去できるのはティナリさんたちだけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020519,
						30020520
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020519,
					"content": "#{M#俺}{F#私}も役に立てるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				},
				{
					"id": 30020521,
					"content": "でも、神の目を持ってないみたいだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020522
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020522,
					"content": "安心しろ、こいつは確かに神の目を持ってないけど、元素力を使うことに関してはベテランと言っても過言じゃないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020520,
					"content": "#{M#俺}{F#私}も元素力を使える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020521
					]
				}
			]
		},
