			},
			"dialogs": [
				{
					"id": 30020801,
					"content": "ストップ、もう進んじゃ駄目。前を見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020802
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020802,
					"content": "前…あっ、あそこらへんが灰色で、植物も枯れてるみたいだ。空気にも、灰のようなものが漂ってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020803,
					"content": "うう、鳥肌が立ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020804,
					"content": "それが「死域」さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020805
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020805,
					"content": "旅人、僕はこれから死域の内部に入る。中には死域の「病変」があって、それを破壊できれば、このエリアを救えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020806
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020806,
					"content": "#{M#俺}{F#私}も一緒だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020807
					]
				},
				{
					"id": 30020807,
					"content": "ありがとう。でも、君はこれを処理したことがないし、無理だけはしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020808
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020808,
					"content": "元素力を持っていたとしても、中に入るときっと気持ち悪くなる。もし耐えきれなかったら、外に出て休んでて。何しろ、これは命にかかわるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020809
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020809,
					"content": "さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
