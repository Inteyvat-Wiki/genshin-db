							"300209",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020901,
					"content": "あっ、見ろ！あそこらへんが灰色だ。やっぱり「死域」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020902,
					"content": "この前も見たけど、やっぱり鳥肌が立つぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020903,
					"content": "旅人、ここからは死域の内部に進むよ。死域を除去したことがあるんなら、やり方は知ってるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020904
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020904,
					"content": "でも、これだけは覚えておいて。無理はしないこと——もし耐えきれなかったら、外に出て休んでてほしい。何しろ、これは命にかかわるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020905
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020905,
					"content": "さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 300210,
			"completionStepIds": [
				300210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300210",
							"2"
						],
						"stepId": 300210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30021001,
					"content": "やったぜ、周りがまた緑に戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021002,
					"content": "君が助けてくれたおかげで、こんなにも早くここを正常に戻すことができたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021003
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021003,
					"content": "ティナリ、そう言ってるけど、なんだか冴えない顔だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021004,
					"content": "えっ、そんなに分かりやすかった？はぁ…分かった、説明するよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021005
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021005,
					"content": "最近、死域の出現頻度がますます増えてきてさ。さっきみたいに死域を除去しても、間もなくまた新たな死域が現れちゃうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021006
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021006,
					"content": "僕の仕事が増えただけならまだ良かったんだけど、死域は雨林のあらゆるところに影響を及ぼしてるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021007
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021007,
					"content": "例えば、さっきはこのエリアを正常に戻したけど、だからと言ってエリア内の植物がみんな生き返るわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021008
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021008,
					"content": "実際、植物の数がかなり減ってる。この変化は植物に関わる動物たちにも影響を与えるだろう。結果、雨林の生態系が不安定になりつつあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021009
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021009,
					"content": "それに…死域の状況が深刻になり始めたことで、コレイの魔鱗病もどんどんひどくなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021010
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021010,
					"content": "えっ、なんでそうなるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021011,
					"content": "具体的な原因はまだ突き止めてない。でも数日前、教令院の知り合いから手紙をもらったんだけど、彼によれば、多くの患者たちも同じような状況らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021012
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021012,
					"content": "死域を根絶する方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021013
					]
				},
				{
					"id": 30021013,
					"content": "僕の知る限り、ないな。死域は数千年もの間、スメールに存在している。それに、死域はこの世界の深いところから生まれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021014
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021014,
					"content": "「世界樹」を知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021015,
						30021016
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021015,
					"content": "知らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021017
					]
				},
				{
					"id": 30021017,
					"content": "「世界樹」は僕たちが踏みしめているこの大地の奥深くにある。生物学的な意味の「樹」じゃないけどね。まあ、大きな樹が逆さに生えているとでも考えてもらえばいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021018
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021018,
					"content": "「地脈」は知ってるだろ。あれは「世界樹」の根みたいなもので、地下を縦横に走り、深くて広大な空洞から地表まで伸びてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021019
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021019,
					"content": "（広大な空洞を、縦横に走る…意識のない時に見たのと似てる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021020
					]
				},
				{
					"id": 30021020,
					"content": "「地脈」はこの世界の記憶を吸収し続け、「世界樹」には古代から現代に至る、世界のあらゆる情報と知恵が詰まっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021021
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021021,
					"content": "草神が「知恵の神」と呼ばれるのも、彼女の意識が世界樹と繋がっているからだ。草神の力は、世界樹の力の顕れとも言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021022
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021022,
					"content": "実は、死域が現れるのは、世界樹が病気になったからなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021023
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021023,
					"content": "世界樹が病気になる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021024
					]
				},
				{
					"id": 30021024,
					"content": "うん。遠い昔、僕の先祖はマハールッカデヴァータ様の眷属からこのことを聞いた。けど、その神秘的な聖霊たちも、世界樹の治療方法までは知らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021025
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021025,
					"content": "僕たちレンジャーは、恐らく長い間、死域に立ち向かわないといけないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021026
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021026,
					"content": "さあ、話はこのくらいにしておこう。もうやることも済ませたし、ガンダルヴァー村に戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021016,
					"content": "どこかで聞いたことあるような。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021017
					]
				}
			]
		},
		{
			"id": 300211,
			"completionStepIds": [
				300211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300211",
							"2"
						],
						"stepId": 300211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アミル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30021101,
					"content": "ティナリさん、おかえり。お疲れさま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021102
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30021102,
					"content": "君たちがこの前見つけた死域はもう片付けたから、安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021103
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021103,
					"content": "ん？それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021104
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021104,
					"content": "まずい、ハイパシアだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021105
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021105,
					"content": "ティナリ？いきなり駆け出して、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021106,
					"content": "この暝彩鳥は、ハイパシアの緊急メッセージを届ける鳥なんだ。ハイパシアって名前を覚えてる？君たちが前に会ったあの学者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021107
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021107,
					"content": "おう、あいつがどうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021108,
					"content": "手紙を読んでみるよ…あぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021109
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021109,
					"content": "急に変な顔してどうしたんだ？オイラにも見せてみろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021110,
					"content": "うぅ、曲がりくねった線が三本だけ描かれてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021111,
					"content": "説明するよ——あの日、ハイパシアのところから君をガンダルヴァー村に連れてきた後、彼女は再び瞑想し始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021112
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021112,
					"content": "そして彼女が目を覚ましたとき——つまりさっき。彼女は三日ほど何も口にしてなくて、食糧を用意するのも忘れてたから、早く助けてくれって書いてあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021113
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021113,
					"content": "ええっ、ずっとあそこに座ってたのか——って、それよりなんで三本の線からこんな多くの情報がわかるんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021114,
					"content": "こんなことが前にもあったからに決まってる。前回は五本の線だった！まあいいや…あの時のことは思い出したくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021115
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021115,
					"content": "ハイパシアはそれほどひどい状況じゃないはずだ。でも、早く様子を見に行った方がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021116
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021116,
					"content": "僕の非常食を、代わりに持って行ってあげてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021117
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021117,
					"content": "#えっ、オイラたちがか？でも、ハイパシアのところにはパラハァムがあるだろ。{NICKNAME}、また気を失ったりしないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021118,
					"content": "#{NICKNAME}、これを嗅いでみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021119
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021119,
					"content": "どう？感じは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021120,
						30021121
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021120,
					"content": "スッキリした香りだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021122
					]
				},
				{
					"id": 30021122,
					"content": "あれ？もう大丈夫なのか？本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021123,
					"content": "ティナリ、なんでこいつが治ったのを知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021124,
					"content": "#死域の片付けを手伝ってくれた時、{M#彼}{F#彼女}は草元素の能力をうまく扱えてただろ。だから大丈夫だって判断した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021125
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021125,
					"content": "君たちに世界樹の根についての話をした時、君はそれが「幻覚」とよく似てるって思っただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021126
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021126,
					"content": "#{M#俺}{F#私}が見たのは「幻覚」じゃない、でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021127
					]
				},
				{
					"id": 30021127,
					"content": "そう、あれは幻覚じゃない。けど、このあいだ嘘をついたことを謝るつもりはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021128
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021128,
					"content": "なぜなら、君が見えるものは、スメール、さらに全世界にとっても極めて重要なものだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021129
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021129,
					"content": "僕の先祖はマハールッカデヴァータ様から大いなる恩恵を受けた。僕たちは彼女と共に、この国を守ると誓ったんだ。だから、僕は君がスメールに信頼に値するかどうか、見極める責任があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021130
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021130,
					"content": "でも君の行動は、尊敬に値するものだった。だから、僕ももう君には秘密にしておく必要がないと判断したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021131
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021131,
					"content": "#{M#俺}{F#私}が見てたのは、一体何だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021132
					]
				},
				{
					"id": 30021132,
					"content": "実はあの時、君の意識は世界樹と繋がってた。君が見たのは世界樹の記憶だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021133
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021133,
					"content": "まあ、詳しくはハイパシアに聞いた方がいいよ。瞑想もパラハァムも、君と同じことをできるようにするためのものだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021134
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021134,
					"content": "けど、本当に答えてくれるのか？初めてあいつに会った時、オイラたちとは一言も話したくなさそうだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30021135,
					"content": "それは特殊な状態だったからだよ。修行中はなるべく他の人と話しちゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021136
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021136,
					"content": "ここでちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021137
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021137,
					"content": "ティナリがしばらく離れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30021138
					]
				},
				{
					"id": 30021138,
					"content": "はい、ハイパシアへの弁当。これで彼女を助けてあげて。それからこっちの食材も彼女のところにお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021139
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021139,
					"content": "この封筒は僕がハイパシアに書いた手紙だ。これを彼女に渡せば、君たちの疑問に全部答えてくれると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30021140
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021140,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021141
					]
				},
				{
					"id": 30021141,
					"content": "いいんだ。こちらこそ、この数日間は色々とありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30021121,
					"content": "気持ち悪い感じがしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30021122
					]
				}
			]
		},
