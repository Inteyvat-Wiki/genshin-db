				"points": []
			},
			"dialogs": [
				{
					"id": 30020401,
					"content": "ティナリ、これで任務完了だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020402,
					"content": "どれどれ…うん、なかなかいいね。よく選んでくれてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020403
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020403,
					"content": "君たちの豊富な野外探索経験のおかげで、時間を節約できた。おかげでついでに他の薬草も採れそうだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020404
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020404,
					"content": "おーい——ティナリさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020405
					],
					"speakerTitle": "アミル"
				},
				{
					"id": 30020405,
					"content": "ティナリ、誰かがおまえを呼んでるぞ。服装からして、レンジャーみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30020406,
					"content": "うん、知り合いのアミルたちだ。みんな出発したばっかりなのに、もう帰ってきたの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020407
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30020407,
					"content": "行ってみようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 300205,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300207",
							"2"
						],
						"stepId": 300207,
						"stateName": "QUEST_STATE_UNFINISHED"
