			"dialogs": [
				{
					"id": 752390101,
					"content": "ジャカのやつ…仕事も終わってないのにどこをほっつき歩いてるんだ。あのおもちゃも一体どこに置いたのやら…一言言ってやらんと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "カーネイ"
				},
				{
					"id": 752390102,
					"content": "ぬいぐるみ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "コホラ竜をモデルにしたぬいぐるみだよ。今それに色を塗っているんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "カーネイ"
				},
				{
					"id": 752390104,
					"content": "弟子のジャカが最近仕事に来なくてね。まだ色付けが終わっていない未完成のぬいぐるみが三つあるはずなんだが、どこに置いたんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "カーネイ"
				},
				{
					"id": 752390105,
					"content": "探すのを手伝ってもらえないか？この辺りにあるはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーネイ"
