					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070101,
					"content": "しょ…鍾離！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070102,
					"content": "久しいな、二人とも。息災だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070103,
					"content": "いやいやいや…鍾離、おまえがなんでここにいるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070104,
					"content": "悠々と闊歩するのであれば、目先のものだけにとらわれていてはならない。自由で豊穣なる風の国、実に良きところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070105,
					"content": "だが、ここでお前たちに会えるとは思わなかった。僥倖だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070106,
					"content": "何か飲みたいものはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "では、煙霞繁葉で一杯淹れてもらおう。濃い目で頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070107,
					"content": "お茶を飲みながら話をしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050703",
							"2"
						],
						"stepId": 7050703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "待たせたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070202,
					"content": "ごゆっくり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "ふむ、透き通る茶の色は美しく、口当たりも甘く芳醇。そして後から花果の香りが広がっていく…実に見事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070204,
					"content": "おおっ、鍾離はお茶を飲むにしても、他の人とはひと味違うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070205,
					"content": "オイラだったら「ゴクリ」と一口で飲んで、「うまい」くらいしか言えないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070206,
					"content": "丁寧に心から味わうことは、茶を淹れてくれた人に対しての敬意でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070207,
					"content": "いい茶とは滅多に出会えないものだ。そして、その茶で人を喜ばせることができる者は、さらに貴重な存在と言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070208,
					"content": "褒めすぎだって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "そっか、なるほどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070211,
					"content": "じゃあ…お茶の味わい方をオイラにも教えてくれよ。まずは匂いをかいで、それから飲めばいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070212,
					"content": "ああ、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070213,
					"content": "茶葉にはそれぞれ特徴がある。茶を飲んでいくうちに、それが自然と分かってくることだろう。茶の香りをかぐことで、その良し悪しも多少分かるようになるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070214,
					"content": "湿った匂いと強く焦げた香りがする茶は、質のよくないものだ。一方、甘美でまろやかな香りがする茶は質がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070215,
					"content": "よりこだわりたいのであれば、璃月に古くから伝わる「品香杯」を使うといいだろう。これは香りを味わうための専用の茶器だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070216,
					"content": "ど、どうしよう。なんだかこれまでずっと、お茶で損をしてきたんじゃないかって気になってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070217,
					"content": "気にするな、学問とは奥深いものだ。いつ始めようとも遅すぎるということはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070218,
					"content": "初めてであれば——まず湯の色を観察し、そして香りを楽しみ、最後に茶をいただくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070219,
					"content": "「浅いところから入り、徐々に深きところへと歩を進めていく」、これはあらゆる物事に通ずることでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070220,
					"content": "勉強になった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "璃月の北西にある「翹英荘」は茶業で有名だ。機会があれば、そこへ行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070223,
					"content": "ただ今日話したことの大半は、璃月の伝統を重んじる俺の習慣にすぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070224,
					"content": "茶を飲む習慣や文化は、地域によって異なるものだ。異国の地では、その土地の習慣を尊重すべきだということも忘れないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070225,
					"content": "オイラ、完全に理解したぞ！覚えられるかどうかは怪しいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070226,
					"content": "やっぱり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#{NICKNAME}、礼を言おう。このようないい茶を飲むことができ、足を運んだ甲斐があったというものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070228,
					"content": "もし、いつかお前が茶館に立つ日があったら、必ず俺も行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070229,
					"content": "でもオイラたち忙しいし、茶館で働くヒマなんてないかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070230,
					"content": "どうだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "いずれにせよ、機会があれば俺は助力する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070232,
					"content": "さて、今日はこのくらいにしておこう。お前達の仕事が上手くいくよう祈っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070233,
					"content": "うん、気を付けて帰って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "ふむ。代金はいつも通り、往生堂に請求しておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 705070236,
					"content": "じゃあなー！堂主にもよろしくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705070234,
					"content": "えっと、お会計は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "もっと知りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "ちょっと恥ずかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}