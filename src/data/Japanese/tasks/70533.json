			},
			"dialogs": [
				{
					"id": 705330101,
					"content": "私の発明品にこんな使い道があったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330102,
					"content": "やあ！こんにちは、旅人。また会ったね…コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330103,
					"content": "モンドを離れたんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "そのつもりだったんだが…万象は常に変化し続けるものだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330108,
					"content": "ゴホン、その話はさておき、本題に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330109,
					"content": "今回は、モンド冒険者協会からの依頼で、一つの種類のカードスキンをベースに、ギアと仕掛けを使って取り外したり組み合わせたりできる「械画」を結構な枚数作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330110,
					"content": "あのカード、何と言ったか…そうだ！「七聖召喚」、たしか、そんな名前だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330111,
					"content": "協会の人によれば、これらの「械画」は今回「召喚王グランプリ」が開催されるエリアにそれぞれ届けられて、ミニイベントなんかに使われるらしい。大会を盛り上げるために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330112,
					"content": "はぁ、私にとっては難しすぎる話さ。やはり私は発明に集中したほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330113,
					"content": "そうだ、モンドの「械画」は私の横に置いてあるから、組み合わせてみたいなら、試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330105,
					"content": "発明にまた問題が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "違う！今回はそうじゃないんだ。うぅ…というか、最初はそうじゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705330107,
					"content": "前回君に助けを求めた時だって、あれは完全に魔物のせいであって、私の発明品には何の問題もなかったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "フェリックス·ユーグ"
				}
			]
		}
	]
}