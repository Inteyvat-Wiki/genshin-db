				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "危なかった…撃沈されるところだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270602,
					"content": "さすが「越石丸」だ、凄いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270603,
					"content": "#ハハッ、喋る船は所詮船さ。この雷を乗り切るには、{NICKNAME}の卓越した操縦技術が欠かせなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270604,
					"content": "もう一回やる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "ハハッ、遠慮しておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270607,
					"content": "はぁ、さっきの雷は、恐らく俺の影響を受けたんだろう。この海域の環境も不安定になってきたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270608,
					"content": "#でも、ちょうどいい…{NICKNAME}、パイモン、宝は上にあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270609,
					"content": "あれ？ここは初めてお宝を探してた場所じゃないか？この上に「越石丸」の半分があったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270610,
					"content": "今回はきっと宝があるさ、何しろこれは…えっと、「大海賊船の直感」ってやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270611,
					"content": "そうか…ところで、この前二つのことを伝えるって言ってたよな、一つは自分の名前だろ、もう一つはなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270612,
					"content": "ハハハッ、もう忘れていると思ったが。残りは、お前たちが戻ってから話そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270605,
					"content": "褒めてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
