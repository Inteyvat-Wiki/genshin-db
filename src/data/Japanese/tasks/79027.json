					"「御肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "「越石丸」、「越石丸」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790271002,
					"content": "お宝があったぞ！ほら、海賊船の模型だ！おまえの直感がやっと当たったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790271003,
					"content": "あっ、そうだ！結局、もう一つの「伝えたいこと」ってなんだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790271004,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790271005,
					"content": "「越石丸」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790271006,
					"content": "（「越石丸」の名を持つ船は何の反応もしてこない…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790271007,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "…ふん、帰ったら教えるって約束したのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790271010,
