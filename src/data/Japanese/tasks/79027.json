			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「御肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "おお、来たか！俺はてっきり、お前たちはなんちゃらの翼で毎日島々を飛び回っていて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270102,
					"content": "水に浸かった「御肉丸」のことなんざとっくに忘れかけているのかと思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270103,
					"content": "だからこうやっておまえのことを思い出したじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270104,
					"content": "ところで、この前手伝ってほしいって言ってたよな、どんなことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270105,
					"content": "別に大したことではないんだが…この前、体の欠片を見つけてくれただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270106,
					"content": "何というか、願いが叶ったせいなのか…はたまた、俺を喋らせていたこの海域の力が弱ってきたせいなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270107,
					"content": "最近意識がはっきりしなくて、眠ってしまうことが増えてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270108,
					"content": "機械を止めたせいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "なるほど、なんちゃらの機械ってやつのおかげで、俺はお前のウェーブボートになれて、言葉も話せるようになった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270111,
					"content": "えっ？…それじゃ、機械の影響がなくなったら、「御肉丸」は話せなくなるってことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270112,
					"content": "なんとかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270113,
					"content": "ハハッ、気にするな、パイモン…こうしてお前たちと話せることができたんだから、俺はもう満足だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270114,
					"content": "いやぁ、思えば…船でありながら、お前たちと気持ちよく話せていたなんて、もはや幻の夢みたいなもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270115,
					"content": "だが、最後に頼みたいことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270116,
					"content": "構わないから言って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "この前、体が見つかったら、この海域でお前たちを乗せてやると約束したが、体はとうにバラバラだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270125,
					"content": "宝もほとんど持っていかれて、価値のあるものは残っていなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270118,
					"content": "だが今回は、大海賊船の名に誓って、必ず立派な宝物を見つけると約束しよう！騙されたと思って、俺に着いてきてくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270119,
					"content": "「御肉丸」はもうすぐ話せなくなるかもしれないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270120,
					"content": "それに…お宝があるらしいぞ！行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270121,
					"content": "しょうがないな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "じゃ、さっそく出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790270124,
					"content": "よし、それじゃ船に乗ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「御肉丸」"
				},
				{
					"id": 790270122,
					"content": "そこまで言われたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "「御肉丸」も機械の影響を受けてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
