			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "三つ揃えた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "本当に揃えたの？ちょっと見せて…確かに、三つの模様を合わせると、「若陀龍王」の物語よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160503,
					"content": "この鶴は「理水畳山真君」で、この鹿は…「削月築陽真君」かしら。残り1人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160504,
					"content": "ん？ここの模様は…わざと消されたみたいに、何も見えないわ。3人目の仙人は一体誰かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160505,
					"content": "この件は完全に私の知識範疇を超えてるわ。とにかく、この「お宝」は揃えてるから、いい値段で売れるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160506,
					"content": "どう？記念に手元に置くか、それとも私に売るのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160507,
					"content": "売る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "ええ、お金はここよ。これはいただいたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160509,
					"content": "しかし…どうして3人の仙人の中で、1人だけ姿が消されたのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160510,
