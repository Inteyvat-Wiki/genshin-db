			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "無名の宝物について",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160202,
					"content": "これは…この模様はかなり歴史があるようね。少し待ってて、今確認するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160203,
					"content": "少しボロボロだけど、急いで手放したいなら、私が買ってあげてもいいわ。あまりいい値段にはならないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160204,
					"content": "じっくり見たんだけど、この模様は確かに璃月のものよ。それに、上に記載されてるものも「若陀龍王」と関連する逸話ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160205,
					"content": "言い伝えによると、若陀龍王は璃月の岩元素が集まって生まれた魔龍。岩王帝君でも簡単に倒せないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160206,
					"content": "それを鎮圧するために、岩王帝君は3人の仙人を招集して、洞窟を作ってもらったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160207,
					"content": "その後、岩王帝君は自ら戦って、若陀龍王を洞窟に入れると、仙人たちは通路を封鎖し、それでやっと封印できたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160208,
					"content": "あなたが持ってきたこれの模様は、あの大戦で3人の仙人たちが力を合わせて洞窟を作ってる光景を描いてると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160209,
					"content": "だから、こういうものは少なくとも三つはあるはずよ。三つ合わせて一つのものになるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160210,
					"content": "そこまで分かるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "一応これで商売してるからね、どんな知識も把握しておかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160215,
					"content": "ちょっと話が逸れたわね。とにかく、これは三つあるはず、一つだけだといい値段で売れないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160216,
					"content": "もし三つを揃えたら、話は別よ。でも、これはそれなりに歴史があるし、三つを全部揃えるのは難しいと思うけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160212,
					"content": "璃月は不思議だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "まあ、璃月はあまりにも広いし、その歴史も長いからってある先輩が言ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 710160214,
					"content": "だから璃月でどんなに変わった骨董品を見かけても驚く必要はない。璃月の長い歴史と比べて、私たちが知ってるのはほんの一部だけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "琳琅"
				}
			]
		},
