			},
			"dialogs": [
				{
					"id": 706560101,
					"content": "こんにちは、目の前の秘境を挑戦しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560102,
					"content": "少し興味ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "それならちょうどいい、紹介してやるよ。俺は冒険者協会のプローン、この秘境の護衛役を担当している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560105,
					"content": "冒険者協会の記録によると、こいつは特定の時間でしか現れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560106,
					"content": "ちょうど風花祭だから、俺たちは秘境内に手を加え、全員が参加できる挑戦に改造した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560107,
					"content": "危なくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "心配いらない、祭を祝うための特別イベントだからな。冒険経験がない人が参加すれば、ベテランの冒険者が付き添ってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560109,
					"content": "まぁ、お前らは冒険経験豊富だから、手伝う必要はないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560110,
					"content": "一人で秘境を探索してもよし、フレンドを招待して参加してもよし。クリアさえできれば、報酬を獲得できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560111,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "これ以上説明しても時間が惜しい。秘境の中で楽しい時間を過ごしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プローン"
				},
				{
					"id": 706560112,
					"content": "報酬があるなら試してもいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "特殊な秘境みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
}