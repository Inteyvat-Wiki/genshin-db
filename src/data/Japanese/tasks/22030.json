			"dialogs": [
				{
					"id": 220300201,
					"content": "ここです。二ヶ所の魔物はそれぞれ、左右に拠点を築いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300202,
					"content": "こっそりと偵察しましたが、左側の魔物は強くありませんが数が多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300203,
					"content": "右の拠点の魔物は多くありませんが、とても強いように感じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300204,
					"content": "あなたには片方の魔物をお任せし、私はもう片方を始末します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				}
			]
		},
