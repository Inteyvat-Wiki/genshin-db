				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "感謝します！食材はまだ使えそうですが、これ以上長引いてはいけません…今すぐ調理を始めます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300602,
					"content": "出来上がりました、ふぅ…おかげさまで、無事美味しい料理が出来ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300603,
					"content": "完璧を求めているね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "当然です。園芸、茶道、料理、剣術、どれも究極を追求する心構えがなければ、それに取り組む意味がなくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300605,
					"content": "「極致」への道は、私の人としての道でもあります。しかし…旭東さんは私とは考えが違うようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300606,
					"content": "旭東さんは以前、璃月には「中庸」という言葉があるとおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300607,
					"content": "人としても、仕事においても、極端にならず、片寄らず、常に変わらないという意味だそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300608,
					"content": "この、旭東さんの言葉を理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300609,
					"content": "もしかしたら旭東さんも…色々な経験をしてきたゆえ、このような理念に辿り着いたのでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300612,
					"content": "食材を入手することが出来ましたし、料理も完成しましたのでもう大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300613,
					"content": "これを受け取ってください。残りは旭東さんのところへ持って帰り、食べてもらおうと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300610,
					"content": "魔物たちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "私が倒しました、心配いりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "亀井宗久"
				}
			]
