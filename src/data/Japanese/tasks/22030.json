					"亀井宗久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "またお会いできましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300102,
					"content": "身勝手ながら、あなたに頼み事があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "旭東さんに雇われて以来、彼らと一緒に旅をしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300107,
					"content": "旭東さんへの恩を返すため、ちょっとしたお礼をしたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300108,
					"content": "しかし武芸よりも、旭東さんは美食に興味があります。なので、彼に料理を作って差し上げたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300109,
					"content": "すでに二つの食材の採集地に目星をつけています。食材が熟したら採りに行こうと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300110,
					"content": "しかし、二ヶ所の採集地はそれぞれ魔物が占拠していて、どちらの食材もすでに採られています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300111,
					"content": "私が作る料理は、鮮度が一番重要で、一ヶ所目で採集してから、二ヶ所目に行く予定だったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300112,
					"content": "今は両方とも魔物に採られてしまいました。あの料理を作るには、早めに二種の食材を入手しなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300113,
					"content": "しかし…一ヶ所の魔物を退治できても、もう一ヶ所の食材はとっくに無くなっているでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300114,
					"content": "ですから、私と共にその魔物を倒して、もう片方の食材を入手していただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300115,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "感謝します、本当になんとお礼を申し上げればいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300119,
					"content": "うむ…話してばかりでは機を逃してしまいます。私と共に前方を確認してから対策を練りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300117,
					"content": "料理が出来上がったら少し分けてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "もちろんです、言わずともお礼として差し上げますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "亀井宗久"
				},
				{
					"id": 220300104,
					"content": "そうかしこまらないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "頼み事をお願いしました故、これくらいの礼節は当然のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "亀井宗久"
				}
			]
		},
		{
