			"dialogs": [
				{
					"id": 721410601,
					"content": "どうだ？「彼」の教え、お前は聞いたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410602,
					"content": "何も聞こえなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "構わない、構わない。「彼」は見ている、「彼」は聞いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410605,
					"content": "「彼」は喜んでいる。そして、「彼」を喜ばせる人は報われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410606,
					"content": "「彼」の褒美が対岸にないなら、明日訪れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410607,
					"content": "自分が何を言ってるか分かってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "またここに来るといい。さすれば、その時に分かるだろう。",
