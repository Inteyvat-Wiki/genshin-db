					"鷲津"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "「彼」の怒りを鎮めなければ、「彼」の憤りを収めなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411702,
					"content": "よくやった、お前はよくやった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411703,
					"content": "覚えておくといい、仮面を被って、お前を騙す者がいる。だが「彼」はお前を助ける、「彼」はいつもお前を助けるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411704,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "あの女は伝説の妖狐のようだ。俺は彼女を逃したから、「彼」はとても怒っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411707,
					"content": "今「彼」はまた怒っている…これは俺のせいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411708,
					"content": "許してくれ…またお供えをしよう、次の「復帰」の供物を探しに行くから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411709,
					"content": "許してくれ、許してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411710,
					"content": "許してくれ、許してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411705,
					"content": "分かった…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
