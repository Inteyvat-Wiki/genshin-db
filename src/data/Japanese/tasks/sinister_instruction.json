			"dialogs": [
				{
					"id": 721410101,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410102,
					"content": "こんにちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410106,
					"content": "えっと、聞いてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410108,
					"content": "こんにちは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "…邪魔しないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410111,
					"content": "「彼」は不機嫌だ、口舌が邪魔をし、「心の声」の知恵が覆い隠されたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410112,
					"content": "口舌…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "口舌はにわか雨のように、鼓膜を揺らし、心を乱すのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410114,
					"content": "たが、「心の声」は霧のように、自然に出て立ちこめる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410116,
					"content": "シッ…！「彼」は聞いている、「彼」は話している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410117,
					"content": "口舌は不要、耳を使うな、心で聞くのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410118,
					"content": "ここへ来て、参拝して、祈り、そして聞け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410119,
					"content": "参拝は三回行うのだ。覚えておけ、三回だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721410120,
					"content": "（試してみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "やめておく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "話せるなら頷いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
