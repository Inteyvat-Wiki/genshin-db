			"dialogs": [
				{
					"id": 721411101,
					"content": "参拝して、耳を傾ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411102,
					"content": "「彼」は耳を傾けるから強い、強いから全てが見える、全てが聞こえる。だから、彼は全てを見る、全てを聞く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411103,
					"content": "珊瑚宮の愚かな人たちも、鳴神島の妄信者たちも、これについて何の理解もなく、感じるものもない。だから、彼らは戦い合うことしか知らず、血迷うことになったのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411104,
					"content": "しかし、お前はそれを理解すべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411105,
					"content": "どういうこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "答えは参拝にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411108,
					"content": "覚えておけ。毎日三回参拝すれば、必ず報われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411106,
					"content": "なんとなく理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
