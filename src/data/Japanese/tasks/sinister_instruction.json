					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "アッ！グゥッ…ごめんなさい…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411810,
					"content": "「彼」の選択を疑うべきじゃない、我慢し続け、参拝をし続けるのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411811,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の声が聞こえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "我慢し続けよ…参拝を続けるのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
