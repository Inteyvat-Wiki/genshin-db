				},
				{
					"id": 721411802,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "俺の罪を許してくれて感謝する、俺を戻らせてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411804,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に話してるんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "何だ…しかし、一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411806,
					"content": "俺は全ての供犠を司り、お前の全ての恩恵を受けた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411807,
					"content": "彼女はお前に印を付けられ、お前のおかげで完成品となった。なのに彼女はお前の恩恵から逃れ、俺らを裏切ったのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "鷲津"
				},
				{
					"id": 721411808,
					"content": "何のこと…",
