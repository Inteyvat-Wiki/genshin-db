			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30301201,
					"content": "どれも心の底から思っていることですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301202
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301202,
					"content": "普段奉行様がお食事をなさる時は、いつもトーマ様がおそばに付き添っていらっしゃるんです。その横でお二方の他愛のない話を聞くことが、私が最も安らぎを感じるひと時なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301203
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301203,
					"content": "公務によっては、やむなく外でお食事をされる時もあります。ただ奉行様は、機会があれば府内へお戻りになられて、お食事をされるほうが好きなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301204
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301204,
					"content": "奉行様が言うには、トーマ様の料理の腕は凡その料理人よりも秀でているとのことです。ふふっ、奉行様はいつも「家」を想ってくださっているのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301205
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301205,
					"content": "ご存じないかもしれませんが、お二方はあなたのこともお話しされます。まるで、とても長い付き合いで、なんでも話せるご友人についてのことのように語られるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301206
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301206,
					"content": "お嬢様も偶にご一緒されることがあります。近ごろ何度かあった一家団欒のひと時には、いつも趣のある人や見聞についての話がありました。その中には、やはりどれもあなたがいたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301207
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301207,
					"content": "…先代奉行様と奥様が亡くなられてから、神里家もこれだけの年月を歩んできたのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301208
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301208,
					"content": "ばあやの私は、奉行様とお嬢様の成長を見守ってきました。彼らの身分で、あなたのような趣のあって頼りになるご友人ができるなんて、本当によいことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301209
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301209,
					"content": "もしお時間がありましたら、いつでも奉行府へ遊びに来てください。不躾ですが、ばあやからのお願いだとでも思ってくださいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301210,
						30301211
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301210,
					"content": "本当にありがとう、今度来るね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				},
				{
					"id": 30301212,
					"content": "それはよかったです。ふふっ、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301213
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301213,
					"content": "へへっ、オイラ、ここに来るのが好きだぜ。それにおばあさんも言ってたけど、社奉行府の料理ってすごいんだってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301214,
					"content": "うぅ、オイラも食べたくなってきたぜ。今度ご飯を食べに…じゃなくて、遊びに来ようぜ！ご飯の時間の時にな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301215,
					"content": "もちろんいいですとも、歓迎いたしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301401
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301401,
					"content": "じゃあ、オイラたちはこの辺で失礼するぜ。でも…うーん、これからどこに行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301402,
					"content": "たたら砂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301403
					]
				},
				{
					"id": 30301403,
					"content": "おう、わかったぜ。じゃあな、おばあさん！見送りはしなくてもいいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301404,
					"content": "ええ、分かりました。また今度お会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301405
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301405,
					"content": "二人とも、もう行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301406
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301406,
					"content": "おう、用事が済んだからな。心配しなくていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301407,
					"content": "そうか、君たちの旅が順調であるよう祈るよ。さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301211,
					"content": "神里家の人はみな友達、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				}
			]
