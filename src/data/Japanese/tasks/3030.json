			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏達",
					"古田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30301001,
					"content": "着いたぞ、社奉行府だ。それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301002,
					"content": "旅人、久しぶりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301003
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301003,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301004
					]
				},
				{
					"id": 30301004,
					"content": "もし奉行様とお嬢様を探してるのなら、あいにく今は府中にいないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301005
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301005,
					"content": "公務に行ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301006,
					"content": "ああ、奉行様は公務に行っている。お嬢様のほうは奉行様の名代で会議に出席しているんだ。急用があるなら、ここで少し休んで待つといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301007
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301007,
					"content": "どうするんだ？中に入るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301008,
					"content": "お邪魔します。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301009
					]
				},
				{
					"id": 30301009,
					"content": "少し庭でぶらぶらしてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301010
					]
				},
				{
					"id": 30301010,
					"content": "他の人だったら当然だめだが…君は奉行様やお嬢様とも親しい仲にあるからな、問題はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301011
					],
					"speakerTitle": "宏達"
				},
				{
					"id": 30301011,
					"content": "ありがとな！じゃあ、中に入るぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301012,
					"content": "おや？そのように私を見てどうしたんです？何か聞きたいことでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301013
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301013,
					"content": "おばあさん、少し質問してもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301014
					]
				},
				{
					"id": 30301014,
					"content": "ふふっ、いいですよ。お嬢様から聞いたことがあるので、あなたがあの旅人さんであることは知っていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301015
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301015,
					"content": "何を聞きたいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301016
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301016,
					"content": "奉行様とお嬢様は最近元気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301017
					]
				},
				{
					"id": 30301017,
					"content": "あなたのおかげで、お二人とも元気ですよ。お嬢様は近ごろ様々な会議に出席しています。時には、奉行様を手伝って民間の組合にも顔を出していらっしゃるんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301018
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301018,
					"content": "奉行様のほうはと言うと、あなたもご存知の通り、相変わらずとても忙しくなさっております。ただ、最近はご気分がよさそうでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301019
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301019,
					"content": "聞いた感じ、普段と変わらないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301020,
					"content": "ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301021
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301021,
					"content": "（神里綾人がまだ社奉行を担当していて、綾華も奉行府のお嬢様のまま…元の状況と違いはない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301022
					]
				},
				{
					"id": 30301022,
					"content": "（社奉行の今の状況も、ほぼ変わりはないみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301023
					]
				},
				{
					"id": 30301023,
					"content": "（予想してた結果だけど、彼ら兄妹の無事を知れただけで、すごく安心だ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301024
					]
				},
				{
					"id": 30301024,
					"content": "どうだ、他に聞きたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301025
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30301025,
					"content": "今はもうない、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301026
					]
				},
				{
					"id": 30301026,
					"content": "どういたしまして。あなたがとても忙しいと伺っていなければ、奉行府によく来るようお誘いしていたところですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301027
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301027,
					"content": "実のところ、お嬢様からよくあなたのことを伺うんですよ。あなたのようなお友達ができたことをとても嬉しく思っていらっしゃるようです。それに、あなたがあらゆる面で素晴らしく、尊敬できる方であるともおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301028
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301028,
					"content": "私も、あなたが稲妻に来られてから、様々なことが良い方向へと向かっているような気がします。もしかしたら、貴人や縁あるお方というのは、あなたのような方のことなのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301029
					],
					"speakerTitle": "古田"
				},
				{
					"id": 30301029,
					"content": "そんな、それほどでも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 303012,
			"completionStepIds": [
				303010
			],
