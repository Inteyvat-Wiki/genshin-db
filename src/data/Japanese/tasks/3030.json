			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天目十五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300201,
					"content": "天目鍛冶屋に着いたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300202,
					"content": "おぉ、久しぶりじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300203
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300203,
					"content": "こんにちは、聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300204
					]
				},
				{
					"id": 30300204,
					"content": "もちろんだ、話してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300205,
						30300206
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300205,
					"content": "「雷電五箇伝」のことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				},
				{
					"id": 30300207,
					"content": "ほう、そんなことが聞きたいとはな…まあいい。知りたいなら、もう少し詳しく話してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300208
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300208,
					"content": "かつて稲妻に名を馳せた「雷電五箇伝」、それはこの五つじゃった——天目、経津、一心、百目、千手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300209
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300209,
					"content": "この五つの鍛造技術は、もともと将軍様から直々に賜ったものじゃ。それは多くの優秀な職人たちによって、より優れたものへと磨き上げられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300210
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300210,
					"content": "しかしその後、これら刀鍛冶の家系は次第に没落していった。現在も受け継がれているのは、我々「天目」ただ一つのみじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300211
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300211,
					"content": "じゃが、幸いにも近ごろ楓原万葉が稲妻に戻り、「一心伝」の技術を受け継いだ。これにより、五箇伝もまだ二つは残っているということになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300212
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300212,
					"content": "わしの記憶が正しければ…彼が刀を打った時、お前もその場におったはずじゃが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300213
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300213,
					"content": "そう言われたらオイラも思い出したぜ！たしかにそんなことあったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300214,
					"content": "あの時は雷電五箇伝が没落したことを聞いて、すごく悲しかった記憶があるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300215,
					"content": "じゃあ没落した原因は…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300216
					]
				},
				{
					"id": 30300216,
					"content": "…はぁ。それがまた、悲しい話なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300217
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300217,
					"content": "本来はわしなんぞが知る由もないことじゃが…それぞれの家系が衰退する話を長年聞いてきて、理由さえ知らぬのはどうかと思ってな…気になって、楓原万葉に聞いたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300218
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300218,
					"content": "彼は、同じ雷電五箇伝の末裔として、わしには知る権利があると言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300219
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300219,
					"content": "まあ…お前に伝えても構わんじゃろう。ただ、聞いて嬉しくなるような話でもないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300220
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300220,
					"content": "——雷電五箇伝は、さる刀工の末裔に報復されたんじゃ。その者は狂ったように殺しを行ったとされている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300221
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300221,
					"content": "報復？どうしてだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300222,
					"content": "伝説によると、四百年以上も前、たたら砂の炉心で事故が起こったらしい。現場にいたとある刀工が、他の者を助けるため、危険を顧みず炉心の中へ飛び込んでいったと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300223
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300223,
					"content": "たたら砂の鍛造製錬技術は優秀なものじゃった。当時、たたら砂を管理していた造兵司正は丹羽という苗字の者で、楓原と姻戚の関係にあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300224
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300224,
					"content": "造兵司正の丹羽様も、その刀工と一緒に炉の中へと飛び込んだそうな。後に炉心は安定したようじゃが、その時には二人はもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300225
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300225,
					"content": "刀工の一族は没落し、その者の息子は誰も面倒を見てくれぬ孤児となって、毎日を憎しみの中で生きるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300226
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300226,
					"content": "彼はこのことを稲妻全体のせいにした。父の死について無関心な将軍様を恨み、父を救ってくれなかったすべての者を憎んだんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300227
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300227,
					"content": "じゃが無力な彼は、その恨みを子孫に継がせることしかできなかった。こうして、その一族は代々恨みを背負い、苦しみの中を生きた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300228
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300228,
					"content": "物語はここで終わらない。百年前、一族の当時の当主は現状にひどく不満を感じておった。じゃが、それを好転させる力もなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300229
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300229,
					"content": "やがて…彼は怒りを晴らすために極めて過激な決断をした——雷電五箇伝に復讐し、稲妻の鍛造事業の根幹を揺るがそうとしたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300230
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300230,
					"content": "その者は百目一族の出でありながら、自らの一族の職人まで殺めてしまった。百年ほど前、すべての攻撃を主導したのが彼じゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300231
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300231,
					"content": "じゃが、楓原家と神里家の末裔や刀工と対峙した折、そばに居合わせた者がおったことで、彼は猛烈な反撃にあい、その場で死したとされておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300232
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300232,
					"content": "そのおかげで、楓原が代表する「一心流」も壊滅を免れた。不幸中の幸いと言えるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300233
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300233,
					"content": "（雷電五箇伝に関する伝説が変わってる。当時刀工たちに害を加えたのがまだ他にいた？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300234
					]
				},
				{
					"id": 30300234,
					"content": "（どうやら、スカラマシュは確かに世界樹に何かしたらしい。でも…それでも丹羽は亡くなった。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300235
					]
				},
				{
					"id": 30300235,
					"content": "まだ他に聞いておきたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300236,
					"content": "ここ数日、万葉に会ってない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300237
					]
				},
				{
					"id": 30300237,
					"content": "楓原万葉か。ちょうど昨日、ここに来ておったぞ。世間話などして、茶を飲んだ。様子を見るに、元気そうじゃったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300238
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300238,
					"content": "（よかった、無事だった…おかしなところもなさそうだし、昨晩考えていた極端な状況よりは遥かにマシだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300239
					]
				},
				{
					"id": 30300239,
					"content": "もう他に質問はない、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300240
					]
				},
				{
					"id": 30300240,
					"content": "気にするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300241
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 30300241,
					"content": "その表情だと、また他の場所に行くんだよな？えへへっ、オイラってけっこう顔色を見るのがうまいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300242,
					"content": "じゃあ、次の場所に出発だ！オイラはどこまでもおまえの後について行くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300206,
					"content": "もう一回話してくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300207
					]
				}
			]
		},
		{
			"id": 303006,
			"completionStepIds": [
				303006,
				303009
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30300602,
					"content": "もちろん、俺はここ一帯の炉心を研究したことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300603
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300603,
					"content": "何が聞きたいんだ？遠慮せず聞いてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300604
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300604,
					"content": "ここの歴史には詳しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300605
					]
				},
				{
					"id": 30300605,
					"content": "当然さ！俺はこの近くを数え切れないほど歩いてきたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300606
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300606,
					"content": "それに他の場所でも、かつてたたら砂に住んでいた人の子孫に会ったことがある。彼らの口から語られるのは、どれもすべて真実の歴史さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300607
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300607,
					"content": "ぜひその歴史を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300608
					]
				},
				{
					"id": 30300608,
					"content": "ふむ？急にそう言われてもな、二言三言で説明しきれるもんじゃないんだぞ。知ってるだろ？たたら砂は歴史深い場所なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300609
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300609,
					"content": "俺の知る限り、たたら砂は鍛造製錬業の中心地区の一つとして、数千年にも及ぶ歴史を持ってるんだ。ただ、炉心には二回ほど問題が発生していてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300610
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300610,
					"content": "二回？どの二回だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300611,
					"content": "ここ数年の一回、何百年か前にもう一回だ。そういえば稲妻の人に聞いたんだが、たたら砂では以前にもフォンテーヌの職人が来たことがあるらしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300612
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300612,
					"content": "どうやら、この二国の技術交流も歴史が深いものなのかもな。聞けばそのフォンテーヌの職人というのも、当時のたたら砂の重要な客人だったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300613
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300613,
					"content": "（「博士」のことだ。どうやら「博士」が意図的に炉心を壊して、動乱を引き起こした歴史には影響がないみたいだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300614
					]
				},
				{
					"id": 30300614,
					"content": "なあ、たたら砂に来て聞きたかったこと、グザヴィエに聞いてみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300615,
					"content": "もう聞いてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300616
					]
				},
				{
					"id": 30300616,
					"content": "おお、二人は歴史を研究しているんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300617
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300617,
					"content": "そうなんだよ。こいつ、今日はどうしたのか知らないけど、ずっと歴史について聞き回ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300618,
					"content": "ん？急に歴史について興味を持ち始めたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300619
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300619,
					"content": "うん。だから、もう一つ質問がしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300620
					]
				},
				{
					"id": 30300620,
					"content": "いいぞ、話してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300621
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300621,
					"content": "たたら砂の「傾奇者」について聞いたことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300622
					]
				},
				{
					"id": 30300622,
					"content": "傾奇者？ふむ…聞いたことはないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300623
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300623,
					"content": "その言葉が稲妻では一般的に、特異な行動を取るとか、ユニークな服装をする人とかを指すのは知っている…俺もこの言葉に相応しい人に会ってみたいとは思っていたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300624
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300624,
					"content": "残念ながら、そのような人に会ったことはないし、たたら砂に関係のある話でそのような噂を聞いたこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300625
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300625,
					"content": "（傾奇者がいない…まさかスカラマシュは世界樹で何かをして、自分に関する記録を消した？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300626
					]
				},
				{
					"id": 30300626,
					"content": "（もしそうだったら、彼は世界を変えて、すべてを原点に戻そうとしたのだろう。でも今のところ、影響があるのは彼自身についてだけ…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300627
					]
				},
				{
					"id": 30300627,
					"content": "ありがとう、グザヴィエ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300628
					]
				},
				{
					"id": 30300628,
					"content": "なあに、どうってことないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300629
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300629,
					"content": "もう行くのか？それじゃあな、グザヴィエ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300630,
					"content": "おう！気にするな、役に立ててよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300631
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300631,
					"content": "じゃあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300632
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 30300632,
					"content": "どうやら、知りたかったことは聞けたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300633,
					"content": "戻ってナヒーダに会おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300634
					]
				},
				{
					"id": 30300634,
					"content": "おう。でもおまえ…今日は本当にどうしたんだ？…なんか悩んでるみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300635,
					"content": "元気出せよな！なにがあっても、オイラがそばにいるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300636,
						30300638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300636,
					"content": "…うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300637
					]
				},
				{
					"id": 30300637,
					"content": "元気だせよ！どうしてもダメなら、なにか食べればいいんだ！お腹が減ったら戦はできないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300640,
					"content": "じゃあ、ナヒーダに会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30300638,
					"content": "ありがとう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30300639
					]
				},
				{
					"id": 30300639,
					"content": "遠慮するなって、オイラたちの仲だろ。えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30300640
					],
					"speakerTitle": "パイモン"
				}
			]
		},
