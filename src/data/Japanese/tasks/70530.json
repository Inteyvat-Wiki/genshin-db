			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ファスビン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705300201,
					"content": "旅人！旅人、ちょっと待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300202
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300202,
					"content": "ここでは何のイベントをやってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300203
					]
				},
				{
					"id": 705300203,
					"content": "イベント？いやいや、私にはそんな気力も能力もないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300204
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300204,
					"content": "私は「写真を撮る」ことが大好きでね。以前、人づてに「写真機」を手に入れてから、たくさんの写真を撮ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300205
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300205,
					"content": "すると、それを協会の人がかなり気に入ってくれてね…サイリュスさんは写真をアルバムにまとめて、記念品として配ろうと提案してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300206
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300206,
					"content": "ちょうど風花祭の時期だろ？モンドのあちこちで風花祭に関する写真を撮ってくるよう、サイリュスさんに言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300207
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300207,
					"content": "風花祭の記念アルバムを作って、協会の冒険者たちに贈りたいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300208
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300208,
					"content": "でも…モンドには写真スポットがたくさんあるし、私一人では到底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300209
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300209,
					"content": "それに協会の冒険者たちはみんなそれぞれの用事があって、手伝う暇がないそうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300210
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300210,
					"content": "風花祭の期間中、人に頼みごとするのは良くないのは知ってる…でも旅人は「写真機」が得意だと聞いた。どうか助けてくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300211,
						705300213
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300211,
					"content": "まあ、多少は心得がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300212
					]
				},
				{
					"id": 705300212,
					"content": "ふぅ…よかった。私の聞いた話は間違いじゃなかったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300216,
					"content": "コホンッ、話を戻そう…旅人、モンドの各地で「写真機」を使って撮影することを正式に依頼させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300217
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300217,
					"content": "そうだ。私のこの「写真機」で撮ってきてほしい。いつもメンテナンスしてるから、使い勝手も悪くないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300218
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300218,
					"content": "いい写真が撮りたければ、まずはいい「写真機」がないと、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300219
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300219,
					"content": "それじゃ頼んだよ。風花祭に関することなら、どんな写真でもいいから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300220
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300220,
					"content": "もちろん報酬も心配ない。協会のルールに則って出すようにする。ただ働きにはさせないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300221
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300221,
					"content": "私はここで写真を整理して、分類してよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300213,
					"content": "どこでそれを聞いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300214
					]
				},
				{
					"id": 705300214,
					"content": "協会の冒険者たちから聞いたんだ。その中にかなりの「写真機」好きがいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300215
					],
					"speakerTitle": "ファスビン"
				},
				{
					"id": 705300215,
					"content": "私たちは「写真機」愛好家協会を立ち上げようとしてるんだ。でも、サイリュスさんが許可してくれるかどうかはまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "ファスビン"
				}
			]
		}
	]
}