			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランパンドゥ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#ナラ{NICKNAME}、それにパイモン！二人のおかげで、ヴァルナ神器もアシャヴァンレルムも良好です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730500102,
					"content": "アランナラが全員ヴァナラーナに戻って、ウツァヴ祭を祝う。鳥が巣に帰るように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730500103,
					"content": "怒った雨が優しい雨に戻った。アランナクラも安心して苗畑の世話をして、ヴィパリャスをご機嫌に育てられる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730500104,
					"content": "ご機嫌なヴィパリャスで、ご機嫌な灯りを作る。ご機嫌な灯りで、ご機嫌なウツァヴ祭を彩る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730500105,
					"content": "#ナラ{NICKNAME}とパイモン、苗畑は順調、ウツァヴ祭も楽しい。ヴァルナ神器を修復し、アランナクラを連れ戻してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730500106,
					"content": "そっか、よかったぞ！へへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730500107,
					"content": "そういえば、すごく気になってたんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "なんでナラヴァルナって名前なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "ああ、そのナラは、ヴァルナ神器の修理を手伝ってくれたナラなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730500110,
					"content": "#じゃあ、{M#彼女}{F#彼}の本名は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "うーん…知りません。ナラヴァルナは本名を言いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730500112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#ナラ{NICKNAME}には色々助けてもらった。勇敢で、困難を次々に乗り越えたナラだ。一緒にウツァヴ祭を過ごせて嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730500115,
					"content": "#ナラ{NICKNAME}に渡したいものがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730500116,
					"content": "アランナラの感謝の印です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730500117,
					"content": "#ナラ{NICKNAME}はきっと気に入る、パイモンも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730500118,
					"content": "アランナラの花を、勇敢なナラとパイモンに贈ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730500119,
					"content": "#アランカラも小さな花を持ってる。ヴィパリャスではないけど、ナラ{NICKNAME}とパイモンにあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "アランカラ"
				},
				{
					"id": 730500120,
					"content": "#ナラ{NICKNAME}、パイモン、ヴァーナのためにしてくれたこと全てに感謝します。アランナラは友達を忘れません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730500113,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
		{
			"id": 7305002,
