			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランナガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "ウツァヴ祭…懐かしい感覚…ん？白いふわふわ…それに金色のナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730500302,
					"content": "ナラの友達とナラの友達の友達、ウツァヴ祭をどうか楽しんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "アランナキン"
				},
				{
					"id": 730500303,
					"content": "友達の友達も友達だ！金色のナラ、それに空飛ぶ白い毛もアランガルの友達だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				}
			]
		}
	]
