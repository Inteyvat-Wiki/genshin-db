			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランラキャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#ナラ{NICKNAME}、パイモン！ヴァーナを「病気」にした悪いヤツはもう来ない、安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730500202,
					"content": "#ナラ{NICKNAME}とパイモンが助けてくれたから、アランラキャはヴァーナを守れた…だから、アランラキャはナラ{NICKNAME}とパイモンにお花をあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730500203,
					"content": "花を受け取ってくれ、アランラキャの友達！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラキャ"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
				7305003
