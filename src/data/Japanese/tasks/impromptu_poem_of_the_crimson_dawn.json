			"dialogs": [
				{
					"id": 741780601,
					"content": "そんな大人数で俺たちに挑むのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780602
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780602,
					"content": "あんたたちは卑怯だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780603
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780603,
					"content": "アニキ、こいつらどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780604
					],
					"speakerTitle": "ブルー"
				},
				{
					"id": 741780604,
					"content": "あそこにいるお友達に聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780605
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780605,
					"content": "#{M#君たち}{F#あなたたち}も強盗なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780606
					]
				},
				{
					"id": 741780606,
					"content": "はは。さあ、どうだろうね。そうとも言えるし、そうでないとも言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780607
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780607,
					"content": "オレたちが奪うのは悪人の持つものだけ。こいつら二人みたいな悪いヤツらからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780608
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741780608,
					"content": "#ワケわからなくなっちゃったぞ…あいつら二人はオイラと{NICKNAME}を引き留めて強盗しようとしたんだから悪もんに決まってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780609,
					"content": "赤毛は二人の悪もんに金目の物を渡し、信用させてここに連れてきた。でも、実は赤毛の仲間が待ち伏せしてたってわけか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780610,
					"content": "つまり赤毛とやつの仲間は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780611,
						741780615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780611,
					"content": "身分を隠した警察だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780612
					]
				},
				{
					"id": 741780612,
					"content": "執律庭の犬だったとは…チッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780613
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780613,
					"content": "残念ながら今の僕は違う。執律庭が正義を追求するやり方には賛同できない…でも彼らの目指すものが正義であることに変わりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780614
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780614,
					"content": "君たちのように弱い者いじめをして、嘘を吐きまくる輩と比べられては困る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780617
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780617,
					"content": "とにかく、僕たちは平凡な人間に過ぎない。だが平凡な人間にも譲れない正義がある。だから目の前の悪行を見過ごすことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780618
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780618,
					"content": "しかも、これまで彼らがここで働いた悪事を抜きにしても、さっき君たちを解放すると言ったとき、心では違うことを考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780619
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780619,
					"content": "心の中で何を考えてるかなんてどうやったらわかるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780620,
					"content": "他人の本音を知りたいなら、耳じゃなくて頭で聞くことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780621
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780621,
					"content": "（前にペニーが言ってた気がする…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780622
					]
				},
				{
					"id": 741780622,
					"content": "何回か深呼吸をした後、余計な考えを取り除いて頭の中をクリアにする…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780623
					]
				},
				{
					"id": 741780623,
					"content": "さっき彼らが何て言ってたか、思い出してみて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780624
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780624,
					"content": "「見ず知らずの{RUBY#[D]相当アホだな}人間のために…お前はなんて善良{RUBY#[S]もしお前の心が黄金と同じ価値があるなら}な心の持ち主だ。俺は感動し{RUBY#[D]何が何でも抉り出してやるぜ}ちまったよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780625
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780625,
					"content": "#「俺たちは約束{RUBY#[D]口約束なんて一銭の価値もねぇ}を守る人間だ。今日はまずペットの散歩中だ{RUBY#[S]まずはこのマヌケから金を搾り取ってから、戻ってもうひと暴れするぞ}った{M#にいちゃん}{F#ねえちゃん}を解放しよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780626,
						741780628
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780626,
					"content": "うわ～…怖いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780627
					]
				},
				{
					"id": 741780627,
					"content": "おまえ、ちっとも怖がってなんかないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780629,
					"content": "なんだかデジャヴを感じるぞ！「悪もんは所詮悪もんだったな」って展開もそうだし、「頭を研ぎ澄ませたら、本音が聞こえるようになった」って経験も、初めてじゃない気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780630,
					"content": "他人の本音が分か{RUBY#[D]ハッタリに決まってる}るだなんてバカな…俺たちが言って{RUBY#[D]俺を騙す気だな}ることは本心だ。何一つ嘘は{RUBY#[D]好きにさせるか}ついてねえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780631
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780631,
					"content": "ちらっと欲に目が{RUBY#[D]よくあることだ}くらんだだけだよ。俺たちはもう{RUBY#[D]俺たち二人だけじゃ対抗できない}これで懲りた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780632
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780632,
					"content": "今ここでこれまでの強盗{RUBY#[S]なんせ、収穫の殆どは持ち歩かずに拠点に置いてある}で得た金銭を返すがな、マジで生活に困っ{RUBY#[D]ここら辺の邪魔ものは手強いようだ}てるんでなけりゃ、誰がこんな命がけの{RUBY#[S]仲間を呼んで縄張りを変えよう}暮らしを望むかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780633
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780633,
					"content": "今回俺たちを見逃してくれたら、ルミドゥースハーバー{RUBY#[S]拠点の仲間を呼び、仕返しに戻るぞ}でまともに暮らすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780634
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780634,
					"content": "当たり{RUBY#[S]アホめ}前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780635
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780635,
					"content": "今言った{RUBY#[S]こいつはマヌケだ}通りだ。あんたらも{RUBY#[D]マヌケだと面倒が省ける}聞いただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780636
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780636,
					"content": "分かった。もう一度君たちを信じよう。ブルー、ブロン、彼らを解放する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780637
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780637,
					"content": "りょーかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780638
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741780638,
					"content": "俺たち心を入{RUBY#[S]さあ、仲間を呼んで戻ってくるぞ}れ替えるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780639
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780639,
					"content": "いずれお礼{RUBY#[D]ボコボコにしてやる}しに戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780640
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780640,
					"content": "二人の宝盗団は、礼を言い終えると振り返りもせずに南へ去った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780641
					]
				},
				{
					"id": 741780641,
					"content": "なんであいつらを見逃したんだ！おまえも聞こえてただろ？心の中ではどう思ってたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780642,
					"content": "そう焦らないで。君たちも聞こえてたのなら分かってるはずだ。彼らがこれからも悪事を働くつもりで、しかも他にたくさんの仲間がいるってことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780643
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780643,
					"content": "大きな魚を釣るためにわざと逃がしたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780644
					]
				},
				{
					"id": 741780644,
					"content": "そのとおり。一網打尽にするいいチャンスなんだ。好機を見逃すわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780645
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780645,
					"content": "#でももし相手が大勢だったら…オイラたちも一緒に行こうか？{NICKNAME}はかなり強いんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780646,
						741780648
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780646,
					"content": "#{M#君}{F#あなた}が彼らを連れてきたばかりに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780647
					]
				},
				{
					"id": 741780647,
					"content": "もし最初会った時にオイラたちが助けてたら、こいつの計画が台無しになっちゃうところだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780650,
					"content": "はは、君たちが手伝ってくれるなら、ブルーとブロンには休んでてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780651
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780651,
					"content": "ええ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780652
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741780652,
					"content": "異存はない。アニキに従おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780653
					],
					"speakerTitle": "ブルー"
				},
				{
					"id": 741780653,
					"content": "では、そういうことで。あの嘘っぱちだらけの悪人コンビは、今ごろ南の拠点へ戻って手下を集めてるのだろう。やつらに時間をあげて、我々は明日の夕方に訪問するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780654
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780654,
					"content": "わかった！あ、そういえばおまえの名前はなんて言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780655
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780655,
					"content": "名前か…ただのコードネームでよければ。ルージュと呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780656
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780656,
					"content": "ルージュ…前にペニーから聞いたことがあるぞ！だから「頭で聴く」って話を聞いたとき、なんだか聞き覚えがあるなと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780657
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780657,
					"content": "ペニーと知り合いだったのか。奇遇だね。僕のことを話してた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780658
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780658,
					"content": "世界は狭いものだね…こんなこともあるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780648,
					"content": "#{M#俺}{F#私}もよく悪人から強奪する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780649
					]
				},
				{
					"id": 741780649,
					"content": "コホン、「制裁」って言いたいんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780628,
					"content": "彼らの考えてたことはそう意外でもない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780629
					]
				},
				{
					"id": 741780615,
					"content": "悪人の中の悪人だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780616
					]
				},
				{
					"id": 741780616,
					"content": "はは！悪人を罰するには、悪人よりも固い意思がなければならない。この道理については君もよく分かってるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780617
					],
					"speakerTitle": "赤毛の青年"
				}
			]
		},
		{
			"id": 7417810,
			"completionStepIds": [
				7417810
