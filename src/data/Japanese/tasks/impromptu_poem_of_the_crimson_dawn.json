			"dialogs": [
				{
					"id": 741781101,
					"content": "そんな大人数で俺たちに挑むのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781102
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781102,
					"content": "あんたたちは卑怯だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781103
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741781103,
					"content": "アニキ、こいつらどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781104
					],
					"speakerTitle": "ブルー"
				},
				{
					"id": 741781104,
					"content": "あそこにいるお友達に聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781105
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781105,
					"content": "#{M#君たち}{F#あなたたち}も強盗なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781106
					]
				},
				{
					"id": 741781106,
					"content": "はは。さあ、どうだろうね。そうとも言えるし、そうでないとも言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781107
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781107,
					"content": "オレたちが奪うのは悪人の持つものだけ。こいつら二人みたいな悪いヤツらからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781108
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741781108,
					"content": "#ワケわからなくなっちゃったぞ…あいつら二人はオイラと{NICKNAME}を引き留めて強盗しようとしたんだから悪もんに決まってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781109,
					"content": "赤毛は二人の悪もんに金目の物を渡し、信用させてここに連れてきた。でも、実は赤毛の仲間が待ち伏せしてたってわけか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781110,
					"content": "つまり赤毛とやつの仲間は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781111,
						741781115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781111,
					"content": "身分を隠した警察だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781112
					]
				},
				{
					"id": 741781112,
					"content": "執律庭の犬だったとは…チッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781113
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781113,
					"content": "残念ながら今の僕は違う。執律庭が正義を追求するやり方には賛同できない…でも彼らの目指すものが正義であることに変わりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781114
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781114,
					"content": "君たちのように弱い者いじめをして、嘘を吐きまくる輩と比べられては困る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781117
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781117,
					"content": "とにかく、僕たちは平凡な人間に過ぎない。だが平凡な人間にも譲れない正義がある。だから目の前の悪行を見過ごすことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781118
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781118,
					"content": "しかも、これまで彼らがここで働いた悪事を抜きにしても、さっき君たちを解放すると言ったとき、心では違うことを考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781119
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781119,
					"content": "心の中で何を考えてるかなんてどうやったらわかるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781120,
					"content": "他人の本音を知りたいなら、耳じゃなくて頭で聞くことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781121
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781121,
					"content": "（言ってることはよく分からないけど、試してみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781122
					]
				},
				{
					"id": 741781122,
					"content": "何回か深呼吸をした後、余計な考えを取り除いて頭の中をクリアにする…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741781123
					]
				},
				{
					"id": 741781123,
					"content": "さっき彼らが何て言ってたか、思い出してみて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781124
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781124,
					"content": "「見ず知らずの{RUBY#[D]相当アホだな}人間のために…お前はなんて善良{RUBY#[S]もしお前の心が黄金と同じ価値があるなら}な心の持ち主だ。俺は感動し{RUBY#[D]何が何でも抉り出してやるぜ}ちまったよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781125
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781125,
					"content": "#「俺たちは約束{RUBY#[D]口約束なんて一銭の価値もねぇ}を守る人間だ。今日はまずペットの散歩中だ{RUBY#[S]まずはこのマヌケから金を搾り取ってから、戻ってもうひと暴れするぞ}った{M#にいちゃん}{F#ねえちゃん}を解放しよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781126,
						741781128
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781126,
					"content": "うわ～…怖いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781127
					]
				},
				{
					"id": 741781127,
					"content": "おまえ、ちっとも怖がってなんかないだろ。…おかしいって、急にそんな能力に目覚めたら超怖いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781130,
					"content": "他人の本音が分か{RUBY#[D]ハッタリに決まってる}るだなんてバカな…俺たちが言って{RUBY#[D]俺を騙す気だな}ることは本心だ。何一つ嘘は{RUBY#[D]好きにさせるか}ついてねえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781131
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781131,
					"content": "ちらっと欲に目が{RUBY#[D]よくあることだ}くらんだだけだよ。俺たちはもう{RUBY#[D]俺たち二人だけじゃ対抗できない}これで懲りた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781132
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741781132,
					"content": "今ここでこれまでの強盗{RUBY#[S]なんせ、収穫の殆どは持ち歩かずに拠点に置いてある}で得た金銭を返すがな、マジで生活に困っ{RUBY#[D]ここら辺の邪魔ものは手強いようだ}てるんでなけりゃ、誰がこんな命がけの{RUBY#[S]仲間を呼んで縄張りを変えよう}暮らしを望むかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781133
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781133,
					"content": "今回俺たちを見逃してくれたら、ルミドゥースハーバー{RUBY#[S]拠点の仲間を呼び、仕返しに戻るぞ}でまともに暮らすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781134
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741781134,
					"content": "うん、つまり心から悔い改めるって言いたいんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781135
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781135,
					"content": "当たり{RUBY#[S]アホめ}前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781136
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781136,
					"content": "今言った{RUBY#[S]こいつはマヌケだ}通りだ。あんたらも{RUBY#[D]マヌケだと面倒が省ける}聞いただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781137
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741781137,
					"content": "分かった。もう一度君たちを信じよう。ブルー、ブロン、彼らを解放する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781138
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781138,
					"content": "分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781139
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741781139,
					"content": "俺たち心を入{RUBY#[S]さあ、仲間を呼んで戻ってくるぞ}れ替えるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781140
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741781140,
					"content": "いずれお礼{RUBY#[D]ボコボコにしてやる}しに戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781141
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741781141,
					"content": "二人の宝盗団は、礼を言い終えると振り返りもせずに南へ去った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741781142
					]
				},
				{
					"id": 741781142,
					"content": "なんであいつらを見逃したんだ！おまえも聞こえてただろ？心の中ではどう思ってたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781143,
					"content": "そう焦らないで。君たちも聞こえてたのなら分かってるはずだ。彼らがこれからも悪事を働くつもりで、しかも他にたくさんの仲間がいるってことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781144
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781144,
					"content": "大きな魚を釣るためにわざと逃がしたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781145
					]
				},
				{
					"id": 741781145,
					"content": "そのとおり。一網打尽にするいいチャンスなんだ。好機を見逃すわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781146
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781146,
					"content": "#でももし相手が大勢だったら…オイラたちも一緒に行こうか？{NICKNAME}はかなり強いんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781147,
						741781149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781147,
					"content": "#{M#君}{F#あなた}が彼らを連れてきたばかりに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781148
					]
				},
				{
					"id": 741781148,
					"content": "もし最初会った時にオイラたちが助けてたら、こいつの計画が台無しになっちゃうところだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781151,
					"content": "はは、君たちが手伝ってくれるなら、ブルーとブロンには休んでてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781152
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781152,
					"content": "ええ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781153
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741781153,
					"content": "異存はない。アニキに従おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781154
					],
					"speakerTitle": "ブルー"
				},
				{
					"id": 741781154,
					"content": "では、そういうことで。あの嘘っぱちだらけの悪人コンビは、今ごろ南の拠点へ戻って手下を集めてるのだろう。やつらに時間をあげて、我々は明日の夕方に訪問するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781155
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781155,
					"content": "わかった！あ、そういえばおまえの名前はなんて言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781156,
					"content": "名前か…ただのコードネームでよければ。ルージュと呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781149,
					"content": "#{M#俺}{F#私}もよく悪人から強奪する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781150
					]
				},
				{
					"id": 741781150,
					"content": "コホン、「制裁」って言いたいんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781128,
					"content": "彼らの考えてたことはそう意外でもない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781129
					]
				},
				{
					"id": 741781129,
					"content": "お、オイラも聞こえるようになったぞ！オイラの頭ってすごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781115,
					"content": "悪人の中の悪人だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781116
					]
				},
				{
					"id": 741781116,
					"content": "はは！悪人を罰するには、悪人よりも固い意思がなければならない。この道理については君もよく分かってるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781117
					],
					"speakerTitle": "赤毛の青年"
				}
			]
		}
	]
}