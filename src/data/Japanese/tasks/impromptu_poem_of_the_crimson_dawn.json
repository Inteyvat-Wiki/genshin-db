					}
				]
			},
			"dialogs": [
				{
					"id": 741781001,
					"content": "品がだいぶ増えてるね。どうやら、やつらの手下もサボってはいなかったみたいだ。でも今回で本当に懲りるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781002
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781002,
					"content": "そうだ、君も随分と頑張ってくれた。ここから分け前を得るべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781003
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781003,
					"content": "なんだか変な感じがするから、遠慮しとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781004
					]
				},
				{
					"id": 741781004,
					"content": "はは、ではお言葉に甘えて。すると、感謝の言葉しか君にはあげられないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781005
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781005,
					"content": "これらの金品をどう処理するつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781006
					]
				},
				{
					"id": 741781006,
					"content": "え？もちろん、本当に必要とする人に渡すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781007
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781007,
					"content": "おっと、僕が富を独り占めしようとしてるんじゃないかって思わせてしまったかな。それじゃ、僕はやつらのしていることとなんら変わらないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781008
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781008,
					"content": "そ、それで一体どうするつもりなんだ？というか、おまえの考えはどうなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741781009,
					"content": "前にハヴィシャムとジングルに言ったことは本心だよ。今の君たちなら分かるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781010
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781010,
					"content": "この世界は不平等に満ちていて、過度な貧困と行き過ぎた貪欲さが存在してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781011
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781011,
					"content": "一部の人たちが落ちぶれて苦しむのは、自分の力だけでは乗り越えがたい状況に陥ったからなんだ。だから、僕はそういう人たちに少しでも手を差し伸べたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781012
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781012,
					"content": "残念ながらハヴィシャムとジングルはそうじゃない側の人たちだ。欲望に目がくらみ、自分たちが持つべきではない物を、暴力によって弱き者から奪い取ろうとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781013
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781013,
					"content": "しかし、フォンテーヌの法は未だに彼らに然るべき罰を与えていない。それが僕には許せないんだ…君たちがなんと言おうと、僕は僕が正しいと思うことをする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781014
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781014,
					"content": "自分なりの理由があるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741781015
					]
				},
				{
					"id": 741781015,
					"content": "ひょっとしたら僕の考え方だって自惚れだと言われるかもしれない。あるいは、また違った形の貪欲さだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781016
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781016,
					"content": "幸い、僕は一人で進んでいるのではない、志を共にする仲間たちが一緒にいてくれている。たとえ、ほんの少ししか世界を変えられないとしてもかまわない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741781017
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741781017,
					"content": "何はともあれ、今回は本当にありがとう。また会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "赤毛の青年"
				}
			]
		},
