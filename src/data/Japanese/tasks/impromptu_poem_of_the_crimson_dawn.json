			"dialogs": [
				{
					"id": 741780201,
					"content": "#やあ、{M#にいちゃん}{F#ねえちゃん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780202
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780202,
					"content": "今日はマジでひどい一日だった。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780203
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780203,
					"content": "あんたは運が悪い。俺たちもツイてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780204
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780204,
					"content": "お前はペットの散歩中に俺たちに出くわした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780205
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780205,
					"content": "運が悪いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780206
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780206,
					"content": "俺たちはそろそろ仕事を切り上げようと思ってたところだ。だがお前に出会っちまったもんだから、ここは一つ頑張るしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780207
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780207,
					"content": "俺たちツイてないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780208
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780208,
					"content": "パイモン、どうしよう。こいつら強盗だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780209
					]
				},
				{
					"id": 741780209,
					"content": "まずはオイラのことを散歩が必要なペットじゃないって、言い返してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780210,
					"content": "まあいいけどさ…こんなときは相手よりも荒々しい態度でいかないとダメだ。オイラを見てろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780211,
					"content": "#やい！オイラたちは泣く子も黙る{NICKNAME}とパイモンだ！この無法者どもめ！余計な事をしてぶっとばされたくなけりゃ、さっさと退散しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780212,
					"content": "こんなによく喋るペットは珍しいな。こいつを捕まえたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780213
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780213,
					"content": "高値で売れるに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780214
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780214,
					"content": "ええ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780215,
					"content": "お喋りはここまで、ケンカしようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780216
					]
				},
				{
					"id": 741780216,
					"content": "ま、待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780217
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780217,
					"content": "ハヴィシャムさん、ジングルさん、約束したよね？僕が持ってる貨物を差し出せば、しばらくは罪のない通行人や動物に手を出さないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780218
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780218,
					"content": "そういえば俺たちは知り合って日が浅い。まだ俺たちの経歴を話してなかったな。以前はフォンテーヌ廷で見習いをやってたんだが、追い出されてな。どうしてだか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780219
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780219,
					"content": "あいつらが言うには「向上心がない」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780220
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780220,
					"content": "そう！だが、何と言っても俺たちは間違いを認めて直せる人間なんだ。前の仕事で向上心がないって言われたんだから、今の仕事では十二分に向上心を持たねえとってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780221
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780221,
					"content": "#{M#俺}{F#私}も悪者を倒すことなら十五分に興味ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780222
					]
				},
				{
					"id": 741780222,
					"content": "#そうは見えなかったが、{M#にいちゃん}{F#ねえちゃん}は背が低い割に、気概はあるようだ。今日は戦わないわけにはいかねえようだな。いいだろう。俺たち二人の腕っぷしを見せてやろうじゃねえか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780223
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780223,
					"content": "十八分にすごい腕っぷしってやつをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780224
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780224,
					"content": "待って、どうかお願いだよ。僕の忠告を聞いて。こんな無意味な争いは君たち双方にとって無益なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780225
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780225,
					"content": "お互いがケガをするにしても、どちらかが命を落とすにしても、そんな結末は望んでないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780226
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780226,
					"content": "幸いにも僕には十分な金がある。二十分にとは言えないけど、身代金を多めに払ってもいい。ただ、これ以上いがみ合うのはやめてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780227
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780227,
					"content": "おまえ…大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780228,
					"content": "ああ、ご心配をどうも。しばらく活動に余裕がなくなるけど、他は何も問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780229
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780229,
					"content": "やつらがお前を閉じ込めてたんだろ？オイラたちに助けを求めないばかりか、やつらに余分な身代金を払うだなんてどうしてだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780230,
					"content": "君は親切だね。生きていると、自分の力だけではどうにもならない状況に陥ることもある。ハヴィシャムさんとジングルさんは今、そういう状況なんだと僕は信じてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780231
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780231,
					"content": "わずかな金銭で二人を、あるいは四人をも救えるなら、これよりお得な取引なんてどこにあるだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780232
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780232,
					"content": "僕のことは心配に及ばない。ハヴィシャムさんとジングルさんが約束してくれたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780233
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780233,
					"content": "彼らを連れて品を取りにいくんだ。そうすれば解放してもらえる。それに彼らには元手もできるから、新しい仕事にも就ける。もう二度と罪のない通行人と動物を困らせる必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780234
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780234,
					"content": "お前は確かにそう言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780235
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780235,
					"content": "俺たちは確かにそう聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780236
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780236,
					"content": "見ず知らずの人間のために…お前はなんて善良な心の持ち主だ。俺は感動しちまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780237
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780237,
					"content": "#俺たちは約束を守る人間だ。今日はまずペットの散歩中だった{M#にいちゃん}{F#ねえちゃん}を解放しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780238
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780238,
					"content": "#よかった。{NICKNAME}{M#くん}{F#ちゃん}とパイモン、これで家に帰れるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780239
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780239,
					"content": "僕のことは心配無用だ。ハヴィシャムさんとジングルさんを連れて、彼らに渡すための品を取りに行く…たったそれだけの仕事だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780240
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780240,
					"content": "宝盗団は赤毛の青年を檻から解放し、三人そろって東へと向かった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780241
					]
				},
				{
					"id": 741780241,
					"content": "#あいつら行っちゃったな…{NICKNAME}。宝盗団の二人、ちゃんとあいつを解放すると思うか？あいつって、マヌケっぽいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780242,
						741780244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780242,
					"content": "#{M#俺}{F#私}に金を渡して解決させればよかったのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780243
					]
				},
				{
					"id": 741780243,
					"content": "たぶんアリも殺せないような人なんだろうな。そんなやつ、ホントにいるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780246,
					"content": "一体どういうことなのか気になるぞ！あいつら東へ向かったよな…追いかけてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780244,
					"content": "それか三人とも演技してるとか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780245
					]
				},
				{
					"id": 741780245,
					"content": "あっ！つまりあいつら三人がグルってことか？でももう三人とも行っちゃったぜ。オイラたちを騙してどうすんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780246
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
