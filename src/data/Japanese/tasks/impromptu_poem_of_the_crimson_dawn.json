			},
			"dialogs": [
				{
					"id": 741780401,
					"content": "見えたぞ！まずは隠れて様子を見よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780402,
					"content": "…これが約束の品だ。それほどではないけど、今この厳しい時期を乗り越えるには十分なはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780403
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780403,
					"content": "数は…フン、確かにぴったり、お前の言った通りの数だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780404
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780404,
					"content": "あんたは素直なやつだね。俺たち、素直なやつは好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780405
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780405,
					"content": "素直に手放すようなやつなら、もっとくれたっていいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780406
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780406,
					"content": "なんせ金なら多すぎるほどあるんだし、惜しくないなら俺たちに寄越せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780407
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780407,
					"content": "…やれやれ。どんな奇抜な言い分が聞けるかと思ったけど、結局はありきたりな脅しか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780408
					],
					"speakerTitle": "弱そうな赤毛の青年"
				},
				{
					"id": 741780408,
					"content": "ありきたりな脅しってのは便利なんだ。使わない手はないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780409
					],
					"speakerTitle": "ハヴィシャム"
				},
				{
					"id": 741780409,
					"content": "痛い目に遭わせてやらねえとダメだな。許しを請うのに、どんな奇抜な言い分が出てくるか、聞いてやろうじゃねえか。くらえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780410
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780410,
					"content": "#（{NICKNAME}、どうする？助けに行くか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780411,
					"content": "（もう少し様子を見よう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741780412
					]
				},
				{
					"id": 741780412,
					"content": "（えっ？でも…うぅ、言う通りにするぜ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741780413,
					"content": "赤毛の青年が口笛を吹くと、茂みから二人の青年が飛び出してきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741780414
					]
				},
				{
					"id": 741780414,
					"content": "許しを請うための奇抜な言い分なんてものはない。でも、ありきたりなやり方で、君たちがこれまで無実の通行人から奪ってきた金銭を吐き出させてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780415
					],
					"speakerTitle": "赤毛の青年"
				},
				{
					"id": 741780415,
					"content": "アニキの言ってることはつまり「今すぐ言うことを聞いてくれたら、このありきたりな茶番劇もここでおしまい」ってことだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780416
					],
					"speakerTitle": "ブロン"
				},
				{
					"id": 741780416,
					"content": "痛い目に遭いたいなら俺がいつでも付き合うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780417
					],
					"speakerTitle": "ブルー"
				},
				{
					"id": 741780417,
					"content": "はあ？お前たちどこから出てきやがった？それにお前…いつの間に着替えたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780418
					],
					"speakerTitle": "ジングル"
				},
				{
					"id": 741780418,
					"content": "たかがサーカス団のピエロじゃないか。痛い目に遭うのはあんたたちの方だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハヴィシャム"
				}
			]
		},
