			"dialogs": [
				{
					"id": 751450101,
					"content": "龍に選ばれし者よ…ああ、龍に選ばれし者よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450102,
					"content": "聖山は目の前だ…入りたくば…影に潜みし敵を…排除せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450103,
					"content": "ああ、龍に選ばれし者よ…聖山に…入るのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450104,
					"content": "グルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "今…火山が噴火した…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "別に静かだったけどな？噴火してるところを見たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450107,
					"content": "#どうしたんだよ、{NICKNAME}、{REALNAME[ID(2)|SHOWHOST(true)]}…なにをそんな考えこんでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450108,
					"content": "なんか、真相に気づいた探偵みたいな顔してるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450109,
					"content": "別の「真相」が見えたんだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "（パイモンにたった今見たものを話した…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#えっと、つまり、ナタに入ってすぐ{REALNAME[ID(2)|SHOWHOST(true)]}に会った時に見たのと同じものを見た、ってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450118,
					"content": "変なビジョンを見たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450119,
					"content": "グルゥ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#あの時も{NICKNAME}は変な文字が見えたって言ってたよな…うーん、オイラには見えないからよくわかんないけど、話しかけてくるのは同じやつなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450121,
					"content": "同一人物だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "でも、今回は巨大な遺跡とアビスまで見えたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450123,
					"content": "それに「聖山」か…うーん、ナタ人はあの火山を「聖山」って呼んでるみたいだけど…あの火山と関係があるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450124,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}をオイラたちに託したやつは、オイラたちを聖山に入らせたがってるんじゃないかって気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450125,
					"content": "#もしかしたら、あそこに行けば{REALNAME[ID(2)|SHOWHOST(true)]}が何者なのかわかるかも…それに、こいつの家族にも会えるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450126,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "とりあえず…火山に関する情報を探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450128,
					"content": "そうだ、ナタ六部族のうちの一つ「豊穣の邦」は火山の隣にあるらしいぞ。そこなら何か情報が手に入るかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450112,
					"content": "ケーキ殺人事件の犯人は…パイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "くそっ、オイラがケーキ嬢を食べてるところは誰にも見られていないはずなのに…なーんてな、オイラが盗み食いしたのはブレイズ・ミートシチューだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450115,
					"content": "だからおまえは…じゃなくて！結局おまえたちは何を見たんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751450116,
					"content": "（パイモンにたった今見たものを話した…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
