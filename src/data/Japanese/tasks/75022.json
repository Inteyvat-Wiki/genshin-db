					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "寝てるのは確かだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "（寝言の内容を話してみた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "つまり、わざと入り口を塞いで、オイラたちから食べ物をもらってるってことか？…なんだか騙された気分だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220410,
					"content": "ふん！だとすれば、オイラたちも容赦しないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220411,
					"content": "#いっそのこと、{REALNAME[ID(2)|SHOWHOST(true)]}に中に入ってもらって、あの宝箱を取ってこさせるのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220412,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "あっちがそう来た以上、こっちも遠慮なく行くぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220407,
					"content": "寝言を言ってるけど…",
