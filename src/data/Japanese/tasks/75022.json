			"dialogs": [
				{
					"id": 750220801,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "へへっ、やったな！さっそく宝箱の中身を見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220803,
					"content": "あれ？紙切れ一枚しかないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220804,
					"content": "もしかして、この紙切れを残したのがこいつの本当の主人ってことか？つまりオイラたち、この竜に騙されたわけじゃなくて、こいつの主人に騙されたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220805,
					"content": "なんて無責任なんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "本当だぜ。重病らしいけど、それでもユムカ竜をこんなとこに置き去りにするなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220807,
					"content": "他人の欲望…じゃなくて、竜への同情心を利用するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220810,
					"content": "まあ、とにかく、このままタダ食いさせるわけにもいかないし、懸木の民の族長に知らせようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220811,
					"content": "懸木の民の族長、ワイナにこのことを伝え、彼を連れてきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "やれやれ、君たちが私の所へ来たとき、なんとなく予感はしていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220813,
					"content": "よもや「あの者」が残した竜だったとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220814,
					"content": "「あの者」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "過ちを犯し、罰を恐れて自ら部族を去った者のことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220817,
					"content": "だが、その罪人の名前は言わないでおこう。やつも自分のしたことは良くないと自覚しているだろう。こんな手紙を残しても、署名はなかったのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220818,
					"content": "その人の竜も一緒にいることを選んだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "いや、そうとも言えない。竜は純粋な生き物でな、善悪を判断するのが苦手なんだ。みな仲間を信じ、感情のままに行動をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220820,
					"content": "…やはり、彼は本性を変えられなかったか。ちょっとした賢さをすべて騙しの手口に使い、他人どころか、自分の竜まで騙すなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220821,
					"content": "このユムカ竜には、定期的に食べ物を与えることにしよう。何しろ、部族の子なのだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220822,
					"content": "それにしても「あの者」は…まあ、無惨な結末ではあるが、同情はしない。人は自分のしたことに責任を持たねばな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワイナ"
				},
				{
					"id": 750220808,
					"content": "食べ過ぎると捨てられるってことだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "そ、そういう冗談はよくないんだぞ！…にしてもこいつ、ちょっとかわいそうだな。もしかしたら、主人の帰りを待ってるから、動こうとしないのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "パイモン"
				}
			]
