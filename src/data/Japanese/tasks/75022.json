			"dialogs": [
				{
					"id": 750220703,
					"content": "ユムカ竜は、あっという間に目の前の食べ物を飲み込んでしまった。\\nどうやって食べたのかさえ見えなかった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "こいつ…すっごくたくさん食べるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220305,
					"content": "パイモンにもライバルができたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "これだけじゃ…足りないんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "オイラは美食にこだわりを持ってるから、そんな風にガツガツ食べたりしないぞ！そんなことしたら、味が楽しめなくなるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220308,
					"content": "#そっ…そうみたいだな！こいつは「大食い竜」だったのか。{REALNAME[ID(2)|SHOWHOST(true)]}がこんなに食いしん坊じゃなくてよかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220309,
					"content": "でもこいつ、ほんとに腹ペコみたいだ！かわいそうだから、もう少しあげようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220310,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も食べたいのか？この竜を腹いっぱいにしてから、おまえにも美味いもんをあげるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220312,
					"content": "お腹をすかせた竜は、目の前の食べ物を一気に飲み込んでしまった。\\nそれはまるで、同じシーンが二度繰り返されたかのようだった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "よし、これでやっと腹いっぱいになったはずだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220314,
					"content": "って、なんでまた座ってるんだよ！もしかして、まだ足りないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220315,
					"content": "腹いっぱいになったら、すぐ寝転がるなんて…洞窟をあける気はまったくないみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220316,
					"content": "#どうするんだ、{NICKNAME}。こいつの行動、オイラにはもう理解できないぞ…腹いっぱいで寝るにしても、入り口を塞ぐことないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220317,
					"content": "道をあける約束はしてないけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "なんか騙された気がする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "腹立つな！オイラたちの食べ物をたくさん食べたくせに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220320,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も我慢できないみたいだぞ。{NICKNAME}、一緒にこいつを起こせるか試してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
