						750220609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220609,
					"content": "一匹ぼっちで、主人もいないから、自分で食べ物を探すこともできないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220610,
					"content": "#{NICKNAME}、なんか食わせてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220611,
					"content": "腹いっぱいになって、おとなしく道をあけてくれたら、お宝はオイラたちのものだぞ。へへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220612,
					"content": "何をすればいいかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "ちょっと待てよ、ナタの竜はなんでも食べるような気がするけど、ユムカ竜の好みは何だろうな？色からして、草とか葉っぱとかが好きそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750220614,
					"content": "とりあえず、適当に当ててみようぜ。腹ペコのやつなら、きっとなんだって食べるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
