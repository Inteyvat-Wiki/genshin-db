				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "素晴らしい腕前、敬服いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100202,
					"content": "#もしよろしければ…私からもう一つ、不躾なお願いがございます。{M#侠客}{F#女傑}殿は<color=#00E1FFFF>飛雲法</color>をご存じですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100203,
					"content": "我が先師古華は、紫気に包まれながら高天へと登り、平地を歩くように空を踏み進んだという言い伝えがあります。これは、その伝説の秘法によるものだと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100204,
					"content": "なんだか信じられない話だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "おう、嘘みたいな話だよな…でも、風の翼なら似たようなことはできるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762100207,
					"content": "#ほう？ならば{M#侠客}{F#女傑}殿、どうか一つ、手本をお見せください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100206,
					"content": "風の翼ならできるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
