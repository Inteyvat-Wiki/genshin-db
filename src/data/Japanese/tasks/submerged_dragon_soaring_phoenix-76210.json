			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#侠客}{F#女傑}殿、見事な身法ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100102,
					"content": "#へへっ、当たり前だぞ！{NICKNAME}はすっごく強いんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762100103,
					"content": "#それでは、{M#侠客}{F#女傑}殿。続いて<color=#00E1FFFF>跳躍法</color>の神髄を、私にご披露願えませんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100104,
					"content": "書に記された通りなら、我が古華の先師はまるで平地を歩くように、壁を跳び城を越えたといいます。これぞまさに跳躍の術なのです——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100105,
					"content": "すごい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "うーん…やってみるか？おまえは普段から宝箱を探してあちこち駆け回ってるし、いろんな場所を登ってきたしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762100106,
					"content": "まるで怪盗みたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#ははっ、考えてみてください、{M#侠客}{F#女傑}殿。もし怪盗風情が壁を乗り越えて逃げるのに、我々のような悪を挫き正義を成す者がそれをできないとなれば、悪党をみすみす逃がしてしまうことになるではありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "長孫継璟"
				}
			]
		},
