			"dialogs": [
				{
					"id": 762100301,
					"content": "ご覧ください。こちらが我が古華堂の「観梅の陣」でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100302,
					"content": "#制限時間内に私が指し示す石杭を順に踏み渡り、{M#侠客}{F#女傑}殿の技量をご披露願えますでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100303,
					"content": "お安い御用だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "報酬は安くないほうがいいけどな…あ、いや、なんでもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762100307,
					"content": "#では、{M#侠客}{F#女傑}殿、その腕前をお見せください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長孫継璟"
				},
				{
					"id": 762100305,
					"content": "パイモン派の宗主パイモンでも楽勝だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "できないぞ！どう考えたって——ん？よく考えたらできそうな気がしてきたけど…空を飛ぶのはルール違反だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "パイモン"
				}
			]
