			"dialogs": [
				{
					"id": 100060601,
					"content": "「うん、どうやら今回はアルベドの言う通りだったようだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060602,
					"content": "おい、こんな不意打ちやめてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060603,
					"content": "でも、彼らを倒したあと、体の中の力をもっと自在に操れるようになった気がするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060604,
					"content": "「実は、君のことを聞いて、血液にあるあの暗黒の力を封じる術式を用意したんだ。この機会に渡そうと思ってな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060605,
					"content": "「当然、その術式を使えば相応の代償が伴う。テイワットでの存在は保てるが、世界との繋がりを削ってしまう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060606,
					"content": "「なにせ、君はMの子だ。力をうまく扱えないせいで、あの子と同じ運命を辿ることになったら、Mに申し訳が立たない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060607,
					"content": "「でも今になってみれば、私の心配は無用だったようだ。Mはすごいな、私よりずっと母親らしい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060608,
					"content": "「君がどこまで成長するのか、楽しみにしてる。この世界に溶け込むことができた錬金生命体は、どのようにして人間社会で自分の居場所を見つけるのか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060609,
					"content": "「このような実験はまだしたことがない。もしかすると、君から思いがけない『答え』を得られるかもしれない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060610,
					"content": "えーと、でもドゥリンは実験体なんかじゃなくて、オイラたちの大事な友達だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060611,
					"content": "よく分からないけど、気持ちは嬉しい。レインドットおばさんには感謝だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥリン"
				}
			]
		},
