					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "もう初めてじゃないけど、人の話し方を真似できる猫って、やっぱりちょっと珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
