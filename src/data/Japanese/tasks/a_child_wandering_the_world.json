				]
			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "それに、生物学的に見ても私は錬金生物であって、「猫」とは言えない。君が空飛ぶフライムと同類ではないようにな。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100060902,
					"content": "ん？なんでフライム？こいつの言ってること、なんか含みがあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060903,
					"content": "なるほど、これが「言葉の裏」ってやつだね？つまり、セバスが言いたいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060904,
					"content": "言わないで、ドゥリン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "おい、どういう意味だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060906,
					"content": "ああ、そうだ。レインドット様が不要と言ったんだ。この術式は破棄しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100060907,
					"content": "レインドット様が誰かを気にかけるなんて、そうあることではない。君には期待してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100060908,
					"content": "さて、もう行かないと。他にも伝えるべき伝言がある。またどこかで会うかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セバス"
