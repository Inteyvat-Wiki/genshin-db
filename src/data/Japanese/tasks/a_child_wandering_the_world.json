			},
			"dialogs": [
				{
					"id": 100060501,
					"content": "「初めまして。まだ君のことをどう呼ぶべきか分からないが、Mの子であるなら、とりあえずちびドゥリンと呼ばせてもらおう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060502
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060502,
					"content": "「体はずいぶん小さく見えるが、君の血に残っているあの子の力は、全く小さくない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060503
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060503,
					"content": "「あの子は『腐蝕層』の不完全な造物だから、自身の力を支配する『意志』が欠けてた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060504
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060504,
					"content": "「『意志』を持たない子が、限界以上の力を与えられ、そのせいで力にねじ曲げられ、飲み込まれ、運命の結末へと向かってしまった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060505
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060505,
					"content": "「君は腐植の血を超え、彼に近い存在だとアルベドは言ってたが、それは彼個人の意見で、まだ私の認めたところではない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060506
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100060506,
					"content": "「私は絶対的な事実にしか動かされない。『見る』必要がある。さあ、Mの子。今この場で、私に証明してみてくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「レインドット」"
				}
			]
		},
