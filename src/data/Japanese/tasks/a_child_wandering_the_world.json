			"dialogs": [
				{
					"id": 100060101,
					"content": "よう！ドゥリン、ここにいたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060102,
					"content": "旅人にパイモン、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060103,
					"content": "へへっ、外はこんなにいい天気なのに、なんで一人で本なんて読んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060104,
					"content": "それが、モンドでみんなと「交流」する機会が増えたんだけど、ボクはよくみんなの言った冗談を本気にしてしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060105,
					"content": "例えばこの前、花屋でとても綺麗な花を見つけて、店主と話してたら、彼女がこう言ったんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060106,
					"content": "「もしこの雑草が気に入ったなら、ミントやスイートフラワーと一緒に花束にしたらどうか？」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060107,
					"content": "彼女の言った通りに花束を作って見せたら、怖い顔をされたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060108,
					"content": "ドゥリンは独特なセンスを持ってるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "アルベドによると、これはボクがまだ「言葉の裏」を理解できてないかららしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060111,
					"content": "モンドの文字を覚えたら、ここで本を読むといいって、彼が勧めてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060112,
					"content": "ボクは物語の本から生まれた存在だから、この世界の「ルール」も本から学べるはずだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060113,
					"content": "気がついたら、こんな時間まで読みふけってたよ…あ、そういえば、ボクに何か用があったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060114,
					"content": "友達同士は頻繁に会うものなんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "なるほど、そういうことか。それも「ルール」の一つなんだね。勉強になったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060116,
					"content": "まあ、それはそうだけど、オイラたちにはちゃんとした用事があるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060118,
					"content": "実は、レインドットから伝言を預かってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060119,
					"content": "まさか…レインドットおばさんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060120,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "いや、ちょっと驚いただけ…レインドットおばさんはお母さんの友達で、かつてこの世界に存在していた「魔龍」の母でもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060123,
					"content": "ボクはその運命に取って代わってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060124,
					"content": "だから、もしおばさんがボクのことを嫌ってたら…どうすればいいか分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060125,
					"content": "たぶん、そんなに心の狭い人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "おう、心配すんなって！ぜったい悪いことじゃないぜ。オイラたちもついてるしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100060128,
					"content": "そう言ってもらえると、ずいぶん気が楽になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060129,
					"content": "それなら、開けてみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 100060126,
					"content": "#それに、{M#俺}{F#私}たちもついてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "緊張しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "魔女の手伝いで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "それは店主が悪いと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
