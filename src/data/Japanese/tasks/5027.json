			"trigger": {
				"objectNames": [
					"ムアラニ",
					"キィニチ",
					"アハウ",
					"カチーナ",
					"シトラリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "炎神様、すごすぎるよ！シュバランケ様と勝負するなんてほんとに大胆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 50270102,
					"content": "そうは言うが、お前だってそういう度胸はあるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 50270103,
					"content": "ハッ！その程度の度胸、誰だってあるさ！オレは言うまでもない！お前だってそうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "アハウ"
				},
				{
					"id": 50270104,
					"content": "わ…わたしには無理だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 50270105,
					"content": "戦うことは戦士の性だ、度胸も何もない。本当にその時が来れば、勝負したくなるのは当たり前さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 50270106,
					"content": "はぁ、キミたちって本当に元気ね。天下のシュバランケさまよ？大昔のスーパー偉い方なんだからね？そんなにすごい人と手合わせがしたいワケ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 50270107,
					"content": "シトラリおばあさまも！機会があったらまた勝負しようよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 50270108,
					"content": "イヤイヤ、絶対イヤよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マソウ",
					"オロルン",
					"イアンサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "あの…僕、どんな野菜になれるのかな。赤い野菜？それとも緑黄色野菜…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "マソウ"
				},
				{
					"id": 50270202,
					"content": "君なら、玉ねぎになれるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270203,
					"content": "玉ねぎ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "マソウ"
				},
				{
					"id": 50270204,
					"content": "平凡そうに見えるが、手を出そうとするやつに涙を流させる存在だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270205,
					"content": "本当？すごく強そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "マソウ"
				},
				{
					"id": 50270206,
					"content": "何言ってんだ、こいつら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50270207,
					"content": "玉ねぎはすごいぞ。前回友人の家に行ったとき、ちょうどそいつが玉ねぎを切っていた、涙を流しながらな。しかも泣いていたのは彼だけじゃない、竜も同じだった。最後は部屋にいた生き物がことごとく泣く羽目になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270208,
					"content": "アンタは大丈夫だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50270209,
					"content": "僕も部屋にいたが、すぐマントで目を覆った。カクークとイファには僕の顔が見えなかったから、僕も一緒に泣いていると思い込んでいたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270210,
					"content": "僕、玉ねぎみたいに人を泣かせられる男になりたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "マソウ"
				},
				{
					"id": 50270211,
					"content": "ああ。きっとなれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270212,
					"content": "この会話を止めさせたいけど、何て言えばいいか分からない…はぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50270213,
					"content": "イアンサなら、そうだな。小さな…キノコだ。うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270214,
					"content": "聞いてないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50270215,
					"content": "でも、キノコか…生命力が強そうで悪くないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50270216,
					"content": "じゃあ、イアンサお姉さんは生命力の強い人なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "マソウ"
				},
				{
					"id": 50270217,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50270218,
					"content": "そういうことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イアンサ"
				}
			]
		}
	]
}