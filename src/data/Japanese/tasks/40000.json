			"dialogs": [
				{
					"id": 400000201,
					"content": "こんにちは！あなたも「機関棋譚」を試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000202,
					"content": "きかん…きたん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "おっと、まだ知らないみたいだね…「機関棋譚」は私が発明した机の上で遊べる「遊戯」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000204,
					"content": "机の上にある置物を見てみて、全部「機関棋譚」に使う道具なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000205,
					"content": "複雑そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "複雑そうに見えるだけで、実は簡単だよ。何回か遊べばすぐルールが分かるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000207,
					"content": "どう？試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000208,
					"content": "一局…いくら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "いやいや、今は海灯祭だもん、みんなにこの「機関棋譚」を遊んでもらいたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000211,
					"content": "だから、「霄灯」一つで一局遊べるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000212,
					"content": "遊びたいなら、「霄灯」を持ってきてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000213,
					"content": "ねぇ、試してみてよ、一回目は霄灯いらないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑞錦"
				},
				{
					"id": 400000209,
					"content": "値段が高そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
