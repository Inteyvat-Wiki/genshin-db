			},
			"dialogs": [
				{
					"id": 230080101,
					"content": "あとちょっとで成功しそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080102,
					"content": "旅人さん！ちょっと待ってくれ、旅人さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "スライムの液体を探してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080106,
					"content": "実はここ数日、あんたが持ってきてくれた泥土を、いろんな比率で混ぜて実験してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080107,
					"content": "失敗も多かったけどよ…ついに実用的な比率を発見したんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080108,
					"content": "この比率で混ぜた「セメン土」は固まる前はとても柔らかいが、固まった後は頑丈で耐久性が高いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080109,
					"content": "…と思うんだが、やっぱりスライムの液体が泥土に対して少ない気がするんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080110,
					"content": "だから旅人さん、至急スライムの液体を3個取ってきてくれないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080111,
					"content": "そのスライムの液体があれば、きっと俺の理想の泥土が完成するんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080104,
					"content": "また何か探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
		{
