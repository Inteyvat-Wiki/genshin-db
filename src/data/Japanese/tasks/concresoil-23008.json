			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アキム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "よかった！それだ！ちょっと待ってくれ。すぐにできるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080302,
					"content": "しばらく待った後。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "やっぱり、俺の推測は間違ってなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080304,
					"content": "湿った泥土は粘着性がいいが、固まると割れやすい。そこにトリックフラワーの泥土を混ぜると、固まっても柔軟性が保たれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080305,
					"content": "だが、その泥土は固まる前の可塑性に問題がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080306,
					"content": "そこにスライム生息地の泥土を混ぜることで、固まる前の可塑性も急激に改善したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080307,
					"content": "俺にも理由は分からんが、強いて言えば、泥土自体がスライムになったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080308,
					"content": "つまり「スライム土」だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "スライムの特性が泥土に影響するのは分かってたから、スライムの液体を直接加えればもっと効果が出ると思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080312,
					"content": "テストしてみたら案の定、スライムの液体の量によって、泥土の可塑性と強度が変化するのが確認できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080313,
					"content": "それはつまり、建築材料だけじゃなく、陶器にも、他の色々なものにも応用が利くってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080314,
					"content": "おめでとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "ありがとう、これが上の賢い連中がよく言う、「砂を集めて塔と成す」なんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080317,
					"content": "この泥土は地味かもしれないが、今に天に通じる塔を作ることもできるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080318,
					"content": "俺はこの混合型泥土のことを「セメン土」と呼ぶことにするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080319,
					"content": "さあ、次にしなきゃならないのは、この「セメン土」が何に使えるかの実験だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080320,
					"content": "長い間みんなを困らせていた家の問題も、やっと解決の糸口が見えたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080321,
					"content": "旅人さんには本当に感謝している。これは報酬だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230080315,
					"content": "やっと成果が出たね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "パイモンが好きそうだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "オイラは土なんて食べないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}