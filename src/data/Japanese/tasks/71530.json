					}
				]
			},
			"dialogs": [
				{
					"id": 715300101,
					"content": "#海灯祭を祝して。{M#お兄さん}{F#お姉さん}、それにお嬢ちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300102
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300102,
					"content": "おや、あんたたちは前に嘉明に会いに来た有名人じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300103
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300103,
					"content": "おまえ、前に会ったよな。嘉明と一緒に遊んでたやつだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300104,
					"content": "そうそう。覚えててくれたのか。俺ってばツイてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300105
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300105,
					"content": "あんたたちは達人で、何でもできるんだってな。毎日ぶらっとチ虎岩まで買い物に行くんだけど、道中でよくあんたたちの評判を耳にするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300106,
						715300107
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300106,
					"content": "#そう、{M#俺}{F#私}は何でもできる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				},
				{
					"id": 715300108,
					"content": "お、おい！オイラにだって食べる以外の才能があるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300109,
					"content": "えと…そうだな…他になにができるかっていうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300110,
					"content": "そうだ！普通の人は浮かんだりできないもんな。あんたは白くてふわふわで、まるで小さな鳩仙人みたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300111
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300111,
					"content": "飛べるだけでもすごいさ。物を運ぶのも便利だし、楽に動ける。しっかり友だちを助けてやれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300112,
						715300113
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300112,
					"content": "パイモンは鳩仙人だったの！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300114,
					"content": "#鳩の仙人が本当にいるかって話は置いといて…オイラ、いつも{NICKNAME}のことを手伝ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300115,
					"content": "#たとえば、高いとこから落ちた時とか、オイラが{NICKNAME}を引っ張って、ぶつかってもあんまり痛くないようにしてやったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300116,
					"content": "#そんなに力があるわけじゃないから、強くは引っ張れないけどな…。オイラが本物の鳩仙人なら、{NICKNAME}が風の翼を使う時に引っ張って、もっと遠くまで運んでやるのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300117,
					"content": "たくさん練習すればいいさ。俺と嘉明の獣舞みたいにな。一緒に練習する時間が長くなればなるほど、気持ちが通じて、息がぴったり合うようになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300118
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300118,
					"content": "ちょうど、新しくておもしろい遊びを考えたんだ。「ドッシン獣舞劇」っていうんだけど、やってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300119
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300119,
					"content": "息を合わせる練習にもなるし、獣舞劇の理解にも役立つぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300120
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300120,
					"content": "「ドッシン獣舞劇」？まさかおまえのそばにあるおっきなぬいぐるみか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300121,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300122
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300122,
					"content": "本格的な獣舞劇は習得するのが難しい。プロに教えてもらっても、合わなかったり、根性がなかったりしたら続かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300123
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300123,
					"content": "だから、獣舞劇の舞の一部に手を加えた。道具を換えて、このゲームを作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300124
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300124,
					"content": "ちょうど海灯祭だし、みんなを楽しませたくてさ。食前の運動、食後の消化にってとこだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300125
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300125,
					"content": "この衣装を着て、誰が一番多く餅茶を入手できるか競うんだ。ぶつかり合いっこもできて楽しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300126
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300126,
					"content": "おもしろそうだな。でも、そんなおっきな衣装を着て誰かと遊ぶなんて、オイラの体力じゃちょっと無理そうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300127,
					"content": "#{NICKNAME}はこの手のゲームが得意だろ！オイラはまず隣で見学して学んどくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300128,
						715300129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300128,
					"content": "うん。じゃあ踊ってみる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300130,
					"content": "あれ？鳩仙人は自分でやらないのか？ちょっと残念だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300131
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300131,
					"content": "#大丈夫だぞ。オイラと{NICKNAME}はず～っと一緒に旅してきたんだし、これからだってそうだ。息を合わせる訓練をするチャンスなんてたっくさんあるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300132,
					"content": "#それに見てるだけでも、{NICKNAME}と息を合わせるコツを色々掴めると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715300133,
					"content": "ハハッ！あんたたちは仲がいいんだな。羨ましいくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300134
					],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300134,
					"content": "#じゃあ、有名人の{M#お兄さん}{F#お姉さん}に「ドッシン獣舞劇」を体験してもらおうか。小さな鳩仙人も楽しんで見てくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "遐慶"
				},
				{
					"id": 715300129,
					"content": "うん。じゃあぶつかってみる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300113,
					"content": "変なあだ名が増えたね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300107,
					"content": "パイモンは食べる達人だよね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				}
			]
		}
	]
}