			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー",
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "…あのね、ガイアお兄ちゃん。前にお話しの続きを教えてくれるって、約束してくれたでしょ。瓶の中のジンニーの物語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401171302,
					"content": "いいぜ。そうだな…前はどこまで話した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171303,
					"content": "クレー覚えてるよ、「魔瓶」の中から出てきた「ジンニー」が、瓶を開けた牧童をがぶっと食べようとするところ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401171304,
					"content": "そうだったな。悪いジンニーが口を大きく開けた瞬間——牧童は突然閃いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171305,
					"content": "ボンボン爆弾をジンニーの口に投げたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401171306,
					"content": "ははっ、もしもそのとき牧童の近くにボンボン爆弾があれば、きっとそうしただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171307,
					"content": "だが、牧童は爆弾を見たこともなかったから、ジンニーにこう言うしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171314,
					"content": "「待ってくれ。お前の体はこんなにデカいのに、本当にその瓶の中から出てきたのか？この目で見ない限り、そんなデタラメ信じないぞ！」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171308,
					"content": "ジンニーはかんかんになって、こう言った——「ぐぬぬ、牧童め。汝ごときに舐められてたまるか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171309,
					"content": "そしてジンニーは瓶の中へと潜り込んだ。それを見た牧童は、たちまち栓で瓶の口を封じてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171310,
					"content": "やった！これで悪いジンニーも二度と出てこられないね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401171311,
					"content": "でも…ずっと瓶みたいな小さなところに閉じ込められちゃうんだよね…悪いジンニーはちゃんと眠れるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401171312,
					"content": "悪いことをして、捕まったから閉じ込められちまったんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401171313,
					"content": "だから——悪いことをしても閉じ込められたくなかったら、一番肝心なのは捕まらないことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "ガイア"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
