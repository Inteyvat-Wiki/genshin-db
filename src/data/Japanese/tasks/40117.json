				"points": []
			},
			"dialogs": [
				{
					"id": 401171501,
					"content": "自信満々にアリスさんと約束したばかりなのに、蜃境がこんな大騒ぎになっちゃうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "イディア"
				},
				{
					"id": 401171502,
					"content": "で、でも、「軍師」さんの言ってた通り、蜃境を元通りに戻すことさえできれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イディア"
				}
			]
		},
		{
			"id": 4011716,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
