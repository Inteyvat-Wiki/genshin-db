						"position": [
							-2156.834,
							174.01,
							5993.106
						],
						"pointId": 3965
					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "おお、ありがとう！勇敢な冒険者よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120102,
					"content": "よかったよかった…さほど時間が経っていなかったからか、パーツはあまり壊されていない…少し修理すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120103,
					"content": "ヴィナヤックは機械を夢中でいじり始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "…ヴィナヤック？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120105,
					"content": "ああ…もうすぐだから！あと少しだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120106,
					"content": "——ヴィ·ナ·ヤック！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120107,
					"content": "うああっ！シュリヤ？いつからここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120108,
					"content": "#{M#君}{F#あなた}がパーツをいじり始めた頃から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "ここには魔物がいるから危険だって、君が言ったんだろ？どうしてその君までここに来た？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120110,
					"content": "…私たちのパーツが心配になっただけ。任務が終わらなくて、私まで教令院に戻れなくなるって事態を避けるためよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120111,
					"content": "はっ、思った通りだ——これを見てくれ、全部回収したぞ。帰ってさらに調整すれば、組み立て始められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120112,
					"content": "そういえば、なんの機械のパーツなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735120113,
					"content": "おっと、紹介し忘れてしまっていたな——これは「対ウェネト殺蟲大砲」さ。僕たちの学生時代の卒業プロジェクトだったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120114,
					"content": "——なんでそんなマイナーなテーマなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735120115,
					"content": "君も卒業課題に取り組んだことがあれば、理由がわかったはずだよ…コホン、とにかくそれは重要じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120116,
					"content": "改めて自己紹介させて。私はアムリタ学院を卒業した学者で、シュリヤというの。専攻は砂漠生物学と環境学よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120117,
					"content": "…そしてこっちの機械バカはクシャレワー学院出身の学者で、専攻は応用ギミック術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120118,
					"content": "——僕の名はヴィナヤックだ。先ほどはありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120119,
					"content": "専攻がぜんぜん違うじゃないか…そんなんで協力関係を結べるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735120120,
					"content": "そこなのよね…そもそも、研究計画のためにこいつと卒業課題に取り組むって決めたこと自体が、間違いなく私の学生時代の一番大きな間違いだったのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120121,
					"content": "そんなことないと思うけど。ほら、互いに無事卒業できたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120122,
					"content": "はっ、おっしゃる通りね！同級生たちより何年遅れたか、思い出させてやりましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120123,
					"content": "それでもちゃんと卒業はできただろ？去年ようやく計画が通った人もいるって聞いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120124,
					"content": "ああ…もうたくさん！こんな無意味な言い争いは、学生時代に散々味わったので充分よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120125,
					"content": "けど毎回、君のほうが先に言い出すんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120126,
					"content": "はぁ？初めてプロトタイプを作る時だって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120127,
					"content": "ストップストップ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "まったく…こんなに仲が悪いとはな。教令院はどうしておまえら二人にこの件を任せたんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735120130,
					"content": "はぁ、教令院に任せてもらった、とは言えないけどね…実は、この件はもともと、うちの学院のクナルが責任を持って管理していたことなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120160,
					"content": "彼は私たちの先生の、そのまた先生だとも言えるわ。当時、私たちの卒論の答弁も聞きに来てくれたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120161,
					"content": "もしかするとその時に、「学院の若者がなんとかウェネト砲を作ったことがある」って印象を与えちゃったのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120162,
					"content": "そんなこんなで今回、「若者をもっと輝かせるべきだ！」とか何とか言って、この件の解決を無理矢理私たちに任せたってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120163,
					"content": "お互い卒業してから、連絡もろくに取ってないって言うのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120131,
					"content": "僕の指導教員まで彼の説得に心を動かされてしまった…だが、これはこの「対ウェネト殺蟲大砲」の名を再び世に轟かせるチャンスだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120132,
					"content": "組み立てが終わったら、あの虫ケラどもを懲らしめてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120133,
					"content": "まーた始まった、この機械バカが。…でも私も、砂漠の生態バランスを維持するために、これらのウェネトが暴れる原因を究明したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120134,
					"content": "冒険者さん、あなたって凄腕なんでしょう。私たちが砂漠に滞在している間、身の安全のためにあなたを雇えないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120135,
					"content": "充分なモラをお持ちなら何でもどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "安心して。今回の任務については、他のサポートはともかく、経費だけは十分に用意してくれてるから…機械をアップグレードするために、誰かさんがその大半を使ってるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120138,
					"content": "そ、それはすべて必要な出費だ！…というか君、そうやって普通に喋れるんじゃないか。なんで僕と話すときはいつもツンツンしてるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120139,
					"content": "——ッ、それは話す対象にきちんと接する価値があるかどうかによって決めることなの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120140,
					"content": "はぁ、こいつら、また始まったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735120141,
					"content": "後で好きなだけケンカしていいから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "あっ…ごめん。学生時代からの癖でつい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120144,
					"content": "これらのパーツはまずアアル村に運んでさらに調整しないといけないから、単純計算で、早くても組み立ては明日になるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120145,
					"content": "私たちの計画では、付近にウェネトが出没する場所に、「対ウェネト殺蟲大砲」を設置することになってるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120146,
					"content": "設置音で他の魔物を引き寄せてしまうかもしれないから——その時が来たら、あなたの出番よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120147,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "さあ、シュリヤ。もうさっきの続きを話していいだろう？僕が使った経費にはちゃんと正当な理由があるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735120150,
					"content": "あなたッ…！まだ言うのね？いいわ！とことん付き合ってあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735120148,
					"content": "また明日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "まず仕事内容を説明してくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "このくらい、お安い御用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
					"content": "もういい加減にして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				}
			]
		}
	]
}