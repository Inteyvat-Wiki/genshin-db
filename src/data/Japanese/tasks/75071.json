			"dialogs": [
				{
					"id": 750711001,
					"content": "#ハハッ、愛しの{NICKNAME}とパイモン！我がミューズと…ええと、小さなミューズよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711002,
					"content": "#ああ、それに{REALNAME[ID(2)|SHOWHOST(true)]}もだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711003,
					"content": "今どっちに小さいって言ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711004,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "ハハッ、そう気にするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711006,
					"content": "フン、オイラは気にするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711007,
					"content": "また何かアイデアが浮かんだの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "もちろんさ。ただ…ええと、ハハッ、新しいアイデアがあるってことは…また君たちの助けが必要ってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711009,
					"content": "いいぜ！モラはちゃんと払ってくれるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711010,
					"content": "ハハッ、もちろんだ、小さなバイトちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711017,
					"content": "あれを見ろ。今回はテペトル竜を撮りたいんだ…シーッ、驚かすなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711018,
					"content": "この種類の竜と接触するのは初めてでな、しばらく見てたんだが…本当に魅力的な生き物だ…ごつごつとした外見の下には個性が隠されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711019,
					"content": "ハハッ、何回かエサをやってみたらな、今じゃ簡単な指示は分かるようになったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711020,
					"content": "そこで、マスターテイマーには、はぐれたテペトル竜と交流することを頼みたい。他の仲間と遊ぶところが撮りたいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711021,
					"content": "どうだ、簡単だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711022,
					"content": "おう、そんなの朝飯前だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711023,
					"content": "（やるのはこっちなんだけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "ハハッ、その調子だ！さあ、はぐれたテペトル竜を連れてきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711024,
					"content": "（朝飯前じゃないかも…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "またこのムースの手伝いが必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "ムース…食べたくなってきちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711013,
					"content": "グルル…グルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "いや…「ミューズ」だ、女神のな！…食べ物じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750711015,
					"content": "へへっ、先にモラを渡してくれれば、食べ物に変えて来てやってもいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750711016,
					"content": "まあ、そこは重要じゃない…モラはちゃんと用意してある。タダ働きさせたりはせんさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "マニフェコ"
				}
			]
		},
