			"trigger": {
				"objectNames": [
					"阿倍良久",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "ああ…当時の白夜国に、汝のような勇士がいれば、あるいは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480202,
					"content": "はぁ…このことが終われば、吾も心残りが消える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480203,
					"content": "どうか…吾の想いを乗せたこの供え物を、吾が監禁されし場所に奉納してほしい。そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480204,
					"content": "そうすれば、どうなるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480205,
					"content": "そうすれば…そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480206,
					"content": "うぅ、この残魂さん、もうなにも言わなくなっちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}、とりあえず供え物を持っていこうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480208,
					"content": "でも残魂さんが監禁されてる高い場所って、どんなところなんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
