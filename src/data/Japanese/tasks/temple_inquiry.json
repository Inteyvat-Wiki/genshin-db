					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480602
					]
				},
				{
					"id": 722480602,
					"content": "では、静かにここで汝を待とう。",
					"roleType": "TALK_ROLE_NPC",
