			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"パイモン",
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "残魂が現れたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480302,
					"content": "吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480303,
					"content": "吾は、ヘリオスの建造者——阿倍良久なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480304,
					"content": "吾は貴様らの戯れ言に屈せぬ！貴様らの傀儡である子供に監禁されるわけにはいかぬのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480305,
					"content": "吾は…なっ…吾は監禁されし場所で生涯を終えたのか…これは、死後の身か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480306,
					"content": "死後の身？もう自分が死んでるってわかるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480307,
					"content": "そのことに気づける残魂って、けっこう珍しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480308,
					"content": "だが、死んだ理由について、もう思い出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480309,
					"content": "ただ覚えているのは…一人の子供によって、死ぬまで閉じ込められたことのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480310,
					"content": "一人の子供？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480311,
					"content": "いかにも。だが今はもう、その子供に恨みはない。ただ、哀れみを感じるのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480312,
					"content": "間違っていたのは、あの子ではない。間違っていたのは、あれを手のひらで操る…いや、これを話しても詮無きこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480313,
					"content": "ただその後、吾は監禁された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480314,
					"content": "とある場所に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480315,
					"content": "とある場所？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480316,
					"content": "非常に高き場所だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480317,
					"content": "高いが、日の光はなく、氷のように冷たかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480318,
					"content": "…おかしい、なぜだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480319,
					"content": "なぜ吾は、高い場所が暖かくあるべきだと思っていた…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480320,
					"content": "なぜ…なぜ吾は何も思い出せない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480321,
					"content": "うーん、おなかが空いてるとかじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480322,
					"content": "オイラもおなかが空いてると、頭を働かせるどころか、会話すらまともにできなくなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480323,
					"content": "たぶん、それじゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "いや、ぜったいそうだって！ほら、この残魂さん、もう話もまともにできないみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480327,
					"content": "そうだ、辺りに供え物がないか探してみようぜ。それなら、きっと食べ物があるはずだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480328,
					"content": "そうだ！供え物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480329,
					"content": "ん？供え物が食べたくなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480330,
					"content": "いや、吾は思い出したのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480331,
					"content": "吾が監禁されて死した後、ヘリオスを建造した功績により、遺体と衣服は各地に奉納された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480332,
					"content": "だがそれが原因で、魂は散り散りになり、安らぎを得られないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480333,
					"content": "ここには吾の聖冠が納めてあるが、すでに朽ち果てている…吾の頭が働かないのも、そのせいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480334,
					"content": "長き時が経ったゆえ、今の状態を維持するだけでも困難なことなのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480335,
					"content": "だが幸い、これらの供え物は遺体や衣服の代わりに、吾の想いを込めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480336,
					"content": "頼む、吾の代わりにこれを持っていってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480337,
					"content": "だが道中、多くの危険に見舞われるだろう。嫌気が差すこともあるかもしれぬが、それでもこの試練を受けてはくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480338,
					"content": "試練？なんだよ試練って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722480339,
					"content": "吾の残魂を見張っている怪物を倒してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480340,
					"content": "これは極めて危険なことだ。旅人よ、準備ができたら、吾に言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480325,
					"content": "ちょうどここに非常食があるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "パイモン"
				}
			]
		},
