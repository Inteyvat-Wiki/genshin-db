			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360601,
					"content": "旅人、また会ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360602,
						210360604
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360602,
					"content": "まだ鍛錬しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "そうだ、ただ…本当に大変だった。自分に実力がないからなのか、それとも鍛錬のしかたが間違っていたのかはわからないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360608,
					"content": "それより、前回君に同行した時、君の技と動きから大いにひらめきを得たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360609,
					"content": "旅人、もう一度鍛錬に付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360610,
					"content": "ここで鍛錬したことがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "幸い、ある優しい冒険者に出会った。彼女は「共に協会の依頼を遂行する」という名目で私をここに連れてきてくれたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360614,
					"content": "それに、鍛錬の計画を立ててくれたり、様々な助言をくれたりもしている…ただその代わりに、彼女と一緒に冒険者協会の依頼を処理しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360615,
					"content": "コホンッ…それより本題に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360616,
					"content": "実は、私は自分のために訓練の計画を立てたのだ——それには「敵との戦い」と「野外進行訓練」の二つの項目が含まれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360617,
					"content": "旅人、どちらかの項目の訓練に付き合ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360611,
					"content": "こんなところまで来て鍛錬してるとは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "はぁ…恥ずかしい話だが、ここは地形が険しく魔物も多いと聞いたもので、鍛錬の場所としてちょうどよいと思っていた。まさか、ここに入るのもそう簡単ではなかったとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360604,
					"content": "妹弟子はまだ構ってくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "コホン…小鳥は…いつも街に用事があるとか言って、戻ってこないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360606,
					"content": "小鳥のところに何回か行ったが、彼女はいつもシニャクに対応させるだけで、当人は会ってくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360607,
					"content": "はぁ、一体どうすれば小鳥をなだめられるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孫宇"
				}
			]
		},
