			},
			"dialogs": [
				{
					"id": 210360701,
					"content": "ふぅ…はぁ…大変だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360702,
					"content": "すまない、恥ずかしいところを見せてしまったな。いざ敵に立ち向かう時になって、まさかこんなに緊張してしまうとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360703,
					"content": "とにかく…私にはまだまだ鍛錬が必要だ。旅人、どうもありがとう。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360704,
					"content": "本当に璃月を出るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "それはまだ決めていない…もう少し、考える必要がある。それにもう一度小鳥を説得してみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
