					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "ふぅ…はぁ…大変だったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360402,
					"content": "すまない、また恥ずかしいところを見せてしまったな。どうやら、私はあまり成長していないようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360403,
					"content": "まだまだ鍛錬が必要だ…ありがとう、旅人。これは報酬だ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360404,
					"content": "どうやって璃月を出るつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "うん…今の予定では、あの商人の船に乗って、水路で外へと旅立つつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360406,
					"content": "最初の目的地は…まずはフォンテーヌに行って、しばらく滞在した後、その後の計画を立てたいと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360407,
					"content": "はぁ、小鳥に一緒にきてもらうよう説得できるかどうかは…依然分からないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103605,
			"completionStepIds": [
				2103605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
