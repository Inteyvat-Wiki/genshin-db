			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "野外進行訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "それがいい。あの冒険者が野外進行のルートを計画してくれたんだ…はぁ、ここで鍛錬ができるのも、彼女のおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360303,
					"content": "早くゴールに到達すればいいだけだと彼女は言うが…私は毎回時間がかかり過ぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360304,
					"content": "だから、どうすれば「野外進行」を早くこなせるのか見せてくれないか。私は後ろから頑張ってついていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360305,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "では頼むよ、まずは訓練場所に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360306,
					"content": "しっかりついてきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "コホン…が、頑張ってみよう。だが正直に言うと、私は脚にはそれほど自信がなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103604,
