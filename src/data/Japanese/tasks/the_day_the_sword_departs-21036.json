			"dialogs": [
				{
					"id": 210360801,
					"content": "はぁ…ふぅ…はぁ…な、何で君はこんなに速く走れるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360802,
					"content": "#{M#君}{F#あなた}が遅すぎるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "私の負けだ、負けを認めよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360806,
					"content": "はぁ…やっと息ができるようになった。まさかこんなに「野外進行」が疲れるものとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360807,
					"content": "手本を見せてくれてありがとう、旅人。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360804,
					"content": "#{M#君}{F#あなた}にはまだまだ鍛錬が必要みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "そ…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "孫宇"
				}
			]
