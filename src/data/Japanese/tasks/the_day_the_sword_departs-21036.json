			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "旅人、また会ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360102,
					"content": "まだ鍛錬しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "そうだ、ただ…本当に大変だった。自分に実力がないからなのか、それとも鍛錬のしかたが間違っていたのかはわからないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360108,
					"content": "それより、前回君に同行した時、君の技と動きから大いにひらめきを得たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360109,
					"content": "旅人、もう一度鍛錬に付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360110,
					"content": "前回と同じく、「敵との戦い」と「野外進行訓練」、どちらかの鍛錬に付き合ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360104,
					"content": "妹弟子はまだ構ってくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "コホン…小鳥は…いつも街に用事があるとか言って、戻ってこないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360106,
					"content": "小鳥のところに何回か行ったが、彼女はいつもシニャクに対応させるだけで、当人は会ってくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360107,
					"content": "はぁ、一体どうすれば小鳥をなだめられるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孫宇"
				}
			]
		},
