			"dialogs": [
				{
					"id": 210360901,
					"content": "野外進行訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "それがいい、前回の野外進行のルートに従って訓練しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360903,
					"content": "早くゴールに到達すればいいだけだとあの冒険者は言ってたが…私は毎回時間がかかり過ぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360904,
					"content": "だから、どうすれば「野外進行」を早くこなせるのか見せてくれないか。私は後ろから頑張ってついていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360905,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "では頼むよ、まずは訓練場所に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360906,
					"content": "しっかりついてきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "コホン…が、頑張ってみよう。だが正直に言うと、私は脚にはそれほど自信がなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "孫宇"
				}
			]
		}
	]
