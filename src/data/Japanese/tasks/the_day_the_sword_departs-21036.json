			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "はぁ…ふぅ…はぁ…な、何で君はこんなに速く走れるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360502,
					"content": "#{M#君}{F#あなた}が遅すぎるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "私の負けだ、負けを認めよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360506,
					"content": "手本を見せてくれてありがとう、旅人。お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360507,
					"content": "小鳥について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "小鳥は…はぁ、まだ私と話したくないようだ。い、一体どうすれば彼女をなだめられるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360509,
					"content": "はぁ…物事を両立するというのはどうしてこんなに大変なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360510,
					"content": "あの冒険者について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "あの冒険者のことか？あぁ…彼女には冒険者協会で出会ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360512,
					"content": "彼女は協会の依頼で層岩巨淵に行くと言っていた。私も入りたいと言うと、ついでに連れてきてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360513,
					"content": "その代わり…彼女が依頼をこなすのを手伝うことになった。だがそのほとんどは物探しだから、そんなに複雑ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360514,
					"content": "ただ…彼女はよく喋るのでな…私は実のところ苦手なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360504,
					"content": "#{M#君}{F#あなた}にはまだまだ鍛錬が必要みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "そ…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孫宇"
				}
			]
		},
