			"dialogs": [
				{
					"id": 210360201,
					"content": "敵との戦い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "良いだろう。習った剣術を活かしたいと以前から思っていたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360203,
					"content": "#{M#俺}{F#私}の動きを目で追うので精一杯かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "おっと…君、そんなに腕が立つのか？ハハハ、それなら少しゆっくり動いてもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360205,
					"content": "そうだな…ちょうどこの近くに魔物の集落が一つある。まずはそこに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
