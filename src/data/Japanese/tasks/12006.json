			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "この店か？通りに面した開放的な店だな、確かに親しみやすそうだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060102,
					"content": "いらっしゃいませ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060103,
					"content": "木南さん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060104,
					"content": "あっ、神里さま、時間ぴったりですね！予約してた時間通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060105,
					"content": "はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060106,
					"content": "注文内容は以前予約した通りに。それと、事前に言っておいたことも…お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060107,
					"content": "はい、わかりました。もうすべて準備してあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060108,
					"content": "旅人とそこの小さいお客さんはこちらへどうぞ。私は料理の準備をしてくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060109,
					"content": "旅人さん、パイモンさん、どうぞお掛けください。私は少々席を外します、すぐに戻りますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060110,
					"content": "何か緊急事態？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "い、いえ…そういうことではございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060113,
					"content": "いくつか些細なことを処理し終えたらすぐに戻ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060114,
					"content": "行っちゃったな…なんか急いでたみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060115,
					"content": "お二人は神里さまのお友達なんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060116,
					"content": "ふふ、私のお店の料理は庶民的なものばっかりで、高級とは言い難いけど…味には自信があるよ！気に入ってくれると嬉しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060117,
					"content": "お店ももう長いことやってるから、神里家の方とも交流が深いの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060118,
					"content": "神里家の兄妹は二人とも私の店の味が好きで、昔はよく人に頼んでうちの料理をお持ち帰りしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060119,
					"content": "でもまさか、神里さまが自分で店に来るなんてね。それにお友達も連れて。あの方がお友達をご飯に誘うところなんて初めて見たよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060120,
					"content": "初めてなのか！オイラたち誇っていいよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060121,
					"content": "そうなの…こう言ったらあれだから、あなたたちだけに言うけど…私の知る限り、神里さまってお友達があまりいないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060122,
					"content": "すごく意外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "どうしてだ？人もいいし、礼儀正しいし、みんなから好かれてるはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060124,
					"content": "私もそう思ってたんだけど、対人関係ってそうもいかないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060125,
					"content": "神里さまは容姿端麗で高貴な身分、それに優雅な振る舞いからまるで高嶺の花だって近所の人たちはみんなそう言ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060126,
					"content": "完璧すぎるのは、逆に距離感を生むのかもね。普通の家の子はあの方に話しかける勇気すらないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060127,
					"content": "あんなにいい子なのに、友達ができないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060128,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060129,
					"content": "交流は少なくとも、私はもう長いこと神里さまのことを知ってるからね。あの方が若くして色々な責任を背負ってることは本当に尊敬するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060130,
					"content": "だから、今日は神里さまがお友達を連れて来たのを見て、私もすっごく嬉しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060131,
					"content": "たくさん食べてね！よかったら、あの方ともっとお話をしてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060132,
					"content": "私たちここ一帯に住む人たちからのお願いだと思ってさ、頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060133,
					"content": "あっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060134,
					"content": "ん？綾華の声？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060135,
					"content": "すみません、旅人さん…えっと、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060136,
					"content": "何か爆発音が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "私と一緒にこちらへ来てくれませんか。頼みたいことが…ございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060139,
					"content": "すみません！急に呼び出してしまって。実は、その…私が先ほど作った料理が失敗してしまい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060140,
					"content": "あの音は鍋が吹っ飛んだ音だったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060141,
					"content": "見ての通り、この家は料亭の隣にある店主の私邸です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060142,
					"content": "この庭も私有地で、ある特別な料理を作るため道具と食材の用意を店主に手伝ってもらったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060143,
					"content": "どうして料理を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "そうだぞ、料理が食べたいなら、店で注文すればいいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060145,
					"content": "私が作りたかったのは…「椿」さんへの手土産でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060146,
					"content": "お母様の手記には、「椿」さんは異国料理がお好きだと書かれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060147,
					"content": "今回「椿」さんに会うため、異国料理を作ってお渡しした方がいいと思い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060148,
					"content": "異国料理…稲妻料理じゃなければいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060149,
					"content": "それだったら、選べるものがたくさんあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060150,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}、実は腕利きの料理人なんだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "私もそうなのではないかと思っていました！貴方みたいな各地を旅する方であれば、きっと様々な美食を知り尽くし、知識にも富んでいるのではと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060154,
					"content": "料理を作っていただけませんでしょうか？どうかお力添えを…もちろん、お礼はきちんといたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060155,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "どのような異国料理なら贈り物に最適でしょうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060158,
					"content": "オイラ知ってるぞ！この類の料理なら、あれしかないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060159,
					"content": "「ピザ」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060160,
					"content": "ピザ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060161
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060161,
					"content": "おう、具材とソース、そしてチーズを生地の表面に乗せて焼いた食べ物だぞ。すっごく美味しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060162,
					"content": "それはとても美味しそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060163
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060163,
					"content": "この中に稲妻ならではの味を加えることはできませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060164
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060164,
					"content": "ピザに何を入れても問題ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060156,
					"content": "#やっと{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の出番。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060152,
					"content": "異世界料理も得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060153
					]
				},
				{
					"id": 120060153,
					"content": "おい——変なこと言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060137,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060111,
