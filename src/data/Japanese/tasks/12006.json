					"nextDialogs": [
						120060241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060241,
					"content": "この自信作、きっとオイラたちの威名と共に稲妻に受け継がれていくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060242,
					"content": "はい、こんなに美味しそうな料理ですから、きっと間違いないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060243
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060243,
					"content": "じゃあ、早くこのレシピを店主に渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060235,
					"content": "鳴草+ユウトウタケ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060236
					]
				},
				{
					"id": 120060236,
					"content": "うぇ…おまえどんどん香菱に似てきたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060237,
					"content": "えっと、すみません。しゃんりんとは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060238
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060238,
					"content": "すごく腕のいい料理人の友達だ！ちょっと変な趣味してるけど…オイラはそいつのこと好きだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060230,
					"content": "ウミレイシ+スミレウリ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060231
					]
				},
				{
					"id": 120060231,
					"content": "えっ…？本気か？わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "パイモン"
				}
