			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "あっ、レシピは書けましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060601,
					"content": "書けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060602,
					"content": "ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060603,
					"content": "わぁ～楽しみだな。早く新しい料理が作りたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060604,
					"content": "旅人さん、パイモンさん、お食事の時間を邪魔してしまい申し訳ございませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060605,
					"content": "へへ、働いたあとの方が食事も美味しいから大丈夫だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060606,
					"content": "熱いうちに食べましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060607,
					"content": "どうでしょうか、稲妻の料理はお口に合いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060609,
					"content": "すごく気に入った、好きな味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "特別な味わいがする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "美味しい！これも美味しいし、あっちにあるのもすっごく美味しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060611,
					"content": "うふふ、安心しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060612,
					"content": "ところで、先ほど私があちらで料理を作ろうとしていた時、店主さんと何か話をされていませんでした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060613,
					"content": "その…私のことについて話していたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060614,
					"content": "ちょっとだけ話したな。でも、おまえのことで嬉しかったから話しただけで、別に変なことは言ってなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060615,
					"content": "私のことで…嬉しかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060616,
					"content": "うぅ…やはり言ったのですね！彼女はあれも言ったのでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060617,
					"content": "はぁ、もういいです。私に友達が少ないのは自分でも分かっていますので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060618,
					"content": "別におかしなことじゃないぞ、他の人がおまえと話す機会がなかなかないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060619,
					"content": "慰めてくれてありがとうございます、パイモンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060620,
					"content": "それはすべて事実です。私はあまり友達と呼べる方がおりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060622,
					"content": "そんなことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が綾華の友達だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "普段から近くにいるのは家族や配下の者のみ。ですので皆さん、私が貴方がたを誘ったことに驚いているのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060624,
					"content": "そうだぞ、おまえに友達はいる。オイラたちだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060625,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060626,
					"content": "ありがとうございます！私、とても嬉しく思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060627,
					"content": "あっ、すみません…お恥ずかしい姿を見せてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060628,
					"content": "なにか抱えてるなら、我慢しないで発散しろよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060629,
					"content": "はい！それと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060630,
					"content": "私も貴方がたを大切なお友達だと思っております。とても…嬉しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060631,
					"content": "いいんだぞ。オイラたち、良くしてくれた人にはこっちも良くするって決めてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060632,
					"content": "おまえも、お母さんの手記からその「椿」っていう人に会いたいって思っただろ。友情っていうのは、色んな人に影響をもたらすことができる。だから、すっごく重要なものなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060633,
					"content": "はい！友情は私にとってとても貴重なものです。貴方がたとの縁、大切にします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060634,
					"content": "でもそういえば、その「椿」って人、いったい何者なんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060636,
					"content": "聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "そのことについて、簡単にではございますがある憶測があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060638,
					"content": "……？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "私が思うに、「椿」さんは…「狐神使」かもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060639,
					"content": "「狐神使」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060640,
					"content": "はい、私はそう思っております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060641,
					"content": "私ですらお母様からそのような友人のことは聞かされていませんでした。その神秘的な存在、きっと普段では見ることが叶わない貴人なのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060642,
					"content": "稲妻には古くから狐神使に関する逸話がございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060643,
					"content": "もうすでに八重宮司にはお会いしていますよね？彼女も狐神使ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060644,
					"content": "この方面から推測するに、稲妻の地にはまだ知らない狐神使が他にも存在する可能性がございます…そしてその「椿」さんこそ、その中の一人なのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060645,
					"content": "それって、稲妻にも仙人がいるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060646,
					"content": "稲妻「にも」とはいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060647,
					"content": "稲妻に来る前は璃月に行ってたんだ。璃月には仙人がたくさんいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060648,
					"content": "空を飛んだり、地下を駆けたり、水中を泳いだり、土に埋まったり…色んなやつがいたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060649,
					"content": "私も本でそのような話を読んだことがございますが、実際に聞いてみるとやはり驚きを隠せません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060650,
					"content": "さすが璃月…古くからの文化が美しき伝説を生み出しているのですね。憧憬の念を抱かざるを得ません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060651,
					"content": "機会があったら一緒に璃月に行ってみようぜ。あそこには美味いもんがいっぱいあるんだ、すごいんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060652,
					"content": "本当ですか？楽しみです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060653,
					"content": "しかしその前に、旅人さん、パイモンさん、今回の食事は満足できましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060654,
					"content": "もちろん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060655,
					"content": "それでは着物を受け取って、稲妻の神秘的な貴人に会いに行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
