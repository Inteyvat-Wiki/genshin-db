					"content": "キノコ+小麦粉",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060229
					]
				},
				{
					"id": 120060229,
					"content": "そう、それだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060232,
					"content": "じゃあ、二つ目の組み合わせを選ぶぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060233,
						120060235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060233,
					"content": "キャベツ+チーズ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060234
					]
				},
				{
					"id": 120060234,
					"content": "そうそう、それだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060239,
					"content": "あとは調理方法も書かないとな…「トレイに乗せて、適度な火加減で焼き上げる」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060240,
					"content": "できた！",
