			"dialogs": [
				{
					"id": 120060401,
					"content": "神里さま、こちらが完成したお着物です。もうすでに畳んで贈り物用の箱にしまっておきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060402
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120060402,
					"content": "あっ、それと神里さまが特別に用意したあれも、準備できてますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060403
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120060403,
					"content": "ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060404
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060404,
					"content": "本当に可愛い服だったので、作っててとても楽しかったです。こちらこそありがとうございました！またのお越しをお待ちしております！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060405
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120060405,
					"content": "旅人さん、私から一つ貴方へ贈りたい物がございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060406
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060406,
					"content": "えっ？本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060407
					]
				},
				{
					"id": 120060407,
					"content": "わぁ…高級品みたいだぞ、髪飾りかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060408,
					"content": "白鷺を題材にして作ったかんざしです。髪飾りにもできますし、置物としても使えますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060409
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060409,
					"content": "貴方をタダ働きさせるわけにはいきません。これを…どうぞ受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060410,
						120060411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060410,
					"content": "素敵なプレゼント、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				},
				{
					"id": 120060412,
					"content": "はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060413
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060413,
					"content": "そういえば、綾華の称号って「白鷺の姫君」だよな？このプレゼント、おまえと同じですっごく綺麗だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060414,
					"content": "パイモンさんは人を褒めるのがお上手ですね。それを見て私を思い出してくれるのでしたら、それだけで十分満足です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060415,
					"content": "えへへ、きっと見るたび思い出すさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060416,
					"content": "よし、じゃあ準備もできたし出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060417,
					"content": "「椿」って人のところに行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060411,
					"content": "大事にするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
