			"dialogs": [
				{
					"id": 120060201,
					"content": "焼けた焼けた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060202,
					"content": "うん、これが完成品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060203
					]
				},
				{
					"id": 120060203,
					"content": "香ばしい匂い…旅人さん、やはり料理がお上手なのですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060204
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060204,
					"content": "私も様々な料理を作れる腕の優れた料理人になりたいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060205,
					"content": "レシピがあればできるぞ。機会があれば今度もっとレシピを持ってきてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060206,
					"content": "はい、一緒に料理の心得を共有できることを楽しみにしていますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060207,
					"content": "二人とも、上手くできた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060208
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060208,
					"content": "あっ、これは…神里さま、欲しかった料理ってこれのことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060209
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060209,
					"content": "はい、旅人さんに手伝ってもらって作った異国料理でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060210
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060210,
					"content": "お持ち帰り用に包んでいただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060211
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060211,
					"content": "もちろんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060212
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060212,
					"content": "うん～香ばしい匂い！本当に美味しそうな料理ですね。ああ、私もこの料理をお店に出してみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060213
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060213,
					"content": "ふふん、作り方を教えてやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060214,
					"content": "えっ？いいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060215
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060215,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060216
					]
				},
				{
					"id": 120060216,
					"content": "食べ物はみんなで食べるともっと美味しくなるんだ。モンドのみんななら、この料理を稲妻の人たちに伝えても気にしないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060217,
					"content": "本当に？やった！前から異国料理を学びたいと思ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060218
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060218,
					"content": "作り方を書き写してくれれば、お店で販売して、一番目立つ位置に広告を載せるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060219
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060219,
					"content": "鎖国してからというもの、みんなもう長いこと新しい料理を食べてないの。旅人、本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060220
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060220,
					"content": "私は神里さまの料理を包んできますね。やることが終わったらみんなもこっちに来て、料理もできてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060221
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060221,
					"content": "高値で売れるものなのに、それを惜しみなく共有するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060222
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060222,
					"content": "…素敵です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060223
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060223,
					"content": "綾華はいつも褒めてくれるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060224
					]
				},
				{
					"id": 120060224,
					"content": "私は本気でそう思っているのです。とても…尊敬しています。貴方のような高潔な方と友人になれたこと、誇りに思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060225
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060225,
					"content": "それで、このレシピは書き写せばいいのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060226
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060226,
					"content": "#ああ、{NICKNAME}、オイラたちの好きな具材でピザを作りながら、その内容をレシピに書いて店主に渡そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120060227,
					"content": "じゃあ、ピザを作るぞ！一つ目の材料の組み合わせを選ぼう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060228,
						120060230
					],
					"speakerTitle": "パイモン"
				},
				{
