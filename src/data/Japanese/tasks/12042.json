						],
						"stepId": 1204209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420501,
					"content": "意識空間を離れて神社へと戻り、八重神子にすべてを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420502
					]
				},
				{
					"id": 120420502,
					"content": "現在の影が自らの意識空間に神櫻を植え、それが過去の稲妻で発芽した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420503,
					"content": "そう簡単には信じられぬ、実に奇怪な話じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420504,
					"content": "これらはすべて眞の力です。永遠に関して、彼女の理解は私より深いものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420505
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420505,
					"content": "「永遠」は時間と密接に結びついた概念です。永遠に触れれば、時間の概念が曖昧になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420506
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420506,
					"content": "空間に入る時、不思議な景色を見た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420507
					]
				},
				{
					"id": 120420507,
					"content": "時間が進んでいるのに、後退もしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420508
					]
				},
				{
					"id": 120420508,
					"content": "時間そのものに意味はなく、常理によって解釈することも不可能…なるほど、これこそが妾の感じた「乱流」じゃったわけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420509,
					"content": "もしかすると、汝らがあの時間に無事戻れたのは、それが原因だったのやもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420510,
					"content": "じゃが、あの乱れた感覚はもう消えておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420511
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420511,
					"content": "まだ私も完全には理解できていません。ただすべての根源が…あの種であると私の直感が伝えています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420512
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420512,
					"content": "ふむ…妾が思うに、眞の力だけでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420513,
					"content": "あなたが何を考えているのかは分かります。たしかに「より高{RUBY#[D]イスタロト}度な力」が関与していたかもしれません。ですが何がどうあれ、彼女のこの方法は、最後の最後で私たちすべての者を守ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420514
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420514,
					"content": "もし神櫻がなければ、稲妻は何百年も前に災いと穢れによって呑み込まれていたかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420515
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420515,
					"content": "汝が神櫻に奇妙な感覚を抱いておるのは知っておる。じゃが妾から言わせれば、神櫻はずっと存在していたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420516,
					"content": "昔、汝はこの神櫻が眞の意識空間とつながっていることを妾に証明しようとしたが、残念ながらうまくいかなかった。そうじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420517
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420517,
					"content": "ええ、ですがいま分かりました。あの時はまだ、神櫻が植えられていなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420518
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420518,
					"content": "でも、あの樹…今の姿とはぜんぜん違うと思うぞ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420519,
					"content": "神櫻は妾の縄張りに植えられたものじゃ。当然、妾の好みに合わせて剪定しておるに決まっておろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420520,
					"content": "ええ…そんな勝手にやっていいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420521,
					"content": "冗談じゃよ。発芽してから今まで、この樹は数多くのことを経験してきた。狐が精魂込めて世話してきたおかげで、今の形となったのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420522
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420522,
					"content": "妾と完全に無関係というわけでもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420523,
					"content": "汝らが空間を離れてから再び入るまでの間、時間は少ししか経っておらんかった。なのに、内部の戦いはすでに何百年も続いておった。そうじゃな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420524
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420524,
					"content": "妾が思うに…旅人、汝は妾の言いつけ通り、自身の願いを心の中で念じておったのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420525,
						120420526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420525,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420527
					]
				},
				{
					"id": 120420527,
					"content": "あの時、妾は影の居所を感知しておったが、同時に内部の「時間」の異常にも気づいておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420528,
					"content": "もし「時間」も妾たちの追い求める要素の一つであるならば、「位置」のみを知っているだけでは不十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420529
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420529,
					"content": "じゃが幸い、汝らの強い意志によって、その乱流はすべての願いが収束する時間の交差点——もっとも大きな可能性を秘めたあの瞬間へと汝らを連れて行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420530
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420530,
					"content": "乱流の方向は眞の影響も受けていたかもしれぬが、影を助けられたのは、みなの努力があったからじゃ。今回は汝らに礼を言わねばならぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420531,
					"content": "もしかして、オイラたちがあの決戦に立ち会えたのは偶然じゃなくて、必然だったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420532,
						120420533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420532,
					"content": "これが将軍の言ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420534
					]
				},
				{
					"id": 120420534,
					"content": "私は元々、空間の外と内で時間の流れが一致していると思っていました。ですので旅人さんが再び現れた時、とても驚いたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420535
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420535,
					"content": "あの瞬間、私が真っ先に思ったのは、「もしや稲妻に大きな災いが起きたのではないか」というものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420536
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420536,
					"content": "しかしあなたが来たのは、私を助けるためだった…あなたが来たことで、私は最良の結末を迎えられました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420537
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420537,
					"content": "お二人とも、ありがとうございます。私のためにしてくださった数々のこと、しかと心に刻んでおきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420538
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420538,
					"content": "影、大丈夫じゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420539,
					"content": "体はすでに回復しています。将軍の意志も、もう私と抗うことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420540
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420540,
					"content": "体ももちろん重要じゃが、それよりも妾は、気持ちが落ち着いたかどうかが知りたいんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420541
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420541,
					"content": "眞の意識に会ったのじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420542
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420542,
					"content": "ただ彼女の声を聞いただけで、会ってはいません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420543
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420543,
					"content": "大丈夫です。少し懐かしいと思っただけなので…私はもう前へ進むと決めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420544
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420544,
					"content": "しかし、今回のことで確信しました。眞は本当に凄いですね…彼女はあの時すでに、稲妻の未来に起こる数々のことを予想していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420545
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420545,
					"content": "何より、私の未熟さも、すべて彼女の計算に入っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420546
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420546,
					"content": "稲妻が今日を迎えられるのも、彼女のおかげです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420547,
						120420548
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420547,
					"content": "眞は凄い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420549
					]
				},
				{
					"id": 120420549,
					"content": "私はただ種を一つ植えただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420550
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420550,
					"content": "影と眞の意志、どちらも必要だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420551
					]
				},
				{
					"id": 120420551,
					"content": "そうだぞ！影は自分の力で眞の前に戻ったんだから、それだけですごいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420552,
						120420553
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420552,
					"content": "最後の行為は簡単なものに見えたけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
						120420555
					]
				},
				{
					"id": 120420554,
					"content": "因果が逆になったからって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420556,
					"content": "…ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420557
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420557,
					"content": "今日ようやく、汝と稲妻は何百年も続く影から完全に抜け出せたようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420558
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420558,
					"content": "眞と汝は、稲妻にとって不可欠な「過去」と「未来」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420559
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420559,
					"content": "あなたからそのような慰めの言葉を聞けるとは、珍しいこともあるのですね。素直に受け取っておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420560
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420560,
					"content": "なんじゃ、これも全部、昔の汝が聞く耳を持たなかったからじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420561
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420561,
					"content": "眞と同じこと言ってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420562
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420562,
					"content": "ほう？なら将軍の位に、妾が二日ほど座ってもよいのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420563
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420563,
					"content": "いや…そんな面倒なこと、やはり御免じゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420564
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420564,
					"content": "冗談はここまでにしましょう。私はこれから数多くのことをやらなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420565
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420565,
					"content": "将軍と共に現在の稲妻をよく観察し、現状を整理し、未来について考えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420566
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420566,
					"content": "そして…鎖国を解除します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420567
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420567,
					"content": "本当か？それって大変なことなんじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420568
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420568,
					"content": "私はもう静止するだけの「永遠」を追い求めることはしません。であれば、この国を封鎖する必要もないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420569
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420569,
					"content": "きっとこれから、稲妻には多くの壁が立ちはだかることになります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420570
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420570,
					"content": "でも同時に多くの「出会い」が生まれる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420571
					]
				},
				{
					"id": 120420571,
					"content": "それについて、私もとても期待しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
