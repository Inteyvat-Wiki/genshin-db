				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204206",
							"2"
						],
						"stepId": 1204206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420302
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420302,
					"content": "どうして…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420303
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420303,
					"content": "あなたたち…一体どうやって再びここへ？それに…どうして姿が昔と同じままなのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420304
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420304,
					"content": "昔？それって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "この戦い、実に懐かしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420306
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420306,
					"content": "今のあなたの意志は、まるで永遠に関する規則を定めた時と同じように固いのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420307
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420307,
					"content": "無数の戦いの中、あなたは一度も負けることなく、一片の迷いもありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420308
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420308,
					"content": "たとえ私が永遠におけるすべての敵を目の前に示しても、あなたは動じなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420309
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420309,
					"content": "それほどまでに規則に従おうとする意志、称賛に値します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420310
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420310,
					"content": "あなたこそ、まさに「永遠の守護者」の名にふさわしい者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420311
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420311,
					"content": "#{M#彼ら}{F#彼女たち}がこの空間に戻ってきた時、まるで運命に導かれた必然のように感じました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420312
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420312,
					"content": "ではこの決戦をもって、私たちの五百年以上にわたる宿命に、終止符を打ちましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420313
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420313,
					"content": "決戦？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420314
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420314,
					"content": "旅人さん、下がっていてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420315
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420315,
					"content": "すべてを終わらせるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420316
					]
				},
				{
					"id": 120420316,
					"content": "私にとっては、次の「始まり」となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
				}
			]
		},
		{
			"id": 1204204,
			"completionStepIds": [
				1204208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204208",
							"2"
						],
						"stepId": 1204208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420401,
					"content": "ここまでです。あなたの勝ちを認めます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420402
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420402,
					"content": "あなたは過去を超えることができないと考えていましたが、私の思い違いだったようです。あなたの魂を軽視していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420403
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420403,
					"content": "永遠に摩耗することのない意志は、結局のところ、未来を抱けないのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420404
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420404,
					"content": "あなたは未来の心配をする必要も、一人で前に進む必要もありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420405
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420405,
					"content": "あなたの強さは私が一番よく知っています。私一人の力では、この決闘の敗者は私だったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420406
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420406,
					"content": "しかし、武芸の形と限界は、刀を振るう理由によって決まります。私が背負いしものは、天光へと向けられた幾千もの眼差し。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420407
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420407,
					"content": "それを思うたび、この「夢想の一心」が震えるのを感じるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420408
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420408,
					"content": "まるで、眞から受け継いだこの刀が、私に気づかせ…鼓舞しているかのように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420409
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420409,
					"content": "私も感じていました。さきの戦いの中、それは確かに新しい力を放っていたことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420410
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420410,
					"content": "その力は、私の認識をも超えたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420411
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420411,
					"content": "これは眞の刀です。もしかしたら、私が彼女を心から理解した時にのみ、この刀は全力で応えてくれるのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420412
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420412,
					"content": "「夢想の一心」を強く握りしめると、彼女と一緒に戦っている感覚になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420413
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420413,
					"content": "馴染みがあるのに、それを知らない感覚…一度も刀を振るったことのない彼女が、ずっと私のそばにいるかのように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420414
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420414,
					"content": "認めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420415
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420415,
					"content": "あなたのその新たな意志は摩耗によって生まれたものではない。もうあなたの規則を修正する行為を妨げるつもりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420416
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420416,
					"content": "これからも、この身はあなたの協力者です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420417
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420417,
					"content": "もう、変えることのできない規則を作りはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420418
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420418,
					"content": "あなたはこれまで私の過去を表わす存在でした。しかし今日からは、あなたが——私です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420419
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420419,
					"content": "眞はただ一度たりとも、私を武器と見なしたことなどありませんでした。私も決して、あなたを道具とは見なしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420420
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420420,
					"content": "…ふふっ、本当に変わったようですね。これが人間のよく言う「成長」というものでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420421
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420421,
					"content": "分かりました、私があなたの影となりましょう。かつてあなたが、眞の影であったように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420422
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420422,
					"content": "私の行うべき責務に変わりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420423
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420423,
					"content": "しかし武者として、今後もこのような戦いの機会があることを期待しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420424
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420424,
					"content": "勝負そのものについては、まだ不服と…そういうことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420425
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420425,
					"content": "いえ、ただ今までに感じたことのない、新しい感覚だったからです。あれはもう一度味わうのに値するものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420426
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420426,
					"content": "もう戦いは終わったのか…？これで、本当にぜんぶ終わったんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420427,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420428
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420428,
					"content": "「夢想の一心」が光ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420429
					]
				},
				{
					"id": 120420429,
					"content": "こんにちは、影。それからこれを見届けている者たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420430
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420430,
					"content": "私は雷電眞。かつて責務を全うすることができぬまま散り、あなたたちに数多の厄介事を残してしまった前代の雷神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420431
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420431,
					"content": "眞…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420432
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420432,
					"content": "私は今、とても嬉しいわ。あなたならきっと、ここまで辿り着けると信じてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420433
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420433,
					"content": "私は「夢想の一心」へと微かに意志を残しておいたの。あなたがその力をすべて発揮した瞬間、私が現れるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420434
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420434,
					"content": "どうしてこんな回りくどいやり方をしたのか——それはあの時のあなたが、自分の考えを信じて疑わず、何も聞き入れようとしなかったからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420435
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420435,
					"content": "ただ私には、あなたの考えが変わるまで待つ時間がなかった。だから、このような形であなたを待つことにしたの。どうか許して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420436
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420436,
					"content": "しかし、そんなこと私には一度も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420437
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420437,
					"content": "すべてが急すぎたのよ…本当にごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420438
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420438,
					"content": "いきなり、稲妻をあなたに託さなければならなくなり、ずっとあなたに悪いことをしたと思っていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420439
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420439,
					"content": "あなたが「無想」に固執しないためにも、元々これらの道理は私が順を追って教えていくはずだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420440
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420440,
					"content": "あの時…カーンルイアで起こることが分かっていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420441
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420441,
					"content": "ええ、多少ね。どの俗世の執政にとっても、「あそこ」は無視できない存在だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420442
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420442,
					"content": "今の私にはもう時間を感知することができない。この再会がどのくらいの時を経たものなのか、そしてその間に稲妻で何が起きたのか分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420443
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420443,
					"content": "それでも私は知っているわ。あなたはきっと、幾度となく涙をこぼしそうになりながら、とても険しい道を歩いてきた。そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420444
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420444,
					"content": "…幾度となど…私を見くびらないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420445
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120420445,
					"content": "ほら、認めてるじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420446
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420446,
					"content": "そういった可能性も考えて、あなたに贈り物を残しておいたわ。稲妻の苦痛を和らげるためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420447
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420447,
					"content": "これを受け取って、私の最後の意識が消失する前に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420448
					],
					"speakerTitle": "眞"
				},
				{
					"id": 120420448,
					"content": "でも、もっとも重要な一歩は、あなた自身の手でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "眞"
				}
			]
		},
