			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "なんじゃ、その焦った顔は。もしやまた妾に頼み事でもしに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420102,
					"content": "汝じゃからよかったものの…もし他の者じゃったら、笑顔で迎え入れはしていなかったじゃろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420103,
					"content": "笑顔でって…いつもニヤニヤしてるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420104,
					"content": "さっきのは常套句じゃ。そう妾にケチをつけるでない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420105,
					"content": "パイモン、本題を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "あっ、そうだ！大変なんだよ！影が…影が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420107,
					"content": "事の経緯を八重神子に伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "そうか——なるほど、影は稲妻を人間に託し、自ら一人でいつ終わるかも分からぬ戦いをしていると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420109,
					"content": "頑固で極端、自身の意志だけで行動し、僅かにでも力が足りなければ目的を達成できぬ…確かにあやつのやり方じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420110,
					"content": "じゃが、あやつは今までずっとあんな風にしてきたんじゃ。いったい何の心配をしておるのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420111,
					"content": "今回のは今までと違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "焦っておる、か…ふふっ、それもそうじゃな。影は時に、子供じみたところがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420114,
					"content": "それで、妾が手伝えると思ったのか？そのようなこと、誰から聞いたのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420115,
					"content": "とぼけてるんだよな？わざとからかってるんだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420116,
					"content": "ほう、ずいぶんと賢くなったではないか。じゃが残念ながら、今回のは本音じゃよ。雷電眞の意識空間について、妾はほとんど知らぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420117,
					"content": "妾が知っておるのは、あれが神櫻の根本であり、影の「一心浄土」とは少々異なるということだけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420118,
					"content": "それって、雷電眞がいなくなったからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420119,
					"content": "完全にそういうわけでもない。空間そのものの性質にも違いがある…じゃが、妾の机上の空論よりも、直接訪れた汝らのほうが感じ取れたのではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420120,
					"content": "分からなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "ともかく、これらはすべて、説明するのも面倒な些細な点じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420123,
					"content": "まずは、その空間の入り口に向かうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420121,
					"content": "あんまり気にしてなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "影は少し焦ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204204",
							"2"
						],
						"stepId": 1204204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "方法は…あるにはある。少し姑息ではあるがのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420202,
					"content": "意識空間は、何も知らぬ者にとっては非常に抽象的なものじゃ。じゃが妾はちょうど影の眷属、多かれ少なかれあやつの居所を感知できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420203,
					"content": "言い換えれば、その場所が空間のどの位置にあるか具体的には分からぬが、汝を影のもとに送ることはできるということじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420204,
					"content": "抽象的…？位置？なに言ってるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420205,
					"content": "理解しなくてもよい。もっと簡単に言うと、今のあやつの周りにあるすべてのものは、混沌に包まれておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420206,
					"content": "乱流のように無秩序…無理に入れば荒波に飲まれ、時間と空間の中に迷い込んでしまうじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420207,
					"content": "だからこそ、「一心浄土」に入る時は、意識を物体へと宿す方法が一番安全なんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420208,
					"content": "えっ？じゃあオイラはやめとくよ…おまえたちが行ってきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420209,
					"content": "逃げちゃダメ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "まあ、行かなくてもよいじゃろう。最悪、影を失うだけじゃろうしな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420212,
					"content": "お、おまえら…ああもう！わかった、行くって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420213,
					"content": "決意は固まったようじゃな。では汝らを送るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420215,
					"content": "ん？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420216,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "いや、なんでもない。この乱れた感じ、妾の考えを裏付けておると思っただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420218,
					"content": "そうじゃ、空間に入る時は、汝の願いを心の中で繰り返すんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420219,
					"content": "抽象空間の巨大な波に飲まれないためには、自らの意識を一定まで高める必要がある。意識を強く保ってこそ、妾は汝をもっとも適した位置へと送れるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420220,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "扉が開いたぞ、入るがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420222,
					"content": "妾は外で待機しておる。汝の最後の保険としてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420223,
					"content": "妾の神…汝に託したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420224,
					"content": "妾のため、そして稲妻のため、全力を尽くしてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420225,
					"content": "神子を信頼していいんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120420226,
					"content": "きっと成功する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420227
					]
				},
				{
					"id": 120420227,
					"content": "さあ、行ってくるがよい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420210,
					"content": "#パイモン、{M#俺}{F#私}を見捨てる気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				}
			]
		},
		{
			"id": 1204203,
