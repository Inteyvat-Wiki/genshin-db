	"talks": [
		{
			"id": 7369701,
			"completionStepIds": [
				7369701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369701",
							"2"
						],
						"stepId": 7369701,
						"stateName": "QUEST_STATE_UNFINISHED"
