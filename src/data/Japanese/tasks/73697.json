			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970101,
					"content": "そう言えば、ソルシュの今の姿にも慣れてきたけど、花冠が無いときのソルシュってどんな感じだったっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970102,
					"content": "うーんと…たしかツルツル頭で、偉そうな口を叩いてたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970103,
					"content": "こんなに順調に花冠が手に入るとは思わなかったな…ま、これもオイラたちのお陰だけどな、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970104,
					"content": "コホン、過去のそういう細々としたことは蒸し返さないデ。白フラ、勘違いしないでくれる？花冠を順調に手に入れられたのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970105
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970105,
					"content": "私が「二本角の花冠」にふさわしい花霊だからヨ。きっと、私が生まれる前から既に、私に与えられたものだったんだワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970106
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970106,
					"content": "背後から、馴染みのある声が聞こえた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970107
					]
				},
				{
					"id": 736970107,
					"content": "ほう、ずいぶん大きな口を利くのネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970108
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970108,
					"content": "ズ、ズルヴァーン先輩！？どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970109
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970109,
					"content": "もちろん、新任の花霊の勇者がちゃあんと勇者としての責務を果たしているか、気になって見にきたのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970110
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970110,
					"content": "ゆ、勇者の責務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970111
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970111,
					"content": "おやまあ、まさか、称号さえもらえれば万事よし、だなんて思っていないわよネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970112
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970112,
					"content": "そのような未熟な考え、めっそうもありマセン！勇者の責務は…決して怠っておりマセン。私も、讃えられるべき貢献はすでにいくつか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970113
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970113,
					"content": "パッと光る花火には、目を奪われてしまいがちネ。でも、雨垂れのような地道な貢献も、賞賛に値する行為なのヨ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970114
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970114,
					"content": "う…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970115
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970115,
					"content": "ソルシュが私たちのもとを離れて人類と仲良くしている間にも、他の花霊たちは勇者の称号とは関係なく、黙々と貢献し続けてきたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970116
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970116,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970117
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970117,
					"content": "ソルシュは「名実ともに」、「勇者」の身分にふさわしい貢献をしていると思っていたんだけれど…どうやら、実は油を売っていただけみたいネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970118
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970118,
					"content": "#油を売ってただけだなんて、ちょっと言い過ぎじゃないのか？ソルシュだってえらかったよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970119,
						736970120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970119,
					"content": "うんうん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970122
					]
				},
				{
					"id": 736970122,
					"content": "決して勇者の責務を怠ったつもりはありマセンが、それが具体的に何を指すのか…スケプティック団にも関連の記述はありマセンでしたのデ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970123
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970123,
					"content": "花霊の伝統を人類から学ぼうだなんて、灯台下暗し…ネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970124
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970124,
					"content": "霊光に認められたとはいえ、あなたはまだ若い。こういう時は素直に私に聞いてくれればよかったのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970125
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970125,
					"content": "ズルヴァーン先輩に？でも、その…いえ、花冠は多くの知恵を持つモノですカラ、もう少し模索すれば自分で答えを見つけられるかもしれマセン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970126
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970126,
					"content": "でも、ズルヴァーンが目の前にいるんだし、聞けば答えるって本人が言ってるんだから…別にもう、自分で答えを考えなくたっていいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970127,
					"content": "#オイラと{NICKNAME}の豊富な旅の経験からすると、こんなチャンスは一旦逃したら、絶対に後悔するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970128,
					"content": "ズルヴァーン先輩の話を疑っているわけじゃないワ…ただ、えーと…自分で見つけた答えじゃないと意味がナイって、スケプティック団の人間に聞いたことがあるノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970129,
						736970131
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970129,
					"content": "それも他人に教えてもらったことでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970130
					]
				},
				{
					"id": 736970130,
					"content": "だよな、ズルヴァーンよりスケプティック団のやつらの話を信じるっていうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970133,
					"content": "…うーん、「謁賛主」と白フラの話は、確かに一理あるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970134
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970134,
					"content": "私も昔のソルシュじゃないんだもノ。霊光に認められた身である以上、もっと成熟した大人の振る舞いをしないとネ。せめて、勇者の称号に泥を塗るようなマネだけは絶対にしたくないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970135
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970135,
					"content": "コホン、ズルヴァーン…先輩。勇者の責務について、是非とも教えていただけないでしょうカ。今までおろそかにして来た分、今後の努力で挽回致しマス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970136
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970136,
					"content": "おー、ソルシュの口からすんなりそんな言葉が出てくるなんて…なんだか、オイラ感動しちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970137,
					"content": "ふふっ…あなたの言葉を聞いて、安心したワ。勇者の責務の詳細については、数日がかりで教えることになるわヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970138
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970138,
					"content": "ただ、ここ数年、ソルシュは他の仲間と比べて人類と一緒にいた時間が遥かに長かった——このコトを考慮して、まずは簡単な内容から始めまショウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970139
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970139,
					"content": "花霊の勇者たるもの、卓越した行動力と洞察力は必須の資質ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970140
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970140,
					"content": "既に六種類の訓練を用意してあるワ。うち三つは飛行能力のテストで、残りの三つのテストは、ソルシュに危険な要素を取り除いてもらうという内容のものヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970141
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970141,
					"content": "訓練の内容、聞き覚えがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970142
					]
				},
				{
					"id": 736970142,
					"content": "似てるどころか、全く一緒じゃないか！まるで雑用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970143,
					"content": "白フラは黙っててちょうだい。この任務を完遂したら、先輩に一人前の勇者として認めてもらえるはずヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970144
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970144,
					"content": "簡単そうに見えるけど、先輩からのテストだもノ…獅子搏兎の覚悟で臨ませてもらうワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970145
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970145,
					"content": "ふふっ、気合はばっちりネ。そうそう、ちょうど「謁賛主」とその仲間もいることだし、ソルシュに協力してあげてほしいミッションがあるノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970146
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970146,
					"content": "別に難しいことは何にもないワ。ご存じの通り、ソルシュはここ数年「スケプティック団」の人間と付き合っていて、花霊の伝統からは遠ざかっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970147
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970147,
					"content": "今回お二人には聞き手として、ソルシュの過去の振り返りに立ち会ってあげてほしいノ。過去の出来事を正確に述べることも、勇者の名を与えられた花霊なら当然の能力でショウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970148
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970148,
					"content": "もちろんデス。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970149
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970149,
					"content": "ソルシュの話を聞くだけか？なら、簡単そうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970150,
					"content": "では、立ち会いについてはお二人に任せたわネ。ソルシュが単独で受けるテストについては、後ほど本人に説明するから、お二人は彼女について行ってくれるだけで結構ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 736970131,
					"content": "文献にもミスのある人たちの言うことだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970132
					]
				},
				{
					"id": 736970132,
					"content": "そうだぞ。ラシュヌを探す時も、あいつらの文献の記載と実際の状況は全然違ってたし、あいつら自身ですら、訳が分かってないぐらいだったもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970120,
					"content": "その…なんて言えばいいか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970121
					]
				},
				{
					"id": 736970121,
					"content": "#{NICKNAME}、そんな厳しいこというなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970122
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7369706,
			"completionStepIds": [
				7369706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369706",
							"2"
						],
						"stepId": 7369706,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7303201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970601,
					"content": "初日のゴールってここだったよな？もう何回も来てるから、覚えちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970602,
					"content": "ふーん？白フラ、そんなに自信があるなら、私と入れ替わってみナイ？私が聞き手役、あなたがしゃべる役ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970603
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970603,
					"content": "おうっ、オイラの実力を見せつけてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970604,
					"content": "目の前に広がる、花と水のある景色は、甘露花海って場所だ。ここは…あ、そうそう、「ディフの魔物」の攻撃から免れた、花霊の故郷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970605,
					"content": "ここにはたくさんの花霊が住んでいて、中でも一番偉いのがズルヴァーンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970606,
					"content": "ソルシュもここで生まれたんだよな？でも、ソルシュは他の花霊とはちょっと違ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970607,
					"content": "もし、他の花霊の話し方が半分おかしいとすれば、最初の頃のソルシュの話し方は百パーセントおかしいと言えるだろう！うーん、おんなじ水で育ったのに、なんでソルシュだけそうなっちゃったんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970608,
					"content": "なんですっテ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970609
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970609,
					"content": "オイラ、嘘は言ってないぜ。ソルシュがスケプティック団としゃべる時の話し方って、本当に変だもん。えーっと、スケプティック団のやつらも十分変だけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970610,
					"content": "他の花霊も皆ソルシュと同じだって思ってたから、甘露花海でズルヴァーンに会うまでは正直心配だったんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970611,
					"content": "最終的には、ソルシュだけがそんな喋り方をするんだって分かったけど…正確には、ソルシュがスケプティック団としゃべる時だけだよな…あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970612,
					"content": "スケプティック団の影響が大きすぎた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970613
					]
				},
				{
					"id": 736970613,
					"content": "うぅ…確かに否めないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970614
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970614,
					"content": "よし、ソルシュが文句ないなら、話を続けるぞ。甘露花海には大きな切り株が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970615,
					"content": "白フラ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970616
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970616,
					"content": "はいはい、「万種母樹」な！花霊の言葉は本当に覚えにくいぜ。それに大体、実際切り株なんだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970617,
					"content": "ソルシュの話では、その切り株は実は神様で、花霊一族もその神様と結構深い関係があるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970618,
					"content": "確かに間違ってはいないケド…これ以上白フラに任せると神様に不敬だから、続きは私が語るワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970619
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970619,
					"content": "分かったよ…分かりやすく説明できたと思ったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970620,
					"content": "ふん…とにかく、五百年前、神様はこの地の災厄を鎮めるために、自分の全てを犠牲にした。ここの甘露活水は、神様からの最後の恩恵だったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970621
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970621,
					"content": "甘露活水によって潤った地には、やがて万種母樹が生まれ、我ら花霊が誕生した。その花霊の一番の年長者が、先輩…つまり「ズルヴァーン」だったノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970622,
					"content": "私が生まれたのはそれよりずっと後のことだカラ、今言ったことなんかは経験したことがないし、ズルヴァーン先輩から一部を聞かされたダケ。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970623
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970623,
					"content": "スケプティック団の設立には先輩も参加されていたというのに、私が生まれた頃には、両者の交流は既にほぼなくなっていたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970624
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970624,
					"content": "花霊の歴史の伝承は大事だって、先輩はいつも仰っているけど…詳しいことはあまり話してくれナイ。むしろスケプティック団のほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970625
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970625,
					"content": "彼らが研究していた歴史について熱心に教えてくれたし、神鳥に追随したいという私の願いにも賛同してくれたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970626
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970626,
					"content": "えっ？それでだんだん花霊一族から疎遠になって、スケプティック団の変なしゃべり方を身につけたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970627,
					"content": "うぅ…客観的に言うとその通りヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970628
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970628,
					"content": "まるで反抗期みたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970629
					]
				},
				{
					"id": 736970629,
					"content": "「反抗期」…以前スケプティック団から聞いた話では、森の中の学者は「サティアワダライフ」とか言う時期を経験するそうだケド、「反抗期」も似たようなモノかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970630,
						736970632
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970630,
					"content": "うん、似たようなもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970631
					]
				},
				{
					"id": 736970631,
					"content": "おい、全然違うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970634,
					"content": "簡単に言うと、反抗期って言うのは人間の子供が世話をしてくれた大人に反抗して、自分の主張をし始める時期だって聞いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970635,
					"content": "へへ、つい最近までソルシュもそうだったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970636,
					"content": "ふん、今の私を過去の私と一緒にしないデ。なんと言っても、今の私は花海に帰還して、霊光に認められた身なんだカラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970637
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970637,
					"content": "ソルシュはえらいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970638,
					"content": "白フラだってちびっこな癖に…ま、いいデショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970639
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970639,
					"content": "今日の話はここまでヨ。「謁賛主」、白フラ、他に聞きたいことはあるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970640
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970640,
					"content": "そう言えば、花霊とアランナラって関係あるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970641,
					"content": "…どうしてそんな質問を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970642
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970642,
					"content": "花霊もアランナラも、ちっちゃいから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970643
					]
				},
				{
					"id": 736970643,
					"content": "でも、やることは超えらいんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970644
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970644,
					"content": "アランマをはじめとするアランナラとの冒険談をソルシュに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970645
					]
				},
				{
					"id": 736970645,
					"content": "そう…ウツァヴ祭はとても重要な祭りだったのネ。先輩から聞いたときは、ただアランナラたちが集まって騒ぐ祭りだと思ってたケド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970646
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970646,
					"content": "アランナラは自分たちの祭りを持ってるのに、どうして花霊には祭りがナイのかしら？先輩に提案しないト…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970647
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970647,
					"content": "ソルシュ、おまえはなんで花霊の祭りが欲しいんだ？ご馳走が腹いっぱい食べれるからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970648
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970648,
					"content": "違うに決まってるデショ！花霊の祭りでは…人間に私たちへの頌歌を披露させて、私がその中から一番歌の上手い人を選ぶノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970649
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970649,
					"content": "それって祭りでやることか…？参加者にとっちゃ、バリバリ緊張するコンテストじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970650,
					"content": "私にとっては、楽しみ満載の祭りだケド？きっと先輩も気に入ってくださるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970651
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 736970651,
					"content": "うぅ…ズルヴァーンの言った通り、ソルシュが一人前の花霊の勇者になるまでには、もう少し訓練が必要かもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736970632,
					"content": "成長の過程で絶対に通る道って意味ではね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970633
					]
				},
				{
					"id": 736970633,
					"content": "学者たちだけが経験する「サティアワダライフ」とは違って、確か、人間の子供はみんなこれを経験するんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "パイモン"
				}
			]
		},
