					"卯師匠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "あといくつ注文があったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320202,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "はははっ、「万民堂」以外のことなんてやりたくてもできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320204,
					"content": "最近は海灯祭だろ、客が多くてな。外国からもたくさん人が来て賑わってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320205,
					"content": "娘の香菱も手伝いに来たんだが、それでもまだ忙しくてな。ほら、今ちょうどそこで料理を運んでる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320206,
					"content": "もう皆とっくに霄灯を飛ばしに行ってるのに、「万民堂」は忙しくてそんな暇もないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320207,
					"content": "旅人、お前さんがよかったらでいいんだが、手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320208,
					"content": "竺子って知ってるだろ？いつも埠頭にいる稲妻から来た子だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320209,
					"content": "ここで注文をしてな、送るのを手伝ってくれないか。せっかくの祭りだから、多めに作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320210,
					"content": "それといつも埠頭で忙しそうにしてる<color=#00E1FFFF>王鉗、李槌、観海、志華…</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320211,
					"content": "皆うちのお得意先でな、祭りなのに埠頭にいるのも、仕事で忙しいからだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320212,
					"content": "だからその人たちにも料理を準備した。しかし見ての通り忙しくて離れられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320213,
					"content": "旅人、そこに行くついでに彼らに何が食べたいか聞いてきてくれないか。そしたら料理の準備ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 413320214,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "じゃあ頼んだよ。聞いてきたらすぐ俺に言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師匠"
				}
			]
		},
