			"dialogs": [
				{
					"id": 413320301,
					"content": "「万民堂」の配達まだ来ないのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320302,
					"content": "注文を届けにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "あっ！ありがとう！もう少しかかるのかと思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320304,
					"content": "璃月の海灯祭、なんだか故郷を思い出すな…でも、しばらくは稲妻に帰れないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320305,
					"content": "稲妻は今どうなってるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "竺子"
				}
