					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "やっと来た！結構待ったよ…でもこんな日に配達してくれるなんて、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
