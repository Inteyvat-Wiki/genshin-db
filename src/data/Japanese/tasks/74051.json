			"dialogs": [
				{
					"id": 740510301,
					"content": "映影機が無傷で良かったわ。中の映影も壊されてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510328,
					"content": "はあ、助かったわ…また最初から撮り直しかと思っちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510302,
					"content": "どうしてここで撮影を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "フォンテーヌ人じゃないみたいだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "この件は話すと長くなるんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510304,
					"content": "単刀直入に説明すると、私たち三人は璃月の「翹英荘」から来たのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510305,
					"content": "村の人たちのほとんどは茶葉を作って生計を立ててるんだけど、私たちは…茶葉の生産には興味がないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510306,
					"content": "だから鞍替えをして、村の茶葉商人のために宣伝用の映影を記録してるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510307,
					"content": "実は茶葉を作っている人が多すぎて、もともと私たちがやってた商売じゃとても周りに敵わないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 740510308,
					"content": "店で雇ってたやり手の従業員もぱらぱらよそに移ってっちゃって。それで、これ以上商売を続けようがなくなっちゃったんですよねー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510309,
					"content": "あんたたち…もっといい感じの話はできないわけ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510310,
					"content": "私たちだって、村の茶葉の宣伝用映影を撮って、結構稼いできたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510311,
					"content": "ええ…ですが、最近村では他の連中まで同じことをやり始めてしまいまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 740510312,
					"content": "とある映影では歌なんかも入ってて…すごかったな～。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510313,
					"content": "そこで私たちは、専門家のアドバイスをもらおうと思ってフォンテーヌにやってきたわけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510314,
					"content": "つまりフォンテーヌに撮影を学びにきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "そうよ。フォンテーヌでガイサートっていう「映影専門家」を見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510316,
					"content": "彼は光と影を使って表現するのが上手なんだけど…なんて言ったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510317,
					"content": "「叙述」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "弈豊"
				},
				{
					"id": 740510318,
					"content": "そう！光と影で「叙述」するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510319,
					"content": "ガイサート先生の指導があれば、翹英荘で一番の映影を撮影することができるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510320,
					"content": "社長ぉ、先月は璃月で一番の映影を撮る…って言ってませんでした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510321,
					"content": "商売というものは、将来への期待値を適度に調整するのが大事なのよ…あなたに何がわかるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510322,
					"content": "とにかく助かったわ、旅人さん。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510323,
					"content": "興曄、弈豊、すぐに準備しなさい！今日中にサンプルを撮り終えてガイサート先生のところへ見せに行くわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510324,
					"content": "ライティングに注意しなさい！レンズは…光源に向けて、高級感のある光を演出するの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510325,
					"content": "例の本を読んだでしょう？光と影には質感を——質感ってわかる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "邱社長"
				},
				{
					"id": 740510326,
					"content": "社長、たしかにガイサート先生の本は全部読みましたけどー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 740510327,
					"content": "このレンズじゃ、どう頑張っても光の質感については高級感の出しようがありませんよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弈豊"
				}
			]
		},
