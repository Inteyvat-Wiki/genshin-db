			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "やはりノートの記述と同じ…ん？もう戻ってきたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732562702,
					"content": "その様子ですと、必要なエネルギーブロックを手に入れたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732562703,
					"content": "これらのエネルギーコアについては、私がチェックしておきました。どれも保存状態が良好だったようです。次はエネルギーブロックを中に装填しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732562704,
					"content": "では頼みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナセジュナ"
				}
