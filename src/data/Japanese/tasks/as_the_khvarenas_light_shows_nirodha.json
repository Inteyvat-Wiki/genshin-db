					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナセジュナ",
					"ソルシュ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "ご覧ください。さあ、運命の時が訪れます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560402,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "えっと、ただの仕掛け扉だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732560404,
					"content": "コホン、私が言いたいのは、この扉さえ開けば、遺跡に入れるということです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560405,
					"content": "初めてダーリ人の遺跡に入ることを考えると、少し興奮してまいりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560406,
					"content": "あれ？今までの自信満々な感じからして、とっくに遺跡をたくさん探索してるもんかと思ったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732560407,
					"content": "ははっ、実際に探索したことがなくとも、私の手には偉大なる古代学者が残した「ルネの調査ノート」があります。これを研究することで、自ら探索した気分になれるのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560408,
					"content": "「ルネの調査ノート」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "おや、君たちも聞いたことありませんか？この学者の尊名を知らないのは、砂漠の僻地にいる私のような人間だけかと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560410,
					"content": "このノートには、ダーリ人が残した記録が数多と書き写してあります。筆者によると、彼はかつてそれら遺跡から「人智を越え」た知識を見つけたそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560411,
					"content": "聞けば聞くほど、怪しくなってくな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732560412,
					"content": "まあ、これについては置いておきましょう。とにかく、このノートがある以上、こういったダーリ遺跡を探索するのはお手の物というわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560413,
					"content": "もし信じられないのなら、まずは検証してみましょう！例えば、このギミックを解く方法は…ああ、ありました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>「歯車を回して、三種の印をすべて表示させる。底部にある三角の印を変えずに、四角をそれと繋げる」</color>…ひとまず、私の言う通りにやってみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナセジュナ"
				}
			]
		},
