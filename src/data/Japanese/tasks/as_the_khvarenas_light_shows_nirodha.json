				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "エネルギーコアの装填が完了しました。これで制御システム全体を起動できるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732561002,
					"content": "おや？予想していたのと違います。どこか間違えているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732561003,
					"content": "どうやら、中継装置のある制御室に行く必要があるようです。まあ、どのみち実験場に行くには、そこを通らなければならないので構わないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732561004,
					"content": "ふむ、制御室は君たちが先ほど来た方向にあるようです。一緒に向かうとしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナセジュナ"
				}
			]
		},
		{
			"id": 7325612,
			"completionStepIds": [
				7325612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
