			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナセジュナ",
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560601,
					"content": "ふむ、ようやく遺跡の中心部に辿り着いたようです。では、ダーリ遺跡のことをかなり研究してきたこの私が説明してあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560602
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560602,
					"content": "ノートに書かれた説明によりますと、ここは元々ダーリ人がギミック性能を研究したり、実験したりする実験基地だったようです。そして、霊光絶唱は最深部の実験場にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560603
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560603,
					"content": "そこに行くためには、まず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560604
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560604,
					"content": "かなり研究をしたって言っときながら、ただノートを読んでるだけじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732560605,
					"content": "何ぶん、この遺跡の構造はさすがに複雑すぎますから…これらダーリ人が設置した不思議な装置に対して、説明を読まずにその原理を理解できる人などいないと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560606
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560606,
					"content": "どれ…ふむ、なるほど。どうやら私たちがいるここは、この実験基地の制御センターのようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560607
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560607,
					"content": "霊光絶唱のある場所にたどり着くには、まずこの遺跡の制御システムを起動させる必要があります。そして、その制御システムを起動させるには、エネルギーの問題を解決しなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560608
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560608,
					"content": "ダーリ人は穢れの力を利用してギミックを作動させたり、魔物を使役したりできたと聞きます。ですが、この遺跡は穢れをエネルギー源にしていないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560609
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560609,
					"content": "その代わり、ここは「アゾス物質」というエネルギーで動作しています。それは純粋な元素エネルギーから抽出され、塊へと凝縮させたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560610
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560610,
					"content": "つまり、このようなエネルギーブロックを見つけられれば、エネルギーコアへとチャージできます。残りの問題も解決できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560611
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560611,
					"content": "随分とややこしそうネ。戦うだけならよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560612
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732560612,
					"content": "じゃあ、さっそく行動しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560613
					]
				},
				{
					"id": 732560613,
					"content": "ほう、やる気に満ちあふれているようですね。さすがは尊使様の謁賛主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560614
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560614,
					"content": "では、エネルギーブロックを探すのは君たちに任せます。実験基地の見取り図をどうぞ。きっと役に立つはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560615
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560615,
					"content": "私はまだ調べなければならないことが残っていますので、ここで君たちの凱旋をお待ちしております。尊使様がご一緒であれば、何も心配はいらないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560616
					],
					"speakerTitle": "ナセジュナ"
				},
				{
					"id": 732560616,
					"content": "何か問題があれば、その見取り図をよく見てみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナセジュナ"
				}
			]
		},
