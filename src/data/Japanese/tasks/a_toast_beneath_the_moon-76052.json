			"dialogs": [
				{
					"id": 760520501,
					"content": "ごきゅ…ごきゅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520502,
					"content": "一気にいったな…！へへ、すっごく気に入ってくれたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520503,
					"content": "あんまり味がしなかったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520504,
					"content": "あ…味がしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520505,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520506,
					"content": "一気に飲み過ぎたんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "ううん、大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520509,
					"content": "昔、私は人々の言う「収穫の喜び」が理解できなかった。でも、実った果実を自分の手で触ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520510,
					"content": "皮の模様から、果実の生命力を感じ取れた。この子は、太陽の光、水、土、そして空気の養分を生命力に変えてるんだってわかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520511,
					"content": "食べてみたら、瑞々しい食感と一緒に甘味が押し寄せてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520512,
					"content": "その時初めて知ったの。香りの魅力からは誰も逃げられないんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520513,
					"content": "いい感想だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520514,
					"content": "私たちは、その生命力を奪うことで、自然の転化を成し遂げてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520515,
					"content": "急に残酷な話になったな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520516,
					"content": "だから私は新鮮な果物が大好きなの。私がこの世界から何を奪ってるのか、教えてくれるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520517,
					"content": "これも、私がこの世界に報いないといけない理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520507,
					"content": "もう一杯作ろうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
