			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520102,
					"content": "コロンビーナ、大丈夫か？なんか元気ないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520103,
					"content": "キミたちだったんだね。私は大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520104,
					"content": "（また「月」のことを考えてるのかな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "なにか手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "私…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520108,
					"content": "ちょっとした悩みでも、話すとラクになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520109,
					"content": "ちょっとだけ…酒場の飲み物を飲んでみたくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520110,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520111,
					"content": "…うぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520112,
					"content": "いや！ちょっとびっくりしただけなんだ。おまえがものを欲しがるなんて、珍しいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520113,
					"content": "しかも…飲み物だなんてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520114,
					"content": "簡単すぎると思ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "「月を採ってきて」とでも言われるかと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520116,
					"content": "でも確かに…おまえは今自由に行動できないから、酒場に行くのはそれと同じくらい難しいもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520117,
					"content": "今に始まったことじゃないよ。「ファデュイ」にいた頃も、私を捕まえに来る人こそいなかったけど、ちょっと出歩くだけでもみんな私を避けてたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520118,
					"content": "（執行官の第三位…この身分は、確かに人々を怯えさせるには十分だ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "あれ？でも…よく考えたら、叶えられない願いってわけじゃないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520120,
					"content": "酒場のドリンクなら、おまえが作れるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520121,
					"content": "…ほんと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520122,
					"content": "そこまで期待されると、緊張するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520123,
					"content": "どんな味がいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520125,
					"content": "外の飲み物はあまり飲んだことが無いから、具体的には言えないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520126,
					"content": "あんまり濃厚じゃないもの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520127,
					"content": "濃厚じゃないってどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520128,
					"content": "「ファデュイ」のコートみたいな感じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520129,
					"content": "よけい分からなくなったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520130,
					"content": "たぶん、さっぱりしたものがいいんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "うん、任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520131,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
