				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "ん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520202,
					"content": "どうだどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520203,
					"content": "すごく昔のことを思い出しちゃった。まだ「霜月の子」と一緒に生活してた頃のこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520204,
					"content": "あの人たちは、新鮮なミントや香料とベリーを混ぜた飲み物を作ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520205,
					"content": "窓辺を通り過ぎるたびに、草木の匂いが漂ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520206,
					"content": "へえ…で？飲んでみたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520207,
					"content": "ううん、飲んでみたかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520208,
					"content": "えっ？なんでだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520209,
					"content": "「神様」が突然「あなたの家にあるお茶を飲ませて？」って言ってきて…本当に「粗茶」を出す人なんていないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520210,
					"content": "ああ…なるほどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520211,
					"content": "最終的にもらえたのは、煌びやかな容器に入った「神様に捧げる供物」だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520212,
					"content": "不味くはなかったけど…窓辺を通り過ぎるたびに部屋から香る…優しい匂いはしなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520213,
					"content": "今は思う存分飲めるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520215,
					"content": "美味しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520216,
					"content": "…でも、ミルクを入れるなんて珍しいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520217,
					"content": "モンドのレシピだからな。あっちの人はお茶を飲むときに、ミルクとかクリームとか、砂糖をいれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520218,
					"content": "変わってるね。でも美味しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520219,
					"content": "ふぅ、気に入ってくれたみたいでよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760520220,
					"content": "うん、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520221,
					"content": "昔の記憶を呼び起こしてくれるのは、月の光だけじゃないんだね。飲み物の香りも、心の奥底に眠ってる風景を思い出させてくれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
