			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "この神器、甘味は作れるだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010102,
					"content": "今回はなにを作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "旅人、ちょうどいい時に来た。ちょうど今回作る品を思いついた、その名を「プリン」という。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010104,
					"content": "この「プリン」という料理は、近ごろ流行りの調理手法で見たものだ。それによると、柔らかい食感が楽しめる甘味らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010105,
					"content": "妾はその作り方を少し変え…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010106,
					"content": "それに「米」を加えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010107,
					"content": "改良後の料理は妾が名付ける必要がある、ふむ…「お米プリン」としよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010108,
					"content": "なんか重そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "この甘味の重要な点は「米」の品質にある。妾もすぐに「からくり調理神器」を起動し、良質な米を探させた。そして、この地にたどり着いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010110,
					"content": "旅人、ちょうどよかった。妾のために、良質な米を取ってきてくれぬか。神器によると、そのような米はここからそう遠くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010111,
					"content": "#なんでいつも{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "神器を調整するには時間がかかる、妾は今それを行う余裕がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010114,
					"content": "お前は行動力もある、頼れる助っ人だ。妾の代わりに取って来てくれないか。「お米プリン」が完成したら、お前にも分けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010115,
					"content": "頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010116,
					"content": "からくり調理神器…起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010117,
					"content": "旅人、神器は妾が起動しておいた。その気配を辿り、妾のほしい米を集めてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 705010112,
					"content": "自分で飛べるでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブルン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "助けてくれてありがとう…私はブルン、商人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010202,
					"content": "はぁ…まったくツイてない。私は貨物を運送していたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010203,
					"content": "だがまさか…途中で魔物に襲われてしまうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010204,
					"content": "荷車にある貨物も、進む方向も全部無視して…なりふり構わず前へ走ったら、ここに着いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010205,
					"content": "それで、やつらを撒けたと思い、貨物を確認しようとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010206,
					"content": "突然どこからか、やつらが現れたんだ…君たちがいてくれて本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010207,
					"content": "何を運んでたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "食材だ、具体的には米など…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010209,
					"content": "どうやら、あの仙人が欲しがってた米はこれみたいだな。でも、もうあまり残ってないみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705010210,
					"content": "米を少し売ってくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "米を？もちろんいいが…逃げる時にほとんど道に落としてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010212,
					"content": "今ごろ魔物たちが、それを戦利品として拠点に持ち帰ってるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010213,
					"content": "私もいま、どうすれば貨物を取り戻せるか悩んでいる。もし取り戻すことができなかったら、この商売はおしまいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010214,
					"content": "旅人…さっき君の腕前を見させてもらった…本当にすまないが、私の貨物を取り戻してくれないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010215,
					"content": "も、もし手伝ってくれるのなら！あの米、欲しいだけ持っていって構わない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010216,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "ありがとう！じゃあ頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010220,
					"content": "私の運搬用の熱気球を持っていき、貨物を全てその上に置くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010221,
					"content": "じゃあ頼んだよ、旅人。私はここで待っている。貨物を手に入れたら、ここに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010218,
					"content": "そんなに多くの貨物は持てない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "大丈夫、私に方法がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "ブルン"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブルン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "貨物を取り戻せたのか？ありがとう、旅人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010302,
					"content": "その…米が必要だって言ってたね？少し待っててくれ、品質が良いのを選んであげるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010303,
					"content": "よし！この米を君にあげるよ、足りるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "ブルン"
				},
				{
					"id": 705010304,
					"content": "手伝ってくれてありがとう、旅人。では私はこれで失礼するよ。",
