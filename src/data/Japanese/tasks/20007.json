			"dialogs": [
				{
					"id": 200070401,
					"content": "ありがとう！アイツらもしつこいな、そんなに獲物が欲しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070402,
					"content": "こんなにいい獲物を狩ることができたのはドゥラフさんのおかげだよ。僕も彼のような狩人になりたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070403,
					"content": "はあ、その前に、まずは車を城内に入れないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070404,
					"content": "すまない、もうすぐ車を直せたんだけど、さっきのでまた問題が出たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070405,
					"content": "でもこれ以上ここにいると危険になるだけだから、急いで車を直さないと。車にロープがあるはずだが、きっとあのヒルチャールに捨てられたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070406,
					"content": "旅人、この周りに<color=#00E1FFFF>ロープ</color>はないか探してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エレン"
				}
			]
