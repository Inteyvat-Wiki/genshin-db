			"dialogs": [
				{
					"id": 200070101,
					"content": "#ありがとう、{NICKNAME}、よかった、終わったかと思ったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070102,
					"content": "この貨物車には狩人たちの成果が入ってるんだ、モンドに届けてくれとドゥラフさんに頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070103,
					"content": "か、狩りは得意じゃないけど、運搬くらいならできるはずだって最初は思ったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070104,
					"content": "急に襲われてしまってな。きっとこの獲物たちが良すぎて、アイツらもほしくなったに決まってる。でも君が来てくれてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070105,
					"content": "えっと、申し訳ないけど…さっき襲われた時、貨物車も壊されたんだ。ここを出るためには、まず車を直さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070106,
					"content": "周りの林に使える材料があるはずだけど、獲物がここにあるから、あまり離れたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 200070107,
					"content": "よければ、<color=#00E1FFFF>丈夫な木の板</color>を探してきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エレン"
				}
			]
		},
		{
