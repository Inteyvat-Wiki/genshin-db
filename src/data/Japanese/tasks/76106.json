				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "…うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "あんたのために忠告するけどね、用もないのに設計局に入るのはやめときな！特に二階！クーヴァキに当てられすぎると…よくて頭痛、最悪吐くよ。私は警告したかんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェロスラヴァ"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
