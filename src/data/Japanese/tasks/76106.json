				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "本当も本当さ！中で仕事するやつはアップルサイダーを一杯多めにもらえるんだよ。体に害が無いのにこんないい事あるわけないでしょうが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "ヴェロスラヴァ"
				},
				{
					"id": 761060303,
					"content": "それに私は…この目で見たんだよ。霜月の子の司祭たちの頭から、角が生えてるのを…これが普通なわけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "ヴェロスラヴァ"
				},
				{
					"id": 761060304,
					"content": "そうだったんだ…教えてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "な、なんだか怖そうな話だな！ば、化け物になっちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761060306,
					"content": "はぁ、上はいっつも新人に危ないことをやらせるんだから…あんたも気をつけな、中に長時間いちゃダメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェロスラヴァ"
				}
			]
		},
		{
