			"trigger": {
				"objectNames": [
					"ワヒッド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "しまった…どうしてこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "旅人、ちょうど探してたところです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370104,
					"content": "この間のお客様、紺田伝助さんを覚えていますか？先日お店に来られて、肥料について聞かれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370105,
					"content": "肥料に満足してた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "満足かどうか…ではなく、紺田伝助さんは「戸惑っている」というべきだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370107,
					"content": "戸惑っている？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "前回、あなたが宣伝に行った後、紺田さんはあなたの説明通りに肥料を撒きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370109,
					"content": "しかしその後、農作物が育ちはしたものの、同時に…不可解なほど大量のキノコが生えてきたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370110,
					"content": "紺田さんがその件を伝えに来た際、正直私も戸惑いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370111,
					"content": "いずれにしても、この状況は撒いた肥料と関係があるのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370112,
					"content": "旅人、もう一度紺田村に行って、キノコ掃除を手伝ってきてくれませんが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370113,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "旅人、もう一度紺田村に行って、紺田さんの畑のキノコ掃除を手伝ってきてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370115,
					"content": "はぁ、もしアラニがいたら、すぐに原因を見つけられたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370116,
					"content": "アラニにお願いしたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "ええ、彼女なら原因を見つけられる筈です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370118,
					"content": "しかし未だに戻ってこないとは、いったいどこで何をしているのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220370119,
					"content": "旅人、今はあなたしか頼れません。私は何が原因なのか、店で資料を調べてみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワヒッド"
				}
			]
		},
