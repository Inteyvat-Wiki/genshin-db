			"dialogs": [
				{
					"id": 220370201,
					"content": "こいつはどうなってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370202,
					"content": "キノコ掃除に来た！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "ワヒッドのところから、キノコ掃除を手伝いに来てくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370206,
					"content": "おう、じゃあ頼んだぞ。俺みたいな年寄りじゃ採り切れないほど、大量のキノコが生えているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370207,
					"content": "キノコめ、急に生えやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370203,
					"content": "キノコを増やしてしまってごめんなさい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "キノコ？あいにく、我が家の食卓はあまりキノコを使わないもんでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "紺田伝助"
				}
			]
		},
		{
