			"dialogs": [
				{
					"id": 220370301,
					"content": "全部採れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370302,
					"content": "採ったキノコはこれで全部。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "これだけか？もっと生えてるかと思ってたけど、全部採れてないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370304,
					"content": "とにかく感謝するぞ、若いの。これをやる、報酬として受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370305,
					"content": "しかし、すごい肥料だったな。キノコをあっという間に成長させるなんて、農作物も成長させてくれればよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220370306,
					"content": "手が空いたら、もう少し買って試すか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田伝助"
				}
			]
