						],
						"stepId": 7301807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランパンドゥ",
					"アランナクラ",
					"アランコンティ",
					"アランバリカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180401,
					"content": "間近で見ると、さらに衝撃的だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180402,
					"content": "ヴァルナ神器は草木の王の創造物です。命の水をもたらし、ワルカをヴァーナに変えました。黄色が緑になり、不毛な大地に命が満ちました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180403
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180403,
					"content": "不思議な話だな。「命の水をもたらした」か…ふぅん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180404,
					"content": "で、その水って飲めるのか？なんか特殊な効能があったりとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180405,
						730180414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180405,
					"content": "若返っちゃったりして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180406
					]
				},
				{
					"id": 730180406,
					"content": "#んん？{NICKNAME}が？それともオイラが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180407,
						730180411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180407,
					"content": "パイモンが赤ちゃんになるに決まってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180408
					]
				},
				{
					"id": 730180408,
					"content": "今よりチビだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180409,
					"content": "飛蛍みたいになっちゃうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180410
					]
				},
				{
					"id": 730180410,
					"content": "そんなにチビじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180418,
					"content": "パイモンは水が欲しいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180419
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730180419,
					"content": "パイモンが種になったら、アランナクラが手入れして、水やりをして、日の当たる場所に住ませて、土を耕してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180420
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730180420,
					"content": "パイモンのために音楽を奏でて、パイモンの知らないヴァーナの話をしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180421
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730180421,
					"content": "アランバリカはたまにしかパイモンに会いに行かないだろう。でも会うときは、持ってきたキノコを調理する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180422
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730180422,
					"content": "アランバリカは、そんなことしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180423
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730180423,
					"content": "へえ、なかなか快適そうな生活だな…って、おい！オイラは種になんかならないぞ！それじゃあ、一度入ったらもう出られない恐怖の森みたいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180424,
					"content": "…こんな話を可愛い顔したアランナラが言ってると思うと、よけいに怖いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180425,
					"content": "すくすく成長して早く実をつけないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180426
					]
				},
				{
					"id": 730180426,
					"content": "#{NICKNAME}、おまえまで！おどかすなんてひどいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180427,
					"content": "ナラとパイモンはアランナラみたいに一生ヴァーナで暮らすわけではありません。それは、アランナクラも知っているはずなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180428
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180428,
					"content": "#知ってる…ナラ{NICKNAME}とパイモンには別の使命がある。他のナラと同じように、ヴァーナを出て行く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180429
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730180429,
					"content": "いまこそアランナラの使命を果たすときです。ヴァルナ神器を止めなければ、下には行けません。悪い虫を駆除し、ヴァルナ神器を修理するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180411,
					"content": "#どう考えても{M#俺}{F#私}じゃないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180412
					]
				},
				{
					"id": 730180412,
					"content": "もしそうなったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180413,
					"content": "#へへっ、「{NICKNAME}ちゃん、パイモンがお世話してあげまちゅよ～、抱っこしましょうね～」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180414,
					"content": "不老長寿の効果があったりして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180415
					]
				},
				{
					"id": 730180415,
					"content": "うわぁ、そしたらテイワットのグルメを制覇できるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180416,
					"content": "でも、一緒に食べてくれる仲間はどんどんいなくなるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180417
