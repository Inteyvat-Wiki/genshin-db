	"talks": [
		{
			"id": 7301802,
			"completionStepIds": [
				7301802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301802",
							"2"
						],
						"stepId": 7301802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランパンドゥ",
					"パイモン",
					"アランバリカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180201,
					"content": "#ナラ{NICKNAME}、パイモン、アランナラのために働いてくれてありがとう。小川を塞いでいた小枝が、他の場所に移動したのを感じるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180202
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180202,
					"content": "おお！これでヴァルナ神器の修理に行けるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180203,
					"content": "ええ、間もなく。でもまだです。根系は地下の奥深くに存在しています。地下への入口はヴァルナ秘宝の中心にあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180204
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180204,
					"content": "「ヴァルナ秘宝」、前にアランパンドゥがそんな話してたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180205,
					"content": "#ヴァルナ神器の力を体現するものです。力を発揮したときには、ヴァーナで一番高い木よりももっと大きくなります。ナラ{NICKNAME}とパイモンもとっくに目にしているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180206
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180206,
					"content": "それって、しょっちゅう水の柱が噴き上がってるとこか？…あれの中心から入れっていうのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180207,
						730180209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180207,
					"content": "とても入口には見えないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180208
					]
				},
				{
					"id": 730180208,
					"content": "うんうん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180211,
					"content": "中に入ろうとしたときに、あいつが動き出したら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180212,
					"content": "水の柱はでっかいし、水の勢いもめちゃくちゃ強そうだぞ…これでどうやって真ん中に行ったらいいんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180213,
						730180215,
						730180217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180213,
					"content": "なんとかして上から入るしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180214
					]
				},
				{
					"id": 730180214,
					"content": "#オイラは飛べるけど、{NICKNAME}は無理だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180219,
					"content": "なぜそうなる？水を止めればいいだけじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180220
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730180220,
					"content": "なんだ、あれって止められるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180221,
					"content": "#以前は無理でしたが、ナラ{NICKNAME}とパイモンのお陰でヴァルナ神器が一部復旧しました。今なら、アランナラにもあれが止められます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180222
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180222,
					"content": "オイラたちって、いつの間にかすごいことをしてたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180223,
						730180225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180223,
					"content": "いつの間にか、でもないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180224
					]
				},
				{
					"id": 730180224,
					"content": "う、確かに。夢の林を探すのはめちゃくちゃ大変だったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180227,
					"content": "#ナラ{NICKNAME}、パイモン、一緒に行きましょう。緑の枝に花が咲きました。間もなく実を結ぶでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730180225,
					"content": "パイモンはほんとにすごいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180226
					]
				},
				{
					"id": 730180226,
					"content": "#{NICKNAME}もすごいぞ。へへっ、オイラたち二人ともやるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180215,
					"content": "無理やり正面突破するしかないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180216
					]
				},
				{
					"id": 730180216,
					"content": "滝に打たれる修行ってのもあるらしいけど…むやみに突っ込んでったら、水に呑まれちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180217,
					"content": "脇に地下道を掘って降りていくのはどう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180218
					]
				},
				{
					"id": 730180218,
					"content": "どんな斬新な解決法だよ！…いや、試してみる価値はあるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730180209,
					"content": "入れないって。どうやっても入れる気がしないぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180210
					]
				},
				{
					"id": 730180210,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301804,
			"completionStepIds": [
				7301804,
				7301807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
