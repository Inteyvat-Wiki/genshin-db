			"dialogs": [
				{
					"id": 730182101,
					"content": "これで…しばらくは安全だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182102,
					"content": "#ナラ{NICKNAME}、ヴァルナ神器の根っこをむしばむ悪い虫をやっつけたアナタの勇気に感謝します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182103
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182103,
					"content": "ヴァーナ各地に点在する枝葉からも、どんどんエネルギーが届いています。これでアランナラもヴァルナ神器を治せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182104
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182104,
					"content": "これくらい楽勝だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182105
					]
				},
				{
					"id": 730182105,
					"content": "だから言ったろ。キノコンなんて全然怖くないって！あと十体いたって平気だぞ！ふふんっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182106,
						730182108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182106,
					"content": "ウォーミングアップみたいなもんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182107
					]
				},
				{
					"id": 730182107,
					"content": "#{NICKNAME}がキノコンなんか怖がるわけないだろ。ふふんっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182110,
					"content": "さっきみんなが悪いヤツをやっつけてるとき、パイモンだけが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182111
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730182111,
					"content": "何もしてなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182112
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730182112,
					"content": "#どこがだよ！オイラだって…全力で{NICKNAME}を応援してたぞ。{NICKNAME}にはオイラの気持ち、伝わってるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182113,
						730182115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182113,
					"content": "伝わったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182114
					]
				},
				{
					"id": 730182114,
					"content": "#へへっ、やっぱりオイラと{NICKNAME}は以心伝心だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182117,
					"content": "#とにかく、ナラ{NICKNAME}とパイモンには感謝しているのです。アランナラを大いに助けてくれました。次は、我々ががんばる番です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182118
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182118,
					"content": "うんうん！これで鼻をむずむずさせる胞子ともお別れだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182115,
					"content": "全然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182116
					]
				},
				{
					"id": 730182116,
					"content": "#そんなのありえないぞ！{NICKNAME}はきっと全力でオイラの気持ちを受け止めてくれたはずだ…絶対そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182108,
					"content": "ほんとに十体来たら、パイモンに頼もうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182109
					]
				},
