							"7301822",
							"2"
						],
						"stepId": 7301822,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランパンドゥ",
					"アランナクラ",
					"アランバリカ",
					"アランコンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730182201,
					"content": "うわぁ！空気がかなりきれいになった気がするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182202,
					"content": "思いっきり息ができるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182203
					]
				},
				{
					"id": 730182203,
					"content": "へへっ、これでアシャヴァンレルムはもう大丈夫だ！でも森のキノコンはどうなってるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182204,
					"content": "これから悪いヤツが消えるか消えないかは分からないのです。でも、ヴァルナ神器も治ったことです。「胞子」もそれほど増えることはないでしょう。アランナラは悪いヤツからヴァーナを守ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182205
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182205,
					"content": "苗畑も元気を取り戻すよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182206
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730182206,
					"content": "でもまだマラーナがいる。アランナラのやるべきことは多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182207
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730182207,
					"content": "う…アランバリカはほんとマジメだな。とりあえず一件落着したんだから、アランナクラに思う存分喜ぶ時間をあげろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182208,
					"content": "フン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182209
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730182209,
					"content": "相変わらずだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182210
					]
				},
				{
					"id": 730182210,
					"content": "はぁ…どうすればこいつが満足なのか、全然わからないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182211,
					"content": "パイモンは緊張感がない。油断してると痛い目に遭うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182212
					],
					"speakerTitle": "アランバリカ"
				},
				{
					"id": 730182212,
					"content": "それは前にも聞いたけど、オイラは油断なんかしてないぞ。だってほら、慎重派だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182213,
					"content": "パイモンは教訓をすっかり忘れてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182214
					]
				},
				{
					"id": 730182214,
					"content": "#そうだ、もういっこアランパンドゥに聞こうと思ってたんだ。な、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182215,
					"content": "ヴィマラ村の子供の件について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182216
					]
				},
				{
					"id": 730182216,
					"content": "東のヴィマラ村で妙なことが起きてるんだ。村の子供が突然行方不明になって、でもしばらくするとまた無事に戻ってくるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182217,
					"content": "森のことは、アランナラが一番詳しいだろ。アランパンドゥがなにか知ってたらいいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182218,
					"content": "ヴィマラ村の怪異、ですか…今は難しいかもですが、気に留めておきます。他のアランナラが知っているかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182219
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182219,
					"content": "それに、ヴァナラーナに戻ったら、答えが見つかるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182220
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182220,
					"content": "#ヴァルナ神器ですが…ナラ{NICKNAME}はもうご存知でしょう。アランナラは音楽であれを制御しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182221
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182221,
					"content": "#え？{NICKNAME}も前にアランナラの音楽を習ったよな？じゃあ、オイラたちもヴァルナ神器を制御できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182222,
					"content": "#ナラ{NICKNAME}は自分の力を証明しました。ナラヴァルナと同じく、アランナラの友情にふさわしいナラなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182223
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182223,
					"content": "アランパンドゥが、ヴァルナ神器を制御する曲を教えてさしあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182224
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182224,
					"content": "やった！でも演奏する度に、毎回こんな深い地の底に来なきゃいけないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182225,
					"content": "パイモンは頭がよくないな。ヴァルナ神器はヴァーナの各地から力をもらえる。ってことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182226
					],
					"speakerTitle": "アランコンティ"
				},
				{
					"id": 730182226,
					"content": "ヴァーナの他の処でも制御できるということ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182227
					]
				},
				{
					"id": 730182227,
					"content": "そういうアランナラの豆知識って、普通は思いつくもんじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730182228,
					"content": "源水のメロディーを覚えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730182229
					]
				},
				{
					"id": 730182229,
					"content": "#ナラ{NICKNAME}、それにパイモン。ご協力に感謝するのです。ヴァーナは永遠に忘れません、アランナラも忘れません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182230
					],
					"speakerTitle": "アランパンドゥ"
				},
				{
					"id": 730182230,
					"content": "次はウツァヴ祭で会えるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182231
					]
				},
				{
					"id": 730182231,
					"content": "きっとまた会えます。ヴァナラーナで、金色のナラが楽しい時を過ごせるように祈っているのです。アランムフクンダのご加護がありますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパンドゥ"
				}
			]
		}
	]
}