				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガフォー",
					"リサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060201,
					"content": "ここのコーヒーには詳しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060202
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060202,
					"content": "もちろんよ。わたくしが昔よく飲んでいた物ですもの、よく知っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060203
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060203,
					"content": "ガフォー先輩…いえ、今は兄弟子として呼ぶより、ガフォー先生と言ったほうがいいかしら。わたくしたちもう古い付き合いでしょ。どうしてそう延々と他愛もない話をするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060204
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060204,
					"content": "昔話をしたかと思ったら、今度はコーヒーの話…何か言いたいことがあるなら率直に言ってくれていいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060205
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060205,
					"content": "あの人がオイラたちの探してるガフォーさんだと思うけど、他の人と話してて取り込み中みたいだな。しょうがない、少し待つか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060206,
					"content": "いや、別にこれといった事情などないんだ。ただ、君が教令院を離れてからというもの、当初のプロジェクトと計画からは頼りになる人がいなくなってしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060207
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060207,
					"content": "ジュライセン先生も、君のことを大切な弟子としていつも評価していただけに、失望が大きかったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060208
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060208,
					"content": "リサ、君が教令院を離れたことは、本当にもったいないことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060209
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060209,
					"content": "君ほどの才能と知恵を持つ者があのまま教令院に残っていれば、今ではハーバッドの地位にいたかもしれないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060210,
						735060211
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060210,
					"content": "（リサさんだ！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				},
				{
					"id": 735060212,
					"content": "オイラの聞き間違いじゃないよな？あれって西風騎士団の図書館司書のリサさんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060213,
					"content": "リサさんがスメール教令院で勉強してたっていうのは聞いたことあるけど、それって昔のことだろ？どうしてリサさんが今ここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060214,
					"content": "わたくしの予想が正しければ、あなたは昔の話を持ち出して、ここに連れ戻そうとしているのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060215
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060215,
					"content": "ふっ…聞いたところによれば、今はモンドの西風騎士団で図書館司書をしているそうじゃないか？僕から言わせてもらえば、とんだ役不足だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060216
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060216,
					"content": "自分の時間を浪費すべきじゃない。どうして司書なんていう小さなことに頭を使うんだ、君の時間はどう見ても貴重なものだというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060217
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060217,
					"content": "君が学院に戻ってきてくれるなら、すぐにでも君を責任者として迎えるプロジェクトが大量にあるだろう。今こそ学院は人を必要とし、重要なプロジェクトを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060218
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060218,
					"content": "はぁ…あれこれ言ったけど、結局はわたくしをここに戻したいということね。ジュライセン先生もあなたがこんなことをするなんて思わなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060219
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060219,
					"content": "いや、実は恩師も以前から君に戻ってきてもらって、院内の仕事をしてほしいと考えているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060220
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060220,
					"content": "…あらそう？ガフォー先生、人を騙すのは良くないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060221
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060221,
					"content": "わたくしがなぜたった二年在籍しただけで学院を離れたのか、あの先生はよく知っているはずだわ。だから、そんなお願いをするなんてありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060222
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060222,
					"content": "モンドの生活を捨てて、素論派学者の身分で教令院に戻る…知恵を求めるために必要な代償は、もう自分では払えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060223
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060223,
					"content": "つまり、もうわたくしを連れ戻そうなんて思わないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060224
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060224,
					"content": "うわぁ、リサさんって素論派の学者だったんだな？リサさんからそんな話聞いたことなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060225,
						735060226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060225,
					"content": "静かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060227,
					"content": "それから、司書はとても大事な仕事よ。時間を浪費しているなんて思っていないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060228
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060228,
					"content": "「知恵は世界の隅々にまで秘められている。一滴の中にある知識を軽んじてはならない」、これは先生の口癖だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060229
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060229,
					"content": "優秀な学者は細部を見落とさないわ。…ガフォー先輩、やっぱり昔と同じようにあなたのことは先輩と呼んでもいいかしら…さっきのあなた、言葉の細部を間違えていたわよ…ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060230
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060230,
					"content": "それと、もう一つ見落としている細部があるわね。今この時、二人の人物がわたくしたちの話をこっそりと聞いているわ。しかも長いことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060231
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060232
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060232,
					"content": "そこの二人、わたくしたちに何の用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060233
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060233,
					"content": "へへっ、リサさんこんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060234,
					"content": "久しぶり、リサさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060235
					]
				},
				{
					"id": 735060235,
					"content": "ほら言ったでしょう？やっぱりあなたたちだったのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060236
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060236,
					"content": "お久しぶりね、可愛い子ちゃんにパイモンちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060237
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060237,
					"content": "…お二人はどういったご用件で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060238
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060238,
					"content": "あれだ、オイラたちはスパタ…えーっと…スパンタマッド学院の地脈調査プロジェクトに参加するために来たんだ。さっきエフェンディさんのところで登録してきてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060239,
						735060240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060239,
					"content": "そしたら、ちょうどリサさんがいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060241,
					"content": "地脈調査プロジェクト？可愛い子ちゃん、まさか教令院に入学したのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060242
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060242,
					"content": "ただのプロジェクト志願者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060243
					]
				},
				{
					"id": 735060243,
					"content": "そうそう、連絡員のエフェンディさんから、学術プロジェクトの有償志願者を募集してるって聞いて、ガフォーさんにどういう内容か聞きに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060244,
					"content": "有償志願者を募集？ガフォー先輩、学院の内部はそんなに人が足りていないの？それとも外部の人間を必要とする計画でもあるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060245
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060245,
					"content": "いやいや、これはあくまで通常の地脈監視プロジェクトにおいて必要なことで、すべて安全基準に則っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060246
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060246,
					"content": "地脈のデータを集めるには大量の人手を割くしかない。こちらとしては…君が戻ってきてくれて事務の一部でも手伝ってくれれば、こんな苦労しなくても済むんだがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060247
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060247,
					"content": "わたくしの記憶では、地脈のデータを集めるには秘境の奥深くまで入らないといけないわ。その危険性は決して低くないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060248
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060248,
					"content": "モンドを離れてから旅人とオイラはいろんな戦いを経験してきたんだ！だから、秘境の探索なんてお手のものだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060249,
					"content": "あら、長いこと会っていなかった間に、面白い経験をいっぱいしてきたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060250
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060250,
					"content": "おう、だからリサさんは心配しなくても大丈夫だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060251,
					"content": "お二人ともプロジェクトに参加しに来たのでしたら、もう少し待っててください。リサとの話が終わるまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060252
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060252,
					"content": "ガフォー先輩、残念だけど、わたくしはあなたの期待に応えることはできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060253
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060253,
					"content": "ほんの少しの挽回の余地もない、と？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060254
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060254,
					"content": "あの時、わたくしは自分の考えを貫いて教令院に別れを告げた。このことを後悔はしていないし、これからも…後悔することはないでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060255
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060255,
					"content": "長らく会っていなかったから、気が変わっていて違う反応が返ってくるかもしれないとも思ったが…はぁ、リサ、君は昔と同じで相変わらず頑固なのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060256
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060256,
					"content": "君がそのように言い切ったんだ、僕が無理に説得する必要もなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060257
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060257,
					"content": "なら、これ以上は邪魔しないでおこう、僕にはまだ事務がたくさん残っているのでね。数日後の学院の会合でまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060258
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060258,
					"content": "ええ、安心して先輩。学院の会合には時間通り出席するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060259
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060259,
					"content": "そちらの志願者のお二人は、時間が空いている時にマウティーマ稠林まで僕を探しに来てくれ。協力してほしい仕事がまだ残っているんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060260
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060260,
					"content": "そうだ、最後にもう一つ、リサ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060261
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060261,
					"content": "何かしら、先輩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060262
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060262,
					"content": "モンドでの生活が順調であることを祈ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060263
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060263,
					"content": "…ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060264
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060264,
					"content": "さあ、可愛い子ちゃん、パイモンちゃん、説得が上手な人ももういなくなったし、腰を下ろしてお話ししましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060265,
						735060266
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060265,
					"content": "説得が上手な人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060267,
					"content": "ふふっ…教令院の内部でとんでもないことが起こっているみたいね。わたくしの兄弟子も、自分の前途のために奔走しているのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060268
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060268,
					"content": "そうだ、どうしてリサさんがスメールにいるんだ？騎士団の仕事はほっといて大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060269
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060269,
					"content": "ええ、ジンがわたくしに長めの有給休暇をくれたの。せっかくのお休みだし、旅行でもしてリラックスするのもいいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060270
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060270,
					"content": "あなたたちは聞いたことあるか分からないけど、わたくしはかつてスメール教令院のスパンタマッド学院で二年間勉強していたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060271
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060271,
					"content": "でも卒業した後は教令院に残らず、そのままモンドに戻って、騎士団の図書館司書になったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060272
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060272,
					"content": "つまり、リサさんがスメールに来たのは、いろんなところを観光するためだけじゃなくて、昔の友達や先生と再会するためでもあるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060273
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060273,
					"content": "リサさんはどうして教令院を離れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060274
					]
				},
				{
					"id": 735060274,
					"content": "あら、そんなに気になるのかしら？そうね…とても昔のことだし、あなたたちになら言っても大丈夫ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060275
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060275,
					"content": "しいて言うのなら、理念が合わなかったからかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060276
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060276,
					"content": "当時、教令院にいた頃のわたくしはジュライセン先生に才能を買われて、教令院の核となるプロジェクトに数多く参加させてもらったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060277
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060277,
					"content": "でも、そういったプロジェクトのほとんどは失敗に終わったの。率直に言うと、超人的な知恵を得ようとして遠くに行き過ぎたのよ。失敗して当然だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060278
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060278,
					"content": "わたくしは、もうこのような狂ったことに巻き込まれたくないと思って、だから離れることを決めたの。…さて、あなたたちなら分かってると思うけど、この秘密を知ったからには誰にも言わないことを約束してちょうだいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060279
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060279,
					"content": "うぅ…色々あったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060280
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060280,
					"content": "だから、たとえジュライセン先生が説得に来たとしても、わたくしが教令院に戻ることはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060281
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060281,
					"content": "昼夜問わず実験に没頭する生活よりも、昼前の十時から仕事をして、毎日決まった時間にアフタヌーンティーをする生活のほうがわたくしには合っているもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060282
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060282,
					"content": "やっぱり、リサさんが図書館司書の仕事を選んだのは、面倒なことをしたくなかったからなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060283
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060283,
					"content": "これがリサさんのスタイル。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060284
					]
				},
				{
					"id": 735060284,
					"content": "仕事なんてそんな面倒なことはのんびりやったほうがいいし、定期的に休暇を取るのもとても重要なことでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060285
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060285,
					"content": "はぁ…でもスメールに到着してまだ間もないのに、ガフォー先輩に見つかっちゃったのよ。ガンダルヴァー村であの子を見に行く前にね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060286
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060286,
					"content": "つい話し込んじゃったわね。それであなたたちは？可愛い子ちゃんとパイモンちゃんは、どうしてスメールに来たのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060287
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 735060287,
					"content": "スメールに来た後のことをリサに話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 735060266,
					"content": "ガフォーさんのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060240,
					"content": "二人の会話を邪魔したくなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060226,
					"content": "しーっ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060211,
					"content": "（リサさんがどうしてここに？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				}
			]
		},
		{
			"id": 7350603,
			"completionStepIds": [
				7350603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350603",
							"2"
						],
						"stepId": 7350603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガフォー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060301,
					"content": "君たち来てくれたか。見たところ準備は万端なようだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060302
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060302,
					"content": "うん、問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060303
					]
				},
				{
					"id": 735060303,
					"content": "なら良かった。ではまずは説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060304
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060304,
					"content": "この研究プロジェクトは、スパンタマッド学院が長年取り組んできた地脈の流れをモニタリングするために立ち上げられたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060305
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060305,
					"content": "スメールの秘境内では、地脈の流れに異常が発生することがよくある。そのため、定期的にそれぞれの秘境に人を送って地脈の状態を記録する必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060306
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060306,
					"content": "秘境内は危険な状況であることが多い。だから原則として「戦闘能力を持った人員のみを派遣する」ことになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060307
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060307,
					"content": "君たちがすべきことは、秘境の奥深くまで進んで地脈の異常状況を記録することだ。もし危険な状況に遭遇したら、自分の身を守ることを優先してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060308
					],
					"speakerTitle": "ガフォー"
				},
				{
					"id": 735060308,
					"content": "よし、これで僕からの説明は以上だ。準備ができたら、秘境に入ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガフォー"
				}
			]
		},
		{
			"id": 7350604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
