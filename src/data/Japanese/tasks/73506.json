	"talks": [
		{
			"id": 7350601,
			"completionStepIds": [
				7350601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350601",
							"2"
						],
						"stepId": 7350601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エフェンディ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060101,
					"content": "こんにちは、レグザー庁へようこそ。依頼任務に興味はありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060102
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060102,
					"content": "手間をかけずに、立ってるだけで楽にモラがもらえる依頼ってないか？オイラたち、そういうのにすっごく興味があるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060103,
					"content": "そ…そのような依頼は今のところありませんが、こちらに比較的簡単な住民リクエストがありますよ。報酬は一件あたり数万モラになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060104
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060104,
					"content": "う～ん…数万モラか。ちょっと物足りない気がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060105,
						735060106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060105,
					"content": "モラは多ければ多いほどいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				},
				{
					"id": 735060107,
					"content": "そうだな。エフェンディさん、もっと報酬の多い依頼ってないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735060108,
					"content": "そういった依頼がお望みですか？そうですね…最近、スパンタマッド学院が地脈調査プロジェクトを立ち上げて、有償で志願者を募集しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060109
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060109,
					"content": "スパンタマッド学院には地脈研究を専門とする学者が多く、地脈データの需要も高いです。そういった理由から、地脈異常を調査するために秘境に入ることがよくあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060110
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060110,
					"content": "ただ、今の時期は学院の学生だけでは人手不足ということもあって、多くの志願者を募集せざるを得ないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060111
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060111,
					"content": "彼らの報酬はとても高額な分、志願者に求める素質も厳しくなっています。どうです、興味はございますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060112
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060112,
					"content": "どんな素質を求めてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060113
					]
				},
				{
					"id": 735060113,
					"content": "では、募集要項を確認してみましょう。まずは「一種類以上の武器を巧みに扱えるか」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060114,
						735060115
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060114,
					"content": "片手剣の分野ではかなりの経験を積んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060116,
					"content": "素晴らしい。では「元素への理解はあるか？元素力が扱えるか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060117,
						735060118
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060117,
					"content": "元素反応をとても理解してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060119,
					"content": "はい、旅人さんなら問題なさそうですね。こちらで登録しました。それでは後ほど、志願者の方に必要な物資と報酬を手配しておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060120
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060120,
					"content": "具体的な依頼内容はガフォーさんからお聞きください。ただ、あの方は本日重要な来客対応がありますので、恐らく教令院にはいらっしゃらないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060121
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060121,
					"content": "院内の来客対応の流れを考えると、今日はたぶんプスパカフェにいらっしゃるでしょう。来客の対応が終わった後に、お話を聞きに行くのがよろしいかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060122
					],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060122,
					"content": "まったく、志願者を急募しているという話でしたのに、途中で来客対応に出向いてしまうとは、一体どれほど重要な人物なんでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフェンディ"
				},
				{
					"id": 735060118,
					"content": "元素力を使った戦闘の経験は豊富。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060115,
					"content": "実は武芸マスターなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060106,
					"content": "キラキラ光る石が欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				}
			]
		},
		{
			"id": 7350602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
