			"dialogs": [
				{
					"id": 400390101,
					"content": "北斗はいま孤雲閣の近くで、私のために散乱した群玉閣の収蔵品を回収しているわ。興味があるのなら行ってみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "足りないものが多いわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390202,
					"content": "何が足りないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "以前と比べて、この群玉閣にはまだ多くのものが足りていないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390204,
					"content": "私の所蔵する数々の書籍、家具、装飾品…すべてかつての群玉閣と共に海の中へ落ちていったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390205,
					"content": "それらのほとんどは、あの災害時に破損してしまったの。壊れていないわずかなものも、海面上に散らばっていて回収が極めて困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390206,
					"content": "水上での作業が得意な人にしか任せられない仕事ね。ただ…北斗がそれらを回収できるかどうかは分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390207,
					"content": "回収？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "えっ？北斗にそれらを回収させにいったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400390209,
					"content": "「させる」というのは正しくないわね。私たちの間にあるのは、常に公平な交渉よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390210,
					"content": "北斗はお金で仕事を受けたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "「お金」以外に、他の「報酬」もあるわ…ふふ、こういうことは複雑なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390212,
					"content": "とにかく、北斗はいま孤雲閣一帯にいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400390213,
					"content": "もし興味があるのなら、そこへ行ってみて。もしかしたら、彼女の助けとなれるかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003904",
							"2"
						],
						"stepId": 4003904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "あの面倒な女め…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390402,
					"content": "海に落ちて粉々になった群玉閣だ、その中に収蔵されてた物もどうせ全部壊れてるに違いないってのに…それを回収するだと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390403,
					"content": "回収は順調？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "よぉ、旅人じゃないか。どうしてあんたたちが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390405,
					"content": "手伝いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "おお、そうか！ちょうどいい時に来たな。いま船員を総動員してるんだが、それでも人手が足りてないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390407,
					"content": "ほら、辛炎にまで手伝ってもらってるくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390408,
					"content": "辛炎も来てるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "なんで辛炎が船にいるんだ？もしかしてライブでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400390410,
					"content": "そうだぜ！つっても正式なライブじゃねぇんだけどな。北斗さんが宴会をやるって言うから、アタイが何曲か歌いに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400390411,
					"content": "でも始まる前に、突然凝光の秘書を名乗る人がやって来て、北斗さんを連れて行っちまってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400390412,
					"content": "百聞か百暁って言ったっけか？あー…あんま覚えてないんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390413,
					"content": "とにかく、凝光の気まぐれで、海の上にある収蔵品を回収してやることになった。もちろん、多額の労働費用を支払ってもらう代わりにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390414
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390414,
					"content": "ふんっ…報酬には文句のつけようがなかったから、この仕事を引き受けたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390415
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390415,
					"content": "回収には、必ず小さな船を使う必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390416
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390416,
					"content": "だが、船隊で動かせる小船はもう全部出しちまっててな。今は使える船が一隻も余ってないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390417
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390417,
					"content": "小さな船を一隻持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390418
					]
				},
				{
					"id": 400390418,
					"content": "あんたが船を？ならちょうどよかった、あんたの船に乗るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390419
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390419,
					"content": "人手は多ければ多いほど効率も上がる。宴会を開いてこの祭日を祝うためにも、さっさと終わらせようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
