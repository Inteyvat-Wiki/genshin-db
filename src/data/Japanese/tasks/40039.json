			"dialogs": [
				{
					"id": 400390801,
					"content": "おい、お前ら！やめろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390802,
					"content": "なんてことしやがる！北斗の姉御のことも知らねぇのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390803,
					"content": "あはは…北斗の姉御、お久しぶりです、相変わらず鮮やかな身のこなしで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390804,
					"content": "カルメン、久しぶりだな。また少し太ったんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390805,
					"content": "そのままだと、茂みに体を隠せなくなるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390806,
					"content": "あはは、姉御の冗談は面白いですね…ははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390807,
					"content": "本題に入ろう。これらの物はアタシが回収する。持ってる物を全部置け、悪いようにはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390808,
					"content": "は、はい、北斗の姉御の言う通りに…お前ら、持ってるもんを全部置け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390809,
					"content": "では、すべてここに置いておきますので…私たちはこれでッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "カルメン"
				},
				{
					"id": 400390810,
					"content": "カルメンは宝盗団を連れてそそくさと離れていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "すんなりと協力してくれたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400390812,
					"content": "素早い投降だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "逃げるのも早かったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400390814,
					"content": "あいつらに構ってる暇はない。早く海に出て回収の続きをしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 400390815,
					"content": "そうだ、あいつらが置いてった物を船に運ばないとな…旅人、ちょっと手伝ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "北斗"
				}
			]
