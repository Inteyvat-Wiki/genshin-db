			"dialogs": [
				{
					"id": 706590301,
					"content": "コホンッ、これ以上言っても仕方ない。直接遊んでみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706590302,
					"content": "「風の行方」を遊ぶ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "離れる",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "わかった。「風の行方」が遊びたかったらまたここに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				}
			]
		}
	]
}