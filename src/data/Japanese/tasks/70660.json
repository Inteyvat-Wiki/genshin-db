			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイガックス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "やあ、「風の行方」に参加しないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600202,
					"content": "「風の行方」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "いい質問だ。「風の行方」とは、モンドの歴史がぎゅっと詰まったナイスなゲームだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600204,
					"content": "かつて、このモンド城には「貴族」がいたことを君も知っているね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600205,
					"content": "彼らはモンド城で数々の悪行を成し、多くの人々を苦しめた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600206,
					"content": "そんな貴族たちの悪事に抗うため、勇敢なモンド人が集まった。そして、秘密の反抗組織を作り上げたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600207,
					"content": "その勇敢な者たちはモンドで活動し、貴族たちに大打撃を与えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600208,
					"content": "しかし、貴族たちも黙ってはいなかった。その者たちを鎮圧するために、すぐさま手下の訓練を始めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600209,
					"content": "こうして、反抗組織と貴族たちの対決が、モンドの各地で繰り広げられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600210,
					"content": "「風の行方」は、そんな壮大な歴史に基づいて作られたゲームなんだ！昔はとても人気があったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600211,
					"content": "昔は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "ああ、最近の若者はあまり「風の行方」に興味ないみたいでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600213,
					"content": "だが、このまま「風の行方」が廃れていくのを見ているだなんて耐えられない。そこで、元のルールに少し手を加えて、より分かりやすく、そして面白くしてみた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600214,
					"content": "さらに、新しいマップも用意してね。これなら、もっと多くの人に興味を持ってもらえるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600217,
					"content": "「風の行方」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "前に一度「風の行方」を遊んでくれる人を募集したことがあるんだ。その中に、凄い上手な人が何人かいてね。かなり印象に残ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600219,
					"content": "ただ、その他の人たちからは、ゲームが難しすぎると言われたことがあった。「レンジャーをやってもなかなか逃げ切れない」とか、「ハンターをやってる時に相手を見つけられない」とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600220,
					"content": "それから、こういった声もあった。「上手くなるには、各マップの細かいところまで覚えないといけないから、面倒くさい」ってね。あと、ゲームをもっとシンプルにして欲しいって人もいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "ガイガックス"
				},
				{
					"id": 706600221,
					"content": "はぁ、俺には彼らの意見が正しいのか、未だに判断できなくてね。だから、またゲームに参加してくれる人を募集して、意見を聞こうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイガックス"
				}
			]
		},
