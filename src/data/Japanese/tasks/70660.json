					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "こんにちは、旅人さん。ここ最近、冒険は順調ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600102,
					"content": "まあまあかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "それは何よりです。この勢いで頑張っていけば、きっと偉大な冒険者になれますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600104,
					"content": "そうだ。もし興味がありましたら、ガイガックスさんのところで、最新の「風の行方」を試してみてはいかがでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600108,
					"content": "それって…冒険者協会と関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "実はですね…ガイガックスさんがうちに依頼を出したんです。「風の行方」を試してくれる助っ人を募集して欲しいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600110,
					"content": "ですので…一応、関係があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600111,
					"content": "もしよかったら試してみてください。それに、実際に「風の行方」を遊んだ冒険者たちからはとても評判がいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600105,
					"content": "何か新しい依頼はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "依頼は…特にありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706600107,
					"content": "ですが、もし興味がありましたら、ガイガックスさんのところで、最新の「風の行方」を試してみてはいかがでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
				7066005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
