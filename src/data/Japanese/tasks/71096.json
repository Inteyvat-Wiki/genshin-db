			"dialogs": [
				{
					"id": 710960101,
					"content": "「老石」は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960102,
					"content": "持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "また「老石」三個だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960202,
					"content": "「親切な民」二人から頂いた「老石」、確かに受け取った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960203,
					"content": "もう三枚も見つけてくれたのか。しかも品質もこれまで見たものより遥かに優れている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960204,
					"content": "はぁ…これは、俺が昔持ってたやつを思い出させるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960205,
					"content": "おまえが持ってたやつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710960206,
					"content": "#持ってるのに{M#俺}{F#私}たちに探させたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "「昔」持ってただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960209,
					"content": "その「老石」は盛露庁にいた父が持っていた端材で、品質もいまいちだった。だからおもちゃとして俺に渡してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960210,
					"content": "あの頃は定職にも就かずにぶらぶらしてた。毎日のように父と喧嘩しては、当時の岩上茶室に居座ってたよ。借金までして、俺は絶体絶命だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960211,
					"content": "あ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710960212,
					"content": "酷かったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "ああ、正に若気の至りだったよ。とにかく、俺が窮地に陥ったとき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960214,
					"content": "あれを「老石」だと見抜いた人物が現れたんだ。俺はただの石だと思ってたから、その石をモラに変えて窮地を何とか乗り越えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960215,
					"content": "そしたらこの間、父に「沐寧、昔お前が遊んでた石はどこにやった？」と聞かれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960216,
					"content": "「ただの石だ。まだ持ってるわけないだろ。」としか、答えようがなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960217,
					"content": "そう答えながらも、心の中ではずっとモヤモヤしてた。もしあのとき石を売らなければ、父に見せてやれたのにってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960218,
					"content": "…まあいい、こんな話をしても無駄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960219,
					"content": "おまえは正しい道に戻ってこれたんだから、もう大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710960220,
					"content": "そうだな…それでも借りた金はコツコツと返さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960221,
					"content": "この話は終わりだ。老石があったら、持ってきてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960222,
					"content": "まだ足りないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "あと三枚探してくれれば足りるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960225,
					"content": "老石は元から希少な鉱物なんだ。たとえ輝山庁がこれ以上の数を求めているとしても、恐らく層岩巨淵ではもう見つからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710960223,
					"content": "あとどれくらい必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "まずは自分のを上納するべきじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}