			},
			"dialogs": [
				{
					"id": 140160801,
					"content": "これ以上時間を無駄にできないぞ。ボスの忍耐にも限界がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "マルティナ"
				},
				{
					"id": 140160802,
					"content": "明日になったら即行動だ。あんたは勝手にすりゃあいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "マルティナ"
				},
				{
					"id": 140160803,
					"content": "自動釣り竿が動かなかったのもパーツが一つ足りなかったせいだったから、そう考えてみると、お互いフェアだったってことになるかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160804,
					"content": "欠けてたものの数ってことで言えば確かにそうかもしれないけど…ふぁあ～…もうダメだ。オイラ、もうこれ以上起きてられないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160805,
					"content": "ははっ、じゃあさっさと休もっか！今日は楽しかったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160806,
					"content": "また明日、ナヴィア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "うん！また明日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160808,
					"content": "どうだった、昨日はよく眠れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160809,
					"content": "ヒトデと一緒にダンスパーティーで踊る夢を見たぜ。「人手」が多くてなかなか楽しかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160810,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160811,
					"content": "…どこでそんなの学んできたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "ハハッ、お前、なかなかユーモアセンスがあるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160813,
					"content": "ほら！面白いって思ってくれる人だっているぞ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "パイモン"
				},
