				]
			},
			"dialogs": [
				{
					"id": 140160601,
					"content": "夕飯を食べ、ショーを観て…賑やかな一夜が過ぎていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "すべてが静まり返った頃、部屋に戻ったあなたとパイモンは、扉がノックされる音を聞いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "もう寝た？まだ起きてるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160604,
					"content": "ナヴィア？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "ううん、ただせっかく素敵な夜だから、このまま終わるなんてもったいないなあと思って。そう思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160607,
					"content": "ってことで、釣りに行かない？道具は揃えてあるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160608,
					"content": "晩ご飯の前に言ってた「準備」って、これのことだったんだな！すぐ行くから待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160609,
					"content": "えへへ、邪魔しちゃった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160610,
					"content": "ううん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "安心して。こんな時間だし、元気ないかもって時のことも考えて、ちゃーんと準備してあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160612,
					"content": "お喋りに付き合ってくれるつもりでいいからさ、どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160615,
					"content": "さ、早く釣りに行きましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160613,
					"content": "#{M#君}{F#あなた}の誘いなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "えへへ、それでこそあたしの相棒だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160605,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
			"id": 1401607,
