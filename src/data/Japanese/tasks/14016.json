						],
						"pointId": 340100396
					}
				]
			},
			"dialogs": [
				{
					"id": 140160501,
					"content": "また来たぞー！へへ、なんか来るたび親しみを感じるようになってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160502,
					"content": "棘薔薇の会のフォンテーヌ廷での拠点が、パレ·メルモニアみたいに豪華な場所だったら、むしろ合わないって思っちゃいそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160503,
					"content": "ははっ、確かにそうだね。あたしも同意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160504
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160504,
					"content": "でもパパはね、棘薔薇の会が発展していった暁には、ポワソン町もフォンテーヌ廷に負けないくらいの大都市になれるって…そんなビジョンを描いてたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160505
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160505,
					"content": "大きな野望を持ってたから、目先のことも過去のこともあんまり考えなかったの。だからこそ、一般人とは違う特別な資質も色々あったんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160506
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160506,
					"content": "それもまた、一部のやつらがカーレスさんを尊敬しつつ恨んだ理由でもあるけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160507
					],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160507,
					"content": "よし。あんたたちは先に店に行って待っててくれる？あたしは中で少し準備をしてくるよ。ついでにあんたたちの部屋を整えてもらうよう手配するね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160508
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160508,
					"content": "部屋は前回と同じよ。覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160509
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160509,
					"content": "おう！ま、部屋は多くないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160510,
					"content": "あ～っ、ここが貧乏くさいって言いたいのね！このっ、今すぐあんたの枕に水草をいっぱい仕込んで来てやるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160511
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160511,
					"content": "ごめん！ごめんって！そんなことされたら本当に眠れなくなっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160512,
					"content": "へへっ、冗談冗談。じゃ、先に行ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				}
			]
		},
