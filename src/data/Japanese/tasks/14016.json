						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "自動釣り竿を使うのかよ…こんなの釣りって言えるか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160702,
					"content": "え？ダメなの？こういう釣り竿、ポワソン町じゃよくあるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160703,
					"content": "釣りって、その…こう、精神を集中させて浮きを見つめながら、針に食いつくタイミングを見計らって、釣り上げる瞬間を楽しむものなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160704,
					"content": "それも確かにひとつの楽しみ方だよね。相棒、あんたはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160705,
					"content": "手動のほうが面白い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "自動のほうが楽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "じゃあ次は普通の釣り竿を使って、どっちが沢山釣れるか勝負しましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160708,
					"content": "えへへ、でしょでしょ。とにかく、魚を釣れたら楽しいんだからそれでいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160709,
					"content": "それよりナヴィア、なんでおまえはこんなに元気いっぱいなんだよ。こんな遅い時間、オイラでさえ…ふぁあ…眠くなってきてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160710,
					"content": "生まれつきってところかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160711,
					"content": "それだけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160712,
					"content": "詳しく説明し始めたら、もっと眠くなるかもよ？ふふっ、でもそうね…多分だけど、棘薔薇の会とママのおかげかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160713,
					"content": "お母さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "パパは、ちっちゃい頃からずっと、あたしに現実離れした期待を寄せてた。パパと同じようになって欲しいって、押し付けられれば押し付けられるほど…話を聞きたくなくなるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160715,
					"content": "でもママのほうはそうじゃなかった。あたしに対して、ママが望んだことは一つだけだったんだって。それはね…あたしが楽しい日々を過ごしながら大人になれますようにってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160716,
					"content": "棘薔薇の会のメンバーたちは、みんなママの考えを尊重してるから、あたしがどれだけはしゃいでも、甘やかしてくれるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160717,
					"content": "想像できる？あたしが何かやらかすとね、マルシラックとシルヴァも含めたみーんなが二列にずらっと並んで、パパ一人だけが激怒するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160718,
					"content": "でも、みんな黙りこくって何にも言わないでしょ？そしたら段々、大した問題でもないことにずっと怒ってるパパの度量が小さく見えてくるの。それで最後には、パパも黙るしかなくなるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160719,
					"content": "そんなこともあったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160720,
					"content": "うん。思い返すと、みんな本当に優しい人たちだったんだなって思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160721,
					"content": "小さい頃のあたしは、やりたいことなら何でもやれるって思ってた。だって後始末をしてくれる人が、いつも付いててくれたんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160722,
					"content": "でも、ある時マルシラックが怪我をして…ついに原因は教えてくれなかった。でも、あたしには分かる。あれはあたしのせいだったんだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160723,
					"content": "——過ちの責任を負う人は、必ず存在する。だから周りを大切にすればするほど、過ちは犯せなくなるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160724,
					"content": "だって、罰が下されたとき…みんなは身を挺して、代償を支払おうとしてくれるんだもん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160725,
					"content": "ナヴィア…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "やっぱりつらいよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "ごめん、ごめんね。こんな話、持ち出すべきじゃなかったよね。今夜は悲しい話をしに来たわけじゃないんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160728,
					"content": "とにかく、棘薔薇の会が今みたいな雰囲気になったのは、絶対にパパじゃなくて、ママのおかげだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160729,
					"content": "これって、もしかするとママからの愛を感じるための唯一の方法かもね。あたしね、ママの優しさを受け継いでいきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160730,
					"content": "だから昼に会ったやつらを見逃してやったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160731,
					"content": "そうね、過去の出来事から学んだ教訓ってやつかな？少なくとも、独りよがりにはなりたくないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160732,
					"content": "あれ…見て、浮きが動いてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160733,
					"content": "でも、なんで釣り竿が糸を引いてくれないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160734,
					"content": "多分、パーツの不具合じゃないかな。こんな釣り竿組み立てるの、初めてだったから…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160735,
					"content": "逃がさないで！捕まえるのよ！早く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160736,
					"content": "オ、オイラもやるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160737,
					"content": "力を合わせて、やっとその大きな魚を釣り上げた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "おまえ、針を付けてなかったのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
