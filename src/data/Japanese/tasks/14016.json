			"dialogs": [
				{
					"id": 140160101,
					"content": "リュディヴィーヌ、来たよ。どう、繁盛してる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160102,
					"content": "棘薔薇の会のお嬢様が来てくれなくちゃ、このしょぼいお店はすぐおしまいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "リュディヴィーヌ"
				},
				{
					"id": 140160103,
					"content": "ハハッ、お前はコネも手段もたっぷり持ってるだろうが。そんな冗談、誰も信じないぞ。でもって、この人はもうボスだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160104,
					"content": "あら、失礼しました。つい癖で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "リュディヴィーヌ"
				},
				{
					"id": 140160105,
					"content": "今日は完成品を取りにいらしたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "リュディヴィーヌ"
				},
				{
					"id": 140160106,
					"content": "そうなの。さっきもフォンテーヌ廷に来てたんだけど、忘れちゃってたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160107,
					"content": "まあ、こんな些細なこと、部下に任せても全然問題ないでしょうに、お嬢様が直々に来てくださるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "リュディヴィーヌ"
				},
				{
					"id": 140160108,
					"content": "ナヴィアはいつも大げさだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160109,
					"content": "大げさなんかじゃないよ。気分転換だって旅の重要な目的なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160110,
					"content": "新しい旅ほど、癒されることはないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160111,
					"content": "ハハッ、ボスの言う通りだ。少なくとも一人で落ち込むより、ずっといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160112,
					"content": "ふふ、少々お待ちくださいね。今すぐ取って参りますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "リュディヴィーヌ"
				},
				{
					"id": 140160113,
					"content": "そういえば、アデルはなんで棘薔薇の会に入ろうと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160114,
					"content": "へへっ、具体的な理由はうまく言えなかったんだけどね…ただあたしのことが好きだからって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160115,
					"content": "あの一件の後、だいぶ明るくなったんだよ。多分、お父さんが期待を裏切るような人じゃなかったってことが、やっと分かったからかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160116,
					"content": "あの子ね、あたしのパパが怖かったから、棘薔薇の会はみんな怖い人ばかりなんだと思ってたって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160117,
					"content": "でも、今の棘薔薇の会の雰囲気は変わったでしょ。それでやっとあたしと話す勇気が出て、自分のことを分かってもらえるって思えるようになったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160118,
					"content": "#{M#君}{F#あなた}たちは似たような経験があるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "うん、そうかもね。あたしは真相を探る中であの子を助けることになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160120,
					"content": "アデルも他の人が手を差し伸べてくるのをただじっと待ってるんじゃなくて、あたしみたいに自分から他の人を助けたいって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160121,
					"content": "優秀な棘薔薇の会のメンバーになれそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160122,
					"content": "あたしもそう思う！でも、まずはあの子が健康に成長できる環境を作らないとね。選択は、大きくなったあの子自身に託すことにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160123,
					"content": "（やっぱり気のせいじゃない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "あれ？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160125,
					"content": "ついてきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "え？び、尾行！？わかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140160128,
					"content": "あたしも見てくるわ！コルター、衣装をお願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140160129,
					"content": "ああ、わ、分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コルター"
				},
				{
					"id": 140160126,
					"content": "尾行されてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
