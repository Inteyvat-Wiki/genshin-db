			"dialogs": [
				{
					"id": 708020101,
					"content": "今度こそ、お父さんを見つけられるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020102,
					"content": "お父さんについて何か分かった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020104,
					"content": "パラド兄さんがね、サイリュスおじさんがお父さんの情報を見つけたって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020105,
					"content": "まだ確定してないけど…今回の手がかりはかなり有力で、もしかしたら本当にお父さんを見つけられるみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020106,
					"content": "ボクも一緒に雪山に行きたかったけど、何か情報があったら教えるから拠点で待つようにって、サイリュスおじさんに言われたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020107,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、もしよかったら、サイリュスおじさんに情報を聞いてきてくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "ボ、ボクは…よくない情報を聞くのが…怖いの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020111,
					"content": "#とにかく、頼んだよ！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 708020109,
					"content": "なんで自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
