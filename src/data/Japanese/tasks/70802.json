			},
			"dialogs": [
				{
					"id": 708020401,
					"content": "旅人、帰って来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020402,
					"content": "パラドが捜索を始めた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "そうか、あいつもたまには役に立つな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020406,
					"content": "手元にある情報を整理したら、俺もジョエルに会ってくるよ。そして、事情を詳しく説明してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020407,
					"content": "旅人、先にジョエルに伝えてきてくれないか。俺は後ですぐに行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020408,
					"content": "情報の整理にはもう少し時間がかかりそうなんだ。あの子に何も知らせないで待たせちゃ悪いからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020404,
					"content": "本当にその人を見つけられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "それは…保証できない。ただ確実に言えるのは、俺たちは必ず最善を尽くす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "サイリュス"
				}
			]
		},
