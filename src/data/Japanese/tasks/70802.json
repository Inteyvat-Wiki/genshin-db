					"うっかりパラド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "まさかこのエリアに…パラド、間違いないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020202,
					"content": "もちろんです、サイリュスさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020203,
					"content": "ジョエルのお父さんの話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "旅人じゃないか。ジョエルのところから来たみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020205,
					"content": "あの子、毎日人に頼んで、俺から情報を聞いてるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020206,
					"content": "だが、今回はやっといい知らせを伝えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020207,
					"content": "この前、冒険者協会が「雪山特訓」を開催してな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020208,
					"content": "サイリュスさん、後は俺から説明します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020209,
					"content": "その特訓に向かう途中、俺は雪と風の影響で、予定していたルートから外れてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020210,
					"content": "そして、手探りでルートに戻ろうとした時、突然、崖の上にぼんやりとした人影を見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020211,
					"content": "最初は、俺と同じように迷っている冒険者かと思い、大声で彼に呼びかけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020212,
					"content": "だけど、その人が気づく前に…俺の声は魔物たちを引き寄せてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020213,
					"content": "雪山の環境の中で、あれらの魔物を倒す自信がなく、撤退するしかなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020214,
					"content": "それで戻ってから、この件をサイリュスさんに伝えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020215,
					"content": "あの人影はジョエルのお父さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "まだ分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020218,
					"content": "いずれにせよ、誰かが雪山に閉じ込められたことを知った以上、救出に向かわなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020219,
					"content": "その人がジョエルの父であるジョセフさんかどうかは、運次第だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020220,
					"content": "とにかく、協会の中で雪山に入れる実力者に、救出の手伝いを頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 708020221,
					"content": "俺も準備してから、救出に参加する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020222,
					"content": "一緒に行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "手伝ってくれるのか？よかった、それじゃ一緒に出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020223,
					"content": "#魔物は{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が倒す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "ただ迷った冒険者かもしれない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
