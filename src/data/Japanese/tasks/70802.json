			"dialogs": [
				{
					"id": 708020301,
					"content": "やっと少し安全になった、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020302,
					"content": "ジョセフさんについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "はぁ…今のところ目ぼしい手がかりはないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020304,
					"content": "でも、この近くは安全になったから、俺も引き続き手がかりを探すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 708020305,
					"content": "君は協会に戻って、俺が捜索を始めたことをサイリュスさんに伝えてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "うっかりパラド"
				}
			]
		},
		{
