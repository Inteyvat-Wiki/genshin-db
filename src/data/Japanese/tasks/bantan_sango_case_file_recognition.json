					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#ふぅ、やっと終わったな。でも、なんで急に戦闘が始まったんだう…影狼丸、さっきまで友好的だったのに…{NICKNAME}がいてくれてよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340902,
					"content": "#あれ、なんで影狼丸が{NICKNAME}の後をついてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340903,
					"content": "ワウワウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340904,
					"content": "なんか嬉しそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "なに言ってるかわかるのか？オイラにはさっぱりわからないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340906,
					"content": "#もし私の推測が正しければ、影狼丸はすでに{NICKNAME}さんの忍犬になりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340907,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340908,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "忍犬の契約方法については、私も少ししか聞いたことがありません。忍犬に認めてもらうには、その忍犬を倒す必要があると言われています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340910,
					"content": "忍者はより強力な仲間を必要とする、それは忍犬も同じこと。互いに認め合ってこそ、契約することができるのです。見たところ確かにそのようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340911,
					"content": "#でも{NICKNAME}は忍者じゃないし…それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340912,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340913,
					"content": "パイモン、どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}、約束してほしいことがあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340915,
					"content": "どんなこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "聞く前に約束してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340917,
					"content": "分かった、約束する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "たとえ、影狼丸と契約をしても、オイラが最高の仲間だってことを忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340919,
					"content": "うん、パイモンは最高の仲間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "よし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340921,
					"content": "猫と犬よりかは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "えへへ、オイラたち、ずっとずっと最高の仲間だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340924,
					"content": "コホンッ、仲がよろしいようで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340925,
					"content": "ところで、影狼丸は強い実力を持っているのに、なぜその方は世話を任せるような手紙を残したのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340926,
					"content": "#オイラ知ってるぞ！ほら、{NICKNAME}だってすごく強いだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340927,
					"content": "確かにとても強いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340928,
					"content": "#でも、もしある日、万が一なにかあって、オイラと{NICKNAME}が離れ離れになったとしたら、オイラも絶対に悲しむ。これは、{NICKNAME}が強いかどうかとはまったく関係ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340929,
					"content": "#うぅ…オイラ、縁起でもないこと言ってるな。ただの例えだからな！オイラと{NICKNAME}は最高の仲間なんだ、絶対に離れないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340930,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "パイモンさんの推理はとても合理的です。であれば唯一残っている問題は、どうしてこの犬が動物たちを盗み、守っていたかということですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340932,
					"content": "うーん…それは…頭のいいオイラにもわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340933,
					"content": "残念だけど、影狼丸は言葉を話せないからな…もし話せたら質問できたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340934,
					"content": "珊瑚に聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "おう、そうだな！こんな時は頭脳派の出番だぜ。珊瑚のところに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340936,
					"content": "はい、私は先に動物たちを送り届けますので、探偵所で会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340922,
					"content": "パイモンの方が頼りになる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
