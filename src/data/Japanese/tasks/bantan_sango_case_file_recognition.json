					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "珊瑚所長、戻りました。それで、状況なのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341002,
					"content": "なるほど。どうして影狼丸が動物たちを守ってたのか、大体わかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341003,
					"content": "動物たちを強くしたかったんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341004,
					"content": "影狼丸は、小さいころ弱かったけど、成長して強くなった。だから同じように、訓練を通して他の動物たちも強くしたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341005,
					"content": "でも弱いものを守る旅人を見て、旅人を主として認めたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341006,
					"content": "これも、弱者への同情心から来るものかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341007,
					"content": "まあ、これは私が手がかりを参考にして推理したものに過ぎないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341008,
					"content": "でも実際の状況は、ほとんど同じだと思うわ。影狼丸は言葉を話せないから、正確な答えは得られないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341009,
					"content": "珊瑚の言うこともすごく合理的だ！さすが頭脳派だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341010,
					"content": "ワンワンワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400341011,
					"content": "珊瑚の言うことが正しいって言ってるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341012,
					"content": "お世辞を言ったからって、今度の依頼が安くなるなんて考えないでよ。まあでも、事件は解決したわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341013,
					"content": "#{NICKNAME}さん、パイモンさん、ありがとうございます。お二人のおかげで解決できました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341014,
					"content": "あっ、それと「四方の網」、使ってみた感じはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341015,
					"content": "使いやすかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "そう、今度友人に言ってみるわ。ありがとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341018,
					"content": "#気にするな！これからもなにか手伝ってほしかったら、オイラたちを呼べよ！{NICKNAME}はすごいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341019,
					"content": "旅人は確かに並外れた実力を持ってるわね。でもやっぱりお世辞はよしてちょうだい、感情は真実の敵だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400341016,
					"content": "壊れないか心配だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
