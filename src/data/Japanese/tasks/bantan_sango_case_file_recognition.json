			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "うん、やっぱり来たわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340103,
					"content": "龍二なら、今ある手がかりと私の推理に従って、ヤシオリ島へ調査に行ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340104,
					"content": "場所をマップに記しておくから、今から行けば合流できると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340105,
					"content": "なんで急にこんな慌ただしいんだ？前は探偵所でオイラたちを待ってたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340106,
					"content": "もう終わりに近いからよ。君たちも早く行って、真相が明らかになる瞬間を見届けてくるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400340107,
					"content": "#そう言われたら、オイラもう待ちきれないぜ。はやく行こう、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "龍二！来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340202,
					"content": "なるほど…あなたたちは後から来ると所長に言われていたので、先に調査していたのですが、確かにその通りでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340203,
					"content": "おう！おまえがここにいるって珊瑚から聞いたんだ！それで、調査はどうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340204,
					"content": "あれ、動物が入ってる檻がたくさんあるのに…周囲には誰もいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340205,
					"content": "さっき離れていきました、宝盗団です。珊瑚所長によると、彼らは犬を盗んで「宝探し犬」に訓練しようとしているらしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340206,
					"content": "宝盗イタチみたいな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "ええ、宝盗イタチと似ています。ただ宝盗イタチはやんちゃで、訓練が難しいため、失敗する可能性が高い。だから今回、より忠誠心の高い「犬」を目標にしたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340210,
					"content": "以前にも宝盗団に関する依頼を処理したことがありました。今考えると、珊瑚所長の言ったことが正しかったのが分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340211,
					"content": "人には足跡があるように、組織にも特有の痕跡があるのです。この事件において、迷子の動物や閉じ込められた動物など、痕跡は多数ありましたが、最終的にはどれも宝盗団に向けられていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340212,
					"content": "当時の解決方法を参考にして、ここへ調査に来たのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340213,
					"content": "しかし見張りをつけていないとは。以前の事件と比べて、今回のやつらは大雑把ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340214,
					"content": "#きっとそそっかしいやつらなんだ！でも、{NICKNAME}も、ここ何日かずっと戦ってて疲れたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340215,
					"content": "だからやつらがいないうちに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "そうだな、そうしようぜ！えへへ、オイラたち、ますます息が合うようになってきたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340216,
					"content": "こっそり救出しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "パイモンみたいな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "パイモン"
				}
			]
		},
