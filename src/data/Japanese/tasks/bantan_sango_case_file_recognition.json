					"content": "ワゥ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340603,
					"content": "こ、これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340604,
					"content": "笠かぶり犬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "違うぞ！なんだよそのあだ名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340609,
					"content": "何はともあれ、私たちを攻撃するつもりはないようで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340610,
					"content": "ワンワン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "影狼丸"
				},
				{
					"id": 400340611,
					"content": "あっ、逃げたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400340612,
					"content": "走りながらこちらを振り返っています。もしかして、ついて来いということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340613,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "はい、真相はすぐ目の前にあるのかもしれません…もしかしたら、珊瑚所長の予想通り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340606,
					"content": "刀持ち犬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "笠かぶり犬ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400340608,
					"content": "黒い影。",
					"roleType": "TALK_ROLE_PLAYER",
