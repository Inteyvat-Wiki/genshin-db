			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影狼丸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "ふぅ、やっと追いついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341102,
					"content": "ん？これは…一通の手紙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341103,
					"content": "見てみましょう、今ある唯一の手がかりですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341104,
					"content": "おう！どれどれ、なにが書いてあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341105,
					"content": "「縁深きお…」うーん、ボロボロでよく見えない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341106,
					"content": "おそらく「縁深きお方へ」でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341107,
					"content": "そっか、それで続きは…「我々は忍犬を訓練する一族であり、忍者たちへ数多の頼れる仲間をもたらしてきました」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341108,
					"content": "「…この徴兵令によって、おそらく私はもう帰って来られないでしょう。この一生に悔いはありませんが、唯一影狼丸のことが心配でなりません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341109,
					"content": "「影狼丸がまだ小さかった頃は、とても弱く、忍者たちが一通り契約を終えた後も、ずっと取り残されていました。しかし私は訓練士として、どんな犬でもあきらめることができませんでした」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341110,
					"content": "「絶え間ない努力を経て、影狼丸は実に強くなりました。ただ惜しいことに、影狼丸はどの忍者とも契約をしたがらないのです」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341111,
					"content": "「戦争はまだ始まっていませんが、奉行所がますます忙しくなっています。もう影狼丸にかまう余裕はなく、離れなければなりません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341112,
					"content": "「私にできるのは、この手紙を残すことだけとなりました。いつの日かどなたかがこれを見つけた時は、どうか私の代わりに影狼丸の世話をしてやってください」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341113,
					"content": "「影狼丸は顔のところに、幼い頃に残した傷跡があります。たたずまいも他の犬とは違いますので、一目でわかるはずです」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400341114,
					"content": "手紙にある影狼丸はおそらく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400341115,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちを連れてきたこの犬のこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "たしかにわかりやすいな！それから手紙の続きは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "パイモン"
				},
				{
