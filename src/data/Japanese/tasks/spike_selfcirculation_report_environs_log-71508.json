			"dialogs": [
				{
					"id": 715080101,
					"content": "さすがは君だ…「プルシナスパイク」もあまり傷ついてないし、周りの黒泥と魔物も片付いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715080102,
					"content": "ヘディーヴの探してくれた助っ人が君で、本当によかった。もし他の冒険者だったら、この問題は解決できないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715080103,
					"content": "#{M#俺}{F#私}はすごいから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715080104
					]
				},
				{
					"id": 715080104,
					"content": "うん、それは皆が認めるところだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715080105,
					"content": "鉱夫の二人、図と昊も休むために戻った。でも…この様子だと、「スパイク」を直接中へ運ぶのは難しいようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715080106,
					"content": "道に沿って、ただ片付けていくのもいい方法じゃないだろう。噴出口に近づけば近づくほど、黒泥が湧き出る速度も増す。黒泥の根源を直接対処しなければ意味がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715080107,
					"content": "…どうやら、他の手を考えたほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				}
