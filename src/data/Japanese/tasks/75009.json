				},
				{
					"id": 750090202,
					"content": "この玉…なんかのパーツに見えるけど。これが好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090203,
					"content": "キュッ…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "ここで見つけたもんだから、意外と価値があるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090205,
					"content": "帰るときに聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
