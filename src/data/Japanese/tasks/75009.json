			"dialogs": [
				{
					"id": 750090101,
					"content": "…入場料は300モラです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090102,
					"content": "もう少し安くならない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "これは龍の遺物研究会が定めた価格なので、交渉の余地はありません。私の知る限り、ここはすでに最安値の採掘場です。なにしろ、だいぶ古くに開発された場所ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090106,
					"content": "とは言え…こんな場所でも、偶にあなたたちのように、運試しに訪れる方はいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090107,
					"content": "一見平凡に見えても、実は莫大な価値がある龍の遺物だった——なんてこともあるかもしれませんしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090108,
					"content": "300モラで素敵な夢を見たいと思っている人は、大勢いるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090109,
					"content": "あなたは、自分にそのような幸運があることを信じていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090110,
					"content": "キュイ…キューン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "運には自信がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も運試しがしたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090114,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "けっこう興味があるみたいだな。ふふん、300モラなら、オイラが出してやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090116,
					"content": "たった300モラで三つの希望が買えるなんて、お得だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090117,
					"content": "それでは、皆さんの健闘を祈ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090112,
					"content": "幸運の仔竜がついてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "#{M#君}{F#あなた}を倒せばタダなんだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "いや、そうはならないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "パイモン"
				}
			]
		},
