			"dialogs": [
				{
					"id": 750090601,
					"content": "収穫はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}がこれを見つけたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090603,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "どれどれ…それほど珍しくはありませんが、なかなか手に入らないものですね。保存状態が良く、燃素が流れた跡もはっきりと見えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090605,
					"content": "そうですね…1万モラで、これを譲ってもらえますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090606,
					"content": "えっ！？オイラたち、本当に価値のある龍の遺物を見つけたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090607,
					"content": "#オイラたちに幸運をもたらしてくれるなんて、やっぱ{REALNAME[ID(2)|SHOWHOST(true)]}はすごいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090608,
					"content": "いえ、あなたが思っているほど貴重なものではありません。龍の遺物研究会総本部による鑑定なら、せいぜい5千モラの価値しかないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090609,
					"content": "えっ…5千モラの価値しかないのに、なんで1万モラで買おうとしてるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090610,
					"content": "それは、私が個人的にその独自の模様をとても気に入っているからです。他の人にとってはそれほど価値はないかもしれませんが、私はそれを手に入れるためなら、追加のお金だって払うつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090611,
					"content": "収集家のさが、あるいは変わった癖とでも言っておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090612,
					"content": "そう言われるとわからなくもないな…それに、300モラの入場料と比べたら、1万モラはかなりの金額だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090613,
					"content": "これを1万モラで売るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090614,
					"content": "キュ…キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、嫌なのか…？自分で持っておきたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090616,
					"content": "キュ…キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}が自分で見つけたものだからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}が嫌なら、やっぱオイラたちで持っとこうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090620,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#どうやらあなたたちは、モラよりも{REALNAME[ID(2)|SHOWHOST(true)]}の気持ちを重んじているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090622,
					"content": "#おう！{REALNAME[ID(2)|SHOWHOST(true)]}もオイラたちの仲間だからな！でも、これから似たようなものを見つけた時って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090623,
					"content": "お心遣いありがとうございます。ですが、収集家の熱意は潮と同じく、過ぎ去るのも一瞬のうち。その頃にはきっと、また別の物に夢中になっていることでしょう。それが何なのかは、私自身にもわかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090624,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090625,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も賛成してるのか？わかったぞ、これが「収集家同士の共感」ってやつなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750090626,
					"content": "こんな賢いテペトル竜に認めてもらえるなんて、実に光栄です。今後、収集について交流したくなったら、遠慮なくお声がけください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090627
					],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090627,
					"content": "では、これで失礼します。皆さん、お元気で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クイピア"
				},
				{
					"id": 750090618,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も収集家になりたいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
