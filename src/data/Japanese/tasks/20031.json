					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "へへっ、ありがたくもらっちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200310302,
					"content": "ええ、これは冒険者協会からの感謝の気持ちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310303,
					"content": "協会には毎日たくさんの依頼が届くので、皆さんの協力がなければきっとうまく処理できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310304,
					"content": "毎日依頼を一定数こなせば追加の報酬をもらえますから、その時は私のところに来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310305,
					"content": "「冒険の証」には本日達成した依頼数が記録されます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310306,
					"content": "追加報酬は数が限られているのと、当日に受け取りに来ないと貰えませんから、忘れないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310307,
					"content": "分かった、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310312,
					"content": "そうだ、仲間に協力して完了した依頼も、追加報酬のカウント対象になりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310313,
					"content": "是非仲間と協力し合ってくださいね！星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310309,
					"content": "1日1回だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "今のところそうなりますね…ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310311,
					"content": "でも安心してください、冒険者たちの報酬を上げられるよう私たちも本部と話し合ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
