			"dialogs": [
				{
					"id": 200310401,
					"content": "#聞きましたよ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310402,
					"content": "もう冒険者協会が受けた<color=#00E1FFFF>依頼</color>を達成したんですね。依頼人があなたにお礼を伝えたいと言ってきましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310403,
					"content": "依頼？よく覚えてないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310404,
					"content": "あなたが道中で助けた人たちのことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310405,
					"content": "あの人たち、協会に依頼を出してたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310408,
					"content": "とりあえず、簡単に紹介しておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310409,
					"content": "冒険者協会には毎日各地からの依頼があって、それを冒険者の皆さんに配るんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310410,
					"content": "これが冒険者たちの主な報酬源になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310411,
					"content": "報酬といえば、協会が特別に報酬を用意しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310406,
					"content": "見かけたから助けておいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310407,
					"content": "さすが我らが冒険者の新星ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
