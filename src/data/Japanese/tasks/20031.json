			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "へへっ、ありがたくもらっちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200310502,
					"content": "ええ、これは冒険者協会からの感謝の気持ちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310503,
					"content": "協会には毎日たくさんの依頼が届くので、皆さんの協力がなければきっとうまく処理できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310504,
					"content": "毎日依頼を一定数こなせば追加の報酬をもらえますから、その時は私のところに来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310505,
					"content": "「冒険の証」には本日達成した依頼数が記録されます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310506,
					"content": "追加報酬は数が限られているのと、当日に受け取りに来ないと貰えませんから、忘れないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310507,
					"content": "分かった、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310512,
					"content": "そうだ、仲間に協力して完了した依頼も、追加報酬のカウント対象になりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310513,
					"content": "是非仲間と協力し合ってくださいね！星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310509,
					"content": "1日1回だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "今のところそうなりますね…ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310511,
					"content": "でも安心してください、冒険者たちの報酬を上げられるよう私たちも本部と話し合ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
