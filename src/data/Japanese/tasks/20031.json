			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#お疲れ様です、{NICKNAME}。初めてにしてはかなり上出来です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310202,
					"content": "依頼人がありがとうって言ってましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310203,
					"content": "では、約束通りこちらをお渡しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
