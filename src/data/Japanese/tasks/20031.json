			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "また会えましたね、冒険者の新星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310102,
					"content": "どうですか？最近の冒険の調子は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310103,
					"content": "順調だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "その調子です。これからも頑張ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310107,
					"content": "十分に経験を積んだように見受けられますし、そろそろ冒険者協会の重要な仕事を紹介しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310108,
					"content": "冒険者協会には毎日各地からの<color=#00E1FFFF>依頼</color>があって、それを冒険者の皆さんに配るんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310109,
					"content": "これが冒険者たちの主な報酬源になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310110,
					"content": "どんな依頼があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200310111,
					"content": "いろいろありますよ～。民衆のために怪物を倒すとか、簡単なものから危険なものまで様々。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310112,
					"content": "百聞は一見に如かず、依頼を受けたほうがより分かりやすいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310113,
					"content": "これが今日の依頼内容です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310114,
					"content": "終わったら報告しに来てくださいね。ちゃんと豪華報酬を用意して待ってますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310115,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#さすが{NICKNAME}、頼もしいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310119,
					"content": "#ここで待ってますからね、{NICKNAME}。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310117,
					"content": "どれくらい豪華？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "そんなに焦らないで、絶対に失望はさせませんから期待しててください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 200310105,
					"content": "少し大変だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "大丈夫、最初はみんなそうです。冒険する前に万全な準備をすると少しは楽になると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
