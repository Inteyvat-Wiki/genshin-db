			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "帰ってきたか、調査の結果はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210702,
					"content": "近くで手がかりを3つ見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210703,
					"content": "ひとつ、つるはしが4本なくなっていたが、生活用品は1つも減っていなかった。つまりみな自発的に出て行ったのではなく、誰かに連れ去られたということになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210704,
					"content": "誰かに連れ去られた！？でも…一体誰がそんな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210705,
					"content": "ふたつ、鉱山には元々5人の鉱夫がいたが、1人は仕事を怠け、作業区域を離れて寝ていた。彼が起きると、仲間は全員失踪していたという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210706,
					"content": "作業区域にいた人が消え、休憩区域にいた人は無事だった。つまり、事件の発生地点は作業区域だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210707,
					"content": "そう言えば、確かに阿虎はサボっていたと自分で言ってたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210708,
					"content": "まさか、誰かが作業区域に入ってあいつらを連れ去ったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210709,
					"content": "俺が言いたかった最後の手がかりがそれだ。クンジュ殿のある調べにより、彼らは1人の子供によって鉱山から連れ出されたことが分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210710,
					"content": "子供！？この近くには住んでいる人なんて少ないし、ましてや子供が鉱山に来るなんてありえない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210711,
					"content": "でも本当にそうみたいなんだ。4人とも子供と一緒に出て行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210712,
					"content": "それで、一体どこに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210713,
					"content": "俺たちの調べによると、彼らは道に沿って北へ向かった。鉱山を出て、遺跡の方へ行ったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210714,
					"content": "北か！よし、今すぐ人手を集めて探してくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210715,
					"content": "手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "調査のことを全部丸投げにしてたんだ、探すのは俺と仲間たちでやる。善は急げだ、まだ追いつけるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210717,
					"content": "待て。事件が起きたのは6日前だ、たとえ彼らが歩きだったとしても、すでに遠くへ行っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210718,
					"content": "うっ…それもそうだな。なら、俺は仲間たちと一緒に北に続く道を進み、その近くに住む人たちに何か知らないか聞きに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210719,
					"content": "鉱山を離れれば、宿にできる民家の数は限られてくる。この調査は俺たちに任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210720,
					"content": "みんなには引き続き手がかりの調査を依頼したい。二手に分かれ、途中で会うことがなかったら、明日の晩に望舒旅館に集合しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210721,
					"content": "いいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210722,
					"content": "それじゃあ、俺は仲間たちと先に行ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "戴"
				},
				{
					"id": 111210723,
					"content": "今の状況をまとめると、オイラたちは引き続き調査をして、戴たちは付近の住民に情報を聞く。これでいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210724,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210725,
					"content": "でも、鉱山にはもう手がかりがないよな…オイラたちも北に向かった方がいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210726,
					"content": "待て、クンジュ殿がいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210727,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210728,
					"content": "ホントだ、クンジュのやつまだ調査してるのか。探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
