							"1112102",
							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クンジュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "クンジュ、なに見てるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210202,
					"content": "あぁ、ちょうどよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210203,
					"content": "何か発見したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210204,
					"content": "ここに鉱石があったのですが、もしかすると何か手がかりが見つかるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210205,
					"content": "鉱石？その鉱石が行方不明と関係があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210206,
					"content": "それは、確かめてみれば分かります。少し待っててください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210209,
					"content": "なんかすごく集中してるぞ。なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210210,
					"content": "見えました。4人の大人…それと、子供のような人影が鉱山を離れていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210211,
					"content": "子供？どうして鉱山に子供が！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210212,
					"content": "僕にも分かりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210213,
					"content": "それに、「見えた」ってどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210214,
					"content": "あっ、それは文字通りの意味です。誰にも言わないでくださいね！自分でもおかしいことは分かってるので、誰にも言ってなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210215,
					"content": "実は僕、鉱石の記憶を見ることができるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210216,
					"content": "えっ——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210217,
					"content": "推測や予想ではなく、「見える」と？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210218,
					"content": "さっきみたいに、石に手を当てるだけで分かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210219,
					"content": "はい、僕からすれば鉱石にも「記憶」があるんです。鉱石たちは周囲で起きた出来事をたまに記録していて、僕は触れることでその「記憶」を見ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210220,
					"content": "すごいな！じゃあ、なんでも知ることができるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210221,
					"content": "それは石の種類にもよります。鉱石の記憶能力には差があるんです。鉄鉱石や白鉄の塊など、一般的な鉱石だと記憶がぼやけていて、ほとんど役に立ちません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210222,
					"content": "一方、石珀や水晶の記憶能力は高く、記録できる量も多くて鮮明です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210223,
					"content": "石を目に…実に興味深い。これは非常に珍しい能力だ。戴殿がクンジュ殿を誘ったこと、実に賢明な判断だったと言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210224,
					"content": "えへへ、皆さんのお役に立ててよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210225,
					"content": "たぶん、彼らはこの道を真っすぐ向かったのだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210226,
					"content": "北か。この道に沿って行けば、鉱山を出ることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210227,
					"content": "彼らは北へ向かった、この手がかりを記録して戴に伝えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
