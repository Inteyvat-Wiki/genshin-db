			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿虎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "ここの労働者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210302,
					"content": "あぁ、そうだ！行方不明者の件で調査しに来たんだろ？頼む、みんなを助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210303,
					"content": "一体何が…何が起きたんだ…あの日は空が暗かったのを覚えてる、頭が何人かの仲間を連れて外に用事を済ませに行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210304,
					"content": "俺と他の4人の仲間は鉱山に残って作業をしていた。その時、俺は少しだけサボってたんだ…でも少しだけだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210305,
					"content": "一番奥のテントで俺は寝てた、そして目が覚めると跡形もなくみんな消えてたんだ！少し前まで普通に話をしてたヤツらが…突然…消えちまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210306,
					"content": "まさか、まさか今度は俺の番なんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "阿虎"
				},
				{
					"id": 111210307,
					"content": "テントにいた人間は失踪を免れ、外で作業していた者だけが失踪したか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210308,
					"content": "もしかすると、作業区域で何か起きたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210309,
					"content": "えっ！そんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210310,
					"content": "作業区域でなにか起きた可能性がある、これも手がかりとして記録しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
