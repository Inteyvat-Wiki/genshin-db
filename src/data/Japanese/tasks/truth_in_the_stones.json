				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "クンジュ、なに探してるんだ？手がかりはもう見つかったろ、そろそろ出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210802,
					"content": "あっ、ごめんなさい。実は個人的に「鎮龍石」と呼ばれる玉石を探してまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210803,
					"content": "「鎮龍石」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210804,
					"content": "聞いたことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "鎮龍石は一般的に鍛造に使われる鉱石だ、なぜそれを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210807,
					"content": "わ…分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210808,
					"content": "ごめんなさい、理由は僕にもよく…ここ最近、頭がぼんやりしていて、名前と住所以外、何も思い出せないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210809,
					"content": "正直、何かやるべきことを忘れている気がして、今もずっと焦燥感に駆られてます。でも、それがどうしても思い出せなくて、心がモヤモヤして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210810,
					"content": "あっ、オイラもその気持ち分かるぞ！なにか忘れてるのにそれを思い出せないって感じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111210811,
					"content": "はい…一体どこへ行けばいいのかも分からず、僕はぶらぶらと歩いていました。そしてある日、市場で買い物をしていたところ、「鎮龍石」のことを話す声が聞こえてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210812,
					"content": "その言葉は、凄く聞き慣れたもののように感じました。僕がやらなければならないことが、その石と関係してるような気がして…だから、探しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210813,
					"content": "もしかしたら、石を手にすることで自分が何をしようとしてたのか思い出せるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210814,
					"content": "なるほど…この旅の途中、俺もその石のことを心に留めておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111210815,
					"content": "本当ですか？ありがとうございます！鍾離先生は本当にお優しい方ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111210816,
					"content": "大したことではないから気にするな。",
