					}
				]
			},
			"dialogs": [
				{
					"id": 745020101,
					"content": "カロン、なかなかうまくやってるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020102
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020102,
					"content": "に、兄さん！？どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020103
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020103,
					"content": "久しぶりの再会だというのに、第一声がそれか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020104
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020104,
					"content": "わ、私はただ兄さんが会いに来てくれるなんて、思いもしなかったから。店も近いのに、今まで一度も来てくれたことがなかったから、てっきりまだ怒ってるんじゃないかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020105
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020105,
					"content": "お前と昔話をしに来たんじゃない。単刀直入に聞こう。お前のその冒険者のおもちゃは、俺のために作ったものなんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020106
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020106,
					"content": "えっ？あ、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020107
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020107,
					"content": "兄さんには、何でもお見通しか…分かってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020108
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020108,
					"content": "ちょ、ちょっと待てよ。わけ分かんなくなってきたぞ。そのおもちゃってベネットのために作ったんじゃなかったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020109,
					"content": "君たちも来てたのか…すまない、この前君たちに言えずにいたのは、どう切り出せばいいか分からなくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020110
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020110,
					"content": "あの冒険者は私に重要なインスピレーションを与えてくれはしたけど…このおもちゃを作ろうって固く決心したのは、実は兄さんのためだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020111,
						745020170
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020111,
					"content": "気持ちは分かる。言いにくいよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020112
					]
				},
				{
					"id": 745020112,
					"content": "カロン、お前のつべこべ言う癖は昔からちっとも変わらないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020113,
					"content": "兄さんも変わってないよ。兄さんとあの冒険者は似てるって、ますますそう思えてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020114
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020114,
					"content": "私は神の目も持ってないし、冒険者でもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020115
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020115,
					"content": "でも冒険心を持ってるって点については一緒だよ。違うとすれば、ベネットは冒険の中で生きてるけど、兄さんは生活の中で冒険してるってところだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020116
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020116,
					"content": "口が達者になったのは私のマネか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020117
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020117,
					"content": "そんなわけないだろ？兄さんはいつも私に怒ってたじゃないか。根性がないってさ。うるさいとは思ったけど、まあ事実だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020118
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020118,
					"content": "今まで、兄さんは最強のおもちゃ屋さんを目指して戦ってきたけど、一方で私はとうの昔から家族に言われれるまま、時計みたいに同じレールの上を繰り返し歩んできた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020119
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020119,
					"content": "兄さんやベネットみたいな人は、自分の好きなことを仕事にできるだろう？私には絶対に無理さ。兄さんの百分の一の勇気さえ、私には備わってないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020120
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020120,
					"content": "カロン、そんなに自分を卑下する必要ないんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020121,
					"content": "君たちには笑われてしまうかもしれないけど、当初兄さんがうちの隣に店を構えるって聞いて、最初に私の頭をよぎったのは店を引っ越すって考えだった。本当に親父に申し訳ないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020122
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020122,
					"content": "幸い、結局その場所は北国銀行に買われたから、お陰で私と兄さんの店は隔たれることになった…ほっとしたよ。運命的な偶然だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020123
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020123,
					"content": "おお、そのことならオイラも知ってるぜ。アルボンに聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020124,
					"content": "ふん、考えてみろ。世の中にそんな偶然がいくつあると思う？北国銀行がちょうどそんなタイミングで俺たちの間に店を出すと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020125
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020125,
					"content": "リーヴァ、つまり…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020126
					]
				},
				{
					"id": 745020126,
					"content": "あの場所は俺がとっくに予約してたんだ。その後、考えが変わったから安値で北国銀行に譲ってやった。やつらが偶然天から落ちてくるわけがないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020127
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020127,
					"content": "うわっ、北国銀行はリーヴァが呼び寄せてきたのかよ！予想外の展開だぜ…。でも、リーヴァも感情的に動きすぎたって思ったからそうしたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020128,
					"content": "家を出てからこの方、俺の目標は「最強のおもちゃ屋になる」ことだったのに、それが「家族と対立して、弟の店を追い出す」ことになったら話にならないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020129
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020129,
					"content": "へへへ、オイラにはそれって気遣いの言葉みたいに聞こえるぞ！ってことは、カロンに謝ってもらうっていう話もメンツ上の話だったんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020130,
					"content": "あ、謝る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020131
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020131,
					"content": "何の話だ？私はそんなこと言っていないが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020132
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020132,
					"content": "自分で言ったことをよくそんなに堂々と否定できるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020133,
					"content": "ふん、カロン、実は私は今日、お前におめでとうと言いに来たんだ。お前のそのおもちゃは…よくできている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020134
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020134,
					"content": "最後に兄さんに褒められたのなんて、いつのことだろう…今になってまた聞けるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020135
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020135,
					"content": "それだけじゃない、お土産も持ってきたぞ。ここ数日こちらの冒険者たちに頼んで集めたデータだ。これがあれば、お前ももっと面白いおもちゃを作れるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020136
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020136,
					"content": "えっ？でも兄さんは「決闘代理人」のおもちゃを作ってる途中じゃなかったのか？このデータはすごく重要だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020137
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020137,
					"content": "いや、そのプロジェクトは中止すると決めた。市場の変動は私が思っていたよりも激しくてな、適切なタイミングで方法転換をする必要がありそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020138
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020138,
					"content": "でも…データは…そんなわけにはいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020139
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020139,
					"content": "お前にやるんだから、グズグズ言わないでさっさと受け取れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020140
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020140,
					"content": "えっ…じゃ、じゃあ一旦私が預かっとくよ。もし必要になったら、いつでも返すから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020141
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020141,
					"content": "リーヴァが言っていた別の考えって、実は弟にプレゼントするためだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020142,
					"content": "事前に君たちの意見も聞かずに、一人で勝手に決めて、すまなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020143
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020143,
					"content": "#気にするなって。リーヴァは既に報酬をくれたし、そのデータをどう使うかはおまえ次第だもんな。それに、おまえたちが仲直りできて本当によかったぜ！な？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020144,
						745020145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020144,
					"content": "まるっきり同感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020146,
					"content": "へへ、オイラたちも見事第三者の役割を果たせたみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020147,
					"content": "そうだ、カロン、リーヴァ、せっかくここに集まったんだし、オイラから一つ提案なんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020148,
					"content": "鉄は熱いうちに打て、っていうだろ。おまえたちでコラボするのはどうだ？カロンは物づくりが上手で、リーヴァは広告がうまいから、二人が手を組めばきっとうまくいくと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020149,
					"content": "…ありがたい話だけど、遠慮させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020150
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020150,
					"content": "うん…私も兄さんと同じ考えさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020151
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020151,
					"content": "うぅ、こんな時に限ってすんなり合意かよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020152,
					"content": "例のベネットっていう冒険者は、こんなことを言ったそうだな？「世の中には色んな人がいる」、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020153
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020153,
					"content": "やっぱり兄さんもそこを覚えてたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020154
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020154,
					"content": "世の中には色んな人がいる。だからこそ、それぞれに見える景色がある…私が彼から何かを学んだとしたら、この言葉だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020155
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020155,
					"content": "俺はカロンとは違う人間だ。だから、歩んできた道も違う。こいつは俺の道が危険すぎると思っているかもしれないが、こいつの選んだ平凡な生活のほうこそ、俺にはたまらないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020156
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020156,
					"content": "そうさ。もし時針に分針の仕事をさせたら、翌日には補償金も与えられないままクビになってしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020157
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020157,
					"content": "激しい挑戦に向き合うのは冒険だけど、平淡な生活に満足するのも、一種の冒険だろう？皆それぞれの道で冒険をしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020158
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020158,
					"content": "だから、進む方向を決めたら、一生懸命歩み続けて、自分だけの景色を見つければいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020159
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020159,
					"content": "うん。たまには兄さんに会いに行くよ。なにせ兄さんの道はもっと険しいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020160
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020160,
					"content": "誰に向かって口をきいてる、余計なお世話だ。少なくとも俺は、困ったときは第三者に助けを求める方法を知っている。北国銀行も二人の冒険者も、自ら訪ねてきてくれたわけじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020161
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020161,
					"content": "もし第三者でも解決できない場合はどうするんだ？兄さんも知ってるだろう、硬度が高い歯車ほど、靭性が劣るって。もし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020162
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020162,
					"content": "そうなったらなったで、しょうがないだろう？人生なんて、そんなもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020163
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020163,
					"content": "いいや、だめだ。どんなことがあっても、兄さんは絶対に人生に打ち負かされちゃいけない。ベネットのようにね。じゃないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020164
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020164,
					"content": "じゃないと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020165
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020165,
					"content": "じゃないと、私が…一発で兄さんをぶっ飛ばす！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020166
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745020166,
					"content": "この野郎、大人になったな。兄貴に向かってなんて口をきくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020167
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020167,
					"content": "うーん、審判席にフリーナが座るぐらいなんだから、兄貴のセリフを弟が言ったって大したことないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020168
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020168,
					"content": "ははは、お前たち、ここ数日の滞在ですでにフォンテーヌ人について把握済のようだな。そうだ、ちょうどお前たちに聞きたいことがあったんだ。よかったら後で店の入り口まで来てくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020169
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020169,
					"content": "カロン、今日はこれで失礼する。話したいことは全部話し終えたから、帰るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020145,
					"content": "#そう、{M#俺}{F#私}たちも信用を守るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020170,
					"content": "えっと…何を恥ずかしがってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020171
					]
				},
				{
					"id": 745020171,
					"content": "弟は小さい時からこんな風にグズグズ言うタイプなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "リーヴァ"
				}
			]
		},
