			},
			"dialogs": [
				{
					"id": 745020201,
					"content": "来てくれたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020202
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020202,
					"content": "おまえ、なんだか機嫌がよさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020203,
					"content": "これもお前たちのお陰だ。ところで、カロンのモンド旅行から、私も色々とヒントをもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020204
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020204,
					"content": "それで、私もそろそろ旅をしながら、おもちゃ制作のインスピレーションを探してみようかと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020205
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020205,
					"content": "二人はあちこちを旅してるから、きっとベネットのような友人が大勢いるんだろう？何かアドバイスはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020206
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020206,
					"content": "友達はたくさんいるけど、おもちゃのインスピレーションってなると、とっさに思い浮かばないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020207,
					"content": "第三者を探してみれば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020208
					]
				},
				{
					"id": 745020208,
					"content": "第三者って？オイラたちが第三者だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020209,
					"content": "もしかして…北国銀行のことを言ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020210
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020210,
					"content": "ああ、前任の第三者のことな！考えてみれば、北国銀行はファデュイのもので、ファデュイは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020211,
					"content": "まさか…ファデュイの執行官？執行官をテーマとしたおもちゃか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020212
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020212,
					"content": "#…おお！{NICKNAME}、おまえ、もしかして？なにを言おうとしてるのか分かったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020213,
					"content": "へへ、リーヴァ、おまえ知ってるか？ファデュイの中には1人特別な執行官がいて、あいつにはすごいあだ名がついてるんだ。その名も——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020214,
					"content": "「スネージナヤトップのおもちゃ売り」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020215,
					"content": "ほう？スネージナヤトップのおもちゃ売りだって？そんな人物がいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020216
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020216,
					"content": "もちろん、あいつはその分野のベテランだぜ！おまえにインスピレーションをどっさり与えてくれるかもな。広告宣伝って面から見ても、おもちゃ商人と営業マンが手を組めば最高のコンビになるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020217,
					"content": "アドバイスをどうもありがとう。大いに参考になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020218
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020218,
					"content": "執行官と繋がるのは容易なことではないと思うが、俺は北国銀行に少々伝手があるから、何とか頑張ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020219
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745020219,
					"content": "へへ、新商品ができたら、絶対オイラたちにも知らせてくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745020220,
					"content": "もちろん、忘れるわけないさ。それじゃ、いい知らせを待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーヴァ"
				}
			]
		},
