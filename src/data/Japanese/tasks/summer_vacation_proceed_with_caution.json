					"nextDialogs": [
						400110620
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110620,
					"content": "しかし、今の稲妻の現状で、こういった事が起きるものなのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110621,
					"content": "動くことのない異邦人…変だな、誰かがここまで持ってきたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110622,
					"content": "ええっ——大魔王、動かないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110623,
					"content": "クレー…大魔王は疲れているのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110624,
					"content": "そ、そうそう！寝ちゃったんだ！クレーがなかなか来ないから、待ちくたびれて居眠りしちゃったんだろ、きっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110625,
					"content": "そうだよ、クレー。今はとりあえず他のところで遊ぼう。大魔王が起きたら、また戻って来ようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110626,
					"content": "…ほんとう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110627,
					"content": "本当だよ、大丈夫だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110628,
					"content": "う～ん…あっ、クレー気づいちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110629,
					"content": "これは本物の大魔王じゃない。本物の大魔王はまた別のどこかにいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110630,
					"content": "え？そ、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110631,
					"content": "クレー諦めないよ。待ってて大魔王、絶対見つけてみせるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110632,
					"content": "また走って行っちゃった…子供は元気だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110633,
					"content": "ちょっと待ってよ、クレー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				}
			]
		},
