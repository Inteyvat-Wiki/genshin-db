					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "クレーはまだ子供だから、危機感に欠けている。旅人、私たちは冷静に現状を捉えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110719,
					"content": "正直言うと、最初に手紙を見た時はただのいたずらかと思った。",
