					"nextDialogs": [
						400110309
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110309,
					"content": "あっ、でも心配しないで！たとえ夏服でも、バーバラは頼もしい仲間に変わりはないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
