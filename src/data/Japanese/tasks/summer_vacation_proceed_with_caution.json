					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110306,
					"content": "夏服について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110307
					]
				},
				{
					"id": 400110307,
