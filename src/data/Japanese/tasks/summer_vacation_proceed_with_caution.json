					"nextDialogs": [
						400110715
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110715,
					"content": "構わないが、気を付けるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "ジン"
				},
				{
