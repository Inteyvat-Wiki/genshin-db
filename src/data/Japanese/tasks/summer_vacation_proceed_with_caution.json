			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"ジン",
					"バーバラ",
					"クレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "ん～いい天気だな。あやうく寝坊するところだったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110102,
					"content": "おはよう！わっ、どうしたんだその格好！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110103,
					"content": "えへへ、どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110104,
					"content": "私たち全員夏服に着替えたんだ！遊びに来てるわけじゃないけど…せっかくの夏の海だし、楽しまないともったいないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110105,
					"content": "へ、変…だろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110106,
					"content": "こんなヒラヒラとした夏服、やはり私には合わない気が…コホン！すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110107,
					"content": "そんなことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "そ、そうか…ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110110,
					"content": "けど、ジン団長がわざわざ夏服を用意してるなんて、意外だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110111,
					"content": "違うよ、お姉ちゃんが自分で用意したんじゃなくて、私とリサさんが選んだの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110112,
					"content": "あっさり「お姉ちゃん」って呼んでるし…それに全然気づいてない。バーバラ、すっかり夏の海に浮かれてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110113,
					"content": "この夏服だが…私も予想外だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110114,
					"content": "実はリサがくれた袋に入っていたんだ。窮地を切り抜ける道具が入っていると思ったら、まさか夏服が入っているとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110115,
					"content": "アクセサリーまで入ってたのか、さすがリサさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110116,
					"content": "騎士団の皆は、こうまでして私を休ませたいということか…私は、自分を追い込み過ぎているのかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110117,
					"content": "みんな！こっち来て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110118,
					"content": "ん？クレーが呼んでいるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110119,
					"content": "変なものを発見したよ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110120,
					"content": "なんだ？変なものって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110121,
					"content": "ほら、海を見て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110122,
					"content": "変なものが浮いてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110123,
					"content": "何やら細長い装置のようだ。見たところ、浮標みたいだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110124,
					"content": "昨日、海を渡った時はあんな装置なかったよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110125,
					"content": "きっとドド大魔王の仕業だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110126,
					"content": "一夜にして現れた変な装置、怪しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110127,
					"content": "ずっとドド大魔王が出てこないのは、クレーを認めてないから？それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110128,
					"content": "クレーが見つけるのを待ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400110129,
					"content": "突然、海に現れた浮標か。何か意味があるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110130,
					"content": "近寄ってみれば分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "そうだな、浜辺からずっと見ててもどうしようもないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110132,
					"content": "大丈夫かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110133,
					"content": "ああ、確認した方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110134,
					"content": "海で何が待ち構えているかは謎だ…念の為、戦闘の準備をしておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110135,
					"content": "準備が整ったら私のところに。船で近づこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110136,
					"content": "さすが、みんなのジン団長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "ほ、褒め過ぎだ。やるべきことをやっているまでのこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110139,
					"content": "では、準備が出来たら声をかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110137,
					"content": "夏服を着ていても頼もしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "すごく似合ってる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "あの浮標はいったい何を意味しているのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110202,
					"content": "群島について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "この群島は世界から切り離されているみたいだ、まるで自然が作り出した秘境だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110204,
					"content": "ここまで来れたのは、手紙のヒントとウェンティがトワリンを呼んで助けてくれたからだ…しかし、事が上手く運び過ぎていて、やや不安になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110205,
					"content": "だが、私がここにいるのは皆を守るため。だから安心してくれ、何があろうとも私が共にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110206,
					"content": "夏服について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "ああ…な、夏服は、その…リサのサプライズだったようだ。それに、バーバラも一枚噛んでいたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110208,
					"content": "バーバラに言われたんだ、せっかく島に来たんだし、目の前に海があるんだから夏服を着た方が雰囲気が出ると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110209,
					"content": "それにしても、やはり慣れない…はぁ、おかしくなければいいのだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
			]
		},
