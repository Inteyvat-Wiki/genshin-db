					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "急に褒められると、照れちゃうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110708,
					"content": "でも、この辺りにあるのは、あの稲妻のからくりだけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110709,
					"content": "まさか、それを祀ってるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110710,
					"content": "そうかもしれない。あのからくりは、何か人の為になることをしたのかもしれない。",
