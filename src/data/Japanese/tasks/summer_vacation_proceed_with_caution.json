					"nextDialogs": [
						400110615
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110615,
					"content": "前に見たことあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 400110616,
					"content": "あくまで推測にすぎないが…服装を見た限り、稲妻から漂流したもののように見える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400110617,
					"content": "稲妻だって？すっごく遠いとこじゃないか？",
