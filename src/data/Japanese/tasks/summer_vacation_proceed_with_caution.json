					"nextDialogs": [
						400110509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400110509,
					"content": "どう考えても妙だ…手紙で私たちを誘き寄せ、このような装置を使って試してくるなど…ドド大魔王、ただ者ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "ジン"
				},
