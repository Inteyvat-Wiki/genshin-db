					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "あれ？池が一つ増えてる気がするぞ？看板になにか書いてあるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010102,
					"content": "「危険——近寄るべからず」？どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010103,
					"content": "文字通りの意味よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010104,
					"content": "うわっ！サンドローネ。びっくりしたぞ！これっておまえが立てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010105,
					"content": "ええ、好奇心旺盛な人が、池に落ちないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010106,
					"content": "この池にはなにがいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010107,
					"content": "ピラニアよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010108,
					"content": "ええっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010109,
					"content": "ふふっ…からかってみただけ。本気で信じたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010110,
					"content": "少し前に、水槽の中に他の魚を攻撃している魚がいるのを見つけたのよ。縄張り意識が強くて性格も荒っぽいヤツら。だから、いったんここに移したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010111,
					"content": "びっくりしたぞ…つまり、ここは魚たちの療養所みたいになってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010112,
					"content": "ええ…この池は水深がそこそこあるし、大きいから、縄張り意識の強い魚たちも落ち着いてくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010113,
					"content": "荒っぽい気性を和らげるために、メロピデ要塞のシグウィンさんから特製の餌も少しもらってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010114,
					"content": "へえ、そうだったのか。けっこう魚たちのことを気にかけてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010115,
					"content": "水槽の中で争っているのを見れば、誰だっていい気はしないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010116,
					"content": "確かに。じゃあいっそ、この仕事もオイラたちに任せてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010117,
					"content": "いいわ。とにかく、池の魚が水面の様子を覗きに来る気分になったなら、療養はほとんど済んだってことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010118,
					"content": "気性が落ち着いたら、また水槽に戻せるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010119,
					"content": "どこに戻すかはアナタたちが判断してちょうだい。ワタシは悪いヤツらをこの池に放り込むだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747010120,
					"content": "分かったぜ。でも、おまえの告知板は怖すぎるぞ。ちょっと変えたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747010121,
					"content": "はぁ…まあいいわ。アナタたちが捕った魚だものね、言う通りにしてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
}