				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "これは…一隻の…じゃなくて、半隻の船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030102,
					"content": "どうしてこんな所に半分になった船があるんだ？あれ、船に文字が刻まれてるぞ。どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030103,
					"content": "「…片方がなくても、もう片方だけでこんな遠くまで渡れるなんて、さすが俺の船だ。はははっ！だがまあ…船にあった物はすべて海に沈んだかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030104,
					"content": "「…たしか、南東方向に沿って漂流してきたんだっけか？まあいい、残る問題は、どうやってここから出るかだな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030105,
					"content": "どうやら遭難した人みたいだな。「片方」って言ってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030106,
					"content": "…もしかしてこれ、「もう片方」ってことか？船が真っ二つになるなんて、いったいなにがあったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030107,
					"content": "たしか、「南東方向」に沿って漂流したって書いてあったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030108,
					"content": "じゃあオイラたちもその方向に沿って、船の「もう片方」を探してみよう。なにか見つかるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030109,
					"content": "文字が刻まれたこの板も持っていこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "その文字が手がかりになるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030111,
					"content": "よし、いいと思うぞ。それにこの船の板はもうボロボロで、簡単に取れるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030112,
					"content": "板を取ったら、もう片方の船を探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
