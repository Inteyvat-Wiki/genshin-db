					"nextDialogs": [
						790030317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030317,
					"content": "辺りを探してみようぜ。なにかお宝が見つかるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790030318,
					"content": "長く海に浸かってるからもう壊れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
