			"dialogs": [
				{
					"id": 740360101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360102,
						740360103
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360102,
					"content": "アイオーヌ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360105,
					"content": "アイオーヌ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "えっ！？何です？書きましたよ、ほら、もう、ちゃんと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360107,
					"content": "#{M#俺}{F#私}だよ。書き終えたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "ああ、あなたでしたか。私…うたた寝してたんですね、すみません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360109,
					"content": "ロアルテさんとスメイヌさんが真夜中まで付き合ってくださって…お二人のご指導のおかげで、どうにか提案書を間に合わせることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360110,
					"content": "でもへとへとになっちゃって。目を閉じてひと休みするだけのつもりだったのに、まさかそのまま今まで寝てしまってたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360111,
					"content": "まずタレスのところに行って、この提案書に共律庭の公印を押してもらって、それからディフォールさんにもハンコをもらって、最後に正式に印刷して配布すれば…この件は完了です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360112,
					"content": "あとは簡単だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "その通りです。しかもタレスのほうは新型オートスタンパーを導入したって聞いてますしね。利便性とセキュリティを兼ね備えたシロモノで、共律庭全体に普及させるつもりだとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360115,
					"content": "ほら、ロアルテさんから鍵ももらってきましたよ。どの部署もこの鍵がないとスタンパーを起動できないんです…けっこうガッチリしてるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360116,
					"content": "やっぱり、ひと眠りしたらどうだ？なんか…フラフラしてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360117,
					"content": "どうせハンコを押しに行くだけなんだろ？それにその…オートスタンパーってのもあるんだし、急がなくてもいいんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360118,
					"content": "いいえ、これ以上時間を無駄にできません。今すぐ出発しましょう。ハンコを押すだけですし、そう時間はかからないはずなので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360113,
					"content": "前ほど複雑じゃなさそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "書き終わった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
		{
