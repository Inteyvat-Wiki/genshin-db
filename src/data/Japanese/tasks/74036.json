				]
			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "タレス、ハンコをもらえますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360202,
					"content": "ああ、もちろん。鍵は持ってきたかい？先にここにサインしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360203,
					"content": "この機械があれば、サインする必要はないんだと思ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360204,
					"content": "それがな…この機械は結局人が操作しないといけないだろ？だから保証人としてのサインが必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360205,
					"content": "だが、この機械のセキュリティは一流だよ。鍵がないと、俺でも動かせないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360206,
					"content": "書類を下に置いて。きちんと合わせたら、鍵をこの穴に差し込むんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360207,
					"content": "これがその「オートスタンパー」か？見た目はすごく…フツーだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360208,
					"content": "こうですね。それから鍵を回して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360209,
					"content": "ああ、待って、その姿勢のまま動かないで。君の写真を撮っておかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360210,
					"content": "それって機密漏洩にならないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "これはこの機械を導入したときに、カルシックスさんが決めた規則なんだ。押印しに来る人を写真機で撮って、記録を残しておかないといけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360253,
					"content": "位置をずらさないと…このファイルが映ってはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360213,
					"content": "最近共律庭で、まもなく写真機の機密漏洩を規制する通達があると聞いた。目立って叩かれたくはないんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360214,
					"content": "#{NICKNAME}、オイラたちも外に出ておこうぜ。もし写り込んじゃったら、「機密漏洩事件」に巻き込まれるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360255,
					"content": "タレスは注意深く写真を撮った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "…よし、撮ったよ。じゃあ機械を動かして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360216,
					"content": "鍵を回しましたけど、この機械…うんともすんともいいませんよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360217,
					"content": "まさか、修理したばかりなのに、また壊れるはずがない…点検してみよう。心配するな、すぐ直るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360218,
					"content": "タレスは下を向いて機械を点検し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "おかしいな、どこも壊れていないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360220,
					"content": "鍵を抜き差ししてみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "そうですね、やってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360222,
					"content": "アイオーヌは鍵を抜いて、また挿し直した。機械はやはり動かない…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "動きませんよ。タレス、何とかしてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360224,
					"content": "書類の位置がちゃんと合っていないのかもしれないな。書類はしっかりこの留め具で挟まないといけない。中にトリガー装置が隠されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360225,
					"content": "書類が機械と関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "もちろんだよ。でなければ、この機械は下に押印を待っている書類があるなんて分からないだろう？これはあくまでオートスタンパーで、私が手動で操作しているわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360227,
					"content": "そんな…はいはい、分かりました！すぐに書類を置き直します。全部の留め具に合わせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360228,
					"content": "アイオーヌは書類をいったん取り上げて置き直したが、それでも機械は動かなかった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "直りませんよ。やっぱりびくともしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360230,
					"content": "そんなバカな。前回はちょっと機械を叩いただけで、また動いたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360231,
					"content": "#じゃ、{M#俺}{F#私}が叩いてみようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "機械を修理するのに、こんな…祈りに近い手段に訴えるほかないんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360233,
					"content": "少なくともまだ祈るチャンスが残されてるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360234,
					"content": "（スタンパーを軽く叩く）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "（スタンパーは沈黙で答えた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360236,
					"content": "（スタンパーを少し強く叩く）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "（スタンパーは抗議の声を上げるのも面倒なようだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360238,
					"content": "（スタンパーを思い切り叩く！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "（スタンパーはしばらく沈黙を続けたのち、苛立ったようにガチャガチャと音を立てた。まるで、目覚めたばかりの人がよろめいてベッドから転げ落ちるように…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360240,
					"content": "うわっ、何の音だ！？機械の中が全部壊れちゃったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360241,
					"content": "（…それから、スタンパーはよろめきながらスリッパを見つけた人のように、手探りしてやっと電気をつけると、ウィンウィンと動き始めた）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360242,
					"content": "う、動いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360243,
					"content": "オートスタンパーは疲れきっていたが、しっかりと辛抱強く働き始めた。数名が絶望に近い瞳で見守るなか、機械はまるでテントガメが地を這うような速度で印章を紙の上に下ろす。足を踏み出した印章は、書類の上で戸惑いながらぶらぶらしていたが、しばらくすると仕方なく紙の上に腰を下ろして休んだ。そして機械は、身体を震わせながら印章を懐に戻した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "ほら、ちゃんと動くって言っただろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360245,
					"content": "この機械の一体どこがいいのか分かりません。自動って言いますけど、手動で押すよりよっぽど遅いじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360246,
					"content": "だがセキュリティの観点から見れば優れている。ほら、ここにいる全員が、勝手に公印を出して押すことなんてできなかっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360247,
					"content": "そんなの自慢になりませんよ。もしある日この機械が完全に壊れて、そこにカルシックスさんもいなかったら、どうするんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360248,
					"content": "む…それでも大丈夫だ、スペアキーがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360249,
					"content": "それはこの機械を動かすための鍵ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360250,
					"content": "いや、カルシックスさんのオフィスにある箱の鍵だよ。中に予備の公印が入ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "タレス"
				},
				{
					"id": 740360251,
					"content": "…旅人さん、急いで帰ってこの書類を製本して、ディフォールさんに渡しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360252,
					"content": "早くこの悪夢から逃げ出したくてたまりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360211,
					"content": "どうして写真を撮るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
		{
