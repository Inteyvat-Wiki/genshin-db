				]
			},
			"dialogs": [
				{
					"id": 740360301,
					"content": "よし、公印は揃ったし、装丁も完成しました。あとはディフォールさんに渡せば、めでたしめでたしです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360302
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360302,
					"content": "今夜はよく寝て、このことはきれいさっぱり忘れます…明日また休みを取って、エスタブレさんのところに行きます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360303
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360303,
					"content": "アイオーヌくん、今お暇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360304
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740360304,
					"content": "ええ、空いていますけど、何かご用ですか？まさか精算の書類がこんなに早く届いたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360305
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360305,
					"content": "そうじゃないんだけど…ヌヴィレット様からあなたに聞いてほしいって使いが来たの。なぜタイプライターを丸ごとじゃなくって、キーキャップ一個だけ経費精算するのかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360306
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740360306,
					"content": "なぜって…キーキャップを一つ失くしただけだからです。どうしてタイプライターを丸ごと購入する必要があるんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360307
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360307,
					"content": "うん、確かにそうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360308,
					"content": "それがね、うちの精算明細書にはタイプライターはあってもキーキャップはないから、新しい精算項目になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360309
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740360309,
					"content": "なぜキーキャップ一個だけを経費精算するのか、詳しく説明した文書を書いて、ヌヴィレット様に提出しないといけなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360310
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740360310,
					"content": "まじめな話じゃなくて、笑えない冗談でも聞いてるような気分だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360311,
						740360312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360311,
					"content": "そんな必要ある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360313
					]
				},
				{
					"id": 740360313,
					"content": "つまり、僕に…単独で始末書を書いて、ヌヴィレット様にキーキャップ一個をなくした説明をしろってことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360314
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360314,
					"content": "枢律庭は、ヌヴィレット様直々の要求だからって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360315
					],
					"speakerTitle": "コーネリア"
				},
				{
					"id": 740360315,
					"content": "おかしいですよ！だいたい、枢律庭は何をしても「ヌヴィレット様直々の要求だから」って言うんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360316
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360316,
					"content": "だが、本当にそうかどうかは誰にも証明できんだろ？よしよしアイオーヌくん、落ち着いて聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360317
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360317,
					"content": "共律官にとって、最高審判官の命令は行政的な強制性を持っている。早い話が、君は書かなければならんのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360318
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360318,
					"content": "別に悪い話じゃないぞ。ヌヴィレット様に文章を見ていただけるちょうどいい機会だ。単独で書面報告する機会なんて、誰にでもあるわけじゃないんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360320
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360320,
					"content": "でも、僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360319
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360319,
					"content": "あ…まずいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360321
					]
				},
				{
					"id": 740360321,
					"content": "やあ、皆さん、ニュースですよ。写真機で機密を漏洩した現行犯を捕まえたのです。悪い見本の典型例として提案書に書けると思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360322
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360322,
					"content": "法を知っていながら破ったこの現行犯は、写真機で秘密を漏らさないようにと注意を呼びかけていたカルシックスさん本人でして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360323
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360323,
					"content": "その人…そいつのせいで、アイオーヌは毎日徹夜で草稿を書いてるんだぞ！？なんで真っ先に自分が誤ちを犯したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360324,
					"content": "彼は写真機で自分のオフィスを何枚も撮影して、写真を記者に送ったのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360325
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360325,
					"content": "その中の一枚に、彼自身の会議の記録が写り込んでしまいました。そして議事録の内容が、彼が以前行った講演とは全く関係ないことが明らかになったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360326
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360326,
					"content": "外は今このニュースで持ちきりですよ。カルシックスのオフィスはすぐにフォンテーヌ最大のお笑い草になるでしょうねえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360327
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360327,
					"content": "ちょっと待てよ！議事録と講演になんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360328,
					"content": "ほとんどの講演の原稿は議事録をもとに整理される内容なのですから、もちろん関係ありますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360329
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360329,
					"content": "じゃあどうして全く関係がなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360330
					]
				},
				{
					"id": 740360330,
					"content": "ああ、それは当たり前ですよ。議事録の最大の意義は、講演の原稿に入れてはならないものを教えてくれることですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360331
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360331,
					"content": "カルシックスは自分が何を話すのかさえ知りませんでした。自分の考えさえないのですから　——全部、若い部下たちに教えてもらっていたのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360332
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360332,
					"content": "待ってください、カルシックスさんは今どこにいるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360333
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360333,
					"content": "うちのオフィスで調査を待っていますが…さすがに機密レベルの文書が流出して、大騒ぎになってしまいましたからねえ…しばらく缶詰状態でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360334
					],
					"speakerTitle": "ガッティーノ"
				},
				{
					"id": 740360334,
					"content": "じゃあ…私が書いた書類はどうなるんですか！何もかも書き終えて、ハンコまで押したのに…ゲホッ…ゲホゲホ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360335
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360335,
					"content": "し、心配するなよ。書き終わった以上、いつかは出せるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360336,
						740360337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360336,
					"content": "きっと無駄にはならないから、落ち着いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360338,
					"content": "アイオーヌ！アイオーヌ、いるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360339
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360339,
					"content": "スメイヌさん、やっと来てくれたんですね。何かいい方法を考えてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360340
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360340,
					"content": "そんなことより、もうキーキャップの経費精算はやり終えちゃったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360341
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360341,
					"content": "したけどそれがどうしたんです？このキーキャップのためにヌヴィレット様に始末書まで書く羽目になって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360342
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360342,
					"content": "ああ…くそっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360343
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360343,
					"content": "ほら、これは君のキーキャップじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360344
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360344,
					"content": "これ…どこで手に入れたんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360345
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360345,
					"content": "僕の机の下だよ。清掃の人が床の掃除中にうっかり掃いてしまったんだろう。誰かが見つけて、僕の机の上に置いておいてくれたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360346
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360346,
					"content": "てっきり自分のタイプライターのキーキャップだと思って、しまっておいたんだ。でも今日見たら…どこも欠けたところはなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360347
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360347,
					"content": "この悪夢は、一体いつになったら覚めるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360348
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360348,
					"content": "#{NICKNAME}、私の仕事の意味って一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360349
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 740360349,
					"content": "アイオーヌは気を失って床に倒れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360350
					]
				},
				{
					"id": 740360350,
					"content": "おい、アイオーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360351
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360351,
					"content": "アイオーヌはものすごい速さで医者の元へ運ばれていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360352
					]
				},
				{
					"id": 740360352,
					"content": "僕のせいだ！もっと早くキーキャップを見つけていれば、こんなことにはならなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360353
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360353,
					"content": "キーキャップの問題じゃないよね！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360354
					]
				},
				{
					"id": 740360354,
					"content": "そうだぞ！全部がぐちゃぐちゃすぎるぞ。アイオーヌも何をしたらいいかわからなくなってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360355
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360355,
					"content": "ガッティーノとディフォールもいなくなっちゃったし…なんなんだよ、この人たち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360356,
						740360357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740360356,
					"content": "アイオーヌは仕事の意味を気にしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360358,
					"content": "はぁ、こいつはいつもそういうことを考えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360359
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360359,
					"content": "「仕事の意味」なんていう大きなテーマはな、一言二言で言い尽くせるものじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360360
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360360,
					"content": "そんなことばっかり考えてたら、ストレスがますます大きくなるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360361
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360361,
					"content": "じゃあその答えを知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360362
					]
				},
				{
					"id": 740360362,
					"content": "僕はそんな問題について考えたことはないな。ただ働くだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360363
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360363,
					"content": "俺は…時々考えるな。だが俺は、自分なりにストレスを和らげる方法を持ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360364
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360364,
					"content": "本当にそういう問題の答えを探したいなら…俺たちに話してくれればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360365
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360365,
					"content": "ただ…今は、先にフルーツでも買ってきて、アイオーヌくんのそばにいてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360366
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360366,
					"content": "今はそれが優先だね。僕もアイオーヌの病気休暇の申請を書いてくるよ。あいつはしっかり休まないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360367
					],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360367,
					"content": "よし、じゃあそれぞれ出来ることをやろう。そういうことで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360368
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360368,
					"content": "#{NICKNAME}、また会おうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360369
					],
					"speakerTitle": "ロアルテ"
				},
				{
					"id": 740360369,
					"content": "あれ、おかしいな…病欠の申請書はどこに置いたっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スメイヌ"
				},
				{
					"id": 740360357,
					"content": "アイオーヌは仕事の意味を見失ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360337,
					"content": "気を楽にして。きっといい方法があるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360312,
					"content": "それはちょっとおかしくない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360350
					]
				}
			]
