			"dialogs": [
				{
					"id": 766520501,
					"content": "やっと捕まえたぞ。これはただの故障じゃなさそうだな。この「お宝探し君」、いったいどうなってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520502,
					"content": "ふんっ！まったく無知な方たちね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520503
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520503,
					"content": "えっ！？こいつ、喋ったぞ！？アイノ、これって仕様通りなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520504,
					"content": "ありえないよ…「お宝探し君」に音声機能は搭載されてるけど、話せるのはあらかじめ用意した音声だけだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520505
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520505,
					"content": "イネファみたいに、自律意識を持つこともないはずだよ。コアの品質がぜんぜん違うもん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520506
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520506,
					"content": "でも、なんか話が通じるみたいだぞ。もしかして、コアがアップグレードされたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520507,
					"content": "#{M#君}{F#あなた}の名前は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520508
					]
				},
				{
					"id": 766520508,
					"content": "なに？あなたには関係ないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520509
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520509,
					"content": "うわっ、生意気なやつだな！こいつのほうが、オイラを捕まえたみたいな態度だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520510,
					"content": "どうしたの？用がないなら、どこかに行ってちょうだい。でなければ、全員逮捕してメロピデ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520511
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520511,
					"content": "メロピデ？…というのは、なんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520512
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766520512,
					"content": "えーっと…あれ？メロピデって何だったかしら…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520513
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520513,
					"content": "メロピデ要塞？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520514
					]
				},
				{
					"id": 766520514,
					"content": "メロピデ要塞…確か、そんな名前だった気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520515
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520515,
					"content": "#{M#君}{F#あなた}はフォンテーヌから来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520516
					]
				},
				{
					"id": 766520516,
					"content": "なによ？いきなり女の子のプライベートに首を突っ込まないでちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520517
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520517,
					"content": "女の子！？おまえは分別ロボットだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520518,
					"content": "女の子よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520519
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520519,
					"content": "こんなのおかしいよ…何があったのかは分からないけど、この子は絶対に元々いたイタズラ好きの「お宝探し君」じゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520520
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520520,
					"content": "よし、決めた！分解して中を調べてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520521
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520521,
					"content": "ちょっと、べたべた触らないで！誰か助けてー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520522
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520522,
					"content": "大丈夫、アイノも女の子だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520523
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520523,
					"content": "女の子でもダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520524
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520524,
					"content": "旅人さん、パイモンさん、申し訳ありません。アイノはいったん興味を持つと、無我夢中になってしまうのです。しばらく待ってあげてください。彼女なら、きっと原因を解明できるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520525
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766520525,
					"content": "もし気になるようでしたら、また明日工房にお越しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イネファ"
				}
			]
		},
