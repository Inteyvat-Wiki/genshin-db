					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520143
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520143,
					"content": "（怖い目つきで「お宝探し君」たちを見回す。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520144
					]
				},
				{
					"id": 766520144,
					"content": "おまえ、結構ノリノリだな！怪しいやつはいたか？",
