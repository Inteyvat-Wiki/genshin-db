			"dialogs": [
				{
					"id": 766520301,
					"content": "アイノ、イネファ、捕まえたぞ！次はどうするんだ？検査とかするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520302,
					"content": "外観に異常は見られません。攻撃による故障の可能性は低そうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520303
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766520303,
					"content": "もしかして、本当にコアの不具合？ちょっと分解してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520304
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520304,
					"content": "まずい！逃げ出したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520305,
					"content": "追いかけよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520306
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520306,
					"content": "ん…あれじゃないか？なんであんなにデカくなってるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766520307,
					"content": "いいえ、あれらは廃棄された分別ロボットです。まさか、接続できるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520308
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 766520308,
					"content": "なんだか、ただの故障じゃない気がしてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520309
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520309,
					"content": "とにかく今は、あの子を捕まえよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
