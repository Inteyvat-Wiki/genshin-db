			"dialogs": [
				{
					"id": 766520801,
					"content": "よく出来てるね！機械技師の才能があるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520802
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520802,
					"content": "ありがとうね、これで今までよりずっとすごい「お宝探し君」が手に入った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520803
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520803,
					"content": "アザザ、真面目に働くんだよ。給料はちゃんと払ってあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520804
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520804,
					"content": "そんなこと、どうだっていいわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520805
					],
					"speakerTitle": "おかしなお宝探し君"
				},
				{
					"id": 766520805,
					"content": "本当に気性が荒いんだね。お花をつけてあげる。ほら、もっと優しくなってね～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520807
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520807,
					"content": "うんうん、すごく可愛くなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520808
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520808,
					"content": "そうだ、旅人、パイモン。もし今後、ネジとかナットとか、使い道のなさそうな材料を拾ったら、ここに持ってきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520809
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520809,
					"content": "お花に変えたり、アイノの作業場をアップグレードしたりするのに使うから。へへっ、もちろんただ働きはさせないよ。毎日来たくなるくらいの報酬を出してあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520810
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520810,
					"content": "交渉成立でいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520811
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520811,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520812
					]
				},
				{
					"id": 766520812,
					"content": "やったー！やっぱりイネファの言った通りだった。「上手くいかない」のは「上手くいく」予兆。それを乗り越えたら、上手くいくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520813
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 766520813,
					"content": "キミたちの旅も、きっとそうなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
			]
		},
