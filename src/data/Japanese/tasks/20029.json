			"dialogs": [
				{
					"id": 200290601,
					"content": "旅人さん、シュースターさんは見つかりましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290602,
					"content": "ググプラムを渡すように言われた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "ああ…ありがとうございます。では、受け取らせていただきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290604,
					"content": "シュースターさんが戻ってきたら、私から報酬を渡しておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290605,
					"content": "それから、子供へのプレゼントでしたね。少々お待ちください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290606,
					"content": "マージョリーはプレゼントを作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "出来ました！どうぞ持って行ってください。ググプラムの件、ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290608,
					"content": "こういった良い香りのするお人形は、子供ならきっと大好きだと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				}
			]
		},
