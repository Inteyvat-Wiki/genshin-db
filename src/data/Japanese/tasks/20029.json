			},
			"dialogs": [
				{
					"id": 200291901,
					"content": "でもおとうしゃん、おじさんは、リリーにおはなしを聞かせてくれるの。ほんとのほんとに、いいひとだもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291902
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200291902,
					"content": "リリー、これはそんな単純なことじゃないんだ…はぁ、お父さんもこれからリリーにお話を読んであげるから…",
					"roleType": "TALK_ROLE_NPC",
