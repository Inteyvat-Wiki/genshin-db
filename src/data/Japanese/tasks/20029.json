			},
			"dialogs": [
				{
					"id": 200292801,
					"content": "あーあ…やっと帰れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292802
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200292802,
					"content": "国に帰るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200292803
					]
				},
				{
					"id": 200292803,
					"content": "あ？おう…お前か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292804
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200292804,
					"content": "そうだ。最近、上からの命令があって、スネージナヤに帰ることになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292805
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200292805,
					"content": "聞いた話だが…ある執行官様の手下に配属されるらしい。だからもう、モンドにいる必要はなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292806
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200292806,
					"content": "まあ、どの執行官様のもとにつくのかは知らないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290107,
					"content": "いつここを離れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "具体的な時期については言われてない。荷物の整理が終わり次第、出発する予定だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290109,
					"content": "まあ、やっとこんな所を離れられて清々するよ。もうシスターたちに、冷たい目で見られなくて済むしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290110,
					"content": "そうだ、旅人。俺らも長い付き合いなんだし、最後に一つ手伝ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290111,
					"content": "以前と同じように、報酬をやる。決して無駄働きはさせないからさ、いいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290112,
					"content": "今度はどんな物語？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "ハハッ、もう「ファデュイ物語」は全部話し終えたさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290115,
					"content": "今回は正真正銘の報酬、モラをやる。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290116,
					"content": "まあ、俺様がリリーに話す童話のほうが気になるんなら、それでもいいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290117,
					"content": "何を手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "えっと…実は今回お前に頼みたいことも、リリーに関することなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290121,
					"content": "このモンド城で、俺様みたいな「ファデュイの悪いおじさん」の話を聞いてくれるやつは、お前以外にはリリーしかいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290122,
					"content": "今後、もうモンド城に帰ってくることはないだろう…だから最後の記念に、リリーにプレゼントを贈りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290123,
					"content": "だがお前も知っての通り、俺様が街で買い物をしたら、きっと冷たい目で見られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290124,
					"content": "だから、頼むよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290125,
					"content": "マージョリーのところで、何か子供が喜びそうなものを見つけてきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290118,
					"content": "まだリリーと遊んであげてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "まあ…遊んでやってる…たまにだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290113,
					"content": "ファデュイの物語って多いんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		}
	]
