					"nextDialogs": [
						200290802
					],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290802,
					"content": "どうちて？ふぁでゅいのおじさん、リリーにたくさん、おはなし聞かせてくれるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290803,
					"content": "ヴィクトルから、リリーにって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "わぁ！ふぁでゅいのおじさん、リリーにぷれぜんとくれたの？ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290805,
					"content": "待て、どうしてファデュイがリリーにプレゼントを…まさか何かする気じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290806,
					"content": "リリー、なんかいも、おじさんにおいしいものあげたの！だからこれはきっと、おじさんのお返し！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290807,
					"content": "リリー、ファデュイのおじさんは良い人なんかじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290808,
					"content": "でも、おじさんはリリーにおはなしを聞かせてくれるもん。いいひとだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290809,
					"content": "これはお別れのプレゼント。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "え…ふぁでゅいのおじさん、どうちて行っちゃうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290812,
					"content": "ふぅ…そいつは良かった。あいつは毎日リリーと話をしてたから、俺は気が気じゃなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290813,
					"content": "おとうしゃん！あのおじしゃんにさよなら言いに行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290814,
					"content": "はぁ…リリー、もうあのおじさんに近づくのはやめなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290815,
					"content": "なんで！おじさんは…リリーにやさしくしてくれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290816,
					"content": "おはなししたり、おいしいものをくれたり！ぜったいぜったい、いいひとだもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 200290817,
					"content": "リリー、お父さんの言うことを聞きなさい…これはそんな単純なことじゃないんだ…はぁ、お父さんもこれからリリーにお話を読んであげるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルドルフ"
				},
				{
					"id": 200290810,
					"content": "ヴィクトルはもうすぐモンド城を離れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
