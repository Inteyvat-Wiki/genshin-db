			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "あ、ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290502,
					"content": "魔物たちが凄くしつこくてね…こんなところにまで逃げてきたのに、それでも追いかけてくるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290503,
					"content": "ググプラムを採りに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "うん、そうなんだ。マージョリーさんの依頼で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290505,
					"content": "誰かに付き添ってもらえばいいのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "「植物採集」なんてレベルの依頼、一緒について来てくれる人なんていないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290508,
					"content": "もちろん分かってるんだけど、ググプラムは奔狼領にしかないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290509,
					"content": "それに、安全区域にあるググプラムは、もうとっくに全部採られてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290510,
					"content": "ググプラムが欲しければ、もっと奥に行くしかないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290511,
					"content": "さて、話はここまでにして、このググプラムをマージョリーさんに渡してきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290512,
					"content": "僕は少し休むよ。さっき走って疲れちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怖がっているシュースター"
				},
				{
					"id": 200290507,
					"content": "一人でそんな遠くに行かない方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
