			"dialogs": [
				{
					"id": 200290701,
					"content": "どうだ、プレゼントは手に入れたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "ヴィクトル"
