			"dialogs": [
				{
					"id": 200291701,
					"content": "プレゼントをリリーに渡してきてくれ。リリーは<color=#00E1FFFF>広場の近く</color>にいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291702
