			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マージョリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "こんにちは、旅人さん。本日はどんなご用でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290202,
					"content": "子供にプレゼントをあげたいんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "子供へ贈るプレゼントですか…そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290204,
					"content": "そういえば、最近作っているおもちゃがあるんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290205,
					"content": "そのおもちゃには、ググプラムを使って色を着けないといけないんです。でも、今ちょうどググプラムを切らしていて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290206,
					"content": "それでシュースターさんに採集を頼んだんですけど、まだ帰ってこなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290207,
					"content": "旅人さん、野外でシュースターさんを見つけてきてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290208,
					"content": "十分なググプラムがあれば、そのおもちゃを作ることができますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290209,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "<color=#00E1FFFF>奔狼領の近く</color>で、ググプラムを探すと言ってましたよ。そこに行けば彼を見つけられるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290212,
					"content": "ではお願いしますね、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200290210,
					"content": "シュースターはどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
