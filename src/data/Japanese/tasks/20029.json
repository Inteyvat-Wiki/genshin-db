			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "プレゼントは手に入れたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290402,
					"content": "国に戻ったら何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "何をするって言われてもな…上からの命令を待つしかないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290404,
					"content": "はぁ、運が悪かったら、また今回みたいにクソみたいな場所で突っ立ってる羽目になるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290405,
					"content": "強いていえば…稲妻だけは行きたくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290406,
					"content": "どうして急に異動になったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "それはもちろん、「淑女」様が…その…亡くなったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290408,
					"content": "まあ、俺様の階級じゃ、上の命令を待つだけだ。それ以上のことを考える必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290409,
					"content": "リリーはどこに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "ルドルフが広場へ遊びに連れていったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290411,
					"content": "ふんっ、きっと俺様みたいな「ファデュイの悪いおじさん」と話をさせたくないんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 200290412,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "ああ。プレゼントのことは頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
