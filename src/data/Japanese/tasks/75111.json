					"ミチカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "これは…アイヤ宛ての配達物みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110202,
					"content": "…包装が破れてしまっているな。このまま配達しても、配達物そのものが壊れてしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110203,
					"content": "こっちはまだ店の配達物を整理しなきゃならないから、代わりにこれをアイヤまで届けてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110204,
					"content": "彼女は「聖火競技場」内にある「フリーダ·パレット」の店主だ。とても目立つ看板をしてるからすぐ分かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミチカ"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
