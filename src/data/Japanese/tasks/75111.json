			"dialogs": [
				{
					"id": 751111401,
					"content": "確かに私のよ。「こだまの子」のほうで顔料を買うも、どうしても欲しい色をうまく言えないお客さんがいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "アイヤ"
				},
				{
					"id": 751111402,
					"content": "だから顔料のサンプルをいくつか包んで送ってあげたの。今度からそれを参考に顔料を買ってもらえるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "アイヤ"
				},
				{
					"id": 751111403,
					"content": "それよりも、はやくもう一回送ってあげないと。また変なものを参考として送ってこられると困っちゃうわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "アイヤ"
				},
				{
					"id": 751111404,
					"content": "そうだ、はいこれ報酬ね。届けてくれてどうもありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイヤ"
				}
