				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "この筆跡…チアンカが書いたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110302,
					"content": "…きっとまた発注リストを送ったんだろう。だが封筒が破れてしまっているから、これじゃ届けるわけにはいかない、このまま送り返さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110303,
					"content": "こっちはまだ店の配達物を整理しなきゃならないから、代わりにこれをチアンカに送り返してもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110304,
					"content": "彼女は聖火競技場内にある「草臥の家」の店主だ。お店ならすぐに見つかるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミチカ"
				}
			]
		},
		{
