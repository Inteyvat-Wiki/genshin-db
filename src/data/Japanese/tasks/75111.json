			"dialogs": [
				{
					"id": 751110401,
					"content": "「ムフル宝石店」の…イミシュ？まずいな、もしかして発注リストを送り出しちゃったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110402,
					"content": "もしこの配達物をなくしたら、あの子はこっぴどくチョウエンに叱られてしまうはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110403,
					"content": "こっちはまだ店の配達物を整理しなきゃならないから、代わりにこれをイミシュに送り返してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 751110404,
					"content": "彼女たちの「ムフル宝石店」なら「こだまの子」のところにある、すぐ見つかるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミチカ"
				}
			]
		},
