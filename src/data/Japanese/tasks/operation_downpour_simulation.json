			"completionStepIds": [
				7451701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451701",
							"2"
						],
						"stepId": 7451701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥレーヌ",
					"アンジェニーナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745170101,
					"content": "#ちょうど兵棋とシナリオの準備が終わったばかりなんです。絶好のタイミングでいらっしゃいましたね、副隊長の{NICKNAME}さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170102
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170102,
					"content": "へえ、あの噂って本当だったんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170103
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170103,
					"content": "「熱い戦術バトルの気配を感じ取ると、副隊長は弾よりも速く駆けつけ、迅速かつ的確に兵たちを指揮する」って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170104,
						745170105
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170104,
					"content": "ちょうどいい時に来たみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				},
				{
					"id": 745170106,
					"content": "なるほど！いま使われてる銃には、まだ改良の余地があるってことですね。私も弾の初速を上げる必要があると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170107
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170107,
					"content": "#トゥレーヌ、その話はいいから。せっかく{NICKNAME}さんが来てくれたんだし、早く本題に入ろうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170108
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170108,
					"content": "そうでした、銃の改良についてはまたの機会に。今回は、副隊長が思う存分才能を発揮できる場をご用意したんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170109,
						745170111
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170109,
					"content": "新しい「演習」ゲーム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170110
					]
				},
				{
					"id": 745170110,
					"content": "正解です！特巡隊が直面する作戦環境に基づいて、演習のルールや仕様をアップデートしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170113,
					"content": "スリル満点で、挑戦し甲斐があると思うよ。特巡隊の精鋭が考案した難題とか、いろんなチャレンジが組み込まれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170114
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170114,
					"content": "私もいくつか試してみたんだけど、オタオタしちゃって…だから、副隊長さんの指揮能力をこの目で見れたらうれしいな～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170115
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170115,
					"content": "もちろん報酬はお支払いします。遊んでるだけで儲かる、まさに夢のようなチャンスですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170116,
						745170117
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170116,
					"content": "副隊長としての腕の見せ所だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170118,
					"content": "#どうなるか楽しみだね。けど、たとえ{NICKNAME}さんでも、三つ目の攻撃演習は無理なんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170119
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170119,
					"content": "#ありえません！それは教官の腕が鈍ってただけで、{NICKNAME}さんなら絶対に大丈夫だと思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170120
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170120,
					"content": "い、言ったな、トゥレーヌ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170121
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745170121,
					"content": "なんなら、賭けたっていいですよ！そうですね…シュヴルーズ隊長も使っている、限定版の競技用弾を賭けるのはどうです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170117,
					"content": "報酬付きのゲームなら大得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170118
					]
				},
				{
					"id": 745170111,
					"content": "つまり…どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170112
					]
				},
				{
					"id": 745170112,
					"content": "以前、璃月で行われた合同演習は覚えていますか？璃月から戻った後、特巡隊の任務内容に即した訓練ができるよう、演習内容を調整してみたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745170113
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745170105,
					"content": "どうせなら「弾」より「雷」がいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745170106
					]
				}
			]
		}
	]
}