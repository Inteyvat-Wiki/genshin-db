				"points": []
			},
			"dialogs": [
				{
					"id": 733070601,
					"content": "ソルシュと「謁賛主」…おや、パイモンまで来たのかネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070602
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070602,
					"content": "おい！「おや」とか「まで」って、どーゆうことだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070603,
					"content": "まあまあ、貴方たちの様子を見るに、何か面白い発見でもあったみたいネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070604
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070604,
					"content": "別に、面白いってわけでもないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070605,
					"content": "ズルヴァーンに「霊谷木」について伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070606
					]
				},
				{
					"id": 733070606,
					"content": "ふうむ…どこから説明すればよいかネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070607
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070607,
					"content": "貴方たちが見た「霊谷木」は、確かに花霊の化身であることは間違いないワ。ただ、「霊谷木」に宿っているのは、霊魂の残りと言うより、記憶の残片と言ったほうが正しいだろうネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070608
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070608,
					"content": "貴方たちが手に入れた「浄光の羽根」も同じで、あの中には大地に還れなかった記憶が宿っているのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070609,
						733070610
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070609,
					"content": "大地に還れなかった記憶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070613
					]
				},
				{
					"id": 733070613,
					"content": "彼らと違い、我ら花霊は花海の甘露から生まれたノ。最後にはまた花海に返るのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070614
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070614,
					"content": "此処を守護してくださる神様と同じように、私たちは大地を流れる「時輪の流れ」に拒まれた種族——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070615
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070615,
					"content": "だからこそ、漆黒のモノが私たちと共に大地に流れ込まずに済むノ。それは私たちの使命であるとともに、心からの願いでもあるのだからネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070616
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070616,
					"content": "そして「甘露の池」は、汚染による穢れを甘露を用いて洗い流すことができるのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070617
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070617,
					"content": "貴方たちが持っている「浄光の羽根」を「甘露の池」に奉納すれば、散り散りになった花霊たちは、再び花海に戻れるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070618
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070618,
					"content": "へへっ、オイラたち、すっごくいいことをしたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070619,
					"content": "フン、なんで白フラが自慢気なのヨ。これは私の偉大なる力のお陰デショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070620
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733070620,
					"content": "わかったわかった。おまえも偉いぞ、ソルシュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070621,
					"content": "当然ヨ…というか、別に白フラに褒められたいワケじゃないワ！我が「謁賛主」にさえわかってもらえれば十分ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070622
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733070622,
					"content": "「謁賛主」と言えば、貴方もその肩書を受け入れているようネェ。確かに、あの儀式に最も相応しい人選だと思うワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070623
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070623,
					"content": "かつて花霊と行動を共にしていた人間の勇士は、砂漠に散らばった花霊のために浄罪の儀式を執り行い、彼女らを花海に連れ帰ってきたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070624
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070624,
					"content": "そのように花霊との間で特別な繋がりを築いた人のことを、「謁賛主」と呼んでいるノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070625
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070625,
					"content": "ええっ、ソルシュが言ってたのと全然違うじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070626,
					"content": "まあまあ、怪我の功名というものだネ。さて、貴方たちには「謁賛主」として、失踪した花霊を救い出す責任を担ってもらうワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070627
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070627,
					"content": "今後また「霊谷木」を見つけたら、そこに結実した「浄光の羽根」を花海まで持ってきてほしいノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070628
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070628,
					"content": "おう！言われなくたって、オイラたちは花霊を助けるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070610,
					"content": "「甘露の池」に奉納されたのも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070611
					]
				},
				{
					"id": 733070611,
					"content": "「浄光の羽根」とは、神鳥「シームルグ」の霊光の化身のこと。我ら花霊の最初の誕生も、霊光と甘露の結びつきが起源なのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070612
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070612,
					"content": "また、それは私たちが霊光の末裔と呼ばれている所以でもあるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070613
					],
					"speakerTitle": "ズルヴァーン"
				}
			]
		},
