			},
			"dialogs": [
				{
					"id": 733070201,
					"content": "ソルシュと「謁賛主」…おや、パイモンまで来たのかネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070202
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070202,
					"content": "おい！「おや」とか「まで」って、どーゆうことだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070203,
					"content": "まあまあ、貴方たちの様子を見るに、何か面白い発見でもあったみたいネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070204
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070204,
					"content": "別に、面白いってわけでもないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070205,
					"content": "ズルヴァーンに「霊谷木」について伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070206
					]
				},
				{
					"id": 733070206,
					"content": "ふうむ…どこから説明すればよいかネェ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070207
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070207,
					"content": "貴方たちが見た「霊谷木」は、確かに花霊の化身であることは間違いないワ。ただ、「霊谷木」に宿っているのは、霊魂の残りと言うより、記憶の残片と言ったほうが正しいだろうネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070208
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070208,
					"content": "貴方たちが手に入れた「浄光の羽根」も同じで、あの中には大地に還れなかった記憶が宿っているのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070209,
						733070210,
						733070213
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070209,
					"content": "大地に還れなかった記憶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070217
					]
				},
				{
					"id": 733070217,
					"content": "彼らと違い、我ら花霊は花海の甘露から生まれたノ。最後にはまた花海に返るのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070218
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070218,
					"content": "此処を守護してくださる神様と同じように、私たちは大地を流れる「時輪の流れ」に拒まれた種族——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070219
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070219,
					"content": "だからこそ、漆黒のモノが私たちと共に大地に流れ込まずに済むノ。それは私たちの使命であるとともに、心からの願いでもあるのだからネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070220
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070220,
					"content": "「霊谷木」に「浄光の羽根」が結実しさえすれば、各地に散らばる花霊たちもいつかは花海に返ってこられるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070221
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070221,
					"content": "そして「浄光の羽根」が「甘露の池」に奉納されれば、彼女らの穢れも洗い流されル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070222
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070222,
					"content": "へへっ、オイラたち、すっごくいいことをしたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070223,
					"content": "フン、なんで白フラが自慢気なのヨ。これは私の偉大なる力のお陰デショ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070224
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733070224,
					"content": "わかったわかった。おまえも偉いぞ、ソルシュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070225,
					"content": "当然ヨ…というか、別に白フラに褒められたいワケじゃないワ！我が「謁賛主」にさえわかってもらえれば十分ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070226
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733070226,
					"content": "「謁賛主」と言えば、貴方もその肩書を受け入れているようネェ。確かに、あの儀式に最も相応しい人選だと思うワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070227
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070227,
					"content": "かつて花霊と行動を共にしていた人間の勇士は、砂漠に散らばった花霊のために浄罪の儀式を執り行い、彼女らを花海に連れ帰ってきたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070228
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070228,
					"content": "そのように花霊との間で特別な繋がりを築いた人のことを、「謁賛主」と呼んでいるノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070229
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070229,
					"content": "ええっ、ソルシュが言ってたのと全然違うじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070230,
					"content": "まあまあ、怪我の功名というものだネ。さて、貴方たちには「謁賛主」として、失踪した花霊を救い出す責任を担ってもらうワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070231
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070231,
					"content": "今後また「霊谷木」を見つけたら、そこに結実した「浄光の羽根」を花海まで持ってきてほしいノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070232
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070232,
					"content": "おう！言われなくたって、オイラたちは花霊を助けるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070210,
					"content": "「甘露の池」に奉納されたのも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070211
					]
				},
				{
					"id": 733070211,
					"content": "「浄光の羽根」とは、神鳥「シームルグ」の霊光の化身のこと。我ら花霊の最初の誕生も、霊光と甘露の結びつきが起源なのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070212
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070212,
					"content": "また、それは私たちが霊光の末裔と呼ばれている所以でもあるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070213,
					"content": "聞き覚えのある話だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070214
					]
				},
				{
					"id": 733070214,
					"content": "そうだな。以前森で手に入れた「ビージャの実」も、確かアランナラの記憶が結実したものだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733070215,
					"content": "アランナラ…？あの、のほほんと生きている妖精たちを知ってるのかネ？なら話が早いワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070216
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 733070216,
					"content": "アランナラは大地に生まれた種族だケド…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "ズルヴァーン"
				}
			]
		},
