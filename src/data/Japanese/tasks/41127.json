			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "外でなにをしてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "おいおい、そんな疑いの顔しないでくれよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270303,
					"content": "俺様はただ外でぶらぶら散歩してただけだ！隕石が落ちてきたから、急いで帰ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270304,
					"content": "さあ、探してくれ、本当に見つからない時は<color=#00E1FFFF>俺様のところに戻れ</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270305,
					"content": "もう少し頑張って何か思い出せないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
