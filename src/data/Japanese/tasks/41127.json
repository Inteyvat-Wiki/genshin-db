			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "走って帰った時なにが起きた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "走って帰った時？そうだな…具体的なことは覚えてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270503,
					"content": "そうだ、確か<color=#00E1FFFF>千風の神殿</color>から走ってきた時、雷スライムの大群に遭ったんだ。うっかりぶつかって、その時に箱を落とした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270504,
					"content": "すぐに箱を拾って、慌てて走り出したけど…最終的には落としてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270505,
					"content": "でも、あの箱は雷スライムに触れたから、多分<color=#00E1FFFF>元素の痕跡</color>がついてるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270506,
					"content": "とりあえず、雷元素の跡を辿ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
