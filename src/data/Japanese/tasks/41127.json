			"dialogs": [
				{
					"id": 411270401,
					"content": "箱にはなにが入ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "そ、それはいいだろ、つまらないものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270403,
					"content": "おい！そんな怪しい目つきで見るな！俺様は悪いやつじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270404,
					"content": "でもファデュイだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "ファデュイ…ファデュイだったら怪しいのか？とんだ言いがかりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270406,
					"content": "さあ、探してくれ、本当に見つからない時は<color=#00E1FFFF>俺様のところに戻れ</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270407,
					"content": "もう少し頑張って何か思い出せないか…",
					"roleType": "TALK_ROLE_NPC",
