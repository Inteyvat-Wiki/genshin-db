			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "終わりだ、もう終わりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270102,
					"content": "どうしたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "毎日ここにいるのがつまらないんだ。シスターからは白い目で見られるし、俺様は外に行きたいだけなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270104,
					"content": "俺様が城を出た時、千風の神殿近くでうろついててな…ここに着く前に、空から突然隕石が降ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270105,
					"content": "こんなことしてちゃいられないと、急いで走ってきたんだが…箱を一つ落としてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270106,
					"content": "今こんなんだから、俺様も外に行って探せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270107,
					"content": "しかも…俺様は「ファデュイ」だ。こんな時に行動すれば、絶対に疑われる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270108,
					"content": "まあ単刀直入に言うが。俺様が落としたものを探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270109,
					"content": "以前した「取引」はとても良かった。今回も良い取引になるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270110,
					"content": "そんな怪しいこと言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "えっと…何が怪しいんだ？少し話をしただけじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270112,
					"content": "簡単にいこう。手伝ってくれるかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
