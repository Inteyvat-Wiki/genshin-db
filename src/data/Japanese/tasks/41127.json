			"dialogs": [
				{
					"id": 411270201,
					"content": "なんだ？まだ何かあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270202,
					"content": "ヒントがないと難しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "うーん、分かった。今思い出すから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270204,
					"content": "本当に思い出せない、何も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 411270205,
					"content": "じゃあこっちから質問を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "質問？いいよ、何が聞きたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
