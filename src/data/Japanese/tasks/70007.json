			"trigger": {
				"objectNames": [
					"エラ·マスク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070102,
					"content": "怒ってるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "ごめんなさい、最近図書館が騒がしくて、落ち着いて研究することができないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070105,
					"content": "風花祭が始まってから、たくさんの人がここにデートしに来るの。最初は静かに本を読んでたけど、いつの間にか話をしてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070106,
					"content": "それに…彼ら…恐ろしいことをやったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070107,
					"content": "本の角を折ったり…本に何か挟んだり…しまいには、本を逆さにして本棚に入れたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070108,
					"content": "図書館は恋愛するところじゃない！真面目に研究してる人の邪魔になるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070109,
					"content": "ワイラットが秩序を維持するべき。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "彼も何もできないわ。その人たちを追い出しても根本的な解決にはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070113,
					"content": "とにかく、ここの人に静かにしてくれるよう注意してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070114,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "ありがとう。一番うるさいのが向こうにいる3組のカップルね。彼らが落ち着いたら、私も研究を再開できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070117,
					"content": "でも気を付けて、彼らは結構厄介よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070115,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "リサさんを探せば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "彼女は代理団長と一緒に見回りに行ってるらしいわ。だから今はいないの。彼女がいたら、カップルたちもあんなことできないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700070103,
					"content": "普段より凶暴さが増してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
