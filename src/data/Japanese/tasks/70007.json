			"dialogs": [
				{
					"id": 700070801,
					"content": "図書館がうるさいことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "なるほど、では「あの方法」を使う時が来たのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "ワイラット"
				},
				{
					"id": 700070803,
					"content": "リサさんから、図書館の規則を破った人には、相応の罰を与えるべきだと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "ワイラット"
				},
				{
					"id": 700070804,
					"content": "図書館に行って、リサさんの話を伝えてきてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "ワイラット"
				},
				{
					"id": 700070805,
					"content": "本を折ったり、バラを入れたり、逆さに戻したり…図書館の規則を破ってるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070806,
					"content": "行こう、あの人たちにリサさんの話を伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
