			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "ん？なにか用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "恋に落ちた女性"
				},
				{
					"id": 700070302,
					"content": "図書館ではお静かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "ごめんなさい、気を付けるわ。でも、仕方ない時もあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "恋に落ちた女性"
				},
				{
					"id": 700070305,
					"content": "例えば、君が気付かないうちに、僕が本からバラを取り出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "マジックを披露する男"
				},
				{
					"id": 700070306,
					"content": "本からバラが生まれるなんて、まるで君のように優しくて美しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "マジックを披露する男"
				},
				{
					"id": 700070307,
					"content": "キャーッ！すごいわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "恋に落ちた女性"
				},
				{
					"id": 700070308,
					"content": "声が大きい！それに、本でマジックをやるな！壊れるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070309,
					"content": "パイモンの声も大きくなってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "おう、ごめん…つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070311,
					"content": "これで分かったでしょ、仕方ないことなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "恋に落ちた女性"
				},
				{
					"id": 700070312,
					"content": "でも静かにするよう気を付けるわ、ごめんなさいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "恋に落ちた女性"
				},
				{
					"id": 700070313,
					"content": "どうやら、全然聞いてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070303,
					"content": "うるさいって苦情がきてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
