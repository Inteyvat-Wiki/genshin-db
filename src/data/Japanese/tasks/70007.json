			"trigger": {
				"objectNames": [
					"恋する青年",
					"恋する少女"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "本当に感動する物語だね。残念なことに最後はハッピーエンドじゃなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070202,
					"content": "私たちはそんなことにはならない、そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "恋する少女"
				},
				{
					"id": 700070203,
					"content": "それは当然さ。どんなに離れていても、僕のそばに連れ戻すからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070204,
					"content": "図書館ではお静かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "えっ？もうだいぶ小声だと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "恋する少女"
				},
				{
					"id": 700070207,
					"content": "恋愛には邪魔が入るとはまさにこのことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070208,
					"content": "読み終わった本も、ちゃんと正しい場所に戻さなきゃダメだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070209,
					"content": "そうやって適当に置くと、本棚を整理する人が困るんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070210,
					"content": "分かった分かった。もう邪魔しないでくれ、今肝心なところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070211,
					"content": "肝心なところ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070212,
					"content": "どんな邪魔が入っても、今みたいに、永遠に変わらないわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "恋する少女"
				},
				{
					"id": 700070213,
					"content": "ああもちろん、命にかけて誓うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070214,
					"content": "そんな…命だなんて、そんなのいけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "恋する少女"
				},
				{
					"id": 700070215,
					"content": "ああ、君はなんて優しいんだ。惚れ惚れするよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "恋する青年"
				},
				{
					"id": 700070216,
					"content": "なんか、全然聞いてないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070205,
					"content": "うるさいって苦情がきてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
