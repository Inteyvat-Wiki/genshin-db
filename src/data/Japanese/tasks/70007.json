			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "あなたが主張した「感情の変化によって研究の正確さに影響が出る」ことに、明確な証拠はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "一見理知的な女性"
				},
				{
					"id": 700070402,
					"content": "ああ、分かってるさ。私は今スランプに陥っているのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "一見理知的な男性"
				},
				{
					"id": 700070403,
					"content": "いいところに来た。君たちの意見も聞かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "一見理知的な男性"
				},
				{
					"id": 700070404,
					"content": "私の理論の正確さを証明するには、私の感情に変化がないことが前提だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "一見理知的な男性"
				},
				{
					"id": 700070405,
					"content": "しかし私にはそれができない。特に彼女といる時は、落ち着いて話せないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "一見理知的な男性"
				},
				{
					"id": 700070406,
					"content": "私もおかしいと思います。寝不足のせい？それともお酒を飲み過ぎたから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "一見理知的な女性"
				},
				{
					"id": 700070407,
					"content": "とにかく、図書館ではお静かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "とにかく、静かにして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "わるい、でもこのことが分からないと、居ても立っても居られない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "一見理知的な男性"
				},
				{
					"id": 700070410,
					"content": "ぜ、全然分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070411,
					"content": "うぅ、とにかく、他の人の邪魔はしないでくれ。それと、本を逆さにして本棚に入れることもダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700070412,
					"content": "もう無視してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
