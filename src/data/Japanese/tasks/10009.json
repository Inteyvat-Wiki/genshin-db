			"dialogs": [
				{
					"id": 100090601,
					"content": "材料は全部そろったし、錬成用の錬金釜もあっちにあるから…いつでも始められるけど、えっと…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090602,
					"content": "まだなにか困ってることがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090603,
					"content": "ううん、違うの。ただ、正確に記録するためにも、あなたたちが錬成するところを見てもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090604,
					"content": "実は、実験を見られたくない人って多くて…私も、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090605,
					"content": "もちろんいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "ありがとう。じゃあ、準備ができたら始めよう。ちゃんと記録しておくからね。どんな細かいことも見逃さないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
