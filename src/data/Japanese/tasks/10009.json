			"dialogs": [
				{
					"id": 100090101,
					"content": "うん…前の結果をもとに、実験計画をちょっと調整しようかな。それから、器材と実験用の素材も確認しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090102,
					"content": "あ、そうだ、今日作る錬金薬は…えっ、旅人さんにパイモン？どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090103,
					"content": "へへっ、オイラたち、「課題」を手伝いに来たんだ！なにかオイラたちにできることがないか、確かめておこうと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090104,
					"content": "「課題」って…あ、アルベド先生が前に言ってた、魔女会に関係する「課題」のことかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090105,
					"content": "ちょうど今日は、定期実験の予定が入ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090106,
					"content": "定期？じゃあ、スクロースはずっとその実験をやってるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090107,
					"content": "うん。でも私の研究分野と方向性がある程度一致してるから、この「課題」を続けるのはそんなに負担じゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090108,
					"content": "だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090109,
					"content": "どうしたんだ？実験でなにか困ったことでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090110,
					"content": "うん、実験はずっと「成功してない」の。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090111,
					"content": "えっ、ってことはもう何回も失敗してるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090112,
					"content": "単純に「失敗」したわけじゃないの。この「課題」の背後にある原理は、想像してるよりもちょっと複雑で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090113,
					"content": "それで、どんな課題なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "そういえば聞いてなかったな。具体的にはどんな実験なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090115,
					"content": "スイートフラワーを「十六倍大きいスイートフラワー」にする薬剤配合の実験…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090116,
					"content": "つまり、錬金薬「四式植物倍化剤七型」の調合実験だよ。ちなみに「七型」なのは、今日がこの実験の七回目だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090117,
					"content": "じゅ、十六倍！？とにかく、わかったぞ！オイラたちは「大きくなる薬」七号を作るってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090118,
					"content": "「大きくなる薬」七号…う、うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090119,
					"content": "ただ、七号といっても、配合はあまり大きく変えてないの。原理も実験過程の産物も、問題ないことが証明されてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090120,
					"content": "それなのに、ずっと「成功しない」のか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090121,
					"content": "うん、それで考えてたの…何か他の要素を取り入れる必要があるのかもって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090122,
					"content": "ふふん…なるほど、他の要素だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090123,
					"content": "#{M#俺}{F#私}たちが手伝うよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "おう！そもそもオイラたちは、なにか手伝えることがないか見に来たんだしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090127,
					"content": "パイモンを加えたら、元の材料の配合を調整する必要があるから、今までの安定した配合より効果が劣るかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090128,
					"content": "オイラは材料になんかならないぞ！はやく普通のレシピを出してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090129,
					"content": "ここにあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090130,
					"content": "でも、あと二つ材料が足りないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090131,
					"content": "へへっ、オイラたちに任せろ！なにが必要なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090132,
					"content": "ベースになるのは、清泉町の泉水。それと、ちょっと面倒なのが、狂風のコアの破片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090133,
					"content": "おう！じゃあ、さっそく行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100090125,
					"content": "じゃあ、パイモンを材料に薬を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "それならきっと、すごい錬金薬が作れるぞ…って、違うだろ！オイラを薬に入れるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "パイモン"
				}
			]
		},
