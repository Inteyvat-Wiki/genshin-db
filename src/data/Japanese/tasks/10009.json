			"dialogs": [
				{
					"id": 100090801,
					"content": "できた…錬成の過程は完璧だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 100090802,
