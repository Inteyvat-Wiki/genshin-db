			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "——うーん、生き物みたいな炎、不気味な残像、自動撮影できる写真機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751310402,
					"content": "オイラの勘が言ってるぞ！きっと複雑ですごい謎が隠されてるに違いない！ひょっとするとお宝とも関係あるかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751310403,
					"content": "パイモン、何か分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "うーん…正直全然わかんないぞ…でも、持ち主が写真機をここに置いたのは、地面が揺れた瞬間を記録するためだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751310405,
					"content": "なら、写真機を元通りにして、地面が揺れるのを待ってみたらいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751310406,
					"content": "へへ、写真の残像みたいに、お宝の手がかりがジャーンって現れるかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
