			"dialogs": [
				{
					"id": 751310301,
					"content": "せ、生物炎雨！？炎が生き物みたいに飛んでくるってことか？うわぁ、ナタの火山って怖すぎるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}、でもオイラ、ちょっとだけ気になるな…へへっ、この先のエリアを軽く探索してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
