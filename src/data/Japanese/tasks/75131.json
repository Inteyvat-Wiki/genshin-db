			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マザリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "生物炎雨…火山が生き物のように進化し、繁殖しながら周囲を火山に変える…まさか、あの伝説は本当なのか？だとしたら危険すぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310102,
					"content": "火山はそんな風に形成されたんじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "そうだよな。熔岩がなければ火山ができるわけがない。でなきゃ、この一帯はとっくに危険エリアに指定されてるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310105,
					"content": "で、でも、もし伝説が事実だったら？うーん、あの自動で撮影できる写真機が使えたら、何かわかるかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310106,
					"content": "いや待てよ、もし写真機に問題があって映像が撮れていなかったら？…ダメだ、やっぱり時間を作って自分の目で確かめに行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310103,
					"content": "ごめん、邪魔したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "ああ、またな…待てよ、もさか他に隠された事実があるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マザリン"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マザリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "なるほど、生物炎雨の正体は、空から降ってくる浮燃ペンギンだったのか。どうりで普通の噴火よりも範囲が広いわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310202,
					"content": "待てよ…もしあれがいつか自分の家に落ちてきたら…？ダメだ、何か対策を考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310203,
					"content": "それはまた特殊な状況だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "そうだよな、浮燃ペンギンが飛べるのは火山の噴火に乗ったときだけ…うちの家は火山の噴火範囲から外れてるし、心配することはないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310205,
					"content": "だ、だが…もしこれまでにない大噴火が起こったら？その時がきたらもう、安全な場所なんてないんじゃ…？ダメだ、やっぱり何か対策を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マザリン"
				},
				{
					"id": 751310206,
					"content": "ごめん、邪魔したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "気にしないでくれ…とにかく、まずは屋根を補強しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マザリン"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
