			"dialogs": [
				{
					"id": 761120101,
					"content": "よう！マイテからこれを預かってるぞ。あいつの名前を出せば、ここで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761120102,
