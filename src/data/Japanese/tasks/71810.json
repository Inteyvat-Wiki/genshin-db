			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アラニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "うぅ…こんなんじゃ論文が書けない、どうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "…おや？君か！私を覚えてるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100104,
					"content": "霊矩関で宝盗団に捕らわれていた…はは…あの時は、助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100105,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "ああ、あの時君に助けられた後、望舒旅館のソラヤーさんを訪ねたんだ。そこで運良く会えてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100107,
					"content": "ソラヤーさんは本当にいい人だった。私に食べ物をくれたり、私が集めた資料を整理してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100108,
					"content": "でも…その後に教えてくれたんだ。私が選んだ課題は、すでに教令院で多くの人が書いたことがあるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100109,
					"content": "とびっきり上手く書かない限りダメだと…だから他の視点から書いた方がいいって彼女から言われたんだ。例えば元素力とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100110,
					"content": "でも私は「神の目」を持ってないし、元素力も使えない。どうやって書くかさっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100111,
					"content": "だからここに来て、何か使える資料がないか探してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100112,
					"content": "まてよ…前に私を助けてくれた時、戦い方が妙に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100113,
					"content": "君は「神の目」を持ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100114,
					"content": "「神の目」は持ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "あれ？「神の目」がないのにあんな戦い方ができるの？一体どんな原理で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100116,
					"content": "いや、原理はきっと複雑だからひとまず置いといて…君に頼みたいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100117,
					"content": "私に君の戦い方を見せてくれないか？そうしたら、何かが分かって論文の役に立つかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100118,
					"content": "たのむよお願いだ！論文が書けないまま教令院に戻ったら、終わりなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100119,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "ありがとう！じゃあ野外に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100121,
					"content": "前にヒルチャールの集落を見つけた。あれを相手にして、戦い方を見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100122,
					"content": "教令院って…そんなに怖いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "怖いってもんじゃない、非常に恐ろしい…夢で見たらきっと泣いて覚めるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100124,
					"content": "論文を書くくらいなら、宝盗団の牢にいた方がマシだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100125,
					"content": "もう教令院の話はやめよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100126,
					"content": "前にヒルチャールの集落を見つけた。あれを相手にして、戦い方を見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アラニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "うわ…君の戦い方は本当に特別だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100202,
					"content": "そうだ、「神の目」の所持者は元素の痕跡を感知できるって聞いた。「元素視角」って言うらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100203,
					"content": "「神の目」は持っていなくても、元素の力が使えるから…きっとこの能力もあるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100204,
					"content": "へへ、さっき周りにスライムがいたのを見たよ。たのむ、「元素視角」も見せてくれ…その能力でやつらを見つけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アラニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "ははは…「神の目」を持たない私からしたら、君が「元素視角」を使っても普段と何も変わらないように見えたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100302,
					"content": "ふむ、これぞ「神の目」を持つ者のみ知る違いだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100303,
					"content": "こんなにたくさん見せてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100304,
					"content": "はあ、私も「神の目」欲しいなあ…できれば「雷」属性。かっこよくて強いし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100305,
					"content": "でも、雷属性の「神の目」なんて、一番ありえない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100306,
					"content": "努力すればなんとかなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "そんなわけないよ、雷属性の「神の目」は努力しても手に入らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100308,
					"content": "あれ？知らなかったの？ここ一年くらい、だれも雷属性の「神の目」を手にしてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100309,
					"content": "教令院もそのことについて研究してね。その結論が…「雷の神」の意志で、もう人に「神の目」を授けないと決めたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100310,
					"content": "それに、稲妻を統率している「雷の神」は、「目狩り令」を発表したらしい。稲妻で「神の目」を持つ者の「神の目」を回収するとかなんとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100311,
					"content": "もし「神の目」を持つ者が回収を拒んだら、重い罰が待ち受けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100312,
					"content": "私も以前稲妻に関する課題の論文を書こうと思ったけど、危なそうだから、やめたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100313,
					"content": "君は「神の目」がないから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "そんなことないよ！「神の目」を持つ者さえあんな扱いなのに、持ってない人はもっと大変だと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100315,
					"content": "やはり璃月で論文を書いて、教令院に提出しよう。早くしないと、何を言われるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100316,
					"content": "そうだ、こんなにたくさん見せてくれたんだ。これをあげる、お礼にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 718100317,
					"content": "よし、今回こそ論文を終わらせるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				}
			]
		}
	]
}