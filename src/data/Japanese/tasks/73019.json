			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランサカ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "そう、これこれ！ずいぶん早く手に入ったね…本物だよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190602,
					"content": "ボクを騙そうとして、そ、それで偽物を作ったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190603,
					"content": "おまえのあの説明で、そんなもん作れるわけないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190604,
					"content": "そんなに心配なら、味見してみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190605,
					"content": "…まさか、変なものとか入ってないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190606,
					"content": "当たり前だろ。ふんっ、味見するのかしないのかどっちだよ。しないなら、持って帰るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190607,
					"content": "ええっ、それはちょっと…持って帰らないで、あ、味見させて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190608,
					"content": "持ってかないで。す、すぐ味見するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190609,
					"content": "ああ、これこれ…本物の「喜びの味」。あの味だ…ふへへ…また食べられて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190610,
					"content": "また食べられるなんて思わなかった…いや、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190611,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "いや…なんていうか…「喜びの味」は前と同じだけど、初めて食べた時みたいな感動がないなぁって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190614,
					"content": "もしかして、甘さが足りなかったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190615,
					"content": "ううん。味はおんなじだ…でも、前に友達と一緒に、初めて「喜びの味」を食べた時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190616,
					"content": "あの時の方が今よりうんと嬉しかった気がする。どうしてかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190617,
					"content": "#そりゃそうだろう。同じ料理でも、{NICKNAME}は作るたびに味が違うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190618,
					"content": "食べる時の気分だって違うしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190619,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "…いや、違う。初めて「喜びの味」を食べた時みたいに嬉しくなれる方法が絶対にあるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190622,
					"content": "そっか…！あの時は友達と一緒に食べたからだ。「喜びの味」は友達と食べるから、おいしくなるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190623,
					"content": "絶対そうだ。キミたちはいいナラだし、「喜びの味」も見つけてくれた。キミたちは、友達。だから、作って食べさせてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190624,
					"content": "うん、オイラたち、友達だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190625,
					"content": "アランサカは、すぐさま料理に取り掛かった。ザイトゥン桃と砂糖をお鍋に入れて…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "そのあとアランサカは、完成した料理をあなたとパイモンに渡した。\\n思った通り、それはひたすら「甘い」だけで、他の味はしなかった。\\n多分それが「喜びの味」なのだろう。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "ああ、これぞまさに喜びの味。うまうまだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190628,
					"content": "うん、この料理はめちゃくちゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190629,
					"content": "めちゃくちゃ「喜び」にあふれてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190630,
					"content": "甘すぎる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "オイラも。さすがに甘すぎる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190633,
					"content": "そ、そう？いやあ、いっぺんに入れすぎたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190634,
					"content": "でも…へへっ、やっぱり、やっぱり友達と一緒に食べるから、「喜びの味」はおいしいんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190635,
					"content": "初めて「喜びの味」を食べた時とはちょっと違うけど、キミたちと一緒だと…また別の嬉しさがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190636,
					"content": "嬉しいならよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "ボクはキミたちのことを疑ってたのに、キミたちはそれを気にもせず、ボ、ボクに「喜びの味」を届けてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190639,
					"content": "キミたちが手伝ってくれたから、「至高のごちそう」が完成して、「お料理修行」を全うできたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190640,
					"content": "そんな、大げさだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190641,
					"content": "いいや、色々助けてもらったのに、このままじゃ気が済まないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190642,
					"content": "そうだ。この料理のレシピを教えてあげる。そしたらキミたちも友達と「喜びの味」を楽しめるよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190643,
					"content": "（うーん…材料の配分を変えて別のものも加えたら、いいデザートになりそうかもな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190637,
					"content": "水が飲みたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "水が欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "そうかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "何か問題でも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
