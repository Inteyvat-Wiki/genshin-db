			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"ヨニス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190402,
					"content": "ああ、どうも…、なにかご入用ですかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190403,
					"content": "うん。あるものを探してるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190404,
					"content": "ハハッ、そりゃみんな「あるもの」が欲しいに決まってます。でも「あるもの」とだけ言われても、「どんなもの」が欲しいのか分かりっこありませんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190405,
					"content": "うん…確かに。えーっと、オイラたちが欲しいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190406,
					"content": "白くて四角いもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "白くて四角い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190408,
					"content": "そうそう。しかも触ると砂みたいにほろほろ崩れて、硬い泡の中に入ってるやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190409,
					"content": "それは実に奇妙な表現ですな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190410,
					"content": "話を聞いただけじゃ、なんのことやら、さっぱりです。その白くて四角いものというのは、何に使うものなんでしょうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190411,
					"content": "使い道…そう、使い道くらいは分かるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190412,
					"content": "食べられるもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "食べられるもので、白くて四角い…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190416,
					"content": "ああ、あれか！何をご所望かピンときましたよ…ハハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190417,
					"content": "そんな大爆笑すること？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190418,
					"content": "いやあ、アハハハッ。あのですね、白くて四角くて、触るとほろほろ崩れて砂になって…食べられるもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190419,
					"content": "それは「砂糖」でしょうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190420,
					"content": "硬い泡というのは、砂糖を入れている瓶のことでしょう。いやはや、硬い泡とはね。ハッハッハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190421,
					"content": "なんだ。砂糖か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190422,
					"content": "なんかもうがっくり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "いやあ、笑いすぎて涙が出てきました。ずっと商売にかかりきりだったもんで、こんなに笑ったのは久方ぶりですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190425,
					"content": "そういえば、懐かしいなあ。あれはいつだったか…ああそうだ、まだ私が子供の頃です。初めて砂糖を食べた友達が、同じようなことを言ってましたっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190426,
					"content": "「この白くて四角いもの、おいしいねえ！すごい！喜びの味だ」って、そりゃもうびっくりしてましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190427,
					"content": "ハハッ…ずうっと昔のことです。もう彼がどんな顔だったかも忘れてしまいましたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190428,
					"content": "いやあ、笑わせてもらったお礼に砂糖を一瓶差し上げますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190429,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "持ち運びには気をつけてくださいよ。硬い泡でも、落とすと割れますからね。「硬い泡」か、ハッハハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヨニス"
				},
				{
					"id": 730190423,
					"content": "ちょっと恥ずかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "料理の材料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "料理の材料で、白くて四角い…調味料でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "ヨニス"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
