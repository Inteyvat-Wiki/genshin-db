			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "ど、どうだった？「喜びの味」は、あった？…ガンダルヴァー村に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190302,
					"content": "ぷっくりしたものを背負ってるナラがいる。「喜びの味」は、絶対そこに入ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランサカ"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
