			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "しっかり雨のしずくを吸って、早く大きくなるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190102,
					"content": "よう！ラン…ラン、なんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190103,
					"content": "アランパカティのお兄さんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "おおっ、その手があったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190107,
					"content": "…大きくなあれ、大きくなあれ、おいしいご馳走になあれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190108,
					"content": "聞いちゃいないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190105,
					"content": "アランサカ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "そうそう、アランサカ！おまえがアランサカか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "うわあ！ナラだ…おっきいよぅ、恐いよぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190202,
					"content": "お願いだから…採らないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190203,
					"content": "落ち着けよ、採らないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190204,
					"content": "よかったあ。ふふ…このザイトゥン桃は、ボクが一個一個育てたんだ。種からね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190205,
					"content": "いや、違う、オマエたちは悪いナラだ！どうして人が植えたザイトゥン桃に勝手に手を付けるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190206,
					"content": "ど、どうしてナラは、そんな恐ろしいことをするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190207,
					"content": "言いがかりはやめろよな。まだ採ってもないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190208,
					"content": "なにもしてないのに、こんなに恐ろしいんだぞ。なにかされたら、怖すぎて死んじゃうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190209,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190210,
					"content": "いや、アランサカ…よく考えろ。苦労して育てたザイトゥン桃や「お料理修行」のためにも…ここで怖気づいちゃダメだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190211,
					"content": "なんだ、やっぱりアランサカなんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190212,
					"content": "ええっ、な、なんでボクの名前を…オマエたち、どこから来たんだ…ひ、一目見ただけで名前が分かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190213,
					"content": "いや、自分で言ったんでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "もう終わりだ…口は災いの元だ。ボクの名前はおぞましい呪いに使われちゃうんだ…ねえ、お願いだから見逃してよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190215,
					"content": "ザイトゥン桃を渡す以外なら、なんだってするから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190219,
					"content": "そうピリピリするなってば。オイラたちは、アランパカティに頼まれて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190220,
					"content": "ラ、アランパカティに？ああ、ボクのかわいい「妹」、ジャングルの中の太陽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190221,
					"content": "アランサカに事情を話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "ああ、ウツァヴ祭。もうそんな季節か…ふぅ、キミたちは祭りに参加するために来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190223,
					"content": "悪いナラだなんて言ってごめん。キミたちはきっといいナラだ。そうでなきゃヴァナラーナには入れないし、ウツァヴ祭にだって出られやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190224,
					"content": "もうすぐウツァヴ祭か…「お料理修行」を途中で放り出してヴァナラーナに帰れば…いや、それはダメだ…でも祭りには絶対参加しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190225,
					"content": "またこいつ、ピリピリしてきちゃったぜ…ザイトゥン桃さえあればそれでいいんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190226,
					"content": "…ボ、ボクのザイトゥン桃だけじゃ足りないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190227,
					"content": "どうにかして「喜びの味」を手に入れないと。「喜びの味」がないザイトゥン桃なんて、ただのザイトゥン桃だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190228,
					"content": "アランチャトラ、アランパス、アランファラは「喜びの味」の存在を疑ってる。だからみんなに作ってあげたいし、ナラにも食べてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190229,
					"content": "「喜びの味」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "へへっ。「喜びの味」…前に一度食べたことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190232,
					"content": "「喜びの味」。真っ白で、触るとほろほろ崩れて…白いワルカになる。でもワルカみたいに硬くも痛くもない。そんで、硬い泡の中に入ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190233,
					"content": "…白いワルカ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "白いワルカって、白い砂…だよな？でも硬い泡っていうのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190236,
					"content": "うーん、どういうことだ…？その「喜びの味」って、どこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190237,
					"content": "そ、それを聞いてどうするつもり？まさか先回りして、「喜びの味」を奪う気なの？怖い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190238,
					"content": "協力したいんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "手伝うってなにを？ボク、ひとりでできるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190242,
					"content": "ただ、あそこはナラがたくさん通る。しかも、ナラワルカの臭いがするとこが一カ所ある。うう…怖い…ナラがもうちょっと少なければ、いけるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190243,
					"content": "はあ…うん、ボクにはやっぱり無理だ…ガンダルヴァー村はナラが多すぎて怖い。しかも死んだ木ばっかり。ぞっとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190244,
					"content": "あそこにはナラの友達が一人いる。でも、ずぅっと会ってない。カレは変わっちゃった…もう、ボクの声も聞こえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190245,
					"content": "そっか。つまり「喜びの味」は、ガンダルヴァー村にあるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190246,
					"content": "「喜びの味」は、土から生えるものじゃない。ナラが作るものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190247,
					"content": "もう一度食べたいなあ。初めてあれを食べたとき、どんなに嬉しかったか。もう、すごいとしか言えない味だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190248,
					"content": "ナラの友達と森の中で、木立の間から降り注ぐ、金箔みたいな陽射しを数えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190249,
					"content": "一緒に歌って、一緒に「喜びの味」を食べた。木漏れ日を見るたびに、カレと「喜びの味」を思い出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190250,
					"content": "だから、それをアランパカティにも味わわせてやりたい。それにウツァヴ祭が始まれば、ナラにも食べさせてあげられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190251,
					"content": "#分かった。オイラと{NICKNAME}に任せろ！な、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190252,
					"content": "#{M#俺}{F#私}も喜んでみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "いいの？嘘じゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190255,
					"content": "ほんとだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190256,
					"content": "でも、ガンダルヴァー村っていうと人も多いし、誰のとこに行けばいいかわからないぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190257,
					"content": "大丈夫。この間、<color=#00E1FFFF>ガンダルヴァー村に向かう</color>ナラがここを通ったんだ。カレが「喜びの味」を持っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190258,
					"content": "カレはぷっくりしたものを背負ってた。ナラが荷物を入れるのに使うヤツだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190259,
					"content": "ぷっくりしたものか…うーん、<color=#00E1FFFF>旅行バッグとか背負いカゴ</color>だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190260,
					"content": "わかった。じゃあオイラたち、「喜びの味」を探してくるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190253,
					"content": "アランパカティとも約束したし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "うわっ、パイモンってこわっ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "おい！オイラはアランサカを手伝いたいだけだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730190234,
					"content": "…硬い泡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "その「喜びの味」って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "名前は元から知ってたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "ええっ！元から知ってた？とっくに目をつけられてたってわけか…ま、まさかボクから何か奪う気なんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730190218,
					"content": "ザイトゥン桃が狙いか？だ、ダメだ。他のものならあげるけど…でも、ザイトゥン桃だけは何があっても絶対渡さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "アランサカ"
				}
			]
		},
