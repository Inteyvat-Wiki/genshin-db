	"talks": [
		{
			"id": 7468301,
			"completionStepIds": [
				7468301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468301",
							"2"
						],
						"stepId": 7468301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746830101,
					"content": "よう、また会ったな！愛しの大冒険家さんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830102,
						746830103
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830102,
					"content": "こんにちは、大映影監督さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830104
					]
				},
				{
					"id": 746830104,
					"content": "最近どうよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830105,
					"content": "最近どう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830106
					]
				},
				{
					"id": 746830106,
					"content": "おお！ほぼ同時だったな！もしかしてこれが古くからの友人のなせる「阿吽の呼吸」というやつか？だがしかし、俺の方がワンテンポ早かったから、お前の話から聞かせてもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830107,
						746830108
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830107,
					"content": "いつも通り冒険者協会で依頼を受けてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830109
					]
				},
				{
					"id": 746830109,
					"content": "はっはっは、お前はいつもクールだな。他の人ならホラ吹きだと思うが、お前が言うならきっと本当なんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830110,
					"content": "俺もいつも通り、映影を一本撮り終えたから、すぐ次の映影の準備さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830111
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830111,
					"content": "最近、面白そうな冒険譚のアイデアが浮かんできたんだ！互いに知らない者同士が偶然集まって旅をすることになり、スリル満点な困難を乗り越えていく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830112
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830112,
					"content": "うーん、具体的にどのような困難にするかは考えていないが、皆が英雄になるという結果は決まっている。結末については、まぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830113
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830113,
					"content": "…まだ思いついていない！別れてそれぞれの道を歩むことになるのか、みんなで次の冒険に向かう…というのをエンディングにするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830114
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830114,
					"content": "これ以外にも、まだまだアイデアはあるんだ。正直、俺のアイデアは永遠に尽きることがないんじゃないかと思う。毎晩寝る前に、頭の中でひたすら飛び交うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830115
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830115,
					"content": "悪く言えば眠れなくなる、良く言えばこんなに沢山のアイデアがあるから一生アイデアの枯渇を恐れなくていい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830116,
					"content": "順調みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830117
					]
				},
				{
					"id": 746830117,
					"content": "実は全てが順調というわけではないのだ。資金やら、スポンサーの問題やら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830118
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830118,
					"content": "センスのある太っ腹なスポンサーに出会えることもあるし、千霊映影祭という絶好のチャンスに出会えることもある。だがそんなビッグチャンスは常に転がっているわけではないから、自分で何とかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830119
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830119,
					"content": "手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830120
					]
				},
				{
					"id": 746830120,
					"content": "おおっ？気遣いありがとうな…だが答えはノーだ、お前の助けは借りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830121
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830121,
					"content": "自分の夢を叶えるために、最初から友人の好意に甘えたくないんだ。友として、たまに挨拶や連絡をしてくれるだけで十分さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830122
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830122,
					"content": "資金問題は俺自身でなんとかするよ。例えば、ちょうど今一部スポンサーのコマーシャルの撮影を手伝っているんだ。報酬は決して多いとは言えないが、収入は十分安定している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830123
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830123,
					"content": "コマーシャル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830124
					]
				},
				{
					"id": 746830124,
					"content": "ああ、映影が流行り始めてから、多くの店や組織がこの新しい宣伝方法に目を付けているんだ。店や組織の需要に合わせた撮影プランを立てて、それを形にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830125
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830125,
					"content": "ストーリーを重んじる映影とは違って、コマーシャルは短い時間で観客の目を引かないといけない。だからテンポが早くて、アイデアが斬新なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830126
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830126,
					"content": "ああ…それからスポンサーの意見も多めに取り入れないといけない。矛盾した修正やめちゃくちゃな修正案が出されることもあって…まったく理解が追い付かないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830127
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830127,
					"content": "おっと、こんな話、聞かれたらただじゃすまないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830128
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830128,
					"content": "大変そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830129
					]
				},
				{
					"id": 746830129,
					"content": "大丈夫さ、本当にやりたいことをやるためには、多少の犠牲は仕方ない。そう、海鮮を食べるときと同じだ。貝の中の剥き身を食べるためには、貝をこじ開けないといけないだろう？なんてことないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830130
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830130,
					"content": "もっと理不尽なスポンサーにあたったこともあった。なんと、ミステリー映影の冒頭、タフな主人公の登場シーンで、スポンサー先の児童用牛乳を飲ませろ、とか言うんだぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830131
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830131,
					"content": "映影と関係ないところでコマーシャルを沢山撮影しておけば、映影内にコマーシャルを入れずに済む…そう考えれば、コマーシャルの撮影も随分気が楽になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830132
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830132,
					"content": "ああそうだ、丁度お前が興味あるかどうか、聞きたいことがあるんだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830133
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830133,
					"content": "なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830134
					]
				},
				{
					"id": 746830134,
					"content": "ずいぶん一緒に作品を作っていないだろう。昔一緒に撮影したシーン、だいぶ良かったんだが。お前も撮影はなかなか楽しんでいたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830135
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830135,
					"content": "ということで、今度は一緒にコマーシャルでも撮らないか？コマーシャルは映影とは勝手が違うが、これはこれで楽しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830136
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830136,
					"content": "使いたい素材はすでに撮影済みだから、お前がロケに向かう必要は無い。ただ、ちょっとばかりクリエイティブな編集をしてくれれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830137,
						746830138
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830137,
					"content": "つまり今回は加工と編集をするってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830139
					]
				},
				{
					"id": 746830139,
					"content": "ああ、じゃあ時間のある時に話しかけてくれ！作品の出来に関しては気にしなくてもいい。ただ、懐かしい相棒と共に面白いものを作りたいだけなんだ。スポンサーとの話はつけておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746830140
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830140,
					"content": "広告というからには、面白いのが一番だ！思うがままに編集したほうが、意外といいものができるかもしれないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 746830138,
					"content": "アイデアなら任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830139
					]
				},
				{
					"id": 746830108,
					"content": "ついでに世界を救ったり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830109
					]
				},
				{
					"id": 746830103,
					"content": "久しぶり、グザヴィエ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746830104
					]
				}
			]
		}
	]
}