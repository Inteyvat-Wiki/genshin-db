					}
				]
			},
			"dialogs": [
				{
					"id": 750680301,
					"content": "なぜ、まだここにいる…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680302
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750680302,
					"content": "冒険団の隊長——鷹の仮面を被ったあの英雄でさえもう…我々にできることは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680303
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750680303,
					"content": "いいか、今すぐ離れろ。ここは呪われた地だ。人間が足を踏み入れていい場所じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
		{
			"id": 7506804,
