	"talks": [
		{
			"id": 1302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302304",
							"2"
						],
						"stepId": 1302304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ",
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "シラージ、か。記憶にないな。君たちの学年にそんなやついたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230102,
					"content": "印象に残るような人間ではない、覚えていなくて当然だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230103,
					"content": "教令院は人に圧力をかけるのが好きな上に、すぐに天才だなんだとレッテルを貼りたがる。その点については、昔っから気に入らなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230104,
					"content": "まあ、だからといって、教令院が君に指導者をやらせていい理由にはならないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230105,
					"content": "しかし、君にまだ最低限の自己認識が残っていたとはね、喜ばしい限りだよ。院内にいる連中の頭がもっと正常だったら、君なんかより、僕を賢者にするほうがいいって分かるはずだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230106,
					"content": "そして、君の賢者としての生涯がその掛け絵のようにぐらぐらと揺らぐものだと、人々に知らしめるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230107,
					"content": "もうじき辞めるやつがなに言ってんだか。何日かすれば、また資料の管理だろ。ふふん、ドン底の人生に逆戻りってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230108,
					"content": "ああ、教令院から支給される手当ては減らないそうだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230109,
					"content": "なんだって！？なんでだよ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230110,
					"content": "それに、建築や設計に携わる者と違って、依頼人の笑顔のためにクタクタになる必要もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230111,
					"content": "き、君ってやつは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230126,
					"content": "まったく、親切にリビングの掃除なんか手伝うんじゃなかったよ！こっちはまだ描き終わってない設計図があるってのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230112,
					"content": "そうだ、滞納している家賃も払ってもらおう。その金でいくつか家具を買うつもりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230113,
					"content": "な…どこまでも僕を怒らせたいようだね？言わせてもらうが、君の買った置物はどれも美的センスの欠片もないものばかりだ。乾いた木彫りを家に置くことにどんな意味がある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230114,
					"content": "金があるんだから、仕方ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230115,
					"content": "き、君ねえ…いつも自分の強みを他人と比べようとするが、それも一種の逃避だと思わないか？金のような低俗なものより、もっと価値のあるもので比べたらどうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230116,
					"content": "君が風上に立てるものがまるで思いつかない。君自身は思いつくか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230117,
					"content": "芸術性に決まってるだろ！君は室内の装飾についてまったくの無知なんだと何度言えば分かる！いいか、家具を適当に買うな、買いたければ僕を連れていけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230118,
					"content": "連れていったところで、今度は酒を奢るハメになるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230119,
					"content": "当然だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230120,
					"content": "なぜ俺がそんなことを？それは結局形を変えた借金だ。いずれ、君はそれを返さなければならないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230121,
					"content": "…借金を取り立てない、善良な人間になるのもいいと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230122,
					"content": "借金がないふりをするのは、他人の家に居候していないふりをするのと同じくらい滑稽なことだ。遅かれ早かれ、他の者に知れ渡るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230123,
					"content": "そ、その話だが…今日来たお友達は、そのことを誰にも言わないよな？君からも内緒にするよう言っておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 130230124,
					"content": "どうかな。とうの昔にバレていそうだし、殊更隠す必要もないんじゃないか。酒を数杯飲んだ程度で倒れるようじゃ、酒場に何度も通っているうちに自分から話しているだろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 130230125,
					"content": "嘘だろ？…いやいや、そんなハズが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーヴェ"
				}
			]
		}
	]
}