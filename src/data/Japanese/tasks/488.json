					"アーネスト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "こんなとこに荷物があったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4880102,
					"content": "た、助けに来てくれたのか？ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880103,
					"content": "長いことワイナリーで務めてきたが、ヒルチャールの強盗に遭うのは初めてだよ…はぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880104,
					"content": "もう少し来るのが遅れていたら、どうなっていたことやら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880105,
					"content": "#安心しろ！ヒルチャールなんかに{NICKNAME}は負けやしないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4880106,
					"content": "良かった。この<color=#00E1FFFF>運搬用の熱気球の護衛</color>はお前たちに任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880107,
					"content": "ヒルチャールの相手だけに集中するなよ。<color=#00E1FFFF>荷物の安全が最優先だ</color>。何かあったら、俺もお前も支払えるような額じゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880108,
					"content": "それじゃ頼んだ、俺はこの先で待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "アーネスト"
				}
			]
		},
		{
