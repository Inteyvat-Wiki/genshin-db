			"dialogs": [
				{
					"id": 4880301,
					"content": "ありがとう。もう半ば諦めてたんだ。お前がいてくれて助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880302
					],
					"speakerTitle": "アーネスト"
				},
				{
					"id": 4880302,
					"content": "ワイナリーの人たちにお前の評判を広めとくよ、じゃあな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーネスト"
