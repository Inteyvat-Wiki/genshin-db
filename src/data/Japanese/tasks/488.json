			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "リサさん、税収報告表を届けに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4880002,
					"content": "あらっ、可愛い子ちゃんじゃない。そうよ、ジンが倒れたって聞いたから、書類仕事はわたくしが引き受けたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 4880003,
					"content": "そうなのか。じゃあ、オイラに手伝えることはなさそうだな、じゃあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4880004,
					"content": "あっ、待って、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 4880005,
					"content": "私が言おう、リサさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4880006,
					"content": "先ほど、取引先から急な注文を受けたんだが、店内の在庫が足りてなくてな。実はワイナリーからの搬入が遅れているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4880007,
					"content": "よければ、<color=#00E1FFFF>荷物がどうなってるか</color>確認してきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4880008,
					"content": "えっと、そんなに緊急なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4880009,
					"content": "ああ、臨時の注文でね、出来れば急ぎたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4880010,
					"content": "それに何か問題があったんじゃないか、ちょっと心配でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 4880011,
					"content": "分かった、行ってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "じゃあ、今度何か奢って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "ハハッ、今度ディルック様がいらっしゃった時に、きっと何か奢ってくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 4880014,
					"content": "そう来なくちゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 48801,
			"completionStepIds": [
				48801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
