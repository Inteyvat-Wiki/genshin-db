			"dialogs": [
				{
					"id": 740540801,
					"content": "レバーを引いてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#うわーっ！{NICKNAME}、なにしてんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740540803,
					"content": "迷わずレバーを引いてみた。\\n次の瞬間、耳をつんざく雷のような音と共に、天地が裂けるかのように塔が激しく揺れ始めた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "そして、ボッという音がしてマシンがテープを吐き出し、あなたの手に落ちてきた。\\nその後、また静けさが戻ってきた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "こ…これだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740540806,
					"content": "うーん…なんて書いてあるのか全然理解できないけど、重要そうな感じはするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}、とりあえずこのテープは持っておこうぜ。あとで使えるかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
