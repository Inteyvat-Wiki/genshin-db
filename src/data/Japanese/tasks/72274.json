					"ファデュイ先遣隊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "まさか計画が漏れるとは、なんて運が悪いんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740202,
					"content": "先生は急にスネージナヤへ戻るよう命令されたが、やはり海祇島の計画は継続すべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740203,
					"content": "まったく、先生の独断がひどくないか？この任務のことだって、「召使」様には報告していなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740204,
					"content": "ああ、確かにな。これも先生個人の判断だ。チッ、嫌な予感がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740205,
					"content": "もし失敗したら、先生は俺たちに責任をなすり付けるつもりなんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファデュイ先遣隊"
				}
			]
		}
	]
