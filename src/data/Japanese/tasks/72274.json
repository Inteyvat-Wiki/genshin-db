			"trigger": {
				"objectNames": [
					"パイモン",
					"ファデュイ先遣隊",
					"浪人暗部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "この場所、なんだかヤバそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722740111,
					"content": "しー…耳を澄ましてみろ、誰か話してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722740101,
					"content": "チッ、口が堅い女だ。一言も話さないとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740102,
					"content": "拷問は得意だから、心配いらないっすよ。とりあえず休んでおいてください。あの女ならこの後なんとかしますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740103,
					"content": "はぁ、もう期限が迫っているというのに…あの女から計画を聞き出せと先生からのお達しだ。もし聞き出すことができなかったら、俺たちまで痛い目に遭うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740104,
					"content": "あの方、沸点が低いですからね。あの女、いったい何をやらかしたんすかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740105,
					"content": "ああ、先生の計画にはリュドヒカという駒が必要なんだが、この終末番の女が始末しやがったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740106,
					"content": "幸い、駆けつけた時にはまだ灰になっていない部分も残っていた。さすが先生だ、服だけでそれがリュドヒカだと分かり、計画が危ういと判断したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740107,
					"content": "それは不幸中の幸いでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "浪人暗部"
				},
				{
					"id": 722740108,
					"content": "しかし、あの女がどこまで計画を知っているのかは分からない。終末番の人間に知らせたかどうかも不明だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "ファデュイ先遣隊"
				},
				{
					"id": 722740109,
					"content": "百代さんは地下の牢屋に閉じ込められてるみたいだ。早く彼女を助けに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7227402,
			"completionStepIds": [
				7227402
