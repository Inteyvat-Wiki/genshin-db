				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#ここはアランヤマたちのようにマラーナの侵蝕を受けていないみたい、本当によかった。ナラ{NICKNAME}、パイモン、これがアシュヴァッタの樹だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350202,
					"content": "うわ——なんかヘンな木だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350203,
					"content": "パイモン、失礼だぞ！アシュヴァッタの樹が怒る。これはとてもとてもすごい木で、ヴァサラの樹の最長老なんだ。すべてのアランナラ、すべてのアランナラの物語よりも古くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350604,
					"content": "数千か、もっとたくさんの月の前、すべての草木を支配する神がここで歌を口にした。そのときカノジョはワルカを離れたばかりで、森林は今みたいに茂ってなくて、地面にはたくさんの砂があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350605
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350205,
					"content": "カノジョのアランラカラリはすべてのアランナラより強かった。なぜなら、カノジョの歌は「起源の歌」に近かったから。そしてカノジョの呼びかけに応えたアシュヴァッタの樹は、サルバの中からすくすくと生えてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350606,
					"content": "カノジョはアシュヴァッタの樹に言った。森にはナラがたくさんいる。カレらは頭が良く美しいが、孤独だ。だから森の民たちを増やして、カレらと友達にならなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350607
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350207,
					"content": "そこで、アシュヴァッタの樹はきれいでふっくらしたザクロを生み出した。ザクロの中にはたくさんの種があって、その中のひとつが育ったのがアランムフクンダだったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350208,
					"content": "だから、アランムフクンダは一番最初のアランナラなんだ。その後、種たちはどれも大きく育ち、アランナラは大樹の葉のように増えた。ボクらとナラは、同じ森の民だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350609,
					"content": "だからアシュヴァッタの樹はすごくて、とても大切なもの！ナラがナラの子供を産むように、すべてのアランナラはアシュヴァッタの樹の子供であり、草神の子供だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350610
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350210,
					"content": "そうだったんだな…悪かったよ、アランマ。アシュヴァッタの樹はすごいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350211,
					"content": "パイモンがママを悪く言ってごめんね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350213,
					"content": "ビージャの実について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350214
					]
				},
				{
					"id": 730350212,
					"content": "そんなつもりじゃなかったんだよ！コホン、とにかく、ビージャの実はどうすれば手に入るんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350214,
					"content": "うん。土と雨が大樹の葉を茂らせ、花を咲かせ、実をつけさせるように、夢と記憶をヴァサラの樹に捧げなければならない。いま言った通り、アシュヴァッタの樹は一番古いヴァサラの樹なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350215,
					"content": "だからボクらはアランジ、アランヤマ、アランマハのヴァソマの実を取ってきて、アシュヴァッタの樹に捧げる。そうすれば、アシュヴァッタの樹は力を蓄え、偉大な実をつけられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350216,
					"content": "アランジ、アランヤマ、アランマハのヴァソマの実？ヴァサラの樹のじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350217,
					"content": "うん、ヴァサラの樹のだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350218,
					"content": "#ナラ{NICKNAME}、ちょっとアシュヴァッタの樹に近づいてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350219,
					"content": "わあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350220,
					"content": "不思議だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350221,
					"content": "奇妙だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "うん。すべてのアランナラはこの樹の子供。アナタは今、すべてのアランナラとつながって、すべてのアランナラの祝福を受けている。だから、アシュヴァッタの樹もアナタを祝福している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350223,
					"content": "アナタが花冠を被っている限り、アシュヴァッタの樹はアナタを森の子供と認める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350224,
					"content": "ん…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350225,
					"content": "アシュヴァッタの樹の調子がちょっとおかしい…少し弱ってる。最近、ここまで広がってきたマラーナと関係してるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350226,
					"content": "よし。とにかくアシュヴァッタの樹の夢に入って、夢の樹にヴァソマの実を捧げよう。そうすれば調子も戻るはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350227,
					"content": "#この前、アシュヴァッタ堂でやったのと同じ感じか？{NICKNAME}が手を伸ばしたら、オイラごと「ヒュヒューン」って不思議な夢の中に着くやつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350228,
					"content": "#そう！パイモンはかしこいね。ナラ{NICKNAME}、準備ができたら、前みたいに手を伸ばしてアシュヴァッタの樹の夢に入って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350229,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350234,
					"content": "ちょっと準備する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350230,
					"content": "#さっきアランマもマラーナのことを言ってたけど、夢の中ではなにが起こるか分からない！でも、{NICKNAME}がいればきっと問題ないはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350231,
					"content": "（アシュヴァッタの樹に手を伸ばす…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "もうちょっと準備する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "うん。準備ができたら教えて。ボクもアナタたちと一緒に行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350235,
					"content": "うん。準備ができたら教えて。ボクもアナタたちと一緒に行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				}
			]
		},
