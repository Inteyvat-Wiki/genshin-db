					"パイモン",
					"アランマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "やっと解決か…そういえば、前にヴァサラの樹の夢の中でも、この不思議な樹を見たよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350902,
					"content": "#ごめん、ナラ{NICKNAME}。ごめん、パイモン。まったく気づかなかった。アシュヴァッタの樹の夢がすでにマラーナに侵蝕されていたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350903,
					"content": "無数の黒い虫が、サルバ中の夢の樹の根を侵蝕している。たとえ夢の中でも、マラーナの手がこの夢を揺らしているのを感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350904,
					"content": "ごめんね…前にアシュヴァッタ堂でマラーナを見た時から、ボクは知っていたはずなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350905,
					"content": "#大丈夫！それにほら、{NICKNAME}があっという間に解決してくれただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350906,
					"content": "じゃあ、ビージャの実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#ヴァソマの実があれば、多少はカレの力を回復できると思う。ナラ{NICKNAME}、頼んだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350913,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350914,
					"content": "うん、分かった。こんなに早くなるとは思わなかったけど、何が正しいか、何をすべきかは分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350915,
					"content": "雲が雨を降らせ、雨が大地に染み込むのが分かるように。種が芽を出し、大樹になり、たわわに実をつけるのが分かるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350916,
					"content": "アランマの様子がおかしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350917,
					"content": "うん、夢の樹と話してた。アナタたちには聞こえなかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350918,
					"content": "前にアランナキンがキノコと話してるのは見たけど…普通、人間は植物と話せないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350919,
					"content": "そうだったの！また新しい知識を学んだ。ありがとうパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350920,
					"content": "#ビージャの実のことなら安心して、ナラ{NICKNAME}、パイモン。まずはこの夢から出よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350907,
					"content": "お安い御用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "うーん…でも、これってビージャの実に影響がありそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350909,
					"content": "パイモンが言うほど楽じゃないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "とにかく、おまえのおかげで解決したのは間違いないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350911,
					"content": "うーん…でも、これってビージャの実に影響がありそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "パイモン"
				}
			]
		}
