			"dialogs": [
				{
					"id": 730350401,
					"content": "アシュヴァッタの樹の真ん中が光ってる…あれがビージャの実か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350402,
					"content": "やれやれ、大変だった。これでやっとラナを元に戻せるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350404,
					"content": "あれ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350405,
					"content": "アランマ、いったい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350408,
					"content": "アシュヴァッタの樹はもうマラーナに侵蝕されて、ビージャの実をつけることはできない。だから、ボクが新しいアシュヴァッタの樹を植えてアナタたちを助ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350409,
					"content": "でも…植えてから長い長い時間がかかるんだろう？種から大樹になるまでなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350410,
					"content": "安心して。ヴァサラの樹の成長速度は種によるんだ。アシュヴァッタの樹はすべての力をボクに委ねてくれた。それにヴァソマの実とボクらみんなの記憶を加えれば問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350411,
					"content": "ありがとう、最初のアシュヴァッタの樹。ありがとう、アランジ、アランヤマ、アランマハ、ボクはアナタたちの残した記憶を使って、新しいアシュヴァッタの樹を夢の道に再接続させる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350412,
					"content": "なんだか、アランマの感じが変わったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730350413,
					"content": "そうかな？ボクは多くの物事を知り、多くの言葉を学び、多くの記憶を得た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350414,
					"content": "でも、心配しないで。ボクはボク、アナタたちはボクの親友だ。ボクはきっとアナタたちを助ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350415,
					"content": "じゃあ、ビージャの実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "アシュヴァッタ神殿の奥深くに封印されているかつてのヴァナラーナ、マラーナの化身はその中にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350420,
					"content": "それは絶えず大地に、サルバに向けて蛇の毒を注ぎ続けている。すべての緑が枯れ、すべての花が散り、川の水が腐った匂いに染まるまで。すべての命が死に至るまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350421,
					"content": "ボクたちはそれを破壊しなければならない。そうしなければ、強い木を育て、ビージャの実を実らせることはできないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350416,
					"content": "うん、信じるよ、次は何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#ナラ{NICKNAME}が分かってくれてよかった。それなら何の問題もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730350406,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
		},
