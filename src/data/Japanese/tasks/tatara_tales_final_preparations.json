					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "よし！前回のテストは問題なかった、「オニカブトムシ」に付いた「祟り神」のエネルギーが綺麗に浄化された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200102,
					"content": "なら今から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "次は進むべきルートを確認すれば、正式に開始できる。でもファデュイたちを避けないと…遠回りする必要があるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200104,
					"content": "この機械…結構デカくてな、二人でこれを中に持ち運ぶには、運送ルートを確かめる必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200105,
					"content": "だから、もう一度「御影炉心」の近くを調べてほしい。もし通れないような道があるなら、少し舗装してくれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200106,
					"content": "ルートの計画はまだだが…ほとんどの道はスムーズに進めることを確かめた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200107,
					"content": "道を舗装したことなんてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "ちゃんと舗装する必要はない…上に木の板を置いて、俺たちがこれを持ち運べれば大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200109,
					"content": "あっ、この辺の木の板を持ってくといい。俺はここでこの機械の耐久度を上げてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
