			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "どうだ？道を全部確認したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200302,
					"content": "問題なく進める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "よし。じゃ、じゃあしばらくしたら出発する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}はどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "俺は、考えているのだ！様々な状況を考えている、分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200306,
					"content": "例えば入った時に、核心がすでにあの狂ったヤツらによって取り出されてたらどうする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200307,
					"content": "そして、ヤツらは核心を遺跡守衛の中へ入れ、そいつが制御不能になり、俺たちを全員吹っ飛ばすんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200308,
					"content": "あるいは、「御影炉心」を浄化する時、突然何かの元素生物が飛び出し、核心を一気に呑み込むとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200309,
					"content": "さ、最悪なのは、あの伝説の大蛇が復活した場合だ。そうなったら本当におしまいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200310,
					"content": "落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "ぐっ…す、すまない。また悪い癖が出てしまった。いつも物事を悪く考えてしまうのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200313,
					"content": "きちんと計画を立てる。時が来たら、この件を解決しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200314,
					"content": "上手くいくように、上手くいくように、上手くいくように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721200311,
					"content": "そんな大げさなことには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
