			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "へへっ、水槽を飾り付けるのって、すっごく面白いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000102,
					"content": "サンドローネも気にしてないみたいだし、もっと色々獲ってきて、ここを綺麗にしてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000103,
					"content": "ちょっと、こっちに来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000104,
					"content": "えっ？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000105,
					"content": "これ、アナタたちにあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000106,
					"content": "これは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000107,
					"content": "アナタたちのために改良した、水中探査補助装置よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000108,
					"content": "ええっ！？ありがとな、サンドローネ！おまえって本当にいいやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000109,
					"content": "ちょっとした機械装置よ、たいしたことじゃないわ。この前アナタたちが魚を捕っていたのを見たけど、なんと言うか…とても原始的で…見ていられなかったのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000110,
					"content": "そ…そんなにひどかったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747000111,
					"content": "効率が悪くて、技術の欠片も感じられなかったわ。おまけにちっとも優雅じゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000112,
					"content": "恥ずかしいところを見せちゃったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "アナタたちにはアナタたちなりの習慣があるでしょうから、多くは言わないでおくわ。でも、引き続きこのアクアリウムを飾りたいというのなら、持っていくことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000114,
					"content": "フォンテーヌの水中には、穏やかで綺麗な小魚だけじゃなく、攻撃的で危険なのもたくさんいるのよ。これはアナタたちの成功のためでもあり、安全のためでもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000115,
					"content": "本当にありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "ふん、もういいわ。さっさと行きなさい。戻ってきたら、どうだったか教えてちょうだい。フィードバックをもとに調整してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747000116,
					"content": "持っていくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}