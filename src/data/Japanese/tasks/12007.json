			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "どうだ？仙人が残した財宝とかあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070202,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070203,
					"content": "うーん…本みたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070204,
					"content": "どうやら、これも手記のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070205,
					"content": "もしかすると「椿」さんの手記でしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070206,
					"content": "皆さん、一度外に出ましょう。ここの雰囲気は思っていたものとは少し違っていました。なぜかは分かりませんが…この手記をここで開けたくはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070207,
					"content": "そうだな。暗い場所で文字を読むと目にも悪いからな。外に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
							"2"
						],
						"stepId": 1200707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "ここなら大丈夫でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070302,
					"content": "はやく中になにが書いてあるのか見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070303,
					"content": "はあ～貴重なお宝だったりして？楽しみだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070304,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "どうした？いきなりそんな小声で話しかけるなんて、オイラを緊張させるなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070306,
					"content": "少し離れよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070308,
					"content": "綾華が手記を見るのを邪魔したくなかったんだな。あの手記、本当になにかあるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070309,
					"content": "でも綾華の表情を見るに…お宝じゃなさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070310,
					"content": "うーん、いったいなんなんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070311,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070312,
					"content": "ふぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070313,
					"content": "旅人さん、パイモンさん、大変お待たせしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070314,
					"content": "全然待ってないぞ、読むのが早すぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070315,
					"content": "手記は読み終わったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "はい、すべて読み終えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070317,
					"content": "この手記に書かれた真実は、貴方がたにも共有すべきものだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070318,
					"content": "内容は、思っていたものとはまったく違っていましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070319,
					"content": "違う？狐神使の手記じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070320,
					"content": "狐神使ではございませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070321,
					"content": "「椿」さんの正体は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070322,
					"content": "私のお母様でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070323,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070324,
					"content": "驚きますよね…私もです…しかし、この手記の最初にはこう書かれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070325,
					"content": "「椿は普段の私と同じでありながら異なる存在。私が椿である時だけ、神里華代ではなくただの平凡な女の子になれる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070326,
					"content": "「以下のすべては、椿としての私の生活を記録しただけのもの。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070327,
					"content": "手記の中に書かれていたのは、お母様が日常で経験した出来事や考えでした…私たちが「椿」だと思っていた女性も、お母様の考えでしかなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070328,
					"content": "それって、服の裁断図も異国料理も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070329,
					"content": "はい、すべて私のお母様が試したかったことのようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070330,
					"content": "貴方がたにとっては不思議に思うかもしれません。しかし私からすれば、お母様のこのような振る舞いはよく理解できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070331,
					"content": "それどころか、実は…私もそのような一面を持っているのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070332,
					"content": "手記を読んだ時、自分の考えがすべて人に見透かされているのではないかと思うほど、そこには私と同じ気持ちが書いてあり、あっけにとられてしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070333,
					"content": "綾華…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070334,
					"content": "お母様がお父様に嫁いでから、ずっと神里家の主母としてすべての事務を担当してきました。高貴な身分である社奉行では、管理すべき点が多々あったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070335,
					"content": "それだけでなく、お母様の一言一行は神里家を代表していました。人々から常に注目を浴びせられていたと思います。そのような状況の中、自分のやりたいことをする時間もなかったはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070336,
					"content": "両親が亡くなった後、お兄様と私は神里家のすべてを引き継ぎました。その中で遭遇した数々の困難は、他の方には想像できないかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070337,
					"content": "私が面倒事に遭った時、いつもこう思うのです——お母様も以前このようなことを経験したのでしょうか？お母様ならこのことをどう対処したのだろうかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070338,
					"content": "お母様と離れ、長い時間が経ったからかもしれません。私の記憶に残っているお母様は、威厳ある高貴な一面だけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070339,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "しかし…これはいけないことなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070341,
					"content": "この手記を読んだ時、気付きました…お母様も私と同じように、どれほど大きな責任を背負っていても、結局はただの人であると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070342,
					"content": "綺麗なお着物を好み、各地の美食を食べ、見たこともない美しい風景を見る…それらに憧れていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070343,
					"content": "もしかすると、貴方がたはそのようなことを稚拙に思うかもしれません。しかし…私はたしかにそのような考えを持っています。神里綾華としてではなく、普通の女の子として生きるという想いを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070344,
					"content": "お母様が書いていました、稲妻の民たちの間で行われるお祭りにずっと参加したかったと。天気のいい夜に家から遠くを眺めると、たまにお祭りの灯りが見えると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070345,
					"content": "私も見たことがあります！夜空を照らす灯りが…とても綺麗なんです…とても賑やかで、そこの治安を心配するほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070346,
					"content": "しかし、私たちの立場では、やみくもにお祭りに参加することはできません。特に両親がいた時代は、社奉行と人々の関係はそれほど親しいものではありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070347,
					"content": "私たちを止める人がいなくとも、突然社奉行の人間が群衆の中に現れれば、皆さんに注目されることでしょう。いったいこれから何が始まるのかと思うはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070348,
					"content": "お母様は人々がそうしてかしこまるのを嫌っていました。皆さんにお祭りの楽しさと自由を味わってもらえることを望んでいたのです…人々の邪魔をしたくない上に、あまり余暇もない方でした。そのため、一度もお祭りに行ったことがなかったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070349,
					"content": "そうだったのか…じゃあ、あの裁断図に描いてあった服って、祭りに行く時に着る服だったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070350,
					"content": "はい。お祭りでは異国からの料理も売られることがあったので、それも味わってみたかったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070351,
					"content": "こういうことを言うのは少々相応しくないかもしれませんが…お母様も意外と乙女な一面を持っていたのですね。うふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070352,
					"content": "相応しくないなんてことないぞ！おまえのお母さんは、かわいくて責任感のある人だとオイラは思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070353,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070354,
					"content": "知らず知らずのうちに、私がお母様の代わりに願いを叶えていたのですね。しかしお祭りに行くことだけは、私もできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070355,
					"content": "どうやら…お母様のためにそれを行う機会もないようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070356,
					"content": "もう十分やったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "はい、分かっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070359,
					"content": "…ありがとうございます。この一件で、私もいくつかのことに気付けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070360,
					"content": "お母様と私、色々と通ずる点があるようです。お母様が直面したことは、私も同じく向き合うべきこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070361,
					"content": "お母様は実現できない願いを「椿」に託した…私…決めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070362,
					"content": "えっ！まさかおまえも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070363,
					"content": "いえ、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070364,
					"content": "この方法を使うつもりはございません。ただ…新しい目標ができました。悔いのない毎日を送りたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070365,
					"content": "その…旅人さん、私…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070366,
					"content": "ふぅ…落ち着いて、気をしっかりと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070367,
					"content": "私たちのお祭りに興味はございますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070368,
					"content": "告知を見た時からずっと行きたかったんだ！綾華も興味あるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070369,
					"content": "綾華も祭りに行ったことないんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "はい、あの…笑わないでくださいね。私も…昔、同じような悩みを抱えていたんです…しかし、今はもう吹っ切れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070371,
					"content": "私は自分の願いを叶えるために、心に忠実に生きようと思います。貴方でしたら、きっと私のわがままを責めることはないですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070372,
					"content": "その…私と一緒に…お祭りに行ってくれませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070373,
					"content": "よろこんで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "行く行く！祭りって美味いもんがたくさんあるだろ？それと楽しい遊びもな、へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070375,
					"content": "…よかった、お二方、感謝します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070376,
					"content": "今から行けば、まだ間に合うかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070377,
					"content": "そうだな、今日は最終日だったよな？じゃあ、さっそく行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070357,
					"content": "綾華のせいじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}