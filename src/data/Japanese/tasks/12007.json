			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "ここが貴人の住む場所か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070102,
					"content": "うーん…なんだか肌寒い感じがするぞ…本当にここに人が住んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070103,
					"content": "わ、私も少し意外に思っています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070104,
					"content": "おかしいですね。手記によるとここで間違いないようですが、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070105,
					"content": "間違えたのかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "うぅ…少々不安になってまいりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070108,
					"content": "しかし、ここまで来たのですから、やはり入って確かめた方がいいですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070109,
					"content": "おう、そうだな。もしかしたら、お宝があるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070110,
					"content": "そうだ、手記にはなんて書いてあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070111,
					"content": "そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070112,
					"content": "「鶴は髪を飾るための花を<color=#00E1FFFF>1</color>輪運び、白兎は<color=#00E1FFFF>4</color>つの月光を袴に縫い上げた。きちんと着飾り、私は<color=#00E1FFFF>東へ向かって</color>椿の名を<color=#00E1FFFF>7</color>回呼んだ。すると、瞬く間に彼女の家に通ずる道に私は立っていた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070113,
					"content": "童話みたいなお話だな…おまえのお母さんはそうやって「椿」の家に行ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070114,
					"content": "ますます仙人っぽくなってきたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "なんだか、ある種の謎かけのような気がします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070116,
					"content": "もう少し近づいてから判断しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120070117,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120070106,
					"content": "もしかしたら狐神使？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
