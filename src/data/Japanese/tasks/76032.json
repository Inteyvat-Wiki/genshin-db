					],
					"speakerTitle": "怪しい人"
				},
				{
					"id": 760320204,
					"content": "冗談じゃない。<color=#00E1FFFF>お宝を狙うネズミ</color>は一匹たりとも逃さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
