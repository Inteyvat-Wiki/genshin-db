			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "どうだった？スパイクは期待通り機能したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280302,
					"content": "異常なし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "すべて正常なら安心だ。この後も故障しないことを祈る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280304,
					"content": "特異体がもし現れたら、近くのスパイクを起動することで、エネルギー供給が遮断されるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280305,
					"content": "今度こそ倒せるはずだ、頑張ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280306,
					"content": "君の実力を信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				}
			]
		}
	]
}