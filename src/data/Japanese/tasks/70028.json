			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "君のテストデータのおかげで、「プルシナスパイク」の調整は順調に終わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280102,
					"content": "きっと期待通りの効果を発揮してくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280103,
					"content": "特異体がよく現れる場所に「プルシナスパイク」を設置すれば、そのエネルギー供給を制御できるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280104,
					"content": "プルシナスパイクが起動すれば、特異体の自己修復機能は停止するはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280105,
					"content": "手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "いや、私に感謝するのではなく、先人たちと彼らの残した知恵に感謝してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280109,
					"content": "先輩たちの知恵の導きがなければ、あの特異体を抑えることはできなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280110,
					"content": "私たちの今までの成果は、それらの知識の導きによるもだ。知識こそが世界で最も貴重な資源だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280111,
					"content": "なんだか難しそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "君が基本道理を理解できないのも当然のこと。君はまだ至高の知恵を心得ていないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280113,
					"content": "やっとのことで「プルシナスパイク」を修理できた。ははっ、さっきは少し興奮して、話が脱線してしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280114,
					"content": "さて、いよいよ最終準備に入る。つまり、「プルシナスパイク」を鶴観に設置すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280115,
					"content": "すまないが、この件に関しては力になれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280116,
					"content": "稲妻の規定によると、私みたいな滞在手続が終わっていない者は自由に行動できない。この後は全部君に任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280117,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "頼んだぞ。スパイクを設置した後、すぐには行動しない方がいい。正常に機能しているか速やかに確認してから、私に教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280119,
					"content": "安全のためにも、慎重に行動しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700280107,
					"content": "科学の力に感謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "いや、それよりも先輩たちと彼らの残した知恵に感謝してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "ホッセイニ"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002803",
							"2"
						],
						"stepId": 7002803,
						"stateName": "QUEST_STATE_UNFINISHED"
