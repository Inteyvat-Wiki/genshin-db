			"completionStepIds": [
				7369301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369301",
							"2"
						],
						"stepId": 7369301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バハドル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736930101,
					"content": "はあ、なんで俺がこんなことやんなきゃいけないんだ？もっと経験豊富な先輩たちに任せておけばいいだろうに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930102
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930102,
					"content": "あれ？ここもイベントをやってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930103
					]
				},
				{
					"id": 736930103,
					"content": "おぉ、旅人か！えーと…そうだな。イベントは…その…ああ、やってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930104
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930104,
					"content": "まあ、イベントというよりか…探索待ちの秘境、って感じだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930105
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930105,
					"content": "その秘境と学院フェスは関係ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930106
					]
				},
				{
					"id": 736930106,
					"content": "はぁ、その教令院主催の学院フェスとやらのために、俺はこんなことを任されちまったわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930107
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930107,
					"content": "っと、自己紹介が遅くなったな。俺はスパンタマッド学院所属のバハドルだ。俺たちの学院では、錬金術とか元素とか、そういうのを研究してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930108
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930108,
					"content": "とにかく、今回はこんなことを任されちまったわけだが…スパンタマッド学院として出せるミニゲームなんて、どう考えてもピンとこなくてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930109
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930109,
					"content": "例えば錬金台を置いて、錬金術の体験をさせるとか？そんなのどう考えてもつまらないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930110
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930110,
					"content": "かといって…元素反応を展示するとかも無理だしな。万が一事故でも起こって、会場が大爆発したら一大事だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930111
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930111,
					"content": "仕方ないから、冒険者協会に相談したんだ。そして彼らの協力のもと、秘境を見つけたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930112
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930112,
					"content": "仲間たちと秘境の下見をしてみたが、内部は正直、かなり入り組んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930113
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930113,
					"content": "だから秘境の特殊な状況に対応できるよう、仲間たちと一緒に錬金薬剤を何種類か開発したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930114
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930114,
					"content": "これでひとまず、我が学院らしいところは体現できたわけだ。ハハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930115
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930115,
					"content": "旅人、もし興味があるなら、この薬剤を持って秘境に行ってみるといい。秘境の場所は後で<color=#00E1FFFF>マップ</color>に記してやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930116,
						736930117
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930116,
					"content": "誰か…遊びに来る人はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930117,
					"content": "#{M#俺}{F#私}の他に、遊びに来る人はいるかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930118,
					"content": "ほ、他にもだな、秘境に興味があって挑む冒険者たちが結構いるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930119
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930119,
					"content": "確かに、学院の学生はあまり来ないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930120
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930120,
					"content": "ま、とにかくだ、興味があれば秘境に行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930121
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930121,
					"content": "冒険者たちの話だと、あの秘境はかなり「チャレンジング」だとさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930122,
						736930124
					],
					"speakerTitle": "バハドル"
				},
				{
					"id": 736930126,
					"content": "そうだ、もし秘境に行くならこの特別な薬剤をやるよ…とにかく、探索する時は安全に十分気をつけるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バハドル"
				}
			]
		}
	]
}