						760150209
					],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150209,
					"content": "「私はリュートを引き、君たちは微笑む。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "「みんなで楽しくダンス！ハイッ！ハイッ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150211,
					"content": "「みんなで集まって、ダンス、ダンス！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "おお、そうそう、まさにそれだよ。すぐに慣れたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150213,
					"content": "オレの名前は███。これでオレたちは知り合いだ。椅子は好きに座ってくれ。オレは別にケチじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150214,
					"content": "オマエもライトキーパーだよな。この酒はオレからのおごりだ。訓練の時に、もしかしたら会えるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150215,
					"content": "感謝します。それは飲めませんが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "それじゃ、夜のパトロールに行ってくる。またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大声の亡霊"
				},
				{
					"id": 760150216,
					"content": "初めまして、フリンズです。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "もし僕がここに座りたいと言ったら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
