			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クリマナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "十、二十…これだけ売れたらしばらく資金には困らずに済みそうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940502,
					"content": "もう少し稼いでおかなくていいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "ふふっ、もう十分よ。欲張らずにここでやめておくわ！もしあなたがあの時手を貸してくれなかったら、あの玉帛のせいで確実にトラブルに巻き込まれてたでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940504,
					"content": "それに、毎日お金のことばかり考えてるのも退屈でしょ？私にとって商売はただの趣味、本当に大事なのは火山の観測だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940505,
					"content": "お金は稼げば済む話だけど、私がもし火山噴火の予兆を見逃したりしたら…それこそ取り返しがつかなくなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940506,
					"content": "「談議室」から経費は出ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "申請なんてしてないわよ。「談議室」の族長たちも常にいろんな問題に悩まされてるからね…これ以上負担を増やすわけにはいかないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940508,
					"content": "それに、彼らと私たちはちょっと違うから。普段から旅をしながら自分たちで稼いでる分、こういう生活にも慣れっこだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940509,
					"content": "旅のついでに火山を観察するくらい、別に大したことじゃないわ。あなたたちが困ってる人を見かけたら助けてるのと同じで、気楽なものよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940510,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "ふふ、またね！縁があったらまたどこかで会いましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリマナ"
				}
			]
		},
