			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クリマナ",
					"パイモン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "ちょっと、ちょっと待ちなさい！これは商品よ、買わないなら触らないで！…あら？そこの金髪のあなた、そう、あなたよ。そんなに急いでどこへ行くの？ちょっと顔を見せなさいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940102,
					"content": "ふむ——やっぱりね。太陽みたいに輝く髪、夜神の国を思わせる深い瞳…これは予想じゃなくて確信よ。あなた、将来すごい人物になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940103,
					"content": "見て、ちょうどいいものがあるの。はい、特別な翡翠をあしらった装飾品よ。この中には様々な旋律が宿ってて、大英雄のあなたにぴったりだと思うわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940104,
					"content": "ただ、これはとんでもないお宝だから、普通の人が買いに来たら最低でも一千万モラはもらうわ。でも、あなたとこの飾りには縁を感じるの…だから、特別に九割引きにしてあげる！どう？悪い話じゃないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940105,
					"content": "えっ、九割引き！？めちゃめちゃお得じゃないか！でも待てよ…それでも百万モラもするぞ！高すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751940106,
					"content": "はぁ、仕方ないでしょ…これでも経費ギリギリなんだから。私たちみたいなしがない商人は楽じゃないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940107,
					"content": "だからってそんな稼ぎ方はダメだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "あら、聞かれてたのね。あはは…もう、私ったらつい独り言が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940110,
					"content": "はぁ——この際だから正直に話すわ。この玉帛、実は拾ったものなの。だから、そんなに高い値がついてたわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940111,
					"content": "でも、どうしようもないのよ。見ての通りうちは資金不足で、浮標のデータ回収員すら雇えないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940112,
					"content": "じゃあ、データなんか回収しなきゃいいだろ！人を騙すよりマシだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751940113,
					"content": "それはダメよ…普通の組織なら活動を休止すればいいだけだけど、私たちのボランティア活動には火山観測の任務も入ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940114,
					"content": "浮標を設置したのも、水温データなんかを集めて火山の活動を監視するためなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940115,
					"content": "それに、今は火山の活動がどんどん活発になってきてるから、急いで浮標を回収しないと大変なことになるかもしれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940116,
					"content": "私がケガさえしなければ、浮標を壊すことなく、中のデータもちゃんと回収できたはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940117,
					"content": "#なぁ{NICKNAME}、オイラたち、手伝ってあげたほうがいいんじゃないか…？火山の問題はみんなの安全にも関わるし、見て見ぬふりはできないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751940118,
					"content": "ほ、ホント！？もしあなたたちが手伝ってくれるなら、この玉帛はタダであげるわ！報酬として受け取ってちょうだい。それでどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940119,
					"content": "百万って言ってたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "心配しないで。あまり多くはないけど、玉帛のほかにも何か用意するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940122,
					"content": "へへっ、玉帛だけで十分だぜ！火山周辺のみんなを守ることが最優先だからな！とにかく、安心して任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751940123,
					"content": "さっそく始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "もうちょっと準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "ええ、こっちはいつでもOKよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940120,
					"content": "え…玉帛だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "百万モラはボッタクリじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
