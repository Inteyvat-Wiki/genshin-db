			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クリマナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "ふぅ…よかった。結果を見る限り、火山の状態は思ったより深刻じゃなかったみたい。これでみんなも安心して眠りにつけるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940402,
					"content": "これもあなたたちが前のことを水に流して助けてくれたおかげね。じゃなかったらここまでスムーズにはいかなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940403,
					"content": "どうかこの報酬を受け取ってちょうだい。これは私個人のお詫びと感謝の気持ちよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940404,
					"content": "へへっ、おまえがそう言うなら、遠慮なく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "まだ手元に売れ残りの商品があるから、それをうまく捌けば資金のほうもなんとかなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "クリマナ"
				},
				{
					"id": 751940407,
					"content": "もちろん、今回は緊急事態じゃないから、ちゃんと誠実に商売するわよ。安心してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリマナ"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
