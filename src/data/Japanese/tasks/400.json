				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "ボクに聞きたいことがあったら、今聞いておくれ。ボクは吟遊詩人だからね、ずっと同じ場所には留まらないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960702,
					"content": "トワリンについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "トワリン…彼は最後まで「四風守護」としての責任を忘れなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960704,
					"content": "だからボクは、彼からその責任を取っ払って、そしてボクの考える「自由」を彼に押し付けたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960705,
					"content": "——トワリン自身に、自由の意味を理解して、選んでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960706,
					"content": "だってボクも神になる前は、こうしてある友人に…「自由の意味」を教わったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960707,
					"content": "アビス教団について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "うん？ガイアが言った情報か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960709,
					"content": "#…なるほど、アビス教団の「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」という人が、トワリンの腐食を計画したんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960710,
					"content": "#トワリンをアビス教団の戦いの道具にするつもりだったのかな。でも、アビス教団に「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」がいるなんて聞いたことがないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960711,
					"content": "教団の古参じゃないみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "ボクもそうだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960714,
					"content": "#でも、その最近になって出てきた「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」は、どうやってアビス教団を率いるポジションにまで上り詰めたんだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960712,
					"content": "教団の新入りなのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "「淑女」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "さっきのファデュイの執行官、「神の心」を手に入れたらすぐに撤退したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960717,
					"content": "それは「騎士団の目撃者」を作らないためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960718,
					"content": "だってこんなことをして証拠でも残してしまったら、西風騎士団との外交関係を断絶したと宣言したも同然だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960719,
					"content": "こんなことをしたくせに、よくもモンドの盟友を続けてられるよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960720,
					"content": "はぁ…アビス教団の脅威に対抗するために、七国の人々は同盟を結ぶべきだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960721,
					"content": "「ファデュイ」は七国最強を誇る武力を持っている、それを天空のライアーの窃盗、神の力の強奪に使って、龍災に乗じて騎士団に圧をかけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960722,
					"content": "あっ、「天空のライアー」といえば…あの時、ディルックの旦那もその名前を口にしてた気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960723,
					"content": "「ファデュイ」が七国を闊歩し、西風騎士団の脅威となったのは、この11人の執行官が原因だ、って言ったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960724,
					"content": "そう、さっきボクが言ったように彼らは氷の神から権力を授かり、普通の人間を遥かに凌駕する力を手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960725,
					"content": "「氷の女皇」…もう500年も会っていないな。彼女は一体何を考え、そして何を企んでいるのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960726,
					"content": "今回の件の真相は、君の七神を探す旅に、未知の影響を与えるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960727,
					"content": "神について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "さっきも言ったように、「神の目」の所有者は、この世界で「原神」と呼ばれ、天空の島に登る資格がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960729,
					"content": "「神の心」はより上位の元素制御中枢で、七神の座を象徴するものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960730,
					"content": "#ごめんね、ボクも七神のうちの誰が君の{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}をさらったか知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960731,
					"content": "あっ、そういえば、ボクも七神の一柱として、まだ自分の容疑を晴らせていない…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960732,
					"content": "ウェンティはあの神と全然違うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "でも、「吟遊野郎」の姿は一つの化身だし、見た目で判断しちゃだめだぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960734,
					"content": "長い付き合いだから、疑う必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#あははっ、確かにボクたちいいコンビだったね。そうだ、君が{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}を見つけたら、新しい「四風守護」になってみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960736,
					"content": "それは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#うん？{NICKNAME}、なんだか興味がないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960738,
					"content": "吟遊野郎！「四風守護」になれば、人から美味いお供え物が貰えるって言うなら…オイラがやってもいいぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960739,
					"content": "あっははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960741,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "じゃあ、早く<color=#00E1FFFF>璃月</color>に行くといい。今年の「迎仙儀式」を見逃したら、また1年待つことになるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		}
	]
}