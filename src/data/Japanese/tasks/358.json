		{
			"id": 35801,
			"completionStepIds": [
				35802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35802",
							"2"
						],
						"stepId": 35802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "…と、ここまでの経緯はこんな感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3580102,
					"content": "なるほど。モンドへようこそ、風と共に訪れし旅人よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580103,
					"content": "私は代理団長のジン。こちらはリサ、騎士団の図書館司書だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580104,
					"content": "あら、人手不足を手伝いに来た良い子ちゃんかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580105,
					"content": "かわいいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580106,
					"content": "ただ、タイミングがあまり良くないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580107,
					"content": "風魔龍が目覚めてからずっと、このモンド周辺をうろついているの。ここ一帯に大きな混乱をもたらしているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580108,
					"content": "おまけに今のモンドは、元素の流れと地脈の循環が子猫ちゃんが遊んだ後の毛糸玉みたいになっていてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580109,
					"content": "魔法使いにとっては最悪な状況よ…肌も気分も調子悪いわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580110,
					"content": "それがなければ、尋ね人の張り紙を出すよりも、騎士団がもっと効率のいい方法で君たちを助けられるのだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580111,
					"content": "もうしばらくモンドに留まっていてくれ。西風騎士団が問題を解決してみせるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580112,
					"content": "騎士団に丸投げするわけにはいかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "オイラも手伝うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3580116,
					"content": "じゃあ、作戦を練るとするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3580117,
					"content": "風魔龍がモンドに攻めてきたことで、逆に災いを終結させるきっかけを与えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580118,
					"content": "それとリサの魔法で探査したところ、モンドを包む暴風の源が分かったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580119,
					"content": "ほぅ？どこなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3580120,
					"content": "放棄された<color=#00E1FFFF>「四風守護」の神殿</color>よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580121,
					"content": "風魔龍があの暴風を引き起こせたのは、そこに残った力のせいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 3580122,
					"content": "私たちの目標は、放棄された四つの神殿のうち、この<color=#00E1FFFF>三つ</color>だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580123,
					"content": "三つだけの理由については…みんなも分かっていると思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580124,
					"content": "分からないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3580125,
					"content": "モンド人だけが分かる暗黙の了解かも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "西風騎士のみんな、時間は限られている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580128,
					"content": "暴風が猛威を振るっている今、守るだけでは意味がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580129,
					"content": "この災害がさらなる拡大をする前に、<color=#00E1FFFF>神殿の遺跡</color>へと向かおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 3580126,
					"content": "あとでまた聞こう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "騎士団に任せた。宿屋はどちらに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "おい、サボるなよ。オイラたちも手を貸すべきだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}