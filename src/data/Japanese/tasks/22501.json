				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "「よくない」と言ったけど、一体何がよくないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010202,
					"content": "隕石に触れると昏睡状態に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "うむ、そのことは私も耳にした。でも近くで見るだけなら、大丈夫だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010204,
					"content": "隕石に絶対触らない自信があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "大丈夫さ…ちゃんと気をつけるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
