				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "うーん…これでもないし、あれもだめ。はぁ、やはり見に行ったほうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "こんにちは。私は清昼、詩人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010104,
					"content": "今詩を作ってるんだけど、どう考えても良いのが浮かばなくてね。ずっと悩んでるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010105,
					"content": "最近空から数多の隕石が降り落ちてる。こんな現象は今までになかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010106,
					"content": "それで思ったんだ。その隕石の近くに行って実際に見てくれば、良い詩が思い浮かぶんじゃないかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225010107,
					"content": "いや、あまりよくないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "よくない？なぜそんなことを言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
