						225011203
					]
				},
				{
					"id": 225011203,
					"content": "確かに、良い詩は奇をてらう必要はない、心に深く染みる方が良いかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 225011204,
					"content": "草花や小動物、そんな些細なことでも良い詩が書けるかもしれない。でもそれじゃあ普通すぎるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "清昼"
				},
				{
