			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "はあ、まさか本当に山の上に落としたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170102,
					"content": "おばあちゃん、ど、どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "おや、子供たち、なぜここに？奇遇じゃな…おや、随分薄着だね。上は風が強いからのう、風邪を引くんじゃないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170104,
					"content": "ばあやは今「琥牢山」に行って、友人と会ってきたんじゃ、そろそろ城内に戻るところじゃが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170105,
					"content": "途中で落とし物に気付いてのう、おそらく「琥牢山」の上に落としたんじゃろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170106,
					"content": "じゃがもうここまで歩いたし、山の上には厄介な琥珀もあるんじゃからのう、もう往復する力も残っておらんのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170107,
					"content": "子供たちや、代わりに「琥牢山」でばあやの落とし物を探してきてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170108,
					"content": "友達って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "おや、「琥牢山」の上に住んでるやつじゃ。会ったことがあるんじゃろう。彼の琥珀はのう…厄介なのじゃ。…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170110,
					"content": "こうなると知ったら、あれを壺に入れておけばよかったんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170111,
					"content": "何を落とした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "箱じゃ、はあ、ばあやは記憶力がよくないからのう、あれを壺に入れておけばよかったんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170113,
					"content": "じゃが、あの箱が本当に「琥牢山」の上にあったら、十中八九あの山の琥珀の中にあるんじゃ、探しやすいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170114,
					"content": "子供たちや、「琥牢山」の琥珀からばあやの落とし物を探してくれぬかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170115,
					"content": "そうじゃ、気を付けておくれ。あの琥珀の中、何が入ってるか分からんからのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
