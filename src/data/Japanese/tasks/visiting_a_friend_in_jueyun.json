				{
					"id": 221170401,
					"content": "子供たちよ、もう少し服を着ておくれ！風邪を引いたら大変じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170402,
					"content": "あの琥珀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "あの琥珀はばあやの友人が作ったものじゃ。怪物や盗賊の侵入を防ぐためとか言ったのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170404,
					"content": "時間が経ったからのう…今、琥珀の中に訳の分からんものが入ってる時があるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170405,
					"content": "はあ、困った琥珀じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170406,
					"content": "その壺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "おや、あなたたちに感謝しないとな、おかげでばあやの壺は綺麗になったのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170408,
					"content": "今回ものを取りに来たのも、あの壺を掃除するためじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 221170409,
					"content": "掃除して、綺麗にして、客をもてなすのじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				}
			]
