			"dialogs": [
				{
					"id": 751330301,
					"content": "#おっ、通路が開いたぞ。今回は{REALNAME[ID(2)|SHOWHOST(true)]}のお手柄だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330302,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#さすが{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "でもおごっちゃダメだぞ。これからもたくさんの挑戦が待ち受けてるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330305,
					"content": "さて、入口も開いたことだし、さっそく下へ行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330306,
					"content": "そうだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330307,
					"content": "キュルル…チュン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "「ココウィク」"
				},
				{
					"id": 751330308,
					"content": "ん？ココウィク、どうしたの、嫌がっちゃって…もしかして怖くなったの？でも、ここで引き返すわけにはいかないよ。まだ冒険は終わってないんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330309,
					"content": "チュン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "「ココウィク」"
				},
				{
					"id": 751330310,
					"content": "ポーナ、あんまり無理言うなよ。本当にすごく怖がってるみたいだぞ。もしかして、下になにか危ないやつでもいるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330311,
					"content": "怖い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#おいおい、おまえまでビビッてどうするんだよ。{REALNAME[ID(2)|SHOWHOST(true)]}みたいに元気出せって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330313,
					"content": "ワクワクしてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "おおっ、意外とやる気満々だな。まあ、下にいるのがどんなやつでも、おまえには敵いっこないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330315,
					"content": "大丈夫、勇敢な仔竜がいるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "キュッ…キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "うーん、ココウィクはここまで怖がってるから、残っててもらうか。あっ、でも…ひとりにするわけにもいかないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330318,
