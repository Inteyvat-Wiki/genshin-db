					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "こんなとこに連れてこられるなんてな。ポーナと会った場所と一緒で、ここもちょっと変な遺跡みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330102,
					"content": "見ろ、ここにもそっくりな壁画があるぞ。うーん…でも上には塗りつぶされた痕跡がないな。高いとこにあるからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}、ここに描かれてるのって、さっきポーナが言ってた蛇王だったりしないか？ヤバそうな見た目だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330104,
					"content": "うん、これが蛇王のオチカンだよ。彼は天蛇の船を作るために、残忍な手段で民衆から搾取して、アビスを引き寄せて国を滅ぼす原因を作ったって言われてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330105,
					"content": "まあ、ただの言い伝えだけどね。蛇王の結末については、部族の語り部の間でも諸説あるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330106,
					"content": "彼は今もあの天蛇の船で宝物を餌食にしてるのかも。もしくは、いつもあたしたちを邪魔してるあの悪龍こそが、あいつの悪霊だったりして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330107,
					"content": "チュン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "「ココウィク」"
				},
				{
					"id": 751330108,
					"content": "ひいっ、そんな話しないでくれよ。ほら、ココウィクも怖がってるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330109,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#あの悪龍を負かしてから、{REALNAME[ID(2)|SHOWHOST(true)]}はやたらウズウズしてるみたいだな。もしかして、ココウィクとなにか勝負でもしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330111,
					"content": "ところで、例の祭壇は一体どこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330112,
					"content": "ココウィクの指し示した方向が正しければ、この下にあるはず…あれ？もっと高いところにあるかと思ったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330113,
					"content": "何か間違えちゃったのかな？源火の祭壇が山の真ん中にあるはずないよね？もしそうだったら、山をふっ飛ばさないと、空には行けないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330114,
					"content": "何か特殊なワープ手段があるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "うぅ、さっき下では大口を叩いてたけど…困ったな。ココウィクの話もわからないし、なにが言いたいのか全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330116,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "「ココウィク」"
				},
				{
					"id": 751330117,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}はなにかわかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330119,
					"content": "分かったよ。その子は「ロジックばっかりに頼ってると、冒険は続かない」って言ってるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330120,
					"content": "どうせまたおまえが適当に言ってるだけだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751330121,
					"content": "とにかく、下に何があろうと、まずは行ってみないとわからないでしょ。これも冒険のうちだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751330122,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#おぉ、{REALNAME[ID(2)|SHOWHOST(true)]}、やる気満々だな。じゃあ、まずは下に降りる方法を調べてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
