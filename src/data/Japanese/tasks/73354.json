					}
				]
			},
			"dialogs": [
				{
					"id": 733540101,
					"content": "照明の色合いに明るさ…華やかなエフェクトに至るまで、すべてが申し分ありません。完璧な演出です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540102
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540102,
					"content": "サフィさんのおかげで、伝説の花の騎士の雄姿を再現できそうです。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540103
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540103,
					"content": "いやいや、俺ひとりの功績じゃないさ。君もご苦労だったな。事務職の私より、君のほうが大変だっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540104
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540104,
					"content": "目下の課題は、花の騎士の人選だな…実力があって、伝説のファーリスのようなオーラを持つ役者を探すとなると、やはり難しいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540105,
						733540106
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540105,
					"content": "何の話をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				},
				{
					"id": 733540107,
					"content": "照明？エフェクト？公演のことで悩んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540108,
					"content": "出た！唯一無二の大英雄、花の騎士役の最有力候補！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540109
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540109,
					"content": "いや、もはや花の騎士そのものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540110
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540110,
					"content": "#うわぁ、落ち着けって！{NICKNAME}を見た瞬間、目の色が変わったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540111,
						733540112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540111,
					"content": "大げさだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540113,
					"content": "#コホン、またお会いできて光栄です、{NICKNAME}さん。こちらは、ヴァフマナ学院の民俗学者、サフィさんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540114
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540114,
					"content": "このところ、街中「花神誕祭」で盛り上がっているので、サフィさんはこれを機に、歴史文献や民間伝説を参考に、フォンテーヌの最新技術を取り入れた映影を作ろうと考えていらっしゃるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540115
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540115,
					"content": "「花の騎士の知られざる戦い」というテーマの映影でな。草神様のために謎の秘境に入って、邪悪な勢力を一掃する騎士の物語なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540116
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540116,
					"content": "あ、なんとなく分かってきたぞ…戦闘のうまい役者がいなくて、戦闘シーンが撮れないでいるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540117,
					"content": "#ああ——もっと言えば、戦闘シーンだけでなく、ほかのシーンについても、{NICKNAME}さんより適した人材はいないと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540118
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540118,
					"content": "君に協力してもらえれば、この映影はスメール史上最も素晴らしい「花の騎士」関連作品として、上映後もかなりの収益が期待できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540119
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540119,
					"content": "もちろん、お二人には十分な報酬をお支払いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540120
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540120,
					"content": "#へへっ、確かに{NICKNAME}のイメージなら、スターにだってなれそうだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540121,
					"content": "「花神誕祭」中は結構暇だし、撮影に協力するぐらいの時間はあると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540122,
					"content": "#{NICKNAME}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540123,
						733540126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540123,
					"content": "演技は専門外だけど、戦闘なら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540124
					]
				},
				{
					"id": 733540124,
					"content": "それは助かるよ…！では、さっそく戦闘シーンの撮影を始めよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540125
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540125,
					"content": "花の騎士のイメージデザインやメイク、衣装も、君に合わせて調整する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540129,
					"content": "ではさっそく撮影を始めましょう。準備ができたら教えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540130
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 733540130,
					"content": "よし、大スターを目指そうぜ！花の騎士の熱血伝説の撮影、スタート！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733540126,
					"content": "戦闘シーンなんて序の口。他のシーンもいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540127
					]
				},
				{
					"id": 733540127,
					"content": "本当に助かるよ…！ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540128
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540128,
					"content": "ただ、戦闘シーンとそれ以外のシーンは別々に撮る必要があってな。戦闘以外のシーンはまた日を改めて撮らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733540129
					],
					"speakerTitle": "サフィ"
				},
				{
					"id": 733540112,
					"content": "その通り。もっと褒めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540113
					]
				},
				{
					"id": 733540106,
					"content": "何か困りごと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733540107
					]
				}
			]
		}
	]
}