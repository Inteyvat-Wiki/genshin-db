	"talks": [
		{
			"id": 7469201,
			"completionStepIds": [
				7469201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469201",
							"2"
						],
						"stepId": 7469201,
