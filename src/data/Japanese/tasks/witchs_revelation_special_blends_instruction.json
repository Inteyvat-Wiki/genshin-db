			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746920101,
					"content": "…つまり、あなたもあたしの厄介な体質を解決できないってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920102
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920102,
					"content": "そうだね。この運命の乱れは、おまえさんの運命とあまりにも深く結びついておる。例えるなら、運命の木から生え出た新芽のようなものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920103
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920103,
					"content": "それはずっと、おまえさんが太陽の光や雨露を吸収する手助けをしてきたし、既に運命を「形作り」始めてもいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920104
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920104,
					"content": "もしむやみにその芽を切り落とせば、残された傷口から何か良くないものが入り込んで、木全体が病気になってしまうかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920105
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920105,
					"content": "ふーん…まるで、この体質がいいものだと思ってるような言い方にゃ。これのせいで、いつまでたっても本当に作りたいお酒が作れないっていうのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920106
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920106,
					"content": "新芽っていうより、大樹に絡みついて苦しめようとしてるツルみたいじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920107
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920107,
					"content": "うむ、もしそうだったら、運命の拒絶反応に従えば簡単に切り落とせるんだがね…だが残念ながら、それはそういうものじゃないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920108
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920108,
					"content": "さて、無駄話はここまでだ。これで、わしがれっきとした占い師だと信じてくれただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920109
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920109,
					"content": "ほら、さっき言った通りにこっちへ来て適当にカードを一枚引いとくれ。おまえさんの未来に、少しだけアドバイスをしてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920110
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920110,
					"content": "うーん…えっと、じゃあ適当に引くよ？これに…ううん、やっぱり…こっちかにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920111
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920111,
					"content": "安心しな。どのカードを選ぼうと、引けるのは運命に定められた一枚だけだよ。ヒッヒッヒッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920112
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920112,
					"content": "（うぅ…この占い師さん、笑い方がすっごく怖い！童話に出てくる悪い魔女みたいだにゃ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920113
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920113,
					"content": "（でも、すごい占い師さんのアドバイスなら、本当に役に立つかもしれないし…真剣に選ばないと！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920114,
						746920115
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920114,
					"content": "子供を怖がらせないでよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				},
				{
					"id": 746920116,
					"content": "えっ？旅人にパイモン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920117
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920117,
					"content": "さすがだね、いつも絶妙なタイミングで現れるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920118,
						746920119,
						746920120
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920118,
					"content": "褒めてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920121,
					"content": "ヒッヒッヒッ、確かにその通りだよ。掴みどころのない「運命」よりも、確実な依頼のほうが、人の言動をより直接的に形作れるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920122
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920122,
					"content": "さて、この子と話すのはおまえに任せようかね。どうやら、わしという魔女をあまり信用しておらんようでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920123
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920123,
					"content": "こんな場所で露店を出してる怪しい占い師なんて、どう考えても信用できないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746920124,
					"content": "（旅人はこの占い師さんと知り合いなの？よかった、やっと信頼できる人に話が聞ける…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920125
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920125,
					"content": "…旅人、パイモン、こっちこっち。ちょっと聞きたいことがあって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920126,
						746920127
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920126,
					"content": "こっちもちょうど聞きたいことが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920128,
					"content": "もちろん、新しいお酒の材料を探すためだよ。ふんっ、これまでのあたしは視野が狭すぎたの。お酒を作るのに、食材ばっかり探してたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920129
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920129,
					"content": "は…はは…おまえが使う材料全部が「食材」ってわけでもないと思うけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746920130,
					"content": "と、とにかく、どれも口に入れられる物ばかりでしょ！目をつぶって歯を食いしばれば、飲み込めはするにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920131,
						746920132
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920131,
					"content": "それで、探しに来たってことだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920133,
					"content": "そうだよ。例えば…錆びたネジに廃棄されたケーブル、固まった油汚れの塊とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920134
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920134,
					"content": "フォンテーヌ科学院でフォンタを作ってるおじさんが手伝ってくれたおかげで、こんなにたくさんいい材料を見つけられたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920135,
						746920136
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920135,
					"content": "ハインリ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920137,
					"content": "うん…あの美味しい炭酸飲料はフォンテーヌ科学院が作ってるって聞いてたから、もともと興味はあったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920138
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920138,
					"content": "行ってみたら、ハインリおじさんが気前よく新しい味のフォンタを何本も飲ませてくれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920139
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920139,
					"content": "あのおじさんからはお酒の匂いが全然しなくて、甘酸っぱいフォンタの香りしかしないんだよ。一嗅ぎしただけで、頼りになる大人だってわかったにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920140
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920140,
					"content": "それに、ここへ来るようにも勧めてくれたんだ。あたしみたいな「特殊体質」は、科学院の技術じゃ解析できないかもしれないんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920141
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920141,
					"content": "でも、最近フォンテーヌ廷の近くにすっごくよく当たるって評判の不思議な占い屋がある、っていう話を聞いたらしくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920142
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920142,
					"content": "「もしかしたら、占いによって原理が分かるかもしれません。それさえ判明すれば、解決方法も見つかる可能性がありますよ」って言われたんだにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920143
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920143,
					"content": "なかなか筋が通ってるし、考え方もはっきりしてるな。さすがはフォンテーヌ科学院の研究員っていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746920144,
					"content": "それで、この占い屋に来たんだけど…来てすぐに彼女に呼び止められて、あたしの体に奇妙な乱れがあるって言われたんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920145
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920145,
					"content": "何も言ってないのに、あたしの体質の問題を全部言い当てたんだよ。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920146
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920146,
					"content": "でも、フォンテーヌ科学院の研究論理は、直接、占いに応用できるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920147
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920147,
					"content": "さっきも言っただろう？例え「原理」が分かったとしても、その後は一筋縄ではいかないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920148
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920148,
					"content": "神秘学は実体のあるベアリングやネジじゃないからね。わしにも、おまえさんの運命を直接「修理」してやることはできないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920149
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920149,
					"content": "それってつまり、何も変えられないってことだよね…？だったら、カードを引いても意味ないにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920150
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920150,
					"content": "それがそうとも限らない。カードを引けば、運命に欠けていた小さな歯車が見つかるかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920151
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920151,
					"content": "一見ちっぽけな部品に見えても、しっかりと装置に取り付けてやれば、それが巨大なシステムを動かすことだってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920152
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920152,
					"content": "あ、あたしを騙そうとしてるんじゃないよね？旅人はどう思う…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920153,
						746920154
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920153,
					"content": "バーベロスさんは信頼できる人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920155,
					"content": "…わかった。旅人がそう言うなら、引いてみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920156
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920156,
					"content": "バーベロスに見つめられながら、ディオナは手を伸ばし、ゆっくりと一枚の「月諭のアルカナ」を引いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746920157
					]
				},
				{
					"id": 746920157,
					"content": "ひ、引いたよ。このカードは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920158
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920158,
					"content": "…おや、これはまた奇妙だね…まさかおまえさんの身体の「乱れ」が、これほどまでにたくましく成長しておったとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920159
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920159,
					"content": "もはや「新芽」ではなく、一本の丈夫な枝になっておる。実に奇妙だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920160
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920160,
					"content": "えっ？どういう意味にゃ？そ…それって、これからあたしが作るお酒が、どんどん美味しくなっちゃうってこと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920161,
						746920162
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920161,
					"content": "悪い話には聞こえないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920163,
					"content": "体質だけのことを言うなら、その通りだね。それに、引いたカードは逆位置の「女教皇」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920164
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920164,
					"content": "それは今まで、幕の手前にあるものばかりに気を取られていたことの証明さ。だからこそ、いつまでたってもその幕の先に行くことができなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920165
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920165,
					"content": "お酒の調合とはあんまり関係なさそうだね…このカードが、どんな食材を探しに行けばいいか教えてくれると思ってたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920166
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920166,
					"content": "ヒヒッ…確かに「月諭のアルカナ」にそれはできないね。少なくとも、今はまだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920167
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920167,
					"content": "だが、おまえさんも必ずしも「お酒の調合」という行為を通して、人生の本当の答えを探す必要はないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920168
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920168,
					"content": "あたしの人生の本当の答えは、酔っぱらいのおじさんを全員こらしめて、二度と酔って暴れたりできないようにすることだにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920169
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920169,
					"content": "大した行動力だ。だが、身体は行動していても、「心」はずっと立ち止まったままのようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920170
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920170,
					"content": "そんなことない！あたしは…あたしは心の底から、お酒を飲む変なおじさんのことが大嫌いなの！特に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920171
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920171,
					"content": "なるほど。なら…そいつと話したことはあるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920172
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920172,
					"content": "えっ…うぅ、誰のことを考えてるかも分かっちゃうの？あたし、何も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920173
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920173,
					"content": "占ったに決まってるだろう。ヒッヒッ、焦りによる行動や混乱した感情は捨てて、一度、本心からそいつと向き合ってみるのもいいかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920174
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920174,
					"content": "そのほうが、世界一まずい酒を調合するより、有意義かもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920175
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920175,
					"content": "…そんなの絶対無理だよ。お酒を飲んだら、なんにも聞いてくれなくなるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920176
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920176,
					"content": "以前はそうだったかもしれない。だが今、おまえさんは一つの小さな歯車を見つけたじゃないか。それが回れば、少しは状況に変化が起きるかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920177
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920177,
					"content": "このカードのこと？でもこれ、ただのカードじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920178
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920178,
					"content": "もちろん違う。わしが言っておるのは、既に変化し始めたおまえさんの「心」のことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920179
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920179,
					"content": "あ、あたしの心なんて少しも変わってないよ！も、もう…お酒の材料を探しに行くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920180
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920180,
					"content": "あっ…えっと…占い代はいくら？ちゃんと払わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920181
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920181,
					"content": "ほう、本当に礼儀正しい子だね。あの小娘よりずっと可愛げがある。だが代金は不要だよ。魔女からのささやかな贈り物だと思いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920182
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920182,
					"content": "あ…ありがとう。もしモンドに来ることがあれば…飲み物を奢ってあげる。美味しさは保証するにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920183
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920183,
					"content": "わしがモンドに？ふむ…機会があれば、一度行ってみるのも悪くないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920184
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920184,
					"content": "あなたたちも付き合ってくれてありがとう。旅人、それとパイモンも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920185,
						746920186
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920185,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920187,
					"content": "だな。どんな面倒事でも、オイラたちがすぐに駆けつけて手伝ってやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920188
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746920188,
					"content": "でも…へへっ、その後は、美味しい飲み物を奢ってもらわないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920189
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746920189,
					"content": "…うん！あなたたちがモンドに遊びに来たら、絶対に一番美味しい飲み物をごちそうしてあげるにゃ。もちろん、お酒が一滴も入ってないやつをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920190
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920190,
					"content": "そうそう、もしカードについてまだ疑問があれば、モナという小娘を訪ねるんだよ。あいつのことは知っておるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920191
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920191,
					"content": "モナ姉さんのこと？知ってるよ。よくお店に来て、一番安い飲み物を頼んでるけど…彼女もすごい占い師なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920192
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920192,
					"content": "ハッ、わしの足元にも及ばんよ。だが、「月諭のアルカナ」の解読すらできんようなら、占い師を名乗る資格はないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920193
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920193,
					"content": "おまえさんはただ、偉大なるアストロマンサー・バーベロス・トリスメギストスに代わって、試練として予言を持ってきたと伝えればいいのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920194
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920194,
					"content": "安心しな。そう言っておけば、あいつは必ず全力を尽くして解読してくれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920195
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746920195,
					"content": "うん、覚えたよ！アスト…アストロマンサー・バーベロス・トリスメギストス…すっごく長い名前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920196
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920196,
					"content": "そういえば、モナ姉さんのフルネームも長かったっけ。たしかアス、アストローギ…忘れちゃったにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 746920186,
					"content": "手伝いが必要な時は、いつでも呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920162,
					"content": "いい話とも言えなさそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920154,
					"content": "そんなに気負わず引いてごらん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920136,
					"content": "どうやって彼と出会ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920132,
					"content": "口に入れられないような物を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920127,
					"content": "ディオナはなんでフォンテーヌに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920119,
					"content": "タイミングよく登場するのは得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920120,
					"content": "じゃなきゃ、たくさんの依頼をこなせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920115,
					"content": "久しぶり、ディオナ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				}
			]
		},
