			"dialogs": [
				{
					"id": 718040201,
					"content": "ここは緋雲の丘の告知板です。街の告知や店の広告など、どんなことでも掲載します。要件がない場合は、掲載しないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 718040202,
					"content": "総務司の人事異動について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "「総務司の人事異動は下記の通り…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 718040204,
					"content": "待ってくれ、総務司の人事異動は経営許可書とは関係ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718040205,
					"content": "緋雲の丘の水源汚染問題の状況報告…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "「近頃、緋雲の丘で発生している水源汚染について…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 718040207,
					"content": "イヴァノヴィチは急いでるんだ。オイラたちに水源汚染を心配している暇はないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718040208,
					"content": "最新の経営許可書の申請について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "「最新の経営許可書の申請が必要な場合は、下記の手続きを…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "掲示板"
				},
				{
					"id": 718040210,
					"content": "これがイヴァノヴィチが探していた情報だな。早く写そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
