					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "ん？お前は代理で来たのか？なら営業場所証明書となんだっけ？そうそう…営業安全許諾書は持って来たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉義"
				},
				{
					"id": 718040504,
