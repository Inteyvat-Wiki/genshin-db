				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "最新の経営許可書の申請についての告知は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040302,
					"content": "写してきたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "助かるよ、確認させてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040304,
					"content": "出港申請審査結果の書類、営業場所証明書に営業安全許諾書…そして過去の経営許可書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040305,
					"content": "よしよし、この書類たちならこの前申請したばかりだ。かなり骨が折れたけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040306,
					"content": "旅人、申し訳ないがこの書類を提出してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040307,
					"content": "コホン…提出先がいくつかに分かれているが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040308,
					"content": "うん、まず、<color=#00E1FFFF>出港申請審査結果</color>を安に、<color=#00E1FFFF>営業場所証明書と営業安全許諾書</color>を千岩軍の嘉義に提出してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040309,
					"content": "それと<color=#00E1FFFF>過去の経営許可書</color>は、昭に提出すれば完了だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040310,
					"content": "頼んだぞ、旅人。報酬はしっかり用意しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040311,
					"content": "分かった分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "この手続きで全てが終わればいいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040313,
					"content": "もう手続きはこりごりだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "君は手続きと無縁の生活を送れるが、私は…ここで商売を続ける限り、手続きから逃れられないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 718040315,
					"content": "はあ、確かに確実で安心感のある方法だが、もう少し簡単にできないのかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴァノヴィチ"
				}
			]
		},
