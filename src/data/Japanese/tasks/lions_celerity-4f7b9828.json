			"dialogs": [
				{
					"id": 761480101,
					"content": "わぁっ！どこに行ってたんだよ！すっごく心配したんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761480102,
					"content": "オイラ、ずっとおまえの名前を呼んでたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761480103,
					"content": "どうしてパイモンは無想の間に引き込まれなかったんだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480104,
					"content": "食べることと寝ること以外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "あんまり深く考えていないからかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "なるほどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480107,
					"content": "とにかく、メランタは本気で怒っているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480108,
					"content": "#一刻も早く、{NICKNAME}を上まで連れて行って、メランタに会ってもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480109,
					"content": "場所を変えよう…ここも安全とは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480110,
					"content": "えっと…誰も気にしていないと思いますが、わたしはアラーラと申します。よろしくお願いしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラーラ"
				}
			]
		},
		{
			"id": 7614807,
