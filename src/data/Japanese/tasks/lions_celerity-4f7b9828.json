				"points": [
					{
						"sceneId": 103,
						"position": [
							250.415,
							-645.04,
							392.731
						],
						"pointId": 118
					},
					{
						"sceneId": 103,
						"position": [
							252.49,
							-645.37,
							394.33
						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "またここに戻って来たね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480702,
					"content": "前回ここに来たのは、人の寿命で数えれば前々々々々々世…よりも前のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480703,
					"content": "どうやら僕らは、再び無想の間に放り込まれてしまったらしいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480704,
					"content": "どうやって出ればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "普通は、瞑想を通じて心と思考を制御し、欲望を全て捨て去って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480706,
					"content": "何も思考しない——そんな状態を保てば出られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480707,
					"content": "口で言うのは簡単だけど、素質や欲望の強さによっては、数年から数百年かかることもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480708,
					"content": "君のように世界の運命を背負っている人がその欲を自ら断ち切ることは、恐らく厳しいだろうね。第一、その欲は捨ててはいけないものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480709,
					"content": "じゃあ、どうすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "まずはカテリンドを見つけ出してから、どうすべきか考えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480711,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761480712,
					"content": "何を拾ってきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "えっ？みっちゃんも引き込まれてしまったのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480714,
					"content": "それなら、何とかなるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480715,
					"content": "同じ守護者であるみっちゃんなら、これに宿る力を使って、無理やり道をこじ開けられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480716,
					"content": "ずっと「これ」と呼ぶのもなんだから…名前を付けようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480717,
					"content": "この棺は、神殿の主の姉妹の趣味だという噂を聞いたことがある…確か、「死念の棺」という名前だとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761480718,
					"content": "とにかく、これのことは「亡念の破片」と呼ぶことにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イストリア"
				}
			]
		}
	]
}