			"dialogs": [
				{
					"id": 762000501,
					"content": "ルミもここだと思うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000502,
					"content": "やっふー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "ルミ"
				},
				{
					"id": 762000503,
					"content": "閉じ込められていたレッドタビーを助け出した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "彼女たちが探してたのは君だね。見たところ外傷はないみたいだけど、もう少し遅かったら危なかったかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000505,
					"content": "とにかく、まずは君の仲間を探しに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リンネア"
				}
			]
		},
