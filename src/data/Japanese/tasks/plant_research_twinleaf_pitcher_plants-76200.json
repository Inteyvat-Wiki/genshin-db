			"dialogs": [
				{
					"id": 762000801,
					"content": "バカ猫ったら、一体どこに——えっ？見つけたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000802,
					"content": "あそこの双葉ウツボカズラに捕まってました。植物ですけど、肉食の捕食者なんですよ。月蛍だって数日で消化しちゃうほどで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000803,
					"content": "早く見つかってよかったですね。少し衰弱してるだけみたいですけど、もう少し遅ければどうなっていたか分かりませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000804,
					"content": "そ、そんなに危険だなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "ジュカ"
				},
				{
					"id": 762000805,
					"content": "全部こいつが勝手にそんなとこ入り込んだせいでしょ。本当にバカ猫なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000806,
					"content": "この子だけのせいとは言い切れませんよ。双葉ウツボカズラは特殊な匂いを発してるんです。人には影響ありませんが、昆虫なんかは引き寄せられちゃうんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000807,
					"content": "双葉ウツボカズラは、そうやって捕食してるんです。この辺りはちょっと異常なくらい生えていますから、動物まで影響を受けてるんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000808,
					"content": "あ…ああ、そう。とにかくこの草がこんなに増えてるのは、絶対いいことじゃないわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000809,
					"content": "はい、放っておくと危険かもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000810,
					"content": "よし、じゃあ草刈りはあたしたちに任せといて。ジュカも手伝うのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000811,
					"content": "あのバカ猫を長いこと苦しめた奴らに、しっかりお返ししてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000812,
					"content": "二人のトレジャーハンターと共に、この一帯で異常に生長した双葉ウツボカズラを取り除いた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "ふぅ——ようやく終わったわね。あたしたちもナシャタウンに戻るわよ…お嬢さん、ありがとう。バカ猫を探すのを手伝ってくれて助かったわ。あんたがいなければ、いつまで閉じ込められてたんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000814,
					"content": "それはそうと、マールカがあんな大声で叫ばなければ、もっと早く見つけられたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "ジュカ"
				},
				{
					"id": 762000815,
					"content": "う、うるさいわね！とにかく、無事に見つかったんだからいいじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "マールカ"
				},
				{
					"id": 762000816,
					"content": "（口ではバカ猫とか言ってたけど、本当はすごく心配してたんだね。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000817,
					"content": "そうですね、この子が無事であることが何よりです。野外はまだ危険ですから、あなたたちも気をつけてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 762000818,
					"content": "ありがとう、気をつけるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "ジュカ"
				},
				{
					"id": 762000819,
					"content": "そっちの調査もうまくいくことを願ってるわ。それじゃ、またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マールカ"
				}
			]
		},
