			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "その、今から何をするのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170202,
					"content": "おまえのために写真を残すんだ。具体的な操作はオイラたちに任せろ。おまえはそこに立って、ポーズをとるだけでいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170203,
					"content": "簡単に言うと、写真は今この瞬間のおまえを記録することができるんだ。なにかの記念に残すにはぴったりだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170204,
					"content": "ポーズをとるとはどういうことでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170205,
					"content": "姿を記録することだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "なるほど。つまり、あなたたちに向かって、見栄えのある格好を取ればいいのですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170207,
					"content": "よく考えると、なんだか恥ずかしいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170208,
					"content": "どうすればいいのでしょうか？何か私に案をください。見栄えするものがいいですが、大げさすぎるのは避けていただけると。でないと、恥ずかしくて仕方ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170209,
					"content": "端正なポーズで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "こ…こうでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170215,
					"content": "これにしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "はい、ではお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170219,
					"content": "いい角度を決めて、影を記録しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170216,
					"content": "他のも試してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "わかりました。ここはあなたが決めてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170211,
					"content": "真剣なポーズで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "少し慣れませんね。こうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170213,
					"content": "気楽なポーズで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "気楽なら、こうでしょうか。肩肘を張りすぎない楽な姿勢です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
