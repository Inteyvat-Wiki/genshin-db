			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170401,
					"content": "いま行っているのが「撮影」ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170402,
					"content": "ふふ、悪くありません。また新しいことを学ぶことができました。さっそく始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "撮れたぞ。ほら、これがさっきおまえのために撮った写真だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170502,
					"content": "これは…不思議ですね。法術の一種でしょうか？この中に…もう一人の私を複製したのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170503,
					"content": "しかし、動かないみたいですね。話もできないようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170504,
					"content": "これは記録だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "先ほどまで、体がこわばっていてあまり良く撮れていないと思っていましたが、いま見てみると想像よりもだいぶ自然な感じで撮れているように思えてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170507,
					"content": "まったく同じ姿勢で、そして背後の風景も…いったいどういう仕組みなのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170508,
					"content": "それがこいつの凄いところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170509,
					"content": "少々お待ちを、まだ原理を理解することができていません。もう少し説明を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170510,
					"content": "つまり、この中にいるのは私ではない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170511,
					"content": "私ではないのなら、どうして私とまったく同じ姿なのでしょう。そしてもし私であるなら、今の私とはいったいなんなのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170512,
					"content": "これは…オイラの回答能力を超える質問だ…おまえにバトンタッチ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170513,
					"content": "将軍と影の違いと同じ感じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "そうだぞ。おまえは将軍を自分のことだと思ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170515,
					"content": "もちろんです。今まで稲妻の管理を他の人に任せようと思ったことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170516,
					"content": "じゃあ、今のおまえはなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170517,
					"content": "それを言うなら、私は私です。疑いの余地もないことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170518,
					"content": "「影」の存在が一つとは限らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "「私」の存在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170520,
					"content": "なんだかわかってきたような気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170521,
					"content": "私は私であり、一人しかいませんが、無数の形で存在することができるのですね。どのような形で存在するのかは、あまり重要なことではないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170522,
					"content": "例えば将軍は、私の存在する形の一種であり、彼女が私であるかどうかという問題は、決して彼女の体にある部品によって決まることではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170523,
					"content": "そういうことなら、この写真もおまえの存在する形の一種だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170524,
					"content": "ええ、「永遠」を追い求める私でさえも、存在の形が変わり続けていたのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170525,
					"content": "そうであれば、いったいどうして稲妻に、そして稲妻で生きる一人一人の方に、不変を要求できるというのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170526,
					"content": "稲妻の本質が容易に変わることはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "今回あなたたちとの旅で見たものは、すべて私の認識外にあるものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170529,
					"content": "はぁ、お恥ずかしい一面を見られてしまいましたね。あなたたちには分からないと思いますが、これらは私の認識に大きな衝撃を与えたのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170530,
					"content": "もし今回見聞きしたもので定義するのなら、今の稲妻は私の印象とは大きくかけ離れたものになっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170531,
					"content": "ですが、決してそのような理由で、今の稲妻が稲妻ではないと否定してはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170532,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "目狩り令、千手百目神像、これらはすべて「永遠」に追い求めるために生まれたもの。もし私自身が「永遠」に近づいていたら、このようなことは起きなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170534,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170535,
					"content": "私は…すべてをきつく縛り付け過ぎていたのでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170536,
					"content": "どうやらわかったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170537,
					"content": "今回のオイラのガイド、すごく価値のあるものになったみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170538,
					"content": "鎌治様、鎌治様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170539,
					"content": "ん？なんか下が騒がしいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170540,
					"content": "一平みたいだ、どうしたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170541,
					"content": "天領奉行の人ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170542,
					"content": "そうみたいだ、なにがあったか聞きに行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170527,
					"content": "人間の本質が容易に変わることはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "本当の影じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "一平、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170702,
					"content": "あ…あなたたちでしたか。僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170703,
					"content": "って、ええっ！？しょ、将軍様！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170704,
					"content": "九条鎌治坊ちゃんに会いにいらしたのでしょうか…？申し訳ございません、鎌治様はまだおかえりになっていません。もし良ければ、私めが代わりに言付かりましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170705,
					"content": "そうかしこまらず。ここへ来たのは要件があったからではなく、あなたの慌てた声が聞こえたからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170706,
					"content": "鎌治さんを探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "はい。実は、鎌治様が交渉に行ったきり帰ってこず、何かあったのではないかと心配しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170708,
					"content": "鎌治様は普段、外でぶらぶらしたまま帰ってこないことがしばしばありますので、たぶんどこかで迷っているのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170709,
					"content": "ですが、なぜか今日に限って、凄く不安に感じるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170710,
					"content": "九条鎌治、聞いた感じでは九条家の子息のようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170711,
					"content": "はい、申し訳ございません。当主は病を抱え、若旦那は長年不在、現在九条家は九条鎌治が九条家の名代となっております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170712,
					"content": "天領奉行が混乱に陥っていることは私も噂に聞きました。そのことが九条鎌治と関係があるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170713,
					"content": "申し訳ございません、将軍様。それも九条家の失態です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170714,
					"content": "九条家の名誉が大きく傷つき、勢力が衰退し、将軍様は…えっと、天領奉行の今後の取り決めを、将軍様も決めていませんでしたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170715,
					"content": "ですので鎌治様は、「鷹司家」にこの状況を仕切ってもらおうと交渉に行ったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170716,
					"content": "だったら奉行所で交渉してるはずだ。どうして、こんなところで探してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170717,
					"content": "あっ、いえ。今回の会合場所は特別なところでして、僕も戸惑っていたところなんです。それに重鎮同士の会合となると、僕も詳細が聞きづらくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170718,
					"content": "場所は鳴神大社近くにある山の上で、そこに「鷹司家」が所有する特別な拠点があるそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170719,
					"content": "「鷹司」…聞き覚えのある名です。長きに渡り、九条家の補佐を務めていたはずですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170720,
					"content": "はい、そうなんです。だからこそ、鎌治様は交渉に行きました。しかし、いくら話す内容があるにしても、時間がかかりすぎています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170721,
					"content": "城内をくまなく探したんですが、まだ帰ってきてないとなると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170722,
					"content": "まだ終わってないんだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "そうですね、僕もその可能性を考えました。ですが僕の身分では、「鷹司家」に入ることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170725,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが代わりに見に行ってあげようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "いえ、僕の考えすぎの可能性もあります。もし交渉の邪魔になってしまったら、それこそどう許しを請えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170727,
					"content": "僕は鎌治様の付き人ですが、幼い頃から一緒に成長してきた仲でもあるんです。僕はただ…彼に何か起きたのではないかと心配で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170728,
					"content": "僕はあの方のように賢くはないので、手助けはほとんどできません。しかし、自分の失態で鎌治様を危険にさらしたくはないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170729,
					"content": "うーん、将軍様は如何お考えで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120170730,
					"content": "直接出向いてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170731,
					"content": "私の身分であれば、交渉の邪魔をしてもあなたに影響はないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170732,
					"content": "それに元はと言えば、私が早急な決断を出せなかったのが原因、このことは私が解決すべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "影"
				},
				{
					"id": 120170733,
					"content": "頼りがいがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "ありがとうございます！将軍様直々に出向いていただけるなんて！僕も他の場所を探しに行ってみます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120170736,
					"content": "では、その会合場所を記しておきますね。上手くいくことを祈ってます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一平"
				},
				{
					"id": 120170734,
					"content": "かっこいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "予期せぬ何かがあったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
