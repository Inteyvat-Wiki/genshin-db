	"talks": [
		{
			"id": 1201702,
			"completionStepIds": [
				1201702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
