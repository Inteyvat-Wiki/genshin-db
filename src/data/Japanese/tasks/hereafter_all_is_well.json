					"平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "かなり大掛かりな作業になってしまいましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300202,
					"content": "本当にお寺の修繕をしてるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "おや、あなたでしたか。私は真人間に生まれ変わったと言ったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300204,
					"content": "しかし、これほど大規模な工事になるとは思ってもいませんでしたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300205,
					"content": "設計を依頼した建築家がここを「夜叉」のお寺だと聞いた途端、やる気が数段跳ね上がりましてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300206,
					"content": "膨大な量の設計図を描いただけでなく、建材の買い出しにも駆け回ってくれたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300207,
					"content": "彼があと数十年若かったら、きっと一人で修繕作業を行っていたでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300208,
					"content": "危険な目に遭ってない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "危険？ああ、魔物と宝盗団のことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300212,
					"content": "大丈夫です、問題ありません。夜叉のためにお寺を修繕すると聞いた総務司が、護衛の千岩軍を何名か派遣してくれたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300213,
					"content": "この辺りの魔物は、ほとんど千岩軍が追い払ってくれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300214,
					"content": "宝盗団たちは…千岩軍がいるので、恐らく襲ってくる勇気もないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300215,
					"content": "ただ、お寺の修繕工事は私の予想を遥かに超えています。準備した建材だけでは足りず、城内からの補給も必要になってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300216,
					"content": "宝盗団は現場に手を出してきませんが、運送品の建材を待ち伏せして略奪してくる可能性はあると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300217,
					"content": "千岩軍は現場を守ることができても、運送中の建材が宝盗団に襲われたら、助けに行こうにもさすがに間に合いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300218,
					"content": "そこで英雄様、あなたにご協力いただけないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300219,
					"content": "あなたが凄腕であることは、私も知っています。宝盗団を相手にするのなら、まさにあなたが適任でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300220,
					"content": "修繕作業が邪魔されないよう、宝盗団を懲らしめに行ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300221,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "ああ、英雄様！感謝します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				},
				{
					"id": 718300223,
					"content": "どうして千岩軍に頼まないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "彼らは昼夜問わず建設現場を守ってくれているため、疲れています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300225,
					"content": "任せられるのは、英雄のあなたしかいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				},
				{
					"id": 718300210,
					"content": "この辺りは危険だったと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "魔物と宝盗団のことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "平安"
				}
			]
		},
