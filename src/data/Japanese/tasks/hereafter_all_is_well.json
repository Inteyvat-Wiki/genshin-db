					"content": "お寺の修繕はまだ時間がかかるので、当分の間、私はここで寝泊まりすることにします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300603,
					"content": "時間があったら、またいつでも立ち寄ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
