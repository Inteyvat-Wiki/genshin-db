			"dialogs": [
				{
					"id": 718300701,
					"content": "お帰りなさい。宝盗団はいましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300702,
					"content": "もういなくなったのですね…良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300703,
					"content": "他に手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "ご親切にどうも。しかし、もう十分助けられています。これ以上はさすがにお願いできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300705,
					"content": "ただ、もしよろしければ<color=#00E1FFFF>却砂材</color>を探していただけると助かります。お寺の修繕にも繋がるものですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300706,
					"content": "お寺を修繕することは、まさに善行と呼ぶべきもの。ご助力いただければ、きっとご利益があるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300707,
					"content": "却砂材を探してくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "ではお願いします。<color=#00E1FFFF>却砂材</color>を集めたら、私にお渡しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				},
				{
					"id": 718300709,
					"content": "修繕のために寄付してくれる人っている？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "うーん、正直なところ、あまりいないですね。こんな辺鄙な場所なので、大半の人はここにお寺があることすら知りません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300711,
					"content": "それに、銅雀という名の仙人を覚えている人も、今やほとんどいないので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718300712,
					"content": "とにかく、<color=#00E1FFFF>却砂材</color>が集まりましたら、私にお渡しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				}
			]
