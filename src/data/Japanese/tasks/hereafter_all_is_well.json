			"dialogs": [
				{
					"id": 718300401,
					"content": "待て待て！俺の負けだ、降参する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300402,
					"content": "荷物をまとめて、ここから出て行って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "は、はい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300405,
					"content": "俺たち…いつの間にか何か機嫌を損ねることでもしちまったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300406,
					"content": "まさか、ここらで何か金になるようなことでもしてたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300407,
					"content": "お寺の修繕をしている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "お、お寺の修繕？こんな人のいないところでか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300409,
					"content": "えっ…この辺りに仙人を祀ったお寺があるだと？待てよ、まさかあのボロい建物のことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300410,
					"content": "親分、以前そこで休んだ時に鳥の彫像を見ましたよね。もしかして、それが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "宝盗団下っ端"
				},
				{
					"id": 718300411,
					"content": "それは夜叉の「銅雀」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300413,
					"content": "お、親分！もしかして俺たち、仙人を怒らせちゃったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "宝盗団下っ端"
				},
				{
					"id": 718300414,
					"content": "そ、そんなバカな！知らなかったんだから仕方ないだろ…わざとじゃないんだし、仙人だって…怒らないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300415,
					"content": "とにかく、お寺の修繕の件は承知した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300416,
					"content": "仙人よ、これまでの無知と無礼を謝罪する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300417,
					"content": "ここを離れたら、あの寺には近寄らないよう兄弟たちにも言っておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300418,
					"content": "親分、線香でもあげて仙人に謝罪すべきでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "宝盗団下っ端"
				},
				{
					"id": 718300419,
					"content": "うるさい！いいから、さっさと行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝盗団親分"
				},
				{
					"id": 718300403,
					"content": "もう二度とここには近寄らないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
