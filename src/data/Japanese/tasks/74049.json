						],
						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コスンツァーナ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME}はほんとにすごいね。グロテスクなメカを、「ドカン」って一発できれいなパーツに変えちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490302,
					"content": "これでもう花畑は荒らされないはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "うん、ちょっと荒らされちゃったとはいえ、残った花はまだ元気みたいだしな。もう荒らしに来るブリーチャープリムスもいないから、コスンツァーナの花もきっとすくすく育つぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490304,
					"content": "よかった…でも、いい勉強になったよ。大切なお花は、大事に大事にお世話しなくちゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}とパイモンは…異国のお花をプレゼントしてくれた上に、あたしのお花畑も守ってくれた。コスンツァーナ、なんてお礼したらいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490306,
					"content": "そんなに気をつかわなくていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490307,
					"content": "#そうだ、あたしが摘んできたこのお花も、すごく貴重なんだよ！これを{NICKNAME}とパイモンにあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490308,
					"content": "#おお！そんなに貴重な花なら、{NICKNAME}も花畑を作って植えてみたらどうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490309,
					"content": "って、これ…タイダルガじゃないか！タイダルガも花なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490310,
					"content": "タイダルガは植物で、きれいだから、もちろん花のうちに入るよ。人間の「生物学」によるとね。一流のガーデナーになるために、ちょっと勉強したんだ、ふふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490311,
					"content": "なんか間違ってる気がするけど、オイラもその辺の分類学の理論についてはよく分からないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490312,
					"content": "これからもがんばって、もっともっとすごいガーデナーになるね。人間に聞いたけど、一流のガーデナーは新しい品種のお花を育てて、「園芸品評会」に持っていくんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490313,
					"content": "あたしも新しい品種を育てて、「園芸品評会」で「賞」をもらいたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490314,
					"content": "意気込みはいいけど…説明しにくい誤解がまだまだあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490315,
					"content": "園芸品評会に参加するってことは、自分で育てた新品種を人間の鑑賞用に持って行くってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490316,
					"content": "コスンツァーナの感覚とか審美眼って、人間とはかけ離れてるからな…コスンツァーナが育てる新品種の花は、人間の目には変な感じに映るんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490317,
					"content": "彼女のガーデナー人生が気になるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "そりゃそうだろ！オイラはコスンツァーナのガーデニングの先生だからな。もしコスンツァーナが出場して受賞できたら、オイラも鼻が高いしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490319,
					"content": "賞のことは気にしないで。楽しむのが大事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "…それもそうだよな！コスンツァーナが自分で育てた花がきれいだと思っていれば、それで十分だ！他人の評価なんて、そんなに重要なもんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490321,
					"content": "だからおまえは花畑の世話をして、きれいな花を見て、毎日楽しく過ごすんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490322,
					"content": "ウン！あたし、異国のお花をすくすく育てるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490323,
					"content": "少なくとも最初の一歩は踏み出せたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "そうだな。それにコスンツァーナが育てる品種はフツーじゃないかもしれないけど、独創的なものが好きな人もいるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490325,
					"content": "コスンツァーナ、新品種ができたら、真っ先にオイラたちに教えてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490326,
					"content": "#もちろん。パイモンと{NICKNAME}はあたしのこと、いっぱい助けてくれたもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コスンツァーナ"
				}
			]
