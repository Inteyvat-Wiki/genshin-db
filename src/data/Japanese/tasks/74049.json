				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#あ！異国のお花を持って来てくれた{NICKNAME}とパイモンだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490102,
					"content": "よう、コスンツァーナ。オイラたちが持ってきた花はすくすく育ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490103,
					"content": "それが…もう丸一日見に行けてなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490104,
					"content": "え、オイラたちが持ってきた花、気に入ってたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490105,
					"content": "せっかくの異国のお花だから、急いでお世話しに行こうとしたの。でも目の前で枯れてしまうかもって思ったら、見に行けなくなっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490106,
					"content": "#ウソだろ、そんなこと気にしてたのかよ？…じゃあ、一緒に見に行ってやるよ。何か問題があったら、このパイモンと{NICKNAME}が助けてやるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490107,
					"content": "びくびくしてても仕方ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#…そうだね、一緒に行こう！パイモンと{NICKNAME}が助けてくれるなら、あたしも安心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コスンツァーナ"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
