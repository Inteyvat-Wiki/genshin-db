							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "うっ、うえっ…貴重なお花が、台無しに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490202,
					"content": "ほんとに残念だったな…花が育たないのは、ブリーチャープリムスに破壊されるからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490203,
					"content": "…あ、あたし、これからお花をそばで守って、一歩も離れないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490204,
					"content": "落ち着けって、コスンツァーナ。一緒に方法を考えよう！それにしても、ブリーチャープリムスはなんで花畑を破壊したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490205,
					"content": "今までも、別の花を持ち帰ったとき…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "一度もないよ！うう…隠れて悪さをする悪党め！もう怒ったんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "コスンツァーナ"
				},
				{
					"id": 740490208,
					"content": "うわ…コスンツァーナでもそんなに怒ることがあるんだな。この花を本当に大事にしてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490209,
					"content": "でも思い返してみると、さっきコスンツァーナが近づいたときも、ブリーチャープリムスは避けようとしてなかったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490210,
					"content": "花に引き寄せられてるわけじゃないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "そうだな、その可能性もあるぞ。花畑の周りを調べてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740490206,
					"content": "…邪魔されたことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
