	"talks": [
		{
			"id": 7150201,
			"completionStepIds": [
				7150201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150201",
							"2"
						],
						"stepId": 7150201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715020101,
					"content": "来てくれたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020102,
					"content": "おう、手伝いに来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715020103,
					"content": "今、「プルシナスパイク」をチェックしているところだ。璃月の鉱夫たちは逞しいよ。たった二人だけで、このスパイクをここまで運んでくれるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020104,
					"content": "ただ、「プルシナスパイク」は繊細なパーツを含んでいる。運送時にその影響を受けていないか確かめないといけない…当然、理論上は問題がないはずだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020105,
					"content": "#前回も理論上は問題ないとか言ってたけど、オイラと{NICKNAME}は大変な目に遭ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715020106,
					"content": "コホン、理論と現実には違いが生じるものだ。でも、君が来る前にすべてチェックしたから大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020107,
					"content": "準備はもう終わったから、あとは起動させるのみ。元素力で「プルシナスパイク」に初期の駆動力を与えずとも、継続的にチャージされるようになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020108,
						715020109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020108,
					"content": "初期の駆動力が必要ない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020110
					]
				},
				{
					"id": 715020110,
					"content": "そう、以前は稲妻の環境に適応させるため、雷元素でチャージして動作するように改造した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020111,
					"content": "でも、あれは「プルシナスパイク」が持つ本来の起動方法ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020112
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020112,
					"content": "元々「プルシナスパイク」はこのような環境で動作することを想定している。この黒泥がそのエネルギー源だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020113,
					"content": "黒泥がエネルギーを供給するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020114
					]
				},
				{
					"id": 715020114,
					"content": "そういうことだ。つまり「プルシナスパイク」なら、今回の件を見事解決できるってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020115,
					"content": "考えてみてくれ。今、層岩巨淵で起きている「湧き出す黒泥」をどうにかするには、「病状」と「病巣」という二つの側面から問題を解決しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020116,
					"content": "その「病巣」とは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020117,
						715020119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020117,
					"content": "地脈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020118
					]
				},
				{
					"id": 715020118,
					"content": "その通り。「病巣の治療」をするには、地脈にある黒泥が湧き出る部分を封鎖する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020122
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020122,
					"content": "でも地脈を封鎖しただけでは、既に湧き出ている黒泥をすべて解決したことにはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020123,
					"content": "「プルシナスパイク」は黒泥のエネルギーを吸い取り、その汚染性を減らすことができる。つまりこれが「病状の治療」になるというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020124
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020124,
					"content": "地脈から湧き出る黒泥が「プルシナスパイク」にエネルギーを供給し、そして「プルシナスパイク」が動作することで、黒泥が湧き出る地脈を封鎖できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020125
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020125,
					"content": "長いこと黒泥の影響を受けてきた魔物たちも、そのエネルギーが無くなれば急激に弱体化するはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020126
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020126,
					"content": "おお！これで黒泥と地脈や魔物の問題を全部解決できるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715020127,
					"content": "オイラが思ってたよりずっとすごいものだったんだな、この「プルプルスパイク」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715020128,
					"content": "「プルシナスパイク」だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020129
					]
				},
				{
					"id": 715020129,
					"content": "プルシナ先輩は本当に偉大だよ。まるでこのスパイクも、こういった問題を解決するために作られたかのような感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020130
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020130,
					"content": "もし推測通り事が運んで、この湧き出る黒泥を解決できれば、貴重な実験事例になるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020131
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020131,
					"content": "もしかすると、この「プルシナスパイク」の研究を通じて、プルシナ先輩がどうやって機器で地脈に影響を与えているのか、その原理を解明できるなんてことも…そうしたら、今までに見たことないものをたくさん発見できるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020132
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020132,
					"content": "この研究課題はかなりの価値がある。あぁ…この研究で「教令院」の「カビカバス賞」を受賞できたらいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020133,
						715020134
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020133,
					"content": "カビカバス賞？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020135
					]
				},
				{
					"id": 715020135,
					"content": "これは「教令院」が若き学者へと贈る特別な賞だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020136
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020136,
					"content": "毎年、学院の賢者たちがその年に提出された研究レポートを読んで、投票で受賞者を決めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020137
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020137,
					"content": "受賞資格のある者は40歳以下で、研究している課題が画期的、かつ優れた革新力を持ち、自己啓発を怠らない人に限られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020138
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020138,
					"content": "40歳までに「カビカバス賞」を受賞した学者は皆その後、スメールの学術界に名が知れ渡っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020139
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020139,
					"content": "そんなにすごいのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715020140,
					"content": "すぐに「プルシナスパイク」を起動しよう。これで鉱区に湧いた黒泥を取り除ければいいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020141
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020141,
					"content": "#ただ、{NICKNAME}、気を付けてほしい。「プルシナスパイク」は偉大な機械だが、それゆえ精密で壊れやすい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020142
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020142,
					"content": "もし動作中に衝撃を受けたり、黒泥に覆われたりしたら、スパイクは直ちに自動停止する。より深刻なダメージを回避するためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020143
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020143,
					"content": "だから、チャージ中は黒泥と近づいてくる魔物たちに気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020134,
					"content": "それって何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020135
					]
				},
				{
					"id": 715020119,
					"content": "湧き出る黒泥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020120
					]
				},
				{
					"id": 715020120,
					"content": "いや、湧き出る黒泥は表面的な問題に過ぎない。その根本は地脈にある黒泥が湧き出る部分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020121,
					"content": "だから「病巣の治療」とは、つまり「プルシナスパイク」で地脈を封鎖するということになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020122
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715020109,
					"content": "継続的にチャージされる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020110
					]
				}
			]
		}
	]
}