				"points": []
			},
			"dialogs": [
				{
					"id": 210080501,
					"content": "仲間は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "仲間は火鉢に燃料を入れる担当で、私が火をつける担当なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080503,
					"content": "かなり細かいけど、明確な役割分担は大事だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
