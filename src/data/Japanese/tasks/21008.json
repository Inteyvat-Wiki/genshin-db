				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "たいまつまた消えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080001,
					"content": "たいまつがどうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "ああ、旅人…この先に三つの監視塔があるでしょ？その上にあるたいまつは燃えてないといけないはずだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080003,
					"content": "帰離原の道は歩きにくいし、怪物もたくさんいるでしょう。たいまつは道を照らすと同時に、怪物による脅威がないことを示す目印でもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080004,
					"content": "でも…周りの怪物を倒した時、たいまつに火をつけるのを忘れてたんだ。気付いたらたいまつの火が全部消えていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "どうして自分で行かないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "実はね、たいまつの状況を確認しに来る人がいるんだ…ここで時間稼ぎをしなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080103,
					"content": "君だけがここに立っていたり、そもそも誰もここにいなかったら、大変じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080104,
					"content": "頼むよ、旅人！たいまつをつけてきてほしいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
