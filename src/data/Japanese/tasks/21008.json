			"dialogs": [
				{
					"id": 210080201,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "うん、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080203,
					"content": "この先に三つの監視塔があって、それぞれ火鉢があるんだ。それに全部火をつけたら、戻ってきて教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080204,
					"content": "道の突き当りに「七天神像」があるんだけど、時間があったら行ってみるといい、一応それも岩王帝君のご加護だからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080205,
					"content": "とにかく、頼んだよ。忘れないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
