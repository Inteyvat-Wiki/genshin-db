				{
					"id": 210080401,
					"content": "帰離原の道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "帰離原は岩の平原だから、険しいところがあるんだ。たとえば西の見張りの丘とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 210080403,
					"content": "でも東の海に近い位置は平坦だから、瑶光の浜とかおすすめだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "星火"
				}
			]
		},
		{
