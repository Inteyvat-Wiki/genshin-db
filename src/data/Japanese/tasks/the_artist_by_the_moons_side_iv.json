			"dialogs": [
				{
					"id": 761200301,
					"content": "うん、素敵だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200302,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200303,
					"content": "気に入ってくれたみたいだな。さっそく描きはじめたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200304,
					"content": "こうしてみると、メイラの絵って、コロンビーナが生まれてからこれまでをぎゅっと詰めた物語みたいなもんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200305,
					"content": "物語はこれからも続くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "おう！凄腕画家の新作をもっと見たいしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200307,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200308,
					"content": "おっ！もう描き終わったのか？相変わらずの早業だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200309,
					"content": "どれどれ…おお…！すごくきれいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200310,
					"content": "月から眺めるテイワットって、こんなにきれいなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200311,
					"content": "ふっ…なんでメイラに変わったって言われたのか、理由が分かったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200312,
					"content": "えっ？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200313,
					"content": "この絵で思い出したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200314,
					"content": "あのとき、月からテイワットを眺めながら、ふと思ったんだ。ずっと家を探して彷徨ってきたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200315,
					"content": "こんなにもきれいな「家」が二つもできたってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200316,
					"content": "大切なものがある場所、家族や友達がいる場所こそが「家」だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200317,
					"content": "素敵な考えだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "ありがとう。これからも時々、月霊たちを連れて月に遊びに行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200319,
					"content": "キミたちもよかったら来て。私のもう一つの家に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
