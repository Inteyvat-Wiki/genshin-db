			"dialogs": [
				{
					"id": 761200101,
					"content": "…はい。私の部分はこれでいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200102,
					"content": "ん？キャンバス！？ってことは…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200103,
					"content": "いいタイミングだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200104,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200105,
					"content": "大芸術家、メイラじゃないか！久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200106,
					"content": "いいタイミングって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "さっきメイラを連れて月に行ってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200108,
					"content": "「隣の花畑を散策してきた」みたいに簡単に言うなよな。くーっ、羨ましいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200109,
					"content": "月へはなにしに行ったんだ？絵の取材か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200110,
					"content": "半分正解。月で「画展」を開く場所を決めてきたの。画展のこと、覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200111,
					"content": "ああ、もちろん覚えてるぜ。月神をテーマに、大芸術家メイラの作品を展示するってやつだろ？ぜったい招待してくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200112,
					"content": "もちろん。メイラはね、周りの細かい変化を察知できるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200113,
					"content": "私が月から戻ってから、変わったって言われてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200114,
					"content": "月に何か特別な秘密があるのかもって、案内を頼まれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200115,
					"content": "なるほど。さすが芸術家だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200116,
					"content": "それで何か分かった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "ううん、いろいろ回ったけど、どこもしっくり来なかったみたいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200118,
					"content": "それで、キミが乗ってた宇宙船のあるところに向かったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200119,
					"content": "宇宙船？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "でも、メイラが気になったのは宇宙船そのものじゃなかったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200122,
					"content": "えっ？どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200123,
					"content": "～！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200124,
					"content": "ん？おまえの周りをグルグル回ってるけど、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200125,
					"content": "ふふっ、あの時もこうだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200126,
					"content": "たぶん、宇宙船を見たときの私の様子が気になったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200127,
					"content": "どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200128,
					"content": "宇宙船を見たとき、旅人と一緒に来た日のことを思い出したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200129,
					"content": "あの日、旅人と一緒に船の中からテイワットを眺めてた。旅人は過去の真実を見つけて、私は「家」を見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200130,
					"content": "今でも思い出すと、穏やかで幸せな気持ちになるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200131,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200132,
					"content": "うん、こんな気分は生まれて初めて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200133,
					"content": "それで、いろいろ聞かせてあげてた。キミと一緒に月に行ってから起きたこととか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200134,
					"content": "そしたら、絵のアイデアが浮かんだみたいで喜んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200135,
					"content": "そうだったのか。じゃ、いよいよ大芸術家が筆をとるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200136,
					"content": "月の旅で得たインスピレーションがどんな大作を生むのか、楽しみだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200137,
					"content": "今回は何で絵の具を作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "今回はちょっと特別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200139,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 761200140,
					"content": "私たちだけの絵の具がほしいって、メイラが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200141,
					"content": "ん？どういう意味なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200142,
					"content": "旅のこととか、旅で得た喜びが思い出されるような、そんなものがいいかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200143,
					"content": "心配しないで、見せるだけでいいから。旅人の大切な物を絵の具にしちゃったりなんかしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200144,
					"content": "コロンビーナは何を見せてあげたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "月の土と、みんながくれた祈月の夜のカード。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761200146,
					"content": "なるほど。つまり、今回の冒険の旅を象徴するものってことだな？旅人、おまえに任せるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761200120,
					"content": "確かに「特別」だけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
