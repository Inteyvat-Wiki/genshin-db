			"dialogs": [
				{
					"id": 756640101,
					"content": "#{NICKNAME}とパイモン！ははっ、やっと会えたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640102
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640102,
					"content": "栄華の演武へようこそ。ここがメイン会場だ。君たちが参加するという話は、族長たちから聞いてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640103
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640103,
					"content": "よろしくな！でも、ルールとかあまり知らなくて…説明してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756640104,
					"content": "じゃあ、簡単に紹介しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640105
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640105,
					"content": "栄華の演武は「攻略戦」と「防衛戦」に分かれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640106
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640106,
					"content": "防衛戦は簡単だ。相手が部族に攻め入るのを防げばいい。一方、攻略戦は少し複雑だ。自分たちの部族がすでに陥落したと仮定して、反撃に出るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640107
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640107,
					"content": "試合を面白くするために、特別な儀式道具も作ったんだ。攻撃側はその道具にエネルギーをチャージして、相手の張った結界を破らないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640108
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640108,
					"content": "試合とはいえ、むやみな衝突や暴力は避けるべきだ。壊したものは直して、魔物に遭ったらできるだけ早めに倒してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640109
					],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640109,
					"content": "#うぅ…オイラ、もう頭がパンパンだぞ。{NICKNAME}、覚えられたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640110,
						756640111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756640110,
					"content": "パイモンと同じ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				},
				{
					"id": 756640112,
					"content": "心配するな。分からないことがあったら、遠慮なく聞いてくれ。そんなに難しいルールじゃないから、何回かやってみればすぐにコツが掴めるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バロー"
				},
				{
					"id": 756640111,
					"content": "ぜんぜん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				}
			]
		}
	]
}