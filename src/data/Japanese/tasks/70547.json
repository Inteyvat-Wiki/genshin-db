				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "わっ！ネコネコ救世主様とネコネコ白魔法使いさん！よくぞお越しくださいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470102,
					"content": "えっと、いまオイラたちのことなんて呼んだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705470103,
					"content": "どこかで聞いたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "うーん…でも、前にも会ったことがあるような気がするぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705470106,
					"content": "あははっ！ネコネコ白魔法使いさんは私のことを覚えてくれていたようですね！ヴァレリナ大感激です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470107,
					"content": "まあ、昔話はまたにして…今は私がスポンサーしている新しいゲームをやってみませんか？この一週間、私をずっと夢中にさせている——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470108,
					"content": "——ドドコドッカン大乱闘を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470109,
					"content": "い…いろんな種類のドドコがいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705470110,
					"content": "しかも、どれも見たことある気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "ささ、ネコネコ救世主…コホン、ではなく！光り輝く！偉大なる栄誉騎士さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470113,
					"content": "このドドコぬいぐるみは、あなたをイメージしてデザインしたものなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470114,
					"content": "#ほんとだ！色も模様も{NICKNAME}っぽいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705470115,
					"content": "このゲームは、火花ドドコ、閃光ドドコ、騎兵ドドコ、魔法ドドコが力を合わせ、これまでに立ち向かったことのないような敵に、爆弾で挑むというものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470116,
					"content": "私はゲームのスポンサーと運営のみを担当しているので、開発の詳細については把握していません。敵のモデルが現実世界ではどのような姿をしているかも知りません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470117,
					"content": "でも、いつか本当に現実で鉢合わせたとしても、不思議なドドコならきっと勝てるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470118,
					"content": "もちろんだぞ！オイラも、どんな魔物でもクレーとドドコを止められないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705470119,
					"content": "じゃあ、戦ってみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "へへっ、お二人もきっと楽しめますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705470120,
					"content": "#ドドコの新しい{M#ゲームだ}{F#ゲーム}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "誰をモデルにしてるか分かりやすい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "聞いたことのないあだ名…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}