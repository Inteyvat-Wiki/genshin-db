					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "はい！おつかれ、これあげる、遊んでくれてありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}これからもいい人でいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000305,
					"content": "おいおい、キャプテンはそろそろオレの番だろう",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000306,
					"content": "次ね。次のキャプテンは君だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000307,
					"content": "ふん、前回もそう言ってたのに…",
					"roleType": "TALK_ROLE_NPC",
