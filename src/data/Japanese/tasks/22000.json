			"dialogs": [
				{
					"id": 220000501,
					"content": "掃除終わった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000502,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "#早く掃除してね、これは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}が道を正すチャンスだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000504,
					"content": "あのさあ、掃除をやるだけで良い人になれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000505,
					"content": "良いことをするのが良い人だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000506,
					"content": "そんな簡単になれるもんかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000507,
					"content": "良いことすれば良い人、悪いことをすれば悪い人、そういうこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000508,
					"content": "そう言われてもね、もし本当にそうだったら、世の中に悪い人はいないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000509,
					"content": "口で言うのは簡単だけど、それを実行するのはむずかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000510,
					"content": "良いことよりも悪いことの方が簡単だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000511,
					"content": "これも北斗姉さんから教わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000512,
					"content": "本に書いてあった",
