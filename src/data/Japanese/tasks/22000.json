			"dialogs": [
				{
					"id": 220000101,
					"content": "今日は何して遊ぶの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000102,
					"content": "うーん、もし海賊をやる人がいなかったら、今日もできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000103,
					"content": "でも、みんな海賊をやりたくないんだよね。どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000104,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "遊んでるの、でもいつも海賊をやる人がいなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000106,
					"content": "海賊をやる人がいないから、ずっと遊べないまま…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000107,
					"content": "#そうだ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！海賊役やってもらえる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000108,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "やった！じゃあ準備してくるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000115,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}準備が終わったら、来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 220000110,
					"content": "それはちょっとわかんないな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "大丈夫よ、海賊は…うーん、なんか乱暴で、他人のものを奪う悪い人だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000112,
					"content": "まあボクも見たことないから、北斗姉さんから聞いただけだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000113,
					"content": "でも…そういう役は真似しやすいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000114,
					"content": "#へへ、とりあえず、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "モン"
				}
			]
		},
