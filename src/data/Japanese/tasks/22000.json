					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "じゃあ始めようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000203,
					"content": "どこから始めるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000204,
					"content": "えっと、金を出せ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "うわああ！海賊だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220000206,
					"content": "ルルこっち来て、オレが守ってあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220000207,
					"content": "あなたは海賊だよね、なぜこんなことするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000208,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は海賊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "海賊にもいい人と悪い人がいる。必ず奪うわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000211,
					"content": "北斗姉さんも海賊って名乗るけど、すごい優しい人だよ。美味しいものをくれるし、みんな大好きなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000212,
					"content": "#なんで{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}は良い海賊じゃなくて、悪い海賊をやるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000213,
					"content": "おまえらが海賊は「乱暴」な人だって言ってたじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220000214,
					"content": "ごめん、間違えた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "うん、道を正すのはいいことだよ。北斗姉さんもよく言っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220000217,
					"content": "じゃあ、周りの掃除をお願い。いいことをすればいい人になれるよ、いい海賊にもなれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 220000215,
					"content": "良い人になりたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "海賊は金を奪う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
