				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "まさか、ここの環境がこんなにも特殊だとは…こうなると、「プルシナスパイク」のエネルギーシステムは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010202,
					"content": "#ん？{NICKNAME}にパイモンじゃないか。実に久しぶりだ。なんで君たちが層岩巨淵に…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010203,
					"content": "そういえばへディーヴから聞いたけど、層岩巨淵で探検隊を色々助けたんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010204,
					"content": "でも今、層岩巨淵の環境は以前よりも悪化していて、危険に満ちている。あまり歩き回らないほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010205,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "少し前に会ってるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010207,
					"content": "会うたび、確かに色々と迷惑をかけてはいるが…知らないふりをすることはないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010208,
					"content": "まぁいい、改めて自己紹介をするよ。私はスメール「教令院」の学者のホッセイニ。以前は、「エネルギー原盤」の研究をするため、稲妻へと考察しに行っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010209,
					"content": "だが現在、研究経費を使い切ってしまってね。スメールに帰らざるを得ない状況になってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010210,
					"content": "あっ、オイラ少しだけ覚えてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010211,
					"content": "私のことを思い出してくれたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010212,
					"content": "おまえは——たしか「原盤マン」だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010213,
					"content": "…いや、「原盤マン」でないことだけは断言できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010214,
					"content": "とにかく、スメールへ帰る道中、同じく「教令院」の学者であるへディーヴから依頼を受けた。彼には以前、研究経費のことで少し世話になっていてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010215,
					"content": "だから、彼の抱えている問題を解決するため、層岩巨淵まで来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010216,
					"content": "こっちの説明はこれで十分かな。それで君たちは？なんでこの時期に層岩巨淵へ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010217,
					"content": "へディーヴの依頼を受けた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "おお、君たちがそうだったのか。へディーヴが誰かに協力してもらおうと言った時、少し心配だったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010220,
					"content": "でも、君たちなら安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010221,
					"content": "もし今回、層岩巨淵に湧いている黒泥を解決するのが私一人だけだったら、かなり手間がかかっていただろう。君たちが協力してくれるなら、問題を解決できる確率も…少し高くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010222,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "「プルシナスパイク」は知ってるかい？地脈を乱す力を放出できる機器だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010224,
					"content": "私の推測では、黒泥の湧き出るところに「プルシナスパイク」を配置すれば、地脈の活動が乱れ、黒泥を取り除くことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010225,
					"content": "えっと、黒泥と地脈になんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010226,
					"content": "あれらの黒泥は地脈の変動を受けてここに現れた。地脈と関係がある可能性は極めて高い…それが私とへディーヴが話し合って出した結論だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010227,
					"content": "だから、プルシナスパイクを使って乱すことにより、ここの地脈と外を繋ぐ出口を閉じれば、黒泥が湧き出るのを止めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010228,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "しかし、今まではプルシナスパイクで「地脈を乱していた」だけ…「完全に封鎖する」のはこれが初の試みだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010230,
					"content": "私は計算をして、プルシナスパイクのパラメータを調整した。理論上では失敗しないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010231
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010231,
					"content": "ただ理論はあくまで理論に過ぎない。実験を行ってそれを検証する必要がある。先ほど私は試運転をするつもりでいたんだが、実験にはリスクが付きものだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010232
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010232,
					"content": "#{M#俺}{F#私}がやってみるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010233
					]
				},
				{
					"id": 715010233,
					"content": "うん…それなら、君に任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010234
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010234,
					"content": "私も隣で観測しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715010218,
					"content": "手伝いに来た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
