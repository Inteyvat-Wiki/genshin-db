			},
			"dialogs": [
				{
					"id": 715010101,
					"content": "はぁ…ここ最近、状況がさらに悪化していますね。探検隊の行動も制限されてしまっている様子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010102,
					"content": "このような依頼を解決できる人は、本当にいるのでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010103,
						715010104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010103,
					"content": "どうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				},
				{
					"id": 715010105,
					"content": "あっ、お二方とも、ちょうどいいところにいらしてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010106,
					"content": "ちょうどいいところ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010107,
					"content": "また何か面倒なことが起きたっぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010108,
					"content": "原因は不明なのですが、ここ最近層岩巨淵の鉱坑と坑道から急に泥状の黒いものが大量に湧いて出てくるようになったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010109,
					"content": "予想外の状況により探検隊もすぐに対応できず、調査も滞っています。そこで、へディーヴさんが冒険者協会に助っ人を探すよう依頼を出しまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010110,
					"content": "ん？泥状の黒いもの？もしかして、層岩巨淵の下にあったあれのことかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010111,
					"content": "ええ、おそらくその黒泥のことです。なぜかは分かりませんが、鉱坑と坑道にまでそれが湧いているのです。これにより探検隊の調査に支障が出ており、普段の行動にも影響が出ています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010112,
					"content": "多くの資源と材料は、坑道を通して運ばなければなりませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010113,
					"content": "それってどれくらい前から？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010114
					]
				},
				{
					"id": 715010114,
					"content": "発生からしばらく経っています。へディーヴさんは協力してくれるスメールの学者を見つけたと言っていましたが、その学者にも助っ人が必要な状況です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010115,
					"content": "この件を解決してくれる人がおらず、困っておりまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010116,
					"content": "へディーヴの依頼なら、報酬もたっぷりだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010117,
					"content": "誰か引き受けようとしてくれる人はいないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010118,
					"content": "あの泥状の黒いものは危険ですから…この依頼を受けてくれる人がいないのです。報酬目当てで話を聞きに来た人もたくさんいましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010119,
					"content": "いざ層岩巨淵のことだと聞くと、多くの冒険者が尻込みしてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010120
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010120,
					"content": "それに、大半の冒険者は層岩巨淵の下の環境に慣れていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010121
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010121,
					"content": "この依頼を受けるのであれば、危険を恐れず、層岩巨淵の環境をよく知っている人でないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010122,
					"content": "この件に相応しい人がいないかと悩んでいたところ、あなたたちが通りがかってくれたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010123
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010123,
					"content": "#そうだったんだな。{NICKNAME}、本当に大変な状況みたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010124,
						715010125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010124,
					"content": "うん、様子を見に行かないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010126,
					"content": "おう！それじゃあ、層岩巨淵に行ってへディーヴを探そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715010127,
					"content": "あっ、それでしたら…直接スメールの学者に会ってほしいと、へディーヴさんは言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010128
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010128,
					"content": "「もし来てくれる人がいたら、層岩巨淵の拠点に行くよう伝えればいい。あいつはずっとそこで設備を調整しているから」とのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010129
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010129,
					"content": "分かった、すぐ行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010130
					]
				},
				{
					"id": 715010130,
					"content": "はい、層岩巨淵の安全は、あなたたちに託しました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 715010125,
					"content": "へディーヴを手伝うことにしよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010104,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				}
			]
		},
		{
			"id": 7150102,
			"completionStepIds": [
				7150102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
