				]
			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "二人とも、おかえりなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410102,
					"content": "でも、まだ別れを告げる時ではないわ。まだ、この小屋の全てを見終えたわけではないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410103,
					"content": "もう全部の部屋を見て回ったはずだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761410104,
					"content": "隠し部屋が無いだなんて言ったかしら？魔女は、何に対してもちょっとした遊び心を加えるものよ。覚えておいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410105,
					"content": "さあ、どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ニコ"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "世界の変化を見守る不動の観測点として、あたしには良好な視界条件が必要なの。彫刻家がたがねを、作家が筆を必要とするようにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410202,
					"content": "その両方の分野におけるあたしの実績はさておき…本職に関しては、大真面目に取り組んでいるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410203,
					"content": "近頃、テイワットの「運命」が揺らぐ事象が目に見えて増えていることを、あなたも実感しているでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410204,
					"content": "たまに、ふと考えてしまうのよね。もし今のあたしに、全盛期の姿や力、能力が備わっていたら、もっといろんなことができたのではないかって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410205,
					"content": "でも、そんな考えはすぐに否定するの。だってその場合、「高天」から受ける制約も増えてしまうもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410206,
					"content": "触れてはいけない話題が増えることを考えると、割に合わないわよね。そうなると、まともに物語も話せないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410207,
					"content": "だからあたしは、払った代償にも、下した全ての選択にも後悔はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410208,
					"content": "人間になって、普通の暮らしがしたいと思うこともあるけれど、そんなのは贅沢な夢でしかないわ。あたしは、自分が「天の使い」であることを決して忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410209,
					"content": "たとえ寡黙なる天の使いだとしても、自分の使命を全うするわ。文明を守り、地上の生きとし生ける者たちを守るために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410210,
					"content": "あら、うっかり真面目な話をしすぎてしまったわね！この場所がそうさせたのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410211,
					"content": "実はあたし、「天の使い」としての自分を結構気に入っているのよ。誇りと言ってもいいくらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410212,
					"content": "ああ、ニコはすごいぞ！普段はあまり姿を見せないけど、手を貸してもらえる時はとても頼りになるんだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761410213,
					"content": "誇りに思って当然だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "そうかしら？ふふっ、あなたたちがあたしを頼りに思ってくれるなら、あたしも嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410215,
					"content": "さあ、もう行く時間よ。あなたたちの冒険には、あたしの祝福がついてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 761410216,
					"content": "迷うことを恐れないで。そして、ここでとある天の使いが、二人の旅路を静かに見守っていることを忘れないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
