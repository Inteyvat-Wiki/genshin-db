			"dialogs": [
				{
					"id": 755090101,
					"content": "ねえねえ、瑞希！聞いてよ。さっきアミナと話したんだけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090102,
					"content": "イベントが始まってから「流泉の衆」の観光客が四割も増えたんだって！そんなに宣伝してないのにだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090103
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090103,
					"content": "それはよかった。こっちもいい知らせがあるよ。ここ最近、心理療法を受けに来るお客さんが、前の十分の一に減ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090104
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090104,
					"content": "つまり、このイベントで気分転換とリラックスの場を提供して、悩みを忘れてもらうって目標は達成できたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090105
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090105,
					"content": "えへへっ、次はイベントをもっと大きくしよう！「ビートボール」だけじゃなくて、もういくつか新しいゲームを追加してさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090106
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090106,
					"content": "そしたら、リラックスしたいお客さんには温泉や日光浴を楽しんでもらって、盛り上がりたい人にはゲームを遊んでもらうの。これぞ「流泉の衆」の最高のバカンスだよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090107
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090107,
					"content": "よっ！ムアラニ、瑞希！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090108,
						755090109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090108,
					"content": "音楽とゲームの天才が戻ってきたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090110
					]
				},
				{
					"id": 755090110,
					"content": "おっ、その表情と言葉からもうビンビン伝わってるよ～！満足してもらえたんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090111
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090111,
					"content": "もちろんだぞ！たっぷり遊べただけじゃなく、お腹いっぱい食べられたしな！特にあのバイキング…「温泉タイム」を五人前もいただいちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090112,
					"content": "ビートボールで遊んでたこいつは、ご飯を食べてるときのオイラよりも勢いが凄まじかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090113,
						755090114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090113,
					"content": "えっへん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090115
					]
				},
				{
					"id": 755090115,
					"content": "「ビートボール」をやってるときの君を見たけど、思わず手に汗握っちゃったよ！テクニックもすごかったね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090116
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090116,
					"content": "次またイベントをやるときは、一緒に企画を考えてほしいな。君の好きなゲームをいくつか作って、みんなに楽しんでもらおうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090117
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090117,
					"content": "うん、それは旅人の得意分野らしいしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090118
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090118,
					"content": "あたしも、また一緒に協力できる日を楽しみにしてるよ。いっそ…旅人はムアラニの「顧問」に立候補したらどうかな？この近くに部屋も借りてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090119
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090119,
					"content": "ナイスアイデア！空いてる部屋がないか聞いてみるよ！そうだ、せっかくだし瑞希のお店の隣は空いてないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090120
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090120,
					"content": "いいね。そしたら、みんなご近所さんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090121,
						755090122
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090121,
					"content": "#{M#俺}{F#私}たちもお店を開きたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090123
					]
				},
				{
					"id": 755090123,
					"content": "毎日、温泉バイキングでお腹いっぱい食べられるようになるのか…えへへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090124,
					"content": "決まった住所があれば、あんたたちを探すのも楽になるしね、いいじゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090125
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090125,
					"content": "はは…まさか、ウチが人を探すほうの立場になって考える日が来るとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090126
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090126,
					"content": "あっ、シロネン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090127,
					"content": "「ビートボール」の選曲、どれもよかったぜ。遊んでると、勝手に身体が動いちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090128,
					"content": "気に入ってもらえてよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090129
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090129,
					"content": "ここ数日見てて分かったけど、あんたたちはミュージシャンとDJ、両方の素質を持ってるっぽいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090130
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090130,
					"content": "たぶん、いろんな文化の音楽を聴いてきたからかな、メロディーを聴くと自然とリズムを掴めるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090131
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090131,
					"content": "最先端の音楽は、多種多様な要素を取り入れる傾向にある。もしかしたらいつか、あんたたちに音楽のアドバイスもらう日がくるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090132
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090132,
					"content": "これ受け取って。暇なときにでも聴いてみてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090133
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090133,
					"content": "これは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090134,
					"content": "あっ！シロネンの選んだ曲がいくつか入ってるレコードでしょ。「花歌レコード」に置いたら、一瞬で売り切れちゃう人気商品だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090135
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090135,
					"content": "そういえば、前にシロネンのおすすめするレコードや楽器が手に入らなくて悩んでるお客さんがいたよ。うちで特別な治療をしてあげたっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090136
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090136,
					"content": "瑞希って、そんな症状までどうにかできるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090137
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090137,
					"content": "彼女の負の感情を和らげて、それからレコード店でのバイトを勧めただけだけどね。そうすれば真っ先に最新情報を手に入れられるし、キミのオススメを見逃すこともないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090138
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 755090138,
					"content": "さすが…でも、その裏技はあんま広めないでやってあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090139,
						755090140
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755090139,
					"content": "このレコード、大切にするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090141
					]
				},
				{
					"id": 755090141,
					"content": "だな！時間を見つけて、シロネンのオススメをたくさん聴いておこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090142,
					"content": "いつかゲームを作るってなったときに、今回みたいな…のれる音楽を選べるようにならないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090143,
					"content": "じゃあ、次に会うときはみんなをあっと言わせるような企画の出し合いっこだね！約束だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755090144
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 755090144,
					"content": "へへっ、まだ今回のイベントが終わってないのに、もう次が楽しみになってきたぜ。なんだかこのまま「流泉の衆」に住みたくなってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755090140,
					"content": "時間があるときに聴かせてもらうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090141
					]
				},
				{
					"id": 755090122,
					"content": "#パイモンも{M#俺}{F#私}も大賛成！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090123
					]
				},
				{
					"id": 755090114,
					"content": "パイモンほどじゃないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090115
					]
				},
				{
					"id": 755090109,
					"content": "楽しかったから高評価を付けにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755090110
					]
				}
			]
		}
	]
}