				{
					"id": 207432001,
					"content": "道の片付けは終わりましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 207432002,
					"content": "終わったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "よかった、これでワイナリーの商売も元に戻れますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 207432004,
					"content": "本当は先にディルック様に報告するべきですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 207432005,
					"content": "ディルック様はまた行方不明になったんです。ワイナリーにいる全員に聞きましたが、誰も知らなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 207432006,
					"content": "唯一手がかりも持つアデリンは「ディルック様は私用で出かけた」としか教えてくれなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 207432007,
					"content": "はあ、いいです。ディルック様が戻られたら、一度話し合います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルザー"
				}
			]
		}
