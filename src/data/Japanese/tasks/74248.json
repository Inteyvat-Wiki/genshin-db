			"dialogs": [
				{
					"id": 742480201,
					"content": "「テーブルトークシアター」って、すっごく楽しいんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480204,
					"content": "うん、悪い吸血鬼も家に帰らなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
