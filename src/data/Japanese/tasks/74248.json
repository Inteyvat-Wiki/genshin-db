				]
			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "コロンビーナさん、サンドローネさん！忙しい中、あたしたちのテーブルトークシアターに参加してくれて、本当にありがと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480102,
					"content": "気にしないで。二人とも初心者だから、むしろ面倒をかけるかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480103,
					"content": "気負う必要はない。皆で物語を楽しもう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 742480104,
					"content": "うん。楽しみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480105,
					"content": "では、私から今回の物語の背景について簡単に説明しよう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 742480106,
					"content": "「この物語は吸血鬼と人類が共生する時代、二つの種族が共に暮らす街で繰り広げられる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "演-クロリンデ"
				},
				{
					"id": 742480107,
					"content": "「両種族の関係性は敵対しているとも、調和がとれているとも言えない。しかし、この辛うじて保たれていた均衡は、ある夜の事件をきっかけに完璧に崩れ去ることとなった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "演-クロリンデ"
				},
				{
					"id": 742480108,
					"content": "吸血鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480109,
					"content": "人間の血を吸わないと生きていけない種族のことよ。小説なんかじゃ定番の設定ね。そういうのを読んだことない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480110,
					"content": "うーん…聞いたことはあるかも。それで、私たちはその物語の中で何をすればいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480111,
					"content": "まずは、自分がこの世界で演じたい役を決めてくれ。背景設定に合ってさえいれば、身分や職業に制限はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 742480112,
					"content": "演じたい役…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480113,
					"content": "自分で決めるのが難しければ、他の人とお互いに役を決め合っても構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 742480114,
					"content": "え？つまり…他の人に自分のキャラクターの背景設定を考えてもらうってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480115,
					"content": "あっ！面白そうじゃない！そうしましょ！あたしのキャラカードは、クロリンデが書いて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480116,
					"content": "じゃあ、私のキャラクターはサンドローネに決めてもらおうかな。私もサンドローネに合うキャラクターを考えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480117,
					"content": "はぁ…まあいいわ。ワタシも職業をどうするか、決めかねていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480118,
					"content": "みんなもう書けた？えへへ、じゃあまずはあたしの担当キャラから見て行きましょ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480119,
					"content": "「商人。普段は吸血鬼と人間が住む都市を駆け回っている…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "ナヴィア",
					"speakerSubtitle": "行商人"
				},
				{
					"id": 742480120,
					"content": "…ちょっと待って。ゲームマスター、これってあたしの前のキャラカードとほとんど同じじゃない！ステータスまで一緒だし！手抜きでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480121,
					"content": "どうせ、おかしな手段で私に無理難題をふっかけてくるんだろう？それに、あなたにはこういう抜け目がなくて騒がしいキャラクターがふさわしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 742480122,
					"content": "…もうっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 742480123,
					"content": "ふふ。じゃあ、次は私の——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480124,
					"content": "「とっても悪い吸血鬼。昼間はいつも家で寝てて、夜、月が出た時にだけ庭を散歩する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "とっても悪い吸血鬼"
				},
				{
					"id": 742480125,
					"content": "「歌うことが好きで、歌声で獲物を誘惑する。彼女が目を開けるところを見た者は、誰一人として二度と朝日を拝むことはない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "とっても悪い吸血鬼"
				},
				{
					"id": 742480126,
					"content": "ん…私って、サンドローネの目にはこんなふうに映ってたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480127,
					"content": "ふふん、結構似合ってると思うけど？それに、面白いでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480128,
					"content": "そっか。でもやっぱり、できるだけいい吸血鬼になりたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480129,
					"content": "勝手にしなさい。さて、アナタはなんて書いたのかしら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480130,
					"content": "「優雅な貴族のお嬢様。自分の部屋でちょっとした発明品を作るのが好き。夜寝るのが遅く、生活リズムはとても不規則…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "「傀儡」",
					"speakerSubtitle": "吸血鬼ハンター"
				},
				{
					"id": 742480131,
					"content": "ちょっと！こんなことはプロフィールに書かなくていいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480132,
					"content": "まったく…「しかし、吸血鬼ハンターとしても活躍している。街の人が危険に陥ると、すぐさま発明品を携えて駆けつけ、みんなを救う…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "「傀儡」",
					"speakerSubtitle": "吸血鬼ハンター"
				},
				{
					"id": 742480133,
					"content": "…はあ？この設定、ワタシとかけ離れすぎじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742480134,
					"content": "そうかな？私はすごくサンドローネらしいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 742480135,
					"content": "その設定だと、コロンビーナさんとサンドローネさんのキャラクターは対立関係ってことになるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "ナヴィア",
					"speakerSubtitle": "行商人"
				},
				{
					"id": 742480136,
					"content": "ああ、面白い展開が期待できそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "演-クロリンデ"
				},
				{
					"id": 742480137,
					"content": "うんうん！早く始めたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "ナヴィア",
					"speakerSubtitle": "行商人"
				},
				{
					"id": 742480138,
					"content": "はぁ…いろいろと厄介なことが起きそうな気がするわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "「傀儡」",
					"speakerSubtitle": "吸血鬼ハンター"
				},
				{
					"id": 742480139,
					"content": "サンドローネ…もしかして、私がすっごく悪い吸血鬼だから怖くなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "「少女」",
					"speakerSubtitle": "とっても悪い吸血鬼"
				},
				{
					"id": 742480140,
					"content": "はあ？そんなわけないでしょ。アナタを退治するのが待ちきれないくらいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」",
					"speakerSubtitle": "吸血鬼ハンター"
				}
			]
		},
