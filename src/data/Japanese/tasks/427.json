			"dialogs": [
				{
					"id": 4270801,
					"content": "西風騎士団だ、今いいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270802,
					"content": "えっ、なにかしたか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4270803,
					"content": "飛行免許を見せてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270804,
					"content": "ひ、飛行免許は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "免許なしか、モンド治安管理法第7条12項に従い、騎士団まで来てもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270807,
					"content": "君には黙秘権があるが、君の言葉は全て風が覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270808,
					"content": "待って！今、飛行免許のテスト中なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270809,
					"content": "あっ、そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270810,
					"content": "このタイミングでテストとは、間が悪いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270811,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270812,
					"content": "「怪鳥」が風の翼で逃げていったと、修道女から通報があってね。だから、君もヤツの仲間かと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270813,
					"content": "怪鳥？誰だそいつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4270814,
					"content": "モンドの犯罪者だ。いつも風の翼を使って犯行に及ぶから、「怪鳥」の名がついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270815,
					"content": "そいつって、そんなに飛ぶのが速いの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270816,
					"content": "ああ、非常に速い。今回、教会のとある文化財を餌におびき寄せたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270817,
					"content": "まんまと逃げられてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270818,
					"content": "修道女たちが文化財に風元素で目印をつけてくれてたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270819,
					"content": "あまりにも速くて、その痕跡を辿っても追いつけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270820,
					"content": "飛行のプロか。なら、このアンバーの出番だね！どこへ逃げたか分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270821,
					"content": "最後に目撃したのは清泉町周辺だけど、もう時間が経ってるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "アート"
				},
				{
					"id": 4270822,
					"content": "#安心して！ちょうど{NICKNAME}もいるし、その怪鳥を捕まえてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270823,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "怪鳥を捕まえたら、直接発行して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270826,
					"content": "コホン…ジンさんには説明してあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270824,
					"content": "飛行免許のテストは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "ウ、ウサギ伯爵に食べられた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
