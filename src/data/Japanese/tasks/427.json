			"dialogs": [
				{
					"id": 4270401,
					"content": "風の翼のコツが分かってきたみたいだね。じゃあ、最後のテストを始めよっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270402,
					"content": "まあ、このルートは1回飛んでるからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4270403,
					"content": "このテストに合格したら飛行免許をあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4270404,
					"content": "飛行免許に向けて、レッツ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "アンバー"
				},
				{
