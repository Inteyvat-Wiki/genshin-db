				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァーシャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "変だな、なんで子供がこんな場所に一人でいるんだ…？なあ！おまえ、なにやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710102,
					"content": "うわっ！怪人！それに空飛ぶチビ怪人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710103,
					"content": "失礼すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710104,
					"content": "そうね、確かにあたしに教養はないわ。礼儀作法を教えてくれる両親もいないんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710105,
					"content": "（何か事情がありそう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "えっと…なんて言えばいいのか…とにかく、オイラたちは怪人じゃないし、悪人でもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710107,
					"content": "ただの親切な旅人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "そう、だから困ってるやつは放っとけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710111,
					"content": "#そうだ、オイラはパイモン、こいつは{NICKNAME}だ。おまえの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710112,
					"content": "…ヴァーシャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710113,
					"content": "じゃあ、ヴァーシャはなんで一人でこんな場所にいるんだ？迷子なんだったら、オイラたちが送ってやっても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710114,
					"content": "過ぎたことは過ぎたこと。あたし決めたの。もう決して振り返らずに、前を向いてくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710115,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710116,
					"content": "大人の力になんか二度と頼らないで、自分だけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710117,
					"content": "こんな子供がなんでまた、そんな大人びたことを…とにかく、森の中は危険がいっぱいだ。おまえみたいな子供が対処できるもんじゃないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710118,
					"content": "前に悪い人に連れて行かれそうになったけど…大丈夫、その時の教訓があるから、今度はもっと気を付けて危険を回避するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710119,
					"content": "その人は、前に会ったことのあるヴィマラ村のお兄さんだった。表向きは親切だったけど…結局、今まで会った大人たちと変わらなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710120,
					"content": "悪い人に連れていかれそうになった！？ぜんぜん教訓が生きてないじゃないか！待てよ、ヴァーシャはその時どうやって逃げたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710121,
					"content": "動きの素早い小さな何かが、ここまで連れてきてくれたの。ガンダルヴァー村じゃ見たことない生き物よ。あたしは森の精霊だと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710122,
					"content": "（アランナラのことみたい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "（だけど、ヴィマラ村のお兄さんってのはまさか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710124,
					"content": "とにかく、子供が一人で森にいちゃ危ないって。なにが起こるか分からないぞ。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710125,
					"content": "危険なキノコンに遭遇する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "そうそう。それに悪いやつにだって会うかも。例えばナラマラーナみたいな…じゃなくて、えーと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710127,
					"content": "#{M#君}{F#あなた}をさらおうとする悪いやつとか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#{NICKNAME}の言う通りだぞ！それに…それに、お腹だってメチャクチャ空くかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710129,
					"content": "お腹なんか空かないわ。森の中はどこでも自然の恵みがあるもん。星茸とか…スイートフラワーとか…それにミントなんかどこにでもあるし、あたし小食だから、すぐ満腹になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710130,
					"content": "それにあたし、植物を育てるのが得意なの。安全な場所を探してスイートフラワーやミントを植えれば、自分のごはんは問題ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710131,
					"content": "でも、もしスイートフラワーがいっぱい生えている畑があったら楽園かも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710132,
					"content": "うぅ…こいつ、変わり者すぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710133,
					"content": "今でさえ、ガンダルヴァー村にいた時より楽しいわ。殴られることもないし…あんたたちの好意は分かるけど、あたしのためを思うならほっといて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710134,
					"content": "うーん…この子になにがあったのかは知らないけど、説得してガンダルヴァー村に戻らせるのは難しそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710135,
					"content": "この辺りはそこまで危険じゃないし…後でまたここに来ることがあったら様子を見に来ようぜ。その時には気が変わってるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710109,
					"content": "#はぐれた{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}を探してるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "そう。だからおまえみたいに独りぼっちの女の子を見ると放っておけないんだ。なにか助けになれないかってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307102",
							"2"
						],
						"stepId": 7307102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァーシャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "スイートフラワーの種さえあれば、もっと沢山のスイートフラワーを育てられる。でもパンは違う、一度食べちゃったらそれでおしまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710202,
					"content": "パンを半分に割ったとき、また半分生えてくるんだったら、人が飢えることなんてなくなるのにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァーシャ"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァーシャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "やあ、ヴァーシャ、まだここにいたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710302,
					"content": "#パイモンに{NICKNAME}、こんにちは。そうよ、ここで問題なく生きてるから、心配しなくていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710303,
					"content": "まさか本当にここで生活し通すなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710304,
					"content": "まだ帰れって言うつもり？あたし、行かないわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710305,
					"content": "そうか…本当に嫌なんだな。オイラたちも無理強いはしない。でも、前に「スイートフラワーがいっぱい生えてる畑」って言ってたの、覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710306,
					"content": "ああ、あれ？あれはあたしの勝手な願望よ。そんな場所、ないことなんか分かってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710307,
					"content": "うー…またそうやって、ませたことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710308,
					"content": "とにかく、オイラたち、おまえにいい知らせを持ってきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710309,
					"content": "スイートフラワーの畑は本当にあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "そうだぞ！信じられないかもしれないけど、おまえを救った「森の精霊」たちはアランナラって言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710311,
					"content": "#オイラと{NICKNAME}は、アランナラと一緒にたくさんヴィパリャスを育てたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710312,
					"content": "大地の記憶を呼び戻してね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "そう。アランナクラが言うには、ヴァーナはすべてを覚えてるから、大地の記憶を呼び戻せば、苗畑にヴィパリャスが生えるんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710314,
					"content": "そう言うおとぎ話ならあたしも昔たくさん聞いたけど、そんなの信じてるのは子供だけよ。でも、パイモンが優しいのは分かったわ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710315,
					"content": "おまえだって子供じゃないか！いや、そうじゃない！これはおとぎ話じゃなくて、ぜんぶ本当の物語なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710316,
					"content": "うん、子供におとぎ話を聞かせる人は、みんなそう言うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710317,
					"content": "なにを言っても信じてもらえないか。だったら…「百聞は一見にしかず」だ！オイラたちと一緒に来て、自分の目で確かめてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710318,
					"content": "まさか、おとぎ話のためにそんな場所を用意したっていうの？だったら、見に行ってあげてもいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710319,
					"content": "うぅ…オイラが言ってるのは全部ホントのことなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710320,
					"content": "#{NICKNAME}、ヴァーシャをアランナラの苗畑に連れて行こうぜ。自分の目で見ればきっと黙って納得するはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
