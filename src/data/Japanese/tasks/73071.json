	"talks": [
		{
			"id": 7307101,
			"completionStepIds": [
				7307101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307101",
							"2"
						],
						"stepId": 7307101,
						"stateName": "QUEST_STATE_UNFINISHED"
