			"trigger": {
				"objectNames": [
					"ヴァーシャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#これ全部、パイモンと{NICKNAME}が用意したの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710402,
					"content": "えっと…なんとも言えないな。これはアランナクラとアランカラが世話してきた苗畑だ。オイラたちは少し手伝っただけだ。でも、おとぎ話を再現するためにやったんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710403,
					"content": "アランナクラとアランカラ…その子たちが森の精霊…「アランナラ」なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710404,
					"content": "#おう！やっと信じてくれたのか？へへっ、オイラと{NICKNAME}は苗畑の世話をしただけじゃなくて、そいつらと一緒にたくさん冒険したんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710405,
					"content": "ヴィマラ村の子供たちが悪い奴にさらわれた時も、アランナラが保護して家まで帰してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710406,
					"content": "まだパイモンのおとぎ話が本当のことだとは思えない…でも、あたしがここにいれば、いつか会えるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710407,
					"content": "確かにヴァナラーナは危険な場所じゃないけど、おまえ、本当にガンダルヴァー村に帰らなくていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710408,
					"content": "パイモンは本当に忘れっぽいのね。前にも言ったでしょ？あたしはもう、大人に頼らず自分だけでやっていくって決めたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710409,
					"content": "でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "#パイモンも{NICKNAME}も、そんなに心配しなくていいわ。ここまであたし一人で上手くやってきたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710411,
					"content": "それに、あたし草花の世話が得意よ。ここの苗畑がもっと元気になれば、「アランナラ」たちも喜ぶわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710412,
					"content": "そこまで言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710413,
					"content": "パイモンは本当に心配性ね。物心ついて以来、あたしのことをこんなに心配してくれた人は初めてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710414,
					"content": "うぅ…ヴァーシャ、ヴァナラーナは安全だけど…でも、おまえはまだ子供なんだ！ヴァーシャ、気を付けろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710415,
					"content": "#うん、分かったわ。パイモンと{NICKNAME}も気を付けて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァーシャ"
				}
			]
		},
		{
			"id": 7307105,
