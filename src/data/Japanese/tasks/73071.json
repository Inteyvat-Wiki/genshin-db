				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "変だな、なんで子供がこんな場所に一人でいるんだ…？なあ！おまえ、なにやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710502,
					"content": "うわっ！怪人！それに空飛ぶチビ怪人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710503,
					"content": "失礼すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710504,
					"content": "そうね、確かにあたしに教養はないわ。礼儀作法を教えてくれる両親もいないんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710505,
					"content": "（何か事情がありそう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "えっと…なんて言えばいいのか…とにかく、オイラたちは怪人じゃないし、悪人でもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710507,
					"content": "ただの親切な旅人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "そう、だから困ってるやつは放っとけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710511,
					"content": "#そうだ、オイラはパイモン、こいつは{NICKNAME}だ。おまえの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710512,
					"content": "…ヴァーシャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710513,
					"content": "じゃあ、ヴァーシャはなんで一人でこんな場所にいるんだ？迷子なんだったら、オイラたちが送ってやっても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710514,
					"content": "過ぎたことは過ぎたこと。あたし決めたの。もう決して振り返らずに、前を向いてくって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710515,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710516,
					"content": "大人の力になんか二度と頼らないで、自分だけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710517,
					"content": "こんな子供がなんでまた、そんな大人びたことを…とにかく、森の中は危険がいっぱいだ。おまえみたいな子供が対処できるもんじゃないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710518,
					"content": "前に悪い人に連れて行かれそうになったけど…大丈夫、その時の教訓があるから、今度はもっと気を付けて危険を回避するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710519,
					"content": "その人は、前に会ったことのあるヴィマラ村のお兄さんだった。表向きは親切だったけど…結局、今まで会った大人たちと変わらなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710520,
					"content": "悪い人に連れていかれそうになった！？ぜんぜん教訓が生きてないじゃないか！待てよ、ヴァーシャはその時どうやって逃げたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710521,
					"content": "動きの素早い小さな何かが、ここまで連れてきてくれたの。ガンダルヴァー村じゃ見たことない生き物よ。あたしは森の精霊だと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710522,
					"content": "（アランナラのことみたい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "（だけど、ヴィマラ村のお兄さんってのはまさか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710524,
					"content": "とにかく、子供が一人で森にいちゃ危ないって。なにが起こるか分からないぞ。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710525,
					"content": "危険なキノコンに遭遇する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "そうそう。それに悪いやつにだって会うかも。例えばナラマラーナみたいな…じゃなくて、えーと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710527,
					"content": "#{M#君}{F#あなた}をさらおうとする悪いやつとか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#{NICKNAME}の言う通りだぞ！それに…それに、お腹だってメチャクチャ空くかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710529,
					"content": "お腹なんか空かないわ。森の中はどこでも自然の恵みがあるもん。星茸とか…スイートフラワーとか…それにミントなんかどこにでもあるし、あたし小食だから、すぐ満腹になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710530,
					"content": "それにあたし、植物を育てるのが得意なの。安全な場所を探してスイートフラワーやミントを植えれば、自分のごはんは問題ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710531,
					"content": "でも、もしスイートフラワーがいっぱい生えている畑があったら楽園かも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710532,
					"content": "スイートフラワーでいっぱいの畑…そういや、前にアランナラと一緒に世話した苗畑が、そろそろスイートフラワーでいっぱいなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710533,
					"content": "パイモンは、本当に楽園みたいな場所があるって言いたいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710534,
					"content": "そうだぞ！信じられないかもしれないけど、おまえを救った「森の精霊」たちはアランナラって言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710535,
					"content": "#オイラと{NICKNAME}は、アランナラと一緒にたくさんヴィパリャスを育てたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710536,
					"content": "大地の記憶を呼び戻してね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "そう。アランナクラが言うには、ヴァーナはすべてを覚えてるから、大地の記憶を呼び戻せば、苗畑にヴィパリャスが生えるんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710538,
					"content": "そう言うおとぎ話ならあたしも昔たくさん聞いたけど、そんなの信じてるのは子供だけよ。でも、パイモンが優しいのは分かったわ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710539,
					"content": "おまえだって子供じゃないか！いや、そうじゃない！これはおとぎ話じゃなくて、ぜんぶ本当の物語なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710540,
					"content": "うん、子供におとぎ話を聞かせる人は、みんなそう言うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710541,
					"content": "なにを言っても信じてもらえないか。だったら…「百聞は一見にしかず」だ！オイラたちと一緒に来て、自分の目で確かめてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710542,
					"content": "まさか、おとぎ話のためにそんな場所を用意したっていうの？だったら、見に行ってあげてもいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "ヴァーシャ"
				},
				{
					"id": 730710543,
					"content": "うぅ…オイラが言ってるのは全部ホントのことなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710544
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710544,
					"content": "#{NICKNAME}、ヴァーシャをアランナラの苗畑に連れて行こうぜ。自分の目で見ればきっと黙って納得するはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730710509,
					"content": "#はぐれた{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}を探してるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710510
					]
				},
				{
					"id": 730710510,
					"content": "そう。だからおまえみたいに独りぼっちの女の子を見ると放っておけないんだ。なにか助けになれないかってな。",
