			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "うーん…ライトキーパーの墓みたいだな。峡谷で見かけたライトキーパーたちのものか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650102,
					"content": "消えたり現れたり、神出鬼没だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650103,
					"content": "うーん、よくわからないな。今度ピラミダに行って聞いてみようぜ！あそこなら知ってるやつがいるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パトリチェフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "あ、こんにちは。私はパトリチェフ、ライトキーパーの物資事務官です。ご用件をお伺いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650202,
					"content": "「凛風の馬」のパトリチェフ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "「凛風の馬」？ああ、この前見かけた変な光景か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650204,
					"content": "はい、以前その分隊に所属していました。「凛風の馬」…懐かしい名前です。まさかあなたの口からそんな名前が出るとは思いませんでした。なぜ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650205,
					"content": "#{M#俺}{F#私}たち、前にキプマキの崖の下に行ったことがあって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "そうだそうだ、オイラたちはあそこでワイルドハントを片付けたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650207,
					"content": "それで、「凛風の馬」のライトキーパーとワイルドハントが戦った時の光景を見たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650210,
					"content": "まさか本当にそんなことがあるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650211,
					"content": "本当だぞ！オイラたちの目で見たんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761650212,
					"content": "ああ…ここ数年、キプマキの崖で犠牲になった私の同僚たちの姿を見かけたという人がよくいるんです。だから今でも、よくそこに行っています…墓参りも兼ねて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650213,
					"content": "でも私は一度も…一度も彼らを見ることはできませんでした。ずいぶん時が過ぎて、私を慰めるための作り話だと思っていましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650214,
					"content": "まさかあなたたちが本当に会えたなんて…でも、どうして私が行った時は、みんな会いに出てきてくれないんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650215,
					"content": "まだその時じゃないんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "そうかもしれませんね…でも、確かにそこにいることは分かっています。たとえそれが一筋の思い出や一片の虚ろな影だとしても、私には十分です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650219,
					"content": "とにかく、教えてくださって本当にありがとうございます。私にとっては、本当に大切なことなんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650220,
					"content": "今ここに立てているのは彼らのおかげですが…もう一度キプマキの崖の下で彼らと共に戦えたらと、願ってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650221,
					"content": "でも…いつか、必ずまた彼らと再会できる日が来るはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650217,
					"content": "辛い事を思い出してほしくなかったのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "はぁ…最後まで共に戦った時間が、どうして辛いものだったはずがありましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "パトリチェフ"
				},
				{
					"id": 761650208,
					"content": "#{M#俺}{F#私}たちは「凛風の馬」のライトキーパーを見た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "うん、影しか残ってなかったけど…でもその影にはワイルドハントと戦ってた姿が映ってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}