			"dialogs": [
				{
					"id": 761830201,
					"content": "たまには、こうした休息の時間も必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 761830202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761830204,
					"content": "ああ、スネージナヤでまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「召使」"
				},
				{
					"id": 761830203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
