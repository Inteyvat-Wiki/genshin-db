			"dialogs": [
				{
					"id": 400230101,
					"content": "旅人さん、来たのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400230102,
					"content": "当時の公文を提示して、天領奉行に説明したよ。それでやっと信じてくれた——僕と「訣籙陰陽寮」は、潔白だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400230103,
					"content": "よかった！これでやっと、式大将は自分の使命に集中できるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400230104,
					"content": "ああ。すでに「訣籙陰陽寮」は当初の形へと復元し、武道を修練するための純粋な秘境となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400230105,
					"content": "この秘境はもうしばらく稼働した後、符術の力を使い果たすだろう。その時はこれを封印して、ゆっくり力を溜めることにするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400230109,
					"content": "またとない機会だ、挑戦してみるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400230106,
					"content": "準備万端！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "おう！オイラも見てみたいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
