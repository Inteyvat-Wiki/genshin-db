			"trigger": {
				"objectNames": [
					"不思議なホプキンス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "調査で何か分かったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530602,
					"content": "うわっ、立てたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530603,
					"content": "ああ、なんとかね。地獄から戻ってきたとも言えるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530604,
					"content": "それで、騎士団の調査で何か分かったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530605,
					"content": "現場に残された体毛から狼は奔狼領で暮らしていると考えられるけど、それ以外はまだ分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530606,
					"content": "でも安心して、すぐに奔狼領に行って真相をはっきりさせるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530607,
					"content": "こんな危険な状況、騎士団が放っておくわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530608,
					"content": "いいだろう。助けに来るのは遅かったが、対策を講じてくれるならいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530609,
					"content": "うわっ、失礼なヤツ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530610,
					"content": "俺たちは、今すべきことをするとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530611,
					"content": "ちょっと、バカな真似はやめてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530612,
					"content": "笑わせるな。俺たちは騎士団とは違う。この仇、必ず取らせてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530613,
					"content": "行くぞッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530614,
					"content": "本当に惨めだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 4530615,
					"content": "なにがだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530616,
					"content": "彼らの未来がだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 4530617,
					"content": "その意見には同意する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "若いヤツはすぐカッとなる。バカなことをしないよう、見ておいてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 4530619,
					"content": "それもわたしたちの仕事だから、安心して——相手が嫌なヤツだとしてもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530620,
					"content": "わたしたちに任せてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530621,
					"content": "早く奔狼領に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
