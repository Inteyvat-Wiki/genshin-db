			},
			"dialogs": [
				{
					"id": 4530801,
					"content": "これは狼の牙だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530802,
					"content": "村を襲った時、そのドアにぶつけたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530803,
