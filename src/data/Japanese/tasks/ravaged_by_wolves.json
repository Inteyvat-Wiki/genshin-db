			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "これは狼の体毛だね。璃月の人はこれで筆を作るって聞いたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530502,
					"content": "この毛色、本に書いてあるモンドの狼と全然違う、もしかして外来種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530503,
					"content": "狼の体毛だって均一じゃないだろ、ただ色の濃さが違う場所から抜けたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530504,
					"content": "でも、こっち見て——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530505,
					"content": "別の毛か。うん？なにかついてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530506,
					"content": "種だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "うん、これググプラムの種だね。この種は見た目が特徴的だから、分かりやすいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530509,
					"content": "モンドだと奔狼領と明冠峡谷だけに見られるはずだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530510,
					"content": "じゃあ…やっぱり奔狼領の狼なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530511,
					"content": "うーん…同じところでも、複数の狼の群れが縄張りを争うケースもあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530512,
					"content": "詳細はまだ分からないけど、これも調査の大事な手がかりになりそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530513,
					"content": "さて、出発する前に、村人たちを安心させてくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530507,
					"content": "何か変わったもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
			"id": 45306,
			"completionStepIds": [
				45306
