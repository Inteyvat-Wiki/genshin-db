			"dialogs": [
				{
					"id": 4530701,
					"content": "うーん、この爪痕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530702,
					"content": "この痕から狼の数と大きさが分かりそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530703,
					"content": "数は2匹だけじゃない。大きさは、そうだな、おそらく——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530704,
					"content": "おそらく？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "…うん、2メートルくらいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530706,
					"content": "…パイモンって狼を見たことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "狼は神秘的な生き物だからな、そう簡単には見れないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
