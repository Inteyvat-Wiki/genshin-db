			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "くっ、惨めだ。立てなくなるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 4530102,
					"content": "っ！？そんな、ひどい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530103,
					"content": "でも…その人、怪我してないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4530104,
					"content": "ああ、そうだ。惨めだろ？ビックリして立てなくなるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 4530105,
					"content": "あっ、うん……そ、それは大変だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530106,
					"content": "他に目撃情報はないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530107,
					"content": "は、初めて狼を見た、怖かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4530108,
					"content": "…役に立ちそうな情報はないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4530109,
					"content": "現場の痕跡を調べに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
