				"objectNames": [
					"アフタブ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230181501,
					"content": "え？この薬は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181502
					],
					"speakerTitle": "アフタブ"
				},
				{
					"id": 230181502,
					"content": "#{M#君}{F#あなた}の薬。あと、食事は常に軽めにして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181503
					]
				},
				{
					"id": 230181503,
					"content": "ああ…うん。大丈夫だ…もう何日も、<color=#00E1FFFF>肉には触れてすらいない</color>。こうすれば、きっと草神様の恩惠をより受けることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181504
					],
					"speakerTitle": "アフタブ"
				},
				{
					"id": 230181504,
					"content": "だがどうしてか、体の調子が前より悪いんだ。ああ、きっとまだ我慢が足りないに違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アフタブ"
				}
			]
		},
		{
			"id": 2301816,
			"completionStepIds": [
				2301816
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
