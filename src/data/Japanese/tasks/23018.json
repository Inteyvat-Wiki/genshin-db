			},
			"dialogs": [
				{
					"id": 230181801,
					"content": "これは？ダメだ…この匂いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181802
					],
					"speakerTitle": "アフタブ"
				},
				{
					"id": 230181802,
					"content": "実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181803
					]
				},
				{
					"id": 230181803,
					"content": "なんだって？軽い食事でも肉は食べていいのか？…教令院の学者もやってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "アフタブ"
				},
				{
					"id": 230181804,
					"content": "なんだ、そうだったのか…！肉を食べたら、草神様のお怒りを買うんじゃないかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "アフタブ"
				},
				{
					"id": 230181805,
					"content": "学のある人たちがそうしてるなら、安心して肉が食べられるな。ありがとよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アフタブ"
				}
			]
		},
