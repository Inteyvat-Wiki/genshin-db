			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ザカリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230181601,
					"content": "おかえりなさい、首尾はいかがでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181602,
					"content": "もう何日も肉を食べてないって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "なんですって？私はなるべく食事を軽めにするよう言っただけで、肉をまったく食べるなとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181604,
					"content": "…まさか、制限を厳しくすればするほど、草神の加護をより受けられると解釈したんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181605,
					"content": "そんなことになってしまうとは…別の言い方を考えなくてはいけませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181606,
					"content": "お疲れ様でした。この報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				}
			]
		},
		{
