					"nextDialogs": [
						230181904
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181904,
					"content": "なんにせよ、アフタブさんが引き続き正しく健康管理をしてくれるのであれば、それに越したことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181905
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230181905,
					"content": "本当にありがとうございます、こちらの報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
