			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ザカリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "ああ、気の休まる暇がありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180102,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "最近は本当に人手が足りないのです。私も、もう何日も休みをとっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180120,
					"content": "旅人さん、もし時間があれば、薬を近くの患者に届けてはいただけませんか？ついでに、彼らの様子も見てきてほしいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180121,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "それでは頼みましたよ。草神のために…いまの私には助けが必要なのです。一日の大半を、祈りに費やさないような人の助けがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180123,
					"content": "はは…もっとも草神のおかげで、私の祈りもずいぶん上達しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180124,
					"content": "少し休んでて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "休むわけにはいきません。さらに重病の患者が別の場所にいるのです、彼らのために薬を調合しませんと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180126,
					"content": "ああ…あの患者たちはまた、どうすればもっと草神の恩恵を受けられるのかと聞いてくるに違いありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180127,
					"content": "それでは頼みましたよ、旅人さん。私には、一日の大半を草神への祈りに費やさないような…そんな人の助けが必要なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180103,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "あなたは旅人さんですか。ここは「ビマリスタン」、人々に草神の…ええ…恩恵を広めるための病院です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180105,
					"content": "貧富の差に関わらず、私たちは必要な人に医療の助けを提供します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180106,
					"content": "ですが、最近は…診察に来られる方が少々増えていまして。忙しくて手が回らない有様です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180107,
					"content": "ああ、草神が与えてくださる慈悲に限りはなくとも…病院の予算と人員にはあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180108,
					"content": "それに、一部の患者は私たちの言うことをまったく聞かず、どうすれば草神の恩恵をもっと受けられるのかと…そればかりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180109,
					"content": "ははは、草神の恩恵か…まったく、何が神様だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180110,
					"content": "もし草神が本当に恩恵をくださるのなら、彼らは元から病気になどなりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180111,
					"content": "…ふう、すみません。私が言うべきことではなありませんでしたね…どうか、ゴルシャンさんには内密に。また小言を言われてしまいますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180112,
					"content": "#{M#君}{F#あなた}は敬虔な草神の信者じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "はい、勿論です。ですがこのスメールシティでは、そうでない方のほうが珍しいのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180114,
					"content": "もっとも、「敬虔」の二文字はいささか同意しかねます。私は…草神の信者の中では、比較的理性のあるほうだと自負していますから。はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180118,
					"content": "いえ…すみません。どうも私は疲れているようです。あくまで個人的な感想ですから、本気にしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180115,
					"content": "病気が治ること自体、草神の恩恵って人も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "ああ…それは聞き流してください。彼らのように、真に受ける必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180117,
					"content": "もし草神がそのように全能であれば、患者たちにキノコを食べさせるだけで彼らはよくなります。本当にそうなら願ってもないことですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "ザカリヤ"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301802",
							"2"
						],
						"stepId": 2301802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ザカリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "今回の薬は、薬畑のガルゲンさんに届けてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180202,
					"content": "彼はこの間、一生懸命働きすぎたようで…腕が肉離れを起こしてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180203,
					"content": "この薬を彼に渡して、ついでに「今日は家で草神様に祈りなさい。畑に出てはいけません」と伝えてくださいますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180204,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "薬を届け終わったら戻ってきてください。報酬をご用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ザカリヤ"
				},
				{
					"id": 230180205,
					"content": "草神様に祈る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "こうでも言わないと、彼は言うことを聞かないんです。いいですね、私の言うとおりにしてくださいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "ザカリヤ"
				}
			]
		},
