{
	"id": 74671,
	"type": "WQ",
	"name": "人生山あり谷あり",
	"description": "フォンテーヌ科学院のマッカーデル研究員はあることで悩んでいるらしい…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5159,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
