	"steps": [
		{
			"id": 7467101,
			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "マッカーデルと会話する",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7467101,
						0
					],
