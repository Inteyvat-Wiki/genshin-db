	],
	"talks": [
		{
			"id": 7467101,
			"completionStepIds": [
				7467101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7467101",
							"2"
						],
						"stepId": 7467101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マッカーデル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746710101,
					"content": "なんてこった！コアの出力周波数が不安定すぎる。このままじゃ、私のプロジェクトはおしまいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710102
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710102,
					"content": "何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710103
					]
				},
				{
					"id": 746710103,
					"content": "うわっ！お…驚かせないでくれ。もしこの手にあるボタンを押してしまったら、大変なことになるかもしれんのだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710104
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710104,
					"content": "ええと、君たちは…？冒険者協会から派遣された人には見えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710105,
						746710107
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710105,
					"content": "協会に依頼を出したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710106
					]
				},
				{
					"id": 746710106,
					"content": "いいや、依頼を出す金銭的余裕なんてないさ…それに冒険者と交流するのは一番苦手なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710109,
					"content": "私はただ、冒険者協会と「提携」しているだけだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710110
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710110,
					"content": "おっと、自己紹介が遅れたね。私はマッカーデル、フォンテーヌ科学院の研究員の一人さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710111
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710111,
					"content": "私が携わっているプロジェクト領域は「ポータブルミニプネウムシア貯蔵装置」の研究だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710112
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710112,
					"content": "チームの団結と努力により研究は順調に進み、プロトタイプの開発も完了した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710113
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710113,
					"content": "だがその後…誰もが知るとおり、フォンテーヌ科学院で大爆発事故が起きてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710114
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710114,
					"content": "あの爆発事故で、私のいた研究プロジェクトチームのリーダーと大半のメンバーが不幸にも被害に遭って亡くなってしまってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710115
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710115,
					"content": "今は私以外に、この研究を続けられる人員がいないんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710116
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710116,
					"content": "だが…現在の科学院の状況からして、このプロジェクトを存続させるには、その価値を一刻も早く示さなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710117
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710117,
					"content": "だから、各方面から意見を求めたあと、私は冒険者協会と提携することにしたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710118
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710118,
					"content": "私は「ポータブルミニプネウムシア貯蔵装置」のプロトタイプをコアとして、「超高圧インパクター」を開発しようと考えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710119
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710119,
					"content": "この「超高圧インパクター」の運行状態をもってして、「ポータブルミニプネウムシア貯蔵装置」の信頼性を証明しようとしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710120
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710120,
					"content": "なんとかそのマシンを作り、作動するところまでこぎつけることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710121,
						746710123
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710121,
					"content": "なかなか順調そうに見えるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710122
					]
				},
				{
					"id": 746710122,
					"content": "ははっ、そうだな…すべては順調だった。この「超高圧インパクター」が作動するまでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710125,
					"content": "はぁ…いつもこの話をするたびに頭が痛む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710126
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710126,
					"content": "そのプロトタイプの設計に問題があるのか、私が作った「超高圧インパクター」のエネルギー伝送方式に欠陥があるのかは分からないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710127
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710127,
					"content": "「ポータブルミニプネウムシア貯蔵装置」から「超高圧インパクター」に入力されるエネルギー量が、いつも不安定なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710128
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710128,
					"content": "つまり、自ずと「超高圧インパクター」の出力も…常に不安定になるというわけさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710129
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710129,
					"content": "出力が大きければ、このマシンは簡単に岩を砕くことだってできる。しかし出力が弱いと、泥に穴を開けるのですら苦労する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710130
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710130,
					"content": "科学院の今の状況を考えると、もう一度「ポータブルミニプネウムシア貯蔵装置」に手を加えるのは常識的に考えて無理だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710131
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710131,
					"content": "今となっては、プロトタイプにモニタリング装置を追加で取り付け、出力エネルギーを常に監視するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710132
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710132,
					"content": "出力エネルギーが高いときに「超高圧インパクター」を起動できさえすれば、必ず最大の力を発揮できるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710133,
						746710135
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710133,
					"content": "複雑すぎる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710134
					]
				},
				{
					"id": 746710134,
					"content": "しかし、これが現状で思いつく限りの最良かつ最もコストが低い解決方法なんだ。これからどうしたらいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710137,
					"content": "はぁ…まさか冒険者協会も同じように考えていて、なかなか人をよこさないのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710138
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710138,
					"content": "くっ、どうすればいいんだ。テストデータがなければ科学院に報告のしようがないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710139
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710139,
					"content": "その…旅人の方…もしよかったら、手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710140
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710140,
					"content": "この装置は絶対に信頼できると私が保証する！各種機能を強化するために、追加部品もかなり付け加えたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710141,
						746710144
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710141,
					"content": "タイミングをミスったらどうなる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710142
					]
				},
				{
					"id": 746710142,
					"content": "大丈夫だ。出力が低ければ…このマシンが爆発することはありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710143
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710143,
					"content": "その次のエネルギーのピークがやってきたらマシンを起動させて、最大パワーで出力すればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710148,
					"content": "安心してくれ旅人の方。このマシンは絶対に安全だし…テストが終われば報酬も支払おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710149
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710149,
					"content": "では任せたぞ！私の未来、このマシンの未来…そして、このプロジェクトの未来は君にかかっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710144,
					"content": "いきなり近くで爆発したりしないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710145
					]
				},
				{
					"id": 746710145,
					"content": "それは絶対にない。私がセーフモニタリング装置をたくさん取り付けておいたからな。出力を落としておけば、爆発は絶対に起こらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710146
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710146,
					"content": "仮にエネルギーがピークになるタイミングを掴めなくても、なんら問題はないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710147
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710147,
					"content": "その次のエネルギーのピークがやってきたらマシンを起動させて、最大パワーで出力すればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710135,
					"content": "それじゃあ、全然使えない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710136
					]
				},
				{
					"id": 746710136,
					"content": "いいや！これが今できる最良の方法なんだ。役に立つことは私が保証する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710123,
					"content": "何も問題はなさそうだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710124
					]
				},
				{
					"id": 746710124,
					"content": "そうとも。このマシン本体を除けば、何も問題はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "マッカーデル"
				},
				{
					"id": 746710107,
					"content": "冒険者を雇って守ってもらおうと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710108
					]
				},
				{
					"id": 746710108,
					"content": "冒険者を雇う金なんてないさ。高すぎるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "マッカーデル"
				}
			]
		}
	]
}