				"points": []
			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "こだわりがない、優雅ではない、素晴らしくない、不思議でもない。何もかもが釣り合わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "「金亀奇術番長」"
				},
				{
					"id": 727340102,
					"content": "何ぶつぶつ言ってんだ。打ち負かされた仲間たちのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727340103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "「金亀奇術番長」"
				},
				{
					"id": 727340104,
					"content": "君たちの虫相撲の戦い方のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "「金亀奇術番長」"
				},
				{
					"id": 727340105,
					"content": "ああ？フライムに体当たりされて頭でも打ったのか？俺様は芸を見せに来たわけじゃあない！俺様のこだわりは熱血、力そして圧倒的な勢いだ！お前に見せてやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727340106,
					"content": "嫌なことを思い出してしまった…君のような騒がしいやつとは対戦なんかできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "「金亀奇術番長」"
				},
				{
					"id": 727340107,
					"content": "#ふむ、こちらの金髪の{M#男}{F#女}の人は手軽そうだ…決めた！{M#彼}{F#彼女}に挑むとしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "「金亀奇術番長」"
				},
				{
					"id": 727340108,
					"content": "ぷっ…ハーッハッハッハッハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727340109,
					"content": "ダチ公、聞いたか？お前のことが手軽そうだってよ！こいつの相手をしてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727340110,
					"content": "ははっ、では遠慮なく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "こいつらどういうつもりなんだ。相手の情報を一切集めてないし、次から次へと勝ちを譲ってくれるような相手を送るなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727340113,
					"content": "「花角玉将」のチームって、なんかバラバラだな！戦略面ではオイラたち三人に遠く及ばないみたいだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727340111,
					"content": "うぅ、お手柔らかに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
