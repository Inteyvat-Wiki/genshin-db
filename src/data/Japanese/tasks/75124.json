					},
					{
						"sceneId": 3,
						"position": [
							-1639.219,
							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "はぁ、また逃げられてしまいましたね。浮き輪に残ってるのは、どれどれ…一匹だけ…いったいどうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240102,
					"content": "時間がかかりそうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240103,
					"content": "おっ、写真を撮ってるやつがいるぞ…撮ってるのは浮流ペンギンか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240104,
					"content": "浮流ペンギンってかわいいよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240105,
					"content": "よちよち歩く姿が可愛い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "だな。よちよち歩きもかわいいし、体を膨らませて、まん丸になって水面に浮かんでる姿も見てるだけで癒されるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240109,
					"content": "つやつや銀髪の小さなレディーの仰る通りです！浮流ペンギンという生物を創造したものは、この世で最も讃えられるべきでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240110,
					"content": "本当に偉大です…あっ、すみません、自己紹介が遅れました。私はジョンヴェル、浮流ペンギンの写真愛好家です。ジョンヴェルとお呼びください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240111,
					"content": "#おう、オイラはパイモン、こいつは{NICKNAME}だ。…浮流ペンギンがこんなにたくさんいるのに、なんでおまえはため息ばかりついてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240112,
					"content": "話すと長くなるのですが…簡単にお伝えしますね。浮流ペンギンの写真愛好家はたくさんいます。そして誰もがより面白い写真を撮りたいと考えているんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240113,
					"content": "もちろん私もです。数日前、奇抜なアイデアが浮かんできました——浮流ペンギンを浮き輪で囲んで写真を撮る、というものです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240114,
					"content": "何の意味があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "意味がないというところに意味があるのです。自力で水に浮かべるのに、浮き輪をするというのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240116,
					"content": "モラでモラを稼ぐのと同じように無意味なことなんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240120,
					"content": "浮流ペンギンに重荷を背負わせてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240121,
					"content": "これこそが「超現実的撮影」——つまり、写真からより深い意味を見出すという手法なんです…ですが、ちょっとしたトラブルに見舞われておりまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240122,
					"content": "実際の浮流ペンギンに浮き輪をする習慣がないので…なかなか理想の写真が撮れないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240123,
					"content": "まあ「超現実的」な撮影だからね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#でも、浮流ペンギンたちに浮き輪をはめてやればいいんだろ？{NICKNAME}、浮流ペンギン愛好家のよしみてことで、手伝ってやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240125,
					"content": "うん！愛好家同士、助け合おう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "その調子だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240129,
					"content": "本当に手伝ってくださるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240130,
					"content": "へへっ、報酬はいい写真何枚かでいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240131,
					"content": "で、ではぜひお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240127,
					"content": "やっぱり、フライングモモンガのほうが好き…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "もう、今は言うなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240117,
					"content": "確かに珍しいアイデアだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "自力で浮かべる浮流ペンギンが、浮き輪をはめているという構図は、意味の重なりが過剰なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240119,
					"content": "それによって、「過剰消費」や「浪費」といったテーマを表すことができるのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240107,
					"content": "実はフライングモモンガのほうが好き…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "そりゃ、フライングモモンガも可愛いぞ。でも浮流ペンギンたちの目の前で、そんなこと言うなんてかわいそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "パイモン"
				}
			]
		},
