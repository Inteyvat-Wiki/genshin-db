			"dialogs": [
				{
					"id": 751240301,
					"content": "あっ、いいタイミングです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240302,
					"content": "一人であれだけ頑張っても撮れなかったものが、お二人のおかげでこんなにも早く撮れるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240303,
					"content": "ああ、浮き輪をしてユラユラしている浮流ペンギンたち…感動で涙が出そうです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240304,
					"content": "そんなに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "傍から見たら理解不能だったり、ばかばかしく思えるかもしれません。ですが、私にとっては、ずっと追い求めてきたものなんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240306,
					"content": "あの子たちの可愛い写真をもっとたくさん撮れば、きっと浮流ペンギンを好きになる人も増えると思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "ジョンヴェル"
				},
				{
					"id": 751240307,
					"content": "オイラもそう信じてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751240308,
					"content": "ああ、本当にありがとうございました。心ばかりですが、どうか受け取ってください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョンヴェル"
				}
			]
		},
