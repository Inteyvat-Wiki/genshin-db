			"dialogs": [
				{
					"id": 761180101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180102,
					"content": "いい匂いがするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180104,
					"content": "コロンビーナが無我夢中でなにか食べてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180105,
					"content": "旅人、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180106,
					"content": "美味しそうに食べてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180107,
					"content": "食べる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180108,
					"content": "ううん、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "ここで食事するところなんか見たことなかったけど…買ってきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180110,
					"content": "ううん、ラウマから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180111,
					"content": "ラウマっていつもおまえのこと気にかけてるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180112,
					"content": "でも条件付き——ここを離れるなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180113,
					"content": "軟禁じゃんか！で、あっさり買収されたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180114,
					"content": "面白そうな本とかおもちゃも貰った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180115,
					"content": "子供に留守番させようとするお母さんみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180116,
					"content": "理由は言ってなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "ううん、しばらく外に出ないようにってだけ。特に霜月の子には絶対に近づくなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180118,
					"content": "食べ物を届けてくれた動物たちも、ラウマの指示なのか一切口を割らなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180119,
					"content": "えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180120,
					"content": "あくまで推測だけど…私に関係する何かを準備してるのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180121,
					"content": "大丈夫だよ。ここにいるのは嫌じゃないし、美味しいものもたくさん食べられる。外に出られないのは全然苦じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180122,
					"content": "それに、もし霜月の子で本当に何か準備してるなら、好奇心を満たすためだけに邪魔するわけにもいかないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180123,
					"content": "ちょっと聞いてこようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "オイラもすごく気になってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180125,
					"content": "いいけど、覚悟はしておいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180126,
					"content": "キミたちがここに来ることは、ラウマも予想してたはず…そう簡単にはいかないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
