						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "クータルの像の修復！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180302,
					"content": "うむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180303,
					"content": "翼を失ったまま、天外の月を眺めていた頃の孤独の「クー{RUBY#[D]月の少女}タル」はもういない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180304,
					"content": "翼を広げ、再び自由を取り戻す姿を我々はこの目で見届けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180305,
					"content": "ゆえに、神像も修復されるべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180306,
					"content": "いいアイデアだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180307,
					"content": "霜月の子のみんなにはもう話したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "ああ、クータルの犠牲と再臨、そして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180309,
					"content": "その優しき光に導かれて、皆は世界を汚染する力に抗ったのだと伝えたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180310,
					"content": "誰もがクータルの帰還を心から喜んでおった。その流れで、コロンビーナさんの考えも伝えたのだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180311,
					"content": "霜月の子の皆と、家族のように過ごしたいということをな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180312,
					"content": "みんなの反応は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180314,
					"content": "月神様が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "スニツア"
				},
				{
					"id": 761180315,
					"content": "月神様と家族だなんて…ご無礼なのでは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "ラウーハ"
				},
				{
					"id": 761180316,
					"content": "しかし、それがコロンビーナさんの心からの願いなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180317,
					"content": "（詠月使様が月神様のことを「コロンビーナさん」と…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "クネグンダ"
				},
				{
					"id": 761180318,
					"content": "先日話したことを覚えているだろうか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180319,
					"content": "「…道は、真実によって、我々自身の手によって開かれるもの。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180320,
					"content": "私と同じ選択を強要するつもりは毛頭ない。だが、一つだけ助言をさせてくれ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180321,
					"content": "「月明かりを招きたくば、まずは扉を開かねばならぬ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180322,
					"content": "…というわけで、ここ数日の様子を見る限り、予想よりも事が順調に運んでおる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180323,
					"content": "ラウマ様、新たに届いた石材は倉庫に入れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "マチェイ"
				},
				{
					"id": 761180324,
					"content": "ああ、ご苦労さま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180325,
					"content": "今の話とここで見た光景については、コロンビーナさんには内緒にしてくれぬか？「サプライズ」なのでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761180326,
					"content": "月神も信者も、とにかくサプライズが好きみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180327,
					"content": "うん、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "あのさ、ラウマ、口止め料…じゃなくて、今日の饗月の膳ってまだあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180329,
					"content": "ふふ、すぐ用意しよう。あ、それともう一つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				}
			]
		},
