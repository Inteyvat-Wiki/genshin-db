					"nextDialogs": [
						761180413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180413,
					"content": "コロンビーナ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180415,
					"content": "#{M#君}{F#あなた}は目を閉じてるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "それがどうかした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180417,
					"content": "目を閉じてても、クーヴァキを使って物事を感知できるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761180418,
					"content": "うん、むしろそのほうがはっきり分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180419,
					"content": "えっと…しばらくの間、感知しないようにできないか？",
