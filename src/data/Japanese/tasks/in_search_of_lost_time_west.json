			"dialogs": [
				{
					"id": 740120501,
					"content": "うわ…厳しいな！オイラ、絶対こんなやつの下で働きたくないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740120502,
					"content": "「集団の栄光」…？食事もさせてもらえないのになにが栄光だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740120503,
					"content": "彼の言うことも多少は一理ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "まったく訳の分からない規定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "まぁ、規律は確かに大切だけど…ここまですることはないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740120506,
					"content": "そうそう！現場のやり方がわからないヤツほど、おかしな規律や決まりを作りたがるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740120507,
					"content": "あれ？よく考えてみたら、オイラたちが騒ぎを起こせば、そのシュミロフとかいう小隊長をおびき寄せられるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740120508,
					"content": "#そうすれば上がれるかも…{NICKNAME}、さっそくやってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
