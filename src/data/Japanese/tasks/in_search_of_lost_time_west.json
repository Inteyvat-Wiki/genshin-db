			"dialogs": [
				{
					"id": 740121001,
					"content": "レバーを引いてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740121002
					]
				},
				{
					"id": 740121002,
					"content": "#うわーっ！{NICKNAME}、なにしてんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740121003,
					"content": "迷わずレバーを引いてみた。\\n次の瞬間、耳をつんざく雷のような音と共に、天地が裂けるかのように塔が激しく揺れ始めた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121004
					]
				},
				{
					"id": 740121004,
					"content": "そして、ボッという音がしてマシンがテープを吐き出し、あなたの手に落ちてきた。\\nその後、また静けさが戻ってきた。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121005
					]
				},
				{
					"id": 740121005,
					"content": "こ…これだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740121006,
					"content": "うーん…なんて書いてあるのか全然理解できないけど、重要そうな感じはするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740121007,
					"content": "#{NICKNAME}、とりあえずこのテープは持っておこうぜ。あとで使えるかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
