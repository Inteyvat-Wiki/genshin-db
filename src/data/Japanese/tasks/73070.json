			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランシュティガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700401,
					"content": "アランマ！また会ったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700402,
					"content": "#うん！ナラ{NICKNAME}、パイモン、こんにちは。こっちはアランシュティガ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700403
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700403,
					"content": "#おお！ナラ{NICKNAME}、パイモン、会えて嬉しいよ！歌の中と同じで、金色のナラは大きくて強そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700404
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700404,
					"content": "オイラも嬉しいぜ！アランシュティガはアランマの友達なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700405,
					"content": "うん！アランシュティガは「歌摘み」さ。いつもいろんな歌を集めているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700406
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700406,
					"content": "種から苗になる前、ボクたちは一緒に木の葉に隠れてクラクサナリデビの大樹に行った。そこでナラが飲むと頭がおかしくなる水を飲んで、歌っている姿を見たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700407
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700407,
					"content": "#ナラ{NICKNAME}、パイモンは何か歌を知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700408
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700408,
					"content": "歌かぁ…あの緑色のやつなら、たくさん知ってるだろうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700409,
					"content": "緑色のヤツ？暝彩鳥？キノシシ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700410
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700410,
					"content": "違う違う！そいつはモンドの風神で、吟遊詩人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700411,
					"content": "おお！それならきっとたくさん歌を知ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700412
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700412,
					"content": "すごい！風神ならきっと、歌を風に乗せて遠く遠くまで届けることができる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700413
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700413,
					"content": "ああ！ところで、ここがアシュヴァッタ堂なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700414,
					"content": "ううん、違う。でも、これもすごい発見だ。ここには、アランナラが長いこと見つけられなかった歌が眠っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700415
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700415,
					"content": "アランナラの歌摘みは、ずっと歌の美しさを求め続ける。そして終わりの時に、自分だけの歌を残す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700416,
						730700418
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700416,
					"content": "それとアシュヴァッタ堂に何か関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700417
					]
				},
				{
					"id": 730700417,
					"content": "ここにはアランマハが残した歌があるみたいだ。もしそうなら、この近くにヴァサラの樹があるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700420,
					"content": "ヴァサラの樹…前にアランラジャが言ってたな。あの…なんだっけ、森林書に書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700421,
					"content": "#ヴァサラの樹！ヴァソマの実がもらえるヴァサラの樹だ！オイラたちも手伝おうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700422,
					"content": "やった！ナラと一緒に昔の歌を研究できるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700423
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700423,
					"content": "アランマハはこのバラが好きだった。でも、バラに歌を隠す方法はアランヤマが見つけたんだ！アランヤマはそれを誇ってたから、カレのバラたちも誇ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700424
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700424,
					"content": "だから、バラは自分からは教えてくれない。かしこいアランナラかナラなら、隠された歌を見つけられるだろう。でも、アランシュティガはあまりかしこくないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700425
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700425,
					"content": "#心配すんなって！ふふん、{NICKNAME}はかしこいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700426,
						730700427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700426,
					"content": "ラナを助けるためなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700428,
					"content": "おう！オイラたち、物探しは得意だもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700427,
					"content": "そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700418,
					"content": "幸運を祈ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700419
					]
				},
				{
					"id": 730700419,
					"content": "#うん！ありがとうナラ{NICKNAME}。ここには、アランマハの残した歌があるみたいだ。だとしたら、この近くにヴァサラの樹があるはずだ。運がいいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "アランマ"
				}
			]
		},
