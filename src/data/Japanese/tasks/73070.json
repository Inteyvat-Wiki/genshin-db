			"dialogs": [
				{
					"id": 730701901,
					"content": "これが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701902,
					"content": "うん、これがヴァソマの実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701903
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701903,
					"content": "ヴァソマの実は、ヴァサラの樹の夢と記憶を集めて結ばれたもの。ボクたちにとっては、力を回復させてくれる貴重な果実。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701904
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701904,
					"content": "「アシュヴァッタの樹」にビージャの実を実らせるには、たくさんの力を費やす必要がある。だからボクたちはヴァソマの実でカレを養う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701905
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701905,
					"content": "#ナラ{NICKNAME}、ヴァソマの実を大事に取っておいてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701906
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701906,
					"content": "ああ…それならアランマに「お宝」の意味を教えてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701907,
					"content": "お宝ってのは、とても貴重なものって意味だ。ヴァソマの実にはたくさんの夢と記憶が詰まっていて、アランナラの力を回復してくれる。これってすごいし、貴重なものだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701908,
					"content": "ヴァソマの実みたいに貴重で大事なもののことをお宝って言うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701909,
					"content": "おーっ！お宝ってそういう意味だったんだ…分かったよ！ありがとうパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701910,
						730701912
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701910,
					"content": "次はどうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730701911
					]
				},
				{
					"id": 730701911,
					"content": "うーん…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだろ。つまり、別のアシュヴァッタ堂を探さないといけないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701914,
					"content": "#うん。がんばるよ！ナラ{NICKNAME}、パイモン、後でまた会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701915
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701915,
					"content": "うん！またな、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701912,
					"content": "ありがとうパイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730701913
					]
				},
				{
					"id": 730701913,
					"content": "おまえまでなに言ってんだよ…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだよな。つまり、別のアシュヴァッタ堂も探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701914
