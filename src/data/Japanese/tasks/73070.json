			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730702101,
					"content": "三個目のヴァソマの実を手に入れたぞ！アランラジャの話によると、三個で十分なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702102,
					"content": "#うん！これで十分のはずだ。ありがとう、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702103,
						730702105
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702103,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702104
					]
				},
				{
					"id": 730702104,
					"content": "…そういや、アランマに助けてもらってるのは明らかにオイラたちなのに、どうしてオイラたちに感謝するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702106,
					"content": "ううん。ボクがお礼を言うべきだと思う。キミたちはアランラナを助けてる。アランラナはボクの友達、だからありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702107
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702107,
					"content": "#それにナラ{NICKNAME}はアランヤサとアランダサ、アランシュティガを助けて古い歌を見つけた。カレらもボクの友達、だからありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702108
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702108,
					"content": "#最後に、ナラ{NICKNAME}、パイモンと一緒に冒険するのは楽しい。だからありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702109
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702109,
					"content": "オイラも楽しいぜ！ありがとな、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702110,
					"content": "そういえば、アシュヴァッタ堂の辺りに誰かが活動してた痕跡があったような…なにかあそこにまつわる物語とかあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702111,
					"content": "うん、昔々の物語、そのときボクは種ですらなかった。そのころのナラはみんなアランナラを見ることができて、アランナラもナラを恐れていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702112
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702112,
					"content": "#当時、ナラはアランナラを助け、アランナラもナラを助け、一緒に遊び、ボクとナラ{NICKNAME}みたいによく一緒に歌っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702113
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702113,
					"content": "アランヤサたちみたいな歌摘みも、元はアランナラがナラから学んだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702114
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702114,
					"content": "アシュヴァッタ堂は、元々アランナラとナラが一緒に遊んだ場所だった。それはずっと昔のことだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702115
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702115,
					"content": "そして、恐ろしい恐ろしい災難が起きた後、ヴァナラーナは壊滅し、アシュヴァッタ堂も荒れ果てた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702116
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702116,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702117,
					"content": "うん、それはとても恐ろしい物語。でも幸いなことに、それは物語であって、ボクの記憶ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702118
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702118,
					"content": "#心配すんなって！これからどんどん良くなるから。なっ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702119,
						730702120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702119,
					"content": "うん、間違いない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702122
					]
				},
				{
					"id": 730702122,
					"content": "アシュヴァッタ堂を見つけて、三個のヴァソマの実も手に入った。次はウツァヴ祭の準備を手伝うために、森の仲間を呼び戻しに行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702123
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702123,
					"content": "おう！アランマ、がんばれよ！ウツァヴ祭、楽しみにしてるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702124,
					"content": "ボクも楽しみ！じゃあ、またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702125
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702125,
					"content": "アランマ、またな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702120,
					"content": "そうとは言い切れない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702121
					]
				},
				{
					"id": 730702121,
					"content": "#…{NICKNAME}…疲れてんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702105,
					"content": "助かってるのはこっち…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702106
					]
				}
			]
		},
