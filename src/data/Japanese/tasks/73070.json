			"dialogs": [
				{
					"id": 730702001,
					"content": "これで二個目のヴァソマの実を手に入れたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702002,
					"content": "#ナラ{NICKNAME}はすごいね！マラーナをやっつけただけじゃなく、怪物も恐れないなんて。さすがヴァナキを倒せるナラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702003
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702003,
					"content": "ふふん、オイラたち冒険の中で色々なことを乗り越えてきたからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702004,
					"content": "#すごい！じゃあナラ{NICKNAME}とパイモンにもたくさんの記憶、たくさんの物語があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702005,
						730702006
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702005,
					"content": "確かに色々あったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702007
					]
				},
				{
					"id": 730702007,
					"content": "#へえ。じゃあ、ナラ{NICKNAME}とパイモンの物語をボクたちに聞かせてほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702008
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702008,
					"content": "いいぜ！前にもオイラたちの物語を語ったことがあるけど、あれからずいぶん経った気がするよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702009,
					"content": "そう言えば、ヴァサラの樹の夢…夢の中で、遠くにとても大きな紫色の樹が見えたけど、あれってなんだろうな？ヴァナラーナでも見えるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702010,
					"content": "あれはね、最初の「アシュヴァッタの夢の樹」さ。うーんと…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702011
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702011,
					"content": "夢は川に浮かぶ葉っぱみたいなもので、すぐに水と一緒に逃げて行ってしまうんだ。だから、夢を留めておきたければ、夢を根付かせないといけない。そうすれば逃げて行かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702012
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702012,
					"content": "うう…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702013,
						730702014
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702013,
					"content": "「アシュヴァッタの夢の樹」は根みたいなもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702015
					]
				},
				{
					"id": 730702015,
					"content": "#ナラ{NICKNAME}はかしこいね。この樹があれば、アランナラの夢はずっと残るし、たくさんのアランナラを中に入れたり、出したり、ヴァサラの樹と繋がったりもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702016
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702016,
					"content": "そうだったのか…つまり夢の中のヴァナラーナが、ずっと夢の中にあるのも、あの樹のおかげってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702017,
					"content": "そう、夢の樹があるから。でも今はマラーナのことが心配だ。みんなと一緒に解決法を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702018
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702018,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702019
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702019,
					"content": "#でも、まずはビージャの実を実らせてからだ！だって、ナラ{NICKNAME}とパイモン、そしてアランラナの友達を助けないといけないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702020
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702020,
					"content": "そうだな！アランマは引き続きアシュヴァッタ堂を探しに行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702021,
					"content": "うん、そのつもり！また会おうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702022
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702022,
					"content": "気を付けろよ、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730702023
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730702023,
					"content": "#キミたちもね、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730702014,
					"content": "「アシュヴァッタの夢の樹」は夢を留めておける？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730702015
					]
				},
				{
					"id": 730702006,
					"content": "大したことない。",
					"roleType": "TALK_ROLE_PLAYER",
