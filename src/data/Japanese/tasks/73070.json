				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランシュティガ",
					"アランマ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700601,
					"content": "「来たれ、来たれ、苗畑の夢、木の葉の記憶…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700602
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700602,
					"content": "「見よ、宝石のようなザクロ、夕日のような夕暮れの実…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700603
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700603,
					"content": "そうか、アランナガたちの歌は、アランマハの歌と元は同じなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700604
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700604,
					"content": "元は同じって…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700605,
					"content": "歌は川のようなもの。最初は全部一緒で、それが「起源の歌」。カノジョはすべての歌の故郷、大河の源流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700606
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700606,
					"content": "後に、違う記憶、違う物語のために歌うことで変化が起きた。川の流れが小川に分かれるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700607
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700607,
					"content": "でも、すべての小川は海に流れ込む。だから歌も最後には起源の歌に集まり、源の歌へと戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700608
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700608,
					"content": "#だから、歌摘みのアランナラはすべての歌を探す。そうして起源の歌にたどり着く。ありがとう、ナラ{NICKNAME}、パイモン、アランマハの歌を見つけてくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700609,
						730700612
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700609,
					"content": "それって、すごい願いだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700610
					]
				},
				{
					"id": 730700610,
					"content": "#ありがとう、ナラ{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700611
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700611,
					"content": "うーん…歌は増え続けて、変わり続けるのか。それって、どうやったら全部見つけられるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700613,
					"content": "アランナラも増える。だから、がんばり続けていれば、きっと大丈夫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700614
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700614,
					"content": "アランマハの歌は丈夫な草の種を引き寄せる。カレのアシュヴァッタ堂も、そうやって封印されているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700615
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700615,
					"content": "#ナラ{NICKNAME}がカレの歌を見つけた以上、もうすぐアシュヴァッタ堂にもたどり着けるさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700616
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730700616,
					"content": "#うん！ナラ{NICKNAME}、パイモン、そしてアランマ、幸運を祈るよ！アランシュティガはウツァヴ祭の準備のため先に帰るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700617
					],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700617,
					"content": "任しとけ！ウツァヴ祭でまた会おうな、アランシュティガ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730700618,
					"content": "またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランシュティガ"
				},
				{
					"id": 730700612,
					"content": "でも、歌は増え続けるんだよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700613
					]
				}
			]
		},
