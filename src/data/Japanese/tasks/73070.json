			"dialogs": [
				{
					"id": 730701301,
					"content": "これが…ヴァサラの樹？見た感じ、思ってたより生気がないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701302,
					"content": "うん。アランマハが必死に抵抗して、マラーナをここだけに留めた。さもなければ、周りの森はもっとひどくなってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701303
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701303,
					"content": "木の葉は落ち、地上で腐り果てる。すべてのキノコは怒りに満ちたキノコンになり、獣と鳥は倒れて地面に帰る。白く硬いものだけが残っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701304
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701304,
					"content": "聞いただけで恐ろしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701305,
					"content": "#うん。でも幸い、ナラ{NICKNAME}とパイモンのおかげで、マラーナの問題はずっと良くなった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701306
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701306,
					"content": "もしボクだけだったら、きっとダメだった。ボクの過ごした時間は短いし、記憶も少ない。だから、他のアランナラほど力もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701307
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701307,
					"content": "#でも、ナラ{NICKNAME}とパイモンと一緒に冒険した記憶があれば、ボクは強くなれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701308,
						730701310
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701308,
					"content": "#{M#俺}{F#私}たちも同じだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730701309
					]
				},
				{
					"id": 730701309,
					"content": "ああ！友達と一緒に冒険するってのは、こういうことだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701311,
					"content": "うん。まずはカレの夢の中に入って、マラーナの影響を取り除く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701312
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701312,
					"content": "「カレ」ってのは…ヴァサラの樹のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730701313,
					"content": "そうだよ。準備ができたら、手を伸ばしてカレの夢に入ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730701310,
					"content": "次はどうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730701311
					]
				}
			]
		},
