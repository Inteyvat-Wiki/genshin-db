			"dialogs": [
				{
					"id": 766670301,
					"content": "採ってくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "ほ、本当に手伝ってくれるの…？すごく助かるわ、ありがとう！——じゃあ…<color=#00E1FFFF>ホワイトベリーを5つ</color>、お願いできるかしら。それだけあれば足りるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670303,
					"content": "最高に美味しい「饗月の膳」を作ってあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーリキ"
				}
			]
		},
		{
			"id": 7666704,
