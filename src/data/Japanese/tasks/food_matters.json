			},
			"dialogs": [
				{
					"id": 766670401,
					"content": "これだけあれば十分よ。本当にありがとう！ちょっと待っててね。最高に美味しい「饗月の膳」を作ってあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670402,
					"content": "リーリキは厨房に走っていき、一生懸命「饗月の膳」を作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "さあ、できあがり。どうぞ食べてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670404,
					"content": "おかげで助かったわ。お腹が空いたときは、いつでも立ち寄って。あなたの分をちゃんと用意するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーリキ"
				}
			]
		},
