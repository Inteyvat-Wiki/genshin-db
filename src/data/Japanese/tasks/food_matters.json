			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リーリキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "…うぅ…ホワイトベリーを多めに用意しとけばよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670102,
					"content": "（この前、たしかここでラウマが…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#{NICKNAME}さん、こんにちは。「饗月の膳」を受け取りにいらしたの？申し訳ないけど、少し待ってもらえる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670105,
					"content": "「饗月の膳」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "ん？前にも受け取ったことがあるでしょう？ああ、あの時はラウマ様から受け取ったから、名前を知らなかったのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670107,
					"content": "饗月の膳というのは、「霜月の子」が必要な人たちに無償で配る食事のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670108,
					"content": "昔から「霜月の子」には助けを必要とする人たちに手を差し伸べる伝統があってね。最初はヒーシ島の周辺に限ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670109,
					"content": "ラウマ様のご指示とみんなの努力のおかげで、「饗月の膳」を配るエリアもだんだん広がっていったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670110,
					"content": "月神の祝福をもっと多くの人に届けるためよ…そうそう、ラウマさまはこうおっしゃってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670111,
					"content": "「最初に摘んだ稀なる果実は、月の祭壇に捧げよ。此れは神への供物ではなく、迷える狩人へ残す…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670112,
					"content": "残す…あら、何だったかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670113,
					"content": "コホン、とにかく！この店は「饗月の膳」の主な配給所の一つで、ほとんど私一人で切り盛りしているのよ。すごいでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670114,
					"content": "ナシャタウンで「饗月の膳」を配ってると、いろいろ大変なこともあるけど…でも、ラウマ様のおっしゃる通り、困ってる人をもっとたくさん助けられると信じているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670115,
					"content": "でも…昨日は、食材が入った箱の蓋をちゃんと閉めておかなかったせいで、朝起きたら鳥たちにめちゃくちゃにされて、全部だめになってしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670116,
					"content": "辛うじて残ったホワイトベリーじゃ、全然足りないし…はぁ、どうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766670103,
					"content": "（食事を配ってた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
