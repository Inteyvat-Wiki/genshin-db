			"dialogs": [
				{
					"id": 230070201,
					"content": "まあ、その補助的な材料が問題でな。いくつかアイデアはあるんだが、今日は…スライムの液体を染み込ませた土を探しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070202,
					"content": "スライムの集まる場所も聞いてある。旅人さん、その泥土を集めに行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070203,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "じゃあ頼むぞ。スライムを倒す必要はない。あいつらの集まる場所の泥土を取ってきてくれればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070205,
					"content": "スライムが集まる場所を地図に書いておくぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070206,
					"content": "自分では行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "俺も自分で行きたいが、先に壺やら器やらの注文を片付けないといけなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070208,
					"content": "安心しろ。仕事に見合った報酬は用意しておく。じゃあ頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070209,
					"content": "ここへ行って探してくれ。地図に書いておくぞ…",
					"roleType": "TALK_ROLE_NPC",
