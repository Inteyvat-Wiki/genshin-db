					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070305,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "じゃあ頼んだぞ。トリックフラワーの根についた泥土を持ってきてくれ。",
