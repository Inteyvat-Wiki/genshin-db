					"アキム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "もっと使いやすい材料はないもんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070102,
					"content": "材料って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "すまんな、独り言だ。最近天気の変化が激しくて、家の建物に問題が起きやすくてな。忙しくて手が回らんのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070104,
					"content": "#{M#君}{F#あなた}は陶芸家じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "ああ、だが俺は瓦職人も兼ねていてな。どちらも泥をこねる仕事だから、同じようなもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070106,
					"content": "こんな言葉を知ってるか？「学問とは家を建てるようなもの。高い家を建てたければ、地盤をよく固める必要がある。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070107,
					"content": "「つまり、学術理論を発展させたければ、基礎固めが大事。基礎が柔らかければ、簡単に揺らいでしまう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070108,
					"content": "上の賢い連中がいつもそう言うんだ。詳しくは分からんが…奴ら、家を建てることを学問と同じくらい大事だと思ってるようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070109,
					"content": "それはただの比喩だけどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "とにかくだ、家の基礎と言えば建材だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070112,
					"content": "泥に何か補助的な材料を加え、練り合わせて強度と適応性を強化できれば、家がもっと頑丈になる。俺も少しは暇ができるというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230070110,
					"content": "その解釈はどうだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
