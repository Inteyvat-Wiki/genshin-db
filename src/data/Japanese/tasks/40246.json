					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "ふん、ワタシは忠告したから。後で痛い目を見ても知らないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461007,
					"content": "次はどこに行くの？船に戻るの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461008,
					"content": "なぁサンドローネ、おまえのことも、昔のことも解決したんだし…そろそろみんなにおまえが無事だって知らせるべきなんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461009,
					"content": "おまえの無事を知ったら、みんなきっとすっごく喜ぶぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461010,
					"content": "はぁ…以前のワタシなら、絶対に認めなかったでしょうけど…確かに、ワタシもみんなに会いたいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461011,
					"content": "でも、コロンビーナは例外よ！今度こそ、いままでアイツに振り回された分の仕返しをしてやるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
