				},
				{
					"id": 402461108,
					"content": "ま、まさか、さっきから…撮っ…撮って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461109,
					"content": "もちろん撮ってたわよ。しょうがないでしょ、写真機はずっと回しっぱなしだったし…あまりにも突然だったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402461110,
					"content": "もしかして、このお嬢さんが…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 402461111,
					"content": "うん、私の一番の友達。本当にまた会えるなんて思わなかった。すごく嬉しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461112,
					"content": "この映影は「いいラスト」を迎えられたみたいだね、サンドローネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461113,
					"content": "…サンドローネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461114,
					"content": "いつも…いつもあんたのせいで…んもーっ！！コロンビーナァァ——！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
		{
