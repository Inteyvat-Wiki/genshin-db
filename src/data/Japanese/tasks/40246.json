			"dialogs": [
				{
					"id": 402460701,
					"content": "準備はいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460702,
					"content": "ええ。出てきたら、まずは意思疎通を試みるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460703,
					"content": "でも、恐らくは…すでに理性を失っていて、できない可能性の方が高い。その時は、戦闘になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460704,
					"content": "おう。もし最悪の事態になったら、ちゃんと隠れとくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460705,
					"content": "ええ。本当に戦いになったら、最後はワタシが手を下すからアナタたちは手出ししないで。ワタシを信じてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460706,
					"content": "リョーカイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460707,
					"content": "さて…しばらく静かにしてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460708,
					"content": "…潮汐に揺蕩う遊魂よ、汝らに呼びかけん。引き離され、見捨てられ、沈黙を強いられた魂よ、かつての気配を辿れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460709,
					"content": "…見合え、名を失いし怨恨よ。引き合え、穢れた悪しき存在よ。今ここに集い、再び形を成すがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460712,
					"content": "（…何も起こらない…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460713,
					"content": "（はぁ…これだから魔法や秘術なんてものは苦手なのよ…演算がどこまで進んでいるのかも分からないし、術式のロジックもさっぱりなんだもの。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460714,
					"content": "（ワタシがよく知る機械科学とは、完全に…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460715,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460716,
					"content": "危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460717,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "「彷徨う魂の怨念」"
				},
				{
					"id": 402460718,
					"content": "アナタたち…あるいはその中にいる人たち。ワタシの言っていることがわかる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460719,
					"content": "ワタシはフォンテーヌの「奇械公」——アラン・ギヨタンの後継者よ。アナタたちを元の姿に戻して、地脈に還してあげる方法を知っているわ。ほんの少し、協力してくれさえすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460720,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "「彷徨う魂の怨念」"
				},
				{
					"id": 402460721,
					"content": "サンドローネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460722,
					"content": "はぁ…どうやら、説得しても無駄なようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460723,
					"content": "いいわ、付き合ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
