			"dialogs": [
				{
					"id": 402460501,
					"content": "いないようね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460502,
					"content": "なら、儀式を始めましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460503,
					"content": "ちょっと待って。この層の水を抜いて空にしましょう。その方が行動しやすくなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460504,
					"content": "ここの水って抜けるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460505,
					"content": "当然でしょう。アランとルネはそれぞれフォンテーヌの運命を観測した後、建築物の防水に関する技術についてもいくつか共有していたの。原理としては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460506,
					"content": "コホン、話が逸れたわね。とにかくアナタたちはワタシの言う通りに、一つずつ仕掛けを解いていってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
