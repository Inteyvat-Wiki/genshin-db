			"dialogs": [
				{
					"id": 402461201,
					"content": "シトラリ、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461202,
					"content": "へぇ、時間通りじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461203,
					"content": "おまえこそ…昨日あんなに呑んだのに、大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461204,
					"content": "フン、見くびらないでよね。ばあちゃんはあのくらいで潰れたりしないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461205,
					"content": "でも、途中から変なこと口走ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461206,
					"content": "えっ…ウ、ウソ、全然記憶にないんだけど！な…なにかトンデモないコト言ってないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461207,
					"content": "孫の文句を三十分ぐらい語った後、謎煙の主での仕事の愚痴を三十分ぐらい垂れ流して、娯楽小説の話を一時間して…あとは…えっと、そのあとはオイラも寝ちゃった気がするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461208,
					"content": "…アイツら、もう行った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461209,
					"content": "あいつらって…ああ、撮影チームのことか？もう行ったぞ。ちょうどデッキですれ違ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461210,
					"content": "ていうか、おまえの問題は解決したはずだろ？なんでコロンビーナに会いに行ってやらないんだよ。あいつ、すっごくおまえに会いたがってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402461211,
					"content": "め、目先の問題を片付けてから会おうと思ってるのよ。それに、アイツを驚かせる絶好のチャンスなんだから、もっとどう登場するか計画を練らないとでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461212,
					"content": "それはさておき、例の件は特定できた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461213,
					"content": "トーゼンよ、ワタシは黒曜石の老婆なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461214,
					"content": "助かるわ。見せてちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461215,
					"content": "モルテ地区の…って、ゲシュタル塔じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461216,
					"content": "やっぱり、自分の魂が切り離された場所への怨みが一番深いものなのかしら？それとも、これは「水仙十字」に対する怨念…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461217,
					"content": "ワタシも一緒に行かせて。具体的にいつどこで出現するかは特定できないから、いなかったら儀式で呼び寄せてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461218,
					"content": "本当？でも、そこまで面倒をかけるわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461219,
					"content": "遠慮しないで、おばあちゃんはどうせヒマだし。若者のために魂を呼ぶくらい、チョチョイのチョイなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461220,
					"content": "（それに…ついて行かなかったら、またキミたちの間でしか通じないネタが増えるじゃない！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402461221,
					"content": "分かった…じゃあお願いするわ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402461222,
					"content": "へへっ、じゃあさっそく出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
