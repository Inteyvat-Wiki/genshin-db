			"dialogs": [
				{
					"id": 402460901,
					"content": "これで…終わりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460902,
					"content": "終わりよ。簡単だと言ったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460903,
					"content": "いったいどうやって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460904,
					"content": "あれは、帰る場所のない魂の集合体。多くの穢れと邪念が混ざり合った産物にすぎないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460905,
					"content": "ワタシはただ、彼ら本来の魂と穢れを切り離して、今の世界の「規{RUBY#[D]ルール}則」に受け入れられる形にしただけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460906,
					"content": "「世界式」の原理は「発散」…一つの原点から出発して、世界の可能性を解体し、再構築する過程から答えを探すものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460907,
					"content": "「数秘配列」を利用して「世界式」を逆演算すれば、集約、収束、そして復元ができるのよ。要するに、術式を反転したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460908,
					"content": "数学で言うホモロジー的還元のようなものね。その集合体の本質を変えることなく、より分かりやすく実質的な形へと変換するのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460909,
					"content": "だから…はぁ、もういいわ。本気で理解したいわけじゃないんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460910,
					"content": "「謎煙の主」のシャーマンの語りを、よそ者がどんなキブンで聞いてたのか分かった気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 402460911,
					"content": "と…とにかく、すごいってことだけは分かったぞ！やっぱりおまえはすごいな、サンドローネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460912,
					"content": "ふん、ワタシがすごいのはいつものことでしょう。ふふっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460913,
					"content": "さすが万物の理を解析する——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "その話はもうやめて！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 402460915,
					"content": "そ…そろそろ帰らないと！ワタシはゲシュタル塔内部の仕掛けを復元してくるわ。岸で合流しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
