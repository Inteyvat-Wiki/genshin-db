					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "シトラリ、昨日結構呑んでたけど…ちゃんと起きたかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460202,
					"content": "おはよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460203,
					"content": "わっ！コロンビーナ！？お、おまえ…なんでここにいるんだ？っていうか、なんでいつも後ろから出てくるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460204,
					"content": "今朝から追加の撮影でみんなと来てて、ちょうど今撮影が終わったの。だから、先にデッキに出て風に当たってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460205,
					"content": "他の人たちは、まだ下でラストについて話してるみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460206,
					"content": "ラスト？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460207,
					"content": "この映影のラスト。みんな、物語のヒロインが最後に友達と会えたことにするか、悩んでるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460208,
					"content": "ここ数日、別のことで忙しくて、すっかり忘れかけてたぞ。たしか、友達がいなくなったことに気づいた主人公が、友達の故郷を訪れるってストーリーだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460209,
					"content": "うん…フリーナ監督と千織さんは、物語の雰囲気を考えると、会えない結末の方が切なくていいって言うんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460210,
					"content": "グザヴィエ監督は、再会できたほうが感動的で、優しいストーリーになるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460211,
					"content": "コロンビーナはどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "私？私は…わからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460213,
					"content": "私自身のことを言うなら、もちろん会いたいよ。本当に、また会えたらいいのに…たとえ映影の中でも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460214,
					"content": "でも、他の人が彼女を演じるのは、納得できない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460216,
					"content": "とりあえず、悩むのはやめよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460218,
					"content": "おう！この件はまたあとで考えようぜ。映影は楽しんで撮ってこそだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460219,
					"content": "それに…ぜ、絶対うまくいくぞ！オイラ、保証してもいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460220,
					"content": "うまくいく？…なにが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460221,
					"content": "ええと、そ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460222,
					"content": "きっといいラストになる、ってことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "おう！そういうことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460224,
					"content": "うん…わかった。キミたちを信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460225,
					"content": "じゃあ、キミたちの言う通り…まずは撮影を楽しむね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460226,
					"content": "おや？旅人とパイモンじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 402460227,
					"content": "あら？おサボり中の照明さんとスクリプターさんじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402460228,
					"content": "ぐっ…ご、ごめんな、オイラたち撮影を休んでばっかで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402460229,
					"content": "ふふっ、冗談よ、気にしないで。撮影は順調だから、安心して自分の用事を済ませてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402460230,
					"content": "ごめんね、ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "あれ？コロンビーナさん、落ち着いたかい。さっきは僕たちのせいで、落ち込ませちゃったね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 402460233,
					"content": "大丈夫、今はもう平気。旅人とパイモンのおかげで、考えがまとまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460234,
					"content": "へえ！それなら、再会するラストとできないラスト、どっちを撮るんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 402460235,
					"content": "いいラストを撮る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460236,
					"content": "…んん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 402460231,
					"content": "後で必ず埋め合わせするから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
