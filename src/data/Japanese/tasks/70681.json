			"dialogs": [
				{
					"id": 706810501,
					"content": "あれって<color=#00E1FFFF>荻花洲</color>？きれい…モンドではまず見られない風景ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
