			"dialogs": [
				{
					"id": 706819905,
					"content": "ゲシェニはメニューを聞いて、高価な料理を注文した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "璃月料理は見た目、匂い、味のどれもにこだわってるんだって…こうして見ると、本当に全部違うわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810802,
					"content": "オイラ、見てるだけでヨダレが垂れてくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810803,
					"content": "一行はごちそうを思う存分味わった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "わぁ、これも美味しいし、あれも美味しい…もう食べられない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810805,
					"content": "美味しかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "旅の疲れが吹き飛んだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "先輩たち、本当にありがとう。二人がいなかったらこんな簡単にここまでたどり着けなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810808,
					"content": "さっき旅館の人から聞いたんだけど、もう少し行けば<color=#00E1FFFF>璃月港</color>だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810809,
					"content": "あたしは数日ここに滞在して、他の旅行客に浮世離れした達人を探す方法を聞いて回ってみるわ。それから今後の行き先を決めようと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810810,
					"content": "先輩たちとの旅は本当に楽しかったけど、これ以上二人の邪魔をするわけにもいかないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810811,
					"content": "これからたくさん努力して、あたしも先輩みたいな頼れる冒険者になってみせるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810812,
					"content": "へへっ。短い間だったけど、オイラたちも楽しかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810813,
					"content": "またどこかで会えるといいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810814,
					"content": "縁があれば、また。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "願いを達成できるよう祈ってるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "うん！先輩もいい旅をね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810817,
					"content": "ゲシェニと手を振って別れた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "せっかくここまで来たんだし、オイラたちも近くを回ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810819,
					"content": "なにか面白いことがあるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810820,
					"content": "ゲシェニによると、この先が<color=#00E1FFFF>璃月港</color>だよな。時間があったらオイラたちも見にいこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
