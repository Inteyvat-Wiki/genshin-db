			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "先輩との貴重な記念写真！大事にするわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810702,
					"content": "はぁ、安心したらお腹空いてきちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810703,
					"content": "うぅ、そういえばオイラのお腹もぐーぐー言ってるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810704,
					"content": "休める場所を探そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "近くにご飯を食べられる場所がないか探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810709,
					"content": "この辺りだと、ちゃんとしたレストランは無さそうね…適当にごまかすのも、先輩に申し訳ないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810710,
					"content": "そういえば、あの大きな石の上に建ってるのって、かの有名な<color=#00E1FFFF>望舒旅館</color>よね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810711,
					"content": "前にモンドに来てた璃月の商人から聞いたんだけど、あそこのメニューは絶品なんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810712,
					"content": "これまでのお礼として、あたしがごちそうするわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810713,
					"content": "やったぁ！美味いもの食べようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810705,
					"content": "パイモン、火を起こしてご飯を作って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "おい！オイラをこき使いすぎだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810707,
					"content": "それにオイラの料理の腕はおまえだって知ってるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "パイモン"
				}
			]
		},
