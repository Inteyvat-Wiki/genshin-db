				},
				{
					"id": 706810502,
					"content": "やっぱり旅に出てきて正解だったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810503,
					"content": "そうだ！せっかくだし、ここで一緒に記念写真でも撮りましょうよ！",
					"roleType": "TALK_ROLE_NPC",
