			},
			"dialogs": [
				{
					"id": 706813101,
					"content": "ふぅ…助かったわ。ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813102
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813102,
					"content": "あたしはゲシェニ。見ての通り、冒険者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813103
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813103,
					"content": "君たち、ものすごく強いけど、絶対一般人じゃないわよね！親切な騎士さん？それとも各地を放浪するレンジャー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813104,
						706813105
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813104,
					"content": "通りすがりの旅人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813109
					]
				},
				{
					"id": 706813109,
					"content": "#オイラはパイモン。で、こっちは{NICKNAME}。実はこいつも冒険者協会の会員なんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813110,
					"content": "じゃあ、先輩なのね！ホント、上には上がいるっていうか…あんな手強い魔物をあっという間に倒しちゃうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813111
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813111,
					"content": "あたしなんて、訓練でしっかり動きを頭に叩き込んだのに、いざ実戦となると手足が言うことを聞かなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813112
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813112,
					"content": "師匠の言う通り、あたしはまだまだ修行が足りないのかしら？でも、このままなんの成果もないまま帰るのも恥ずかしいし…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813113
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813113,
					"content": "えっと、単に経験の差だと思うぞ。オイラたちもたくさん経験を積んで、やっと余裕が出てきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813114,
						706813118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813114,
					"content": "まずは落ち着くこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813115
					]
				},
				{
					"id": 706813115,
					"content": "そうそう。実践だと、初心者はどうしても焦っちゃって、本当の実力を出せないもんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813116,
					"content": "敵がどんなに強そうでも、落ち着いて観察して、そいつらの弱点を見つけ出すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813117,
					"content": "そうすれば、バババーって勝てるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813120,
					"content": "なるほど…さすが経験豊富な先輩だわ！あたし、もっと旅を続けて腕を磨いたほうが良さそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813121
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813121,
					"content": "#{M#君}{F#あなた}も旅をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813122
					]
				},
				{
					"id": 706813122,
					"content": "そうよ…<color=#00E1FFFF>璃月</color>へ行ってみるつもりなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813123
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813123,
					"content": "璃月の武術について聞いたことある？軽々と壁を飛び越えたり、刃物を通さないほど頑丈になったり、金属をバターみたいに斬ったりできるんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813124
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813124,
					"content": "もし達人の教えを少しでも学べたら、今後の冒険がずっと楽になるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813125
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813125,
					"content": "でも実を言うと…冒険者協会に入ってしばらく経つけど、遠出はしたことないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813126
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813126,
					"content": "はぁ…街を出てすぐ、魔物が通せんぼしてるんだもの。あたし、本当に璃月まで行けるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813127,
						706813128
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813127,
					"content": "璃月なら行ったことあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813129,
					"content": "わあっ！すごい先輩に案内してもらえるなんて、あたしの旅路が希望に満ちてきたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813130
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813130,
					"content": "でも、きっとすごく忙しいんでしょう？あたしなんかの面倒まで頼むなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813131,
						706813132
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813131,
					"content": "正しいことするのが日常だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813133,
					"content": "じゃあ…お言葉に甘えようかな！マップをくまなくチェックしておいたから、なるべく足手まといにならないようにするわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813132,
					"content": "#後輩を助けるのも大事なこと{M#だ}{F#だよ}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813128,
					"content": "案内してあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813118,
					"content": "形勢を判断するのも大事だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813119
					]
				},
				{
					"id": 706813119,
					"content": "そうそう。もし敵が自分よりも格上だって判断したら、すぐに退散したほうがいいぜ。無茶はだめだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706813105,
					"content": "正体を明かすわけには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813106
					]
				},
				{
					"id": 706813106,
					"content": "あーなるほど！秘密の使命を背負ってるから、目立たないようにしてるのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813107
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706813107,
					"content": "まぁそんなところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813108
					]
				},
				{
					"id": 706813108,
					"content": "もういいだろ、あんまりもったいぶるなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813109
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
