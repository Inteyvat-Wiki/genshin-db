			"dialogs": [
				{
					"id": 706810301,
					"content": "ふぅ…助かったわ。ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810302,
					"content": "あたしはゲシェニ。見ての通り、冒険者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810303,
					"content": "君たち、ものすごく強いけど、絶対一般人じゃないわよね！親切な騎士さん？それとも各地を放浪するレンジャー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810304,
					"content": "通りすがりの旅人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#オイラはパイモン。で、こっちは{NICKNAME}。実はこいつも冒険者協会の会員なんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810310,
					"content": "じゃあ、先輩なのね！ホント、上には上がいるっていうか…あんな手強い魔物をあっという間に倒しちゃうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810311,
					"content": "あたしなんて、訓練でしっかり動きを頭に叩き込んだのに、いざ実戦となると手足が言うことを聞かなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810312,
					"content": "師匠の言う通り、あたしはまだまだ修行が足りないのかしら？でも、このままなんの成果もないまま帰るのも恥ずかしいし…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810313,
					"content": "えっと、単に経験の差だと思うぞ。オイラたちもたくさん経験を積んで、やっと余裕が出てきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810314,
					"content": "まずは落ち着くこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "そうそう。実践だと、初心者はどうしても焦っちゃって、本当の実力を出せないもんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810316,
					"content": "敵がどんなに強そうでも、落ち着いて観察して、そいつらの弱点を見つけ出すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810317,
					"content": "そうすれば、バババーって勝てるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810320,
					"content": "なるほど…さすが経験豊富な先輩だわ！あたし、もっと旅を続けて腕を磨いたほうが良さそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810321,
					"content": "#{M#君}{F#あなた}も旅をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "そうよ…<color=#00E1FFFF>璃月</color>へ行ってみるつもりなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810323,
					"content": "璃月の武術について聞いたことある？軽々と壁を飛び越えたり、刃物を通さないほど頑丈になったり、金属をバターみたいに斬ったりできるんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810324,
					"content": "もし達人の教えを少しでも学べたら、今後の冒険がずっと楽になるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810325,
					"content": "でも実を言うと…冒険者協会に入ってしばらく経つけど、遠出はしたことないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810326,
					"content": "はぁ…街を出てすぐ、魔物が通せんぼしてるんだもの。あたし、本当に璃月まで行けるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810327,
					"content": "#{M#俺}{F#私}たちも璃月へ行くつもり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "本当？もしかして先輩も浮世離れした達人を探すの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810330,
					"content": "いやいや。オイラたちはとある理由で各地を旅してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810331,
					"content": "璃月のことはあんまり詳しくないけど、いずれ行ってみないとって思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810332,
					"content": "目的地も同じなんだし、一緒に行くのも悪くないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810333,
					"content": "わあっ、すごい先輩と一緒に行動できるなんて…あたしの旅路が希望に満ちてきたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810334,
					"content": "じゃあガイドはあたしに任せて。マップをくまなくチェックしたから、絶対に迷わないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810328,
					"content": "#{M#俺}{F#私}たちと一緒に行く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "形勢を判断するのも大事だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "そうそう。もし敵が自分よりも格上だって判断したら、すぐに退散したほうがいいぜ。無茶はだめだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810305,
					"content": "正体を明かすわけには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "あーなるほど！秘密の使命を背負ってるから、目立たないようにしてるのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810307,
					"content": "まぁそんなところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "もういいだろ、あんまりもったいぶるなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "パイモン"
				}
			]
		},
