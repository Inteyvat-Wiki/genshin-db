						],
						"pointId": 9403
					},
					{
						"sceneId": 3,
						"position": [
							1874.555,
							201.412,
							-142.334
						],
						"pointId": 9404
					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "先輩！ごめんなさい。ちょっとここで待っててもらってもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810402,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "忘れ物でもしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706810404,
					"content": "あ、違うの。マップを確認してるだけよ。…このまま前に進めばモンドを離れることになるのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810405,
					"content": "次に戻ってくるのはいつになるかしら…あたしの置き手紙を見たら、師匠きっとカンカンだろうなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810406,
					"content": "前にも「師匠」って言ってたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "ええ…師匠は冒険者になりたての頃、野外でヒルチャール暴徒に遭遇したの。それで戦っているときに、油断して斧をくらってノックアウト。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810409,
					"content": "でも幸い、通りすがりの騎士が助けてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810410,
					"content": "ふがいなさに打ちひしがれた師匠は、街で武芸を極限まで鍛錬したあと、外に出て冒険することを決めた。そうして鍛錬は十年も続いたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810411,
					"content": "師匠は「基本が一番大事だ」って言うけど、毎日木の杭を割るのはもうウンザリ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810412,
					"content": "だから、あたしは師匠の目を盗んで、一人で旅に出たの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810413,
					"content": "強くなって帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "うん！あたしもそのつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810416,
					"content": "あっ、そうだわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810417,
					"content": "ゲシェニはバッグの中から蒲公英の種を取り出して手のひらに乗せると、それに何かをささやき、風で飛ばした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "あたしたちの習わしでは、蒲公英は願いを乗せてくれるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810419,
					"content": "この旅で目標を達成して、師匠があたしの事を認めてくれますようにってお願いしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810420,
					"content": "風神がきっと聞き入れてくれるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "うん！それじゃあ先に進みましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲシェニ"
				},
				{
					"id": 706810414,
					"content": "彼が認めてくれるような成果を出そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "その人も冒険者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
