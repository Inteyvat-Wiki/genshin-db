				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "わぁ。ここの海、キレイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620102,
					"content": "ん？荻花洲は海じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620103,
					"content": "でも荻花洲の水域は確かに海と繋がってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "それはそうだけど…でも、荻花洲を海って言うのは、やっぱり違うと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620105,
					"content": "ぬ…分からない。「海」と「海じゃないの」って、何が違うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620106,
					"content": "水の匂い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "おお！森にある川の水はちょっと甘い、だから海じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620108,
					"content": "でも、もしシードル湖の水が全部シードルだったら、一体なにになるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620109,
					"content": "ウェンティがきっと喜ぶね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "それはさておき、吉法師。おまえ段々喋りが上手くなってきてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620121,
					"content": "五百蔵が言うには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "五百蔵がなんて言ったか、覚えてるか？えっと、「吾輩は天下に名を轟かせる妖狸」…じゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620124,
					"content": "「お腹を掻きたい、うぬぬ。」…「ぬ！」…でもないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620125,
					"content": "ぬはは、パイモン、五百蔵とそっくり。面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620126,
					"content": "「吉法師の匂いに慣れる…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "あ、そうだった！匂いに慣れてきたら、吉法師の言ってる事を理解できるようになるんだったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620128,
					"content": "それから修行も！パイモンたちと一緒にいると、色んなことを学べる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620129,
					"content": "パイモンは優秀なガイドだからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "へえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620131,
					"content": "そんな昔の事、まだ覚えてるのか。オイラ嬉しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620132,
					"content": "#うん！パイモン、{NICKNAME}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620136,
					"content": "この「海」はとてもキレイ。後ろにある家も背が高くてキレイ。写真、撮ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620137,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "一緒に成長できる冒険仲間だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "うん！仲間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620135,
					"content": "最高の仲間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620122,
					"content": "出発する前、五百蔵が言ってたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "陸地から外れた広い水域が、海なのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "おお、すっごく真面目な質問だな。でもそうなると、また「境界」はどこなのかって問題に戻っちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME}はさっき、荻花洲の水は海と繋がってるって言ったぬ。じゃあ「陸地」と「陸地じゃないとこ」って、何が違うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620113,
					"content": "…ちゃんと定義したと思ったけど、結局なにも解決できてないみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620114,
					"content": "所詮人が考えた概念だから、意味はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "荻花洲が自分を海だと思うなら、それは海。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "じゃあ自分を仙人だと思ったら、吉法師は仙人になるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620117,
					"content": "#吉法師、こいつの言うことを信じるな。{NICKNAME}、おまえなに言ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620118,
					"content": "でも、ちょっと無茶苦茶だったけど、こいつの言うことにも一理あるかもな。吉法師はこれから、なろうと思えばどんな妖狸にもなれるぞ。もしかしたら、仙狸にだってなれるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620119,
					"content": "仙狸！イェーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "「吉法師」"
				}
			]
		},
