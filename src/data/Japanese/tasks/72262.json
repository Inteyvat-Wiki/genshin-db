					"nextDialogs": [
						722620319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620319,
					"content": "でも、優しさと心を開くことも忘れないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "そうだぞ！そういう心構えでいれば、色んなことを楽しめるようになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620321,
					"content": "ぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME}とパイモンの説明、難しい。吉法師、理解できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620323,
					"content": "でも、二人はいい人。だから、吉法師は二人から学ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620324,
					"content": "おう、いい子だ！じゃあ早速、釣りの勉強をしようぜ。",
