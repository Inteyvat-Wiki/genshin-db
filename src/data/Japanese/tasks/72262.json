			"dialogs": [
				{
					"id": 722620201,
					"content": "ほら、撮れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620202,
					"content": "次は、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620203,
					"content": "そうだ！吉法師、釣りはやったことあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620204,
					"content": "釣り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620205,
					"content": "ないみたいだな！じゃあ、早速水辺に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620206,
					"content": "うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				}
			]
		},
		{
