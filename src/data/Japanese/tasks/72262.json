				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "うぬぬ…なんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620302,
					"content": "おい、吉法師！なんでヒルチャールの拠点に突っ込んで行ったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620303,
					"content": "ヒルチャールと…遊べるかと思った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620304,
					"content": "ええ？なんでそう思ったんだ？ヒルチャールは危険な魔物だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620305,
					"content": "ヒルチャールは別に危なくないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "おい！吉法師はおまえみたいな百戦錬磨の旅人じゃないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620309,
					"content": "初めて鎮守の森で会った時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "そうだ、あの時ヒルチャールに囲まれてただろ？なにかに変身して隠れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620311,
					"content": "初めて会った時…えーっと…えーっと…そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620312,
					"content": "あの時はヒルチャールと、かくれんぼしてた。森のヒルチャールは妖狸を攻撃しないから、よく一緒に遊んでたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620313,
					"content": "え？ヒルチャールとそんなに仲良くなれるものなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620314,
					"content": "だから知らなかったの、ここのヒルチャールは危険だなんて…うぬぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722620315,
					"content": "とにかく、外にいる時は気を付けないとな！たとえヒルチャールでも…じゃなくて、ヒルチャールには特に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620316,
					"content": "#説明が難しいぞ…{NICKNAME}、代わりに説明してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722620317,
					"content": "良い人と悪い人はちゃんと見分けないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "うんうん！外に出たら、自分の身は自分で守らないとな。",
