			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "うわっ、また君か！ハトが全部飛んだじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480102,
					"content": "まだ餌をあげてる途中なのに、なにしてくれたんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480103,
					"content": "ごめんなさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "お詫びは行動で示せってママが言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480105,
					"content": "橋のハトは僕の友達で、僕がずっと餌をあげてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480106,
					"content": "でも最近アヒルたちがよく餌を食べにくるから、結局どの子もお腹いっぱいになれなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480107,
					"content": "だから小麦を三つ探してアヒルにあげてほしいんだ。僕も橋の上でハトに餌をあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480108,
					"content": "みんなお腹いっぱいになったら、きっと仲良くなれるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "じゃあお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480112,
					"content": "動物たちときちんと向き合えば、君も動物たちと友達になれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480110,
					"content": "あまりハトと友達になりたくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "友達になりたくなくても…まずはこの子たちに謝るのが先だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200480114,
					"content": "だから、早く小麦を探してきて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				}
			]
		},
