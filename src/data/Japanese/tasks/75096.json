			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ポカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960101,
					"content": "おかえりなさい、結構時間かかったね。どうだった、何か出来事はあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960102
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960102,
					"content": "オイラたち、下でいろんなことをしてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750960103,
					"content": "ポカにフレイムグレネードの木の根っこで起こったことを話した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750960104
					]
				},
				{
					"id": 750960104,
					"content": "ティザコのやつ、本当にやっつけてくれたのね…よし、これでワイナ兄貴に報告ができる。もう謎煙の主や豊穣の邦に頭を下げる必要はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960105
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960105,
					"content": "彼ならできるって、私信じてたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960106
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960106,
					"content": "えっ、ワイナ兄貴って、最初からフレイムグレネードの木の根っこに問題があるって知ってたのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750960107,
					"content": "そりゃもちろん、フレイムグレネードの母樹の情況ならみんな知ってたわよ。誰もまだ知らないと思い込んでたのは、ティザコだけ。おまけに意地でも自分で解決しようとしていたんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960108
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960108,
					"content": "頑固なところはあるけど、多分そういうところがみんなから好かれているんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960109
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960109,
					"content": "#今回も本当にありがとう。あはは、実を言えば、あなたたちの名前はとっくに知ってたんだ、パイモン、{NICKNAME}。なんたって伝達使は、情報で食っているからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960110
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960110,
					"content": "だから少し利用させてもらったよ…君たちが現れる場所に通行証を置いたりしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960111
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960111,
					"content": "えっ！？全部おまえの仕業だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750960112,
					"content": "あはは、もちろん。あの石頭から多分報酬をもらってるだろうから、こっちも負けてらんないわ。はい、これをどうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960113
					],
					"speakerTitle": "ポカ"
				},
				{
					"id": 750960113,
					"content": "だから報酬に免じてさ、二人とも大目に見てくれないかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ポカ"
				}
			]
		},
		{
			"id": 7509602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509601",
							"2"
						],
						"stepId": 7509601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティザコ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960201,
					"content": "「山の王のフレイムグレネード」がやっと熟しましたか。これでやっと、一息つけますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960202
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960202,
					"content": "おや、あなたたちでしたか。どうしました？もし入るのなら、ささっと終わらせてくださいね、部族の人にバレたら大変ですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960203,
						750960208,
						750960212
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960203,
					"content": "「山の王」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960204
					]
				},
				{
					"id": 750960204,
					"content": "ほう、「山の王」についてですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960205
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960205,
					"content": "「山の王」コンガマトーとは、その昔、英傑らと一緒にアビスに対抗した偉大な竜なんです。部族のみんなからとても尊敬されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960206
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960206,
					"content": "この「山の王のフレイムグレネード」を献上する専属の人もいますが、噂によれば、ユムカ竜もこっそりそれを「山の王」に与えてるとの話もありましてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960207
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960207,
					"content": "だから、「山の王」は他のユムカ竜よりも…その、幾分逞しいというか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960208,
					"content": "フレイムグレネードの実について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960209
					]
				},
				{
					"id": 750960209,
					"content": "いいことを聞いてくれましたね。フレイムグレネードは実に立派な燃素植物です。自分の根っこを液体燃素に伸ばすことは、大抵の植物にとってかなり勇気がいる行為でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960210
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960210,
					"content": "それに、その実も燃素を豊富に含んでいることから、たくさん食べればユムカ竜にとってはいいこと尽くめです…ユムカ竜が投げ出したりしなければ、の話ですがね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960211
					],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960211,
					"content": "なんせ強い衝撃が加わると、フレイムグレネードの実は爆発してしまいますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティザコ"
				},
				{
					"id": 750960212,
					"content": "通りかかっただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960213
					]
				},
				{
					"id": 750960213,
					"content": "そうですか…「山の王のフレイムグレネード」を一目見ておかなくて、本当によろしいのですか？見ておけば、きっといい気分になれると思いますよ…もし悩み事があれば、ぜひご覧にいらしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティザコ"
				}
			]
		}
	]
}