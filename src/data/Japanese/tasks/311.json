			"dialogs": [
				{
					"id": 3090201,
					"content": "ふぅ、やっと全部片付いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090202,
					"content": "これでモンドの元素の流れも、地脈の循環も元通りになるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090203,
					"content": "<color=#00E1FFFF>騎士団</color>の方に戻ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090204,
					"content": "もちろん、他にやりたいことがあるなら、オイラも付き合うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090205,
					"content": "たとえばモンドで買い物するとか…もしくはもう一回、<color=#00E1FFFF>七天神像</color>を見に行くとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090206,
					"content": "前に四風守護の神殿で、固体になった風みたいなのを手に入れただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090207,
					"content": "モンドの人たちは、それを「失われた風神の瞳」って呼んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090208,
					"content": "神像の眼窩へはめ込むのに値するって意味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090209,
					"content": "目として作られた宝石をツバメが咥えて飛んでったって逸話もあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090210,
					"content": "実は「失われた風神の瞳」に実体はないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090212,
					"content": "「神の目」を持つ人はそれを集め、加護を得るために<color=#00E1FFFF>七天神像</color>に捧げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090213,
					"content": "「神の目」は持ってないけど、この世界の常識を超えたおまえなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090214,
					"content": "試してみたかったら、行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090215,
					"content": "風立ちの地にある七天神像が、オイラたちの場所から一番近いはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3090216,
					"content": "今回、神がどう答えるか…オイラも楽しみだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
