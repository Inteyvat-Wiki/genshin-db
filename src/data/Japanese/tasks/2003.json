			"dialogs": [
				{
					"id": 20030501,
					"content": "招待状にある住所はここみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030502,
					"content": "一般の客は招いておりません。お帰りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "梢"
				},
				{
					"id": 20030503,
					"content": "あっ、ちょっと待ってくれ。オイラたち一般の客じゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030504,
					"content": "海外から密航してこちらに亡命してきた特殊な客ですね。その格好を見れば分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "梢"
				},
				{
					"id": 20030505,
					"content": "そんなこともわかるのか…って、違う、オイラたちはそんなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030506,
					"content": "招待状を見て。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "社奉行の印章、トーマさんですか…お二方は普通の身分ではないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "梢"
				},
				{
					"id": 20030508,
					"content": "では…社奉行の小さな「保有地」、「木漏茶屋」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "梢"
				},
				{
					"id": 20030509,
					"content": "そうこなくっちゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
