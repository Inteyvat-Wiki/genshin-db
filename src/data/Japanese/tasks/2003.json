				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "これが稲妻の良家の屋敷なのか？なんか思ってたほど…そうでもないような？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030402,
					"content": "群玉閣を見てきたからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "神里府へようこそ。お客人方、お嬢がお二人をお待ちしておりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030405,
					"content": "おまえがずっと言ってた「白鷺の姫君」だよな。どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030406,
					"content": "コホンッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030407,
					"content": "屏風の後ろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030408,
					"content": "ハハッ、社奉行のご令嬢は、いつもこうして客人と接しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030409,
					"content": "百年も続いている社奉行の習わしだ。許してやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030410,
					"content": "なんとなく理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "まあ、高貴な「白鷺の姫君」だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030413,
					"content": "海を渡り、長旅で疲れていることでしょう。ここへ来てもこのような形でしか会うことができず、本当に申し訳ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030414,
					"content": "お二方の到着をずっと楽しみにしていました。トーマからの報告で、お二方に「形勢を変える」ほどの力があることも確認しております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030415,
					"content": "昨今の稲妻では、目狩り令の遂行により、人々の願いが次々と踏みにじられています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030416,
					"content": "社奉行は将軍様に仕えているとはいえ、職務上人々と最も近い立場でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030417,
					"content": "もともと奉行の権力は民の信頼からくるもの、このような状況を見て見ぬふりをしていては、安心して眠ることすらできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030418,
					"content": "旅人さん、どうか貴方の力を私たちにお貸しください。私たちならばきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030419,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は雷電将軍に会いに来ただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030422,
					"content": "言ったでしょ、お嬢…そのやり方じゃダメだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030423,
					"content": "もう帰るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "あっ、少々…お待ちを！どうか…お待ちください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030425,
					"content": "うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030426,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "貴方を将軍様のところへ導くことを約束します。その代わり…私の3つの願いを叶える手伝いをしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030428,
					"content": "どんな願いなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030429,
					"content": "3人の…神の目を失った方々にまつわることです…彼らにお会いすれば貴方もきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030430,
					"content": "村を守る武人、過去に目狩り令を執行していた武士、それと天下一を目指す剣術家。これで合ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030431,
					"content": "はい。その者たちをできる限り助けてあげてください。私はここで貴方がたの帰りをお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030432,
					"content": "約束するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "ふふ、ではお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030435,
					"content": "頑張ってくれよ、みんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030433,
					"content": "めんどくさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "反旗を翻しに来たわけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "なんかがっかり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "アカツキワイナリーを見てきたからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
