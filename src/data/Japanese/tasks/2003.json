			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"トーマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "やっと着いた。トーマは？トーマはどこだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030102,
					"content": "あれ…トーマのやつまさか約束を破ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030103,
					"content": "約束を破るだなんてひどいな。君たちこそオレのことを忘れてたじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030104,
					"content": "ど、どういうことだ！？犬がしゃべった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030105,
					"content": "フンフンフン…驚くことはない。オレのこの状態を見るのは初めてだったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030106,
					"content": "トーマって…犬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "ふむ…璃月ではこのようなものを見たことはなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030109,
					"content": "そうか、オイラなんかわかった気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030110,
					"content": "何かが違う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "ハハハハハッ…もう冗談はここまでにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030113,
					"content": "おい！おまえってやつはなんでいつもこうなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030114,
					"content": "離島の時も、茶屋の時も、君たちを待つ時間がとてつもなく長くてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030115,
					"content": "こんな特殊な待ち合わせ方法を考えたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030116,
					"content": "でも…やはり二人にはオレからのきちんとした謝罪を受け取ってほしい。これまでの数々の「試練」は、必要な形式だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030117,
					"content": "すべては君たちをお嬢のところまで連れていき、オレたちの…雷光に立ち向かえる仲間になれるかどうかを見極めるためのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030118,
					"content": "真面目な顔になったからってオイラたちが許すと思うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030119,
					"content": "アハッ…やり過ぎたかな、悪い悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030120,
					"content": "じゃあ…試練の結果は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "君は最初から「規則」なんかに捉われるような人じゃないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030123,
					"content": "君の「意志」は揺らぐことがなく、屈服することもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030124,
					"content": "遥か昔、オレもそんな仲間を一人持っていた、しかし雷光が下され…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030125,
					"content": "それって万葉の友達…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "へぇ、君たちも彼のことを知っているとは、どうやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030128,
					"content": "…彼の光は微かなものなんかじゃなかったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030129,
					"content": "もう「白鷺の姫君」に会える？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "もちろんさ。社奉行所の神里府まで連れて行ってあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030131,
					"content": "だが…その前に、もう一つ二人には来てほしい場所があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030132,
					"content": "ん？どこだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030133,
					"content": "鳴神島に住んでいる限り無視することのできない、建設中の巨大な——「千手百目神像」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030126,
					"content": "前に御前試合で亡くなった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "雷光に立ち向かえる仲間って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "でも、これ完全に犬だよ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "人型のトーマはどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トーマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "この神像の周り、なんか殺伐とした雰囲気が漂ってるぞ…普通の人はこんなとこ近寄りもしないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030202,
					"content": "あれ、よく見ると…上にはめてあるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030203,
					"content": "神の目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030204,
					"content": "神の目！目狩り令で押収した神の目を、この神像にはめ込んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030206,
					"content": "将軍はどうして目狩り令を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "やはり、もう目狩り令のことは聞いているんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030207,
					"content": "君たちも知っての通り、モンドは「自由」の国、璃月は「契約」の国…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030208,
					"content": "そして稲妻は…「永遠」の国なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030209,
					"content": "雷電将軍は稲妻の統治者であり、稲妻の神でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030210,
					"content": "幾千年も変わらない永遠こそ、この国を司る「彼女」の意志なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030211,
					"content": "そのため、三奉行によって国政を固め、鎖国令で人員の流動を阻止する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030212,
					"content": "稲妻をそのように静止した状態にし、時間という流れから逸脱させ、稲妻を不変のまま「永遠」まで辿り着かせる。それが将軍の考えだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030213,
					"content": "神にも自分たちの考えがあるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030214,
					"content": "もちろん、これはオレ自身の見解だけどね。最近行われている目狩り令の理由については…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030215,
					"content": "もしかしたら将軍は、神の目が人々に「変革」の力をもたらすと思っているのかもしれない。そのような「不安定」な存在は、将軍の思う「永遠」にふさわしくないのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030216,
					"content": "だから雷電将軍は「天領奉行」の部下たちに神の目を集めさせ、この神像にそれらを一つ一つはめ込んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030217,
					"content": "この「千手百目神像」は、稲妻の「永遠」の象徴とも言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030218,
					"content": "なんか…雷電将軍ってちょっとわがままじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030219,
					"content": "ハハッ、君たちみたいな異郷人くらいだろうね、そんな風に雷電将軍を批判できるのは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030220,
					"content": "だが…オレもそう思うよ。目狩り令はあってはならないものだ。お嬢は目狩り令が出されたその日から、抵抗する決心をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030223,
					"content": "さっきのは…何の音？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#あれっ？{NICKNAME}、どうしたんだ？そんな顔して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030222,
					"content": "ん？音？オレは聞こえなかったけど、何か起きたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030225,
					"content": "他の人の…「願い」を聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "神像に触ったんだよな、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20030226,
					"content": "「願い」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030227,
					"content": "ふむ…確かにそれは、ある言い伝えを裏付けることになるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030228,
					"content": "聞いたことはあるかな？人の願いが一定の強さに達した時、神の視線がその者に降りそそぐ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030229,
					"content": "それが神の目の由来なんだ。言い換えれば、神の目はその者の願いを代表している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030230,
					"content": "もし君が言ったことが本当であれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030232,
					"content": "神の目が象徴するのは力じゃなくて願い…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "どうやら…人々の願いはオレが思っていたよりも根強いものだったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030233,
					"content": "さあ、鳴神島のお客人方、そろそろ次の場所——神里府へ向かおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20030234,
					"content": "やっと行けるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
