			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コレイ",
					"エウルア",
					"レッシグ",
					"クレー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "アアル村から出発するなら…キャラバン宿駅とパルディスディアイを通れば…遠回りだけどスメールシティに行けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401251202,
					"content": "なるほどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401251203,
					"content": "途中で何か買いたいものはあるか？好きなお土産を買うといいよ、私が運ぶから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "レッシグ"
				},
				{
					"id": 401251204,
					"content": "手に持てる限り、どんなに重くても問題ないさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "レッシグ"
				},
				{
					"id": 401251205,
					"content": "そんなに贈る相手がいないでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401251206,
					"content": "ママにアルベドお兄ちゃん、ジン団長、レザー…それから、ディオナお姉ちゃんにモナお姉ちゃん、フィッシュルお姉ちゃんでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401251207,
					"content": "なんで私を見るわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401251208,
					"content": "いやいや、なんでもないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401251209,
					"content": "クレーはみんなにどんなお土産を買いたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 401251210,
					"content": "えっとね…夕暮れの実の味のキャンディ！それと、キノコンみたいに大きな帽子、あとね、あとね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401251211,
					"content": "みんなにいーっぱい物語の本を買っていってあげたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401251212,
					"content": "でもママへのお土産は、まだ決めてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 401251213,
					"content": "大丈夫よ、歩きながら見ましょう。お姉ちゃんたちも手伝うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401251214,
					"content": "うん！ありがとう、お姉ちゃんたち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				}
			]
		}
	]
