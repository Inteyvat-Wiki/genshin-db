			},
			"dialogs": [
				{
					"id": 401251101,
					"content": "珊瑚宮さんは貝を持ち帰らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 401251102,
					"content": "イディアさんのところに預けておくほうがいいと思いますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401251103,
					"content": "今の海祇島には新たな「宝物」がありますし…それに、人々の願いも少しずつ叶えられるようになってきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 401251104,
					"content": "ですから、貝にはこの瓶の中にある蜃境を守ってもらって、通りかかった旅の人たちの夢に寄り添ってもらうほうがいいと思うんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
