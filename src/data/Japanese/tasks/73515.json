				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "来たか、冒険者。設置を始めようとしたところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150102,
					"content": "すべてが順調に運んだら、今日こそやつをぎゃふんと言わせてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150103,
					"content": "本格的にチャージが始まると、魔物がまた襲い掛かってくるかもしれないわ。そのときになったら、装置のチャージ進捗と破損の状況に、どうか注意しながら戦ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735150104,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "本当にありがとう、冒険者さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735150107,
					"content": "あっ、いいことを思いついたぞ！「対ウェネト殺蟲大砲」のために散々苦労してきたからね…この初試射の栄誉を、君に託すよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150108,
					"content": "自分でやるつもりじゃなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "設置できるところを見られるだけで僕は満足だ！それに、他の人に点火してもらったほうが、僕も発射時の全貌を見られる…コホン！とにかく、君に任せた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150112,
					"content": "魔物からチャージ装置を守り、チャージが溜まったら——ウェネトが隙を見せた一瞬を狙って、砲台を思いっきり叩く！それだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150113,
					"content": "あとはみんな、点火装置と自動補正装置がやってくれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150114,
					"content": "#なんだかすごそうだな…{NICKNAME}！オイラも見てみたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735150115,
					"content": "分かった、操作してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "ははっ、そうこなくっちゃな！僕が具体的な操作プロセスを説明してあげよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150110,
					"content": "操作方法を知らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "安心していいぞ！僕は完璧にユーザーフレンドリーの原則に従って、これを設計したからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735150105,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}