			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー",
					"リサ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2207.302,
							230.089,
							-804.911
						],
						"pointId": 5742
					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "へへっ！ドドコはわるいツノツノ魚の兵士の大群に勝ったんだよ！ツノツノ魚の大王だって敵じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360102,
					"content": "ドドコとボンボン爆弾、ドッカン花火の組み合わせが、一番強いの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360103,
					"content": "無敵だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "このゲームを遊んでると、ちょくちょくシードル湖の話を思い出すんだよな…まさか、リサさんはあれをアレンジしてこのゲームのテーマにしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360106,
					"content": "ところで実際、もしあの外来種の魚たちを見つけられなかったら…怪しげな岩礁を一通りクレーに爆破させれば、それで万事解決じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360107,
					"content": "本当にだめだったら、オイラたちも爆弾をいくつか起爆させたら、この事件を解決できるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360108,
					"content": "いつにも増してクレーと気が合いそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "ふふ、その表情…どうやらこのゲームを楽しんでくれているみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360111,
					"content": "リサお姉ちゃん、来てくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360112,
					"content": "リサさん、やっと顔を見せたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360113,
					"content": "おまえの作った「ドドコドッカン冒険記」、すごく面白かったぞ。クレーと存分に楽しませてもらったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360114,
					"content": "気に入ってくれてありがとう。それって、この作品の続きを作ってくれって意味かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360115,
					"content": "やったー！クレー、続きが知りたい。ドドコが他のところを冒険する話も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360116,
					"content": "い、いや…でも…クレー覚えてる。リサお姉ちゃん、このゲームを作るのに、たくさん時間がかかったんだよね。きっとくたくたなはずだから…リサお姉ちゃんを疲れさせてばかりいられないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360117,
					"content": "あら。クレーちゃん、お姉ちゃんのことを気にかけてくれるの？お姉ちゃん、とても嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360118,
					"content": "こういうゲームを気に入ってくれて、城内で大人しく遊んでいてくれるのなら、どれだけ時間を費やしたって構わないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360119,
					"content": "もちろん、自由に色んなところを冒険してまわるのが、クレーちゃんの一番好きなことだって言うことはわかってるわ。このゲームはただの、ちょっと変わった新しい暇つぶしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360120,
					"content": "だから、みんなに良い知らせを持ってきたの。可愛い子ちゃんたちへのプレゼントもあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360121,
					"content": "プレゼント！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360122,
					"content": "#あ、あのねあのね、クレーも栄誉騎士のお{M#兄}{F#姉}ちゃんとパイモンちゃんにプレゼントがあるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360123,
					"content": "じゃあプレゼントは最後にしましょうか。まずは良い知らせから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360124,
					"content": "もしかして、シードル湖の問題が解決した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "そうなの。調査小隊の二人の騎士が、外来魚の巣窟を見つけて、やっつけたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360127,
					"content": "外来魚が突然現れた原因も、騎士団の調査によってはっきりしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360128,
					"content": "今回のアクシデントは、とある商人が悪意なくとった行動によるものだったの。他意はなかったということを考慮して、彼女には相応の罰金を支払ってもらったうえで、騎士団がきちんと教育したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360129,
					"content": "ふぅ…大きな被害にならなくてよかったな。でも、その商人もちょっと不用意すぎだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360130,
					"content": "シードル湖の水質は、これで安心！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "じゃあ、次は…プレゼント発表の時間だよ！クレーが先に言って良い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360133,
					"content": "もちろんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360134,
					"content": "わたくしも不思議に思っていたわ。クレーちゃんったら、最近誰に注意されるでもなく、毎日ちゃんと早くに帰って来てたんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360135,
					"content": "ふふん～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360136,
					"content": "夜おうちにいるとき、アルベドお兄ちゃんの手作りの絵本でやり方を見ながら、これを作ってたんだよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360137,
					"content": "じゃじゃーん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360138,
					"content": "これは…ボンボン爆弾を投げようとしてるドドコだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360139,
					"content": "うん！クレー、「ドドコドッカン冒険記」のこまを参考に、このドドコのぬいぐるみを作ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360140,
					"content": "このドドコは本物のボンボン爆弾を投げることはできないけど、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360141,
					"content": "#このぬいぐるみを見たら、栄誉騎士のお{M#兄}{F#姉}ちゃんとパイモンちゃんも、ここ数日間の楽しい時間を思い出して、悩みや退屈が消えてなくなると思ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360142,
					"content": "ドドコのでっかいぬいぐるみか！確かにすごいサプライズだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360143,
					"content": "これがあれば、いつでもクレーとドドコに会えるような感じがするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360144,
					"content": "ありがとう！クレーは優しくて器用だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "#へへっ！栄誉騎士のお{M#兄}{F#姉}ちゃんもパイモンちゃんも、プレゼント気に入ってくれたんだね。クレーの頑張りは大成功だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360147,
					"content": "リサお姉ちゃんのプレゼントはどんなの？クレーも知りたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360148,
					"content": "あら、クレーちゃんの真心に比べたら、わたくしのプレゼントは随分控えめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360149,
					"content": "さあ、「ドドコドッカン冒険記」の冒険物語を見てみましょう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360150,
					"content": "冒険物語！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360151,
					"content": "一冊の本にしたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360152,
					"content": "可愛い子ちゃんたちはモンドに戻ってくると、クレーちゃんと一緒にドドコの冒険の旅に参加したの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360153,
					"content": "一緒にわるいツノツノ魚の兵士を倒して、アフタヌーンティーを楽しんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360154,
					"content": "この物語こそ、「ドドコドッカン冒険記」の一番完璧な姿よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360155,
					"content": "もしかして、リサさんはゲームのステージを考えてるときに、すでにこのストーリーをみんな思いついてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360156,
					"content": "いいえ、パイモンちゃん。この物語は、可愛い子ちゃんとあなたとクレーちゃんが、力を合わせて完成させた物語よ。あなたたちこそが、すべてを決定した主人公なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360157,
					"content": "挿絵を入れようと思って、本の中に場所を空けてあったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360158,
					"content": "提案があるの——みんながゆっくり集まれる機会は貴重だし、せっかくだからあなたたちの記念写真を撮らせてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705360159,
					"content": "おう！友だちに会えた上に、楽しいゲームで遊べたんだから、確かに記念すべき瞬間だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705360160,
					"content": "楽しい一枚にしよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#じゃあ、撮ってもらおう！栄誉騎士のお{M#兄}{F#姉}ちゃんとパイモンちゃん、こっちこっち！リサお姉ちゃん、お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360163,
					"content": "今日も楽しかったね！3、2、1——ドドコ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 705360161,
					"content": "平穏な時間も貴重だしね！",
