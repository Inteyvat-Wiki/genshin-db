			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726520101,
					"content": "旅人さん、こんにちは！最近どうですか？「南十字」武装船隊を手伝ってみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520102,
						726520103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520102,
					"content": "「南十字」武装船隊…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				},
				{
					"id": 726520104,
					"content": "ええと…アハハ、すみませんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 726520105,
					"content": "「死兆星」号の首席機関士、慕珍と言う者です。ずっと船倉にいてあまり出てこなかったから、知らないのもおかしくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520106,
					"content": "その結果、海龍さんに追い出されちゃいました、ハハ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520107,
					"content": "「体を動かせ！たまには日光を浴びろ！」って、私を海岸に降ろしました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520108
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520108,
					"content": "なのに、自分は船から降りることすらできません。陸地酔いするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520109,
						726520110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520109,
					"content": "そうか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520111,
					"content": "あ、本当にごめんなさい。人のことを笑うばかりで、大事なことを忘れてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520112
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520112,
					"content": "北斗の姉御の次の航路に備えて準備をしなくちゃいけないから、雑用の手助けをして欲しいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520113
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520113,
					"content": "以前は、こう言ったことも姉御が自らやっていました。「南十字」を統べる者、先駆者となって危険に踏み込まなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520114
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520114,
					"content": "これも私たち「南十字」の掟です。誰が親玉になろうと、この危険を担う義務があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520115
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520115,
					"content": "今は姉御が稲妻で優先すべき注文があるから、こんなことで邪魔しちゃいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520116
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520116,
					"content": "だからオイラたちに押し付けるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726520117,
					"content": "エヘッ、私は機関士だから戦うのはちょっと…船のみんなも自分の仕事があって、忙しんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520118
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520118,
					"content": "雑談はここまでにして、事情を言いますと——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520119
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520119,
					"content": "次の注文の雇い主がサンプルを要求してきたんです。つまり、この地で見られる特殊な遺跡機械の部品です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520120
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520120,
					"content": "雇い主が渡してくれた目撃情報によると、あの機械…あるいは生物は稲妻列島に隠れていて、非常に面白いと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520121,
						726520125,
						726520130
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520121,
					"content": "雇い主…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520122
					]
				},
				{
					"id": 726520122,
					"content": "どうしました、「南十字」の秘密を聞きたいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520123
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520123,
					"content": "ハハ、緊張しないでください。私も知っていたら、教えてあげたいところなんですが…こっちの世界で、「死罪」で罰されますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520124
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520124,
					"content": "だからすみません。雇い主が誰なのかは知らないんです。あなたにとっても重要なことではないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520134,
					"content": "居場所はどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520135
					]
				},
				{
					"id": 726520135,
					"content": "良い質問です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520136
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520136,
					"content": "今、居場所が分からなくて悩んでました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520137
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520137,
					"content": "しかし、島のいくつかのところで怪しい雷元素の活動を確認しました。私の推測によると、その頻度は他の雷元素の活動と大きく差があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520138
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520138,
					"content": "まとめて言いますと、それらの異常が発生したエリアを先に調査すれば、私たちの目標へと導いてくれる可能性が高いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520139
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520139,
					"content": "ついでに、もしあの機械たちから副産物が出たら、それも私に持ってきて欲しいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520140
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520140,
					"content": "ご安心ください、報酬はきちんと払います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520125,
					"content": "機械生物…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520126
					]
				},
				{
					"id": 726520126,
					"content": "…はい、以前、層岩巨淵でも似たような機械が掘り出されました、500年前の厄災と関係あるんだとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520127
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520127,
					"content": "とにかく…遺跡をぐるぐる回っている不吉な存在なんですが、恐ろしいばかりじゃなく、ドキドキも止まりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520128
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520128,
					"content": "ここにもいると知ったら、1体分解したくてたまらなくなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520129
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520129,
					"content": "機関士じゃないあなたには理解し難いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520130,
					"content": "面白い…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520131
					]
				},
				{
					"id": 726520131,
					"content": "うん…自分の手で分解したくなりませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520132
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520132,
					"content": "あまり…したくはないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726520133,
					"content": "はぁ。いいでしょう…機関士だけが、私の熱情が分かるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726520110,
					"content": "何かお困り？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の知り合い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				}
			]
		}
	]
}