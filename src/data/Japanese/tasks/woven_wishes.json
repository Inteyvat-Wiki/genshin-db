			},
			"dialogs": [
				{
					"id": 120050301,
					"content": "大人しく捕まれ！こそ泥め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050302,
					"content": "はっ！そんな人数で何ができるというんだ？寝言は寝てから言え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050303
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050303,
					"content": "何を自信満々にそんなことを…なんてやつらだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050304
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050304,
					"content": "何か間違ったことを言ってるか？じゃあ聞くが、お前は他国から来た商人だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050305
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050305,
					"content": "万国商会、稲妻の地にみすぼらしく寄生する害虫どもめ！お前らが今まで誰かに助けられ、一度でも守られたことなんてあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050306
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050307
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050307,
					"content": "ははははっ！自分の立場もよく分かってないようだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050308
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050308,
					"content": "この稲妻では、お前たちみたいな無力な商人が狩られるのは当たり前だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050309
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050309,
					"content": "…おのれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050310
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050310,
					"content": "おい！余所者、一つ交渉と行こうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050311
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050311,
					"content": "交渉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050312
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050312,
					"content": "モラを払ってこれらの布地を買うってのはどうだ？血まみれでここを去るよりはましだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050313
					],
					"speakerTitle": "浪人"
				},
				{
					"id": 120050313,
					"content": "いい加減にしろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050314,
					"content": "私は…くっ！諦めるしかないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050315
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050315,
					"content": "お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050316
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050316,
					"content": "久利須さん、モラを渡す必要はございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050317
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050317,
					"content": "し、しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050318
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050318,
					"content": "私たちの約束を覚えていますか？貴方はこの件を他言しない、私は貴方のためにこの件を解決すると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050319
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050319,
					"content": "はい、そうでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050320
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050320,
					"content": "では貴方は安全な場所へ避難し、自分の身を守ってください。ここからは…私が約束を果たす番です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
