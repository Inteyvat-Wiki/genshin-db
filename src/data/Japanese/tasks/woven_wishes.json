			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050101,
					"content": "おや？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050102
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050102,
					"content": "祭りの告知だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050103,
					"content": "そういえば、オイラたちまだ稲妻の賑やかで面白い場所に行ったことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050104,
					"content": "綾華は祭りに行きたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050105
					]
				},
				{
					"id": 120050105,
					"content": "ち、違います！コホンッ…私はただ…お祭りは稲妻でよく行われているので、私たち社奉行の者はすでにそのような風習に慣れていると言いたかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050106,
					"content": "この時期になると、稲妻の民たちはみなお祭りに参加します。それと同時に、治安維持も難しくなり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050107,
					"content": "もちろんお祭りは賑やかで楽しいものなのですが、私たちにとっては心配すべきことでもあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050108
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050108,
					"content": "あっ！仕事ばかりに気がいってしまい、話が逸れてしまいました。すみません…私が行きたかったのはその隣の店舗です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050109
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050109,
					"content": "この看板を見に来たんじゃないのか。じゃあ早く店の中に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050110,
					"content": "新しいお着物、ちょっと見ていきませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050111
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050111,
					"content": "あら、神里さまに異郷のお客さん方！小倉屋へようこそ。布地と着物のあつらえ、どちらをご所望で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050112
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050112,
					"content": "こんにちは、こちらに着物の裁断図があるのですが、見ていただけないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050113,
					"content": "おお！裁断図なんか持って来てたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050114,
					"content": "どれどれ…おや？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050115
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050115,
					"content": "見ての通り、こちらは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050116
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050116,
					"content": "とても素晴らしい裁断図じゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050117
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050117,
					"content": "神里さま、この着物をあつらえたいということでよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050118
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050118,
					"content": "はい、お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050119
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050119,
					"content": "神里さまがうちに来て着物の注文をするなんて、小倉屋にとってとても光栄なことです。ただ…少々厄介な問題がありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050120
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050120,
					"content": "その着物を作るには、霓裳花で作られた絹が必要なんです。稲妻にある絹の多くは璃月港から輸入された物なんですが、今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050121
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050121,
					"content": "神里さまも知っての通り、稲妻はいま鎖国状態にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050122
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050122,
					"content": "正直なところ、服飾界隈も大きな影響を受けています。高級な布地が手に入りづらく、着物のあつらえも長いこと保留にしてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050123
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050123,
					"content": "しかし、お客さんがご自身で布地を持参できるのでしたら、着物を作ることはできますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050124
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050124,
					"content": "自分で布を買わないといけないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050125,
					"content": "小倉屋ですら手に入らない高級布地…いったいどこであれば買えるのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050126
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050126,
					"content": "万国商会に行ってみてはどうですか。彼らは大陸各地に店舗を設けているので、私たちより多くの伝手を持っていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050127
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050127,
					"content": "価格は少し高いかもしれませんが、このような時代ですので…欲しいものが買えるだけで十分ですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050128
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050128,
					"content": "稲妻で服を作るのはこんなに大変なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050129,
					"content": "たしか、万国商会って久利須のところだよな？そういえばオイラたち、もうずいぶん離島には行ってないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050130,
					"content": "ということは…どうやら万国商会へ行ってみる必要があるみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050131
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050131,
					"content": "ありがとうございました、布地を買ったあとにまた来ます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050132
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050132,
					"content": "その前に、少しお願いがあるのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050133
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050133,
					"content": "綾華のやつ、コソコソとなんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050134,
					"content": "は、はい…わかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050135
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050135,
					"content": "ではよろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050136
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050136,
					"content": "いえ、そうかしこまらないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050137
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050137,
					"content": "正直、我々小倉屋もすでに長いこと絹を使った着物を作っていません。それにとても綺麗な裁断図ですし…私も皆さんと同じで、とても楽しみなんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050138
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050138,
					"content": "ありがとうございます。では、私たちはこれで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050139
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050139,
					"content": "旅人さん、パイモンさん。万国商会で私たちの運を試してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
			"id": 1200502,
			"completionStepIds": [
				1200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200506",
							"2"
						],
						"stepId": 1200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"久利須"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050201,
					"content": "あそこ！久利須会長だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050202,
					"content": "ええ、あの方で間違いないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050203
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050203,
					"content": "ふむ…いったいどうしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050204
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050204,
					"content": "久利須さん、どうかなさいましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050205
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050205,
					"content": "お、おお！あなたは神里家の…綾華さま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050206
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050206,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050207,
					"content": "それに旅人さんも。お久しぶりです、近頃は離島から離れたみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050208
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050208,
					"content": "うん、久しぶり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050209
					]
				},
				{
					"id": 120050209,
					"content": "以前はどうも。あなたのおかげで私たちの商売もまた上手く回り始めました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050210
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050210,
					"content": "あれ、ところで…なんでこんなところでボーっと突っ立ってたんだ？なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050211,
					"content": "それが…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050212
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050212,
					"content": "お恥ずかしながら、万国商会の貨物が浪人に奪われてしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050213
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050213,
					"content": "中にあった貨物とはなんだったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050214
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050214,
					"content": "高級な絹です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050215
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050215,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050216
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050216,
					"content": "何年か前に璃月から大量の絹を仕入れ、ずっと倉庫に保管していたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050217
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050217,
					"content": "近頃、稲妻城にある着物店の絹がそろそろ底を尽きるとの情報を耳にしまして、これを売って商売をしようと思ったのですが、まさかそんな時に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050218
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050218,
					"content": "はぁ…あの浪人たち…貨物を奪うとそそくさと森へ逃げていきました。私も被害届を出そうと思ったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050219
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050219,
					"content": "あなたも知っての通り、私たち外国の商人はあまりよく思われていません。「勘定奉行」の方々は私たちの話をまったく聞かないどころか、もっと不運に見舞われればいいとさえ思っているでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050220
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050220,
					"content": "私も個人的に「勘定奉行」のやり方は認めていませんが、それでもここは稲妻です。久利須さん、発言にはご注意ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050221
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050221,
					"content": "あぁ、申し訳ございません。つい愚痴をこぼしてしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050222
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050222,
					"content": "今のところ良い案も思い浮かばず、我々商会の人間だけでは貨物を取り戻すことも難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050223
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050223,
					"content": "はぁ、この損害はきっと運命によって定められた避けようのないものだったのでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050224
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050224,
					"content": "正式な手続きはできませんが、遺失物の回収を手伝うことはできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050225
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050225,
					"content": "そうですか、やはり…って、え！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050226
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050226,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050227,
					"content": "本当に大丈夫なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050228
					]
				},
				{
					"id": 120050228,
					"content": "はい。しかし、個人名義でこのことに対処するとはいえ、私の一言一行は多かれ少なかれ社奉行と神里家の印象に関わってくるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050229
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050229,
					"content": "そのことだけが少々不安ですので…このことはどうかご内密に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050230
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050230,
					"content": "それと、人生において困難に直面した時、必ずしも誰かが手を差し伸べてくれるわけではございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050231
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050231,
					"content": "貴方の万国商会という立場を鑑みて、私から助言がございます。不必要な損失を避けるためにも、今後はより一層注意を払っておくべきでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050232
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050232,
					"content": "はい、必ず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050233
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050233,
					"content": "しかし、お手伝いいただけるのはありがたいのですが、これではあなた方に面倒をかけるのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050234
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050234,
					"content": "万が一、勘定奉行のお方があなたに対して何か良からぬ考えを持っていたら…それにあなたは民衆の間でも高い評判を持つお方、我々のような一般人のために損害を被る必要はありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050235
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050235,
					"content": "ご冗談を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050236
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050236,
					"content": "何を言おうと私は神里家の長女。勘定奉行の方たちに私の行動を言及する資格はございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050237
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050237,
					"content": "うぉ！なんて気迫感じる発言！これが良家のお嬢様ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050238,
					"content": "久利須さん、貨物が奪われた具体的な時間、場所、そしてその者たちの特徴を教えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050239
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050239,
					"content": "ありがとうございます！なんとお礼を言ったらよいか。時間は2時間前、場所は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050240
					],
					"speakerTitle": "久利須"
				},
				{
					"id": 120050240,
					"content": "皆さん、私と一緒に現場まで行き、調査をしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050241
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050241,
					"content": "よし、出発っ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
