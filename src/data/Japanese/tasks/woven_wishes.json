						120050902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120050902,
					"content": "皆さん、おかえりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050903
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050903,
					"content": "どうでしたか？万国商会に在庫はありました？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050904
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120050904,
					"content": "はい、手に入れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050905
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120050905,
					"content": "これを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
