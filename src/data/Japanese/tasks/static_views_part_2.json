			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランミナリ",
					"パイモン",
					"アランニムバ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "ひっ！金色のナラだ！それに、風の匂い、土の匂い、それとアランナラの匂い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990302,
					"content": "金色のナラも、アランヤマのアランラカラリが解けたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990303,
					"content": "こわいこわい！障害が無駄になった。誰でも入れるようになったら、アランミナリの「ハッピーな我が家」が、「突破」されちゃう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990304,
					"content": "うわぁ、落ち着いてくれ。オイラたち、悪意はないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990305,
					"content": "「悪意」がないってどういうこと？「欲張り」じゃないってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990306,
					"content": "#えっと…まあ、そんなところかな！オイラと{NICKNAME}はアランナラの味方だぞ。おまえらと友達になりたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990307,
					"content": "パイモンは食いしん坊だけどいいやつ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "おい！間違ってはないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990309,
					"content": "アランナラの友達…金色のナラからは、アランナラの匂いがする。懐かしくて、久しぶりな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990310,
					"content": "#あっ、そうだ、あの変な種！{NICKNAME}、その種をアランミナリに見せてみようぜ。なにか知ってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990311,
					"content": "ううう！喉が渇いてるんだ！いっぱいお水を飲まないと、元の姿に戻れないよ…急いで、ここにはお水がたくさんあるから。お腹いっぱいになるまで飲ませてあげたら、元気になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990312,
					"content": "種を水の中に入れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "…ぷぅっ！戻れた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990314,
					"content": "#うわぁ！種がアランナラになった！「閉じ込められたアランナラ」、本当に見つけたぞ！な、オイラが言った通りだっただろ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990315,
					"content": "本当に「閉じ込められたアランナラ」だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "アランニムバだ！アランニムバはボクと違って、旅をするのが好きなんだよ。この間まで、遠い場所から見た景色を描いて、ヴァナラーナに届けてたんだけど、その後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990318,
					"content": "その後、すごく硬くて、暗い場所に行っタ。土が少なくて、石が多かっタ…土の下は、草が少なくて、木も少なくて…でもキノコがたくさんあっタ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990319,
					"content": "えっと、それって層岩巨淵のことだよな？でも、アランニムバはアランナラなのに、スメールを離れてそんな遠い場所まで行ったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990320,
					"content": "ウン！旅は長かったし、危険もあっタ。黒いナラに出会った時は、危なかっタ！でもアランニムバはアランムフクンダに見守られてタ。種になって、「九死に一生を得」タ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990321,
					"content": "アランニムバが安全に帰れるのは、金色のナラと白いふわふわのおかげダ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990322,
					"content": "#{NICKNAME}とパイモンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990323,
					"content": "#うん！ナラ{NICKNAME}とパイモンは、アランナラの友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990324,
					"content": "#アランミナリとアランニムバは「親友」。だから、ナラ{NICKNAME}とパイモンもアランニムバの「親友」ダ！ウン、わかっタ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990325,
					"content": "アランニムバは旅に出るんダ。今回は、絵だけじゃなくて、「プレゼント」もアランミナリに送り返ス。「宝箱」に入れるためニ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990326,
					"content": "ここの「宝箱」は、ぜーんぶアランミナリのものなの。アランミナリは「宝箱」のオーナー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990327,
					"content": "たくさんのアランナラを助けてくれたアランナラの本当の友達に、アランナラは「恩返し」をしなくちゃ。だから、「お宝」を「箱」に入れるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990328,
					"content": "箱は元々空っぽだったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990329,
					"content": "アランナラは生まれた時から、ヴァーナのすべてを知ってるよ。でも「箱」は生まれた時、お腹が空っぽ！アランミナリにも何でかよくわからないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990330,
					"content": "オイラもよくわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990331,
					"content": "#…アランミナリが準備できたら、ナラ{NICKNAME}は「宝箱」を開けて、緑色のナラみたいに、「やった！」をしたり、「はぁ…」をしたりするの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990332,
					"content": "どうしてそんな手間が掛かる方法でやるんだ？宝箱に入れるつもりのものを直接オイラたちに渡してくれていいんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990333,
					"content": "#アランミナリは知ってるの。緑色のナラは、洞窟や部屋の中に入って、「宝箱」を開けるのが好き。ナラ{NICKNAME}とパイモンは、好きじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990334,
					"content": "えっと…確かに好きじゃないとは言いにくいな…なんか…不思議とひきつけられる、みたいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990335,
					"content": "うん、ナラは「宝箱」が好き、アランミナリも好き。だから、アランナラを助けたいいナラは「宝箱」を開けてもいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990336,
					"content": "ヴァーナにはたくさんのアランナラが居て、ナラと遊びたいコもいる。その願いを叶えてくれるナラは、アランナラの友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990337,
					"content": "そういうナラは、アランミナリが用意した「宝箱」を開けてもいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990338,
					"content": "だからアランニムバはすぐに出発すル！「宝箱」をいっぱいにするためニ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990339,
					"content": "あれ、でもアランニムバは帰ってきたばっかりなんだろ？なのにもう出発するのか？嵐みたいなやつっていうか、電光石火っていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990340,
					"content": "ひッ！風はいいけど、火はダメダ。火に近すぎると、アランニムバはすぐ渇いてしまウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "アランニムバ"
				},
				{
					"id": 730990341,
					"content": "あっ、そういう意味じゃなくて、アランニムバがなんでそんなに急ぐのか、わからないってことだ。もうちょっと留まって、アランミナリと話でもしてけばいいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990342,
					"content": "アランミナリだって、アランニムバとは久々なんだろ？なにか話したいこととか、ないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990343,
					"content": "アランニムバは止まらないアランナラ。だから「宝箱」のオーナーにはなれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990344,
					"content": "アランニムバがどこを旅してるのか…ヴァーナが知り、風が知り、花や草が知れば、アランミナリはわかるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990345,
					"content": "だから、大丈夫なの。お話が少なくても。アランニムバが話したいなら、アランミナリは聞く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "アランミナリ"
				},
				{
					"id": 730990346,
					"content": "#ふぅん…これがアランナラの友情ってやつなのか？オイラならきっと、{NICKNAME}とどんなに話しても尽きないくらい話があるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990316,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
