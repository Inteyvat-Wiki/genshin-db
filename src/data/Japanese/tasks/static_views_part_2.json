				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "へへっ、アランナラの世界って不思議だな…絵を見たら、宝箱が見つかるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990102,
					"content": "これで、絵にあるすべてのポイントを見つけたな！この宝の地図たちを描いたアランナラは一体どこにいるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990103,
					"content": "すべてじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "そういえばそうだな。たくさんのアランナラが一緒に描いた絵からは、お宝を発見できなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990106,
					"content": "（バッグの中で、なにか震えたぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990107,
					"content": "（震えたのはこれか。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "あれ、これって…前に層岩巨淵の地下で見つけた種か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990109,
					"content": "#まるで{M#俺}{F#私}たちをどこかに導こうとしてるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "うん…もしかしたら本当にそうかもしれないぞ！次にこの種が震え出したら、また考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990113,
					"content": "「閉じ込められたアランナラ」が本当にいるかもしれないぞ！それとも、「アランナラの宝物庫」とかがあったりして…その種がカギとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990111,
					"content": "意味不明すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "えっと…この種は、多分どこかに行きたいんじゃないか？次にこの種が震え出したら、また考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730990104,
					"content": "あともう一つ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
