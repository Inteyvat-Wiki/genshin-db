			"dialogs": [
				{
					"id": 411350501,
					"content": "旅人、グローリーには会えたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350502,
					"content": "グローリーの状況はどうだ？元気か？けがしてないか？おっと…城内にいるんだったな、いやでも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
