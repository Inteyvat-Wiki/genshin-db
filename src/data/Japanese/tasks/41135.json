			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グッドウィン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "魔物たちを倒したか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350302,
					"content": "倒した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "礼を言うよ、旅人。これで魔物たちの脅威も一旦なくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350304,
					"content": "君たちは早く城に戻るといい。こんな状況なのに野外に行かせてしまって悪かったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350305,
					"content": "えっと…ついでだけど、戻るときに一つ頼んでもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350306,
					"content": "簡単だ！少し気にかけてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350307,
					"content": "どんなこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "その、城に戻ったあと、グローリーの状況を見てきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350309,
					"content": "彼女はずっと城内にいたから危険はないと思うが、それでも心配だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350310,
					"content": "頼む、彼女がどうなってるか見てきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350311,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "ありがとう、旅人。そうだ、グローリーには…俺がここにいることは言わないでくれ。まだ遠くで任務を実行してるとだけ伝えればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350313,
					"content": "すまないね、必ずそう言ってくれ。俺には俺の事情がある、頼んだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				}
			]
		},
		{
