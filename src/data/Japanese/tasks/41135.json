					"グローリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "グッドウィンが無事でいますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350402,
					"content": "グッドウィンから頼まれて来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "グッドウィン？今どこにいるか知っているのですか？もうずっと音沙汰なしで、心配していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350404,
					"content": "まだ遠くで任務を実行している。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "そう…なんですか？分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350406,
					"content": "もしこんな隕石がなかったら、騎士団に行って行方を尋ねていたところです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350407,
					"content": "私はずっと城内にいるので安全です。でも彼は野外で任務を実行しているんですよね、もし世界の各地でも隕石が降っていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350408,
					"content": "彼が無事なのを祈ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350409,
					"content": "彼は無事だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "ありがとうございます。そうだ、もしよろしければ、一つ手伝っていただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350411,
					"content": "フローラさんから蒲公英の種を買って、誰かに高いところで撒いてもらって…風でグッドウィンのところに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350412,
					"content": "でも今城内は混乱してる状態で、手伝ってくれる人もいなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350413,
					"content": "ちょうどあなたが来たので、この蒲公英の種をグッドウィンに持っていってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350414,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "ありがとうございます。彼はきっとすごく遠くにいるんでしょうね。大団長と一緒の任務に行ったのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "グローリー"
				},
				{
					"id": 411350416,
					"content": "この蒲公英の種を持っていって、私は元気ですと伝えてください。それと…彼にも安全にと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グローリー"
				}
			]
		},
