					"グッドウィン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "グローリーがどうなったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "旅人か。今野外にいるのは危険だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350104,
					"content": "安全な場所で避難がしたいなら、早くモンド城に行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350105,
					"content": "モンド城に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "俺は…暫く戻らない。西風騎士だからな…こんな時に退いてはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350107,
					"content": "少しわけがあってな。モンド城に戻ることはできないが、野外でできることもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350108,
					"content": "隕石が落ちた後、多くの魔物がその影響で狂暴になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350109,
					"content": "もし放っておいたら、とんでもないことになる。だから今から片付けにいくところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350110,
					"content": "一人で大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "うむ、数はそれなりにあるが…気をつければ、俺なら問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350112,
					"content": "しかし俺一人で行っても、いつまでに終わるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350113,
					"content": "旅人、もしよかったら、魔物の拠点を片付けてきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350114,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "では頼んだ、本当に助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350116,
					"content": "どうして騎士団に応援を要請しないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "騎士団に応援を…うむ、それはできない…俺には俺の事情がある、それ以上は聞かないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350118,
					"content": "手助けしてくれ、魔物の拠点を片付けてくれたら、騎士団も楽になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				}
			]
		},
