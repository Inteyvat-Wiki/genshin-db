			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "こんなことが起きているのに、大団長は一体どこに…メッセージを受け取ってるといいのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "グッドウィン"
				},
				{
					"id": 411350202,
					"content": "しかし、メッセージを受け取ってたとしても、すぐには戻れない、困った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グッドウィン"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
