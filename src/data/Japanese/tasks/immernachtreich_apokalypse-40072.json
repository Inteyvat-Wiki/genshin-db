			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傍白",
					"辛炎",
					"楓原万葉",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "「しかし、幽夜浄土は悪夢のように広がる暗雲に包まれた。邪龍タスラクが地下へと潜り、海底を渡って、王城の上を彷徨い始める」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "傍白"
				},
				{
					"id": 400720402,
					"content": "えっ？龍が現れたのか？空が少し暗くなっただけだと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400720403,
					"content": "龍…それは何かを指す比喩ではなかろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400720404,
					"content": "なるほど…彼女を否定し、その妄想に異を唱えたものすべてが、彼女の宿敵である「邪龍タスラク」になったわけですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007210",
							"2"
						],
						"stepId": 4007210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レオン",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "ああ、よかったです…あれ？またあなたたちでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721002,
					"content": "それはこっちのセリフです。またあなたですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉",
					"辛炎",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "また戻って来たな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400721302,
					"content": "偶然にもかの邪龍の正体を垣間見たでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400721303,
					"content": "はぁ、ああいうのすごく共感できるぜ。アタイたちの趣味を時間の無駄だと思ってる人が、たまにいるんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400721304,
					"content": "おや？あなたは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400721305,
					"content": "僕は「道を聞かれるのが好きなアーノルド」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721306,
					"content": "いえ、私が言いたいのは、どうしてまたあなたがここにいるのかです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400721307,
					"content": "ふっふっふっ、そろそろ君たちが『聖国の詠唱』の第三巻を探してる頃だろうと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721308,
					"content": "ええ、その通りですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400721309,
					"content": "親愛なるお嬢さん、君が僕のためにすることなど何もない。君の美しさこそが、僕への一番のご褒美なんだ。だから君が求める答えを、今ここに捧げよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721310,
					"content": "聖典の第三巻は、王城の最上階にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721311,
					"content": "そこに見張りはいるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400721312,
					"content": "ああ、もちろんいるさ。何をバカなこと言ってるんだ？貴重な本を野ざらしにするような国なんてないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721313,
					"content": "つまり、そこも夜鴉によって守られておるのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400721314,
					"content": "聖典を守るのは、臣下にとってこの上ない栄誉だ。でも、こちらのお嬢さんはきっと聖典を読みたいだけなのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721315,
					"content": "ああ、君はなんて美しい顔をしているんだ。その上、知性に満ち溢れている。君の仲間も英雄のような顔立ちをしているし、きっと聖典に秘められた物語を理解できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "アーノルド"
				},
				{
					"id": 400721316,
					"content": "大書記官のオズ様が伝えし殿下の偉業は、幽夜浄土の宝。あの本を読むたびに、殿下が幸せであることを願うばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーノルド"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レオン",
					"楓原万葉",
					"辛炎",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "このような無様な姿を幾度もお見せしてしまい申し訳ありません。やはり今の実力では、立派な夜鴉騎士を演じるのはまだ早いようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721802,
					"content": "演じる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400721803,
					"content": "ええ、恥ずかしながら、私は本物の騎士ではありません。最近、劇団で騎士役をもらった新人役者で、役作りのため準備をしていたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721804,
					"content": "それって、胸を張って言えるようなことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400721805,
					"content": "皆さんはご存知ないかもしれませんが、幽夜浄土で演劇とは非常に重要な文化なのです。良き演出は、皇女殿下への一番の恩返しになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721806,
					"content": "へぇ、つまり、あんたらんとこ特有の文化ってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400721807,
					"content": "ええ、そうなりますね！ですので、騎士を演じられるのを私は誇りに思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721808,
					"content": "あなたたちの皇女殿下は、なぜ演劇が好きなのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400721809,
					"content": "皇女殿下は昔、このように言ってました。「わたくしのために祭典を催し、荒野で劇を演じよ。わたくしにひれ伏し、永夜の栄光と引き換えに、純潔の幻夢を捧げなさい」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721810,
					"content": "おそらく、皇女殿下は真の芸術とは何たるかを知っているのでしょう。人間の奥深くに隠された喜怒哀楽を、見分けることができるんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721811,
					"content": "演劇において魂とは、感情の凝集と昇華です。演劇への理解が深い方は、きっと繊細で情緒豊かな心を持っているんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721812,
					"content": "…なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400721813,
					"content": "教えていただき感謝する、騎士殿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400721814,
					"content": "お、おお！あなたは…私のことを騎士と呼んでくれるのですね？嬉しいです、ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721815,
					"content": "それでは、私はこの栄光と共に、己の戦場へと赴きます。皆さん、縁があればまた会いましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400721816,
					"content": "もう会わなくて済むように、今度こそ気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400721817,
					"content": "あっ、そうだ。扉を開けるための合言葉をお教えしますね。「命令に従え、翼を広げて出航せよ」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レオン"
				}
			]
		}
	]
}