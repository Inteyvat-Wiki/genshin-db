			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"厳かな夜鴉",
					"凜とした目つきの夜鴉",
					"モナ",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "待て！お前ら何者だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400720202,
					"content": "その様子、幽夜浄土の臣下ではないな？言え！何しに来た！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "凜とした目つきの夜鴉"
				},
				{
					"id": 400720203,
					"content": "まさか守衛がいるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400720204,
					"content": "慌てる必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "えっ？なにをするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400720206,
					"content": "#{M#俺}{F#私}たちは皇女殿下の臣下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "星海を越えてきた者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "殿下の臣下だと？それを証明できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400720209,
					"content": "まったく、そのような横柄な質問をしてくるとは、あなたたちの視野の狭さを証明しているようなものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400720210,
					"content": "「我が民に自由を与え、古き法則に囚われぬように」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400720211,
					"content": "そ…それは、幽夜浄土の合言葉！本当に殿下の臣下だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "凜とした目つきの夜鴉"
				},
				{
					"id": 400720212,
					"content": "なんてことを！皆さん、失礼なことを申してしまい、すみません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400720213,
					"content": "ほら、もう下がったらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400720214,
					"content": "ええ、今すぐ姿を消します…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400720215,
					"content": "よし、行ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400720216,
					"content": "これが『聖国の詠唱』第二巻でござるな。皆の者、準備はできておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400720217,
					"content": "おう！出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
