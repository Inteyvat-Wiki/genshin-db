			"trigger": {
				"objectNames": [
					"ロアルド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "君たちもまだ島に残っていたとはね、よかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750102,
					"content": "最近どうだ？新たな発見はあったか？あるなら話してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750103,
					"content": "何もなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "そうか、それも仕方ない。このような島には秘密がたくさん眠っているだろう。きっと見つかるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750107,
					"content": "ところで、ロアルドさんはここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750108,
					"content": "ん？私はここを離れるために、拠点で荷物をまとめているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750109,
					"content": "この島の霧は不気味だ…深入りすると方向を見失い、いつの間にか元の場所に戻ってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750110,
					"content": "前にカマが示してくれた道をすっかり忘れてしまっていて…もう一回先住民を訪ねようとしても、道が分からなくなっていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750111,
					"content": "身につけていたコンパスも、地面の影も、どれも方向を示すことはできなかった…靴でも試してみたが、霧の中を進むことはできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750112,
					"content": "靴…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750113,
					"content": "靴を投げて方向を示す方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "えっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750115,
					"content": "#ハハッ！ベテラン冒険者のテクニックは、{NICKNAME}も知っていたようだ！パイモンも、もっと勉強しなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750116,
					"content": "パイモンにはまだ勉強が必要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "そんなの運任せだろ！なんでそんなの勉強する必要があるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750118,
					"content": "まあ、とにかく、私の探索はこれで終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750119,
					"content": "はぁ…近くの木にロープを結び、もう一方の端につかまって進めば、もう何度か挑戦できたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750120,
					"content": "なんで試すのをやめたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750121,
					"content": "方向を判断する予備の靴を投げ終えてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750122,
					"content": "予備の靴は使い捨てなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "ハハッ、本来は違うんだが、いつも拾うのを忘れてしまって…いつの間にか、たくさん使っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750126,
					"content": "あっ！そうだ、君たちへの頼み事をやっと思い出したよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750127,
					"content": "わっ、びっくりした！急に噛みついてくるのかと思ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750128,
					"content": "すまない、アハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750129,
					"content": "見ての通り、こんな恥ずかしい問題を抱えていてね…いつも何か失くしたり忘れたりする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750130,
					"content": "生まれつき記憶力が悪く、今まで不便な事も多かった。特に冒険者は、そのせいで危険な目に遭うこともある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750131,
					"content": "今回私が鶴観へ来た目的の一つは、「ユウトウタケ」というキノコを採るためだ。珊瑚さんによれば、このキノコは記憶力を強化し、脳の負担を軽減できるらしい。それと、視力回復にも効果があるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750132,
					"content": "前にカマとここに来た時は、「先住民に会えた」ことに気を取られてしまって…キノコを採るのを忘れていた…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750133,
					"content": "そして、まさか一人で島に来たらこんな困難に遭うなんて…実に残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750134,
					"content": "もしここで探索をするのなら、私のために「ユウトウタケ」を採ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750135,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "感謝するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750137,
					"content": "このことを忘れないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "アハハッ、もちろんこれは忘れないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750124,
					"content": "それは残念だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "はぁ、たしかに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750105,
					"content": "まだ探索途中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "そうか、ハハッ、それじゃ邪魔しないでおくよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "ロアルド"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ロアルド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "ふむ…これだけあれば十分だ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750302,
					"content": "それと、もし島の「祭場」付近で何か発見したら、私に伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750303,
					"content": "あっ…それと、君たちはあのフォンテーヌの「写真機」を持っているんだよね？あれは高価なものだ…もし経費に余裕があれば、私も一台買わなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750304,
					"content": "現地の歴史作家によれば、鶴観の古代先住民は、塗料を使って洞窟の岩壁に復元できない古き歴史を描くようだ。それが千年以上も続いていたらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750305,
					"content": "私は以前の調査で、祭典の明かりを頼りにその模様を見た…あれから忘れることができず、何日もよく眠れなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750306,
					"content": "それらの壁画は、私の知る限り誰も見たことがないものだ…もし君たち二人にもそれが確認できたら、「冒険者協会」の歴史的学術分野において大きな進展になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750307,
					"content": "だから二人には、その伝説の壁画を探してもらい、明晰な写真を撮ってきてほしい。日誌の素材としてその写真を私が買い取り、君たちに報酬をあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750308,
					"content": "どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750309,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750311,
					"content": "日誌を失くさないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "それは…尽力するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロアルド"
				}
			]
		},
		{
			"id": 7217504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
