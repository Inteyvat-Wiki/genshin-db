				"points": []
			},
			"dialogs": [
				{
					"id": 721750401,
					"content": "やあ二人とも！何か収穫はあったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750402,
					"content": "目新しいものはなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "焦らなくても、私はずっとここにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750404,
					"content": "それと、君が送った「ユウトウタケ」、とても新鮮だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750407,
					"content": "そんなこと言ってるけど、おまえの食べてるキノコはオイラたちが採ったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750408,
					"content": "アハハッ、そんなこと気にするなよ、私はもうたくさん食べたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750409,
					"content": "うわっ——この忘れん坊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750405,
					"content": "まだ頑張って探してるところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "疲れたなら休むといい。「ユウトウタケ」を食べないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "ロアルド"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
