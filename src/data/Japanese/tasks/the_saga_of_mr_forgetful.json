			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ロアルド",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#また会ったね、{NICKNAME}！それと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751802,
					"content": "…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751803,
					"content": "ところで、その飛んでいる小さいのはいくらで買えるんだ？見るからに面白そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751804,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751805,
					"content": "大丈夫…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "いやよくないだろ！なんで急に記憶喪失してるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751809,
					"content": "何を言って…プッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751810,
					"content": "プッ…ハハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751811,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751812,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "ハハハハッ…ゴホッゴホッ…ハハハハハッ！君たちの…君たちのその表情！ハハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751814,
					"content": "ダメだ…笑い死んでしまう…すまない…これは…アハハハハッ…これは私の大好きな「ど忘れジョーク」なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751815,
					"content": "全然面白くないぞ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751816,
					"content": "面白さが分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "プッ…もうからかわないから、許してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751819,
					"content": "まったく、オイラはおまえが大冒険者だから、すごく真面目な人かと思ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751820,
					"content": "ハハッ、固定観念にとらわれていてはいけない。冒険者協会は変人が多いことで有名なんだ。私はまだ普通の方さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751821,
					"content": "…ぜんぜん普通じゃないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751822,
					"content": "キノコをありがとう。まだ効果はほとんどないが…長期的に服用する必要があるかもしれないし、それ自体が薬じゃない可能性もある…まあ、味は悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751823,
					"content": "まだすべて食べてはいけない。スメールの友達にも残しておかないと。これの薬用価値を調べてもらうためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751824,
					"content": "それもすぐに忘れると思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751825,
					"content": "コホンッ、本題に入ろう。壁画は探してきてくれたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751826,
					"content": "欲しがってた写真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "おお！感謝の言葉もない！この国ではそうやって感謝を表現するんだったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751828,
					"content": "ふむ…面白い、実に面白い。ただ…これで壁画は全部か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751829,
					"content": "これで全部。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "それなら、もっと面白くなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751832,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751833,
					"content": "鶴観の先住民は雷元素の魔鳥を信仰としていて、祭典儀式を中心に自分たちの文明を築いた。歴史を少しでも知っている者ならこれに異論はないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751834,
					"content": "しかし君たちの提供した壁画の写真…そこに雷鳥の痕跡はなかった。人々が拝んでいたのは別のものだった——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751835,
					"content": "太陽、月、星、それと…変な記号。もしかすれば…雷鳥が降臨する前、鶴観先住民の先祖たちはすでに高度な文明を有していたのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751836,
					"content": "それ以外にも…霧と月、群星と暗闇…ふむ、分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751837,
					"content": "もう頭を使うのはやめておいた方がいいぞ…もうそんなに記憶力が悪いんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751838,
					"content": "…あっ、すまない。考えるのに夢中で、君たちがいるのを忘れてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751839,
					"content": "手助けしてくれて感謝するよ。これからの日誌の素材にもなった。もし幸運にも歴史学者に取り上げられるようなことになったら、二人の名前も掲載しておく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751840,
					"content": "では、私は冒険者協会へ行ってくる。こんなに長く付き合わせてしまって申し訳ない。縁があったらまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751841,
					"content": "本当に忙しい人だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721751842,
					"content": "あっ、それと…もう一つ。些細なことだが、私の代わりに気にかけてくれると助かる。前に言ったあの子供…えっと…なんていう名前だったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751843,
					"content": "「ルー」…そう、その名前だ。今回はその子のために食べ物を用意した…まだ新鮮だといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721751844,
					"content": "前回ここに来て以来、島に子供がいることをずっと覚えていてな…こんな危険な島で生活をするのは、容易なことではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "ロアルド"
				},
				{
