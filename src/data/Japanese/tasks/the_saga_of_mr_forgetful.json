			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#こんにちは、{NICKNAME}、それと話の多い精霊さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750602,
					"content": "こんにちは、忘·れん·坊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750603,
					"content": "オイラは·パイ·モン！次は忘れるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750604,
					"content": "分かったよ、パイ·モン·ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "ロアルド"
				},
				{
					"id": 721750605,
					"content": "うわっ！オイラをからかうなんて！失礼だぞおまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750606,
					"content": "#ふんっ、{NICKNAME}、早くそのお化けのようなキノコを渡そうぜ。もうこいつと話すのは嫌だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721750607,
					"content": "これで足りる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
