						"position": [
							2209.107,
							230.089,
							-801.605
						],
						"pointId": 9306
					}
				]
			},
			"dialogs": [
				{
					"id": 705460101,
					"content": "ファニーヤ、あなたは「ドドコバンバン冒険記」の最初のプレイヤーになりたくないのですか？ほらほら、この新作を遊んでみてくださいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460102
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460102,
					"content": "機動性を活かした戦い、正確な爆撃、狡猾な敵との知恵比べ…まさに最高峰のゲームと言える仕上がりになってるんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460103
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460103,
					"content": "いやよ。あなたと違って、あたしは爆弾に夢中じゃないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460104
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460104,
					"content": "テスト版とテーブルゲームの手伝いで、もう私にとっては十分オーバーワークなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460105
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460105,
					"content": "今はただ「鹿狩り」で出前を取って帰宅したい。それが届く頃にはちょうど洗濯も終わって、清々しい気分で美味しいご飯を受け取れるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460106
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460106,
					"content": "その「バコーンバコーン」？って新しいゲームは、次に当直が被ったときの暇つぶしにさせてもらうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460107
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460107,
					"content": "新しいゲーム…？なんか気になるぞ！オイラたちにも見せてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460108,
					"content": "おや、栄誉騎士様と白い助手さんじゃありませんか？こんなタイミングでお会いできるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460109,
						705460114
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460109,
					"content": "思い出した！「爆弾マニア」だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460110
					]
				},
				{
					"id": 705460110,
					"content": "えっ、私のことを知ってくれているんですか？栄誉騎士様の耳にまで私の名前が届いてるなんて…前回の「侵入者コオニフグ殲滅作戦」での活躍が世間に認められたようですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460111
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460111,
					"content": "こここ…これからもがんばります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460112
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460112,
					"content": "ここ最近は、少しでも火花騎士様との差が縮まるよう、ずっと爆弾の火薬の配合とデザインの改良を重ねておりまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460113
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460113,
					"content": "要するに、前回のオペレーションでは、遠距離から爆弾を投下したら多くの死角が残るし、障害物や遮蔽物がある場合は、威力が足りないとエマートは気づいた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460119,
					"content": "だから彼女は新しい装備を研究し始め、その検証のために火花騎士が好きなテーブルゲームも改良したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460120
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460120,
					"content": "その通りです！ここ数日、ずっと火花騎士様の戦闘スタイルを分析していて、ついに爆弾のもう一つの使い方を思いつきました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460121
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460121,
					"content": "火花騎士様は威力で勝負しています。「爆弾の威力が足りなければ、詰め込む火薬を三倍に増やす。ボンボン爆弾一つで解決できない問題なら、三つでなんとかする」というのが彼女の戦い方です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460122
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460122,
					"content": "ですが、それは私たちのような普通の騎士にとっては難しいこと。ならば、火花騎士様のように威力のある爆弾が使えない私たちは、機動性と命中率でそれを補うしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460123
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460123,
					"content": "ターゲットを追跡し、その近くに爆弾を設置する装備を開発できれば、危険なターゲットを正確に仕留められるだけでなく、爆弾の威力を最大限に活かせるようになります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460124
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460124,
					"content": "敵を追いかけて爆弾を設置する装備…？なんかすごそうだけど、ちょっと怖いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460125,
					"content": "もしオイラがヒルチャールで、友達とイノシシを追ってるときに急にちっこいやつが出てきて、問答無用で爆弾を投げられたら…怖すぎて気絶すると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460126,
						705460128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460126,
					"content": "悪くなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460127
					]
				},
				{
					"id": 705460127,
					"content": "まぁ、確かにそうだな。魔物や敵が怖がるってことは、オイラたちや西風騎士、冒険者からすると使えるってことだし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460130,
					"content": "ですが、この新装備はまだ早期検証段階で、正式に生産され、使えるようになるまでまだ時間が必要でして。でも、がんばって研究を進めるつもりですから任せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460131
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460131,
					"content": "野外での実験は、モンドの生態系に影響を与える恐れがある。それに、そういう実験はアルベド隊長に使用エリアの申請をしないといけない。けど、そんなに大掛かりな実験をする必要はないとあたしは考えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460132
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460132,
					"content": "その意見を聞いたエマートは、先に小型のプロトタイプを作って操縦をシミュレートし、爆弾のテストをすることにしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460133
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460133,
					"content": "ちょうど「縮尺模型実験」にぴったりなテーブルゲームがあったから、エマートに引っ張られて二人でリサ先輩のところに行って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460134
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460134,
					"content": "なんとリサ先輩から実験だけでなく、それに関するストーリーの支援もいただきまして！そうして、とっても素晴らしいものが出来上がったのです——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460135
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460135,
					"content": "ジャジャーン！こちらのテーブルをご覧ください！「ドドコドッカン冒険記」第二部、その名も「ドドコバンバン冒険記」です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460136
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460136,
					"content": "今回、近距離爆撃を身につけたドドコはスペシャルボンボン爆弾を携え、こちらの指揮に従い、再び敵に立ち向かいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460137
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460137,
					"content": "ドドコとツノツノ魚の大王との戦いで、プレイヤーは灼熱の火花と爆発を存分に楽しむことができます！ついでに、私も新装備のテストデータを入手できるというわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460138
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460138,
					"content": "おお！ドドコVSツノツノ魚のゲームを、エマートがさらに改良したってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460139,
					"content": "栄誉騎士と白い助手さんは興味津々みたい。二人なら、きっと参考になるフィードバックをくれるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460140
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460140,
					"content": "ええ！もしお二人が貴重な時間を割いてプレイしてくれるのなら、感謝してもしきれないくらいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460141,
						705460142
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460141,
					"content": "#{M#俺}{F#私}たちが最初のプレイヤーになるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460143,
					"content": "ドドコVSツノツノ魚の続編なら、クレーも誘ったほうがいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460144,
					"content": "うっ！その…ドドコを使ってるのは、私にとって大変名誉なことでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460145
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460145,
					"content": "ですから、「ドドコバンバン冒険記」をもっと面白くしてから、火花騎士様にプレイしてもらいたいんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460146
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460146,
					"content": "ふふん、オイラわかったぞ！新装備のテストだけじゃなくて、クレーのためにゲームのバグも探してほしいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460147,
						705460148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705460147,
					"content": "望むところ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460149,
					"content": "ええ、では決まりですね！なんだか、三人の絆が深まった気がします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460150
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460150,
					"content": "二人がプレイするのを見ているだけで、私の情熱もふつふつと湧いてくるはず！さあ、早速始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460148,
					"content": "クレーと面白いゲームのために！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460149
					]
				},
				{
					"id": 705460142,
					"content": "誰か忘れてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460143
					]
				},
				{
					"id": 705460128,
					"content": "#{M#俺}{F#私}にも一つくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460129
					]
				},
				{
					"id": 705460129,
					"content": "やっぱり、栄誉騎士様も爆発物愛好家なんですね…思っていた通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460130
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 705460114,
					"content": "#えっと、{M#君}{F#あなた}たちは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705460115
					]
				},
				{
					"id": 705460115,
					"content": "あたしたちは西風騎士団の冴えない団員。栄誉騎士があたしたちのことを知らなくても、覚えてなくても大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460116
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460116,
					"content": "あたしは調査小隊の信号官、ファニーヤ。錬金探測設備のテストを担当してる。こっちは同僚で武器官のエマート。爆発物に…異様な興味を持っててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460117
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460117,
					"content": "あたしたちは以前、スメールから来た「コオニフグ」シードル湖侵入事件を担当したの。かなり前のことだけど、オペレーションは無事に終了した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460118
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 705460118,
					"content": "そのオペレーションを経て、遠距離から爆弾を投下したら多くの死角が残るし、障害物や遮蔽物がある場合は、威力が足りないとエマートは考えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705460119
					],
					"speakerTitle": "ファニーヤ"
				}
			]
		}
	]
}