				"points": []
			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "ふむ…ここの入り口を見つけるとは。もうずいぶんと長い間、誰も訪れていなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "夜魂の霊"
				},
				{
					"id": 750490402,
					"content": "ここは夜魂の彷う場所…しかし、太陽の照らす大地では、夜魂の名すら、誰も覚えてはいないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "夜魂の霊"
				},
				{
					"id": 750490403,
					"content": "ああ、夜魂よ…我らが主が眠っている間、我らは主の夢となり、我らの神が時折目覚める時——彼女の思索の一部となる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "夜魂の霊"
				},
				{
					"id": 750490404,
					"content": "ここまでたどり着ける人間がいるとは思ってもみなかった。ふっ、戦いを切望する者共はもう我慢できなくなったらしい…異郷の勇者、愛されし者よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "夜魂の霊"
				},
				{
					"id": 750490405,
					"content": "落ち着きを失っている魂を熾烈な戦いで鎮めてはくれないか…勝利を収めれば、ここに眠る魂から褒賞が与えられるだろう…どうだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜魂の霊"
				}
			]
		},
