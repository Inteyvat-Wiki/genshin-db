			"trigger": {
				"objectNames": [
					"宛煙",
					"クリメント"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210801,
					"content": "あなたね！お金が全てじゃないのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210802
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110210802,
					"content": "あんたこそ、文化財のことばかりで頭が固いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210803
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110210803,
					"content": "まだ言ってる…邪魔しないでおこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1102202,
			"completionStepIds": [
				1102202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102202",
							"2"
						],
						"stepId": 1102202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220201,
					"content": "「地中の塩」は、かつて「塩の魔神」の民が暮らしていた場所だと聞いた。ああ…きっと価値のある文化財も多いだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220202
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220202,
					"content": "伝説によると、「塩の魔神」ヘウリアの加護を受けた民は確かに幸せな暮らしをしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220203
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220203,
					"content": "しかし、この伝説は古くからあり、ここに来た宝盗団も数知れない。価値のあるものはほとんど残っていないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220204,
					"content": "ちぇッ…来なければよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220205
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220205,
					"content": "実は、洞窟の奥に「塩の魔神」関連の遺跡があるの。それが「地中の塩」の由来にもなっているらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220206
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220206,
					"content": "ただ、遺跡の入り口は封印されているみたいで入れないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220223
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220223,
					"content": "関係のありそうな装置は見つけたけど、解除しても封印は微動だにしなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220207
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220207,
					"content": "その封印の由来も解除方法も、「塩の魔神」の研究にとって重要な課題になっているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220208,
						110220209
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220208,
					"content": "民と関係してたりするかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220210
					]
				},
				{
					"id": 110220210,
					"content": "物証がないから分からないわ。でも封印の多くは、真実を隠すために存在するものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220211
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220211,
					"content": "けど「塩の魔神」は優しく、力もあって、みんなに愛されていた。見せられないものなどないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220212
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220212,
					"content": "だから…真実を隠したいのは犯人のモラクスだと、私は考えているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220213
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220213,
					"content": "岩王帝君はそんなことしないと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110220214,
					"content": "そんなのどうだっていい。それより、その遺跡には「塩の魔神」の宝物があるんだろうな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220215
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220215,
					"content": "人の話を聞きなさいって…あったとしても、封印を解かないと入れないわよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220216
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220216,
					"content": "鍾離先生がいるじゃないか！何でも知ってるし、封印だって楽勝だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220217
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220217,
					"content": "あの封印は長いこと存在していて謎だらけだから、きっと鍾離殿だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220218
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220218,
					"content": "——多少なら分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220219
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220219,
					"content": "…えっ？ええーッ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220220
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220220,
					"content": "封印に関する言い伝えは雑然としているように見えるが、実は解除の仕方もちゃんと伝わっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220221,
					"content": "封印と関係がありそうな装置の話をしていたな、まずはそれを確認しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220222
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220222,
					"content": "うん…鍾離殿がそう言うなら、案内するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220209,
					"content": "帝君と関係してたりするかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220210
					]
				}
			]
		},
		{
			"id": 1102206,
			"completionStepIds": [
				1102206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102206",
							"2"
						],
						"stepId": 1102206,
						"stateName": "QUEST_STATE_UNFINISHED"
