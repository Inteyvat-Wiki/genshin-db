				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220601,
					"content": "無用の争いを避けるため、遺跡に入る前に一つ提案があるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220602
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220602,
					"content": "何でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220603
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220603,
					"content": "契約を結んでほしい、内容は「順番にものを取る、一度に一点のみ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220604,
					"content": "誠意を示すため、俺はカウントしなくていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220605
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220605,
					"content": "右に同じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110220606
					]
				},
				{
					"id": 110220606,
					"content": "おい、せっかくのチャンスを諦めるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110220607,
					"content": "俺は認めない！…この半人前の考古学者と収穫を等分しろってか？ありえない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220608
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220608,
					"content": "それはこっちのセリフよ！「塩の魔神」の文化財が台無しになるわ、絶対に無理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220609
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220609,
					"content": "ふむ…もし「契約」を結べないのなら、顧問を降りるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220610
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220610,
					"content": "この遺跡にある宝と罠の対処は二人の判断に任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220611
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220611,
					"content": "そ、それは…分かった。「塩の魔神」の宝物だ、その半分でも十分金になるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220612
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220612,
					"content": "契約に応じてもいいけど…鍾離殿、一つ条件があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220613
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220613,
					"content": "「塩の魔神」の真相を見つけたら、たとえモラクスに不利なことであっても公正に判断してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220614
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220614,
					"content": "その条件なら、受け入れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220615
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220615,
					"content": "では、行こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1102207,
			"completionStepIds": [
				1102207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102207",
							"2"
						],
						"stepId": 1102207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110220701,
					"content": "ここ…ああ、変わった元素石碑があったわ。これも関係があったのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220702
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220702,
					"content": "封印を調べるために、「神の目」を持った人を雇ったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220703
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220703,
					"content": "石碑に明かりをつけた後、何も起こらなかったのよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220704
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220704,
					"content": "ここの石碑は、正しい順番で明かりをつけないと封印の解除ができない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220705
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220705,
					"content": "そしてヒントは、魔神戦争に関する文章の中にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220706
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220706,
					"content": "「<color=#00E1FFFF>南</color>は天衡、<color=#00E1FFFF>東</color>は瑶光、<color=#00E1FFFF>西</color>は絶雲、<color=#00E1FFFF>北</color>は軽策、広い璃月に居場所がないとは。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220707
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110220707,
					"content": "ん…何だって？意味が分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220708
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110220708,
					"content": "それ、聞いたことがある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110220709
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110220709,
					"content": "ああ、この文章は「塩の魔神」とも関係がある。",
