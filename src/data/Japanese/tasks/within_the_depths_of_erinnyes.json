						740851703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851702,
					"content": "まだ丸一日は戦えるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "へへっ、その言葉、信じてるぞ。根っこも元に戻ったみたいだし、ここの厄介事もこれで解決しただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851705,
					"content": "でもさっき、一体なにがあったんだ？ヴィシャップがいきなり助けに来てくれて、パシーフのやつはいなくなったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851706,
					"content": "おい——パシーフ！どこにいるんだ？聞こえるか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851707,
					"content": "しょうがないな、あいつは本当にいなくなったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851708,
					"content": "あの子はまだ沢山の秘密を抱えてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851709
					]
				},
				{
					"id": 740851709,
					"content": "うーん…本当に謎めいたメリュジーヌだったな。報酬のことは考えてなかったけど、こんな形で別れるなんて、やっぱりちょっと変な気分がするぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851710,
					"content": "どんな感じ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "そうだな…たとえば好きな料理からある日突然「我々の関係はここまでだ」って言われるみたいなおかしさだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851712,
					"content": "へぇ、それは本当に悲しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "とにかくそんな感じだ！でも、パシーフは怪我をしてたんじゃないか？さっきすごく疲れてそうだったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851715,
					"content": "近くを探してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "おう！オイラもそうするべきだと思う、あいつを危険な目に遭わせちゃいけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851717,
					"content": "待て…どういうことだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740851718,
					"content": "あなたたちが近くでパシーフを探そうとすると、突如洞穴に水が流れこみ、二人は海流に巻き込まれていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "料理が喋るなんてもっとおかしいでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851703,
					"content": "ちょっとした筋肉痛くらい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851718
					]
				}
			]
