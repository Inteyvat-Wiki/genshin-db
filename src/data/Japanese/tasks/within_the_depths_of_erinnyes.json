			},
			"dialogs": [
				{
					"id": 740850201,
					"content": "鍵、彫像、鍵、彫像、鍵、彫像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850202,
					"content": "うーん…鍵を彫像に入れるのか？それなら、ちょうど鍵も三本、彫像も三体だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850203,
					"content": "とりあえずやってみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850204,
					"content": "鍵を入れたら何が起こるんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "開く、扉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850206,
					"content": "扉？どこのだ？扉の向こうには何があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850207,
					"content": "根っこ、エリニュス、とても深い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850208,
					"content": "扉がエリニュス島の根っこに繋がってる！？パシーフ…い、いろんなことを知ってるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850209,
					"content": "パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850210,
					"content": "#あと、{M#俺}{F#私}たちが知っておくべきことは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850212,
					"content": "情報だよ、情報！多いほどいいし、知ってるほどいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850213,
					"content": "ジョ…ウホウ？ジョウホウ…パシーフ！ジョウホウ、とても十分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850214,
					"content": "よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850215,
					"content": "エリニュス、情報、とても十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850216,
					"content": "ふむふむ…情報がたくさんあって…それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850217,
					"content": "情報、水脈、とても十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850218,
					"content": "ふむふむ…水脈もたくさんあって…他には？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850219,
					"content": "水脈、塗り絵ヒト、とても十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850220,
					"content": "ふむふむ…なるほど…っておい！？「塗り絵ヒト」が多い！？待て、意味がわからないぞ…「塗り絵ヒト」はどこからそんなに来たんだ？分身魔法でも使えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850221,
					"content": "メリュジーヌ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850222,
					"content": "水脈、塗り絵ヒト、味見する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850223,
					"content": "邪悪、塗り絵ヒト、わかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850224,
					"content": "水脈の邪悪の味見？どんなおかしな趣味だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850225,
					"content": "塗り絵ヒトは水脈のことがわかるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850227,
					"content": "柳、集める。霧の道、処理。泉、発信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850228,
					"content": "根っこ、水脈、中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850229,
					"content": "エリニュス島は情報の中心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "エリニュス島全体が塗り絵ヒトの情報システムなのか？塗り絵ヒトはそれで悪いものを感知できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850231,
					"content": "#賢い、パイモン！賢い、{NICKNAME}！パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850232,
					"content": "すごいぞ、そいつって一体何者なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850233,
					"content": "フォンテーヌ、塗り絵ヒト、守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850234,
					"content": "でも塗り絵ヒト、たくさん忙しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850235,
					"content": "紫のやつ、こそこそ、根っこいく。紫のやつ、こそこそ、根っこ壊す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850236,
					"content": "パシーフ、こそこそ見てた。パシーフ、石碑こそこそ磨いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850237,
					"content": "あっ、石碑の文字を消したのはおまえだったのか！そいつを阻止するためか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850238,
					"content": "パシーフ！でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850239,
					"content": "紫のやつ、根っこ行った。紫のやつ、たくさん手強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850240,
					"content": "紫のやつは他の方法を見つけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "パシーフ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850242,
					"content": "そいつは確かにちょっと手強そうだ…根っこを壊せば、情報システムが機能しなくなるから、塗り絵ヒトの感知能力も影響を受ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850243,
					"content": "パシーフ、責任！パシーフ、守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}、おてて。パイモン、おてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "パシーフ"
				},
				{
					"id": 740850245,
					"content": "#{NICKNAME}、ぐずぐずしてられないな！今すぐこいつに手を貸してやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740850246,
					"content": "パシーフ！扉を開けていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
