			"dialogs": [
				{
					"id": 230220501,
					"content": "よぉ…し！これだけあれば十分だ。ほら、これは報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220502
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220502,
					"content": "しかしこの材料、やけに軽いぞ…綺珊の選んだやつだが、ほんとに信用していいんだろうな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220503,
					"content": "私を信じてください。前にあなたが選んだものより、絶対にいいはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230220504,
					"content": "じゃ、今回は君が浮き輪を用意してくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220505,
					"content": "…大丈夫です。私を信じて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
