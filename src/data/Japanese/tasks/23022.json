				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "ここの強度が増すとしたら、ここを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220102,
					"content": "この設計を採用するなら、以前のものと本質的に違いはないと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230220103,
					"content": "まだ船の設計をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "ああ、君か。そうだ…前回の試験運航が終わったあと、綺珊とまた…えっと…主要部分の設計について話し合った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220105,
					"content": "俺たちは十分に意見を出し合ったうえで、新しい設計プランを試そうとしたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220106,
					"content": "また材料の問題で、意見が分かれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220107,
					"content": "とはいえ、今回は綺珊の意見を聞くことにした！大枚はたいて良い材料をそろえたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220108,
					"content": "ほら旅人、これだ。到底一人じゃ運びきれない量だし、綺珊は力がない、えーと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220109,
					"content": "一緒に運ぼう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "さすが、頼りになるな！じゃ、急いで出発だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220112,
					"content": "今回の材料はあの綺珊が自分で選んだやつだ。問題が起きるはずがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220113,
					"content": "そして、今回は君にも手厚い報酬を用意してる。本当に感謝してるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230220110,
					"content": "いいから、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
