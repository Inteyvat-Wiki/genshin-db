			"dialogs": [
				{
					"id": 752130201,
					"content": "助けが必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "え？助けてくれるの！？ありがとう…うちの店のスタッフ、みんな配達に出ちゃってて。今また急ぎの注文が入ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "ハヤルク"
				},
				{
					"id": 752130203,
					"content": "注文書には<color=#00E1FFFF>ビーチにいる青いズボンのお客様</color>に届けるようにってメモがあるわ。届けるだけでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "ハヤルク"
				},
				{
					"id": 752130204,
					"content": "配達料と、店のドリンクレシピもお礼に差し上げるわ。頼むわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハヤルク"
				}
			]
		},
