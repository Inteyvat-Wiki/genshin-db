			"dialogs": [
				{
					"id": 752130601,
					"content": "どうぞ、ご注文の飲み物です。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "ああ！飲み物を届けてくれたのか。いつまで経っても届かないなと思ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "アクオ"
				},
				{
					"id": 752130608,
					"content": "おまえのせいだろ。注文書に「砂浜の青いズボンの客に届ける」ってメモを残したくせに、砂の中に隠れるなんて。おかげでずいぶん探し回ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752130609,
					"content": "配達料を倍もらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752130610,
					"content": "いやあ、申し訳ない、すっかり忘れてたんだ。見つけてもらえるように、ズボンは脇に置いておくべきだった",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "アクオ"
				},
				{
					"id": 752130611,
					"content": "どうして砂の中に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "面白いからさ。休暇をこうして過ごす人がたくさんいると聞いて、やってみたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "アクオ"
				},
				{
					"id": 752130613,
					"content": "でもおまえの姿勢はちょっと変だぞ。畑から突き出した大根みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752130614,
					"content": "え？それだと何か…まずいのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "アクオ"
				},
				{
					"id": 752130615,
					"content": "#人がつまずくかもだし、{M#君}{F#あなた}もケガする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "分かった、考えとくよ。あ、これ配達料ね。ちゃんと倍にしておいたから。ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アクオ"
				}
			]
