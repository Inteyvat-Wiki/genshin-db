			"trigger": {
				"objectNames": [
					"サディーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "お帰りなさい、旅人さん。それで、例の箱は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480302,
					"content": "これ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "良かったです！本当にありがとうございます…はぁ、推薦状を持って訪ねてくださったというのに、私のご相談にも応じていただいてしまいました。真に恐縮です…どうぞこのモラをお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480305,
					"content": "確か教訓では…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "おや？あなたもその言葉をご存じなのですか？私たちプルビルニには、確かにそうした教訓がありますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480307,
					"content": "それはあくまでも、私たち自身に向けたものです。いかなる時も、金銭や他の外的要因によって、研究原則を破ってはいけないという戒めなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480308,
					"content": "研究者が、己の学術的信条の頂きに利益を据えようものなら…それは研究者失格ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480309,
					"content": "しかしあなたは私のために働いてくださいましたので、合理的な報酬を受取るべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480310,
					"content": "重ねて感謝を申し上げます。今後もし私の助けが必要でしたら、いつでも仰ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480311,
					"content": "「金銭は智慧の報酬にあらず」なのでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "取り返してきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
