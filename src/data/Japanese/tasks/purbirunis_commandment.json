				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "待った！わかった！やめろ！もう勘弁してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480202,
					"content": "はぁ…ふぅ…たったひと箱の本のために、ここまでボコボコにする必要ないだろ？欲しいなら全部やるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480203,
					"content": "これだけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "天に誓う！俺たちがここで掘り出したのはこの箱だけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480206,
					"content": "本の他には、石と泥が詰まった瓶くらいだ…まあ綺麗な宝石もいくらか混ざってたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480207,
					"content": "宝石を全部盗ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "おい！宝石を返せよ！あれは全部、大事な地質サンプルなんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480209,
					"content": "地質…サンプル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480210,
					"content": "返して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "返す返す！全部返すっての！おい、お前ら、全部箱の中に入れとけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480213,
					"content": "も…モノは全部箱に入れたからな、俺たちはこれで失礼するぜ…は、はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "ダーラ"
				},
				{
					"id": 733480214,
					"content": "サディーフが探してるの、全部入ってるよな？早く箱をあいつに渡そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480215,
					"content": "にしても、あいつはほんとに一人で砂漠に入ったんだな。それでこんなに大量の地質サンプルを掘って、たくさんメモを取って…そう考えるとすごい学者だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480211,
					"content": "三つまで数える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "他には？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
			"id": 7334803,
			"completionStepIds": [
