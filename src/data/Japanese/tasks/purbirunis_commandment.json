			"dialogs": [
				{
					"id": 733480101,
					"content": "ですが…あのサンプルがないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480102,
					"content": "プルビルニについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "はい。私はプルビルニの現「ハーバッド」です、どのようなご用で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480105,
					"content": "学術に関する質問ですか？しかし、あなたの装いを見る限り、教令院の方ではないようですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480106,
					"content": "ヘディーヴの推薦状について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "これは…我が後輩ヘディーヴ直筆の手紙？少しお待ちを、内容を確認させていただきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480108,
					"content": "ふむ、どうやら彼は層岩巨淵での研究を順調に進めているみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480109,
					"content": "…菌類調査…水生環境…古代生物の化石…特殊な地質環境…サンプル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480110,
					"content": "素晴らしい、実に素晴らしい！学術における彼の嗅覚と考察力は相変わらず素晴らしいですね、やはり彼は私を失望させたりしません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480111,
					"content": "ふん…あまり関係のない方の前では認めたくありませんが、やはりプルシナのところの学術能力は、信頼に値するものです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480112,
					"content": "それに、手紙にはヘディーヴが何度もあなたに助けられたとあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480113,
					"content": "あなたの助けがあったからこそ、彼の研究は「まるでトラに翼をつけたように順調だ」とのことです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480114,
					"content": "何度も言わなくていいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "そうなのですか？コホン、失礼しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480117,
					"content": "彼が教令院に戻ってくる頃には、きっとプルシナの学術史に輝かしい記録が加えられるはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480118,
					"content": "ええと…そして、私たち二つの門派の千年にも及ぶ友情は、大いに深まることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480119,
					"content": "とにかく！プルビルニとプルシナを代表して、もう一度あなたに感謝を申し上げさせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480120,
					"content": "それと、あなたにプレゼントを用意するよう、手紙で頼まれています…これはまったく問題ありませんが、少しお待ちいただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480121,
					"content": "また手紙が報酬なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "そんなまさか！あなたはヘディーヴを手伝ってあちこち調査してくださったわけですから、モラをお支払いすることは至極当然です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480123,
					"content": "ですが…どうかお許しください、今日は慌てて出かけてきたせいで、あまり多く持ち合わせがないのです。もしよろしければ、どうかここで少しお待ちいただけますでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480124,
					"content": "サディーフとヘディーヴはどっちも自分の一族を自慢に思ってるけど…ずいぶん様子が違うんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480125,
					"content": "なんか…本当にお金をあんまり持ってないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480126,
					"content": "そ、そういうわけでは…私たちプルビルニは学者の一族です、金銭の面で困ることなどあるわけがありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480127,
					"content": "しかし、財産の大部分は研究に投じられておりまして、それ以外のことにおいては少々…窮屈な状況になっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480128,
					"content": "ですが、それが私たちの研究の妨げとなることはありません。むしろ物欲に目がくらむことなく、智慧の道をよりハッキリと見据えられるのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480129,
					"content": "今すぐ戻って報酬を用意させていただきます。ですがその前に、不躾ながらもう一つご相談が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480130,
					"content": "ヘディーヴの手紙によりますと、あなたは身体能力が高く、戦闘経験も豊富で、冒険者の中でも抜きんでた精鋭とのこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480131,
					"content": "もし！もしよろしければ、私に少し手を貸していただけませんか？少し前に、とあるエリアで地質環境を調査するため、私は単独で砂漠に入ったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480132,
					"content": "お金が…さほどなかったので、あのときは護衛を雇いませんでした。素早く調査を済ませるなら、リスクもあまりないと考えていたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480133,
					"content": "しかし運が悪いことに、調査が終わってからの帰り道で、宝盗団に襲われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480134,
					"content": "私は傷を負うことなく、無事城内まで逃げ帰れたのですが、地質サンプルとノートが入ってる箱をなくしてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480135,
					"content": "商人や宝盗団からすれば、あの箱はまったく価値のないものかもしれませんが…私にとっては違います！あの箱に入ってるのは物凄く価値のある、かけがえのないものです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480136,
					"content": "すぐには手伝ってくださる冒険者を見つけられず…旅人さん、どうか私を助けていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480137,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "感謝感激です！あなたがいなければ、一体どうしていたことでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480140,
					"content": "襲われた場所を地図に記しておきます、あの箱はきっとその近くにあるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サディーフ"
				},
				{
					"id": 733480138,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "それはもう彼から聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "プルビルニの学者なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
		{
