						733480904
					]
				},
				{
					"id": 733480904,
					"content": "プルビルニの学者？ああ、サディーフさんを探しに来たの？珍しいわね…彼を訪ねてくる人がいるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480905,
					"content": "サディーフさんならちょうど教令院に用事があるから、近くにいるはずよ…彼にどんな用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480906,
					"content": "ヘディーヴの推薦状について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "ヘディーヴさん？彼はもう研究を終えたの？チームをまるごと雇って調査に行けるなんて、お金持ちっていいわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480908,
					"content": "私なんて、フィールドワークの手当すら申請を通らないんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480909,
					"content": "ヘディーヴを知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "もちろん。私のように資金繰りに悩む、お金儲けに疎い人々の間では、彼の財力は広く知られているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480911,
					"content": "うわぁ、それじゃ…ヘディーヴの…一族の学者って、みんなお金持ちなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480912,
					"content": "それじゃあオイラたちも、すっごい報酬がもらえるんだよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480913,
					"content": "そんなことないと思うわよ。ヘディーヴさんは特別なの。プルビルニとプルシナの学者に、あまり幻想を抱かない方がいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480914,
					"content": "特に星象学をメインにやって、片手間に歴史と生物を研究する方の一族は…どっちの研究でも、運が悪ければ経費すら降りないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480915,
					"content": "当の彼らは、「金銭は智慧の報酬にあらず」とか言ってるしね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480916,
					"content": "コホン、喋りすぎたわね…サディーフさんはあっちにいるわ。他のことは直接彼に聞いて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イリス"
				},
				{
					"id": 733480903,
					"content": "プルビルニの学者について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
		},
