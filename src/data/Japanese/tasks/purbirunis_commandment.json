			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "おや、もう戻ってきたのか。プルビルニの人間には会えたのか？そこまで大変なことでもなかったはずだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480402,
					"content": "会えたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "うん？なんだか言いづらそうだな。なにか無理難題を押し付けられたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480405,
					"content": "ヘディーヴにサディーフのことを教えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "サディーフ先輩か…彼は石頭で有名でね、たまに教員さえ頭を抱えるくらいだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480407,
					"content": "しかも資金援助を全部断り、自分たちだけで研究を進めると言って聞かないんだ。それが「研究の純潔」を保つためだとかなんとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480408,
					"content": "それが、あの「金銭は智慧の報酬にあらず」ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733480409,
					"content": "そう、プルビルニの学者たちの研究原則だな…ハハ、俺たちプルシナはそんな古臭いことはしないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480410,
					"content": "いや…そういうわけじゃないか。単に俺が金持ちなだけかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480411,
					"content": "どうやってお金を儲けてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "なんだよ、その疑うような目は？俺の資産だって苦労して稼いだものだぞ。先物取引がどれだけ大変か分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480414,
					"content": "さ、先物取引？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "先物取引をやるためには…貨物の交易量だけでなく、市場の動向や、投資の方向性、全てを注意深く観察する必要があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480417,
					"content": "最初は遊びのつもりで、研究に影響しない程度に嗜んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480418,
					"content": "でもそれが…はぁ…うまいこと稼げてしまって、取引所に預けるお金もどんどん増えていったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480419,
					"content": "俺の本職は学者だぞ！俺は研究が、学術がやりたいんだ！欲しいのは学術の成果であって、モラではない！…と、ずっと自分に言い聞かせてたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480420,
					"content": "スメールシティにいると何故か無意識に取引所に入ってしまって、一件そしてまた一件と先物に手を出してしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480421,
					"content": "口座の金は増える一方だが、学術的な進展はからっきしだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480422,
					"content": "だから俺はこんな大所帯を雇って、層岩巨淵まで調査に来たんだ！取引所がないこの場所にいる限り、俺は心を落ち着かせて学術研究に邁進できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480423,
					"content": "もし研究の成果が出なければ、俺は…俺はもう、二度と層岩巨淵から出ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 733480415,
					"content": "先物取引で儲けてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "なんでそんなにお金持ちなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "ちょっとしたことが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
