					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "以前、「千風の神殿」で「時間」に出会い、助けを受けたって言っただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071102,
					"content": "「時間」の助けがあったから、最初の自由の風は、あれほど力強く吹くことができたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "でも、激しい暴風は建物の一掃には向いていても、万物の成長には向いていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071202,
					"content": "モンド城の危機をいくつか乗り越えた後、ボクは風を少し穏やかにしたんだ。モンドの人々に勇気を与えられるくらい強く、でも風に足を取られてよろめくことのない程度にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071203,
					"content": "それじゃ、今回来たのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071206,
					"content": "影が遠くで集まりつつある…もう君も感じ取っているんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071207,
					"content": "炎の神と「死の執政」ロノヴァが対峙している…それにファデュイ執行官「隊長」の件も、すでに風の噂で聞いているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071208,
					"content": "しかも、アビスの活動範囲がモンドにまで迫っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071209,
					"content": "もうすぐ訪れるこの危機は、人の力だけでは太刀打ちできないかもしれない…ボクも、準備をしておかなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071210,
					"content": "必要とあらば、ボクはモンドの風の神「バルバトス」として風を起こし、どんな靄だろうと吹き飛ばすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071211,
					"content": "でも、ボクが軽率にモンドで暴風を起こしたりしたら、みんなの服や帽子、ベランダの花まで飛ばしてしまうだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071212,
					"content": "だから今回は「風立ちの地」として、この島を選んだんだ。ボクはかつてここで、「時間」に讃歌を捧げたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071213,
					"content": "ボクの演奏が良すぎたからか、この島は「時間」に愛されているみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071214,
					"content": "本当か？この島がそんなに特別だったなんて…でも、前に見た時は、普通に見えたけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100071215,
					"content": "たまに潮が満ちて水に沈んだり、鳥がいっぱい降りてきたり…普通の島にしか見えないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100071216,
					"content": "「時間」の物事への影響は、表面だけに現れるわけじゃない。うん…まるで、完熟した夕暮れの実のようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071217,
					"content": "表皮に傷がない時は、専門家でもないと、内部の果肉が熟しているかは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071218,
					"content": "でも、表皮に穴を開けると、もともと完熟していた夕暮れの実は、その穴から一気に腐り始めてしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071219,
					"content": "「時間」の配下にあるこの島の「表皮」には、穴が開いていない。誰も「時間」が本質に与えた影響を感じ取ることはできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071220,
					"content": "でも本質的に「時間」に愛されない痕跡は、すべて洗い流されてしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071221,
					"content": "だから、ボクはちょうどここに残る力を借りて、「時間」で「風」の境界を定めることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071222,
					"content": "これなら、ボクがこの島でどんなに大きな風を吹かせても、外の世界には気づかれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071223,
					"content": "もちろん、誰かが手伝ってくれるなら、ちゃんとお礼を準備しておかなくちゃね。さあ、一緒に曲を奏でて、「時間」に讃歌を捧げよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071224,
					"content": "合奏の準備ができたら教えて。楽器がないなら、ボクが貸してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100071204,
					"content": "風を再び…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
