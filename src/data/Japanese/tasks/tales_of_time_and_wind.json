			},
			"dialogs": [
				{
					"id": 100070101,
					"content": "…黙認ということにしておくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070102,
					"content": "ウェンティ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "あれ、やっと来たんだ。誰かからボクに伝言かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070104,
					"content": "伝言？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "「ウェンティに関する予言は、この辞典に載ってなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070107,
					"content": "でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070108,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "あれ？ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070111,
					"content": "うーん…バーベロスさん、相変わらずすごい知識欲だね。残念だけど、ボクの「未来」は彼女の辞典には載らないと思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070112,
					"content": "風は蒲公英によって形を描かれ、詩人によって歌われることを好むけど、誰かの手に留まろうとは思わないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070113,
					"content": "だから、尊敬するバーベロスさん、そのペンを置いて欲しい。風の中で歌われる言葉は、そのまま文字に書き起こすには向いていないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070114,
					"content": "もしこの神話に心から興味があるなら、ボクがこの詩文に少し手を加えて、次のお茶会の時にみんなの前で詠んであげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070115,
					"content": "バーベロス？彼女は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "アハハ、バーベロスさんはいつも分かってくれるんだ。どうやら、もうボクのお願いを聞いてくれたみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070117,
					"content": "これで、もう誰にも邪魔されずに話せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070118,
					"content": "さっき、バーベロスがこっそり聞いてたのか！？で、でもオイラたち、全然気づかなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070119,
					"content": "なんたって、魔女会の一員だからね。バーベロスさんは、本当にすごいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070120,
					"content": "でも、おまえはすぐに気づいて、しかも帰らせたよな。吟遊野郎、おまえってバーベロスよりもすごいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070121,
					"content": "うーん…いろいろ現実的なことを考えると、ボクもせいぜい限られた意味でしかすごいって言えないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070122,
					"content": "またそのもったいぶった感じかよ。先に言っとくけど、魔女の辞典におまえに関することは一つも書いてなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070123,
					"content": "彼女はただ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "それで十分だよ。バーベロスさんのボクに対する「予言」は、完全ではないけど、「間違い」でもないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070126,
					"content": "ボクがやろうとしていることには、確かに君の助けが必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070127,
					"content": "何でも言ってよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "おっ、頼りになるね。それじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070130,
					"content": "あとで一緒に一曲奏でてくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070131,
					"content": "えっ？いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "うん、それだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070134,
					"content": "安心して。今回の演奏のお誘いは、運命の重圧とか、遠い因果によるものじゃなくて、ただ純粋に…ボクたちの友情によるものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070135,
					"content": "以前、ボクがこの曲を弾いた時、唯一の聴き手は吹き荒れる風だけだったんだ。風は曲の音色をさらって行き、残ったのはわずかな余韻だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070136,
					"content": "でも今、ボクには君という友がいるわけだし、風に観客席を独占させておく理由はないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070137,
					"content": "それに、君という友がそばにいてくれれば、もっと安定して楽器を弾けるかもしれないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070138,
					"content": "本気で演奏するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "それじゃあ、まず演奏場所に行こうか。風について行けば、すぐに着くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070132,
					"content": "それだけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "#{M#俺}{F#私}にここで待つようにって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "#でも、魔女が{M#君}{F#あなた}のこと探してて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "実は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
