			"dialogs": [
				{
					"id": 100071001,
					"content": "昔、ボクはモンドに最初の自由の風を吹かせたんだ。その風の力で、自由を手にするべきすべての人々が、自由を取り戻せたんだよ。",
					"roleType": "TALK_ROLE_NPC",
