			"dialogs": [
				{
					"id": 100070401,
					"content": "この島は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "何か特別なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "この島自体に、特別なところはないよ。他のほとんどの島と同じで、ただの砂と石が集まって出来たもの——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070404,
					"content": "風が物語の種を運び、時間がそれを芽吹かせるまではね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070405,
					"content": "その後も、風は新しい物語を運び、時間はそれを島の外で神話に変える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070406,
					"content": "この「時間」に愛された島に「本当に」来てくれたね。歓迎するよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070407,
					"content": "遠い昔、時と風がここで交わっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070408,
					"content": "おっ、おい、吟遊野郎…急に真面目になって、言ってることもなんだか難しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070409,
					"content": "アハハ、焦らないで、パイモン。いい物語の始まりっていうのは、いつも高らかで、ちょっとした謎を残すものなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
