			"dialogs": [
				{
					"id": 100070701,
					"content": "よし、ここまで。美しい合奏だったね。ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070702,
					"content": "さっきの力は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "心配しなくていいよ。さっき君が見た力は、純粋にボク自身のもの。誰かから借りたわけでも、何かに頼ったわけでもないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070704,
					"content": "たとえるなら…楽器をちょっと調律して、もっと美しい音色を奏でられるようにした、ってところかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070705,
					"content": "うわっ、やっぱり奥の手を隠してたな！…まさか、まだ他にも隠してるんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070706,
					"content": "パイモン、ボクは本当に手が二本しかないんだ。ほら、見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 100070707,
					"content": "この吟遊野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100070708,
					"content": "アハハハ！今日は風が強くなりそうだ。早くモンド城に戻って、みんなに洗濯物を取り込むよう、知らせてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 1000710,
