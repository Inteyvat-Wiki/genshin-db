				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "ん？こっちにもまだ絵が一枚あるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761240402,
					"content": "ハハッ、よく見てるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240403,
					"content": "これは古華の継承者を自称する小僧たちが、以前カスティリオーネに頼んで描いてもらった代物だよ。あいつらが誇る「演武場」ってやつだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240404,
					"content": "でも、あいつらは誇りだけは一丁前に持っててな。自分たちはすでに達人の域に達してると思ってるんだ。こんな基礎的な修行はもう必要ないってことで、絵を私にくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240405,
					"content": "えっ？おまえ、古華派の人じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761240406,
					"content": "ハハハ、私もそう名乗りたいところだけどな。残念だけど、古華の小僧には、私を受け入れる度胸がないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240407,
					"content": "以前、あいつと帰離原で賊を討伐した時、あいつは修行不足のせいで命を落としかけた。そのせいで私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240408,
					"content": "まあ、いい。どれもつまらない話だ。だが、この絵はなかなか面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240409,
					"content": "興味があるなら、広げて見てみるといい。破いてしまっても構わないしな。どうせカスティリオーネは一日中暇を持て余してるんだし、また描かせればいいだけの話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸（ジョウキ）"
				}
			]
		}
	]
}