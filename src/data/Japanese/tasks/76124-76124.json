			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "よし、そこまで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240302,
					"content": "#二人ともありがとう、おかげで楽しませてもらった。特に金髪の{M#兄ちゃん}{F#嬢ちゃん}の腕前は実に大したものだ。私が知ってる古華の小僧よりずっと強いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240303,
					"content": "#さすが{M#俺}{F#私}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "君たちのおかげで、私も久しぶりに得るところがあった。やはり魚醤には、細かく刻んだ新鮮な獣肉を加えて味を引き立てるべきだ。そうでなければ、時間が経った時の生臭さはどうしても隠しきれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240307,
					"content": "おおっ、なるほど…ん？それって全然関係ないことじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761240308,
					"content": "ハハハッ、細かいことは気にしない、気にしない！今度カスティリオーネにもっと魚を描いてもらった時は、君たちにも魚醤をご馳走するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妌癸（ジョウキ）"
				},
				{
					"id": 761240304,
					"content": "大げさだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "ハッ、謙遜する必要はない。君の剣技は見事なものだ、それくらい分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "妌癸（ジョウキ）"
				}
			]
		},
