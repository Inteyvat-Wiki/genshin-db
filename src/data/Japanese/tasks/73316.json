			"dialogs": [
				{
					"id": 733160201,
					"content": "こんな姿になるなんテ…憐れね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160202
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160202,
					"content": "ん？ソルシュ、なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160203,
					"content": "いいえ、何でもないワ。同胞の惨めな最期の姿を見てしまったダケ、気にしないデ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160204
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160204,
					"content": "う…そう言われると余計に気になるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160205,
					"content": "オイラも見てみたいな…うぇっ、あそこに変な樹があるぞ。輪っかみたいに固まってて、ゲートにも見えるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160206,
						733160207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160206,
					"content": "くぐり抜けたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733160208
					]
				},
				{
					"id": 733160208,
					"content": "そう言われると、がぜん興味が湧いてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160209,
					"content": "…その「霊谷木」は門なんかじゃないワ。不用意にくぐり抜けたりしたら、そこに宿る残霊を邪魔しちゃうかもしれないデショ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160210
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160210,
					"content": "へー、「霊谷木」っていうのか？でも残霊っていっても…なんにも見えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160211,
					"content": "そりゃ、白フラには見えないわヨ。残霊は過去の執念の中にとどまっているんだモノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160212
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160212,
					"content": "それが彼女たちの本望かどうかは分からないケド…この世に執着し続けるその姿は、本当に見るに忍びないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160213
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160213,
					"content": "みずみずしくて、いい感じに見えるけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160214,
					"content": "ふん、白フラなんかに何が分かるって言うノ？これらの「霊谷木」は大地を浸蝕した穢れと戦った花霊が、最後の力を振り絞って変身した姿なのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160215
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160215,
					"content": "力が尽きて本来の姿さえ維持できなくなって、穢れに触れたせいで花海にも拒まれてしまったノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160216
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160216,
					"content": "言い伝えによると、かつてはスケプティック団による浄罪の儀式を経れば、彼女たちも再び「甘露花海」に戻ることができたそうヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160217
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160217,
					"content": "でも今となっては、スケプティック団にその儀式を執り行える人はもういナイ。辛うじて、霊谷木が枯れて死んじゃったりしないように保つのが精一杯でしょうネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160218
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160218,
					"content": "でも、それはむしろ彼女たちの苦しみを長引かせているだけヨ。今のままじゃ、きっと彼女たちに残されているのは、苦難に満ちた記憶にただ独りで耐える道だけだワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160219,
						733160220
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160219,
					"content": "助けないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733160221
					]
				},
				{
					"id": 733160221,
					"content": "うんうん！独りで苦痛に耐え続けるだけだなんて、可哀想すぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160222,
					"content": "そうは言っても、それは我ら花霊の運命だとも言えるワ。こんな姿になることで大地を守れたなら、それが彼女たちの本望だったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160223
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160223,
					"content": "う…でもそれはあくまでソルシュの考えであって、おまえも言ってたけど、もしかしたら本望じゃなかったかもしれないんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160224,
					"content": "もしオイラだったら、こんな所より、花海に帰ってみんなと一緒にいたいって思うもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733160225,
					"content": "白フラ、私たち花霊を見くびないデ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733160226
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160226,
					"content": "ふん、まあいいワ。とにかく私が力を行使して彼女を呼び覚まして、最期の声を聞かせてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733160220,
					"content": "救う方法はあるってことでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733160221
					]
				},
				{
					"id": 733160207,
					"content": "どこかに通じてるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733160208
					]
				}
			]
		},
