			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "うん？おかしい、どうなってやがんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280402,
					"content": "オイラたち…戻ってきちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280403,
					"content": "ここ、さっき通った場所だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280404,
					"content": "ふむ、出発地点のようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280405,
					"content": "俺らは道を間違えてねぇはずだ。ずっと出口を目指して進んでた、道を戻ったりもしてねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280406,
					"content": "ええ、私もそう思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280407,
					"content": "旅人、俺ら道を間違えてねぇよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280408,
					"content": "うん、方向は正しいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "う～ん、どういうことなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280410,
					"content": "そういやぁ、稲妻にはこんな話がある。商人が夜道を歩いてると、狸が妖術で同じところを一晩中彷徨わせるらしい。夜が明けるまで抜け出せないとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280411,
					"content": "鬼打牆のことだな、オイラも知ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280412,
					"content": "なら、話が早え。つまり、俺たちは今そういうのに遭遇したってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280413,
					"content": "だが、心配いらねぇ。俺様には邪気を払える助っ人がいるからな。こういう時は、そいつを呼べばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280414,
					"content": "一斗って鬼なのに、邪気を払える友達がいるんだな…なんていうか、肝が据わってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280415,
					"content": "鈍いとこが、親分が楽しく生きていけてる理由だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280416,
					"content": "いでよッ、丑雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280417,
					"content": "モォ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280418,
					"content": "こいつが荒瀧派の隠れ構成員、丑雄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280419,
					"content": "モォモォ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280420,
					"content": "おっ、丑雄が挨拶してるみてぇだぜ。お前ら、こいつのことは丑雄か丑兄貴って呼んでやってくれ。丑雄は道を探すのが得意なんだ、こいつに案内してもらえば一発だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280421,
					"content": "隠れ構成員なんていたのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280422,
					"content": "私には頼りなさそうに見えるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280423,
					"content": "さあ、どうでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280424,
					"content": "いけ、丑雄！俺たちのために道を切り開け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280425,
					"content": "モォ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280426,
					"content": "丑雄は隠された出口がないか探し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "モ…モモ…モォ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280428,
					"content": "うん？ふむふむ…ああ！？なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280429,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280430,
					"content": "道に沿って全部探したらしいが、出口がないらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280431,
					"content": "いや、入れるのに出られないわけがねぇ。クソッ…俺様が見てくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280432,
					"content": "気付いたか？最初、私たちは上のほうから落ちてきた。つまり、高いところに出入口があったはずだ…それが今はなくなっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280433,
					"content": "一体、これはどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280434,
					"content": "この地底の建物は、思ったほど単純ではないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280435,
					"content": "…この辺りを調べてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280436,
					"content": "この辺、岩壁だらけだな。もしかして…オイラたちが勘違いしてるだけで、本当は落ちてきてなんかいないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280437,
					"content": "おい、なんだ？怖くなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280438,
					"content": "べ、別にオイラは怖がってなんかないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280439,
					"content": "モォ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280440,
					"content": "お前が怖がってんのを、丑雄は感じ取ってるみたいだぜ。心配すんな、もし怖けりゃ言え。俺たちが守ってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280441,
					"content": "#パイモン、{M#俺}{F#私}もついてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#立ち止まっててもしょうがねぇ。もう一度探すぞ。忍、お前は恩人と一緒にいろ、俺様は{NICKNAME}とパイモンを連れて行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280443,
					"content": "分かった。みんな、くれぐれも気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280444,
					"content": "恩人だなんて大げさな、私のことは煙緋でいい。それにしてもさすが荒瀧派の親分だ、一斗さんは統率力に優れているんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280445,
					"content": "それほどでもねぇよ。それから俺様に「さん」なんていらねぇぜ、一斗って呼んでくれ。お前らとは仲間になるって約束したんだ、助け合わねぇとな。パイモン、怖いなら俺様が目を覆ってやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280446,
					"content": "一行は分かれて周りを調べたが、収穫はなかった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "…ちっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280448,
					"content": "本当に出口がないなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280449,
					"content": "モォ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "丑雄"
				},
				{
					"id": 10280450,
					"content": "一体どうなってんだここは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280451,
					"content": "親分、そっちはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280452,
					"content": "収穫はなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "それに、さっきちらっとだが、人影を数人見た気がする…角の生えた化けもんとか出てこなけりゃいいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280454,
					"content": "冗談なんか言ってる場合じゃないけど、おまえだって角の生えた鬼だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280455,
					"content": "そうじゃねぇ！俺様が言ってんのは、姿が消えたりするほうの化けもんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280456,
					"content": "うん？一斗、おまえまさか…お化けが怖いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280457,
					"content": "あらら、バレてしまったみたいだな、親分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280458,
					"content": "そ、そそ、そんなわけねぇだろ！デタラメ言うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 10280459,
					"content": "へへっ、一斗の反応を見てたら、急に怖くなくなってきたぞ…おい、牛使い野郎、怖いならオイラ様が目を覆ってやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280460,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280461,
					"content": "どうやら、他にやることを探して、この緊迫した空気を和らげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280462,
					"content": "（あれ？横で忍が石を拾って、ポケットから枝とスミレウリを取り出した…ん？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "塩少々…コショウ少々。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280464,
					"content": "スミレウリを焼いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "ああ。焼きスミレウリだ、美味しいから食べてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280466,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "あ…塩味と甘めの味付けの二種類あるんだが、どっちがいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280468,
					"content": "両方ともいける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "そうか、じゃあ二つやろう。このような状況だからこそ、心の平穏を保つのは大事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280470,
					"content": "もし私の推測が正しければ、ここには私と親分が知ってはいけない秘密があるんだろう。安心してくれ、親分が首を突っ込まないようにしておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280471,
					"content": "おっ、食べ物を焼いているのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280472,
					"content": "煙緋さんもどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280473,
					"content": "いや、私はお腹が空いてないから、後でいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280474,
					"content": "そう言えば、忍と会うのは久しぶりだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280475,
					"content": "ああ。前に会ったのは、私が璃月の学校に通っていた時のことだ。煙緋さんが先生の代わりに授業してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280476,
					"content": "授業…ああ、思い出した。たしか、冬だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280477,
					"content": "みんな、煙緋さんの授業はとても面白いと言っていたよ。そう考えると…私は煙緋さんのことを先輩と呼んだほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280478,
					"content": "うん、悪くない呼び方だね、気に入ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280479,
					"content": "まさか、後輩とこのような問題に巻き込まれるとは思ってなかった。これもある種の縁というものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280480,
					"content": "煙緋は授業もできるんだ、すごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "ああ。しかも、面白い知識を教えてくれるから、学生の中でもかなり人気があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280482,
					"content": "はははっ、忍はお世辞が上手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280483,
					"content": "全員、ここにいたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280484,
					"content": "夜蘭、手分けして探したんだが、出口は見つからなかった。そっちは収穫あったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280485,
					"content": "なかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280486,
					"content": "それから…あまりこれは言いたくないのだけど、心して聞いてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280487,
					"content": "もし、このまま道が見つからなかったら、しばらく地下で過ごすことになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280488,
					"content": "…やはりそうなるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280489,
					"content": "…分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 10280490,
					"content": "でも、入ることができて、出ることのできない地下空間なんてあり得ない…引き続き、試行錯誤してみるつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280491,
					"content": "みんなも出口に繋がりそうな場所を見つけたら、安全に気を配りながら調べてみてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 10280492,
					"content": "（そういえば、魈もこの場所にいる。困ったことがあれば名前を呼んでくれって言われた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "（…うん、試してみる価値はありそう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "おい、そんな真剣な顔して、なにかするつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280495,
					"content": "魈もここに来てること、忘れてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "魈…そっか！あいつに助けてもらうんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280497,
					"content": "試してみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "おう、じゃあやってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280499,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "魈、聞こえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280502,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "魈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "反応がない…魈ならどこにいても、すぐに駆けつけてくれると思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280505,
					"content": "もしかして、あの魈でさえオイラたちの気配を感じられないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10280506,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "#（{M#これはどういうことだ？俺}{F#これはどういうこと？私}たちがいるこの地下は…一体なんなんだろう？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
