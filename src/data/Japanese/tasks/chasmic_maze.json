					"content": "いい方向に考えるんだ。そう、ここで見聞を広めたり、旧友と親睦を深めたりするのは良いことだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280605,
					"content": "うん…そうだ、これはいいこと。よし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "煙緋"
				}
