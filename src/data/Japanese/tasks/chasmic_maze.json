	"talks": [
		{
			"id": 102804,
			"completionStepIds": [
				102804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102804",
							"2"
						],
						"stepId": 102804,
