			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タンジ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "やあ！見知らぬ友よ！君は旅人かい？それでここを通りかかったのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380102,
					"content": "引き留めてしまって悪かった…ただ…えっと、ここで何があったのか…教えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380103,
					"content": "#{M#俺}{F#私}は{NICKNAME}。よろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "因論派ダステアのタンジだ。私は…えっと、そうだった、タニット部族の…教育支援を行っている者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380105,
					"content": "おかしいな、ここのはずなんだが…どうしてこんな風になっているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380106,
					"content": "その…話すと長くなるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "部族間の争いまたは内輪揉めだと…ほう？面白い。砂漠で部族がまるごと壊滅するなんて衝突、数百年ぶりだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380110,
					"content": "それに…不吉な痕跡も見つけた…コホン、見ないほうがいい。その…吐いてしまうかもしれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380111,
					"content": "その人々のうち生き残った者が戻ってきて、残されたものの大半を…整理したのかもしれん。確証はないが…実に不穏だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "はぁ…なんてことだ。なんだか…歴史に残りそうな事件を目撃した気分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380114,
					"content": "ああっ、そうだ、ついでなんだが…えっと、カードゲームをしないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380115,
					"content": "あそこのテントでデッキをいくつか見つけたんだ。少し拭く必要はあったが、なかなかいい状態でね。もし興味があれば、一緒にどうだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タンジ"
				},
				{
					"id": 733380108,
					"content": "多分…部族ごとここからもう離れたのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "移動したのか？いや…でも、荷物もテントも元の場所に残されたままだ。薪の灰、そして寝室には生活の痕跡…ふむ、どちらかというと、突如として襲い掛かってきた災難が、ここにいた人全員の生活を中断させたかのように見える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "タンジ"
				}
			]
		},
