			"dialogs": [
				{
					"id": 200700101,
					"content": "前に雪山に置いてきたお花はどうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700102
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700102,
					"content": "1つだけ持って帰れた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700103
					]
				},
				{
					"id": 200700103,
					"content": "他のお花は持って帰れなかったの？うーん…雪山の状況は予測できるものじゃないし、仕方ないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700104
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700104,
					"content": "でも1つしかないとなると、比較はできないね。また機会を探して試すしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700105
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700105,
					"content": "手伝ってくれてありがとう、これは報酬だよ。今後も手伝ってもらうことがあるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
		{
			"id": 2007002,
