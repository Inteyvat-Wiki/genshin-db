			"dialogs": [
				{
					"id": 200700501,
					"content": "こっちだよ、ほら来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700502
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700502,
					"content": "雪山に置いてきたお花のことは覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700503
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700503,
					"content": "もう1日経ったし、冷蔵保存の効果を確認したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700504
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700504,
					"content": "雪山に行ってお花を取ってきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700505,
						200700507
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700505,
					"content": "任せて",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "じゃあお願いね。フローラはここで待ってるから、早く戻って来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700507,
					"content": "どこに置いたかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700508
					]
				},
				{
					"id": 200700508,
					"content": "忘れたの？<color=#00E1FFFF>七天神像のそば</color>、<color=#00E1FFFF>山中の水辺</color>、それと<color=#00E1FFFF>洞窟の近く</color>だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700509
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700509,
					"content": "地図に標記してあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		}
