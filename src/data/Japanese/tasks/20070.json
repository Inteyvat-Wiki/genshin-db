			"dialogs": [
				{
					"id": 200700201,
					"content": "お花はどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700202,
					"content": "ごめんなさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "え？どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700204,
					"content": "うっかり花と箱を壊してしまった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "こ、壊した！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700206,
					"content": "うぅ…あれはフローラが厳選したお花なんだよ。簡単には見つけられないきれいなお花なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700207,
					"content": "雪山ってそんなに危ないの？あなたのような冒険者でも、うっかり花を一箱も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700208,
					"content": "それでも手伝ってくれてありがとう。これを受け取って。フローラはお花のお世話をしなくっちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 200700209,
					"content": "はあ…サラさんに教えてもらった方法をもう一回試してみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
