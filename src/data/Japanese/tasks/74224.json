						],
						"stepId": 7422409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タイユフェール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "これは…！ええ、『漂流の異邦人』の譜面で間違いありません。本当に見つけてきて下さるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240902,
					"content": "きっと大変だったでしょう。さすがは凄腕冒険者さん…信じて正解でした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240903,
					"content": "へへっ！ところでタイユフェールさんはこの譜面を使ってなにをしようとしてるんだ？エピクレシス歌劇場で公演して大儲けしようってわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240904,
					"content": "まぁ…お金稼ぎも大事ですけどね。でも私は、この譜面を独り占めするつもりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240905,
					"content": "こういった古の芸術は、全人類の財産ですからね。『漂流の異邦人』全篇の研究が終わったら、公開するつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240906,
					"content": "失われた伝説の演劇を復元し、芸術史から抜け落ちた一ページを補完する。それってものすごく素晴らしいことだと思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240907,
					"content": "がんばって！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "では、さっそく譜面を研究しに戻ろうと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240911,
					"content": "報酬を受け取ってください。またお会いしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240908,
					"content": "手伝ってあげたこと、忘れないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "もちろんです。出版した暁には、扉にあなたたちのお名前を載せますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "タイユフェール"
				}
			]
		},
