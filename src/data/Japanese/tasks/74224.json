			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タイユフェール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "あれっ？タイユフェールさんじゃないか？また会えるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240202,
					"content": "これはこれは、冒険者さんに助手さん。先日はお名前を伺いそびれていましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240203,
					"content": "#オイラはパイモン、こっちは{NICKNAME}だぞ。こないだは「海螺の響き」で大昔の曲を演奏するのを手伝ってくれてありがとうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240204,
					"content": "ところでタイユフェールさんは、なんでペトリコールに来てるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240205,
					"content": "こちらも同じことを聞こうと思っていたところです…私は風のうわさを聞いて、駆けつけたんです。まぁ、あなたたちは冒険者だから、先に着いていても不思議じゃありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240206,
					"content": "うわさって、なんのうわさだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240207,
					"content": "ペトリコールといえば、最近一番アツいニュースは「あれ」に決まってるじゃありませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240208,
					"content": "#{M#俺}{F#私}たちが偶然世界を救ったこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "えっ、何を言ってるんですか？もちろん、伝説の色褪せた城が再び発見されたってニュースですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240211,
					"content": "色褪せた城に関する最後の記録は、一番新しいものでも数百年前のものだったんです。てっきり、あなたたちもそのためにここへ来たのかと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240212,
					"content": "それもまぁ、オイラたちに関係あるっちゃあるんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240213,
					"content": "あなたたちもご存知でしょう？色褪せた城は、かつてフォンテーヌの歴史上でもっとも重要な音楽家だったボエティウスが所有していたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240214,
					"content": "ボエティウスが創作した歌劇も、彼がまとめた古レムリアの譜面も…音楽史上、特別な位置づけにあるものばかりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240215,
					"content": "彼がかつて住んだ城というからにはきっと、大量の資料が残されているはずです。それは私たち音楽家協会の人間にとって、とても重要な文献です…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240216,
					"content": "ですから、報せを聞いてすぐ駆けつけてきたんです。ほかの冒険者たちよりも先に、重要な文献を確保したいですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240217,
					"content": "あなたたちに先を越されるとは思いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240218,
					"content": "（どうする？ボエティウスは実はとんでもない悪人で、音楽を利用して悪事を働いたんだぞって教えてやったほうがいいんじゃないか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240219,
					"content": "（でも、もし本当のことを知ったら、悲しむかなぁ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240220,
					"content": "「楽章」にもう悪いことはできない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "…なにをひそひそ話しているんですか？もしかして、もう古代の譜面を見つけてしまったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240223,
					"content": "あのさ、もし…もしもだぞ？ボエティウスがすっごく悪いやつだとしたら、それでもあいつが残した譜面が欲しいと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240224,
					"content": "うーん…あなたの言う「すっごく悪い」がどういうことなのかは分かりませんが、ボエティウスが歴史上に素晴らしい名声を残したのは、音楽に関することだけですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240225,
					"content": "彼の残したロマン主義歌劇『漂流の異邦人』からもわかるでしょう？彼はこの世を去る直前までレムリアの再興を諦めることなく、新生フォンテーヌを敵視していたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240226,
					"content": "それに歴史学者の話によれば、フォンテーヌが興ったばかりの頃にあった戦乱も、彼と関わりがあるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240227,
					"content": "でも、それと音楽における成果とはまったく別の話でしょう？彼の創作した音楽に誤った歴史が描かれていたとしても、その芸術的価値を否定することはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240228,
					"content": "それに、私にとってはそれも歴史の一部ですからね。純粋な芸術が、悪事に利用されることもある——音楽家の端くれとして胸に刻むだけですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240229,
					"content": "#{M#君}{F#あなた}なら、悪事には使わないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "ふふっ、私はただの研究者に過ぎませんよ。古のメロディーを聴きたいと、心の底から願っているだけのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240233,
					"content": "ところで…こうして会ったのも縁ですから、ちょっと力を貸していただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240234,
					"content": "この前協力して差し上げたことへの、お返しだと思って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240235,
					"content": "報酬はいらないって言ってたくせに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "ふふっ、とにかく、決まりってことでいいですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240240,
					"content": "ともかく…先ほどちらっとお話ししましたが、私は著名な歌劇『漂流の異邦人』の失われた譜面を探すためにここへ来ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240241,
					"content": "ルッジェロという人が残した数百年前の記録によると、それは色褪せた城のどこかにしまわれているそうです。もし手伝ってもらえると、とても助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240242,
					"content": "遺跡探索のような仕事は私よりも、あなたたちの専門でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}、どうしてもって感じだし…手伝ってやろうぜ。どうせその譜面にはもう「あの力」は残ってないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 742240244,
					"content": "それは…承諾してもらえたってことでいいですよね？良かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240245,
					"content": "ではお願いしますね。お帰りになるまで、私は町で朗報を待っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240237,
					"content": "報酬はもらうけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "もちろん報酬はお渡ししますよ。別に音楽家協会はお金に困っていませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240239,
					"content": "こうなると思った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "正論だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "ふふ、単なる一個人の見解ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240221,
					"content": "きちんと説明するにはちょっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "ペトリコール全体が催眠にかかってること？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
		{
