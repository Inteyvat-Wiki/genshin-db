			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タイユフェール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "ここの景色は素晴らしいですね。毎年たくさんの楽器を買い付けに来ていますが、旅行者として来るのは初めてなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "タイユフェール"
				},
				{
					"id": 742240802,
					"content": "譜面について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "特になにも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "ではお願いしますね。お帰りになるまで、私は町で朗報を待っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タイユフェール"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422409",
