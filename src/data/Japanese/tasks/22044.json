			"dialogs": [
				{
					"id": 220440301,
					"content": "おう！これだけあれば十分だ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440302,
					"content": "あとでじっくりと観察しよう…どうすれば木を鳴草の形にできるんだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440303,
					"content": "ふむ、もし装飾品を出来の良いものにして、種類も増やしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440304,
					"content": "装飾品も単独で売れるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
