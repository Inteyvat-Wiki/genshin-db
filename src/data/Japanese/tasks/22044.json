			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "やあ旅人、お参りに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440102,
					"content": "木彫りはどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "はははっ、まあまあ順調さ。ただ木彫りの大きさについては、まだ調整する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440104,
					"content": "何せ当時の考えでは、手のひらに収まる大きさの木彫りにする予定だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440105,
					"content": "そうすれば、遊ぶとき色々便利だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440106,
					"content": "それに、本体以外にも…「装飾」をつけるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440107,
					"content": "以前他の人が彫像を作るところに立ち会わせたんだが、本体以外にも装飾をつけていたのを見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440108,
					"content": "花だったり、動物だったり、花柄の台座だったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440109,
					"content": "俺も自分の作った木彫りに、装飾品を付けた台座を作りたくてな…まあ、大きさの問題で、装飾品はそれぞれの台座に対して一つしか付けられないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440110,
					"content": "取り外し可能なものにすればいいだろう。お客さんが付けたい装飾品があったら、それを付けてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440111,
					"content": "そこで、最も簡単なものから始めたい。例えば…鳴草とかの植物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440112,
					"content": "旅人、「鳴草」を3つ持ってきてくれないか。装飾品作りの参考にしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440113,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "それじゃ頼んだよ、旅人。鳴草を採ってきたら、俺のところに持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440114,
					"content": "どうして3つ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "3つあれば、状態の異なる鳴草を観察することができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440116,
					"content": "そうすれば、きっと最高の鳴草の形に彫れると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "大島純平"
				}
			]
		},
