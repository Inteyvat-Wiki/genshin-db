				]
			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "プーカ、戻ったぜ！おまえのしるしを見つけたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450202,
					"content": "見つけたしるしをプーカに渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "うんうん、これだよ。ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450204,
					"content": "あと、しるしを探してた時、これも見つけたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450205,
					"content": "これまで見たことない鉱石だったから、もしかしてなんか貴重な宝石かもって思って、一緒に持ってきたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450206,
					"content": "たしか、プーカは前にもこの近くできれいな石をよく拾ってたって言ってたよな？こんな石も見たことがあるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450207,
					"content": "ちょっと見せて…確かにすごくきれい！でも…これは貴重な石とかじゃなくて、ただの普通の石なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450208,
					"content": "他のところにはこんな石はないかもしれないけど、ここの鉱脈付近では至るところにあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450209,
					"content": "なんだよ、すごく価値のある石かと思ったら、ただの石ころだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450210,
					"content": "特に使い道もなさそうだし、適当な場所を見つけて捨てようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450211,
					"content": "でも、他所の人々は見たことがないかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "おお！つまり、他のところで売ったら、高く売れるかもしれないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450214,
					"content": "#たしかに、メリュジーヌの村に来て鉱石を採掘しようなんて思う人はいないだろうし、こんな石を見た人もいないだろうな…頭いいな、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450215,
					"content": "こうなったら、この石をフォンテーヌ廷に持っていって、あそこの商人に見せてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450216,
					"content": "うん、もし鉱石についてもっと知りたいことがあれば、いつでも私のところに来てね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450217,
					"content": "姉さんみたいに宝石工房もないし、鑑定とか処理のこともあまり知らないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450218,
					"content": "私は貴重な宝石より、いろんな面白い石を拾うのが好きだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450219,
					"content": "周辺の鉱脈の状況なら、結構知ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450220,
					"content": "うんうん、わかったぜ、プーカ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450212,
					"content": "でも、ここでしか見られない石だとしたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
