				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "いらっしゃいませ。当店はフォンテーヌ廷で一番宝石の種類が豊富な店で、各種工芸品も販売してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450402,
					"content": "何か好きなものはあるかい？なくても、ほしいものがあれば何なりと私に言ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450403,
					"content": "奇妙な鉱石を手に入れたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "そうそう。宝石の種類が一番豊富な店なら、きっとオイラたちが手に入れた鉱石の価値もわかるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450405,
					"content": "おお、君たちは鉱石を売りに来たんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450406,
					"content": "なら、当店が最適な選択だ。ここの買い取り価格は絶対に信用できるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450407,
					"content": "どれどれ、鉱石を見せてくれるかい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450408,
					"content": "以前見つけた奇妙な鉱石を取り出し、チェシルに見せた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "こ…これは私でさえ見たことのない鉱石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450410,
					"content": "この神秘的な色合いと光沢、それに滑らかな手触り…きっと珍しい種類に違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450411,
					"content": "私の知識不足で大変恥ずかしいんだが、これは一体なんていう鉱石なんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450412,
					"content": "#{M#俺}{F#私}も分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "だから、鑑定を頼みに来たってわけだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450419,
					"content": "でもこんな鉱石が一つしかないなんて、本当に残念なことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450420,
					"content": "もし十分な量さえあれば、フォンテーヌ全土を席巻できるくらい人気の装飾品を作れるかもしれないんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450421,
					"content": "（たしか、この石ころは鉱脈周辺の至るところにあるって、プーカが言ってたよな。あいつに聞けば…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450422,
					"content": "こんな鉱石は結構持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "本当か、それはよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450430,
					"content": "そしたら、君たちが持ってる鉱石を買わせてもらおう。それに君たちのルートを通して、さらに多くの鉱石を買い入れ、工芸品を作りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450431,
					"content": "もちろん誠意を表すために、代金は先払いさせてもらうよ。今度来た時に、もっと多くの鉱石を持ってきてくれたらいいさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450432,
					"content": "どうだい、公平な取引だと思うけど、君たちはどうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450433,
					"content": "へへ、オイラも悪くないと思うぜ。じゃあ取引は成立だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450434,
					"content": "それは本当によかった。これは品物の代金だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450435,
					"content": "この宝石でどんな装飾品ができるかな。ははは、今から楽しみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450436,
					"content": "じゃ、私はここでいい知らせを待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450424,
					"content": "供給元は企業機密。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "ああ、それもそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450426,
					"content": "でも、君たちが仕入れのルートを知ってるならそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450427,
					"content": "実は「エリナス」のところにたくさんある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "おい、あっけなく言っちゃうのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450429,
					"content": "なるほど、「エリナス」のところで見つけたのか？確かに、鉱脈の奥深くまで入る人はあまりいないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740450414,
					"content": "「パイパイ石」とかいう鉱石かも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "おい、変な名前をつけんなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450416,
					"content": "それはもちろん「きらきら琉璃色の金」だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "うっ、それ…たったいま思いついた名前だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450418,
					"content": "すごい名前だな。道理で見た目からして特別なわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "チェシル"
				}
			]
		},
