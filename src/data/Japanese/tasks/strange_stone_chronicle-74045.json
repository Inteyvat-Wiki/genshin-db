			"dialogs": [
				{
					"id": 740450101,
					"content": "プーカ、なんでまたここに来たんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450102,
					"content": "この近くにはこれ以上魔物は現れないと思うけど、別の危険があるかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450103,
					"content": "とにかく、一人であっちこっち走り回ったりしないほうがいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450104,
					"content": "#パイモン、{NICKNAME}{M#兄さん}{F#姉さん}、私は走り回ったりなんかしてない…実は私、自分の「しるし」を探しに来たの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450105,
					"content": "えっ？おまえ「しるし」を失くしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450106,
					"content": "うん…たぶん前に石を拾った場所で失くしちゃったんだと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450107,
					"content": "うぅ…もしかして前回閉じ込められた時、うっかり落としちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450108,
					"content": "えっと…たぶんその時だと思う…その時はあまりに怖かったから、気づかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450109,
					"content": "今でも思い出すだけで怖いけど、でも「しるし」はとても大事だから、見つけないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450110,
					"content": "うーん…でもプーカだけで行くのは危ないし、こうなったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}、もう一度あの場所に行って、プーカの「しるし」を探してやろうぜ。プーカは先に家に帰って待っててくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740450112,
					"content": "#{M#俺}{F#私}たちに任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#ありがとう、{NICKNAME}{M#兄さん}{F#姉さん}とパイモン！家に帰っていい子で待ってるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450113,
					"content": "ついでに探索もできるし、いい機会だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
