			"dialogs": [
				{
					"id": 740450601,
					"content": "また来てくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450602,
					"content": "鉱石について知りたいのかな？なんでも聞いてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450603,
					"content": "プーカもあまり知らないかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450604,
					"content": "貴重な宝石について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "周辺の鉱脈にはキラキラしてて、きれいな石がいっぱいあるけど、本物の宝石とはかなりの差があるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450606,
					"content": "もし私も本物の宝石を見つけることができたら、スルアシー姉さんみたいに自分の宝石工房が持てるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450607,
					"content": "鉱石の用途について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "えっ？私はそのことについて考えたことがないの…私はただ、きれいだからいろんな石を集めてるだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740450609,
					"content": "特に質問はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "へへ、プーカに会いに来てくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プーカ"
				}
