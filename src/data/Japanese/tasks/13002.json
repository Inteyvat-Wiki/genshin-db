			"dialogs": [
				{
					"id": 130020801,
					"content": "なあ、また映像フィルムを見つけたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020802,
					"content": "日付まで書いてあるぞ！うーんと…半年前のものみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020803,
					"content": "もうかなり経ってるね。その間にいったい何があったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020804
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020804,
					"content": "映像フィルムを入れると、少しずつ過去の映像が映し出された…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020805
					]
				},
				{
					"id": 130020805,
					"content": "珍しいな。まさかお前が操作ミスで故障するなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020806
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020806,
					"content": "どうやらコーヒーを入れるのはまだ難しかったみたいだな。それとも、俺が設定したパラメータに問題があったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020807
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020807,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020808
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020808,
					"content": "よし、これでもう大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020809
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020809,
					"content": "グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020810
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020810,
					"content": "「ハサミ」のパーツに水が入っちまったせいで配線がショートし、「脳」からの信号を受信できなくなっていたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020811
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020811,
					"content": "おっと、こんなことお前には分からないか。大丈夫、新しいパーツと取り換えてやったから、もう直ったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020812
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020812,
					"content": "動いてみて、違和感がないか確認してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020813
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020813,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020814
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020814,
					"content": "次は気を付けるんだぞ！最近は資金面が厳しいからな、備品もエネルギーも残り少ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020815
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020815,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020816
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020816,
					"content": "何だ？嬉しそうじゃないか。カカタ、俺は昨日ある夢を見たんだ。夢の中でお前は喋っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020817
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020817,
					"content": "教令院のやつらはいつも「機械の知能など統計学の延長に過ぎない」って言ってたよな。お前が俺と話せてるのを見て、あいつら唖然としてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020818
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020818,
					"content": "グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020819
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020819,
					"content": "ただの夢だったのが残念だ。お前のその純粋な姿を見ていると、俺と会話するどころか、俺がいつかいなくなったとしても、お前は異変に気付かないんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020820
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020820,
					"content": "…まあいい。まずは来月のエネルギーを何とかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020821
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020821,
					"content": "ここで映像は終わっている。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020822
					]
				},
				{
					"id": 130020822,
					"content": "アバッドイは教令院を出た後、音信不通になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020823
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020823,
					"content": "僕はあの時、アバッドイは意気消沈して、機械生命の研究を諦めたんだって思った。まさか、こんなところに身を潜めて実験を続けていたなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020824
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020824,
					"content": "カカタのためにパーツも交換してあげてたし、なんだか悪いやつじゃないみたいだよな。なんで地脈に目を付けたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020825,
					"content": "エネルギーのことを言ってたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020826
					]
				},
				{
					"id": 130020826,
					"content": "とにかく、他にも探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
