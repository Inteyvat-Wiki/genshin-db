			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021101,
					"content": "つまり…カカタはマスターを「修理」できると思って、パーツを集め続けてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021102,
					"content": "カカタには、「死」というものが理解できないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021103
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021103,
					"content": "それでも、かつて「故障」したとき、アバッドイにパーツを交換してもらったおかげで「正常」に戻ったことを覚えてたんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021104
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021104,
					"content": "確かにカカタに思考能力はないし、分からないことも多い。だけどそれでも、子供と同じように大人を真似するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021105
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021105,
					"content": "だから機械パーツを奪ってたのか…でも、あいつがどんなに頑張っても、もう修理することはできないんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021106,
					"content": "うん。でも大事なのは、カカタに「アバッドイを直したい」という考えが生まれたことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021107
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021107,
					"content": "どうやって生まれたのかは分からない。でもその考えは、アバッドイが設定した「本能」さえも凌いでたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021108
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021108,
					"content": "もし僕たちの推測が本当なら、これは教令院を揺るがすことができる研究だよ。古代の技術ではできたのかもしれないけど、現代の科学で成功した人はまだいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021109
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021109,
					"content": "おい、カカタ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021110,
					"content": "聞いたか？おまえ、ティナリに褒められたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021111,
					"content": "反応がないね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021112
					]
				},
				{
					"id": 130021112,
					"content": "きっともう限界なんだ。もうずっとエネルギーを補充してないし、激しく破損したパーツも交換できてないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021113
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021113,
					"content": "むしろ今まで持ったのが奇跡だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021114
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021114,
					"content": "僕は地脈抽出装置がちゃんと止まったかどうか確認してくる。君たちも一緒に来なよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021115
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021115,
					"content": "彼らを…二人っきりにしてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
