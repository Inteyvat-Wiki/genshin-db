			"dialogs": [
				{
					"id": 130021301,
					"content": "地脈抽出装置は止まったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021302
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021302,
					"content": "空気中にはまだ地脈エネルギーがかなり残ってるけど、漏出の源は断てたから、この量なら浄化装置で処理できると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021303
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021303,
					"content": "あとは、手遅れになる前に地脈の影響を受けた人を治療しないと。告知板に汚染区域の危険性を書いて、患者がコレイのところに向かってくれるようにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021304,
						130021305
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021304,
					"content": "カカタ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				},
				{
					"id": 130021306,
					"content": "教令院のルールでは、彼ら全員を連れ戻さないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021307
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021307,
					"content": "機械生命に関する研究資料は全て破棄され、カカタは解体されて保管される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021308
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021308,
					"content": "そんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021309,
					"content": "君たちは先に戻ってて。残りは僕が処理しておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021310
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021310,
					"content": "地脈漏出の源は塞いだけど、空気中の地脈エネルギーはまだ普通より高い。このままじゃ、君たちの体が持たないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021311
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021311,
					"content": "で…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021312,
					"content": "#君はともかく、{NICKNAME}はあまり休めてないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021313
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021313,
					"content": "ここの研究資料は数が多いから、梱包に時間がかかる。君たちは実験について何も知らないし、ここにいてもあまり意味がないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021314
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021314,
					"content": "仕事は片付いたって、冒険者協会にそう伝えてくれる？あとはぐっすり休んどいて。他のことはまた明日話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021317
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021317,
					"content": "ティナリは研究時によく訪れるパルディスディアイをマップに標記した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130021315
					]
				},
				{
					"id": 130021315,
					"content": "…あ、そうそう。アバッドイに関しては他言無用ね。機械生命の研究に関わることは、あまり知られない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021316
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021316,
					"content": "分かった…じゃあ、オイラたちはキャサリンのところに戻るぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130021305,
					"content": "アバッドイの研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				}
			]
		},
