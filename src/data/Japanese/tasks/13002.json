				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ",
					"カカタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020401,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020402,
						130020403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020402,
					"content": "見たことない装置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				},
				{
					"id": 130020404,
					"content": "地脈エネルギーはここから漏れ出してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020405
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020405,
					"content": "この装置…何てことだ、延々と地脈を抽出し続けてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020406
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020406,
					"content": "いったい誰がこんなことを…後先を考えてないの？このまま地脈を破壊し続けたら、自己修復すらできなくなるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020407
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020407,
					"content": "そんな…絶対に止めないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020408,
					"content": "えっと…うーん…操作できるところが見当たらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020409,
					"content": "頭がくらくらしてきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020410
					]
				},
				{
					"id": 130020410,
					"content": "ここにいると地脈エネルギーを直接浴びることになる。そしたら、体も取り返しのつかないダメージを受けてしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020411
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020411,
					"content": "君とパイモンは先に避難するんだ。僕はこの装置の止め方を調べてみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020412
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020412,
					"content": "でも…いくらティナリでも、地脈の影響はさけられないんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020413,
					"content": "オイラたちも残るぞ。ティナリを一人にさせる訳にはいかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020414,
					"content": "分かった、なら一緒に探そう。制御ユニットが見えないってことは、この辺に「隠し扉」があるはず——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020415
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020415,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020416
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020416,
					"content": "グル！グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020417
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020417,
					"content": "もしかしておまえ、どこに隠し扉があるか知ってるのか？おい、待てよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020403,
					"content": "嫌な感じがする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				}
			]
		},
		{
			"id": 1300205,
			"completionStepIds": [
				1300205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
