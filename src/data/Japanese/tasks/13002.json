			"dialogs": [
				{
					"id": 130020101,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020102
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020102,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020103
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020103,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020104
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020104,
					"content": "止まったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020105,
					"content": "よく見ると、ここの植物…確実に何か違うね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020106
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020106,
					"content": "地脈エネルギーも他の場所より強い。僕たちが探していたのはここかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020107
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020107,
					"content": "準備はいい？中に入ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 1300204,
			"completionStepIds": [
				1300204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
