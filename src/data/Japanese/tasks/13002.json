				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021001,
					"content": "…多分、これが制御ユニットだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021002
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021002,
					"content": "制御ユニットの電源を切れば、地脈抽出装置は止まるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021003
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021003,
					"content": "地脈を壊す「外力」さえなければ、ゆっくりと自己修復していくはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021004
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130021004,
					"content": "今はきっと、カカタの方が気になるんだろ？さあ、一緒に戻って確かめようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 1300211,
			"completionStepIds": [
				1300211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300211",
							"2"
						],
						"stepId": 1300211,
						"stateName": "QUEST_STATE_UNFINISHED"
