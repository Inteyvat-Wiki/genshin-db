			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ",
					"カカタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020501,
					"content": "あ！誰かいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020502,
					"content": "ここで地脈を抽出してたのはおまえなのか？今すぐその装置を止めるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020503,
					"content": "どうしてなんにも言わないんだ。びびってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020504,
					"content": "…もう、冷たくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020505
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020505,
					"content": "ひどく痩せてるし、目の下が青い。多分、慢性的な栄養失調と過労で倒れたっきり、二度と目を覚まさなかったんだろうね。いったい何があったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020506
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020506,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020507
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020507,
					"content": "…君を忘れるところだった。ほら、もう最後の一個だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020508
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020508,
					"content": "グル！グル！グル！グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020509
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020509,
					"content": "あいつ、なにやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020510,
					"content": "さあ。部屋の配置からして、ここは研究室みたいだ。奥に実験資料を保管してあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020511
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020511,
					"content": "資料室に何か手掛かりが残ってるはずだから、探してみよう。この場所について何か分かるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
		{
			"id": 1300207,
			"completionStepIds": [
				1300206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300206",
							"2"
						],
						"stepId": 1300206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ",
					"アバッドイ",
					"カカタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020701,
					"content": "なにか見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020702,
					"content": "実験ノートがいっぱいあったけど、全部読むには時間がかかりすぎるからね。実験に使われた映像フィルムを探し出したよ。シリアルナンバーを見る限り、多分二年前のものじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020703
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020703,
					"content": "映像フィルム？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020704,
					"content": "うん。素論派は昔、実験映像を残すための装置を作ってたんだ。そうして作り出したのが、映像フィルム。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020705
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020705,
					"content": "でもこの装置は値が張る上に安定性にも欠けてるから、一部の研究室で使われてるだけで一般公開はされてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020706
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020706,
					"content": "じゃあ早く見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020707,
					"content": "ちょっと待ってね、どうやって再生するのか確認するから…うん、これでよし——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020708
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020708,
					"content": "映像フィルムを入れると、少しずつ過去の映像が映し出された…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020709
					]
				},
				{
					"id": 130020709,
					"content": "カカタ、カカタ！まったく…しばらく目を離した隙に、どこ行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020710
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020710,
					"content": "グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020711
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020711,
					"content": "お前、そこにいたのか！早くおいで、ここが俺たちの新しい家だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020712
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020712,
					"content": "このアバッドイがここで大活躍して、教令院にのさばる骨董品どもを感服させてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020713
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020713,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020714
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020714,
					"content": "おっ？お前も嬉しいのか！でもカカタ、お前は俺たちがこれから何をするのか分かっているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020715
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020715,
					"content": "グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020716
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020716,
					"content": "ハハハッ…そうだな、分からなくともしょうがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020717
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020717,
					"content": "いいかカカタ、俺はこれからここで大量生産可能な機械生命を作るんだ。これまでにない技術を使ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020718
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020718,
					"content": "臓器を模した機械に、電流を血液のように流す。鋼でできた心臓は鼓動し、部品でいっぱいの脳は、俺と同じように考えることができるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020719
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020719,
					"content": "遺跡からの啓示、教令院に止められた研究…俺はすべてがここで復活すると願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020720
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020720,
					"content": "そして時が来たら、お前らは人の言葉を理解し、人とともに生活できるようになるんだ。それも単なる機械としてじゃないぞ。真の生命としてだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020721
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020721,
					"content": "グルル？グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020722
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130020722,
					"content": "大丈夫だ。お前にもいつか分かる、いつかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020723
					],
					"speakerTitle": "アバッドイ"
				},
				{
					"id": 130020723,
					"content": "ここで映像は終わっている。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020724
					]
				},
				{
					"id": 130020724,
					"content": "カカタって、あの機械ガニのことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020725,
					"content": "このアバッドイっていう学者は、教令院になにを証明しようとしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020726,
					"content": "「研究の廃止」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020727
					]
				},
				{
					"id": 130020727,
					"content": "思い出したよ。あの頃、確かにアバッドイって後輩がいた——機械生命の研究の一件で、教令院から追い出されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020728
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020728,
					"content": "「後輩」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020729,
					"content": "「後輩」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020730
					]
				},
				{
					"id": 130020730,
					"content": "それがどうかした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020731
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020731,
					"content": "いやいや。ただ、アバッドイはティナリより年上な気がしたんだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020732,
					"content": "学級に年齢は関係ないんだ。僕は早くに学業を終えたから、後から入学してきた人には先輩って呼ばれるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020733
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020733,
					"content": "そうだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130020734,
					"content": "もちろん、年齢も大事なことだけどね。一時期なんか、ある種の珍獣みたいに連れて行かれては写真を撮られてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020735
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130020735,
					"content": "コホン。そんなことより、他にも映像フィルムがないか探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティナリ"
				}
			]
		},
