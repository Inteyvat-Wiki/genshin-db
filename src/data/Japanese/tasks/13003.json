	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "…つまり、実は汚染の原因は森の奥からの地脈漏出だったんだ。今は解決して、正常に戻ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030102,
					"content": "そうでしたか。本当に、お疲れさまでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 130030103,
					"content": "空気中に残った地脈エネルギーが薄まったら、住民へのお知らせを貼り出しましょう。そうなれば、これまで通り自由に行き来できるようになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 130030104,
					"content": "こちらがお約束していた報酬です。どうぞお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 130030105,
					"content": "冒険者協会を後にすると、パイモンに静かな場所まで連れて行かれた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "カカタは…教令院行きになっちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030107,
					"content": "すでに故障はしてたけど、解体されるって考えると、ちょっと悲しくなっちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030108,
					"content": "#{M#俺}{F#私}も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "だったら、明日ティナリにお願いしてみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030110,
					"content": "ほんとはすぐに行きたいけど、ティナリは「明日話そう」って言ってたし、今戻ったら怒られるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030111,
					"content": "そうかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "じゃあ決まりだ！明日ティナリには、カカタを解体しないように言おうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ",
					"カカタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "ティナリ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030302,
					"content": "しー、静かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030303,
					"content": "フジモドキ、ジンチョウゲ科ジンチョウゲ属。著しい抗けいれん効果があり、麻酔粉として使用することができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030304,
					"content": "両組の実験データによって、魚に対して特に毒性があることがわかった、と…ちゃんと記録しておかなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030305,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130030306,
					"content": "カカタ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030307,
					"content": "グル！グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130030308,
					"content": "静かにしてって言ったのに。植物はちっとも気にしないだろうけど僕の耳には響くんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030309,
					"content": "おまえ、カカタを解体しなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030310,
					"content": "解体してどうするの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030311,
					"content": "だっておまえ、「教令院のルール」だって言ったじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030312,
					"content": "なるほど、こんな朝早くに僕を邪魔しに来たのは、そのためだったんだね。まあ、昨日ちゃんと説明しなかった僕も悪いか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030313,
					"content": "僕が言いたかったのは、教令院のルールでは研究成果は全て破棄することになっているから、あの場所を教令院に見つからないようにしようってこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030314,
					"content": "ティナリがあそこに残ったのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "とりあえずカカタを修理してたんだよ。昔教令院にいた時、素論派の授業を履修したことがあるんだ。まさか役に立つ日が来るなんて思わなかったけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030316,
					"content": "それから、カカタと一緒にアバッドイを埋葬してきた。実験資料の一部は記念として持ち帰って来たけど、ほとんどは燃やして深く埋めたよ。証拠隠滅のためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030317,
					"content": "僕は教令院の人間じゃないし、あそこのルールなんか知ったこっちゃない。それよりも、今はアビディアの森のレンジャー長として、森の生命たちを守る義務がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030318,
					"content": "この世に生まれた命には必ず意味がある。カカタも例外じゃない。存在する以上、勝手に捨てたり壊したりするべきじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030319,
					"content": "へへっ！良かったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030320,
					"content": "グルル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130030321,
					"content": "でも、ティナリは今、「命」って言ったよな。ってことは、もうカカタのことを「真の生命」だって認めたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130030322,
					"content": "あくまでも可能性の話だよ。何しろアバッドイを「修理」しようとした挙動は、解明が難しいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030323,
					"content": "アバッドイが残した実験記録だって、氷山の一角でしかない。彼がどれだけのコマンドを設定していたのかは、誰にも分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030324,
					"content": "もしかしたらカカタは単純にコマンドから生じた不具合のせいで、ああいう行動をとったのかもしれないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030325,
					"content": "だから厳密には、カカタが真の生命だとはまだ言えない。でも、可能性がある以上——僕はそれを信じたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030326,
					"content": "グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "カカタ"
				},
				{
					"id": 130030327,
					"content": "ちなみに、僕はこの研究テーマを続けることにはほとんど興味がない。連れて来たのも、単にここが隠れ家として優れているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030328,
					"content": "でもまあ、実験のアシスタントとして働いてもらうのもいいかな。少なくとも、実験記録くらいはこなしてくれそうだしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030329,
					"content": "君はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 130030330,
					"content": "グル！グル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カカタ"
				}
			]
		},
