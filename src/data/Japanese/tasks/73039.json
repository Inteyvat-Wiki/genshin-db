			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランパカティ",
					"アランチャトラ",
					"アランサカ",
					"アランパス",
					"アランファラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#おう、やっぱ{NICKNAME}の助けがいるようだな。じゃないと、また同じ料理が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391201,
					"content": "この前パイモンが思いついた改善方法を使ってアランナラを指導し、料理を完成させた。\\nそして、アランナラたちと一緒に楽しんだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "どうだ？本格的ナラグルメは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391203,
					"content": "#うーん…アランパカティはナラ{NICKNAME}にお兄ちゃんたちを指導してほしいって頼んだんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391204,
					"content": "ナラの料理…こ、これがナラの「幸福の味」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730391205,
					"content": "喜びが逃げていきそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730391206,
					"content": "ヴァナラーナの水は…確かに「最高に美味しい水」…どうしてこんなものができるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730391207,
					"content": "でも、「新鮮極上の果実」はやっぱり美味しかった…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730391208,
					"content": "え？どうしたんだ？アランナラにはマズいのか？オイラにはこんなに美味しいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391209,
					"content": "「マズい」が何か分からないけど…うーん…「インパクト」に満ちた味がする。走りすぎて木の幹にぶつかったみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391210,
					"content": "うぅ…こ…これはきっとナラ文化とアランナラ文化の衝突だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391211,
					"content": "#お兄ちゃんたちダメだよ、ナラ{NICKNAME}に感謝しなきゃ。どうしてそんなこと言うの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391212,
					"content": "うぅ…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730391213,
					"content": "違う！ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391214,
					"content": "#ありがとう、ナラ{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730391215,
					"content": "#それでも…ナラ{NICKNAME}とパイモンが喜んで食べてくれればそれでいいの！バカなお兄ちゃんは放っておいて！ナラの友達が喜んでくれれば、ワタシたちは嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391216,
					"content": "#でも、ナラ{NICKNAME}とナラヴァルナはちょっと違う。ナラヴァルナはあの時、「{M#お兄ちゃん}{F#妹}」のことをたくさん話してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391217,
					"content": "#でも、ナラ{NICKNAME}はあまり話さない。不機嫌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391218,
					"content": "#うーん…{NICKNAME}、なにか話してやったらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391219,
					"content": "心配してくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#そうなの？ナラ{NICKNAME}が大丈夫ならいいや。うん、ありがとう。この花をナラ{NICKNAME}とパイモンに贈るね、アランパカティとお兄ちゃんたちの気持ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391223,
					"content": "#ナラ{NICKNAME}とパイモンがヴァナラーナでもっと「幸福の味」に出会えるといいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730391220,
					"content": "（沈黙を保つ）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#…まあ、アランパカティ、心配するな！{NICKNAME}は大丈夫だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "パイモン"
				}
			]
