				"points": []
			},
			"dialogs": [
				{
					"id": 730391001,
					"content": "そうだ。こんな嬉しい日に、アランナラたちは熱心にオイラたちのために料理してくれてるんだよな。なら「礼には礼を」だ、オイラたちもなにかしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730391002,
					"content": "うーん…アランナラが喜びそうなもの…よし、大根入りの野菜スープにしようぜ！えへへ、アランナラにもナラの料理の腕を味わってもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
