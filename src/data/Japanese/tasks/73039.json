			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "お兄ちゃんたち、よく反省した。ウツァヴ祭は楽しい日。アランパカティはもう怒らないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730390102,
					"content": "うん、アランパカティもう怒らないで。楽しい日は、「幸福の味」をごちそうしてお祝いしないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730390103,
					"content": "今こそ、「お料理修行」の成果を見せるとき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730390104,
					"content": "とっくに準備は万端だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730390105,
					"content": "おおっ！ウツァヴ祭のごちそう！ずっと楽しみにしてたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730390106,
					"content": "やった！ウツァヴ祭のごちそうだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "ヴァナラーナの水は最高に美味しい水だ。最高のスープができる。飲めばナラもきっと満足さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730390109,
					"content": "#「幸福の味」をナラ{NICKNAME}とパイモンにあげたいなら、ナラ{NICKNAME}とパイモンに「指導」してもらったほうがいいよ、お兄ちゃんたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730390110,
					"content": "そうしないと、ナラが満足する料理にならないと思う。それこそが「お客さん」をもてなす「マナー」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730390111,
					"content": "#ナラ{NICKNAME}、お兄ちゃんたちの料理を「指導」してくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730390107,
					"content": "あまり期待しないほうがいいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
