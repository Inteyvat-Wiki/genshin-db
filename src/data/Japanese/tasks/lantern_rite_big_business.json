			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱店主"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "何か方法を考えなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340102,
					"content": "なんの方法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "…旅人でしたか。実はこの海灯祭の期間に、商売で一儲けしたいと考えておりまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340104,
					"content": "ここは位置的にもいいと思います。環境も悪くないですし、料理も…少なくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340105,
					"content": "城内で「明霄の灯」が飛ぶ時、ここでお酒とおつまみを嗜みながら見れば、人気スポットになれると思うんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340106,
					"content": "これを機にお客さんを集めたいと思うんですが、どう思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340107,
					"content": "ここから「明霄の灯」は見える？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "えっと…「明霄の灯」はとても大きいので、見えるはずですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340110,
					"content": "まあ…それについては後で考えるとして、まずは店の掃除をしなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340111,
					"content": "旅人、霄灯を作る材料を集めてきてくれませんか？霄灯を店に飾りたいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340112,
					"content": "完成した霄灯じゃだめ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "材料だけで大丈夫です。霄灯を作るのには手間がいるんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340115,
					"content": "デクが霄灯を作りますので、材料を集め終えたら、彼に渡してください。私は他の事に取りかかります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340116,
					"content": "もちろん、ただ働きさせるつもりはありません。きちんとお客さんが来て商売が成功したら、報酬を差し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340117,
					"content": "お客さんが来なかったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "えぇ…お客さんが来なくとも…報酬を用意いたしますので、ご心配なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340119,
					"content": "とにかく、店をきちんと手入れすれば、お客さんも来るはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340120,
					"content": "ゴホンッ…材料はデクに渡してください。明日状況を見て報酬を差し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413340113,
					"content": "材料だけでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "ここから「明霄の灯」は見えないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
