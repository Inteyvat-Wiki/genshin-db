					"content": "料理は準備できましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342202
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342202,
					"content": "準備できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342203
					]
				},
				{
					"id": 413342203,
					"content": "はい、これでいいと思います。ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342204
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342204,
					"content": "お二方、お待たせいたしました。ごゆっくりどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342205
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342205,
					"content": "ありがとうございます。そちらの旅人さんも…疲れたことでしょう、座って一緒に食べてはいかがですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342206
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342206,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342207
					]
				},
				{
					"id": 413342207,
					"content": "フフ、その様子ですと、私たちと同じように旅をしている人と存じます。祭りの日は、皆で一緒に食事した方が賑わうかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342208
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342208,
					"content": "はい、店主も一緒にいかが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342209
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342209,
					"content": "いいんですか。では遠慮なく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱店主"
				}
			]
		},
