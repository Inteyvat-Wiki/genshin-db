					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342105
					],
					"speakerTitle": "花初"
				},
				{
					"id": 413342105,
					"content": "旅人さん、ありがとうございます。私たちは先を急ぎます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
