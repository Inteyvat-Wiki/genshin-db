					"朱店主"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413342501,
					"content": "お二方、こちらへ。もうすでに準備できておりますので、お座りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342502
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342502,
					"content": "店主、この二人は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342503
					]
				},
				{
					"id": 413342503,
					"content": "ああ、先ほどお客さんを集めていた時に、下の方でお会いしたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342504
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342504,
					"content": "はい、こちらは明華銭荘のお嬢様で、私は明華銭荘の雇人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342505
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342505,
					"content": "お嬢様とは遠出していて、偶然海灯祭の時期にここに来ました。お嬢様は…故郷が恋しくなっているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342506
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342506,
					"content": "ですので、霄灯がよく見える場所を探していたのですが、その時にこちらの店主に会ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342507
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342507,
					"content": "はい、私の店には霄灯がたくさん飾ってありますので、最適かと思います。ですが…明華銭荘は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342508
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342508,
					"content": "…ゴホンッ！なんでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342509
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342509,
					"content": "お二方、長旅で歩き疲れたことでしょう。ここでごゆっくり休んでいってください。私は料理を準備してきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342510
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342510,
					"content": "旅人も手伝っていただけますか。あまり待たせるわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342511
					],
					"speakerTitle": "朱店主"
				},
				{
					"id": 413342511,
					"content": "できれば「美味しそうな真珠翡翠白玉湯」を用意してきてください。報酬は付け加えますので、お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱店主"
				}
			]
		},
