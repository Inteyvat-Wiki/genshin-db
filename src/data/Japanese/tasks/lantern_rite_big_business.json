					"content": "ここで霄灯を飛ばすのは確かにいいものですね。旅人さん、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342102
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342102,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342103
					]
				},
				{
					"id": 413342103,
					"content": "お嬢様の願いが叶いますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342104
					],
					"speakerTitle": "鑑秋"
				},
				{
