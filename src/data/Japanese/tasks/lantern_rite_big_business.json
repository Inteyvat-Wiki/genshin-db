				{
					"id": 413342701,
					"content": "旅人さん、申し訳ないのですが…山の上まで護衛してくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342702,
						413342703
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342702,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342704
					]
				},
				{
					"id": 413342704,
					"content": "少々用事がありまして…今は帰れません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342705
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342705,
					"content": "では護衛をお願いします。今すぐ出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342706
					],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342706,
					"content": "霄灯を飛ばしたら…すぐに先を急がなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鑑秋"
				},
				{
					"id": 413342703,
					"content": "なんで城内に帰らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342704
					]
				}
			]
		},
