					"路通",
					"ガルシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "先生、今回こそは本当に心からのご提案です。何とかしてお金を払いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140102,
					"content": "あの商人どもはまるで強盗だ！なぜたった数個の鴉マークがあんなに高いんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140103,
					"content": "それは、先生がそれらを見た時、両目をギラギラと光らせていたのに気づいたからかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140104,
					"content": "鴉マークをどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "旅人くん！君はいつもいいところに来てくれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140106,
					"content": "前回は大変世話になった。おかげで、一応実用的な潤滑剤を作ることができたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140107,
					"content": "しかし、すぐに別の問題が見つかってね。いくつかの部品を再生産している時に気づいたんだが…その材料があまり硬すぎると、他の部品を傷つけやすくなってしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140108,
					"content": "それに、その硬すぎる部品はわずかな衝撃を受けただけで、程度の差こそあれ割れてしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140109,
					"content": "ゆえに、一定の硬度を持ちながら、一定の柔らかさも持ち合わせる素材を探し始めたというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140110,
					"content": "俺のたゆまぬ研究と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140111,
					"content": "…アハンガルさんへの度重なる嫌がらせの結果、ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140112,
					"content": "俺は宝盗団が持っているその…鴉マークが、まさに探している材料かもしれないと気づいたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140113,
					"content": "しかし…あの商人どもはまるで宝盗団のように欲深く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140114,
					"content": "#また{M#俺}{F#私}の出番というわけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "ありがとう！俺は君の名前を「ナンバリングマシン」のメインベアリングに刻もう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140115,
					"content": "探してあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
