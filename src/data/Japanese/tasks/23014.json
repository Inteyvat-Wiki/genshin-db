			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "うぅ…路通くん、俺を支えてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145502,
					"content": "先生、一旦帰って寝ましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145503,
					"content": "旅人さん、ちょうどいいところに来ました！あなたに手伝ってほしいことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145504,
					"content": "彼はどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "簡単に言えば…ガルシア先生はコーヒーを飲み過ぎて、寝不足なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145506,
					"content": "ですが幸い、口にしたのはコーヒーだけです。お酒は飲んでいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145507,
					"content": "路通、うぅ…お、俺たちはその鴉マークをあと何枚か手に入れないと…宝盗団が持ってたやつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145508,
					"content": "旅人くんじゃないか！どうしてここに？すまん、さっきは君のことに気が付かなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145509,
					"content": "そのような鴉マークを何枚か持ってきてくれるか？ほんの少しでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145510,
					"content": "戻ってしっかり休憩しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "大丈夫大丈夫、俺は平気だ。頭はよく回っている…手が少し動かないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145514,
					"content": "とにかく、何枚か鴉マークを持ってきてくれますか？報酬はちゃんと用意しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145515,
					"content": "持って来たら…俺に渡してくれればいい。よく観察して、今度こそベアリングを作る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145512,
					"content": "コーヒーでそこまでなるもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "コーヒーのせいにはできません。寝ることを拒んでいるガルシア先生が原因です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "路通"
