			"dialogs": [
				{
					"id": 230140301,
					"content": "本当にありがとう、旅人くん。これだけの鴉マークがあれば十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140302,
					"content": "まずは歯車を再生産して…いや、違うな。まずはベアリング問題の検討からか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230140303,
					"content": "こちらが報酬です、旅人さん。どうぞお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140304,
					"content": "現在の状況から見ると、まだまだ長いお付き合いになりそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230140305,
					"content": "ああ、ガルシア先生の帳簿を整理するのは本当に大変だ…",
