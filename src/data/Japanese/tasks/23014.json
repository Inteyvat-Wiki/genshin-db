			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "やはりお金を稼ぐ方法を見つけないとダメですよ、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145002,
					"content": "スメールシティにはシアターがあって、そこには計算の作業が必要な劇団がたくさんあると聞きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145003,
					"content": "そして、そこの劇団員たちは…お分かりとは思いますが、お金はたくさん稼いでいるものの、帳簿をどう管理したらいいか分かっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145004,
					"content": "これはチャンスですよ、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230145005,
					"content": "君の経理と商売の才能に打ち震えているよ、親愛なる路通くん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230145006,
					"content": "ちょっと待て、ちょっと待ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		},
