			"dialogs": [
				{
					"id": 747090101,
					"content": "旅人、パイモンちゃん、お疲れ様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090102,
					"content": "病気のお魚たちの症状はもうだいたい分かったのよ。メリュジーヌの秘伝のお薬も調合できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090103,
					"content": "この特別なお薬を水槽に混ぜれば、みんなを落ち着かせてあげられるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090104,
					"content": "つまり、水槽が丸ごと治療所になるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747090105,
					"content": "へへ…シグウィンだからこそ出来たことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747090106,
					"content": "これって一時的に病状を和らげるだけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "そうね、いろいろな特性を持ったお魚たちにウチのところで「健康診断」を受けてもらわないと、原因は突き止められそうにないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090109,
					"content": "これから、お魚たちの特性に合わせて、患者さんをリストアップしてみるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090110,
					"content": "その子たちを気にかけてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747090107,
					"content": "根本的解決のためには原因を解明しないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
	]
