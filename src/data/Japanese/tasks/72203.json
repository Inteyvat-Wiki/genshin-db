			"dialogs": [
				{
					"id": 722030501,
					"content": "あははっ、また見つかっちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "ノンノ"
				},
				{
					"id": 722030502,
					"content": "あのね、名残惜しいけど…今回はお別れを言いに来たの。金色のおじさんがもう行かなきゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "ノンノ"
				},
				{
					"id": 722030503,
					"content": "でも心配しないで。今から行く場所にはたくさんの人がいるから、みんな遊んでくれる！君も来てくれたらいいのにな…でも金色のおじさんが、まだその時じゃないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "ノンノ"
				},
				{
					"id": 722030504,
					"content": "大丈夫、大丈夫だよ！私、待ってるから。もし待ちきれなかったら、輝く光になって、君の夢の中に行くよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "ノンノ"
				},
				{
					"id": 722030505,
					"content": "いってらっしゃい、気をつけてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "うん。君との遊び、とても楽しかった。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "ノンノ"
				},
				{
					"id": 722030507,
					"content": "もう一人じゃない、よかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ノンノ"
				}
