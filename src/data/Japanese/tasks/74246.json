			},
			"dialogs": [
				{
					"id": 742460101,
					"content": "お客様、霄灯の部品が仕上がりました。防水加工もばっちりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460102
					],
					"speakerTitle": "豊泰"
				},
				{
					"id": 742460102,
					"content": "油紙で五、六層にも包んでありますから、たとえ水に七、八日浸けたって問題ありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460103
					],
					"speakerTitle": "豊泰"
				},
				{
					"id": 742460103,
					"content": "苦労をかけたな、追加料金も請求してくれ。時季外れにすまなかった…仕入れに苦労しただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460104
					],
					"speakerTitle": "ヌヴィレット"
				},
				{
					"id": 742460104,
					"content": "いやいや、お安い御用ですよ。お客様のお困りごとに応えるのが商売なんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460105
					],
					"speakerTitle": "豊泰"
				},
				{
					"id": 742460105,
					"content": "そういえば、前回お買い上げいただいたお茶はお口に合いましたか？沈玉仙茶がちょうど入荷したばかりですがご覧になりますか？炒りたての、上質な品——お安くしますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460106
					],
					"speakerTitle": "豊泰"
				},
				{
					"id": 742460106,
					"content": "そうか、そこまで言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌヴィレット"
				}
			]
		},
