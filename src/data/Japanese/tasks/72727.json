					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "よっ！そこの異郷の武者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270102,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "ああ、また会えてうれしいぜ！君の姿は、相変わらずまぶしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270106,
					"content": "…コホン。とにかくここ数日、また何者かが「百人一揆」を秘密裏に開催している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270107,
					"content": "「百人一揆」ってなんだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "「百人一揆」は、元々「天狗党人」たちが開催した祭典だった。痛快な戦いを通して、記念すべきことをお祝いしたり、嫌な気持ちを吹き飛ばしたりするのが目的だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270109,
					"content": "祭典では、武者や魔物といった偏見を捨てて、身分を問わず、ただ熱い戦いを楽しむことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270110,
					"content": "そして祭典で勝利した武者は、様々な財宝を手に入れることができる、と言われている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270111,
					"content": "…それはそうと、「天狗党」が取り締まられた今、誰が、どこで祭典を開催しているのか、勝者の賞品がどこから来たものかも、俺には分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270115,
					"content": "とにかく、ここは人目が多い。じっくりと話ができないから、前と同じように俺についてきてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270116,
					"content": "茅葺一慶はあなたを稲妻城外の島へと連れて行った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "…また？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "ああ、大勢の人が君の戦う雄姿に憧れ、観衆たちまでもが熱くなった。自ら祭典に参加して、自分の腕を試したい人も出てきているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270114,
					"content": "実はこんなに早く、今回の「百人一揆」が開催されるとは思わってなかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 727270104,
					"content": "…誰だっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "もう忘れたのか？…ああ、すまん。前回の「百人一揆」の時は戦闘の記録ばっかり取ってたからな、君へ歓声を送れなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "茅葺一慶"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
