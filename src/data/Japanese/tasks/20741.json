					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 207411002,
					"content": "手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "これで十分ね、ここで少し待ってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 207411004,
					"content": "…バルバトス様、聞いてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 207411005,
					"content": "わぁ…あんなに話して、シスターは敬虔だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 207411006,
					"content": "…「吟遊野郎」はちゃんと聞いてるといいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 207411007,
					"content": "さて、この蒲公英の種を神像の上で撒いてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 207411008,
					"content": "本当は私が行くべきだけど…私の身体能力だと、登れたとしても降りることは難しいと思うわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 207411009,
					"content": "だからお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
		},
