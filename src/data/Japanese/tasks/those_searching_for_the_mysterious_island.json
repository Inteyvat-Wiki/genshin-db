			"dialogs": [
				{
					"id": 150050201,
					"content": "ここって本当にいい景色だよな。時々コホラ竜も見れるしさ。なあなあ、記念に野生のコホラ竜と写真を撮らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050202,
					"content": "噛まれたらどうしよう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "コホラ竜はけっこう可愛いやつだと思うけど…それは…まあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050204,
					"content": "ん？なんだあれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050205,
					"content": "助けて！誰か助けて…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050206,
					"content": "ひぃ、野生のコホラ竜が本当に人を噛んでるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050207,
					"content": "助けてあげないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "おう。危ない目に遭ってる人たちを、オイラと旅人は見捨てたりしないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050209,
					"content": "記念写真は後回しだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "だな、そんな話をしてる場合じゃないみたいだ。助けを呼んでる人がいる以上、見捨てるわけにはいかないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
