			"dialogs": [
				{
					"id": 150050101,
					"content": "コホラ竜たちは逃げていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "その格好…もしかしてスメールから来た学者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050103,
					"content": "はい、カーリャと申します。こちらはヴィランドラさんです。危ないところを助けていただき本当にありがとうございました…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050104,
					"content": "お礼なんかいいぞ、このくらいお安い御用だからな。オイラはパイモン、こいつは旅人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050105,
					"content": "はぁ…コホラ竜たちがみんな逃げてしまった。せめて一匹だけでも生け捕りできていれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050106,
					"content": "生け捕り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050107,
					"content": "君たち、それなりの腕の持ち主のようだな。僕がおとりになるから、コホラ竜が来たら、一匹でいいから生け捕りにしてくれないか！もちろん報酬はちゃんと払う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050108,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050109,
					"content": "申し訳ありません。ヴィランドラ先輩は研究のことになると熱くなってしまうんです…どうかお気になさらずに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050110,
					"content": "気にしないでいいぞ！それで、どうして野生のコホラ竜にちょっかいかけてたんだ？それに生け捕りだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050111,
					"content": "#{M#君}{F#あなた}たちも記念写真を撮りたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "そんなんじゃないに決まってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050113,
					"content": "お見苦しいところをお見せしてしまいましたね…実は私たち、伝説の「神秘の島」を探しているんです。重要な手がかりがコホラ竜にあると風の噂で耳にしまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050114,
					"content": "「流泉の衆」のガイドもいないのに、コホラ竜に接触するのはやはり無謀でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050115,
					"content": "神秘の島…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050116,
					"content": "ええ。「流泉の衆」の伝説には、ある謎の島が出てくるんです。先輩は自分の研究目標がその島にあると信じていらっしゃるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050117,
					"content": "コホン…というわけだ。さっきの件、もう一度検討してみてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050118,
					"content": "さっきの件って…人間をおとりにするなんて真似、絶対にやらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050119,
					"content": "そうか。ならこれ以上話を続けても時間の無駄だな。他の方法を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050120,
					"content": "先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050121,
					"content": "わかったわかった…さっきは確かに助けてもらった。感情からしても理屈からしても、ここは礼を言うべきだと思う…本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050122,
					"content": "素直じゃないやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050123,
					"content": "カーリャ、そろそろ行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "ヴィランドラ"
				},
				{
					"id": 150050124,
					"content": "本当に申し訳ありません。ヴィランドラ先輩は人付き合いに疎くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "カーリャ"
				},
				{
					"id": 150050125,
					"content": "気にしないでいいぞ。じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050126,
					"content": "あんな二人がチームを組んで冒険してるだなんて、不思議だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050127,
					"content": "それにしても…あのお姉さんが言ってた「神秘の島」が気になるんだよなあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050128,
					"content": "パイモンもそこに行きたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "だって、もしかしたらお宝があるかもしれないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050130,
					"content": "今まであれだけ不思議な場所を探索してきたんだし、神秘の島とやらを見つけるのだって楽勝だと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050131,
					"content": "でも、何の情報もないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "それもそうだな…あっ、でもさっきのお姉さんが、神秘の島は「流泉の衆」の伝説に出てくる島だって言ってたよな。部族のやつらに聞いてみるのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050133,
					"content": "善は急げだ。さっそく次の冒険を始めようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050134,
					"content": "聞こうって決めたはいいけど…誰に聞けばいいんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150050135,
					"content": "族長に直接聞くのもいいかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "うーん…確かに、神秘の島は「流泉の衆」の伝説と関係してるって、あのお姉さん言ってたしな。「流泉の衆」の族長ならきっとなにか知ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
