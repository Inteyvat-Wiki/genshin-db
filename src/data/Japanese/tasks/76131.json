					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310403,
					"content": "龍族の技術は本当にすごいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310404
					]
				},
				{
					"id": 761310404,
					"content": "下手に触らないほうがよさそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310405
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310405,
					"content": "本当にそう思ってるのか？おまえがいれば、広い基地でも隅から隅まで調べられると思ってたんだけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310406,
					"content": "宇宙船に乗った時みたいにならないか、不安じゃないの？あの時、危うく爆発に巻き込まれそうだったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310407
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310407,
					"content": "うっ…嫌なことを思い出させるなよな！なんで基地に自爆システムなんてものがあるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310408,
					"content": "はぁ…いつもみたいにこっそり忍び込むしかないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310409,
					"content": "うん、私も中に何があるのかすごく気になる。自分の「家」に潜入する感覚って、なかなか新鮮だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310410
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310410,
					"content": "それにここに立ってると、あの不思議な懐かしさをより強く感じるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
				}
			]
		},
