			"dialogs": [
				{
					"id": 761310701,
					"content": "ん？これ、まだ使えるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310702,
					"content": "なにか情報があるかもしれないな、開けて見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310703,
					"content": "これが、星海生物が龍族に伝えたメッセージなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310704,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310705
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310705,
					"content": "つまり、観月者計画ってのは、こういうメッセージをもう一度宇宙に送るってことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310706,
					"content": "それだけなら、あの「イビニベルンの目」を使えばできるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310707,
					"content": "もしかして、まだなにか見落としてる内容があるかもな…もう一回確認してみるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310708,
					"content": "おお！やっぱり最後に追記があったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310709,
					"content": "「『私の娘』、ニンニンへ」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310710,
					"content": "ニンニン！？ちょっと待ってくれ…クロタマゴはルシャリムの娘だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310711,
					"content": "じゃあ、なんでおまえまでそんな姿になっちゃったんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310712,
					"content": "どうして…わからない…私にはそんな記憶、ないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310713
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310713,
					"content": "月心に行ってみないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310714
					]
				},
				{
					"id": 761310714,
					"content": "そ、それじゃあコロンビーナはどうするんだ？まだあいつがいなくなった手がかりは見つかってないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310715,
					"content": "彼女が消えた理由も月心に関係してるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310716
					]
				},
				{
					"id": 761310716,
					"content": "そうか、あいつが言ってた懐かしい感じって、月心のことなんだな…よし、急ごう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
