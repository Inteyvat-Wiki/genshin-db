			"dialogs": [
				{
					"id": 761310501,
					"content": "あれっ？重力が元に戻ったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310502,
					"content": "あっ、コロンビーナ！戻ってきたんだな！さっきのは、おまえが解決してくれたのか？本当に助かったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310503,
					"content": "オイラたち、すっごく心配したんだぞ！どこに行ってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310504,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310505
					]
				},
				{
					"id": 761310505,
					"content": "ごめんね。この基地が月心に繋がってるなんて、思わなかった…あそこには、とても濃い古月の力が凝縮されてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310506
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310506,
					"content": "前にクーヴァキでこの基地に浸透した時、うっかりそれに触れちゃって…そのまま、あの力に月心へと引き込まれちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310507
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310507,
					"content": "やっぱり月心に行ってたんだな…オイラ、てっきり幽霊が出て悪さをしたのかと思ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310508,
					"content": "とにかく、無事で本当によかったぜ！さっき観月者計画の新しい手がかりを見つけたんだ。実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310509,
					"content": "パイモン、私、もう月心で真実を知ったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310510
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310510,
					"content": "ニンニン、キミが誰なのかも分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310511
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310511,
					"content": "私の使命はそこにあるんだね…連れて行ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310512
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310512,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310513
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310513,
					"content": "どうしたんだ？ニンニンを連れて行きたくないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310514,
					"content": "ニンニンは…月心の環境じゃ、生きられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310515
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310515,
					"content": "でも、私は使命を果たさなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310516
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310516,
					"content": "キミの使命は、そこにはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310517
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310517,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310518
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310518,
					"content": "うん、キミの使命は月心にはない。使命は最初の場所にあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310519
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310519,
					"content": "それって…「イビニベルンの目」のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310520,
					"content": "そう。キミの使命は、「イビニベルンの目」の観月者計画を起動させること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310521
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310521,
					"content": "それには古月の力で構成された情報の鍵が必要。私がもう一度月心に行って、取ってきてあげるよ。でも、少し時間がかかるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310522
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310522,
					"content": "…「イビニベルンの目」に戻って待ってて…ってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310523
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310523,
					"content": "それでいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310524
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310524,
					"content": "ううん、自分で鍵を取りに行けないなら…ここであなたを待ちたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310525
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310525,
					"content": "あなたが戻ってくるまで…私はここを離れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310526
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310526,
					"content": "ここで…友達が戻るのを待ってたいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310527
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310527,
					"content": "分かった。ありがとう、ニンニン。すぐ戻ってくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310528
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310528,
					"content": "#コロンビーナ、{M#俺}{F#私}も一緒に行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310529
					]
				},
				{
					"id": 761310529,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310530
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310530,
					"content": "じゃ、じゃあクロタマゴはどうするんだ？あいつ一人、ここに置いていくのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310531,
					"content": "心配しないで。マーゴを呼んだから。今、こっちに向かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310532
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310532,
					"content": "ここで待つだけなら、この基地に他の危険はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310533
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310533,
					"content": "でも…やっぱりちょっと心配だな。いっそ、オイラが残ってあいつと一緒にいてやろうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310534,
					"content": "え？パイモンは月心の様子が気にならないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310535
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 761310535,
					"content": "一人っきりだとクロタマゴが寂しがると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310536,
					"content": "あいつはあのルシャリムの娘で…さっきそのことを知ったばっかりだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310537,
					"content": "こういう話は、きっと考えを整理する時間が必要だろ？万が一思い詰めて、危険な場所に行っちゃったら大変だしさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310538,
					"content": "だから、やっぱりオイラはここであいつと一緒に、マーゴが来るのを待つことにするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310539,
					"content": "おまえたちが中でなにを見たか、後で教えてくれればそれで十分だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310540,
					"content": "ありがとう、パイモン。あなたにはもう少し敬意を払ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310541
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761310541,
					"content": "じゃあ、オイラもおまえにもう少し多くお菓子を分けてやろうかな！これでおまえが三、オイラが七だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310542
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310542,
					"content": "今回のパイモンはお姉さんみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310543
					]
				},
				{
					"id": 761310543,
					"content": "へへっ、そりゃそうだろ？オイラは、クロタマゴが大きくなるのをずっと見守ってきたんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310544
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310544,
					"content": "ほら、早く行ってこいよ。さっと行って、さっと帰ってくるんだぞ。あんまり待たせないでくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310545
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761310545,
					"content": "うん。じゃあ旅人、ついてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
				}
			]
		},
