			"dialogs": [
				{
					"id": 750280101,
					"content": "ちっ、厄介なやつに出くわしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "ネズミ"
				},
				{
					"id": 750280102,
					"content": "くぅ…今日は一体なんて日だ？人に恨まれるようなことしてないのに、こんなにボコボコにされるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "夜更かし"
				},
				{
					"id": 750280103,
					"content": "#{M#兄貴}{F#姉御}、教えてくださいよ。俺が何をしたっていうんですか。言ってくれたら、ちゃんと直しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "夜更かし"
				},
				{
					"id": 750280104,
					"content": "おい！このやろう、こんな凶悪なやつにペコペコしやがって、少しは根性見せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "ネズミ"
				},
				{
					"id": 750280105,
					"content": "根性？根性で飯が食えるのか？もうはっきりわかった。お前とつるんでいたら、結局は泥棒や盗賊みたいなことをする羽目になるだけだ。竜の密売なんて、しなきゃよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "夜更かし"
				},
				{
					"id": 750280106,
					"content": "#どうせこんなことになるんなら、こっちの{M#兄貴}{F#姉御}とつるんだほうがマシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "夜更かし"
				},
				{
					"id": 750280107,
					"content": "#{M#兄貴}{F#姉御}、自慢じゃないけど、俺のほうがお連れのあの二人よりずっと器用ですよ。何か用があれば、何でも言ってください。きっちりとこなしてみせやすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "夜更かし"
				},
				{
					"id": 750280108,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "ちょうど子分がほしかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "まさか、本当に連れて行く気か？ダメダメ！オイラは反対だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750280112,
					"content": "#それに、おまえらは悪党だろ！オイラたちは正義の味方だから、竜の密売人なんかと組んだりしないぞ！なっ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750280113,
					"content": "#{M#俺}{F#私}以上に正義感がある人はいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#うぅ…とにかく、竜には手を出すなよ。じゃないとオイラたちが…{NICKNAME}が思い知らせてやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750280118,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "二人の竜の密売人は不機嫌そうに去っていった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "あのクク竜の状況がどうなってるか、見に行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750280114,
					"content": "そうとは限らない。交渉の余地はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#そんなこと言ったら、{REALNAME[ID(2)|SHOWHOST(true)]}に悪影響だろ！{REALNAME[ID(2)|SHOWHOST(true)]}、安心しろ。オイラたちは竜の密売人なんかと組んだりしないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750280116,
					"content": "キュウ…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "好意はありがたいけど、遠慮しとくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
