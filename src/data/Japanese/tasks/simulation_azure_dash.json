				"points": []
			},
			"dialogs": [
				{
					"id": 745030101,
					"content": "お二人さん、また会ったな。ちょっとしか経ってないのに、もう君たちに会いたくなってたところやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030102,
					"content": "おまえってやつは、ホントにゴマすりがうまいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745030103,
					"content": "嫌われたか、悲しいな。やっぱり仕事に専念しよか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030104,
					"content": "まず、今回のデータ収集は大きく二つに分かれてて、俺とアルベールがそれぞれ一つずつ担当してるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030105,
					"content": "俺が担当してるデータ収集は、決闘代理人の柔軟性をシミュレートするためのものや。君には水中でのダッシュシミュレーションにトライしてほしいんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030106,
					"content": "ってことは、決闘代理人って水中で訓練してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745030107,
					"content": "さあ？俺は決闘代理人を見たことないからな。たぶん店主も見たことないと思うけど、そのほうがカッコいいやろ？って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030108,
					"content": "元々はおもちゃのアームの中に十種類の水鉄砲を組み込んで、シュッシュッシュ～って水を発射させたかったらしいけど、コストが高すぎて諦めたそうやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030109,
					"content": "確かにカッコいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "フォンテーヌは水の国やからな。外国に広く売り込むなら、フォンテーヌの特徴を活かしたほうがいいやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030112,
					"content": "とにかく、具体的な注意点についてはハンドブックを用意したから、後で読んでみてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030113,
					"content": "どうや？今にも始めたくてうずうずしてきたやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030114,
					"content": "少し準備する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "問題ないで。データ収集の機器はすでに設置済やから、心配いらん。君たちは挑戦をクリアすることにだけ集中すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745030110,
					"content": "カッコいいと思うのは子供だけでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}