			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "また会ったな、きょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752475102,
					"content": "実はさっき「初めてイファにあった日はその日じゃない」って言いたかったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752475103,
					"content": "でも、それはやっぱり腹の中にとどめておくことにしたぜ。なにせ、俺は空気の読める大人だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カクーク"
				}
			]
		}
	]
}