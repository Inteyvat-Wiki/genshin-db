			"dialogs": [
				{
					"id": 752470101,
					"content": "写真に載ってたのはここみたいだな。あっ、二人ともいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470102,
					"content": "やっほー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470103,
					"content": "声のトーンからして、パイモンは「喜んでいる」な。警戒しなくてよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470104,
					"content": "怒ってても警戒しなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "このーっ！オイラをなめるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470106,
					"content": "美味しいものを渡しておけば大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "ふん、分かればいいんだ…って、オイラの扱いがカクークと同じになってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470108,
					"content": "まぁ、今日のパイモンは「喜んでいる」パイモンだから、細かいことは気にしないでおいてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470109,
					"content": "そういえば、カクークはどうしたんだ？カピバラキングに食べられたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470110,
					"content": "そんなわけないだろ、きょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470111,
					"content": "カクークが敵と手を組んで、僕たちをいじめてくるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470112,
					"content": "カクークが「いじめる」？へへっ、またそんな冗談言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470113,
					"content": "冗談じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470114,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470115,
					"content": "敵、って…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "そいつは「カクーシャ」と名乗ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470117,
					"content": "カクーシャ？本当か？アシャが喋ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470118,
					"content": "ストップ。そいつのデタラメを聞くな。俺が説明する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470119,
					"content": "カクークは…えーっと、ここのアシャとかくれんぼをしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470120,
					"content": "正確に言うと、「カクーシャ」と同盟を組んで僕たちと対抗してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470121,
					"content": "カクークは素早いし、「カクーシャ」は変装が得意だから、かなり手強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470122,
					"content": "あんたらが現れる前から、ずっとこいつらに付き合わされてたんだ。もう何周目のかくれんぼかわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470123,
					"content": "カクークは確かにすごい。だが、俺がそんなカクークを「誇りに思ってた」のは最初だけだ。もうそんな元気、どっかいっちまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470124,
					"content": "イアンサのトレーニングを受けないのが悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470125,
					"content": "はぁ…ずっと探し回ってたから、腰が痛くて痛くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470126,
					"content": "それもイアンサのトレーニングを受けないのが悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470127,
					"content": "…はいはい、ここの仕事が終わったら行くって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470128,
					"content": "まあまあ。で、結局今は誰がカクークと「カクーシャ」を捕まえる番なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470129,
					"content": "それは…目の前にいる、長くないものにも巻かれてくれると評判の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470130,
					"content": "#…また{M#俺}{F#私}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470132,
					"content": "しょうがないなぁ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#{M#じいちゃん}{F#ばあちゃん}ならきっといける。パイモンばあちゃんも活躍できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470134,
					"content": "無理するなよ。助けがいるときはいつでも声をかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470135,
					"content": "えっ、僕たちがアシャ役をやるわけじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470136,
					"content": "アシャ役って…まさか、おまえまで一緒に隠れて、オイラたちに探させるつもりだったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470137,
					"content": "ああ！今から僕がオロシャで、こっちがイファシャだ。がんばって見つけてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470138,
					"content": "おい、ちょっと…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470139,
					"content": "悪いな…付き合ってやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470140,
					"content": "いいよ、面白そうだし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "ありがたい…じゃあ、頼むぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イファ"
				},
				{
					"id": 752470141,
					"content": "#大丈夫、{M#俺}{F#私}は元気だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
