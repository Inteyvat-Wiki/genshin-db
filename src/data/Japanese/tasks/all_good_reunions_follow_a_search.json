					"nextDialogs": [
						752470407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470407,
					"content": "へへっ、まだ運が残ってるかどうかわからないけど、やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470408,
					"content": "ああ、やってみな！エッグの用意もできてるよ。",
