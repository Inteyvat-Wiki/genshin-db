			"dialogs": [
				{
					"id": 752470301,
					"content": "ふぅ～…終わった。大変だったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "「カクーシャ」"
				},
				{
					"id": 752470303,
					"content": "カクーシャだっけか？おまえもカクークも本当にすごいな。ライバルとして認めてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752470304,
					"content": "すごいな、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752470305,
					"content": "ほら、言った通りだ。この二人が手を組んだら厄介だっただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470306,
					"content": "カクーク、君には「隠れ身の術」の修了書を渡そう。これで君も晴れて一人前の詐欺師だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752470307,
					"content": "マジかよ、きょうだい！最高だな、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
