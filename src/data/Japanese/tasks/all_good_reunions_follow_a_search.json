			"dialogs": [
				{
					"id": 752475001,
					"content": "どうだ？楽しめたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752475002,
					"content": "マジかよ、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752475003,
					"content": "楽しんでるみたいだな。誕生日おめでとう、きょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752475004,
					"content": "ところで、なんでこの計画を僕に黙ってたんだ？僕たちきょうだいじゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752475005,
					"content": "へへっ…実はお前がこの日を覚えてるか、試したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752475006,
					"content": "…イファ、君は変わったな。ずるくなった。今後は君を警戒しなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752475007,
					"content": "心配しなくても覚えてる。新鮮な蜜を用意しておいてよかった…さもないと一年間カクークに頭をついばまれ続けるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752475008,
					"content": "そんなことしないぞ、きょうだい！やっぱ最高だな、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カクーク"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
