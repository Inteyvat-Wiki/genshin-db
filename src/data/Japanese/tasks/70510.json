			"dialogs": [
				{
					"id": 705100401,
					"content": "いやはや…ここ数日、酒場がかなり繁盛していたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100402,
					"content": "お酒目当てで来ていた人もいれば、君のことが目当てだった人もいたとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100403,
					"content": "ん？なんか…引っかかる言い方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705100404,
					"content": "こんなに成功した「バーテンダー体験ウィーク」は初めてです！商売も上手くいき、評判も上々。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100405,
					"content": "とにかく…よくやってくれました、相棒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100406,
					"content": "たった数日で「相棒」になってる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705100407,
					"content": "ある意味では…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "ですので、この先もここに残って続けてみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100410,
					"content": "だめだめ。飲み放題は魅力的だけど、オイラとこいつは一緒に旅をするって約束したんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705100411,
					"content": "そうですよね。いえ、大丈夫です。チャールズさんにも無理だろうと言われていたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100412,
					"content": "ただ、また機会があれば「エンジェルズシェア」にいらしてください。その時はぜひお友達も一緒に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100413,
					"content": "うん、また来るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "それではまた会いましょう。お気をつけて、よい旅になるよう祈っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルカ"
				},
				{
					"id": 705100408,
					"content": "彼の言う通りではあるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
