				]
			},
			"dialogs": [
				{
					"id": 715360101,
					"content": "旅人さん？海灯祭を祝して。ディシアの祝灯状作りを手伝ってくれたそうですね。とても綺麗でした——ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360102,
					"content": "村の方はもう大丈夫なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "ええ、ディシアたちのおかげで、今は私の代わりに村を守ってくれている人々がいるので、少しは安心です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360104,
					"content": "今はしっかり休んでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "はい、そうします。ディシアはもう何日かしたら「翹英荘」に行ってみたいそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360106,
					"content": "景色が素敵で、お茶の名産地だから、村の人たちへのお土産にちょうどいい、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360107,
					"content": "私も璃月の伝統に従って祝灯状を何枚か作って、プレゼントと共に贈ろうと思っていたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360108,
					"content": "ディシアがぎゅうぎゅうにスケジュールを詰め込んで、あちこち走り回っていたものですから、なかなか作る暇がなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360109,
					"content": "ディシアも言っていましたが、旅人さんは祝灯状を作るのが得意なのでしょう？教えてくださいませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360110,
					"content": "うん、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
