			"dialogs": [
				{
					"id": 715360301,
					"content": "なるほど…素敵な祝灯状です。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360302,
					"content": "教えていただいた通りに、もう何枚か作ってみます。お土産と一緒に村人にあげたら、きっとみんな喜ぶでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 715360303,
					"content": "あなたの作ってくださった祝灯状は、大切に保管しておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャンディス"
