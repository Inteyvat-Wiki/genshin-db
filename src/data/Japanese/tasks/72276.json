						722761202
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761202,
					"content": "また会ったね。名前はなんだっけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "矢部だよ矢部！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761204,
					"content": "まったく、人の名前ぐらいちゃんと覚えてよ。それに依頼の件、まさか忘れたりしてないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761205,
					"content": "コイツは冗談を言ってるだけだ。オイラたち、もう文谷秘宝の真相を突き止めたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722761206,
					"content": "矢部にこれまでの経緯を詳しく話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "つまり、陽炎幻法と宝の密室は本当のことだったのか。でも途中で他の事件が起きたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761208,
					"content": "怨霊のことも確かで、人の心を支配できるなんて。うわぁ、おっかないね。ついて行かなくて良かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761209,
					"content": "#{M#俺}{F#私}たちを心配してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "うん。ボコボコにされないか心配だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761211,
					"content": "とにかく、満足したと同時にちょっとした心残りもできた。たしかに奇妙だけど、全て元素力で解釈できる。なんだかすっきりしないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761212,
					"content": "おかげで文谷の謎がやっと解けたよ。早く世の中に知らしめないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
