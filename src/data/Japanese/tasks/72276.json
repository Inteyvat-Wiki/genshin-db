			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"矢部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#やあ、君は{NICKNAME}っていう名前だったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760102,
					"content": "僕のことは覚えてるかい？矢部だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760103,
					"content": "こんにちは、矢部。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "おう、よろしくな。えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760105,
					"content": "君ってかなり凄いんでしょ。雷電将軍に正面から立ち向かったり、淵下宮を探索したりするほどだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760106,
					"content": "まあそうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "あははっ、よかった。ちょうど宝物の手がかり持ってるんだ。危険かもしれないけど、どう、興味ある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760108,
					"content": "怪談とかは割りと好きなんだけど、僕は自分の命を大切にするタイプでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760109,
					"content": "興味ある、詳しく教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "以前大日御輿で見回りしてたら、これを見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760111,
					"content": "ただの石板にしか見えないけど、僕はこれが「文谷秘宝」に繋がる手がかりだと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760112,
					"content": "文谷秘宝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "白夜国の歴史は海祇島ではあまり広く伝わっていないから、僕にもよく分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760114,
					"content": "文谷は二代目宰相で、「太陽の子」と共に暴政で金を集めたという噂がある。その後、宝物を大日神輿の秘密部屋に隠したらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760115,
					"content": "そして彼は陽炎幻法を使って宝物を隠し、地脈に埋もれた穢鬼を呼び出して宝を見張らせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760116,
					"content": "文谷も恐らく、タイなんとかテスみたいな、古代の名前を持っていた。しかし、卑しき者と佞臣の物語は詳しく記録されていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760117,
					"content": "石板の話に戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "この石板は文谷宝物庫を開ける鍵になるはず。僕は怪談や噂話、奇妙な案件を長い間研究してきたから——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760119,
					"content": "この石板にある…えっと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760120,
					"content": "率直に言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "実は大日御輿の倉庫でこの石板を見つけた時、隣に二つの言語で書かれた紙があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760122,
					"content": "過渡期に書かれた文書は、すべて二つの言語で登録されていたようだ。そして説明には、この石板が「文谷事案」と直接関係していることが書かれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760123,
					"content": "石板は全部で8個あって、これまでにこの1個しか回収されていないことも説明に書かれている。そして、近くの場所に文谷密室があるとも記録されているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760124,
					"content": "代わりに確認してきてよ。お宝なんてどうでもいいんだけど、「文谷事案」の結末は見届けたいからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
		},
