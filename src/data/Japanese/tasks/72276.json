			},
			"dialogs": [
				{
					"id": 722761001,
					"content": "そ…そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761002,
					"content": "なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722761003,
					"content": "私が自分の友達に手を出すとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761004,
					"content": "きっと文谷が出した怨霊が私に取り憑いて、私の心を支配したのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761005,
					"content": "これしきの秘宝、彼との友情と比べれば大したことない。財宝のために悪事を働く、それだけは決してしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761006,
					"content": "彼は私をとても信頼していた。文谷の宝を発見したら私に告げると言ってくれた…私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761007,
					"content": "私はそのような人間ではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761008,
					"content": "えっ、つまり最後の欠片が真相を隠したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722761009,
					"content": "彼を一人にさせてあげよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722761011,
					"content": "戻ってこのことを矢部に話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
