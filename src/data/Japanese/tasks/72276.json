					"nextDialogs": [
						722760807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722760807,
					"content": "ふん、ならばさっさと去れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722760808,
					"content": "（オイラたちよりも先に、誰かが来てたみたいだぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722760809,
					"content": "（秘法はもうそいつらに持ってかれたのかも？）",
