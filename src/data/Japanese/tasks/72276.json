					"nextDialogs": [
						722760414
					]
				},
				{
					"id": 722760414,
					"content": "諦めるの早すぎるだろ！矢部に聞いてみた方がいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722760415,
					"content": "石板が八枚って記載されてるから、他にも手がかりはあると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760416
					],
					"speakerTitle": "パイモン"
