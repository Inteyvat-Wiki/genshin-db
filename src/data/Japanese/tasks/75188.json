				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パカリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "三匹とも戻ってきた。お前のおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880402,
					"content": "ありがとな、通りすがりの冒険者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880403,
					"content": "背中はまだ痛ぇけど、コイツらが傍にいれば随分マシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880404,
					"content": "オレは金持ちじゃねぇが、礼くらいはちゃんとする。ほらよ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パカリン"
				}
			]
		}
	]
}