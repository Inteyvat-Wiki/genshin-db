			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パカリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "ちょっと頼みがあるんだ。畑にいるうちの<color=#00E1FFFF>三匹の仔竜</color>を探して、オレのとこに連れてきてくれねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パカリン"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パカリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "ああ、そうだ、そこのお前のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880202,
					"content": "軽やかな足取りに、力もありそうだ。普段から鍛えてるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880203,
					"content": "お前、「豊穣の邦」の勇士か？それとも別の部族の出身か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880204,
					"content": "通りすがりの冒険者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "そうか、残念だ。まぁそうだよな、ちょうど人手が足りねぇって時に助っ人が現れるなんて、そんな都合のいい話あるわけねぇよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880207,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "見ての通り、ここに農場があるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880209,
					"content": "長らく一人で管理してきたんだが、最近ちょっとツイてなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880210,
					"content": "数日前、部族の勇士とレスリングをして、背中を痛めちまったんだ…わかってる、バカなことしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880211,
					"content": "親父の新しい畑を手伝うどころか、自分の農場の世話すらできねぇ始末で…はぁ、正直歩くのもキツいくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880212,
					"content": "で、数日だけでも手伝ってくれそうなヤツがいねえかと考えてた時に、ちょうどお前が現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880213,
					"content": "だが、お前は通りすがりの冒険者だ。畑仕事は毎日やらねぇといけねぇし、今日だけ乗り切ったところでどのみち荒れちまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880214,
					"content": "まぁ、今のオレじゃ部族のとこまで行くこともできねぇから、どのみち飼ってるライノ竜たちしか頼れねぇけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880215,
					"content": "それなのに…はぁ、いたずら好きで反抗的な奴らでな。三匹とも畑に居座ったまま、全然オレのとこに戻ってこねぇんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880216,
					"content": "だから、ちょっと頼まれてくれねぇか？こんな状態でろくに歩けもしねぇから、オレの代わりにアイツらを連れ戻してきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880217,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "助かる。アイツら、いつもならもう少し言うことを聞くし、なんだかんだ畑も手伝ってくれるんだが、ここ最近は様子が変でな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880219,
					"content": "だがまぁ、お前がちょっと声をかけりゃ、三匹とも素直に戻ってくるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パカリン"
				},
				{
					"id": 751880205,
					"content": "ナタ人じゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
