			"dialogs": [
				{
					"id": 751350201,
					"content": "ポーナ、速すぎたぞ！置いてかれるところだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350202,
					"content": "へへっ、ごめんごめん。源火の祭壇を見たらつい……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350203,
					"content": "その祭壇を使えば、天蛇の船に辿り着けるってことか？でも、あとでもし大きな風域が出ても、どこまで飛べばいいかわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350204,
					"content": "うわっ、考えただけで心配になってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350205,
					"content": "大丈夫だよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "そうか、おまえがそう言うならちょっと安心だけど…あんまり離れないでくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350209,
					"content": "とにかく、今はさっさと炎燐石を奉納しよう。でも、あたしたちのを合わせて炎燐石は二個あるから…うーん…念のため、二個とも置いていこっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350207,
					"content": "わぁ、ワクワク。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "でしょでしょ？あたしもワクワクしてきたよ。冒険者として、こんなチャレンジは見逃せないよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "ポーナ"
				}
			]
		}
