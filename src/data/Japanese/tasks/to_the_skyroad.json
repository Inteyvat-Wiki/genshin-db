			"dialogs": [
				{
					"id": 751350101,
					"content": "あれが源火の祭壇か…うぅ、あっちに行くのはちょっと難しそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350102,
					"content": "#どうしよう。オイラたちは飛べるけど、{REALNAME[ID(2)|SHOWHOST(true)]}とポーナはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350103,
					"content": "甘く見ないで。花翼の集の冒険者なんだから、飛行経験は豊富だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}を連れて飛ぶのだって、楽勝楽勝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350105,
					"content": "#{M#俺}{F#私}も飛行免許を持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "ならよかった。案内するから、しっかりついて来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350107,
					"content": "次はタイムトライアルなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "もう、今はそんな勝負してる場合じゃないでしょ？あたしが案内するから、しっかりついて来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751350109,
					"content": "#なんだか危なそうだし、なにがあるか分からないから、{REALNAME[ID(2)|SHOWHOST(true)]}はちゃんと掴まっててくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751350110,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
