					"nextDialogs": [
						200630802
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630802,
					"content": "サイリュスさんはこう言ったんだ…よく覚えてるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630803,
					"content": "それから、あの怪物を倒した鍵は、ある方法で盾を壊したとも言ったよ。",
