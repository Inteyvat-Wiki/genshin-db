			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "僕はいつになったら偉大な冒険者になれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630202,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "ああ、君か…昨日サイリュスさんが冒険の話を教えてくれたんだ…今回は<color=#00E1FFFF>望風山地</color>での出来事だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630204,
					"content": "確か「…あのざらざらした盾はまるで悪夢みたいで、剣でいくら叩いてもビクともしない。そして盾の奥にいる怪物は俺を見下ろし、その笑い声はまるで俺の無力さを嘲笑うような…」って言ってたっけ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630205,
					"content": "どんな攻撃でも防げる木盾…はあ、この目で見てみたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630206,
					"content": "でも仕事がこんなにあると、行きたくても行けないな…一体どんな怪物がそんな盾を持ってるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630207,
					"content": "そうだ、君も興味があるなら…あの怪物を探してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630208,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "ありがとう。見つけたら、絶対詳細を教えてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630210,
					"content": "一緒に行ってあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "僕？だめだよ、冒険者協会の仕事がまだたくさん残ってるんだ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630212,
					"content": "最近の冒険活動があまりお金にならなくてね、冒険者協会は名ばかりで、実際は人を助ける仕事ばかりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630213,
					"content": "たとえばドゥラフさんのイノシシ駆逐を手伝ったり、マーガレットさんの猫を探しだったり、フローラさんに新鮮な花を持って行ってあげたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630214,
					"content": "ハハッ、冒険者協会に入った時は、こんな「冒険」が待ってるって考えもしなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
		},
		{
			"id": 2006303,
