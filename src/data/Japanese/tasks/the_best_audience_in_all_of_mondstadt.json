				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "はあ、見てみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630102,
					"content": "何を見たいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "うわっ、いつ来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630104,
					"content": "実はね、昨日スタンレーさんと酒を飲んでて、<color=#00E1FFFF>ダダウパの谷</color>での冒険の話を教えてもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630105,
					"content": "確か「…あの怪物が激しく燃え上がって、巨大な体がゆっくりとにょろにょろ動く。俺がいくら攻撃しても叫んでも、ヤツはその目で俺を見るだけ。まるで俺を軽蔑しているようで…」って言ってたかな",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630106,
					"content": "僕は見たことがないけど、あのスタンレーさんが苦戦するくらいだから、きっとすごい冒険だったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630107,
					"content": "はあ、あのスタンレーさんが苦戦してた怪物に会ってみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630108,
					"content": "まあ、僕の力だと会っても逃げるだけで精一杯だろうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630109,
					"content": "そうだ、君も興味があるなら…あの怪物を探してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "頼もしいね！では頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630112,
					"content": "一緒に行ってあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "可能なら僕も一緒に行きたいけど、まだまだ僕に残された仕事がたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630114,
					"content": "何の仕事だって？今のモンドの冒険者協会だと、冒険だけの収入が全然足りないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630115,
					"content": "だからみんなの手伝いを色々してるんだ。たとえば猫探しとか、除草とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630116,
					"content": "この偉大な冒険は君に任せた。見つけたら、絶対詳細を教えてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
		},
		{
			"id": 2006302,
