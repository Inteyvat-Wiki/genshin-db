					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "いろんなところに冒険したいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630302,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "昨日スタンレーさんがまたいろいろ話してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630304,
					"content": "でも彼はちょっと酔っぱらってて、話が支離滅裂なところがあるけど…確か<color=#00E1FFFF>アカツキワイナリーの周辺</color>の話だったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630305,
					"content": "彼はこう言ったかな…「…あの怪物の不吉な気配が氷となり、悪意が怪物の体をより大きくした。そして恐怖が俺を足を凍らせ、俺は武器を振り回したが、斬った氷の欠片は俺の目をくらます…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630306,
					"content": "あのスタンレーさんが苦戦するくらいの怪物は一体なんなんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630307,
					"content": "一目見てみたいな。まあ、僕は逃げるだけで精一杯だろうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630308,
					"content": "でも君ならきっと問題ないと思うよ。その怪物を探してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630309,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "では頼むよ。見つけたら、絶対詳細を教えてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630311,
					"content": "一緒に行ってあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "僕はもちろん行きたいけど、冒険者協会の状況…君も分かるだおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630313,
					"content": "サイリュスさんはずっと清泉町でのんびりした生活をしたいって言ってるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630314,
					"content": "ヘルマンさんは娘さんが生まれてからモンドを出ることがないし、昔はエース冒険者だったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630315,
					"content": "それからスタンレーさんも長い間ずっと休んでて、冒険に行ってないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630316,
					"content": "今協会が経費を集めようとしても、細かい仕事で稼ぐしかない…今は細かい仕事をする人も少なくなったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 200630317,
					"content": "僕も頑張らないと。ベネットのやつも大変だから、頼ってばかりはだめだよ。",
					"roleType": "TALK_ROLE_NPC",
