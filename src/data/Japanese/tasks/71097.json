			"dialogs": [
				{
					"id": 710970101,
					"content": "「老石」は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970102,
					"content": "持ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "これを含めて「老石」が九個か。ああ、これで十分だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970202,
					"content": "もう輝山庁の要求を満たしたとは…さすがだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970203,
					"content": "一巨獣一闘争の労だ、気にするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970204,
					"content": "「一挙手の労」でしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "おお！オイラが言いたかったのは…こんなこと、巨獣と闘うのと同じくらい楽勝だぜってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970206,
					"content": "パイモンが言い訳してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "ははっ…パイモンの言う通りだな。二人が海魔と戦った功績は知っている。これしきのこと、きっと朝飯前だったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970208,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "まさか総務司に入っても尚、「層岩巨淵での老石探し」のような仕事を担当するとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970211,
					"content": "そう言えば、その昔親父さんと喧嘩ばかりしてたおまえが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970212,
					"content": "どうやって総務司に入ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970213,
					"content": "昔は大きな借金を抱えてたって言っただろ？行くあてもなかったが、家にも帰れなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970214,
					"content": "そしたら、借金取りは父を探して盛露庁まで押しかけてきて…あのときは、父にこっぴどくやられて足の一つでも折られるんじゃないかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970215,
					"content": "でも、足は大丈夫そうだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970216,
					"content": "それは…恥ずかしながら、父は借金を返済してくれた上、道で行き倒れていた俺を見つけ出してくれたんだ。「お前の借用書は全部俺が持っている。これからは俺に金を返すんだ」と父は言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970217,
					"content": "そして借金を理由に…仕事をさせられたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970218,
					"content": "なるほど、じゃあ今は親父さんからお金を借りたことになってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970219,
					"content": "その通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970220,
					"content": "当時は借金取りに追われて、夜もぐっすり眠れないほどだった。だから、二度目の機会をもらった俺は、今度こそ絶対に変わろうと誓ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970221,
					"content": "その機会をくれたのが、いつも揉めていた父だなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970222,
					"content": "父はいつものように俺と揉めたりはせず、真摯に話し合ってくれた。はぁ…もっと早くそうやって話し合うべきだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970223,
					"content": "でももしあの頃から父に話し合う気があったとしても、俺は聞く耳を持たなかっただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970224,
					"content": "親父さん、おまえに優しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970225,
					"content": "そうでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970226,
					"content": "だから何があっても、この仕事をこなさないといけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970227,
					"content": "今回の層岩巨淵の事も、輝山庁の「老石」探しの雑用も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970228,
					"content": "#今回は{M#俺}{F#私}がやってあげたんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "他人の力を借りるのも、仕事の内さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970230,
					"content": "でも今回は本当に、あんたらのおかげだ。こんなに早く終わるなんて思ってもみなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970231,
					"content": "へへっ、ちゃんと分かってるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710970209,
					"content": "全く苦労がなかったわけじゃないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}