				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "あっ…こんにちは！ジン団長をお探しですか？それとも——何かお手伝いできることはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190402,
					"content": "ただ散歩してるだけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "騎士団の執務エリアの定期大掃除中です。埃落としは大体終わったので、次は古い資料を整理するつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190405,
					"content": "長い間山積みのまま放置されていたので、きちんと整理すれば、後で皆さまが確認するのにも便利になるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190406,
					"content": "それに先人の記録からは、たくさんのことを学べます。これも、修行のうちです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190407,
					"content": "ノエルは相変わらず真面目で頼もしいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "これは私の果たすべき責務ですから。何より、あなたや騎士団の皆さまは常に前進されていますから、一刻も早くその歩みに追いつきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190409,
					"content": "じゃあ、その決意を称えて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "えっ？私の写真を？こ…光栄です！あ…ただ、先ほど掃除を終えたばかりで、埃まみれなのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190412,
					"content": "ノエルが頑張ってる姿を撮りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "き、騎士だなんて…まだ早すぎます！でも、撮りたいと望んでいただけるなら…埃まみれでも光栄です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190415,
					"content": "では、シャッターを切るタイミングはお任せしますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ノエル"
				},
				{
					"id": 745190413,
					"content": "メイド騎士の決定的瞬間を収めたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "写真を撮ってあげるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "ノエルは何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
