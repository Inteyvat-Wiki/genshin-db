			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "うぬぬ…風、大きい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780402,
					"content": "ここの風の壁は通れないぞ！回り道をしないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780403,
					"content": "吉法師、オイラたちに着いてこい。横から回って来ようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
