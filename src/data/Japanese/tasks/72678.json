		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百蔵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "五百蔵、戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790102,
					"content": "おお、帰ってきたか。吉法師、修行の成果はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790103,
					"content": "カサカサ、ぽんぽこ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790104,
					"content": "ぬははは、よくやった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790105,
					"content": "あれ、吉法師が何言ってるか、また分からなくなったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790106,
					"content": "あ、そうだ。写真もたくさん撮ったんだ。五百蔵、ほら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790107,
					"content": "旅の途中、吉法師のために撮った写真を五百蔵に渡した。\\n道中であった出来事も全部、五百蔵に話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "…やっと五百蔵に頼まれた、「修行で吉法師を八ヶ所に連れていく」旅が終わったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790109,
					"content": "ぬ！さすが吾輩が認めた人間たちだ、よくやった。お前らが狸だったら、吾輩の半分ぐらいの強さの、立派な大妖狸になれたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790110,
					"content": "（それ、あんまり強くなさそうだな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790111,
					"content": "さて、任務も完了したことだし、そろそろ行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790112,
					"content": "うぬぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790113,
					"content": "ううっ、そんな顔するなよ。分かった分かった、オイラからもう一つ教えてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790114,
					"content": "友達とサヨナラをするときは、笑顔じゃないとダメなんだぞ！笑顔で別れることが出来たら、次に会う時はもっと楽しくなるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790115,
					"content": "…ん？ふむ、よかろう。吾輩に任せるがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790116,
					"content": "吉法師はこう言っておる、「分かった、白髪。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790117,
					"content": "え？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790118,
					"content": "吉法師はまた喋れなくなっちゃったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "だいぶ時間が経った故、妖狸飯の効果もそろそろ無くなる頃だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790121,
					"content": "ふん、吾輩が石に封印されていなければ、妖狸の言葉を一生理解できるようにしてやることなど、お安いご…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790122,
					"content": "…ん？ふむ、吾輩が伝えてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790123,
					"content": "「吉法師、頑張って修行する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790124,
					"content": "「五百蔵みたいな、大妖狸になる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790125,
					"content": "…ぬ？お前って奴は、いい度胸だ。ぬははは、吾輩の若い頃とそっくりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790126,
					"content": "「そしたら、白髪と金髪は妖狸飯を食べなくても、吉法師の話を理解できる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790127,
					"content": "…おう！次一緒に修行できる時まで、オイラ待ってるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726790128,
					"content": "頑張れ、吉法師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "また封印されないようにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "ぬ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790131,
					"content": "ぬ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726790132,
					"content": "まあいい、忘れてやろう。吉法師を修行に連れて行ってくれたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790133,
					"content": "そうだ。以前、歌麿って奴が鎮守の森で封印された狸の絵を描いて、下書きを何枚か残して行ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790134,
					"content": "これはお前らにやろう。もし我ら妖狸一族のイケメンな姿が見たくなったら、その絵を見るがいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790135,
					"content": "はぁ、お前たちが妖狸だったらなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790136,
					"content": "それならとっくに石になってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "ふむ、それもそうだな。他に用がないなら去れ。吾輩はこれから吉法師に法術を教えねばならんからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726790119,
					"content": "また何言ってるか、分からなくなった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}