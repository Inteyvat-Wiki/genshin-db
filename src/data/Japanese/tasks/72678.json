					"content": "ぬ…すごい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780302,
					"content": "吉法師…おまえ、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780303,
					"content": "さびれた街。よく分からないけど、何だか悲しい。おかしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も同じ気持ち。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "次は、「都市」の中心部に移動しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780305,
					"content": "吉法師がおかしくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
