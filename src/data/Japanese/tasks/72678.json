			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "やっと登れたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780502,
					"content": "ここからの眺めは、下よりもずっといいぞ。見ろ、あそこはさっきオイラたちがいた場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780503,
					"content": "パイモンは、高いところが好きなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780504,
					"content": "高いところは見晴らしが良くて飛びやすい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "風風龍は、塔の中で眠ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780508,
					"content": "そうだ、長い間眠ってるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780509,
					"content": "#{NICKNAME}は「風魔龍」と戦ったことがあるけど、別に悪い龍じゃなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780510,
					"content": "ただ、悲しいことに遭って、悪いやつに騙された。それで、友達の風神に嫌われたと思っちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780511,
					"content": "ぬ…その後は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780512,
					"content": "#その後は…{NICKNAME}、覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780513,
					"content": "戦って「毒血」を浄化した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "でも、戦ってた足場が崩れちゃったんだ。オイラたちも風神も、すごく深くて暗いどん底に落ちてしまうところだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780515,
					"content": "#ぬ！怖い…じゃあ、パイモンと{NICKNAME}はどう助かったの？空を飛んだの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780516,
					"content": "トワリンが背中に乗せて救ってくれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "ト…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780518,
					"content": "「風魔龍」のことだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780520,
					"content": "#「風魔龍」にもトワリンっていう名前があるんだ。吉法師やパイモン、{NICKNAME}と同じようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780521,
					"content": "トワリンは悪者に傷つけられた上に騙されて、すごく怒ったんだ。だからモンドに行って、大騒ぎを起こした。それでみんなは悪い龍だと思ったから、「風魔龍」って呼んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780522,
					"content": "その後、オイラたちは悪者を倒して、風神と一緒に汚染された毒血を浄化した。そしてトワリンは、風神は自分のことを見捨てていなかったって気付いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780523,
					"content": "おお！じゃあ、ト…風風龍はいい龍になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780524,
					"content": "その通りだ！吉法師をここに連れてきたのは、トワリンの物語を教えてあげたかったからだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780525,
					"content": "吉法師も、大人になったら、誤解されたり傷つけられたり、悲しいことに遭ったりするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780526,
					"content": "それでも絶対に悪いやつにはなっちゃダメだぞ。だって、「風向きは変わるもの」だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780527,
					"content": "いつか、光射す方へと吹いてくるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "ぬ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780529,
					"content": "吉法師にはちょっと難しかったかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "何だか、分かったような、分からないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780531,
					"content": "#でも、とても大事ってことは分かる。パイモンと{NICKNAME}が教えてくれたこと、忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780532,
					"content": "へへ、そうこなくっちゃな！時間をかけて話した甲斐があったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780533,
					"content": "まあとにかく、吉法師も遊んでばっかいたり、いたずらしすぎたりしちゃダメだぞ。人間に封印されちゃうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780534,
					"content": "吉法師の修行もこれで終わりだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "うぬぬ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780537,
					"content": "おい、そんなに悲しむなよ！笑顔で帰らないと、五百蔵も悲しんじゃうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780538,
					"content": "よし、じゃあオイラたちもそろそろ最後の役割を果たすとするか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780539,
					"content": "吉法師を五百蔵のところに送り届けないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780540,
					"content": "行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "ぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780541,
					"content": "行こう、吉法師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "五百蔵の依頼もこれでおしまい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "風魔龍が背中に乗せて救ってくれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "「バカと煙…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "オイ！からかうなよ。高いところは遠くまで見渡せるし、空気も美味しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
