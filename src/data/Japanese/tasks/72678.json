			"dialogs": [
				{
					"id": 726780101,
					"content": "大きな街。でもなんだか、寂しい感じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780102,
					"content": "#以前、オイラは{NICKNAME}、そしてたくさんの仲間たちと一緒に、ここで「風魔龍」と戦ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780103,
					"content": "龍って、体が大きくて、歯が尖ってて、翼で飛ぶ怖い生き物のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780104,
					"content": "本物はそれほど怖くないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "吉法師は、モンド城で見た風神像を覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780107,
					"content": "風神像…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780108,
					"content": "すっごく大きくて背の高い石像だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780109,
					"content": "ぬ！覚えてる。風神の手、大きかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780110,
					"content": "「風魔龍」は風神の友達なんだぞ！その昔、風神もここにあった「都市」から来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780111,
					"content": "おお！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780112,
					"content": "でも、風風龍は体が大きい。どうやってここに入ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780113,
					"content": "前に、誰かが同じ質問をしてたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "あ、オイラ知ってるぞ！それはな、オイラたちみたいに歩いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780116,
					"content": "吉法師、もうとっくに分かった。風風龍、飛べるから歩いて入る必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780117,
					"content": "く、くそ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780118,
					"content": "ぬ？パイモン、機嫌悪い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780119,
					"content": "うう…オイラの話は後でいいから、先にここで記念写真を撮ろうぜ。吉法師、動くんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726780120,
					"content": "吉法師、動かない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726780114,
					"content": "「風魔龍」ね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "本物は綺麗な見た目。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
