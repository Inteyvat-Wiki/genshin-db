				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "もうローデシアと話し合いをした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220102,
					"content": "彼女は私たち純水精霊の中でも最も有名で、最も強い。でも彼女は先代の水神に思いを寄せ、フォンテーヌから逃げ出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220103,
					"content": "私ももうフォンテーヌに帰れない。あなたたちに全部話す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220104,
					"content": "私たち純水精霊は大陸中の川や渓谷の水のなかに散らばってる。そのほとんどがフォンテーヌからのスパイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220105,
					"content": "えっ！？水神はなにか企んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220106,
					"content": "先代はなにも企んでなかった。ただ水を通して、大陸中のみんなを繋ごうとしただけ。でも彼女がなくなってから、多くの精霊はフォンテーヌとの繋がりを切った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220107,
					"content": "最強のローデシアでさえ、新たな水神を認めなかった。かつての夢を抱くしかなかった。ローデシアは、静かなる水が欲しいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220108,
					"content": "でも彼女は私のことをフォンテーヌから来た刺客だと勘違いした。だから敵意を向け、川を苦くして、私を消滅しようとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220109,
					"content": "でもおまえはまだ小さいから、そんなことする必要ないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220110,
					"content": "純水精霊の意識は、悪意のある雑念と融合すると簡単に崩壊する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220111,
					"content": "私はローデシアを慕ってる。だから水スライムを通して、フォンテーヌから少しずつここにたどり着いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220112,
					"content": "任務を執行する刺客を除けば、私みたいに執着する純水精霊は他にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220113,
					"content": "それは、とてもすごいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220114,
					"content": "#でもオイラも、いつか{NICKNAME}と一緒に七国を全部旅するんだ。オイラと比べたら、まだまだだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220115,
					"content": "オイ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "もう話し合いをしたから、水の苦みはもうすぐ消える。最後に彼女から聞かれた。軽策の水に溶け込みたいかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220117,
					"content": "だからオイラたちに別れを告げに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220118,
					"content": "まだ話すことがある。一緒に清泉町にきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エンドラー"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィンチじいさん"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "フィンチ、フィンチ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220202,
					"content": "おっと、びっくりしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220203,
					"content": "エンドラーの学習能力はすごいから、びっくりするのも無理はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220204,
					"content": "いや、ただ…フィンチと呼んでくれるところが、彼女に似ててな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220205,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220206,
					"content": "「毎日、ふらふらと前へ進む子供がいる。この世を見定め、自らの一部にする——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220207,
					"content": "「子供は前へ進み、一生の時を過ごす。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220208,
					"content": "その詩は知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220209,
					"content": "私たちとあなたたちの命には大きな違いがある。だから生きている内、互いに理解することはできないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220210,
					"content": "でも私たちの命は、同じものでもある。常に新しい物事や転機を受け入れて、海へと流れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220211,
					"content": "彼女はこう言った——「夜空の星々がすべて消える時、すべての小川と夢は同じ海へと流れ込む。その時、我らは再会するだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220212,
					"content": "…あぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220213,
					"content": "生命の流れはまだ続く。あなたも立ち止まらず、前へ進んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220214,
					"content": "はははっ、彼女らしいな。まだ俺を子供だと思ってる言い方だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220215,
					"content": "少し、ひとりにさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "フィンチじいさん"
				},
				{
					"id": 414220216,
					"content": "#{NICKNAME}、コナーに伝えてこよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コナー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "おっ、帰ったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414220302,
					"content": "君たちが来たということは、もう完全に解決したのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414220303,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "あと何日かで水の苦みも消えるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220306,
					"content": "あぁ、分かってる。元凶を取り除いても、元に戻るには少し時間がかかるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 414220307,
					"content": "それじゃあ、冒険者協会には依頼完了だと伝えておく。本当にありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コナー"
				},
				{
					"id": 414220304,
					"content": "過程は複雑だったけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "私たちの愛情表現は、お互いの水を融合させること。そうすれば、お互いの意識を繋げることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220402,
					"content": "でもこの世界の他の命は、そう簡単には理解できない。だから私たちはそれらを観察、研究、真似、変化してきた。今やそれらに変化した姿も、私たちの一部となっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220403,
					"content": "エンドラーが小川を眺めながら、難しい話をしてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220404,
					"content": "昔の私は、これからの命をどう過ごすか考えたことがなかった。ローデシアと一つになればいいと思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220405,
					"content": "でもローデシアはまったく嬉しそうに見えなかった。彼女も分かってる、自分は只々水が腐敗するのを待っているだけだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220406,
					"content": "じゃあエンドラーは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "ローデシアも清泉町の彼女も、私に彼女たちの道を歩ませたくないらしい。といっても、フォンテーヌでの生き方はもっと耐えられないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220409,
					"content": "おまえたちの命は不思議だ。オイラもなにを言えばいいか分からない…でも、やっぱり楽しく生きる方がいいとオイラは思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 414220410,
					"content": "だから、私は先人たちが歩んだことのない道を選ぶ。あなたたちとの旅は楽しかった、これからも毎日楽しくいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "エンドラー"
				},
				{
					"id": 414220411,
					"content": "あなたたちと旅がしたい。生命の流れが海に着く前に見る花と雲を、果てのない空を、この目で確と見届けたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "エンドラー"
				},
				{
