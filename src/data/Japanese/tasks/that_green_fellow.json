			},
			"dialogs": [
				{
					"id": 3720101,
					"content": "おや、君たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "緑のやつ"
				},
				{
					"id": 3720102,
					"content": "ふーん…あっ！あの時、トワリンを驚かした人たちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "緑のやつ"
				},
				{
					"id": 3720103,
					"content": "トワリン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720104,
					"content": "風魔龍の名前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "むむ…あっ！思い出したぞ！でも、普通の人は「風魔龍」って呼ばないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720107,
					"content": "なんで名前を…仲いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720108,
					"content": "さあね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "緑のやつ"
				},
				{
					"id": 3720109,
					"content": "#おい、{NICKNAME}、こいつなんか怪しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720110,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "こんにちは、たった一度お会いしたことのある異邦人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "緑のやつ"
				},
				{
					"id": 3720113,
					"content": "ボクは吟遊詩人、ウェンティさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720114,
					"content": "もっと正確に言えば、「モンド城で一番愛される吟遊詩人」を三期連続で優勝したウェンティだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720115,
					"content": "ボクに何かご用かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720116,
					"content": "オイラたちが分かるなら、これ以上説明する必要もないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720117,
					"content": "もちろん、風魔龍の件だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720118,
					"content": "う～ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720119,
					"content": "おい！記憶喪失のふりはやめろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}、あれを見せるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720121,
					"content": "おや、これは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720122,
					"content": "あれ？結晶が浄化されてる？いつの間に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720123,
					"content": "知らないうちにこうなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "これはトワリンが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720126,
					"content": "風魔龍が苦しんで流した涙だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720127,
					"content": "涙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720124,
					"content": "前まで濁っていたのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "名前を教えてくれないかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "忘れたの？リサさんが言ってた話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
