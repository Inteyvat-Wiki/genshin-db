			},
			"dialogs": [
				{
					"id": 3720501,
					"content": "え——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720502,
					"content": "君、本当に不思議な力を持っているんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720503,
					"content": "君のような人が、吟遊詩人の詩に登場させられるのはある種の運命だと思ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720504,
					"content": "日向にいれば英雄に、日陰にいれば災いに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720505,
					"content": "あっ…今は君のために新しい詩を書いているヒマないんだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720506,
					"content": "たとえトワリンは討伐されずとも、その生命力はすごい勢いで消耗していっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720508,
					"content": "かわいそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "風魔龍と共に自首することを推奨する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "彼は怒りの中で、自分を燃やし尽くそうとしているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720509,
					"content": "ありがとう。それと涙の結晶の浄化も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720510,
					"content": "ここからは、ボクが動く番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720512,
					"content": "涙の結晶を浄化してくれただけでも助かったよ、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720513,
					"content": "でも今は、新しい作戦を思いついたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720515,
					"content": "うわぁ、ひどい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720516,
					"content": "自首はしないよ…別の作戦があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720517,
					"content": "作戦って、なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720518,
					"content": "龍の涙を見ていたら、ある故人のことを思い出してね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720519,
					"content": "故人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720520,
					"content": "へへっ、それじゃあお先に失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720521,
					"content": "おい、どこ行くんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720522,
					"content": "モンドの「英雄の象徴」だよ。またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3720524,
					"content": "変わった人で、観察が必要だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#むぅ…{NICKNAME}、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720526,
					"content": "それに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "あいつからしたら、おまえも十分変わってるだろうけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3720528,
					"content": "声を、知ってるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "それに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}