						761210102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210102,
					"content": "よっ、コロンビーナ！ご機嫌だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210103,
					"content": "ふふ…こっちにおいでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210104,
					"content": "おう！また「月並べ」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210105,
					"content": "うん、しばらくやってなかったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210106,
					"content": "ルールは前と同じ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "三月の女神になったから駒を何回も動かせる、なんてことないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210108,
					"content": "心配しなくても、そんなズルはしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210109,
					"content": "へへっ、ただの冗談だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210110,
					"content": "じゃあ、始めようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
