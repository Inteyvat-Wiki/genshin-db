			"dialogs": [
				{
					"id": 760540301,
					"content": "こうかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540302,
					"content": "ええと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540303,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540304,
					"content": "月…月…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540305,
					"content": "ここはどうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540306,
					"content": "今回は私の勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540307,
					"content": "私の月が三つ繋がったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540308,
					"content": "うん、これで勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540309,
					"content": "月が昇っては沈む…長いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540310,
					"content": "私たちの月、お互いに譲らないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540311,
					"content": "…引き分けかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540312,
					"content": "直感よりも思考タイプなんだね。ゆっくり考えていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540313,
					"content": "「月」をどうやって「夜空」に置けばいいのかわからなくなった？手伝おうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540314,
					"content": "このゲーム、つまらなかった？私は面白いけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540315,
					"content": "ん？もしかして私を見てる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540316,
					"content": "私の顔に…「月」の答えが書いてある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540317,
					"content": "盤面はそっちだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540318,
					"content": "うん、キミの「月」の勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540319,
					"content": "この夜空はキミのものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540320,
					"content": "あっ…しまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540321,
					"content": "コロンビーナと楽しい時間を過ごした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "三つの月がつながった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210203,
					"content": "どうしたんだ？今のゲームのことを考えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210204,
					"content": "えっと…ただ、このゲームって不思議だなって思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210205,
					"content": "そうだな。おまえが授かった三つの月の力って、夜空を支配するレベルを遥かに超えてるもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210206,
					"content": "うん。もし三人の女神の意見が分かれてなかったら、世界は違う運命を辿ったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210207,
					"content": "月の女神ってどんな印象だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "そうだね…最初に会ったのは虹月の女神、ソネット姉さま。想像してたよりも活発な性格で、やんちゃな妹みたいだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210209,
					"content": "恒月の女神、アリア姉さまは三人の中で一番落ち着いてて、リーダシップがあって…優しい神だった。あ、ラウマと雰囲気が似てるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210210,
					"content": "霜月の女神、カノン姉さまは…知恵と先見の明のある女神だった。最初に月を私に託そうとしてくれたのも彼女だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210211,
					"content": "みんな優しい神だったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "うん、考え方の違いはあっても…みんなテイワットが、この「家」が大好きだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210213,
					"content": "私がテイワットの未来について話すと、ほっとした表情で耳を傾けてた。この世界に豊かな未来が訪れることを、心から喜んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210214,
					"content": "だからこそ、私に力を授けてくれたんだと思う。「家」に帰れるようにって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210215,
					"content": "そっか…もし会えるなら、ありがとうって言いたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210216,
					"content": "私も。でも…たぶん、無理だろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210217,
					"content": "幸い、世界は前に進み続けてる。彼女たちに守られた人類もちゃんと生き延びて、月の三女神の物語を語り継いでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210218,
					"content": "そうだな！毎日精一杯生きて、悪党からこの世界を守ることが、女神たちへの一番の恩返しになると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210219,
					"content": "パイモンの言う通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "パイモンも毎日精一杯生きてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "おう！毎日を楽しく過ごす——これがオイラのモットーだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210222,
					"content": "コロンビーナも、毎日ちゃんと食べて寝て、元気に過ごすんだぞ。それと、ゲームがしたくなったらいつでもオイラたちを呼んでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761210223,
					"content": "ふふっ、うん、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761210224,
					"content": "「月並べ」をするたびに、優しい姉さまたちのことを思い出すんだろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
