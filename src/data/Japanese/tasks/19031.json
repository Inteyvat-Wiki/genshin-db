					"傅三"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "1人で歩き回るのは危険ですよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102102,
					"content": "だって、どんな人間に遭うか分かりませんから…いや、もしかしたら人間ではない者に遭う可能性だってあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102103,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "おや？落ち着いてますね。川沿いを歩くと、靴が濡れるのは避けられないっていうことわざを知っていますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102106,
					"content": "陰に満ちた場所を歩いていると、普段は見えないものが見えてきてしまうかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102107,
					"content": "もしそれを一度でも目にしたら、悪夢のように絡みついて一生離れなくなるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102108,
					"content": "へえ、そうなんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "いやいや、どうしてそんなに冷静なんですか？普通の人なら、話の途中で怖がって逃げるんですけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102111,
					"content": "普通の人間に見えたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "人の恐怖心を上手に煽ることで雰囲気を演出し、怖がらせてこそが真の技巧というもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102113,
					"content": "私の見た目なんて、関係ないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102117,
					"content": "あなたみたいに怪談を信じない人は、どんな手を使っても効果がなさそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102118,
					"content": "ただ脅かす役をサボりたいだけじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "そんな訳ないじゃないですか。さて、他の腰抜けを探すとしますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102120,
					"content": "あなたも早く友達のところへ戻った方がいいですよ。今頃、恐怖に怯えてるかもしれませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102114,
					"content": "もっとそれっぽい衣装は着ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "あるにはありますが、衣装が暑くて…それに、人の恐怖心を上手に煽ることで雰囲気を演出し、怖がらせてこそが真の技巧というもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102116,
					"content": "私の見た目なんて、関係ないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三"
				},
				{
					"id": 1903102109,
					"content": "よくわからないけど、何か用？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "はじめまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
