			"dialogs": [
				{
					"id": 210240901,
					"content": "注文書は見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240902,
					"content": "全部見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "ありがとう、本当にありがとう。よかった、大きな問題にならなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240904,
					"content": "この注文書をなくしたら、オーナーに怒られるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240905,
					"content": "えっと、「この注文書はどういうビジネスか」って聞きたいんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240906,
					"content": "すまない、本当に教えられないんだ、秘密だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240907,
					"content": "これはあなたへの報酬…待って、この箱、開けられた痕跡が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240908,
					"content": "…野外である人に出会って、彼女は箱を拾って開けたと！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240909,
					"content": "終わった、何もかも終わった！だめだ…早くオーナーに報告しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240910,
					"content": "ああ、安心して、あなたを疑ったりしないから、なにせあなたのことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "ランダ"
				},
				{
					"id": 210240911,
					"content": "コホン！は、早くオーナーに連絡しないと！あなたも用事があるなら行ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランダ"
				}
			]
		},
