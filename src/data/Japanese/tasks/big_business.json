					"宝児"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "使えそうにないわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240602,
					"content": "箱を見かけてなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "箱？ええ、確かに箱を拾ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240604,
					"content": "開けてみたけど、注文書だったわ、しかもかなりの数の。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240605,
					"content": "箱の持ち主はこの箱のためにどれくらいのお金を出してくれるかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240606,
					"content": "…どういう意味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "そんなに緊張しないで、冗談よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240608,
					"content": "この注文書の価値は高いし、きっと璃月港の偉い人のものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240609,
					"content": "私は空気の読める人だから、敵になるつもりはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240610,
					"content": "でも、私が苦労して保管したものを、ただであげるなんて…どうかと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240611,
					"content": "こうしよう、最も伝統的な「物々交換」で解決しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240612,
					"content": "「夜泊石」を三つ渡してくれたら、この注文書をあなたに渡す、どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240613,
					"content": "この注文書に書いてあるビジネスより…「夜泊石」三つなんて安いものでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240614,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "じゃあ早く探してきてちょうだい。見つけたら、物々交換としましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240616,
					"content": "…どういうビジネスが書いてある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "分からないの？あなたもただの使い走りなのね…まあいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240619,
					"content": "忠告してあげる、こういう規模のビジネスは、知らないほうがいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240620,
					"content": "さあ、「夜泊石」を探してきてちょうだい。そしたら注文書をあなたに渡して、あなたは注文書をその依頼者に帰す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 210240621,
					"content": "これでおしまい、面倒事はいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				}
			]
		},
