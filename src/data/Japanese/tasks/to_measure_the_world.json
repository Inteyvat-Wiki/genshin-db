			"trigger": {
				"objectNames": [
					"ファルガーニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "あの、ちょっとお時間よろしいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250202,
					"content": "なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "「空が落ちてきたらどうしよう」と思ったことはありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250209,
					"content": "それは考えすぎだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "恐らくは、そうです。ではなぜ空は落ちてこないのですか？大地はなぜ崩壊しないのでしょう？緻密な測量なくして、その答えは永遠に見つかりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250213,
					"content": "実は私、その問いを完璧に説明できる模型を持っているのです。ただ、もう少しその説明を補強する観測データが手に入れば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250214,
					"content": "手伝ってほしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "手伝ってくださるのですか。ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250224,
					"content": "実は、もう絶好の観測地点を選んであります。ただ近隣の魔物の動きがやや活発で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250225,
					"content": "私が安心して観測できるように、魔物を追い払っていただけませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250226,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "助かります。ではすぐに出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250228,
					"content": "#{M#君}{F#あなた}も現場に行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "自分の目でデータを確かめないと、誤差が生じる場合もありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250230,
					"content": "紙にうもれて計算ばかりしていても、正解は遠ざかるばかりです。さあ、急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250215,
					"content": "幸運を祈る。じゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "ちょ、ちょっと待った！ぜひ考え直してください。この研究成果が世に出れば、天地がひっくり返るくらいの大騒ぎになりますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250217,
					"content": "そのときにはこの偉大な理論の協力者として、論文の最後にあなたの名前を挙げてもいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250218,
					"content": "うむ…なんなら、第二著者の地位を差し上げても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250219,
					"content": "そこまで焦ってるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "結果を出せなければ、研究費が打ち切られるかもしれません…そうなれば、空がいつ落ちるかなどと言っている場合ではなくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250221,
					"content": "「第二著者」はいらないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "ちゃんと報酬をくれるならそれでいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "空は落ちてこないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "いま忙しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "おや、そうおっしゃらずに。あなたは自分の住まいが倒壊しそうなときに、落ち着いていられますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250205,
					"content": "家が…崩れそうなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "ゴホンッ、もちろん違います。ですが自分の住んでいる家の全貌も知らず、誰も家の強度を保証してくれないとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250207,
					"content": "そこで毎日暮らすのは不安でしょう？それはこの世界に住むのだって、同じことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "ファルガーニー"
				}
			]
		},
		{
			"id": 2302504,
			"completionStepIds": [
				2302504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
