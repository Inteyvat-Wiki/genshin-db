			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "え？もうビーコンの設置が終わったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250702,
					"content": "全部設置したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "本当にありがとうございます。さあ、お約束の報酬です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250704,
					"content": "データの採集が終わったら、これまでの推論の裏付けがとれます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250705,
					"content": "あの…話は戻りますが、私はどうやってビーコンを回収すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				}
			]
		},
		{
			"id": 2302508,
			"completionStepIds": [
				2302508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
