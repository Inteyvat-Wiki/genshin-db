			"dialogs": [
				{
					"id": 230251001,
					"content": "え？魔物が現れた？まさか。あのエリアの環境パラメータは明らかに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230251002,
					"content": "いや、まさか…ビーコンそのものが変数となってしまったのか？作動時の軽微な揺れや音、光が魔物を引き寄せたとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230251003,
					"content": "採集したデータには影響しないはず…あ、すみません。つい独り言が出てしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230251004,
					"content": "あなたに余計なお手間を取らせてしまいました…これは報酬です。受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230251005,
					"content": "次に測量するときは、もっと慎重に考えます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				}
