					"ファルガーニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "ふむふむ…そういうことだったのか？この変数を導入すれば、これまでの誤差が説明できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250402,
					"content": "でもそうなると、他の推論も変わってくるのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250403,
					"content": "進展はあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "あ、すみません。あなたの存在をすっかり忘れていました…お約束した報酬です。どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250405,
					"content": "進展ですか…1つ問題を解決したと思ったら、また新しい問題が次々に現れる…それが研究というものなのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250406,
					"content": "最終的な結論が出るまでは、あなたのお手を煩わせることになりそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				}
			]
		},
