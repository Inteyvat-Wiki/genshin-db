					"ファルガーニー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "あっ、旅人さん！お待ちしてました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250802,
					"content": "研究は順調？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "お陰様でここ数日でかなり進みました。ビーコンもしっかりデータを集めてくれているはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250804,
					"content": "今日あのデータを回収すれば、この数日で立てた推測を証明できます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250805,
					"content": "この数日、推測しかしてなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "ゴホンッ、計算式の最適化や測量機器の調整もしていましたよ。なんせ、ほら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250808,
					"content": "運動音痴ですから、ビーコンの回収にも行けませんしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250809,
					"content": "今回もビーコンの回収にはあなたの手をお借りすることになるかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250810,
					"content": "そうだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "旅人さん、お願いします。報酬は弾みますから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250812,
					"content": "次からは回収方法も考えておいて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "一応、回収装置の取り付けや適用範囲の拡大といった方法は考えたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250814,
					"content": "でもそうすると、コストやデータの精度への影響が懸念されるもので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250815,
					"content": "と、とにかく今回もあなたが頼りです。お願いです、旅人さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルガーニー"
				},
				{
					"id": 230250806,
					"content": "それは順調とは言えないんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
