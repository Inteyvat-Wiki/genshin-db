					"平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "終わったようですね。気分はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310502,
					"content": "なんだか清々しい気分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "それは良かった。今後、このお寺を参拝する方が増えてくれたらいいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310504,
					"content": "私はしばらくここにいようと思います。ここは静かで、仕事をするのにちょうどいいので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310505,
					"content": "さて、さっそく以前集めた資料を整理して、「護法夜叉」に関する本を書かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310506,
					"content": "今後もし暇がありましたら、また立ち寄ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310507,
					"content": "線香をあげたい時は、私に声を掛けていただければと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310508,
					"content": "はぁ、本当はここ一帯をまとめて修繕したかったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310509,
					"content": "道を舗装し、両側には柵を建て、隣には花壇を置けたらなと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				}
			]
		},
