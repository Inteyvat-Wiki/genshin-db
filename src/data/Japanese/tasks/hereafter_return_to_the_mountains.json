			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "うん、まずまずといったところですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310302,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "おや、いいところに来てくれました。ちょうど修繕が終わり、作業員にも給料を払い終わったところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310304,
					"content": "はぁ…まさか、こんなにモラがかかるとは思いませんでした。頑張って稼いだモラもすっからかんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310305,
					"content": "でも、おかげさまでお寺の修繕は終わりました。モラを使った甲斐もあったというもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310306,
					"content": "線香をあげていきませんか？この日のために、新しい香炉も作ってもらったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "平安"
				},
				{
					"id": 718310307,
					"content": "うん、あげさせてもらう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "さあ、こちらが線香です。香炉はすぐそこにあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "平安"
				},
				{
					"id": 718310308,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}も線香をあげたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "もちろんです。修繕が終わってすぐに線香をあげました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "平安"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
