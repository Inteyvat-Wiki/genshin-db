			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "いつになったら釣れるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "魚を釣っている、デカい魚を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040104,
					"content": "料理が好きな友人がいる。デカい魚を渡せば、きっと喜ぶと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040105,
					"content": "ただ、この辺に魔物たちがいる。そいつらの相手をしてたら、魚に逃げられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040106,
					"content": "君から元素の気配を感じる、邪魔してくる魔物たちを倒してくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040112,
					"content": "でも、いつ魔物が来るか分からないじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220040113,
					"content": "見れば分かるよ。君も後ろを見ればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040114,
					"content": "後ろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220040109,
					"content": "なんでわかるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "私もかつては神の目を持っていた。もう使わなくなったが、元素の気配は多少感じられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040111,
					"content": "元素の力を使える君にとって、あの魔物はきっと楽勝だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "た、倒した、全然動きが見えなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220040302,
					"content": "おまえは一体何者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220040303,
					"content": "ただの釣り人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040304,
					"content": "怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "確かに私はあやしいが、この世の中にはあやしい者などたくさんいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040306,
					"content": "例えば旅館にいる料理人。昔の彼は刀を振り回していたが、今は料理に夢中になっている。怖い顔をした優しい人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040307,
					"content": "例えば旅館の女将、モンド出身だと彼女は言うが、モンドで彼女を知っている者は誰一人いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040308,
					"content": "それから…神の目を持っていないのに、元素の力を使える君とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040309,
					"content": "でも、「あやしい」けど「怖く」ない相手を、心配する必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040310,
					"content": "これは君へのお礼だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		}
	]
}