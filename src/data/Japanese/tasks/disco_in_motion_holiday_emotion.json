			},
			"dialogs": [
				{
					"id": 756740101,
					"content": "こうして…こうで…コソ泥たちは跪いて泣き叫ぶはずだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740102
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740102,
					"content": "その時に、一人だけ「うっかり逃す」んだ。そいつは絶対に慌てて仲間に知らせに戻るから、君はこっそり尾行するの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740103
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740103,
					"content": "そうすれば、コソ泥たちが対策を練ってる時にアジトの扉を蹴り飛ばして、ホラー映影みたいな恐怖を与えられるってワケ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740104
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740104,
					"content": "いいアイデアだね、アンジェニーナさん。話の通じない悪人を相手にするなら、確かに常識外れな手段を使わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740105
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740105,
					"content": "ナタはフォンテーヌと違って、あんな面倒な…コホン、「厳格な法の執行手続き」なんてないからね！この強みをしっかり活かすとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740106
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740106,
					"content": "この前、取り逃してた竜の密売人を何人か捕まえたから、あなたが提案してくれたやり方で、北方の密売人も一網打尽にしてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740107
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740107,
					"content": "いい知らせを聞かせてね、すっごく楽しみにしてるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740108
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740108,
					"content": "はぁ…私はもう執律庭のメンバーじゃないから秘密保持の義務があるし、トゥレーヌも私に仕事の状況を報告できないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740109
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740109,
					"content": "なんだか、共有し忘れてるノウハウがまだある気がするんだけど…いっそ、回顧録でも書いてみようかなぁ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740110
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740110,
					"content": "そう、各国の法執行機関の人たちにだけ販売する回顧録！私のこの150年の仕事の思い出や経験が、きっと役に立つと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740111
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740111,
					"content": "いいね！パーティーを思い切り楽しんで、心身ともにリフレッシュできたら、執筆もきっと順調に進むだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740112
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740112,
					"content": "その時は、あたし用にサイン入りのを一冊取っておいてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740113
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740113,
					"content": "真っ先に君にプレゼントするよ！今は思いっきり踊って、帰ったらタイプライターを借りて、すぐに書き始めるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740114
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740114,
					"content": "メリュジーヌと…ヌスタか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740115,
					"content": "なかなか見ない組み合わせだけど、なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740116,
						756740117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740116,
					"content": "面白そうな話をしてるみたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				},
				{
					"id": 756740118,
					"content": "よし、あたしたちの「トゥマイニ」もやってきたね！リードダンサーも位置について、パーティーはここからが本番だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740119
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740119,
					"content": "まずは特大の朗報を伝えないとね——あたしたちの第二回「ビートパーティー」が始まったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740120
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740120,
					"content": "それに、新しい参加者もいるよ！フォンテーヌ観光団のアンジェニーナさんと、彼女の三人の仲間たちさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740121
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740121,
					"content": "そして、「ウッサビーティ」のカチーナと、モンドから来たアイドルのお嬢さんのおかげで、フォンテーヌのお友達とここのアシャも新しいステップをマスターできた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740122
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740122,
					"content": "ま、待て待て！情報が多すぎて、ついてけないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740123,
					"content": "つまり、前回踊ってたみんなと仔竜のほかに、メリュジーヌと…アシャもいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740124,
					"content": "そういうこと！だからあたしたちは、より斬新に、より楽しい音楽に合わせて、もっと心ゆくまで踊れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740125
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740125,
					"content": "リードダンサーの「トゥマイニ」も、すべてのビートへの対応力を披露できるしね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740126,
						756740127
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740126,
					"content": "確かに賑やかなほうがいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740128,
					"content": "#待って、ヌスタが君のことを「トゥマイニ」って呼んでたけど…{NICKNAME}が「トゥマイニ」なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740129
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740129,
					"content": "私にダンスを教えてくれた、あの「こだまの子」の小さな勇士が言ってたんだ。彼女の師匠はナタで一番すごい「トゥマイニ」で、ダンスもすごく上手だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740130
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740130,
					"content": "どんな人かと思ったら、君のことだったんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740131,
						756740135
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740131,
					"content": "#じゃあ、{M#俺}{F#私}は{M#君}{F#あなた}の師匠の師匠だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740132
					]
				},
				{
					"id": 756740132,
					"content": "ぷっ…じゃあオイラも、アンジェニーナの師匠の師匠と同格ってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740133,
					"content": "だめだめ、それだとなんだか地位が二段階くらい下がっちゃう気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740134
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740134,
					"content": "二人は上下関係のない別々の格として考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740139,
					"content": "話を戻すけど、踊るのってすごく才能が大事だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740140
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740140,
					"content": "もしかしたら、実は私は小説の主人公レベルの天才で、二日くらい稽古すれば、君と同じくらい踊れちゃうかもね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740141
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740141,
					"content": "もちろん、ダンスは他人と競うものじゃないけど…私が言いたいのは…最高に気持ちいいリズムも、一番流行りのステップも、私ならついてけるってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740142
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740142,
					"content": "そうそう！ダンスってのは、楽しければそれでいいんだ！リズムに合わせて体を揺らすだけでも、参加してるって言えるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740143,
					"content": "準備はすべて整ったみたいだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740144
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740144,
					"content": "「トゥマイニ」が先に友達とおしゃべりしたいなら、あっちでみんなが待ってるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740145
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740145,
					"content": "こっちはいつでも集合をかけて、音楽を鳴らして、パーティーの本番を始められるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756740135,
					"content": "ベテラン警察隊員の情報網もまだまだだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740136
					]
				},
				{
					"id": 756740136,
					"content": "まったくだぜ！教官のおまえも油断する時があるんだな。隣の国の重要な情報は、しっかり収集しなきゃダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756740137,
					"content": "それはちょっと理不尽だよ。私には国外で行動する必要なんてないんだ。どうして自分に関係ないことに首を突っ込まないといけないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740138
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740138,
					"content": "知ってることが多いほど、頭がこんがらがることもあるでしょ。「情報オーバーロード」しないための調整だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756740139
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756740127,
					"content": "パーティーは人が多いほうが楽しいしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740128
					]
				},
				{
					"id": 756740117,
					"content": "危なそうな話をしてるみたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756740118
					]
				}
			]
		}
	]
}