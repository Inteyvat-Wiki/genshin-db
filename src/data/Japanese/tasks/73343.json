			"dialogs": [
				{
					"id": 733430101,
					"content": "おお、やるじゃないかソルシュ！一気に周りが生き生きとしてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733430102,
					"content": "花霊の力はとても不思議だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430103
					]
				},
				{
					"id": 733430103,
					"content": "驚くにはあたらないワ！「シューニャター花」を救うぐらい、私の偉大な能力にかかればわけないんダカラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430104
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733430104,
					"content": "暗色の浸蝕は未だに拡大しているワ。ここの「シューニャター花」は、被害者のほんの一部にすぎないノ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430105
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733430105,
					"content": "他の花池もこの災難を免れることはできなかったみたいネ。セファーナはきっとあたふたしているに違いないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430106
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733430106,
					"content": "おまえの話を聞く限り、そのセファーナってやつはまじめな花の世話役みたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733430107,
					"content": "#{NICKNAME}、その花霊を助けてやろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733430108,
					"content": "このぐらいの功績なら、偉業の柱につけるちょっとした飾りといったところネ。我が「謁賛主」、ほかの「シューニャター花」も注意して探すのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430109
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733430109,
					"content": "また見つけたら教えるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430110
					]
				},
				{
					"id": 733430110,
					"content": "おう、オイラたちでかわいい花たちをいっぱい助けようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
