					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "こんなことがあったなんて思わなかったぞ…ミリッチも、このノートを残した人も、みんな本当に勇敢だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751260602,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "これって…さっきのノートにあった、休眠中の竜の卵じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751260604,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、孵化マシンで孵化させてほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751260605,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "#——うーん、竜の卵の状態は悪くなさそうだな。孵化マシンにもちょうど操作ガイドがあるぞ。{NICKNAME}、早速やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751260607,
					"content": "どうなるか分からないけど試す価値はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "キュー！",
