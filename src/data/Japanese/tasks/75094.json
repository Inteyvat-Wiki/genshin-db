			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "ふぅ——魔物が急に襲ってくるなんてびっくりしたぜ！オイラたちが強くて良かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940602,
					"content": "なら、次はパイモンが戦ってね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "ええっ！？いやいやいや、オイラは無理だぞ！あんなに怖い魔物と戦いたくないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940606,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}、こいつも早くしてほしいみたいだぞ。やっぱりなんとかして、まず竜の卵を孵化させようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940608,
					"content": "孵化マシンを起動する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "孵化マシンが再び稼働し始めた…\\nあとは、待つだけ…\\nしかし、長く待っても…竜の卵には少しの変化も無かった…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "おかしいなぁ、ぜんぜん反応がないな？もしかして、操作がなにか間違ってたのか？もう一回試してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940612,
					"content": "もう一度試す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "説明の通りに、孵化マシンをもう一度起動させた…\\nしかし前回同様、竜の卵に変化は現れなかった…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "うぅ…いったいあとどれくらい待たなきゃいけないんだよ、オイラ、もう目が回りそうだぞ…頭もクラクラするし…お腹も空いてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940615,
					"content": "ウウ…クゥ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "あれ！？えっ！？待てよ！今動いたみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940617,
					"content": "それじゃあ、もう少し待ってみる…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "また長い時間が経った…\\n依然として竜の卵には何の変化もなく、内側から殻が破られる気配も全くなかった。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "まだ反応がないな…孵化マシンが壊れてるのか…？でも、ちゃんと明かりはついてるもんな！もしかして、問題があるのは竜の卵の方か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940620,
					"content": "——うーん、このまま待っててもしょうがない気がしてきたぞ…オイラたち、やっぱり竜の卵を持って行ったほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940621,
					"content": "お腹が空いても竜の卵は食べちゃダメ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "グル！グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#食べたりしないぞ！{REALNAME[ID(2)|SHOWHOST(true)]}に変な誤解させないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940626,
					"content": "オイラが言いたいのはな、その、もし本当に卵の方に問題があったとしたら、この卵はもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940634,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#そんなに落ち込むなよ、{REALNAME[ID(2)|SHOWHOST(true)]}、これはどうしようもないことなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940636,
					"content": "たぶん、ここの環境が適してないだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "そ、そうだな！孵化しないのは、この竜の卵が、ナタは昔と同じままで自分の家にはふさわしくないって思ってるからかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940639,
					"content": "ずっとここに隠れてたんだから、外がどれだけ素敵なところになったのか、知らないはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940640,
					"content": "だから、こいつは持ち帰ってちゃんと面倒を見てやろうぜ！毎日いろんな話を聞かせてやるんだ！きれいな景色とか、楽しかった冒険のこととか、それから、沢山のいい人たちの話をな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940641,
					"content": "とにかく、今のナタがどんなに素敵かをこいつに伝えるんだ！こいつの心が動けば、きっと殻を破って自分から出てきてくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940642,
					"content": "…キュイオン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "卵はまだ生まれる時じゃないと思ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}はどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "まったくないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#えっ！？でも…さっきのは…オイラの見間違いだったのか？いやいや、{REALNAME[ID(2)|SHOWHOST(true)]}は見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940629,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#うぅ…おまえも見てないのか？本当にオイラの見間違いだったのかな？どうしたらいいんだ、{NICKNAME}？このまま待つのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940631,
					"content": "それとも…問題があるのは竜の卵のほうか？で、でも、もしそっちなら、卵は永遠に孵らないってことにならないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940632,
					"content": "たぶん竜の卵の方に問題がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "え？つ、つまり、この卵はもう孵ることはないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750940604,
					"content": "フン、大したことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "ほんとだぞ！ものすごく凶暴そうだったから、てっきりなんかすごいやつかと思ったけど、結局大したことなかったな！あんなの、こいつの頭突きにも及ばないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
