			"dialogs": [
				{
					"id": 220360501,
					"content": "若いの、また会ったな。今日は何を聞きに来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360502,
					"content": "聞きに来たわけではない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "おおっ、ワヒッドに言われて来たんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360505,
					"content": "離島に真新しい肥料屋さんがあるって聞いて、店主のワヒッドに挨拶したんだ。彼んとこの肥料を試してみたかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360506,
					"content": "その効果で農作物の収穫量が増えたら、紺田村活性化への希望も湧いてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360507,
					"content": "ははっ、村興しも俺みたいなオッサンが頼りになるんだ。村の若いやつらには…フン！まったく期待できないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360508,
					"content": "とにかく教えてくれよ、この肥料ってどう使うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360509,
					"content": "清水を加え、ちぎれた葉っぱを入れ、最後にかき混ぜる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "この肥料、使い方がこんな複雑なのか…よし、覚えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 220360510,
					"content": "ちぎれた葉っぱを加え、かき混ぜて、最後に清水を入れる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
