			"dialogs": [
				{
					"id": 220360201,
					"content": "肥料の使用方法について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "そうでした、今回持って行く肥料は、特別な使い方が必要になることを説明していませんでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360203,
					"content": "どれどれ…説明書によると、使う順番は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360204,
					"content": "まずは肥料に<color=#37FFFF>清水</color>を加え、次に<color=#37FFFF>ちぎれた葉っぱ</color>を入れます。最後に<color=#37FFFF>よくかき混ぜて</color>畑に投入します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360205,
					"content": "しっかりと覚えてくださいね。順番通りにしないと、予期せぬことが起こる可能性があります。誤った情報を伝えてしまった場合、お客様の信頼を失い、注文の獲得が難しくなります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360206,
					"content": "ちゃんと覚えた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "では、この仕事はお任せしましたよ。お客様に「豊沃の恵」を渡せたら、その頭金があなたの報酬になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360208,
					"content": "もう一回言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "まずは肥料に<color=#37FFFF>清水</color>を加え、次に<color=#37FFFF>ちぎれた葉っぱ</color>を入れます。最後に<color=#37FFFF>よくかき混ぜて</color>畑に投入します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360210,
					"content": "頼みましたよ、旅人…みんなで頑張れば、今月の業績も何とかなるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワヒッド"
				}
			]
		},
