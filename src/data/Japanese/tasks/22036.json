					"ワヒッド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "実に困難な商売です。売っているのは子供向けの良い品ばかりなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360102,
					"content": "おかしい。どうして、誰も買いに来ないのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "おお、あなたですか、旅人。はぁ…恥ずかしながら、店の肥料がなかなか売れないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360105,
					"content": "アラニが手伝ってくれるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "彼女は…少し助けになりましたが、問題があるのです。私たちはどちらも商売について詳しくなく、ただ店内でお客様が来るのを待っている状態でして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360107,
					"content": "しかし、離島の事情はあなたもご存じかと思いますが、ここにはお客様がほとんどいないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360108,
					"content": "そこで、商会の皆さんに尋ねたところ、「マーケティング」に取り組んでみてはどうかと言われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360109,
					"content": "具体的には、肥料の効果や仕組みをもっとお客様に説明し、宣伝を増やし、「お試し」サービスというものを実施する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360110,
					"content": "しかし…そのような難しいことはよく分かりません。この肥料も私が研究したものではありませんし、何を言うべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360111,
					"content": "ただ、説明書を読み上げるだけでも、歩き回って宣伝しないといけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360112,
					"content": "アラニは既に宣伝のためにでかけました。私もこの後行く予定です。旅人、宣伝の仕事を少し手伝ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360113,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "助かります！ではお任せしますよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360115,
					"content": "あなたにお願いしたいのは、ここからそう遠くない「紺田村」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360119,
					"content": "そこに、店の肥料に興味を持ってくれた紺田伝助さんがいます。以前も店に来てくれて、少しお話したことがありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360120,
					"content": "もし実際に商品を持って行き、「お試し」してもらえたら、もしかしたら買いに来てくれるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360116,
					"content": "アラニはどこに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "取材するために、遠くに行くと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "ワヒッド"
				},
				{
					"id": 220360118,
					"content": "あなたにお願いしたいのは、ここからそう遠くない「紺田村」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "ワヒッド"
				}
			]
		},
		{
