			"trigger": {
				"objectNames": [
					"小林",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "お待ちを！「通行証」をお出しください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130102,
					"content": "あの…ちょっと鳴神島に急用があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130103,
					"content": "「通行証」がないのでしたらお帰りください。規則ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "小林"
				},
				{
					"id": 20130104,
					"content": "はぁ…やっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130105,
					"content": "旅人、なんか考えろよ。どうやったら外に出られるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130106,
					"content": "#社奉行が{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちのこと知ってるなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "勘定奉行の偉い人に直接会いに行くってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130109,
					"content": "…そいつの手下にはまだ文句が残ってるけど、やってみるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130110,
					"content": "もしかしたら、オイラたちを歓迎してくれる可能性だってあるしな？えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130107,
					"content": "#勘定奉行も{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちのこと知ってるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
