					"nextDialogs": [
						20130812
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130812,
					"content": "千里さんすごいな、人が変わったみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130813,
					"content": "分かりました…お嬢様とご同行できとても光栄に思います…お嬢様の身の安全、命と引き換えにしてでも守って見せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20130814,
					"content": "新之丞！いいのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20130815,
					"content": "ああ…お嬢様がそう言うんだ。部下はそれに応えるしかないだろう。",
