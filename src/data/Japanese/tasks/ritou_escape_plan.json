			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柊慎介",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "私は柊慎介、勘定奉行柊家の当主をやっている。君たちに会えて実に光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130202,
					"content": "こちらも光栄です。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "会えてうれしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130205,
					"content": "今回会いに来たのは、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130206,
					"content": "まあ、そう急くな。せっかく有名な二人の旅人が来たんだ、そう焦って本題に入らなくてもよかろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130207,
					"content": "へへっ、オイラたちって有名なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130208,
					"content": "もちろんだ。風魔龍を倒し、渦の魔神をも鎮圧するほどの実力を持った人間が、この世に何人いるというのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130209,
					"content": "たしかにな！おっしゃる通りだ！うんうん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130210,
					"content": "それと…璃月港でファデュイの計画を阻止し、決戦の最中、彼らの執行官を倒したのは本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130211,
					"content": "そんなことも知ってるのか。たしかに本当だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130212,
					"content": "ふむ…やはり本当だったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130213,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130214,
					"content": "いや、なんでもない。ただ君たちを称賛しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130215,
					"content": "それほどでも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "…お二人がこの離島に訪れたのは、実に光栄なこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130218,
					"content": "かねてよりお二人は熱心な方だと聞いている、我々勘定奉行のためにちょっとしたお手伝いをお願いできないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130219,
					"content": "#いいぜ！遠慮しないでなんでも言えよ！な、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130220,
					"content": "またお使いの時間、そうだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "ははっ、よかった。それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130223,
					"content": "知っておられると思うが、璃月の山には清心と呼ばれる植物が生えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130224,
					"content": "オイラたちそれを採ったことあるから知ってるぞ。璃月に行って採ってきてほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130225,
					"content": "ああ、新鮮な清心を300個ばかし採ってきてほしい。新鮮で採りたてのものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130226,
					"content": "オイラの聞き間違いか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130227,
					"content": "桁がおかしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "おっと？そんなに面倒なことであったか…ふむ、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130230,
					"content": "それでは、島の手紙配送を手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130231,
					"content": "それならいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130232,
					"content": "全部で709通だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130233,
					"content": "おい！どういうことだよ！それって本当にオイラたちがやらなきゃいけないことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130234,
					"content": "はは、すまないね。しかし、島は確かに人手不足なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130235,
					"content": "理由もありきたりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130236,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "どうするんだ、旅人？本当に手伝うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130238,
					"content": "考えておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "さすが旅人殿。では私は返事を待つことにしましょう、ははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊慎介"
				},
				{
					"id": 20130239,
					"content": "まずは状況を調べてくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "採り終わる頃には新鮮じゃなくなってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "そういったことは得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "最後は彼らの思惑通りだったけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
