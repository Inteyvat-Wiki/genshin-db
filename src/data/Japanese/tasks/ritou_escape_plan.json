				},
				{
					"id": 20131006,
					"content": "お…嬢…様…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131007,
					"content": "はぁ、やっぱりそういうことだったのか。こんなことだろうとは思っていたが、新之丞お前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131008,
					"content": "いや、それはない。お嬢様はきっと考えあってのことだ。ですよねお嬢様？その、お嬢様がおっしゃっていた鎌治というのは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131009,
					"content": "もう隠す必要はありません…私の意中の人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131010,
					"content": "意中の…人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131011,
					"content": "おいおい、嘘だろ。新之丞お前まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131012,
					"content": "い、いや…なんでもない…ゴホッ…な、なんとなく聞いてみただけだよ。俺がそんな、夢みたいなこと…思ってるわけ…ぐっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131013,
					"content": "二人とも心配しないでください。このことは何も知らないことにしておけば問題ありません。もし父上が咎めても、私が全責任を負います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131014,
					"content": "そうするしかありませんね。はぁ…分かりました、お嬢様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131015,
					"content": "でも千里さん、もし本当にバレたらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20131016,
					"content": "大丈夫です。父上は小さい頃から私を可愛がっています。酷くても食事を半日抜きにされるだけでしょう、ご心配なさらないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131017,
					"content": "あの爺さんにそんな一面があったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20131018,
					"content": "ではお二人ともお気を付けて。またいつかお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20131019,
					"content": "おう、またな～千里さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20131020,
					"content": "ほらさっさと貨物を運ぶぞ、何をふさぎ込んでんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "健三郎"
				},
				{
					"id": 20131021,
					"content": "うぅ…ぐすっ…うぅう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "新之丞"
				},
				{
					"id": 20131005,
					"content": "千里さんも気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
