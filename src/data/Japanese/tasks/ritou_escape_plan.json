			"dialogs": [
				{
					"id": 20130701,
					"content": "あっ、いらしてくれたのですね…私は…柊千里と申します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130702,
					"content": "お会いするのは…二度目ですね。何卒、よろしくお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130703,
					"content": "わぁ、本当に柊家のお嬢様だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130704,
					"content": "こちらこそよろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "いえ…そんなにかしこまらずに。あなたのお噂はかねがね聞いております。そして、やっとこのような機会を得ることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130707,
					"content": "ん？なんか雰囲気が変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130708,
					"content": "今回このように人目を忍んでお会いしたのは…この機会を逃せば、もうあなたに話せないからです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130709,
					"content": "なにを…話すんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130710,
					"content": "その…お手紙を届ける依頼についてです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130711,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "おまえやっぱりあの父親の娘だな！それしかないのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130714,
					"content": "いえ…お待ちください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130715,
					"content": "お二方には私の代わりに鳴神島へ行き、天領奉行の次男の鎌治さんまでお手紙を届けてほしいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130716,
					"content": "父上からはずっと連絡を反対されておりました。政治の面から見てもっと良い相手を望んでいるのでしょうが、私の心には鎌治さんしかいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130717,
					"content": "離島で父上に歯向かえる方はいないでしょう。しかし、あなた方は鳴神島へ行こうとしておられる異郷の方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130718,
					"content": "そんな事情があったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130719,
					"content": "もちろんその代わり、あなた方がここを離れるのを全力で支援いたします。どうか私を信じてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130720,
					"content": "うん…悪くない取引だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "実は、あなた方が稲妻にいる限り…父上はあなた方を離島から出すつもりがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130723,
					"content": "おう、それはオイラたちも勘付いてたぞ。あんなことを依頼するなんて、最初から足止めが目的だったんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20130724,
					"content": "何日か前に、父上と身分の高そうな女性が話しているのを見ました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130725,
					"content": "異郷の旅人をどうやって離島に閉じ込めるのか相談していたようです。父上が将軍様以外の方にあんなにかしこまるのを初めて見ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130726,
					"content": "身分の高そうな女性…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "そろそろ時間です。あなた方を外に行かせるための計画を話します…今ちょうど外へ送る貨物がありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130729,
					"content": "（柊千里は旅人に計画を話した…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130730,
					"content": "では、関所でお待ちしております。手紙のこと…どうかお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130727,
					"content": "早くここを離れた方が良さそうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "これ以外に方法もない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
