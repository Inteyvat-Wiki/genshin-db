					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "時間がありません。遅れれば処罰があると父上から言われているはずですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 20130809,
					"content": "お嬢様、おっしゃることは分かりますが、しかし…",
