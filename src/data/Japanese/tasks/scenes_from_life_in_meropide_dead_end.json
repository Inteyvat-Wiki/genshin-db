				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クランツ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4373.38,
							184.186,
							4785.289
						],
