						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "君たち、やっと来てくれたか。助けてくれるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300202,
					"content": "え、読心術？怖っ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "ガルヴァーヤから助けてやれって頼まれたんだけど…なんで知ってるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300204,
					"content": "ん？だって、ここで手助けできるのなんて、君たち以外にいないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300205,
					"content": "…それもそっか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300210,
					"content": "で、やってもらうことは別に難しくない。ここのリサーチ端末は、二人で同時に操作する必要があってね。具体的なコマンドはもう登録してあるから、君たちはあっちのバーを下げるだけでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300211,
					"content": "おっと、そうだ…エネルギー蓄積装置が近くにある。まずはエネルギー蓄積装置を設置してから起動させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300212,
					"content": "それと…ちょっと確認させてほしいんだが…君たち、「機械を壊す」ような人じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300213,
					"content": "その「壊す」の定義にもよる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "なんでそんなこと聞くんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300216,
					"content": "以前、ガルヴァーナに手伝ってもらったことがあるんだが…ちょっと目を離した隙に、リサーチ端末が壊れてたんだよ。ガルヴァーナに聞いたら、自分でもよく分からないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300217,
					"content": "あとで彼女の妹に聞いたんだが、ガルヴァーナの手にかかれば機械は半日でオジャンになるそうだ。アラン·ギヨタンもガルヴァーナに会ったら、ため息をつくしかないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300218,
					"content": "その時の修理代は、私の報酬から差し引かれた…もし君たちがガルヴァーナと同じタイプなら、私は長いこと働いた上に、最後には特別許可券まで渡さなきゃならない羽目になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300219,
					"content": "そ、そんなことがあったのか…でも、オイラたちはあいつとは違うから安心してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300220,
					"content": "そうか。じゃあ、頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300214,
					"content": "端末が攻撃してきたら、壊すけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "報酬なしに助けるわけには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "その点については、あとでガルヴァーヤに申請してもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300208,
					"content": "えっ？でもあいつはさっき、おまえから直接受け取れって言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300209,
					"content": "そんなこと言ってたのか？そうか、仕方ない。ここで経費を申請するのは、フォンテーヌ科学院よりも難しいんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "クランツ"
				}
			]
		},
		{
			"id": 7403003,
