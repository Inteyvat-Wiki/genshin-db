				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "こんにちは、何か用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300102,
					"content": "お姉ちゃん、助けてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "ラノールみたいにどうしたの？何かあったのなら、気にせず言ってくれていいのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300104,
					"content": "オイラたち、特別許可券がたくさん必要なんだ！なにか仕事を紹介してくれないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300107,
					"content": "エティヌのゲームにでも参加したの？遊ぶのはほどほどにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300108,
					"content": "…そういえば、お願いしたいことがあったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300109,
					"content": "クランツが今、海蝕の裂け目のあたりで何かの装置を修理してるの…手伝ってあげてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300110,
					"content": "報酬はクランツから直接受け取ってちょうだい。たぶん断らないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740300111,
					"content": "おう、任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300105,
					"content": "何か手伝えることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "報酬があるやつがいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
