						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クランツ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4373.38,
							184.186,
							4785.289
						],
						"pointId": 4603
					},
					{
						"sceneId": 3,
						"position": [
							4373.582,
							184.163,
							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "ほう、なかなかやるな。こんな場所じゃなかったら、助手として雇いたいところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300402,
					"content": "えっへん！これくらい朝飯前だぞ。ところでこの装置、一体なんのためのものなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740300403,
					"content": "ここには元々、外部につながる裂け目があって、看守が必要だったんだ。でも今はロック装置で通路を封鎖したことで、人手を節約できてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300404,
					"content": "この技術は、フォンテーヌ科学院では別に新しいもんじゃない。ただ暇だったんでね、ちょっとばかし改造してみたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300405,
					"content": "君たちが目にしたのは、完全版じゃない。完全版はジオード鉱坑道で使われていて…おっと、話しすぎてしまったな。今のは忘れてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300406,
					"content": "ジオード鉱坑道からも外に出られるんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "うっ、その通りだ…賢いな。でももっと賢いやり方は、今の話を心にしまっておいて誰にも言わないことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300411,
					"content": "とりあえず、今回の問題は解決したな。ガルヴァーナも、もう何度もここに来て看守をする必要がなくなった。私も休むことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300412,
					"content": "…おっと、忘れるところだった。君たちへの報酬だ——ありがとよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300408,
					"content": "完全版はもっとすごいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "もちろんだ。完全版にはさらにパーツが追加されて…って、こんなこと聞いてどうするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740300410,
					"content": "完全版の詳細が知りたきゃ、自分で見てみろ。まぁ、もし捕まっても私から聞いたなんて言うなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "クランツ"
				}
			]
		}
	]
}