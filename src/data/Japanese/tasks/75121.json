			"trigger": {
				"objectNames": [
					"黒田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "二冊の本を探してほしいと頼まれた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "シトラリが欲しがっていた絶版の本について、黒田に説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "『雷電将軍に転生したら、天下無敵になった』の初版本と『お願いっ！私の仙狐宮司』の限定愛蔵版ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210104,
					"content": "君のそのご友人は本当に娯楽小説に精通していらっしゃる。そう認めざるを得ませんね。今の八重堂から出版されている本も、価値という点でいえば、今言った二冊には及びません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210105,
					"content": "そんな読者と面識がないとは…誠に遺憾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210106,
					"content": "今でも手に入れられる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "購入するのは無理ですね。在庫は言うまでもなく、とっくに売り切れていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210108,
					"content": "ですが、ここにちょうど一冊ずつ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210109,
					"content": "言い値で買い取らせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "いえいえ、こちらは君のご友人が持っていた方が、価値を発揮すると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "黒田"
				},
				{
					"id": 751210111,
					"content": "ですから、君に差し上げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黒田"
				}
			]
		}
	]
}