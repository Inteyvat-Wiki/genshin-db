			"dialogs": [
				{
					"id": 401300601,
					"content": "ごめんなさい…そろそろ行かなければいけないわ。友だちと約束しているのに、もう随分と遅刻しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300602
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300602,
					"content": "奥様、お身体が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300603
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300603,
					"content": "私を止めないで！今日はトルクシーを治療する一番大事な日！幻想を導く方法を使うの、あなたも効果があると思うでしょう？そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300604
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300604,
					"content": "奥様、あなたを止めているわけではありません。ただ…坊っちゃんのお名前は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300605
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300605,
					"content": "ジャラーカン先生、患者の名前を忘れるなんて！名前はトルクシーよ！水妖王国の王子よ！今日その王冠を取り戻して、戴冠式を行ってあげるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300606
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300606,
					"content": "奥様…安心してください、大丈夫ですよ。あなたの友人たちはすでに出発しています…待って、ほら！もう帰ってきましたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300607
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300607,
					"content": "ジュリア夫人！ジュリア夫人！オイラたち、王冠を取り戻してきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300608,
					"content": "パイモン…みんな…それは本当？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300609
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300609,
					"content": "はい。王子の戴冠式はまだ出来ていませんが…夫人、あなたが行うべきだと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300610
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300610,
					"content": "よかった、よかった！トルクシー…かわいい子…私の子…聞こえる？全部戻ってくるわ、もう孤独にならなくて済むのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300611
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300611,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300612
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300612,
					"content": "そして絵本の最後の一ページも、夫人。あなたが完成させるべきことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300613
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300613,
					"content": "そう、絵本、絵本も…でも私、絵本の最後に何を描いたらいいか分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300614
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300614,
					"content": "トルクシーとオイラたちがわかってるぞ。早く準備しろよ、オイラたちが話すから、夫人が描いてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300615,
					"content": "ええ…ええ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300616
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300616,
					"content": "コホン…ついに、「トルクシー」と勇者の仲間たちは力を合わせて、魔物たちをかっこよく撃退し、見事な勝利を手に入れたあと、王冠を奪い返した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300617,
					"content": "故郷に帰った水妖たちは、歓声を上げながら王子を迎え入れた。みんなは再び貴重な貝殻を取り出して、かつての虹の架け橋を作り上げた。王子はこの光景を見て「おお、なんて素晴らしいんだ」と心の中で呟いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300618
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300618,
					"content": "王子は感動しながら虹の架け橋の上を歩き、一緒にここまで来てくれた仲間たちを見つめる…旅人や女神パイモン、フレミネ、そして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300619,
					"content": "あれ？もう一人は？と王子は四方八方を見回したが、その姿は見つからなかった。すると突如、その人が橋の向こう側に現れる。彼女は微笑みながら歩いてきて、その仮面を外した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300620,
					"content": "王子は思わず涙を流した。なぜなら、一緒に付き添ってくれたこの謎の人物は、自分のお母さんだと分かったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300621
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300621,
					"content": "ジュリア夫人は歩み寄り、王冠を王子の頭に被せた。そして微笑みながら、こう語りかけた。我が子よ、我が国王よ。もう永遠に孤独を感じる必要はないのよ、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300622
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300622,
					"content": "ジュリア夫人、これが最後の物語だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300623,
					"content": "ありがとう…ありがとう、みんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300624
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300624,
					"content": "かわいい子…どうかお母さんに謝らせて。お母さんはもっと一緒にいてあげるべきだったわ。聞こえる？もう孤独を感じる必要はないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300625
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300625,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300626
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300626,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300627
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300627,
					"content": "ええ！お母さんも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300628
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300628,
					"content": "ど、どういうことだ？ジュリア夫人は「トルクシー」と話してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300629,
					"content": "「トルクシー」はなんて言ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300630
					]
				},
				{
					"id": 401300630,
					"content": "はやくぼくの潜水用ヘルメットを被って。その中には「トルクシー」の信号コードを翻訳するモジュールが搭載されてるから、それで「トルクシー」の話を理解できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300631
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300699,
					"content": "フレミネが近づき、自分の潜水用ヘルメットを取り出してたあなたの頭にかぶせた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401300631,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300632
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300632,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300633
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300633,
					"content": "お母さん、愛してるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300634
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300634,
					"content": "これが「トルクシー」の言葉だったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300635
					]
				},
				{
					"id": 401300635,
					"content": "お母さん…お母さんもあなたを愛しているわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300636
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300636,
					"content": "僕のほうがもっと愛してるよ、お母さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300637
					],
					"speakerTitle": "レスコー·ドストレ"
				},
				{
					"id": 401300637,
					"content": "待って、これは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300638
					]
				},
				{
					"id": 401300638,
					"content": "どうしたの？何が見えたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300639
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300639,
					"content": "お母さん、僕はすこし眠いよ。もう寝る時間だから、また子守唄を歌ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300640
					],
					"speakerTitle": "レスコー·ドストレ"
				},
				{
					"id": 401300640,
					"content": "いい子ね…もちろんよ。聞きたければ、ずっとずっと歌ってあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300641
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300641,
					"content": "~♪♫♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300642
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300642,
					"content": "ありがとう、お母さん。僕、お母さんの子守唄が一番好きなんだ。これで夢の中に、水妖王国に安心して戻れるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300643
					],
					"speakerTitle": "レスコー·ドストレ"
				},
				{
					"id": 401300643,
					"content": "この子ったら。忘れないで、お母さんはずっとあなたを愛しているわ。そうね…ここから水妖王国までの距離くらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300644
					],
					"speakerTitle": "ジュリア·ドストレ"
				},
				{
					"id": 401300644,
					"content": "忘れないよ。お母さんも覚えていて、僕がお母さんのこと大好きだってこと。ここから、水妖王国に行って帰ってくるくらい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300645
					],
					"speakerTitle": "レスコー·ドストレ"
				},
				{
					"id": 401300645,
					"content": "お母さん、おやすみなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レスコー·ドストレ"
				}
			]
		},
