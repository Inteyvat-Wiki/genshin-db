					}
				]
			},
			"dialogs": [
				{
					"id": 401300801,
					"content": "おーい、フレミネ！「トルクシー」！来たぞ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300802,
					"content": "こんにちは、パイモン、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300804,
					"content": "王冠はもう出来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300805,
					"content": "うん、今ジュリア夫人を待ってる、まだ来てないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300806,
					"content": "じゃあもうちょっと待とう。それか直接探しに行くか？遠いわけじゃないし、ジュリア夫人の家は、あそこの丘の上だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300807,
					"content": "おーい、旅人！パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300808,
					"content": "へへ、話してたらちょうど来たな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300809,
					"content": "やっと見つけた…二人が無事で本当に良かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300810,
					"content": "え？デラロッシュ、どうしたんだ？オイラたちになんか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300811,
					"content": "なんか用？って、トルクシーのことに決まってるじゃない！あの恐ろしい水妖！あの日、あなたたちに依頼した後、不安になったから水の中に入っていった子どもについてまた聞いてまわったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300812,
					"content": "その件ならもう調査してはっきりわかったぞ。それはフレミネだ。魚群もこいつのせいでびっくりして逃げちゃったんだよ。安心しろよ、オイラたちが仕事を終わらせたら、魚群を戻すからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300813,
					"content": "ごめん、ぼくは潜水士なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300814,
					"content": "え？フレミネ？潜水士？いやいや、違うよ？私が聞いたのはそうじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300815,
					"content": "聞いたところ、一ヶ月くらい前に、ある子どもが身体中に重たい貝殻を巻き付けて、この水の中に入っていったんだって…そして二度と戻らなかった…これは絶対水妖が惑わしたせいだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300816,
					"content": "ええっ？な、なにか間違えてないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300817,
					"content": "本当の本当だって！何人かの優秀な漁師にも聞いたんだよ。その子は八歳で、名前はレスコー、レスコー·ドストレ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300818,
					"content": "待って、レスコー·ドストレ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300819,
					"content": "そう、その名前。どうやら祖先がストレという地方から引っ越してきた一族みたい。母親はちょっとばかり名の知れた画商で、父親は早くに亡くなったらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300820,
					"content": "はあ…そんなことがあってから、母親はかなりのショックを受け、病気で起き上がれなくなったみたい。今はもうフォンテーヌ廷を離れたらしく、どこへ行ったかは分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "デラロッシュ"
				},
				{
					"id": 401300821,
					"content": "まさか？レスコー·ドストレ…ジュリア·ドストレ…そんな偶然があるわけないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300822,
					"content": "ジュリア夫人の家に行ってみないとだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "お姉さん、ごめんなさい！ぼくたちは用があってもう行かなきゃいけないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300824,
					"content": "ああうん、分かった…ちょっと様子を見に来ただけだから、無事ならいいんだ。じゃあ私も帰るね、くれぐれも安全に気をつけてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デラロッシュ"
				}
			]
		},
