			"dialogs": [
				{
					"id": 401300501,
					"content": "またここまで来たな。もう「トルクシー」の旅の最終章だ。でも、一番肝心な人がいない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300502,
					"content": "-.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300503
					],
					"speakerTitle": "「トルクシー」"
				},
				{
					"id": 401300503,
					"content": "みんな、そう重くならないで。ジュリア夫人も言っていた、ぼくたちが落ち込んでいたら、患者さんも滅入っちゃうって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300504
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300504,
					"content": "そうだ、オイラも笑わないと！ジュリア夫人には笑ってほしいからな！笑顔でこの冒険を完成させないとだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300505,
					"content": "そうすれば、ジュリア夫人もきっと良くなるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300506,
					"content": "きっと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300507
					]
				},
				{
					"id": 401300507,
					"content": "うん、きっと良くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				}
			]
		},
