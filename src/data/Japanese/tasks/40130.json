			"dialogs": [
				{
					"id": 401300646,
					"content": "三日後、フレミネの拠点にて…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300647
					]
				},
				{
					"id": 401300647,
					"content": "旅人、パイモン、来てくれたんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300648
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300648,
					"content": "フレミネ！こんな急いでオイラたちを呼ぶってことは、なにかジュリア夫人に関する知らせがあったのか？良い知らせじゃないと、オイラは聞かないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300649
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300649,
					"content": "安心して、良い知らせだよ。さっきお医者さんの付き添いのもと、夫人が来てくれたんだ。顔色も良くて、元気そうだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300650
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300650,
					"content": "街に帰って、画展の続きをするつもりらしい。今回は、お医者さんと協力して、孤独病に関する絵本を展示するそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300651
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300651,
					"content": "もちろん『トルクシーの不思議な冒険』と幻想を導く療法のことも含まれてる。自分の経験をもとに、もっと多くの人を助けたいんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300652
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300652,
					"content": "それはよかった、本当に良い知らせだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300653
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300653,
					"content": "うん、そしてこの絵本を受け取って。夫人からあなたたちに。もし、今後誰かが同じような境遇にいたら、これを使って困難を乗り越えてほしいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300654
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300654,
					"content": "え？でもこれは夫人の子どもの物語じゃないか、オイラたちに渡していいのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300655
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300655,
					"content": "複写本だよ。原本はジュリア夫人のところにある。それは夫人にとって、とても意義のあるものだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300656
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300656,
					"content": "ならよかった、へへっ。その意義の中には、オイラたちの努力も含まれてそうだな。今回の幻想冒険が本当に役立つとは思わなかったぜ。幻想は所詮幻想なんじゃないかって心配してたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300657
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300657,
					"content": "パイモン、夫人がなんて言っていたか知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300658
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300658,
					"content": "夫人はね。トルクシーに王冠を被せたとき、素敵なこと——つまり、お子さんが本当に帰ってきて、愛しているよって言ってくれたのが見えたって、そう言っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300659
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300659,
					"content": "そして、その瞬間に子どもとお別れができて、自分も癒やされたかのように、身体中に勇気がみなぎるようになったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300660
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300660,
					"content": "ええ！？ほんとか？でも、それは夫人の幻想の一部なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300661
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300661,
					"content": "でも、幻想が幻想でしかなくて、幻想の世界が全て偽りだとしたら、どうして人に力を与えられるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300662
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300662,
					"content": "だから、幻想は単なる幻想ではない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300663
					]
				},
				{
					"id": 401300663,
					"content": "じゃあ、なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300664
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300664,
					"content": "童話の世界が現実に降りてきたんだ。その瞬間、美しい童話はほんの僅かな間だけ真実となって、現実に影響を及ぼした。きっとそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300665
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300665,
					"content": "あなたもそれを見たよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300666
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300666,
					"content": "そんなわけがないだろ？ありえないぞ。もしそれが本当だとしたら、奇跡じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300667
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300667,
					"content": "そう…奇跡が起きたってことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300668
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300668,
					"content": "ぼくは、窮地に陥った人に、美しいものや奇跡を目にして欲しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				}
			]
		},
