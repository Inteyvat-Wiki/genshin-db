			"dialogs": [
				{
					"id": 401300201,
					"content": "おーい、誰かいるか？ここはジュリア夫人の家か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300202,
					"content": "誰だ？部屋には静養中の患者がいる。用がなければ帰ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300203
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300203,
					"content": "病人って誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300204
					]
				},
				{
					"id": 401300204,
					"content": "しばらく沈黙した後に扉は開かれた。一人の男性が歩いてきて、その目は疑惑で満ちていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300205
					]
				},
				{
					"id": 401300205,
					"content": "ここはジュリア·ドストレの家だ。私はそのかかりつけ医のジャラーカン。さっきの質問はどういう意味だ？他に誰が病気だというのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300206
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300206,
					"content": "ジュリア夫人の子どもだろ？ジュリア夫人が自分で言ったんだ、子どもが孤独病を患ったって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300207,
					"content": "間違ってはない。レスコー坊っちゃんも確かに孤独病を患ったことがある。しかし…まあいい、とにかく坊っちゃんはもういない。今、孤独病は奥様の身を蝕んでいる。あなたたちは…奥様の友人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300208
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300208,
					"content": "しばらく黙り込んだあと、ここ数日間の出来事を話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300209
					]
				},
				{
					"id": 401300209,
					"content": "なるほど、気晴らしがしたいと言っていたこの数日間は、あなたたちと一緒だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300210
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300210,
					"content": "つまり…本当に制御不能型幻想に陥っていたのはジュリア夫人自身だったってこと？だから子どもはまだ生きてると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300211
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300211,
					"content": "そうだ。坊っちゃんが亡くなった日、奥様はちょうど画展の準備をしていた。それは坊っちゃんのために用意していたのだが、準備のせいで、奥様は坊っちゃんの最後の姿を見ることができなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300212
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300212,
					"content": "それが心のわだかまりとなったのか、あるいは旦那様が急逝したとき、孤独病の種がこの家系に埋められたのか…まずは坊っちゃん、次に奥様と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300213
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300213,
					"content": "そんな…でも、ジュリア夫人はなにもかも良さそうに見えたぞ。すごく楽しそうに笑ってたし、ポジティブでいるようにって、オイラたちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300214,
					"content": "それがまさに、幻想と現実を混同させている症状だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300215
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300215,
					"content": "じゃあオイラたちに話してくれた、子どもについてのことは…全部ウソだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300216,
					"content": "いや、本当のことだろう。ただ、それは坊っちゃんが亡くなる前の出来事で、奥様の時間はずっとそこで止まっているということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300217
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300217,
					"content": "だからその後、子どもがまだ生きてる幻想の世界を作り出して、一生懸命子どもの病を治そうと、ぼくたちを訪ねてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300218
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300218,
					"content": "夫人のいまの様子は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300219
					]
				},
				{
					"id": 401300219,
					"content": "ここ最近は気分が良いようで、気晴らしをして帰ってきたときにはいつも鼻歌を歌ってる。それに、幻想を導き孤独病を緩和させる方法について、私と積極的に話し合ったりしてたんだ、昨晩までは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300220
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300220,
					"content": "奥様は坊っちゃんの遺品を一晩中眺めていた。遺言が刻まれた貝殻を見つけてから…再び打ちのめされてしまった。奥様に鎮静剤を出したから、今は休んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300221
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300221,
					"content": "じゃあ、どうしたらいいんだ？なにか手伝えることはあるか？はやくジュリア夫人を助けてやろうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300222,
					"content": "焦らないで、パイモン…これは確かに悲しい知らせだけど、今は冷静にならないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300223
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300223,
					"content": "（どうしよう…早く方法を考えないと…昔の壁炉の家のことを思い出してみよう…子どもたちや…患者さんたち…そしてお医者さん…あっ！そうだ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300224
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300224,
					"content": "ジャラーカンさん、絵本を見ませんでしたか？ジュリア夫人が持って帰ってきたはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300225
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300225,
					"content": "坊主…奥様が言っていた幻想を導く方法を試すのか？分かった、すぐに取ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300226
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300226,
					"content": "医者はすぐに絵本を取ってきて、フレミネに渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300227
					]
				},
				{
					"id": 401300227,
					"content": "間違いない、これだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300228
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300228,
					"content": "絵本と冒険の続きを完成させるつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300229
					]
				},
				{
					"id": 401300229,
					"content": "そう…ジャラーカンさんの話によれば、ぼくたちの冒険はきっと夫人の役に立つはずだ。だからこれを完成させるべきだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300230
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300230,
					"content": "ジュリア夫人に見せてあげないと…お子さんがあの世界でハッピーエンドを迎えたことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300231
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300231,
					"content": "でも…これじゃあもっと現実を受け入れられなくなるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401300232,
					"content": "現実を受け入れる前に、まず現実と向き合わなければならない。奥様は絶望的な感情に押しつぶされ、現実を見る勇気がないんだ。まずはこの状態から抜け出す手助けをするべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300233
					],
					"speakerTitle": "ジャラーカン"
				},
				{
					"id": 401300233,
					"content": "うん。今日まで『トルクシーの不思議な冒険』はジュリア夫人のお子さんを助けるためだと思っていたけど、ジュリア夫人自身を救うためのものだったんだと、今では思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300234
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300234,
					"content": "これを完成させたら、ジュリア夫人にとっての慰めと励ましになるだろう。そうすれば、多少は現実を直視する勇気が出てくるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300235
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401300235,
					"content": "試してみるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300236
					]
				},
				{
					"id": 401300236,
					"content": "善は急げ…今すぐ出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレミネ"
				}
			]
		},
