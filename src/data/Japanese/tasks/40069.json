			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"楓原万葉",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690301,
					"content": "うぅ、帽子が飛んでいってしまうところでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690302
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690302,
					"content": "ふむ？この匂い…拙者たちは璃月辺りの山にいるようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690303
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400690303,
					"content": "暗いところだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690304,
					"content": "みんな待て。聞こえたか…？声がしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4006904,
			"completionStepIds": [
				4006904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006904",
							"2"
						],
						"stepId": 4006904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"竹おじ",
					"吉祥",
					"海おじ",
					"モナ",
					"楓原万葉",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690401,
					"content": "あのなあ、辛炎よ。女子たるものが、あんな野蛮な楽器をやってはいかんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690402
					],
					"speakerTitle": "竹おじ"
				},
				{
					"id": 400690402,
					"content": "辛炎、あんたのお母さんがね、「時間があったら辛炎に刺繍を教えてやって」って。ふふ、こういうのが上品な趣味なのよ。それで、いつおばちゃんのうちに来る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690403
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690403,
					"content": "うるせぇな、道端で弾くなよ！どうしても弾きたいなら、人前に出せるような曲を弾いてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690404
					],
					"speakerTitle": "海おじ"
				},
				{
					"id": 400690404,
					"content": "こ、こいつら、なんてひどいこと言うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690405,
					"content": "はぁ、この人たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690406
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690407
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400690407,
					"content": "ああ——本当にムカつくぞ！なんで言い返さなかったんだよ。おまえのロックの精神はどこにいっちゃったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690408,
					"content": "ハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690409
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690409,
					"content": "こんなセリフを聞いてまだ笑えるのかよ！怒らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690410,
					"content": "こういうのって、初めは確かにムカつくけど、百回も聞かされたらもう怒りも湧いてこないんだ。でもありがとな、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690411
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690411,
					"content": "え…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690412,
					"content": "吉祥おばちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690413
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690413,
					"content": "ええ、おばちゃんはあんたの返事を待っているのよ。今週末はちょうど時間があるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690414
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690414,
					"content": "アタイのことはいいって。そんなことよりおばちゃん、竈の火が付いたままだぞ。スープを火にかけてただろ？あちゃー…ほら、もう焦げちまってるんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690415
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690415,
					"content": "あらあら、大変！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690416
					],
					"speakerTitle": "吉祥"
				},
				{
					"id": 400690416,
					"content": "竹おじ、竹坊がまた外で泥遊びしてたぞ！やれやれ、やめるように竹おじも言ってたのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690417
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690417,
					"content": "なんだと！？あいつ、また俺に内緒でやらかしやがって！後でしっかり言い聞かせてやらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690418
					],
					"speakerTitle": "竹おじ"
				},
				{
					"id": 400690418,
					"content": "ハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690419
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690419,
					"content": "海おじ、すまねーな。アタイは他の場所に行くよ。でも海おじも、ちょっとは流行を追ったほうがいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690420
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690420,
					"content": "何しろ、璃月港で一番有名な役者さんまでもが、アタイのこの「人前に出せない曲」を好いてくれてるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690421
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690421,
					"content": "な、何だと？お、お前、嘘をつくなよ！本当にそうなのか？フン、他の奴に聞いてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690422
					],
					"speakerTitle": "海おじ"
				},
				{
					"id": 400690422,
					"content": "去って行きましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690423
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690423,
					"content": "な。話術と自然な笑顔があれば、ほとんどのトラブルを解決できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690424
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690424,
					"content": "ならばロックの精神は一体どこで使うのでござろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690425
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400690425,
					"content": "アタイのロックの精神は、そんな表面的なものじゃないんだ。人と喧嘩するためになんか使ったら勿体ないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690426
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690426,
					"content": "ロックは革命だ！自分と運命を改革し、臆病さや妥協なんかに別れを告げる。言葉じゃなくて、芸術でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690427
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690427,
					"content": "風や雨の中でも消えない蝋燭の火、洞窟の地下で永久に沸き続けるマグマ…誰にも止められねー気迫、これぞアタイのロックさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690428
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690428,
					"content": "ほら、進もうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690429
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690429,
					"content": "あそこに小道があるぞ。そっちに行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
