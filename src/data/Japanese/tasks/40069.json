			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"辛炎",
					"飛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690601,
					"content": "なあ、あれって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690602,
					"content": "また「扉」ですね。まさか、またさっきのような人が出てくるのではないでしょうね…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690603
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690603,
					"content": "出て来たって朝飯前さ、アタイに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690604
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690604,
					"content": "お姉ちゃん、その髪型は変だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690605
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690605,
					"content": "そうか？アタイはかっこいいと思うけど。もう一度よく見てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690606
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690606,
					"content": "立った二つ結びにとんがった髪飾り。そんなのしてる人いないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690607
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690607,
					"content": "だから変だって言うのは違うぞ。他の人と違うから、きっと印象に残るだろ。そしたら今度また会った時、あんたはアタイのことを覚えていてくれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690608
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690608,
					"content": "うん…確かにそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690609
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690609,
					"content": "髪型や服、それに顔やスタイルは、他の誰かに見せるためだけのものじゃないぞ。自分がしたい格好をしていいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690610
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690610,
					"content": "本当？でももしオレが犬の描いてある服を着たら、きっと「飛は犬みたい」ってからかわれちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690611
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690611,
					"content": "そしたら、そいつらの言うことなんか聞かないことにしようぜ。あんた、犬が好きなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690612
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690612,
					"content": "うん、好き。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690613
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690613,
					"content": "あんたの友達は犬が嫌いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690614
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690614,
					"content": "みんなも好きだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690615
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690615,
					"content": "だったら、あんたの友達もきっとその服を気に入るはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690616
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690616,
					"content": "…わかった。でもお姉ちゃん、なんでみんなに好かれるような髪型をしないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690617
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690617,
					"content": "仕方ないさ、だってアタイはこういう個性的なのが好きだからな。はぁ、それにこの髪を結ったときは、みんなからこんなに嫌われるとは思わなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690618
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690618,
					"content": "なのに変えないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690619
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690619,
					"content": "この髪形こそが、アタイの音楽と生活に合ってるんだ。普段よく見る髪型っていうのはみんな普通すぎて、元気が足りない。それにライブのときに髪が邪魔で頭を振れなくなっちゃうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690620
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690620,
					"content": "嫌われても気にしないさ、アタイは変えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690621
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690621,
					"content": "お姉ちゃんの髪型、友達にも嫌われてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690622
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690622,
					"content": "そんなことないぜ。きれいだってみんな言ってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690623
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690623,
					"content": "…友達はお姉ちゃんの味方なんだな。羨ましい。オレの友達は…オレ一人をここに置き去りにしたんだ。うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690624
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690624,
					"content": "急に泣き出して、どうしたんだ！？何があった？ほら、お姉ちゃんに話してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690625
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690625,
					"content": "ルルとモンちゃんが…オレと遊んでくれない。うぅ…今日は埠頭で会うって約束したのに、二人とも来てくれないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690626
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690626,
					"content": "子供のくせにすっぽかしかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690627,
					"content": "ここで待っててくれ、アタイが探しに行くよ。二人を見つけたら、あんたのところに連れてきてやるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690628
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690628,
					"content": "…うん！ありがとう、お姉ちゃん。髪型が変だなんて、もう言わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690629
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690629,
					"content": "ハハ、気が利くな。じゃあまた後で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
