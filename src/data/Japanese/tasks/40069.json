				"points": []
			},
			"dialogs": [
				{
					"id": 400690801,
					"content": "バカバカ、私たち、サプライズを用意してたのに。結局こっちに来てくれなかった上に、な、泣いたりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690802
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 400690802,
					"content": "ごめん、オレはバカだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690803
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690803,
					"content": "ううん！飛くんはバカじゃない。私たちが悪かったの…飛くんを驚かせたくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690804
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 400690804,
					"content": "飛くん、今日は君の誕生日だから、ボクたちはサプライズで飛くんを驚かせようと、わざと避けてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690805
					],
					"speakerTitle": "モン"
				},
				{
					"id": 400690805,
					"content": "え？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690806
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690806,
					"content": "飛くんのためにハスの花托をたくさんとってきたよ。とっても美味しいんだから。それに、これはボクとルルが書いたお祝いの手紙…字が汚いとか、言いっこなしだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690807
					],
					"speakerTitle": "モン"
				},
				{
					"id": 400690807,
					"content": "ふふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690808
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 400690808,
					"content": "お前ら…へへ、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690809
					],
					"speakerTitle": "飛"
				},
				{
					"id": 400690809,
					"content": "そういうことだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690810,
					"content": "大事なくて、よかったでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690811
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400690811,
					"content": "友達だったら、こういうことをしてもおかしくないんよな。友達がサプライズしてくれたら、アタイだってびっくりするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690812
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690812,
					"content": "サプライズを用意してくれって言いたいんですか？すごい話術ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690813
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690813,
					"content": "え？いやいや違うぞ！ただ感想を言っただけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690814
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690814,
					"content": "分かってますよ。私もちょっと、サプライズで冗談を言ってみただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690815
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400690815,
					"content": "あ…オイラ、お腹が空いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690816,
					"content": "音が大きすぎるでしょ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400690817
					]
				},
				{
					"id": 400690817,
					"content": "確かにそろそろご飯の時間だし、そうだな…アタイのうちで食べていけよ？ここからそんなに離れてないから、歩いていけばすぐだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690818
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690818,
					"content": "幻境にも家があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400690819,
					"content": "あるぜ。さっき見たんだ、この道は現実と同じように、アタイのうちに繋がってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690820
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690820,
					"content": "幻境にいるとはいえ、周りと意見が合わない時や、ライブで失敗して落ち込んだ時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690821
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690821,
					"content": "もし行くべき場所があるとすれば、あそこしかないんだ。だって…人は家に帰るもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4006911,
			"completionStepIds": [
				4006911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006911",
