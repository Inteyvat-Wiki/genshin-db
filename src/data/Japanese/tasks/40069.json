			"dialogs": [
				{
					"id": 400690701,
					"content": "やあ、あんたはモンか？飛って子が埠頭であんたを待ってるぞ。待ちくたびれて泣いちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690702
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400690702,
					"content": "ええ！飛くんのやつ、なんてバカなんだよ。僕たちのとこに来ればいいのに…まあいっか、彼を探しに行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690703
					],
					"speakerTitle": "モン"
				},
				{
					"id": 400690703,
					"content": "行っちゃったぜ、早く追いかけよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
