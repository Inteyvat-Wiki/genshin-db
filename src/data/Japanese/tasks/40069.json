			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"耳を傾ける"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691101,
					"content": "あの鳥たちは山頂にある泉の湧き水を飲んだから、美しい歌を歌えるようになったんだよ。うちに歌うのが好きな人は一人もいないんだから、あんたも歌が上手なわけないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691102
					],
					"speakerTitle": "辛炎の母"
				},
				{
					"id": 400691102,
					"content": "だったらアタイもその水を飲めばいいんだろ？母さん、ちょっと行ってくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4006912,
			"completionStepIds": [
				4006912
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006912",
							"2"
						],
						"stepId": 4006912,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"楓原万葉",
					"モナ",
					"香菱",
					"雲菫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691201,
					"content": "ここだ。さっ、靴はそのままでいいからあがってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691202
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691202,
					"content": "失礼するでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691203
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400691203,
					"content": "椅子もあるんですね。ちょうど座りたいと思っていたところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691204
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400691204,
					"content": "ん？奥の部屋から声がするな…あんたらは休んでてくれ、アタイはちょっと見てくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691205
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691205,
					"content": "明かりも付いてないし、誰もいなさそ…うわぁ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691206
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691206,
					"content": "じゃじゃーん！誕生日おめでとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691207,
					"content": "何してんだよ、あんたら！部屋にいるならちゃんと明かりをつけろって、びっくりしただろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691208
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691208,
					"content": "雲菫の言った通り、本当に驚いてるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691209,
					"content": "せっかくの誕生日ですから、普段とは違うほうがいいかと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691210
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691210,
					"content": "あんたらなぁ、そんな可愛い顔してこんなことするなよな、頼むから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691211
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691211,
					"content": "あら、そのようなことを言われても、私は納得しませんよ。可愛くていい子だからって、いたずらしちゃいけないなんて誰が決めたんです？そうでしょう、香菱さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691212
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691212,
					"content": "そうそう！グゥオパァーだってああ見えて、すっごくすばしっこいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691213
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691213,
					"content": "はいはい、まったく、あんたらには敵わないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691214
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691214,
					"content": "北斗姉さんは今日用事があって来れないから、代わりにプレゼントを渡すようにって頼まれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691215
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691215,
					"content": "はい、これが北斗姉さんからのプレゼント。外国の楽譜と特製の短剣だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691216,
					"content": "辛炎さん、私は家の者に頼んで、金のかんざしと鉄の髪留めを作ってもらいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691217
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691217,
					"content": "鉄の髪留め！？千年もの歴史を持つ鍛造の一族が、このためだけにか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691218
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691218,
					"content": "どうかしましたか？小さな髪留めですが、機能は申し分ないと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691219
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691219,
					"content": "えへへっ、アタシのは違うよ。この前、道端で眼鏡をかけてる鍛冶屋さんに会ったんだけど、その人、まるで石を読めるかのような顔をしててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691220
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691220,
					"content": "で、半信半疑だったんだけど、石選びを手伝ってもらったの。そしたらね、本当に翡翠が出てきたんだよ！へへっ、すぐにその翡翠を飾りに使える大きさに削ってもらって、紐で結んで辛炎にあげる装飾品にしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691221,
					"content": "おぉ、翡翠の首飾りを作ってくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691222
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691222,
					"content": "あっ、首に付けるんじゃなくて、琴に付けるんだ！ほら、いつもその琴を大事にしてるでしょ。だから、綺麗に飾ろうかなと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691223,
					"content": "こんな貴重なプレゼント、使うのがもったいないな、大事にしないと！ありがとな香菱、よく見てるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691224
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691224,
					"content": "ふふっ、香菱さんが気を配るのはいつものことです。ただ、その石を読める人について…もう少し詳しく教えていただけますか。もし面白い話だったら、芝居に取り入れてみようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691225
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691225,
					"content": "アタシもよく知らないんだけど、その人、しばらく病気だったみたい。病気中は頭が混乱してて、何も覚えてないんだって。まるで、自分の体が自分のものじゃないように感じたとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691226
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691226,
					"content": "でもある日、パッと治ったらしいの！それ以来、一目見ると石を読めるようになってたんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691227
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691227,
					"content": "うーん…何だか奇妙な話ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691228
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691228,
					"content": "あっ、それより料理が冷めちゃうよ！早く食べよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691229
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691229,
					"content": "お待ちください。辛炎さん、外国の商人からおまじないを教えてもらいましたよね？前回、私の誕生日の時に教えてくれたものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691230
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691230,
					"content": "ん？ああ、誕生日に願い事をするってやつだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691231
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691231,
					"content": "そうです、それです。外国ではケーキにロウソクを立てて、切り分けるそうですが、私たちは香菱さんの料理を運ぶだけで精一杯でしたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691232
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691232,
					"content": "平気平気、頭の中で想像すりゃいいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691233
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691233,
					"content": "でしたら、「いち、にの、さん」でぜひ願い事をしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691234
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691234,
					"content": "いち——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691235
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691235,
					"content": "にの——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691236
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400691236,
					"content": "さん——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691237
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 400691237,
					"content": "ん——今年は何を願おっかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691238
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691238,
					"content": "アタイの願いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4006913,
			"completionStepIds": [
				4006913
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006913",
							"2"
						],
						"stepId": 4006913,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎",
					"モナ",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691301,
					"content": "あれ、戻って来た？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691302
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691302,
					"content": "どういうことだ？オイラ、ドアの隙間から中を覗いたばっかだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400691303,
					"content": "幻境ってことは、辛炎、先ほどの部屋で何かありましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691304
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400691304,
					"content": "オイラ知ってるぞ！辛炎の誕生日を祝ってくれる友達がいたんだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400691305,
					"content": "それは私も聞こえてましたよ！そうではなくて、彼女自身のことを言っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691306
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400691306,
					"content": "アタイ…？ああ、アタイは願い事をしたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691307
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691307,
					"content": "そう言えば、面白い話だったな。さっきドアを開けた先に、アタイの親友の香菱と雲菫がいたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691308,
						400691309
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691308,
					"content": "彼女たちなら知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400691310
					]
				},
				{
					"id": 400691310,
					"content": "あれは現実ですでに起こったことだ。前回の誕生日のことなんだけど、あいつらがうちに来てアタイを驚かせてな。美味しい料理がいっぱい用意してあって、アタイに願い事をするように言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691311
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691311,
					"content": "辛炎、その願いは何ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691312
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400691312,
					"content": "アタイの願いは——「思いもよらない人と、一緒にライブをしたい」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691313
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691313,
					"content": "思いもよらない人、誰であろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691314
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400691314,
					"content": "それなんだけど、さっきパッと思い浮かんだ人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691315
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400691315,
					"content": "して、その人物とは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691316
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400691316,
					"content": "うん…いや、答えを言う前に、まずは山石を貫く水脈を開通させよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
