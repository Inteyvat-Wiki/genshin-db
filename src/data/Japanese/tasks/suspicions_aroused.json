					}
				]
			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "字がいっぱいで、目が回ってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020502,
					"content": "とにかく…サーチェンは自分の事業を教令院に預けて、研究に出かけたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020503,
					"content": "もし特別に認められる参加者がいたら、賞金だけじゃなくて、自分の事業をあげるとも書いてあるぞ…それって、めちゃくちゃ大金になるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020504,
					"content": "何だって！？そんなうまい話があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020505,
					"content": "サーチェンの資産、か…一生かけても使いきれないだろうな。もし手にすることができたら…借金を返して、新居を買って…それでも数え切れないほどお釣りがくるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020506,
					"content": "そうなれば、アルカサルザライパレスをもう一つ作れる。いや、あれの十倍は大きい宮殿だって——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020507,
					"content": "待てよ…オルモス港の新プロジェクト、あれも橋の改装だったな。最高の効果を出すためには、おそらく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020508,
					"content": "おい、目を覚ませ！それを考えるにはまだ早いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020509,
					"content": "…それもそうだ。当面の急務は優勝して、さっさとここから引っ越すことだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020510,
					"content": "んん？待てよ、資料にメモが挟んであるみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020511,
					"content": "アルハイゼンが書いたのか？あいつの考えを書き留めたものみたいだな…どれどれ。二つの文章に丸が付けられてるぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020512,
					"content": "ひとつは「サーチェン、生死不明」、もうひとつは…「才識の冠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020513,
					"content": "それと…よくわかんない言葉だな。これ、他のところの言葉か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020514,
					"content": "どれどれ…うん？この文字は…そうだな、ちょっと考えさせてくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020515,
					"content": "「大いなる理想では虚無に対抗できないかもしれないが、小さき選択ならそれに対抗できる」。百パーセント正しい保証はないけど、大体そんな意味だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020516,
					"content": "…ん？下にまだ小さな文字があるな…うん…あいつは何が言いたいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020517,
					"content": "この変な文字が読めるなんて、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020518,
					"content": "学生時代、僕たちは共同で課題をやっていたことがあるんだ。テーマは「キングデシェレト文明の古代遺跡における古代文字と建築デザインの方向性についての解読」だった。古代文字については、その時にちょっと勉強してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020519,
					"content": "なるほどな！でも…アルハイゼンが書いたこれは、どういう意味なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020520,
					"content": "さあね。あの男の考えることは、普通の人間には分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020521,
					"content": "…まあ、ここにはもう手がかりはないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020522,
					"content": "アーラヴのほうで進捗があるといいけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "そうだな。早くあの悪いやつらを捕まえてほしいぜ。それまでは…えっと…とりあえず、他を回ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4010206,
			"completionStepIds": [
				4010206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
