			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アーラヴ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-418.417,
							281.227,
							2771.899
						],
						"pointId": 330201419
					},
					{
						"sceneId": 3,
						"position": [
							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "お二方、これはお久しぶりですね。私に何か御用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020202,
					"content": "ディシアとキャンディスから聞いた状況をアーラヴに教えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "サーチェン様の拉致ですか…そんなことを計画している者がいるとは。でもよくよく考えてみれば、意外なことでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020204,
					"content": "学院祭の影響力はどんどん広がってきていますからね。サーチェン様も協賛したということで、沢山の人が彼の名を耳にし、彼を大富豪として見ています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020205,
					"content": "あいつが狙われてるかもって分かってたんなら、人手を増やしてあいつを守ったほうがよかったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020206,
					"content": "実を言いますと、我々にもそのような考えがありました。ただ、サーチェン様はもともと外での調査研究がお好きで、ほとんどスメールシティ内にいないので、誰も彼と連絡を取れなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020207,
					"content": "たった一つの手がかりは、彼が「学院トーナメントが開催されたら、私は毎回一番近い所で観察するつもりだ。私の資産を継ぐにふさわしい者を選び出す」と仰っていたことでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020208,
					"content": "サーチェン様がご自分の仰ったことを守っているなら、彼は今スメールシティ内にいるはずです。エルマイト旅団の者たちもそれを耳にしたからこそ、スメールシティに来たのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020209,
					"content": "じゃあ、あの悪いやつらもサーチェンがどこにいるかまではわかってないんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020210,
					"content": "そのはずです。セノ様はまだ休暇中ですので、この件は私が対処しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020211,
					"content": "安心してください。今のスメールシティで、拉致犯たちによる波風を立たせることなどありません。私には、彼らを探し出す方法があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020212,
					"content": "でも、サーチェン様のことが気になるようでしたら、彼を探してみていただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020213,
					"content": "彼の居場所が早く分かるほど、それだけ早く彼の身の安全を保障できます。マハマトラや三十人団がどれほどすごくても、自分から姿を見せたくない、という人間は守りにくいですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020214,
					"content": "わかった、探してみるぜ。けどどこから探せばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020215,
					"content": "そっちにサーチェンの資料はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "ないですね。サーチェン様は法律や規範に違反するようなことは何一つしていませんので、マハマトラのほうには、彼の情報はあまりありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020217,
					"content": "アルハイゼン様はすでに代理賢者を辞め、書記官の仕事に戻られたと聞いています。彼に聞いてみてはどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401020218,
					"content": "確かにそうだな。じゃあ、いったん会場に戻ってアルハイゼンを探しに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
