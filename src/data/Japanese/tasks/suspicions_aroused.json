			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020601,
					"content": "ノックしても返事がなかったから、家に誰もいないのかと思ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020602,
					"content": "仕方ないんだ。もし僕がノコノコとドアを開けたりして、来たのがアルハイゼンを探しに来た教令院の人だったら、ここに住んでるってことがバレてしまうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020603
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020603,
					"content": "このことになるとやけに慎重だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020604,
					"content": "じゃあ、もしアルハイゼンを探しに来た人がいて、おまえもたまたま家にいたらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020605,
					"content": "自分の部屋にいるだけさ。それに、家に来てまでアルハイゼンを探すやつなんかいない。そんな無駄なことをする人はそういないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020606,
					"content": "そっか。アルハイゼンがどこに行ったか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020607,
					"content": "あいつがか？知るか、好きなところに行ってればいいさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020608,
					"content": "喧嘩したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "喧嘩なんかじゃない。あいつ、口が過ぎるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020610,
					"content": "第二ラウンドで起きたことについてあいつと話してたんだ。最後、僕がくじを引き当てただろう？いい人間にはいい運が回ってくるって証明だ。今の僕は絶好調についているのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020611,
					"content": "そしたら、あいつ…これを聞いたときのあいつの反応を、あなたたちはきっと想像もできないだろうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020641,
					"content": "あいつはこう言ったんだ——いつも自分のほうが先輩だと強調するくせに、問題の対処をする際には先輩としてあるべき姿勢が見受けられない。なら、その先輩というプライドにはなんの意味がある？——先輩のあるべき姿勢ってなんだよ！先輩は先輩だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020642,
					"content": "それに！あいつはこんなことも言った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020612,
					"content": "——君はもう少しよく考えたほうがいい。なぜどのラウンドでも運試しをする？その歳まで生きて、自分の最大のピンチに見向きもしないとは、信じられないな。だってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020613,
					"content": "はは…確かにアルハイゼンの言いそうなことだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020614,
					"content": "もう我慢できない！今回だけじゃないんだ。前回も、前々回もこんな調子だった。あいつとの会話は本当に苛々するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020615,
					"content": "どうせ僕たち、互いのことが気に食わないんだ。なるべく早くここから出ていくよ。今、荷造りしてるところなんだ。あいつのためにものを片付けたり、掃除したりする人なんてもういない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020616,
					"content": "壁の絵も持って行く！今後、アルハイゼンは感性なんてものとはまったく無縁な場所で住むことだな、ハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020617,
					"content": "ちょっと待てよ、引っ越すのか？試合ってまだ終わってないんじゃないのか？どこにそんな金あったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020618,
					"content": "今はもちろんないさ。だから、とりあえず荷物を片付けて、前もって準備をするだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020619,
					"content": "新居の目星はついている。賞金を手に入れたら、すぐにそれを買うんだ。それで片付けた荷物を運び込んだら、せいぜい三日あればここを離れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020620,
					"content": "この目標を実現するために、僕は決めた！例え第三ラウンドで何が起こっても、全力を尽くして優勝を手にするから、見ていてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020621,
					"content": "おう、応援してるぞ。けど…本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020622,
					"content": "ん？僕の何が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020623,
					"content": "レイラがオイラたちに、おまえは時々「自己矛盾」に陥ってるって言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020624,
					"content": "どういう意味だ？あなたたちも僕の性格に問題があるって思ってるってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020625,
					"content": "そうは言ってないぞ！でも考えてみろ、賞金を手に入れるって言ったのはおまえだし、ファルザンからのポイントをやるって提案を断ったのもおまえ、コサックギツネを放っておけなかったのもおまえだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020626,
					"content": "待てよ、そんなのは全部普通のことじゃないか。理由だって前に言ったはずだろう？そうしないと負い目を感じるんだって…どこが矛盾してるって言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020627,
					"content": "なんで負い目を感じるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020629,
					"content": "突然そう聞かれると…そうだな、なんでだろう？多分僕の性格なのかもしれない。そうしないで、万が一悪い結果を呼ぶはめになったら、僕も責任逃れはできないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020630,
					"content": "でも、そんなことばっか考えてると生きるのが大変だぞ。それにおまえがしたことって全部、危険がないわけでもないだろ…例えば砂漠で気絶したりとか…本当にそれでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020631,
					"content": "…簡単には説明できないんだ。いや、僕のことはとりあえずいったん置いとこう。アルハイゼンに何の用だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020632,
					"content": "サーチェンに関する資料を探してほしくて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "サーチェン？最近、あいつがそんな名前を口にしたのを聞いた気がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020634,
					"content": "その時、あいつは資料を一部持って帰ってきてたんだ。ブツブツ言いながら、紙に何か書いたりしてた、僕に暇だったら目を通すように言ってきたけど、読まなかったんだよな。ちょっと待ってくれ、どこにあるか探してみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020635,
					"content": "…これだ。どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020636,
					"content": "うぅ…本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020637,
					"content": "何が？あいつが僕のところからビールを持っていくときはずいぶん慣れてる様子だったけどね。遠慮なんてものは全くなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020638,
					"content": "それに、あいつから見ないかって聞いてきたくらいだ。僕はあのとき必要ないと思ったけど、あいつはそのまま横に置いてった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020639,
					"content": "あいつの習慣からすると、片付けてない資料は読んでいいっていうことさ。気にする必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020640,
					"content": "そうか、だったら安心だな。サーチェンの資料に何が書いてあるか、見てみようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
