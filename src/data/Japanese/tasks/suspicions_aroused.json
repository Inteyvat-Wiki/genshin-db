					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "反応がないな…留守か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020404,
					"content": "（コンコン）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "アルハイゼン、聞こえるか？家にいるのか？ちょっと手伝ってほしいことがあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020406,
					"content": "あなたたちだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401020407,
					"content": "カーヴェ！家にいたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020408,
					"content": "…とにかく入ってよ。今ドアを開ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーヴェ"
				}
			]
		},
		{
			"id": 4010205,
			"completionStepIds": [
				4010205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
