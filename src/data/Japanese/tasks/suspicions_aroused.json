				"points": []
			},
			"dialogs": [
				{
					"id": 401025001,
					"content": "まさか、学院祭の期間中に手を出そうとするやつがいるとはな。サーチェンの財産というのは、ずいぶん魅力的らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401025002,
					"content": "もしいきなり大金が手に入ったら、あんたは何をする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401025003,
					"content": "わかりません…考えたことがありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401025004,
					"content": "じゃあ、いま考えてみろよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401025005,
					"content": "えっと…食べ物を買って、水源を探す…とかでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャンディス"
				}
			]
		},
