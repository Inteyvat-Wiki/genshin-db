				]
			},
			"dialogs": [
				{
					"id": 401020301,
					"content": "ふぅ…ニィロウ、アルハイゼンを見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020302,
					"content": "アルハイゼンさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020303,
					"content": "今ちょっと、ある人の調査中なんだけど、あいつに資料を探してもらいたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020304,
					"content": "そうなんだ…ごめんね、私もどこに行ったかまでは知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020305,
					"content": "試合が終わった後、いつも一番に会場から離れるの。それにアルハイゼンさんは、他人に自分のスケジュールを教えない主義みたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020306,
					"content": "そっか。まあ、あいつは普段からそういう感じだしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020307,
					"content": "うーん…アルハイゼンさんは学院祭にもあまり興味なさそうだったし、この近くには残ってないかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020308,
					"content": "あの人にとって、特別評論員はどっちかと言うと割り当てられた仕事、って感じなんだよね。普段、仕事が終わったらどこに行くか知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020309,
					"content": "酒場？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "うーん…でもまだ試合が一ラウンド残ってるのに、アルハイゼンさんはそんなときにお酒を飲みに行くような人かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401020311,
					"content": "あっ！分かったぞ！家に帰ったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020314,
					"content": "アルハイゼンの家はここからそんなに遠くなかったはずだぞ。あいつん家に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020312,
					"content": "家に帰った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
