			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "おまえ、なにか考えごとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020102,
					"content": "（試合前に見た、白髪の男の人って…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "旅人さん、パイモンさん、やっと会えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020105,
					"content": "あれ、なんかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020106,
					"content": "今回の学院祭…何か変だと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020107,
					"content": "さっきまでキャンディスと一緒にカフェにいたんだけど、いかにも用があってここに来たって風な傭兵を見かけたんだ。あいつら、わざわざ変装までして、買い物に来ただけの観光客を装ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020108,
					"content": "でもどう変装したって、あいつらの体に染みついた血の生臭さは隠せやしない。あのコソコソした様子を見るに、きっとまた拉致とか暗殺みたいなゲスい仕事だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020109,
					"content": "少し聞き耳を立てていたのですが、彼らの目標はどうやら「サーチェン」という人のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020110,
					"content": "サーチェン？開幕式のとき、カリーナが言ってた人のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020111,
					"content": "「才識の冠」と、試合の賞金も全部そいつが提供してくれたって言ってたよな。けど、そいつ自身はずっと顔を見せてないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020112,
					"content": "ふーん、聞いた限りじゃ金持ちみたいだな。それだったらおかしくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020113,
					"content": "ここんとこ、エルマイト旅団のやつらも生計が苦しいからな。傭兵たちの大半は「副業」をしてる。狙いは全部、金や権力を持ってる大物たちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020114,
					"content": "あいつらの言葉を借りれば、一度成功しさえすれば、身代金でしばらく楽な生活ができる、だそうだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020115,
					"content": "ちょうど学院祭の時期ですからね。スメールシティから一気にたくさんの観光客が押し寄せてきたのに乗じて、紛れ込んできたというところでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020116,
					"content": "ディシアと一緒に彼らを捕まえようと思ったのですが、相手の警戒が強くて…理由をつけて逃げられてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020117,
					"content": "シティ内で戦いなんかしたくないだろ。そうじゃなきゃ、すぐにでもやつらを縛り付けてたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020118,
					"content": "こういうのは誰が管轄する決まりなんだ？マハマトラ…？それとも三十人団か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020119,
					"content": "うーん…セノならなんとかしてくれるだろ。とりあえず教令院に戻って、情報をマハマトラに伝えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020120,
					"content": "ディシア、キャンディス！ありがとうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020121,
					"content": "いいえ、私たちもたまたま耳にしただけですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020122,
					"content": "ああ、気にするな。本当にやつらにやられてしまった日には、エルマイト旅団の名がもっと汚れるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020123,
					"content": "それにここはスメールシティだからな、あたしとキャンディスは手を出しにくいんだ。あんたらに任せたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 401020124,
					"content": "もし私たちの助けが必要になったら、いつでもカフェまで探しにいらしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 401020125,
					"content": "さっきなにか考えごとをしてたみたいだったけど、もしかしておまえも学院祭について考えてたのか？ディシアとキャンディスの話を聞いて、オイラも裏になにかあるんじゃないかって気がしてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020126,
					"content": "うーん…こうして考えてたってどうしようもないよな。よし、教令院に行ってマハマトラを探しに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401020103,
					"content": "（第一ラウンドの後に聞いた密談って…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
			"completionStepIds": [
				4010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
