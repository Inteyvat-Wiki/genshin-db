					"nextDialogs": [
						718290704
					]
				},
				{
					"id": 718290704,
					"content": "その…ただ飯食いの、隣で指導してやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290705,
					"content": "ああ。まずは剣で机に置かれた肉の筋を取る。それから細かく潰してひき肉を作る…",
					"roleType": "TALK_ROLE_NPC",
