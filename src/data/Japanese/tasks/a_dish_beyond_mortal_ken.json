			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291402,
					"content": "ほおう、この味…コクがある。そして食感は豆腐みたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291403,
					"content": "見た目もいいし、製作に必要な技術も非常に高度、「野菜に扮した肉」という称号も人目を引く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291404,
					"content": "いい！いいぞ！これならきっと支配人も認めてくれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291405,
					"content": "やるじゃないか、ただ飯食い野郎。こんなレシピを知ってたなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291406,
					"content": "ははっ、当時はこのレシピに凄い剣術が隠されていると思い、日夜研究をしていたほどだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291407,
					"content": "今思えば、当時の私は本当に狂ったように剣の練習をしていたな。ただのレシピに剣術があるわけないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291408,
					"content": "剣の練習をしていたわけは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "正義を貫くためにある人を探していただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291410,
					"content": "凄いことなのに、何でこんな穏やかに話すことができるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291411,
					"content": "ははっ、正義を貫いたあと、ここに来たんだ。支配人に引き取ってもらってからは、ここの暇人になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291412,
					"content": "もう他にやることもなくなり、剣を振るうこともないだろう。これといった特技があるわけでもない…このままここで余生を終えるのもいいかもしれないな。はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291413,
					"content": "ほら、このレシピは君にもあげるよ。時間があれば自分で作ってみるといい。面倒だが、味は美味いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291414,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "ふむ…この料理はここに置こう。支配人が来たらすぐに見せる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291418,
					"content": "それと…おい、ただ飯食い野郎。少しこっちに来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291419,
					"content": "何か用か？もう他に教えてやれるレシピなんてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291420,
					"content": "お前、剣以外は何も特技がないと言ったな？ほら、剣を抜いてみろ、肉の切り方を教えてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291421,
					"content": "肉？それは…ちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291422,
					"content": "早くやれ。まずは肉の切り方、それから料理の方法だ。料理も特技のうちに入るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291423,
					"content": "それってどういう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291424,
					"content": "ふんっ、お前が料理を作れたら、もう俺のところでただ飯を食わずに済むだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718291425,
