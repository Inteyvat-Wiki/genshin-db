			"dialogs": [
				{
					"id": 718291201,
					"content": "それからコンロに火をつけて、さっき取った出汁でひき肉を煮る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291202,
					"content": "いいか、火加減は中火だ。火が弱すぎると熱が通らない、逆に強すぎると肉の形が崩れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718291203,
					"content": "肉を煮るのに専用の出汁が必要なのか。結構費用がかかるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
