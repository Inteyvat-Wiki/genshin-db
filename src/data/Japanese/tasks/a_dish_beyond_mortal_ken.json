		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "おや？珍しい客だね。普段は私とあの料理人しかいないのに、今日は君もいるのか。実に賑やかだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290302,
					"content": "しかしあの料理人、今日は顔色が悪いみたいだが、何か面倒事にでも遭ったのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪",
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "この肉団子はやはり美味い。口の中に入れた瞬間にとろけ、汁も濃厚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290402,
					"content": "ん？中にかにみそが入ってるのか、どうりで旨味が段違いなわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290403,
					"content": "ほら、旅人、君も一つ食べてみてくれ。まずは箸で二つに分けてから、汁をかけてご飯と一緒に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290404,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "たくさん食べておけ。もうすぐ俺はクビになるんだ、もう食べたくても食べられなくなるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290410,
					"content": "ここをクビに？…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290411,
					"content": "おいおい、まさか私のただ飯食いのせいで、支配人に嫌われたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290412,
					"content": "そんなわけないはずだ…私はいつも釣った魚を旅館に送っている。飯代くらいはそれで間に合ってるはず…それに支配人もそこまでケチな人では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290413,
					"content": "よく言うぜ。あれしきの量の魚、お前一人が食っても足りないくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290414,
					"content": "ではいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290415,
					"content": "はぁ…まあいい、教えてやるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290416,
					"content": "良い見た目、美味しさ、高級感、高度な技術、趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290417,
					"content": "はははっ、支配人はこの世に存在しない料理を君に作らせるつもりらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290418,
					"content": "笑ってられるのも今のうちだ。俺がいなくなったらお前はもうただ飯が食えないんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290419,
					"content": "ちょっと笑っただけじゃないか。そんなしかめっ面で何かあったのかと思ったが、こんな事だったとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290420,
					"content": "はぁ…なんで支配人はいきなりこんなことを、まったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290421,
					"content": "ふむ、そう急ぐな。私は料理こそできないが、奇妙なレシピなら知っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290422,
					"content": "当時旅をしていた時、偶然にもある屋敷で奇妙な料理を食べたことがある。「鶏豆花」というらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290423,
					"content": "その料理は、「肉を食べているのに肉は見えず」、食感はまるで豆腐のようにまろやかで濃厚。「野菜に扮した肉」と呼ばれる不思議な料理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290424,
					"content": "私はそれを気に入ってね、レシピをもらったんだ。しかし料理は得意じゃないから…そのレシピは今まで使ったことがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290425,
					"content": "そのレシピ、誰に教わったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "ふむ…簡単に言うと、当時ある一家の手伝いをしたお礼に、食事をご馳走になったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290427,
					"content": "そのレシピを考えた料理人が自信満々に言ってたのを覚えてるよ。この料理を作れる人はほぼいないから、レシピを知られても大丈夫なんだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290429,
					"content": "確かに非常に難しい。あの料理人が言うには、料理の技術以外に、剣術も必要みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290430,
					"content": "チッ、剣術なんて知ったことか。肉なら、俺の刀捌きで十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290431,
					"content": "本当に剣術を使ってひき肉なんて作ろうものなら、まな板が真っ二つになるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290432,
					"content": "あの料理人が言うには、この料理の肝心なところはそのひき肉にあるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290433,
					"content": "巧みな剣術で肉の筋を取り、ひき肉になるように切る。そして刀の背で肉を叩き、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290434,
					"content": "待った。少し待ってくれ…そのレシピ、言うだけ無駄だ。俺は料理人で刀が使えない、お前は刀が使えるが料理ができない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290435,
					"content": "どこに行けば料理ができて刀が使える人に会えるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290436,
					"content": "…目の前にいるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290437,
					"content": "#えっ…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "その通り。料理ができて剣術もできるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290441,
					"content": "#いっそのこと、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}にこの料理を作ってもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290442,
					"content": "でも支配人は言笑に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "いや、支配人は新料理を考えろとだけ言ったんだ。誰が作るかまでは指定してない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290444,
					"content": "料理人、私の言うことに間違いはないかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290445,
					"content": "あっ…ああそうだ！それ、それで間違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290446,
					"content": "だが鶏豆花はどんな食材を使うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290447,
					"content": "食材はあくまでも普通の物だ。鳥肉、ハム、鳥の卵、キンギョソウでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290448,
					"content": "鳥肉とハムは厨房にある。鳥の卵とキンギョソウは…もう使い切った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290449,
					"content": "はぁ、松茸の卵炒めなんて作らなければよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290450,
					"content": "旅人、鳥の卵を1つ、キンギョソウを1つ持ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290451,
					"content": "そうしたら、一緒に鶏豆花とやらを研究してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290452,
					"content": "もちろん…報酬は弾む。このことは頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718290439,
					"content": "確かに料理は少しできるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "剣術にも秀でている、そうだろ？君をよく観察したことがあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290428,
					"content": "きっと難しいんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "詳しいんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "はははっ、これほどの美味、どんなバカにでも美味しいことが分かるだろう。どれ、そこの魚の食べ方も教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 718290407,
					"content": "言笑は一緒に食べないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "俺か？今はやめておこう。支配人に振り回されて食欲もなくなったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "言笑"
				}
			]
		},
