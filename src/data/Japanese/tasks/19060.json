			"trigger": {
				"objectNames": [
					"珊瑚",
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "旅人、君ならきっと真実を見つけることができると信じてるわ。間違いなく鹿野院は何か細工したはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190602902,
					"content": "はぁ…所長も平蔵さんもいい人なんですが、二人一緒になると良いことが起こったためしがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190602903,
					"content": "龍二、ちょっとは大人になりなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
