			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "旅人さん、調査は大変でしょう。僕の分析を信じてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603002,
					"content": "珊瑚所長について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "あれから大変なんですよ！鷹司家は本当にすごい探偵を雇ったものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603004,
					"content": "もうしょっちゅう「龍二事件」の再調査依頼を出しに来るんです。その度に平蔵先輩に止められていましたが、まさか今回は苦情の手紙まで出してくるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603005,
					"content": "平蔵先輩はきっと珊瑚所長を危険に晒したくなくて再調査を止めていたんでしょう。何しろ大物に関する事件ですから、色々と複雑で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603006,
					"content": "珊瑚は探偵所の所長といっても、結局は普通の人なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603007,
					"content": "二人は仲がいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "いえ…会うたびに口喧嘩しているのを見かけますから、いいとは言えません。でも、平蔵先輩は珊瑚と一緒に仕事をしていたらしいのですが、まだ昔の誼を忘れていないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603009,
					"content": "探偵所の収入を増やしてあげるためなのか、取るに足らない事件をあそこに依頼するよう、時々お願いされるんです。",
