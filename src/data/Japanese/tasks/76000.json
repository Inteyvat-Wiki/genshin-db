			"dialogs": [
				{
					"id": 760000601,
					"content": "タンクだらけだぞ！中に入ってるのは…まさかクーヴァキじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000602,
					"content": "ファデュイのやつら、地下深くにこんなものを置いとくなんて。いったい、なにするつもりなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000603,
						760000605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000603,
					"content": "それはもちろん、使うためでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000604
					]
				},
				{
					"id": 760000604,
					"content": "それくらいオイラだってわかるぞ！問題はなにに使うかだろ。お風呂に入るためってわけじゃないだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000607,
					"content": "#{NICKNAME}、とりあえずこの辺りを調べてみようぜ。手がかりがあるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000605,
					"content": "きっと怪しい実験か何かだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000606
					]
				},
				{
					"id": 760000606,
					"content": "うぅ、ファデュイってほんと悪どいやつらだよな！でも、怪しい実験って、いったいなんの実験だ？",
					"roleType": "TALK_ROLE_NPC",
