			"dialogs": [
				{
					"id": 760000201,
					"content": "うーん…この扉、どうやっても開かないぞ。でも、中に何があるのか気になるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000202,
						760000204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000202,
					"content": "別に重要なものとかじゃないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "たしかに場所を考えると、ここに重要な物を置くはずはないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000206,
					"content": "とにかく、なんとかして中に入って確かめてみようぜ！でないと、この先ずっと気になって気持ち悪いからな。お腹いっぱい食べたナド・クライ・ホットドッグが、そのまま消化されないみたいに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000207,
					"content": "扉以外にも入れるルートがあるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760000204,
					"content": "中で怪しい実験でもやってるんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "あ、怪しい実験…！？もしそうなら、さすがに警備が緩すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "パイモン"
				}
			]
		},
