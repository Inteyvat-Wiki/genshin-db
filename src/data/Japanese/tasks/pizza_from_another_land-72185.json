					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "おかえり、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850302,
					"content": "どう、聞いてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850303,
					"content": "お客さんの意見について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "本場の「キノコピザ」か…うん、試してみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850305,
					"content": "必要な材料はチーズにキャベツ、そしてキノコ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850306,
					"content": "他の材料なら店にあるけど、チーズは普段からあまり扱ってないんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850307,
					"content": "旅人、チーズを取ってきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850308,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "じゃあ、頼んだよ。チーズ1つでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850310,
					"content": "普段チーズを使わないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "まったく使わなくはないけど、あまりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850312,
					"content": "この店にはチーズを使う料理が少ないから、在庫も少ないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850313,
					"content": "とにかくお願い旅人、チーズを1つ持ってきてくれるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
