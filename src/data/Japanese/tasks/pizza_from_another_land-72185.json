					"nextDialogs": [
						721850504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850504,
					"content": "このピザ…見た目はいい感じだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850505,
					"content": "手伝ってくれてありがとう、旅人。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850506,
					"content": "あとでこのピザをきちんと味わわせてもらうよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721850507,
					"content": "いい感じだったら…新しい商品として発売できるね。",
