				"points": []
			},
			"dialogs": [
				{
					"id": 721850201,
					"content": "はぁ、この世界に私を満足させることができる斬新な料理はあるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850202,
					"content": "「木南料亭」のピザについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "あっ、あのピザのことね、確かに美味しかったよ。稲妻の特産まで入ってたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850204,
					"content": "でも、前に本場の「キノコピザ」を食べたことあるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850205,
					"content": "私の記憶では、チーズとキャベツとキノコで作ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "松本"
				},
				{
					"id": 721850206,
					"content": "ふふっ、やっぱり異国の食べ物だから、私は本場の特徴を保った方がいいと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "松本"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
