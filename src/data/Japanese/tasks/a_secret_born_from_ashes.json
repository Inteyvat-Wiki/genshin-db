			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティマイオス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290301,
					"content": "ティマイオス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290302,
					"content": "旅人にパイモン、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290303
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290303,
					"content": "ちょっと待って…その何かを企んでるような表情…まさか、まだあのおかしな要求のことを考えてるんじゃないだろうね！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290304
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290304,
					"content": "ティマイオス、オイラたちを手伝ってくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290305,
						400290306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290305,
					"content": "オイラ「たち」じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290307
					]
				},
				{
					"id": 400290307,
					"content": "旅人がいらないって言ってるんだから、いらないだろ…だって、それ本当におかしなものなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290308
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290308,
					"content": "いやだ！あれがないとオイラの夕暮れの実がダメになっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290309,
					"content": "でもこんなものを研究する時間があったら、君のために10回は果物を採れるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290310
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290310,
					"content": "どんなものを研究するんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290311
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290311,
					"content": "ん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290312
					]
				},
				{
					"id": 400290312,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290313
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290313,
					"content": "アルベド先生！ちょうどいいところに！果物をジュースにできて、かつ果物を新鮮な状態で保てる機械が欲しいと言われまして、そんなもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290314
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290314,
					"content": "すごく重要なことなんだ！これが発明できたら、もう果物が腐るのを心配しなくてもいいんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290315,
					"content": "そんなの有り得ないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290316,
						400290317
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 400290316,
					"content": "（……！？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290318,
					"content": "果物をジュースに変えるのは難しくないが、新鮮さを保つのが難点だ。果物を腐らせないようにするだけなら、方法はいくつもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290319
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290319,
					"content": "そうだろ、旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290320
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290320,
					"content": "（！？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290321
					]
				},
				{
					"id": 400290321,
					"content": "アルベドの首…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290322
					]
				},
				{
					"id": 400290322,
					"content": "（印がまた現れた…まさかいたずら？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290323
					]
				},
				{
					"id": 400290323,
					"content": "首？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290324,
					"content": "どうしたんだい？ボクの首に何かあるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290325
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290325,
					"content": "…いや、なんでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290326
					]
				},
				{
					"id": 400290326,
					"content": "その表情、まるでボクが悪質ないたずらでもしたかのようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290327
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290327,
					"content": "（やっぱり、いたずらだった！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290328
					]
				},
				{
					"id": 400290328,
					"content": "アルベド、さっき言った果物を腐らせないようにする方法ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290329,
					"content": "例えば、果物を雪山にある溶けない雪の中に埋める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290330
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290330,
					"content": "それじゃあ食べられないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290331,
					"content": "雪山に住むといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290332
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290332,
					"content": "いやいや、オイラ寒いのが苦手で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290333,
					"content": "もしくは果物をボクに渡して、ボクが雪山に持っていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290334
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290334,
					"content": "だけどキミは寒がりだから、他の人に果物を取りに来てもらうしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290335
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290335,
					"content": "どうやらキミがやってあげるしかないようだ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290336
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290336,
					"content": "それだったら、なんだかいけそうな気がする…じゃあ、そうしようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290337,
					"content": "果物を雪山に埋めれば、確かに日持ちするようになる。だが、発芽して木になる可能性もないとは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290338
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290338,
					"content": "もしかすると、今度キミが来た時は、その夕暮れの実が果樹園になっているかもしれない。それらの木に水や肥料を与え、実がなれば新しい夕暮れの実を手に入れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290339
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290339,
					"content": "えっ——！？いやだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290340,
					"content": "それだと木を育てることになるから、まるでオイラたち庭師みたいじゃないか？本末転倒だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290341,
					"content": "そうかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290342
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290342,
					"content": "ボクは、庭師になるのも、悪くないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290343
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290343,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290344
					]
				},
				{
					"id": 400290344,
					"content": "（庭師…ね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				},
				{
					"id": 400290345,
					"content": "（でも、まさかアルベドがこんな冗談を言うなんて。もしかして…あの印の意味を気にしてないのかな？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290346
					]
				},
				{
					"id": 400290346,
					"content": "アルベド！なんでオイラの超甘い夕暮れの実を狙ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290347,
					"content": "おや？そんなに気になるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290348
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290348,
					"content": "もちろんだ！あれはせっかく見つけたすっごくす～っごく甘い夕暮れの実なんだぞ、おまえに渡すもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290349,
					"content": "ふむ、ただの夕暮れの実じゃないか。キミは果物をたくさん持っていないから、そのようなことを気にしてしまうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290350
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290350,
					"content": "もし懐にたくさん持っていて、心が満たされていれば、簡単にそのような感情に陥ることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290351
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290351,
					"content": "えっ？そうなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290352
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290352,
					"content": "（…なるほど、そうだったんだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400290317,
					"content": "（待って、アルベドの首！？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290306,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は別にいらない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				}
