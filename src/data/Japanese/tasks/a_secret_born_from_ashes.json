			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290101,
					"content": "アルベド！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290102,
					"content": "旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290103
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290103,
					"content": "どうやら、物語は思いついたらしいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290104,
					"content": "そうだぞ、おまえは？もう少し時間が必要か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290105,
					"content": "いや、ボクもすでに思いついている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290106,
					"content": "先着順で、オイラが先に言うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290107,
					"content": "いいよ、構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290108
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290108,
					"content": "じゃあ始めるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290109,
					"content": "むかしむかし、あるところに邪悪な学者がいて、山の上でトリックフラワーを改造していました。それらのトリックフラワーは痛みを抱えながら人間の姿になり、山道の脇で通行人を待ち構えていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290110,
					"content": "誰かに尋ねられると、それらは相手にこう質問をします。私は誰？あなたは誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290111,
					"content": "もし答えを間違えれば…わぁっ！という声と共に食べられてしまうのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290112,
					"content": "うん、怖いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290113
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290113,
					"content": "パイモン怖いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290114
					]
				},
				{
					"id": 400290114,
					"content": "なんだよ、全然怖がってないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290115,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が屈強だからかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290116
					]
				},
				{
					"id": 400290116,
					"content": "オイラのダメ出しするなよ！不満なら自分で考えればいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290117,
					"content": "じゃあ、ホラー要素を入れる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290118,
						400290119
					]
				},
				{
					"id": 400290118,
					"content": "トリックフラワーが人を食べた後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				},
				{
					"id": 400290120,
					"content": "つまり、加害者であるトリックフラワーが、被害者に完全に取って代わるということだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290121
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290121,
					"content": "しかも、その身分を利用する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290122
					]
				},
				{
					"id": 400290122,
					"content": "じゃあ、トリックフラワーが城内に入るのか！？一般人の姿で家に帰って、そいつの家族を全員食べちゃう…うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290123,
					"content": "オイラが始めた話なのに、自分でも怖いって思えてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290124,
					"content": "悪くない物語だ。記録してもいいかい？今度誰かと雑談する時、使えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290125
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290125,
					"content": "驚かすために使うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290126,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290127
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290127,
					"content": "いじわるなやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290128,
					"content": "アルベドはどんな物語を考えたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290129
					]
				},
				{
					"id": 400290129,
					"content": "ボクの物語はキミのよりも少し長いものだ。話は、とある錬金術師から始まる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290130,
					"content": "偉大なる錬金術師は、ホムンクルス一号を創造した。一号は彼女の誇りと共に、一般人に完璧に紛れ込んだ。自分たちのそばにいる友人が人造人間だとは、誰も思わなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290131
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290131,
					"content": "しかし、一号は知らなかった。彼が生まれるまで、錬金術師が幾度も実験を繰り返していたことを。失敗した欠陥品は放棄されたのだが、彼は死んでいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290132
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290132,
					"content": "失敗作二号は巨龍の腹の中に飲み込まれ、龍と共に雪山に残った。何年も後に、神秘的な龍の力によって目覚めるまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290133
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290133,
					"content": "彼は雪山で様々な人を見た。そして、その人々と溶け込む一号のことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290134
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290134,
					"content": "二号は思いもしなかった。彼らのような実験品が、すべての人の目を完璧に騙せていることを。人々は一号を友人として受け入れ、親しみを込めて彼の名前を呼んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290135
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290135,
					"content": "それこそが二号の望んでいたものだった。だからこそ、二号は一号に取って代わろうとした、その幸せな者になるために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290136
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290136,
					"content": "うぅ…オイラ、なんか急に寒くなってきたぞ、こわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290137,
					"content": "二号は自身の計画を練った。一号の書籍とノートを盗み、一号が錬金術師から受け継いだ知識を研究した。彼は賢く、驚異的なスピードで学んでいった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290138
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290138,
					"content": "その後、彼は自身の元の顔を変え、一号と完全に同じ姿となる。それから擬態能力のある雪山植物を発見すると、龍血と錬金術をもって改造した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290139
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290139,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290140
					]
				},
				{
					"id": 400290140,
					"content": "二号は自身を一号とまったく同じ姿にし、さらには三つ目の個体——三号を作り出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290141
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290141,
					"content": "えっ！？三つ目！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290142,
					"content": "しかし、一号との間には違いがあった。二号は正真正銘の完璧な者になりたかったんだ。そのため、彼は自身と三号の首から欠陥の印を消した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290143
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290143,
					"content": "わざと…消した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290144
					]
				},
				{
					"id": 400290144,
					"content": "ボクが思うに、印を消したのは無意識の行動だったのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290145
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290145,
					"content": "彼は完璧な者になりたいと渇望するあまり忘れていたのだろう、人間とは本来、不完全であることで鮮やかな活気を放つということを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290146
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290146,
					"content": "二号の計画は綿密なものだった。三号が注意を引き、一号が三号を片付けるのを待つ。そうすれば、脅威が去ったと勘違いした一号は、きっと隙を見せるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290147
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290147,
					"content": "一号が一人になった時こそ、二号が動く絶好の機会。一号を排除すれば、彼は唯一の存在になれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290148
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290148,
					"content": "彼は知らず知らずのうちに、すべての人の記憶に存在する一号に取って代わるだろう。一号の身分、住居、衣服、宝剣、名前、そして友人さえも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290149
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290149,
					"content": "しかし人々は知らない、昨日と今日で会ったのが別人だということに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290150
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290150,
					"content": "こ、怖いぞ…オイラもう人を信じるのをやめよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290151,
					"content": "だが二号の計画が実行される前に、とある特別な見知らぬ者が現れた。二号はその者との接触を試みたが、その者が自分と一号の違いを微かに感じ取れることに気付く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290152
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290152,
					"content": "ごっくり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290153,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290154
					]
				},
				{
					"id": 400290154,
					"content": "どうしたのかな？怖いのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290155
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290155,
					"content": "そのあとは？その見知らぬやつはどうなったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290156,
					"content": "もちろん、二号の計画の一環に加えられた。二号にとって、排除すべき者がもう一人増えたことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290157
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290157,
					"content": "庭にある三つのバラのように、見た目はまったく同じだが、三つの中の一つだけが毒のない良質品で、残りの二つが毒のある劣等品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290158
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290158,
					"content": "そしてこの世界において、それらの世話をする庭師のみが、どれが良質品かを見極めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290159
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290159,
					"content": "人々は毒を持つ植物を嫌う、そのため完璧なバラのみが高価で売れるんだ。劣等品は自身に価値がない事実を隠すため、毒で庭師を排除しようとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290160
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290160,
					"content": "二号もそう考えていた。だから暗闇に隠れてじっと待った。もう少しすれば、チャンスが訪れる。正真正銘の「人間」になるチャンスが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290161
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290161,
					"content": "（これは物語じゃない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290162
					]
				},
				{
					"id": 400290162,
					"content": "（これは過去に起きた事。アルベドが言いたいのは、この残酷で不思議な出来事の真相。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290163
					]
				},
				{
					"id": 400290163,
					"content": "なんか暗い物語だな、そのあとはどうなったんだ？二号は成功したのか？オイラもう考えるのも怖いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290164,
					"content": "物語はあくまでも物語だ、本当のことにはならない。二号はこの物語で成功することができなかった。だが雪山では、キミたちも警戒を怠ってはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290165
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290165,
					"content": "ドゥリンの力と血肉によって変異したモノは、同じくレインドットの創造物とも言える。ボクとなんら変わりはない。キミたちも、そういった化け物には気をつけるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290166
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290166,
					"content": "#アルベドは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の友達、化け物なんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290167
					]
				},
				{
					"id": 400290167,
					"content": "そう言ってくれて嬉しいよ。いいんだ、ボクは自分の素性を分かっている。お互いに、このテイワット大陸では異質な存在だ。ボクはキミの前なら、本当の自分を隠す必要はないと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290168
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290168,
					"content": "ただ、時に錬金術がこのように偉大な学問であることを思うと、どうしようもなく無力に感じる時がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290169
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290169,
					"content": "大地に足を踏み入れる生命の一つとして、運命の掌握を渇望し、創造を渇望する我々は、いったいどれほど傲慢なのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290170
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290170,
					"content": "旅人、創造とは傲慢な行いなのだろうか？もし違うのなら、ボクたちはなぜ、ボクたちを支配し創造するものを「神」と呼ぶのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290171
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290171,
					"content": "もし違っていないのなら、ボクたちは一体なんの資格があって「創造者」などと主張するのか。ボクたちの畏敬と尊重の念は、いったいどの程度まで持つべきで、どのように使えばいいんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290172
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290172,
					"content": "偽物を斬った時、辛くなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290173
					]
				},
				{
					"id": 400290173,
					"content": "別段、特別な感覚はなかった。だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290174
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290174,
					"content": "…たまにこのことを思い出すと、少し悲しく感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290175
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290175,
					"content": "アルベド…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290176,
					"content": "旅人——！ここにいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290177
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290177,
					"content": "あれ、アンバーの声だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290178
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290178,
					"content": "やっぱりここにいたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290179
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290179,
					"content": "旅人、わたしたちサイリュスさんに言われて来たの。麓の拠点で大事なことがあるから、あんたもそこに行って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290180
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290180,
					"content": "ウィンターキャンプもそろそろ終わりを迎えるわ、名目上の教官であってもきちんと配置につかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290181
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290181,
					"content": "じゃあ行ってくる。アルベド、またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290182
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290182,
					"content": "ああ、行ってくるといい。ボクはまだここで用事がある、今回は下山に付き合えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290183
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 400290183,
					"content": "大丈夫、ここ最近は下山もとても順調だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290184
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290184,
					"content": "それじゃ準備ができたら出発しましょう。拠点の人たちを待たせたら悪いわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290119,
					"content": "その人間の姿になる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				}
			]
		},
		{
			"id": 4002902,
			"completionStepIds": [
				4002904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002904",
							"2"
						],
						"stepId": 4002904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サイリュス",
					"ジョエル",
					"うっかりパラド",
					"ジョセフ",
					"ベネット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290201,
					"content": "あれ？この人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290202,
						400290203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290202,
					"content": "まさかジョエルのお父さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				},
				{
					"id": 400290204,
					"content": "わたしから紹介するね、この方はジョセフさんで、ジョエルのお父さんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290205
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290205,
					"content": "お父さん！この人がさっき話した旅人さんだよ。ボクのために色々手伝ってくれたんだ。雪だるまも一緒に作ってくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290206
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290206,
					"content": "ジョエルから話は聞いたよ。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290207,
						400290208
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290207,
					"content": "再会できてよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290209,
					"content": "そうだな、本当によかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290210,
					"content": "待てよ、なんでサイリュス会長がこっそり涙を流してるんだ。それにパラドもいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290211,
					"content": "今回はパラドのおかげなの！パラド、自分から話して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290212
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290212,
					"content": "コホンッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290213
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290213,
					"content": "あれは天気の良い日だった。俺はなんだか運気が上がりそうな予感がして、自分の理念を信じ、危険な場所に向かったんだ。危険な場所にはお宝があると考えたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290214
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290214,
					"content": "なんだか、出だしから妄想じみてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290215,
					"content": "だけど、グループから離れてまだ少ししか経っていないというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290216
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290216,
					"content": "うっかり足を踏み外して、崖から転がり落ちてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290217
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290217,
					"content": "うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290218
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290218,
					"content": "（もしかしてオレと山の上で会ったから、悪い運が移ったんじゃ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290219
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290219,
					"content": "俺は普段なら行かないような場所まで転がった…しかもケガをしてしまって、自分の運の悪さを嘆いたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290220
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290220,
					"content": "（うぅ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290221
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290221,
					"content": "でもその後、音を聞いて駆けつけて来たジョセフさんに会ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290222
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290222,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290223
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290223,
					"content": "うわっ、思いもよらない結果に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290224,
					"content": "俺は最初、彼をイベントに参加しに来た冒険者協会の人だと思ったんだ。けど話をしていくうちに、彼が多くのことを覚えてないことと、自分の名前すら知らないことに気づいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290225
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290225,
					"content": "だけど雪山は寒すぎて、そんな細かいことを考えてる余裕がなかった。だから話は拠点に戻ってからにしようって彼に伝えたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290226
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290226,
					"content": "拠点に戻ると、ジョエルの姿が見えた。ジョエルが彼を見るとまるで凍り付いたかのように固まって、それから大声でこう叫んだ「お父さん！」と。彼はその時に色んなことを思い出したらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290227
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290227,
					"content": "今でもまだ記憶が完全に復活していないが、ジョエルや妻のことは…この二人だけは…絶対に忘れはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290228
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290228,
					"content": "お父さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290229
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290229,
					"content": "ジョエル、お父さんはここだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290230
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290230,
					"content": "ジョセフさん、本当に他のことを思い出せないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290231,
					"content": "『イノシシプリンセス』、それと雪山でエサをあげた狐たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290232,
					"content": "すまない、そのほかは覚えがない。頭にケガを負ったせいかもしれない。だがそれすらも分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290233
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290233,
					"content": "私が目を覚ました時、体中血まみれだった。荷物も失くしてしまい、身分を証明するものもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290234
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290234,
					"content": "仕方なく洞窟に入り、落ち着いてゆっくりとケガが治るのを待ったよ。足のケガが良くなってからは、狩りの本能を頼りに生き延びてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290235
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290235,
					"content": "お父さん…本当に心配したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290236
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290236,
					"content": "大丈夫だジョエル、泣くな。お父さんはもうどこにも行かない、ずっとお前のそばにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290237
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290237,
					"content": "うぅ…よかったな、本当によかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290238
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290238,
					"content": "これでよし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290239
					]
				},
				{
					"id": 400290239,
					"content": "そういえば、俺は山でベネットに会ってから運が悪くなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290240
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290240,
					"content": "それはオレも分かってる！はぁ…オレは…本当に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290241
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290241,
					"content": "いや、そうじゃなくて。俺が言いたいのは、それがなかったら、こんな広い雪山の中でジョセフさんに会えなかったって言ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290242
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290242,
					"content": "それに、俺たちは無事に帰って来れただろ？だから自分を責めないでくれ。運も極限まで悪くなれば、奇跡を引き起こすかもしれないってことだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290243
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290243,
					"content": "…パラド…ははっ、お前ってやつは、いつからそんな口が上手になったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290244
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400290244,
					"content": "えっ？そうかな？ほ、本当のことを言っただけだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290245
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290245,
					"content": "#あっ、そうだ。ボク、旅人の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}とサイリュスおじさん、それからエウルアお姉ちゃんとアンバーお姉ちゃんにお礼を言わなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290246
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290246,
					"content": "ボクと一緒にいてくれてありがとう。ボク、みんなといた時間をずっと大切にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290247
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290247,
					"content": "でも、雪だるまは雪山を離れたら溶けちゃうよね。連れて行けない、残念だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290248
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290248,
					"content": "…それなら私に方法があるわ。ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290249
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290249,
					"content": "えっ？エウルア？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290250,
					"content": "…これでよし。ジョエル、これを受け取って。これは堅氷の粉よ、これを君の雪だるまに加えれば、永遠に溶けることはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290251
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290251,
					"content": "わぁ！ホント？すごいよ！エウルアお姉ちゃん本当にすごい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290252
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290252,
					"content": "お父さん、ボク、溶けない雪だるまを手に入れたよ！やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290253
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290253,
					"content": "本当に、皆さんには…どう感謝を伝えればいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290254,
						400290255
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290254,
					"content": "気にしないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290256,
					"content": "皆さん、本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290257
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290257,
					"content": "お父さん、一緒に雪だるまを運ぼうよ、今すぐ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290258
					],
					"speakerTitle": "ジョエル"
				},
				{
					"id": 400290258,
					"content": "ああ、いいよ。それでは皆さん、私はジョエルに付き添います。また今度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290259
					],
					"speakerTitle": "ジョセフ"
				},
				{
					"id": 400290259,
					"content": "よかった、よかった…俺とパラドも、冒険途中の規律問題について話し合ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290260
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 400290260,
					"content": "えっ？サ、サイリュス会長…俺は手柄を立てたから、今回は見逃して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290261
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 400290261,
					"content": "みんなじゃあな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290262,
					"content": "そうだ、君とアンバーにもこれを作ったから、受け取ってちょうだい。冬の記念品と思って取っておくといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290263
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290263,
					"content": "本当にいいの？これってエウルアにとって、とても重要なものなんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290264
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 400290264,
					"content": "アンバー、こんな時はそんなこと言わないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290265
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290265,
					"content": "わぁ、これでオイラたちの雪だるまも溶けないな。やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290266,
						400290267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290266,
					"content": "ありがとう、エウルア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290268,
					"content": "…遠慮しないで。それと、きちんと保管しておきなさいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290269
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290269,
					"content": "それじゃ、私とアンバーはまだ処理することがあるから、先に失礼するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290270
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 400290270,
					"content": "おう！またな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290271
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290271,
					"content": "行っちゃったな、なんだかみんな、やることがあるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290272
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290272,
					"content": "あっ！そういえば、オイラたちこんなに長く雪山にいたのに果物をジュースにして新鮮なままにできる装置を、アルベドに作ってもらうの忘れてた…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290273
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290273,
					"content": "やっぱりティマイオスになんとかしてもらうか、あいつはお人よしだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400290267,
					"content": "大事にする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290255,
					"content": "みんな喜んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290208,
					"content": "無事でよかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290203,
					"content": "大きなジョエルだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				}
			]
		},
		{
			"id": 4002903,
