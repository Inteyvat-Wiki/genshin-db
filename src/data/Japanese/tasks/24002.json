			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イサドラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "あれ？どこにいったのかしら？まずいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020102,
					"content": "もう一回書くなんて絶対無理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020103,
					"content": "何か失くしちゃったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "ええ、本当に私が失くしただけなら助かるのですが…私はポジティブですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020105,
					"content": "それって…ポジティブって言える？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "はは…私が探していたのは半年間のオフィスの会計帳簿なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020108,
					"content": "すぐにカイザーさんに提出しなければいけないというのに、なんと五ページ分も抜けていることに気が付きました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020109,
					"content": "しかも、その五ページにはそれぞれ違う月の、かなりの量の支出の内訳が書かれていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020110,
					"content": "その数ヶ月分の請求書がないことに、ついさっき最終チェックをしていて気が付いたんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020111,
					"content": "それがもし不注意で失くしたのではなく、最初から作成していなかったとしたら…私はどうやって経費の総額を計算したんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020112,
					"content": "ううっ…もうこれ以上考えるのは怖い…もしも、私のミスで漏れていたら、きっとカドメさんに過去十年分の帳簿をもう一回チェックさせられます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020113,
					"content": "すごく深刻な事態みたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "そうなんです。もしそれらの請求書が会計から漏れたり、紛失したままだったら、来月にはかなりの部署が資金問題で大騒ぎになるでしょうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020115,
					"content": "本当に困りました…昨日は徹夜してまで帳簿作りを終わらせて、それで今朝パレ·メルモニアに持ってきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020116,
					"content": "でもそろそろ着くという頃にカモメの群れに驚いて、つい手元が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020117,
					"content": "はぁ、その時に失くしてしまったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020118,
					"content": "探してあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "手伝っていただけるんですか？それは助かります…！では、道に沿って探してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020121,
					"content": "特に機密情報の書かれた書類ではありませんから、見つかったら安心して拾ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020122,
					"content": "あ、そうだ！来る時に、警官のマーナさんにも会ったんです。彼女がカモメたちを追い払ってくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020123,
					"content": "彼女に請求書を見ていないか聞いてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020119,
					"content": "一緒に探そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "ものを失くしたのが「いいこと」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
		{
