				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "私の探していた書類です…！全部そろっています…本当によかった…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020402,
					"content": "どうして帳簿作成をカフェなんかで…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "そ、それは、正確に計上するためには、たくさんのコーヒーを飲まなければいけませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020404,
					"content": "これはパレ·メルモニアのすべての部署の経費請求書なんですよ。本来なら五人分の作業です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020405,
					"content": "でも、私以外の人はみんな別の部署に呼ばれて、外まわりに行ってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020406,
					"content": "経費審査の時期だというのに、帳簿作成に当たっているのはオフィスで私一人だけ。もう何日も寝てないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020407,
					"content": "計上だけでなく、チェック作業まで全部任されて…目がすっごくしぱしぱします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020408,
					"content": "とにかく、帳簿が見つかってよかったね。イサドラさん、パレ·メルモニアまで送ってあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "マーナ"
				},
				{
					"id": 240020409,
					"content": "ありがとうございます。はぁ、マーナさん…この三か月で私が出会った優しい人は、あなたと旅人さんの二人だけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020410,
					"content": "他のみんなは私に怒鳴ったり、仕事を催促したりするばかりで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "イサドラ"
				},
				{
					"id": 240020411,
					"content": "いえ…愚痴をこぼす暇なんかありません。早く仕事に戻らないと、またカイザーさんにうるさく言われます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イサドラ"
				}
			]
		}
	]
}