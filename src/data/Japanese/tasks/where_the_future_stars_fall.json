			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "バヌと会話する",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7367501,
						0
					],
