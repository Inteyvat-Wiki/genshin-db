	],
	"talks": [
		{
			"id": 7367501,
			"completionStepIds": [
				7367501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367501",
							"2"
						],
						"stepId": 7367501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バヌ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736750101,
					"content": "わぁ、やった！エルマイト旅団でも宝盗団でもない、まともな格好をした知らない人だ。このチャンス、逃さないようにしなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750102
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750102,
					"content": "あの、その…「道ゆくそこのお方、どうか足を止めてください！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750103,
						736750104
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750103,
					"content": "はい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				},
				{
					"id": 736750105,
					"content": "「初めまして、カッコ、相手の性別に応じてミスターかミスを選ぶ、カッコ閉じ。突然申し訳ありません、お忙しいところ恐縮ですがお時間をいただけるなら…ええと…お願いを聞いていただけますか」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750106
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750106,
					"content": "カ、カッコ閉じ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736750107,
					"content": "ダメダメ、口をはさまないで。でないと次のセリフを忘れちゃう。次は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750108
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750108,
					"content": "「カッコ、直面している問題を簡潔な言葉で説明し…礼儀正しく相手に協力を求め、それから丁重に相手に感謝を表す、カッコ閉じ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750109
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750109,
					"content": "最後の文は——「カッコ、例、カッコ閉じ。寛大なお心遣いに感謝申し上げます。このご恩は一生忘れません」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750110
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750110,
					"content": "「また、お骨折り頂いたことには十分な報酬をお支払いしたいと思っております。ですからこのお願いについて何卒お考えください」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750111
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750111,
					"content": "ふー、一文字も間違えずに暗唱できたから、これで大丈夫かな。じゃあ、未来星を探す件はお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750112
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750112,
					"content": "オイラたちに依頼があるみたいだけど、言ってることがさっぱり分からないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736750113,
					"content": "どこが問題なの？『遊学者が知っておくべき50のこと』には、人にお願いする時こう言うように書いてあったよ。問題なんてあるはずないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750114,
						736750116
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750114,
					"content": "問題だらけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750115
					]
				},
				{
					"id": 736750115,
					"content": "そうなの？ちょ、ちょっと待って、「問題だらけ」の場合は、どの段落を読めばいいか探してみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750118,
					"content": "女の子はポケットから『遊学者が知っておくべき50のこと』という本を取り出すと、慌ててページをめくった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750119
					]
				},
				{
					"id": 736750119,
					"content": "う～ん、そんなこと書いてない。でもシャルマは問題があった時、この本をめくればいいって言ってたのになぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750120
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750120,
					"content": "混乱してるけど、様子を見る限り、困ったことがあって助けを求めてるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736750121,
					"content": "本が役に立たない以上、自分の言葉で自分が直面している問題を話したほうがいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736750122,
					"content": "えっとね、私はバヌっていうんだけど、地図を頼りに未来星を探してここまで来たんだ。未来星は全部で六つあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750123
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750123,
					"content": "六つの未来星を全部見つけると、大未来星を召喚できるの。大未来星はとってもすごいんだよ。私の目標は大未来星を召喚することなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750124
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750124,
					"content": "ああ、さっき言ってた「未来星を探す」ってのはそのことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736750125,
					"content": "うん、未来星の設定はだいたいそんなとこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750126,
						736750128
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750126,
					"content": "設定？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750127
					]
				},
				{
					"id": 736750127,
					"content": "そうよ。私が普段読んでいるものより、この設定のほうがわかりやすいと思うの。でも簡単すぎて面白くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750130,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750131
					]
				},
				{
					"id": 736750131,
					"content": "それから…この設定じゃ曖昧すぎて、どうやって未来星を探せばいいのか説明してないでしょ。その問題を解決するために、追加設定を考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750132
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750132,
					"content": "女の子は背後の草むらから奇妙な物体を取り出した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736750133
					]
				},
				{
					"id": 736750133,
					"content": "そこでこれが重要なアイテムになるの。これは…えーと…「バヌの智慧」でいいかな。これが未来星の位置を指し示してくれるの。すごいでしょ、へへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750134
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750134,
					"content": "この名前、すっごくカッコイイよね！でもこれって高すぎるし、しかも重いから、私には持てないんだ。カッコ悪くなっちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750135
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750135,
					"content": "そこで手伝ってもらいたいの。あなたたちなら持てるでしょ？これを使って未来星を見つけてもらえないかな？大未来星を召喚できたら、報酬はたんまり払うから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750136,
						736750137
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750136,
					"content": "それが依頼なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750138,
					"content": "あなたたちに会う前に、他の人に手伝ってもらおうとしたんだけど。でも未来星の話を聞くとみんな変な顔をして、それ以上私の話を聞いてくれなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750139
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750139,
					"content": "みんな「でたらめ言ってないで、おとなしくお家に帰りなさい」って言うんだよ。ほんと頭にきちゃう！私は家の人に内緒で遊びに出てきたガキんちょじゃないんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750140
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750140,
					"content": "大人たちはいつもそう。私が子どもだからって、すぐでたらめ言ってるって決めつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750141
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750141,
					"content": "でも未来星は実在するの！私の空想じゃないんだから。その…えーと…「バヌの智慧」を持って探せば、嘘かどうかわかるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750142
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750142,
					"content": "もし、あなたたちも手伝ってくれないなら…はぁ、もう少し待ってみる。次に出会った人なら、私の話を聞いてくれるかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750143
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750143,
					"content": "分かった、やってみてもいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750144
					]
				},
				{
					"id": 736750144,
					"content": "#信じてくれるの！？よかった、{M#お兄さん}{F#お姉さん}、この「バヌの智慧」を持って行って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750145
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750145,
					"content": "覚えておいて。「バヌの智慧」は一度使ったらしばらく休ませないといけないの。そうしないと、再び未来星の位置を指し示せないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750146
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750146,
					"content": "それから、この『遊学者が知っておくべき50のこと』も持って行って。この本の地図に未来星の位置をマークしておいたから、それに従って探せば大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750147
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750147,
					"content": "未来星を六つ全部見つけたら私のところに来てね。そうしたら、あなたたちを連れて大未来星を探しに行くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750137,
					"content": "ちょっと考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750138
					]
				},
				{
					"id": 736750128,
					"content": "それはまた何かの本に書いてあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750129
					]
				},
				{
					"id": 736750129,
					"content": "あっ、この設定のことなら、その場で作ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750130
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750116,
					"content": "どんな問題に直面しているのか言ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750117
					]
				},
				{
					"id": 736750117,
					"content": "そうなの？ちょ、ちょっと待って、「どんな問題に直面しているのか言ってない」場合は、どの段落を読めばいいか探してみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736750118
					],
					"speakerTitle": "バヌ"
				},
				{
					"id": 736750104,
					"content": "何か用？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736750105
					]
				}
			]
		}
	]
}