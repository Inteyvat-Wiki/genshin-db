{
	"id": 73675,
	"type": "WQ",
	"name": "未来星が落ちし場所",
	"description": "少女バヌが野外で一人何かを探している…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5096,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
