				"points": []
			},
			"dialogs": [
				{
					"id": 710410401,
					"content": "ここです、先輩。コホンッ…あいにく、扉に鍵がかかっているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410402,
					"content": "二つの鍵を同時に手に入れないと開かない…はぁ、璃月人はいつも、このようなわけのわからないところを用心する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710410403,
					"content": "無駄話はそこまでです…ほら、扉に貼ってある通知書を見てください。うん、砲弾は確かにこの倉庫にあることが判明しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410404,
					"content": "砲弾はともかく、俺らはまだ信管の保存状態を知らないんだぜ。もっとじっくり検討したほうがよくないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710410405,
					"content": "そんなこと…まだ何もしていないのに、縁起でもないことを言わないでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410406,
					"content": "それに、宝盗団の言葉に私たちが耳を傾ける必要もないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410407,
					"content": "クレイトポンの言うことにも一理ある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "そうだぞ、おまえらケンカしないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710410410,
					"content": "ふん…先輩がそう言うなら、分かりました。話を続けましょう。瑾武姉さんなら、この倉庫の扉の開け方を知っているかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410411,
					"content": "でもその後も、かなり色々と作業しないと…尾栓を解除するには、信号装置を起動する必要もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410412,
					"content": "瑾武姉さんによれば、大砲を見下ろせる高いところに爆破班の観測地点は設定されているはずです…そこから信号を調整すれば、安全な距離から大砲の安全装置を解除できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710410408,
					"content": "とにかく、まずは扉を開かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
