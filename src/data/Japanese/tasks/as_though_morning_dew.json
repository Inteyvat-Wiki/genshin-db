				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "思いついた！御輿長正を小説の最後に持ってこよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320302,
					"content": "つまり、物語の他の登場人物はもういないということか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "アカバ"
				},
				{
					"id": 30320303,
					"content": "そうだ。御輿長正は最後まで寿命を全うしたらしいから、最後を飾る叙述者にぴったりだと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320304,
					"content": "「異様な雰囲気は消え去った。だがこれから先何十年と、この件はまるで暗雲のように、御輿長正の心に纏わりつくのだった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320305,
					"content": "「年老いた彼はある日、夢を見た。『大たたら長正』という宝刀が作られたその日の夜、みなは喜びに踊り、絵を描き、舞い、酒を飲んだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320306,
					"content": "「…すべての喜びは炉の中の火に溶け、紅の雲と化し、御輿長正が人生において最後に見た日の出を包んでいった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320307,
					"content": "「人生という道は長い。そのことを何か言おうとした時には、すでにどう表現すればいいか、分からなくなっていた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "澤田"
				},
				{
					"id": 30320308,
					"content": "…ふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
