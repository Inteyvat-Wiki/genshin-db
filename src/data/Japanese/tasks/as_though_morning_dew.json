					"content": "ゆっくり休んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "おお！やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320506,
					"content": "…あれ？この瓶…",
