					"nextDialogs": [
						30320507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320507,
					"content": "…ん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "誰かが掃除の時に割っちゃったのか？でも、掃除が来るなんて聞いてないけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320509,
					"content": "（あの夜、パイモンが「散兵」のことで驚いて、うっかり机にぶつかってこれを割ってしまった。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "（でも、その後に「散兵」が自分の存在を消したことで、世界は変わったはず？どうしてこの瓶は…まだ砕けたままなんだろう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "どうやら、戸惑っているようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320512,
					"content": "…誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "気持ちはよく分かるわ。これを知れば、誰だって頭を抱えるはずだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320514,
					"content": "えっ？誰かがオイラたちの耳元で話してる！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320515,
					"content": "でも残念ながら、テイワットの運命はそう容易く揺らぐものじゃないわ。神ならばまだ少し可能性があるけど、そうでないなら…難しいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320516,
					"content": "小さな動物が木にぶつかれば、木は揺れる。でも、傾きと位置が変わることは別の物なの、運命もそれと同じね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320517,
					"content": "まさに瓶が床に落ちるように、猫が割ったものでも、鳥が割ったものでも、割れたという結果に変わりはない。そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320518,
					"content": "お、おまえ、誰なんだよ！どうしてそんなこと知ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320519,
					"content": "歴史は簡単には変わらないけれど、人々の心は変わる。自分の目を信じて。目に見えるものこそが真実であり、見えないものはすべて虚幻よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "天の声"
				},
				{
					"id": 30320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "声が途絶えた…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320522,
					"content": "さっきの人、いったい誰だったんだ？急に出てきて怖いこと言って…なんなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320523,
					"content": "（目を信じろ？彼女が言ったのは…自分の記憶を最後まで信じろということ？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "瓶も床で砕けたままだし、誰か呼んで掃除してもらうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320525,
					"content": "…なんか、このまま放っておくのは気持ち悪いんだ。オイラ、ちょっくら行ってくるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320526,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "#（この先、何が{M#俺}{F#私}を待ち受けているんだろう？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "美味しいものをごちそうしてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
		},
