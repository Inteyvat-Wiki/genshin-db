				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "これで、あなたも名前を持つ人間になったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320402,
					"content": "あだ名は？もう思いついたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "えっと…えっと…まだ考えてるんだ、そう急かすなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320404,
					"content": "ゆっくり考えるといいよ。思いつくまでは、僕たちはしばらく会わなくて済む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "これからどうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "僕を不幸に陥れた者たちには、いつか代価を払ってもらうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "ファデュイのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320408,
					"content": "少なくとも「博士」はね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "立場が変わったわね。あなたのこれからの道も、それに合わせて変わっていくと思うわ。でも、それは今すぐというわけじゃない…今はまだ、時間をかけて自分自身を整理する必要があると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "もう一つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "今の稲妻には、まだ雷電五箇伝の末裔が少しいたね。彼らの中には、僕と雷電五箇伝の関係を知っている…いや、知るべきだった人がいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "僕はしばらくスメールを離れるつもりはない。もしも君が稲妻で彼らを見かけたら、教えてやるといい…僕こそが、雷電五箇伝を失墜させた元凶だとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "…たとえこのことが世界から抹消されたとしても、彼らには真実を知る権利がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "なるほど…それがあなたの選択なのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320416,
					"content": "えっ？でもそうなったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320417,
					"content": "なんてことはないさ。彼らが望むなら、刀で僕の胸を突き刺しても構わない。と言うより…本来そうするべきだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "なんだいその目は？そんな顔をしないでくれ。僕は、自分が何をしているか知ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "…その日は、いつか来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "話は終わりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "またね、賢明なる神、そして君たちも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "行っちゃったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320427,
					"content": "最近の出来事は彼にとって、いきなり一生を過ごしたような気分だったでしょうね。そんなこと、誰でも気持ちの整理には時間がかかるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320428,
					"content": "おう、そうだな。あいつは相変わらずあいつだけど、態度はちょっと丸くなった感じがするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320429,
					"content": "何はともあれ、全部終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "これでやっとご飯を食べに行けるよな？オイラ、腹ペコだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320431,
					"content": "お疲れ様、落ち着ける場所を探して存分に休みましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320422,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "単純明快だね、悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "…さて、おしゃべりはこのへんにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
