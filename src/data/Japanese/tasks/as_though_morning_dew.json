						],
						"stepId": 303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "おかえりなさい、旅人、パイモン、そして「散兵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320102,
					"content": "ふぅ！なんだかすっごく長い旅をしたみたいだ…疲れたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "もしかして、この名前は不満かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320105,
					"content": "別に。ただ、そろそろ名前を変えなくてはと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "もう「散兵」と名乗らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "「博士」があれだけのことをしたと知ったいま、引き続き彼と関係のある称号を使うわけがないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "僕がファデュイのほうに戻ることはないし、そのつもりもない。きっと多くの人がこの件に影響されたから、そもそも第六位が誰だったか覚えてるとも限らないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "つまり、ファデュイを離れるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320110,
					"content": "形を変えて逃げるってやつだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "君の言う通りだ、クラクサナリデビ。すべてが無駄に見えたとしても、意味がないとは限らない。少なくとも、多くの人に僕のことを忘れさせることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "だからといって、あなたの身から過去が消えるわけではないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320114,
					"content": "それはもちろんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "それから、あなたが全力を尽くして追い求めていたこと、その最も核心的な目的は…まだ達成されていない。その点についても分かってほしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320116,
					"content": "世界を変え、過去を変え…他人の運命を変えるのは、そんなに容易なことではないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320117,
					"content": "あなたが渇望した答えは究極の破滅…その本質は虚妄よ。たとえこの世から「散兵」がいなくなっても、世界があなたの意志に従って動くことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320118,
					"content": "ふん…そうだね。ハハハッ、本当に笑えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "そこまでやって、こんな結果になったこと…後悔してないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320120,
					"content": "たとえ僕に何の価値がなくても、この世において後悔に値することなんて最初からないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "クラクサナリデビ、世界樹にあった情報は、君がわざとあそこに残したんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "できる限りあなたが自然に情報を得られるよう、だいぶ工夫したんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320123,
					"content": "どうしてそこまでするんだ？僕を抱き込むつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "これは正直に言うべきね。過去の経歴によって、あなたは私にとってもスメールにとっても、有用な個体となったの。あなたを仲間にすることは、確かに私の計画の一部だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320125,
					"content": "でもその前に、私は過去の真実をあなたに教えたかったの。もし利用するだけなら、私は「博士」と何も変わらなくなってしまうから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320126,
					"content": "…本当に、冴えているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "これは、私が持つべき美徳なのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320128,
					"content": "他者にとって有用であること、それが価値というものだ。だからこそ罪人であっても、僕は再び利用される理由を手に入れられたというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "ナヒーダはそんなこと思ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "ああそうか、危うく忘れるところだったよ…君たちは「正義」の側で、僕とは違っていたんだっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "悪いけど、僕は物事を見る角度が少し違うのさ。まあ、僕も全部が全部打算だとは思ってないよ。君のその知恵が、優れた助っ人を持つことを定めたんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "そう思ってくれてよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320133,
					"content": "旅人、これから私は、世界樹に深く隠された秘密をより一層研究し、発掘しようと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320134,
					"content": "もちろん、世界樹に記録されたあなたの血縁者の旅の始まりもね。その前後に何があるのか、私も知りたいもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320135,
					"content": "じゃあ、お願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320137,
					"content": "旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "僕が世界樹の情報の激流に飛び込んだ後、どうして稲妻に行った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "#{M#君}{F#あなた}が何を変えたのか知りたかったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "…だから彼らに、変わった後の運命を尋ねたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "何はともあれ助けてもらったわけだし、この恩は全力を尽くして返そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "…見返りを求めてやったわけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "個体と個体の間には「借り」と、それを「返す」だけの関係しかないんだ。僕たちはいずれ必ず、貸し借りのない関係になる、気にする必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "そうではないわ。人と人との関係は、決して簡単に白紙に戻せるようなものではないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320147,
					"content": "あなたもきっと感じたことがあるでしょう。あなたの人生に現れた人は、水滴が蒸発するように消えはしない。この世には、本当に「貸し借りのない関係」なんてないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320148,
					"content": "取り返しのつかないことや、変えられないことがあるからこそ、人の世には感情が芽吹くの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320149,
					"content": "あなたの感じるものはすべて真実であって、あなたの犯した過ちが補われることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320150,
					"content": "亀裂を背負ったまま生きていくのが、人間というものよ。人間になるかどうかは、あなたが選んでちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320151,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "心臓のない人間なんていないだろう？それに、僕はとっくに人間になろうなんて考えるのはやめてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "あなたは心臓がなくても、苦痛を理解することができる。あなたはただ感情を封じ込めているだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320154,
					"content": "過去は揺るぎないけれど、あなたは引き続き歩むことができる。未来という線が十分に長いのであれば、「過去」は相対的にごく短い区間に過ぎないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320155,
					"content": "どうやら僕をどうするべきか、もう考えてあるようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "ナヒーダに協力して欲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "色んなことが混ざって、難しい話になってるけど…一番重要なのは、ナヒーダについて行ったほうがいいってことだな！じゃないと、オイラたちもなんでここまでしたのかわからなくなっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320158,
					"content": "…だったら、君たちと共にいるとしよう。暗闇からの助力としてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "私たちの提案を受け入れてくれて嬉しいわ。お祝いとして、自分に新しい名前でも付けてみるのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320160,
					"content": "はやくはやく、オイラもおまえにひっどいあだ名をつけてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320161,
					"content": "なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "だって…オイラ、まだおまえのことあんまり好きじゃないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320163,
					"content": "ふん。なら、今後はあまり会わないほうがいいかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "「名前は人生で最初の贈り物」——はっきりとは言わなかったけど、あなたがそう考えていることは知っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320165,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#今回は{M#彼}{F#彼女}とパイモンが色々と手助けしてくれたし、どんな名前にするか決められないのなら、{M#彼ら}{F#彼女たち}の意見を聞いてみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30320167,
					"content": "#えっ？{M#俺}{F#私}たちで決めるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "だめだ、オイラ、あだ名しかつけられない…まともな名前は無理だぞ…おまえに任せるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30320144,
					"content": "#{M#俺}{F#私}が脅してるかのように言わないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
