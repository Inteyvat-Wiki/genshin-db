			"dialogs": [
				{
					"id": 747080101,
					"content": "こんにちは、旅人、パイモンちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080102,
					"content": "ギヨタンさんから聞いたけど、キミたちがアクアリウムの管理をしてるそうね。ウチは彼女に頼まれて、アクアリウムのお魚関連の顧問として来たのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080103,
					"content": "いらっしゃい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "よかったぜ！シグウィン看護師長がいれば、こいつらが体調不良になる心配はないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747080106,
					"content": "ふふっ、前にキミたちが「シュヴァルマラン映影ランド」のガーデンの管理を任せてくれたおかげで、ウチもいくつかコツを掴んだの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080107,
					"content": "患者さんのお世話と、お利口な動物のお世話には、通じるところがいくつもあるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080108,
					"content": "でも今回は、お魚の展示以外にも、ちょっとした「療養」の計画があって、キミと相談したいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080109,
					"content": "なんでも言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "警察隊員のシースから聞いたんだけど、最近すごく凶暴化してるお魚がいて、近くの生き物や、潜水士、さらには小さな船にまで激しく攻撃してるらしいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080111,
					"content": "ウチ、その子たちをアクアリウムにお迎えして、少し落ち着いてもらいたいなって考えてるの。これ以上大きな被害が出ないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080112,
					"content": "どうして気性が荒くなってしまったのかについては、ウチが研究して治療法を見つけるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080113,
					"content": "お魚たちや水域の環境を守れるうえに、アクアリウムにも個性的な子が加わることになって、いいと思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080114,
					"content": "確かにいい考えだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747080115,
					"content": "#{M#俺}{F#私}も賛成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "じゃあ、気性の荒いお魚たちが出没する水域の情報を教えるから、あとはお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747080104,
					"content": "すごく助かる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}