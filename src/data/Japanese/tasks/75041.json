						],
						"pointId": 10040
					}
				]
			},
			"dialogs": [
				{
					"id": 750410401,
					"content": "まだいるのか、勇士よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410402
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410402,
					"content": "かつて、とある学者が言った——この灰燼の都の残虐な主は、アビスの侵食を止める方法を持っていると。それで我々は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410403
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410403,
					"content": "だが、ここは実に不気味だ。この頃そう思えてきた。何かがおかしい、とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410404
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410404,
					"content": "昨日まで綺麗だった道が次の日にはボロボロになっている…あの石造りの家は初めからあんな風だったか？もっと…まともだった気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410405
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410405,
					"content": "それから、目が覚めたら、二度と現れるはずのない友人を見ることもある…あれは魔物だったんだろうか？友人の姿に化けた魔物だったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410406
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410406,
					"content": "私の…私の責務は、ここの魔物を片付けることだ。だが、なぜ…そうしなければならない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410407
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410407,
					"content": "とにかく、ここはおかしいんだ…早く離れたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
