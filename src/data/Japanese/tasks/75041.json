				]
			},
			"dialogs": [
				{
					"id": 750410101,
					"content": "人ならざるものは実に厄介だ…非人間的な怪物とでも言おうか。勇士よ…私は冒険団のクエニン。私の責務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410102
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410102,
					"content": "私の責務は…この魔物どもを一掃することだ。そう、私は冒険団の戦士だ。勇士よ、気を付けろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410103
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410103,
					"content": "この魔物どもはずる賢い。様々に姿を変える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410104
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410104,
					"content": "夜になると、いつも聞こえてくる…古い廃墟に潜む、やつらの声がな。そのせいで…野営地ではなかなか眠ることもできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410105
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410105,
					"content": "そういう魔物がここにはうようよしている。お前たちも…気を付けとくんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
		{
			"id": 7504102,
			"completionStepIds": [
