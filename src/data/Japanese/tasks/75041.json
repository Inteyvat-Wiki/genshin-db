					}
				]
			},
			"dialogs": [
				{
					"id": 750410301,
					"content": "なぜ、まだここにいる…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410302
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410302,
					"content": "冒険団の隊長——鷹の仮面を被ったあの英雄でさえもう…我々にできることは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410303
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750410303,
					"content": "いいか、今すぐ離れろ。ここは呪われた地だ。人間が足を踏み入れていい場所じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
		{
			"id": 7504104,
