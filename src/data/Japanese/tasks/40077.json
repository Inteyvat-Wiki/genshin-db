						],
						"stepId": 4007707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"楓原万葉",
					"ファデュイの士官",
					"ファデュイの新兵",
					"フィッシュル",
					"辛炎",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770701,
					"content": "全部入れたぞ。モナ、これでいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770702,
					"content": "たぶんそれで大丈夫です。レポートにはそう書いてありますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770703
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770703,
					"content": "しばし待とう。元通りになるといいのでござるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770704
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770704,
					"content": "みんなで座って、火を囲みながら食事と雑談をした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770705
					]
				},
				{
					"id": 400770705,
					"content": "装置を修復した後、状況は好転したようだ。しばらくして、遠くから足音が聞こえてきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770706
					]
				},
				{
					"id": 400770706,
					"content": "なっ！俺たちの拠点に誰かいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770707
					],
					"speakerTitle": "ファデュイの士官"
				},
				{
					"id": 400770707,
					"content": "おいっ、お前たち！何者だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770708
					],
					"speakerTitle": "ファデュイの新兵"
				},
				{
					"id": 400770708,
					"content": "待て、あの装置を見ろ。な、直ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770709
					],
					"speakerTitle": "ファデュイの士官"
				},
				{
					"id": 400770709,
					"content": "えっ、ええ？だがペルシーコフさんは、まだ地べたに倒れてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770710
					],
					"speakerTitle": "ファデュイの新兵"
				},
				{
					"id": 400770710,
					"content": "この装置はオイラたちが直したんだ、オイラたちに感謝しろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770711,
					"content": "このような邪魔さえ入っていなければ、私たちは完璧な休暇を過ごせていたというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770712
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770712,
					"content": "ふんっ！さっさとわたくしと臣下たちに詫びよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770713
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770713,
					"content": "あっ、えっと…さ、先に失礼する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770714
					],
					"speakerTitle": "ファデュイの士官"
				},
				{
					"id": 400770714,
					"content": "お、おいっ、俺を置いていくなよ…ペルシーコフさんがまだここにいるんだぞ、助けないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770715
					],
					"speakerTitle": "ファデュイの新兵"
				},
				{
					"id": 400770715,
					"content": "アハハッ、あの二人は目が覚めたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770716
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770716,
					"content": "どうやら、修復に成功したようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770717
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770717,
					"content": "やったぁ！じゃあ、オイラたちもここを離れようぜ。自分の拠点に戻って休暇を満喫しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770718,
					"content": "それってクレーの拠点でしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770719
					]
				},
				{
					"id": 400770719,
					"content": "おう！でもいま考えると、あそこってオイラたちの拠点でもある気がするぞ。仮住まいってやつだな、えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770720,
					"content": "あそこは幽夜浄土兼ドド王国大使館と言ったほうが適切かもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770721
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400770721,
					"content": "ええ？うーん、言いづらいな。オイラ、覚えやすい名前のほうがいいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770722,
					"content": "さっ、行こうぜ。早く家に帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007708,
			"completionStepIds": [
				4007710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007710",
							"2"
						],
						"stepId": 4007710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィッシュル",
					"オズ",
					"辛炎",
					"楓原万葉",
					"モナ",
					"ドド通話機",
					"ウェンティ",
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770801,
					"content": "ふぅ——！家に着いて、いっぱい食べて、椅子でのんびりして、ようやく落ち着けたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770802,
					"content": "ふふっ、幽夜浄土の招待、満足してくれたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770803
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770803,
					"content": "おう、大満足だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770804,
					"content": "よかったです。お嬢様が臣下の皆様を招いたのは、我らが聖国の降臨を見届けていただくためだけでなく、安らぎを与え、夏を楽しんでもらうためでもありましたので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770805
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400770805,
					"content": "すごくよかったぜ。アタイ、ここが好きだ！本当に来てよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770806
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770806,
					"content": "ここは永遠なる楽土となるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770807
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770807,
					"content": "お嬢様は、今後もあなた方と一緒に遊びたい、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770808
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400770808,
					"content": "おう、もちろんだぜ！時間が空いたら璃月に来いよ。アタイが色んなとこに連れてってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770809
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770809,
					"content": "そうだ、璃月で一番美味しいメシ屋は、アタイの友達がやってるんだ。きっと気に入るはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770810
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770810,
					"content": "それから劇を見たかったら、雲菫を訪ねるといい。親切な上に、面白いやつと友達になりたがるから、きっと劇の話題で盛り上がれると思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770811
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770811,
					"content": "ほう？辛炎殿が勧めるなら、興味が湧いてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770812
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770812,
					"content": "旅人、拙者に一つ案があるのでござるが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770813
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770813,
					"content": "稲妻には焼きスミレウリなる食べ物があり、その風味は魚とよく合うのでござる。今晩、試しに果実と海鮮を一緒に焼いてみるのはどうであろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770814,
						400770816
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770814,
					"content": "いいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770815
					]
				},
				{
					"id": 400770815,
					"content": "では、決まりでござるな。拙者は果実をできるだけ探しておこう。味付けは…うむ、あれにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770823,
					"content": "ここにいたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770824
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770824,
					"content": "一つ問題が見つかりました。すでに装置を修復したというのに、島の幻境がまだ消えていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770825
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770825,
					"content": "うむ、それは拙者も気づいていたでござる。だが幻境の誕生に時間がかかるように、消失にも時間が必要なのではないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770826
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770826,
					"content": "ええ、その可能性もあると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770827
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770827,
					"content": "それに、私の水占の盤が元に戻り、使えるようになったので占ってみたところ、大きな異常はありませんでした。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770828
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770828,
					"content": "ただ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770829
					]
				},
				{
					"id": 400770829,
					"content": "占いの結果に理解できないものがあったのです…ある種の力が私たちを囲んでいて、見つめているような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770830
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770830,
					"content": "装置によるもの…あるいはペルシーコフによるものでござろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770831
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770831,
					"content": "すみません、それは私にも分かりません。ただ確かなのは、今のところ、この力に攻撃の意志がないということだけです。私たちに悪意はないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770832
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770832,
					"content": "（そういえば、島にはもう一つ解決できていない問題があった。しかも、みんなが知らない問題が…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770833
					]
				},
				{
					"id": 400770833,
					"content": "気をつけるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770834
					]
				},
				{
					"id": 400770834,
					"content": "はい。邪魔がなくなり、休暇を楽しめるようになったとはいえ、海島を離れるまでは気をつける必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770835
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770835,
					"content": "私も、毎日占っておきますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770836
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770836,
					"content": "フィッシュル殿をお守りすると約束した以上、拙者も手伝うでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770837
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770837,
					"content": "ええ、お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770838
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770838,
					"content": "…はぁ、彼女たちはのんきですから…今回の件は、私がより気にかけておかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770839
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770839,
					"content": "パイモン、ちょっと来て！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770840
					]
				},
				{
					"id": 400770840,
					"content": "おお、なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770841
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770841,
					"content": "あっちに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770842
					]
				},
				{
					"id": 400770842,
					"content": "そっか、吟遊野郎に連絡するんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770843
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770843,
					"content": "ドドコ——ドドコ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770844
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400770844,
					"content": "あれれ、やっとボクに連絡をくれたの？遊びに夢中で、ボクのことなんか忘れちゃってたのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770845
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770845,
					"content": "違うぞ、吟遊野郎。オイラたち、奇妙なことに遭遇したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770846
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770846,
					"content": "この数日、海島で起きたすべてのことをウェンティに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770847
					]
				},
				{
					"id": 400770847,
					"content": "奇妙な装置？神を模した能力？アハハッ、ファデュイにそんな計画があったのかい。まったく、ビックリだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770848
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770848,
					"content": "その言い方、おまえも知らなかったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770849
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770849,
					"content": "ボクはただ酒場で小銭を稼いでる吟遊詩人に過ぎないよ。そんなこと、知ってるはずないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770850
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770850,
					"content": "こいつ、またそうやって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770851
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770851,
					"content": "それよりも旅人にパイモン、今回は思う存分楽しめたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770852
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770852,
					"content": "おう、すっごく楽しかったぞ！美味しいもんをいっぱい食べて、不思議な景色もたくさん見れた！最高だったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770853,
						400770854
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770853,
					"content": "すごくよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770855,
					"content": "アハハッ、ならよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770856
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770856,
					"content": "旅の意味は心の記録にあるんだ。忘れられない体験を残すことができれば、それだけで有意義な旅となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770857
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770857,
					"content": "その謎の声が誰なのかは知らないけど、少なくとも彼女は君たちに危害を加えることはなかった。それどころか、みんなのことを知るきっかけにもなった。そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770858
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770858,
					"content": "その点から見て、彼女の行動は善意によるものだったんじゃないかな。そうじゃなかったら、アリスさんの発明した通信機を遮断した上で、君たちを襲っていたはずでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770859
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770859,
					"content": "うっ、たしかにその通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770860
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770860,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770861
					]
				},
				{
					"id": 400770861,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770862
					]
				},
				{
					"id": 400770862,
					"content": "アハハッ、安心してくれたようでよかったよ。じゃあ、思う存分遊んできて。帰ったら、ボクにも海島の美しい幻境のことを聞かせてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770863
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770863,
					"content": "その美しい思い出をすべて記録し、詩歌を書こうと思うんだ。これから送るすべての夏が、忘れられない楽章となるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770864
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770864,
					"content": "うん、約束。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770865
					]
				},
				{
					"id": 400770865,
					"content": "それじゃあ、君たちの帰りを待ってるよ。休暇、楽しんでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770866
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400770866,
					"content": "吟遊野郎が大丈夫って言うんなら、たぶん大丈夫だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770867
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770867,
					"content": "なんてったって、あいつも神だしな。信じていいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770868,
						400770869
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770868,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770870,
					"content": "もう戻ろうぜ。みんなを待たせたら悪いし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770871
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770871,
					"content": "さっき、フィッシュルがカニを捕まえに行きたいって言ってたんだよな。へへっ、オイラも行きたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770872
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770872,
					"content": "此度の件を解決したあなたは、その充足感と喜びに満たされているのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770873
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770873,
					"content": "（この声は…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770874
					]
				},
				{
					"id": 400770874,
					"content": "安心して、危害は加えないわ。と言うより、私はただ偶然この海域を通った小鳥。今は遠い場所からあなたを見ているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770875
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770875,
					"content": "たまたま、ここには私と関係する力があった。それが気になって、浜辺に降り立ち、島の一切をうかがっていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770876
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770876,
					"content": "…本当に面白かったわ。公務で忙しくとも、海島に来た人はみんな心の底から笑顔になっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770877
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770877,
					"content": "そして、後から来たあなたたちも言うまでもなく、輝かしい夢境と美しい意志をもたらしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770878
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770878,
					"content": "あなたたちの幻夢は、まるで海面上の泡のように、透き通っていて儚い。心を打つ泡影であればあるほど、私は目を奪われてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770879
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770879,
					"content": "私は遠出することができないの。あなたたちのような自由な人がとても羨ましい。だから、ちょっとした仕掛けを施したの。気に入ってくれたら嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770880
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770880,
					"content": "#{M#君}{F#あなた}は誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770881
					]
				},
				{
					"id": 400770881,
					"content": "言ったはず、私に目的はない。私は、ただの小鳥に過ぎない。ここに残っているのも、あなたたちの喜怒哀楽を観賞するため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770882
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770882,
					"content": "あなたは特別な人よ。異なる色彩を放っている。とても気になったから、こんな方法であなたとコミュニケーションを取っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770883
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770883,
					"content": "私の名前は気にしないで。おそらく将来、他の場所でいつか会えるかもしれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770884
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770884,
					"content": "その時が来たら、きっとあなたも私のことを知るはずよ。ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770885
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770885,
					"content": "（声が消えた…今、直接頭の中に話しかけられていた？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770886
					]
				},
				{
					"id": 400770886,
					"content": "おい、なにやってんだよ！はやく行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770887
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770887,
					"content": "（…これは…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770888
					]
				},
				{
					"id": 400770888,
					"content": "（他の場所で会える…いつ、どこで会うのだろう…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400770869,
					"content": "まあ、そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770854,
					"content": "全体的に満足。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770816,
					"content": "焼きスミレウリ、食べたことある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770817
					]
				},
				{
					"id": 400770817,
					"content": "稲妻で食べたのでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770818
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770818,
					"content": "稲妻の友達に焼いてもらった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770819
					]
				},
				{
					"id": 400770819,
					"content": "ははっ、それは重畳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770820
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770820,
					"content": "拙者もお主のように、色々なところへ行き、友を作ろうと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770821
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770821,
					"content": "万葉ならきっと大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770822
					]
				},
				{
					"id": 400770822,
					"content": "実に嬉しい言葉でござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "楓原万葉"
				}
			]
		},
		{
			"id": 4007711,
			"completionStepIds": [
				4007711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007711",
							"2"
						],
						"stepId": 4007711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ペルシーコフ",
					"辛炎",
					"モナ",
					"フィッシュル",
					"オズ",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400771101,
					"content": "あっ！あいつって、初日にオイラたちが会ったやつじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400771102,
					"content": "ハハハッ…ゲフッ！狂え、立ち去れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771103
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771103,
					"content": "俺たちは…永遠に目覚めない…だが俺は正しい、俺の宝は、無敵だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771104
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771104,
					"content": "宝？宝って何のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771105
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400771105,
					"content": "奇跡を創造する機械に…できぬことなど…絶対にない…ひっく…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771106
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771106,
					"content": "どうやら、宝とはあの装置のことを指しているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771107
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400771107,
					"content": "酔いつぶれているようね、ふんっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771108
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400771108,
					"content": "このお酒の匂い…お嬢様、私の翼で風を送らせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771109
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400771109,
					"content": "あっ、私にもお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771110
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400771110,
					"content": "#じゃあ、{M#俺}{F#私}にも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400771111
					]
				},
				{
					"id": 400771111,
					"content": "もちろんでございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771112
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400771112,
					"content": "皆の者、近くを見てきたが、他に人はいなかったでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771113
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400771113,
					"content": "妙ではござらぬか？ファデュイは組織であるのに、ここにはこの者しか残っていない。ましてや前回来た時は、この者さえいなかったでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400771114,
					"content": "それに、この前のふくよかな男もいなくなっている。あるいは…他の場所に隠れているのであろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771115
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400771115,
					"content": "その理由は、目の前にいるこの者に聞くしかないでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771116
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400771116,
					"content": "でも酔いつぶれてるみたいだぞ。こいつの酔いが覚めるのを待たなきゃいけないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400771117,
					"content": "懲罰の聖泉を降さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771118
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400771118,
					"content": "お嬢様は、水をかけてはどうかとおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771119
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400771119,
					"content": "いいなそれ、やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400771120,
					"content": "一行はバッグの中から水を取り出し、ファデュイの研究員にかけた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400771121
					]
				},
				{
					"id": 400771121,
					"content": "あっ、目を覚ましたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400771122,
					"content": "うぅ…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771123
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771123,
					"content": "あなた、ファデュイですよね？ここで何が起きたのか、そしてあの装置が何に使われるものなのか、教えてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400771124,
					"content": "…ファ…デュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771125
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771125,
					"content": "…ハハハッ！ファデュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771126
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771126,
					"content": "ああ、ああ…愚かで無知なる幹部どもよ、後悔しているか！ハハハッ、俺の研究を否定して、俺に無理やり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771127
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771127,
					"content": "無理やり…無人島へ来させ、実験を…宝！宝が…うぅう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771128
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771128,
					"content": "なんで泣いてるんだよ…一体どんな目に遭ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400771129,
					"content": "…俺と…俺が発明した宝を愚弄した！あいつらは…あいつらは…未来でもたらされる勝算を理解していない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771130
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771130,
					"content": "俺の発明があってこそ…世界を征服することができるのに…ハハッ、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771131
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771131,
					"content": "愚かな、バカどもが！ハハハハハッ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771132
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771132,
					"content": "グアッ…！ぶたないでくれ、もう実験室は爆破しないから…悪かった！わざとじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771133
					],
					"speakerTitle": "ペルシーコフ"
				},
				{
					"id": 400771133,
					"content": "ダメだ、精神がぐちゃぐちゃで、まったく話ができねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771134
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400771134,
					"content": "初日に会った時は、このような様子ではなかった。どうやら、後の数日で影響が進み、やがて狂気に陥ってしまったのでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771135
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400771135,
					"content": "う、うぅ…俺のレポート、レポートが！これだけは…勘弁を…うぅ…",
