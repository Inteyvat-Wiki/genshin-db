			},
			"dialogs": [
				{
					"id": 400770101,
					"content": "ここね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770102
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770102,
					"content": "おめでとうございます、問題を解く鍵を見つけましたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770103
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400770103,
					"content": "どれどれ…ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770104
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770104,
					"content": "モナはレポートを受け取り、詳しく読んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770105
					]
				},
				{
					"id": 400770105,
					"content": "やはり、この「感知擬態」と呼ばれる装置は、人間の脳に影響を与えられるようです。それから製造者はあの研究員で、名をペルシーコフと言うようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770106
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770106,
					"content": "レポートによると、ファデュイ幹部はペルシーコフの研究を支持しておらず、それどころか道を誤ったと判断した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770107
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770107,
					"content": "しかし、ペルシーコフはどうしてもこの装置を実戦に投入したかった。そのため、彼は人脈を駆使して人手を集め、装置全体を各部品に分けて、無人島に運んだようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770108
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770108,
					"content": "よくこの島を見つけたな。やっぱりファデュイの情報網を甘く見ちゃダメだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770109,
					"content": "ペルシーコフは独断専行で、ここで実験を始めたようですね。実験に参加したほとんどがファデュイの下っ端兵士で、その全員がリスク同意書にサインしたとあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770110
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770110,
					"content": "…どうやら、彼らは本当にこの装置が、ファデュイに利益をもたらすと思っていたみたいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770111
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770111,
					"content": "装置の原理は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770112
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770112,
					"content": "それは恐らく極秘なのでしょう、レポートには書いてありません。しかしペルシーコフは、とある神の権能を模してこの装置を作ったと書いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770113
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770113,
					"content": "つまり、その神の権能はこれらの幻夢と関係のあるもの。そして、ファデュイはそれについて研究をしたことがあるということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770114
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770114,
					"content": "うむ。でなければ、彼らに神の権能を真似るなどできまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770115
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770115,
					"content": "（そういう神がいるってこと？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770116
					]
				},
				{
					"id": 400770116,
					"content": "とにかく、ペルシーコフの実験過程は順調ではなかったようです。装置起動後、何日も経たずして故障してしまい、修理を試みたらしいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770117
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770117,
					"content": "技術の未熟なファデュイ兵士によって装置を滅茶苦茶にされ、もっとも重要な晶核まで弾き飛び、どこかに落ちてしまったようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770118
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770118,
					"content": "修理がいかに重要な仕事であるかがうかがえますね。皆様も、身の丈に合った範囲で行ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770119
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400770119,
					"content": "ペルシーコフはマッドサイエンティストですが、自分の部下が不幸に見舞われるのを見たくなかったのでしょう。それに、問題が解決できなければ、彼自身も狂ってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770120
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770120,
					"content": "切羽詰まった彼は、一人で晶核を探しに外へ出た。しかし、彼は病弱な研究員です。その探索は失敗に終わり、あきらめざるを得なかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770121
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770121,
					"content": "その後、ペルシーコフは狂気に陥りはぐれてしまった兵士たちを必死に探し、彼らを洞窟まで連れていってかくまったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770122
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770122,
					"content": "島に上陸したあの日、拙者たちが会ったのはこの段階の彼らだったのであろう。ペルシーコフは、がっしりとした体付きのファデュイ兵士を連れていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770123
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400770123,
					"content": "そういうことです。ペルシーコフは力を尽くし、兵士たちを洞窟に集めて、彼らの目を覚まそうと試みました。音楽や詩歌などを使ったとあります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770124,
					"content": "ですが、効果はなかったようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770125
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770125,
					"content": "そう言えば、前にアタイたちがここに来た時、誰もいなかったよな。ということは、ペルシーコフはその日、洞窟に全員集めたってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770126
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400770126,
					"content": "そういうことでしょう。最後の数ページに、良い知らせと悪い知らせが書いてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770127
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770127,
					"content": "良い知らせは、ペルシーコフは狂気に陥った兵士から断片的な情報を聞き出し、晶核の所在地を特定したこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770128
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770128,
					"content": "悪い知らせは、ペルシーコフは彼らの目を覚ますことができなかったこと。その後、彼自身も影響を受け、狂気に陥ってしまった。レポートの最後のほうは、彼の狂気じみた落書きで埋め尽くされています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770129
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770129,
					"content": "となると、これはまたわたくしと臣下たちに出番が回ってきたようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770130,
						400770131
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400770130,
					"content": "まさか、休暇中も人助けするだなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770132
					]
				},
				{
					"id": 400770132,
					"content": "レポートに地図が描いてあります。マークされた場所が晶核の在りかでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770133
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400770133,
					"content": "他に方法はないみたいだな。晶核を探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400770131,
					"content": "なんかそういう使命感がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770132
					]
				}
			]
		},
