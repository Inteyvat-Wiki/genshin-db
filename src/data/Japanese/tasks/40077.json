					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770202
					]
				},
				{
					"id": 400770202,
					"content": "（元々意識がもうろうとしていたのか、それとも投げ飛ばされたせいなのか。）",
