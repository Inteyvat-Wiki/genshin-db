			"dialogs": [
				{
					"id": 400050501,
					"content": "なるほど、どうして人間はいつも愚かなことをしてしまう…まあ、どうでもいいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050502,
					"content": "それで、我を「明霄の灯」が見えるところに呼んだのは、一体なんのためだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050503,
					"content": "もちろん「明霄の灯」のためだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "おまえも海灯祭で記念される英雄なんだろ…なんで提灯を見ないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050506,
					"content": "我は人間たちに近づけない。そういう、悩みのない人たちに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050507,
					"content": "苦行と殺戮の日々を、我は過ごしすぎた…慣れてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050508,
					"content": "この話はここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050509,
					"content": "では。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050510,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050511,
					"content": "今後、璃月で鬼神の難に遭遇したら、我が名を呼べばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050512,
					"content": "お前でも、この璃月でも、全ての灯り、そして平和を祈る全ての願いは、我に届くのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400050513,
					"content": "では、よい年を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "よいお年を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050504,
					"content": "もちろん海灯祭のためだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
