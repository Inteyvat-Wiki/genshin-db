			"dialogs": [
				{
					"id": 400050401,
					"content": "早くその企みを白状しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050402,
					"content": "白状するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050403,
					"content": "さもなければ、この…えっ？早くない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050404,
					"content": "実は…俺は「宝盗団」に憧れる新米盗賊なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050405,
					"content": "新米盗賊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050406,
					"content": "ああ、俺のようにデビューしたてのひとりぼっちの新米にとって…宝盗団はまるで高嶺の花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050407,
					"content": "待て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050408,
					"content": "だからデカいことをして、宝盗団に忠誠を誓おうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050409,
					"content": "待て待て！まったく意味が分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050410,
					"content": "オイラが想像してた残酷で、凶暴な放火犯と全然違う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050411,
					"content": "放火犯？何のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050412,
					"content": "おまえ、ずっと燃えやすい材料の近くをうろうろしてただろ！放火するためじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050413,
					"content": "ああ、それか。下見をしてただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050414,
					"content": "俺の計画は建造材料とは関係がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050415,
					"content": "関係がない！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050416,
					"content": "俺は…あの20年に1度の巨大「浮生の石」を盗みたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050417,
					"content": "俺の計画では、夜中に鎖の半分を壊し、そのまま石を海の方へと飛ばして——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050418,
					"content": "へえ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050419,
					"content": "あとはなんとかしてそれを雲来の海の浅瀬に沈めるんだ。これぞ、完全犯罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050420,
					"content": "全然、完全じゃないだろ！浮生の石をどうやって水に沈める気なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050421,
					"content": "俺もその問題に困っていて、まだ手を出せてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050422,
					"content": "コイツ、まともじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050423,
					"content": "#よし、{NICKNAME}、少しおしおきをしてやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050424,
					"content": "千岩軍が、あのバカを連行してくれたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
