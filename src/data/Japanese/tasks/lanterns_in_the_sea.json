			"dialogs": [
				{
					"id": 400050201,
					"content": "宝盗団の者か？手紙にこちらは仮装をするから、そちらの二人も仮装して構わないと書いたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050202,
					"content": "ありのままの姿で会いにくるとは、さすがだ、感服する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050203,
					"content": "フフン、おまえのような正体を隠すヤツと違って、オイラたちは仮面がないといけないようなことはしてないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050204,
					"content": "おい——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400050205,
					"content": "だって仮装していいよって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "おまえたち、宝盗団のヤツらじゃないな！何者だ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 400050206,
					"content": "これかっこいいと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
