				]
			},
			"dialogs": [
				{
					"id": 750390301,
					"content": "喉がカラカラになっている人を助けた。よく見ると、水を浴びた彼は一回り大きくなっていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750390302
					]
				},
				{
					"id": 750390302,
					"content": "ふぅ…はぁ…はぁ…ゲホゲホ…！ありがとよ…あと少しで死ぬところだった…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390303
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390303,
					"content": "結局こいつは……ずっと水源の近くにいたのに、喉が渇いて死にそうになってたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390304,
					"content": "えっ？なんだ、近くにあったのか！まったく…だが、助けてくれてありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390305
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390305,
					"content": "ワシはマニフェコ・ド・マニフェサンスだ。マニフェコと呼んでくれ。見ての通り、フォンテーヌ貴族の末裔だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390306
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390306,
					"content": "古い友人には「刑事」とか、「ブルータス」、あとは「ミスターマグネット」と呼ばれているが…好きなように呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390307
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390307,
					"content": "うわぁ…やっぱり変なやつだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390308,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390309,
						750390314,
						750390325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390309,
					"content": "「刑事」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390310
					]
				},
				{
					"id": 750390310,
					"content": "昔、マレショーセ・ファントムで何年か刑事をやってたんだ。フランク・ドレイビン警部の下で、何件もデカいヤマを解決したもんさ。警部はそれから昇進したが、ワシは職を退いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390311
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390311,
					"content": "あれは本当に忘れられない時間だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390312
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390312,
					"content": "そう…ある男とある女が出会い、そして別れた。女は男を探し、男が女を忘れてはまた思い出し、女が千霊祭のフロート車に三回轢かれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390313
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390313,
					"content": "そんなメチャクチャな思い出は別に思い出さなくていいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390332,
					"content": "ゴホン、とにかく、マレショーセ・ファントムを辞めた後はしばらくブラブラしてたよ。だが、ついに決めたんだ。写真家になって、人とモノが持つ生命力を記録しようってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390333
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390333,
					"content": "だからナタに来たのさ！様々な元素の生命力が光り輝き、胸がドキドキするこの国に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390334
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390334,
					"content": "たしかにドキドキはしただろうな…ここで干からびて死にそうになってたわけだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390335,
					"content": "ハハッ、本当にすまなかった。助けてもらった恩は忘れん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390336
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390336,
					"content": "ああ…そうだ、君らの地図を見せてくれないか？えーと…次の目的地はどこだったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390348
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390348,
					"content": "そうだ…ここと、ここ…あと…ここだ！見せてもらって悪いな…こいつは返す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390337
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390337,
					"content": "おっと、ワシとしたことが君らの名前を聞いてなかったな。礼儀がなってなくてすまん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390338
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390338,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390339
					]
				},
				{
					"id": 750390339,
					"content": "#オイラはパイモン！こいつは{REALNAME[ID(2)|SHOWHOST(true)]}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390340,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390341
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390341,
					"content": "#{NICKNAME}とパイモンだな、覚えたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390342
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390342,
					"content": "キュウ？キュー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390343
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390343,
					"content": "#ハハッ、もちろん{REALNAME[ID(2)|SHOWHOST(true)]}もだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390344
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390344,
					"content": "近いうちに、またどっかで会えるといいな。また助けてもらうことになるかもしれんし…いや、もしかしたら次はワシが助ける番かもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390345
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390345,
					"content": "へぇ…遠くまで行くのか…今度は干からびないように気を付けろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390346,
					"content": "ハハッ、ありがとよ！また会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390347
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390347,
					"content": "マニフェコは手早く飲み水とその他の荷物をまとめ、手を振って別れを告げた。\\n彼の小さな姿が見えなくなるまで、そうかからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750390314,
					"content": "「ブルータス」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390315
					]
				},
				{
					"id": 750390315,
					"content": "ああ、ワシは昔マレショーセ・ファントムで何年か刑事をやってたんだ。フランク・ドレイビン警部の下に付いてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390316
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390316,
					"content": "ワシはある日、公園で古代風の服を着た五人が刃物を振り回し、老人に襲いかかろうとするところを見たんだ。その場には大勢の人の目があった。そこでワシは「パン、パン、パン、パン、パン！」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390317
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390317,
					"content": "やつらを全員撃ち倒してやったんだ。倒れたやつは誰一人息していなかった。ハッ、弾を避けられるほどの強運が自分にあるとでも思ったか、悪党め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390318
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390318,
					"content": "ひいっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390319,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390320,
					"content": "ただその後、そいつらが科学院の事務員だったことが分かったんだ。警部が言うには『レムリア』のリハーサルだったんだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390321
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390321,
					"content": "ええっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390322,
					"content": "それで、「ブルータス」と呼ばれるようになったわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390323
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390323,
					"content": "キュウ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390324
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390324,
					"content": "まあ、あの時は科学院がちょうどリストラを進めてた時だったから、遅かれ早かれヤツらのクビは飛んでただろうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390325,
					"content": "「ミスターマグネット」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390326
					]
				},
				{
					"id": 750390326,
					"content": "もちろん、このワシの素晴らしい品格を表した名前だ。ワシを知っている者はみな、ワシに惹かれてやまないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390327
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390327,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390328,
					"content": "そう…ちょっとした金属製の小物やら、モラやら、あと小ぶりなアクセサリーなんかが、どういうわけかワシのポケットに吸い込まれていくんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390329
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390329,
					"content": "ただ泥棒の常習犯じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390330,
					"content": "まさに！これこそ、ワシの一族に伝わる美徳の一つさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390331
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390331,
					"content": "キュイ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
