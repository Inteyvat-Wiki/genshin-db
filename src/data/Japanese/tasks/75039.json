			"dialogs": [
				{
					"id": 750390101,
					"content": "やぁ暗闇、我が懐かしき友よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390102
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390102,
					"content": "うわっ…なんだ…このオジサンみたいな子供。すっごく変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390103,
					"content": "ん？待てよ…こいつ、「華麗なるマニフェコ」じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390104,
						750390107,
						750390110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390104,
					"content": "マ…なんて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390105
					]
				},
				{
					"id": 750390105,
					"content": "マ…マニフェコ、「華麗なるマニフェコ」さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390106
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390106,
					"content": "はぁ…こんな落ちぶれた姿で申し訳ないが、水をくれないか。助けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390119,
					"content": "水…水をくれ…頼む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390120
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390120,
					"content": "あれ…また死にそうになってるぞ…助けてやった方がいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390107,
					"content": "全然「華麗」じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390108
					]
				},
				{
					"id": 750390108,
					"content": "干からびた小魚みたいになって…かわいそうにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390109,
					"content": "おい！人としての同情する心はねえのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390110,
					"content": "#{M#俺}{F#私}が闇だ、懐かしき友よ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390111
					]
				},
				{
					"id": 750390111,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390112,
					"content": "そう！その歌、ワシも好きなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390113
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390113,
					"content": "ああ…セミオンとカーベンクル兄弟、何度聞いても飽きない…そういえば、仕事を辞めることになったのは、あいつらのせいだったな。こうしてクソみてえな冒険をしてるのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390114
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390114,
					"content": "まあ…そいつぁ今はどうでもいいな、ハハッ。いま一番大事なのは、水だ。水、持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390115
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390115,
					"content": "なんつっても、うぅ、ふふっ…その、ヘヘッ、本当にすまんが、喉が乾いて死にそうなんだ、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390116
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390116,
					"content": "命の危機になにヘラヘラ笑ってるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390117,
					"content": "さあ？最後の輝きかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390118
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390118,
					"content": "そ、そうか…ええっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "パイモン"
				}
			]
		},
