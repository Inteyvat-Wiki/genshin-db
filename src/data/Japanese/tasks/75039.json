			"dialogs": [
				{
					"id": 750390201,
					"content": "やぁ暗闇、我が懐かしき友よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390202
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390202,
					"content": "うわっ…なんだ…このオジサンみたいな子供。すっごく変だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390203,
					"content": "おい、ワシみたいなモンを尊重しろとパパとママに教わらなかったか？チビにだってデッカいことはできるんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390204
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390204,
					"content": "実際、デカいことを成し遂げてきたのは、ワシみたいな小さいヤツばっかだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390205
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390205,
					"content": "こいつ、ヒゲまで生えてる！うぅ…ちょっと気味悪いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390206,
					"content": "ワシのことを侮辱するためにヒゲの話をするんじゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390207,
						750390220
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390207,
					"content": "#{M#俺}{F#私}が闇だ、懐かしき友よ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390208
					]
				},
				{
					"id": 750390208,
					"content": "ああ…いや、そこは合わせなくていい。言いたかったのはな…ワシはもう長くないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390209,
						750390214
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390209,
					"content": "そうなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390210
					]
				},
				{
					"id": 750390210,
					"content": "干からびた小魚みたいになって…かわいそうにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390211,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390212,
					"content": "おい、人として同情する心ってもんがねえのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390213
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390213,
					"content": "水をくれ！喉がカラカラで死にそうだ。見て分かるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390214,
					"content": "何が欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390215
					]
				},
				{
					"id": 750390215,
					"content": "ああ、助かったぜ…三日もここから動けずにいたが、やっと人と話せた…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390216
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390216,
					"content": "九番セットを二つ、一つは大盛りで頼む。六番セットが一つ、これはソースマシマシで。それから七番セットが一つと四十五番セットを二つ。ああ、片方はトッピングのチーズを付けてくれ。あと、フォンタのラージサイズを一杯。注文は以上だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390217
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390217,
					"content": "わかった。他にはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750390218,
					"content": "キュ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390219,
					"content": "他、だと？水だ！水をくれ！喉がカラカラで死んじまいそうなんだ。見たら分かるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750390220,
					"content": "しっかりして。どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390221
					]
				},
				{
					"id": 750390221,
					"content": "水…水をくれ…頼む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				}
			]
		},
		{
			"id": 7503903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
