			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マニフェコ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750391701,
					"content": "喉がカラカラになっている人を助けた。よく見ると、水を浴びた彼は一回り大きくなっていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750391702
					]
				},
				{
					"id": 750391702,
					"content": "ふぅ…ゲホッ！ゴホッゴホッ！ありがとう…だが、ゲホッ…人を助ける時はもっと攻撃性を少なくした方がいいと思うぜ…ワシは泳げないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391703
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391703,
					"content": "心配しなくていいぞ！もしそうなっても、なんとかしておまえを引き上げてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391704,
					"content": "そんな目に合うのはごめんだ…だが助けてくれてありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391705
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391705,
					"content": "ワシはマニフェコ・ド・マニフェサンスだ。マニフェコと呼んでくれ。見ての通り、フォンテーヌ貴族の末裔だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391706
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391706,
					"content": "古い友人には「刑事」とか、「ブルータス」、あとは「ミスターマグネット」と呼ばれているが…好きなように呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391707
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391707,
					"content": "うわぁ…やっぱり変なやつだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391708,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391709,
						750391714,
						750391725
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391709,
					"content": "「刑事」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391710
					]
				},
				{
					"id": 750391710,
					"content": "昔、マレショーセ・ファントムで何年か刑事をやってたんだ。フランク・ドレイビン警部の下で、何件もデカいヤマを解決したもんさ。警部はそれから昇進したが、ワシは職を退いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391711
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391711,
					"content": "あれは本当に忘れられない時間だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391712
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391712,
					"content": "そう…ある男とある女が出会い、そして別れた。女は男を探し、男が女を忘れてはまた思い出し、女が千霊祭のフロート車に三回轢かれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391713
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391713,
					"content": "そんなメチャクチャな思い出は別に思い出さなくていいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391732,
					"content": "ゴホン、とにかく、マレショーセ・ファントムを辞めた後はしばらくブラブラしてたよ。だが、ついに決めたんだ。写真家になって、人とモノが持つ生命力を記録しようってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391733
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391733,
					"content": "だからナタに来たのさ！様々な元素の生命力が光り輝き、胸がドキドキするこの国に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391734
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391734,
					"content": "たしかにドキドキはしただろうな…ここで干からびて死にそうになってたわけだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391735,
					"content": "ハハッ、本当にすまなかった。助けてもらった恩は忘れん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391736
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391736,
					"content": "そうだな、ワシが次に行く場所を…君らの地図にマークさせてくれないか…ああ、ここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391737
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391737,
					"content": "おっと、ワシとしたことが君らの名前を聞いてなかったな。礼儀がなってなくてすまん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391738
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391738,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391739
					]
				},
				{
					"id": 750391739,
					"content": "#オイラはパイモン！こいつは{REALNAME[ID(2)|SHOWHOST(true)]}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391740
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391740,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391741
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391741,
					"content": "#{NICKNAME}とパイモンだな、覚えたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391742
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391742,
					"content": "キュウ？キュー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391743,
					"content": "#ハハッ、もちろん{REALNAME[ID(2)|SHOWHOST(true)]}もだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391744
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391744,
					"content": "近いうちに、またどっかで会えるといいな。また助けてもらうことになるかもしれんし…いや、もしかしたら次はワシが助ける番かもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391745
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391745,
					"content": "へぇ…遠くまで行くのか…今度は干からびないように気を付けろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391746
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391746,
					"content": "ハハッ、ありがとよ！また会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391747
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391747,
					"content": "マニフェコは手早く飲み水とその他の荷物をまとめ、手を振って別れを告げた。\\n彼の小さな姿が見えなくなるまで、そうかからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750391714,
					"content": "「ブルータス」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391715
					]
				},
				{
					"id": 750391715,
					"content": "ああ、ワシは昔マレショーセ・ファントムで何年か刑事をやってたんだ。フランク・ドレイビン警部の下に付いてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391716
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391716,
					"content": "ワシはある日、公園で古代風の服を着た五人が刃物を振り回し、老人に襲いかかろうとするところを見たんだ。その場には大勢の人の目があった。そこでワシは「パン、パン、パン、パン、パン！」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391717
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391717,
					"content": "やつらを全員撃ち倒してやったんだ。倒れたやつは誰一人息していなかった。ハッ、弾を避けられるほどの強運が自分にあるとでも思ったか、悪党め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391718
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391718,
					"content": "ひいっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391719,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391720,
					"content": "ただその後、そいつらが科学院の事務員だったことが分かったんだ。警部が言うには『レムリア』のリハーサルだったんだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391721
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391721,
					"content": "ええっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391722,
					"content": "それで、「ブルータス」と呼ばれるようになったわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391723
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391723,
					"content": "キュウ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391724
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391724,
					"content": "まあ、あの時は科学院がちょうどリストラを進めてた時だったから、遅かれ早かれヤツらのクビは飛んでただろうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391725,
					"content": "「ミスターマグネット」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391726
					]
				},
				{
					"id": 750391726,
					"content": "もちろん、このワシの素晴らしい品格を表した名前だ。ワシを知っている者はみな、ワシに惹かれてやまないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391727
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391727,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391728,
					"content": "そう…ちょっとした金属製の小物やら、モラやら、あと小ぶりなアクセサリーなんかが、どういうわけかワシのポケットに吸い込まれていくんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391729
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391729,
					"content": "ただ泥棒の常習犯じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750391730,
					"content": "まさに！これこそ、ワシの一族に伝わる美徳の一つさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391731
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750391731,
					"content": "キュイ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
