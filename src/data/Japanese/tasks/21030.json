			"dialogs": [
				{
					"id": 210300201,
					"content": "旅人、どんな状況だった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300202,
					"content": "しばらく安全。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#さすが{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、すごいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300204,
					"content": "父は旅行のとき、ボクたちを守るために何人か雇うって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300205,
					"content": "#その人たちが{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}みたいにすごいといいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300206,
					"content": "鍛冶屋のおじさん。これで採掘ができるし、注文した鉄器の鍛造もできるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300207,
					"content": "ハハハ、それはもちろんだ。少し準備をしたら、採掘に行く。帰ってきたら鍛造を再開するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300208,
					"content": "でも俺一人で運べる鉱石の量には限界があるからな…そこに魔物が再び現れないといいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "章"
				}
			]
		},
