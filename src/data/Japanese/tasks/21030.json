			"trigger": {
				"objectNames": [
					"モン",
					"章"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "え？この鉱石とこの鉱石は違うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300102,
					"content": "それはもちろん。この二種類の鉱石で作られたものは、品質も値段も全然違うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300103,
					"content": "そうなの…でも、この二種類の鉱石はこれしか残ってないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300104,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300105,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、こんにちは。父が注文した鉄器のチェックを手伝ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300107,
					"content": "鍛冶屋のおじさんはいい人なんだ。ボクに小さな剣を作ってくれるって約束したんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300108,
					"content": "でも、最近店で使ってる材料が足りなくて、父の注文した鉄器が延期になるかもしれないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300109,
					"content": "ボクの小さな剣も、いつになったらできるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300110,
					"content": "はぁ…まあ仕方ないことだ。最近店に来るお客さんが多いから、鉱石はあまり残っていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300111,
					"content": "それに、鉱石が豊富なところには、魔物がたくさんいるから、俺も採掘にいけないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300112,
					"content": "だから、この時期を過ぎてから、冒険者を雇って採掘に同行してもらうしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300113,
					"content": "でも、それっていつまで待てばいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、君は魔物を倒すのが得意だって聞いたけど、本当？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300115,
					"content": "手伝ってくれない？お願い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210300116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "旅人、お前さん様子を見に行ってくれるのか？それじゃ、普段採掘してる場所を地図に描き込んでておくよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300119,
					"content": "よし、できた。これらの場所だ。あそこには魔物がたくさんいるから、行くときは気を付けろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "章"
				},
				{
					"id": 210300120,
					"content": "#じゃあお願いするね、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210300117,
					"content": "わ、分かった…何とかするよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
