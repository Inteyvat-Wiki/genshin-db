			"dialogs": [
				{
					"id": 705430101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430102,
					"content": "…にゃお。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "「つみれ」"
				},
				{
					"id": 705430103,
					"content": "…お前たちか。オレ、話してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430104,
					"content": "話してるって…「つみれ」と話してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430105,
					"content": "ニャ、ニャニャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "「つみれ」"
				},
				{
					"id": 705430106,
					"content": "「そうだ」って言ってるみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430107,
					"content": "懐かしい匂いがする、友だち探す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430108,
					"content": "この子は元気、うれしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430109,
					"content": "にゃ、にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "「つみれ」"
				},
				{
					"id": 705430110,
					"content": "匂いで友だちを引き寄せる。お前も来た、うれしい。お前は、風と雨の匂い。懐かしい…猫の匂いも、懐かしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430111,
					"content": "パイモン、甘い匂い。いい匂い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430112,
					"content": "えっ！？甘い匂い…まさか、ヴァレリナがオイラたちにくれたパンケーキの匂いか？オ、オイラ、そんなに食べてたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430113,
					"content": "#{M#俺}{F#私}のも半分あげたしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "全然気づかなかったぜ…あぁ、あのパンケーキが美味しすぎたせいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430116,
					"content": "へへっ、あとは鳥肉のスイートフラワー漬け焼きとステーキ、ハッシュドポテトと…アップルサイダーも飲みたいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430117,
					"content": "#メニューはこれで決まりだな。{NICKNAME}、はやくヴァレリナに注文しようぜ。レザーも一緒に来いよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430118,
					"content": "あ、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430119,
					"content": "「つみれ」たくさんくれた…ナッツ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430120,
					"content": "あと、箱の中の肉で…オレ、お腹いっぱい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 705430121,
					"content": "どうやら、ヴァレリナが注文した出前みたいだな？もしかして、「つみれ」が出前をレザーに渡してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430122,
					"content": "にゃにゃ、にゃー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "「つみれ」"
				},
				{
					"id": 705430123,
					"content": "まさか「ネコモコの城」で、猫のほうがお客さんをもてなすことがあるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430124,
					"content": "レザーって、本当に「猫ウケ」がいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705430114,
					"content": "大丈夫、パイモンはあと三倍は食べられる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}