			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "一体どこなのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060102,
					"content": "また落とし物でもした…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "今回は「落とした」じゃないわ、まだ探し始めたばかりよ！でも——どうしても見つからないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060104,
					"content": "一体どこにあるのよ、せっかく位置まで絞ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060105,
					"content": "一緒に探してよ、こんな貴重な文物を放置するわけにはいかないでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060106,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "じゃあ、あなたはあっち、私は引き続きこっちを探すわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060109,
					"content": "絶対探し出すわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060107,
					"content": "今回はどういう文物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "えっと…うーん、すごく古い！そうね、千年前…いや、魔神戦争の時代のものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060111,
					"content": "とにかく、とても貴重な文物なんだから、放置するわけにはいかないわ！一緒に探して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				}
			]
		},
