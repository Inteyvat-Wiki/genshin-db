				},
				{
					"id": 220060609,
					"content": "お疲れ様、これはあなたへの報酬よ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060610,
					"content": "でもあの文物がまだ見つからないなんて、心配よ…",
