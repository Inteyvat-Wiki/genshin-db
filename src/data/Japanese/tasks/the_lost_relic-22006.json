			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "結構時間がかかったわね、何か発見は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060602,
					"content": "これを見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "はあ…まあいいものだけど、私が探してるものとは、かなり違うわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220060605,
					"content": "でも、これもちゃんとした文物だから、保管しておくわ。安心して、ちゃんとその価値を発揮させるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
