			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "ありがとう、旅人…ふう、さっきはビックリしたよ、最近の宝盗団も大胆になってきてるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060302,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "私はソラヤー、遊学者だよ。今はここで研究してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060304,
					"content": "数日前、手がかりを辿ってある遺跡を見つけた。中で魔神戦争時代の歴史が記されている玉盤を見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060305,
					"content": "でも玉盤を取り出し遺跡を出てすぐに、宝盗団に襲われた。頑張って逃げたけど、すぐ追いつかれてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060306,
					"content": "あなたたちがいなかったら、私も玉盤も無事ではすまなかったよ。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060307,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}も学者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "…も？他に学者がここで研究してるの？名前を聞いても…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060309,
					"content": "宝児…待って、さっき私を襲った宝盗団も、「宝児に独り占めさせるわけには」って言ったような。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060310,
					"content": "そんな偶然があるとは…ごめん、あなたが出会ったその「宝児」のことを詳しく教えてもらえないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060311,
					"content": "事の経緯はこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "…その「宝児」があなたに教えた場所は、ちょうど私が選定した場所だよ。こんな「偶然」はあまりにもおかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060313,
					"content": "もし彼女が宝盗団のメンバーなら、私はきっと宝盗団に尾行されているのだろう…私の後をついて、そのまま宝物を探し出すつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060314,
					"content": "あの「宝児」は宝物を独り占めしたいから、一人で行動しているんだ。でも、彼女一人だけでは広範囲を探せない。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060315,
					"content": "…君も利用されたみたいだね、旅人。おそらく今回の位置も、彼女が狙った場所だろうね。ただ彼女の仲間と私が君よりも先に着いたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060316,
					"content": "本気にしないで、あくまで私の推測だよ。しかし「宝児」って名前…あやしいね、偽名か、コードネームかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060317,
					"content": "旅人、適当に彼女の相手をしてくれないかな？何があっても、この玉盤をあやしい人に渡すことはできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060318,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "ありがとう、でも手ぶらで帰ると、彼女に疑われるかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060321,
					"content": "こうしよう、それほど貴重じゃないものを持っているから、それを彼女に渡して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060322,
					"content": "大した価値はないけど、これでしばらくは誤魔化せるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060325,
					"content": "さあ、早く戻って。彼女の仲間を倒したけど、今の彼女は単独行動中だ。きっとその仲間も君のことをすぐに彼女に教えることはできないはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060326,
					"content": "そうだ、今度また彼女に探し物を頼まれて、本当に見つけてしまったら、私のところに持ってきてほしい。いつもは望舒旅館にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060327,
					"content": "まあ、私にできることは限られるけど…文物はなるべく守っておきたいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060319,
					"content": "手ぶらで帰ると疑われる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "うん…一理あるね。こうしよう、それほど貴重じゃないものを持っているから、それを彼女に渡して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220060324,
					"content": "大した価値はないけど、これでしばらくは誤魔化せるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "ソラヤー"
				}
			]
		},
