			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リーリキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766690101,
					"content": "（<color=#FFCC33FF>ラウマ</color>は「饗月の膳」のことが気になるのかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766690102
					]
				},
				{
					"id": 766690102,
					"content": "いらっしゃい…まあ！ラ、ラウマ様、どうしてここに！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690103
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690103,
					"content": "頑張っておるな、リーリキ。配膳は順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690104
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766690104,
					"content": "ええ！順調ですわ！「饗月の膳」を作るのも配るのも、この上ないぐらい順調ですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690105
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690105,
					"content": "ヤフォダさんが何日か配膳を手伝ってくれて以来、ちょっかいを出したり、割り込んだりする人もいなくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690106
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690106,
					"content": "数日前、大柄な男がやってきて、いきなり列に割り込んだうえに、何人分もの食事を寄越せと言ってきたんです…カントールさんが止めようとしたら、何発も殴られてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690107
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690107,
					"content": "そのとき、ちょうどヤフォダさんが食事をもらいに来ていたんですが、その光景を見るや否や、さっと飛び上がって、男を一発で蹴り倒したんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690108
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690108,
					"content": "そして、男が投げつけた「饗月の膳」をこぼれないようにしっかりとキャッチし、男を指差してこう言い放ちました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690109
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690109,
					"content": "「恩人と食べ物に対して、敬意の欠片もないな。今日は食事抜きだ！さっさと失せろ。もう一発蹴られたくなかったらな！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690110
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690110,
					"content": "その後、ヤフォダさんは何日も配膳を手伝ってくれました…お礼に、私も精一杯いろいろ作ってあげました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690111
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690111,
					"content": "ヤフォダさんには本当に世話になったな…前にも言ったように、もう一人護衛をつけたほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690112
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766690112,
					"content": "あ、いえいえ、人手は足りていますし、護衛を雇うぐらいなら、配給所を増やしたほうがいいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690113
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690113,
					"content": "ヤフォダさんが時々見に来てくれていますし、カントールさんもいます。騒ぎを起こす人はもういないはずなので、ご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690114
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690114,
					"content": "そうだとよいが…こうしよう。私の友を交代で来させる。もし困ったことがあれば、彼らに言うとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690115
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766690115,
					"content": "お友達？島の方でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690116
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766690116,
					"content": "ふふ、きっと見覚えがあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690117
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766690117,
					"content": "これ以上邪魔はしないでいこう。では、月神の恩寵があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690118
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766690118,
					"content": "はい！お気をつけて、ラウマ様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーリキ"
				}
			]
		},
