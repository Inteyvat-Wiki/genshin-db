			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レモンド",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "何か聞きたいことはあるか、名誉上級研究員？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361202,
					"content": "ナッカーとエドウィンの処置について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "二人にはしばらくメロピデ要塞にいてもらい、自分の犯した罪を悔いてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361204,
					"content": "もちろん、エドウィンの性格からして、「悔いる」なんてことはないと思うがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361205,
					"content": "だが…とにもかくにも、エドウィンを研究機材やアルケウムから遠ざけておければいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361206,
					"content": "ナッカーについては…二度と我々を厄介事に巻き込むこともないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361207,
					"content": "はぁ、もうあんなのはこりごりだ…二人をまた起用しないとならないような仕事がないといいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361208,
					"content": "フュシリエはエドウィンを尊敬してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "…エドウィン·イースティングハウスは天才だ。彼と同じ分野で働いた人間は自暴自棄になるか、その信者になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361210,
					"content": "フュシリエさんは情熱と創意にあふれた研究員だ。しばしば小さなコストで素晴らしい成果を出していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361211,
					"content": "彼女はアルケウム研究プロジェクトの第三技術班に入ってから、抑制機の構造設計に携わり、エドウィンと何度も交流する機会があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361212,
					"content": "彼女はその時、エドウィンの信者になったのかもしれない。他の信者と同じく、エドウィンに認められることが彼女の唯一の目標となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361213,
					"content": "爆発後、彼女はエドウィンが犯人だと信じようとせず、自ら調査に参加し、エドウィンの無実を勝ち取ろうとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361214,
					"content": "君もエドウィンと話しただろう、どんな印象を受けた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361215,
					"content": "研究以外には目もくれないマッドサイエンティストだったな！責任を他人になすりつけて、フュシリエの名前も覚えてなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741361216,
					"content": "そう、彼はそんな人間なんだ。目の前の研究以外、あらゆる物や人にほぼ目もくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361217,
					"content": "研究さえ上手くいけば、他のことはどうだって構わないんだ。部下の研究員がこっそり研究資産を転売していようがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361218,
					"content": "フュシリエさんの調査の参加を許したのは…単に彼女に早く分かってほしかっただけだ。自分はずっと、想像の中の幻影を追いかけてるんだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361219,
					"content": "ついに幻想は消え去った。彼女が早く元気になってくれるといいんだが…フォンテーヌ科学院は、これ以上研究員を失うわけにはいかないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				},
				{
					"id": 741361220,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "ああ、さよなら。名誉上級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レモンド"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
