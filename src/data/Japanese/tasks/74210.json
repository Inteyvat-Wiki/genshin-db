			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ショワズール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "ふぅ…大丈夫、大丈夫だ、悪夢はもう終わった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361302,
					"content": "エドウィンの復活をどう思ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "うわっ！お、驚かせないでください、どう思ってるかですか？別にどうも、ただ無責任な人間には罰を受けてほしいと思っているだけで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361304,
					"content": "もしできるなら、あいつの手足を縛り付け、目隠しをして、二度とアルケウムに触れられなくしてやりたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361305,
					"content": "もう安心できた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "今までと比べたら、少しはほっとしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361307,
					"content": "でも本当は…ナッカーとエドウィンを一緒に収容するなんてこと…あぁ！あいつらが何をしでかすか、私にも分かりません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361308,
					"content": "前回は爆発で、次は何をするか？フォンテーヌを丸ごとフォンタで沈めるとか？想像するだけで恐ろしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741361309,
					"content": "健闘を祈る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "ええ。あなたもよい一日を、名誉上級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショワズール"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7413611",
							"3"
						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フュシリエ",
					"ルマーク",
					"ショシベル",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "…価値がない…私の研究に価値がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741361402,
					"content": "お嬢さん、そうあまり考えなさるな。あなたの発明は俺の命を救ったんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "ルマーク"
				},
				{
					"id": 741361403,
					"content": "でも…でもエドウィン先輩は…エドウィンさんは、こんなものには価値がないって！うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741361404,
					"content": "それはあのエドウィンってやつに見る目がねぇんだよ。ほら、どう見てもお宝だぜ！価値がないだって？俺の手下に一人一台配ってやりたいくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741361405,
					"content": "エドウィンは悪人だから、信じないように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "違う！エドウィン先輩は悪い人じゃない！先輩は…先輩は…だけど…私の名前さえ覚えてなかった！私、設計図を何度も見せたのにっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741361407,
					"content": "フュシリエは十分立派なやつじゃんか。どうしていつもエドウィンなんかの評価を気にするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741361408,
					"content": "#彼から低評価でも、{M#俺}{F#私}はすごいと思ってる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "ほ…本当に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741361410,
					"content": "ハッ、当たり前だろ。俺たちみんなそう思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "ショシベル"
				},
				{
					"id": 741361411,
					"content": "だけど、あなたたちに研究のことなんか分からないでしょ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "フュシリエ"
				},
				{
					"id": 741361412,
					"content": "フュシリエ…完全にナーバスになってるな。仕方ない…しばらく一人にしてやろうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741361413,
					"content": "分かった…俺とルマークは近くにいるから、何かあったら呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ショシベル"
				}
			]
		}
	]
}