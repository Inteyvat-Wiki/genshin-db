					"nextDialogs": [
						761270316
					]
				},
				{
					"id": 761270316,
					"content": "…「イビニベルンの目」に…エネルギーを供給するため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270317
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761270317,
					"content": "イビニベルン…の目？…ってなんだ？聞き覚えがある気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270318,
					"content": "宇宙船の着陸地点の一つだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270319
					]
				},
				{
					"id": 761270319,
					"content": "イビニベルン…の目？…ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270320,
					"content": "ここに設計図が…見せてあげる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270321
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761270321,
					"content": "真ん中の塔が…「イビニベルンの目」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270322
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761270322,
					"content": "おおっ、すごいな！隣のちょっと背の低い三つの建物はなんだ？それがエネルギーステーションなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270323,
					"content": "うん…今、そのうちの一つにいるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270324
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761270324,
					"content": "「イビニベルンの目」は何をする建物なの？",
