					"nextDialogs": [
						761270337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270337,
					"content": "ニンニンだけでいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270338
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 761270338,
					"content": "おい！調子に乗るなよ、クロタマゴ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270339,
					"content": "オイラたちがこんなレストラン一つない荒野に来ちゃったのは、誰のせいか忘れるなよ…お菓子が欲しくないのか？",
