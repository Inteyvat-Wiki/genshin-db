			"dialogs": [
				{
					"id": 761270101,
					"content": "#{M#（何が…起きたんだ…？）}{F#（何が…起きたの…？）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270102
					]
				},
				{
					"id": 761270102,
					"content": "（そうだ…宇宙船に事故が起きて…脱出ポッドに乗って…着陸に成功したのかな？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270103
					]
				},
				{
					"id": 761270103,
					"content": "（早くここを出て…パイモンの無事を確かめに行かないと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270104
					]
				},
				{
					"id": 761270104,
					"content": "（脱出ポッドから出る。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
