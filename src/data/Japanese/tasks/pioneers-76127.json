			"dialogs": [
				{
					"id": 761270201,
					"content": "うぅ…おまえなら絶対に無事だって、オイラ信じてたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270202,
					"content": "パイモン、大丈夫だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270203
					]
				},
				{
					"id": 761270203,
					"content": "本当に焦ったんだ。脱出ポッドから出てみたら、おまえもクロタマゴもいなくなってて…びっくりして息が詰まりそうだったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270204,
					"content": "でも、おまえを見つけられたから、もうすっかり安心したぞ。へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270205,
					"content": "怪我はないか？ほら、ちょっと見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270206,
					"content": "安心して、こっちも無事だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270207
					]
				},
				{
					"id": 761270207,
					"content": "これで一安心だな。まさか宇宙船の調子が悪くなるなんて思わなかったぞ…いや、こうなることも予想すべきだったのかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270208,
					"content": "なにしろ、何年も地下に埋まってたんだからな。飛べただけでも奇跡だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270209,
					"content": "それに、過程はちょっと大変だったけど…オイラたち、最終的には月に来れたんだしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270210,
					"content": "龍族の技術は本当にすごいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270211
					]
				},
				{
					"id": 761270211,
					"content": "クロタマゴのことで頭がいっぱいで、宇宙船をしっかりチェックするのを忘れちゃってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270212,
					"content": "あっ、そうだ！クロタマゴはどこだ？あいつも脱出ポッドに潜り込んでたはずだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761270213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761270213,
					"content": "探しに行かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761270214
					]
				},
