					}
				]
			},
			"dialogs": [
				{
					"id": 740640101,
					"content": "だから、なんとかしてそれをきれいに落とすか、誰がやったのかを調べるしかないって言ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640102,
					"content": "ったく、簡単そうに言うなよ…色んな洗剤を試したが、どれを使っても取れなかったんだぞ。もっと強力なやつってなると…「濁水幻霊イチコロリ」くらいだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640103,
					"content": "濁水幻霊イチコロリ？壁に穴でも開けて、みんなを魚と一緒に「おねんね」させるつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640104,
					"content": "じゃあ、犯人を捕まえるしかないな。ただ、今のところ何の手がかりもないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640105,
					"content": "二人ともどうしたんだ？なにか手伝おうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640106,
					"content": "ああ。見てくれよ、この壁のマーク。メロピデ要塞じゃ落書きが禁止されてるってのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640107,
					"content": "色々と試してはみたが、何をやっても消えなくてな。せめて誰の仕業か分かれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640108,
					"content": "あっ、そういえばまったく手がかりがないわけじゃないわよ。フォンテーヌ科学院には特別な方法で解読できるマークがあるって、クランツが言ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640109,
					"content": "つまり…このマークが、クランツの言ってたものかもしれないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640110,
					"content": "ええ。その話を聞いたときは全く興味がなかったから、深くは聞かなかったけど…もし彼がこれを見たら、答えが分かるかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640111,
					"content": "彼がやったのかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "確かにその可能性も捨てきれないわ。でも、もし仮にそうだったとしても…ふふっ、彼はここのルールをよく知ってるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME}とパイモンは、物知りな冒険者なのよね？何かいい案はない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640116,
					"content": "落書きをした犯人を探すか、あるいはクランツに見てもらうか。うん…これは正式なお仕事として依頼させてもらうわ。ちゃんと特別許可券を報酬に支払うから安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640117,
					"content": "おう！正式な依頼なら、なんとかしてみせるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640118,
					"content": "ええ、ありがとう。私たちもマークを消す方法が他にないか試してみるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640113,
					"content": "じゃあ、彼に見てもらったら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "けど、今どこにいるんだ？今日はまだ顔を見てないが…それに、本当にあいつに頼まないといけないことか？あいつに頼むたびに、オレのプライドも削られていくんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "マポワ"
				}
			]
		},
		{
			"id": 7406402,
