			"dialogs": [
				{
					"id": 740640401,
					"content": "あっ、クランツを見つけてくれたのね。それで、落書きの犯人は見つかった？手がかりでもいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640402,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640403,
					"content": "やっぱりクランツが犯人だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "ええ、私もそう思ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640405,
					"content": "はぁ、せっかく用意した言い訳が、これで全部パーになったよ。もうまな板の上の鯉だ…どうにでもしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640406,
					"content": "ルールはルールだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640407,
					"content": "お前が受ける罰よりも、今はこのマークをどうやって消すかのほうが気になるんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640408,
					"content": "なんだ、暗号図に興味があるのか？説明するとなると、少し時間がかかるが…まあ、座ってくれ。ゆっくり話してあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640409,
					"content": "あ、いや、細かい技術うんぬんには興味がなくってだな…どうやって消せばいいかだけ教えてくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640410,
					"content": "それを話すと長くなる。何しろ、特殊な塗料と技法を使ってるからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640411,
					"content": "他にも仕事があるんだ…その、手短に説明してくれないか…頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640412,
					"content": "#二人のことは気にしないで。{NICKNAME}、パイモン、これが約束した報酬よ。おつとめご苦労さま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640413,
					"content": "専門的なものだから、彼に見てもらおう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "クランツ、これって前に話してくれた特殊なマークよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640415,
					"content": "どれどれ…ふむ、なるほど。ほら、この部分を見てみろ——まるで歯車みたいになってるだろう？こんな大きな歯車…フォンテーヌ科学院のものでなければ、どこのものだと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640416,
					"content": "じゃあ、これはフォンテーヌ科学院のものなのね。そして、あなたもフォンテーヌ科学院の人間——つまり、あなたたちの関係性は一目瞭然ってことね…さあ、正直に白状したらどう？あなたがやったんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640417,
					"content": "おっと、それは些か勘違いしているな。例えば——もしもある日、私が運よく君の姉であるガルヴァーナと一緒に、ホテル·ドゥボールで食事することになったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640418,
					"content": "まだ目が覚めてないなら手伝ってあげるわよ。私の拳じゃ物足りない場合、ロシモフがきっと喜んで手伝ってくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640419,
					"content": "落ち着いてくれ。ただのたとえ話だろう！たとえ話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640420,
					"content": "どこまで話したか…ああ、とにかく私とガルヴァーナが一緒に出かけたとする。私たちはどちらもメロピデ要塞にいたが、必ずしも関係性があるとは言えないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640421,
					"content": "ほら、つまり関係がないんだよ！私とこのマークに関係性はない…私とガルヴァーナに関係性がないのと同じようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640422,
					"content": "なるほど、理解したわ。あなたとお姉ちゃんに関係性がないってところだけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640423,
					"content": "それって…全然理解してないってことでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "オ、オイラたちはもう言えることがないからさ…こっからは自分でなんとかしてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640425,
					"content": "はぁ…何はともあれ、ありがとう。前に約束した報酬は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640426,
					"content": "#おっと、そうだった！{NICKNAME}、パイモン、労働の報酬を渡しそびれるところだったな。犯人が見つからなかったのは残念だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640427,
					"content": "クランツならきっと、このマークの消し方を知ってるはずだ！さ、後はガルヴァーヤとクランツに任せよう。オレはまだ他の仕事があるんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マポワ"
				}
			]
		},
