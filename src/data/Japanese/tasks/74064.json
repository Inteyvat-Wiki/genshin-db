				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クランツ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "あれ？クランツだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640302,
					"content": "こんにちはクランツ、また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "…ん？クランツがここにいるってことは、あのマーク…やっぱりおまえがやったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640306,
					"content": "はぁ、なんで君たちが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640307,
					"content": "何のことだい？まったく心当たりがないんだけど…他の人に聞いてみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640308,
					"content": "パイモン、どうやら違うみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#なんだ、オイラたちの勘違いだったのか…って、んなわけあるか！{NICKNAME}、騙されるなよ。ここにはこいつ以外に誰もいないだろ。こいつが犯人に決まってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640312,
					"content": "分かったよ、君たちの勝ちだ。確かに私がやった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640313,
					"content": "はぁ、これを利用して知り合いを見つけて、昔話でもしようと思ってたのに…まさか、君たちが来るとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640314,
					"content": "これを利用して知り合いを見つける…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640315,
					"content": "ああ。暗号図はサー·ビュトールが開発した技術で、フォンテーヌ科学院でも解読法を知ってる人は少ない。私は昔、よくあの人のお世話になってたから知ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640316,
					"content": "ただ残念ながら、彼は早くに亡くなってしまった。それに暗号図の技術は、管理職に重視されていなくってね。だからもし解読できる人がいれば、その人とはきっと気が合うはずだと思ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640317,
					"content": "おっと、君たちと話すことに意味がないと言ってるわけじゃないぞ。私たちの間には、共通の話題がないだけかもしれないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640318,
					"content": "無理しなくていい、確かに話すことがない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "君は本当に正直だな。私の昔の友人も、まさに君のように正直者だった。そのせいで、かなりトラブルを起こしもしたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640320,
					"content": "でも、今思い返してみれば、あの頃は本当に楽しかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640325,
					"content": "さて話を戻すが、私のところに来たのはその件についてなのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640326,
					"content": "おっと、忘れるとこだったぜ！ガルヴァーヤとマポワに頼まれて、落書きの犯人を探しに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640327,
					"content": "自首して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "そうだ、自首しろよ！もし抵抗したら、オイラたちも手加減しないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640329,
					"content": "おいおい…話し合う余地はないのか？マポワはともかく、ガルヴァーヤのほうは勘弁なんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640330,
					"content": "お二人さん、どうか目をつぶってくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640331,
					"content": "でもマポワは、メロピデ要塞で落書きは禁止されてるって言ってたし、ルール違反はよくないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640332,
					"content": "頼む、どうか大目に見てくれ。暗号図とあの壁の文字に違いなんてないだろ。どっちもただの飾りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640333,
					"content": "#そうだ、こうしよう！君たちと一緒に行きはするが、私を引き渡すかどうかは{NICKNAME}が決めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640334,
					"content": "もちろん、それ相応の報酬は用意しよう！私を見逃し、ガルヴァーヤの魔の手に落ちずに済んだらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640335,
					"content": "私の運命は君たちに託したぞ。さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640321,
					"content": "それは悪かったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "はぁ、そんなこと言われたら話が続かないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640323,
					"content": "普通こういう場合、「君たちの旅の話を聞かせてもらうのも悪くないかも」とか、社交辞令を言うべきだと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640324,
					"content": "まぁ今回だけは、正直になろう。外の新しい話はもう聞き飽きたんだ。ただ知り合いと、昔話がしたい——そのためにやったのさ。謝罪すべきはこちらだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "クランツ"
				},
				{
					"id": 740640310,
					"content": "#ここには{M#君}{F#あなた}しかいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "そうだそうだ！そんなヘタな芝居でオイラたちを騙せると思うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740640304,
					"content": "#白状して、{M#君}{F#あなた}がやったんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "白状しろよ！あのマークはおまえの仕業だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "パイモン"
				}
			]
		},
