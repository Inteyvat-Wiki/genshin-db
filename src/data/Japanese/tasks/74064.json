				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "プクプク獣を捕まえて、ツバを吐かせてみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640202,
					"content": "それ、本気で言ってる？最近、ストレスでも溜まってるんじゃないの？メンタル面は大丈夫？シフトを入れすぎてるとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "ガルヴァーヤ"
				},
				{
					"id": 740640203,
					"content": "いやいや、メンタルは問題ない。ただ、プクプク獣がツバを吐く姿を見たいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "マポワ"
				},
				{
					"id": 740640204,
					"content": "やっぱり…休んだほうがいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルヴァーヤ"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
