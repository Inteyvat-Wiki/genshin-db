				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "海灯祭の最終日、きっと「明霄灯」を見にたくさんの人が来るはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021002,
					"content": "こんなところに不審者がいるなんて、いいことがないに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021003,
					"content": "もし、あの燃えやすい材料に何か細工をしてたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021401,
					"content": "大人たちの力も必要だな！早速璃月の「総務司」に行って、この件を報告しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021406,
					"content": "やけに熱心だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "そ、それは…璃月のみんなの努力の成果なんだろ！台無しになるようなことは絶対に止めないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021408,
					"content": "本当は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "埠頭付近の「中原のもつ焼き」は美味しいぞ、一度食べると忘れられない味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021410,
					"content": "店主の掛け声の真似かな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
