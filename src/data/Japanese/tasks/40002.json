					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "あっ、これは…「嵐生石」と「霞生石」、どれもクオリティが高い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020502,
					"content": "ありがとう！はい、報酬だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020503,
					"content": "君たちの努力のおかげで、海灯祭はより華やかになるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020504,
					"content": "そうだ、せっかく海灯祭期間中の璃月にきてくれたから、「明霄の灯」の変化にも注意してみるといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020505,
					"content": "建設進捗が進むと、埠頭の建設現場の風景も変わっていくからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020506,
					"content": "#面白そうだな。{NICKNAME}、今から行ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
