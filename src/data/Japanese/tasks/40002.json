			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "やあ、君たち。海灯祭の物資を寄贈してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020202,
					"content": "ところで、今日は「寄贈」のほかに…えっと、「購入」に関することだけど、興味はあるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020203,
					"content": "おっ！無償じゃないのか？それなら興味あるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400020204,
					"content": "ハハッ、じゃあ君たちに頼もうかな。実はね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020205,
					"content": "祭りの準備には、2種類の特殊な「浮生の石」が必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020206,
					"content": "ひとつは「嵐生石」、天衡山の北部に発見された記録があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020207,
					"content": "根元に嵐生石が埋められている普通の灌木は、時に「ポンポンの実」に変異して、種を飛行させるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020208,
					"content": "もうひとつは「霞生石」、一般人にとってはかなり危険なものよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020209,
					"content": "帰離原にいる飛行能力を失った古い「遺跡ハンター」は、霞生石を使って自身の飛行能力を維持するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020210,
					"content": "分かった！「嵐生石」と「霞生石」だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400020211,
					"content": "（本当はただの赤と青の浮生の石だけど…きれいな名前は宝石商人がわざと付けたものよ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020212,
					"content": "うん、持ってきてほしいの。お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慧心"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
