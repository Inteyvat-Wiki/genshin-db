			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "この先は璃月総務司、部外者は立ち入り禁止だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400021502,
					"content": "不審者の通報しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "明霄の灯の燃えやすい材料の近くに怪しいやつがいたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021504,
					"content": "「中原のもつ焼き」の屋台が壊されるような行為は絶対に許さない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021505,
					"content": "ああ、それは大事件だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400021506,
					"content": "そうだろ、璃月港の美食はこの都市の真骨頂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400021507,
					"content": "いや、そういうことじゃないが、チビの言うことも間違っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400021508,
					"content": "詳細は了解した。上にはそう伝えておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400021509,
					"content": "情報ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 400021510,
					"content": "絶対に、絶対に、厳しく対応してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
