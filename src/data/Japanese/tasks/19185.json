				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "…マレショーセ·ファントムの情報によると、ピエールの家にこういった樽はなかったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 191851002,
					"content": "樽を直接抱えてくると、目立ちすぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "うん。ピエールの行動パターンとも違う気がする…それなら、どうやって持ってきたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 191851004,
					"content": "（樽をじっくり見てみよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "（樽の外側を見ると——胴回りにぐるりと乾いた水の染みがある…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 191851006,
					"content": "（水染みは奇妙なほど「規則的」だ。樽の上半分にはほとんど染みがない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 191851007,
					"content": "（蓋はぴったりはまってないみたいだ。端のほうに大きな隙間がある。でも内部に水の入った痕跡はない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 191851008,
					"content": "下半分だけが水に浸かってたみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネット"
				}
			]
		},
		{
			"id": 1918511,
