			"dialogs": [
				{
					"id": 191851201,
					"content": "やはりここが「偽造ロシ」の製造拠点か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191851202,
					"content": "[薬]（シュヴルーズの薬物識別に協力しよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "この瓶や缶に入ってるのが「偽造ロシ」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "…それだけではない。製造に必要な原料や大量の洗剤、それから正体不明の薬物も少量ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191851205,
					"content": "この洗剤はある種の「痕跡」を消すために使うのだろう…たとえば「偽造ロシ」の臭いとかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191851206,
					"content": "特巡隊の資料にも、一般人が「偽造ロシ」の痕跡を見つけるのは難しいと書いてあった。それはピエールも同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191851207,
					"content": "徹底的に除去しようと思えば、それなりの時間や技術が必要なはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191851208,
					"content": "だが残りの薬は、何に使うつもりだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュヴルーズ"
				}
			]
