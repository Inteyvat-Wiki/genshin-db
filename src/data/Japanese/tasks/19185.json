				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "この袋の材質、かなり珍しいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191851102,
					"content": "[知識]（リネの材質識別に協力しよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "「マジックポケット」と似てない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "…うん。ロマリタイムフラワーの繊維でできてるのは同じだけど、こっちのほうが繊細な処理を施してある。防水に耐酸、それに液漏れ防止も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191851105,
					"content": "紐まで特製で、袋の口をぎゅっと閉められるようになってるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191851106,
					"content": "さっき同じ材質の袋をいくつか見つけた。でも小さくて薄いし、簡単に破けてしまいそうだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191851107,
					"content": "密封パックみたいに…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "…確かにちょっと似てる。ガードドッグが「偽造ロシ」の臭いを嗅ぎ分けるとはいえ、密封すれば一時しのぎにはなるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191851109,
					"content": "じゃあ、こっちの大きな袋は何に使うんだろう？「偽造ロシ」の密封用にしては、目立ちすぎるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				}
			]
		},
