			"dialogs": [
				{
					"id": 150170201,
					"content": "さ、着いたよ。結構立派な家でしょ？ちょっと待ってて、ノックするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170202,
					"content": "ラゾーリ、開けて。二人を連れてきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170203,
					"content": "…ラゾーリ？中にいるんでしょ？ドアを開けてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170204,
					"content": "おかしい…鍵もかかってる。この時間に外出するはずないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170205,
					"content": "ニエガちゃん、いる？チョウエンお姉ちゃんだよ。ドアを開けてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170206,
					"content": "まったく反応がない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "でも変だね。ラゾーリと約束したはずなのに…まさか、ニエガちゃんを連れて薬を取りにでも行ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170211,
					"content": "あれ？あそこにあるのってなんだ？テペトル竜の巣だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170212,
					"content": "うん。そういえば、ラゾーリのところにはテペトル竜が一頭いたね。名前は確か…「イェング」だったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170213,
					"content": "彼女がまだ古名を作ってた頃、よくイェングに採掘を手伝わせてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170214,
					"content": "でも、ニエガちゃんがああなってからは、もうそういうことをさせなくなったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170215,
					"content": "ちょっと待って。なんかまわりがすごく散らかってない？イェングもいないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170216,
					"content": "見ろ！箱がたくさん壊れてる！なんかマズいことでもあったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170217,
					"content": "近くに行ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "チョウエンはここにいて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "わ…わかった！ど、どどどこかに隠れておくよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170220,
					"content": "イミシュの口ってば、大霊の祝福でも受けてるの？どうしてあの子に危ないところに行くなって言われるたび、こんな目に遭うんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170207,
					"content": "ドアを突き破る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "まさか、二人にまたなにかあったのか？それとも、ニエガの病気が…うぅ…これ以上想像したくないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170209,
					"content": "大丈夫だよ。昨日私が来たときは、二人とも元気だったから。その時、ニエガちゃんは自分の部屋でぐっすり眠ってたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "チョウエン"
				}
			]
		},
