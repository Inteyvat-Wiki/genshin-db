			"dialogs": [
				{
					"id": 150170101,
					"content": "おっ！二人ともずいぶん早いね。例のプレゼントが楽しみで仕方ないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170102,
					"content": "ニエガたちに会いたかったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "そうだな。ニエガは大変な病気になって、ラゾーリも大事な仕事を失っちゃったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170104,
					"content": "状況は良くなってたとしても、二人がうまく立ち直れるか心配なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170109,
					"content": "ふふっ、私たちがこれから行くことは伝えてあるから、もう準備はできてるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170110,
					"content": "そろそろ行こっか。イミシュ、お店は頼んだ。しばらくしたら戻るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170105,
					"content": "プレゼントが気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "オイラも気になるけど…今はニエガに会いたいって気持ちのほうが強いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170107,
					"content": "大変な病気だったわけだし、身体が心配だぞ。それにラゾーリも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170108,
					"content": "大事な仕事を失ったんだろ？うまく立ち直れるのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "パイモン"
				}
			]
		},
