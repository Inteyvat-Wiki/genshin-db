				]
			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "テペトル竜がいたぞ！ラゾーリが育てたやつかはわかんないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170402,
					"content": "危険な目に遭ったようには見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "うーん…って、違う違う！オイラたちが探してるのはテペトル竜じゃなくて、ラゾーリだぞ！…でも見た感じ、このあたりにはいないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170405,
					"content": "おーい——旅人、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170406,
					"content": "あれ、チョウエンがなにか言ってるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170407,
					"content": "隣に一人増えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "ラゾーリが帰ってきたよー！もう降りてきてー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170409,
					"content": "ええ？オイラたちが登ってすぐ帰ってきたのかよ？まったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170410,
					"content": "とりあえず下に降りよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "あれ、あのテペトル竜がついてきてるぞ！うわぁ、いきなり突っ込んでくるなよ！ぶつかるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170414,
					"content": "テペトル竜と一緒に下山した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "おいで、イェング。またやんちゃしてたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170416,
					"content": "ガゥ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "イェング"
				},
				{
					"id": 150170417,
					"content": "いい子ね。お腹空いた？ごめんね、あとで美味しいご飯作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170418,
					"content": "さあ、遊んでおいで。ご飯ができたら迎えに行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170419,
					"content": "ギャウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "イェング"
				},
				{
					"id": 150170420,
					"content": "二人ともごめんなさいね。家で待ってたんだけど、ニエガが一人でこっそり抜け出しちゃったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170421,
					"content": "「お客さんにプレゼントを作りたくて、きれいなお花を摘んでたんだ」って、見つけたとき言ってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170422,
					"content": "でも、あの子ったら花を摘みながら歩いてるうちに迷子になっちゃって…はぁ、早く見つかってよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170423,
					"content": "ニエガの体調は大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "病気が良くなったばっかだって、チョウエンが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170425,
					"content": "ええ、まだ身体が弱くてね。それに迷子になった不安と、冷たい風に当たったからかちょっと熱を出してるの。今は薬を飲ませて寝かせてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170426,
					"content": "大した症状じゃないから、一晩休めば元に戻るはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170427,
					"content": "ただ…申し訳ないけど、今日は二人に会うのが難しいかもしれないわ。わざわざ来てもらったのに本当にごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170428,
					"content": "いやいや、謝らなくていいぞ。ニエガはすっごく重たい病気で、やっと良くなったんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170429,
					"content": "だから、お見舞いに来ようと思っただけなんだ。オイラたちのことより、ニエガに元気になってもらうことのほうが優先だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170430,
					"content": "病気は完治したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "…少なくとも今のあの子は、私と会話もできるし、普通に生活もできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170432,
					"content": "それだけでもう十分。これ以上、高望みはしないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170437,
					"content": "こらこら、なんで暗くなってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170438,
					"content": "ニエガちゃんの気持ちはしっかり受け取ったから——次はラゾーリ、ほら例のものを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170439,
					"content": "プレゼント！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "やったぜ！どんなプレゼントなんだ？もう教えられるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170442,
					"content": "私が作った「燃晶名刻」よ。最高純度の鉱石を使ってるから、劣化することがほぼないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170443,
					"content": "それに製造技法もすべて、「古名」を作るものに基づいているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170444,
					"content": "つまり「簡易古名」ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "ふふ…そうじゃないわ。そんなことしたら大霊に怒られちゃうわよ。古名を作る技法で鉱石を加工したら、こんな結晶体ができただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170446,
					"content": "結晶体を作りはじめた当初は、「綺麗」で「劣化しない」ってだけで、特に実用性はないと思ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170447,
					"content": "チョウエンが、それを特別な「アクセサリー」にしたらどうって助言してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170448,
					"content": "「『古名の職人』が手がける『燃晶名刻』に、永遠の言葉を刻む」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170449,
					"content": "どう？思わず買いたくなってこない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170450,
					"content": "あれこれ謳い文句が増えてくから、なんだかその「燃晶名刻」がすごいものに見えてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170451,
					"content": "商売上手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "あはは、でもラゾーリが作った「燃晶名刻」はそれくらいの価値があるものなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170454,
					"content": "口伝えの言葉は、常に信じられるものとは限らない。一人また一人と伝わっていく過程で、それは不完全なものになったり、忘れられたり、誤って伝わったりすることだってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170455,
					"content": "でも、この「燃晶名刻」に刻まれた言葉は本来の意味を、少しも歪ませることなく永遠に残すことができるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170456,
					"content": "大切な友達、恋人、子供に贈るのに最高のプレゼントだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170457,
					"content": "今のはセールストーク？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "オイラも思わず心が動きそうになったぞ…旅人、一つ買わないか？オイラたちの名前を入れてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170459,
					"content": "#そんで{M#妹さん}{F#お兄さん}が見つかったら、自分の手で名前を刻んでもらおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170462,
					"content": "そうすれば、オイラたちの名前はずっと一緒だ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170463,
					"content": "パイモンがセールストークにやられた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "遠慮しないで。私だけじゃなく、ニエガちゃんの誕生日プレゼントも守ってくれたじゃない。これくらいは出さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170465,
					"content": "チョウエン、さっきも言ったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170466,
					"content": "ラゾーリも遠慮しないで。「燃晶名刻」を一つ作るのにどれだけ手間がかかるか知ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170467,
					"content": "ありがとう、チョウエン、それに旅人さん。できるだけ早く品を仕上げるわね。出来上がったら、銘を入れてみてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170468,
					"content": "その頃にはニエガも良くなってるだろうから、会いに来てくれたら喜ぶと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170469,
					"content": "いいものを独り占めするのも良くないし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "おい！そういうのは値段を聞いてから考えたほうがいいんじゃないか。もしすっごい高いもんだったら、オイラたちの旅費がなくなっちゃうかもしれないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170471,
					"content": "ってちょっと待ったぁ！まさかオイラたちへのプレゼントとか言いつつ、本当はもっともっとモラを使ってもらうために、チョウエンが仕掛けた罠だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170472,
					"content": "そうかもしれないね～だって君たち…それなりに蓄えがあるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170473,
					"content": "うわぁ！だめだめ！旅人、こいつの罠にかかっちゃだめだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170474,
					"content": "うふふ、それじゃ決まったら、またいつでも言ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170475,
					"content": "ギャウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "イェング"
				},
				{
					"id": 150170476,
					"content": "あれ、あいつまた出てきてるぞ。おい、早く止めてくれ！もう体当たりされるのは嫌だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170477,
					"content": "いい子にしてて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "ガゥ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "イェング"
				},
				{
					"id": 150170479,
					"content": "ラゾーリ、私の「燃晶名刻」の修理もお願いしていいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170480,
					"content": "この間、襲撃に遭ったときに落として、紐も留め具も壊れちゃってね。付けられなくなっちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170481,
					"content": "自分でも修理してみたんだけど、どうもうまく直せなくて…だからお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170482,
					"content": "ええ、任せてちょうだい！元通りにしてあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170483,
					"content": "…ありがとう、チョウエン。助けてくれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170484,
					"content": "いいって、ラゾーリ。ニエガちゃんが元気になってくれたらそれでいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150170485,
					"content": "…ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170486,
					"content": "イェング、いい子にしてて！あとでご飯をあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170487,
					"content": "旅人さん、「燃晶名刻」が完成したら、チョウエンにそのことを伝えさせるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170488,
					"content": "ニエガの誕生日にも、ちょうど間に合いそうだし。その時は、ちゃんとしたパーティーをしましょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170489,
					"content": "へへ、美味しいものがいっぱい出てきそうだな。おなかを空かせておかないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170490,
					"content": "それじゃあまたな、ラゾーリ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170491,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "またね。お二人も元気で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170494,
					"content": "…ニエガも、きっと喜ぶわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170492,
					"content": "ニエガの健康を祈ってるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "お土産にたくさん買おうかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "こんなに貴重なもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "買いたくなってきたかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#一つ買おうぜ！オイラたちの名前を入れてさ。そんで{M#妹さん}{F#お兄さん}が見つかったら、自分の手で名前を刻んでもらおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170452,
					"content": "さすが店をやってるだけある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "どんなプレゼントだろ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "抜け出せたのなら、体調も悪くないみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "そうね。野菜を食べさせようとするときの逃げっぷりもすごいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170435,
					"content": "椅子を跳び越えたり、テーブルの下に隠れたり…家中をぐるぐる走り回って、私もなかなかついていけないほどでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170436,
					"content": "あの子がここまで元気になってくれただけで、私は十分満足しているの。もうこれ以上、高望みはしないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "ラゾーリ"
				},
				{
					"id": 150170411,
					"content": "こんな偶然もあるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "とりあえず下に降りようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150170403,
					"content": "自分でここまで来たっぽい…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
