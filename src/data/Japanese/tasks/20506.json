			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "こんにちは、僕は錬金術の研究者ティマイオス。モンドへようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060102,
					"content": "錬金術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "錬金術は古代からの技術で、今でも分からないことが多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060104,
					"content": "そしてその法則はミステリアスで、僕たちが知る創造物体の原理とは全く違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060105,
					"content": "この技術を使いこなすことができれば、きっと素晴らしいものが作り出せるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060106,
					"content": "あれは錬金術用の台？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205060107,
					"content": "そうだよ。あっ、そうだ、錬金術を試してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060108,
					"content": "複雑に聞こえるけど、大丈夫なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "大丈夫、操作はそんなに複雑じゃない。興味があるなら基礎を教えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060111,
					"content": "錬金合成",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "爆発しないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
