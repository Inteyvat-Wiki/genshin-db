			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティマイオス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "不思議だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205060202,
					"content": "今僕たちが使ってる錬金術は、まだ先人たちが残した方法を真似してるだけに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060203,
					"content": "風の翼を使うのにその作り方まで知る必要はないだろう？錬金術も似たようなもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060204,
					"content": "ただいつも、やっとその原理を理解したと思った直後に予想外のことが起きるから、はあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060205,
					"content": "錬金術は何に使えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "正直に言うと、僕にも分からないよ。でも分からないからこそ興味がわくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060210,
					"content": "僕もまだいろんな配合を研究してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060211,
					"content": "冒険してる途中で、古代文明が残した錬金術に関する記録を発見することがあると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060212,
					"content": "「冒険ランク」が上がれば、理解できる配合も増えていくはずさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060213,
					"content": "説明ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "どういたしまして。君が得た成果を僕に共有することも忘れないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060218,
					"content": "また会おう。君たちの旅に風のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060215,
					"content": "そしたらパイモンを作れるはずだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "まだそれを言う！オイラのどこがだめだっていうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205060217,
					"content": "ハハッ、二人とも面白い人だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "ティマイオス"
				},
				{
					"id": 205060207,
					"content": "パイモンを作り出せる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "オイラだけじゃ満足できないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205060209,
					"content": "ハハハッ、残念だけど今はまだできないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "ティマイオス"
				}
			]
		}
	]
}