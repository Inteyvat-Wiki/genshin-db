			"dialogs": [
				{
					"id": 716710101,
					"content": "ううっ…あの夜蘭が手強いって言うだけあったな。そのへんの秘境とはわけがちがうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710102,
					"content": "この地脈の乱れが記録してる戦いって、なんだったんだろうな…普通の兵士には厳しすぎないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710103,
						716710104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710103,
					"content": "魔神戦争の時の戦い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				},
				{
					"id": 716710105,
					"content": "うーん…そこまで恐ろしいものじゃない気もするけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710106,
					"content": "おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710107
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710107,
					"content": "落ち着いてるじゃない。順調だったのね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710108,
					"content": "めちゃくちゃ危険な状況にもなったけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710109,
					"content": "刻晴と夜蘭に状況を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716710110
					]
				},
				{
					"id": 716710110,
					"content": "そうだったのね…本当にご苦労さま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710111
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710111,
					"content": "君たちが乱れ地点を通って秘境に入ってから、外に溢れ出る魔物は大幅に減ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710112,
					"content": "地脈の乱れを完全に排除できたわけじゃないけど、その力は確かに弱まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710113,
					"content": "おかげで魔物の脅威は大幅に下がり、一般の兵士でも倒せるようになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710115,
						716710116
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710115,
					"content": "一回で危険性を実感した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710117,
					"content": "やる気に燃えてるな…今にも戦いにいっちゃいそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710118,
					"content": "玉京台への急ぎの手紙に、返信が来たわ。天権も開陽も、旅人と長期的な協力関係を結ぶことに同意してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710119
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710119,
					"content": "君のおかげで、この地脈の乱れ地点を逆手にとって、上手く利用することさえできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710120
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710120,
					"content": "これから駐屯軍は全面的に君を支援するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710121
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710121,
					"content": "この地脈の乱れ地点の活動期間中は、好きな時に秘境に入って。外に漏れた魔物は訓練も兼ねて、千岩軍で片付けるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710122
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716710122,
					"content": "ピンチをチャンスに、ってところかしらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710123,
						716710124
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716710123,
					"content": "これからも、全力で頑張る！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710125,
					"content": "ふぅ…やっとひと息つけるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710126,
					"content": "それにしても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710127,
					"content": "地脈って本当に不思議だよな。どうにかして、もっと秘密を探ってみたいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710128,
					"content": "どこかに物知りなやつがいたりしないかな？『地脈百科全書』を持ってるやつとか…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716710124,
					"content": "気が向いたら来る！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710116,
					"content": "厄介な敵には、長期戦で挑もう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710104,
					"content": "災害時の極限状況とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				}
			]
		}
	]
}