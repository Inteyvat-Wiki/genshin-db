			"dialogs": [
				{
					"id": 200110201,
					"content": "ありがとう、旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110202,
					"content": "しかしここに障害物がある限り、通れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110203,
					"content": "ハハハッ、本来なら自分でなんとかするところだけど…ヒルチャールに襲われて、全身痛いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110204,
					"content": "でもアナのために採ってきた薬草が無事でよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110205,
					"content": "すまないが、この障害物をなんとかしてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110206,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "ありがとう、少し休むよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110207,
					"content": "他に急用がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "でもアナがまだ俺を待っている…頼む、助けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		},
