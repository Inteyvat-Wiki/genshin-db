			"dialogs": [
				{
					"id": 200110301,
					"content": "これで通れるはずだ…ありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110302,
					"content": "うちはお金がなくてな、アナの病気もずっと治らないから、よくここに薬草を採りに来るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110303,
					"content": "薬草を採ったのはいいが、まさかアイツらに襲われると思わなかった。お前が来てくれてよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110304,
					"content": "これはお前にあげるよ。咳止めの効果があるから、よくこれをアナに飲ませているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200110305,
					"content": "お前もよく野外にいるだろう？体に気を付けてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
