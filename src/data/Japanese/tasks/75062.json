						],
						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620401,
					"content": "まだいるのか、勇士よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620402
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620402,
					"content": "かつて、とある学者が言った——この灰燼の都の残虐な主は、アビスの侵食を止める方法を持っていると。それで我々は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620403
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620403,
					"content": "だが、ここは実に不気味だ。この頃そう思えてきた。何かがおかしい、とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620404
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620404,
					"content": "昨日まで綺麗だった道が次の日にはボロボロになっている…あの石造りの家は初めからあんな風だったか？もっと…まともだった気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620405
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620405,
					"content": "それから、目が覚めたら、二度と現れるはずのない友人を見ることもある…あれは魔物だったんだろうか？友人の姿に化けた魔物だったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620406
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620406,
					"content": "私の…私の責務は、ここの魔物を片付けることだ。だが、なぜ…そうしなければならない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620407
					],
					"speakerTitle": "クエニン"
				},
				{
					"id": 750620407,
					"content": "とにかく、ここはおかしいんだ…早く離れたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クエニン"
				}
			]
		},
