				"points": []
			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "新しい生徒を集めるのは簡単なんだが、問題は訓練してしばらく経つと何かしら理由をつけて休んだり、そのまま来なくなるやつが多いことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150302,
					"content": "だから、コーチもどうにかみんなのやる気を上げようと考えてて、その内の一つがブロックの挑戦ってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150303,
					"content": "でも、スコアを上げようとブロックに突っ込むやつが続出してな…顔面を腫らして帰るやつが増えたもんだから、おかげでさらに欠席者が増えちまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コリー"
				}
			]
		},
