			"trigger": {
				"objectNames": [
					"コリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "あんたも筋力トレーニングに興味があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150102,
					"content": "器具は自由に使っていいが、その細い腕と脚…ケガしないように気をつけろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150103,
					"content": "毎日たくさん動いてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "本当か？なら、大口を叩く前にまずそこのでっかいブロックと勝負してみな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150106,
					"content": "ルールは簡単だ。ブロックに<color=#00E1FFFF>攻撃を放つ</color>か、直接ブロックに<color=#00E1FFFF>ぶつかって</color>、その力の大きさをスコアで測る。さぁ、腕前を見せてもらおうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150104,
					"content": "ヒルチャールを一発で倒せるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
							"2"
						],
						"stepId": 7521502,
						"stateName": "QUEST_STATE_UNFINISHED"
