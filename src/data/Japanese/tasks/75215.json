				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "…うそだろ？このでかいブロックの一角を壊したってのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150202,
					"content": "こんな力を持ってるやつなんて、ヴァレサ先輩以来だな…どうやらあんたも彼女と同じく、才能に恵まれた天才型らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150203,
					"content": "ちょっと大変だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "ホント、人は見かけによらないもんだな。機会があればぜひ指導してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150206,
					"content": "そうだ、これをやるよ。豊穣のフルーツジュースってやつで、運動の効果を高めてくれるそうだ。うちの生徒たちの間でも人気だから、あんたも試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コリー"
				},
				{
					"id": 752150204,
					"content": "このくらいなら楽勝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
			"completionStepIds": [],
