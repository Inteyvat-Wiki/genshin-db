			"trigger": {
				"objectNames": [
					"小鳥",
					"シニャク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "シニャク姉さん…に、兄さんはわざと…！わ、私と一緒にいたくないから…！ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 210370402,
					"content": "小鳥ちゃん、朝も夜もずっと一緒にいた仲なんだから、お兄さんがあなたの気持ちを知らないはずないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 210370403,
					"content": "璃月を離れて旅に出るのも、自分なりの考えがあったからよ。どうして一緒に行くのが嫌なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 210370404,
					"content": "私は璃月から離れたくないもの！二人でずっとここにいてもいいでしょ？古華派なんて…古華派なんてどうだっていい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 210370405,
					"content": "じゃあ、なんでその気持ちを教えてあげなかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "シニャク"
				},
				{
					"id": 210370406,
					"content": "わ…わ…私は…兄さんはずっと古華派のことしか心にないから…私が兄さんにそんな話をして、嫌われたらどうしよう…って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "小鳥"
				},
				{
					"id": 210370407,
					"content": "はあ、小鳥ちゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シニャク"
				}
			]
		},
