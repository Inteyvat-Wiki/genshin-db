					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "ありがとう、これで十分だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370302,
					"content": "あまり気が進まないように見えるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "ん？ああ、大丈夫だ、ハハハ…締まらないところを見せてしまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370304,
					"content": "ただ、長い間暮らしてきた璃月をいきなり離れるというのは…やはり少し寂しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370305,
					"content": "いつ出発するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "物資の準備が整い次第、出発する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370307,
					"content": "そうだ、前に一緒に層岩巨淵に行ってくれたあの冒険者も、同行することになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370308,
					"content": "彼女は私がフォンテーヌに行くと聞いて、自分も興味があるからと、一緒に来ることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370309,
					"content": "商人は守ってくれる冒険者が一人増えたと喜んでいるが…正直、ああいう親切がすぎる人との付き合いは本当に苦手なんだ、はあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370310,
					"content": "まさか、私にも郷を離れ、遠出する日が来るなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
