			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "ああ、璃月…璃月よ、次に帰ってくるのはいつのことになるだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "旅人、君か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370104,
					"content": "実は、フォンテーヌへの旅立ちがやっと決まったんだ。数日後にあの商人と一緒に発つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370105,
					"content": "いま彼は貿易の事務処理をしなければならないから、私もその間にもう少し荷物をまとめている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370106,
					"content": "絶雲の間に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "ふん、辺りを見て回っているうちに、璃月を離れたくなくなるかもしれないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370109,
					"content": "ここでもう少し街を見ていくつもりだ。ここには長い間住んでいた…今回離れたらいつ戻ってこられるのか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370110,
					"content": "そうだ、小鳥は…一緒に来てくれなかった。だがシニャクには小鳥の面倒をよく見てくれるよう頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370111,
					"content": "もっとも、小鳥には少しお金を残したし、あの子は私より頭がいい、自分の面倒は自分で見られるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370112,
					"content": "…いつか、小鳥が私を理解してくれる日が来るといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370113,
					"content": "そうだ、旅人、もう一つお願いしたいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370114,
					"content": "「土」を少し集めてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370115,
					"content": "問題ないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "故郷を離れるときは、何かしら思い出の品が必要だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370118,
					"content": "璃月の土をひとつまみでも持っていれば、この土地との繋がりを持っていられる気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370119,
					"content": "なんで自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "ハハハ…さっきも言っただろう？もし私が辺りを見て回って、故郷の景色に情が湧いてしまったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370121,
					"content": "せっかく故郷を離れると決意したこの心も、きっと揺らいでしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370122,
					"content": "だから、土を採ってくる件は頼む、旅人。欲しい土の位置は地図に記しておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370123,
					"content": "それはなにか特別な場所？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "コホン…か、かつてはよくそこで、小鳥と一緒に剣の練習をしていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370125,
					"content": "とにかく！土を採ってくる件は頼むよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370116,
					"content": "何のために？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "辺りを見て回っておかなくていいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
