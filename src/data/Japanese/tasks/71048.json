			"dialogs": [
				{
					"id": 710480201,
					"content": "戻って来たのね、冒険者協会は君を歓迎するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480202,
					"content": "層岩巨淵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "あそこに何があるか聞きたいの？ふふ、どうでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480204,
					"content": "ある人は、鉱夫が願いの石を掘り出して、願い事をしたら裏目に出たと言い、またある人は、古い龍王の尻尾を掘り出したと言う…どれも面白い噂だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480205,
					"content": "まあ、層岩巨淵のことに関しては私も詳しくないから、沐寧に聞くといいわ。これは総務司からの依頼だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480206,
					"content": "依頼について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "コホンッ…層岩巨淵に頼って生計を立てていた商人が街中に溢れているわ。君は厄介事を恐れてはいないだろうけど、こっちは冒険者協会の人間を養わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480208,
					"content": "沐寧について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "ああ、彼ね…ふん、層岩巨淵に駐留させたのは、総務司が彼を鍛えたかったからでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480210,
					"content": "彼のように恵まれた環境で育った子はすぐいい気になってしまうものだし、こんな風にずっとふらふらしてるのは、役人としてはどうなのかしら…だから層岩巨淵で成長させたいんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 710480211,
					"content": "また後で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "ええ、あっ…星と深淵を目指せ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		}
	]
