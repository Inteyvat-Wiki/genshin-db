			},
			"dialogs": [
				{
					"id": 230260401,
					"content": "顔を上げてみろ、教令院を下から支えている大きな樹が見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260402,
					"content": "次の問題は簡単だが、意外と知らないやつが多いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260403,
					"content": "それでは、教令院を支えている大きな樹、その名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260404,
					"content": "大樹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "そのまんまだな！残念ながら、間違いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260406,
					"content": "聖樹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
