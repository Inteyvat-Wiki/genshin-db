					"ズィルヤーブ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "コホンッ…ご存知かもしれないが、教令院の各学派にはそれぞれ得意な研究分野がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260202,
					"content": "教令院の中で最も研究している学者が多い学派、つまり生論派の学者が主にいる学院は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260203,
					"content": "アムリタ学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "いいぞ、大正解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260205,
					"content": "アリムタ学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "うーん、惜しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260207,
					"content": "アタムリ学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "はは、残念。とても惜しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				}
			]
		},
		{
			"id": 2302603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
