			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズィルヤーブ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "この問題、難しすぎるだろうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260102,
					"content": "おや？旅人！ちょっといいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260103,
					"content": "#{M#俺}{F#私}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "まさに！ははは、君を呼んだのは、ちょっとしたお願いをしたかったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260105,
					"content": "何か落としたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "お、なんだかこういうことに手慣れているみたいだな…！ははは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260109,
					"content": "全部違うぞ、落とし物はないし、研究の材料も足りてる。取材については…まあ、もう沢山取ったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260110,
					"content": "コホンッ、実は…スメールに広く流布している各種用語を新入生がいち早く理解できるよう、「問答集」を書いているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260111,
					"content": "簡単に言えば、一問一答形式で複雑な各種用語を解説するものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260112,
					"content": "これなら効率よく言葉を覚えられて、過程も退屈にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260113,
					"content": "ただ、問題の難易度は自分ではわからなくてね…だから、君に判断してもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260114,
					"content": "教令院には詳しくないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "ははは、いい機会じゃないか。僕の問題に答えていれば、少しは分かるようになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260119,
					"content": "心配するな。これらの問題は物事を深掘りするようなものじゃない、どれも日常的なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260120,
					"content": "それじゃ問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260116,
					"content": "前にも同じことをしたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "モンドのスワンに、西風騎士団について問題を出されたことがあったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230260118,
					"content": "スワンの時は騎士団ガイドっていう模範解答があったけど…こいつは、なんかそういうのはくれなさそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230260106,
					"content": "材料が足りない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "取材？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
