			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズィルヤーブ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260301,
					"content": "君は旅の途中、「ダリオッシュ」と自称するたくさんの「遊学者」に会ったかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260302,
					"content": "もちろん、教令院のどこかの学院にも沢山の「ダリオッシュ」がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260303,
					"content": "この学院は、元素を理論の中心に据え、元素力と関連するあらゆるものを研究している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260304,
					"content": "その学院の名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260305,
					"content": "スパンタマッド学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "その通り。「素論派」の学者が集まるスパンタマッド学院だ。彼らは七つの元素をあらゆる物質と命の本質と見なしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260307,
					"content": "ハルヴァタット学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "おっと、間違えたな。「ハルヴァタット学院」にいる「知論派」の学者たちは、言語や記号、論理学を研究している…信じてくれ、あれは本当にややこしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				},
				{
					"id": 230260309,
					"content": "ルタワヒスト学院。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "うーん、残念だが間違いだ。「ルタワヒスト学院」は「明論派」の学者たちの本拠地だ。彼らの研究の核となるものは、僕たちの頭の上にある星空だ…はは、面白いだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズィルヤーブ"
				}
			]
		},
		{
			"id": 2302604,
			"completionStepIds": [],
