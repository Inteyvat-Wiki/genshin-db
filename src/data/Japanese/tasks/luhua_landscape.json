			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "まずい、これでは絵が描けないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "君は…ああ、旅人だね。実は僕、絵を描くためにこの漉華の池の周りで取材してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060104,
					"content": "でもなかなか納得できる角度が見つからなくてね、いい作品がまだ描けてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060105,
					"content": "景色に集中しすぎたせいか、ここに来てやっと僕の筆と顔料が半分以上なくなってることに気付いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060106,
					"content": "きっとこの周りのどこかに落としたと思うけど、探すのを手伝ってくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060107,
					"content": "どこで絵を描いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "えっと…実は僕もよく覚えてないんだ。絵を描く時はいつも絵に集中してるから、周りの状況や位置は分からないや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060109,
					"content": "でも、この周りで描いた絵は2枚だけだから、あの2箇所だけだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060113,
					"content": "この2枚の絵を君に渡すよ。僕の画材は絵を描いた時の<color=#00E1FFFF>場所</color>にあると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060114,
					"content": "見つけたら僕に持ってきてくれると助かる。僕はもっといい角度はないかここで探してみるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060110,
					"content": "でもどこで探せば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "絵を描く時はいつも絵に集中してるから、周りの状況や位置は分からないや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060112,
					"content": "でも、この周りで描いた絵は2枚だけだから、あの2箇所だけだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "フェルメール"
				}
			]
		},
