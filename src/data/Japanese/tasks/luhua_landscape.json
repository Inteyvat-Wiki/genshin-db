					"content": "<color=#00E1FFFF>漉華の池</color>の中で拾ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060705,
					"content": "何？君も<color=#00E1FFFF>漉華の池</color>の中で探すのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060706,
					"content": "気を付けたほうがいいよ。池の中にはいろんなものがあるからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
