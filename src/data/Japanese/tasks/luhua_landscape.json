					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "やあ、画材は見つかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060602,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "やっぱり絵を描いた場所にあったんだね。絵を描く時はいつも道具を地面に置くからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060604,
					"content": "そのまま忘れてしまうこともたまにあるんだ。ありがとう、これで新しい画材を買わなくて済むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060605,
					"content": "まだここで絵を描くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "その話はやめておくれ。この二体の彫像の目は光るし、遠くからでもはっきり見えるって聞いたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060607,
					"content": "目が光る巨像が山の横に佇む…絶対いい絵になると思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060608,
					"content": "でもここに来ると、確かに彫像はあるけど、光る目なんてなかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060609,
					"content": "タイミングを逃した、もしくは角度を間違えたと思って、この周りで角度とか探してたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060610,
					"content": "でも…いくら探しても、何も見つからなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060611,
					"content": "唯一の収穫は、下の池からこれを見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060612,
					"content": "実は…同じ石を持ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "おや？どれどれ…本当だ、そっくりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060614,
					"content": "裏に字が書いてあるよ、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060615,
					"content": "「石の兵が扉を隠す、入りたい者は点睛せよ」…点睛？どういう意味かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060616,
					"content": "この石、僕が持っても仕方ないから、君にあげるよ。画材を探してくれたお礼にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060617,
					"content": "ある考えがあるんだけど、この二つの石って目だったりすると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060618,
					"content": "もし本当に目だったら、あの言葉にある「点睛」も、この石と関係があったりしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060619,
					"content": "ハハハッ、あくまで僕の推測だよ、あまり気にしないで。僕は取材を再開するよ、画材を探してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
