			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "やあ、画材は見つかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060202,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "やっぱり絵を描いた場所にあったんだね。絵を描く時はいつも道具を地面に置くからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060204,
					"content": "そのまま忘れてしまうこともたまにあるんだ。ありがとう、これで新しい画材を買わなくて済むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060205,
					"content": "まだここで絵を描くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "その話はやめておくれ。この二体の彫像の目は光るし、遠くからでもはっきり見えるって聞いたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060207,
					"content": "目が光る巨像が山の横に佇む…絶対いい絵になると思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060208,
					"content": "でもここに来ると、確かに彫像はあるけど、光る目なんてなかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060209,
					"content": "タイミングを逃した、もしくは角度を間違えたと思って、この周りで角度とか探してたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060210,
					"content": "でも…いくら探しても、何も見つからなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060211,
					"content": "唯一の収穫は、下の池からこれを見つけたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060212,
					"content": "どういうものかは分からないけど、見れば見るほど、この石は目に見えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060213,
					"content": "でも本当に目だったら、もうひとつあるはずだよ。だって目は二つあるもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060214,
					"content": "まあ、これはあくまで僕の推測だから、あまり気にしないで。この石、僕が持っても仕方ないから、君にあげるよ。画材を探してくれたお礼にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710060215,
					"content": "はあ、目が光る彫像…漉華の池に一体どんな秘密があるんだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
