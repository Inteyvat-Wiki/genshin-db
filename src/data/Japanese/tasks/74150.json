			},
			"dialogs": [
				{
					"id": 741500301,
					"content": "仕事は終わったかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500302,
					"content": "終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "全部きれいに片づけたぞ。モリィも猫にエサをあげたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500304,
					"content": "ブノワじいちゃん、家の脇に古くて汚い箱が積んであったけど、それも一緒に片づけたほうがよかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500305,
					"content": "箱？ああ…あれは放っておいてくれ。昔の物をしまうのに使っているガラクタの箱だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500306,
					"content": "前の家で使っていた家具や小物の類いでな。捨てるのはもったいないが、部屋に置いてもインテリアに合わん。だから、積んだままにしておるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500307,
					"content": "ずっと放置しっぱなしだが、ご近所さんは良識のある人ばかりだ。誰も盗んだりはせんから、そのまま置いておけばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500308,
					"content": "ねえ、ルロワさん。あたし、役に立てた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500309,
					"content": "もちろん大助かりだ、モリィ。帰ってご両親によろしく伝えてくれたら、なおのこといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500310,
					"content": "さあ、お菓子とお小遣いは用意してある。これをみんなで分けるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500311,
					"content": "い、いいってば。お小遣いはいらないから。それより、もうちょっとナナをなでてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500312,
					"content": "いいとも。さぁ行ってきなさい。爪に気をつけるんだよ。満足したら、お菓子を食べにおいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500313,
					"content": "お義父さん、なぜお出かけを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500314,
					"content": "うちの子たちは留守で相手をしてくれんだろ？老いぼれ独りでは寂しくてな。外に出て新鮮な空気を吸っておったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500315,
					"content": "モルティシア、見てごらん。何日かいなかっただけで、すっかりご機嫌斜めだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500316,
					"content": "でもどんなお土産を用意したか知れば、お義父さんもきっと許してくれるはずだ。そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741500318,
					"content": "お土産？何を持ってきたのかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500319,
					"content": "それはもちろんいいものです。見たら分かりますよ。高価できれいなものがお好きなお義父さんのために、モルティシアがわざわざ選んだんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500320,
					"content": "そうか、それは感謝せんとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500321,
					"content": "当然のことをしたまでですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741500322,
					"content": "おっと、そうだ。この小さなお客さんたちは、お前たちが遠出している間、うちに遊びに来た子たちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500323,
					"content": "初めまして。うちの義父は優しくて、子供が大好きなんだ。君たちが一緒にいてくれて本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500324,
					"content": "でも、もう僕と妻が戻ってきたから大丈夫。君たちに代わって、あとは僕らがお義父さんの面倒を見ないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500325,
					"content": "そうだな、お前たちが戻ってきてくれてよかったよ。さあ、お土産を見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500326,
					"content": "お父さん、お家に帰りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741500327,
					"content": "ああ。アトーズ、この子たちにお菓子と報酬を渡してくれ。掃除やナナのエサやりをしてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500328,
					"content": "おっと、あそこのお嬢さんにもお菓子を渡してくれるかな？わしは先に部屋に戻っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500329,
					"content": "ルロワさん、ナナがお腹をなでさせてくれたよ…あれ、ルロワさんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500330,
					"content": "うちの義父を探しているのかな、お嬢さん？僕はあの人の娘婿…まあ息子みたいなものだ。名前はアトーズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500331,
					"content": "娘婿の意味なら知ってるよ。ルロワさんの娘さんの夫でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500332,
					"content": "ははっ、物知りだね。義父は先に家に帰ったんだ。義父の相手をしてくれて、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500333,
					"content": "お菓子をどうぞ。今後は僕と妻が付き添うから、もう来なくて大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500334,
					"content": "さ、早く帰ったほうがいい。外でずっと遊んでいたら、ご家族が心配する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500335,
					"content": "ううん、おじさん。あたし、全然迷惑だなんて思ってないよ。それに、ルロワさんと約束したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500336,
					"content": "ルロワさんには、まだあたしの助けが必要だと思う。猫のエサやりとか植物の水やりとか、お手伝いできたらうれしいな！だから、また来るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500337,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500338,
					"content": "チッ、それが迷惑だっていうんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500339,
					"content": "あれ？おじさん、どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500340,
					"content": "ああ、いや何でもない。君に一つ相談がある。いや、相談というか君にやってほしいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500341,
					"content": "いいよ、おじさん。どんなこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500342,
					"content": "おじさんがお菓子とお小遣いをあげるから、もうここへは来ないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500343,
					"content": "どうして？あたし、悪いことでもした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500344,
					"content": "いや、君は何も悪くない。ただ義父はずっと体調が優れないんだ。最近は不眠もひどくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500345,
					"content": "義父の健康を考えると、静かな環境で休養したほうがいいと僕と妻は思っている。分かってくれるね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500346,
					"content": "ルロワさん、体の調子が悪いんだ…わかった。じゃあ、これからはバブルオレンジを持ってくることにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500347,
					"content": "いつもケーキの食べすぎでお腹を壊すと、パパがお説教するの。甘いものは控えて、果物を食べなさいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500348,
					"content": "ルロワさんも果物をいっぱい食べたら、きっと元気になるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500349,
					"content": "…はぁ、こうなったらもう仕方ないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500350,
					"content": "子供たち、お菓子と報酬はこの僕が払うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500351,
					"content": "だから、はっきりさせておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500352,
					"content": "ルロワ家を代表して言わせてもらう。今後は、僕たちの暮らしを邪魔しないでもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500353,
					"content": "君たちは若いが、話の分かる人たちだと信じているよ。今後の訪問は遠慮してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500354,
					"content": "そういうことだから。では失礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741500355,
					"content": "どうしてもう来ちゃいけないの？おかしいよ、ルロワさんはあんなにいい人なのに、なんであのおじさんは来るなって言うんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500356,
					"content": "だよな。あいつ、妙に品のある話し方をしてるくせに、やってることはすっごく冷たいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500357,
					"content": "おじさんになんて言われても、あたしはまた明日ルロワさんに会いに行くつもり。あなたたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500358,
					"content": "一緒に行こう。ナナがかわいいから、もっとなでたいの。それにルロワさんだって、お菓子をくれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500359,
					"content": "#{M#俺}{F#私}たちもまた来るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "約束だよ。一緒に猫をなでて、ルロワさんと遊ぼうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500361,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "うん、またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モリィ"
				}
			]
		},
