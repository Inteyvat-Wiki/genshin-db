			"dialogs": [
				{
					"id": 741500101,
					"content": "ありがとう、モリィ。おまえさんの美しい紫の瞳には、慈悲の光が宿っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500102,
					"content": "ふふっ、そうかな？そういえばルロワさん、この間あげたお人形は気に入ってくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500103,
					"content": "ああ、とても気に入ったよ。可愛い子だ。食卓にあの子専用の場所まで作ってやったほどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500104,
					"content": "本当？きっとあの子も喜んでると思う！それで今日は？お散歩のお手伝い？それとも新聞を取ってくる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500105,
					"content": "新聞を音読してあげてもいいよ。もしルロワさんの目がかすむようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500106,
					"content": "ママは一日一善を心がけなさいって言うの。家庭教師のお姉さんにも今週、「よい行い」っていうテーマの作文を出さなきゃいけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500107,
					"content": "あっ、作文のためにお手伝いするんじゃないよ。でもできれば、ルロワさんの力になりたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500108,
					"content": "ははっ、いいんだよ。おまえさんがご両親に伝えた上で、ここに遊びに来てくれてることが何よりのお手伝いなのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500109,
					"content": "うん、ルロワさん。けどパパとママに話したら、あんまりうれしそうじゃなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500110,
					"content": "それでも、また来てくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500111,
					"content": "もちろん。パパやママがダメって言っても来る。だってあたしたち、約束したでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500112,
					"content": "おまえさんは約束を守るいい子だな、モリィ。ルロワじいさんはおまえさんが大好きだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500113,
					"content": "おや、優しい小さなお客さんたち、よく来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500114,
					"content": "…えっと、話し中だったから、邪魔しちゃ悪いかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500115,
					"content": "お邪魔じゃなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "とんでもない。邪魔だなんてことはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500117,
					"content": "小さな友人のモリィが宿題のために奔走しておってな。ちょうどうちの前を通りかかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500118,
					"content": "彼女が手伝いを申し出てくれたから、ちょっとした仕事を頼んだ。そうすれば、作文も書きやすくなるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500119,
					"content": "別に宿題があるから「よい行い」をしてるんじゃないもん。す、少なくとも宿題のためだけってわけじゃないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500120,
					"content": "そうだな。おまえさんはいい子だ。宿題のためだけに親身になってくれたわけじゃないのは分かっとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500121,
					"content": "この若いお客さんたちと同じようにな。この二人も仕事が欲しくて訪ねてきたわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500122,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "えーっと…オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500124,
					"content": "ちょっとした冗談だ、気にせんでくれ。おまえさんたち、この老いぼれに目くじらを立てたりはせんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500125,
					"content": "若いもんには時間がたっぷりある。そして、おまえさんたちはここに時間を潰しに来た。わしも若いもんがいてくれると嬉しい。いいことづくめじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500126,
					"content": "それと、おまえさんたちに仕事を用意した。この辺は人の往来が激しくてな、玄関にすぐホコリがたまる。裏口もしばらく掃除してない。悪いが、また綺麗にしてくれんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500127,
					"content": "おう…わ、わかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741500128,
					"content": "モリィはネコと遊んでくれるかい？ついでに魚肉をあげて、相手をしてやってくれ。そうそう、あの子のナナという名前だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500129,
					"content": "うちで昔飼っていた犬の名前を付けたんだ。残念ながら、その犬は前の娘が遠くに嫁いだ際、連れていってしまったがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741500130,
					"content": "うん、任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741500131,
					"content": "ではみんな、仕事に取り掛かってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブノワ·ルロワ"
				}
			]
		},
