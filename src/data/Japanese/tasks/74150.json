			"dialogs": [
				{
					"id": 741490601,
					"content": "新聞配達か？玄関に置いといてくれ。あとで取りに行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490602,
					"content": "（今日はもうブノワさんの手伝いをしたし、何度も休憩の邪魔をするのはちょっと失礼かもしれない。明日会う約束をしたんだから、その時にまた来よう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "たたく"
