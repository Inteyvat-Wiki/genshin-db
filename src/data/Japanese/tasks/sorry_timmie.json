			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680501,
					"content": "さあ、早くハッシュドポテトをティミーに渡しておいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680502,
					"content": "ティミーが言ってたママ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "ええ、私よ。私が世話が必要な子供たちの世話を見てるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680504,
					"content": "ティミーはその中で一番長く一緒にいたからね、いつの間にか「グレイスママ」と呼んでくれるようになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680505,
					"content": "呼んでくれるのはうれしいけど、私は彼の本当の家族じゃないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680506,
					"content": "ティミーはどうしてそんなに怒ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "そ、そんな質問をするのね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680508,
					"content": "あの子は友達が少ないの。ノーラとグローリーの他に、あの子と一緒に遊んでくれるのは小動物たちだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680509,
					"content": "それなのに、あなたはハトたちを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680510,
					"content": "…ううん、なんでもないわ。早くハッシュドポテトをティミーに渡すといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
		},
