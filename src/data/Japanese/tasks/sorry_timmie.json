				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "…早く食べて、食べ終わったら早く行って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680302,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "またお前か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680308,
					"content": "一体なにがしたいんだ、まさかまたアヒルやハトになんかするつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680309,
					"content": "はい、ハッシュドポテト。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "ハッシュドポテト？どうしてこの作り方が分かるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680312,
					"content": "わかった、グレイスママのところに行ったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680313,
					"content": "フン、これでボクを買収するなんて甘いよ！お前がハトやアヒルにしたこと、ボクは誰よりも知ってるんだからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680314,
					"content": "…でも、このハッシュドポテトを送ってもらったってことは、グレイスママは早く仲直りしてほしいってことだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680315,
					"content": "ノーラとグローリーの世話もあるし、これ以上グレイスママを困らせたくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680316,
					"content": "先に言っておくけど、ボクは許したわけじゃないからね！ママに迷惑をかけたくないだけだから、わかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680317,
					"content": "フン…どうせボクは子供だから、こういう約束もすぐ忘れるんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680318,
					"content": "パパが戻ってきたら、絶対言いつけてやるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680310,
					"content": "このハッシュドポテトを受け取って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "ティミー、あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "なんでまたくるの？いい加減にしてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "ティミー"
				},
				{
					"id": 200680304,
					"content": "な、なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "ボクに聞くわけ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "ティミー"
				}
			]
		},
