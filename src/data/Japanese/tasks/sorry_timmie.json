					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "はあ、どうしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680102,
					"content": "えっと、どうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "ああ、旅人、ちょうどよかったわ。アヒルの件、ティミーに教えてもらったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680104,
					"content": "はあ…その…なんというか、あなたのことを知らないわけではないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680105,
					"content": "その勇気と力を…こんなところに使わなくても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680106,
					"content": "お腹がすいたから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "あの…お腹がすいたなら、ちゃんとした仕事を探せばいいのでは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680110,
					"content": "あなたの実力なら、冒険者協会では大活躍することに間違いないでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680113,
					"content": "もう済んだことだし、これ以上言っても意味はないけど、ティミーはこの件で拗ねているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680114,
					"content": "ティミーの…父親からあるレシピを教えてもらった。「慕風のマッシュルーム」の入った「モンド風ハッシュドポテト」はティミーの大好物だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680115,
					"content": "「慕風のマッシュルーム」を三つ探してきてほしい。ティミーがそれを食べると、きっと喜ぶはずだから…仲直りもできるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "ええ、なるべく早く戻ってほしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680120,
					"content": "慕風のマッシュルームは…確か城内の南の家屋の軒下なら見つかると思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680121,
					"content": "なるべく早く戻ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680117,
					"content": "わかった、たくさん持ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "三つでいいのよ。たくさん持ってくるなんて、ティミーが拗ねる度にこれで解決しようとしてるんじゃないわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680107,
					"content": "手が滑っただけだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "手が滑ってハトやアヒルを？ではあなたが今まで遭遇した強敵も、きっと「手が滑って」倒したんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680108,
					"content": "力は普段の修行の成果だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "そ、それは…まあ、あなたの実力は確かに本物だったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "グレイス"
				}
			]
		},
