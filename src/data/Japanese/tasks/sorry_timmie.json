					"グレイス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "これで十分よ、ありがとう。少し待っててね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680402,
					"content": "これでいいわ、この「モンド風ハッシュドポテト」をティミーに渡してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680403,
					"content": "それと今後はそういう…よくないことはしないように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680404,
					"content": "私の忠告を覚えておきなさい。もう私とティミーを失望させないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "グレイス"
				},
				{
					"id": 200680405,
					"content": "まあ…みんなが忠告を覚えてくれるなら、シスターヴィクトリアもそんなに忙しくはならないのにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グレイス"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
