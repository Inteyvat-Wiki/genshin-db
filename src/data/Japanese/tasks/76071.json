			"trigger": {
				"objectNames": [
					"ベレナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "美味しいパンが作れたら、みんなを元気づけられるかな。でも今の状況じゃ、ちょっと難しいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710102,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "えっと、今ちょうど新しいパンを作ろうと思っててさ。子供の頃にお母さんが作ってくれた、キノコみたいなパン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710106,
					"content": "確か、キノコとベリーであんを作ってから、こねた生地に詰めて、オーブンで焼くの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710107,
					"content": "一番大切なのは、必ず新鮮な麦から挽いた小麦粉を使うこと。そうすることで、パンから優しい香りがするんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710108,
					"content": "本当は麦を少し摘みに来ただけだったんだけど、最近は同僚たちがここの麦畑の世話をする暇がないのか、周りに妙なちびっ子たちが増えてしまったみたいでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710109,
					"content": "ヴァルディスサーがいれば対処できたと思うけど…わたし、こういうの本当に苦手なんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710110,
					"content": "もしよかったら、少しだけ麦を採ってきてくれないかな？ほんの少しでいいんだ。お礼に温かいキノコパンの作り方を教えるから、お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				},
				{
					"id": 760710103,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "あっ、待って！ちょっと助けてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "ベレナ",
					"speakerSubtitle": "ライトキーパー"
				}
			]
		},
