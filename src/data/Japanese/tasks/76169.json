			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}さんとパイモンさんも来てくださったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761690102,
					"content": "#{M#俺}{F#私}たちもお参りしたくて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "口では言わなくても、きっと喜んでくれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761690104,
					"content": "イルーガと共に、お墓の前でしばらく立っていた…\\nイルーガは、一足先に旅立った戦友に、最近ピラミダで起こった様々なことを話した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "ピラミダでみんなが元気にやってるって知ったら、ビョルンも安心できるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761690106,
					"content": "はい。彼は彼の任務を全うしました。僕たちも、僕たちの任務を全うしていきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761690107,
					"content": "そして、僕たちの後も、他の人たちがこの土地を守り続けてくれるでしょう…嵐や寒さの中でも咲き誇る、ヴィンテル草のように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		},
