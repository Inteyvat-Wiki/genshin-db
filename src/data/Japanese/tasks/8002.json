				"objectNames": [
					"レザー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "ここは、お前を、歓迎しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020302,
					"content": "フフフ…残魂の狼にも、跡継ぎを守る習性があったとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020303,
					"content": "防衛のためか？しかしその実力、魔神の足元にも及ばぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020304,
					"content": "我々に服従すれば、神に匹敵する力を得られるだろう、過去のようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020305,
					"content": "戯…言を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020306,
					"content": "なんの儀式だ？苦しそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020307,
					"content": "トワリンの時と同じ「腐食」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020308,
					"content": "狼は、屈しない。でも、これ以上は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020309,
					"content": "あいつを止める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "何度やろうと、無駄な足掻きだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020310,
					"content": "もう一度、戦おう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "巨大な神像、壮大な大聖堂。モンド人がこれらを作るのに、どれだけの資源とエネルギーを費やしたことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020402,
					"content": "しかし、そんな贈り物を受け取った風神は、一体どれほどの見返りを渡したというのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020403,
					"content": "「信仰」は見返りを求めないものだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020404,
					"content": "ふん、神がそれでいいと思っているのなら、何も言うまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020405,
					"content": "しーっ！もうすぐ大聖堂に着くんだから、風神の悪口はやめといた方がいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020406,
					"content": "それに風神も実は…えーっと、な、なんでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020407,
					"content": "俺はもとから大聖堂に入るつもりはない。シスターと話す役目は貴様たちに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020408,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020409,
					"content": "今まで一緒だったのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "貴様はモンド城の栄誉騎士だ、深く信頼されている。この役は貴様が適任だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020412,
					"content": "それに、俺が行けば警戒されるのが目に見えているしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020413,
					"content": "身元不明だから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "ああ、それに小さいのが言うように、俺はいつだって…教会に対し不都合なことを言いかねない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020416,
					"content": "「信仰を拒む者」が「信仰の地」に入れば、待っているのは災いのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020417,
					"content": "俺は一度も神に恩恵を受けたことがない、そして今と未来においてもその必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020418,
					"content": "さあ、話せることは全て話した。俺たちがここで立ち話をしている間にも、アビス教団は動いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020419,
					"content": "そっか…じゃあ、2人で聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020420,
					"content": "それと、「穢れた逆さ神像」については、教会の人間に言わない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020421,
					"content": "神像のこととなれば西風教会も黙ってはいられないだろう。しかし、ヤツらが手を出しても邪魔になるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020422,
					"content": "それに…誰であろうと「アビス」と関わったら最後、いい結末を迎えることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020414,
					"content": "歓迎されないから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "気にならないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
