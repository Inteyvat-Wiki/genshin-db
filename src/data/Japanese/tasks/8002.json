			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "栄誉騎士！こんにちは、元気にしてた？今日はどうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020102,
					"content": "あっ…先に言っておくけど、天空のライアーは貸せないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020103,
					"content": "（どうやら幻術はバレてないみたいだな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020104,
					"content": "オイラたちは情報収集に来たんだ。「最古の耕運機」って聞いたことあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020105,
					"content": "「耕運機」？さあ…何に使うもの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020106,
					"content": "う～ん、やっぱり知らないか。じゃあ、質問を変えよう。教会は過去に七天神像を失くしたことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020107,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020108,
					"content": "あなたたち、「歴史」について聞きにきたの？凄く意外。とっても昔のことだから、そのことについて話す人はもうほとんどいないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020109,
					"content": "遠い昔、確かにとある七天神像が一夜にして消失したことがあるの、それも何の痕跡も残さずにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020110,
					"content": "当時、教会にいる人たち全員で捜索したらしいんだけど、結局見つからなかったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020111,
					"content": "後にこの怪奇事件は、「失われた七天神像」って呼ばれるようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020112,
					"content": "う～ん…やっぱり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020113,
					"content": "やっぱり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020114,
					"content": "あっ、なんでもない。他になにかあるか？その…変わった出来事とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020115,
					"content": "（バーバラには悪いけど、まだ神像のことは話せない…バーバラの安全のために…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020116,
					"content": "変わった出来事？えっと…教会に記録されてるものだと「暴君の遺恨」とかかな？でも、時期的にはその七天神像とはあまり関係ないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020117,
					"content": "「暴君の遺恨」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020118,
					"content": "その変わった出来事は、今では「風龍廃墟」と呼ばれるようになった「旧モンド」で起こったの。あの時は凄く危険だったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020119,
					"content": "誰かがそこに近づくと、天から火の玉が降り落ちてきたらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020120,
					"content": "天から火の玉！？それは怖いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020121,
					"content": "当時の人々はそれを「竜巻の魔神」の呪いだと思っていて、「暴君の遺恨」と呼ぶようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020122,
					"content": "その奇妙な現象が1年続いたんだけど、解決できなくて。結局、時間が経ったら自然と消失したんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020123,
					"content": "おかしすぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "うん、あとになって教会も「暴君の遺恨」と竜巻の魔神の関係を否定してるの。だって竜巻の魔神は火の玉を吹けないもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020126,
					"content": "あの災いはおそらく、他に原因があったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020127,
					"content": "けど、このことはたぶん「失われた神像」と関係ないかな。他の変わった出来事については、私も知らないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020128,
					"content": "わかった、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020129,
					"content": "「ありがとう」？何やらまた面倒事の気配がする言葉が聞こえたわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020130,
					"content": "あ、ロサリアさん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020131,
					"content": "騎士団を探してるなら無駄足よ。「あの魔物たち」がまた現れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020132,
					"content": "「あの魔物たち」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020133,
					"content": "風魔龍の混乱に乗じて、モンド城に攻め入ろうとしてきた魔物のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020134,
					"content": "それってアビス教団のことじゃないか！？アイツらが現れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020135,
					"content": "ええ、すでに<color=#00E1FFFF>奔狼領</color>に集まってるわ。狼たちもピリピリしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020136,
					"content": "もしかしたら、アビス教団は…「北風の狼の残魂」を狙ってるのかもしれないわね。目的に関しては、私も分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020137,
					"content": "ジン団長がすでに向かっていて、私も裏で動く予定よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020138,
					"content": "じゃ、じゃあ私も行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020139,
					"content": "君は教会に残りなさい、ジン団長からのお達しよ。聖職者としての本職を忘れないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 80020140,
					"content": "で、でもあなただって聖職者でしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020141,
					"content": "心配しないで、こっちも手助けする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "おう！オイラたちもジン団長の手助けに行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020143,
					"content": "分かった…「栄誉騎士」がそこまで言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020144,
					"content": "でも、お願いだから気をつけてね。風神の加護が、あなたたちの安全を守らんことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 80020124,
					"content": "暴君とは関係ないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "ふぅ——結構多かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020202,
					"content": "近づけば近づくほど、敵の数が増えるか。ふん、実に教団らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020203,
					"content": "早く「王狼」を見つけないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "おう！行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020205,
					"content": "俺は…ここにいよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020206,
					"content": "えっ？どうしてだ？モフモフした生き物が怖いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020207,
					"content": "理由はそれじゃないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "「狼」とは関係ない。かつての魔神が、七神に仕えてるのが気に食わないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020210,
					"content": "そのような行為を認めるつもりはない、無論話す気もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020211,
					"content": "それに、こういうのは貴様の得意分野だろう。俺にはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020212,
					"content": "本当に七神が嫌いなんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "神は当てにならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020216,
					"content": "俺の個人的な意見だと思って聞くがいい。いいか、神に対して、いつどんな時でも警戒を怠るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020217,
					"content": "ヤツらを信じきるな。そして…「簒奪」や「凶行」の道にも堕ちるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020218,
					"content": "たとえ貴様が対峙したあの「憎き敵」であっても。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020219,
					"content": "「神を信じるな」とか、「凶行の道に落ちるな」とか…矛盾した考え方だよな。結局ダインは、七神を憎んでるのか、それとも守ってるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020220,
					"content": "どうして、そんなに矛盾してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020222,
					"content": "過去の教訓だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020223,
					"content": "最後に…事実を一つ教えてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020224,
					"content": "えっ？なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020225,
					"content": "「カーンルイアは神によって滅ぼされた国、そしてそれが…アビス教団が七神の国を滅ぼしたいと思っている理由だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020226,
					"content": "話はここまでだ。今は優先すべきことがある。俺は残りのアビス教団を片付ける、貴様も手っ取り早く終わらせろ。事が終わったら、奔狼領の入り口で合流だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020227,
					"content": "あ…行っちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020228,
					"content": "本当におかしな人だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020229,
					"content": "少し理解できるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "おう、おまえも「見知らぬ神」のことを警戒してるもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020231,
					"content": "璃月の迎仙儀式の時も、ダインと似たような選択を取ってたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020232,
					"content": "信用がないなら、避けるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "まあ…おまえも大変だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020234,
					"content": "栄誉騎士、パイモン！どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020235,
					"content": "あっ、ジン団長！無事でよかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020236,
					"content": "ロサリアからここで戦ってるって聞いたから、加勢に来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020237,
					"content": "そうか、感謝する。今回の暴動は通常のものとは違う。アビス教団が奔狼領を囲い始めている、私も兵を向かわせているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020238,
					"content": "そして、奔狼領を偵察していたところ…君たちに出会ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020239,
					"content": "ロサリアが言うには、ヤツらの標的は「ボレアス」のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020240,
					"content": "しかし、アビス教団と「ボレアス」に…一体どんな関係が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020241,
					"content": "単純に面倒を起こしたいだけなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020242,
					"content": "ほら、アビス教団はトワリンにもちょっかいを出しただろ？風神の眷属に、もう一回手を出してもおかしくないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020243,
					"content": "確かに、一理ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020244,
					"content": "とにかく、この辺り一帯の脅威は、全て私が引き受けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020245,
					"content": "栄誉騎士、君は「王狼」のもとへ向かって、状況を確認してきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020246,
					"content": "魔神の残魂…滅多にお目にかかれないが、君はそれに会ったことがあると聞いた。君が適任だと私は思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020247,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "うん、気をつけてくれ。後のことは任せた、「西風の栄誉騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 80020214,
					"content": "本当に交流が嫌いなんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "人と交流するのは問題ないが…神は違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020208,
					"content": "モフモフしててかわいいから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
