			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "なるほど、アビス教団に新たな動きがあったと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020502,
					"content": "「穢れた逆さ神像」と関係があるのかもしれない。俺たちもそこに向かおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020503,
					"content": "でも、アビス教団は奔狼領でなにがしたいんだ？まさかトワリンの時みたいなことを？うぅ——もう災いは起きてほしくないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020504,
					"content": "いや、それはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020505,
					"content": "鎮圧されたオセルとは違って、魔神「アンドリアス」はとっくに死んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020506,
					"content": "いま奔狼領を守っているのは、ただの残魂だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80020507,
					"content": "アビスの使徒がその残魂を標的にしたのは、風神の眷属から情報を聞き出そうとしているだけかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				}
			]
		},
		{
