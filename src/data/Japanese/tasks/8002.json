			"trigger": {
				"objectNames": [
					"ボレアス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "フン…儀式が中断されたか、運がよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020702,
					"content": "残魂にも、これほどまでに堅い意志があったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020703,
					"content": "しかしこの程度のこと、なんの影響もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "アビスの使徒"
				},
				{
					"id": 80020704,
					"content": "また消えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020705,
					"content": "行動を阻止することはできた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "ありがとう、いいところに、来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020708,
					"content": "こんな無様な姿を…人間の「ルピカ」に見せるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020709,
					"content": "しかしアビスの使徒、我も甘く見られたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020710,
					"content": "王狼、試練、拒まない。でも、不気味な外来者、掟、守らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020711,
					"content": "オレも、罠に、気づかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020712,
					"content": "それって、アビス教団は試練を利用して「王狼」を呼び覚まし、腐食しようとしたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020713,
					"content": "レザーのせいじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#ありがとう、{NICKNAME}。オレの爪、もっと、強くなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020716,
					"content": "お前たち、危険な匂い辿って、ここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020717,
					"content": "いや、オイラたちは話を聞いてここに来たんだ。鼻はそんなによくないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020718,
					"content": "助けに来たついでに、質問させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020719,
					"content": "その…こちらの魔神殿は、「最古の耕運機」を知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020720,
					"content": "我は人間の造物なぞに興味はない。故に「耕運機」なるものは知らないが、印象に残っている機械なら一つある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020721,
					"content": "あれは我の試練に誤って立ち入り、我もあれを試練を受ける勇士として扱った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020722,
					"content": "知能はなく、ただ戦闘と殺戮のためだけに作られたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020723,
					"content": "我の攻撃で損傷し、倒れる前にこの試練場を離れたがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020724,
					"content": "うーん…その感じだと、「最古の耕運機」の可能性もなくはないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020725,
					"content": "その機械は回れる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "ああ、回転と跳躍、そして火の玉を放つ。力は魔神には及ばないが、「神の目」を持つ者より上だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020730,
					"content": "火の玉…？なんか最近どこかで聞いたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020731,
					"content": "とにかく、これって「最古の耕運機」はモンドに来たことがあるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020732,
					"content": "しかも、「最古」の実力は、他の量産型の遺跡守衛よりも大分強いものみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020733,
					"content": "でもこの話によると、「狼の試練」で損傷してるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020734,
					"content": "役に、立った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020735,
					"content": "大助かりだ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020736,
					"content": "オイラたちは重要なことを調べに行くぞ。アビスの使徒が離れたとはいえ、教団の攻撃はまだ止んでないから、おまえたちも気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80020737,
					"content": "うん、もっと危険な匂い、ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020738,
					"content": "お前たちも、気をつけろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レザー"
				},
				{
					"id": 80020727,
					"content": "その機械はミサイルを撃てる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "「ミサイル」？いや…さっき言ったように、人間の造物には興味がない。そのような言葉、我には分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020729,
					"content": "回転と跳躍、そして火の玉を放つ。力は魔神には及ばないが、「神の目」を持つ者より上だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 80020714,
					"content": "悲しまないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "逃げ足だけは早い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
