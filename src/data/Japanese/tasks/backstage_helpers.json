	"talks": [
		{
			"id": 7151601,
			"completionStepIds": [
				7151601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151601",
							"2"
						],
						"stepId": 7151601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"応公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715160101,
					"content": "これでやっと、この劇も完璧に幕を閉じたわけだ。若者よ、よくやった。どうだ、紙映戯は難しかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160102,
						715160104
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160102,
					"content": "楽勝だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160103
					]
				},
				{
					"id": 715160103,
					"content": "紙映戯は璃月劇と違って、一人でも演じることが可能だ。たしかに、だいぶ楽ではある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160106,
					"content": "#オイラ、{NICKNAME}はうまくやれてたと思うけどな。紙映戯もすっごく面白かったし、他にも新しい物語を観てみたいぜ！応公のおじさん、次はいつまた開演するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715160107,
					"content": "ははっ、ならよかったよ。ただ再演については、俺にも分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160108
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160108,
					"content": "元々、紙映戯を子供たちに観せることは俺の個人的な趣味でね。今回の劇が終わった後は、また雲翰社に戻って衣装と道具の管理を続けるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160109
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160109,
					"content": "えっ？おじさん、雲翰社の人だったのか？じゃあ、璃月劇もできるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715160110,
					"content": "そりゃまあ、少しはな。長年雲翰社にいたんだ、誰だって少しは歌えるようになる。だが、雲座頭と比べたらまだまださ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160111
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160111,
					"content": "実を言うと、俺は裏方なんだ。舞台で使う槍や旗、様々な柄の劇衣装、それから装飾に道具…それらすべて俺が管理してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160112
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160112,
					"content": "雲翰社がいま使ってる道具や衣装の一部は、昔から使われてきたもので、他の一部は俺が買ったものや手作りしたものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160113
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160113,
					"content": "完全な璃月劇を演じるとなると、舞台上と舞台下には多くの人員が必要になる。役者だけじゃ足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160114
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160114,
					"content": "今年の海灯祭は、雲座頭が俺たち裏方に休暇をくれてな。俺のダチたちも実家に帰ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160115
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160115,
					"content": "で、一人でやることもないから、いっそのことみんなに紙映戯を観せてるってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160116
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160116,
					"content": "家に帰らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160117
					]
				},
				{
					"id": 715160117,
					"content": "ああ、俺はまだ家庭を築いてないんだ。一昨年、オヤジとおふくろも逝っちまってな、今は一人さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160118,
						715160119
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160120,
					"content": "いやいや、謝る必要はないよ。俺も気にしてないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160121
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160121,
					"content": "一人で海灯祭を過ごすのも結構楽しいもんさ。子供たちも俺の紙映戯が好きみたいでよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160122
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160122,
					"content": "オイラたちも大好きだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715160123,
					"content": "ああ、もちろん俺自身も好きだ。じゃないと、こんな労力を費やして紙映戯を作ったりなんかしないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160124
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160124,
					"content": "物語はおじさんが書いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160125
					]
				},
				{
					"id": 715160125,
					"content": "いや、そういうわけじゃないんだ。璃月劇や紙映戯、さらには茶博士の講談でも、みんな「虬髯公」の物語をモチーフにしたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160126
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160126,
					"content": "人々が必要とし、皆が呼びかければ、そのような英雄が生まれて困難に陥る人を救うのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160127
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160127,
					"content": "璃月にはそういった英雄が多くいる。だから、彼らの物語に少し手を加えれば、みんなが大好きな劇の出来上がりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160128
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160128,
					"content": "これまでもこういう話はたくさん聞いてきたけど、これって璃月の伝統文化の一部なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715160129,
					"content": "ははっ、そうとも言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160130
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160130,
					"content": "だが、危険な時に助けてくれる英雄がいるとはいえ、いつも他人任せなのはダメだ。自分の面倒は、自分一人で見るべきだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160131
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160131,
					"content": "#{M#少年}{F#お嬢ちゃん}、ちゃんと自分を大事にな！海灯祭を祝して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160132
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715160132,
					"content": "うん、海灯祭を祝して！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160133
					]
				},
				{
					"id": 715160133,
					"content": "海灯祭を祝して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715160134,
					"content": "時間があったら、ぜひ雲翰社へ劇を観に来てくれ。もしかしたら、また会えるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "応公"
				},
				{
					"id": 715160119,
					"content": "ご、ごめん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160104,
					"content": "大変だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160105
					]
				},
				{
					"id": 715160105,
					"content": "君は経験者じゃないし、初めてのことだろうからミスはつきものさ。それは仕方ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "応公"
				}
			]
		}
	]
}