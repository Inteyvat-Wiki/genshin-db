	"talks": [
		{
			"id": 7052101,
			"completionStepIds": [
				7052102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052102",
							"2"
						],
						"stepId": 7052102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エウルア",
					"アンバー",
					"ベルンハルト"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705210101,
					"content": "エウルアとアンバー！おまえたちも遊びに来たのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210102,
					"content": "探したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210103
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210103,
					"content": "えっ？わざわざオイラたちに会いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210104,
					"content": "もちろんだよ。あんたたちのお店ってば、すっかり有名だからみんな噂してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210105
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210105,
					"content": "「栄誉騎士と小さな白い助っ人が『西風ヒューヒューチャリティー連盟』っていうお店でいろんなお宝を売っている。しかも不思議なプレゼントつき、見逃せない！」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210106,
					"content": "なんだよ、結局オイラ「小さな白い助っ人」になっちゃったぞ…でもお店を評価してくれてるみたいだし、嬉しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210107,
						705210108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210107,
					"content": "お客さんたちのおかげだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210109
					]
				},
				{
					"id": 705210109,
					"content": "そういえば、ずっとエウルアとアンバーを見かけなかったけど、二人とも出かけてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210110,
					"content": "えへへっ、あたしたちには仕事があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210111,
					"content": "えっ？ずっと仕事してたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210112,
						705210113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210112,
					"content": "祭りの日も休みはないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210114
					]
				},
				{
					"id": 705210114,
					"content": "正確に言うと、私とアンバーは騎士団の「半休暇メンバー」なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210115
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210115,
					"content": "ブリュー祭の期間中は、ドーンマンポートとモンド城間をキャラバンが頻繁に移動するため、警戒を強める必要があるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210116
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210116,
					"content": "魔物や悪党に襲われるからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210117,
					"content": "ええ、そうよ。遊撃小隊の任務は、その二か所の間を巡回すること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210118
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210118,
					"content": "キャラバンの後を追い、貨物を守る。さらには率先して攻撃を仕掛けたり、怪しい場所を調査したりして、脅威を事前に取り除くってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210119
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210119,
					"content": "なんだか大変そうだな。もしかして…ブリュー祭が終わるまでずっと仕事なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210120,
					"content": "そんなことないわ。交代制でやっているからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210121
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210121,
					"content": "一組は見回り、一組は休憩、一組は予備隊として待機するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210122
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210122,
					"content": "これを一定の周期で交代しているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210123
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210123,
					"content": "エウルアは経験豊富な隊長だからね。エウルアの的確な指示のおかげで、厳しい任務もこなすことができたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210124
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210124,
					"content": "別に、褒めるほどのことではないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210125,
						705210127
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210125,
					"content": "すごい熱意だね、偵察騎士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210126
					]
				},
				{
					"id": 705210126,
					"content": "へへっ、今度機会があったら、エウルアが隊長になったばかりの頃の話をしてあげる、すごいんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210129,
					"content": "コホン…実はちゃんと用事があってきたんだ。エウルア、説明をお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210130
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210130,
					"content": "ええ、君たちに「騎士団特製北地のスモークチキン」四十人前と、「西風の加護つきお肉ツミツミ」四十人前を用意してほしいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210131
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210131,
					"content": "とんでもない量だな！一度にこんな注文するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210132,
					"content": "まさか…騎士団でパーティーを開くつもりだな？どうして誰もオイラたちを招待してくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210133,
					"content": "あはは、そんな盛大なものじゃなくて、エウルアが隊員たちを労うためなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210134
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210134,
					"content": "ええ…遊撃小隊のメンバーは日ごろから体力の消耗が激しいから、一回の食事で…四、五人前は食べるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210135
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210135,
					"content": "それに、最近は古参の隊員が一人復帰することになってね。だから、この機にお祝いしようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210136
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210136,
					"content": "他で何か買うよりも、資金を君たちのお店で使えば、チャリティーのためにもなるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210137
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210137,
					"content": "おおっ！一石二鳥のナイス判断だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210138,
					"content": "まいどあり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210139
					]
				},
				{
					"id": 705210139,
					"content": "そうだ…エウルアの言う「古参の隊員」って、まさか前に会った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210140,
					"content": "前線で活躍している測量士のミカよ。大団長と遠征に出る前は、ずっとうちの隊の主力だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210141
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210141,
					"content": "やっぱりあいつのことか！あの恥ずかしがり屋の騎士が、そんなにすごいやつだったなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210142,
						705210143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210142,
					"content": "#{M#俺}{F#私}たちを怖がってるみたいだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210144
					]
				},
				{
					"id": 705210144,
					"content": "ミカは決してあんたたちを怖がってたわけじゃないよ。若干遠回しだけど、それもあんたたちに対する「敬意」の表れなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210145
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210145,
					"content": "彼は強い人には独特の個性があると思い込んでいてね。その人たちを知り、考えを理解した上で、より深いコミュニケーションを図るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210146
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210146,
					"content": "こうすることで、気兼ねなく会話できるようになるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210147
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210147,
					"content": "最初は私とアンバーに対しても同じ感じだったわ。私たちのことをよく知ってから、だんだんと自然体でいられるようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210148
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210148,
					"content": "そういうことだったのか…ミカって本当に変わったやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210149,
						705210150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210149,
					"content": "覚えておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210151
					]
				},
				{
					"id": 705210151,
					"content": "ええ。今度時間があったら、もっと接してみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210152
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210152,
					"content": "君は騎士団の重要人物。私は彼の上官として、お互いの誤解を防ぐ義務があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210153
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210153,
					"content": "えへへ、そんなに弁解しなくても大丈夫だぞ。エウルアがあいつのために言ってるってことは、オイラたちにも十分伝わってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210154,
					"content": "あっ、エウルア、あたしの分も払ってくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210155
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210155,
					"content": "あたしは遊撃小隊のメンバーじゃないし、別で払うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210156
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705210156,
					"content": "君の分も私が奢るから、遠慮しなくていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210157
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705210157,
					"content": "注文された料理を渡すと、二人は礼を言って帰って行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705210158
					]
				},
				{
					"id": 705210158,
					"content": "へへっ、エウルアとアンバーのおかげで、一気に前日と同じ分のモラを稼げたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210159
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210159,
					"content": "栄誉騎士、パイモン！朗報だ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210160
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210160,
					"content": "二人のおかげで、予想を遥かに上回る資金が集まった！大成功だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210161
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210161,
					"content": "へへん、どんなトラブルが起きてもきっと乗り越えられるって、オイラ言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210162,
						705210163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705210162,
					"content": "みんなお疲れさま。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210164
					]
				},
				{
					"id": 705210164,
					"content": "お店がうまくいったのは、二人の指導のおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210165
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210165,
					"content": "収益はすでにチャリティー資金の担当者に渡してある。今回のチャリティーイベントもこれで無事終了だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210166
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210166,
					"content": "感謝の気持ちを込めて、二人に報酬を贈ろう。さあ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210167
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210167,
					"content": "もうお店を開くのも怖くないぞ。今後もぜひ一緒に仕事をしてほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210168
					],
					"speakerTitle": "ベルンハルト"
				},
				{
					"id": 705210168,
					"content": "おう、オイラもかなりいい経験になったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210169
					],
					"speakerTitle": "パイモン"
				},
				{
