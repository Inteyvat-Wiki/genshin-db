			"dialogs": [
				{
					"id": 750110201,
					"content": "うーん、これがもう最後の装置だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110202,
					"content": "他の装置と変わらないように見えるけどな…チコヤは騙されてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110203,
					"content": "キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "そんなはずないわ。古いウォーベンの解読に関しては、お姉さんはとても自信が…そこそこ自信が…えーと、ちょっぴり自信があるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110205,
					"content": "自信がどんどんなくなってるぞ！がんばれ、自信を持てって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110206,
					"content": "でも、これは最後の装置じゃないはずよ。私のイメージでは、装置はもっと大きくて、もっと…完全なはず？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110207,
					"content": "「空中の島」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "#それじゃ分からないわよ、エリート{M#坊ちゃん}{F#お嬢ちゃん}。固有名詞を言うだけじゃ、他の人には理解できないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110209,
					"content": "…果たしてお宝はあるのかないのか、秘薬はどうなのか。実際にやってみれば分かることよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110210,
					"content": "ガゥ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "今回はだめでも次回がある、ここがだめでも他がある。ずっと挑戦し続けてれば、きっと奇跡が起こるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110212,
					"content": "すごく楽観的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "褒め言葉と受け取っておくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110216,
					"content": "ギャウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#えへへ、{REALNAME[ID(2)|SHOWHOST(true)]}も興奮してきたでしょ？さあ{NICKNAME}、燃素で装置を起動しましょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110214,
					"content": "ずっと挑戦できること自体が最大の奇跡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "ちょっと、水を差すのはやめて！",
