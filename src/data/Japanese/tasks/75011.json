			"dialogs": [
				{
					"id": 750110501,
					"content": "水位が少し上昇したわね…それに、燃素に満ちてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110503
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110503,
					"content": "温かい…温かさが手足に沿って内側に向かって流れるのが感じられる。とてもいい泉質ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110504
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110504,
					"content": "つまり「盗炎の賢者」からの贈り物は、「あらゆる傷を治す秘薬」じゃなくて、ここの温泉だったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110505,
					"content": "さすが流泉の衆の近くにあるだけあるっていうか…結局は温泉関連だったな。",
