			"dialogs": [
				{
					"id": 750110301,
					"content": "まさか「静寂の浮遊島」の中心が隠された島だったなんて。ね？だから図で見たのと違うって言ったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110302
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110302,
					"content": "私の記憶は当てになるってことだわ。なにしろ普段は古代のウォーベンを整理する仕事をしてるんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110303
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110303,
					"content": "でもここには、真ん中にもっと大きな石があるだけ…この大きな石が「盗炎の賢者」からの贈り物なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110304,
					"content": "キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110305,
					"content": "…こうなるともう、お姉さんにも分からないわ。だってどのウォーベンにも、試練を経てここに到達した勇士たちは、「盗炎の賢者」の精神を感じたとしか書かれてないんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110306
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110306,
					"content": "試練を経てここに来た人であれば、呼びかけに気づけるはずってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110307
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110307,
					"content": "でも具体的にどんな形式なのかは、私にも分からないの。ここに来れば分かると思っていたけど…この様子じゃダメみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110308
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110308,
					"content": "ウ…キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110309,
					"content": "#あれ、{REALNAME[ID(2)|SHOWHOST(true)]}にも見えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110310
					]
				},
				{
					"id": 750110310,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110311,
					"content": "じゃ、読める？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110312
					]
				},
				{
					"id": 750110312,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110313,
					"content": "#え…見えるって？何か見えてるの？まさか、贈り物を受け取る資格があるのは{NICKNAME}{M#くん}{F#ちゃん}だってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110314
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110314,
					"content": "あれ、オイラもなにも見えてないぞ…おかしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110315
					],
					"speakerTitle": "パイモン"
				},
