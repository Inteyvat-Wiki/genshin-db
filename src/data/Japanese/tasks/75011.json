					}
				]
			},
			"dialogs": [
				{
					"id": 750110101,
					"content": "ここが「静寂の浮遊島」か。下から見上げたときは何だか冴えない島だなって思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110102,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "まさかこんな感じだなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110104,
					"content": "ええ、この島そのものが燃素の力で集まったものだそうよ。燃素自体も特別生命力にあふれたエネルギーなんだけど…ひとまず、ちょっと変わったエネルギーって理解でいいと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110105,
					"content": "だからここには草も花も生えるし、冷えた土地をふたたび温めることもできる。暗闇で魂を燃やして明かりを灯すことだってできるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110106,
					"content": "それこそが「燃素」…「盗炎の賢者」が巨竜から奪い取ってきてくれたものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110107,
					"content": "そういえば、ちょっと腹立たしいことを思い出したわ。ふん、部族の中には、「静寂の浮遊島」を見て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110108,
					"content": "人間が燃素を使ったところで浮き島なんて絶対に作れるわけがない、「盗炎の賢者」も実は巨竜の仲間だったんだなんて言う人もいるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110109,
					"content": "キュー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "そんな説もあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "自分ができないことをできる人がいるだけで「実は人じゃないんだ」なんて、意気地なしの考えよ。そんな連中とは友達になりたくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110114,
					"content": "えっと…そういえば、お宝…秘薬は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110115,
					"content": "ここにはなにもなさそうだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750110116,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "ふふっ、これこそ変人と呼ばれる「盗炎の賢者」の試練よ。そう簡単にいくわけがないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110118,
					"content": "古いウォーベンによると、いくつか装置を起動させて、最後の試練を完成させれば、「静寂の浮遊島」の中心に到達できるそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110119,
					"content": "でもそこがどういうところなのかは、私にも分からないの。ここの図を見たような覚えもあるけど、今こうして見ているのとはちょっと違うし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110120,
					"content": "でも、歳を取って自慢の記憶さえ当てにならなくなっちゃっただけなのかも。大丈夫…ここまで来たんだから、直感に頼りましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110121,
					"content": "装置はどうやって動かすの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "ええと…「燃素銘刻」と同じように、燃素を使えば動くんじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110123,
					"content": "少なくとも古いウォーベンにはそう描かれていたわ。ナタに点在する「燃素刻印碑」も、実はここの装置を元に作られているそうよ…装置自体がすごい古代の遺物ってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110124,
					"content": "#さあ{M#坊ちゃん}{F#お嬢ちゃん}、早く行ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チコヤ"
				},
				{
					"id": 750110111,
					"content": "どう考えるかは自由だし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "分かってるわ、他人が世界をどう見ていようと、それをどうこうするのは難しい。でも、やっぱり頭にきちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "チコヤ"
				}
			]
		},
