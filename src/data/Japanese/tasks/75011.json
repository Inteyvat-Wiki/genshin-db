						],
						"pointId": 8161
					},
					{
						"sceneId": 3,
						"position": [
							-3014.803,
							380.927,
							8549.981
						],
						"pointId": 8670
					},
					{
						"sceneId": 3,
						"position": [
							-3014.679,
