					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "「あそこだ。鱗石を活性化させられる光の刻印、あれが『許可』だ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890602,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "ここからなら…聖都の全体が見渡せるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890604,
					"content": "「そうだな…かつての栄光の悲しき影だ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890605,
					"content": "ガゥ…キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "「裁きの結果が知りたいのか？ふふ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890607,
					"content": "「神聖なる裁きを望む者は、全ての炎を司る主が仮死状態に陥っていたことを知っていた。しかし、はっきりとした意識を持つ王がその場に現れると…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890608,
					"content": "「騒々しい十三の領主と三王子はすぐに口を噤んだ。茶番のような審判も、うやむやとなった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890609,
					"content": "キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "「その後…王子はみな人類との戦争で死に、十体の領主は聖都トゥランの崩壊で命を落とし、一体はチチェンウトゥに残った…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890611,
					"content": "「そして一体だけが今も生き延びている…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890612,
					"content": "「しかし、それも彼が望んだ『生き残り方』ではないのだろう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890613,
					"content": "「まあいい…聖山の心に向かおう。そこにはすべてが…旅の終点に秘められた熱望が埋められている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890614,
					"content": "「私の使命はここまでだ…龍に選ばれし者よ、かつてここはあれほどまでに美しかった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890615,
					"content": "「その炎鱗の刻印に触れ…聖山の心への『許可』を手に入れるがよい…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "アワンヨ…もう、また行っちゃったぞ！この名前、まだ全然呼んでないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890618,
					"content": "でも、これでやっと「聖山の心」に入るための「許可」が手に入ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890619,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "光が…消えたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
