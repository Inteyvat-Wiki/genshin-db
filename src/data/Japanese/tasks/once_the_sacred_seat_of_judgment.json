			"dialogs": [
				{
					"id": 751890301,
					"content": "「では行こう。『許可』の媒体をどこに隠したのか調べなければ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890302,
					"content": "「隠す気もなく、普通においてあるだけとは…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890303,
					"content": "「だが、空っぽの媒体にしか見えぬな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890304,
					"content": "うわっ、なんで獣域ハウンドがこんなにいるんだよ…うぅ、「許可」が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890305,
					"content": "「おそらく入口の防御が消えたせいで、入り込まれてしまったのだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890306,
					"content": "じ、じゃあどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890307,
					"content": "「案ずるな、審議の庭の浄化装置を起動させればよいだけの話だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890308,
					"content": "「そこだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源の龍従"
				}
			]
		},
