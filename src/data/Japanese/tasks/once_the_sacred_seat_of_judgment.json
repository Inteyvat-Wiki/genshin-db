			"dialogs": [
				{
					"id": 751890701,
					"content": "影に潜みし敵の脅威を検出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890702,
					"content": "内部防御…自動修復モード起動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890703,
					"content": "おおっ、建物の中にもこういう装置があったんだな…魔物たちが、一瞬で全滅だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890704,
					"content": "「幾千万年も壊れぬよう計算して造られた建物だからな。敵に対する防御機能だけでなく、自己修復機能も搭載されている…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890705,
					"content": "しかもキラキラ光ってるぞ…触ってみたいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890706,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "「はっはっは、それはやめておけ…これはお前が『敵』か『友』かなど、見分けられぬ…ただ触れたものを無条件で燃やすだけだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890708,
					"content": "「…実に愚かで乱暴なやり方だ。ふん、誰が考えたのだか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890709,
					"content": "でも、これを使えば「許可」を覆ってるバリアをなんとかできるかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890710,
					"content": "確かに試してみる価値はある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "とりあえず…なんとかしてあれを上昇させればいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890712,
					"content": "珍しく真っ当な提案だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "キュイオン、クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "「お前の言う通りだ。白き使者が、能ある鷹の如く爪を隠していたとは…そんな知恵があるとは思わなかった。驚きだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890715,
					"content": "そこまで驚くことないだろ！オイラをなんだと思ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
