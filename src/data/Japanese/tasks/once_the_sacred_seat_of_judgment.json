			"dialogs": [
				{
					"id": 751890401,
					"content": "やっと終わったぞ…ふふん、これでやっと「聖山の心」に入るための「許可」が手に入ったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890402,
					"content": "「いや、前にも言ったが、これは『許可』の媒体の抜け殻に過ぎない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890403,
					"content": "「中に持ち主の情報がなければ、この鱗で作られたガラクタは『許可』として機能しない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890404,
					"content": "「そうでないと、これが『どの龍でも使える』万能の鍵になってしまうであろう？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890405,
					"content": "エラい龍を連れてきて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#そんな龍、連れてこれるわけないだろ…うーん、{REALNAME[ID(2)|SHOWHOST(true)]}じゃダメなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890407,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "「そやつに…そのような力はまだない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890409,
					"content": "じゃあこれからはどうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890410,
					"content": "「遥か昔、偉大なる君主が聖山の心に入っていった後、権力を持っているにもかかわらず『許可』を有効化させられない者がいた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890411,
					"content": "「『許可』の媒体がこのように目立つ場所にあるのは、そのためなのかもしれない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源の龍従"
				}
			]
		},
