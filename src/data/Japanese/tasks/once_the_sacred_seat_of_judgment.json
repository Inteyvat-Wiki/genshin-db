			"dialogs": [
				{
					"id": 751890501,
					"content": "「お前らがここに来ることはわかっていた。だからわざわざこうして出迎えてやったのだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890502,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "「ただの社交辞令だとはわかっているが…私もお前に会えて嬉しい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890504,
					"content": "あっ、やっぱりおまえか！えーと、今回はなんていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890505,
					"content": "「今度の名は『審議の庭』の書記官の名前だ。秘源の龍従が発明されてからは、自ら筆を執ることはほとんどなくなっていたがな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890506,
					"content": "「アワンヨ…そう呼んでくれて構わない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890507,
					"content": "じゃあアワンヨ、今回は「聖山の心」に入るための「許可」を何とかしてくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751890508,
					"content": "「許可がないと、『聖山の心』に足を踏み入れた瞬間、『擬似群星』の攻撃が飛んでくる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890509,
					"content": "「…『アワンヨ』の記録を抽出した。聖山の心に入るための『許可』の媒体は審議の庭に安置されている。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890510,
					"content": "「そのためにも、私はこの地に足を踏み入れなければならなかった…愚かで思い上がった者や、無能の癖して偉そうに振る舞う者が集う、この地にな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "秘源の龍従"
				},
				{
					"id": 751890511,
					"content": "「こやつらが偉ぶって同族を裁いたおかげで…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源の龍従"
				}
			]
		},
