	"talks": [
		{
			"id": 7565801,
			"completionStepIds": [
				7565801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7565801",
							"2"
						],
						"stepId": 7565801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘルカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756580101,
					"content": "ん？冒険者協会は、「詳細非公開組織」からの超高難易度依頼だって言ってたよな？でも、こいつ…子供だぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580102,
					"content": "#{NICKNAME}とパイモンだね？初めまして、僕はヘルカ。今回の依頼人だ。依頼の内容は把握しているね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580103
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580103,
					"content": "巨大な魔物の情報を集めるために力を貸してもらいたい。戦闘パフォーマンス面のデータも含めてね。じゃあ、よろしく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580104
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580104,
					"content": "おう！任せろ…じゃなくて！オイラたち、自己紹介もしてないのに…なんで名前を知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580105,
					"content": "依頼の難易度を考えれば、おそらく冒険者協会は経験と実績を兼ね揃えた冒険者に回すだろうと予想できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580106
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580106,
					"content": "そうして絞られた数少ない候補者の中で、金髪の旅人と小さな白いガイドのコンビとなると、必然的にね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580107
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580107,
					"content": "なるほど。子供なのに物知りだな！喋り方も、なんか老け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580108,
					"content": "コホン。すごく落ち着いてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580109
					]
				},
				{
					"id": 756580109,
					"content": "あっ、そうそう！えっと、話を戻すけど、本当におまえが依頼人なのか？「詳細非公開組織」って一体なんなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580110,
					"content": "ああ、依頼を出したのは確かに僕だ。「詳細非公開組織」を名乗ったのは、カーリャのアイデアさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580111
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580111,
					"content": "悔しいが、バックグラウンドのない子供よりも、正体不明な組織からの依頼のほうが、協会も真剣に取り組んでくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580112
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580112,
					"content": "言っておくが、「組織」については嘘じゃない。僕は確かに「詳細非公開組織」の一員だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580113
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580113,
					"content": "僕はただ、相手に伝えるべきと判断したことのみを伝えただけだ。そこからどんな情報を汲み取るかは、想像力次第さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580114,
						756580116
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580114,
					"content": "おやつを一緒に食べる会とかじゃないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580115
					]
				},
				{
					"id": 756580115,
					"content": "なんだよ、そんな「秘密組織」って…ただの友達の集まりじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580117,
					"content": "ああ、出発前にメイジーと約束したんだ。嘘はつかない、そして危険なことはしないと——それを破ったことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580118
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580118,
					"content": "真実だけを話すことで、事を有利に進められる。さらに頼れる助っ人がいれば、危険な地だって安全だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580119
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580119,
					"content": "そ、そういうもんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756580120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756580120,
					"content": "ああ。二人の準備ができたら、さっそく出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 756580116,
					"content": "わぁ、「秘密組織」ってことだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756580117
					]
				}
			]
		}
	]
}