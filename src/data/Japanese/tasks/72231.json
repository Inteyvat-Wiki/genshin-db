				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "代理宮司様がこんなに喜ぶなんて。どうやらその人は、すごく大切な人みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722310102,
					"content": "でも、どこにいるか分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悦子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "確かに、「響」…「浅瀬神社」…「百目鬼」…どれも気になるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310202,
					"content": "いつからいたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "島でこんなに大きな騒ぎがあったら、来ない方がおかしいでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310204,
					"content": "それと、説明しなきゃいけないことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310205,
					"content": "大祐、話してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310206,
					"content": "あっ…分かったよ、悦子。その、僕が言いたいことは…このセイライ島に関することなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310208,
					"content": "セイライ島の歴史はとても古く、様々な調査を行った協会でも、有用な情報がまったく見つかっていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310209,
					"content": "協会の資料によると、数百年前のここは、「海賊」が集まる場所だったみたいだ。当時、幕府が全面的に海賊を片付け、島の住民たちを別の場所に移住させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310210,
					"content": "その「百目鬼」とは、たぶん、当時幕府と正面から対峙した海賊の頭である「赤穂百目鬼」のことだ。書類にもはっきりと名前が記録されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310211,
					"content": "協会が僕たちに渡した資料によると、この「赤穂百目鬼」は海賊の船隊を指揮し、海上で幕府と戦っていたという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310212,
					"content": "彼の船隊は幕府に制圧され、セイライ島に逃げてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310213,
					"content": "だが、幕府の船隊が彼を追撃しようとした時、突然セイライ島に原因不明の雷が落ちた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310214,
					"content": "赤穂百目鬼の船隊と幕府の船隊は、その雷に当たり…そのまま消息を絶った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310215,
					"content": "雷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "後は私から話すわ…このことに関する最大の疑問点は、突如現れた雷にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310217,
					"content": "赤穂百目鬼の船隊は雷のせいでほぼ壊滅した…でも幕府がセイライ島に手配した船隊も、同じようにほとんど壊滅したの。そうして鳴神島に撤退し、船隊の再編までとても長い時間をかけたらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310218,
					"content": "いくらなんでもタイミングが良すぎるのよ、この雷が落ちた時が。そう…まるで…誰かに操られていたかのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310219,
					"content": "わざと封印が解かれたあの「鎮め石」のことを、まだ覚えているでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310220,
					"content": "そして、その「鎮め石」を封印したら、島の雷も収まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310221,
					"content": "安易な推測はできるだけ避けたいけど…これらは、多かれ少なかれ関連していると思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310222,
					"content": "その、寝子さまに聞いてみるってのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310223,
					"content": "それはやめた方がいいと思う…資料では百目鬼は失踪したと書かれているけど、あんな雷に当たったんじゃ、たぶんもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310224,
					"content": "私たちは引き続きこの島で探索をして、このことに関する手がかりも見つけたいと思ってる。しばらく経ってから、協会へ報告しに行くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310225,
					"content": "ふふ、旅人、もしかしたら、その時はまた一緒に仕事できるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310226,
					"content": "その時はよろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "ええ、よろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310228,
					"content": "大祐、準備をしなさい。引き続き探索計画を練るわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310229,
					"content": "えっと…悦子、寝子さまは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310230,
					"content": "以前と同じように、その猫に接するといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310231,
					"content": "でもこれだけは覚えておいて。言ってはならないことは、決して口にしないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310232,
					"content": "あの猫…今、とっても嬉しそうにしてる。空気を壊すようなことは言っちゃだめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310233,
					"content": "分かったよ、悦子！えへへ、やっぱり君って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722310234,
					"content": "…ただ、より効率的に依頼をこなすためよ。早く仕事に戻りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310235,
					"content": "セイライ島…どうやらまだまだ秘密があるみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 722310207,
					"content": "何か知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}