			"dialogs": [
				{
					"id": 150260201,
					"content": "ここがあの大シャーマン殿が住んでいる場所…？あまりにも辺鄙すぎないか？道を聞いた人に騙されてないといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260202
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260202,
					"content": "シトラリなら、こういうところに住んでてもおかしくないとは思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260203,
					"content": "壁にあるラクガキは大シャーマンが描いたものでしょうか？部族の文化と関係があるかもしれません！模写しておけば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260204
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260204,
					"content": "アリエ、用事が先だ。さて約束通り、彼女との交渉は君たちに頼んだよ。私たちはここで待っていよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260205
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260205,
					"content": "おう、任せろ。行こうぜ！ただあいつ…二日酔いじゃなきゃいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260206,
					"content": "シトラリ、いるか？ちょっと頼みたいことがあるんだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260207,
					"content": "…返事がない。いないのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260208,
					"content": "呼び方を変えてみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260209
					]
				},
				{
					"id": 150260209,
					"content": "おーい、黒曜石の老婆、いるかー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260210,
					"content": "急にドアが開き、酒の匂いが漂ってきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260211
					]
				},
				{
					"id": 150260211,
					"content": "このスットコドッコイ！試練を受けるなら前もって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260212
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260212,
					"content": "（シトラリって普段、こんなにダラしないんだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260213
					]
				},
				{
					"id": 150260213,
					"content": "…た、たたた旅人っ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260214
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260214,
					"content": "ドアがまた「バンッ」と閉じられた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260215
					]
				},
				{
					"id": 150260215,
					"content": "…タイミングが悪かったかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260216,
					"content": "オホンッ…まだいるかしら？さ、もう入ってダイジョーブよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260217
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260217,
					"content": "ふぅ、断られなくてよかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
