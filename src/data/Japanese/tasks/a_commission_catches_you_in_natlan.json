			"dialogs": [
				{
					"id": 150260101,
					"content": "なあ…おまえたち、ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260102,
					"content": "あん？モラをもらって仕事をしてただけだ。文句があんなら雇い主に言え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260103
					],
					"speakerTitle": "グルドック"
				},
				{
					"id": 150260103,
					"content": "なんだよその態度…ファデュイも雇われたりするんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260104,
					"content": "…コホン！彼はグルドック、私が雇ったボディガードだ。どうやら人付き合いが苦手なようでね。いやはや、お二人には恥ずかしいところを見せてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260105
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260105,
					"content": "最初はナタの地元民を雇おうとしていたのだが、ある祭司からの推薦なんだよ、彼とその小隊は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260106
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260106,
					"content": "彼らにはちょうど時間があり、戦闘経験も悪くない。私の要望に合っていたし…ナタじゃファデュイの評判もよさそうだったのでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260107
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260107,
					"content": "なるほどな…ところでおまえって、フォンテーヌ人だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260108,
					"content": "ああ、私はモンリュソン、フォンテーヌ出身で出版業に就いている。お二人はもしや…噂の旅人とその仲間の精霊だろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260109
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260109,
					"content": "オイラたちのことを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260110,
					"content": "金髪の旅人に、空飛ぶ銀色の仲間…ああ、間違うはずもないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260111
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260111,
					"content": "君たちがフォンテーヌで残した実績の数々は、本にすればベストセラー間違いなし、しかもシリーズ化できるほどのものだ。書籍を扱う人間として、知らないわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260112
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260112,
					"content": "オイラたちってやっぱり有名なんだな、旅人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260113,
					"content": "実に運がいい——さっきまでお二人を探しに行こうかと悩んでたところなんだ。急な話で申し訳ないんだが、少し頼みたいことがあってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260114
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260114,
					"content": "なんかまるで、フォンテーヌの依頼人がナタまでオイラたちを追いかけてきたみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260115,
					"content": "依頼が完了したら、報酬はたんまり払おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260116
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260116,
					"content": "…気前がいいな。とりあえず話だけでも聞いてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260117,
						150260118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260117,
					"content": "「追われてる」なら逃げられないしね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				},
				{
					"id": 150260119,
					"content": "ええと…オイラたちになにをしてほしいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260120,
					"content": "お二人はシトラリ殿のことを知っているだろうか？どうしてもあの大シャーマン殿に協力を仰ぎたくってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260121
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260121,
					"content": "うーん…さすがにオイラたちの仲でも、知らないやつの頼みごとは難しいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260122,
					"content": "あの性格だし、厳しいだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260123
					]
				},
				{
					"id": 150260123,
					"content": "その、あいつは知らないやつとあんま関わりを持ちたがらないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260124,
					"content": "ああ、それはすでに謎煙の主の人間から聞いた。彼女に頼みごとをできるとすれば、それは「金髪の旅人」しかいないこともな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260125
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260125,
					"content": "手伝ってくれるなら、報酬は相場の二倍にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260126
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260127,
					"content": "その協力してもらいたいことって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260128
					]
				},
				{
					"id": 150260128,
					"content": "そうだな…シトラリにどんなことを頼みたいんだ？念のため教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260129,
					"content": "…これは話すと長くなるんだ。謎煙の主の歴史に関することでね…ここは専門家に説明してもらおう——アリエ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260130
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260130,
					"content": "はい！普段はこんな話を聞いてくれる人、滅多にいないんですけど…初めまして、僕はフォンテーヌ科学院の研究員、アリエ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260131
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260131,
					"content": "多くの研究員とは違い、僕は古代遺跡の研究にも興味があるんです。そこを買われて、モンリュソンさんに誘われまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260132
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260132,
					"content": "お二人は伝説のシャーマン、ウィツィリンについて聞いたことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260133,
						150260134
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260133,
					"content": "聞いたことあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260135,
					"content": "現在入手できるナタの史料によると、彼女は二百年以上も昔の人で、色に関する秘術に長けていたとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260136
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260136,
					"content": "そして、彼女の功績の中で最も有名なのが伝説の「七彩の戦い」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260137
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260137,
					"content": "それはアビスの侵攻により引き起こされたもので、その凄惨さはナタの戦争史においても、トップレベルだったといいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260138
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260138,
					"content": "ですが驚くべきことに、ナタは極めて不利な状況から戦局を逆転させました。そして勝利の鍵となったのが、まさにウィツィリンが戦場で作り出した「色」なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260139
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260139,
					"content": "その「色」はとても不思議なもので、幻のようにも実体があるようにも見えたといいます。ウィツィリンはそれを使って、美しい迷宮を作り出しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260140
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260140,
					"content": "凶暴な敵は全員迷宮に閉じ込められ、仲間たちはウィツィリンの指揮のもと反撃に転じ、最終的に勝利を収めました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260141
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260141,
					"content": "コホンッ…説明は大体で構わないよ。旅人の時間を無駄にしてはならないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260142
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260142,
					"content": "今話した物語こそ、私がナタに来た理由だ。他の国の歴史を集め、本にして出版するのが好きでね。幸い、そういう本はよく売れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260143
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260143,
					"content": "その物語を聞いたとき、今後出版する本に収録しようと考えたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260144
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260144,
					"content": "ナタの史料に詳しい記述がないんだ。私の部下も当時の戦場を特定できなかった。「七彩の戦い」が起きたという証拠もいまだ見つかっていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260145
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260145,
					"content": "それに謎煙の主の中には、「七彩の戦い」を作り話だと言い、その真偽を疑う人もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260146
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260146,
					"content": "それでは、とても本には入れられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260147
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260147,
					"content": "えっ？本に書く物語なのに、実際に起こったって証拠が必要なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260148,
					"content": "ああ、私が出す本の最大の売りは「歴史を忠実に再現する」ことなんだ。証拠はもちろん必要不可欠さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260149
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260149,
					"content": "だから私はここに来た——謎煙の主は歴史を記録する習慣があると聞いてね。彼らの史料を調べたいと思ったのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260150
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260150,
					"content": "だが結局、「黒曜石の祭場」とやらは立ち入り禁止だったし、苦労して申請しても普通のウォーベンしか見せてくれなかった。それで何の研究ができる？私なら彼らの歴史を広める手伝いができるというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260151
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260151,
					"content": "僕の知る限り、謎煙の主にとって歴史を記録するウォーベンは神聖なものですし、そう簡単に余所の人間には見せられないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260152
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260152,
					"content": "ウォーベンに含まれる情報は膨大です。それをじっくり調べることができれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260153
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260153,
					"content": "アリエ、その話はもう済んだだろう？もっといい方法があるんだ。そこに時間を割く必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260154
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260154,
					"content": "もっといい方法？もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260155,
					"content": "ああ。周知のように、シトラリ殿は二百年以上も生きてきた大シャーマン。つまり「七彩の戦い」が起きた時代も生きていたことになる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260156
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260156,
					"content": "もし彼女を顧問として雇えれば、史料を研究する必要もなくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260157
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260157,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260158,
					"content": "どうだ？報酬はさらに倍にしてもいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260159
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260159,
					"content": "手伝いたくないわけじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260160,
						150260161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260160,
					"content": "パイモン、どっちみち行かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260162,
					"content": "あっ、そうだった！前に謎煙の主の族長に託された使命って、ウィツィリンが大きく関わってるんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260163,
					"content": "「七彩の戦い」の裏には、オイラたちの知りたい情報が隠されてるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260164,
					"content": "よし、手伝ってやるぞ。でもシトラリとの交渉はすべてオイラたちに任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260165
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260165,
					"content": "ああ、それで構わない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260161,
					"content": "まだ果たしてない使命がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260134,
					"content": "「色」と関係のあるシャーマンだよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260118,
					"content": "報酬をたんまり貰えるなら喜んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				}
			]
		},
