			"dialogs": [
				{
					"id": 150260601,
					"content": "グルドック、モラを払うのは私だぞ。待つのも仕事のひとつだと思え。さあ、下がるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260602
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260602,
					"content": "へい、へい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260603
					],
					"speakerTitle": "グルドック"
				},
				{
					"id": 150260603,
					"content": "齢数百の大シャーマン殿がこんなにも…おっと失礼。お騒がせして申し訳ありません。臨時で雇ったので、しつけが行き届いていないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260604
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260604,
					"content": "ふぅ…シトラリが手を出さなくてよかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260605,
					"content": "こうしてお会いできましたし、少しお話を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260606
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260606,
					"content": "黒曜石の老婆がどんな人物か聞いたコトある？キミたちのチンケな芝居に騙されるとでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260607
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260607,
					"content": "うっ…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260608
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260608,
					"content": "キミと話すつもりはミジンもないの。さっきどう返事するか考えてるときに、キミの部下にジャマされたから——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260609
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260609,
					"content": "——もしまた同じコトをしたら、ホラー小説にも書けないような悲惨な末路を辿るコトになるって伝えに来ただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260610
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260610,
					"content": "う、うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260611,
					"content": "旅人、戻ってハナシを続けましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260612
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260612,
					"content": "さすがは黒曜石の老婆。大変失礼いたしました。ですが、「七彩の戦い」ですらあなたの興味を惹けないとは、思いもしませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260613
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260613,
					"content": "…調べたいのは「七彩の戦い」なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260614
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260614,
					"content": "旅人からまだ詳細を聞いていないのですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260615
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260615,
					"content": "実はあなたに依頼しようとしたのは、旅人が仲介に応じてくれたからだけではなく、この件があなた自身にとっても、大事なことだと思ったからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260616
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260616,
					"content": "ウィツィリン——かの大シャーマンとは旧友だと聞きました。彼女のことをあなたはよくご存じでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260617
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260617,
					"content": "「七彩の戦い」の真偽を明らかにし、論争を収められたら、私はそれを本にまとめます。そうすれば、テイワット全土に伝説のことを知ってもらえる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260618
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260618,
					"content": "亡き友人の輝かしい功績も、あなたの口を経て再びこの世に届くんです。実に美談でしょう？そう思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260619,
						150260620
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260619,
					"content": "#{M#俺}{F#私}の使命の助けにもなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				},
				{
					"id": 150260621,
					"content": "キミの使命というのなら…分かった。調査を手伝ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260622
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260622,
					"content": "ありがとうございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260623
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260623,
					"content": "そういうのは結構。キミの依頼を受けたつもりはないから。ワタシが手伝うのはあくまで旅人。キミたちはつ・い・で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260624
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260624,
					"content": "シトラリ、やっと引き受けてくれたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260625,
					"content": "#（これもシトラリとの絆のおかげ{M#だ}{F#だね}。それにこう見えて、シトラリは薄情者じゃないし。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260626
					]
				},
				{
					"id": 150260626,
					"content": "ワタシのコトをそんな風に思ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260627
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260627,
					"content": "…構いませんとも。私も旅人と協力して進めるつもりでしたので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260628
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260628,
					"content": "さて、さっそく質問をさせてください。あなたは「七彩の戦い」を経験されたのですか？戦場はどこだったのでしょう？あの戦争が起きたことを証明できる遺物は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260629
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260629,
					"content": "ウルサイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260630
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260630,
					"content": "ええと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260631
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260631,
					"content": "#{M#俺}{F#私}も知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260632
					]
				},
				{
					"id": 150260632,
					"content": "戦いには参加してないし、戦場も遺物も知らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260633
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260633,
					"content": "え…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260634
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260634,
					"content": "確かに彼女と同じ時代を生きたけど、だからと言って同じコトを経験したワケじゃない。ただ少し長生きなだけ。何でも知ってる歴史書じゃないのよ、ワタシは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260635
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260635,
					"content": "調査の方向性はキミたちで決めてちょうだい。ワタシの知ってるコトなら、答えてあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260636
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260636,
					"content": "…分かりました。「七彩の戦い」の経験者ではないとのことですが、あなたはあの時代を生きたお方。その言葉は必ず役に立つでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260637
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260637,
					"content": "アリエ、君はどう調査したらいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260638
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260638,
					"content": "僕ですか？…謎煙の主には歴史を記録する人がいると以前の調査で分かったので、その人に聞いてみるのはどうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260639
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150260639,
					"content": "では、そこから攻めるとしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260640
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260640,
					"content": "旅人、引き続き協力を頼む。大シャーマン殿の助けを得られるのは、君しかいないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260641
					],
					"speakerTitle": "モンリュソン"
				},
				{
					"id": 150260641,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150260620,
					"content": "謎煙の主にとっても重要なこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				}
			]
		},
