					}
				]
			},
			"dialogs": [
				{
					"id": 150260401,
					"content": "えーっと…ここがシトラリの家なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260402,
					"content": "あぁ…そうすぐ片付くワケもなかった…ナ、ナニか感想があるならご自由にどうぞ！謎煙の主の大シャーマンは、つまらない家事に時間をかけたりしないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260403
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260403,
					"content": "それに、いつも部屋をキレイに片付けてるようなヒトが、娯楽小説の主人公になれるハズもないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260404
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260404,
					"content": "そもそも！ワタシは俗世から離れたのであって、ダラしないワケじゃないのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260405
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260405,
					"content": "シトラリのやつ、オイラたちにどう見られるかすごく気にしてるみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260406,
					"content": "ところで以前、巫術で感覚を共有したときに副作用があったでしょ。あれはもうヘーキ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260407
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260407,
					"content": "ワタシって大シャーマンだし、相応のセキニンってものがあるから。念のため、確認しておかないと…ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260408
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260408,
					"content": "おまえの心の声が聞こえたことだよな？ずいぶん経ってるし、もう大丈夫だぞ。心配いらないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260409,
					"content": "じゃあ、どうしてワタシに旅人のココロの声が聞こえるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260410
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260410,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260411,
					"content": "（心の声が？でもシトラリならもっと平然とした態度でいると思ったけど…だって「俗世から離れた」わけだし…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260412
					]
				},
				{
					"id": 150260412,
					"content": "イマも聞こえてるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260413
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260413,
					"content": "ご、ごめん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260414
					]
				},
				{
					"id": 150260414,
					"content": "ま、いいわ。どうにかするから——フン、前はこっちのココロの声がダダ漏れで、今度はそっちだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260415
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260415,
					"content": "感覚を共有する巫術を使っただけなのに…はぁ、一体どんな体質ならこんなフクザツな副作用が出ちゃうワケ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260416
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260416,
					"content": "…で、今日はどうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260417
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260417,
					"content": "おう、実はおまえを顧問として雇いたいってやつがいるんだ。ナタの歴史について調べてるみたいでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260418,
					"content": "フーン、ナタを救った英雄に頼んでまで、ワタシを雇いたいと。そのヒトは、ワタシがメンドーごとを嫌ってるってよく分かってるようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260419
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260419,
					"content": "しかも、報酬も太っ腹だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260420,
					"content": "だが断る。忙しいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260421
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260421,
					"content": "どう見ても忙しそうには見えなかったけど…やっぱりいくらオイラたちの仲でも、知らないやつの手伝いはしてくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260422,
					"content": "#{M#俺}{F#私}からもお願いしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260423
					]
				},
				{
					"id": 150260423,
					"content": "キミのオネガイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260424
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260424,
					"content": "そうそう。実はこの間、神聖な使命を受けてな——謎煙の主のために、歴史を記録する特殊なウォーベンを作るんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260425,
					"content": "えっ？今回選ばれたのはキミたちなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260426
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260426,
					"content": "オイラたちも驚いたぞ。だって、そのウォーベンの作り方なんてまったく知らないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260427,
					"content": "でも族長のビラムの助けもあって、ちょっと進展があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260428,
					"content": "まあ、結局成功しなかったけど…ただ少なくとも、ウォーベンを作るカギは、特殊な「色」にあるってことはわかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260429,
					"content": "ちょうど、さっき話したやつらが調べたいことも色と関係してるみたいでさ…もしシトラリが手伝ってくれたら、オイラたちも助かるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260430,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260431
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260431,
					"content": "どうしたんだろ？また「あの顔」になってるぞ…オイラの説明がわかりにくかったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260432,
					"content": "これって超展開？それとも伏線回収ってやつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260433
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260433,
					"content": "ええと…なに言ってんだ？やっぱダメなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260434,
					"content": "…ちょっと考えさせて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260435
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260435,
					"content": "おおっ、いけそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260436,
					"content": "おいッ！まだまとまんないのか？手伝うか、手伝わないかさっさと決めろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260437
					],
					"speakerTitle": "グルドック"
				},
				{
					"id": 150260437,
					"content": "おい…交渉はこっちに任せるって約束だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150260438,
					"content": "ハァ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260439
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150260439,
					"content": "あ、シトラリ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
