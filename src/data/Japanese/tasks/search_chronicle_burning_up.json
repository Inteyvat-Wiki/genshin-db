	"talks": [
		{
			"id": 7166501,
			"completionStepIds": [
				7166501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166501",
							"2"
						],
						"stepId": 7166501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランジット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716650101,
					"content": "おっと、やっと来てくれたな。君が「主人公」だろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650102,
						716650104
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650102,
					"content": "#そう、{M#俺}{F#私}こそが主人公。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650103
					]
				},
				{
					"id": 716650103,
					"content": "えっと、その質問の意図が全然わかんないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650105,
					"content": "おっと、すまんすまん。つい先を急いでしまった。依頼を出す時にも、まず簡潔な言葉で依頼内容を説明すべきだと言われたというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650106
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650106,
					"content": "私はランジット、創作料理の道を歩むシェフだ。爆炎樹と仲良くなりたいと思ってるんだが、あいにく向こうにその気はないようでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650107
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650107,
					"content": "火の玉を吐いたり、地面を叩きつけたりしてくる。まったく手も足も出ないから、物語の主人公になれるような冒険者に手伝ってもらいたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650108,
						716650110
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650108,
					"content": "分かった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650109
					]
				},
				{
					"id": 716650109,
					"content": "こんなむちゃくちゃな依頼をあっさり引き受けるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650111,
					"content": "おまえ、本気なのか？創作料理のシェフが爆炎樹と仲良くなりたいだなんて…どう考えてもおかしいだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650112,
					"content": "そうか？確かに爆炎樹は植物なのに少し乱暴だが…物は試しって言うだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650113
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650113,
					"content": "爆炎樹以外にも、エンシェントヴィシャップ、マッシュラプトル、それに千年真珠の海駿とも仲良くなる予定だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650114
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650114,
					"content": "…うわー、ますますむちゃくちゃだな。なんでそんなことを思うようになったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650115,
					"content": "ああ。実は、少し前にナタに行ってきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650116
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650116,
					"content": "あそこは本当に不思議な場所だよ。あの新鮮さを喩えるなら、初めて激辛カレーを食べて、全身に汗をかいた時の感じと言えばいいだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650117
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650117,
					"content": "舌がとっくに限界だというのに、手が止まらないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650118
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650118,
					"content": "…そうそう、その時にナタで友人をたくさん作ってね。岩登りを教えてくれたり、温泉に連れていってくれたりと、いいやつらばっかりだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650119
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650119,
					"content": "知ってるか？ナタ人——特にその戦士は、自分らの竜の姿を模した服を身にまとってるんだ。その恰好はまるで本物の竜のように逞しくってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650120
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650120,
					"content": "そこで、私もナタの友人の帽子にならって作ってみた。どうだ？悪くないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650121
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650121,
					"content": "えっと…たしかに特徴的な帽子だな。でも、その帽子だけじゃ、なにもわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650122,
					"content": "それもそうだろう。なぜなら私には、竜の仲間がいないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650123
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650123,
					"content": "はぁ…私にも竜の仲間がいてくれたら…。だが私はナタ人じゃないし、あの国に長居しても落ち着くことはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650124
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650124,
					"content": "そこでだ。ナタ以外の場所でも、竜の代わりになる仲間を探そうと決めたんだ！可能かどうかは別として、少なくとも次にナタに行く時の話のネタにはなるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650125
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650125,
					"content": "だとしても、もう少し相手を選んだほうがいいんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650126,
					"content": "ん？ぴったりじゃないか？ほら、ナタの竜とも似てるし、しかも強いだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650127
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650127,
					"content": "駄獣を仲間にする程度じゃ自慢にはならないからね。ナタの友人に冒険譚を語るなら、やはりそれなりに手ごわい相手を選ばないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650128
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650128,
					"content": "ただ残念なのは、私じゃ「主人公」になれない点だ…昼も夜も関係なく怒ってるやつらを落ち着かせるのは、そう簡単なことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650129
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650129,
					"content": "だが経験豊富な冒険者なら、こういうのが得意だろ？もちろん、私も近くでサポートする。網で捕まえるのも、料理を振る舞うのも私に任せくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650130
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650130,
					"content": "だから、未来の仲間たちと正面から「交涉」するのは君に任せた！「主人公」よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650131
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650131,
					"content": "なんで危険なことを全部主人公にやらせるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650132,
						716650134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716650132,
					"content": "苦労に見合った報酬をくれるといいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650133
					]
				},
				{
					"id": 716650133,
					"content": "それはもちろん！報酬については心配不要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650136,
					"content": "よし！そうと決まれば、さっそく出発しようか？鍋は用意してあるし、装備のメンテナンスもパッチリ。きっと上手くいくだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650137,
						716650138
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650137,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716650138,
					"content": "他に用事があるから、またあとで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650139
					]
				},
				{
					"id": 716650139,
					"content": "ああ。じゃあ、ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650134,
					"content": "「理屈責め」のあと交流するんだね、了解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650135
					]
				},
				{
					"id": 716650135,
					"content": "ああ、その通りだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716650136
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 716650110,
					"content": "説明が簡潔すぎて、全然理解できなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650111
					]
				},
				{
					"id": 716650104,
					"content": "何を言ってるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716650105
					]
				}
			]
		}
	]
}