			"dialogs": [
				{
					"id": 120220401,
					"content": "心海、探してたのはこの本か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220402,
					"content": "よく覚えていません…少し読んでいただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220403,
					"content": "権を制する手段は、事制に因りて権かるものなり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "はい、それです！お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220406,
					"content": "心海…心海…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220407,
					"content": "#どうしよう{NICKNAME}、心海が寝ちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220408,
					"content": "今夜は祝賀会があるし、それにもうじき和平交渉も！まだまだやることが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220409,
					"content": "少し休ませよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220411,
					"content": "でも、たしかに疲れてるみたいだ。まだ時間があるなら、もう少しだけ休ませてあげるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220412,
					"content": "災いを払い…安寧を守る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220413,
					"content": "戦争は終わりました…すべてが…良い方向へ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220414,
					"content": "あなたたち…見届けられましたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220415,
					"content": "あっ…私…眠ってしまったのですか？今は何時でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220416,
					"content": "すっごく長いあいだ寝てたぞ！もうすぐ営火が始まる時間みたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220417,
					"content": "そんなに長く！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220418,
					"content": "これほど安らかに眠ったのは久しぶりです。少なくともエネルギーも3点は回復したような気がします。これで和平交渉の終わりまで耐えられるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220419,
					"content": "ありがとうございます。私たちも早く営火の場に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220420,
					"content": "心海がいつもの状態に戻った！よかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220421,
					"content": "そろそろ起こそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "おう、仕事に影響を及ぼすわけにはいかないって心海も言ってたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220423,
					"content": "おーーい、心海、起きろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220424,
					"content": "うぅ…私…眠っていましたか、今は何時でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220425,
					"content": "営火に行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220426,
					"content": "もうそんな時間なんですか？うぅ…なんだかエネルギーがまだ回復していない気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220427,
					"content": "あとで新しい兵学の本を買ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "本当ですか！『テイワット戦争芸術』の新刊が読みたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220429,
					"content": "先月、八重堂から発売されたのですが、ずっと購入できていなくて…先に言っておきますが、やっぱなしとかはダメですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220430,
					"content": "なんだか心海の元気が一気に戻ったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220431,
					"content": "営火に行ってみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220404,
					"content": "其の懈怠を撃ちて、其の空虚に出づる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
