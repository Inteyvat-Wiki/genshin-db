			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "あれ、心海はまだ来てないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220102,
					"content": "おかしいな、心海は遅刻するような人じゃないと思うけど…もう少し待つか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220103,
					"content": "なんでまだ来ないんだろう…なにかトラブルにでも遭ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220104,
					"content": "あそこの兵士に聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220701,
					"content": "珊瑚宮様に会いたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220702,
					"content": "ここにはいないよ。俺も珊瑚宮様がどこにいるのか分からない、悪いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220703,
					"content": "そんな…じゃあ、オイラたち帰るしかないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220704,
					"content": "いや、諦めるのはまだ早い。たしか珊瑚宮様が残した常備用の虎の巻に、この状況を打破する解決策があったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220705,
					"content": "たしか…第九十八条…<color=#00E1FFFF>「私の不在時、遠方より訪れし客を南へ導き、紫の葉が茂る木のそばへ」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220706,
					"content": "それに注意書きも。珊瑚宮様が理由を残さず不在の時、そして客人の身分が特別な場合にのみ適用されると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220707,
					"content": "お二人は遠くから来たお客さんだったね。この虎の巻に間違いはないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "柴田"
				},
				{
					"id": 120220708,
					"content": "心海は本当にあらゆる状況を考えてるんだな。じゃあ、オイラたちもさっき言ってた場所に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "心海！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220205,
					"content": "ここにいたのか！今日一緒に祝賀会の準備をする約束してたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220206,
					"content": "あっ…あなたたちでしたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220207,
					"content": "すみません、今日は…少し具合が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220208,
					"content": "病気か？待ってろ、すぐに医者を呼んでくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220209,
					"content": "いいえ、一時的に「エネルギー」を使い果たしてしまっただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220210,
					"content": "エネルギー…ま、まさか心海って、人間じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220211,
					"content": "いえ、ただの比喩に過ぎません。お恥ずかしながら、あのような万能な姿をずっと維持することはできないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220212,
					"content": "昨日話しかけられた時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "ふぇ！？気づいていたのですか？どうやら私もまだまだのようです、もっと隠し通す技術を磨かないといけませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220215,
					"content": "実は、私は人の上に立つのがあまり得意ではないのです。元々私は、兵学を学んで幕僚になるのが夢でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220216,
					"content": "他人と会話し、気を配り、顔色をうかがい、利益を分配する…私にとってどれも非常に大変なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220217,
					"content": "他の人を満足させるだけでなく、彼らに畏敬の念を抱かせるのは、私の得意分野ではありません。むしろ、かつての私が関わりを持ちたくなかった分野なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220218,
					"content": "しかし血筋のせいで、「現人神の巫女」の地位は結局私の元にやってきました。好む好まざるにかかわらず、それを避けることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220219,
					"content": "ですので、自分に限界が来た時、ここへ来るようにしているのです。本を読んで、休憩して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220220,
					"content": "仕事には影響しませんので、ご心配なく。祝賀会の準備はすでに他の者を手配しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220221,
					"content": "今夜はまだ演説が一つ残っています、兵士たちに良くない印象を与えるわけにはいきません…やっとのことで勝ち取った平和、彼らにはもっと息抜きをしてほしいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220222,
					"content": "なにかオイラたちに手伝えることはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220223,
					"content": "このまま放っておいても、エネルギーはゆっくりと回復していきます。ただ、私の好きな兵学を聞かせていただけると、より早く回復できる気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220224,
					"content": "たしかこの前、半分まで読んだ本が一冊ありました。ただ、どこに置いたのか忘れてしまい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220225,
					"content": "オイラたちが探してくるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220226,
					"content": "それを心海に読ませれば、心海も立ち直れるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220227,
					"content": "本当ですか？ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220228,
					"content": "ふふ…やはり、あなたたちが海祇島に戻ってきてくれて本当によかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120220213,
					"content": "確かに心海が悩んでるのを感じた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
		{
			"id": 1202203,
			"completionStepIds": [
				1202217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202217",
							"2"
						],
						"stepId": 1202217,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220301,
					"content": "#{NICKNAME}、これを見ろ、心海の探してた兵学の本かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220302,
					"content": "今日はメカジキ二番隊隊長が戻ってきた、エネルギー+4——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120220303,
					"content": "あわわ…それは…",
