				"objectNames": [
					"秋月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "どうしたの？え…湯雯さんのこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250307,
					"content": "変な匂いが口の中を充満し、食欲不振で食べたくない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250302,
					"content": "本当に変わった料理を食べたの？間違いないわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250303,
					"content": "なんだか消化不良にも聞こえるけど…まあ、とりあえず考えてみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250304,
					"content": "だめ、全く分からないわ。ただ、試してみる価値のある料理を思い付いたの。その料理の名前は——腌篤鮮よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250305,
					"content": "濃厚な味で、やわらかいお肉は食欲をそそられる。そして鍋いっぱいのスープが、消化を助けてくれる。うん！今すぐにでも食べたいくらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "秋月"
				},
				{
					"id": 220250306,
					"content": "私を信じて、今湯雯に必要なのは腌篤鮮に違いないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秋月"
				}
			]
		},
		{
			"id": 2202504,
			"completionStepIds": [
				2202504
			],
