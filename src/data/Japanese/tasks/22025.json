			"trigger": {
				"objectNames": [
					"湯雯",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "あぁ…もう腹ペコです…苦しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "わ、私にもよく分かりません…とにかく、体がだるいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250104,
					"content": "昨日の夜、あなたの作った料理を持ち帰って、しっかりと味わいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250105,
					"content": "味は少々「独特」でしたが…お腹を満たすことはできました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250106,
					"content": "そして今日の仕事に向けて、しっかりと睡眠を取るつもりでしたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250107,
					"content": "眠りにつくたびに、あの料理の匂いがお腹から湧き出てくるのです！そのせいで完璧に目が覚めてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250108,
					"content": "このようなことを繰り返し、寝返りを打っているうちに夜が明けました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250109,
					"content": "ただの寝不足なら大したことはありません。普段から、遅くまで仕事をしていることがたまにありますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250110,
					"content": "問題は今日です！起きた後に何か食べれば治ると思っていましたが、何を食べても口の中にあの料理のにおいが充満していて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250111,
					"content": "あの料理にこれほどの威力が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "はぁ、この匂いを消すためには、独特な味がする料理を食べるしか方法がないような気がしています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250113,
					"content": "独特な味がする料理って、難しいな。他の人にも話を聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250114,
					"content": "その料理を作れたら…湯雯さんの悩みを解決できるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250115,
					"content": "本当ですか？良かったです、ありがとうございます！もし、もしよろしければ、離島で聞いてもらえますか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220250116,
					"content": "そういえば、離島の商人である李暁は料理に詳しいと聞きます。楚瑜商行の秋月もかなりの食通です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
