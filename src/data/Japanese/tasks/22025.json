			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李暁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "どうした？ああ…湯雯さんのことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250207,
					"content": "食欲不振…口に充満する変わった匂い…特別な料理じゃないと治らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250202,
					"content": "そのような目に遭ったとは…確かに厄介だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250203,
					"content": "私が思うに、特に高価な料理でなくても、味や風味が独特で、パンチが効いていれば十分じゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250204,
					"content": "だから私のお勧めは——絶雲のお焦げだ！独特なパリッとした食感と、猛烈な辛さがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250205,
					"content": "軽策荘で初めて絶雲のお焦げを食べてからもう十年以上経つが、その味は今でも時々思い出すほどだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "李暁"
				},
				{
					"id": 220250206,
					"content": "だから、絶雲のお焦げならば、解決できるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李暁"
				}
			]
		},
		{
			"id": 2202503,
			"completionStepIds": [
				2202503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
