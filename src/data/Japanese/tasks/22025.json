					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250401,
					"content": "ううん、全然違う答えだったな。絶雲のお焦げと腌篤鮮、どれもすっごく美味しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250402,
					"content": "どっちがいいかな？迷っちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250403,
					"content": "パイモンはどれがいいと思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "えっ？オイラか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250405,
					"content": "ふむふむ…オイラが選ぶなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250406,
					"content": "チ虎魚焼きだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250407,
					"content": "チ虎魚焼きの名前を聞くだけで、勇気が湧いてくるんだ。湯雯さんがそいつを食べたら、きっと勇気が出て難関を乗り越えられるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250408,
					"content": "パイモンは食の専門家だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "えへへ、やっぱりおまえが決めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250411,
					"content": "じゃあ…美味しそうな絶雲のお焦げ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "よし、じゃあさっそく美味しい料理を作って、湯雯さんに食べさせてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220250412,
					"content": "じゃあ…美味しそうな腌篤鮮！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "じゃあ…美味しそうなチ虎魚焼き！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "チ虎魚焼きにそういう効果があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
