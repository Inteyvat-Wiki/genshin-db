			"dialogs": [
				{
					"id": 706760101,
					"content": "図書館の中にこんな部屋があるなんてな。まさか、ここがリサさんが言ってた禁書エリアってわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760102,
					"content": "うーん…それにしては雰囲気がそれっぽくないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760103,
					"content": "それとも、物語によく出てくる、「人に知られたらまずい秘密を隠してるから、立ち入り禁止にされた謎の部屋」とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760104,
					"content": "立ち入り禁止なら、鍵をかけてるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "それもそうだな。さっきは普通に入れたし、ロックが壊れたとかでもなさそうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760106,
					"content": "あれ？待てよ。このドア、オイラたちがさっき入った時に通ったやつと違うぞ…！うわぁー！ここって本当にまだ図書館か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760107,
					"content": "シードル湖の底だったりして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "そんな構造になってたのか、すごいぜ…って、違ーう！どう考えてもあり得ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760111,
					"content": "うぅ…リサさんがお休みじゃなきゃ聞けたのに。まあ、せっかく来たわけだし、別に危ない要素もなさそうだから、周りを見て回ろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760112,
					"content": "新しい場所に来たら、まずは思いっきり自由に探索すること！これがいいガイドになるための秘訣だぞ。フフン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760113,
					"content": "見ろよ、狼のぬいぐるみだ！すっごく可愛いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760114,
					"content": "もふもふで、触り心地もよさそうだな！でも、一体誰がここに置いたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760115,
					"content": "このぬいぐるみこそ部屋の主なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "「恐れを知らぬ旅人よ。よくも我が城に侵入したな。全員食べてやる！ガオー！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760120,
					"content": "…ま、ほっとこうぜ。かなり広そうだから、他のところも見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760117,
					"content": "謎の部屋の門番かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "門番なのに部屋の中のソファーでのんびり寝てていいのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760119,
					"content": "「すぴー、すぴー…危険がないということはつまり危険がないってことだ…すぴー…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706760109,
					"content": "もしかしたらもう別の世界かも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "別の世界ってどの世界だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}