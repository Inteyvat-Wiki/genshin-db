			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470101,
					"content": "仕掛け設備のチェック完了、「風の元素粒子」配置オーケー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470102
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470102,
					"content": "もしもし、もう配置は完了しましたか？あの異常な風の元素粒子は…もう大丈夫です？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470103
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470103,
					"content": "コホン！とにかく…演劇「ダイアの三日空想」、「セーブ·ザ·スカイタウン」の章——まもなく開演…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470104
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470104,
					"content": "物語の舞台はとある辺鄙な山の中。ここの住民は洪水と嵐の被害にたびたび見舞われ苦しんでいた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470105
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470105,
					"content": "いち早くその災害を警告するために、責任感の強い勇者たちが立ち上がった。そして、雲まで届く高い崖の上に見張り所を作った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470106
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470106,
					"content": "時は流れ、崖の上に住む人々は独特な部族を形成する——「崖の防人」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470107
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470107,
					"content": "スピーカーから流れる傍白が物語の背景を紹介している——\\n物資輸送が不便なため、防人たちの生活は厳しいものだった。最近、まともに残っていた最後の建物さえも失った。\\nそこで、防人の長老はある依頼をする——建築を専門とする「奇跡の建築士」に空に浮く町を作らせたのだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470108
					]
				},
				{
					"id": 790470108,
					"content": "奇跡の建築士は堅牢な岩石を基盤とした素晴らしい耐性を持つ構造を用意し、そこにすべての建物を造り上げた。\\nその後、基礎の内部に数万個にもおよぶ貨物輸送用の熱気球をセットし、中に「風の元素粒子」を注入した。\\n気球は比類ない上昇効果を得ると、町を丸ごと持ち上げて山頂まで浮上した。\\n奇跡の建築士は事前に計算しておいた高度で町をロープで固定する…\\nこうして防人たちは安定した温かい住居を得られたのであった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470109
					]
				},
				{
					"id": 790470109,
					"content": "しかし時は流れ、貨物輸送用熱気球に問題が起きる…\\n防人一族は町の高度が徐々に下がっていることに気づいたのだ。あと少しで山頂に墜落して、町は粉々になってしまう…\\n町の高度が下がっていくという未曾有の災害が降りかかると同時に、地震のような振動が頻繁に防人たちを襲い、誰もが恐怖に陥っていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790470110
					]
				},
				{
					"id": 790470110,
					"content": "おおっ…この物語の始まり方、すごくちゃんとしてるぞ！空に浮く町が…墜落しそうってことだよな？聞いただけで、とんでもなくピンチだってわかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470111,
						790470112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470111,
					"content": "こっちも真剣に対応しないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				},
				{
					"id": 790470113,
					"content": "そうだな！見ろよ、もうひとつスピーカーがあるぞ。あっちが演劇のスタート位置みたいだ。近くに行って、続きを聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470112,
					"content": "物語の全容を把握しないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470113
					]
				}
			]
		},
		{
			"id": 7904702,
			"completionStepIds": [
				7904702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904702",
							"2"
						],
						"stepId": 7904702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470201,
					"content": "防人の長老は再び奇跡の建築士と会い、空中の町が直面している危機を話した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470202
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470202,
					"content": "奇跡の建築士殿、見ての通り、町の高度は日に日に下がっておる。ワシらはみんなこの暖かで頼れる故郷を失いたくない。じゃが、まったく打つ手がない状況じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470203
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470203,
					"content": "しかも最近、町で強い揺れがよく起きるようになった。そのせいでよくない噂まで広がり、恐怖が徐々にみんなを蝕んでおる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470204
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470204,
					"content": "オチルゾ、オチルゾ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470205
					],
					"speakerTitle": "ちょっと失礼な物真似鳥"
				},
				{
					"id": 790470205,
					"content": "敬愛なる長老様、恐れていることは重々承知しています。そして、工事の品質を疑うような噂も耳にしました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470206
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470206,
					"content": "ですが、心配無用です。私がここに戻ってきたのは、まさにこの危機をすべて解決し、皆様の心配と疑いを晴らすためなのですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470207
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470207,
					"content": "先ほど町を一周して、基礎の中に残しておいた観測装置を確認しました。どうやら、一部の気球に問題があるようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470208
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470208,
					"content": "その気球の中に入ってる風の元素粒子の量が減っています。これは恐らく悪意を持った破壊行為です…それを直せば、町は墜落しなくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470209
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470209,
					"content": "ですが、町を元の高度にまで戻すためには、一部の気球の上昇効果を高める必要があります。より多くの固定用ロープを付ける必要があるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470210
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470210,
					"content": "その…人為的な破壊による修理は保証の範囲外でして…追加料金をいただくことになりますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470211
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470211,
					"content": "問題ない、今提示している予算の5倍を払おう。それでどうじゃろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470212
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470212,
					"content": "ゴバイヨサン！ゴバイヨサン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470213
					],
					"speakerTitle": "ちょっと失礼な物真似鳥"
				},
				{
					"id": 790470213,
					"content": "お、おお…追加予算をいただき、本当に感謝です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470214
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470214,
					"content": "…いや、待ってください、5倍ですか？それはいくらなんでも多すぎるかと…この町を作った当初も、あなたが提示してきた予算は他の発注者よりも数倍高かったですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470215
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470215,
					"content": "前回言い忘れたんじゃよ。昔、欲深い職人がおってのう、ワシらの資金に余裕があるのを見て、平均価格の20倍もの値段を言ってきよったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470216
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470216,
					"content": "まあ、幸いなことに、ちゃんと調査したから騙されずに済んだがな。それでワシらは施工費用のことを大方把握できるようになったんじゃ。むしろ、アンタが提示した予算は平均よりも低いようじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470217
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470217,
					"content": "あなたたちはすごく裕福なのですね…それはまた…人は見た目によらずというか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470218
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470218,
					"content": "ワシラクロウスル、ミンナカセゲル！ミンナシッテル、ミンナカネヲクレル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470219
					],
					"speakerTitle": "ちょっと失礼な物真似鳥"
				},
				{
					"id": 790470219,
					"content": "そうじゃ、付近の村人たちが大きな商売をすると、よくワシらに多額の寄付をくれるんじゃよ。その上、我が一族はみんな勤勉で節約家でのう、これまでずっと貯金してきたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470220
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470220,
					"content": "世の中に、こんなにも純朴な地域があるだなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470221
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470221,
					"content": "コホン、とにかく…私はコストを抑えることにおいてプロです。現在提示している2.5倍にしていただければそれで十分。それ以上の額は必要ありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470222
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470222,
					"content": "おお、これはまた意外な申し出じゃ。さすが「奇跡」と名乗るだけあって、高尚な建築士じゃのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470223
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470223,
					"content": "カネステル、アホ！カネステル、アホ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470224
					],
					"speakerTitle": "ちょっと失礼な物真似鳥"
				},
				{
					"id": 790470224,
					"content": "おい！そこのバカ鳥、私はただ自分の良心に背くような金は稼がない主義なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470225
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470225,
					"content": "当初この町を作った時、私が提示した予算は材料費と人件費を少しだけ高く設定していました。それであなたたちに最高の部屋を作り、さらに私の手元には二ヶ月分もの食事代を残すことができています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470226
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470226,
					"content": "それに今日の修理サービスについては、もともと旅費と数日の宿泊食事代しか稼がないつもりだったのです。これは発注側にとって最高のプランかと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470227
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470227,
					"content": "さっきまで感動して涙を溢れさせていた長老は、肩に乗る物真似鳥に少し怒ると、ぽかんと叩いて黙らせた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470228
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470228,
					"content": "コホン、本当に感謝じゃ！ワシら防人一族はアンタからの恩を忘れない。アンタのことを代々伝えていこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470229
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470229,
					"content": "ところで、前回アンタは駄獣のキャラバンを雇って、数百個もの特別な貯蔵缶を運んできたはずじゃが…今回は随分と軽装のようじゃ。特に何も準備をしておらんのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470230
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470230,
					"content": "ふむ、重要なところに気が付きましたね。今の一番の問題は、どうやって十分な風の元素粒子を集めて、不足している気球の上昇効果を補うかなのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470231
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470231,
					"content": "それなら心配に及ばん。今回の風の元素粒子はワシらに任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470232
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470232,
					"content": "風の元素粒子を集めるのは、我が一族の専門分野——ワシらはよくこの方法で嵐が形成される可能性を分析してきたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470233
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470233,
					"content": "#その中でも特に腕が立つ{M#彼ら}{F#彼女ら}にその役を任せよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470234
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470234,
					"content": "長老が二人の勇敢な防人を推薦した——それは隣でずっと静かに聞いていたあなたたちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470235
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470235,
					"content": "この二人は既に重力と山風を征服し、高い地形も自由に行き来できる、防人一族の新星だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470236
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470236,
					"content": "おっ、ついにオイラたちの出番みたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470237,
					"content": "今回オイラたちは飛ぶのが得意な防人で、いろんなところから「風の元素粒子」を集めるっぽいな。これなら楽勝だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470238,
						790470239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470238,
					"content": "定番の作業！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				},
				{
					"id": 790470240,
					"content": "では、二人とも頼んだぞ！今回の仕事は普段よりも疲れるかもしれん、追加の報酬を用意しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470241
					],
					"speakerTitle": "防人の長老"
				},
				{
					"id": 790470241,
					"content": "高所での作業は簡単なことじゃありません。どうか身の安全に気を付けてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470242
					],
					"speakerTitle": "奇跡の建築士"
				},
				{
					"id": 790470242,
					"content": "おう、心配いらないぜ。人の良い長老と誠実な建築士、この件はオイラたちに任せろ！おまえたちは町で気球の修理を進めててくれ、オイラたちは肝心の粒子を集めてくるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470243,
					"content": "#さっ、行こうぜ、{NICKNAME}。パパッとやればすぐに終わるはずだ！十分な「風の元素粒子」を見つけて、防人と一緒に町を守ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470239,
					"content": "慣れてる作業！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470240
					]
				}
			]
		},
