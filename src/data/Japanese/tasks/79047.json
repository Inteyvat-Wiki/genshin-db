					"nextDialogs": [
						790470432
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470432,
					"content": "これにて、防人一族を長く悩ませていた問題が、奇跡の建築士によって解決された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470433
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470433,
					"content": "この空の町は引き続き崖の防人一族が支えていき、地域全体に長期的な安寧と繁栄をもたらすだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470434
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470434,
					"content": "「セーブ·ザ·スカイタウン」これにて終幕——ご覧いただきありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470435
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470435,
					"content": "劇が終わったぞ、拍手拍手～！少しだけ円満じゃないところもあったけど、物語自体は悪くなかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470436,
					"content": "もしオイラが大商人だったら、きっと「ダイアの三日空想」に大金を投資するぞ。で、道具とセットをすべて一流のもので揃えて、この物語を完璧な形で表現させるだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470437,
						790470438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470437,
					"content": "機会があれば、一緒に検討しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
				{
					"id": 790470439,
					"content": "そうだな！近いうちに不思議なダイアと会えたらいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470438,
					"content": "このアトラクションの財務状況って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470439
					]
				},
				{
					"id": 790470415,
					"content": "予算がないのが一番の問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470416
					]
				}
			]
		},
