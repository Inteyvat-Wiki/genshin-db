				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790470701,
					"content": "ふん！これで悪事を働いたことを後悔したよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470702,
					"content": "覚えとけ！もう二度とこんなことするんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470703,
					"content": "いったい何が…さっきの三人、誰か知っていますか？「スーパー役者」が雇った役者でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470704
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470704,
					"content": "「エンジニア」は？「エンジニア」はもう海獣の手下の仕掛けを修理し終わりましたか？早く応急チームを連れて、現場の事後処理をやってください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470705
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470705,
					"content": "えっ？まだ放送中ですって？ああ、すみません！すぐオフにします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470706
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470706,
					"content": "今回はゲストが自力でこのトラブルをどうにかできて良かったです…もう二度とこんなミスを犯さないようにしませんと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470707
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790470707,
					"content": "幾多もの困難を乗り越え、「風の元素粒子」の収集作業はもうすぐ完了する。二人の防人は集中のあまり、半月ほど時間が経っていたことに気づいていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470708
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470708,
					"content": "その間、奇跡の建築士も完璧な仕事をしていた。限りある時間の中で、町の基礎内部にある気球を迅速に修理していく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470709
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790470709,
					"content": "スピーカーの向こうの声が…なんだか慌ててるみたいじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470710,
						790470711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470710,
					"content": "これも元々の設計？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470712
					]
				},
				{
					"id": 790470712,
					"content": "えっと、なにが起きたのかわからないけど、とりあえず気にしないでおこう！オイラたちは演劇を続けようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790470713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470713,
					"content": "傍白によると、設定ではもう「十数日」が経ったみたいだ。これで建築士が気球を修理するのを待たなくて済むな。今からあいつらと合流しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790470711,
					"content": "なんかアクシデントが起きてるのかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790470712
					]
				}
