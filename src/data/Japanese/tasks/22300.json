					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "おや、これはどこから手に入れたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001202,
					"content": "これは今じゃ玉京台でしか見られないと聞いたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001203,
					"content": "手が込んでるね。岩王帝君の話を聞くために、これも持ってくるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001204,
					"content": "この「琉璃百合」も璃月港の成立と関わっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001205,
					"content": "分からない？考えてみて、「琉璃百合」の特徴は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001206,
					"content": "そう、貴重である。「琉璃百合」は非常に貴重で、高く売れるからモラをいっぱい稼げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001207,
					"content": "「モラ」という名前は、岩王帝君のもう一つの名前「モラクス」が由来なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001208,
					"content": "だから、岩王帝君は「富の神様」でもある。業種を問わず、商売する前は必ず岩王帝君を参拝し、線香をお供えする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001209,
					"content": "なぜなら、岩王帝君は世の中で一番のお金持ちだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001210,
					"content": "きっと七神の中でも…岩王帝君は一番お金を持ってる神様だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
