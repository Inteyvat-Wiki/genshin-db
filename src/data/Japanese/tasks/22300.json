			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "これで大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "岩王帝君の参拝をしている。うーん、どうやら君はここの人じゃないみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000104,
					"content": "ここは倚岩殿、岩王帝君を参拝するところだ。縁起が良くなるように璃月の人はよくここに来て線香のお供えをする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000105,
					"content": "私の家はここから遠いから、そんなに来れないんだが、来れる時はなるべく長くいるようにしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000106,
					"content": "私も岩王帝君に関する書籍をたくさん読んできた。読めば読むほど岩王帝君は立派だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000107,
					"content": "璃月のために岩王帝君が成し遂げた偉業と比べて、私は参拝することしかできないから、大したことないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000108,
					"content": "そういえば、君は岩王帝君のことをよく知らないだろ？私が岩王帝君の偉業を教えてあげようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000109,
					"content": "でも、話すだけではきっと印象には残らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000110,
					"content": "うーん…こうしよう、<color=#00E1FFFF>璃月港付近</color>で何か物を持ってくるといい。それを使って、岩王帝君の話を教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000111,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "では、早く行ってくるといい。ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000113,
					"content": "どんなものがいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "<color=#00E1FFFF>璃月港</color>のもの、または<color=#00E1FFFF>岩王帝君に関する</color>もので大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000115,
					"content": "でも、私が知ってる話も限りがあるから…なんでも教えられるわけじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000116,
					"content": "戻ってきたらまた話そう。さあ、早く行くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
