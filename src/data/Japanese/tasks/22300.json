							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "これは郊外で取れたものかい？きっとたくさん苦労したんだね、ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001102,
					"content": "うーん…君も見ただろう、今の璃月港の規模はとても大きい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001103,
					"content": "でもどんなに大きい都市でも、細かい瓦で一枚一枚を積み重ねてできたものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001104,
					"content": "私たちの祖先がこの土地に来た時、「璃月港」なんてなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001105,
					"content": "彼らは汗と勇気で、ちょっとずつ開拓していき、この広い都市を建てたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001106,
					"content": "君も知ってると思うけど、璃月港の周りはごつごつした岩が多く、開拓はとても難しい。でもこの植物たちは岩の隙間で必死に生きている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001107,
					"content": "これらの植物は様々な用途があり、開拓者たちにとって大きな助けとなった。そしてそれは岩王帝君の恩恵だと考えられるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001108,
					"content": "先人たちの偉業はずっと璃月港に伝わっている。今でもこの話に感動する冒険者たちがいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001109,
					"content": "先人たちの強い開拓精神を継ぐ以外に、彼らは岩王帝君を「開拓の神」として敬う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001110,
					"content": "岩のように強くて不屈の精神を持つ冒険者になることは彼らの目標なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
