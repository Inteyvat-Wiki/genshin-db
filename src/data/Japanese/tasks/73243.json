			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "「…『ザンディク』に関する調査結果について…ダステア…死因…他殺の可能性がある…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431902,
					"content": "「…『ザンディク』…除名後…魔鱗病に対する…証拠が足りない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431903,
					"content": "「…記録が突然消え…年から…魔鱗病が伝染し始めた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431904,
					"content": "「…失踪する前…『ヴァルナ伝説』が…にこだわり…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431905,
					"content": "【以下の内容はひどく汚損され、意味のある文字は読み取れない。】",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "「偉大な賢者タバリの編纂した『星表』を読んだ後、やっと気づいた。魔神の戦争だの、古国の壊滅だの、すべては群星が大地に映し出した残影に過ぎない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732432002,
					"content": "「唯一永遠と言えるものは、我々の頭上にある星空しかない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732432003,
					"content": "「まあ…厳密な学術研究に付加された叙情的な要素はさておき、明論派の研究は何千年にも渡る過去と未来の歴史を混同して扱うというのか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732432004,
					"content": "「はぁ、一日中星を眺めてブツブツ呟くんじゃなく、もっと歴史の角度から問題を改める方法を学んでほしいんだけど。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732432005,
					"content": "「君に何が分かる！これは世界の法則を探究することだ。ヴァフマナが本の虫と言われるわけだな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
