					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "教令院関連のお知らせおよび内外の法令については、すでにアーカーシャ経由でお知らせすることにしました。この告知板は現在、教令院の者の課外活動の交流に使われているので、部外者は好き勝手にメッセージを残さないでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "「よりリラックスした学術環境のために、よりフレンドリーな学術交流のために、何より、みんなが笑顔で論文を書くために！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430202,
					"content": "「ヴィクラムが次のグランドキュレーターになることを支持する！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430203,
					"content": "「『ヴィクラム友の会』へようこそ。我々と共に、若くて民を大切にする個性的なグランドキュレーターの誕生を見届けよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "「教令院の三善と六罪を決して忘れてはいけない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430302,
					"content": "「忠言、創意、篤行。これらは学者が求めるべき美徳である。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430303,
					"content": "「そしてリファエットは、数十年にも渡ってこの三つを自ら実践し続けてきた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430304,
					"content": "「『三善読書サークル』へようこそ。知恵と共に歩み、未来のグランドキュレーターに同行しよう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "「『三善読書サークル』の成員たちよ、あなたたちの美徳に対する追求は尊敬に値する。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430402,
					"content": "「しかし聞いた話によると、リファエットの論文の半分は代筆によるものらしい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430403,
					"content": "「だから、彼は学術成果の多さにも関らず、これほど…慎ましいわけだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430404,
					"content": "「掲示板は論文のように十分な論拠を必要としないが、故にそれを使って他人を攻撃することもできない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430405,
					"content": "「上のコメントは、ただの嫉妬だ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430406,
					"content": "「それに、ヴィクラムは自分の弁舌の才能を、女性を誑かすのに浪費していると聞いた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430407,
					"content": "「口説かれた子は、彼が既婚者であることも知らないだろう。どうだ、彼の艶福に嫉妬しないか？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430408,
					"content": "「教令院の学者に対する不当な中傷は禁じられている。これ以上の違反があった場合は、マハマトラが噂の出所を調査することになる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "「この掲示板はアーカーシャ権限システムに編入されていないため、このまま閲覧できます。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430502,
					"content": "「知的安全への配慮を徹底し、本掲示板を通じた領域外での知的資源の交換は厳に慎んでください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "「学生たちは課外活動や教令院の外にいる時も、教令院の規律やルールを守るようご注意ください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430602,
					"content": "「知識の統一管理は『知恵の国』が存在する礎となります、些細な過ちで教令院で学ぶチャンスを棒に振らないよう気を付けてください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "「最近、缶詰知識の密輸事件が続発しています。詳細は調査が終わった後、次のジュニャーナガルバの日までに、アーカーシャを経由して関連する学院の学生や先生にお知らせいたします。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732430702,
					"content": "「各先生方におかれましても、学生が論文のストレスで自暴自棄にならないよう、適宜交流を深めてください。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
