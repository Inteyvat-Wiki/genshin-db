						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "「やっぱり商売は理論と知識だけではどうにもならない。あのとき、グランドバザールに残ってちゃんと商売を続けていればよかった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431502,
					"content": "「論文は書けておらず、モラも尽きた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431503,
					"content": "「どうしようもなくなったら、いっそのこと退学してエルマイト旅団に入ろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "「砂漠から来た連中に文句があるわけじゃないが、大マハマトラはやっぱり人望の厚い学者に任せるべきだ。特に学術的な問題は、ケンカで解決できるもんじゃないからな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431602,
					"content": "「ふん、君ら明論派が管理していた時よりはマシだ。少なくとも、特定の学派をひいきすることはないからな。当時、年次の発表率がどうなっていたか、知らないわけではないだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431603,
					"content": "「おい、妙論派め！証拠はあるのか？ないなら、マハマトラに聞かせるぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "「他国の留学生の受け入れだけならともかく、全ての外国人にアーカーシャを開放するとは…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431702,
					"content": "「外国人の頭がアーカーシャに何か悪影響をもたらすかもしれないし、避けられない知識の流出問題が、スメールの対外貿易経済にどれだけ影響を及ぼすかも分からない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431703,
					"content": "「学者が経済に関心を持つとは、珍しいな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431704,
					"content": "「だからお前たち知論派は世間知らずだと言われるんだ。俺は独力で漆器塗料が調合できるなら、学者になんかならなかった！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "「もう長い間、砂漠のチビの顔を見てないな。しばらくはのんびり過ごせそうだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431802,
					"content": "「あの風紀管理気取りがどうしてるかなんて知らんが、昨年度の試験で俺を不合格にしてくれたことは確かだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431803,
					"content": "「その試験、授業に出てれば余裕だったって聞いたぞ？自分の勉強不足を他人のせいにするとはな。最近マハマトラが人手不足とはいえ、でたらめを言うのは控えたほうがいいぞ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431804,
					"content": "「はぁ、マハマトラなんて所詮、うわべだけのもんだろうがよ…待った、アーカーシャからメッセージが…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431805,
					"content": "「みんな、気を付けた方がよさそうだな。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
