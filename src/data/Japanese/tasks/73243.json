						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "今週、レンジャー長のティナリ様がパルディスディアイで「植物学講座」を講演してくださいますので、ぜひご参加ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431302,
					"content": "植物に興味があればどなたでも参加可能です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431303,
					"content": "大変申し訳ありませんが、この講演への申し込みが予想を大きく上回ったため、知識管理の観点から出席者を生論派の生徒と、レンジャーのスタッフに限定することを教令院で協議し、決定しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "「八重堂の最新の小説を読んだ？今回はスメールの作者も掲載されているよ、確か…プルシナなんちゃら…だったかな。名前だけで生論派だと分かる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431402,
					"content": "「はぁ…あのときアムリタ学院に入学できていれば…毎日旅ができて、小説を書く暇もある。文献を読む以外は論文を書くことしかしないハルヴァタット学院とは大違いだ。こっちは実地調査すらできないんだから。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "伝言板"
				},
				{
					"id": 732431403,
					"content": "「なんだって？私よりも先に八重堂で小説を出版したやつがいるのか？そんな…私の娯楽小説研究者としての権威が…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伝言板"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
