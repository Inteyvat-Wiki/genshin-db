					"瀾陽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "こんにちは、何かご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320402,
					"content": "凝光の服を取りに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "あ、はい、お聞きしております。すぐにお持ちしますので、少々お待ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320404,
					"content": "長いこと待って、ようやく瀾陽が戻ってきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "こちらになります。凝光様にお渡しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320406,
					"content": "かなり時間が掛かってたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "ええ、この部屋には衣服だけでなく、あらゆる種類の工芸品や玉器など、収蔵品がたくさんあるんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320408,
					"content": "その上、最近は凝光様の意向で室内の配置換えを行っており、部屋が少々散らかっております。ですので、部屋の中を行き来するのも大変な状況でして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320409,
					"content": "（確かに収蔵品が多すぎる気がする…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "それでは、こちらの服はあなたにお任せしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320410,
					"content": "（これもお金持ち特有の悩みなのだろう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
