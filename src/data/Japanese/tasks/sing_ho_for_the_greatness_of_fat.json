					"スリキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "ふふ、なかなかやるわね。でも、あたしには及ばないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650702,
					"content": "あたしは長年このちょいポチャな体を維持しつつも鍛錬を続けてきたの。力と俊敏性で筋トレ狂ごときに負けるはずがないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650703,
					"content": "筋肉に執着しないで、あたしと一緒に偉大なる脂肪を称えましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スリキ"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
