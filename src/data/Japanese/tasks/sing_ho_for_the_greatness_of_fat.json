			},
			"dialogs": [
				{
					"id": 751650301,
					"content": "もうちょっと準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "構わないわ。準備ができたらまた来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スリキ"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イイマニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "通りすがりの勇士よ、そう、キミのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650402,
					"content": "うーん、痩せすぎだね…ちゃんとごはんは食べてるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650406,
					"content": "パイモンが全部食べちゃうから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "どんな事情があろうと、ご飯はちゃんと食べないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650408,
					"content": "テテオカンに入ったってことは、たぶん「豊穣の邦」の逞しい戦士たちに会ったことがあるんだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650409,
					"content": "親切心から忠告してあげるけど、やたらと筋肉ばかり推してくるやつらの言うことなんて、絶対に信じちゃダメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650410,
					"content": "脂肪は神様が僕たちに授けてくれた大切な贈り物なんだ。それなのに、見た目がいいからって筋肉のために美味しいものを断ち切って、脂肪を捨てるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650411,
					"content": "そんなのバカの極みさ。イノシシにすら同情されるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650412,
					"content": "それに、見た目がいいなんて言うけどさ、筋肉を崇める風潮なんて、せいぜいここ数十年のことじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650413,
					"content": "僕のおじいちゃんも言ってたよ。若い頃は、ぽっちゃり体型のほうが好まれてたってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650414,
					"content": "だから、誰になんと唆されようと、ダイエットなんていう間違った道には進んじゃダメだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650415,
					"content": "でも、いつかキミが「豊穣の邦」にいる僕の親戚たちのように、力を求めるためにダイエットを選ぶことになったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650416,
					"content": "どうか思い出してほしい。ちょいポチャの戦士は魚のように俊敏に動くことができるし、力に関しても細身の連中では相手にならないほど強いってことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650417,
					"content": "もし証拠が必要なら、この訓練場にある壺を見てごらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650418,
					"content": "僕のこの体型なら、<color=#00E1FFFF>壺を一つも割らずに素早く駆け抜ける</color>、なんてことも朝飯前さ。このレベルの敏捷さ、スリムなやつらにだって真似できないかもよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650419,
					"content": "笑いたいけど、遠慮して我慢してる顔だね…ま、構わないさ。すぐに信じてもらえないのは分かってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650420,
					"content": "さあ、挑戦してみなよ！キミの持てる最速でこの訓練場を駆け抜けてごらん。ただし、<color=#00E1FFFF>壺を割らないように注意</color>しながらね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650421,
					"content": "キミの記録がどれくらいのものか、僕を超えられるかどうか、見せてもらおうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650404,
					"content": "わぁ、ごちそうしてくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "そういう意味じゃないんだけどね…お腹が空いてるなら僕のバッグに焼いた肉が少し入ってるよ。でも、それは一旦置いといて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "イイマニ"
				}
			]
		},
