			"dialogs": [
				{
					"id": 751650901,
					"content": "イイマニ、また太ったわよね？おめでとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650902,
					"content": "あはは、ありがとうスリキ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650903,
					"content": "そういえばいい知らせだよ！この前、痩せているのにダイエットしようとしてる人がいて、また一人断念させることができたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650904,
					"content": "すごいじゃない、よくやったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650905,
					"content": "あら、あんた、最近ちゃんとご飯は食べてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650906,
					"content": "うん、いっぱい食べてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "いいことだ、たくさん食べな。ふっくらするぐらいがちょうどいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650910,
					"content": "イイマニ、この人、壺割りでかなりいい記録を出してるの。もう少しであたしの最高記録を破りそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650911,
					"content": "僕のところでも挑戦したことがあるけど、なかなかにいい成績だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650912,
					"content": "へえ、やるじゃない！あと少しであたしたち二人を超えそうだなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650913,
					"content": "もうちょっと太れば、本当に超えられちゃうかもしれないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650914,
					"content": "ええ、十分にあり得るわ。あたしからすればまだまだ細いし、太る余地はあると思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650915,
					"content": "とにかく、実力は認めるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650916,
					"content": "ああ、僕もだ！キミを認めるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650917,
					"content": "でも、やっぱり食事の量は増やしたほうがいいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650918,
					"content": "ええ、ダイエットなんてしたら、あたしたち、ガッカリしちゃうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650908,
					"content": "あんまり食べてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "ダメよ。ちゃんと食べることが一番大事なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "スリキ"
				}
			]
		},
