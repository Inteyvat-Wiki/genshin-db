			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イイマニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "なかなかいい記録じゃないか。でも、僕の自己ベストは超えられてないね。もちろん自慢がしたいわけじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650802,
					"content": "ま、人には誰しも得意なことが一つや二つあるものさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "イイマニ"
				},
				{
					"id": 751650803,
					"content": "どうだい、これで信じてくれたかな？僕みたいな体型の戦士だって、決して鈍いわけじゃないんだ。だから、ちゃんとご飯を食べること！無茶なダイエットなんてしちゃダメだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イイマニ"
				}
			]
		},
		{
			"id": 7516509,
