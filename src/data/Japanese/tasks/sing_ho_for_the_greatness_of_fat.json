			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スリキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "道行く勇士さん、あんたも力を求めてテテオカンに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650202,
					"content": "なら、「豊穣の邦」の逞しい戦士とやらにはもう会ったかな。まぁ、あたしに言わせればただの筋肉バカだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650203,
					"content": "あんたはスラッとしてるから、毎日ベンチプレスにかじりついてる筋トレ狂にはなってないみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650204,
					"content": "あんなの全部ウソだから、騙されちゃだめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650205,
					"content": "トレーニングが嫌いなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "嫌いってほどでもないけど、勇士の力が筋肉から生まれるとか、筋肉が万能みたいに言うのは違うと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650208,
					"content": "昔の英雄たちの体が、骨と筋肉だけで構成されてるわけないじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650209,
					"content": "今よりずっと過酷な環境を生き抜いていた英雄たちにとっては、生存と防衛こそが重要だったはず。なら当然、適度な脂肪も必要だったはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650210,
					"content": "だから、あたしの体形に近かったんじゃないかって思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650211,
					"content": "強い力と柔軟性を兼ね備えた、少しぽっちゃりぐらいの体形こそが、英雄にふさわしいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650212,
					"content": "なのに、部族の誰もわかってない。ほんとバカばっかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650213,
					"content": "その表情、あまり賛同できないみたいね…なら、こうしましょ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650214,
					"content": "あたしが用意した壺割りの試練に挑戦してみて！自分を鍛えるために作ったものだけど、あんたに貸してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650215,
					"content": "これをやれば、ぽっちゃり体型が実戦に向いてるってことがよく分かるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スリキ"
				},
				{
					"id": 751650206,
					"content": "筋肉が嫌いなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
