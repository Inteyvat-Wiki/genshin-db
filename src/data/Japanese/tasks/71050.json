			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "キノコを集めてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "うんうん、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500703,
					"content": "君が助けてくれたおかげで、俺の調査はまるで…璃月のことわざで何と言ったっけ…「まるでトラに翼をつけたように順調だ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500704,
					"content": "為虎添翼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "そうそう、まさに為虎添翼だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500706,
					"content": "このキノコは、なぜこんなことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500707,
					"content": "おかしいな、このキノコはスメールのとあるキノコとまったく同じなんだが、なぜ光るんだ？暗闇で生えているから蛍光色素が生じるのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500708,
					"content": "しかし、蛍光色素という進化ができたのに、なぜキノコの本体には何の変化もないのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500709,
					"content": "全然分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "うん…簡単に言えば、キノコは環境に適応するために進化していく。だがこの真菌は、明らかに森の中で生えるのに適している種なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500712,
					"content": "だから、この真菌がもともとスメールに生えていたものであることは間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500713,
					"content": "それじゃ光るって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "この真菌は層岩巨淵の在来種ではない。つまり、発光は進化の産物ではなく、異常な生態的影響による変異だということだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500715,
					"content": "空から落ちてきたあの欠片が、そのエネルギーを吸収したんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500716,
					"content": "欠片って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "コホン…ん？何だって？欠片？ああ、俺が言いたかったのは、真菌の欠片が空から落ちてきたとき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500719,
					"content": "偶発突然変異が起きたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500720,
					"content": "間違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500721,
					"content": "うん、これらのキノコを採集してくれてありがとう。お疲れさま、ゆっくり休んでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500722,
					"content": "俺はこれらのキノコをもう少し研究するが、傍に人がいると気が散るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500717,
					"content": "何の欠片？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "何か問題でもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}