			"dialogs": [
				{
					"id": 710500401,
					"content": "このキノコについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "さすが経験豊富な冒険者と言うべきかな、こんなに早く見つけるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500403,
					"content": "ん？これはここで採集したキノコなのか？これはおかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500404,
					"content": "地下じゃキノコは生えないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "生えるか生えないかという問題ではないんだがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500406,
					"content": "この菌はスメールに生えているとある菌に似ている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500407,
					"content": "でも一種だけじゃ足りないな…十分なサンプルがあれば、何か分かるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500408,
					"content": "ふむ、十分なサンプル…これを持ってきてくれた君なら、他のキノコがどこにあるかもきっと知っているはずだね。どうだい、採集してくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500409,
					"content": "十分なキノコを採集してきてくれたら、報酬にそれなりのモラを支払うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500410,
					"content": "キノコを何本集めれば十分なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "うん…そうだな、じゃあとりあえず、8本ほど採集してきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500412,
					"content": "心配せずとも、持ってきてくれたら、報酬は弾むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105003",
							"2"
						],
						"stepId": 7105003,
						"stateName": "QUEST_STATE_UNFINISHED"
