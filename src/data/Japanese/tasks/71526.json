			"dialogs": [
				{
					"id": 716663001,
					"content": "オニカブトムシも…犬や猫のように友だちになれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "「恐怖の猫爪草」"
				},
				{
					"id": 716663002,
					"content": "またちびっこを呼んできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663003,
					"content": "みたいだな。でも「花角玉将」も幼いし、前回はもう一人小さい子どもがいたのを覚えてるぞ。虫相撲と年齢は全然関係ないっぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663004,
					"content": "こちらの… 「恐怖の猫爪草」選手に虫相撲の経験は無いが、彼女のオニカブトムシからはとてつもなく強い気迫が溢れ出ているんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716663005,
					"content": "何言ってるかわからないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "「恐怖の猫爪草」"
				},
				{
					"id": 716663006,
					"content": "チャンチャンのオニカブトムシは、父ちゃんがこの前持って帰ってきてくれた贈り物。旅の途中で知り合った友だちがくれたんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "「恐怖の猫爪草」"
				},
				{
					"id": 716663007,
					"content": "おお、お前の父ちゃんは玄人のようだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663008,
					"content": "じゃあこっちは「空を翔ける白鉄チビ助」を出陣させよう。俺様が相手だといじめみたいになっちまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663009,
					"content": "ふん！オイラが一番弱いやつみたいに言いやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663010,
					"content": "でも、おまえらみたいな周りの見えてない虫相撲野郎は力の加減がわからなそうだし、オイラがやるのが良さそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663011,
					"content": "緊張すんなよ！ただの遊びだし、楽しもうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
