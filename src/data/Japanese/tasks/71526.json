			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "ふぅ…なんとかなったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663102,
					"content": "お、驚いた！確かに激しい気迫だったな。俺様が相手してもきっと苦戦しただろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663103,
					"content": "璃月の虫相撲の強者はみんな鬼才なのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716663104,
					"content": "オニカブトムシ同士はこうやって遊ぶんだ？チャンチャン、完全に理解したよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "「恐怖の猫爪草」"
				},
				{
					"id": 716663105,
					"content": "時間があったら、あと何回かチャンチャンと遊んでくれない？みんなが遊んでるのを見て、ちゃんと勉強する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "「恐怖の猫爪草」"
				},
				{
					"id": 716663106,
					"content": "どうやら… 「恐怖の猫爪草」にはとんでもない才能があるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663107,
					"content": "牛使い野郎にもこんな才能があれば、グゥオパァーと「水晶島バンバン旋風」のやり取りを聞くだけで、甲羅生物とのコミュニケーション方法を理解できたのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716663108,
					"content": "ガッ…ハハハハッ…俺様もそれぐらい強くなりたいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
