						],
						"pointId": 340100229
					},
					{
						"sceneId": 3,
						"position": [
							3606.78,
							428.202,
							4584.271
						],
						"pointId": 340100230
					},
					{
						"sceneId": 3,
						"position": [
							3606.759,
							428.202,
							4583.423
						],
						"pointId": 340100231
					}
				]
			},
			"dialogs": [
				{
					"id": 746700101,
					"content": "まだ改善の余地があるね…圧力の具合がよくない。材料は同じなのに、加工方法が違うからか？閉塞鍛造と密閉鍛造と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700102
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700102,
					"content": "となると、先に圧力を設定すれば…いや、加工方法に応じて自動調整するシステムを作るべきだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700103
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700103,
					"content": "へえ、近くで見ても不思議だな。こんな風に「カーンカーン」って自動で鉄を打つ機械があったら、鍛冶職人なんか要らなくなっちゃうんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700104,
					"content": "ハハッ、この機械は「職人いらず」と言えるほど、まだ賢くないんだよ。使うたびに細かい調整が必要だし、後の焼入れや研磨作業は人手に頼ってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700105
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700105,
					"content": "でもいつか絶対、こいつを全自動の鍛造機械にしてみせるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700106
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700106,
					"content": "どうだい、何か鍛造を依頼したいものはあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700107
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700107,
					"content": "オートスミスの性能次第だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700108
					]
				},
				{
					"id": 746700108,
					"content": "そこまで言うなら、腕前を披露しようじゃないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700109
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700109,
					"content": "ん？おまえってここのオーナーってだけじゃなくて、鍛冶職人でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700110,
					"content": "ああ、アタシはここのオーナー兼、鍛冶職人さ。見た目によらず、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700111
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700111,
					"content": "そりゃあ初対面の人はみんなびっくりされるけど。「普通の人より痩せてるし、腕もムキムキじゃないのに」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700112
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700112,
					"content": "うんうん、そんなやつにホントに鍛冶職人なんてできるのかよって…あ、そんな風に思ってなかったのに、ついおまえの話に釣られちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700113,
					"content": "あははっ、いいんだって。なにを隠そう、ガリガリのアタシに鍛冶職人が務まるのは、この機械のおかげさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700114
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700114,
					"content": "人類は道具を使える。緻密に設計された道具が、不可能を可能に変えるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700115
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700115,
					"content": "機械には職人の魂がないっていうけど、アタシからすれば機械もハンマーも道具に違いない。そんな風に言うなら、素手で叩いてみろって話だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700116
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700116,
					"content": "おっと、話が逸れたね。よし、今から切れ味抜群の剣を作ってみせてやる…あ、でも材料が足りないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700117
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700117,
					"content": "あちゃー、テストで材料を使いすぎたな。どうしよっかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700118
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700118,
					"content": "わかったぞ！次は謎のおっきなレバーを動かすんだろ。そしたら鍛造機が「ゴゴゴッ」ってクロックワーク·マシナリーになって、自分で材料を探しに行くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700119,
					"content": "うーん…自動で材料を探す機能は、確かに必要だよな。材料の識別はどうする？表面の反射光で材質を判断するとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700120
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700120,
					"content": "エスタブレ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700121,
					"content": "あ、悪い。ぼーっとしてた。オートスミスは鍛造をするだけの機械だから、変形して歩くのは無理だ。材料は誰かに持ってきてもらわなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700122
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700122,
					"content": "そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700123,
					"content": "そうそう、あんたらも色んな材料を手に入れたら、ここに持ってきてくれ。テストしながら機械の調整をしてると、材料がいくらあっても足りなくってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700124
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700124,
					"content": "お礼に…工房の製品設計図をあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700125,
						746700126
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700125,
					"content": "企業秘密のにおいがする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				},
				{
					"id": 746700127,
					"content": "なんつうかさ。アタシにとっちゃ、大事なのは鍛造した「製品」じゃなくて、鍛造の「道具」なんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700128
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700128,
					"content": "オートスミスを色んな材料に触れさせて、データを集める。そうすりゃ、もっといい製品を作るのに役立つ。設計図の重要性は二の次だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700129
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700129,
					"content": "だから鍛造用の素材だけじゃなくて、材料になりそうなものを見つけたら、どんどん持ってきてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700130
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700130,
					"content": "うーん、妙な設計図をオイラたちに押し付けて、今度来たら店は空っぽで、人もオートスミスも一緒に消えてたりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700131,
					"content": "まさか。これは長期的な提携と考えてほしい。そういう関係だと、信頼が一番大事だろ。設計図の質はアタシが保証する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700132
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700132,
					"content": "それにアタシは逃げられても、オートスミスに足を生やすのは難しいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700133
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700133,
					"content": "それもそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746700134,
						746700135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746700134,
					"content": "じゃあこれで決まり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700136,
					"content": "お互い気持ちよく仕事ができるといいね。うん、どんな材料を持ってきてくれるか楽しみにしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 746700135,
					"content": "今後ともよろしく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700136
					]
				},
				{
					"id": 746700126,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746700127
					]
				}
			]
		}
	]
}