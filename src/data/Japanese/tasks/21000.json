			"dialogs": [
				{
					"id": 210000201,
					"content": "もう碧水川に着いたの？ん…じゃあ、いい場所を探して漂流瓶を流そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000202,
					"content": "漂流瓶をより遠くに流すなら、上流からじゃないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				}
			]
		},
