					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000705
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000705,
					"content": "#それじゃ、ボクは家に帰るね。またね、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
