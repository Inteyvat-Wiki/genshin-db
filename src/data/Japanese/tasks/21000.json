				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "よかった…昨日徹夜して書いたんだ。もし失くしてたら、書き直さないといけないところだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000502,
					"content": "ええ…徹夜して書くなんて、そんなにたくさん悩みを抱えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000503,
					"content": "そ…そういうわけじゃないよ。ボクはただ、どうすれば大人になれるのか知りたいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000504,
					"content": "資料をたくさん調べて、本もたくさん読んだ。でも、読めば読むほど、分からないことが増えていった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000505,
					"content": "へへ、だから、分からないことを全部書いたの。答えが返ってくるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000506,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、早く漂流瓶を流そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				}
			]
		},
