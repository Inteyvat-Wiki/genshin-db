					"モン",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "はぁ、ボクなんかにできるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000102,
					"content": "モン、どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、君か…どうも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000104,
					"content": "モン、なんだか機嫌が悪そうだな。どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000105,
					"content": "なにかあったのか？やつらがその…海賊ごっこの相手をしてくれないとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000106,
					"content": "え？違うよ、ルルと飛くんは家に帰ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000107,
					"content": "ボクは…外で一人になりたくて、家に帰らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000108,
					"content": "家族が心配するんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000109,
					"content": "この時間、父と母はまだ仕事で、家には帰らないはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000110,
					"content": "#それより、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、一つ聞いてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000111,
					"content": "何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、たくさんの人から君の話を聞くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000115,
					"content": "君は色んなところに行ったことがあるらしいし、たくさんのことも経験したでしょ…君なら、この問題に答えてくれるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000116,
					"content": "おっ…急に真剣な顔になったな。いったい、どんな問題なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000117,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ボク、聞きたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000118,
					"content": "人はどうすれば「大人」になれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000119,
					"content": "大人になるには時間がかかる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "それって、大きくなったら、人は自然に大人になれるって意味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000121,
					"content": "でも、大きくなってからしか大人になれないなんて、ちょっと遅すぎるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000124,
					"content": "そうだな…街を出てみたいのなら、オイラたちが付き添ってやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000125,
					"content": "それは君たちに迷惑をかけちゃうよ。それに…ただ街を出るだけじゃ、特別な収穫はないと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000126,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、もう一つお願いがあるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000127,
					"content": "消えない悩みがあるなら、それを書いたものを漂流瓶に入れて、悩みを川に流すといいって話を聞いたことがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000128,
					"content": "それをやれば、気が晴れるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000129,
					"content": "でも、外には魔物がたくさんいるって聞いたから、ボク一人で行くのは危ないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000130,
					"content": "#だから、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、守ってくれないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000131,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。ボク、貯めたモラを全部報酬で払うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000134,
					"content": "それじゃ、出発しよう。まずは碧水川に行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210000132,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "特別なことを経験する必要がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "特別な経験か…でもボク、璃月港を出たこともないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000112,
					"content": "今遊びに付き合ってる暇はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "ははは、あれはルルと飛くんに付き合ってるだけだよ。二人がいないなら、ボクもわざわざ遊ばないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "モン"
				}
			]
		},
