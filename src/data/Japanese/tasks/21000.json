			"dialogs": [
				{
					"id": 210000601,
					"content": "#ここなら漂流瓶を流すのによさそう。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ここから漂流瓶を流そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000602
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000602,
					"content": "ボクが答えを得られますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000603
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000603,
					"content": "きっと大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000604
					]
				},
				{
					"id": 210000604,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、港に戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000605
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210000605,
					"content": "でも、漂流瓶を流しただけで、モンの問題は解決するのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000606,
					"content": "心の慰めが欲しいだけかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000607
					]
				},
				{
					"id": 210000607,
					"content": "え…そうなのか？なんだかモンはオイラたちに言っていない悩みもたくさん抱えてるみたいだったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210000608,
					"content": "「どうすれば大人になれる」って、本当に難しい問題だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
