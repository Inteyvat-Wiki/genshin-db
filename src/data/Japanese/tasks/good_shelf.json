			"dialogs": [
				{
					"id": 790730101,
					"content": "いらっしゃいませ！お客様、「祝福の森」へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730102
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730102,
					"content": "こちらには森を旅しにいらっしゃったんですか？それとも雨歌の池で行われるジャンプコンテストにご参加ですか？どちらにしても、楽しいひと時を過ごせますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュティ"
				}
			]
		},
		{
			"id": 7907303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730301,
					"content": "旅に支障が出ないよう、神出鬼没の巨龍は避けて通ってくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730302
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730302,
					"content": "はぁ、あの龍に棚を吹き飛ばされないように、「紙模型」を贈って機嫌をとろうと思っていたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730303
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730303,
					"content": "どうやら、あの龍は私の声があまり好きじゃないようで、毎回目もくれないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュティ"
				}
			]
		},
		{
			"id": 7907304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730401,
					"content": "今は突然巨龍に遭遇する心配もありませんし、いいところに来てくださいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730402
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730402,
					"content": "あの龍も、すっかり機嫌がよくなったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730403
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730403,
					"content": "なので、「紙模型」を持って彼を訪ねる予定です。気に入ってくれるといいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュティ"
				}
			]
		},
		{
			"id": 7907305,
			"completionStepIds": [
				7907301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730501,
					"content": "ああ、そうだ！私のとっておきの作品をご紹介するのを忘れていました。この素晴らしい棚も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730502
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730502,
					"content": "こちらの「抽選ボックス」をご覧ください！私がこれまでに作ってきた紙模型が全部この中に入っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730503
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730503,
					"content": "このボックスを作るために、世界中を歩き回りました…正確には「跳び回り」ましたが、新たな友人にも多く出会いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730504
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730504,
					"content": "風域で私に飛行テストを受けさせようとしてくるモモンガのクランシェ、私と同じで模型作りが好きなデヴィット…それから、いつも真剣な顔のエロフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730505
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730505,
					"content": "みんなとても優しくて、紙模型のモデルになってほしい、それをみんなに紹介させてほしいと言ったら快く承諾してくれました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730506
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730506,
					"content": "どうぞ、こちらの「星旅コイン」は私からのプレゼントです。「星旅コイン」を「抽選ボックス」に入れてレバーを引くと、露からの贈り物を受け取れますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730507
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730507,
					"content": "コインを使い終わった後は、ご自身でコインを手に入れて「抽選ボックス」を回してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730508
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730508,
					"content": "どうやって手に入れるかは…ふふふ…私の友人たちに聞いてみてください。きっとアドバイスをくれると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730509
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730509,
					"content": "贈り物を受け取ったら、後ろにある「立派な棚」に飾ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730510
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730510,
					"content": "実はこの棚こそ、私が「抽選ボックス」と「紙模型」を作ったきっかけなんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730511
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730511,
					"content": "詳しくはとある物語と関係しているのですが…お望みなら、あとで聞かせて差し上げますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730512
					],
					"speakerTitle": "シュティ"
				},
				{
					"id": 790730512,
					"content": "さあ、どうぞ「抽選ボックス」を回してください。求めていた贈り物が届きますように。そして、良い一日を過ごせますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュティ"
				}
			]
		}
	]
}