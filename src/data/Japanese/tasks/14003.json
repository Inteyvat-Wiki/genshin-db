			"dialogs": [
				{
					"id": 140030101,
					"content": "ごめんね、シャルロットさん。今日は僕もリネットも忙しくて、取材はちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030102,
					"content": "さほどお時間は取らせませんから——どうかお願いします、リネさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030103,
					"content": "えっ、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030104,
					"content": "遅くまで怪盗マーテンのコラムを書いてて、今朝新聞に発表しようと思ってたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030105,
					"content": "——明け方急に情報が入ったの。なんと、セサルの婚約者だったジェマが、自分こそ真の怪盗マーテンだって警察隊に自首したそうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030106,
					"content": "もう認めたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030107,
					"content": "コホンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030108,
					"content": "あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030109,
					"content": "もう遅いよ、お兄ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140030110,
					"content": "ふふ…第一声が「もう認めたのか」ってことは、すでにあなたたちは真相を知ってたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030111,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030112,
					"content": "やっぱり私の予感は的中ね。何か、隠してるんでしょ？ジェマが自首したわけは…昨晩のリネさんのマジックショーと関わってるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030113,
					"content": "高所脱出マジックを観たジェマさんは、セサルさんと過ごした日々を思い出して、良心が痛んだんじゃないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030114,
					"content": "なるほど——って、そんなはずありません。そう簡単に良心が痛むなら、この十年間、彼女は一体何をしてたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030115,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030116,
					"content": "（シャルロットの記者魂がメラメラ燃え盛っちゃってるみたい。何とか注意を引かないと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "そういえば！昨日のマジックショーの後、あなたたちもジェマもいなくなりましたよね…まさかあの時に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030118,
					"content": "突然ですが、聞かせてもらえますか。ショーの後、あなたたちはどこへ行ってたんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030119,
					"content": "ショーの後？オイラたちとリネは墓地に行ったんだぞ。リネがオイラたちにだけ、マジックを見せてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030120,
					"content": "そういやおまえの話のおかげか、リネはマジックで「レインボーローズ」を使うようになってたよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030121,
					"content": "コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030122,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140030123,
					"content": "私だってお兄ちゃんからレインボーローズをもらった記憶はないのに。つまりお兄ちゃんは、私より旅人たちのほうが大事なの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140030124,
					"content": "それは違う！あれは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030125,
					"content": "なな、なんでおまえまでそんな反応するんだ？オイラまたマズイこと言っちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030126,
					"content": "変な空気になっちゃったぞ…旅人、オイラたちどうすればいいんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030127,
					"content": "はぁ、どうやら今日は取材できる感じじゃないみたい。まあいいか、また今度来るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030128,
					"content": "しつこくしてごめんなさいね。でもこんなにインパクトのあるニュース、放っておくわけにはいかないわ！ジェマの情報が広がって、世の中は大騒ぎよ。この裏にある真実を必ずつきとめて見せる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030129,
					"content": "彼女は警察隊にこう伝えたらしいわ——「最後の願いは、もう一度ロレンツォに会うことよ」って。はぁ…複雑な関係よね。とっても気になっちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030130,
					"content": "とりあえずお先に失礼するわね。ごゆっくり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140030131,
					"content": "えっと、リネット、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030132,
					"content": "大丈夫、別に怒ってない。彼女の注意をひきたかっただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140030133,
					"content": "なるほど…オイラびっくりしちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140030134,
					"content": "ふぅ、僕も危うく騙されるところだったよ…幸い効果はてきめんだったね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140030135,
					"content": "…レインボーローズ、大切にして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140030136,
					"content": "失くしちゃったら、私も悲しくなるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネット"
				}
			]
		}
	]
}