			},
			"dialogs": [
				{
					"id": 30080801,
					"content": "結局、既視感については、まだ心当たりないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080802,
					"content": "もしかして、ただ疲れてるだけなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080803,
						30080804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080803,
					"content": "確かになんだか頭がくらくらする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080805
					]
				},
				{
					"id": 30080805,
					"content": "実はオイラも同じ感じがするんだ。だから、もう昼あたりから考えるのをやめてたぜ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080806,
					"content": "疲れて幻覚を見たってことにして、とにかく早く休もうぜ。他のことは、また明日考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080807,
					"content": "「ピ——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080808,
					"content": "…知能出力がわずかに低下。だが、正常範囲内にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080809
					],
					"speakerTitle": "カジェ"
				},
				{
					"id": 30080809,
					"content": "原因を早急に解明するため、引き続き数値を観測せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザール"
				},
				{
					"id": 30080804,
					"content": "あまり頭は使ってないのに、疲れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080805
					]
				}
			]
		},
