			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドニアザード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080101,
					"content": "おはよう、ドニアザード。遅くなってごめんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080102,
					"content": "そんなことないわ、私が早く来ちゃっただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080103
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080103,
					"content": "なんだか少し元気ないみたいだけど…よく眠れなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080104,
					"content": "ううん、心配しないで、私なら大丈夫。まずはあそこの屋台に行ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080105
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080105,
					"content": "おう…っておい、なにボーっとしてんだよ？早く行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 300802,
			"completionStepIds": [
				300802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300802",
							"2"
						],
						"stepId": 300802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドニアザード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080201,
					"content": "ここは…「ハフト·スィーン」で使う料理を売っている屋台ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080202
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080202,
					"content": "よく知ってるね。これを知ってる人は、もうだいぶ少なくなってきてると思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080203
					],
					"speakerTitle": "アマール"
				},
				{
					"id": 30080203,
					"content": "肉はないのか。うぅ、ちょっと残念…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080204,
					"content": "で、その「ハフト·スィーン」ってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080205,
					"content": "花神誕祭の伝統行事よ。人々はこれら料理を食卓に並べて、スメールの神が持つ七つの美徳を象徴しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080206,
						30080207
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080206,
					"content": "待って、さっきから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				},
				{
					"id": 30080208,
					"content": "…この粉塵からして、「月」のようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080209
					],
					"speakerTitle": "キミヤ"
				},
				{
					"id": 30080209,
					"content": "そうか？なんだか食べ物みたいに見えるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080210,
					"content": "えーっと…「月」が象徴するのは…ふむ…なんだったか、ちょっと待っててくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080211
					],
					"speakerTitle": "キミヤ"
				},
				{
					"id": 30080211,
					"content": "こいつ、こっそり本で調べてるな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080212,
					"content": "あっ、そうそう。これは「虚幻」と「嘘」を意味しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080213
					],
					"speakerTitle": "キミヤ"
				},
				{
					"id": 30080213,
					"content": "ただ、自分の直感を信じ、心の中の恐怖を克服すれば、太陽は必ずや昇るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080214,
						30080215
					],
					"speakerTitle": "キミヤ"
				},
				{
					"id": 30080214,
					"content": "聞いたことあるセリフだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080216,
					"content": "そう、参考になったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080217
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080217,
					"content": "ああ、いやいや…実は僕もまだ勉強中の身なんだ、は…ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080218
					],
					"speakerTitle": "キミヤ"
				},
				{
					"id": 30080218,
					"content": "なかなか面白かったな。よし、次の場所に行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080215,
					"content": "「既視感」ってやつかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080207,
					"content": "なんだか聞き覚えがあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				}
			]
		},
