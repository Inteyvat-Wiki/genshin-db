			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィハル",
					"ドニアザード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080401,
					"content": "ファーリス！ファーリス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080402
					],
					"speakerTitle": "パッチ"
				},
				{
					"id": 30080402,
					"content": "さあ、兵士たちよ、ご褒美のヤルダーキャンディをもらったら、クラクサナリデビ様に忠誠を誓って、解散ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080403
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080403,
					"content": "はい！ファーリス騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080404
					],
					"speakerTitle": "パッチ"
				},
				{
					"id": 30080404,
					"content": "なんだなんだ、今のってなにかの芝居か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080405,
					"content": "花の騎士ファーリスは花神誕祭のシンボルでね、子供たちに大人気なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080406
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30080406,
					"content": "ドニアザードさんの支援がなかったら、子供たちが花の騎士の私に会う機会もなかったでしょうね、はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080407
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080407,
					"content": "そうだ、ヤルダーキャンディはいかがです？箱の中に入っているので、どうぞお好きなのを選んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080408
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080408,
					"content": "選んで？これ、ぜんぶ同じものじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080409,
					"content": "はははっ、そこがこれの面白いところなんですよ。箱の中のキャンディは、味がランダムに入っています。スミレウリ味、夕暮れの実味、ハッラの実味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080410
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080410,
					"content": "おっ、たしかに面白そうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080411,
					"content": "…それから、トカゲのしっぽ味やオニカブトムシ味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080412
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080412,
					"content": "おい！なんだよその味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080413,
					"content": "えっと…ここはおまえが代わりに選んでくれ。オイラが欲しいのは夕暮れの実味だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30080414,
					"content": "はい、キャンディの箱は5つで、左から順に5つの数字が振ってありますが、どれにします？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080415,
						30080416,
						30080417,
						30080418,
						30080419
					],
					"speakerTitle": "ヴィハル"
				},
				{
					"id": 30080415,
