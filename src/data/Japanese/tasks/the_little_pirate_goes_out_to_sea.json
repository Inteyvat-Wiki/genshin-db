			"dialogs": [
				{
					"id": 210270201,
					"content": "旅人にモン？何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 210270202,
					"content": "#あっ？えっと…あの…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270203,
					"content": "厨房を貸してほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "厨房を貸すのはいいけど、どうして急に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 210270205,
					"content": "そういうことか…なるほどな、好きに使うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 210270206,
					"content": "モン、旅をしてるときは、好き嫌いをしてはいけないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 210270207,
					"content": "わ、分かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270208,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、それじゃあお願いね。美味しい料理の作り方を教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270209,
					"content": "父と旅行に行ったときに、サプライズしたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270210,
					"content": "オイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}、なにを作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
