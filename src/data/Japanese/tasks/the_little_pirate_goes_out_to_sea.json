					"モン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#ちょうどいいところに！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}を探してたところだったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270102,
					"content": "え？モン、何か用だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270103,
					"content": "ボクの悩みが入った漂流瓶を一緒に流してって頼んだこと、覚えてるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270104,
					"content": "正直、ボクそんなに期待はしてなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270105,
					"content": "でもこの間、父の取引先の一人から連絡があったらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270106,
					"content": "そのおじさんは、みんなでキノコの商売をしようと計画していて、スメールに調査しに行くんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270107,
					"content": "それで、彼らは父に一緒に行かないかって聞いてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270108,
					"content": "しかも…ボクを一緒に連れて行ってもいいって言うの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270109,
					"content": "父は初めは頷いてくれなかったけど…あるおじさんが、突然手紙を取り出して、父と二人で話をしたいって言い出してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270110,
					"content": "その話の後、父はボクもスメールについて来ていいって言ってくれたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270111,
					"content": "うーん、どうして急に父の気が変わったのかは分からない…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270112,
					"content": "#ボク、スメールに行けるんだ！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、スメール旅行だ！やったぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270113,
					"content": "おめでとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#きっとあの漂流瓶のおかげだよ。本当にありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270117,
					"content": "スメールに行った後、「翹英荘」ってところにも行かないとって父が言ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270118,
					"content": "翹英荘？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "うん、そこはお茶の村なんだって。茶の木がいっぱい植えられてて、お茶の質もすごくいいらしいよ。でも、名前はちょっと覚えにくいよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270120,
					"content": "まあとにかく！そこに行く前に、ボクたちはスメールに行けるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270121,
					"content": "スメールはここからすごく遠いから、着くまでにはきっと時間がかかるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270122,
					"content": "でも、道中色んなことが起こるから、旅に出発する前に色々準備する必要があるって聞いたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270123,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、君はずっと外を旅してるでしょ。ボクに旅での秘訣を教えてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270124,
					"content": "例えば…うーんと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270125,
					"content": "外で旅してるときって、何を食べるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270126,
					"content": "父は、みんな自分で料理を作って食べるって言った。でもボク、簡単な料理しかできない。しかも、美味しくできるかどうかも分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270127,
					"content": "#へへ、料理はオイラたちの得意分野だぞ。そうだよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270128,
					"content": "教えてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "まずはかまどを探さないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270131,
					"content": "そうだな…卯師匠のところに厨房を借りに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270132,
					"content": "卯師匠？うぅ、あのおじさんは怖そうなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210270133,
					"content": "卯師匠は怖くなんかないぞ！すごくいい人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210270134,
					"content": "そ、そうなの？でも父と食事をするとき、ボクが清心だけをよけて食べないたびに、あの人は眉をひそめるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210270129,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}もスメールに行くかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "本当？それじゃ、スメールで会おうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "モン"
				}
			]
		},
