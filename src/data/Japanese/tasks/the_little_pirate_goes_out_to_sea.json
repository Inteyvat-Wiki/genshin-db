			},
			"dialogs": [
				{
					"id": 210270401,
					"content": "満足サラダ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270402
					]
				},
				{
					"id": 210270402,
					"content": "その料理なら確かに簡単だぞ。味もなかなかいいしな。",
					"roleType": "TALK_ROLE_NPC",
