			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "仙人の使いよ、ありがとう！俺の兄弟を助けくれて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080602,
					"content": "仙人を見たことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "うん？ああ…俺らも噂程度には聞いたことがある、この琥牢山は仙人の敷地だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080604,
					"content": "でも俺らみたいな凡人が仙人に会うなんて、夢のまた夢だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080605,
					"content": "ただ尊き仙人の使いのあなたなら、きっと俺らとは違うはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080606,
					"content": "おっと、これ以上仙人の敷地でうるさくしてはいけないな。俺らは帰ることにする。本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080607,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10080608,
					"content": "…オイラたち、本当に「仙人の使い」だったらいいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080609,
					"content": "なんか、ここの仙人は気性が荒そうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080610,
					"content": "でも、オイラたちは悪いことしてないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10089601,
					"content": "山門を荒らし、賊人を逃したか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10089602,
					"content": "我が戒めをその身に受けよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水畳山真君"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"理水畳山真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "「琥牢山」に侵入し、山の琥珀を破壊し、さらに戒めを受けさせた賊人を勝手に逃すとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080702,
					"content": "あの賊人どもは、確かに仙威を知らぬかもしれない。だがお前たちがやってきたことは無礼千万。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080703,
					"content": "ひゃうっ！オ、オイラたちにもちゃんと理由があったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080704,
					"content": "これを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "…「禁忌滅却の札」か、これがまだ世に残っていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080708,
					"content": "ほう？これは「禁忌滅却の札」か？まだ世に残っていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080709,
					"content": "昔、帝君がこの神札を作り、人間に授けた。元々数が少なく、千年を経た今ではもうほとんど存在しないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080710,
					"content": "まずは詳しい事情を聞かせてみよ、後々その事実を確認させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080711,
					"content": "璃月港は手が届かぬ場所ではない、虚言は通じぬからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080712,
					"content": "帝君が…暗殺された、だと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080713,
					"content": "しかも、「迎仙儀式」の最中に！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080714,
					"content": "璃月の…いや、この世界の誰がそのようなことを！待て…帝君を暗殺できる者など、この世にそういるだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080715,
					"content": "我らは帝君の律令に従い、璃月を守っている。人間界の繁栄により、我々は山野に住むようになった。これは人間を思ってのことであったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080716,
					"content": "だが今…帝君は…帝君は…ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080717,
					"content": "旅人よ、話は分かった。削月築陽真君が招へいした理由も分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080718,
					"content": "この山の雑事を処理したら、ほかの仙人たちに会いに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080719,
					"content": "そう言えば、ここの琥珀って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "知ってるぞ！あれは仙人の仙力だろ！小説とかに書いてあるみたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080721,
					"content": "羽根を草木に、唾液を滝にって感じで、あの琥珀もきっと同じ原理なんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080722,
					"content": "「燕の巣」みたいな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "…そのような話は知らんが、これら琥珀は私が植えた花だ。名を「踱山葵」という。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080725,
					"content": "この花の大部分は地中に埋まっている、これを踏むと琥珀が産み出され、侵入者を閉じ込める仕組みになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080726,
					"content": "ここに隠居して以来、山の静寂を求めるためにこの花を至るところに植えた。おかげでここ数年で侵入者を数多く排除してくれている。だが、たまに珍妙なものを閉じ込めることがあるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080727,
					"content": "じゃあ、この「琥珀」って…生きてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080728,
					"content": "その通り。もし私が軽率にこの山を離れれば、罪のない命まで傷つけてしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080729,
					"content": "それらの処理を済ませたら発つ。お前はもう行くがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10080723,
					"content": "…うっ、ちょっと気持ち悪い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "削月築陽真君に言われてここに来た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "削月築陽真君が…人間に言付けを頼んだ、だと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "理水畳山真君"
				}
			]
		},
