			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "仙人様、お助けください！お願いします…俺ら兄弟に慈悲を！仙人様、どうか…どうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080202,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "お、お前は…誰だ？どこから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080204,
					"content": "こっちが聞いてるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080205,
					"content": "あっ！この絶雲の間を安全に行き来できるってことは…なるほど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080206,
					"content": "あなたは…きっと仙人の使いなのだな！俺ら兄弟を助けるため仙人様が遣わせた使者なのだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080207,
					"content": "ちょっと、この人なに言ってるか分かんない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080208,
					"content": "慈悲深き仙人の使いよ！どうか助けてほしい！俺ら兄弟は貧困に苦しんでいただけなんだ。だから、琥牢山の琥珀に宝があるって話を聞いて魔が差してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080209,
					"content": "琥珀から掘り出した宝を売って、家計の足しにしようと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080210,
					"content": "だが、宝を探すため<color=#00E1FFFF>山道に沿って</color>登っていたら、俺の兄弟が琥珀に…喰われてしまったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080211,
					"content": "もう怖くて恐くて、俺は一目散にここまで逃げてきた。今になって考えると、仙人様の敷地に侵入してしまい、それで天罰を受けたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080212,
					"content": "兄弟を助けたいが、どうしたらいいのか分からなかった。だから、ここでひたすら仙人に許しを乞おうと。そしたら、二人の仙人の使いが来てくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080213,
					"content": "オイラたちは仙人の使いじゃないぞ、オイラたちも仙人を訪ねに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080214,
					"content": "いや、いやいや、違いない！きっとあなたたちは仙人の使いだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080215,
					"content": "李当が閉じ込められた琥珀はこの山のどこかにある。慈悲深き仙人の使いよ！どうか助け出してほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080216,
					"content": "分かった…探してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "お、おお！慈悲深き仙人の使いよ、感謝いたします！もう二度とこんなことはしないと誓う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				},
				{
					"id": 10080218,
					"content": "今回は許そう。二度としないように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "うわ…役になりきってる、しかも随分と「仙人の使い」っぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080220,
					"content": "仙人の使いよ、感謝いたします！もう二度とこんなことはしないと誓う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李丁"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
