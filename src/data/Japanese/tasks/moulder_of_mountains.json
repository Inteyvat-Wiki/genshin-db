				"objectNames": [
					"李丁"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "兄弟から話は全部聞いた。本当にありがとう、俺の兄弟を助け出してくれたこと、感謝してもしきれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089702,
					"content": "ああ、俺らもこんなことをしたかったわけじゃないんだ。家計が苦しくて、仕方なかったんだよ。だから、琥牢山の琥珀に宝があるって話を聞いて魔が差してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089703,
					"content": "琥珀から掘り出した宝を売って、家計の足しにしようとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089704,
					"content": "結果は…見ての通り。俺は仙人から天罰を受けて琥珀に喰われてしまった。もし、あなた達の助けがなければ、一生出られなかったかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089706,
					"content": "せ、仙人の使い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "今回は許そう。二度としないように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "慈悲深き仙人様が二人の仙人の使いを遣わしてくれたおかげだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089707,
					"content": "ああ、さっき俺が山頂で仙人様に祈っていたらあなた達が現れた。そして俺の兄弟を救い出してくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089708,
					"content": "だから、あなた達はきっと仙人の使いなのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089710,
					"content": "うわ…役になりきってる、しかも随分と「仙人の使い」っぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10089711,
					"content": "あ、ああ、兄弟を救ってくれたこと感謝いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089712,
					"content": "仙人の使いが助けてくれたこと、一生忘れないようにする。この過ちを改めて、真っ当な手段でお金を稼ごうと思う。たとえ埠頭の力仕事をすることになっても構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089713,
					"content": "おっと、これ以上仙人の敷地でうるさくしてはいけないな。俺らは帰ることにする。本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "李丁"
				},
				{
					"id": 10089714,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "李当"
				},
				{
					"id": 10089715,
					"content": "…オイラたち、本当に「仙人の使い」だったらいいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080609,
					"content": "なんか、ここの仙人は気性が荒そうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10080610,
					"content": "でも、オイラたちは悪いことしてないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10089601,
					"content": "山門を荒らし、賊人を逃したか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 10089602,
					"content": "我が戒めをその身に受けよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "理水畳山真君"
				}
			]
