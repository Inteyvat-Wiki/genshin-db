			"trigger": {
				"objectNames": [
					"レクラード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "あの黄緑色の石…絶対に問題がある。このままじゃ、死んでしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320202,
					"content": "えっと…大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320203,
					"content": "俺は…長い目で見れば、えっと…俺たちはみんな大丈夫さ？ただ、俺が先に大丈夫になる…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320204,
					"content": "大丈夫だったらいっか。じゃあね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "いやいや、どう見ても大丈夫そうじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320208,
					"content": "いや、本当に何でもないんだ。もし何かあるとしても、きっともう手遅れさ、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320209,
					"content": "結局、どっちなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "頭がこんがらがってきたぞ。もうちょっとはっきり言ってくれないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320211,
					"content": "はっきりか…実は最近、生産エリアに来るたびに頭が割れるように痛くなって、手足も冷え、動悸が時々起こるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320212,
					"content": "あぁ…俺はもうおしまいだ！分かるか、おしまいなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320213,
					"content": "きっと、あの黄緑色の石のせいだ…あれはとんでもなく邪悪な石なのさ！知ってるだろ。フォンテーヌ科学院の中央実験室を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320214,
					"content": "全部あの黄緑色の石のせいだ。あれが何もかもダメにしたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320215,
					"content": "医者に行ったほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "俺自身が医者だから、一番よく分かってる！いや、今は医者じゃないか…資格がもうないからな、診察はできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320218,
					"content": "お、お願いだ。本物の医者を探してきてくれ。資格を持った医者を。助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320219,
					"content": "#うぅ、なんだか本当に重症みたいだな…{NICKNAME}、医者に聞いてみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320216,
					"content": "医務室で休んだら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "新しいレトリックかと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "その話し方、どう聞いても大丈夫そうじゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アーダーン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "何かお困りごとですか？それとも、他の誰かがお困りです？…見たところ、お二人とも血色は良さそうですし、おそらく他の方がお困りなのですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320302,
					"content": "そうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320303,
					"content": "レクラードの状況を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "また、彼ですか…昔からそうなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320305,
					"content": "まだ治せる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "頭痛のほうですか、それとも妄想のほうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320307,
					"content": "ん？つまり、たいした病気じゃないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320308,
					"content": "以前検査した結果から見ると、ほぼ問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320309,
					"content": "彼はここの外にいた時、誤診で初期症状を見逃したことがあるんです。そのせいで患者を…はぁ、とにかくそれ以来、彼は少し神経質になってしまったようでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320310,
					"content": "他人に対しても、そして自分に対しても。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320311,
					"content": "あの黄緑色の石に問題はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "あの人以外、みんな元気そうにしているでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320313,
					"content": "まあでも、ほっておくわけにもいきませんね。これを彼に渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320314,
					"content": "これって…「純潔の水」だよな？これで本当に治るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320315,
					"content": "おや、君たちも知っているのですね。大丈夫です。身体に害はありませんし、彼を元気にさせることもできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320316,
					"content": "彼は知らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "私の知る限り、彼はこういった飲み物を敬遠しています。以前、健康に良い薬という理由で、これを届けたことがあるんです。彼がこれを飲むと、体調は回復しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320322,
					"content": "そうなのか。だったら任せろ！これを届けてやるぜ。でも、それでもダメだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320323,
					"content": "その場合は、医務室で横になるように言ってあげてください。医師の指示だと言えば、彼は素直に聞いてくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320324,
					"content": "#おう、わかったぜ。じゃあ、あいつのところに戻ろうぜ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320318,
					"content": "なら、フォンタを飲んだほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "それは難しいですね。ここでは誰もがフォンタの味を知っていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320320,
					"content": "ですが私の知る限り、彼は「純潔の水」を飲んだことがありません。何しろ流通範囲がかなり限られていますからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "アーダーン"
				},
				{
					"id": 740320321,
					"content": "以前、健康に良い薬という理由で、これを届けたことがあるんです。彼がこれを飲むと、体調は回復しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "アーダーン"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403204",
							"2"
						],
						"stepId": 7403204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レクラード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "戻ったぞ～！医者がこれを渡すようにだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320402,
					"content": "レクラードは「純潔の水」を受け取り、一気に飲み干した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "おおっ、だいぶ良くなった！活力が戻ってきたようだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320404,
					"content": "もう治ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "効くのが早すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320408,
					"content": "アーダーン先生は、さすが資格を持った医者だけある。薬の効き目がなんと早いことか。それに比べて俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320409,
					"content": "なぁ、あの黄緑色の石だけどさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320410,
					"content": "あれこそ、問題の元凶だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320411,
					"content": "うーん…頭痛は治ったみたいだけど、もう一つの問題はまだ解決してないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740320412,
					"content": "まあ、これでひとまず仕事を続けることができる。医者のところまで行ってきてくれて、ありがとう。この特別許可券を受け取ってくれ。ほんの感謝の気持ちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320413,
					"content": "お前さんたちの健康を祈ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レクラード"
				},
				{
					"id": 740320406,
					"content": "本当は病気じゃないんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
