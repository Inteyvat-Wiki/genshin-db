			"dialogs": [
				{
					"id": 760510101,
					"content": "旅人、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510102,
					"content": "どうしたんだ、コロンビーナ？なにか面倒ごとにでも巻き込まれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510103,
					"content": "絵の具、持ってない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510104,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510105,
					"content": "あっ！お前は…メイラだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510106,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510107,
					"content": "なんで絵の具まみれになってるんだ？お絵描きでもしようとしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510108,
					"content": "いないと思ったら、こんな姿で帰って来たの。この絵の具、すぐには落ちないだろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510109,
					"content": "もしかして、出かけた先でなにかあったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510110,
					"content": "でも、芸術家っぽくて悪くないかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510111,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510112,
					"content": "あっ！絵の具なら、この前みたいに色が取れそうなものをあげればいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510113,
					"content": "～～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510114,
					"content": "へへっ、喜んでるな。いっぱい楽しいインスピレーションをゲットできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510115,
					"content": "じゃあ、今回は暖かい、楽しい色をメイラに渡してやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
