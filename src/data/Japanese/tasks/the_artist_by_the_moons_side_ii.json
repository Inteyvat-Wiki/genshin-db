			"dialogs": [
				{
					"id": 760510301,
					"content": "どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510302,
					"content": "～～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510303,
					"content": "おお！描き始めたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510304,
					"content": "コホン——天才画家メイラがどんな傑作を生み出してくれるのか、期待が高まります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510305,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510306,
					"content": "えっ！もうできたのか？まだ全然実況できてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510307,
					"content": "おお！今回もコロンビーナを描いたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510308,
					"content": "幸せそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "これは…ナド・クライの森の中か？動物がたくさんいるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510311,
					"content": "これは…たぶん、私が「霜月の子」を離れる前の絵だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510312,
					"content": "わぁ、うらやましいぞ！本当に動物たちがこんな風に寄ってきてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510313,
					"content": "うん。私はクーヴァキを放出してるから、そばにいると安心できるんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510314,
					"content": "へえ～！じゃあ、思う存分触っても逃げられないってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510315,
					"content": "うん…一番触り心地がいいのはモサモサアナグマかな。しっぽが大きくて、もふもふだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510316,
					"content": "ツノシカの首の毛もすごく柔らかいから、枕にすると気持ちいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510317,
					"content": "キミたちはどっちが好き？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510318,
					"content": "なんでオイラたちが触ったことある前提なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510319,
					"content": "でも、触れるとしたら…オイラはモサモサアナグマの尻尾がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510320,
					"content": "モサモサアナグマは人見知りな子が多いから、安全なところでじゃないと触らせてくれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510321,
					"content": "あっ…でも、パイモン、気をつけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510322,
					"content": "えっ？なんだなんだ？噛んできたりするのか？オ…オイラ、怒らせたりしないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510323,
					"content": "ううん、上に気をつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510324,
					"content": "上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510325,
					"content": "うん、長羽トキは体が小さい動物を捕まえるの。何度も釘をさしたから、月霊は捕まえないでいてくれるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510326,
					"content": "そういうのは初めて会ったときに言えよ！オイラが今日までさらわれてないのは奇跡だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510327,
					"content": "うーん…わかった。今度長羽トキに会ったとき、言っておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510328,
					"content": "い、今言ってきてくれよ。オイラ、怖くてここから出られないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510329,
					"content": "パイモンの事はどう伝えたらいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510330,
					"content": "最高の仲間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "そうそう、最高の仲間をさらうなんてダメだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510336,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760510337,
					"content": "この子…パイモンが長羽トキにさらわれる場面が描きたくなっちゃったみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760510338,
					"content": "そんな場面描かなくていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510332,
					"content": "最高のガイド。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "うっ…覚えててくれて嬉しいけど、長羽トキに「ガイド」なんて言ってもわからないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510334,
					"content": "食べるとお腹を壊すもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "オイラはそもそも食べものじゃないぞ！長羽トキが「へえ、食べてみよう」って思ったらどうするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760510309,
					"content": "楽しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
