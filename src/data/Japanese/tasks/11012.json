			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "さあ、ここが璃月の「おもちゃ研究所」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120102,
					"content": "着いた！中から機械の音が聞こえる、すごーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110120103,
					"content": "ここは一体、なんなんだ？なんでこんなとこ知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120104,
					"content": "前に資料で見たんだ。ここは「博士」の「おもちゃ研究所」ってところかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120105,
					"content": "「博士」はファデュイの「執行官」、古いものをいじるのが趣味でね…この遺跡は遺跡守衛を研究するために改造されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120106,
					"content": "えっ？遺跡守衛もファデュイが作ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120107,
					"content": "いや、あれは「アビス」の方に近いかな。だから我々の敵でもある…単に研究対象なだけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120108,
					"content": "近頃、遺跡守衛が出没する理由は…おそらく「博士」がここに飽きたからだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120109,
					"content": "またも性格の悪い執行官だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120110,
					"content": "テウセルをここに連れて来たのは、事前に調査して安全だって知ってたからだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120111,
					"content": "いや、実は…この「研究所」の中がどうなってるかは、全く分からないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120112,
					"content": "お、弟の安全をなんとも思わないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120113,
					"content": "まさか…危険があったら、俺が代わりに受け止めるよ——「弟」に傷一つつけさせないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120114,
					"content": "それにテウセルも戦う意味を理解するからね、この意味は何年も俺の心の重しになってきたわけだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120115,
					"content": "お兄ちゃんたち、何話してるの？早く案内してよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110120116,
					"content": "ハハッ、任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "君たちでよかったよ…怪我したまま「魔王武装」を使うのは、思ったより骨が折れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120202,
					"content": "さすがに、こんな格好悪い姿はテウセルに見せられない…ハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120203,
					"content": "…今なら簡単に始末できるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "ハハッ、君はそんなことしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120205,
					"content": "君のことは理解してる…君は弱ってる人間に手を出したりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120206,
					"content": "それにしても、まさかここまでやるとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120208,
					"content": "俺はただ…いかなる試練からも逃げないだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120209,
					"content": "これがこのタルタリヤが強くなる理由だからね、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120210,
					"content": "それに、子供の夢は壊れやすい。放っておいたら、知らないうちに壊れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120211,
					"content": "だから、守らないといけないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120212,
					"content": "約束したら守る、悪い事したら謝る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120213,
					"content": "与えた夢はちゃんと最後まで守る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120214,
					"content": "あいつは俺の大事な弟だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120215,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "どうした…何か君の思い出を蘇らせたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120217,
					"content": "ゲホゲホっ…くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120218,
					"content": "そんなに弱ってるのに格好つけるな、早く医者に行ったほうがいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120219,
					"content": "ハッ…いい案だね、でもその前に…これをテウセルに渡してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120220,
					"content": "これは…「独眼坊」の人形？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120221,
					"content": "ああ、鍛冶屋に作ってもらった。帰国後に渡す予定だったけど、今は旅の記念品としてちょうどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120222,
					"content": "わぁ…なんか、こいつの家族って幸せだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110120223,
					"content": "それと、俺が何も言わずに消えることへのフォローも、頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120224,
					"content": "手伝ってくれるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
