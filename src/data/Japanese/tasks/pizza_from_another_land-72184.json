			"dialogs": [
				{
					"id": 721840201,
					"content": "こんにちは、何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 721840202,
					"content": "「木南料亭」のピザについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "あっ、あのピザのことね、確かに美味しかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 721840204,
					"content": "でも…何と言うか、食べ慣れない味でもあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 721840205,
					"content": "個人的にね、ピザにスミレウリみたいな稲妻の特産を入れたらいいなって思うの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "梨絵"
				},
				{
					"id": 721840206,
					"content": "そうしたら、今よりもっと人気が出るかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梨絵"
				}
			]
		},
		{
			"id": 7218403,
			"completionStepIds": [
