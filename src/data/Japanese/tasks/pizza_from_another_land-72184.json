			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "おかえり、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840302,
					"content": "どう、聞いてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840303,
					"content": "お客さんの意見について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "スミレウリで作ったピザか…難しくはないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840305,
					"content": "他の材料はいつもの物でいいかな、いや、「稲妻の特産を合わせてほしい」んだし、他の材料も用意しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840306,
					"content": "ウミレイシ？鳴草？うん…ユウトウタケはどうかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840307,
					"content": "えっと、手助けは必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "あっ！ごめん、食材のことばかり考えてた！どうしよう…店のスミレウリの在庫が少ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840309,
					"content": "旅人、スミレウリを1個持ってきてくれる？材料が…それだけ足りない状況なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840310,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "うん、頼んだよ。スミレウリ1個でいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840312,
					"content": "他の食材はいらない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "他の材料は店に在庫があるはず、スミレウリ1個でいいよ、お願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
