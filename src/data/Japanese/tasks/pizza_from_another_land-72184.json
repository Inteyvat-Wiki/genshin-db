				},
				{
					"id": 721840502,
					"content": "稲妻の特産が入ったピザ、どんな味がするんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840503,
					"content": "完成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840504,
					"content": "このピザ…見た目はいい感じだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840505,
					"content": "手伝ってくれてありがとう、旅人。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840506,
					"content": "あとでこのピザをきちんと味わわせてもらうよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840507,
					"content": "いい感じだったら…新しい商品として発売できるね。",
					"roleType": "TALK_ROLE_NPC",
