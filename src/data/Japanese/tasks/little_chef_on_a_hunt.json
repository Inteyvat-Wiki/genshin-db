					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "シッ！静かに。今、狩りの最中なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000302,
					"content": "モンドには素敵な食材がたくさんあるって聞いたけど、本当にすごいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000303,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は…狩人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "ううん、アタシは料理人。各地を巡って、珍しい食材を探している料理人なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000306,
					"content": "名前は香菱、璃月港から来たの。あなたたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000307,
					"content": "#{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "オイラはパイモンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000309,
					"content": "パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000310,
					"content": "なんだよ？なんでオイラをじっと見てるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000311,
					"content": "変わった生き物だね。ねえ、これ食べられる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000312,
					"content": "パイモンは友達だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "残念、友達なら食べられないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000316,
					"content": "仲良しだね。実はアタシにもそういう友達がいてね、グゥオパァーっていうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000317,
					"content": "変わった名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000318,
					"content": "へへっ、かわいいでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000319,
					"content": "そうだ、よかったら狩りを手伝ってくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000320,
					"content": "ここって獲物がたくさんいるし、どれも最高の食材なんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000321,
					"content": "さすがにアタシ一人じゃ手が回らなくてね。でも、取り逃がしたくないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000322,
					"content": "えー、面倒だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000323,
					"content": "そんなこと言わないで、あとで美味しいものを食べさせてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000324,
					"content": "#えっ、美味しいもの？約束だぞ、{NICKNAME}はこういうの得意だからな、任せておけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000325,
					"content": "ちょろい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "あははっ、気にしない、気にしない。あなたの友達はもう約束してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000328,
					"content": "どんな方法でも構わないから、獣肉を持って来てほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000329,
					"content": "じゃあ、よろしくね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000326,
					"content": "こっちの意見を無視するな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "おいっ！オイラは食べられないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000304,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は…冒険者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
