			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "ここのイノシシ、肥えてて活きがいいから、きっと肉質も完璧だろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000402,
					"content": "ああ、言ってたらお腹が空いてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "わぁ、こんなにたくさん！これは焼いて、これはキノコと一緒に炒めて、あとの残りはスライムの液体と合わせてみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000502,
					"content": "一瞬で自分の世界に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "もうオイラたちのことは目に入ってないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000506,
					"content": "あっ、ごめんごめん。ついレシピのことに夢中になっちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000507,
					"content": "これは約束してた料理だよ。食べてみて！で、感想を聞かせて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000508,
					"content": "オイラたちのことを試食係だと思ってないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000509,
					"content": "おお！こ、これ…すっげーうまいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000510,
					"content": "どうやって作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000511,
					"content": "へへっ、もちろん教えてあげるよ！でも、まだレシピにまとめてないから、そうだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000512,
					"content": "こうしよう！アタシが今から作るから、あなたたちはそれを見て覚えるの。一回見たら、きっと覚えられるはずだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000513,
					"content": "こんな複雑そうな料理、一度見たくらいじゃ覚えられないって…それに道具も調味料もないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110000514,
					"content": "うん？それなら問題ないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000515,
					"content": "鉄板は平らな岩で代用して、油はさっき捕ったイノシシの油を使えば大丈夫。石でかまどを作ったら、木の枝や葉っぱで火を起こすの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000516,
					"content": "砂糖はスイートフラワー、塩は…この前、洞窟で岩塩をたくさん取ってきたから、数日分ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000517,
					"content": "な、慣れてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "えへへっ、レシピを思いついたらすぐに試したくなるんだけど、毎回調理器具を持ってるわけじゃないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000520,
					"content": "ちょっと待ってて、今すぐ準備するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000521,
					"content": "そこで何してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 110000601,
					"content": "ここはイノシシの生息地だが、狩猟禁止区域だよ！イノシシたちが驚いたらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 110000602,
					"content": "僕たち狩人は目先の利益だけを追い求めはしない、将来のこともちゃんと考えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 110000603,
					"content": "あっ…！そうだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000604,
					"content": "最適な環境だけが、最高の肉を生み出す！驚いてこの場所からいなくなっちゃったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000605,
					"content": "ダメダメ、そんなの美食界の…いや、全人類の損失だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000606,
					"content": "個性的な理解だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "ごめんね！まさか、いけないことだとは思わなかったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110000609,
					"content": "とにかく、ドゥラフさんのところに謝りに行った方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 110000610,
					"content": "彼は僕たち狩人のリーダーでね、ルールに厳しいからすごく怒ってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 110000611,
					"content": "どうしよう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
