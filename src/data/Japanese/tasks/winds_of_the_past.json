			"dialogs": [
				{
					"id": 3061001,
					"content": "ふぅ…疲れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061002,
					"content": "でも、これで少しはジンさんの役に立てたと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061003,
					"content": "以前なら、城内の安全を死守することはできた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061004,
					"content": "まあ、それもジンさんの力があればこそなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061005,
					"content": "でも今、風魔龍がモンド城内を直接襲うようなことがあったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061006,
					"content": "「風向きが変わったのなら、策も考えるべきよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061007,
					"content": "いい言葉だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "これはリサさんの口癖だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061010,
					"content": "そうだ、前に話した「四風守護」の話だけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061011,
					"content": "過去の歴史に興味があったら、リサさんに聞いてみるといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061012,
					"content": "…先に言っておくけど、わたしが歴史苦手とか、そういうんじゃないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061013,
					"content": "図書館司書の知識が…偵察騎士を上回っているのは当たり前のことでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061008,
					"content": "アンバーが考えた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
