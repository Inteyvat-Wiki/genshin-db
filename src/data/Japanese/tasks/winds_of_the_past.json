				"points": []
			},
			"dialogs": [
				{
					"id": 3061101,
					"content": "ここが放棄された<color=#00E1FFFF>四風守護の神殿</color>の一つだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061102,
					"content": "この神殿が放棄されたのは何年も前でね、モンドの人でも滅多にここには来ないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061103,
					"content": "だから、中は獣やヒルチャールの巣窟になってるかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061104,
					"content": "はぁ…風魔龍でさえ自分の神殿を捨てたほどだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061105,
					"content": "風魔龍が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "あっ…えっと、実はね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061108,
					"content": "わたしもショックなんだけど…風魔龍はかつて「四風守護」の一つとして数えられていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061109,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3061110,
					"content": "この話は置いておいて、どう？何か感じた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061111,
					"content": "ここの「風」、少し変わってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061112,
					"content": "#中へ入ってみよう、{NICKNAME}。気を付けて、龍の力が影響を及ぼしているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3061106,
					"content": "「自分の神殿」とは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
