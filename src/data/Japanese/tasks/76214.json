			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "にゃお…もうお茶会の時間だにゃ。あの子たち迷子になってないかにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140102,
					"content": "あっ、黄金の旅人さん、貴方はきっと選ばれし勇者に違いないにゃ！僕の二人の友達を探すのを手伝ってくれないかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140103,
					"content": "友達っていうのは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "まだ来てないのは、片方は僕と同じ言葉を話す茶トラの猫にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140107,
					"content": "もう片方は礼儀正しいレディドッグで、犬だけど、とっても優しいんだにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140108,
					"content": "猫と犬だって、一緒に座ってお茶を飲めば、みんなきっとハッピーになれるにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140109,
					"content": "ミャウラノポリスの平和のために、どうか力を貸してにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「灰色猫さん」"
				},
				{
					"id": 762140104,
					"content": "勇者の基準、適当すぎない！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "細かいことは気にしないでにゃ。たとえ伝説の聖剣がなくても、伝説の純水の杯が見つからなくても、勇者は勇者だにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "「灰色猫さん」"
				}
			]
		},
		{
			"id": 7621402,
