			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "ワン？どうかしましたか、黄金の旅人さん？何か私にお手伝いできることはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "「レディドッグさん」"
				},
				{
					"id": 762140302,
					"content": "レディドッグさんに、灰色猫さんからのお茶会の招待を伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "え？もうこんな時間だったんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "「レディドッグさん」"
				},
				{
					"id": 762140304,
					"content": "ありがとうございます、ワン！忙しくなければ、直接茶トラ猫さんを招待しに行ったのですが…そうしていれば、灰色猫さんも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "「レディドッグさん」"
				},
				{
					"id": 762140305,
					"content": "猫でも犬でも、みんな平和に共存できるはずです…きっとできます。とにかく、今すぐお茶会に向かいますね。教えてくださってありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「レディドッグさん」"
				}
			]
		},
