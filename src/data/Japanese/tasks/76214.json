						],
						"pointId": 244
					}
				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "…にゃ。そなたの剣技…実に印象的だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "「茶トラ猫さん」"
				},
				{
					"id": 762140209,
					"content": "感謝する、尊敬すべき異邦の騎士よ。あの傲慢で強力な不届き者たちが、我が民の故郷を荒らすことは二度とないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "「茶トラ猫さん」"
				},
				{
					"id": 762140210,
					"content": "では、話してくれぬか。そなたは何ゆえ、我が王庭を訪れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "「茶トラ猫さん」"
				},
				{
					"id": 762140202,
					"content": "王庭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "うぅ…童話だし、きっとこれも設定の一部なんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762140206,
					"content": "茶トラ猫さんに、灰色猫さんからのお茶会の招待を伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "「茶トラ猫さん」"
				},
				{
					"id": 762140208,
					"content": "…分かった。ありがとう、尊敬すべき異邦の騎士よ。それでは、そなたの助言に従い、出発することとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「茶トラ猫さん」"
				},
				{
					"id": 762140204,
					"content": "王よ、ご報告いたします…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "役に入り込むのが早いな！コホン、まあ、そういう設定なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "パイモン"
				}
			]
		},
