				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "なんだよ、脅かすなよ！結局、ただの花火だったじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 701110302,
					"content": "な、なんと絢爛な…某、御建鳴神主尊大御所様に付き従い戦場を駆けし折にも、これほどまでに目を奪う炎の花は未だ見たることなし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110303,
					"content": "なるほど、これぞ虞黄衣殿が某に見せんとした奇景か…恐悦至極、恐悦至極に存ずる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110304,
					"content": "「ぬばたまの 夜半の雲居に 咲く花は うたかたなれや 星と散りぬる…」ああ、いかに雅なるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110305,
					"content": "雅…？よくわからないけど…とにかく、無事ならよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
