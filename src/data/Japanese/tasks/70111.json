				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "貴殿、しばし待たれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110102,
					"content": "委細は省くが、折り入って頼みがある。先日、璃月の虞黄衣殿が某に希代の珍品を送ってくれたのだが、未だに届いておらぬのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110103,
					"content": "某は、この地の番人に奪われたのではないかと疑っておる。もし貴殿が虞黄衣殿の仰る「珍品」を見つけたなら、取り戻してはくれぬか？その時は、必ずや相応の礼を差し上げよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曽我隅田流左近重衡"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曽我隅田流左近重衡"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "戻ったぞ！ほら、これがおまえが言ってた「珍品」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 701110202,
					"content": "おお、かたじけない、かたじけない！御二方の助太刀、感謝いたす！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110203,
					"content": "では、善は急げと言う。これより封を解こう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110204,
					"content": "こ、これは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110205,
					"content": "うわっ！こいつ、爆発寸前じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 701110206,
					"content": "虞黄衣殿が某に害をなすはずが…まさか番人に見つけられ、いわゆる「爆弾」に改造されたというのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110207,
					"content": "恥ずかしながら、某は「爆弾」の解体法など心得ておらぬ…かくなるうえは、これを投げ捨てるほかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110208,
					"content": "恐れずともよい！某は覚えておる。「ヒュペルボレイア」より参られたある殿下が、神聖なる「爆弾」をいかに投げるべきか、仰っていたのを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110209,
					"content": "「汝、三つ数えるべし。多くも少なくもなかれ。汝、四つ数えるべからず、二つもまた数えるべからず、五つは数えすぎなり。汝が数えし数が三となりし時——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "曽我隅田流左近重衡"
				},
				{
					"id": 701110210,
					"content": "いつまで喋ってるんだよ！早く投げないと、ホントに爆発しちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7011103,
