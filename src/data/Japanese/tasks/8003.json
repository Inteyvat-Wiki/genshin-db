			"dialogs": [
				{
					"id": 80030301,
					"content": "これだよな？よし、元素視角で見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030302,
					"content": "うーん——どうだ？なにか分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030303,
					"content": "なにもない？うぅ、期待してたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030304,
					"content": "なにか勘違いしてるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030305,
					"content": "方法の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030306,
					"content": "「耕運機」に元素視角を使っても意味はない。動作のエネルギーが「元素」ではないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030307,
					"content": "俺が試してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030308,
					"content": "…完了だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030309,
					"content": "あっ！これは…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030310,
					"content": "アビスの使徒がずっと探していた「最古の耕運機の目」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030311,
					"content": "今まだ残っている遺跡守衛は、全てこの「プロトタイプ」のレプリカ。その戦闘力は計り知れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030312,
					"content": "「プロトタイプ」…難しい単語だな、カーンルイアの用語か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030313,
					"content": "アビス教団の思惑通り、「目」を「穢れた逆さ神像」の手に置けば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030314,
					"content": "「渦の魔神」オセルの肢体を繋ぎ、機械魔神を創造することで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030315,
					"content": "「天空の島にある神座を揺るがす」力を、新たに誕生した魔神に与えることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030316,
					"content": "危険な行為だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030319,
					"content": "じゃあ、この「目」はどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030320,
					"content": "どこかに隠そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "いや、俺が保管する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030323,
					"content": "えっ！？ダイン…それを使って悪いこと企んでたりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030324,
					"content": "疑いたければ好きにしろ。俺はその力が利用されないために確保する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030325,
					"content": "他の場所に隠しても見つかる、教会も——信用できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030326,
					"content": "お…おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030327,
					"content": "それだけではない。不安要素を残さないよう、あの「穢れた逆さ神像」を「処理」しておく必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030328,
					"content": "どうやって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "教会に介入させるつもりはない、俺たちだけで終わらせる。「処理」とはつまり…破壊することだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030331,
					"content": "破壊！？あの七天神像を！？価値のある文化物だぞ、本物の神が…あ、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030332,
					"content": "バ、バーバラが知ったら今度こそ失神するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030333,
					"content": "ふん…七神の物を、俺が守る義務があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030334,
					"content": "<color=#00E1FFFF>あの遺跡</color>へ戻って逆さの神像を破壊する。それに、運が良ければ「アビスの使徒」とも会える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030335,
					"content": "俺がいれば、今度こそヤツは逃げられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030329,
					"content": "教会に任せてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "西風教会に預けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "必ずアビス教団を止める。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
