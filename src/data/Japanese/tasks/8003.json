			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "行っちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030602,
					"content": "そんなに悲しむなよ…きっとまた会えるぞ！良い方に考えよう！少なくとも手がかりは見つかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030603,
					"content": "悲しんで…ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "え？本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030607,
					"content": "とにかく、家族を探すためには、「七神」以外にも、「ダイン」が突破口に加わったってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030608,
					"content": "稲妻でも、気にかけよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "おう！でも、あいつらが話してたこと難しかったよな。全部理解できたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030611,
					"content": "全部理解した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "そっか…じゃあもう一回整理しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030614,
					"content": "#まずはあのアビスの使徒、おまえの{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_SISTER]}さんを「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}様」って呼んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030615,
					"content": "#おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんはアビス教団を率いてて、アビスの使徒よりも地位が高いってことだな…一番高いかどうかは分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030616,
					"content": "#それと、おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんが「神座を下し、天理と戦う」のが目的だって言ってたけど、どういう意味なんだろう？七神と七国を滅ぼすってことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030617,
					"content": "あと、アビス教団の怪物は、カーンルイアの民が…歪んで出来た化け物だった。これは恐ろしいことだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030618,
					"content": "ダインはカーンルイア人で、500年前に全てを経験した。でも怪物にはなってなくて、500年経った今では、アビス教団と対峙している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030619,
					"content": "#それって、おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんが言ってた「ダインは{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_GIRLFIRST|INFO_MALE_PRONOUN_BOYFIRST]}の敵」って意味だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030620,
					"content": "でも、アビス教団の怪物が、当時のダインが守ろうとした民なら、どうしてダインはアビス教団と敵対してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030621,
					"content": "#それに、一緒に探してた{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんも、どうしてアビス教団に協力してるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030622,
					"content": "まだまだ情報が少ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "おう、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030625,
					"content": "ひとまず——元気出していこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030626,
					"content": "オイラたちの旅は終わってない、出発しよう！こんな嫌な場所から出て、日差しの差す明るい地上へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030627,
					"content": "#おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんが「終点に辿り着け」って言うなら、辿り着いてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030628,
					"content": "「旅人」、一緒に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030623,
					"content": "これ以上考えても意味ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_YING|INFO_MALE_PRONOUN_BIGBROTHER]}だけ見てたから聞いてなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "また一つ「旅」の目標が増えた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "パイモンの言う通り、まだ希望はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "な、そうだろそうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}