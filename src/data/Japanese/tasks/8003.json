			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "そうだ、ダインはジン団長に会ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030102,
					"content": "見かけたが、会わないように避けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030103,
					"content": "彼女は「獅牙騎士」であり代理団長でもある。俺を警戒している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030104,
					"content": "気を付けなければ、彼女の調査対象になってしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030105,
					"content": "ところで、魔物は片付けたが情報はなかった。そっちは何か収穫があったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030106,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030107,
					"content": "これで、「最古の耕運機」の全貌も、少しは掴めるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030108,
					"content": "えっ？本当か？「王狼」から聞いたことだけで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030109,
					"content": "それだけではない、もっと全体的に考えた上で出した結論だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030110,
					"content": "例えば、貴様たちが教会で聞いた「歴史」について…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030111,
					"content": "「暴君の遺恨」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "そうだ。そのシスターから聞いた、暴君の遺恨に関する事件だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030113,
					"content": "もし火の玉がミサイルだったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "あっ、オイラ分かったぞ！「暴君の遺恨」は、奔狼領から逃げた機械が発射したミサイルなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030116,
					"content": "「狼の試練」で損傷したあと、彷徨い続けて「旧モンド」の廃墟まで辿り着いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030117,
					"content": "人が近づくと、ミサイルを発射してたけど——ある日、ついに壊れて、その天から降る火の玉もなくなったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030118,
					"content": "当時のモンドの人はあまり「遺跡守衛」を見たことなかったから、「暴君の遺恨」って呼ぶようになったんだと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030119,
					"content": "どうやら、次は<color=#00E1FFFF>「風龍廃墟」</color>と呼ばれるあの場所に行って詳しく調査する必要があるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030120,
					"content": "いや。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "ん？それはどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030123,
					"content": "印象に残ってる「記憶」がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030125,
					"content": "あっ！分かったぞ！あの<color=#00E1FFFF>「高塔に居座る守衛」</color>は、確かに印象深かったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030121,
					"content": "必要ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "当時は火の玉が何か分からなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "バーバラは祈祷牧師だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
