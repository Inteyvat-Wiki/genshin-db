			"dialogs": [
				{
					"id": 80030201,
					"content": "そ、その人、もしかして…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030202,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_YING|INFO_MALE_PRONOUN_KONG]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "やっと見つけた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "さっき…アビスの使徒のために攻撃を防いだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030207,
					"content": "#おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さん、「アビス」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030208,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}、どうしてダインと一緒に？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "どうして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "（あんなに長い間離れ離れになってたのに…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030214,
					"content": "#おまえの{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さん…ダインを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030216,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}。また会ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030217,
					"content": "#ど…どういうことなんだ！？ダインが{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BOYA]}さんの名前を知ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030218,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}…その人と一緒にいちゃだめ{MATEAVATAR#SEXPRO[INFO_MALE_PLAYER_END02|INFO_FEMALE_PLAYER_END01]}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "#その人は…{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の「敵」。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80030221,
					"content": "待って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "……",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "#これは言わなきゃいけないこと{MATEAVATAR#SEXPRO[INFO_MALE_PLAYER_END03|INFO_FEMALE_PLAYER_END03]}、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}。ダインと一緒に{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を、「アビス」を、阻止{MATEAVATAR#SEXPRO[INFO_MALE_PLAYER_END04|INFO_FEMALE_PLAYER_END04]}。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "その人は…ダインスレイヴは、最後のカーンルイア宮廷親衛隊「末光の剣」。500年前、彼はカーンルイアの滅亡を阻止できなかった。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "その時に不死の呪いをかけられ、荒野を彷徨った…彼が守ろうとした民が、アビスの怪物になるのを見ながら…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "ダインが…カーンルイア人だって！？500年前に滅びたあのカーンルイア人！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030228,
					"content": "それに、「民が怪物になる」って…今のアビス教団は、「カーンルイアと関係がある」どころか、カーンルイアの「遺民」だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030229,
					"content": "うぅ…「ダインはおまえの敵」って、なにがなんだか分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80030230,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}と一緒に家に帰ろう！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "家…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "#{M#うん}{F#ああ}、もちろん、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}がいる場所が「家」だ{MATEAVATAR#SEXPRO[INFO_MALE_PLAYER_END01|INFO_FEMALE_PLAYER_END02]}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "#でも{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_GIRLFIRST|INFO_MALE_PRONOUN_BOYFIRST]}は、まだ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}と次の世界に行けない。少なくとも今は…できない。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "「アビス」が神座を下す前に、まだ「天理」との戦いが残ってる…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "天…理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#聞い{MATEAVATAR#SEXPRO[INFO_MALE_PLAYER_END05|INFO_FEMALE_PLAYER_END05]}、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_GIRLFIRST|INFO_MALE_PRONOUN_BOYFIRST]}はすでに一度旅をした。だから、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_KONG|INFO_FEMALE_PRONOUN_YING]}も{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_GIRLFIRST|INFO_MALE_PRONOUN_BOYFIRST]}と同じように終点に辿り着けば、この世界の淀みを見届けることができる。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "そんな事あとでいいから、早く家に帰ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#言ってる事が分からないよ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "（どうして…そんなことを？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "ダインの…ことを？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
