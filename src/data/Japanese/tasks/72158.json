				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "雷が…収まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580102,
					"content": "どうやら「鎮め石」は4つとも封印したようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580103,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "も、戻ってきた！どうやって上まで行ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580105,
					"content": "君が扉みたいなものを通ったら消失したって、大祐が言ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580106,
					"content": "あの扉はなんだろう？変ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580107,
					"content": "上で何があったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580108,
					"content": "僕と悦子が下にいた時、上から突然大きな音が聞こえたんだ。まるで…雷のような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580109,
					"content": "でも、雷は収まったはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580110,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "石が空中に浮かんで、土台を作った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580112,
					"content": "そんな…前代未聞だ。セイライ島にこんな自然現象があったなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580113,
					"content": "そんなの…自然現象なわけないでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580114,
					"content": "どう考えても…普通じゃないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580115,
					"content": "確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "でも、それが何の現象かはともかく、セイライ島の雷も収まったし、我々の任務も終わった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580118,
					"content": "奇妙な羽毛について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "この羽毛…大祐、これを見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580120,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580121,
					"content": "ごめん、僕もこの羽毛がどこから来たのか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580122,
					"content": "この羽毛の模様と質感、どれも僕の知ってる鳥類とは違うものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580123,
					"content": "それにこの羽毛の大きさ、比率をもとに計算したら、この鳥はあの空にある石台と同じくらいの大きさになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580124,
					"content": "この羽毛は大事なもの？もし詳しいことが知りたいのなら、冒険者協会で依頼を出してみたら？手がかりが見つかるかもしれないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580125,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "そう、じゃあ…今回はありがとう、冒険者。私と大祐は協会に戻って報告してくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580128,
					"content": "そうだ、これを報酬として受け取って。あまり多くはないけど…手助けしてくれたお礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580129,
					"content": "大祐、協会へ戻る準備をするわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580130,
					"content": "その、悦子…その前にあの神社に行って、「寝子」さまを見に行こうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580131,
					"content": "あのねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580132,
					"content": "言葉を喋る猫なんだよ？喋る猫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580133,
					"content": "まったくあんたは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 721580126,
					"content": "もう少し調べてみる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}