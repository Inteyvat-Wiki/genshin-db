					"エウルア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#あら、{NICKNAME}じゃない。こんなところで会うなんて思わなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200402,
					"content": "久しぶりだね、エウルア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "パトロール中よ。体を鈍らせないためにも必要なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200405,
					"content": "最近のモンドは比較的平和で、遊撃小隊を集めるほどの脅威はほとんどないわ。隊の者たちも…内心、だいぶ緩んでるみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200406,
					"content": "休息と仕事のバランスを取るのも必要だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "それでも私は、隊長として気を緩めてはいけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200408,
					"content": "平和だからといって、敵の剣は鈍くなったりしないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200409,
					"content": "だから、巡回の合間に人気のない場所で鍛錬をして、腕が鈍らないようにしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200410,
					"content": "それならちょうどいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "へえ？面白いお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200413,
					"content": "でも私、速いわよ。君に私を捉えられるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200414,
					"content": "いつも通りにしてくれればいいよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "わかったわ。そこまで自信があるなら、私も本気で行かせてもらうわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200417,
					"content": "よく見てなさい。波の花が舞うのは一瞬よ、瞬きさえも許さないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 745200415,
					"content": "しっかり捉えてみせるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "#{M#俺}{F#私}に写真を撮らせてよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "仕事中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
