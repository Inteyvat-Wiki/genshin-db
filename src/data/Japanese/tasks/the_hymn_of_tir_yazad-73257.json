			"dialogs": [
				{
					"id": 732572901,
					"content": "よし、淵の底を抜ける通路が開いたナ。私たちの任務もこれで無事完了ダ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572902
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732572902,
					"content": "えっ、こんな簡単なのか？ずっと儀式、儀式って言ってるから、意味わかんない呪文とか唱えないといけないのかと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732572903,
					"content": "ふっ、そんなことが必要なの人間だけサ。なにせ、己だけでは元素すら使役できないのだからナ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732572904,
					"content": "私たち花霊は違う。なぜなら、私たちの力は霊光と同源ダ。あなたたちだって、歩くくらいで呪文を唱える必要はないダロ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732572905,
					"content": "まあ…あなたは飛んでいるケド。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732572906,
					"content": "やっぱり、ただの屁理屈じゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732572907,
					"content": "まあいい、無駄話はここまでダ。ここから先のことは頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732572908,
					"content": "「永遠なる霊光は、私たちを上昇の道へと導いてくれる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミヒル"
				}
			]
		},
