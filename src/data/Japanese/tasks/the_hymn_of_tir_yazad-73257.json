	"talks": [
		{
			"id": 7325701,
			"completionStepIds": [
				7325701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325701",
							"2"
						],
						"stepId": 7325701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソルシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "そういえば、ソルシュ…遺跡工場を出てから、一言もしゃべってないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570102,
					"content": "前は四六時中しゃべってたのに、今みたいに静かだとなんだか慣れないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570103,
					"content": "あまりにショックで落ち込んでるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "元気出せって、ソルシュ！やるべきことはまだたくさん残ってるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570107,
					"content": "あのなんちゃら…えっと覚えづらい名前の儀式をやって、さっさとあのでっかい穴をなんとかするんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570108,
					"content": "全部が終わったら、美味しいものでも食べに行こうぜ。みんな頑張ったしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570109,
					"content": "例えば…えーっと、花霊の喜びそうな食べ物がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570111,
					"content": "…花霊は食べ物を口にする必要がないワ。白フラのおバカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570112,
					"content": "はぁ、白フラに慰められることになるなんて、情けないにもほどがあるわネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570113,
					"content": "今すぐにでも、「灰残晶」に封印されたい気分だワ。それか、私のコトを知っている者が全員消えるまで、ずっと寝ていられる洞窟を見つけてそこに引きこもっていたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570114,
					"content": "オイラのことを白フラって呼ぶなって言ってるだろ！それにそんな洞窟、本当にあるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570115,
					"content": "逃げるだけじゃ問題解決にならない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "もう、どうだっていいノ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570119,
					"content": "ナセジュナの手のひらで踊らされていたコトを考えると、恥ずかしくて耐えられないのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570120,
					"content": "どうせ「霊光絶唱」も手に入れたんだし…あのなんたら天象を解決したいなら、花海にいるミヒルかラシュヌを探せばいいワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570121,
					"content": "とにかく、私のコトはほっといて。今まで私から聞いた話は忘れてちょうダイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570122,
					"content": "まあ、確かにおまえの口から妙な言い回しの言葉をいっぱい聞きはしたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570123,
					"content": "「我が謁賛主」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "ヒンッ！お願いだカラ、もう言わないでェぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}、こんな時くらいソルシュのことをからかわないでやろうぜ。長いこと一緒に冒険してきた仲なんだし、こいつに途中でリタイアさせるなんてよくないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570128,
					"content": "それにソルシュだって、すごいところがあるし。例えば…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570129,
					"content": "あなた、なんで言い淀むのヨ！うわぁん…慰めの言葉なんかもう聞きたくないワァぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570130,
					"content": "例えば、行動力がとてもあるところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "そうそう、その通り！それに、オイラたちはずっとあの天象をどうにかするために頑張ってきたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570133,
					"content": "ここまで来られたのは、ソルシュのおかげなんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570134,
					"content": "えーっと、なんて言ったけ？…そうっ！「歩みを止めずに進み続ければ、卓越した冒険者になれるのも時間の問題です」ってやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570135,
					"content": "ほんとうに？心から私のことを褒めているノ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570136,
					"content": "これは友達としての称賛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "くふふんっ、さすがはこの私というべきネ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570138,
					"content": "よーし、一気にモチベーションが湧いてきたワ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570139,
					"content": "ソルシュが元気を取り戻したことだし、さっそくズルヴァーンのところに行こうぜ。あのでっかい穴をさっさと塞いで、報酬を手に入れよう。美味しい食べ物がオイラたちを待ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570131,
					"content": "例えば、責任感がとても強いところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "「勇姿」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "「運命に定められし犠牲」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "まだやるべきことが残ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "そんなこともあったわネ、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570104,
					"content": "あんなことを経験したら、無理もない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "疲れているだけかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ズルヴァーン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "ズルヴァーン、戻って来たぞー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570202,
					"content": "#おや、{NICKNAME}にパイモン、それにソルシュじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570203,
					"content": "その様子だと、「霊光絶唱」を全部手に入れたみたいネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570204,
					"content": "紆余曲折あったけど、なんとか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "過程はどうあれ、最終的な結果が良ければ問題ないワ。貴方たちに頼んだのは、やっぱり正しかったようネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570207,
					"content": "貴方たちがいなければ、おそらく「霊光絶唱」はあの悪巧みをしていた輩に奪われていたでショウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570208,
					"content": "あれ？ズルヴァーンのその言い方、まるで前々からなにか知ってたように聞こえるけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570209,
					"content": "ふふふっ…いや、当てずっぽうで言ってみただけヨ、まさか当たっているなんて。貴方たち、まさか本当にあの黒淵に仕える者たちに遭遇したノ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570210,
					"content": "どうやって知ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "それについては…まあそれを深掘りするより、私に事の経緯を説明してくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570214,
					"content": "ズルヴァーンに地下遺跡での冒険、それからナセジュナの裏切りを説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "ふふっ…まさか、スケプティック団の「識主」までもが黒淵の肩を持つとはネェ。あの者たちには元々大した期待を寄せてなかったけど、これはさすがに驚いたワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570216,
					"content": "私の推測が正しければ、彼が「霊光絶唱」を狙ったのも、貴方たちが戦っていた黒淵の者に惑わされたからなのでショウ。何ぶん、その黒淵の者は私と旧知の仲だからネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570217,
					"content": "えっ？ズルヴァーンって、アビス教団に知り合いがいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570218,
					"content": "ふん、そいつは元々スケプティック団の一員だったのヨ。数百年前、森から来た調査団と自称する者たちがダーリ人の秘密を究明するために、この地を訪れたことがあってネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570219,
					"content": "彼らはスケプティック団の制止を無視し、ダーリ人が残した遺跡に入ろうとしたワ。予測不能な事態が起こるのを阻止するため、当時の識主はそいつに同行するよう命じたノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570220,
					"content": "けど、遺跡で何かに遭遇したのか、そいつの姿を再び見た時には、既に穢れの「祝福」を受けていたワ。そして、調査団の者たちも行方不明にネ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570221,
					"content": "黒淵の信徒たちは「霊光絶唱」を狙って集まり、ディフの魔獣を数多と呼び寄せ、花海に侵攻したワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570222,
					"content": "多くの花霊と人間の勇士たちのおかげで、花海を最後まで守り抜くことができたケド…黒淵の信徒たちをすべて消すことはできなかったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570223,
					"content": "その者たちに利用されることがないように、私は「霊光絶唱」の力で花海と各地の遺跡を封印したノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570224,
					"content": "とうのスケプティック団も、その裏切りによって大きな痛手を被ったワ。伝承してきた典籍はすべて焼失してしまってネ。それから少しずつ、今のような姿になってしまったノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570225,
					"content": "この前、貴方たちの話を聞いた時から、裏で糸を引いている者がいると疑っていたワ。けれど、スケプティック団のリーダーまでもが連中に利用される操り人形になっているなんてネェ、思いもしなかったワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570226,
					"content": "でも、ナセジュナが言ってたことって、やっぱり気になるよな。スケプティック団の先人のことについては、ズルヴァーンもなにか知ってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570227,
					"content": "かつて、彼らと一緒に戦ってたわけだしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "ふふっ、歴史が伝説となり、やがて伝説が物語となる。伝承というものの本質も所詮こんなものヨ。忘れること自体も物語の一部だからネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570229,
					"content": "伝承にこだわるほど、信じたい物語だけを覚えるようになってしまうものだワ。そして最後には、物語の迷宮を彷徨うことになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570230,
					"content": "この忘れ去られていく世界では、重みのない頌歌よりも、私たちがこの大地に刻んだ痕跡のほうがより頼りになるものヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570231,
					"content": "だから、貴方たちを信じることにしたノ。なにせ貴方たちは、何の評価も気にしない、率直な者だと感じられたからネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570232,
					"content": "一応、オイラたちのことを褒めてるみたいだけど、なんか変なふうに聞こえるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570233,
					"content": "含みのある言い方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "先輩…それって、私のことを言っているのネ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570235,
					"content": "五百年より前のことについては、私からもう一つの物語を聞くより、その身で体験してきたほうがいいワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570236,
					"content": "ちょうど、今はそのような機会があるようだからネェ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570237,
					"content": "そういえばソルシュ、貴方もだいぶ頼れるようになってきたみたいネ。あれだけのことを経験してきたのだから、そろそろあんな人間の戯言から目覚めたらどうなノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570238,
					"content": "先輩！もう終わったことですカラ、それ以上は言わないでくだサイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570239,
					"content": "#やはり、{NICKNAME}とパイモンに頼んで正解だったみたいネ。これなら、安心して「アブゾーアの儀」も貴方たちに託せるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570240,
					"content": "「アブゾーアの儀」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "たしか前にも、ズルヴァーンから聞いたよな！穢れを消すための儀式だとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570242,
					"content": "「アブゾーアの儀」は「万種母樹」の穢れを祓うための儀式ヨ。通常、黒淵を鎮める巨木の下で行うことになるワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570243,
					"content": "けれど、黒淵の封印が緩み、空にある異象も再び現れた今、普通の儀式で解決できる問題ではなくなっているワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570244,
					"content": "そもそも、この異象が母樹に顕現したのは、母樹が穢れを大量に吸収したことが原因ヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570245,
					"content": "「万種母樹」には、ただでさえ穢れが溜まりすぎているワ。それなのに、さらに異象の侵蝕を受けて、今や霊光の力すら維持できなくなっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570246,
					"content": "いま取れる唯一の方法は——「万種母樹」の中に入り、そこにある穢れを祓って、神様の神識を呼び覚ますことヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570247,
					"content": "えっと、樹の中って入れるものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570248,
					"content": "おや、まさか「チンワトの儀」をあの黒淵の中で行うものだと思っていたノ？あそこまでの穢れ、たとえ花霊であっても耐えられないはずヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570249,
					"content": "神の意識が宿っている巨蓮「ガオケレナ」は、万種母樹の中にあるワ。穢れを祓うことさえできれば、聖潔の花は再びそこから綻ぶワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570250,
					"content": "そして、甘露が大地をすべて浄化してくれるノ。少し複雑だけど、貴方たちなら簡単なはずヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570251,
					"content": "さあ、ラシュヌとミヒルには事前に「トゥニギの黒淵」のところへ向かうよう伝えてあるワ。「霊光絶唱」さえ持っていれば、霊光の力を集められるはずヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570252,
					"content": "霊光は黒淵を鎮める巨木を呼び覚まし、淵底の泥を浄化してくれるワ。それから「チンワトの儀」を行って、「万種母樹」に入るための通路を開けなサイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570253,
					"content": "古の英雄たちの偉業については、母樹の中に入れば分かるワ。その時になったら、花冠がソルシュに見せてくれるハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570254,
					"content": "何しろ霊光に関連する記憶のすべてが、「万種母樹」へと最後には帰っているからネ。世に謳われる伝説が変わろうとも、そこにある記憶だけは色褪せたりしないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570255,
					"content": "そんなこと、初めて聞きましたワ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570256,
					"content": "ふふっ、花冠というのは、もともと母樹の一部なノ。その時になったら、貴方も理解できると思うワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570257,
					"content": "さて、どうかあの「焚真の天象」を鎮めてきてちょうダイ。空から甘露が降る時に——私たちはまた会えるでショウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570212,
					"content": "そうだと思った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "じゃあ、事の経緯を説明してくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "ズルヴァーン"
				},
				{
					"id": 732570205,
					"content": "本当に疲れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
