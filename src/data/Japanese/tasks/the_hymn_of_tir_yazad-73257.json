			"dialogs": [
				{
					"id": 732573001,
					"content": "大霊光を置いたら、この辺りも生気を取り戻したみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732573002,
					"content": "これらの木々は、もともと霊光の力が災厄の侵蝕に抵抗するために、霊光の力によって栽培されたモノ。ただ、長い時間を経たことで、その力も徐々に消耗して尽きてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573003
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732573003,
					"content": "「霊光絶唱」に養分を与えられた今、昔のように輝かしい姿を取り戻せたってわけサ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573004
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732573004,
					"content": "しかし、封印が解けたことで過去の穢れも一緒に排出されたハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573005
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732573005,
					"content": "私とラシュヌがここで力尽きてしまうと、儀式を行えなくなる。残りの数箇所はあなたたちに任せヨウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573006
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732573006,
					"content": "ふふん、私に任せなサイ！穢れに対抗するのは、この勇者の仕事なんだカラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソルシュ"
				}
			]
		},
