				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "遅かったネ…ソルシュ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "ラシュヌ"
				},
				{
					"id": 732570402,
					"content": "もうずいぶん、ここで待っていたヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732570403,
					"content": "疲れたヨォ…帰って…寝たい。ふぁあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "ラシュヌ"
				},
				{
					"id": 732570404,
					"content": "なにヨ、あなたたち。何もやってないくせに。こっちはずっと苦労してたのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 732570405,
					"content": "そんなことナイ。待つことだって重要な仕事だからナ。なんなら短期の行動よりも、待つことのほうが永遠とも思える仕事サ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732570406,
					"content": "どんな屁理屈だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570407,
					"content": "私たち花霊の哲学って言うべきだナ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732570408,
					"content": "ケド、哲学を語るより…いま大事なのは「霊光絶唱」のほうサ。もちろん、すべて集めてきたのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732570409,
					"content": "おう、当然だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732570410,
					"content": "よろしい。では、私たちがここの封印を解くとしヨウ。そうすれば「霊光絶唱」で霊光の力を集めることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732570411,
					"content": "けど気を付けてほしい。なにせ長年溜まってきた穢れだ。何が出てくるかは分からナイ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミヒル"
				}
			]
		},
		{
			"id": 7325714,
			"completionStepIds": [
				7325714
			],
