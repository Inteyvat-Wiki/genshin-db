					"ラシュヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732571401,
					"content": "やっと収まったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732571402,
					"content": "新しい穢れが出てこないうちに、さっそく「チンワトの儀」を始めるとしヨウ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571403
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732571403,
					"content": "それができたら、私たちの仕事は終わりダ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571404
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732571404,
					"content": "そして…邪魔されることなく、安眠できるヨ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571405
					],
					"speakerTitle": "ラシュヌ"
				},
				{
					"id": 732571405,
					"content": "急げ、ソルシュ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571406
					],
					"speakerTitle": "ミヒル"
				},
				{
					"id": 732571406,
					"content": "ソルシュ…もたもたしないデ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571407
					],
					"speakerTitle": "ラシュヌ"
				},
				{
					"id": 732571407,
					"content": "私たち三体が一緒じゃないとダメだからナ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミヒル"
				}
			]
		},
