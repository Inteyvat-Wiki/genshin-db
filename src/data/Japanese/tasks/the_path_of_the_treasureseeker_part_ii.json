						726510203
					]
				},
				{
					"id": 726510203,
					"content": "お前は…旅人？ちょうどよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510204
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510204,
					"content": "いい商談があるんだ！一夜でお金持ちになれるほどにな。どうだ、興味あるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510205,
						726510206
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510205,
					"content": "じゃあ自分で儲ければ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510207
					]
				},
				{
					"id": 726510207,
					"content": "警戒心が強いんだな。俺はただ、稲妻で大金を手に入れたい一般人だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510208
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510208,
					"content": "稲妻は今鎖国中だろう。だから、「友達」とよく話し合って、小さい船で海を渡って稲妻に来ようとしたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510209
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510209,
					"content": "はぁ…稲妻に近づけば近づくほど、雷と嵐が激しくなってきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510210
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510210,
					"content": "それから、雷に打たれ船が壊れて、俺も海に落ちてしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510211
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510211,
					"content": "波に飲み込まれて気絶して、それから目を覚ましたら、海岸で寝そべっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510212
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510212,
					"content": "凄い運だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510213
					]
				},
				{
					"id": 726510213,
					"content": "ははは、俺もそう思った、ずっと運が良かったもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510214
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510214,
					"content": "あと…う…何と言うか、陸地に上がって色々聞き回っていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510215
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510215,
					"content": "この小さいのを見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510216
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510216,
					"content": "せ、仙霊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510217
					]
				},
				{
					"id": 726510217,
					"content": "正しく言えば「宝探し仙霊」だな。名前の通り、宝を探してくれる立派な仲間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510218
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510218,
					"content": "けどなぜか、宝をいくつか探したら急に休んじゃって、俺の周りでうろうろするだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510219
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510219,
					"content": "たぶん、俺の宝探しのスピードが遅いから、仲間を変えようと思ってるんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510220
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510220,
					"content": "旅人、もし興味が湧いたら、お前がこいつの新しい相棒になってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510221
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510221,
					"content": "仙霊と交流したことがない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510222
					]
				},
				{
					"id": 726510222,
					"content": "ははは、大丈夫さ。こいつ、結構お前のことを気に入ったらしいぜ、ほら、楽しそうだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510223
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510223,
					"content": "こほん！とにかく、こいつのパートナーになってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510224,
						726510225
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510224,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510226
					]
				},
				{
					"id": 726510226,
					"content": "良かった、じゃあ俺ら2人…いや、3人はこれから協力し合う仲だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510227
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510227,
					"content": "この手帳を受け取ってくれ。中に、宝物の場所が書かれてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510228
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510228,
					"content": "「宝探し仙霊」がいなければ、俺は絶対にあの宝を探し出せなかった…。だから、お前に託したぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510229,
						726510231
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510229,
					"content": "宝を探し出した後は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510230
					]
				},
				{
					"id": 726510230,
					"content": "それは…探し出した宝は旅人が全部持って行っていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510233
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510233,
					"content": "その代わり、掘り出す時に「鉄銭」と言う古代の貨幣も一緒に出てくることがある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510234
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510234,
					"content": "それを見つけたら、俺に渡してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510235
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510235,
					"content": "普通の商人ならこんなもの買わないかも知れないが、俺はいい値段で買ってやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510236
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510236,
					"content": "じゃっ、この手帳をしっかり持って、こいつを連れて行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510237
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510237,
					"content": "それから、宝探しの旅を楽しんでくれ…俺との取引もな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510231,
					"content": "半分に分けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510232
					]
				},
				{
					"id": 726510232,
					"content": "へー、ちゃんとルールを分かってるんだな…でも、宝はいいや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510233
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510225,
					"content": "好きになってくれたらいいな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510226
					]
				},
				{
					"id": 726510206,
					"content": "聞いただけでも怪しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510207
					]
				}
			]
		}
