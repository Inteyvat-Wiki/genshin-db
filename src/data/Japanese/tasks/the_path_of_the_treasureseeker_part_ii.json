			},
			"dialogs": [
				{
					"id": 726510101,
					"content": "俺って、本当に「仙霊を引き寄せる」体質なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510102
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510102,
					"content": "お前は…旅人？ここで何してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510103,
						726510106
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510104
					]
				},
				{
					"id": 726510104,
					"content": "俺だよ、ウルマン！昔、一緒に宝を探してたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510105
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510105,
					"content": "やれやれ、「宝探し仙霊」！思い出せたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510108,
					"content": "どうして稲妻に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510109
					]
				},
				{
					"id": 726510109,
					"content": "コホン…前に協力した時、鉄銭をたくさん探してくれただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510110
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510110,
					"content": "その鉄銭でたくさん儲かったんだ。はは、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510111
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510111,
					"content": "けど、知っての通り、最近はどこに行ってもお金が必要だから、モラがすぐなくなっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510112
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510112,
					"content": "「宝探し仙霊」もいなくなって、お前の助けもないから、鉄銭を探すこともできなくなってるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510113
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510113,
					"content": "だから、他に稼ぐ方法を探してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510114
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510114,
					"content": "ある人…。っ、…昔の同僚から聞いた話、稲妻は至る所に宝があるらしい。だから、運試しに行きたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510115
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510115,
					"content": "稲妻は鎖国中だって知ってるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510116
					]
				},
				{
					"id": 726510116,
					"content": "それはもちろん知ってるけど…へっ、俺なりの方法があるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510117
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510117,
					"content": "「友達」とよく話し合って、ちょっとだけの代価で船を用意して、稲妻まで漕いで行くつもりだったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510118
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510118,
					"content": "はぁ…稲妻に近づけば近づくほど、雷と嵐が激しくなってきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510119
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510119,
					"content": "それから、雷に打たれ船が壊れて、俺も海に落ちてしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510120
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510120,
					"content": "波に飲み込まれて気絶して、それから目を覚ましたら、海岸で寝そべっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510121
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510121,
					"content": "凄い運だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510122
					]
				},
				{
					"id": 726510122,
					"content": "ははは、俺もそう思った、ずっと運が良かったもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510123
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510123,
					"content": "あと…う…何と言うか、陸地に上がって色々聞き回っていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510124
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510124,
					"content": "またこの小さいのに会って、いくつかの宝を探してくれた。だから、こいつも「宝探し仙霊」なんじゃないかって思ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510125
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510125,
					"content": "それに、宝をいくつか探したら休んじゃって、俺の周りでうろうろするだけ。前のやつと一緒だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510126
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510126,
					"content": "またこの仙霊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510127
					]
				},
				{
					"id": 726510127,
					"content": "よくわからないが、俺ってもしかしたら「仙霊を引き寄せる」体質なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510128
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510128,
					"content": "あるいは、俺がやつらを引き寄せる何かを持っていたりして？よくわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510129
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510129,
					"content": "とにかく、稲妻まで来たんだし、ただで帰る事はできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510130
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510130,
					"content": "聞いた情報によると、周りにはまだ宝が潜んでる。全部このノートに記してやった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510131
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510131,
					"content": "でも、この小さいのがやる気を出さない限り、俺一人じゃ限界があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510132
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510132,
					"content": "旅人、もし興味があったら、また俺に協力してみないか。旅人の「宝探し仙霊」はやる気満々だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510133
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510133,
					"content": "前のルールと同じだ。宝蔵地はマークしてやったから、探し出した宝は全部持って行っていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510134
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510134,
					"content": "もし「鉄銭」を探し出したら、俺のところに持って来い。へへ、いい値段で買い取ってやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510135
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510135,
					"content": "本当にいい値段だといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510136
					]
				},
				{
					"id": 726510136,
					"content": "そんなの当たり前だ。俺に協力するのも初めてじゃないだろう、信じてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510137
					],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510137,
					"content": "この手帳を渡そう。宝探しの旅を楽しんでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウルマン"
				},
				{
					"id": 726510106,
					"content": "「宝探し仙霊」の…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510107
					]
				},
				{
					"id": 726510107,
					"content": "そうだ、ウルマンだ。昔、一緒に宝を探してたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "ウルマン"
				}
			]
		},
