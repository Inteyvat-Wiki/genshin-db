			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"チャスカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "なんとなくここに来るべきだと思ったんだが…お前に会うためだったか、「トゥマ{RUBY#[S]希望}イニ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610102,
					"content": "「花翼の集」の戦闘試験のために来たんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610103,
					"content": "うん、難易度を試すためにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "手応えを感じてもらえると思う。私はクク竜騎士の訓練には厳しいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610105,
					"content": "人に教えるのは得意じゃないから、設計にあたっては、これまでに遭遇した「厄介な問題」を思い浮かべて、ステージに組み込んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610109,
					"content": "だが、「花翼の集」の戦士の九割九分が第一ステージで脱落してしまってな。仕方なく、イラードの提案通り、難易度を下げたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610110,
					"content": "お前なら、難易度を下げては物足りないだろう。そうだな…私でさえ手こずるステージを選ぶべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610111,
					"content": "同感！でも、特別扱いは遠慮しとく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "買い被りなんかじゃない。教えるのは苦手だが、人の能力を見定める眼力には自信がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610114,
					"content": "君の実力なら、一番難しい挑戦でも行けそうだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610115,
					"content": "ほかの戦士のことも考えないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "…そうだな。今回は依頼されたテストを優先しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610118,
					"content": "代わりに今度、お前にぴったりな…クク竜騎士の頂点をも「超越」した戦闘の宴を用意するから、楽しみにしててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610116,
					"content": "普通の戦士にも使えるものじゃないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "嬉しいけど、買い被りだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "チャスカに会うためでもあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "ふっ、そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 756610108,
					"content": "——私の記録を「超越」することが狙いなんだろう？望むところだ。このステージには、私がこれまで遭遇してきた「厄介な問題」を組み込んである。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "チャスカ"
				}
			]
		}
	]
}