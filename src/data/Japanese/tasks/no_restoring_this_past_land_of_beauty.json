				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "今回は天穹の谷で起きたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#{NICKNAME}か、ここで会えるとは。お会いできて光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220104,
					"content": "それはさておき、最近天穹の谷の南天門に行ったことはあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220107,
					"content": "近頃、天穹の谷の南天門一帯で地震が多発しているという報告を受けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220108,
					"content": "最初は小さな揺れだったんだが、ますます大きくなっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220109,
					"content": "少し前に、特に強い地震が1回起きて、山と遺跡の一部が崩壊した。その後、巨大な洞窟が現れたという報告を受けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220110,
					"content": "報告書によると、そこで未知の魔物に遭遇したらしい。それは、過去に混乱を引き起こした「ヴィシャップ·岩」と「エンシェントヴィシャップ·岩」の可能性がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220111,
					"content": "どうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "その天穹の谷の洞窟に行って、地震の影響を調査してきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220113,
					"content": "それと魔物の状況も。もし大規模に出現してしまったら、早急に対策を練る必要があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220114,
					"content": "もちろん、これも協会の正式な依頼とする。終わったら報酬も渡すよ、引き受けてくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220115,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "では頼んだよ。調査に行く時は、十分気を付けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "治平"
				}
			]
		},
