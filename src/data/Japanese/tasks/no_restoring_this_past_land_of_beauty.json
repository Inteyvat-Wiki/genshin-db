						710220212
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220212,
					"content": "もちろん、これも協会の正式な依頼とする。終わったら報酬も渡すよ、引き受けてくれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220213
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220213,
					"content": "その表情…何かあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220214
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220214,
					"content": "前に行ったことある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220215
					]
				},
				{
					"id": 710220215,
					"content": "もう行ったことあったのか？さすが優秀な冒険者だ、異常に対する勘が鋭い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220216
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220216,
					"content": "天穹の谷の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220217
					]
				},
				{
					"id": 710220217,
					"content": "…巨大な遺跡空洞、そして洞窟の中のエンシェントヴィシャップ·岩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220218
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220218,
					"content": "大体理解したよ、情報ありがとう。書面にまとめたら、正式に協会に報告する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220219
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220219,
					"content": "あれはどういうところなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220220
					]
				},
				{
					"id": 710220220,
					"content": "書物によれば、天穹の谷にある遺跡は、はるか昔に栄えた街だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220221
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220221,
					"content": "今みたいになってしまったのは、古代のある龍王の動乱によるものだったようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220222
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220222,
					"content": "動乱については詳しく記載されていなかったが、噂によると、最後は帝君と仙人たちによって洞天の檻に閉じ込められたらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220223
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220223,
					"content": "そして龍王の眷属は地下に逃げ、深い眠りにつき、龍王が復活する日を待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220224
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220224,
					"content": "出現した魔物って、まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220225
					]
				},
				{
					"id": 710220225,
					"content": "あはは、あくまでも伝説だから、本当かどうかは分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220226
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220226,
					"content": "でも頻繫に起こる地震や、突然現れた魔物に対しては、ちゃんとした対策を練る必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220227
					],
					"speakerTitle": "治平"
				},
				{
					"id": 710220227,
					"content": "そうだ、この報酬を受け取ってくれ。情報を提供してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "治平"
				}
			]
		},
