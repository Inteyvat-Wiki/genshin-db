					"紀芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "いらっしゃい、どんな本をお探しで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130202,
					"content": "『珠玉の鉱山』がほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "『珠玉の鉱山』？ここには置いてないわ…すぐに必要なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130204,
					"content": "群玉閣再建について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "え？群玉閣が再建されるの？それは確かに準備が必要ね。うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130206,
					"content": "清昼に聞いてみるのはどう？清昼は読書家だから『珠玉の鉱山』の在処を知っているかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718130207,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "清昼はいつも望舒旅館にいるはずよ。そこに行くといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
