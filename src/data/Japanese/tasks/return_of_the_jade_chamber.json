			"dialogs": [
				{
					"id": 718130801,
					"content": "こんにちは、また何か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130802,
					"content": "準備した物資について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "これは…『珠玉の鉱山』、どこで見つけたのです？璃月中を探してもなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130804,
					"content": "清昼が書き写した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "あの詩人が？噂通りの腕前ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130806,
					"content": "準備を手伝ってくれてありがとうございます。ルーじいさんの置物が届いたら、こちらでお支払いをします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130807,
					"content": "群玉閣再建について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "群玉閣再建の計画は既に動いていますが、必要な物も作業もとても多いです。すぐには完成しませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130809,
					"content": "それに材料についての問題は、今でも解決策がありません。困りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 718130810,
					"content": "はあ、仕方ないですけどね。準備を手伝ってくれてありがとうございます。これを受け取ってください。私は仕事に戻ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百聞"
				}
			]
