			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "難しい、非常に難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130302,
					"content": "『珠玉の鉱山』について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "『珠玉の鉱山』？あぁ、その本は知っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130304,
					"content": "前に商い事に関する詩を書こうと思い、各地を取材していた時に偶然読んだことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130305,
					"content": "本の内容は全て理解できたわけではないが、それでも詩のヒントを得られたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130306,
					"content": "どんな詩を書いたんだっけな、今思い出すから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130307,
					"content": "本の場所は覚えてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "本を探しているのかい？場所はもう覚えていないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130309,
					"content": "だが、急ぎで必要なら書き写してあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130310,
					"content": "書き写す？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "はあ、そんなに厚い本でもないからね、覚えるのは簡単だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130313,
					"content": "それにあの時、『珠玉の鉱山』の持ち主が本を貸してくれなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130314,
					"content": "詩は一朝一夕で書けるものではない…仕方なくその場で本を書き写したんだ。内容も多くないし、それでほぼ暗記してしまったのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130315,
					"content": "これが詩人の実力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "大したことないさ。ただ…本を書き写してあげる代わりに、一つ頼まれてくれないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130317,
					"content": "恥ずかしいことに、食事も忘れるほど取材に夢中になっていたんだ。少々お腹が減ってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130318,
					"content": "「璃月三糸」を1つ持って来てくれないかな。私はここで『珠玉の鉱山』を写すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130319,
					"content": "君が戻って来る頃には、本も完成しているさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130311,
					"content": "全部覚えたのか！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
