			"dialogs": [
				{
					"id": 718130601,
					"content": "うん？何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130602,
					"content": "竹製の置物がほしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "竹製の置物？作れるが、これは誰からの注文書だ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130604,
					"content": "百聞から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "はあ…月海亭の注文か。よし、なるべく急ぎで作るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130606,
					"content": "だが、わしがよく材料を集めに行く竹林に、なぜかイノシシが大量に出るようになってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130607,
					"content": "危険はないが、いつも回り道をして竹を取らねばならんのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130608,
					"content": "お前さんたちがイノシシを追っ払ってくれるなら、今すぐ竹を取りにいけるのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "ルーじぃ"
				},
				{
					"id": 718130609,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "ではここで待ってるぞ。イノシシを追っ払ったら教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルーじぃ"
				}
			]
		},
