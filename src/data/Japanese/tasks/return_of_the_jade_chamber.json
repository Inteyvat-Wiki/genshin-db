			"dialogs": [
				{
					"id": 718130501,
					"content": "「そうすれば、璃月の発展は保たれる。革新に急ぐのではなく、ゆっくりと…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130502,
					"content": "戻って来たのか。少し待ってくれ、あと数行で終わる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130503,
					"content": "うん…よし、完成だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130504,
					"content": "「璃月三糸」だよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "それより、完成した本を見てくれ。書道には自信があってね、字もそれなりに読めるものになっているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718130506,
					"content": "これが詩人の実力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "ははは、大げさな。この本は君にやろう、失くさないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
