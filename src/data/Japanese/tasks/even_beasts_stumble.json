			"trigger": {
				"objectNames": [
					"エルバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "はぁ…はぁ…ありがとう、旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850102,
					"content": "無事でよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "俺はエルバー、商人だ。ここで休憩しようと思っていたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850105,
					"content": "まさか、突然ヒルチャールに襲われるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850106,
					"content": "護衛はつけてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "そうだ、オイラたちシティで聞いたぞ。商人たちが荷物を運ぶために外出するときは、大抵「エルマイト旅団」を助っ人として雇うって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850109,
					"content": "いや、お、俺は…モラがもったいないと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850110,
					"content": "「エルマイト旅団」の連中は、どいつもこいつも法外な値段を吹っかけてくるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850111,
					"content": "俺はしがない商人だから、そんな金額は払えない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850112,
					"content": "俺だって武術をかじったことはあるし、目的地までそんなに距離もないから、いっそ一人で出発しても問題ないと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850113,
					"content": "でも、ヒルチャールが襲ってきたときに、俺が連れていた二頭の駄獣が驚いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850114,
					"content": "俺が反応するより先に、片方の駄獣に地面に倒されたあげく、起き上がった直後に、もう片方の駄獣に蹴りつけられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850115,
					"content": "うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850116,
					"content": "それから二頭の駄獣が逃げてしまって、ヒルチャールに囲まれる羽目になったんだ…君たちが助けてくれてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850117,
					"content": "ただ…俺の全財産は、その二頭の駄獣に載せてあるんだ…旅人、頼む。あいつらを連れ戻してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850118,
					"content": "け、蹴られたくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "いや、大丈夫だ、その心配はしなくていい。あいつらはもともと大人しい性格なんだ。今回こんなことになったのは、ヒルチャールに食べ物の皿をひっくり返されたせいなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850121,
					"content": "荷物を載せて長い距離を歩いて、二頭とも腹ペコだったのに…食べ物の皿をひっくり返されたりしたから、余計に怒ったんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850122,
					"content": "なるほどな…食事時に邪魔されて、しかも皿をひっくり返されたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850123,
					"content": "むむむっ、考えただけでもムカつくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850124,
					"content": "パイモン、理解が早い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "こうしよう…ほら、この食べ物を持って行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850126,
					"content": "駄獣を見つけたら、この食べ物を食べさせてやってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850127,
					"content": "食べ物さえあれば、あいつらも怒ったりはしないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850128,
					"content": "さっき横目で見ていたんだが、駄獣の一頭はヒルチャールを跳ね飛ばして、遠くへ逃げていって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850129,
					"content": "もう一匹はヒルチャールに捕まって連れて行かれたみたいだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850130,
					"content": "二頭の駄獣が消えていった大体の方向をマークしてやるから…この件は頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850131,
					"content": "荷物さえ取り戻してくれたら、豊富な報酬を支払うから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850119,
					"content": "ぶ、ぶつかってこないか心配…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "守ってくれる人はいないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "お安い御用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
