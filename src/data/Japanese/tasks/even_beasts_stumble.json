			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "この駄獣…なんか機嫌が悪いみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850502,
					"content": "おい、あいつのひづめを見てみろよ、すごく頑丈そうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850503,
					"content": "あれに蹴られたら、普通の人は気絶しちゃうかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850504,
					"content": "パイモン、食べ物を持って行ってあげて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "お、おまえが行けよ！ほら、早く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850506,
					"content": "ごゆっくり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "ひづめを悪く言うつもりはない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "駄獣はゆっくりと食べ物を食べた。そのひづめも少し落ち着いたようだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "そんなに怒ってないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850509,
					"content": "早く連れて帰ろうぜ。蹴られないように気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731850511,
					"content": "駄獣と一緒にエルバーさんのところへ戻った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "よかった…この駄獣が本当にいなくなったらどうしようかと思った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850513,
					"content": "ありがとう、旅人。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "エルバー"
				},
				{
					"id": 731850514,
