			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "すまなかったな。本当のことを言えなくて、申し訳ないと思ってる。だが…そうせざるを得なかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551602,
					"content": "理解してるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "ところで、心海はこのことを知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "珊瑚宮様は…今言えるのは、戦争は多くの悪いことをもたらしたが、俺たちを大きく成長させたということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551605,
					"content": "だから、心海は知っていたのか、どうなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 190551606,
					"content": "それは…お前たちは法案を推したのは誰か、気にならないか？勘定奉行は得をしないし、手を貸す者がいなけりゃあり得ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551607,
					"content": "確かになんだか、神の救いの手が突然現れたような感じだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 190551608,
					"content": "ははっ、神か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551609,
					"content": "少し前、鳴神島で容彩祭が開催されたとき、俺と珊瑚宮様も招待された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551610,
					"content": "その時、俺は市場で待っていたが、珊瑚宮様は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				}
			]
		},
