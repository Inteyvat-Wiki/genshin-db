			"dialogs": [
				{
					"id": 190551701,
					"content": "神子に会いに行ったよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "その通り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551802,
					"content": "彼女は勘定奉行に行き、あの宮司の八重神子と会談を行った。名目上は娯楽小説の鑑賞会だったが、その内容は公開されていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551803,
					"content": "珊瑚宮様は帰ってすぐに貿易や通商の促進施策を始め、鳴神島ではすぐに新しい法案を推し進めることになった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 190551804,
					"content": "それで…珊瑚宮様はこのことをご存知ないと思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴロー"
				}
			]
		},
