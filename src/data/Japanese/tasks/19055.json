			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"徳田",
					"轟",
					"将司"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "轟さんの情報は正しかった。俺たちが到着したとき、野伏衆たちはまだ寝ていたぜ、ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "徳田"
				},
				{
					"id": 190551002,
					"content": "品物も全部回収できた、正に一網打尽ってやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "徳田"
				},
				{
					"id": 190551003,
					"content": "よし、数えてみよう…うん…問題ない、ご苦労だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "轟"
				},
				{
					"id": 190551004,
					"content": "とんでもない。轟さんの商隊が頑張ってくれたおかげで、村じゃ食糧の値が下がったんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "徳田"
				},
				{
					"id": 190551005,
					"content": "その通り。特に俺たちみたいなよく負傷する連中は、戦争の後遺症がこんなにひどいとは思わなかった。幸い、轟さんが持ち帰って来てくれた薬のおかげで救われてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "将司"
				},
				{
					"id": 190551006,
					"content": "上からの支援のおかげで、状況はよくなって来てるんだ。そうだ、村の在庫状況はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "轟"
				},
				{
					"id": 190551007,
					"content": "今夜中に確認してくれ。明日の朝、珊瑚宮でゴロー様の許可を得たら、すぐに出発するからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "轟"
				},
				{
					"id": 190551008,
					"content": "心配ない、リストは整理してある。俺たちと一緒に来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "将司"
				}
			]
		},
