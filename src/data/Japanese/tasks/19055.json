			"dialogs": [
				{
					"id": 190550901,
					"content": "轟さん。商品が届いたから、棚卸ししてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "徳田"
				},
				{
					"id": 190550902,
					"content": "おう、今行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "轟"
				},
				{
					"id": 190550903,
					"content": "轟…うっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 190550904,
					"content": "しー！声出さないで。こっそり着いて行くんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
