				"objectNames": [
					"ジェイド",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "ごめん…まだ気持ちの整理がうまくできなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 730552602,
					"content": "謝らないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "そうだぞ…ジェイドが悲しいのは、みんな知ってるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730552604,
					"content": "ありがとう…これからの旅がうまくいくことを祈ってるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 730552605,
					"content": "ああ…ジェイドもこの先すべてうまくいくといいな…絶対に！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
