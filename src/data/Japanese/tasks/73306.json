			"trigger": {
				"objectNames": [
					"ティルザード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "…君たちか、まだ何か話したいことがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552502,
					"content": "ジェブライラについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "…私は最後まで彼を疑ってしまった。私はなんてバカなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552504,
					"content": "今は彼に感謝しかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552505,
					"content": "私はずっと揺らいでいた。学術においても、生活においても…だが、これからはもう迷わない。私は信じる道を歩く。たとえそれが茨の道でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552506,
					"content": "ジェブライラを弔うためにも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552507,
					"content": "キングデシェレトについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "今まで読んできた文献の真偽を疑い始めたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552509,
					"content": "あの「祈祷文」には…言い知れぬ妙な感じがあった。それにサミエルの…あの言葉…戻ったらもう一度じっくり研究する必要があるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552510,
					"content": "もちろん、最優先すべきタスクは計画通りに論文を書き上げることだがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552511,
					"content": "ジェイドについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "はぁ…私だって何かしてやりたい。しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552513,
					"content": "私には何もできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "ティルザード"
				},
				{
					"id": 730552514,
					"content": "彼女も何も言ってくれなかった。彼女が望みを言ってくれれば、私のできる範囲で何でもするのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティルザード"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
