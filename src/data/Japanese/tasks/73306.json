			"trigger": {
				"objectNames": [
					"ボニファズ",
					"ナハティガル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "オーミドとミルサドが見当たらないな。もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "ボニファズ"
				},
				{
					"id": 730552702,
					"content": "彼らなら無事だ。ただ…互いに自分の計画があって、俺たちと駄獣の商売をできなくなったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "ナハティガル"
				},
				{
					"id": 730552703,
					"content": "なに？じゃあ、どうするんだ？俺たち二人じゃ人手不足だろう。人を増やそうにも…アアル村まで喜んで来るようなやつなんて、そうそういないと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "ボニファズ"
				},
				{
					"id": 730552704,
					"content": "まあ、その話はまた後にしよう。それよりサイリュスが無事に戻って来てよかった。今度はあんな危険な場所にはもう行かせない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "ボニファズ"
				},
				{
					"id": 730552705,
					"content": "冗談言うなよ？俺たちは駄獣の商人だぞ。駄獣を働かせないで、どうやって食っていくつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "ナハティガル"
				},
				{
					"id": 730552706,
					"content": "風だけじゃ腹は膨れないぞ。それに、こんなところで口を開けてみろ、入ってくるのは砂ばっかだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "ナハティガル"
				},
				{
					"id": 730552707,
					"content": "それでも、サイリュスを危険な目に遭わせるのはよくない。お前、丈夫そうじゃないか。代わりにお前が荷物を運べばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "ボニファズ"
				},
				{
					"id": 730552708,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナハティガル"
				}
			]
		}
