				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "おや、写真を撮りに来たのかい？前も、外国から来た観光客がいて、写真を撮りたがってたんだ。海に浮かぶ島は絶景だからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270102,
					"content": "あの時は残念ながら写真機がなくてね。わざわざ知り合いの外国の商人に頼んで調達したのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270103,
					"content": "お客さん、写真はいかがかな？ただ、私はあまり上手くないのでね、自分で撮ってもらわないといけないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270104,
					"content": "なんか変。海に霧が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "海に霧？なに言ってるんだ？ここは海風が強いから、霧なんて立つわけないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270106,
					"content": "生まれてこの方、海に霧が立ち込めるのは見たこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270107,
					"content": "もしかして、テスカテペトン山脈の下の、あの霧に覆われた場所と勘違いしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270108,
					"content": "たぶん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "はは、お客さん、肩に力を入れすぎだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 751270110,
					"content": "ナタに観光に来たんだろう？もっとリラックスしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サカウ"
				}
			]
		}
	]
