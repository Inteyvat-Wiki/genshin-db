			"dialogs": [
				{
					"id": 752460101,
					"content": "おい見ろ、誰かいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460102,
					"content": "あれ？この後ろ姿は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "オロルンとイファじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460104,
					"content": "#聞き覚えのある声…{M#じいちゃん}{F#ばあちゃん}とパイモンか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460105,
					"content": "よう、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460106,
					"content": "久しぶりだな。あんたらまでリゾートに来てたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460107,
					"content": "チャスカからおまえたちがリゾートで働いてるとは聞いてたけど…ここで会えるとは思わなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460108,
					"content": "同感だ。ここはいい場所だな。みんなも楽しく遊べてるみたいでよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460109,
					"content": "へへっ、もっともっと盛り上がって、いっぱい観光客が来るといいよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460110,
					"content": "仕事のほうはどうなんだ？順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460111,
					"content": "ああ、竜のスタッフもミツムシも健康そのもの、元気いっぱいだ。おかげさまで、俺たちもあちこち見てまわれそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460112,
					"content": "…スタッフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460113,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460114,
					"content": "「竜のスタッフ」と「ミツムシのスタッフ」、だ。「スタッフ」が一つ漏れていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460115,
					"content": "そうだぞ、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460116,
					"content": "ああ…それはすまなかった。全てのスタッフと、スタッフのために奔走してる「オロルンさん」に敬意を払わないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460117,
					"content": "早くから動いて、大事な事のために闘う——僕たちはこうあるべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460118,
					"content": "初めて正式な招待状を貰ったもんだから、舞い上がってるんだ。気にしないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460119,
					"content": "熱心なのはいいこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#ほら、{M#じいちゃん}{F#ばあちゃん}もこう言ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460121,
					"content": "カクークが教えてくれたんだ。大切にしなくてもいい日なんてない——毎日大切なものを守るために仕事をするんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460122,
					"content": "ははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460123,
					"content": "でも…魚を釣ってるようにしか見えないぞ？釣りが「大切なものを守るための仕事」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460124,
					"content": "なにデタラメ言ってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460125,
					"content": "ああ、ある友人に釣りを勧められたんだ。彼はモンドの有名な冒険家で、すごく運がいいんだ…彼の言うことを聞いておけば間違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460126,
					"content": "（まさか…ベネット？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "そいつの投げた木の枝が、この池を指し示した。オロルンが「あれこれ悩むより導かれるがままに進んだ方がいい」っていうもんだから、こうして釣りしてるわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460128,
					"content": "なるほどな…でもさっきからずっとツッコミたかったんだけど…池の周りがカピバラだらけだぞ！こんなところで本当に釣れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460129,
					"content": "大丈夫だ。カピバラは温厚な性格で、めったに攻撃してこない。ばあちゃんも「水場があるなら釣りをしろ」と言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460130,
					"content": "ばあちゃんは「飯があったら食え」「長いものがあったら巻かれろ」とも言ってたけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460131,
					"content": "#{M#じいちゃん}{F#ばあちゃん}とパイモンも、せっかくだから長いものに巻かれていかないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460132,
					"content": "一番大きい魚を釣り上げたら、こいつの蜜酒がもらえるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460133,
					"content": "わぁ！それを早く言えよな♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460134,
					"content": "へへっ、ここで会ったが百年目…売られた勝負は受けて立つ！旅人が相手だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460135,
					"content": "きょうだい、勝負だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "やる気満々だな。じゃあ付き合ってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460137,
					"content": "かわいい孫と釣りでもしようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "ああ。ミツムシのスタッフが作ったお酒と全ての魚を賭けて、勝負だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オロルン"
				}
			]
		},
