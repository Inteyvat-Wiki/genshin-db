			"dialogs": [
				{
					"id": 752460384,
					"content": "#まずは一番年長の、{M#じいちゃん}{F#ばあちゃん}から。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460385,
					"content": "それじゃ、いくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "おっ、開始早々、絶好調の旅人！華麗な必殺技で、見事に大物を引き上げた！空中にきれいな弧を描いたのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460302,
					"content": "えっと…ア…シャ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460303,
					"content": "いきなりやるな…早速既存の判断基準から外れた獲物を釣り上げるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460304,
					"content": "#流石{M#じいちゃん}{F#ばあちゃん}だ！他のメンバーがもっと特別なものを釣り上げない限り、これが優勝でいいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460305,
					"content": "ありがとう！可愛い孫の言う通り、これで優勝できるといいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "幸先のいい好成績！これは、後の二人にプレッシャーがのしかかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460307,
					"content": "イファ選手、用意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460308,
					"content": "がんばれ、きょうだい！手を貸せ、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460309,
					"content": "すまない、カクーク。今は手を貸せる場面じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460310,
					"content": "二人とも落ち着け…おっ、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460311,
					"content": "イファは全力で竿を引っ張った。どうやら大物が釣れたようだ。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "しかし、浮かび上がってきたのは…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "えっと…イファ選手が釣り上げたのは…コホラ竜…カピバラ付き？なんでこいつら一緒に揚がってきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460314,
					"content": "さすがだ。ここでも動物に好かれてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460315,
					"content": "待て、このコホラ竜の尻尾、何かおかしいぞ…もしかして、水底の石に引っかかっていたところを、カピバラが助けようとしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460316,
					"content": "カピバラがコホラ竜のしっぽを食べようとしていたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460317,
					"content": "それはないだろ、きょうだい。カクーク、聞いてみてくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460318,
					"content": "うん、うん…あってたぞ、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460319,
					"content": "な、俺の言う通りだっただろ…って、そんな場合じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460320,
					"content": "イファはコホラ竜の尻尾を素早くチェックした。幸い、軽いかすり傷だけで、特に問題はなかった。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "簡単に消毒し、薬を塗ると、コホラ竜とカピバラは共に去っていった。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "友達ができたのか。今日はあいつらにとっても「ツイてる日」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460323,
					"content": "あいつらにとって「も」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460324,
					"content": "ああ、勝てる予感がする。次は僕が「闘う」番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460325,
					"content": "手を貸せ！きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460326,
					"content": "一体どこでそんな言葉を学んだんだ…俺たちを応援してるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460327,
					"content": "カクークは釣りのチアリーダーだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "僕たちは闘っているのだから、「闘いのチアリーダー」というべきだ。そっちの方が壮大…うっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460329,
					"content": "何だ！？みんな避けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460330,
					"content": "ちょっと様子が変だけど…またカピバラだ！穏やかな性格だとか言ってた割に、やる気満々みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460331,
					"content": "こいつもきっと大事なことのために闘ってるんだろう。僕にはわかる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460332,
					"content": "…うん？何かおかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460333,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 752460334,
					"content": "機嫌が悪いみたいだ。闘わなければいけないのは僕たちの方らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460335,
					"content": "おお、友よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460336,
					"content": "——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 752460337,
					"content": "ははっ！最高だな、きょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460338,
					"content": "ど、どういうことだ？カクークはなにをいってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460339,
					"content": "なだめてるみたいだな。こう見えても、カクークは患者の気持ちを落ち着かせるのが得意なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460340,
					"content": "なるほど。でも、カクークの語彙力で大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460341,
					"content": "パイモン、そもそも人間の言葉はカピバラに通じない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460342,
					"content": "あれ？確かに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460343,
					"content": "こういう時は、きょうだいを信じるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460344,
					"content": "それに、コミュニケーションにおいては内容よりも声のトーンのほうが大事だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460345,
					"content": "例えば、「こんにちは」。これは嬉しがってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460346,
					"content": "「こんにちは」…は困ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460347,
					"content": "「こんにちは」！これは怒ってる。一般的に、危機が迫ってるから、避けなければいけないと感じさせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460348,
					"content": "なんとなくわかったけど、それだけで伝わるとは思えないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460349,
					"content": "勉強になった。ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "本当か？それなら嬉しい。僕もいつもこうしてミツムシとコミュニケーションを取ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460351,
					"content": "「スタッフ」、だろ。「ミツムシのスタッフ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460352,
					"content": "スタッフになりたくないミツムシだっている。僕は彼らの気持ちや選択も受け止めるし、尊重する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460353,
					"content": "…じゃあ、今は俺のこの複雑な心境を理解してほしいところだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460354,
					"content": "何故だ？誇りに思うべきなんじゃないか？ほら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460355,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 752460356,
					"content": "ははっ！だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460357,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 752460358,
					"content": "マジかよ！マジかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460359,
					"content": "ずいぶん盛り上がってるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460360,
					"content": "誇りに思わないこともないけど…って、えっ？おい、オロルン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460361,
					"content": "心配するな。何とかする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460362,
					"content": "こんにちは、カピバラキング。お菓子を食べないか？イファが作った、出来立てのクッキーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460363,
					"content": "ウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "カピバラ"
				},
				{
					"id": 752460364,
					"content": "カピバラキング？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460365,
					"content": "食べた！嬉しそうにしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460366,
					"content": "やれやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460367,
					"content": "ところで、オイラたち釣り大会をやってたはずだよな。もはや、動物園みたいになってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460368,
					"content": "それもいいんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "それもそうだな…じゃあ、今回の釣り大会の優勝者は、オロルンってことでいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460371,
					"content": "なんたって…あの「カピバラキング」を釣ったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460372,
					"content": "いい名前だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "はぁ、オロルンでいいや。どうせ誰も魚を釣れなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460374,
					"content": "ははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "カクーク"
				},
				{
					"id": 752460375,
					"content": "それじゃあ、蜜酒は僕のものだな。やった…って、元々僕のものじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460376,
					"content": "持ってたものを守り抜けたのも、ある意味「ツイてる」んじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460377,
					"content": "確かに。それに、ほかにも収穫があった。ほら、カピバラキングからの贈り物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 752460378,
					"content": "「キラキラエッグ」と一枚の写真か。この場所、なんとなく見覚えがあるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460379,
					"content": "オイラたちにここに行って欲しいのか？なんかそんな感じがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752460380,
					"content": "探してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "俺もそう思ってたところだ。みんな、写真に映ってる場所を覚えといてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460382,
					"content": "#いいものが待ってるといい{M#な}{F#ね}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "何があるかわからない…念のため、準備は万全にしていこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イファ"
				},
				{
					"id": 752460369,
					"content": "和やかでいい。",
					"roleType": "TALK_ROLE_PLAYER",
