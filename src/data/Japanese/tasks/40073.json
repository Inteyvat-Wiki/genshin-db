				"points": []
			},
			"dialogs": [
				{
					"id": 400731301,
					"content": "あんちゃん、こんな調子でこれから先、どうやって外を歩くつもりだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731302
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731302,
					"content": "旅には体力と胆力、それから危機意識が必要でござる。体力と胆力が身についたら、危機意識を高めるといいでござろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731303
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731303,
					"content": "皆さんのお言葉、しかと胸に刻みます。でも今度こそ、本当にお別れです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731304
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731304,
					"content": "気づきましたか？空は晴れ、海面は穏やかで美しい姿を見せています…このような日を迎えるために、私たちは長いこと待ち続けてきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731305
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731305,
					"content": "皆さんは、私のようなうっかり者が役者になれるのかと、疑問に思ったことでしょう。でも信じてください。これは決して偶然手にしたわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731306
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731306,
					"content": "夜鴉は常に仕事を探しています。仕事、すなわち運命です。私たちは、自分が果たすべき役割を見つけるため生まれてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731307
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731307,
					"content": "あなたたちはまだご存知ないかもしれませんが、『聖国の詠唱』とは実は預言書なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731308
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731308,
					"content": "預言書？あれって、おまえたちの聖典じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731309,
					"content": "ええ、そうです。数百年前、幽夜浄土が不吉な気配に覆われた時、私たちの主は国を治めることに興味を失ったかのように、何も行動を起こしませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731310
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731310,
					"content": "その後のことです。ある日、大書記官オズが姿を現しました。彼は聖典と心震わす預言をもたらしたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731311
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731311,
					"content": "その預言は、本に書いてあった通り、幽夜浄土の真の幸せが何なのかを示すものでした。だから、私たちはいずれ暗雲が消え去ると確信し、今もその日が訪れるのを心から待っているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731312
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731312,
					"content": "救世主…皇女殿下よ。彼女はきっと、ここがどんなに幸せな場所だったかを思い出してくれます。彼女のためにも、私たちは預言の通りに劇を捧げるつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731313
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731313,
					"content": "だから私は立ち上がり、勇士を演じることにしました。幾多の苦難を乗り越え、剣の山と火の海を渡り…彼女に、私の真心を捧げるために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731314
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731314,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731315
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731315,
					"content": "あ、あなたは…皇女殿下！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731316
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731316,
					"content": "ああ。さっきおまえを助ける時、なぜか後ろに隠れてたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731317,
					"content": "我が臣下よ、汝の意志は邪龍の手足を断つに足る強さである。今、我は汝の祝福を受けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731318
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731318,
					"content": "大変光栄に思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731319
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731319,
					"content": "汝はよくやった。騎士の美徳も備えている。さあ行け、準備をして劇の開幕を待つがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731320
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731320,
					"content": "皇女殿下へと捧げる敬虔な心を、私は誇りに思います。幽夜浄土全土を覆う暗雲は、皇女殿下率いる従者の私たちが必ずや晴らしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731321
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731321,
					"content": "…ありがとうございます、殿下、それに英雄たちも！それでは、私はこれで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731322
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731322,
					"content": "あっ、そうだ。もし必要でしたら…この先の扉の合言葉は「永夜の序曲」です。覚えておいてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731323
					],
					"speakerTitle": "レオン"
				},
				{
					"id": 400731323,
					"content": "オイラ、訳がわからなくなってきた…えっと、なんの芝居をやってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731324,
					"content": "この場にいる者は、誰一人としてわたくしの至言を理解できないのかしら？愚昧ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731325
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731325,
					"content": "お嬢様は、皆様が馬鹿である、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731326
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731326,
					"content": "それは訳さなくても分かります！それから誰がお馬鹿なのかも、よく分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731327
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731327,
					"content": "ふむ、皇女殿下が前に言っていた「用事」とは、このことでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731328
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731328,
					"content": "なら急ごうぜ！行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731329
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731329,
					"content": "えっ？待てって、いったいどうなってるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007315,
			"completionStepIds": [
				4007315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007315",
							"2"
						],
						"stepId": 4007315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ",
					"フィッシュル",
					"幽夜フィッシュル",
					"オズ",
					"辛炎",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731501,
					"content": "ここは、図書館？私たち、どうして図書館にいるのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731502
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731503
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731503,
					"content": "…ふん、苦心し探した我が宿敵よ——無為で軟弱な皇女とは、あなたのことかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731504
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731504,
					"content": "ばかばかしい。わたくしに勝てると思っているの？先ほどあなたから滲み出た恐怖と気の迷い、わたくしにははっきりと見えていたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731505
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731505,
					"content": "フィッシュルがもう一人いるぞ！あれって、おまえの影か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731506,
					"content": "影？ええ…確かにそういう関係ね。負けを認めにきたのかしら？エミちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731507
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731507,
					"content": "うっ…あなた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731508
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731508,
					"content": "そこの夜鴉はオズよね？よろしい、わたくしも長いこと待っていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731509
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731509,
					"content": "オズという大書記官が、『聖国の詠唱』を幽夜浄土に持ち込んだと聞いたわ。恐らく、あなたのことよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731510
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731510,
					"content": "…恐縮です、お嬢様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731511
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731511,
					"content": "なんで、あいつのことをお嬢様って呼ぶんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731512
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731512,
					"content": "ご覧の通り、あの方もお嬢様です。お嬢様である以上、私のご主人様でもあります。違いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731513
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731513,
					"content": "…筋は通っておるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731514
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731514,
					"content": "幽夜浄土とは、一度入れば二度と戻れない場所。ここに来たということは、わたくしの支配を受け、隷属するということよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731515
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731515,
					"content": "オズに至っては、わたくしを不快にさせる預言書を持ち込み、愚かな臣下たちにその茶番を信じさせた。とはいえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731516
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731516,
					"content": "オズであることに変わりはない、わたくしの傍に来なさい。「フィッシュルはオズと組まないと」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731517
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731517,
					"content": "お嬢様からそのように認めていただき恐悦至極です。それでは、お言葉通りそちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731518
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731518,
					"content": "オズ！？どこへ行くの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731519
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731519,
					"content": "向こうへ行っちゃいましたよ、フィッシュル。あなたが飼っていた鴉ですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731520
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731520,
					"content": "うぅうう——今はわたくしを非難してる場合じゃないでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731521
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731521,
					"content": "オズ、何を惑わされているの？彼女の言葉を信じないで。幽夜浄土は、自由と演劇の聖地でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731522
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731522,
					"content": "大間違いよ。幽夜浄土は、そんな遊園地のような場所ではないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731523
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731523,
					"content": "いい…ここは現実を直視できない人のための墓場なの。あなたはここに埋葬される。そして、わたくしは共に作り上げた想像上のオズと一緒に、永遠に王城で暮らすの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731524
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731524,
					"content": "…墓場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731525
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731525,
					"content": "あなたが一番知っているはずよ。なぜ幽夜浄土に雨が降っているのか。なぜこの楽土には本物の歌声がないのかを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731526
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731526,
					"content": "…あなたよ！全部あなたのせい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731527
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731527,
					"content": "ふふふっ、可笑しいわね。つまり、あなたのせいでしょ！エミちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731528
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731528,
					"content": "うぅ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731529
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731529,
					"content": "これほど壮大で虚構に満ちた王国を想像しておいて、結局は耐えられないのね。自分が創造したものに動揺して、いくら逃げようとも自分を変えられないなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731530
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731530,
					"content": "あなたがここに溶け込めないから、わたくしが降臨してその代わりを務めるの。幽夜浄土はもはやわたくしの物、あなたに指図する権利なんてないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731531
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731531,
					"content": "わ…わたくしは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731532
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731532,
					"content": "エミちゃん、あなたは軟弱な愚か者。この世界を支配するのにふさわしくないわ。出ていきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731533
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731533,
					"content": "おい、いい加減にしろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731534
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731534,
					"content": "見事に自分に罵倒されているようですね。あなた、ずっとこの件で悩んでいたのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731535
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731535,
					"content": "モナ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731536
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731536,
					"content": "何ですか、その顔は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731537
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731537,
					"content": "わ…わたくし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731538
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731538,
					"content": "ふん、まさか負けを認めるわけじゃないですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731539
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731539,
					"content": "…認めたくないけど…彼女の、言う通りかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731540
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731540,
					"content": "いや、考えを整理するでござる。皇女殿下、何故ここへ来たのか覚えておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731541
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731541,
					"content": "万葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731542
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731542,
					"content": "拙者は稲妻の剣客で、お主の安全を守るために。そして、ここにいる皆は、お主の呼びかけに応じてやってきた者でござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731543
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731543,
					"content": "自分の墓場を持つっていうのも、なかなかクールな響きだな。でも残念ながら、幽夜浄土は墓場なんかじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731544
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731544,
					"content": "辛炎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731545
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731545,
					"content": "…へぇ、友達ができたようね。でも、それでわたくしに勝てるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731546
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731546,
					"content": "わたくしはあなたにとっての恐怖と闇であり、長年逃れられなかった悪夢。わたくしを前に、あなたは何もできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731547
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731547,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731548
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731548,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731549
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731549,
					"content": "…違う。まだ…まだ負けてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731550
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731550,
					"content": "わたくしこそ、真の勝者よ！絶対にあなたを後悔させてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィッシュル"
				}
			]
		},
		{
			"id": 4007317,
			"completionStepIds": [
				4007317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007317",
							"2"
						],
						"stepId": 4007317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"幽夜フィッシュル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731701,
					"content": "あり得ない、あの悪夢のような図書館から抜け出せるなんて…下がりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731702
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731702,
					"content": "…今もまだ、わたくしが負けると思ってるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731703
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731703,
					"content": "あなた…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731704
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731704,
					"content": "あなたはわたくしのことを見下し、弱く小さいと思い込んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731705
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731705,
					"content": "確かに、そのような日々を過ごしていたこともある。だって…わたくしは現実を直視できない、毎日夢ばかり見ている臆病な人間だったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731706
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731706,
					"content": "けど、いま分かった。この幻境を目にした瞬間、あらゆるものを理解したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731707
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731707,
					"content": "そこにある息を呑むような幻象を見たかしら？壮大で美しい…それこそがわたくしの想像力であり、力の根源でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731708
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731708,
					"content": "あなたは傲慢に見えるわ——だって暗いものはいつだってそうだから。でも、それは間違っていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731709
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731709,
					"content": "あなたは完全な皇女じゃない。わたくしの影に潜む独りよがりのチリのような存在！あなたこそ負け犬で、足を引っ張っている張本人よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731710
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731710,
					"content": "くっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731711
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731711,
					"content": "軟弱ゆえにトゲだらけで、臆病ゆえに自暴自棄で誤魔化そうとしている。そんなあなたこそ…わたくしより弱い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731712
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731712,
					"content": "さあ、返してちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731713
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731713,
					"content": "な、なにを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731714
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731714,
					"content": "わたくしのものをよ！幽夜浄土、王城、民…それと、わたくしのもっとも大切な仲間、オズを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731715
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731715,
					"content": "ああ、お嬢様がこれほど流暢に立派なお言葉を話されるとは、真の皇女へと成長されたのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731716
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731716,
					"content": "よくもそんなことが言えるわね、この裏切り者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731717
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731717,
					"content": "いえ、お嬢様。私がもう一人のお嬢様に付いたのは、皆様にあることを証明するためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731718
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731718,
					"content": "ご存知の通り、私オズは断罪の皇女——フィッシュルに付き従います。お二人ともフィッシュル様なのであれば、どちらに付こうと問題はないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731719
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731719,
					"content": "しかし、私がもう一人のお嬢様に付いても、お嬢様は自身の身分を見失いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731720
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731720,
					"content": "なるほど、賢い立ち回りでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731721
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731721,
					"content": "わたくしの身分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731722
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731722,
					"content": "「フィッシュル」というのは、何を意味していると思いますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731723
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731723,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731724
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731724,
					"content": "これはお嬢様への質問です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731725
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731725,
					"content": "フィッシュルは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731726
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731726,
					"content": "人生の落伍者であり、恐れを抱く臆病者よ。空想の先にある嘘に塗れた、不完全な自分に向き合えない人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731727
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731727,
					"content": "いいえ、違います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731728
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731728,
					"content": "フィッシュルは…わたくし？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731729
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731729,
					"content": "おお、理解がお早いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731730
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731730,
					"content": "えっ？それだけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731731
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731731,
					"content": "そのほうが正しいのです、お嬢様。フィッシュルは、断罪の皇女ですが、いつもそうであるとは限りません。時に勇敢で誇り高く、時に臆病で弱いところもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731732
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731732,
					"content": "フィッシュルはまさにあなた自身です。高貴でありながら平凡であり、腕利きの冒険者なのに友達はあまりいない、不思議な王国の皇女殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731733
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731733,
					"content": "フィッシュルとは、臆病であって強き者。他人の戯言を恐れながらも、他人に畏敬されることを強く望んでいるお方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731734
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731734,
					"content": "そして何より…フィッシュルは常に心の中で自省をし、何度も自分に負けてきました。ですが、そのたびに立ち上がり、自らの歩みを止めてこなかった人です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731735
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731735,
					"content": "フィッシュルの名にふさわしい人物は、お嬢様を除いて他にいません。この名は複雑でありながら単純な記号であり、夢と自由の素晴らしさを指しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731736
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731736,
					"content": "追従する者がいようといまいと、エミちゃんこそがフィッシュルなのです。フィッシュル——すなわち、無意識に志言を心の中に書く賢き者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731737
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731737,
					"content": "…「我が民に自由を与え、古き法則に囚われぬように」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731738
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731738,
					"content": "幽夜浄土を作って私たちに居場所を与えてくれたこと、また潜在意識に従って『聖国の詠唱』を書き残し、いずれ光が訪れることを信じさせてくれたこと感謝いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731739
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731739,
					"content": "さあ、殿下、暗闇を受け入れ、元の姿に戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731740
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731740,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731741
					],
					"speakerTitle": "幽夜フィッシュル"
				},
				{
					"id": 400731741,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731742
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731742,
					"content": "うわぁ、ドレスのやつが消えたぞ！あれ…また現れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731743,
					"content": "どうやら、影が元の場所、つまりフィッシュルの心に戻ったみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731744
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731744,
					"content": "…ふふふふ、来たか、皆の者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731745
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731745,
					"content": "お？この感じ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731746
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400731746,
					"content": "おーほっほっほっ、我が臣下たちよ！聞こえたかしら、わたくしの呼びかけが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731747
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731747,
					"content": "うむ、聞こえたでござるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731748
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400731748,
					"content": "まったく、元気になった途端、すぐ騒がしくなるんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731749
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731749,
					"content": "オズの言う通り、今日はわたくしが真の心を取り戻し、幽夜浄土へと再び君臨する偉大なる刻。今を以て宣告する——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731750
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731750,
					"content": "——幽夜浄土へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731751
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731751,
					"content": "めでたしめでたし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4007318,
			"completionStepIds": [
				4007318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007318",
							"2"
						],
						"stepId": 4007318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィッシュル",
					"オズ",
					"モナ",
					"ドド通話機"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400731801,
					"content": "（今日は本当に素敵な日だわ。自分を取り戻すことができ、真の皇女になれた。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731802
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731802,
					"content": "（それに幽夜浄土が本当に現れるなんてね。とはいえ、心の中に潜むネガティブな感情が消えないことは理解してる。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731803
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731803,
					"content": "（大丈夫、この弱さを抱えながらでも戦っていける。だって、わたくしはもう気付いたから、手にしたものがこれほど特別で素晴らしいものだってことを。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731804
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731804,
					"content": "フィッシュル、外の劇場が完成したみたいだぜ。見に行かないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731805,
					"content": "パイモン殿、どうかお言葉にご注意ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731806
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731806,
					"content": "お、おお！わかった。皇女殿下、よかったら見に行ってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731807,
					"content": "ぷっ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731808
					]
				},
				{
					"id": 400731808,
					"content": "コホン！臣下の身でありながら、栄光ある偉大なこの皇女のことをあざ笑ったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731809,
						400731810
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731809,
					"content": "あざ笑ったわけじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				},
				{
					"id": 400731811,
					"content": "…ふふっ、ええ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731812
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731812,
					"content": "今日は幽夜浄土にとって記念となる日、思う存分楽しみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731813
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400731813,
					"content": "ふむ、お嬢様がおっしゃりたかったのは、皆々が持てる限りの熱意を捧げ、夜の聖地がこの世に降臨することを祝そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731814
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731814,
					"content": "いいから、フィッシュル語に逆翻訳しないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731815,
					"content": "…あははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731816
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731816,
					"content": "このような国でしたら…演劇もきっと面白いでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731817
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731817,
					"content": "私が気になる謎も、もうすぐ解けそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731818
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400731818,
					"content": "そうだ！オイラたち、まだやり残したことがあったよな。じゃあ、皇女殿下にオズ、またあとでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731819,
					"content": "承知しました。また後ほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731820
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400731820,
					"content": "もう一回、吟遊野郎に連絡してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731821,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731822
					]
				},
				{
					"id": 400731822,
					"content": "ドドコ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731823
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731823,
					"content": "ドドコ——ドドコ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731824
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731824,
					"content": "もしもし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731825
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731825,
					"content": "この声…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731826
					]
				},
				{
					"id": 400731826,
					"content": "聞いたことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731827
					]
				},
				{
					"id": 400731827,
					"content": "あれ？吟遊野郎じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731828
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731828,
					"content": "あの、誰ですか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731829
					]
				},
				{
					"id": 400731829,
					"content": "そっか、私たち会ったことなかったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731830
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731830,
					"content": "島の外にいる人と連絡したいんでしょ？でも、今はまだダメ。だから、あなたの通信を遮断させてもらったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731831
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731831,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731832,
					"content": "人に聞くより、まずは自分で調べて答えを見つけたほうがいいでしょ？「深き夢」を表す不思議な幻境は、人間の心の本質を映し出すものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731833
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731833,
					"content": "自分の目ですべて見極めてみなさい。物語が終わった時に、また感想を聞かせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731834
					],
					"speakerTitle": "ドド通話機"
				},
				{
					"id": 400731834,
					"content": "…通信が切れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731835
					]
				},
				{
					"id": 400731835,
					"content": "おい、今の誰なんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731836
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731836,
					"content": "おかしいぞ、なんで今の人、オイラたちと吟遊野郎の連絡を遮断できたんだ…？それに、どうしておまえの感想を聞きたいんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731837,
					"content": "うぅ…ダメだ、オイラにはまったく意味がわかんないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731838,
					"content": "#{M#俺}{F#私}にも理解できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731839
					]
				},
				{
					"id": 400731839,
					"content": "なんか怖くなってきたな。で…でも安心しろ、どんなことがあってもオイラがおまえを守ってやる。ずっとそばにいてやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400731840
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400731840,
					"content": "うん。この件は一旦内緒にしておこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731841
					]
				},
				{
					"id": 400731841,
					"content": "（さっきの人の言葉に悪意はこもってなかった。でも、何か詮索されていたような気がする。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731842
					]
				},
				{
					"id": 400731842,
					"content": "#（{M#俺}{F#私}から何の答えを得ようとしてるのか分からないけど、その前に…すべての物語を見届けないと。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400731810,
					"content": "#{M#君}{F#あなた}が元気になってよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400731811
					]
				}
			]
		}
	]
}