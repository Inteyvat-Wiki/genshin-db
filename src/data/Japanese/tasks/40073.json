				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"厳かな夜鴉",
					"凜とした目つきの夜鴉",
					"モナ",
					"フィッシュル",
					"オズ",
					"辛炎",
					"楓原万葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730201,
					"content": "待て！またお前たちか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730202
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400730202,
					"content": "なんだよ？オイラたち、皇女殿下の臣下だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400730203,
					"content": "いいや、でたらめを言うな！皇女殿下が、君たちのような小者を認めるはずがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730204
					],
					"speakerTitle": "凜とした目つきの夜鴉"
				},
				{
					"id": 400730204,
					"content": "はぁ？まったく、今の自分の発言に責任を持てますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730205
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400730205,
					"content": "もう一度言うが、皇女殿下が君たちのような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730206
					],
					"speakerTitle": "凜とした目つきの夜鴉"
				},
				{
					"id": 400730206,
					"content": "汝は今、誰のことを小者と言った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730207
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730207,
					"content": "皇女殿下にオズ様！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730208
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400730208,
					"content": "幽夜浄土の臣下たちにそのような無礼なことを言うとは、守衛の諸君は些か礼儀に欠けているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730209
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400730209,
					"content": "ふん。わたくしが自ら選び抜いた臣下たちを軽んじるとはね？早々に立ち去りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730210
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730210,
					"content": "しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730211
					],
					"speakerTitle": "厳かな夜鴉"
				},
				{
					"id": 400730211,
					"content": "しかしではない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730212
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730212,
					"content": "は、はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730213
					],
					"speakerTitle": "凜とした目つきの夜鴉"
				},
				{
					"id": 400730213,
					"content": "フィッシュルにオズ、おまえら戻ってきてくれたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400730214,
					"content": "ふん、ひとまず、そう思ってくれていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730215
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730215,
					"content": "お嬢様は、幻境には向き合いたくないが、時間をかけてここまで辿り着いたからには、皆様を見捨てるわけにはいかない、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730216
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400730216,
					"content": "モナが言ってた通り、この幻境に「向き合いたくない」んだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730217
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400730217,
					"content": "日記を誰かに覗かれてるような気分になるもんな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400730218,
					"content": "…ふん、浅はかね。もし、わたくしが容易く流されるような人物だったら、こんな立派な幽夜浄土、この世に存在していないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730219
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730219,
					"content": "お嬢様は、ここには別の問題がある、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730220
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400730220,
					"content": "問題？何かあったのでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730221
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400730221,
					"content": "…うっ…その話はまた後にするわ、まずは用事を済ませるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730222
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730222,
					"content": "さあ、行こうぜ。本はもう目の前だ、ぼーっとすんなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4007304,
			"completionStepIds": [
				4007304
			],
