			"trigger": {
				"objectNames": [
					"フィッシュル",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730401,
					"content": "ふん…壮大で脆く、巨大で臆病…驚天動地とはこのことね、気分が悪いわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730402
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730402,
					"content": "お嬢様は、これほど大仰な幻境は見たことがなく、本人も驚いている、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オズ"
				}
			]
		},
		{
			"id": 4007306,
			"completionStepIds": [
				4007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007306",
							"2"
						],
						"stepId": 4007306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィッシュル",
					"オズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730601,
					"content": "お城があるけど、なんだか形が不完全だな。フィッシュル、これっておまえのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400730602,
					"content": "うっ…少し考えさせてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730603
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730603,
					"content": "お嬢様、その必要はありません。これはかつて、お嬢様が悲しみのあまり手を滑らせて壊してしまった城のおもちゃかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730604
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400730604,
					"content": "オズ！それを言わないで！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730605
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730605,
					"content": "今、思い出したわ。わたくしの城は、二つの部分が欠けてしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730606
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400730606,
					"content": "ってことは、その欠けた二つの部分を探せばいいってことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
