			"dialogs": [
				{
					"id": 745300401,
					"content": "あっ、師匠！おかえりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300402,
					"content": "カチーナ、すごく嬉しそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "へへっ、今回の採掘で、すごくいい鉱石が見つかったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300405,
					"content": "ちゃんと磨いたら、キラキラの宝石になるかもしれないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300406,
					"content": "すごいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "うん！最初は何も見つからなくって、手ぶらで帰るところだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300408,
					"content": "でも、もうちょっとだけ頑張ってみよう、あともう少し、ほんのちょっとだけ…って粘ってみたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300409,
					"content": "そうやって何度も何度も掘り続けて、やっと見つけたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300410,
					"content": "外に出たら、もう日が沈みかけてた…一日中掘ってたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300411,
					"content": "さすがカチーナ、本当に根気強いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "わ、わたしを？えっと…わたし、写真機を向けられると緊張しちゃうから…うまく撮れるかわからないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300414,
					"content": "#でも、{NICKNAME}さんのお願いだから…頑張るよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300415,
					"content": "もう十分頑張ってるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "わかった…！じゃあ、任せるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 745300416,
					"content": "だから、そのままでいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "#そんな輝いてる{M#君}{F#あなた}を撮らせてくれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "何かいいことでもあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
