					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761190105,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190106,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761190107,
					"content": "こんにちは、ルオンノタル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190108,
					"content": "新しいゲーム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "うん、フラッグシップでこうやってコップを使って遊んでたのを見たから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190110,
					"content": "コップの中に宝石を入れて、テーブルの上で素早く動かした後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190111,
					"content": "どれに宝石が入ってるか相手に当てさせるってゲーム。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190112,
					"content": "この子たちは布の中に潜って遊ぶのが好きだから、魔女の帽子をちょっと改良して作ってみたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190113,
					"content": "かわいいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "月霊"
				},
				{
					"id": 761190115,
					"content": "「フラッグシップ」に行ったのか？気づかれなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761190116,
					"content": "「月神様の真似ごっこ。そっくりでしょ？」って言えば問題なし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190117,
					"content": "祈月の夜の技をしっかり使いこなしてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761190118,
					"content": "みんな信じてくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "うーん…半信半疑みたいだったけど、それ以上は聞いてこなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190120,
					"content": "演技が不自然だったのかな？今度ほかのところでも試してみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190121,
					"content": "変な知恵を植え付けちゃったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761190122,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 761190123,
					"content": "ルオンノタルが、隠れてる場所を当ててみてって。試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190124,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "じゃあ、フラッグシップと同じように賭け金として十万モラを預かるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190126,
					"content": "そこは真似しなくていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
