					"content": "…ふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761190104,
					"content": "楽しそうだな。",
