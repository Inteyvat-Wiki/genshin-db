			"trigger": {
				"objectNames": [
					"露子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}さん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330102,
					"content": "露子、珊瑚を採る準備は進んでるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330103,
					"content": "えっと、それがちょうど壁にぶつかっていまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330104,
					"content": "露子…悲しそうな顔してうつむいてるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330105,
					"content": "ちらちらこっち見てるし！わかりやすすぎだぞっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330106,
					"content": "さて…あなたたちも事情を理解したことですし、単刀直入に言いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330107,
					"content": "元々隠す気なかっただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330108,
					"content": "以前「月浴淵の鍵」を手に入れたことで、淵下宮もゆっくりと目覚めてきています。しかし、人手不足により調査がかなり遅れているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330109,
					"content": "今は特殊な時期ですし、鳴神島との関係がいつ穏やかになるかも分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330110,
					"content": "#じゃあ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}がいたところで意味は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "それは違います。伝統によれば、珊瑚を採るのにもっとも重要なのが、「勇者」の存在なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330112,
					"content": "まず拠点を作り、次に先祖の歩んだ道を「勇者」が探索できるよう支援する。そして、最後に試練を迎える、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330113,
					"content": "地道な策ですが、確実な方法です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330114,
					"content": "でも最近は人手不足で、探索できないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330115,
					"content": "そうですね、一番重要な「勇者」も、その髪の色さえ分かっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330116,
					"content": "ですが、私の直感が教えてくれたのです。それはずばり…金髪であると！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330117,
					"content": "うわぁ…面倒くさそうだな。絶対にやりたくないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330118,
					"content": "探索の道中、お宝を見つけることもできますよ。規則上、そういったものは珊瑚宮家に引き渡す必要がありますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330119,
					"content": "今回あなたが見つけたものに関しては、少しくらい目をつぶっても構いません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330120,
					"content": "少しじゃなくて、全部でお願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "英雄様！戦士様！救世主様！それは同意ということでよいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330123,
					"content": "オイラたちが、珊瑚宮のピンチを無視するわけにもいかないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330124,
					"content": "そう仰っていただけて何よりです。心海様から教わった話術で、こうも人の心を動かせるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330125,
					"content": "それに心海様は、あなたたちがまた私のところに戻ってくるのを予想していたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330126,
					"content": "ん？なんか言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330127,
					"content": "いえ、なんでもありません。私について来てください。お見せしたいものがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330128,
					"content": "この先の祭壇でお会いしましょう。祭壇は下にあります。もし見つからない場合は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330129,
					"content": "見つからない場合は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330130,
					"content": "南東の方角をお探しください。きっと見つかるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330121,
					"content": "心海とは仲がいいし、仕方ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"露子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "これは「鍵紋」といって、かつて淵下宮の通行紋章だったものです。通路が開かれている時にのみ、これが地上に浮かび上がります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330202,
					"content": "聞いた話では、これは淵下宮が目覚めた時に、海祇島の民へ送られた鍵だそうです。珊瑚宮の記録によると、鍵紋は全部で五つあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330203,
					"content": "海祇島では現在、そのうちの三つを手に入れました。すべて揃えれば、封印を解くことができるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330204,
					"content": "その三つの鍵紋は既に抜き取ってあり、海祇島の他の場所に置いてあります。またこれにより、障壁が再び起動しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330205,
					"content": "こうすることで好奇心旺盛な子供やファデュイのスパイ、鳴神島や外国の方が忍び込むのを防ぐことができるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330206,
					"content": "あっ、外国の方と言っても、もちろんあなたのことではありませんよ。あはは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330207,
					"content": "現時点では冒険者協会と連絡を取ることもできず、冒険者を通すわけにもいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330208,
					"content": "昔は、冒険者に探索させてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330209,
					"content": "歴史上、そのような記録があります。探索は彼らやあなたみたいな方が得意とする分野ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330210,
					"content": "おおっ！じゃあ、今回は横取りするようなやつがいないってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330211,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "はい…ただ臨時の障壁は不安定です。それに今回、鍵紋を抜き出すのに時間がかかったため、誰かがこっそり侵入している可能性もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330213,
					"content": "今は人手が不足している状況…もし下でファデュイや宝盗団、海乱鬼といった者に遭遇したら、構わずやっつけてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330214,
					"content": "もし、そいつらが簡単に侵入できるなら、オイラたちが月なんとか鍵を手に入れる意味なんてないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330215,
					"content": "淵下宮を目覚めさせるには、「月浴淵の鍵」を取るしか方法はありません。それと同時に、「月浴淵の鍵」を使って扉を開くことでしか、試練を発動させることはできないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330216,
					"content": "海祇御霊祭で淵下宮に行く必要がないのであれば、確かに抜け道を使っていたかもしれませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330217,
					"content": "とにかく、どうかお急ぎを。海祇島の他の「鍵紋」を取ってきていただければと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330218,
					"content": "鍵紋は「海神の鰭」と「海神の心」に置いておきました。その二つの祭壇は、それらと珊瑚宮を結ぶ線上、月浴淵の第二の山岳にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330219,
					"content": "では、いつもの場所でお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
