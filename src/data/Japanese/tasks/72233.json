				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "これより解封の刻となります。「月浴淵の鍵」をお持ちください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330302,
					"content": "もう一回言ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330303,
					"content": "「月浴淵の鍵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330304,
					"content": "もう三回言ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330305,
					"content": "「月浴淵の鍵」、「月浴淵の鍵」、「げつおくえんのかい」…うぅ、噛んでしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330306,
					"content": "やっぱり、その名前難しすぎると思うぞ。変えたほうがいいんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722330307,
					"content": "たとえ変えたとしても、その恩恵を受けるのは何百年も後の人たちです。今回は我慢してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330308,
					"content": "コホンッ…とにかく、儀式を始めます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330309,
					"content": "残念ながら、淵下宮の試練の詳細については不明です。あとはあなたの力に頼るほかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330310,
					"content": "神秘的な一面を頑なに守ろうとする伝統には、愚痴をこぼしたくもなりますが、仕方ないことでしょう。それでは、幸運をお祈りいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330311,
					"content": "それと、くれぐれも無理はなさらずに。安全第一ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
