			"dialogs": [
				{
					"id": 722330401,
					"content": "#{NICKNAME}さん、他に何か聞きたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330402,
					"content": "鍵紋について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "鍵紋は「海神の鰭」と「海神の心」に置いてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330404,
					"content": "実は私たちも少し動かしただけで、あまり触れてはいません。何せ、海神の傷もまた隠された場所にありますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330405,
					"content": "本当に、精一杯な状況だったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 722330406,
					"content": "祭壇について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "祭壇は北と真東の方角、月浴淵の第二の山岳にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330408,
					"content": "珊瑚宮から「海神の鰭」と「海神の心」を二つの線で結び…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330409,
					"content": "それと二つの山岳の弧が交わる二つの点…そこに祭壇はあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		},
