						722330502
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330502,
					"content": "白夜国について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "淵下宮はかつて白夜国と呼ばれていました。地下の王国には太陽も月もなく、天象は白夜と常夜という二つのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "露子"
				},
				{
					"id": 722330504,
					"content": "私の家系には、烏帽子という名の巫女がいます。彼女は白夜国の歴史においてもかなりの重鎮でした。だから私が「海祇御霊祭」を担当しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		}
