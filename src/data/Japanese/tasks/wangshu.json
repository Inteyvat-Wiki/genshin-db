					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031009
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10031009,
					"content": "仙人と関わることで傷ついてしまわないよう、まずはお化けから慣れるといいわ。",
