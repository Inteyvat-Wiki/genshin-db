					"nextDialogs": [
						10030305
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030305,
					"content": "だが、それは我がお前たちを傷つけないためのものであって、お前たちが傷つかないという意味ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030306
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030306,
					"content": "えーっと…よくわかんないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030307,
					"content": "仙と魔の世界に近づき過ぎれば、世の理を踏み外すことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030308
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030308,
					"content": "人の子の魂は仙人ほど強くはない。血も仙人の気運に耐えられないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030309
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030309,
					"content": "ここを去れ、お前たちのために言っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030310
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10030310,
					"content": "待ってくれ、ここに来たのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030311,
					"content": "あー、もうっ！なんだアイツ、全然話を聞いてくれないじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030312,
					"content": "恥ずかしいあだ名をつけてやりたいけど…仙人の恨みを買ったら、次から宝箱を開ける時にキャベツしか出なくなりそうで怖いからやめとこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030313,
					"content": "はあ…どうすれば仙人と話ができるか、旅館の女将に聞いてみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
