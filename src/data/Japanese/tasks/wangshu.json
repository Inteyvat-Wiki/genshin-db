				{
					"id": 10039403,
					"content": "女将じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039404,
					"content": "オーナーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039405,
					"content": "噂に関して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "ハハッ、ここで旅館ができるのは七星と関係がないわけないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039407,
					"content": "彼らの同意が必要だって意味よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039408,
					"content": "他の噂はただの噂よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039409,
					"content": "ところで、なにか面白い噂でも聞いたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039410,
					"content": "この猫について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "はあ…この猫は自分でついてきたの。かわいいからそのままにしてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10039412,
					"content": "名前？阿偉よ、適当につけたから。",
