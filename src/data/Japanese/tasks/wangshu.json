			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "休憩中だ、邪魔しないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030602,
					"content": "あの、杏仁豆腐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "邪魔しないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030604,
					"content": "ううっ…ここのシェフはモンドの鍛冶師のワーグナーと同じくらいサービス精神がないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030605,
					"content": "ゴレットオーナーが頼んだのよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030607,
					"content": "なるほど。オーナーの命令なら仕方がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030608,
					"content": "だが残念だ、今は杏仁豆腐のような細かなデザートを作る余裕がないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030609,
					"content": "どうしてだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030610,
					"content": "剣士の手が剣の調子を決めるのと同じように、料理人の手は料理のクオリティを大きく左右する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030611,
					"content": "だが今の俺の手は…すまないが、ちょっと思い通りに動かなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030612,
					"content": "うん？原因か…い、いや、実はお化けが出たって…お客さんが言っててな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030613,
					"content": "それにな！ついさっき…キッチンで…あ、あやしい影を見たんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030614,
					"content": "（このシェフ、見た目は怖いのにお化けの話になったら、急に口調が弱々しくなったな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030615,
					"content": "と、とにかく…この望舒旅館が安全じゃないかと思うと…お、落ち着いて杏仁豆腐も作れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030616,
					"content": "#仕方ない、{NICKNAME}、最高の杏仁豆腐のために、キッチンに行ってみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 100308,
			"completionStepIds": [
				100308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
