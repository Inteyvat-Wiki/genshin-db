					"nextDialogs": [
						10031014
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10031014,
					"content": "——そして、この旅館の周りで「完全な降魔印が見える場所」を探してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
