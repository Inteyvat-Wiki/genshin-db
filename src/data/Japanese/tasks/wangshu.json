						10031710
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031710,
					"content": "削月、理水、留雲の三人に会ってくる。彼らもそろそろ決断した頃だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031711,
						10031712
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031711,
					"content": "仙人が代わりに璃月を管理する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "仙人は、己に課された責任から逃れはしない。",
