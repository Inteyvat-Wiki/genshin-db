			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "あの仙人に関して…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "あら、もう魈様に会ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030403,
					"content": "珍しいね、彼が自ら誰かと会うなんてめったにないから、きっと機嫌がよかったんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030404,
					"content": "あの態度で「機嫌がいい」のか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030405,
					"content": "そうよ、仙人との縁はかなり貴重だもの。一生会えない人だってたくさんいるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030406,
					"content": "言い伝えによると、岩神が璃月を作った時、仙人の力を借りたそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030407,
					"content": "でも、仙人の多くは戦いによって璃月を守ることしか知らなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030408,
					"content": "だから数千年もの間、貿易の都として人間がその運営の手綱を握り、仙人は隠居の身となったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030409,
					"content": "女将は物知りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030410,
					"content": "「女将」じゃなくて、「オーナー」よ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030411,
					"content": "とにかく、あなたたちは仙人との縁を得た、あとは簡単よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030412,
					"content": "私のアドバイスに従って…魈様のご機嫌を取ればいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030413,
					"content": "機嫌を…？あの「護法夜叉」が喜ぶ姿なんて想像できないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030414,
					"content": "ふふっ、楽しみでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030415,
					"content": "（私も、彼の笑った顔なんて見たことないけど…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030416,
					"content": "まず、シェフに杏仁豆腐を作ってもらいなさい。それと、あなたの得意料理を用意して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030417,
					"content": "杏仁豆腐は魈様の数少ない好物よ。得意料理に関してはあなたに任せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 10030418,
					"content": "#ふむ…{NICKNAME}、どんな料理が得意だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030419,
					"content": "「満足サラダ」かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "あまりミスが出ない料理だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030423,
					"content": "でも、仙人への贈り物で攻めすぎるのもどうかと思うぞ、ここは「満足サラダ」にしておこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10030421,
					"content": "「大紅蓮マーラー炎スライム」かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "わおっ、新しい料理だな、食べてみたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 100306,
			"completionStepIds": [
				100306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
