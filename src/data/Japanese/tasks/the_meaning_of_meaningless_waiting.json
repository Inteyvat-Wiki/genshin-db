				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"健次郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040702,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "このことは「目狩り令」と関係があるのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040704,
					"content": "手島さんは何も悪くないのに、「神の目」を押収された。その後の彼は…人が変わったようだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040705,
					"content": "上手く言えないが、彼は何か大切なものを失ってしまったようだった。村の周囲を一人で何度も回っていたかと思うと、いきなり世界を一周するなんて言い出したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040706,
					"content": "俺たちも別に彼をここに留まらせようとしているわけじゃない。ただ…魂が抜けたような彼をこのまま行かせることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040707,
					"content": "どうやらみんな、あの人のことを尊敬してるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
