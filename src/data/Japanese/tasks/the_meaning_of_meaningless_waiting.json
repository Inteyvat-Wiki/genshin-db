				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "どれどれ、綾華が言ってた人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040102,
					"content": "どうしてなんじゃ、もう何年もここにいるのになぜ今さら離れると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040103,
					"content": "そうだそうだ。まだ心の準備もできておらん。いきなりそんなことを言われても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040104,
					"content": "子供たちもまたお前と遊びたいと思ってる…頼む、考え直してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "健次郎"
				},
				{
					"id": 20040105,
					"content": "あいつが綾華の言ってた人に間違いないみたいだな。早く行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
