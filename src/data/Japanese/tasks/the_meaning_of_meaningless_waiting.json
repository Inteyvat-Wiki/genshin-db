				"objectNames": [
					"パイモン",
					"手島"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "おまえが手島って人だな。どうしていきなりここを離れようとしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040802,
					"content": "俺か？離れるっていうよりも…どうしてここに居続けているのかが分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040803,
					"content": "ここでずっと暮らしてきたんでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "みんな頼りにしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "ああ、だがそれは俺が残る理由にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040806,
					"content": "30年前、どうして俺はここに来たんだ？30年もの間、どうして俺はずっとここにいた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040807,
					"content": "もう何も覚えてない。「神の目」を奪われてから、たくさんのことを忘れてしまったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040808,
					"content": "昔の俺はここに残りたいようだったが、今はもうそんな考えもなくなった。どこか遠くに行った方がましだ。まあ、心の中はからっぽなままだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040809,
					"content": "そうだったのか…それって、おまえがここに残る理由を探し出せば、残ってくれるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040810,
					"content": "うーん…でも、自分でも忘れてるみたいだし…どうすればいいんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040811,
					"content": "がんばって思い出してみるってのはどうだ？こう…「ピキーン」っていう感じで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040812,
					"content": "そういえば、以前手島さんに果物を届けた時、日記を書いていたような？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040813,
					"content": "俺にそんな習慣があったのか？正直…もう覚えていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040814,
					"content": "あったあった！その時の手島さん、面白いことを書き記しておいて大事な時に使うんだって言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040815,
					"content": "それだ！その日記を探せば、手島さんを引き留めることができるかもしれない。辺りを探してみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040816,
					"content": "じゃあ頼んだよ…私は先に村に帰って、手島さんの状況を他のみんなに説明してくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真昼"
				}
			]
		},
