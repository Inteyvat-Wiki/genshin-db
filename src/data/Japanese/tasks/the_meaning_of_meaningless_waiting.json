				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "これが手島さんの日記みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040202,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040203,
					"content": "「今日は村のみんなと一緒に干物の網焼きを作った。俺は不器用で、うっかり網を焦がしてしまった。仕方なく、最初から黒魚の蒲焼きを作っていたことにした。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040204,
					"content": "「今日は村で溺れていた子供を助けた。その子は自分の友達のバンブがまだ水の中にいると言った。俺は半日かけて探し回りやっと分かった。そのバンブっていう友達は、その子の飼っているカニだった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040205,
					"content": "「今日は凧を揚げに行った。糸が突然切れた。どんなに追いかけても追い付けなかった。仕方なく休憩できる場所に座り、それが遠くへ行くのをただ眺めていた。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040206,
					"content": "う～ん…なんかぜんぶ日常の出来事みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040207,
					"content": "あれ？待てよ、これを見ろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040208,
					"content": "「今日はまた近くの祠へお祈りに行き、そこでずっと座っていた。おまえが送った御守りも色褪せたが、それでも俺の一番大事なものだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040209,
					"content": "なんか有力な情報みたいだな。祠に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
