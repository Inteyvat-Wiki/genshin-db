				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "これが手島さんの日記にあった御守りか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040302,
					"content": "見た感じ女の子のものみたいだな。色も模様も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040303,
					"content": "これをずっと持ってたってことは、手島さんの元素力が残ってるかも。これでなにかできないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
