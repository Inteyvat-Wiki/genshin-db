			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"真昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "あんたは…手島さんを引き留めに来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040602,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "手島さんはな、30年前にここに来てから、ずっとこの地におられる方じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040604,
					"content": "宝盗団を追い払ったり、魔物を撃退したり、村の争いを止めてくれたり…彼は多くの心血をここに注いできた。私らの最も尊敬するお方じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040605,
					"content": "しかし、いきなりここを離れるなんて言い出したんじゃ。もしかしたら…私ら何か間違えたことをしてしまったのかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "真昼"
				},
				{
					"id": 20040606,
					"content": "できることなら手島さんに非を詫び、これからもここに残ってほしいんじゃが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真昼"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
