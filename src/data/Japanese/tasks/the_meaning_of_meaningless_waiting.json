			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "見つけた！ここが手島さんがよく来てた場所みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040402,
					"content": "地面に動かした痕跡があるぞ…もしかして手島さん、なにかお宝をここに隠してて、それでずっとこの村に残ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040403,
					"content": "手島さんが30年も守ってきたお宝、きっとすごいんだろうな～！早く掘り出してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040404,
					"content": "これは…手紙？時間が経ちすぎててもう黄ばんでるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040405,
					"content": "紺田村、聞き覚えのある名前だな。どこだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040406,
					"content": "この村の名前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "えっ？てことは手島さん、ここでずっと人を待ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040408,
					"content": "でも、もう30年も経ってるんだぞ、まだ現れてないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040409,
					"content": "とりあえず、これらを手島さんに渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"手島",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "そうだ、この日記にあるのは確かに俺の筆跡だ。御守りと手紙も…俺の物だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040502,
					"content": "それに書いてあることは、もう忘れたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040503,
					"content": "しかし、俺は確かにここで誰かを待っていた、30年も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040504,
					"content": "その間、毎日起きた面白い出来事を記録した、再会した時にこの30年もの月日を彼女に聞かせるために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040505,
					"content": "色んなことが起きたな…時間が過ぎるのは早い、もうこんなにも経っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040506,
					"content": "どうしてこんな重要なことを忘れていたんだ？よく考えると、神の目を奪われてから自分の中が空っぽになった気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040507,
					"content": "愛も、後悔も、彼女に関することも、すべて消えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040508,
					"content": "悲しいと思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "そうでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040510,
					"content": "彼女が誰かさえも忘れているしな。彼女の姿、声、俺と経験した出来事、すべて忘れてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040511,
					"content": "始めから彼女がいなかったかのように…すべてが儚い夢だったかのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040513,
					"content": "じゃあ、まだここを離れたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "それはもういい…こんなにも待ったんだ、これからも待ち続けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040516,
					"content": "ただ、本当に彼女に会えたとしても、名前すら口にできなかったら彼女は悲しく思うだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040517,
					"content": "それを考えると、俺の心は確かに悲しくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040518,
					"content": "おかしいな、彼女のことはもう覚えてないのに、どうしてこんな思いを抱くんだ。前もそうだった、心の中が空っぽで、何か欠けているような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040519,
					"content": "何はともあれ、俺がここに残る理由を取り戻してくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040520,
					"content": "ここに残って彼女を待ち続けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "手島"
				},
				{
					"id": 20040522,
					"content": "手島さんはそんなに悲しくないって言ってたけど…なんか、オイラはすっごく悲しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040523,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "綾華とトーマが言ったように…神の目を失ったら、願いと関係あるすべてが同時に失われるのかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040526,
					"content": "これが手島さんがあんなことになった原因だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040527,
					"content": "オイラたち、手島さんの役に…立てたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040528,
					"content": "はぁ…次の人を探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20040524,
					"content": "悲しみの理由を失うのはもっと悲しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
