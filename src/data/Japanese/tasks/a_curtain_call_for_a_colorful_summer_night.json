					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "吟遊野郎は相変わらずこういう場所を探すのが得意なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450702,
					"content": "気に入ってくれてよかった。鳥よりも、空高く光る星に語るべき物語もあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450703,
					"content": "また寝る前の読み聞かせ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "あはは。今度のお話は「時間」の物語だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450705,
					"content": "昔々、「時{RUBY#[D]イスタロト}間」はこの世界の記録を始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450706,
					"content": "彼女は、俗世に存在するすべての命に対して、分け隔てなく接していた。でも、その命たちは…彼女にとって取るに足らない存在だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450707,
					"content": "彼女はまるで古い巻物のように、全ての人や出来事、出会いと別れを記憶に刻んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450708,
					"content": "その頃まだ風の精霊だったボクは、千風の神殿で「時間」と邂逅したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450709,
					"content": "彼女はボクの願いに耳を傾け、ボクに力と権利の欠片を分け与えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450710,
					"content": "風が種を運び…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "おや、「時と風」の物語を聞いたことがあるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450713,
					"content": "味わい深いと思わないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450714,
					"content": "祭礼、詩歌、遺跡や古書に刻まれた記憶によって、「取るに足らなかった」命が時間を「見る」ことができるようになるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450715,
					"content": "それがおまえの伝えたかった物語か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450716,
					"content": "うーん…まだ物語の「序章」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450717,
					"content": "燼寂海の汚染には「時間的特性」がある。言い換えればその災害はすべての時間に存在する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450718,
					"content": "「時間」…彼女とは違って、ボクは願いをたくさん心に秘めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450719,
					"content": "五百年前、燼寂海の汚染が拡散し、テノチズトク以外の地域に拡散するのを防ぐため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450720,
					"content": "ボクは燼寂海を時間軸から吹き飛ばし、「無風の地」にした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450721,
					"content": "それが燼寂海が消えた謎の真相…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "おっと、情報が色々混ざっちゃってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450723,
					"content": "もし二、三十年前にテノチズトクから燼寂海が消えたことを言ってるなら、ボクより詳しいやつがいるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450724,
					"content": "燼寂海は、関わってはいけない多くの物語に足を踏み入れていた…ボクはそのうちの一つに関わったにすぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450725,
					"content": "そして、ボクが五百年前に行った選択には、代償があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450726,
					"content": "ボクの選択によって、モンドに帰れなくなった魂があったんだ。その他にも、この土地に根付き、幻写霊と融合してアシャになった魂もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450727,
					"content": "じゃあ、おまえがテノチズトクに来たのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450728,
					"content": "うん、現炎神のマーヴィカと協力する必要があったからだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450729,
					"content": "それってロウソクを灯した時のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "正解。炎の光こそがボクたちの合図だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450731,
					"content": "マーヴィカにあの空間から本物の燼寂海へと繋がる裂け目を作ってもらったんだ。そこへボクがこっそり中に入り込んで、家に帰りたがっている魂を帰してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450732,
					"content": "そのついでに記憶を一緒に連れ戻す小細工を、ちょっとね…えへっ、別に今回が初めてじゃないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450733,
					"content": "マーヴィカは、君がボクを紹介したがってたって言ってたけど…ボクが先回りしちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450734,
					"content": "彼女も美酒と自由を愛してるみたいで嬉しいよ。話が合いそうだなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450735,
					"content": "さすがだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "いやぁ、それが何日もダウンしちゃって。また眠りに就くところだったよ。",
