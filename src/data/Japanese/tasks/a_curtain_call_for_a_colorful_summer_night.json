			"dialogs": [
				{
					"id": 150450401,
					"content": "旅人、パイモン！プクフグフロートと一緒に朝の挨拶に来たよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450402,
					"content": "おはよう、ムアラニ。昨日一番遊びまわってたのに、なんでそんなに元気なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450403,
					"content": "だってそれは昨日のことでしょ！寝て起きたら、疲れもバイバイだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450404,
					"content": "ほら、これ。記念アルバムの報酬だよ。君が行かなくて済むように、一緒にもらってきちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450405,
					"content": "おお！ムアラニ、気が利くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450406,
					"content": "人のために悩んで、人のために動くのがいいガイドでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450407,
					"content": "ガイドといえば、そろそろバカンスもお開きかなー。いい加減帰らないと、うちのわんこに忘れられちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450408,
					"content": "ほかのみんなも、そろそろホームシックみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450409,
					"content": "家族に会いたいとか、蒲公英酒の味が恋しいとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450410,
					"content": "チャスカですら…口では何も言わないけど、夕方にはいつも木の上に座って「花翼の集」のほうを眺めてるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450411,
					"content": "だよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "だからね、この楽しい夏が終わる前に、もう少しだけ記念になることをしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450413,
					"content": "例えば…記念写真をもう一回撮るとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450414,
					"content": "ここで撮るのはどうだ？ずっと泊まってたから、愛着が沸いちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450415,
					"content": "賛成！壁を飾り付けようよ！みんなを呼んでくるから…広場で集合ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		},
