			"dialogs": [
				{
					"id": 150450601,
					"content": "わぁ、すごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450602,
					"content": "みんな、こっちに集合！写真撮るよー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450603,
					"content": "うんうん…みんな元気いっぱいでいいね！前髪もサラサラだし、目の下にクマもない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450604,
					"content": "そんなところまでチェックするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450605,
					"content": "いい写真が撮れないと、ガイド失格だからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450606,
					"content": "そうそう。お酒が好きな吟遊詩人じゃないと、旅仲間失格なのと一緒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450607,
					"content": "ぜんぜん意味が分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450608,
					"content": "ははっ、でも楽しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450609,
					"content": "みんなだいぶ打ち解けたよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "こんなんでいいのかよ？おまえもベネットも吟遊野郎を甘やかしすぎだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450611,
					"content": "——悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450612,
					"content": "ほら、このアシャのカチューシャをつけて！みんなからのプレゼントだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450613,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "うん！よく似合ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450615,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450616,
					"content": "三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450617,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450618,
					"content": "パイモン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450619,
					"content": "…ごめん。みんなが変な事ばっかり言うから、はいチーズの代わりが思いつかなくなっちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450620,
					"content": "別れが寂しいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450621,
					"content": "この瞬間に、バカンスが終わってしまう…そんな気がしたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450622,
					"content": "おまえ…！「調停者」は心を読めるわけじゃない、って言ってたくせに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450623,
					"content": "あははっ、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450624,
					"content": "大丈夫だぞ、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450625,
					"content": "お前も炎神様に祈ってただろ。来年もまた、楽しい夏になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450626,
					"content": "みんなの旅はそれぞれ続いていくけど、お互いを思い合ってれば、きっとまたいつか会えるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450627,
					"content": "ベネットもずいぶん口がうまくなったね、ウェンティ先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450628,
					"content": "えへへ、ボクの教育の成果じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450629,
					"content": "おまえの成果じゃないっていうなら、なんでそんなに得意げなんだよ！まったく、オイラせっかく感動してたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450630,
					"content": "じゃあ仕切り直す？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450631,
					"content": "みんな一緒に叫ぼうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450632,
					"content": "何を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450633,
					"content": "ラッキースター？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "それで行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450635,
					"content": "三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450636,
					"content": "ラッキースター！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450641,
					"content": "みんなと楽しい時間を過ごした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "…ベネットはこれからどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450643,
					"content": "確かに。まだ迷ってるなら、まずは「流泉の衆」においでよ！居たいだけ居ていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450644,
					"content": "…ムアラニ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450645,
					"content": "この前、炎神様に会った時、心からの感謝を伝えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450646,
					"content": "炎神様が言うには、あの燼寂海はアビスが模倣して作った不安定な空間で、すでに跡形もなく消えてしまったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450647,
					"content": "その後オレの話にもなったんだけど…炎神様はナタに残るなら歓迎するけど、オレの意見も尊重する、って言ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450648,
					"content": "じっくり考えたけど…やっぱりモンドに帰ろうと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450649,
					"content": "オヤジさんたちが気になるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450650,
					"content": "うん、それも理由の一つだ。オレの経験した物語をみんなに伝える、って約束したからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450651,
					"content": "でもそれだけじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450652,
					"content": "父さんと母さんと別れた時、「偉大な、伝説の冒険者になって見せる」って誓ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450653,
					"content": "冒険者たるもの、いつまでも同じところに留まってるわけにはいかないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450654,
					"content": "ベネット…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450655,
					"content": "ナタを離れて、また不運になっちゃったらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450656,
					"content": "ははっ、大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450657,
					"content": "今回の旅で得た温もりは、今後直面するすべての困難に打ち勝つ力になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450658,
					"content": "オレは自分の運命を掴みたい——家族や友達からもらった温もりを、さらに伝えていきたい。この気持ちは変わらないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450659,
					"content": "我らが団長に乾杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450660,
					"content": "ベネット団長に乾杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450661,
					"content": "乾杯乾杯——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450662,
					"content": "うーん…ほとんど徹夜することになるとは思わなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150450663,
					"content": "楽しんでる～？次は誰が芸を披露してくれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450664,
					"content": "ベネットが何回も寝かけていたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450665,
					"content": "いやいや、オレは…まだ大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 150450666,
					"content": "そろそろ帰って休もう。ムアラニ、そんなに元気なら後片付けは任せた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150450667,
					"content": "えっ？なんであたしが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150450668,
					"content": "旅人、散歩に付き合ってくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 150450669,
					"content": "眺めのいい場所を知ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
							"2"
						],
						"stepId": 1504507,
						"stateName": "QUEST_STATE_UNFINISHED"
