					}
				]
			},
			"dialogs": [
				{
					"id": 750170901,
					"content": "おい、イレール！おまえが言ってたパーツは全部揃ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170902,
					"content": "だ、誰がイレールですって！？なんて無礼な！私の名は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170903
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170903,
					"content": "#はぁ…まあ、いいでしょう！もう私は死にたくてたまりませんの！高貴なる{NICKNAME}様、どうか今すぐその心臓を私の胸に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170904
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170904,
					"content": "そして、そのまま心臓を取り出してください。あなたの高貴なる手の上で私が死ねるよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170905
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170905,
					"content": "白くて丸い元素浮遊物よ、あなたも歓喜なさい！チチェンウトゥの主が死ぬ瞬間を目撃する栄誉を、あなたにも与えましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170906
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170906,
					"content": "うわ、急にそんな興奮すんなよ！とにかく、えっと…このパーツを全部入れればいいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170907,
					"content": "そうです、その通りです！そしたら、私が「胸の内」を開きますので、心臓を取り出していただければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170908
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170908,
					"content": "いやいや、言葉の意味がなんかちがうぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170909,
					"content": "（パーツを入れる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170910
					]
				},
				{
					"id": 750170910,
					"content": "えっと…この後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
