					},
					{
						"sceneId": 3,
						"position": [
							-393.099,
							-82.556,
							9582.68
						],
						"pointId": 9897
					},
					{
						"sceneId": 3,
						"position": [
							-390.54,
							-82.556,
							9582.82
						],
						"pointId": 9898
					}
				]
			},
			"dialogs": [
				{
					"id": 750170701,
					"content": "「七重燃{RUBY#[D]チチェンウトゥ}火の地」の至高なる領主より、選ばれし者へ敬意を表しますわ。あなたの道が、永遠に咲き誇る花で満たされますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170702
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170702,
					"content": "今の声…この大きな彫像から聞こえたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170703,
						750170704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170703,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170706
					]
				},
				{
					"id": 750170706,
					"content": "私の名は聖龍イ・クェクシ・ツボ{RUBY#[S]L型自律監視機構統合処理ユニット}ロン・ク・レール、かつてはチチェンウトゥを統べる主でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170707
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170707,
					"content": "イ…イ…なんだって？な、長い名前だな！なんか意味のわからないおまじないみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170708,
					"content": "まあいいや、とりあえず「イレール」って呼ぶことにするな。全部覚えられそうにないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170709,
					"content": "定{RUBY#[D]クフル}めにある神聖なる道に従い、あなたたちを…いや、待ちなさい！そこの白くて丸い元素浮遊物、いま私をなんと呼びましたの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170710
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170710,
					"content": "#誰が「白くて丸い元素浮遊物」だ！オイラはパイモンだぞ。こっちは{NICKNAME}で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170711,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170712
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750170712,
					"content": "#この子は{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170713
					]
				},
				{
					"id": 750170713,
					"content": "それに、おまえも自分で言っただろ。「私の名はイなんとかレール」って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170714,
					"content": "な、なんと無礼な！この神聖なる名は尊き主より賜りしもの。白くて丸い元素浮遊物よ、よくもそのようなことを…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170715
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170715,
					"content": "#高貴なる{NICKNAME}様！大変申し上げにくいのですが…あなたは下僕を甘やかしすぎているようですわ。至高なる領主に対して、このような口を利くなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170716,
						750170719
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170716,
					"content": "#パイモンは{M#俺}{F#私}の下僕じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170717
					]
				},
				{
					"id": 750170717,
					"content": "#そうだそうだ！{NICKNAME}とオイラは最高の仲間なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170718,
					"content": "元素浮遊物と仲間…ですって？まあ、なんて個性的なお方でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170721,
					"content": "#とにかく、まずは謝罪をさせてください、高貴なる{NICKNAME}様。ここまでお越しいただいたのに、かような姿でお迎えすることになってしまい…誠に面目ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170722
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170722,
					"content": "もしこの下劣な彫像に囚われていなければ——聖龍の姿であれ、人の姿であれ——もっと優雅な姿をお見せできたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170723
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170723,
					"content": "え？彫像に囚われてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170724,
					"content": "ふん、でなければなんです？私がただの喋れる彫像だとでも思っていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170725
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170725,
					"content": "うーん、だって…こんな場所だし、「ただの喋れる彫像」がいてもおかしくないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170726,
					"content": "ぐっ、なんと無礼な！私はチチェンウトゥの至高なる領主、尊き聖龍ですのよ。それをよくも…よくも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170727
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170727,
					"content": "あの卑劣な裏切りさえなければ、こんな粗悪な彫像に囚われていませんでしたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170728
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170728,
					"content": "#と、とにかく！高貴なる{NICKNAME}様、単刀直入にお話しさせていただきますと——私から一つ、お願いがあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170729,
						750170730
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170729,
					"content": "お願い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170732
					]
				},
				{
					"id": 750170732,
					"content": "私の心臓は裏切り者によってバラバラにされ、いろいろな装置の中に隠されてしまいました。あなたには、その心臓の欠片を探し出していただきたいのです。そして、その後——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170733
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170733,
					"content": "——グレインの実の葉を剥くように、私の胸を開き、心臓を取り出してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170734
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170734,
					"content": "え…ええっ？ちょっと待てよ、今さらりとすごく恐ろしいことを言わなかったか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170735,
					"content": "恐ろしいって？グレインの実のことでしょうか？ふふっ、ずいぶん臆病な元素浮遊物ですわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170736
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170736,
					"content": "もうめちゃくちゃだぞ！グレインの実を怖がるやつなんているもんか！おまえが得意げになってるのも意味わかんないぞ…オイラが言ってるのは後半の部分だ、「心臓を取り出す」とかなんとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170737,
					"content": "#あら？グレインの実よりもありふれたことでしょう？高貴なる{NICKNAME}様、祭祀に下僕を連れて行かれたことがないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170738
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170738,
					"content": "#どうして{M#俺}{F#私}が心臓を取り出すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170739
					]
				},
				{
					"id": 750170739,
					"content": "それはあなたが高貴なるお方、龍に選ばれし者だからですわ。行方知れずになった領{RUBY#[D]アハウ}主の朋輩たちを除いて、私の身分にふさわしい解放を与えられるのはあなただけですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170740
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170740,
					"content": "#古の道に詳しければ、{NICKNAME}様もご存じでしょう。太古の昔に造られたこの心{RUBY#[D]集団記憶装置}臓には、かつての私の思い出がすべて宿っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170741
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170741,
					"content": "裏切り者——その名が永遠に消えない炎の中で、一万三千年間焼かれますように——が私の権能を奪い、思い出で私をここに縛り付けたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170742
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170742,
					"content": "うーん、思い出で人を縛れるもんなのか？あ、いや龍を縛れるもんなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170743,
					"content": "ふんっ、可愛らしいほど無知なのですね、この白くて丸い元素浮遊物は。もし私がまだ権能を失っていなければ、あなたを飼ってみたかったかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170744
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170744,
					"content": "短命の種族にとって、思い出はケネパベリーのように甘美なものでしょう。しかし、長命の種族にとって、思い出は呪いと束縛でしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170745
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170745,
					"content": "ええと、言ってることが難しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170746
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170746,
					"content": "とにかく、あの卑劣な裏切り者はこうして、彼の帝国のため、彼の妄想のために、私に歌うことを強いました——彼が、この都市の運用方法を知らなかったがために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170747
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170747,
					"content": "彼の哀れな帝国も、その滑稽な妄想も灰燼と化しましたが、私はいまだにこの卑しい彫像の中で千年、また千年と囚われ続けているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170748
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170748,
					"content": "うーん、そう言われても、心臓を見つけてから取り出すって、やっぱりよくわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170749
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170749,
					"content": "ふふ…まだ理解できないのですか？白くて丸い元素浮遊物よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170750
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170750,
					"content": "私の命はもう残り僅か…何もしなくとも、冬があと三十回訪れれば、この意識は完全に消えてしまうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170751
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170751,
					"content": "#しかし、私が奴隷のように縛られたまま死ぬことを、私の尊厳が許しません。だから、高貴なる{NICKNAME}様に、解放を乞うているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170752
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170752,
					"content": "私は自害することもできません。ですが、もしあなたが欠片を全て見つけてくだされば、私は残りの生{RUBY#[D]エネルギー}命をすべて注ぎ込み、バラバラになった心臓を元通りに修復できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170753
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170753,
					"content": "これは<color=#00E1FFFF>自己防衛</color>の一環ですわ。こうすることでのみ、定{RUBY#[D]クフル}めにある神聖なる法則を犯さずに済むのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170754
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170754,
					"content": "その後、どうか私の心臓を取り出してください。私を奴隷のように縛り、何千年も苦しめ続けたこの心臓を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170755
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170755,
					"content": "それこそが真なる聖龍の心臓。人間のいかなる宝石もこれには及びません。それがあなたに差し上げる報酬です——さて、返事をお聞かせいただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170756,
						750170759
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170756,
					"content": "分かった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170757
					]
				},
				{
					"id": 750170757,
					"content": "ありがとうございます。それでは、ここで歌いながら、あなたの良い知らせを待つことにしましょう。それ以外に、今の私にできることはございませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170758
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170758,
					"content": "どうか…私の心臓を探し出し、高貴なる解放をお与えください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170759,
					"content": "他に方法はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170760
					]
				},
				{
					"id": 750170760,
					"content": "ふふ…私のかつての仲間たちに会ったことがないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170761
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170761,
					"content": "そうでなければ、彼らはあなたに教えていたはずです——破滅こそが我々の「定めら{RUBY#[S]クフル}れた」道だと。別の道を探す必要も、可能性もどこにもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170762
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170762,
					"content": "とにかく、私はここで歌いながら、あなたの選択をお待ちします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170730,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170731
					]
				},
				{
					"id": 750170731,
					"content": "ふふ、ご心配なく。最後までお聞きいただければ、報酬の価値もおのずとお分かりいただけるはずですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170732
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750170719,
					"content": "その通りだ、パイ。今日という今日は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170720
					]
				},
				{
					"id": 750170720,
					"content": "「パイ」って誰だよ！ちょっとおだてられたからって、調子に乗るんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750170704,
					"content": "#選ばれし者って、{M#俺}{F#私}のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750170705
					]
				},
				{
					"id": 750170705,
					"content": "はい。あなたは龍に選ばれし者、そして私が選んだ高貴なるお方ですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750170706
					],
					"speakerTitle": "イレール"
				}
			]
		},
