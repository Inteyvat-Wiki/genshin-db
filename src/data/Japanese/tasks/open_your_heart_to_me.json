					},
					{
						"sceneId": 3,
						"position": [
							-393.099,
							-82.556,
							9582.68
						],
						"pointId": 9897
					},
					{
						"sceneId": 3,
						"position": [
							-390.54,
							-82.556,
							9582.82
						],
						"pointId": 9898
					}
				]
			},
			"dialogs": [
				{
					"id": 750171701,
					"content": "「七重燃{RUBY#[D]チチェンウトゥ}火の地」の至高なる領主より、選ばれし者へ敬意を表しますわ。あなたの道が、永遠に咲き誇る花で満たされますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171702
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171702,
					"content": "今の声…この大きな彫像から聞こえたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171703,
						750171704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171703,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171706
					]
				},
				{
					"id": 750171706,
					"content": "私の名は聖龍イ・クェクシ・ツボ{RUBY#[S]L型自律監視機構統合処理ユニット}ロン・ク・レール、かつてはチチェンウトゥを統べる主でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171707
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171707,
					"content": "イ…イ…なんだって？な、長い名前だな！なんか意味のわからないおまじないみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171708,
					"content": "まあいいや、とりあえず「イレール」って呼ぶことにするな。全部覚えられそうにないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171709,
					"content": "定{RUBY#[D]クフル}めにある神聖なる道に従い、あなたたちを…いや、待ちなさい！そこの白くて丸い元素浮遊物、いま私をなんと呼びましたの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171710
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171710,
					"content": "#誰が「白くて丸い元素浮遊物」だ！オイラはパイモンだぞ。こっちは{NICKNAME}で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171711,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171712
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750171712,
					"content": "#この子は{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171713
					]
				},
				{
					"id": 750171713,
					"content": "それに、おまえも自分で言っただろ。「私の名はイなんとかレール」って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171714,
					"content": "な、なんと無礼な！この神聖なる名は尊き主より賜りしもの。白くて丸い元素浮遊物よ、よくもそのようなことを…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171715
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171715,
					"content": "#高貴なる{NICKNAME}様！大変申し上げにくいのですが…あなたは下僕を甘やかしすぎているようですわ。至高なる領主に対して、このような口を利くなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171716,
						750171719
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171716,
					"content": "#パイモンは{M#俺}{F#私}の下僕じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171717
					]
				},
				{
					"id": 750171717,
					"content": "#そうだそうだ！{NICKNAME}とオイラは最高の仲間なんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171718,
					"content": "元素浮遊物と仲間…ですって？まあ、なんて個性的なお方でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171721
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171721,
					"content": "#とにかく、まずは謝罪をさせてください、高貴なる{NICKNAME}様。ここまでお越しいただいたのに、かような姿でお迎えすることになってしまい…誠に面目ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171722
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171722,
					"content": "もしこの下劣な彫像に囚われていなければ——聖龍の姿であれ、人の姿であれ——もっと優雅な姿をお見せできたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171723
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171723,
					"content": "え？彫像に囚われてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171724,
					"content": "ふん、でなければなんです？私がただの喋れる彫像だとでも思っていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171725
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171725,
					"content": "うーん、だって…こんな場所だし、「ただの喋れる彫像」がいてもおかしくないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171726,
					"content": "ぐっ、なんと無礼な！私はチチェンウトゥの至高なる領主、尊き聖龍ですのよ。それをよくも…よくも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171727
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171727,
					"content": "あの卑劣な裏切りさえなければ、こんな粗悪な彫像に囚われていませんでしたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171728
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171728,
					"content": "#と、とにかく！高貴なる{NICKNAME}様、単刀直入にお話しさせていただきますと——私から一つ、お願いがあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171729,
						750171730
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171729,
					"content": "お願い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171732
					]
				},
				{
					"id": 750171732,
					"content": "私の心臓は裏切り者によってバラバラにされ、いろいろな装置の中に隠されてしまいました。あなたには、その心臓の欠片を探し出していただきたいのです。そして、その後——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171733
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171733,
					"content": "——グレインの実の葉を剥くように、私の胸を開き、心臓を取り出してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171734
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171734,
					"content": "え…ええっ？ちょっと待てよ、今さらりとすごく恐ろしいことを言わなかったか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171735,
					"content": "恐ろしいって？グレインの実のことでしょうか？ふふっ、ずいぶん臆病な元素浮遊物ですわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171736
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171736,
					"content": "もうめちゃくちゃだぞ！グレインの実を怖がるやつなんているもんか！おまえが得意げになってるのも意味わかんないぞ…オイラが言ってるのは後半の部分だ、「心臓を取り出す」とかなんとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171737,
					"content": "#あら？グレインの実よりもありふれたことでしょう？高貴なる{NICKNAME}様、祭祀に下僕を連れて行かれたことがないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171738
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171738,
					"content": "#どうして{M#俺}{F#私}が心臓を取り出すの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171739
					]
				},
				{
					"id": 750171739,
					"content": "それはあなたが高貴なるお方、龍に選ばれし者だからですわ。行方知れずになった領{RUBY#[D]アハウ}主の朋輩たちを除いて、私の身分にふさわしい解放を与えられるのはあなただけですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171740
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171740,
					"content": "#古の道に詳しければ、{NICKNAME}様もご存じでしょう。太古の昔に造られたこの心{RUBY#[D]集団記憶装置}臓には、かつての私の思い出がすべて宿っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171741
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171741,
					"content": "裏切り者——その名が永遠に消えない炎の中で、一万三千年間焼かれますように——が私の権能を奪い、思い出で私をここに縛り付けたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171742
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171742,
					"content": "うーん、思い出で人を縛れるもんなのか？あ、いや龍を縛れるもんなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171743,
					"content": "ふんっ、可愛らしいほど無知なのですね、この白くて丸い元素浮遊物は。もし私がまだ権能を失っていなければ、あなたを飼ってみたかったかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171744
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171744,
					"content": "短命の種族にとって、思い出はケネパベリーのように甘美なものでしょう。しかし、長命の種族にとって、思い出は呪いと束縛でしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171745
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171745,
					"content": "ええと、言ってることが難しいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171746
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171746,
					"content": "とにかく、あの卑劣な裏切り者はこうして、彼の帝国のため、彼の妄想のために、私に歌うことを強いました——彼が、この都市の運用方法を知らなかったがために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171747
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171747,
					"content": "彼の哀れな帝国も、その滑稽な妄想も灰燼と化しましたが、私はいまだにこの卑しい彫像の中で千年、また千年と囚われ続けているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171748
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171748,
					"content": "うーん、そう言われても、心臓を見つけてから取り出すって、やっぱりよくわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171749
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171749,
					"content": "ふふ…まだ理解できないのですか？白くて丸い元素浮遊物よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171750
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171750,
					"content": "私の命はもう残り僅か…何もしなくとも、冬があと三十回訪れれば、この意識は完全に消えてしまうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171751
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171751,
					"content": "#しかし、私が奴隷のように縛られたまま死ぬことを、私の尊厳が許しません。だから、高貴なる{NICKNAME}様に、解放を乞うているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171752
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171752,
					"content": "私は自害することもできません。ですが、もしあなたが欠片を全て見つけてくだされば、私は残りの生{RUBY#[D]エネルギー}命をすべて注ぎ込み、バラバラになった心臓を元通りに修復できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171753
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171753,
					"content": "これは<color=#00E1FFFF>自己防衛</color>の一環ですわ。こうすることでのみ、定{RUBY#[D]クフル}めにある神聖なる法則を犯さずに済むのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171754
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171754,
					"content": "その後、どうか私の心臓を取り出してください。私を奴隷のように縛り、何千年も苦しめ続けたこの心臓を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171755
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171755,
					"content": "それこそが真なる聖龍の心臓。人間のいかなる宝石もこれには及びません。それがあなたに差し上げる報酬です——さて、返事をお聞かせいただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171756
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171756,
					"content": "ん？ちょっと待てよ、おまえが言った「心臓」って、もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171757
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171757,
					"content": "イレールに以前見つけた奇妙な欠片を見せた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750171758
					]
				},
				{
					"id": 750171758,
					"content": "こ、これは…！そう、まさにこれですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171759
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171759,
					"content": "#まさかもうすでに欠片を全部集めていらっしゃるなんて！さあ、高貴なる{NICKNAME}様、どうか私の心臓を取り出して、あなたの手の上で私を死なせてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171760
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171760,
					"content": "白くて丸い元素浮遊物よ、あなたも歓喜なさい！チチェンウトゥの主が死ぬ瞬間を目撃する栄誉を、あなたにも与えましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171761
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171761,
					"content": "うわ、急にそんな興奮すんなよ！とにかく、えっと…このパーツを全部入れればいいんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171762
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171762,
					"content": "そうです、その通りです！そしたら、私が「胸の内」を開きますので、心臓を取り出していただければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171763
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171763,
					"content": "いやいや、言葉の意味がなんかちがうぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171764
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171764,
					"content": "（欠片を入れる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171765
					]
				},
				{
					"id": 750171765,
					"content": "えっと…この後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171730,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171731
					]
				},
				{
					"id": 750171731,
					"content": "ふふ、ご心配なく。最後までお聞きいただければ、報酬の価値もおのずとお分かりいただけるはずですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171732
					],
					"speakerTitle": "イレール"
				},
				{
					"id": 750171719,
					"content": "その通りだ、パイ。今日という今日は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171720
					]
				},
				{
					"id": 750171720,
					"content": "「パイ」って誰だよ！ちょっとおだてられたからって、調子に乗るんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750171704,
					"content": "#選ばれし者って、{M#俺}{F#私}のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750171705
					]
				},
				{
					"id": 750171705,
					"content": "はい。あなたは龍に選ばれし者、そして私が選んだ高貴なるお方ですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750171706
					],
					"speakerTitle": "イレール"
				}
			]
