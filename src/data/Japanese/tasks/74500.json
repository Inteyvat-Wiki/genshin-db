			"dialogs": [
				{
					"id": 745000401,
					"content": "いらっしゃいませ、店主のカロンだ。何かお探しかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000402
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000402,
					"content": "人がすごく多いけど、なにかイベントでもやってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000403,
					"content": "はは、イベントとまではいかないけど、最近新しいおもちゃを発売したんだ。入口に置いてあるあれだよ。もし興味があるなら、いつでも遊びにおいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カロン"
				}
			]
		},
		{
