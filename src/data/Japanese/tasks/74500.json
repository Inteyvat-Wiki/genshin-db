			},
			"dialogs": [
				{
					"id": 745000501,
					"content": "お待ちかねのお客さんが来たって、店主に伝えてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000502
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000502,
					"content": "早く戻ってきいや。一人で店番すんのは退屈やからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベール"
