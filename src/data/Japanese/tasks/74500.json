			"dialogs": [
				{
					"id": 745000301,
					"content": "店主、お二人さんが戻ってきたで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000302
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000302,
					"content": "さすが冒険者協会から推薦されただけのことはあって、仕事が速いな。私が店主のリーヴァだ。よくぞ来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000303
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000303,
					"content": "リーヴァ、こんにちは。おまえとカロンは兄弟だったんだな。あっという間にスパイだって見破られちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000304,
					"content": "アルベール、どういうことや？そんな大事なことを伝え忘れてたんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000305
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000305,
					"content": "アルボン貴様！君が伝えるって言ってたやろ？店主、給料から天引きするならこいつの給料から引くべきやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000306
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000306,
					"content": "おい、おまえらもまさか兄弟なんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000307,
					"content": "こんなやつと兄弟でたまるかい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000308
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000308,
					"content": "ゴホンッ…それでお前たち…任務は失敗したということかな？何の情報も手に入らなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000309
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000309,
					"content": "いやいや、カロンはすっごく優しいやつで、オイラたちの意図を知っても全然気にしなかったんだ。それに、いつでもおもちゃを試しに来ていいってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000310,
					"content": "ふふ、あいつ…それであれは本当に錬金術のおもちゃだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000311
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000311,
					"content": "いや、冒険者のおもちゃだったぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000312
					]
				},
				{
					"id": 745000312,
					"content": "ふん、また古臭い冒険者のおもちゃか。あいつ、冒険者の物語が込められてるとか言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000313
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000313,
					"content": "そうだぞ。どうして分かったんだ？もしかしてすでにこっそり調べてあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000314,
					"content": "あいつのことは私が一番知ってる。いつもセンチメンタルな要素をおもちゃに持ち込んでばかりで、ちっとも市場のことを考えないんだ。冒険者の物語なんて、もはやこの時代には合わないっていうのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000315
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000315,
					"content": "でも彼の店はすごく人気なんだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000316
					]
				},
				{
					"id": 745000316,
					"content": "経営から言えば正常な波の範囲にすぎないさ。私たちの決闘代理人プロジェクトが完成すれば、あいつらはきっと一溜まりもなく潰されるに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000317
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000317,
					"content": "でも、本物の「決闘代理人」じゃなくて、オイラたちみたいに「時代遅れ」な冒険者がなりすましたものだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000318,
					"content": "お前たちは何も分かっていない。これはパッケージングといって、市場で通用する基本戦略なんだ。中身を気にするやつなんか誰もいやしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000319
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000319,
					"content": "データが手に入ったら、それを基盤となる人気玩具に取り入れて、「決闘代理人」の成長物語を描いたものだと宣伝すれば、出来上がりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000320
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000320,
					"content": "そんなんでいけるのかよ？どう考えてもその物語には問題がありそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000321,
					"content": "物語に問題があろうと関係ない。話題性があればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000332
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000332,
					"content": "もし私が、アルボンとアルベールは実は「コント」をテーマに作られたからくり人形だと言ったら、どう思うかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000322
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000322,
					"content": "なんだって！？からくり人形！？こ…こんなにリアルなからくり人形があったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000323,
					"content": "当然や。どや、ほんまにリアルやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000324
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000324,
					"content": "「コント」の世界では、人騙しでさえこんなにリアルに仕上げられるんやで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000325
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000325,
					"content": "見たか？これがパッケージングの力だ。偽りの売りポイントも、こんな風に言えば興味を持ってくれる人がいるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000326
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000326,
					"content": "うわっ！嘘だったのかよ。ずるいぞ…弟とは天と地の差だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000327,
					"content": "あいつ、本業のクロックワークの時計の経営に専念すればいいものを、おもちゃにまで手を出しやがって。兄貴としては、当然「教育」してやるべきだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000328,
						745000329
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000328,
					"content": "わあ、やり手だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				},
				{
					"id": 745000330,
					"content": "お褒めに預かり光栄だ。じゃ、引き続きお二人さんにはよろしく頼むぞ。データ収集に関してはアルボンとアルベールに任せてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000331
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745000331,
					"content": "ふん、オイラたちはおまえたちの兄弟喧嘩に首をつっこむつもりはないぞ。モラはちゃんと払ってくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000329,
					"content": "やっぱり商人に善人はいないんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000330
					]
				}
			]
		},
