			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カロン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745000201,
					"content": "いらっしゃいませ、店主のカロンだ。何かお探しかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000202
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000202,
					"content": "カロン、こんにちは。オイラたち、ここにすごいおもちゃがあるって聞いて見にきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000203,
					"content": "はは、もちろんいいよ。ただ…君たちは兄さんに頼まれて情報を聞きに来たんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000204
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000204,
					"content": "えっ？兄さん？いや、それより…なんでオイラたちが情報を聞きに来たってすぐ分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000205,
					"content": "さっき、君たちがクロックワーク工房からこっちに来るのが見えた。あの店の店主は私の兄だから、すぐに事情が分かったよ。兄さんらしいやり方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000206
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000206,
					"content": "まずい…バレちゃったぞ。これじゃ情報を聞き出す以前に、相手にもしてもらえなさそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000207,
					"content": "うぅっ、もっとしっかり準備をしてから来るべきだったな。まさか兄弟だなんて思いもしなかったぜ。同じ業界のライバルだと思ったら、まさか…ち…血で血を洗うような状況だったなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000208,
					"content": "パイモン、そんな言葉使わないの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000209
					]
				},
				{
					"id": 745000209,
					"content": "ごめんな…オイラ、ちょっと混乱しちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000210,
					"content": "いや、気にしないでくれ。いくら手の込んだおもちゃでも、部品にガタが来るときがある。人間も同じで、丁寧に手入れしてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000211
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000211,
					"content": "…兄さんからしてみれば、私との関係もそんな状況なんだろう。さて、これ以上君たちの時間を無駄にするのは止めておこう。おもちゃを紹介するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000212
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000212,
					"content": "えっ、おまえ気にならないのか？オイラたち…産業スパイみたいなもんなんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000213,
					"content": "はは、産業スパイか。君、面白いな。うちのメインは時計なんだ。代々受け継がれてきた技術で作ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000214
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000214,
					"content": "おもちゃは単なる私の個人的な趣味だからね。おもちゃは人に喜びを与えてくれる…より多くの人に知ってもらえれば、喜びがより遠くまで広がるはずだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000215
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000215,
					"content": "わあ、すっごく心温まる話だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000216,
					"content": "はは、兄さんは「冒険心に欠けてる」って言うだろうけどね…本題に戻ろう。よかったらおもちゃを試してみないか。気に入ってくれると嬉しいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000217
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000217,
					"content": "モンドでインスピレーションを得たって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000218
					]
				},
				{
					"id": 745000218,
					"content": "ああ、私は子供の頃からモンドに憧れてたんだけど、少し前やっとモンドに旅に行けたんだ。思った通り、沢山収穫があったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000219
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000219,
					"content": "モンドで出会ったある冒険者の物語を込めて、このおもちゃを作ったんだ。でも、あまり期待しすぎないで。所詮は単なるクロックワーク玩具だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000220
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000220,
					"content": "冒険者？なんだ、錬金術で作られたおもちゃじゃなかったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000221,
					"content": "錬金術でおもちゃ？それは面白そうだね。でも、その冒険者も深い印象を残してくれた仲間だったよ。機会があれば彼の物語もちゃんと聞かせてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000222
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000222,
					"content": "さて、早速このおもちゃを試してみるか？百聞は一見に如かず、ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000223
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745000223,
					"content": "#そうしたいところだけど、あいつらがオイラたちの返事を待ってるんだ。{NICKNAME}、早く行って、また戻ってこよう！この冒険者のおもちゃで早く遊んでみたいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000224,
					"content": "ああ、構わないよ。いつでも待っているからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カロン"
				}
			]
		},
