			"dialogs": [
				{
					"id": 745000101,
					"content": "いややで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000102
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000102,
					"content": "な、いややで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000103
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000103,
					"content": "それってフリーナ様が審判席に座るってことやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000104
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000104,
					"content": "そういうことや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000105
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000105,
					"content": "フリーナが審判席に座るって…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000106,
					"content": "おお！お客さんか。服装から見るに、他所から来たんやろ？フォンテーヌの地元の話が分からなくても無理ないわ。まず聞くけどな…審判席には誰が座るべきやと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000107
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000107,
					"content": "そりゃあもちろん審判官様やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000108
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000108,
					"content": "じゃあじゃあ、俺たちの最高審判官様は誰や？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000109
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000109,
					"content": "もちろんヌヴィレット様やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000110
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000110,
					"content": "おっと、ならヌヴィレット様の席に、水神フリーナ様が座ってるっちゅうんはどういうことや？お二人さんはどう思う？審判に掛けられた気の毒な人間はどんな思いがするやろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000111
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000111,
					"content": "俺なら絶対、ペテンにかけられたって思うな。水神様は、審判についてはさっぱりなんやで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000112
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000112,
					"content": "うーん…なんか、看板に偽りありって感じがするかな…なんて言ったっけ、羊の頭を看板にしてるのに、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000113,
					"content": "そう！まさに「羊頭狗肉」や！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000114
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000114,
					"content": "そうそう。って、あれ…？待て待て、自分たちの神様に対してそんなふざけた言い方をして大丈夫なのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000115,
					"content": "もちろん大丈夫ちゃうで。水神様はこういうふざけた話が一番好っきゃねん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000116
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000116,
					"content": "もしこれが水神様のお耳に入ったら、水神様は俺に石を括り付けて湖に放り投げた後、興味津々に観察されるにきまっとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000117
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000117,
					"content": "でもお二人さん、その後どうなると思う？アルボンのやつ、口が達者なおかげで、全然沈んでいかへんねん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000118
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000118,
					"content": "「生きてるぞ！」水神様は興奮のあまりパチパチと手を鳴らされる——「すごくロマンチックだ！」と仰りながら、少しばかり落涙されることもあるかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000119
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000119,
					"content": "うまくいけば俺に「フォンテーヌ浪漫市民」の勲章を授けてくださるかもしれへんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000120,
						745000121
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000120,
					"content": "すごくロマンチックだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				},
				{
					"id": 745000122,
					"content": "な、なんてコメントすればいいのか分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000123,
					"content": "さて本題に戻ろか。お二人さん、今日はうちの店に何のご用や？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000124
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000124,
					"content": "ところでアルボン、お二人さんは服装からして…前に店主が言ってた有名な冒険者っぽくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000125
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000125,
					"content": "#おおっ！確かに、金や銀のように光り輝く髪の毛…おおおおっ——まさかお二人さん、{M#サー}{F#マドモワゼル}·{NICKNAME}にマドモワゼル·パイモンなんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000126
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000126,
					"content": "わぁ、オイラたちを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000127,
					"content": "前、うちの店主が冒険者協会に、近頃フォンテーヌで活動中の冒険者がいないか尋ねたことがあってな。そのとき協会から、凄腕コンビって情報をもらったんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000128
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000128,
					"content": "#へへ、{M#サー}{F#マドモワゼル}·{NICKNAME}、オイラたちの名声はどんどん広まってるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000129,
						745000131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000129,
					"content": "#パイモン、{M#俺}{F#私}のお陰だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000130
					]
				},
				{
					"id": 745000130,
					"content": "ふんっ、だとしても、もうちょっと謙虚になれないもんかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000133,
					"content": "ところで、おまえたちの店主はオイラたちになんの用なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000134,
					"content": "あいにく、店主は今離席中や。とりあえず俺たちから説明するで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000135
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000135,
					"content": "じゃあざっと説明するで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000136
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000136,
					"content": "一言でいうと、店主の「決闘代理人プロジェクト」のデータ収集に協力してほしいんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000137
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000137,
					"content": "「決闘代理人プロジェクト」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000138,
					"content": "決闘代理人を物語の主人公にした、新しいクロックワーク玩具プロジェクトのことや。今後の研究開発の中心で、宣伝広報の方向性でもある。ああっ、うちは玩具を扱う店なんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000139
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000139,
					"content": "そういえば、お二人さんは「決闘代理人」については聞いたことあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000140,
						745000141
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000140,
					"content": "うん、話を続けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000145
					]
				},
				{
					"id": 745000145,
					"content": "店主はこの制度をフォンテーヌの文化的象徴やって考えててな、それをモチーフにした玩具を作れば、大ヒットするんちゃうかって考えたわけや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000146
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000146,
					"content": "もし大ヒットして他の国でも売れるようになったら、国民の誇りやで。一石二鳥やな！フリーナ様自ら、俺たちに勲章を授けてくださるかもやで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000147
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000147,
					"content": "そういうことだったのか…でも「決闘代理人」のおもちゃを作るのに、なにをオイラたち冒険者に頼むことがあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000148,
					"content": "研究開発には、データが必要やろ。でも手強い「決闘代理人」たちは、様々な危険に満ちた場所で武芸を鍛えあげてるから、彼らのデータを入手するのは至難の業やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000149
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000149,
					"content": "でも…凄腕の冒険者たちも似たようなことをするって聞いたんや。なんやったら、冒険者に協力を仰ぐのもいいかって考えてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000150
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000150,
					"content": "ああ！なんとなく分かったぜ…「決闘代理人」って名前のおもちゃだけど、冒険者からデータを提供してもらいたい、ってことなんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000151,
						745000152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000151,
					"content": "羊頭狗肉だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000153,
					"content": "そこまではいかへんやろ。せいぜい、「ロマリタイムフラワーを移してマロウの木に接いだ」くらいやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000154
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000154,
					"content": "なんでやねん、「木の柱を盗んで、石の柱と取り換えた」くらいやろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000155
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000155,
					"content": "いったいどう違うんだよ。おまえたちの話は、最初からずっと聞いてたんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000156,
					"content": "あーそれか、それは隣の隣のルポート時計店のことやな。あいつらは、俺たちよりよっぽどひどいんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000157
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000157,
					"content": "看板には時計店って書いていながら、こっそりおもちゃを売り始めたんや。なあ君たち、ひどいと思わへんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000158
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000158,
					"content": "ほんま、ひどい話やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000159
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000159,
					"content": "時計店でおもちゃを売ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000160,
					"content": "そうなんや。ひどいマネやと思わへんか？例をあげてみよか。君、一番好きなものは何や？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000161
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000161,
					"content": "#一番好きなもの…？そりゃもちろん、オイラの最高の仲間{NICKNAME}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000162,
					"content": "#例えば「{NICKNAME}人形店」っていう名前の店があるとする。長い道のりの末、やっとその店に着いてみたら…なんとその店で売ってるのは{NICKNAME}人形じゃなくて、アルボン人形やった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000163
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000163,
					"content": "そうして、大好きな仲間を買う楽しみは水の泡になってしまった…どうや、心の底から怒りがこみあげて、泣きわめきたい気分になって、店主をボコボコにしたいと思わへんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000164
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000164,
					"content": "ムカつくな！アルボン人形なんかを買いたい奴がいるか？俺やったら一発で店主をメロピデ要塞に投げ入れるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000165
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000165,
					"content": "#うううっ、言われてみたら、確かにちょっとムカついてきたぞ…どうしよう、{NICKNAME}、おまえの人形が急に買えなくなるなんて嫌だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000166,
						745000167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000166,
					"content": "待って、二人は話をすり替えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000168,
					"content": "た…たしかに！オイラ、危うく引っかかるところだったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000169,
					"content": "おっと、まあこれはただの比喩やから、あんまり現実にそぐわへん場合もあるやろう…それに、俺の言った状況もあり得ると思わへんか？晶螺マドレーヌには晶螺なんて入ってへんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000170
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000170,
					"content": "そうや。そんなことがどんどん増えていったら、いずれ時計店で時計を売らへんようになることさえあり得る。ルポートおもちゃ工房に店の名前を変えへんかぎり、絶対あいつらを許さへんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000171
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000171,
					"content": "今回は状況の仮定だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000172
					]
				},
				{
					"id": 745000172,
					"content": "おまえたち、ホントに屁理屈キングだな！これ以上聞いてたらどんどん話が逸れちゃうぞ…本題に戻ろうぜ。オイラたちはどうやってデータ収集に協力すればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000173
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000173,
					"content": "うん、でも実はその前に、ちょっと他の件でも頼みたいことがあるんや。隣の隣のルポート時計店に行って、あることを聞いてきてくれへんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000174
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000174,
					"content": "あいつらの本業はクロックワークの時計だけど、新発売のおもちゃが大人気で、うちの客まで奪われる始末なんや。あっちの店主がモンドでインスピレーションを得て作ったものやそうやけど、一体どんなものなのか知りたいんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000175
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000175,
					"content": "もしかしたら、何かの錬金術かもしれへん。夕暮れの実の四倍も甘ったるい香りを出して、周囲の人々を瞬時に魅了する…噂では、モンドにはそんな錬金術師がいるそうやないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000176
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000176,
					"content": "甘さ四倍の夕暮れの実？もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000177
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000177,
					"content": "だからお二人さん、そのおもちゃについて聞いてきてくれへんか？店主がめちゃくちゃ気にしてたんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000178
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000178,
					"content": "どうして自分たちで行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000179
					]
				},
				{
					"id": 745000179,
					"content": "そりゃあ、商人のメンツってものがあるやろ？しれっと訪ねるわけにはいかへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000180
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000180,
					"content": "そう、メンツ！メンツは何より大事なんやで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000181
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000181,
					"content": "俺はちょうどお二人さんが来たことを店主に知らせに行かなアカンから、この件については頼むで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000182
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000182,
					"content": "#{NICKNAME}、話を聞いてたら、モンドでインスピレーションを得てフォンテーヌで作られたっていうのがどんなおもちゃなのか、オイラも見てみたくなったぜ。ホントに錬金術と関係してるのかな？とりあえず見に行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000183
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000183,
					"content": "ほんまに助かるで。お二人さんのいい知らせを待ってるで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000167,
					"content": "代わりじゃなくて追加で売ってるんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000168
					]
				},
				{
					"id": 745000152,
					"content": "フリーナ様が審判席に座るのと一緒！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000153
					]
				},
				{
					"id": 745000141,
					"content": "聞いたことがない。何それ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000142
					]
				},
				{
					"id": 745000142,
					"content": "これはフォンテーヌ特有の制度なんやけど、もし何か罪を犯して審判を受けることになった場合、「決闘代理人」との「決闘」を申し込むことができるんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000143
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000143,
					"content": "「決闘代理人」に勝つことができたら、罪には問われず、自身の名誉を守ることができる。そして二度と審判に掛けられることもない。もちろん、「決闘代理人」を倒すのはそう簡単なことちゃうけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000144
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745000144,
					"content": "きっとおもちゃを売るより難しいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000145
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745000131,
					"content": "パイモン様、あなたのお陰です。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000132
					]
				},
				{
					"id": 745000132,
					"content": "へへへ、おまえも口がうまくなってきたじゃないか。今後、オイラの幸運はおまえにも分けてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745000121,
					"content": "それがフォンテーヌ流のロマンなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000122
					]
				}
			]
		},
		{
			"id": 7450002,
			"completionStepIds": [
				7450005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
