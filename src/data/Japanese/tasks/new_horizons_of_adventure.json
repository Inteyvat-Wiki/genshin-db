			},
			"dialogs": [
				{
					"id": 221110101,
					"content": "新しい依頼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110102,
					"content": "こんにちは、冒険者さん。あなたの冒険の話はモンドの多くの人に知られています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110103,
					"content": "この勢いで頑張っていけば、きっと偉大な冒険者になれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110104,
					"content": "なにか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "偉大な冒険者になりたいなら、一つのところで冒険してちゃダメですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110106,
					"content": "もう十分な経験を積んだことですし、ほかのところを挑戦してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110110,
					"content": "この手紙を璃月港のキャサリンさんに届けてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110111,
					"content": "璃月港の…キャサリン？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "そうです、すぐ見つかります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110115,
					"content": "この手紙を持っていれば、彼女も私みたいにあなたの冒険に様々なサービスを提供します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110116,
					"content": "もしまたモンド城に戻ってきたら、私もいつも通りのサービスを提供しますので、ご安心ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110117,
					"content": "そういえば、この手紙は勝手に開封しないでくださいね。落としたら面倒な事になるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110118,
					"content": "星と深淵を目指し、前へ進んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110113,
					"content": "じゃあ君は「モンド城のキャサリン」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "いいえ、もっと呼びやすい名前で結構です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110107,
					"content": "モンドだけなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "今までずっとモンド周辺だけで冒険をしてましたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110109,
					"content": "でも、今すぐにでも外の世界に行けるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 2211102,
			"completionStepIds": [
				2211102
