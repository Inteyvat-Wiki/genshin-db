			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110201,
					"content": "あなた宛の手紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110202,
					"content": "星と深淵を目指せ！ようこそ、冒険者協会へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110203,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}宛の手紙のはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "手紙？見せてください。うーん…あなたはモンドからの冒険者ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110205,
					"content": "あれ？これは…蒲公英？なんで手紙にこんなものが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110206,
					"content": "冒険者さん、あなたが蒲公英を手紙に入れて、ご自身がモンド出身だということを証明しようとしているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110207,
					"content": "考えすぎです。この手紙の内容だけであなたの身分と経歴がわかります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110208,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "まあ、重要なことではないので、気にしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110214,
					"content": "モンド冒険者協会の手紙から見ると、あなたはすでにベテラン冒険者ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110215,
					"content": "璃月冒険者協会の様々な依頼のために準備してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110216,
					"content": "星と深淵を目指して、新しく偉大な冒険があなたを待っています！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110210,
					"content": "まさかキャサリン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "キャサリン？あら、もしかして「モンド城のキャサリン」ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110212,
					"content": "なんで蒲公英を入れたんでしょう？おかしいですね…冒険の役に立たないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 221110213,
					"content": "まあ、重要なことではないので、気にしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "キャサリン"
				}
			]
		}
	]
