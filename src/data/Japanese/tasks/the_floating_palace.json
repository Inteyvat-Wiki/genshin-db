			"dialogs": [
				{
					"id": 10200401,
					"content": "止まれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200402,
					"content": "何者だ、勝手に要地に入り込むとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200403,
					"content": "勝手に？通りがかっただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "そうだそうだ、訳が分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200406,
					"content": "オイラたちは招待されてここに来たんだ！そんな風に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200407,
					"content": "いや…待った…まさか凝光…わざとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200408,
					"content": "群玉閣に招待する振りをして、実はここに来たオイラたちを捕まえるつもりなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200409,
					"content": "違うと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "うお——怒ったぞ！そこの兵士、オトリ捜査反対！卑怯だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200412,
					"content": "何を…普通に仕事しているのに、卑怯とは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200413,
					"content": "意味がわからない。とりあえず、捕まえるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "阿陽"
				},
				{
					"id": 10200414,
					"content": "来るぞ、やってやろうじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200410,
					"content": "まだ招待された事を彼に説明してない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "要地？ここは天衡山の外じゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
