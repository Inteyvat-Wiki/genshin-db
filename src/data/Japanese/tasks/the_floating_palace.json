			"dialogs": [
				{
					"id": 10200101,
					"content": "ほら！空にあるあれが「群玉閣」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200102,
					"content": "高い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "えっ…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200105,
					"content": "しまった！道案内役なのに、「天上」への行き方が分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200106,
					"content": "今さら気付いたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "うう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200109,
					"content": "でも、地図上から群玉閣の位置を直接探すのもアリだと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200110,
					"content": "その近くに上がる方法があるはずだ！探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200107,
					"content": "あの時、甘雨に聞けばよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "どうやって行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
