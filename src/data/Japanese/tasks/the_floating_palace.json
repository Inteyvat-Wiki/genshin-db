					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "見ろ、装置だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200202,
					"content": "この位置にあるからには、きっと群玉閣と関係があるはずだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200203,
					"content": "群玉閣に繋がる道かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "きっとそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200205,
					"content": "普通に罠かも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "まさか？オイラを信じろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
