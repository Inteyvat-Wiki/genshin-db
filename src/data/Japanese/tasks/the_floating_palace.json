			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "んー？ここまでだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200702,
					"content": "風域がもっと強かったら、そのまま行けたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200703,
					"content": "璃月港に戻って千岩軍に聞こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "ん？なんで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200705,
					"content": "上がる方法は秘密じゃないはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "…ああ、分かったぞ！じゃなきゃ、あの甘雨が群玉閣まで案内してくれてるはずだもんな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200707,
					"content": "よしっ、おまえの言うとおりに、まずは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200708,
					"content": "あっ！待った、下を見ろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200709,
					"content": "もう<color=#00E1FFFF>「帰終機」</color>の近くまで来てたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200710,
					"content": "そうだ…うん…いいアイデアを思いついたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200711,
					"content": "——「帰終機」でおまえを上に飛ばそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200712,
					"content": "いや、死んじゃう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "あう…確かに安全面まで考えてなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200716,
					"content": "でも、帰終機には望遠機能がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "あっ、そうだった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200718,
					"content": "確かにそれは使える…さあ、帰終機で上に行く道がないか探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200714,
					"content": "非常食扱いを根に持ってる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "うう…安全面を忘れてただけだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}