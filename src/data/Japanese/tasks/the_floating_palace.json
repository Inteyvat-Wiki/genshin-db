			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "やめなさい！何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200602,
					"content": "刻晴様、この不審者たちが帰終機に何かしようとしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "華清"
				},
				{
					"id": 10200603,
					"content": "だ、誰が不審者だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200604,
					"content": "群玉閣への道を探してるだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "ん？「群玉閣」？君たち、何者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200606,
					"content": "招待された客人で、「璃月七星」を探してる！そっちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200608,
					"content": "奇遇ね、私がその「璃月七星」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200609,
					"content": "？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200610,
					"content": "私は刻晴、璃月七星「玉衡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200611,
					"content": "旅人、君のことは知ってるわ。凝光の客人よね？まさかここで会うとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200612,
					"content": "おぉ——こんな荒野でお金持ちと会えるなんて思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200613,
					"content": "壊れた天衡古城垣の帰終機が一夜で修復された。私がここに来たのはそのことを調べるためよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200614,
					"content": "この千岩軍たちがいるのも、現場を守るためだけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200615,
					"content": "誤解だったんだな？うん…全く思いつかなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200616,
					"content": "ちゃんと考えれば分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "そもそも、仙人の作った装置を直せる凡人がいるなんて、「七星」にとっては不思議な話よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200618,
					"content": "へへっ、それはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200619,
					"content": "（シッ…余計なことは言わない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "ん？あっ、ああ…そうだ、「玉衡」様は「天権」様がオイラたちを招待した理由を知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200622,
					"content": "刻晴でいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200623,
					"content": "そうね、彼女が君を呼んだのは「モンドを救った英雄」に中立を保っていて欲しいからだと思うよ…完全に仙人の味方にならずにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200624,
					"content": "別に誰かの味方でもないよな！あの仙人たちだって、璃月を守ろうとしてるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200625,
					"content": "その「守る」は、上から目線の傲慢のことかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200626,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200627,
					"content": "君たちは凡人。彼らの守る対象だから、彼らは君を「神を殺せる刺客」だとは思わないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200628,
					"content": "だから凝光が現場を封じ、民を取り調べて刺客を探すなんて命令を…彼らは何かを隠すための工作だと思ってるでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200629,
					"content": "そう、彼らは私たちを軽蔑してるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200630,
					"content": "確かにそれも一理あるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200631,
					"content": "でも、刻晴みたいな「仙人を敬わない」璃月人は初めて見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200632,
					"content": "ハッ…時間の概念が薄いだけで敬えと？彼らは凡人に対して傲慢だから、私たち「七星」にしばらく手は出してこないでしょうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200633,
					"content": "いい、今のは忘れて。「敬わない」はあくまで私個人の信条だから、凝光はそんなこと言わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200634,
					"content": "とにかく、今回彼らの行動は十分自制があるものだと認めるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200635,
					"content": "帝君の殺害は尋常じゃない。こんな事態を前に、彼らは直接攻撃してくるのではなく、他の仙人を招集して話し合うことにした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200636,
					"content": "思いのほか理性的ね、意外だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200637,
					"content": "つまり、和解の可能性もあると？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "凝光はね…何でも交渉で解決しようと思ってるけど——それは詭弁だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200640,
					"content": "「仙人」の時代は終わった。「璃月七星」さえもそれを受け入れなければ、璃月の未来はどうなるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200641,
					"content": "わっ…また大胆な発言だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200642,
					"content": "まあ…話は以上よ。ここまで話すつもりはなかったけど、君はいい聞き手よね、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200643,
					"content": "さあ、群玉閣に行きなさい。ちゃんと時間を守ってよ？凝光に会いたい人はたくさんいるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200644,
					"content": "璃月の富豪たちにとって、「群玉閣に登る」ことは最高の栄誉よ。なんたってメリットしかないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200645,
					"content": "メ、メリット！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200646,
					"content": "パイモン、そこじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "でも…でも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200649,
					"content": "そうだ！「手土産」も璃月の文化だぞ。メリットのためじゃない、璃月の伝統文化のためだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200650,
					"content": "パイモン、また始まった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "まあまあ、手土産はあとでいいから、まずは群玉閣に行く方法を教えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200652,
					"content": "本当はここに来なくてもいいの。璃月港に戻って、月海亭で「案内人」を探せばね。それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200653,
					"content": "では、また会いましょう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10200654,
					"content": "うん…あの「玉衡」は仙人を敬わないけど、あっさりした人だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200655,
					"content": "いい人だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "そうだ、凝光への手土産はどうする…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200658,
					"content": "パイモンの優先事項が手土産になった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "そうだ！昨日、夢で素敵な料理を思いついたんだ。その名も——<color=#00E1FFFF>「アイシングスライム」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200660,
					"content": "凝光みたいな大富豪にピッタリだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200661,
					"content": "それを手土産にしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200662,
					"content": "レシピは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "ない！でも「ピキーン」って感じでやればいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200666,
					"content": "まずは材料だ！急げ、栄光と富が待ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200664,
					"content": "夢で思いついたものをどう作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "「ピキーン」って感じでやればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10200656,
					"content": "彼女の話には同感できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "パイモン、真面目な話の途中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "凝光も仙人と交渉したいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "（大したことしてないよ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
