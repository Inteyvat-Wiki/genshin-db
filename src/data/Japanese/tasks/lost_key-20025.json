			"dialogs": [
				{
					"id": 200250101,
					"content": "旅人、ちょうどよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250102
					],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250102,
					"content": "もともと荷物をモンドに運ぶ予定だったが、昨夜ここを通った時、キラキラしたものがいくつか見えてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250103
					],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250103,
					"content": "飲みすぎたせいか…急にその正体を確認したくなったんだ。近くまで行ったらあれがスライムの群れだって気付いて、そしたらヤツらに攻撃されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250104
					],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250104,
					"content": "怖かったが、方向が分からなくてな、ようやくなんとか馬車に戻れたんだ。それで朝になってから<color=#00E1FFFF>鍵</color>がなくなったことに気付いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250105
					],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250105,
					"content": "探してきてくれないか？きっとこの周辺に…すぐ近くにあると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250106,
						200250108
					],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250106,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250107
					]
				},
				{
					"id": 200250107,
					"content": "よかった。ここ結構広くてな、どこから探せばいいか悩んでたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワイアット"
				},
				{
					"id": 200250108,
					"content": "他に急用がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250109
					]
				},
				{
					"id": 200250109,
					"content": "こんな広い場所は俺ひとりじゃ探せないよ。お前にしかできないんだ、頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワイアット"
				}
			]
		},
