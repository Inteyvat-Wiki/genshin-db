			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アラミス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "はぁ…どうしたものか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030102,
					"content": "何かトラブルでもあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "風花祭になると、毎回この神像に色々な花が贈られるんだ。そして風が吹くと、花びらが城内に向かって飛んでいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030104,
					"content": "この枯れた花を片付けるのにいつも苦労するよ。広場の花びらや葉などは俺たちでもなんとかなるけど、屋根や城壁の上にあるのはどうにもできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030105,
					"content": "それに俺の膝も…そろそろきつくなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030106,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "手伝ってくれるのか？ありがとう。あの枯れた花びらは特徴的だから、屋上に登ればすぐに見つかるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラミス"
				}
			]
		},
