			"trigger": {
				"objectNames": [
					"迷子の子猫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "本当に子猫がいた。どうしてこんなところに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700030502,
					"content": "にゃん…にゃん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "迷子の子猫"
				},
				{
					"id": 700030503,
					"content": "ニャオ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "ニャオ、ニャオ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "迷子の子猫"
				},
				{
					"id": 700030506,
					"content": "うーん…こっちの話を理解できてないと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700030507,
					"content": "とりあえず下におろそう。アラミスさんならこの子猫の主人を知ってるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700030504,
					"content": "迷子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
