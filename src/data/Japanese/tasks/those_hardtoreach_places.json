			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アラミス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "すまないが、見たことない。もし見たことあったら印象に残ってるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030602,
					"content": "そう…あの子花びらが好きだから、花びらを追ってきたのかと思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700030603,
					"content": "猫を探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "ニャオ…ニャッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "迷子の子猫"
				},
				{
					"id": 700030605,
					"content": "この声…蝶々ちゃん？もう、どこに行ってたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700030606,
					"content": "屋根の上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "やっぱり考えが当たってたのね…ありがとう。蝶々ちゃんは花びらが好きでいつも追いかけていくの。だから風花祭は特に世話が焼けるの…本当に助かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700030608,
					"content": "次また「キャッツテール」に来たら、一杯おごってあげる。あっ、もちろんお酒が入ってないものでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700030609,
					"content": "やっぱり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "ふふっ、ありがとう。じゃあまたね。楽しい風花祭になりますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700030612,
					"content": "まさか子猫も花びらに惹かれるとはな…さすが風花祭、とても賑やかだ…見つかってよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030613,
					"content": "もし俺が城壁を登って猫を探してたら、今度こそ膝が壊れてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030614,
					"content": "面倒をかけたな、これは報酬だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700030610,
					"content": "また今度にするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}