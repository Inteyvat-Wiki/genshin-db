			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "やっと着いたぁ。ここが「豊穣の邦」の集落で、わたしのお家だよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180814,
					"content": "わぁ、いいとこだな～！あの牛の頭の形をした高台、すっごく立派だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180802,
					"content": "えへへ、あれは「エコーアリーナ」って言うんだぁ。わたしたちがいろんな大会を開催してる場所なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180803,
					"content": "ここまで案内してくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "どういたしまして～！これくらい朝飯前だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180815,
					"content": "ゆっくりここを案内してあげたいところだけど、実は一回お家に帰らないといけないんだ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180816,
					"content": "なにか大事な用事でも思い出したのか？さっきヒルチャールが現れたときも、かなり急いでたみたいだったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180817,
					"content": "もしかして邪魔しちゃった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "ぜんぜん大丈夫だよ、時間にも余裕あったし！でもこれはわたしにとって、すご～く重要なことなんだ。トレーニング後の一番大切なこと、それは…ご飯を食べることだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180805,
					"content": "お腹が空いたら力が出なくなるし、目まいもしちゃう。それから頭がふらふらして変なことばっかり考えるし、身体に悪いことだらけでしょ？だから、絶対に気をつけないとダメなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180806,
					"content": "ほんとごめんねぇ！どうしてもわたし、今すぐ、今すぐご飯を食べなきゃ！きみたちも早くご飯を食べてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180807,
					"content": "それじゃ、あとでまた「エコーアリーナ」で会おう。バイバーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180808,
					"content": "ヴァレサのやつ、もう行っちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180809,
					"content": "なんていうか、不思議な子だったな。ふわふわしてるかと思えば、すごい勢いがあったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180810,
					"content": "これぞ「青春」だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "「これぞ『青春』だ」——って、急に年寄りみたいなこと言うなよ！オイラもおまえもまだ若いだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180812,
					"content": "ヴァレサも帰っちゃったことだし、オイラたちだけでこの辺をぶらぶらしてみようぜ。「エコーアリーナ」にはあとで行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180813,
					"content": "あんなに高いところなら、きっと見晴らしも最高なはずだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
