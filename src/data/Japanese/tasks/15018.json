			},
			"dialogs": [
				{
					"id": 150180501,
					"content": "オイラはパイモンで、こいつは旅人だ。オイラたち最高の仲間なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180502,
					"content": "うんうん、パイモンちゃんと旅人さんかぁ～、すっごくいい名前だねぇ。ちゃんと覚えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180503,
					"content": "それじゃあ出発しよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
