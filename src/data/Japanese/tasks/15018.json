				"points": []
			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "おまえがあのヴァレサだったのか！聞いたことある名前だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180202,
					"content": "オイラはパイモンで、こいつは旅人だ。オイラたち最高の仲間なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180203,
					"content": "うんうん、パイモンちゃんと旅人さんかぁ～、すっごくいい名前だねぇ。ちゃんと覚えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180204,
					"content": "それじゃあ出発しよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
