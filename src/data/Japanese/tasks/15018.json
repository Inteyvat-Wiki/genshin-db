			"dialogs": [
				{
					"id": 150180301,
					"content": "こんにちは～！ちょっといいか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180303,
					"content": "ん～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180304,
					"content": "きみたち、もしかして迷子～？何か手伝おっか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180305,
					"content": "いや、たまたまこの辺を通りかかったから「豊穣の邦」に行ってみようかなと思って…この道で合ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180306,
					"content": "そだよ～わたしのお家もそこにあるんだ。よかったら連れてってあげるよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180307,
					"content": "ほんとか！ラッキー、また現地のガイドに出会えたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180308,
					"content": "サボりたいってしっかり顔に書いてあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "ガイドか…道案内くらいはわたしにも出来るよね。えへへ、じゃあ今からわたしがきみたちのガイドだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180310,
					"content": "この道にはね、特別な景色がたくさんあるんだぁ～！紹介してあげるね。初めてここに来る人はみんな「わあ～」って驚くんだから～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180311,
					"content": "あ、いやちょっと待ってくれ…気持ちはありがたいけど、こんなすぐ引き受けてくれると、なんか逆に申し訳なくなってくるぞ…えっと、ほんとにいいのか？たぶん他に用事があったんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180312,
					"content": "平気平気～もともとここにはトレーニングで来てただけなんだ。ちょうど荷物をまとめて、お家に帰ろうと思ってたところだから、ついでだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180313,
					"content": "それにねぇ、わたしがガイドになれば、この辺りの自然とか文化のこともいろいろ教えてあげられるよ。そしたら、もっと楽しめるでしょ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180314,
					"content": "きみたちが喜んでくれたら、わたしも嬉しいんだ。アカトルおじさんが言うには、これが「おもてなしの道」なんだって～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180315,
					"content": "お、おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180316,
					"content": "なんだか純粋で親切なやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180317,
					"content": "今日はツイてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "だな、オイラもそう思うぜ。こいつのこと気に入ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180319,
					"content": "どしたの？準備できたら出発しよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180320,
					"content": "そういえば、まだ名前を聞いてなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180321,
					"content": "あっ、そうだったねぇ～、わたしはヴァレサ。きみたちに会えてすっごく嬉しいよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				}
			]
		},
