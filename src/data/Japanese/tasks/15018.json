				{
					"id": 150180404,
					"content": "きみたち…もしかしてパイモンちゃんと旅人さん！？よかった、ずっと待ってたんだ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180405,
					"content": "おおっ!オイラたちのこと知ってるのか？へへっ、すっかり有名人だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
