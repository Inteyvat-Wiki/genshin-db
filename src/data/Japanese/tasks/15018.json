			"dialogs": [
				{
					"id": 150180101,
					"content": "ん？あの木の板って、なんに使うもんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180107,
					"content": "あ～あれはねぇ、わたしたち部族のトレーニング器具だよ。わたしもよく使ってるんだ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180108,
					"content": "トレーニング器具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180109,
					"content": "んーと、そだなぁ…説明するより、直接見せたほうが早いかも。ヴァレサ、いっきま～す！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180103,
					"content": "よしっ！着地成功～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180104,
					"content": "うわぁ～！あっという間に飛び越えちゃったぞ。おまえすごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150180105,
					"content": "そんな大したことないって～！ちゃんと練習すれば誰だってできるようになるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180110,
					"content": "わわ！トレーニングなしで、そのまま飛んで来れちゃうんだねぇ。わたしよりずっとすごいよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 150180112,
					"content": "これはちょっと違うけど…まあ、おまえの言う通りだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
