			"dialogs": [
				{
					"id": 761920201,
					"content": "よく撮れてるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920202,
					"content": "満足したかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920203,
					"content": "うん！伝説が本当かどうかはおいといて、ヘルカがどこへ行っても幸運が危険から守ってくれて、無事に「スペランザ」に帰ってこられるように願ってるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920204,
					"content": "…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920205,
					"content": "えへへ、じゃあ帰ろっか？リンネアお姉ちゃんもありがとう。また「スペランザ」でね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920206,
					"content": "うん、またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リンネア"
				}
			]
		},
