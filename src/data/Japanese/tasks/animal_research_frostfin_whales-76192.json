			"dialogs": [
				{
					"id": 761920101,
					"content": "今日はツイてないみたいだね。こんなに待ったのに、普通のフロストフィンイルカにもあまり会えないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920102,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920103,
					"content": "今日はここまでにして帰ろう。チャンスはまだあるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920104,
					"content": "でも…長くは滞在できないんだよね？すぐにまたどこかへ行っちゃうんでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920105,
					"content": "もう少し待ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920106,
					"content": "えっ…？まさか、ヘルカ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920107,
					"content": "リンネアお姉ちゃん。うん、戻ってきたんだ。でも、僕の図鑑は完成までもう少し時間がかかりそうだから、まだお姉ちゃんと勝負できないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920108,
					"content": "へぇ？その様子だと、今回の旅でかなりの収穫があったみたいだね。でも、私だって何もせずに過ごしてたわけじゃないんだから。図鑑にたくさん補足を書き加えたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920109,
					"content": "リンネアお姉ちゃんも、あのフロストフィンイルカを見に来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920110,
					"content": "そうそう！最近発見されたばかりなんだって。あの体型からして、環境の変化が表皮の変色を引き起こしたと思うんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920111,
					"content": "例えば、この環境のクーヴァキの濃度とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920112,
					"content": "残念だけど、今日は見られなさそうだよ。僕たちも結構待ったんだけど、会えてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920113,
					"content": "リンネアお姉ちゃんからもあの子に言ってやってよ。今日はもう戻ろうって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920114,
					"content": "あたしは平気だよ。今日は、朝からいつもより調子がいい気がするの。もう少しだけ待ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920115,
					"content": "あのフロストフィンイルカに出会った人は、願いが叶うって言われてるの。ということは、きっと幸運をもたらす動物なんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920116,
					"content": "ヘルカには、その子がもたらしてくれた幸運を持って、また旅立ってほしいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920117,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920118,
					"content": "じゃあ、一緒に待とうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920119,
					"content": "リンネアお姉ちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920120,
					"content": "大丈夫だよ。なんとなくそんな気がするんだ…きっと、あのフロストフィンイルカを見られるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920121,
					"content": "ヘルカも知ってるでしょ？私の予感はいつも当たるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920122,
					"content": "わかったよ…じゃあもう少しだけ、本当にもう少しだけだからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920123,
					"content": "しばらく待ち続けた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "見て見て！わあ、すごく高く跳んでるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920125,
					"content": "私もあんなに速く泳げたらなあ…あの子たちと一緒に泳げたら、楽しそう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920126,
					"content": "いっそ今、水に入って試して——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920127,
					"content": "危なすぎるよ！はぁ、こんなに長く離れてたのに戻ってきてみたら、リンネアお姉ちゃんは相変わらずそそっかしいんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "ヘルカ"
				},
				{
					"id": 761920128,
					"content": "そ、そんなことないよ！ヘルカだって、あの子たちと一緒に遊びたいでしょ？あんなに楽しそうに遊んでるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761920129,
					"content": "でも、服が濡れて風邪を引いたら大変だよ。岸に残って、写真機であの子たちの楽しそうな様子を記録するのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "メイジー"
				},
				{
					"id": 761920130,
					"content": "それもそっか…じゃあ、ヘルカの写真機を借りるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リンネア"
				}
			]
		},
