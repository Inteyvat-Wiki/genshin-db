						],
						"pointId": 7523
					}
				]
			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "おーい、誰かいないのかよ。新聞はもういらないのか？なんか返事してくれって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "ブノワさんは不在？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "知らないよ。自分で新聞を頼んどいて、受け取らないなんておかしいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530105,
					"content": "前は新聞を玄関まで届けに行くと、少なくともルロワさんが返事をしてくれたのに。最近じゃめっきりその影もないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530106,
					"content": "おかげで、あの人が購読してるスチームバード新聞がこんなにも溜まっちゃったよ。あんたら、あの人と知り合いなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530107,
					"content": "おう。オイラたちはブノワじいちゃんの友達だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530108,
					"content": "友達？…まぁいいや。だったら新聞をあんたらに渡しとくからさ、あの人に会ったら渡しといてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530109,
					"content": "分かった、任せておいて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "こっちだって真面目にやってるんだし、あとになって新聞が届かなかったなんて文句言われないといいけど。他にやることだってあるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530112,
					"content": "オイラたちも最近、全然見てないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530113,
					"content": "あんたらもかよ？ルロワさん、一体何してるんだろ。まさか前の家に戻っちゃったとか？そんなの聞いてないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530114,
					"content": "前の家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "ああ、サーンドル河にある昔の家さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530116,
					"content": "ブノワじいちゃんってもともとサーンドル河に住んでたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530117,
					"content": "サーンドル河から引っ越してきたことも知らないなんて…あんたら、ほんとにあの人の友達なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530118,
					"content": "ええっと…オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530119,
					"content": "ああ、説明しなくてもいいよ。あんたらとあの人の関係なんてちっとも興味ないしさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530120,
					"content": "とにかく、新聞さえ届けてくれたらそれでいい。ほら、この新聞な。じゃあ俺、もう行くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "ピプ"
				},
				{
					"id": 741530121,
					"content": "ブノワじいちゃんには、オイラたちの知らない事情がまだまだあるんだな。なあ、オイラたちの調べてることと関係あると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530122,
					"content": "かなりあると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "よし！ならブノワじいちゃんの家の近くをちょっと調べてみようぜ。もしかしたら、ブノワじいちゃんのことがもっとわかるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530125,
					"content": "あっ…でも静かに行動したほうがいいかもな。でないと、あの夫婦に警戒されちゃうだろうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530123,
					"content": "情報は多いほどいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "パイモンが持ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
