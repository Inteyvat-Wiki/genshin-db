					},
					{
						"sceneId": 3,
						"position": [
							3505.04,
							283.082,
							4528.36
						],
						"pointId": 7524
					},
					{
						"sceneId": 3,
						"position": [
							3504.077,
							283.082,
							4528.295
						],
						"pointId": 7525
					}
				]
			},
			"dialogs": [
				{
					"id": 741530701,
					"content": "はぁ、つまらん…働きたくない…いつになったら金持ちになれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530702,
					"content": "ブノワ·ルロワについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "…ルロワ？その名前どっかで聞いたことあるような、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530704,
					"content": "ああ、思い出した。ブノワ·ルロワ、露店の雑貨屋の店主だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530705,
					"content": "彼がどうかしたのか？っていうかお前ら誰だ？それを聞いてどうするつもりだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530706,
					"content": "いや、オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530707,
					"content": "色々と複雑な事情があるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "えっ、それって…まさか…彼がなんかやらかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "あーなるほどね…もう一つ聞いときたいんだけど、お前らをよこしたのは棘薔薇の会？それとも執律庭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530712,
					"content": "#「{M#君}{F#あなた}には黙秘権があるけど…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "「発言はすべて法廷での証拠となる…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#（おおっ！演技が上手いな、{NICKNAME}。さすがだぜ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530715,
					"content": "わ、分かったよ。もう聞かないさ。彼の稼ぎ方はあんまりいいやり方じゃなかったからな。フォンテーヌの数ある法律のどれかに抵触したってことだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530716,
					"content": "調査官さん、俺のところに来て正解だぜ。何しろ俺はあの家族をよく知ってるからな。ブノワはたくさん悪事を働いてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530717,
					"content": "俺ももう結婚して所帯を持つような年になったし、彼もずいぶん老け込んだだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530718,
					"content": "あの人にはオー{RUBY#[D]秋}タムって名を持った、美人の娘がいてな。くくっ、まぁあいつは自分の娘と俺たちを関わらせなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530719,
					"content": "オータム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "ああ。オータム·ルロワ。ブノワ·ルロワの養女だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530721,
					"content": "考えてもみろよ。雑貨売りで小銭稼ぎしかできなかった男が、なんで突然金持ちになって上に引っ越したと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530722,
					"content": "あいつは美人で若い娘のオータムを使ったに違いない。金持ちの老人と無理やり結婚させたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530723,
					"content": "ほんの数年でその老人は亡くなっちまった。ジジイの家は当然、オータムのモノになる。オータムのモノはやつのモノだ。そうやってあいつは一気に「上の人間」になったんだと思うぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530724,
					"content": "チッ、なんであんな男に一夜にして大金持ちになれる幸運が舞い込むんだよ。あの老いぼれはな、自分の娘の血を吸ってるってことさ。とんでもないヤツだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530725,
					"content": "（ホントにそうなのかな？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530726,
					"content": "（もう少し聞いてみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "調査官さんは、このことを探りにきたんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530728,
					"content": "つまり、もしこの些細なことがお前らの役に立つなら、俺もフォンテーヌの安全に貢献したってことにならないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530729,
					"content": "社会に貢献した市民に、執律庭は褒美をくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530730,
					"content": "そのことはもう知ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "まぁ待てよ、他にも教えられることがあるんだ。ここはサーンドル河だぜ。他人の秘密を一つや二つ知っておかないと安心して眠れやしない…くくっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530734,
					"content": "いいか、オータムには二人目の夫がいる。彼女はすぐにまた結婚したんだ。結構遠くに嫁いだもんだから、それっきり彼女を見かけてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530735,
					"content": "俺たちが再びオータムのことを耳にしたのは、彼女が「あれ」を犯したときだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530736,
					"content": "「あれ」ってなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530737,
					"content": "なんだ、調査官さんは知らないのか？オータムは二人目の夫を殺して、メロピデ要塞送りになったのさ。ブノワのことを調べに来たのに、そんなことも知らないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530738,
					"content": "パイモン隊員、これが事件関係者の記録だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#うっ…えっと、ゴメンよ{NICKNAME}隊長…今度からは気をつけるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530741,
					"content": "話を続けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "ああ、ちょうど言おうと思ってたところさ。これは聞いた話なんだが、オータムの裁判で彼女はブノワの出廷を希望したんだが、やつはそれを拒否したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530744,
					"content": "ブノワは未婚で、家族は娘のオータムだけだ。…そうそう、彼女は引き取られた子ではあるが、ブノワとは多少なりとも血縁関係にあったらしいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530745,
					"content": "唯一の家族である父親が法廷で証言してくれなかったんだ。それでオータムはメロピデ要塞行きになっちまってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530746,
					"content": "あの悪徳ジジイが、住居という財産を独り占めするためにそうしたのか、はたまた娘といさかいがあって出廷しなかったのかは、俺の知るところじゃないけどな、くくっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530747,
					"content": "アイツは普段善良そうに見えるだろ？俺も昔、お菓子をもらったことがある。だが腹の底はこんなにも冷徹なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530748,
					"content": "調査官さんはホントに冷静だな。こんなに長い話を聞いても眉一つ動かさないし…あまりに冷酷な話だと思わないか？俺も自分がけっこう冷たいヤツだと思ってたけど、お前らのほうが上回ってるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530749,
					"content": "いつも公正であるべきだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "さすがプロだな。頭が上がらないぜ。それで調査官さん、ブノワが犯した罪は重いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530751,
					"content": "ノーコメント。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "ハッ、そこまで重いってことかよ…じゃあ、ヤツの家は差し押さえられるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530753,
						741530754
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530753,
					"content": "おそらく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "へっ、なるほどな。ネズミは結局ネズミってことか。ここから上がったところで結局同じなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530756,
					"content": "素敵な一日をくれたことに感謝するぜ、調査官さん。またサーンドル河で二人に会えるのを楽しみにしてるよ。くくっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530757,
					"content": "なんていうか…オイラちょっと複雑だぞ。ブノワじいちゃんのことはいいやつだと思ってたのにさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530758,
					"content": "人は見た目によらないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "あいつがそんな人だったなんて気づかなかったぞ。オイラの目も節穴だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530763,
					"content": "いろいろ複雑すぎて理解するには時間がかかりそうだな。なんか妙な気分だ…もうサーンドル河にいたくないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530764,
					"content": "行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "だな、お日さまを浴びに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530760,
					"content": "一方の言葉だけを信じちゃいけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "それもそうだな。でもオイラ、すっかりブノワじいちゃんのことが信じられなくなっちゃったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530762,
					"content": "こういう感じすごく嫌だけど、幸いオイラにはおまえっていう信用できるやつがいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530754,
					"content": "その可能性はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "で、秘密は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530739,
					"content": "失望したよ、書類の確認を漏らすなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530732,
					"content": "どんな情報をくれるかによる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530733
					]
				},
				{
					"id": 741530733,
					"content": "だったら、俺の情報量はかなりのモンだ。ここはサーンドル河だぜ。他人の秘密を一つや二つ知っておかないと安心して眠れやしない…くくっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "スノッドグラス"
				},
				{
					"id": 741530708,
					"content": "#{M#俺}{F#私}たちに協力してほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				}
			]
		},
