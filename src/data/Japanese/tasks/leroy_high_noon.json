					}
				]
			},
			"dialogs": [
				{
					"id": 741530501,
					"content": "あの箱さ、あそこに元々あった物じゃないよな。それに臭いし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530502,
					"content": "サーンドル河から運ばれた物かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530503
					]
				},
				{
					"id": 741530503,
					"content": "あり得るな。ブノワじいちゃんの家の誰かが最近あそこに行ったんじゃないか。それにブノワじいちゃんも元々サーンドル河に住んでたみたいだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530504,
					"content": "#どの手がかりもサーンドル河と繋がってるぞ。{NICKNAME}、サーンドル河に行ってみたら、もっと役に立つ情報が見つかるかもしれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741530505,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530506
					]
				},
				{
					"id": 741530506,
					"content": "サーンドル河に出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7415307,
			"completionStepIds": [
				7415307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
