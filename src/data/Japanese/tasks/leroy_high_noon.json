			},
			"dialogs": [
				{
					"id": 741531201,
					"content": "こんな領収書を見つけたんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531202
					]
				},
				{
					"id": 741531202,
					"content": "最近うちで売れたペンチにノコギリ…ロウソク？あれまぁ、おかしなことを聞くねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531203
					],
					"speakerTitle": "ブラッカリ"
				},
				{
					"id": 741531203,
					"content": "お菓子作りの材料を買いたいならうちにたくさんあるけど、そういった物は在庫をあまり置いてないし難しいねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531204
					],
					"speakerTitle": "ブラッカリ"
				},
				{
					"id": 741531204,
					"content": "ばあちゃん、別に買いたいわけじゃないぞ。ここ数日でこの店にこういう品を買いに来た人がいなかったか聞きたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741531205,
					"content": "そうねぇ、えぇと…ああ、いたねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531206
					],
					"speakerTitle": "ブラッカリ"
				},
				{
					"id": 741531206,
					"content": "数日前に若い男女が、うちの店でそれを買ってったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531207
					],
					"speakerTitle": "ブラッカリ"
				},
				{
					"id": 741531207,
					"content": "家で木工作業をするのに工具が足りないって言ってたけど、それがどうかしたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531208
					],
					"speakerTitle": "ブラッカリ"
				},
				{
					"id": 741531208,
					"content": "なんでもないぞ！オ、オイラたちは社会経済の状況について調査してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531209
					],
