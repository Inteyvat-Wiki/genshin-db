			"dialogs": [
				{
					"id": 401970201,
					"content": "よし、<color=#C4D6EAFF>白い</color>ヒゲにしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "クリーム味かい…定番だね。でも美味しそうだから、許可しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970401,
					"content": "はい、この地図はもう相棒のものだから、どんな味のヒゲを描いてもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970402,
					"content": "へへっ、なんだか美味しそうな地図だな。大事にするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970403,
					"content": "気に入ってもらえてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970404,
					"content": "映影ランドの施設はこれですべて完成よ。ここからは仕事のことなんて忘れて、思う存分遊んでちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				}
			]
		},
