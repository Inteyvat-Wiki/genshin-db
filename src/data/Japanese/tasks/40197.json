			"dialogs": [
				{
					"id": 401970101,
					"content": "こうなった以上、入れるべきものはこれしかないと思う——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970102,
					"content": "塩——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970103,
					"content": "いや、コショウだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970104,
					"content": "まあ！素敵だわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970105,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970106,
					"content": "二人とも、なにを研究してるんだ？スイーツの新メニューか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970107,
					"content": "スイーツにコショウなんて入れるかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "いいえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970109,
					"content": "シナリオだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970110,
					"content": "えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "愛する友——敏腕カメラマン、新人監督よ！映影愛好家たちの溢れ出る愛と同様、創作の歩みは永遠に止まらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970112,
					"content": "僕の舞台に、平凡なシナリオは厳禁だ。驚きの展開はまるで空から降ってくるコショウのように、観客たちにくしゃみをさせるものでないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970113,
					"content": "映影だけじゃない——お皿の上もまた舞台よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970114,
					"content": "エミリエさん曰く、コショウは調香にも使われているそうですわ。スイーツに使うこともできるんじゃないかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970115,
					"content": "ああ！コショウのスパイスは、クリームの甘さをより引き立てるかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970116,
					"content": "うわっ、二人は創作でも気が合いそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970117,
					"content": "コショウ味のケーキなんて、想像もできないけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970118,
					"content": "なになに？エスコフィエが新作ケーキを作るの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970119,
					"content": "コショウケーキで機械がコショウ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "えっ、それは大変ね！成功したらぜひ食べさせてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970121,
					"content": "気のせいか？仕事が終わってからのほうが、みんなテンション高いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970122,
					"content": "いいんじゃない？努力が報われた時が、一番嬉しいものだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970123,
					"content": "甘くなりすぎるのを心配して、マカロンに入れるお砂糖を控えることなんてないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970124,
					"content": "マカロンには、お砂糖をたっぷり入れるべきよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970125,
					"content": "お砂糖たっぷり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970126,
					"content": "お砂糖たっぷり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 401970127,
					"content": "…って、何に入れるんです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 401970128,
					"content": "レピーヌ・ポーリーン、来たのね！「あれ」はできた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970129,
					"content": "もちろんです。とても順調でしたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 401970130,
					"content": "えっ？なにか重要な任務でもやってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970131,
					"content": "さあ、どうぞお受け取りください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 401970132,
					"content": "これって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "わあ、すごい！イベントのパノラマ地図だ。みんなの絵も描いてあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401970134,
					"content": "ふふっ、映影ランドの大成功を祝って、何か特別な記念品を作りたいって話し合ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970135,
					"content": "この映影ランドはみんなが力を合わせて一から作り上げたものだからね。みんなで一緒に描いた、この地図みたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 401970136,
					"content": "ほとんどは絵の得意なレピーヌ・ポーリーンさんに描いてもらったけど、他のみんなにもできるだけ描き加えてもらったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "エスコフィエ"
				},
				{
					"id": 401970137,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970138,
					"content": "それだけじゃない。旅人、キミにとある特権を与えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 401970139,
					"content": "——僕のイラストにヒゲを描き加える特権だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				}
			]
		},
