						100100806
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100806,
					"content": "小さな帽子か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100807,
					"content": "ドドコ用の帽子だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100808,
					"content": "ドドコ一族の中でも、特に特別で、特にすごいドドコだけが、「ドド大魔王」に認められるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100809,
					"content": "このすごいドドコたちは、ほかのドドコを助けたり、守ったりする役目があるの。だから「ドド大魔王」は彼らに特殊な帽子を与えるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100810,
					"content": "そうすれば、ほかのドドコたちも彼らのことが分かって、助けが必要な時に見つけられるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100811,
					"content": "おお、それでドドコは、帽子をかぶったドドコになるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100812,
					"content": "うん！帽子をかぶったドドコは「ドド大魔法使い」になるの…そうすると、大魔法使いの火花の力で、もっとたくさんの人を助けられるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100813,
					"content": "クレー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100814,
					"content": "城外の森でまた大きな爆発音が聞こえたと、騎士団の皆が言っていたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100815,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、パイモンちゃん、今はクレーが助けてもらいたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100816,
					"content": "あ、オイラが証言できるぞ。オイラたち、クレーと一緒に集まったヒルチャールとスライムを片づけたんだ！それにオイラたち、「課題」のために来たんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100817,
					"content": "パイモンちゃんの言う通りだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100818,
					"content": "ならここの魚は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100819,
					"content": "それは、湖にいた悪いやつらをやっつけてる時に、クレーがうっかりドカーンしちゃったの…今までとは全然違うよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100820,
					"content": "つまり、今まではずっとわざとだったということか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100821,
					"content": "クレー、前にドカーンした魚のことは、もう言い訳できない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100822,
					"content": "…はあ、ここに来る途中、破壊された魔物の拠点と、星落としの湖からちょうど逃げてきた魔物を見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100823,
					"content": "ほかに被害は出ていないな、旅人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100824,
					"content": "ほかの被害は全部パイモンがやった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "…ああ、ぜんぶオイラが吹き飛ばしたんだ。オイラすごいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100827,
					"content": "クレー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100828,
					"content": "帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100829,
					"content": "うう、また反省室なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100830,
					"content": "今回は旅人が君の保証人になってくれたから、罰として…一緒に鹿狩りでしっかり食事をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100831,
					"content": "たくさん走り回ったんだ。お腹も空いただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 100100832,
					"content": "今日は優しいジン団長だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
