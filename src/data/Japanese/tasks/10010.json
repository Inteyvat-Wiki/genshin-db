				]
			},
			"dialogs": [
				{
					"id": 100100301,
					"content": "ここ、なんで、なんでこんなに変なものがいっぱいあるんだ…それにヒルチャールも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100302,
					"content": "っていうか、ヒルチャールが運んできたって感じがするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100303,
					"content": "うぅ、これがメモにあった「果樹果樹の障害」なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100304,
					"content": "うーん、正しくは「数々の障害」だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100305,
					"content": "でも、メモのヒントだと、オイラたちが探してるものはこの「数々の障害」の下にあるはずだ…ほかにヒントは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100306,
					"content": "こういうとき、「ドドコの導き」みたいなのはないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100307,
					"content": "ないよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100308,
					"content": "えっと…じゃあどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "パイモン"
				},
				{
