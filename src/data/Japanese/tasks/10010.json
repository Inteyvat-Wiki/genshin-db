				},
				{
					"id": 100100502,
					"content": "火事になったりもしなかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100503,
					"content": "クレー、ちゃんとボンボン爆弾をコントロールしたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100504,
					"content": "最近、クレーが反省室に入る回数もどんどん減ってるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100505,
					"content": "えらいぞ、クレー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100506,
					"content": "とはいえ、クレーはいつになったら反省室に入らなくて済むようになるんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100507,
					"content": "反省室をドカーンしてもいいって、ジン団長が言ってくれたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100508,
					"content": "そういう意味で言ってるんじゃないぞ！あ、そうだ、ドドコの試練はどうなってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100509,
					"content": "あっ、クレー、手に入れたよ！さっきボンボン爆弾でドカーンした土の穴の中にあったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100510,
					"content": "新しいメモだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100511,
					"content": "うん、上に書いてあるのはママの字だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100512,
					"content": "「ドドコは全部の障害をドカーンと吹き飛ばしたのかしら。時には、直接やっちゃうのが一番美しい方法だったりするんだよね。こうして、ドドコは試練の第二ステージに…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100513,
					"content": "「まあ、最後のステージなんだけどね。どんなに元気な子でも、毎日の活動時間はしっかり管理しなくちゃ。そして…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100514,
					"content": "「星が落ちた湖のほとりで、ドドコは試練を乗り越えて、ついに最後のご褒美を手に入れる…でも、そんなに簡単にいくかしら…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100515,
					"content": "星と湖と言えば、星落としの湖だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100516,
					"content": "それじゃ、湖に行ってみるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100517,
					"content": "分かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100518,
					"content": "この「最後のご褒美」ってなんだろうな。気になるぜ。もしかしたら、すっごいお宝かもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
