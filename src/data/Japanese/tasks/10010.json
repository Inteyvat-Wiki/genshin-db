			"dialogs": [
				{
					"id": 100100101,
					"content": "そうだね…ドドコ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100102,
					"content": "よう！クレー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100103,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}！パイモンちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100104,
					"content": "#ママが言ってたの。栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}とパイモンちゃんが、クレーと一緒にドドコを助けてくれるって！まさかこんなに早く来てくれるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100105,
					"content": "ドドコを助ける？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100106,
					"content": "…えっと、「課題」って、これのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100107,
					"content": "分からない…でも、クレーはクレーだよ、「カダイ」じゃないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100108,
					"content": "あっ、別に名前を間違えたわけじゃないぞ！クレーはクレーで、課題は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100109,
					"content": "課題は課題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100111,
					"content": "…はぁ、役に立たない説明をありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100112,
					"content": "んー…課題っていうのは、その…いざ説明するとなると、ちょっと難しいな。とにかく、課題っていうのは、クレーがやりたいことで、ドドコを助けるためのことだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100119,
					"content": "うん！パイモンちゃん、ありがとう！クレー、よく分からないけど、ちょっと分かった気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100120,
					"content": "それじゃあ、はやくいこう！ドドコを助けに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100121,
					"content": "ちょっと待った、クレー。ドドコを助けるって言ってたけど、具体的にはなにをするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100122,
					"content": "えーと、ドドコたちは赤い四つ葉を見つけると、ほかのドドコと違う特別なドドコになれるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100123,
					"content": "それから、ドドコはいっぱい友達を作って、「ドド大魔王」の試練を乗り越えると——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100124,
					"content": "「ドド大魔法使い」になれるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100125,
					"content": "…ママはそう言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100126,
					"content": "「大魔法使い」になれるかどうかは、「大魔王」次第ってことか…聞いた感じ、筋は通ってるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100127,
					"content": "じゃあ、オイラたちはなにをすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100128,
					"content": "クレー、分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100129,
					"content": "#でもママが言ってたの。栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}とパイモンちゃんが教えてくれるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100130,
					"content": "そうだ、クレー、この本を見てくれるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100131,
					"content": "あっ、中にメモがはさまってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100132,
					"content": "じゃあ、一緒に見てみようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100133,
					"content": "「…試練の最初の場所、ドドコは葉っぱが囁く森にやってきた。そこで、埋もれた秘密を見つけ、数々の障害を乗り越え…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100134,
					"content": "ドドコの物語の一部みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100135,
					"content": "あっ、クレー、分かったよ！きっと、クレーがよくドカーン…よくドドコと遊んでる森の中だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100136,
					"content": "#クレー、ドドコ、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、パイモンちゃん、しゅっぱーつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100137,
					"content": "よし！出発だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100113,
					"content": "やるべきことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "そう、やるべきことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100115,
					"content": "あ、じゃあクレーがボンボン爆弾でお魚をドカーンするのも「課題」なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100116,
					"content": "いや、それは違うな。なんでもかんでも「課題」ってわけじゃないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100100117,
					"content": "クレー、ちょっと分かんなくなっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 100100118,
					"content": "うーん、とにかく、アリスが言ってた、クレーにやってほしいことが「課題」だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "パイモン"
				}
			]
		},
