			"dialogs": [
				{
					"id": 721110301,
					"content": "それは…コホン、今度はどこで拾ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110302,
					"content": "溝の下流で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110306,
					"content": "それに、この二つのものに関連性があると証明はできないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110307,
					"content": "関連性ならあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110308,
					"content": "まったく、いったい何があるっていんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110309,
					"content": "モラに何か暗号でも書いてあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110310,
					"content": "モラにはないけど、他のところにあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110311,
					"content": "これは壊された荷車の近くで見つけた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "村の入り口の木のてっぺんで拾った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "そんなバカな…そうやって俺に探りを入れて無駄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "紺田伝助"
				}
			]
		},
