					"紺田伝助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "何か用か？若者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110102,
					"content": "証拠を見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "「証拠」？何の証拠だ？本当に訳がわからねぇな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110104,
					"content": "村の変わった出来事だ。言い訳はさせないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110105,
					"content": "嘘だろ！うちの村に変わった出来事なんてあるわけない。いいだろう、何か証拠があるなら見せてみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110106,
					"content": "#（おい、{NICKNAME}、井戸のとこで見つけた物から見せてやろうぜ。おまえに任せたぞ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110107,
					"content": "これは庭の枯れ井戸で拾った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
