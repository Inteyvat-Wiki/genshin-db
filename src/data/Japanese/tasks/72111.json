						"rawParams": [
							"7211101",
							"3"
						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211102",
							"3"
						],
						"stepId": 7211102,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211103",
							"3"
						],
						"stepId": 7211103,
