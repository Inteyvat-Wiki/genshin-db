			"dialogs": [
				{
					"id": 721110501,
					"content": "これは何だ？俺には見当も付かないものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110502
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110502,
					"content": "若者よ、このじじいを謀ろうとするなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110503,
					"content": "これは雨の夜に捨てられたもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
