			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紺田伝助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "こ…これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110702,
					"content": "うっかりしてた、まさか荷車を壊してる時に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110703,
					"content": "わっ、認めたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110704,
					"content": "しょうがない、お前にここまで調べられては、これ以上隠し通せないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110705,
					"content": "それに事情もよく分かったはずだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110706,
					"content": "ああ、十分な！伝助のじいさん、おまえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110707,
					"content": "幕府の荷車を襲ったんだろ。で、争ってる時に、おまえは一撃で荷車を壊してしまった。その結果、貨物の袋が飛んで溝渠に落ちた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110708,
					"content": "さらに幕府のやつらはおまえに殺されないよう、袋を井戸に投げておまえの注意を引いた！それを誰かに拾われるとまずいから、おまえは井戸に鍵をかけたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110709,
					"content": "そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110710,
					"content": "は？違う、全然違う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110711,
					"content": "違うのか！なら、おまえから鍵をもらって、井戸の底のモラを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110712,
					"content": "…幕府の人に届けに行こう！そう！やましいところなんてないからな、幕府へ届けに行くだけだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110713,
					"content": "はぁ、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110714,
					"content": "村にいる若者たちが、酔っ払って幕府の荷車を強奪してな。この貨物も袋も、全部幕府のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110715,
					"content": "村の恥を外に知られてはならぬと思い、このことを隠蔽した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110716,
					"content": "それじゃあ、モラの入った袋を自分のものだって言ったのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110717,
					"content": "事実を隠すため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "そうだ。そうすれば、お前たちもこれ以上調べないと思ったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110719,
					"content": "俺一人でいいんだ…他の人が巻き込まれなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110720,
					"content": "お願いだ、幕府に告発しないでくれ。俺の面子とかの問題じゃない。この件で、この村が巻き添えを食うんじゃないかと心配なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110721,
					"content": "告発をする気はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "そうだぞ、オイラたちはこの件のために来たんじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110723,
					"content": "そうか、なら良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110727,
					"content": "この一件で良心を痛めてな、今回のことを記録しておいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110728,
					"content": "それを書いた手記は屋根の上に投げ捨てた。若者よ、お前がどうしても読みたいなら、探すといい。ただし、直したばっかりの屋根を壊すなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110729,
					"content": "井戸の鍵について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "そう、井戸に鍵をかけたのは俺だ。鍵の隠し場所も手記に書いたから、それを読むといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110731,
					"content": "紺田村の「結界」について、伝助のじいさんはなにか知っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110732,
					"content": "「結界」？ふむ、そんな古い伝説を知っている人がまだおるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110733,
					"content": "昔、我々の立つこの地面の下に、鳴神島の平和を守る五つの木の根の一つである、雷櫻の根があったそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110734,
					"content": "それとその結界を守ることは、「狐斎宮様」が俺ら紺田一族に授けた責務だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110735,
					"content": "だが、それは大昔の話、詳しいことは俺も知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110724,
					"content": "ただ真実を調べたいだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "そうだぞ、オイラたちはこの件のために来たんじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110726,
					"content": "真実を調べる？ほほう…今の若者にしては、面白いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "紺田伝助"
				}
			]
		},
