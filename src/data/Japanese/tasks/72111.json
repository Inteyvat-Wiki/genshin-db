			"trigger": {
				"objectNames": [
					"紺田伝助"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "モラの入った袋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110202,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110203,
					"content": "…これはうちの物だ。疑わしい点などない。そうだ、ごく普通のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110204,
					"content": "怪しい！きっとなにかあるに違いないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110205,
					"content": "袋にある印を書いてみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110211,
					"content": "いいだろう。確かに、これは俺の袋じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110212,
					"content": "うちの庭の近くは人の往来が多いから、誰かが落しても不思議じゃないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110213,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110214,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "はぁ！バレたか。俺はその袋を自分の物にしたかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110216,
					"content": "いい歳して、この伝助は何やってるんだ、こんな悪だくみしてはならんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110217,
					"content": "違う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "お、俺はそのモラを自分のものにしたかっただけだと自白した。それ以外に問題はないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110220,
					"content": "今すぐ、そのモラの入った袋を幕府へ届けに行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110221,
					"content": "なんか変だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110222,
					"content": "この袋は誰かがわざと捨てた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "お、お前、何か証拠でもあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110228,
					"content": "この袋は証拠の一部にすぎない。こういうのも見つけたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110229,
					"content": "#…えっと、なにを見つけたんだっけ？うぅ…{NICKNAME}、おまえに任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110230,
					"content": "#（{NICKNAME}、この前、溝のとこで見つけたのはなんだっけ…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110231,
					"content": "これは雨の夜に捨てられたもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "いや、パイモンの考えすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#（おいおい！{NICKNAME}、伝助のじいさんは本当にモラが欲しいだけだったって言うのか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110225,
					"content": "（なにか他のことを隠してると思うぞ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721110226,
					"content": "この袋は誰かがわざと捨てた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "何か隠している…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "モラがいくら入ってるか言ってみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "ははは、何を言ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110208,
					"content": "お前だって財布の中身を見なければ、モラがいくら入ってるかなんて答えられないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "紺田伝助"
				},
				{
					"id": 721110209,
					"content": "袋にある印を書いてみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
