			"dialogs": [
				{
					"id": 737050101,
					"content": "旅人、パイモン！こっちこっち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050102
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050102,
					"content": "「知行合一プロジェクト」の本拠地へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050103
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050103,
					"content": "ほら、メインプロジェクトの施設はもうできてるんだ。みんな準備万端だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050104
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050104,
					"content": "おお！いい雰囲気だな。娯楽小説に出てくる「若き冒険者たちの最初の拠点」って感じだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050105,
					"content": "うーん…学院祭っぽい感じもするぞ。みんなで集まって、研究をして、チームを組んで自分を鍛える…なんだかワクワクするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050106,
						737050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050106,
					"content": "#{M#俺}{F#私}もやる気満々！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				},
				{
					"id": 737050108,
					"content": "学院祭ほど豪華じゃないけどな。ティナリ師匠曰く、教令院はあたしたちに一番コスパのいい資源を配布してくれるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050109
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050109,
					"content": "学生や学者たちは危険地帯に足を踏み入れる前に、あたしたちのところで説明や緊急訓練を受けるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050110
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050110,
					"content": "ガイドや安全責任者として、チームに専門家も派遣する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050111
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050111,
					"content": "イマドキの言い方で言うなら、訓練と実戦の両方を兼ねた「前進基地」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050112
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050112,
					"content": "新兵たちにはこれから直面する挑戦についてちゃんと意識して訓練してもらわないと。未知の領域に送り込むならその後だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050113,
					"content": "アンバー！こんなところで会えるなんて思わなかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050114,
						737050115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050114,
					"content": "偵察騎士の業務範囲、広がったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050116,
					"content": "えへへ、びっくりしたでしょ？わたしもびっくりしちゃったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050117
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050117,
					"content": "最初はシフトの休みを使って、コレイのところに遊びに行こう！程度の気持ちだったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050118
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050118,
					"content": "意外とコレイが忙しそうだったから、隣で見てるだけなのもなーって思って、コレイの助手になったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050119
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050119,
					"content": "ごめんなアンバー、休暇中なのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050120
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050120,
					"content": "気にしないでよ。リラックスしながらも充実したバカンスを過ごすっていうのも悪くないでしょ！わたしも色々勉強になったしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050121,
					"content": "それに、あんたを手伝ったからこそ、思いがけず旅人とパイモンに会えたわけだしね。嬉しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050122
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050122,
					"content": "こっちの仕事が落ち着いたら、一緒にごちそうでも食べない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050123
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050123,
					"content": "やったぜ！こんなところで最初に出会った仲間と巡り会えるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050124,
					"content": "大盛りのニンジンとお肉のハニーソテーを食べた時くらい嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050125,
						737050126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050125,
					"content": "じゃあ、さくっと仕事を終わらせよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050127,
					"content": "うん！じゃあ、本題に戻ろっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050128
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050128,
					"content": "コレイとわたしが担当しているプロジェクトは「高速偵察パートナー」っていうの。装置を使って危険地帯を素早く駆け抜けて、地形や魔物について調査するのが目的だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050129,
					"content": "生論派の研究によると、危険な環境下では、可愛くて大人しい仲間がいると、過度な緊張が和らぐんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050130
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050130,
					"content": "そこで、コレアンバーとウサギ伯爵をモチーフに、偵察装置「グリーンコレアンバー」と「アカトビウサギ伯爵」を作ったんだ。結構評判いいんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050131
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050131,
					"content": "十分なテスト結果が集まったら、教令院はこれを改良していろんなスタイルの仲間を導入するんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050132
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050132,
					"content": "コレアンバーとウサギ伯爵がすんごい速さで駆け抜けるのか…一体どんな感じなんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050133,
						737050134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050133,
					"content": "頼もしそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050135,
					"content": "お前なら、きっといいデータが得られると思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050136
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050136,
					"content": "プログラム全体を理解したら、後で試してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050137
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050137,
					"content": "まずは他の顧問たちに会いに行こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050138
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050138,
					"content": "あっちのお姉さんにも、可愛い装置のパートナーがいるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050139
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050139,
					"content": "うちのペアとは用途が違うみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050140
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050140,
					"content": "二人とも、頑張ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050141
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 737050141,
					"content": "二つ目のプロジェクトも…見覚えのある顔だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050142,
					"content": "挨拶しに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050134,
					"content": "ちょっと想像できない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050126,
					"content": "楽しい食事会のために、真面目に頑張ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050115,
					"content": "広範囲に勧誘をかけたんだね、コレイ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050107,
					"content": "一体どんな娯楽小説が好きなの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				}
			]
		},
