				]
			},
			"dialogs": [
				{
					"id": 737050201,
					"content": "本当にそれほど人気が出るものか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050202
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050202,
					"content": "歩行機構を内蔵するという考えは悪くない。地形識別、遠距離制御、重量感知モジュールもよく処理されておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050203
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050203,
					"content": "じゃが、見た目はどう見ても普通のぬいぐるみ…やはりもう少し変えた方がよいのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050204
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050204,
					"content": "ファルザン先輩、いい知らせだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050205
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050205,
					"content": "旅人とパイモンが加わって、「知行合一プロジェクト」のメンバーがさらに豪華になったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050206
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050206,
					"content": "へへっ、ファルザン先輩、やっほー！手伝いに来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050207,
					"content": "ほう、これはこれは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050208
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050208,
					"content": "よくやったぞ、コレイ！業界公認のスペシャリストを招くとは、ワシがお前にどんな高評価をつけても文句は言われまい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050209
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050209,
					"content": "ちょうどよかった。この「謎解きバディ」を見てくれ！どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050210
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050210,
					"content": "おお…ファルザン先輩のイメージをそのまま使ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050211,
						737050212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050211,
					"content": "心地よさそうで、落ち着く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				},
				{
					"id": 737050213,
					"content": "学院の後輩たち…謎解き協会と遺跡仕掛けシンポジウムのメンバーの努力の結晶じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050214
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050214,
					"content": "彼らの共同研究の産物は、高い技術的価値を持つものであるにもかかわらず、子供っぽい外見を持っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050215
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050215,
					"content": "特に後輩のアニス！この外見の長所を熱弁しておった。課題の答弁をする時よりも熱心にな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050245
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050245,
					"content": "今時の若者は可愛いものに夢中になりすぎではないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050216
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050216,
					"content": "オイラはそんなに悪くないと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050217,
					"content": "可愛い仲間は冒険者の緊張を和らげるって、アンバーとコレイもさっき言ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050218,
					"content": "ファルザン先輩のぬいぐるみと一緒に冒険したら、どんな暗い遺跡でも緊張しなくてすみそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050219,
					"content": "確かに一理あるのう。後輩たちがこの形を選んだのも、ワシへの尊重かもしれぬ…コホン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050220
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050220,
					"content": "しかし、装置の信頼性や技術レベルを重視する冒険者がいるのも事実。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050221
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050221,
					"content": "そういう者は「マシナリーは硬くあるべき、落石に耐えるべき、最先端の技術を搭載していることがわかるべき」と考えるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050222
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050222,
					"content": "この「謎解きバディ」は見た目がふわふわと柔らかすぎて…威厳や頼もしさの欠片もない。それどころか、探検者の気を散らしてしまうやもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050223
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050223,
					"content": "ツヤ消し加工を施した金属で重厚な外殻を作り、形を四角くして、適度に複雑な部品が見えるようにしたほうが、視覚的にも頼もしく見えるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050224
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050224,
					"content": "このワシですら、見た目のせいで信用されないことがある…もしワシが白髪だらけだったら、あやつらも文句は言わんかったじゃろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050225
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050225,
					"content": "ほ、本当か？オイラならそいつらを納得させられるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050226,
					"content": "えっ？い、いや…それとこれとは…別の話じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050227
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050227,
					"content": "ファルザン先輩、意外とそういう部分に厳しかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050228,
						737050229
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050228,
					"content": "#{M#俺}{F#私}は今のままでも素敵だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050230,
					"content": "ぬっ？お前まで…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050231
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050231,
					"content": "…コホン！ううむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050232
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050232,
					"content": "わかった。お前がそう言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050233
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050233,
					"content": "では、旅人。「謎解きバディ」を操作して、いくつかの謎解きの典型例を解いてみぬか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050234
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050234,
					"content": "この装置を使った時の効率をしっかり評価して、そのパフォーマンス結果によって使用規則を作成するのじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050235
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050235,
					"content": "外見の改善については、長期的な観察が必要じゃ。今はとりあえず保留するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050236,
						737050237
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050236,
					"content": "やった！頑張るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050238,
					"content": "準備ができたら、ワシのところに来てくれ。最適な秘境をいくつか選んでおいた。いつでも謎解きを始められるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050239
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050239,
					"content": "ありがとう、ファルザン先輩。ただ、これから旅人とパイモンを連れて、最後のプロジェクトを見に行くんだ。ちょっとだけ待っててくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050240
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050240,
					"content": "うむ、分かった。コレイも疲れておるじゃろう。あまり無理をするでないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050241
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050241,
					"content": "落ち着いたら、みんなでのんびりしよう。昔のお菓子でも食べて、ゆっくり話をするんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050242
					],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050242,
					"content": "昔のお菓子！オイラ絶対参加するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050243,
					"content": "先輩、ありがとう。あたしも質のいいハーブティーを持ってくるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050244
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050244,
					"content": "さあ行け、うまくやるんじゃぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルザン"
				},
				{
					"id": 737050237,
					"content": "最大限活用させてもらうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050229,
					"content": "四角い見た目はまた今度にしない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050212,
					"content": "全然冒険用のものには見えないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				}
			]
		},
		{
