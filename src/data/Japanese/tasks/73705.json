			},
			"dialogs": [
				{
					"id": 737050301,
					"content": "次は最後のプロジェクト——長期的な持続をもとにし、発展を目的に設立された「セーフティチーム」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050302
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050302,
					"content": "大マハマトラのセノさんの協力で、ディシアさんとキャンディスさんをそれぞれ教官と調整担当者として招聘したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050303
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050303,
					"content": "二人とも戦闘試験の準備をしてるけど、そろそろ戻ってくると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050304
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050304,
					"content": "あたしらをお探しかな？ちょうどいいタイミングで帰ってこれたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050305
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050305,
					"content": "もしかして旅人とパイモンも参加してくれるのか？ますます楽しくなりそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050306
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050306,
					"content": "お待たせしました。いい情報が得られましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050307
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050307,
					"content": "情報を仕入れにいってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050308,
						737050309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050308,
					"content": "戦争の下準備みたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050309,
					"content": "まさか本当にどこかに攻め入ろうと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050310,
					"content": "実はマジなんだ。砂漠にいる危険なやつらを一掃しないと、学生の安全に関わるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050311
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050311,
					"content": "ディシア、冗談はそこまでにしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050312
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050312,
					"content": "本当に剣を抜いて砂漠の果てまで戦いに行ってしまったらどうするんですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050313
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050313,
					"content": "砂漠中の危険なやつを全員倒すなんて…いくらこいつでも、日の出から日没まで砂漠で何年も戦い続けないといけないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050314,
					"content": "旅もやめないといけないぞ。か、考えたくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050143,
					"content": "砂漠は広いから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050144,
					"content": "敵がどれだけいるか、見当もつかない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050315,
					"content": "時間なんて軽い問題だ。それよりも、多くの危険は肉眼では確認できないものなんだ。地下に潜むサソリとか、木の上で眠る恐ろしい大きな怪鳥とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050316
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050316,
					"content": "そいつらが飛び出してきて通せんぼしてきたら、真っ向から戦うのは避けられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050317
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050317,
					"content": "こういう時は、ファルザン先輩の言う通り、アンバーの偵察の方法を参考にして、敵に遭遇する確率とか、行動時間を予測して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050318
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050318,
					"content": "おいおい、本気にするなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050319
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050319,
					"content": "そこまで大げさなことをするわけではありません。「セーフティチーム」の責務は、視察に出かける学生チームに、頼もしい護衛をつけることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050320
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050320,
					"content": "「熾光の猟獣」と傭兵に依頼済みですし、研究調査隊の人員のうち、戦闘試験を通過した猛者にも一部を任せています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050321
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050321,
					"content": "研究調査隊が危険地帯に向かう時は、戦闘試験を通過したプロフェッショナルを少なくとも二名は編成するようにしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050322
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050322,
					"content": "情報というのは、その戦闘試験の会場に関するものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050323
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050323,
					"content": "魔物と盗賊に占拠された秘境を見つけたんだ。悪党ならよりどりみどりだから、ちょうどやつらの首を借りて、護衛たちの腕を検証できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050324
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050324,
					"content": "じゃあ、あとは試験監督がいればオッケーってことか？審査員も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050325,
					"content": "ディシアと一緒に信頼できる人を交代で手配するので、参加者の安全は保障します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050326
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050326,
					"content": "でも、試験の基準についてはまだ色々と問題がある。戦いってのはお勉強と違って、唯一の解なんてないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050327
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050327,
					"content": "傭兵にはそれぞれ、自分なりの戦い方がある。実戦じゃ問題ないが、教官ってなるとワンパターンに陥りがちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050328
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050328,
					"content": "ってなわけで、視野が広くて、柔軟な思考で戦えるプロに、参考になる理想的な答えを見せてもらいたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050329,
						737050330
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050329,
					"content": "専門分野だね、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050330,
					"content": "もともと手伝うために来てるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050331,
					"content": "おう。視野が広くて臨機応変に動ける人と言えば、やっぱり旅人だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050332,
					"content": "よしきた。あんたと仕事ができるなんて、嬉しいよ。スパイスたっぷりの肉を目の前にした時の気分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050333
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050333,
					"content": "ディシア、報酬のことも忘れてはいけませんよ。提携案を聞いた瞬間に引き受けたでしょう？金銭関連のことは考えていなかったのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050334
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050334,
					"content": "大丈夫だ！コレイが教令院と交渉して、報酬を二八で分けることになってる。あたし一、キャンディス一、旅人・パイモンが八さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050335
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050335,
					"content": "えっ！八割も貰えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050336,
						737050337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050336,
					"content": "もらいすぎなんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050337,
					"content": "ディシア、ありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050338,
					"content": "はっはっは！あたしたちの仲だろ！遠慮すんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050339
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050339,
					"content": "とにかく、あんたらの戦いぶりでセーフティチームの仕事の基準が決まる。あたしたちは実行と長期的な経営を担当するだけだからな。大変なのはあんたらだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050340
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050340,
					"content": "前から提携の話は出てたし、いい機会だから気持ちよくスタートを切りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050341
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050341,
					"content": "じゃ、じゃああたしは報酬を計算して、一目で分かるように明細を書いておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050342
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050342,
					"content": "ありがとな、コレイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050343
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050343,
					"content": "それと、キャンディスさんも安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050344
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050344,
					"content": "アアル村に支払われる食糧倉庫代についても、教令院に三割増しで受け入れさせたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050345
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050345,
					"content": "ありがとうございます。村の施設の修繕費に回しますね。研究調査隊がアアル村に滞在する際、より快適に過ごせるようになりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050346
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050346,
					"content": "旅人さんがスムーズに行動を開始できるよう、「セーフティチーム」の拠点も少し整理しておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050347
					],
					"speakerTitle": "キャンディス"
				},
				{
					"id": 737050347,
					"content": "じゃあ、また後でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050348
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 737050348,
					"content": "コレイは今回の中心人物なんだな。みんなをまとめてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737050349,
					"content": "いやいや！ただ、できることをしてるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050350
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050350,
					"content": "まだまだ勉強することは山積みだし、やらなきゃいけないことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050351
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050351,
					"content": "とにかく、旅人、パイモン、一緒に頑張ろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050352
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 737050352,
					"content": "おう！「知行合一プロジェクト」、最高の形で成功させようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
