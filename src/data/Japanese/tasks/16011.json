					"nextDialogs": [
						160111202,
						160111215,
						160111219,
						160111231
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111202,
					"content": "ファルカさんの作戦について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111203
					]
				},
				{
					"id": 160111203,
					"content": "剣を囮にして、心臓に魂を宿す…それが、俺が最も確実だと踏んでいた作戦だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111204
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111204,
					"content": "だが作戦の後半部分…想いに引き上げられて地脈から抜け出すってのは…正直あんま自信なかったが、はは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111205,
					"content": "もしあの時、旅人がローランドの不純物を切り離すのに失敗してたら、どうするつもりだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160111206,
					"content": "ああ…もともとはバルバトスに任せるつもりだったんだが、話を聞いたあいつがすぐにもっと適任なやつを…「風を捕まえる異邦人」を推薦したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111207,
					"content": "結果的に、お前を信じて正解だった。ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111208,
					"content": "#{M#俺}{F#私}も失敗してたらどうしてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "——そうなったらバルバトスに無理させて、狼側から人間側へと吹き戻してもらうことになってたろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111210,
					"content": "…とはいえ代償は大きいし、成功率もさほど高くなかった…俺もあいつにその力を無理して使わせたくなかったしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111211,
					"content": "…神の力を使うと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "ああ、いい質問だ——上等な蒲公英酒一杯、それから俺の机の引き出しにあるへそくりを差し出すはめになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111214,
					"content": "——そんな安く済むわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160111212,
					"content": "…どんな代償を払うことになるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "遠征軍について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "そうだな、今回ローランドの影を倒したことで、ワイルドハントはしばらく反撃に転じる力を蓄えられないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111217,
					"content": "ナド・クライの拠点に駐在するやつら以外は、何回かに分かれて順次帰還することになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111218,
					"content": "アルベドとドゥリンも第一陣と共に帰る予定だ。しばらくすればまた会えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111219,
					"content": "ファルカさんの未来について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "俺の未来か…バルバトスか魔女会あたりから聞いてるかもしれんが、水占の盤に映る未来の影をちらっと見たことがあってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111221,
					"content": "「北方のアビスの災厄」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "ああ。だが今…この未来は、お前のおかげで変わったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111223,
					"content": "ただそれでも、騎士団の雑務を片付けたらまた北に戻らなきゃならん…ナド・クライの新拠点には、まだ処理すべき仕事が山積みだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111224,
					"content": "最初に自ら残ると志願した騎士たちが、まだ交代せずに頑張ってるんだ。放っておくわけにはいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111225,
					"content": "きれいごと言ってるけど…実際はモンドの仕事を全部ジン団長に押し付けたいだけなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160111226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111227,
					"content": "…まさか当たりかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160111228,
					"content": "こんな時に無言にならないでよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "はっはっは——冗談だ。これからは、モンドでも俺のことをよく見かけることになると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111229,
					"content": "こんな時に微笑まないでよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "特に質問はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "ああ。じゃあ、俺はもう少し風に当たるとしよう——何よりも気持ちよく酔える酒は、やっぱ故郷の風だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				}
			]
		}
	]
}