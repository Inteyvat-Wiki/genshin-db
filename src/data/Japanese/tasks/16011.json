					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 160111104,
					"content": "「…みんなに迷惑かけたんだから、戻ったらちゃんと礼を言いなさいよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 160111105,
					"content": "「ふっ、報告したいことはいろいろとあるんだが…まあ、帰ってきただけで十分だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 160111106,
					"content": "「騎士団に戻るつもりはない…自力でなんとかしてくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 160111107,
					"content": "「…大団長、皆であなたを待っています。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "ジン"
				},
				{
