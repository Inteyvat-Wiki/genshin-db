						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ローランド"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "…叶えてやろう、「北風騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110902,
					"content": "はっ、思ってたのと違うな。「破片」にあった記憶ほど狂ってるようには見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110903,
					"content": "私は正しい道から外れたことなど、一度たりともない。対して貴様は…今の貴様は龍を討つ英雄というより、長く彷徨い続け、落ちぶれた騎士のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110904,
					"content": "お互いさまだろ。どうやら俺たちは、どっちも全盛期ってわけじゃなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110905,
					"content": "月の狩人の軍勢が敗れたことで、アビスによって再現された「私」もまた、不完全な影となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110906,
					"content": "力はローランドの全盛期に並べど、心は血染めの頃で止まったままだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110907,
					"content": "故に、「私」もまた「正しくない」…そして騎士は、自身の停滞を許さぬもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110908,
					"content": "貴様を不当な境地から救い、アビスへと導いた後、私自身も正しき道へと戻り、騎士道を歩み続けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110909,
					"content": "ふん、外はもうお前の暴れっぷりに耐えられそうにない…想像通り、とんでもねぇ執着心だな。説得は無理ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110910,
					"content": "騎士が信ずる美徳は、いかなる言葉でも揺るがぬ…それがどれだけ高尚な言葉であろうともな。互いに説得することは不可能だと…貴様もとっくに分かっているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110911,
					"content": "でなければ、すべての希望をボレアスの「想い」に託すはずもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110912,
					"content": "だが、あの狼の魂を宿した剣は砕けた。その手にあるのは形ばかりの幻に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110913,
					"content": "すべてを覆す手立てはもはやなく、援軍も望めぬ状況…ここが貴様の「末{RUBY#[D]最期}路」だ、孤独なる遠征者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110914,
					"content": "ふっ、すべてを覆す手立てはともかく、援軍なら…ここにいるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110915,
					"content": "…何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110916,
					"content": "——俺が説得しなきゃならないのは、最初から最後まで、あいつだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110917,
					"content": "ここは北風の魔神——アンドリアスの「心」の中なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110918,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110919,
					"content": "——おい！聞こえてるか、アンドリアス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110920,
					"content": "目ぇ覚ませ！北風の魔神様なんだろ！いつまでアビスに操られてやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110922,
					"content": "これが貴様の最後の抵抗というのなら…失望だな、北風騎士よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110923,
					"content": "勢いと願いだけでは奇跡など起こらん。この世界は慈悲深くなどないのだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110924,
					"content": "…還る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110925,
					"content": "…地脈に…還る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110926,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110927,
					"content": "…これが「我」の選択…「我」の記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110928,
					"content": "…「我」の旅の終点で…見つけた答えなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110929,
					"content": "アンド{RUBY#[D]ボレアス}リアス…お前の「手紙」、ちゃんとお前の心に届けたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110930,
					"content": "ふん…北風騎士か、見ていろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110931,
					"content": "…これこそが…我{RUBY#[S]「狼」}が…汝{RUBY#[D]「人」}らにできる唯一のことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "アンドリアス"
				},
				{
					"id": 160110932,
					"content": "…群狼の領主よ。地上の人間を代表して、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110933,
					"content": "ボレアスが…地脈へと還っていく。なぜだ？貴様の剣は砕け、魂を宿すすべも失われたというのに。いや、まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110934,
					"content": "勢いと願いだけじゃ奇跡は起こせない…そんなことは分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110935,
					"content": "…だがな、魂を宿せるもんは「剣」だけじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110936,
					"content": "…奔狼の領主は、配下の狼たちに魂の力を授け、その心臓を強くし、爪と牙を鋭くしたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160110937,
					"content": "…たとえ「我」にその意図がなくとも、人の「心」は王狼の魂に噛み砕かれ、呑まれ、同化する…まるで人と狼の群れを無理やり混ぜたかのようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "ボレアス"
				},
				{
					"id": 160110938,
					"content": "…人の心臓に、魔神の魂を宿す、か…後戻りはできないぞ。だが、騎士が自ら選んだ道を進むことを、止めはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 160110939,
					"content": "貴様の心臓と魂が…崩れていく？…そういうことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110940,
					"content": "「子羊が狼の胸元に鈴をどうつけるのか」…そう聞いたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110941,
					"content": "これが答えだ——狼に俺の「心臓」を呑ませる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110942,
					"content": "剣に宿った狼の魂は囮で、真の想いと記憶は、貴様の心臓が背負っていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110943,
					"content": "私に悟られぬよう、王狼の魂を自身と同化させ、その上で私に呑まれるよう仕向けていたのだな…ずっと、そのような重荷を背負って戦っていたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110944,
					"content": "王狼の決意に比べりゃ…こんくらい大したことねぇさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110945,
					"content": "強靭な意志に、優れた策略…だがそれは騎士のあるべき戦い方ではない。故に、その選択は間違っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110946,
					"content": "貴様の魂はアンドリアスと一体化した。魂が完全に地脈へ溶ければ、貴様もまたその中へと落ちるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110947,
					"content": "そうなれば、バルバトスも、あの旅人も、地脈からその魂を見つけ出すことはできない。ましてや、貴様を助けるなど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110948,
					"content": "貴様も、私も負けたのだ。残念ながら、私にも貴様を救うすべはないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110949,
					"content": "…北風とともに、その魂が安らかに眠れることを祈ろう…孤独なる遠征者よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "ローランド"
				},
				{
					"id": 160110950,
					"content": "…はは、孤独、か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110951,
					"content": "すまないな。お前と一緒に地脈の底で最期を迎えるのも、悪くない結末だと思いもしたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110952,
					"content": "かつてのローランドとは違ってよ、外で美味い酒とダチが帰りを待ってんだ。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110953,
					"content": "——諦めるつもりなんざ、さらさらないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110954,
					"content": "やっほ～、君に手紙だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
