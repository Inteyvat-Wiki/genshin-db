					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111109,
					"content": "ん？…ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111110,
					"content": "まあまあ「大団長」をやれてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111111,
					"content": "…その沈黙、肯定ってことでいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111112,
					"content": "かつてお前らが命を懸けて守り抜いたものは…今もちゃんと残ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111113,
					"content": "ああ…騎士団も、モンドも…そして騎士の誓いも、俺がしっかり守っていくさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111114,
					"content": "だから…あの手紙は、俺が代わりに届けておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111115,
					"content": "…お前は「あいつ」の影だが、時間があるなら代わりに読んでやってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111116,
					"content": "——ルースタンもエレンドリンも、お前のことを忘れちゃいなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111117,
					"content": "はぁ…今回は、本当に遠くまで来ちまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111118,
					"content": "あとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111119,
					"content": "…「風の導くままに」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111122,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 160111130,
					"content": "よう…久しぶりだな、お前ら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111131,
					"content": "…また会えて、本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160111132,
					"content": "おかえり——大団長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
