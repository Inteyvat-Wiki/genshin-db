			"dialogs": [
				{
					"id": 160110201,
					"content": "う、うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110202,
					"content": "…剣が無傷？だが、狼の魂の気配は感じない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110203,
					"content": "（…どうやらここは「現実」じゃなく、「北風」と「ローランド」の意識が混ざってできた空間のようだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110204,
					"content": "退路はなく、前に待ち受けるは「狼の胃袋」か…ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 160110205,
					"content": "——はっ、上等だ。このまま進んでやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				}
			]
		},
