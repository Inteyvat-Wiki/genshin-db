			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝霧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "こほっ…これも…やっぱりダメだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830102,
					"content": "このままじゃ、今期分の挿し絵の提出が間に合わないよ…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830103,
					"content": "こんにちは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830106,
					"content": "ご、ごめんなさい！今日こそはちゃんと完成した挿し絵を提出するので！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830107,
					"content": "わっ！ちょっと待てって、オイラたち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830108,
					"content": "森子さん！どうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830109,
					"content": "あれ？森子さんじゃない…？よかっ…こほっ！こほっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830110,
					"content": "森子さんって…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "森子さんは私の編集担当者なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830112,
					"content": "私は朝霧、えっと…「個人の絵師」をやってるの。森子さんは…私の仕事を担当している編集さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830113,
					"content": "さっき言った挿し絵ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830114,
					"content": "君たちも「八重堂」が出版してる娯楽小説は読んだことあるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830115,
					"content": "その小説の中に、文章じゃなくてたまに絵が数ページ描いてあるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830116,
					"content": "そういう娯楽小説で描かれている絵のことを、「挿し絵」って言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830117,
					"content": "小説で重要な場面や展開になった時、もしくは作者が主人公の見た目をちゃんと披露したい時に、作者が挿し絵を依頼するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830118,
					"content": "そうすれば、読者も小説をより楽しめるし、小説の内容そのものも豊かになるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830119,
					"content": "へぇ…そうだったのか。娯楽小説って奥が深いんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830120,
					"content": "オススメの娯楽小説がいくつあるんだ！例えばあの…こほっ…こほっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830121,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "平気平気、ずっと体調が悪いんだ。挿し絵を描く時はいつも夜更かししてて、たまにご飯を食べるのも忘れちゃうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830123,
					"content": "こほっ…そしたら、だんだん体調が悪くなってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830124,
					"content": "体調が悪いのに、なんでこんなとこで絵を描いてるんだよ？家じゃできないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830125,
					"content": "ここへは取材するために来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830126,
					"content": "最近、絵を描くためのひらめきが全然湧いてこないの。締切りが過ぎてる挿し絵もいくつかあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830127,
					"content": "森子さんが締切りを何度も延ばしてくれたんだ。それでも提出できなかったら、きっと森子さん怒るだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830128,
					"content": "外に出ることで、何かひらめきを得られるかもしれないと思ったの。で、外を歩いてるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830129,
					"content": "結果…はは…見ての通り。出発からまだそう経ってないのに、私にはきついみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830130,
					"content": "はぁ、やっぱり冒険者協会に依頼して、「写真機」を持っている冒険者に手伝ってもらうしかないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830131,
					"content": "ん？「写真機」なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830132,
					"content": "持ってるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "え！？君、写真機を持ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830135,
					"content": "冒険者に「写真機」で写真を撮ってもらいたいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830136,
					"content": "外には面白い場所がたくさんあるって聞いたんだ！例えば、モンドの近くにある高い雪山とか、璃月にある柱がたくさん立っているところとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830137,
					"content": "それに！璃月には「絶雲の間」っていう場所があってね、そこには仙人が住んでいるらしいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830138,
					"content": "仙人が住む場所…想像するだけでわくわくするよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830139,
					"content": "私は体調のせいで、そこへは行けないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830140,
					"content": "でも、もし君が代わりに「写真機」で景色を撮ってくれたら…私も必ず…コホッコホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830141,
					"content": "うわぁ！大丈夫か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726830142,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "本当に！？よかった！私、見てみたい場所がたくさんあるんだ。少し待っててね、今その場所を書くから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830145,
					"content": "あっ、そうだ。報酬なら心配しないで、少しは貯えがあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830146,
					"content": "えっと、私の筆記帳は？筆記帳、筆記帳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830143,
					"content": "何とかしてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "でも、「写真機」で何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}