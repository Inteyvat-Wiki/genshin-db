			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "ゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "こんにちは、ようやく適切な人物が来てくれた。ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700104,
					"content": "しかも顔なじみときた。これでサンプルの数は心配しなくて済む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700105,
					"content": "こんなにも待ったのに、年寄りや子供ばかりで、全然だめだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700106,
					"content": "あなたは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "えっ、もう私のことを忘れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700108,
					"content": "私はなにも悪巧みをするような者ではない。そうやって知らないふりをする必要はないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700111,
					"content": "ほらよく見てくれ、私だ、私。稲妻の離島でも会っているじゃないか…ゴホッゴホッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700112,
					"content": "実に怪しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "どうやら本当に私のことを覚えていないようだ。はぁ…ならばもう一度自己紹介をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700114,
					"content": "私はスメール「教令院」の学者ホッセイニだ。研究を行うために、はるばる稲妻にやって来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700115,
					"content": "ただ残念なことに…ゴホッゴホッ…稲妻には様々な制限があり、研究を行うのが難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700116,
					"content": "何の成果もなかったというわけではないが、払った代価と比べるとやはり損をした気分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700117,
					"content": "研究経費はもう残りわずかで、今は璃月を経由して「教令院」に戻るしかない。だが帰りに費やす時間を無駄にしたくないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700118,
					"content": "だからいっそのこと、「教令院」で既に評価を得た「エネルギー原盤」をより深く研究することに決めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700119,
					"content": "君は「エネルギー原盤」のことをまだ覚えているだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700120,
					"content": "あれは貴重な古代遺物であり、遍在する地脈を使い、使用者の力を増幅できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700121,
					"content": "ゴホッ…これについての研究はまだ初期段階で、以前提出した調査報告もこの研究の序論に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700122,
					"content": "「エネルギー原盤」の動作原理と応用性を理解し尽くすには、まだまだやるべきことがたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700123,
					"content": "だから私はここでボランティアを募り、彼らに「エネルギー原盤」を体験してもらうことにした。そこから得たデータを研究に使うために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700124,
					"content": "私は…ゴホッゴホッ…怪しい人などではない、誤解しないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700125,
					"content": "なるほど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "そうだ…ゴホッゴホッ…君に聞きたいんだが、ボランティアとして「エネルギー原盤」を試してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700127,
					"content": "試してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "まずは、英知の追求に力を貸してくれるその精神に、改めてお礼を言わせてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700129,
					"content": "だが、「エネルギー原盤」を正式に渡す前に、少し準備運動をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700130,
					"content": "これも、君が自分の身を守ることができるかどうかの確認だ…ゴホッゴホッ…責任ある学術研究は、決してボランティアの命を危険にさらしたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700131,
					"content": "もし準備ができたら、指定の場所に行って、そこの拠点を片付けてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700132,
					"content": "私はここで待っている。くれぐれも安全に気をつけるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700109,
					"content": "…何をする気なの！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "私が人を誘拐して実験するようなイカれた学者に見えるのか？そんな賊を警戒するような話し方はやめてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "ホッセイニ"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "帰ってきたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700202,
					"content": "傷一つ負ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "ハハッ…ゴホッゴホッ…やはり私の考えすぎだったな。君の実力は相当なものだ、安心して「エネルギー原盤」を任せられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700204,
					"content": "「エネルギー原盤」の使い方はとても簡単だ。見たらすぐに分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700205,
					"content": "だが、使う時はくれぐれも気をつけてくれ。これは本物の古代遺物、失くしたり壊したりしたら、私が大変なことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700206,
					"content": "少し「エネルギー原盤」に慣れてみるといい。その後でテストに移行しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700301,
					"content": "どうだ、「エネルギー原盤」の使い方は理解できたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700302,
					"content": "あまり複雑じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "確かに、「教令院」の装置と比べれば、「エネルギー原盤」は簡単のほうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700306,
					"content": "君の実力なら、テストのレベルを上げても問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700307,
					"content": "通りかかった冒険者から、奇妙な秘境を発見したと聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700308,
					"content": "初めて発見された場所で、中には相当の数の魔物がいる。それに魔物の力も、野外のものより強いだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700309,
					"content": "もしそこをテスト場所にできるなら、きっとより全面的なデータが得られるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700310,
					"content": "何せ以前の君の活躍も…ゴホッ…見事なものだった。だが実力が高すぎて、逆に「エネルギー原盤」のデータがあまり取れなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700311,
					"content": "君なら、このような秘境は大したことじゃないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700312,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
					"content": "他の人がこう言ったら信用できるか迷うが、君なら絶対問題ないと思うよ、ハハッ…コホンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700314
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700314,
					"content": "秘境の場所はマップに記しておこう、テスト任務は頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 726700304,
					"content": "よく分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700305
					]
				},
				{
					"id": 726700305,
					"content": "まあ、当たり前だな。心配するな、君は専門家ではない、基本的な操作だけを覚えればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "ホッセイニ"
				}
			]
		}
	]
}