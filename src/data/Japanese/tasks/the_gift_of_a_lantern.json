			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "はぁ…ばあや、お前もこっち来て話さんか…今ちょうど手芸について話してるんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180302,
					"content": "この豆腐は璃月港でも売れるくらいの良い物じゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180303,
					"content": "小白よ、お前は何しに来たんじゃったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180304,
					"content": "霄灯を届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "霄灯…ほう…霄灯じゃったか…毎年すまんのう、小白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180306,
					"content": "ばあや、お前も覚えてるじゃろ、わしの霄灯作りの腕前を。周りのやつら皆わしに頼んでたわい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180307,
					"content": "毎年海灯祭になると、霄灯が綺麗なんじゃ…少し待っておれ、今霄灯を飾って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180308,
					"content": "飾るの手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "うむ、よかろう。転ばないように、気をつけるんじゃぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				}
			]
		},
