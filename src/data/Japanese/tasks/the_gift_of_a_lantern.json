					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "こんにちは、旅人。この前は助かったよ、軽策荘があんなに賑わうことはなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180102,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "前は私と凪しかいなくてね。子供たちに霄灯を作ったり、年寄りと話をしたり、料理を作ったりするので精一杯だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180104,
					"content": "今回は君のおかげで、賑やかで楽しい海灯祭が過ごせたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180105,
					"content": "でも…やっぱり私も軽策荘の年寄りの方に会いたいの。今日は江城じいさんに会いに行くつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180106,
					"content": "もしよかったら、一緒に来てよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180107,
					"content": "じゃあ一緒に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "うん、じゃあ、江城じいさんのところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
		},
		{
			"id": 7181802,
