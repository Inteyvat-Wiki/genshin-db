					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "霄灯を飾ったのか？ほう、綺麗じゃのう。来年もきっと良い年になるわい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180402,
					"content": "きっとそうなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "じゃあ江城じいさん、私たちはまだ用事があるから、後でまた来るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180405,
					"content": "そうかそうか、若者はいつの時も忙しいのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180406,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "おや、ばあや…わしらの畑がまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江城"
				},
				{
					"id": 718180403,
					"content": "心配ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
