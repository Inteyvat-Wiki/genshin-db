			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "さっきはありがとう、旅人。私一人だったら、対応しきれなかったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180502,
					"content": "祭りの日くらいは、江城じいさんを一人にさせたくなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180503,
					"content": "自分のことはどうするの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "うん…私も後で製粉所に行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180505,
					"content": "あの製粉所は私の父さんが残してくれたの。父さんが亡くなってから、私も璃月の仕事を辞めて、父さんの製粉所を受け継いだの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180506,
					"content": "何と言うか、父さんと同じ環境で同じ事をやると、色々思い出すものがあるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180507,
					"content": "特に海灯祭の時は、父さんが昔言ってくれた言葉をいつも思い出すの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180508,
					"content": "そうだ、江城じいさんの霄灯作りに気を取られて…自分の分を忘れてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180509,
					"content": "でも材料はもう無いし…もう霄灯が作れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180510,
					"content": "今材料を集めても間に合わないし…旅人、材料集めを手伝ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180511,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "じゃあお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				}
			]
