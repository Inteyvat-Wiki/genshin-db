			"trigger": {
				"objectNames": [
					"江城"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "ばあや、帰ってきたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180202,
					"content": "人違いです…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "ほほっ、まだボケてないわい…分かってたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180204,
					"content": "さっきちょうどお前について考えてたんじゃ。祭りの日には、娘に新しい服をあげないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180205,
					"content": "お…今回は誰か連れて来たのか…それは新しい服か？やはりわしが考えてたのと同じやつだったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180206,
					"content": "江城じいさん、私だよ、小白。前に豆腐を送ったでしょ、もう忘れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180207,
					"content": "おう…小白…小白か！覚えておるわい！この前お前のお父さんと話をしたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180208,
					"content": "えーっと…いつだったかのう…ばあや、覚えてるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180209,
					"content": "…覚えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "ほほっ！そうじゃろ、記憶はいいんじゃ…それに、それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "江城"
				},
				{
					"id": 718180212,
					"content": "江城じいさん、少し休んで、休憩しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180213,
					"content": "旅人、江城じいさんのお家を掃除してくれる？私はじいさんと話をしてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718180214,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小白"
				},
				{
					"id": 718180210,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
