					}
				]
			},
			"dialogs": [
				{
					"id": 705500301,
					"content": "ジャジャ～ン！新作ドリンクのできあがり～！きっと気に入るはずだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "わぁ！飲み物の上に、ドドコのキャンディものってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500303,
					"content": "コップの中が、オレンジの食材でいーっぱい！ドドコが白い雲の上でゴロンってしてるみたい…これはもっとすごい「いいお天気」だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500304,
					"content": "クレー、飲んでみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "うんうん…おいしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500306,
					"content": "ゆっくり飲まなきゃ。ごくごく飲んじゃったら、美味しさが分からなくなっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500307,
					"content": "#すっごく不思議…栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、もしかしてお日様をジュースの中に入れちゃったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500308,
					"content": "疲れが全部消えちゃった！温かくて、すごく落ち着く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500309,
					"content": "#…ふあ～栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}はすごいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500310,
					"content": "飲み物の名前はクレーが付けて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "ほんとに？じゃあ、えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500313,
					"content": "お天気もいいし、気分もいいし、ドドコならきっと歌うよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500314,
					"content": "ドドコが歌うなら、クレーも一緒に歌う…だからこれは…「ドドコ晴れ晴れコーラス」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500315,
					"content": "いい名前だね、賛成！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "#えへへ、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、こんなにおいしい飲み物を作ってくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500318,
					"content": "ママに教えてあげなきゃ！今、モンドで一番美味しい飲み物は、「ドドコ晴れ晴れコーラス」だよって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500319,
					"content": "#クレーがハッピーなら、{M#俺}{F#私}もハッピーだよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#じゃあ、クレーがママのおまじないを紙に書いて、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}にあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500322,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}も魔法を覚えて、好きなキャンディを作ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500323,
					"content": "またねー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500320,
					"content": "クレー先生の試練、クリアだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "クレーの考える名前が一番いいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "かっこいい名前をつけてみて？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
