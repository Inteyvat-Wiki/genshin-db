				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "はい、クレー！「いいお天気」だよ！飲んでみて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "わぁ、「いいお天気」ってこういう色なの？紫色の空…キラキラしてる夜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500203,
					"content": "イメージは日没後の澄んだ夕暮れかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "じゃあ、ちょっと飲んでから、しっかり考えてみるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500206,
					"content": "あっ、飲み終わっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500207,
					"content": "おいしい！すっぱくて甘い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500208,
					"content": "焼き魚を食べる時にこれを飲んだら、何匹もパクパク食べられちゃいそう！食欲大爆発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500209,
					"content": "これだけじゃ、クレー飲み足りないよ！もう一杯…ケーキみたいな飲み物が欲しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500210,
					"content": "分かった。「飲むデザート」を追加ね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#うーん…クレー、どんなレシピがいいか分からない…栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}、一緒に考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500214,
					"content": "クレーが持ってきたキャンディ、すごいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "これ？えへへ…ママが錬金台で作り方を教えてくれたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500216,
					"content": "たくさんのキャンディに、ママのフォンテーヌのお友達が持ってきてくれたお花、それからバービーおばあちゃんの星のはちみつと、オクタヴィアおばさんがママにくれた魔力のジャム…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500217,
					"content": "それを錬金台の上に置いたら、形を思い浮かべて、ママと一緒におまじないを唱えるの。そしたら「ドカーン」って音がして、ドドコ形のキャンディができちゃうんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500218,
					"content": "材料も作り方もすごいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#ドドコキャンディ、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}にもあげるね！気に入ったら、ママのおまじないも教えてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500221,
					"content": "#これで、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}も好きなキャンディを作れるようになるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500222,
					"content": "すごいレシピを教えてくれてありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "えへへ、分からないことがあったら、クレーに聞いてね！魔法のキャンディのことなら、クレーはプロだもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500225,
					"content": "今日はまだ何かやることあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "うん！ママが最近、クレーにすごい本をくれたの。毎晩一章ずつ読んでるんだ。お勉強が終わったら、ちゃんと早く寝てるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500227,
					"content": "その本はクレーに「推進剤」の作り方を教えてくれるの！ボンボン爆弾がもっと「ヒュー」って高く跳ねるようになるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500228,
					"content": "そ…それって学んでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "難しくないよ…爆弾と似てるところがたくさんあるから。クレヨンを削るみたいに、ちょっと気をつけてやればいいだけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500231,
					"content": "寝る前も、すっごく大切な時間なんだよ！ママがクレーの隣に座って、いろんなお話を聞かせてくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500232,
					"content": "ママが一本の…ええと、一台の？…とにかく宝石でできたランプを取り出すと、それが「キラン♪」てして、天井に光が映るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500233,
					"content": "天井が物語の舞台になるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "うんうん、お話が進むと天井の光がキレイな模様に変わっていくんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500235,
					"content": "時々ね、ママはお話をしてるうちに寝ちゃうんだ。そしたら、クレーがママにお布団をかけてあげるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500236,
					"content": "#クレーがランプの使い方を覚えたら、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}にお話をしてあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500237,
					"content": "いいね、いいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "えへへ。クレー、たくさんお話を覚えたから、みんな今までにないような時間を楽しめるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500240,
					"content": "クレーは夜も何か食べるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "うん！帰ったら、本を読みながら…ちょっとお塩をかけたナッツを食べるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500242,
					"content": "前はね、晩ご飯の後にケーキを食べてたんだ！でもジン団長が、ケーキに入ってる白砂糖が多すぎて、寝る前に食べるのはよくないって。太っちゃうし、歯も痛くなっちゃうんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500243,
					"content": "それでママは、バービーおばあちゃんの提案で、クレーにナッツをくれたの。これを食べると頭がよくなって、たくさんのことを覚えられるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500244,
					"content": "ナッツの味は薄くて、草をモグモグしてるみたいだけど、塩をつけたら食べられなくはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500245,
					"content": "いい解決策だね。栄養と健康は大切！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "健康的で甘みもある材料を探してみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "うん…クレーはやっぱり、甘いものが食べたい！ケーキのクリームを薄くして、代わりに…フルーツをいっぱい入れるとかどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500248,
					"content": "そうだ！ママのメガネをかけたお友達が、フォンテーヌの果物をくれたの。バブルオレンジっていって、まん丸でコロコロしてるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500249,
					"content": "すっごく甘くて美味しくて、クレー、たくさん食べちゃった。でもジン団長も大丈夫って言ってたよ——「フルーツの甘さは、砂糖の甘さとは違う」って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500250,
					"content": "ってことは、ナッツを食べるなら、フルーツジュースに浸けて食べたらいいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500251,
					"content": "そういえば、クレーの三食って普段どんな感じなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "三食？えへへ、クレーは一日五回食べることもあるし、七回食べる時だってあるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500253,
					"content": "そんなに！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "だって、冒険には体力をいっぱい使うから。でも一度にたくさん食べちゃうと走りにくいから…少しずつ、何回かに分けて食べるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500255,
					"content": "前はアルベドお兄ちゃんがクレーのごはんを作ってくれてたんだ。お弁当箱のお料理は、アルベドお兄ちゃんがいつもきれいに盛り付けてくれて、絵みたいだったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500256,
					"content": "アルベドらしいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "アルベドお兄ちゃんが雪山で忙しい時は、クレーも騎士団のみんなと一緒にキャンプで食事するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500259,
					"content": "ガイアお兄ちゃんの拠点はいつもきれいだし、アンバーお姉ちゃんの拠点は木の上にあったりして、すっごく楽しいの！それに、ヘルターおばさんが作るごちそうは最高なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500260,
					"content": "ママが帰ってきた時は、もっともっと面白いご飯を食べられるんだ！いろんなお魚のお肉とスープで、プリンみたいな四角いのを作ってくれるの。「五色魚のゼリー」っていうんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500261,
					"content": "#それを聞いたら{M#俺}{F#私}も食べたくなってきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "「チョコのサクサクチップ」も美味しいよ！ママがチョコとクッキーで作った新発明なの！ちょっと苦いけど、サクサクで香ばしくって、苦いのがなくなったら、もっと甘くなるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500264,
					"content": "#食べたらパワー全開…！今度、栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}にも持ってきてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500265,
					"content": "うん、どう改良すればいいか分かった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "もう一杯おいしいのを作ってあげるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "もう思いついたの？やったぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500268,
					"content": "次の飲み物はどれくらい美味しいのかな…クレー、すっごく気になる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500262,
					"content": "さすがは大冒険家だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "#アルベドの料理、{M#俺}{F#私}も味わってみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "クレーのお話、待ってるからね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "き、聞いただけで難しそうだけど…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "頑張って勉強して、作ってみるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "とんでもなくすごいキャンディだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "うん、もう一杯すごいの作ってあげる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "好みに合わせて、どんな味でも作れるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "もっとピンとくる名前を考えよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
