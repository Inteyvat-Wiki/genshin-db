							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#あれ？あれぇ？栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}だ！わーい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500102,
					"content": "わーい！クレーだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "えへへ、エウルアお姉ちゃんが言ってたよ。ヘルターおばさんがすごい助っ人を見つけたって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500105,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}がいるってことは、きっとここがテイワットで一番すごいドリンク屋さんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500106,
					"content": "いつか本当に一番のお店にしてみせるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "えっ…まだ…一番じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500109,
					"content": "じゃあ…クレーが行ったドリンク屋さんの中で、一番すごいお店！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500110,
					"content": "#栄誉騎士の{M#お兄ちゃん}{F#お姉ちゃん}が作ったんなら、どんな飲み物でもきっと美味しいはずだもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500111,
					"content": "今回は厳しい目で見てほしい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "え…えっと、そうなの？でもクレー、厳しくできないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500114,
					"content": "うーん…じゃあ、アルベドお兄ちゃんみたいにやってみる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500115,
					"content": "アルベドお兄ちゃんは、ティマイオスおじさんの宿題を直すとき、すっごく真剣なの！クレー、全部ちゃんと聞いてたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500116,
					"content": "じゃあ、今回はクレーが先生役ね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "えへへ…クレー、すっごく上手に注文しちゃうから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500119,
					"content": "もうすぐクレー、ママとお魚をドカーンしに行くんだ…ジン団長には内緒だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500120,
					"content": "今日はママと一緒に、たーくさんお魚をドカーンしたんだ…ジン団長には内緒だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500121,
					"content": "最近ね、ママとずーっとずーっと楽しく遊べて、とっても楽しかったんだ！反省室に入れられても平気なくらい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500122,
					"content": "だから、クレーの注文は「いいお天気」！——お日様がポカポカで、絶対に気持ちいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500123,
					"content": "了解！クレー先生、さっそく始めるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "えへへ、どんな味かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 705500124,
					"content": "了解！じゃあ始めるね、大錬金術師クレー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "いいね、大錬金術師クレー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "ダメなところは全部言っていいからね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "一番を目指してこれからも頑張るね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "わーい！クレーが遊びに来てくれた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
			"id": 7055002,
