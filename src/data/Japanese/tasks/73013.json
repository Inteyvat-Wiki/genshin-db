	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランパカティ",
					"アランマ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "わっ！金色のナラだ。うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130102,
					"content": "#アランパカティ、怖がらないで。ナラ{NICKNAME}はいいナラだよ。物語に出てくるあのナラとおんなじだ。ナラ{NICKNAME}とパイモンはたくさんの人を助けてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130103,
					"content": "#うん…怖くない。アランパカティはアランマを信じる。草と葉と種の話を信じる——きっといいナラだ。こんにちは、ナラ{NICKNAME}とパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130104,
					"content": "よろしくな、アランパカティ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130105,
					"content": "#実は{M#俺}{F#私}、悪いやつなんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "コラ！悪い冗談はやめろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130107,
					"content": "違うよ。アランパカティは知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130108,
					"content": "#風のたくさん吹くところにある、小さな種。その子たち、ナラと一緒にヴァナラーナにやってきた。その子たちが言ってる、ナラ{NICKNAME}はいい人だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130109,
					"content": "アランマもそんなこと言ってたよな！風の多い場所から来た種って…ひょっとしてタンポポのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130110,
					"content": "風車アスターのことかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#ナラ{NICKNAME}はアランラナを助けて、ビージャの実を実らせないといけない。だから、一緒にウツァヴ祭の準備をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130116,
					"content": "あああ…ウツァヴ祭が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130117,
					"content": "アランパカティ、様子が変だよ。何か困ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130118,
					"content": "アランパカティの「お兄ちゃん」たちが、ヴァナラーナに帰ってこないの。帰ってこないと、「兄妹」で一緒にウツァヴ祭を過ごせない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130119,
					"content": "ボクもずいぶん長く、ヴァナラーナでアランチャトラやアランサカ、アランパスとアランファラに会ってない。前に事件があって以来、ずっとだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130120,
					"content": "ずいぶん…ってどれくらいだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130121,
					"content": "たくさんのお月様が昇って沈むよりもずーっと前のとき。種から芽が出たばっかりのとき。もうその芽は、アランナラの雨を遮る大木になっちゃった。アランパカティ七人分くらい、大きいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130122,
					"content": "種が大樹にって…うわあ！それ、とんでもない時間じゃないか！アランパカティの兄ちゃんたちは失踪しちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130123,
					"content": "「シッソウ」？それは種の名前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130124,
					"content": "へえ！ナラの種はシッソウっていうのか。すごいや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130125,
					"content": "#ナラすごい！ナラ{NICKNAME}にはきっとたくさんの「シッソウ」があるんでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130126,
					"content": "そういう意味じゃないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130127,
					"content": "どこに行ったか分からないっていう意味。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "ううん。アランパカティは、アランチャトラやアランサカ、アランパスとアランファラがどこにいるか知ってるよ。だから、失踪じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130129,
					"content": "みんなはずーっと、ヴァナラーナの外で修行してるの。「お料理修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130136,
					"content": "ああ、なるほど。「お料理修行」な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130137,
					"content": "パイモンが食いつきそうな話だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#ふふんっ！オイラは「{NICKNAME}のお料理修行」の方が気になるけどな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130139,
					"content": "で、お料理修行っていうのは一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130140,
					"content": "それは、前回のウツァヴ祭の時の話だ。あの時、ナラはたくさんの「料理」を作って、アランナラたちに振る舞った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130141,
					"content": "だからアランチャトラたち、次はナラに「料理」を作ってあげたくて、ずっと「お料理修行」してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130142,
					"content": "…なんだか急にお祭りが楽しみになってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130143,
					"content": "でも、それってアランナラ料理だよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "グルメはあらゆる生物の共通言語なんだぞ。心配ないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130146,
					"content": "でも兄ちゃんたちの居場所を知ってるのに、なんで捜しに行かないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130147,
					"content": "盛大なウツァヴ祭がもうすぐ始まる。アランパカティも、準備で大忙し。捜しに行く暇がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130148,
					"content": "みんな、ウツァヴ祭のためにヴァナラーナを出て、「お料理修行」に行った。でも祭りがもうすぐなのを知らない。アランチャトラもアランサカもアランパスもアランファラもバカ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130149,
					"content": "#じゃあオイラたちに任せろよ！オイラたちもアランマとウツァヴ祭の準備をして、森のアランナラを取り戻さなきゃいけないんだ。{NICKNAME}、いいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130150,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "でも、そのアランチャトラ、アラン…なんとかたちをどうやって捜せばいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130153,
					"content": "アランチャトラ、アランサカ、アランパス、アランファラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130154,
					"content": "うわあ…アランラナ、アランマ、アランラジャにアランパカティ…アランナラの名前って、なんでこんなに難しいんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130155,
					"content": "パイモン、アランナラの名前を悪く言わないでくれ。じゃないと、アランナラは悲しくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130156,
					"content": "う、ごめんな。それで、どうやってそいつらを見つけるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130157,
					"content": "アイツらはヴァナラーナで「お料理修行」をした結果、たくさんの煙を出してしまった。だから、アランパカティはアイツらを追い出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130158,
					"content": "あの時はみんなとても怖がって、休眠してしまうアランナラもいたの。でも、アランマが勇気を出して煙を懲らしめてくれた。それでアランパカティは怒ってお兄ちゃんたちを追い出したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130159,
					"content": "森の中で<color=#00E1FFFF>煙がモクモク出ていたら</color>、そこにお兄ちゃんたちはいるはず。ぜったい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130160,
					"content": "おまえがそいつらを追い出したのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130161,
					"content": "うん。だめ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130162,
					"content": "#いや、そういうわけじゃ…そんじゃ{NICKNAME}、行くとするか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130163,
					"content": "あ、そうだ。もうひとつ。もしもお兄ちゃんたちがおかしくなってたら、<color=#00E1FFFF>草元素の力</color>で「パチン」してあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130164,
					"content": "お兄ちゃんたちがモクモク煙を出したせいで、ヴァナラーナは煙だらけになった。お兄ちゃんたちも怖がって逃げ回った。たまに森で変なキノコに出会った時も、あんな風になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130165,
					"content": "でも、アランナラは草木の精霊。だから<color=#00E1FFFF>草元素の力</color>を吸うと、元気になって目が覚める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130166,
					"content": "#そっか。{NICKNAME}は鳥肉のスイートフラワー漬け焼きを食べると元気になるんだ。つまり、鳥肉のスイートフラワー漬け焼きの精霊ってことだな。うんうん！納得だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130167,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130169,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130170,
					"content": "…えっと、じゃあ出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130172,
					"content": "#ナラ{NICKNAME}、パイモン、がんばって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730130171,
					"content": "うん、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "すごく楽しみだぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "その気持ちはよく分かるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#ナラ{NICKNAME}にも、気持ちが分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130132,
					"content": "#そうだな。{NICKNAME}にも生き別れた{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}がいるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130133,
					"content": "#ふうん。ナラ{NICKNAME}の{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}も「お料理修行」に行った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130134,
					"content": "えっ？なんか話がかみ合わないな…失踪っていうのは「どこに行ったかわからない」っていう意味だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130135,
					"content": "あれ、じゃあ違う。アランパカティのお兄ちゃんたちは「しっそう」じゃない。ヴァナラーナへ、ずっと修行に行ってるの。「お料理修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130111,
					"content": "松ぼっくりのことかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "まさか風が物語の種を運んで来たのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130114,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
