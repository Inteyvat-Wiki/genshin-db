				"objectNames": [
					"アランパカティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "…ナラと話すの、難しくて大変。それに、ナラはおっきい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130202,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#うわっ！ナラ{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130204,
					"content": "アランパカティ、怖くないよ。お兄ちゃんたちも勇敢だから、きっと怖がらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130205,
					"content": "<color=#00E1FFFF>煙の柱</color>についていけば、みんなが見つかる。変な風になってたら、<color=#00E1FFFF>草元素の力</color>で「パチン」てしてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパカティ"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランパカティ",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "アランパカティは今、すっごく怒ってる。もおおおっ、すっごく怒ってるよりももっと怒ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130302,
					"content": "森はとてつもなく危ないところ。森では「マラーナ」が暴れてる。出発するとき、アランパカティはお兄ちゃんたちに言ったよね。心をひとつにしてって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130303,
					"content": "なのに出かけた途端、お兄ちゃんたち大げんかした。アランチャトラは、勝手に変なもの食べた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130304,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730130305,
					"content": "アランパカティは決めた。夕暮れの実が十回熟すまで、アランチャトラはキノコを採っちゃダメ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130306,
					"content": "そんなあ…えーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "アランチャトラ"
				},
				{
					"id": 730130307,
					"content": "まったくだ！悪い胞子を持ち込んで、キノコの怪物が生まれたらどうすんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730130308,
					"content": "アランファラお兄ちゃんもだよ。ヴァナラーナからあんなに離れた所まで果物を採りに行くなんて。あそこにはすっごく悪いヤツがいるからって、アランラジャがわざわざ注意してくれてたでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130309,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "アランファラ"
				},
				{
					"id": 730130310,
					"content": "だよな。果物は水を飲むし、アランナラも水を飲む。だから、水は最高なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730130311,
					"content": "アランパスお兄ちゃん、意地でも「ヴァルナ神器」のところまで水を汲みに行くつもり？ナラヴァルナも言ってたでしょ。ヴァナラーナの水が一番おいしいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130312,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730130313,
					"content": "ほ、ほれみろ。妹を幸せにできるのは、「喜びの味」だけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730130314,
					"content": "#あのね、アランサカお兄ちゃん。その「喜びの味」のせいで、ナラ{NICKNAME}にどれだけ迷惑かけたと思ってるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130315,
					"content": "そ、それは全部「至高のごちそう」のためで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730130316,
					"content": "「至高のごちそう」は、「お料理修行」が実を結んでこそのものでしょ。ああもうっ、ひとの力に頼って修行を終えることに、意味がある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130317,
					"content": "アランサカお兄ちゃんはよぉく反省した方がいいと、アランパカティは思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130318,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "アランサカ"
				},
				{
					"id": 730130319,
					"content": "やっほー、アランパカティ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130320,
					"content": "あら、アナタたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130321,
					"content": "#ナラ{NICKNAME}とパイモンは、アランパカティの悩みをすっかり解決してくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130322,
					"content": "お兄ちゃんたちはウツァヴ祭に間に合った。もう外で危ない目に遭ってないか、心配しなくていい。全部アナタたちのおかげ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130323,
					"content": "アランパカティもお兄ちゃんたちも、みんな感謝してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130324,
					"content": "それならよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130325,
					"content": "でも、ずっと疑問だったんだけどさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130326,
					"content": "「ナラヴァルナ」って誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はワタシたちの友達。ヴァナラーナの仲間だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130328,
					"content": "#うーんと昔、アランナラの友達だった。ナラ{NICKNAME}とそっくりの金色のナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130329,
					"content": "へえ、そうだったのか。あとさ、もう一つ質問があるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130330,
					"content": "「兄妹」のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "うん。アランパカティの兄ちゃんたちって、誰が一番大きくて誰が一番小さいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130332,
					"content": "え？大きさ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130333,
					"content": "歳のこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "「年齢」…アランパカティ、知ってる。それは木の年輪みたいなもの。でも、森の子供たちは「年齢」で大きさを分けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130337,
					"content": "え？じゃあ「兄」と「妹」ってなんなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130338,
					"content": "#えっと、昔ナラの友達がいた。ナラヴァルナ。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}が言ってた。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}には「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」がいるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130339,
					"content": "#アランパカティとお兄ちゃんたちは、{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}が「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」の話をするとき、幸せそうで、それでいて悲しそうだと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130340,
					"content": "それで分かった。「兄」にとって、「妹」はとても大切なナラ。「妹」にとって、「兄」はとても大切なナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130341,
					"content": "すごくステキだと思った。だから、アランパカティとお兄ちゃんたちは決めたの。「兄」と「妹」になるって。ナラヴァルナも、いいねって言った。家族は大切だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130342,
					"content": "そうだね。家族は大事にしなくちゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "ふーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130344,
					"content": "もう一個気になってたんだけどさ…アランナラもごはんを食べるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130345,
					"content": "ヒト類は食材を料理にする。森の子供も、食材で料理を作る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130346,
					"content": "ナラヴァルナが、ナラの料理を教えてくれた。だからアランパカティとお兄ちゃんたちは、「お料理修行」を始めた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130347,
					"content": "へーえ、不思議な話だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130348,
					"content": "そうやって遊んでる感じなのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "ううん、アランパカティとお兄ちゃんたちは本気。だって、ナラヴァルナが言ってた。一緒に食べるのは幸せだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130351,
					"content": "#そうだ、アランパスお兄ちゃんが言ってた。ナラ{NICKNAME}も料理ができるんでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130352,
					"content": "#おう！{NICKNAME}も中々手慣れたもんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730130353,
					"content": "#そうなんだ…じゃあウツァヴ祭には、ナラ{NICKNAME}も絶対来て。ダメダメなお兄ちゃんたちと一緒に料理をして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130354,
					"content": "それで、みんなに教えてあげて。ナラにしかわからない。アランナラには永遠にわからない。本物の料理のことは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130355,
					"content": "あとで「あれ？」と思っても遅いから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "アランパカティ、すっごく楽しみ。今度のウツァヴ祭はきっとすごくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパカティ"
				},
				{
					"id": 730130356,
					"content": "腕をふるってみせるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "おままごとみたいな感じかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "サイズのこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "おい、違うぞ。オイラ、年齢のことを聞いてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "パイモン"
				}
			]
