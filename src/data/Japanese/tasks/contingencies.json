					"id": 411230901,
					"content": "状況はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230902,
					"content": "清泉町はもう安全だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "それはよかった…今人手が足りないと嘆いてたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230904,
					"content": "本当に助かった、感謝する。これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230905
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230905,
					"content": "隕石やら魔物やら…これ以上何か出ないでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
