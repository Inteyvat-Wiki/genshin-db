			},
			"dialogs": [
				{
					"id": 411231101,
					"content": "やあ、栄誉騎士。この期間は極力城内にいろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231102
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231102,
					"content": "あの落ちる隕石なら、お前さんも見ただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231103
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231103,
					"content": "何故かは知らないが、この頃隕石が落ちる勢いが増してきてる。外はもっと危なくなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231104
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231104,
					"content": "城内の仕事がますます多くなって、騎士団じゃ手に負えない。こんな時に城外で宝盗団の痕跡が見つかってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231105
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231105,
					"content": "金のためなら何でもするやつらだ、この混乱の中で一稼ぎしようと企んでるに違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231106
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231106,
					"content": "もしよかったら、城外の宝盗団を追い払ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231107,
						411231109
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231107,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231108
					]
				},
				{
					"id": 411231108,
					"content": "ふむ、さすが栄誉騎士だ。では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231109,
					"content": "宝盗団は隕石が怖くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231110
					]
				},
				{
					"id": 411231110,
					"content": "ふん、金のためなら、何も怖くないんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231111
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411231111,
					"content": "じゃあ頼んだよ。こんな状況の中、本当に申し訳ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
