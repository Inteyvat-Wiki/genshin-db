			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "あれ？また君か、何してたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230802,
					"content": "魔物を倒してきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "倒したって…本当に、一人で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230804,
					"content": "自分で見てきたらいい",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "う…僕は行きたくない、魔物に見つかったら終わりだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230806,
					"content": "まあいいや、本当でも嘘でも、全部報告するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230807,
					"content": "君が本当に魔物を倒したのなら、町にいる西風騎士が検証してくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "臆病なモロー"
				}
			]
		},
