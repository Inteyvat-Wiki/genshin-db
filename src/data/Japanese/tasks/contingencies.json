			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "やあ、旅人。この期間は極力城内にいろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "あの落ちる隕石なら、お前さんも見ただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230104,
					"content": "何故かは知らないが、この頃隕石が落ちる勢いが増してきてる。外はもっと危なくなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230105,
					"content": "城内の仕事がますます多くなって、騎士団じゃ手に負えない。こんな時に城外で宝盗団の痕跡が見つかってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230106,
					"content": "金のためなら何でもするやつらだ、この混乱の中で一稼ぎしようと企んでるに違いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230107,
					"content": "もしよかったら、城外の宝盗団を追い払ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230108,
					"content": "本来は騎士団の仕事だが、今は本当に人手が足りない。お前さんに頼むしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "じゃあ頼んだよ。こんな状況の中、本当に申し訳ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230111,
					"content": "宝盗団は隕石が怖くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "ふん、金のためなら、何も怖くないんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230113,
					"content": "じゃあ頼んだよ。こんな状況の中、本当に申し訳ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
