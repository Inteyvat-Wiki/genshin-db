			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "宝盗団を追い払ってくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230302,
					"content": "追い払った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "それはよかった、本当に助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230304,
					"content": "あの宝盗団もこれに懲りて、ここには悪さをしに来ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230305,
					"content": "もう用がないなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "おっと、待ってくれ…まだ一つ、手伝ってほしいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230307,
					"content": "実は隕石が落ちてから、魔物が異常になる報告を騎士団に多く届いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230308,
					"content": "それらの報告では、隕石の影響を受けて、魔物たちが狂暴になっているという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230309,
					"content": "モンド城の護衛なら心配する必要はないが、清泉町の近くに隕石が落ちたらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230310,
					"content": "清泉町には狩人が多くいる。こっちも騎士を向かわせたが、あそこの地形のせいで完全な守備はできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230311,
					"content": "もし魔物を取り逃して町に入ったらまずい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230312,
					"content": "清泉町周辺に行って状況を確認してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230313,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "なら頼んだぞ、こっちも終わり次第追加の騎士を支援に送る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230315,
					"content": "清泉町の状況はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "正直いうと…あまりよくない。隕石のこと以外にも、魔物や宝盗団のことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230317,
					"content": "同時にそこまで多く対処するのは、さすがにきつい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 411230318,
					"content": "ならこのことは頼んだぞ、こっちも終わり次第追加の騎士を支援に送る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				}
			]
		},
