			"dialogs": [
				{
					"id": 411230401,
					"content": "うわ！く、来るな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230402,
					"content": "あれ？魔物じゃない…き、君は誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230403,
					"content": "魔物の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "魔物の状況って…そんなの見たらわかるでしょ？僕はあの魔物たちから逃げてきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230405,
					"content": "すぐそこに、もうたくさん集まってる。町を攻撃しようとしてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230406,
					"content": "必死で走ってなかったら、今頃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230407,
					"content": "魔物はどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "町のすぐ近く、少し歩けば見えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "臆病なモロー"
				},
				{
					"id": 411230409,
					"content": "君も早く避難した方がいい、僕はここで少し休んだら…町に戻って状況を報告するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "臆病なモロー"
				}
			]
		},
		{
