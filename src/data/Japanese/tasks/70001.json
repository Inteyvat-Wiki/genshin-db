			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "宝盗団のことはどうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010602,
					"content": "全部解決した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "さすが西風の栄誉騎士ね。あの宝盗団との話し方も絶妙なものだったわ。やっぱり「あの方」が見込んだだけのことはあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
