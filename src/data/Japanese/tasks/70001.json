			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"落ち込む市民"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "まだチャンスはあるだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "落ち込む市民"
				},
				{
					"id": 700010502,
					"content": "ん？なにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "落ち込む市民"
				},
				{
					"id": 700010503,
					"content": "風の花が舞い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "もしかして、「何が起きても、風花祭を楽しめ」って言いたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "落ち込む市民"
				},
				{
					"id": 700010505,
					"content": "確かに、拒否されただけで落ち込むのはいけないな。祭りもまだ終わってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "落ち込む市民"
				},
				{
					"id": 700010506,
					"content": "ありがとう、少し元気になったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "落ち込む市民"
				},
				{
					"id": 700010507,
					"content": "誤解されたけど、怪しい人物じゃなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
