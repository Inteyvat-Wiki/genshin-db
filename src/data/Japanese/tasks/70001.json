			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "旅人、また会ったわね。城内の雰囲気にはもう慣れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010202,
					"content": "すごく好きな雰囲気。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "そう、よかった。でも…雰囲気とかけ離れたことだけど、風花祭に関することを君に依頼したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010204,
					"content": "いえ、正確には、「あの方」からの依頼ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010205,
					"content": "今は人に依頼できないんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "それは心配しないで。今回の依頼は、風花祭の掟に入らないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010207,
					"content": "君も気づいてると思うけど、毎年の風花祭はとても賑やかで、人もすごく多い。みんな祭りを楽しんでるの。西風騎士団も秩序を守るためにとても忙しく働いてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010208,
					"content": "無防備な群衆、忙しい西風騎士、宝盗団にとっては絶好のチャンスね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010209,
					"content": "「あの方」の情報によると、いくつかの宝盗団のメンバーがすでに城内に忍び込んだらしい。城内で風花祭を祝うふりをしてるけど、実際は計画のための調査よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010210,
					"content": "もし騎士団が大掛かりな捜査を始めると、気づかれて取り逃がす。それに祭りの雰囲気も壊してしまう。でも彼らを放ってはおけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010211,
					"content": "#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "そう、今回も「あの方」からの名指しよ。彼が言うには、君が最も適任らしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010213,
					"content": "それじゃ、本題に戻るわね。私が仕入れた情報によると、宝盗団たちは身分を示すための<color=#00E1FFFF>小包</color>を持っているらしい。それに、身分を確認する時は<color=#00E1FFFF>暗号</color>を使う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>「風の花が舞い、人々が見る。」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010215,
					"content": "覚えやすい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "この暗号が合えば、城内に忍び込んだ宝盗団ということね。それに彼らの口から、野外の拠点の情報も聞き出せるかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010218,
					"content": "情報を聞き出したら、ついでに倒してきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010219,
					"content": "どうして騎士団に任せないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "祭りの秩序を守るために、騎士団はもういっぱいいっぱいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010221,
					"content": "なるべく手助けした方が、彼らのためになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010222,
					"content": "じゃあお願いね、「栄誉騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァル"
				},
				{
					"id": 700010216,
					"content": "やつらの風格らしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
