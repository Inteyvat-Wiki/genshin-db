			"dialogs": [
				{
					"id": 700010301,
					"content": "どこも賑やかで、いい雰囲気だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "怪しげな市民"
				},
				{
					"id": 700010302,
					"content": "風の花が舞い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "おっ？…人々が見る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "怪しげな市民"
				},
				{
					"id": 700010304,
					"content": "仲間だったか、ちょうどいい。さっき警戒心が薄いカップルを見つけたんだ、モラを奪いに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "怪しげな市民"
				},
				{
					"id": 700010305,
					"content": "お前があいつらの注意を引いて、俺がやる。そしたら風立ちの地で他の仲間たちと合流しよう。みんながどんな収穫を手に入れたのか気になるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "怪しげな市民"
				},
				{
					"id": 700010306,
					"content": "その前に、一緒に来てもらおう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "えっ！？ちょ、ちょっと！宝盗団じゃないのか？何者だ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "怪しげな市民"
				},
				{
					"id": 700010308,
					"content": "騎士団のメンバーだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "あいつはもう騎士団に連れていかれたな。でもどうしてあんなに早く西風騎士が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700010310,
					"content": "とりあえず、さっき風立ちの地に仲間がいるって言ってたから、そこに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
