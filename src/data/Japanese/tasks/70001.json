			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "ん？どうした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "焦る市民"
				},
				{
					"id": 700010402,
					"content": "風の花が舞い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "風の花？なんだ、蒲公英のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "焦る市民"
				},
				{
					"id": 700010404,
					"content": "それがどうしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "焦る市民"
				},
				{
					"id": 700010405,
					"content": "ごめんなさい、間違えました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700010406,
					"content": "普通の市民だったようだな。他をあたってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
