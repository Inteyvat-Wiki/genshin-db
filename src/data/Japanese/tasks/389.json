				"points": []
			},
			"dialogs": [
				{
					"id": 3890601,
					"content": "これ以上は行けないね。この遺跡には古い<color=#00E1FFFF>封印</color>が施されているみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890602,
					"content": "これもトワリンの仕業か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3890603,
					"content": "違うよ。この廃墟は古代都市で、トワリンが一時的に身を置いてるに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890604,
					"content": "廃墟自体、「四風守護」の時代よりもずっと古いものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890605,
					"content": "モンドは王のいない都市だったけど、モンドができる前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890606,
					"content": "ある暴君がここを統治していたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890607,
					"content": "うん…機会があったら、君たちにもその物語を聞かせるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890608,
					"content": "僕の知る考古学の知識からすると、<color=#00E1FFFF>「導光装置」</color>が鍵になるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3890609,
					"content": "散らばった全ての<color=#00E1FFFF>パーツを元に戻せば</color>、<color=#00E1FFFF>導光の儀式</color>を完了できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3890610,
					"content": "見たところ、導光の儀式が行える状態まで、そうかけ離れてはいないようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3890611,
					"content": "まずは<color=#00E1FFFF>パーツ</color>を設置して、また様子を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
			]
		}
	]
