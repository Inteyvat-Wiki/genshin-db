			"dialogs": [
				{
					"id": 3890301,
					"content": "行き止まりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3890302,
					"content": "行き止まりだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890303,
					"content": "なぁ…あそこの<color=#00E1FFFF>屋根</color>、でっかい<color=#00E1FFFF>穴</color>が開いてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3890304,
					"content": "うん…あそこの<color=#00E1FFFF>風域</color>は利用できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3890305,
					"content": "うん、回り道になるけど、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3890306,
					"content": "うん、回り道になるけど、行こう。",
