					"nextDialogs": [
						411500303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500303,
					"content": "これを届けに行ってやってくれ。<color=#00E1FFFF>飛んだり走ったりせずに、慎重に歩けよ</color>。こぼすからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>それと、変な元素を付けて味を台無しにしないでくれ</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500305,
					"content": "もし料理がダメになったらここに戻って来い。作り直してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
