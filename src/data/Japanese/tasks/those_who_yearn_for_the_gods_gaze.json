			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "ここだよな。でも、怪しいヤツはいないみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140202,
					"content": "#まさか隠れてるのか？{NICKNAME}、近くを探索してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140203,
					"content": "この<color=#00E1FFFF>雷元素の石碑</color>、なんだか怪しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "ふぅ…やっと終わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140502,
					"content": "手強いヤツだったな。でもなんでこんなところに、あんな大きな雷兜のヒルチャール王者がいたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140503,
					"content": "わからない…それにここの雰囲気、なんだか変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140504,
					"content": "とにかく、もうなにもないはずだから、早く戻ろう…あれ、哲平だ。なんでおまえもここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140505,
					"content": "ゴホッ…僕も驚いたよ、君たちもここで調査してたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140506,
					"content": "ちょうど物資を前線まで運んで、今この近くの脅威を片づけようと…コホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140507,
					"content": "大丈夫か、おまえなんか変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140508,
					"content": "大丈夫大丈夫、たぶんこのまえ海に出た時に体が冷えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140509,
					"content": "ここを通りかかった時、ちょうど島に上陸して調査してる人がいるって聞いてね、見に来たんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140510,
					"content": "万が一危険にでも遭っていたら、僕が英雄みたいに助けてあげようと思ってたけど…君たちだったとは。どうやら、僕の取り越し苦労だったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140511,
					"content": "哲平、おまえはここの雰囲気になにか特別なものを感じるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140512,
					"content": "うーん…そう言われると、たしかに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140513,
					"content": "でもここは魔神オロバシの亡骸に近いから、祟り神の気配が強いんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140514,
					"content": "魔神オロバシってなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140515,
					"content": "ほら、あれがオロバシの残した遺骨だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140516,
					"content": "うわっ！あんなにデッカイ蛇の骨、見ただけで体が震え上がってくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140517,
					"content": "今の海祇島があるのは、オロバシが僕たちの先祖を淵下宮から地上へ連れ出したからなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140518,
					"content": "僕たちの先祖はそれをずっと守り神として見ていたけど、魔神戦争中、オロバシはヤシオリ島を侵略した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140519,
					"content": "それで雷電将軍が直接出向き、「無想の一太刀」で斬り伏せたんだ。あの一刀が、今の「無想刃狭間」を形成したってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140520,
					"content": "「無想刃狭間」って、雷電将軍に斬られてできたものだったのか…すごいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140521,
					"content": "そう。でも魔神戦争は非常に苛烈なもので、ヤシオリ島はそのせいで廃墟と化した。噂では将軍様もその時に大切なものを失ったと言われてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140522,
					"content": "オロバシが死んでから、海祇島と幕府の仲は悪くなったんだ。でも今回抵抗軍を立ち上げたのは、その信仰とは関係なく、単に目狩り令に抗うためだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140523,
					"content": "オロバシが文明を滅ぼそうとするのを、将軍様が止めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140524,
					"content": "そして今、将軍様が目狩り令を発令し、人々の願いを奪おうとしている。これも同じように、誰かが将軍様を阻止しなければならないんだ…ゴホッゴホッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140525,
					"content": "僕は先に戻るよ。幕府軍の精鋭武士を片づけたばかりで、帰って少し休みたい。まだ他にやることもあるしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140526,
					"content": "君たちは早く珊瑚宮様に報告するといい。ここはまだ祟り神の気配が残っているかもしれないから、長居すると体に良くない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140527,
					"content": "ゴホッゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140528,
					"content": "哲平も体をお大事に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "心配しないで、僕はこの通りピンピンしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20140531,
					"content": "まさか、哲平がもう幕府軍の武士と戦えるようになってるとはな。いつの間にか凄く成長したみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}、戻って<color=#00E1FFFF>心海</color>に報告しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140529,
					"content": "哲平も気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "心海、戻ってきたぞ…って、あれ、ゴローもいるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140602,
					"content": "なにかあったのか？なんかすごく真剣な表情だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140603,
					"content": "この異常が発生した人は、どれくらいいるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140604,
					"content": "まだ完全には統計できていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140605,
					"content": "心海、ゴロー、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}、近ごろ抵抗軍の一部兵士たちに、奇妙な老化現象が発生しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140607,
					"content": "彼らを問い詰めたら、裏でこっそり支援者からいくつかの「秘密兵器」を手に入れていたことが発覚した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140608,
					"content": "そいつらはみんな負けん気が強く、目狩り令に対して極度の不満を抱いていたやつらだ。それら秘密兵器を手にした後、こっそり使っていたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140609,
					"content": "どうりで近ごろの戦況が異様に順調だったのですね…しかし、これは決して正しい方法ではありません、一刻も早く禁止しなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140610,
					"content": "ゴロー、彼らの言う「秘密兵器」は手に入れられましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140611,
					"content": "ほとんどのやつらは差し出すことを拒んでいましたが、なんとか一つ手に入れました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140612,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}、これを知っているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20140614,
					"content": "ファデュイの…邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "ということは、支援者の正体はファデュイだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20140616,
					"content": "しかし、なぜファデュイがこのようなことを…",
					"roleType": "TALK_ROLE_NPC",
