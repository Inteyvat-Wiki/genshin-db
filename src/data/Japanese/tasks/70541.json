			},
			"dialogs": [
				{
					"id": 705410101,
					"content": "にゃうー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410102
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705410102,
					"content": "へへっ、橙色騎士もだいぶいい子になったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410103,
					"content": "これからも、心やさしい、いい子でいろよ。みんなと幸せに暮らすんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410104,
					"content": "わ、私もこの子の頭と耳を触ってみたいです…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410105
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410105,
					"content": "暴れていないときは、本当にいい子なんだけど…目の上にある傷は一体どうしたのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410106
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410106,
					"content": "復元ポーションの残留痕跡からして、橙色騎士は恐らくここにいるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410107,
					"content": "ん？旅人とパイモン…それに、シスターロサリア。そちらの方は冒険者かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410108
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410108,
					"content": "どうやら、みんなすでに橙色騎士と友達になったみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410109,
					"content": "わぁ、アルベドじゃないか！？久しぶりだな！会えて嬉しいぜ。その…おまえの探してる場所って、ここで間違いないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410110,
					"content": "調査小隊の隊長さんが動物保護施設を訪ねてくるだなんて、一体どんなご用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410111
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410111,
					"content": "隊長？騎士団の隊長さんなんですか？何の前触れもなしにそんなに偉い方がいらっしゃるなんて…おもてなしの用意が、何も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410112
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410112,
					"content": "いえ、そ、そうじゃなくて…「ネコモコの城」は運営許可も下りた、ちゃんとした施設なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410113
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410113,
					"content": "保護施設の監査だと誤解したヴァレリナは、慌てて騎士団発行の書類を持って来ると、アルベドに「ネコモコの城」の運営目的について一生懸命説明した…\\n彼女は「調査小隊」の名前に度肝を抜かれたようだ。実際には、調査小隊は都市管理関連の仕事は担当していないのだが…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705410114
					]
				},
				{
					"id": 705410114,
					"content": "緊張する必要はないよ。ボクはただ、部下の仕事に手を貸しているだけだ。今回訪ねてきたのは、その猫のためだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410115
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410115,
					"content": "先日、「臨時猫隊員·症例No.3『橙色騎士』」が、世話係の武器官を気絶させ、城門まで逃げたところで、行方が分からなくなっていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410116,
					"content": "「騎士団の紋章を身に着けた、調査小隊所属の大きな猫が城内で騒ぎを起こした」と知られれば、あまりいい影響にはならないだろう？だから、早めに事態を収めたほうがいいと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410117
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410117,
					"content": "にゃー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410118,
						705410119
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705410118,
					"content": "調査小隊の猫だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410120
					]
				},
				{
					"id": 705410120,
					"content": "橙色騎士が調査小隊の騎士を気絶させたのかよ！さっき、こいつの名前の前に、長ったらしい称号みたいなのをつけてたけど…なにか事情でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410121,
					"content": "実は二ヶ月前にも、橙色騎士は野外で迷子になってしまったんだ。その時トリックフラワーの蜜を食べてしまったらしくて、身体が三倍のサイズに膨れ上がってしまってね…ただ、詳しい原因は現時点ではまだ分かっていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410122
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410122,
					"content": "三倍…！？普通のサイズの猫だって、怒り出したらけっこう怖いのに…三倍のサイズって言うと、ヒルチャールにだって襲い掛かれそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410123,
					"content": "そう…道理であんなに緊張してたわけだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410124
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410124,
					"content": "猫にとって…いや、すべての野生生物にとって、身体が大きいことにさほどメリットはないのよ。むしろ、目立ちやすくなるうえ、動きも鈍くなりがちで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410125
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410125,
					"content": "敵にすぐ見つかってしまうという危険に常に晒され、捕獲者に攻撃される頻度も上がることになる。つまり、極度の恐怖の中で生きることになるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410126
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410126,
					"content": "その通りだよ。調査小隊の拠点近くで橙色騎士を見つけたとき、身体は傷だらけで、かなり怯えていた。相当つらい目に遭ってきたんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410127
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410127,
					"content": "そんな…可哀そうに…私、この子に攻撃されたって、もう悲しいなんて思いません。だって、私がもしこの子の立場だったら、きっと見知らぬ人や動物を警戒してたはずですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410128
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410128,
					"content": "いや、既に問題は解決したから、心配しないでくれ。前に、錬金薬の影響を消すことのできる復元ポーションを開発したんだけど、そのポーションで「橙色騎士」を元の姿にかなり近づけることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410129
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410129,
					"content": "普通の猫と比べればまだ大きいけど、少なくとも生活に支障はなくなったし、騎士たちも交代で世話ができるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410130,
					"content": "橙色騎士というのは、クレーがこの子の色に因んで付けてあげた名前だよ。みんなもぴったりの名前だと思って、スカーフまで作ってあげたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410131
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410131,
					"content": "へへっ、示し合わせたわけでもないのに、おんなじ名前を思いつくなんて、オイラたち息ぴったりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410132,
					"content": "にゃーん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410133
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705410133,
					"content": "でも、後遺症かな？橙色騎士は人に会うたび、ひどく緊張して警戒態勢に入るものだから、武器官や信号官たちは毎回大変な目に遭わされていたよ。クレーもしょっちゅう拠点に来られるわけじゃないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410134
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410134,
					"content": "そんなこの子が、二人にこんなに懐くなんてね。小隊のみんなも、この様子を見たらきっと驚くと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410135
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410135,
					"content": "それはもう——偉大なる救世主、栄誉騎士さんとネコネコ白魔法使いさんの手にかかれば！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410136
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410136,
					"content": "どれだけ凶暴だった猫も、二人としばらく一緒に遊べばすぐに大人しくなって、可愛い一面を見せてくれるんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410137
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410137,
					"content": "そうか。なら、旅人とパイモン、橙色騎士を引き取る気はないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410138
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410138,
					"content": "えっ？いいのか？でも、橙色騎士はおまえの小隊の猫隊員なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410139,
					"content": "実は「臨時猫隊員」という肩書きもその場しのぎでつけたものでね。元々、順調に回復したら、責任をもって引き取ってくれる人を探すつもりだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410140
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410140,
					"content": "調査小隊は騎士団の作戦部隊の一つだから、この子にとって理想的な居場所とは言えないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410141
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410141,
					"content": "顔馴染みの騎士が出動するたびに、拠点に残された橙色騎士は不安になってしまうだろうし、かと言って、隊と一緒に行動させれば、再びこの子を恐怖に晒してしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410142
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410142,
					"content": "賢明な判断だと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410143
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410143,
					"content": "一度恐怖に襲われた子は、できるだけ刺激から遠ざけてあげたたほうがいいでしょうね。完全に心が癒えるまで、少しずつトラウマを取り除いてあげないといけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410144
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410144,
					"content": "じゃあ、塵歌壺にあったかい猫ハウスを作って、住んでもらうのはどうだ？あそこなら魔物にいじめられる心配もないし、安心して幸せに暮らせるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410145,
					"content": "にゃおー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410146,
						705410147
					],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705410146,
					"content": "うん！新しいペットは猫で決まり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410148
					]
				},
				{
					"id": 705410148,
					"content": "ホントにありがとな、アルベド！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410149,
					"content": "気にしないでくれ。暇があれば、橙色騎士を連れて拠点に寄ってくれると嬉しい。この子の元気な姿を、調査小隊のみんなにも見せてあげてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410150
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410150,
					"content": "なんて感動的な場面…最高の猫ちゃん引き取りシーンを見届けることができて、本当によかったです。「ネコモコの城」で保護された動物が新しい家族を見つけた、最初の事例ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410151
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410151,
					"content": "ちょっと、私の頭巾で涙を拭わないでよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410152
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410152,
					"content": "ところで、シスターロサリアが動物と交流するのが好きだったとは、少し意外だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410153
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410153,
					"content": "たしかにな。でも、なんとなくだけど…ロサリアには猫に親しまれる、なにかがあるような気がするぞ。本人でさえそれに気づいてないから、表に出てないだけでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410154,
					"content": "雪大福もロサリアに懐いてたし、そのあと橙色騎士がやって来たばかりの時も、ロサリアが落ち着かせてやったんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410155,
					"content": "コホン…私はただ、そばで見ていただけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410156
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410156,
					"content": "私…ひらめいちゃいました、ロサリアさん！この数日間、栄誉騎士さんとネコネコ白魔法使いさんから、猫ちゃんと仲良くなるテクニックを色々教えていただきましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410157
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410157,
					"content": "施設の事前準備期間をもうしばらく延長して、オープン前にひとまず学んだことを実戦してみます！えっと…「見習いネコネコ魔法使い」目指して、頑張ります…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410158
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410158,
					"content": "なので、「ネコモコの城」が正式にオープンしたら、どうか運営を助けていただけませんか？モンド全土の野良猫を一緒に助けてあげましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410159
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410159,
					"content": "ロサリア、引き続きヴァレリナに手を貸してやるだろ？…猫を助ける魔法使いとシスターのコンビ、なかなか良さそうじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410160,
					"content": "…ま、いいわ。特に面倒なこともなくて、結構暇な仕事だし…引き続き傍観するのも悪くなさそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410161
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 705410161,
					"content": "ボクは動物の保護事業に関してはあまり詳しくないけど、どうやら、重要な節目を迎えたみたいだね。おめでとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410162
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410162,
					"content": "困っている野良猫を見かけたらここに連れてくるよう、他の騎士たちにも伝えておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410163
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 705410163,
					"content": "本当に、本当に、ありがとうございます！皆さんにはご用意できる限りの報酬をお渡ししますのでっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410164
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410164,
					"content": "お陰様で、「ネコモコの城」の事前準備も何とかうまくいきそうです。正式にオープンするときは、ぜひ皆さんにテープカットをお願いしますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410165
					],
					"speakerTitle": "ヴァレリナ"
				},
				{
					"id": 705410165,
					"content": "モラもたっぷりもらえたし、橙色騎士も引き取れたし…オイラ、すっごくいい気分だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410166
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410166,
					"content": "「ネコモコの城」がオープンする日が、今から楽しみだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705410167,
					"content": "にゃおーん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「橙色騎士」"
				},
				{
					"id": 705410147,
					"content": "うん！橙色騎士を新居に迎えよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410148
					]
				},
				{
					"id": 705410119,
					"content": "だから騎士団の紋章をつけてたんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410120
					]
				}
			]
		}
	]
