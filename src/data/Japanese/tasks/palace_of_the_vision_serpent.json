			"dialogs": [
				{
					"id": 751340301,
					"content": "ふぅ、やっと終わったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340302,
					"content": "あれを守ってた秘源機兵も大人しくなったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340303,
					"content": "よし、中になにが入ってるか確かめてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340304,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "がっかりさせないでくれよ…えっ？また炎燐石かよ。炎燐石って一つだけじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340306,
					"content": "うーん、待て。炎燐石を包んでたウォーベン、見覚えがあるな…遺跡の外の塔で見つけたあのメモに似てないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340307,
					"content": "キュッ…キュウ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#うわっ、ちょっと不気味だぞ。{REALNAME[ID(2)|SHOWHOST(true)]}もそう思うだろ？{NICKNAME}、なにがかいてるか、さっそく見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340309,
					"content": "へえ、やっぱりあの冒険者が残したメモみたいだぞ。「統律の心」ってここのことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340310,
					"content": "他の可能性もある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "そうか、炎燐石を見つけたのはここだけど、他の場所にもあるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340312,
					"content": "分からないことが多すぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "そうだな。それに、ココウィクはここに炎燐石があるって知ってたから、オイラたちを呼んだってことか？よくわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340314,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "一旦戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "はぁ、そうだな。ココウィクならなにか知ってるはずだ。それになにを見つけても絶対戻って合流するってポーナと約束したしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340317,
					"content": "持って帰って、ポーナに見せよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "はぁ、そうだな。ポーナに見せたらなにか分かるかもしれないぞ。それに、なにを見つけても必ず戻って合流するってポーナと約束したからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340319,
					"content": "早くここを出ようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
