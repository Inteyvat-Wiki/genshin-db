			"dialogs": [
				{
					"id": 751340201,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "うぅ、アビスに侵蝕されてて、いつ落ちてもおかしくないぞ。ココウィクが言ってたのって、あれで間違いないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340203,
					"content": "あの中になにがあるかはわからないけど、きっと祭壇とかじゃないと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340204,
					"content": "「ロジックばっかりに頼ってると…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "あっ、わかったぞ。アビスがいるから、ココウィクがあんなに嫌がってたんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340206,
					"content": "アビスを放っておくわけにはいかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "アビスがいるから、ココウィクがあんなに嫌がってたんだよな。確かに、放っておくわけにはいかないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340208,
					"content": "#行くよ、{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "おい、オイラを仲間外れにするなよな。ひどいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751340211,
					"content": "とにかく、あれを片付けようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
