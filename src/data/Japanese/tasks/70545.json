			"dialogs": [
				{
					"id": 705450101,
					"content": "ニャ、ニャニャ——ニャ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450102,
					"content": "ニャ！ニャニャニャ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "「うさぴょん」"
				},
				{
					"id": 705450103,
					"content": "うん…「うさぴょん」もアンバーも一理あるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450104,
					"content": "ふむふむ、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450105,
					"content": "確かに、そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "実はオイラもよくわかってないけど、アンバーと「うさぴょん」の意見が一致したってのは、はっきり感じたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}にパイモン！来てたんだね！ちょうど会いに行こうと思ってたところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450109,
					"content": "あんたたちが「ネコモコの城」の運営に協力してることは、もうヴァレリナさんから聞いてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450110,
					"content": "#さすが{NICKNAME}、モンドに戻ってすぐこんなに助けてくれるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450111,
					"content": "なんでもこなす栄誉騎士だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "そういえば、アンバーと「うさぴょん」はなにを話してたんだ？なんだか楽しそうだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450114,
					"content": "にゃ、にゃにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "「うさぴょん」"
				},
				{
					"id": 705450115,
					"content": "うん、いま「うさぴょん」に今日の天気を聞いてたの、雨が降るかどうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450116,
					"content": "えっ？猫ってそんなこともできるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450117,
					"content": "へへっ、わたしもリサさんから聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450118,
					"content": "リサさんが読んだ本によると、子猫は湿気に敏感らしいの。しかも、濡れた感覚があまり好きじゃないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450119,
					"content": "だから、空気中の湿気が急激に増加したのを感じたら、焦って不安になって、ずっと顔をクシクシしたり、毛を舐めたりしはじめるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450120,
					"content": "猫たちがそういう行動をしはじめると、大雨が降るかもしれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450121,
					"content": "そんな不思議な関係性があったのか…思わぬところで、変わった知識を学べたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}、今度からオイラたちが旅をする時、猫たちを観察しようぜ。そうしたら…急に降ってくる大雨にいつもびしょ濡れになるなんてことが無くなるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705450123,
					"content": "それなら今後は気をつけておこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "本当はね、今日ヴァレリナさんに聞きたいことがあって来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450126,
					"content": "でもヴァレリナさんと話してたら、この子猫が近づいてきて、私の隣に寝転がって大きなあくびをしたの。すっごくかわいくってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450127,
					"content": "こんなに懐いてくれたんだから…わたしも親しみを持って接したほうがいいと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450128,
					"content": "それで、リサさんが教えてくれたことを思い出して、「うさぴょん」に天気のことを聞いてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450129,
					"content": "でも「うさぴょん」は顔をこすったり、しっぽを振ったり、地面に寝転がってわたしの手をスリスリしたりしてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450130,
					"content": "うーん、結局雨は降るのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 705450124,
					"content": "もともと道端の猫には注目してたよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "モンドの猫を守るのも職務の一つ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "待って、全然わからない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}