			},
			"dialogs": [
				{
					"id": 401030401,
					"content": "親分、また誰か来たみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030402
					],
					"speakerTitle": "リワール"
				},
				{
					"id": 401030402,
					"content": "あのな、俺たちはただ金をもらって働いただけだ。ここまでする必要ねぇだろ…逆恨みもいいとこだ。俺たちを雇ったのはこいつだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030403
					],
					"speakerTitle": "マザール"
				},
				{
					"id": 401030403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030404
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030404,
					"content": "どうしたんだ？おまえら、誰にやられたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030405,
					"content": "お前、あいつらの仲間じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030406
					],
					"speakerTitle": "マザール"
				},
				{
					"id": 401030406,
					"content": "あいつら？誰のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030407,
					"content": "空を飛ぶガキがいてよ、出会い頭にぶん殴ってきやがったんだ。しばらくしたら、今度は緑の服の男が来て、俺たちに質問をしていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030408
					],
					"speakerTitle": "マザール"
				},
				{
					"id": 401030408,
					"content": "事情聴取は終わっています。背後で指揮していたのは、ここにいるサーチェン様の息子、シワニです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030409
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030409,
					"content": "聞きたいことがありましたら、今ここで聞いて頂いても構いません。このあと彼らを全員逮捕して、教令院に連れ戻し尋問します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030410
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030410,
					"content": "どうして人を雇って、サーチェンを拉致しようとしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030411,
					"content": "ふん、決まってるだろ？二十年もの間、あいつはどこで遊んで暮らしてるかもわからなかったんだぞ。僕のことを気にも留めなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030412
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030412,
					"content": "もっとムカついたのは、あいつが事業を教令院に任せたばかりか、それをいつか気に入った天才に譲るだなんて契約をしたことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030413
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030413,
					"content": "あれは本来僕のものだ。なぜ他人に譲らなきゃならない？僕にくれないというなら、あいつから奪ってやるまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030414
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030414,
					"content": "まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030415
					]
				},
				{
					"id": 401030415,
					"content": "そのまさかだ！あいつは、影で試合を観てるって言っただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030416
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030416,
					"content": "だから人を雇ってあいつを拉致して、契約を修正させることにした。教令院が応じてくれないなら、あいつ本人に認めさせればいいだけのことだ。僕がその天才だってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030417
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030417,
					"content": "彼を見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030418
					]
				},
				{
					"id": 401030418,
					"content": "いや。あの老いぼれは隠れるのがうますぎる。今もどこかに隠れて、この笑い話を見物してることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030419
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030419,
					"content": "二十年前の時点で、既にあいつは狂ってると思ってた。狂ったやつは、何でもできるからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030420
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030420,
					"content": "「才識の冠」のことは知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030421
					]
				},
				{
					"id": 401030421,
					"content": "才識の冠？あいつが教令院に寄付した、あの冠のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030422
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030422,
					"content": "あれはなかなか値が張ったな。当時あれを買うために、サーチェンは多くの事業を売り払ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030423
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030423,
					"content": "あれを買ってからというもの、家に幽霊が出るようになったのさ。収蔵室の前を通ると、たまに甲高い話し声が聞こえてくるという具合にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030424
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030424,
					"content": "それに、あの冠を教令院に寄付する以前、サーチェンは部屋に閉じ籠って、連日あれを研究してた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030425
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030425,
					"content": "あの時から既にどうかしてたから、何をしててもおかしいとは思わなかったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030426
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030426,
					"content": "どうかしてたって…どういうことなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030427,
					"content": "あの時は小さかったから、よく覚えてるわけじゃないが。確か砂漠へ調査に出かけて、数年戻ってこなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030428
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030428,
					"content": "ある日やっと帰ってきたと思ったら、まるで人が変わったようになっていた。誰も理解できない言葉をぶつぶつと口にして、昼も夜も論文を書いてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030429
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030429,
					"content": "何を書いてるか覗いてみようとしたけど、追い出されたよ。その後、あいつは書いた論文を持ってもう一度出かけ、帰ってきたのち教令院と契約を結んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030430
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030430,
					"content": "今思い返せば、あれはもう僕の父などではなかったのかもしれない。サーチェンの皮を被った…砂漠から帰ってきた悪魔だったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030431
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030431,
					"content": "怖いこと言うなよ！ゾッとしたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030432,
					"content": "信じるかどうかは君たちの勝手だ。知ってることはすべて話した。ああ、それと一つだけ頼みごとをしたいんだ。もしサーチェンに会うことがあったら、こう伝えてくれ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030433
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030433,
					"content": "あいつが外で何を研究してようが、僕の目に映るあいつは、ただのクソ野郎でしかないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030434
					],
					"speakerTitle": "シワニ"
				},
				{
					"id": 401030434,
					"content": "話は終わりましたか？それでは行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030435
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030435,
					"content": "今回の件の主謀者は逮捕できました。情報提供、ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030436
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030436,
					"content": "まだ、何か心配なことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030437
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030437,
					"content": "「才識の冠」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030438
					]
				},
				{
					"id": 401030438,
					"content": "そうだな。アルハイゼンのメモにも、あの冠のことが書いてあったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030439,
					"content": "アルハイゼン様も、この件に注目していらっしゃるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030440
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030440,
					"content": "一つ考えがあります。冠に問題がありそうなら、主催者に連絡して試合をいったん中止させ、詳しく調べたほうが良いかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030441
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030441,
					"content": "そうだな！それじゃ、さっそくメイン会場に戻って、このことをカリーナに伝えようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4010305,
			"completionStepIds": [
				4010305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010305",
							"2"
