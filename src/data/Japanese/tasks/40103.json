			},
			"dialogs": [
				{
					"id": 401035101,
					"content": "アルハイゼン、ニィロウ。他の参加者を見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401035102,
					"content": "ううん、まだ試合の目標を達成した人はいないよ…どうかした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401035103,
					"content": "あの冠だけど、問題があるかもしれなくて…そうだ。アルハイゼン、おまえもここにいるってことは、なにか知ってるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401035104,
					"content": "何のことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401035105,
					"content": "おまえ——ふんだ！冠を見つけたら、質問責めにしてやるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
