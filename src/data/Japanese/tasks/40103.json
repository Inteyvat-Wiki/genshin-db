					}
				]
			},
			"dialogs": [
				{
					"id": 401030201,
					"content": "いらっしゃいましたか。すみません。犯人の尋問が終わったばかりで、あなたたちにお知らせする時間がありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030202
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030202,
					"content": "なにかわかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030203,
					"content": "何と言いましょうか…予想外のことが多々ありまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030204
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030204,
					"content": "誘拐犯の傭兵を捕まえるのは思ったより簡単でした。適当な者にサーチェン様の格好をさせたところ、しばらくして向こうから食いついてきましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030205
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030205,
					"content": "問題は、これは尋問が終わって分かったことですが…彼らを雇ったのは、なんとサーチェン様の息子だったというのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030206
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030206,
					"content": "子供が人を雇って、父親を拉致しようとしたのか？なんだってそんなことしなきゃいけないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030207,
					"content": "それはなんとも…シティに入った傭兵はごく一部でしたので、多くはまだ外で待機しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030208
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030208,
					"content": "これから人手を集めて、彼らを一網打尽にしに行きます。あなたたちも一緒にいらっしゃいませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030209
					],
					"speakerTitle": "アーラヴ"
				},
				{
					"id": 401030209,
					"content": "いいぞ。ちょうどオイラたちも、どういうことか見に行きたいと思ってたとこなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
