			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401030601,
					"content": "これで、終わったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030602
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030602,
					"content": "カーヴェ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030603,
					"content": "大丈夫？体調はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030604
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401030604,
					"content": "僕は…大丈夫だ…うっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030605
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030605,
					"content": "ありがとう、ティナリ。心配はいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030606
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030606,
					"content": "無理しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030607
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 401030607,
					"content": "カーヴェさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030608
					],
					"speakerTitle": "ニィロウ"
				},
				{
					"id": 401030608,
					"content": "冠はカーヴェ選手によって叩き壊されたが、その前に彼は試合目標を達成した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030609
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030609,
					"content": "ルールに則れば彼が第三ラウンドの勝者であり、合計得点から見ても、今回の学院トーナメントのチャンピオンだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030610
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030610,
					"content": "学院トーナメントのチャンピオンとして、及びサーチェン直々に推挙された継承者として、カーヴェ選手はサーチェンのすべての財産を継承する権利を有する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030611
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030611,
					"content": "それではもう一度聞こう。本当にサーチェンの財産を、すべて寄付するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030612
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030612,
					"content": "さっきも言っただろ。この世界が良くないと言うなら、彼の遺した事業でそれを変えればいいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030613
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030613,
					"content": "単に否定するだけでは何の結果も出せない。僕は彼とは…違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030614
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030614,
					"content": "分かった。書記官として、この件を資料に記録しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030615
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030615,
					"content": "これから財産の具体的な使途については、大会が終わった後に賢者から連絡が行くだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030616
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030616,
					"content": "…ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030617
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030617,
					"content": "僕もあの人の研究が正しかったかどうか分からないし、どうすればあれを完成できるかなんて、尚更分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030618
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030618,
					"content": "ただわかってるのは、すべてをここで止めれば、参加者は誰も苦しんだりしないってことだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030619
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030619,
					"content": "今回が最後のトーナメントってわけじゃない。これからも誰かが、このトーナメントに参加する…未来の学者たちだって、引き続きこのために研鑽を積むだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030620
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030620,
					"content": "でも、サーチェンの話は人々を苦しませるものだ。だから…ここまでにするんだ。これ以上広げちゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030621
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030621,
					"content": "僕たちがみな学者である以上、彼の観点をむやみに否定するのもまた、傲慢な独断だが…大丈夫。この責任は僕が背負えばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030622
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030622,
					"content": "僕にとって、これでよかったんだ。僕にも…これしかできることはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030623
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030624
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030624,
					"content": "よく言った。君は、大半の人々が欲しても実行する勇気のない、正義と理想を述べたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030625
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030625,
					"content": "俺から見れば滑稽であることに変わりはないが、君は自身の問題に気づいている。ただ、プライドがそれを認めることを許さないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030626
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030626,
					"content": "でも、君のその見解は受賞の舞台で発表されるに値する。今大会の開催委員会を代表して、君の優勝を祝福しよう。おめでとう、カーヴェ選手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030627
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401030627,
					"content": "はあ？か、勘違いするなよ。誠意のない賞賛なんかいらない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030628
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030628,
					"content": "それに、今ここは弁論の場じゃない。僕の見解じゃなくて、試合の評論に集中してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030629
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401030629,
					"content": "カーヴェさん、おめでとうございます！授賞式に出る準備をしておいてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニィロウ"
				}
			]
		},
		{
			"id": 4010310,
			"completionStepIds": [
				4010310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
