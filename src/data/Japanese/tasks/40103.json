			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カリーナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401030501,
					"content": "カリーナ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030502,
					"content": "ふぅ…やっと戻られましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030503
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030503,
					"content": "探しましたよ。どちらへ行かれていたんですか？第三ラウンドの試合はもう始まっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030504
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030504,
					"content": "サーチェンを狙った悪いやつを捕まえに行ってきたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030505,
					"content": "いやいや、それはどうでもいいんだ！才識の冠に問題があるかもしれなくて…ちゃんと調べたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401030506,
					"content": "才識の冠に…問題が？そんなはずはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030507
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030507,
					"content": "二十年もの間、試合の度にあの冠を使っていましたが、何の問題もありませんでした。どこからそのような情報を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030508
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030508,
					"content": "#{M#俺}{F#私}たちのちょっとした推理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030509
					]
				},
				{
					"id": 401030509,
					"content": "これはとても重要なことですから、少し考えさせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030510
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030510,
					"content": "実を申しますと、第三ラウンドの試合が開始する前に、才識の冠をマウティーマ稠林に置いてきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030511
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030511,
					"content": "第三ラウンドの試合内容は、まさにマウティーマ稠林で冠を見つけ出し、それを指定された台に置くことです。最初に冠を配置できた人は4ポイントを獲得できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030512
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030512,
					"content": "ここまで参加者の得点に大差がないことを踏まえると、最初に冠を置いた人が、最終的なチャンピオンとなる可能性が高いでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030513
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030513,
					"content": "ですから、今回の試合は激しい戦いになると推測しています。今から向かっても間に合わないかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030514
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030514,
					"content": "それでもやってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030515
					]
				},
				{
					"id": 401030515,
					"content": "冠の位置をマークしますので、直ちに現場へ行って状況を確認してみてください。何事もなければ良いのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030516
					],
					"speakerTitle": "カリーナ"
				},
				{
					"id": 401030516,
					"content": "おう！今すぐ出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4010306,
