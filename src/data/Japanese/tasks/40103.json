			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401031001,
					"content": "ついに…私の財産を受け継ぐ者…私の研究を受け継ぐ者が…現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031002
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031002,
					"content": "さあ、カーヴェ。いい子だ、私のところに来い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031003
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031003,
					"content": "…どうして僕の名前を？あなたは一体誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031004
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401031004,
					"content": "私はサーチェン。もちろん、正確にはサーチェンの意識の欠片の一つに過ぎないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031005
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031005,
					"content": "実に不思議な縁だ…君を見ていると、昔会ったある人を思い出す。だが君の信念は彼より強く、世の辛苦を熟知している。君には、私のすべてを継承する資格がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031006
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031006,
					"content": "子供たちよ、私たちは初めて会うが、これから話すことはとても大事なことだ。ぜひその証人となってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031007
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031007,
					"content": "今回の学院トーナメントにおいて、みな素晴らしい試合を見せてくれた。教令院には多くの奇才がいる。君たち一人ひとりが、全員が特別なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031008
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031008,
					"content": "だが、あえて後継者を一人に絞るとしたら、私は君を選ぶだろう、カーヴェ。君が優勝したからというだけではない。君は私と似ているからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031009
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031009,
					"content": "…あなたが？僕と？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031010
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401031010,
					"content": "そうだ。私たちは共に哀れな理想主義者であり、それこそが私たちの苦しみの源だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031011
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031011,
					"content": "二十八年前、私は砂漠に行き、八年間も暮らした。そこで何を見たと思う？戦争、殺し合い。永遠に終わらないものたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031012
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031012,
					"content": "水源の奪い合い、キャラバンからの略奪、民衆に対する搾取、それらは一日たりとも止むことはなかった。防砂壁の外側の世界は、私の思い描いていたものとは完全に異なっていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031013
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031013,
					"content": "見てきたすべてのものに苦しみを感じた。だからこそ、彼らを救う道を見出したいと切に願ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031014
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031014,
					"content": "それで…答えは見つかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031015
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401031015,
					"content": "私は因論派の学者だ。当然、因論派の知識に答えを求めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031016
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031016,
					"content": "私は歴史を研究し、社会を分析した。人間性に関する実験を数え切れないほど行った。遂には砂漠の奥深くで、「失われた学派」を自称する学者とも接触した——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031017
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031017,
					"content": "そして、答えなど最初から存在しないということに気がついた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031018
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031018,
					"content": "過ちを、簡単に誰かのせいにすることはできない。罪とは人間の性に刻まれたものなのだから。人は争いをもたらし、争いは破滅を導く。これは人間の力では逆らうことのできない、必然なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031019
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031019,
					"content": "如何にして歴史から教訓を得るかを研究してきた。だが皮肉なことに、歴史からは何ひとつ教訓を得られず、すべては悪くなるばかりだという結論にたどり着いた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031020
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031020,
					"content": "学んできたことの意味が分からなくなった。重くのしかかる虚無に私は生きる気力を失い…自らの命を絶つことにしたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031021
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031021,
					"content": "だが偶然にも、私は意識の一部を保存できるこの冠を手に入れた。私は自らの経験をその中に書き込み、教令院に財産を預けることにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031022
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031022,
					"content": "やはり、あなたが教令院と結んだ「契約」は、いわば「遺言」だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031023
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401031023,
					"content": "この世界に絶望したというなら、どうしてまたこんなことをした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031024
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401031024,
					"content": "言った通り、私は数多くの人間性に関する実験を行って来た。これは、その最後の実験だと思ってもらって構わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031025
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031025,
					"content": "教令院なら天才には事欠かないうえ、どの世代にもそれを代表する花形がいる。高額な報酬のもとに、人間性のわだかまりを解き、世界を正しい方向へと導いてくれる者がいつか現れる…そう私は願っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031026
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031026,
					"content": "つまりあなたが欲しがっている継承者は、天才でありながら、常人の苦しみを理解できる人間でなければならないということだな。なぜなら、それが人間性、社会、そして世界に対するより明確な認知につながるからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031027
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401031027,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031028
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401031028,
					"content": "でも、こう考えたことはないか。富は人間の心を麻痺させ、外部の苦しみに対する感覚を失わせる。あなたの財産を継承した理想主義者が、必ずしもその意思を最後まで貫けるとは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031029
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401031029,
					"content": "君は賢いな。だが私にはわかる…君は私の考えを理解できる類の人間ではない——私にとってはこれも実験の一部であり、人間性に対する考察なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031030
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031030,
					"content": "継承者が私の研究で苦しむのか、あるいは偽りの快楽に溺れるのか、どちらにせよ私の研究には進捗がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031031
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031031,
					"content": "私は世界の本質に痛みを感じ、その重苦しい歴史を嘆いた。そして遂行できなかった研究への未練も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031032
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031032,
					"content": "だから、カーヴェ、愛しき子よ…君は私のためにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031033
					],
					"speakerTitle": "サーチェン"
				},
				{
					"id": 401031033,
					"content": "ほ…本当にすべてを僕にくれて、そのうえ好きにしていいと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031034
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401031034,
					"content": "私は自分の目を信じる。冠を戴き、私のためにこの道を最後まで歩んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サーチェン"
				}
			]
		},
