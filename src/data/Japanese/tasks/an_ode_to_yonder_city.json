			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"範二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "最近の芝居は全く理解できん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "範二"
				},
				{
					"id": 718090302,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "旅人か。「和裕茶館」でいくつか新しい芝居が始まったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "範二"
				},
				{
					"id": 718090304,
					"content": "最近の劇は…賑やかだけど私にはさっぱり。若い人たちは好きみたいだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "範二"
				},
				{
					"id": 718090305,
					"content": "それでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "うーん…もちろん私からしたら古い芝居の方が良い、長年観てきたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "範二"
				},
				{
					"id": 718090307,
					"content": "しかし、今の璃月港は色々変化している。新しい劇が出来てもそれはそれで良いと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "範二"
				},
				{
					"id": 718090308,
					"content": "まあ、変化が速すぎて古い劇はさっぱり無くなってしまったけどね。きっと岩王帝君も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "範二"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
