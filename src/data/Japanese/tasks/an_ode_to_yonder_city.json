			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "収穫はあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090402,
					"content": "かなり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "では聞こうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090404,
					"content": "南埠頭には犬がたくさんいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "ほう、なるほど、生活感があるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090406,
					"content": "不卜廬の近くにヤマガラがたくさんいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "ヤマガラ、ふむ…縁起がいい、詩にはぴったりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090408,
					"content": "食べることだけ関心がある人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "それも間違ってない、食べるのは最も重要なことだからね。特に…この璃月港では。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090410,
					"content": "中々興味深い。メモしておこう、詩に使えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090411,
					"content": "変化が速すぎるという人もいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "ふむ…そう思う人がいてもおかしくない。今の璃月港は目まぐるしい変化を遂げている。私ですらついていけない時がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090413,
					"content": "しかしこの話題は大きすぎる、今はメモだけしておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090414,
					"content": "これで十分だ、やはり君に頼んで間違いなかったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090415,
					"content": "これで私の次の詩集も、何本か新作を入れられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090416,
					"content": "そうだ、報酬以外にこれを…感謝の気持ちとして受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 718090417,
					"content": "次の詩集が出版したら、このサインを使って一冊引換ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
