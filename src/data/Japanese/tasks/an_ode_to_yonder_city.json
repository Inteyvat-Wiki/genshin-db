			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "よしよし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "浩"
				},
				{
					"id": 718090202,
					"content": "何かいいことあった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "あ、旅人か。この前、城内で大事件があっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "浩"
				},
				{
					"id": 718090204,
					"content": "あれ以来他に大事も起きてないから悪くはない。それよりも…飯屋が普段通りに開いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "浩"
				},
				{
					"id": 718090205,
					"content": "もしそうでなかったら、美味しいものも食べられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "浩"
				},
				{
					"id": 718090206,
					"content": "食べ物の話か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "食べ物を甘く見るな。一つの地域の良し悪しを決める最も簡単な方法は、その地域の食べ物の質を見ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "浩"
				},
				{
					"id": 718090208,
					"content": "あ…こんなこと言ってるうちにお腹が空いてきた、何か食べないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浩"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
