			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャタピラー",
					"ミトゥル"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "ミトゥル、大丈夫ですか？閉じ込められてから、まださほど経っていませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330402,
					"content": "おお、救世主よ！来てくれたか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330403,
					"content": "で、コブレンツは？一緒じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330404,
					"content": "あなたがここに閉じ込められていることは彼から聞いたんです——それで助けてくれと。ただ…途中で看守の邪魔が入り、彼は離れざるを得なくなり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330405,
					"content": "はぁ、コブレンツが信頼できるやつじゃないってことは知ってたさ！きっと怖気づいて、後ろめたさから逃げ出したんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330406,
					"content": "商売をするには、それなりの度胸がなきゃ利益は出せない、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330407,
					"content": "やつの不器用さはともかく、優柔不断なところがな……今がどんな状況だか分かるか？「純潔の水」どころか、フォンタまで入ってきた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330408,
					"content": "フォンタが入ってきたら、オレたちが生き残る道なんてないだろ。そう思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330409,
					"content": "えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330410,
					"content": "なんだ、お前たちもフォンタが好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330411,
					"content": "#{M#君}{F#あなた}は好きじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "もちろん好きさ！だからこそ、とても手ごわい競争相手だと認めてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330415,
					"content": "まあ、雑談はここまでにしよう。コブレンツとケリをつけなきゃならないしな。そうだ、あいつは報酬を払ってないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330416,
					"content": "確かに払ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330417,
					"content": "…たまにあいつをバケツに詰めて、きっちり反省させてやりたくなるよ。とにかく——ほら、この特別許可券を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330418,
					"content": "#これは、{NICKNAME}とパイモンが受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330419,
					"content": "えっ？全部オイラたちがもらっていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330420,
					"content": "もちろんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330421,
					"content": "へへっ。じゃあ、全部もらっちゃうぞ。あとでラグ＆ボーンショップにいいものがないか、見に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330422,
					"content": "そうだ。迷惑をかけた詫びといっちゃなんだが、この新鮮な健康ドリンクを何本かあげよう。ぜひ飲んでみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330423,
					"content": "新鮮な…健康ドリンク？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330424,
					"content": "ああ、「純潔の水」より全然ヘルシーだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330425,
					"content": "じゃあ、一杯もらおうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "（おい！キャタピラーがさっき忠告してただろ。飲まないほうがいいぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330427,
					"content": "#{NICKNAME}の言ったことは忘れてくれ！ここに来る前にオイラたち…その、飲み物をたくさん飲んできたからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330431,
					"content": "本当に残念だなぁ～、こんな素晴らしい健康ドリンクが飲めないなんて。また今度、試させてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330432,
					"content": "そっか、そいつは残念だ。分かった、また今度オレのところに来てくれ。必ずごちそうしてやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330433,
					"content": "じゃあ、先に失礼させてもらおう。コブレンツのやつを探しに行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330434,
					"content": "ボクも他に用事があるので、ここで失礼します。特別許可券については、どうか気にしないでください。<color=#00E1FFFF>手がかりが見つかったら、黒板</color>に貼ります。また会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740330435,
					"content": "おう、またな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330428,
					"content": "フォンタをお願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "あるにはあるが…なんだ？オレの健康ドリンクじゃダメなのか？これはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "ミトゥル"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME}はそういう意味で言ったんじゃないぞ！ただ…ここに来る前にオイラたち、飲み物をたくさん飲んできたんだ。だから、今はもう入らなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740330413,
					"content": "まあまあかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "ほう…？いいセンスしてるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "ミトゥル"
				}
			]
		}
	]
}