					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "っ、いたたっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010502,
					"content": "ありがとう、戻れないかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010503,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "ああ、かすり傷だよ…うっ！か、かすり傷だから問題ないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010505,
					"content": "ヒルチャールがこの先にある拠点に集まっているのに気付いて、何かまずいと思って尾行したんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010506,
					"content": "…近付きすぎたせいで、気付かれてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010507,
					"content": "僕のことよりも、この先にいるヒルチャールを倒してほしいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010508,
					"content": "どんどん数が増えていて、きっと何かを企んでるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010509,
					"content": "僕は…僕はちゃんと自分自身を守るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
