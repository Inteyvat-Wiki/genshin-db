			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "もうあの拠点を片付いたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010602,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "さすが君、強いなぁ。僕も君みたいに優秀だったらいいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010604,
					"content": "僕も悪龍を倒し、世界を救う伝説を残したんだ。結局ヒルチャールにすら勝てないけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010605,
					"content": "あのさ…すごく申し訳ないけど、君に頼みたいことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010606,
					"content": "実は今回僕が千風の神殿を調査しに来たのは、もうすぐ「冒険ランク評定」だからだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010607,
					"content": "このタイミングで実力を見せることができたら、きっと評定もスムーズにいくと思ったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010608,
					"content": "まさか実力を見せるどころか、怪我してしまうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010609,
					"content": "た、頼む！僕の惨状をサイリュスさんに言わないでもらえないかな？「冒険ランク評定」に響いたらまずいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010610,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "ありがとう！これからはちゃんと気を付けるようにするよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010612,
					"content": "それはよくないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "よくないのは分かってるし、「冒険者は自分に正直にいるべき」ってサイリュスさんもよく言うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 206010614,
					"content": "でも…はあ、いいや、サイリュスさんが本気で怒らないといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
		},
