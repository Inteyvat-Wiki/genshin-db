	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガルシア",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "た、旅人くん！いいところに来た！ジャーヤくんとコーヒーを飲んで、仕事に戻ろうとしていたところだ。紹介しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170102,
					"content": "前に言っていた人ね？会えて嬉しいわ。私はジャーヤ、一介の…うーん…ダンサーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230170104,
					"content": "初めまして。噂はガルシアさんからかねがね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "ふふ、そうなの？それは何よりだわ。彼ったら機械と…路通のことしか頭にないと思っていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230170106,
					"content": "僕のことは除いてもらって結構ですよ、お嬢さん。ガルシア先生もその方が喜ぶと思いますし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170107,
					"content": "それはダメよ。あなたがいなければ、ガルシアはきっと最後の一枚までお金を使い切ってしまうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230170108,
					"content": "それには賛同しかねますね、お嬢さん。ガルシア先生は、何があってもコーヒー二杯分のお金は死守するんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170109,
					"content": "3杯分だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170110,
					"content": "その柔軟な思いやりの心には、いつも驚かされますよ。ガルシア先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170111,
					"content": "ほ、本題に戻ろう！旅人くん、俺はまだ宝盗団の持っている鴉マークを集めてるんだ。もし見つけたら、俺に売ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170112,
					"content": "俺も最近…金を稼いだからな。報酬については心配無用だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		},
