				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "うーん…まあ、これだけ鴉マークがあれば実験ができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170302,
					"content": "これは報酬だ、受け取ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170303,
					"content": "旅人くん、なんだね？その表情は。そんなに見つめられると照れてしまうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230170304,
					"content": "ゴホン！おっと、仕事に行かなければ。そうそう、今すぐ行かなければならんのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		},
