			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジャーヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "あら？んー…何か聞きたいことでも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175002,
					"content": "どうやってガルシアさんと知り合ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "ずいぶんストレートね？それが冒険者のスタイルかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175004,
					"content": "ガルシアと知り合ったのは…私の劇団の団長が、彼を帳簿整理に雇ったからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175005,
					"content": "アハハ…正直、あんなに劇団の雰囲気に合わない人、初めて見たわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175006,
					"content": "私たちが演奏して、踊って、お酒を飲んで、歌を歌ってる間、彼と路通は端っこで黙々と計算をしてるわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175007,
					"content": "ある日、彼が変な服を着ていることに気づいたの。その服には何かの図案が描いてあるみたいだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175008,
					"content": "興味があったから、何の図案か聞いてみたの。そしたら彼、これは機械の設計図だっていうのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175009,
					"content": "服に描いたのは、外でその機械について議論していた時、紙とペンが見つからなかったからで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175010,
					"content": "だから彼は、炭で直接自分の服に図を描いて説明したんですって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175011,
					"content": "その後、私たちは彼の洗えてない服と機械について、ずっと話してたわ。もちろん、ほとんどの時間は彼がしゃべって、私が聞いていたんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 230175012,
					"content": "ふふ、本当におかしな人よね。でも同時に…そう、魅力的な人でもあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャーヤ"
				}
			]
		},
