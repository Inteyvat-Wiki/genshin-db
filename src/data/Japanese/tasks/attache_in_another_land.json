			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"範兵衛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "この店のキノコは質が良さそうだ。調達リストに載せておこう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020102,
					"content": "範兵衛？なんか、聞いたことのある名前だぞ？どこかで誰かが話してたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020103,
					"content": "も、もしかしてこの前のたたら砂の…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "うわあ！グズグズ事務仕事をやって、「御影炉心」をめちゃくちゃにしたヤツじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020106,
					"content": "「遠国御用」として来たんだと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "アイツ、本当にスメールに来てたのか？あの「遠国御用」ってのは冗談だと思ってたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020109,
					"content": "おや？金髪の…それに、隣でふわふわ浮いてるチビ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020110,
					"content": "あなたはもしや、あの「旅人」殿では？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020111,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "おお、やはりそうでしたか。陽介が手紙に書いておりました。あなたがグザヴィエさんと一緒に「御影炉心」を修理してくださったと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020115,
					"content": "いやはや、お恥ずかしながら、あなたとグザヴィエさんが「御影炉心」を修理していたとき、私は事務処理で手が放せませんで……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020116,
					"content": "事務処理って「御影炉心」より大事なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "仕事の優先が完全に間違ってる…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020118,
					"content": "何をおっしゃいますやら。事務処理をきちんとしなければ、「御影炉心」の修理だって順序よく進められないのですよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020119,
					"content": "ほら、周りの人たちを避難させ、修理物資を準備し、修理要員を動員し、各方面の生産需要を調整しなければならないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020120,
					"content": "事務方の支えがなければ、大混乱に陥ってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020121,
					"content": "やっぱり虎之助の言った通り…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "評判通りだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020123,
					"content": "虎之助…あの方は、事務手続きをまるで気にかけない人でして。一緒に仕事をすると、いつも余計な仕事が増えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020124,
					"content": "しかし、私はもう「御影炉心」の担当ではありません。今はスメールで「遠国御用」として、キノコ貿易を管理しておりまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020125,
					"content": "ふむ…旅人殿の功績は陽介から聞いております。とても信頼できる方だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020126,
					"content": "よろしければ、ひとつお手伝いをお願いできませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020127,
					"content": "信頼のおける、安定したキノコの仕入れ先を探していまして。ここでたくさん店を訪ねたのですが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020128,
					"content": "彼らが持ってきてくれた見本のキノコは、わざわざ選りすぐられたであろう、お行儀の良い品ばかりでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020129,
					"content": "ですからその産地に行き、直に品質を確かめて、実際に納品される商品の質を評価すべきだと思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020130,
					"content": "しかしご覧のように、私は野外で実地調査をした経験がありません。一人で森に入れば、危険のほうが大きいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020131,
					"content": "そこで、代わりに森へキノコを採集に行っていただきたいのです。いかがでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020132,
					"content": "だめじゃないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "おお、引き受けてくださいますか？助かります！報酬のことはご心配なく、既に書類を用意してあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020135,
					"content": "こちらをご覧ください。ええ、まずはこの書類を。これが雇用契約で、報酬の計算方法も記してあります。こちらが義務の告知と秘密保持契約です。そうそう、キノコの産地の地図もございまして……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020136,
					"content": "範兵衛と一緒にすべての書類を細かく確認して、へとへとになった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "はい、これですべての書類の説明をいたしました。先に幕府に報告いたしますので、受理されるのを待って、正式な雇用関係を結びましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020138,
					"content": "ですがその前に、ひとまず私が自腹で報酬を支払います。なにしろキノコの仕入れを、遅らせるわけにはいきませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020139,
					"content": "もちろん、この件も文書にまとめて幕府に届け出ます。あなたの報酬も税務上、申告が必要ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020140,
					"content": "と、とりあえず、キノコ狩りに行ってくる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "あ、はあ…左様ですか。ではお願いします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020142,
					"content": "もう面倒事には巻き込まれないだろうな？オイラ心配になってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020143,
					"content": "彼をしっかり見張っておける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "そうとも言えるな…わかったよ、それも一理あるかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020147,
					"content": "おや？何だか私を信じていないような表情ですね…ご安心ください。私の準備は完璧です。この段取りなら決して、問題は起きませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "範兵衛"
				},
				{
					"id": 230020148,
					"content": "まさにそういうところが心配なんだぞ！…はあ、とにかく森に行って、キノコを採って来てやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020145,
					"content": "…次にどんな騒ぎを起こすのか見たい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "おい！もし本当に騒ぎになったら、オイラたちだけでどうにかしないといけないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020133,
					"content": "先に報酬の話をしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "こっちはパイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "オイラはパイモンだ！「ふわふわ浮いてるチビ」じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230020107,
					"content": "たしかキノコ貿易の管理に「栄転」した…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "虎之助と陽介が言ってた例の…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
