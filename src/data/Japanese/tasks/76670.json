			"trigger": {
				"objectNames": [
					"リーリキ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "リーリキ、最近の様子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766700102,
					"content": "あっ！ラウマ様、こんにちは。すべて上手くいっております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700103,
					"content": "食材の調達も順調で、ちょっかいを出してくる人もいません。それに私の料理の腕も、いくらか上がりました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700104,
					"content": "そういえば、この前おっしゃっていたお友達というのは…あの動物たちのことですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700105,
					"content": "とってもいい子たちで、ずっとそこで見守ってくれているんです。ただ餌をあげてみたんですが、ぜんぜん食べようとしなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700106,
					"content": "忠実に責務を果たしておるのだ。仕事中は集中しなくてはならない、そうであろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766700107,
					"content": "だが、仕事が終わったら少しぐらい甘やかしてくれて構わない。ふふ、きっと喜んでくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766700108,
					"content": "なるほど！では、今日はごちそうを作ってちゃんと礼を言わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700109,
					"content": "ご苦労さま、リーリキ。人手がいるなら、私も手を貸そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766700110,
					"content": "そんな、人手は十分です！カントールさんとヤフォダさんにも手伝ってもらっていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700111,
					"content": "そうか。ではこれ以上邪魔はしないでおこう。また会おう、リーリキ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766700112,
					"content": "はい、これから次の食事を出してきます…そうだ、ラウマ様、よろしければ、一ついかがですか？作り立てでとても美味しいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 766700113,
					"content": "よし、あとは盛り付けて…あれ、お皿は？さっき洗ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーリキ"
				}
			]
		}
	]
}