							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "あの二人だ、楽しそうに遊んでるぞ。心配はいらなかったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413410702,
					"content": "でもあの雰囲気は…邪魔しない方がいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 413410703,
					"content": "気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "羽のお父さんに花冠を作ったら、体も良くなるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410706,
					"content": "分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410707,
					"content": "本には、楽しく生活すれば、病気も良くなるって書いてあったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410708,
					"content": "羽のお父さんもきっと、モンモンがお店の手伝いをしてくれて、とても嬉しく思ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410709,
					"content": "でも、父さんは時々僕に言うんだ…「店にばっかいないで、外で遊べ」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410710,
					"content": "「モンモンにつきあってあげないと、周囲の花を全部摘まれるぞ」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410711,
					"content": "ここの花はまだたくさんあるから、そんなことないもん…ちょっと待ってて、今花冠を作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410712,
					"content": "ありがとうモンモン、そろそろ帰ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410713,
					"content": "分かった…お父さんの体が良くなったら、羽も遊ぶ時間が増えるよね？その時は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410714,
					"content": "うん、父さんの体はきっと良くなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410715,
					"content": "#あれ！？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…い、いつからいたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410716,
					"content": "今来たところ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "ううぅ…僕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410719,
					"content": "海灯祭楽しんで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}も、海灯祭楽しんでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410721
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410721,
					"content": "た…楽しんで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410722
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410722,
					"content": "その、手伝ってくれてありがとう。これどうぞ。人に手伝ってもらったら、お礼をあげるべきだって父さんから言われてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410723
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410723,
					"content": "じゃあ…僕たち店に戻るね。行こう、モンモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410724
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410724,
					"content": "#うん、帰ろう。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ありがとう。",
