			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#この霄灯、本当に綺麗だね。ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410402,
					"content": "じゃあ羽…遊びに行こうよ。モンモンね、花がとても綺麗な場所を知ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410403,
					"content": "#さっき{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}が霄灯作りを教えてくれたの。だからその場所に行ったら、羽にも教えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410404,
					"content": "それは…できないよ。お店の掃除もやらないといけないんだ。お客さんは少ないけど、店はいつも綺麗にしなきゃって父さんに言われてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410405,
					"content": "じゃ、じゃあ霄灯作りはやめて、お話しよう？すぐ終わるから大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410406,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410407,
					"content": "店の掃除を手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "えっ？いいの？ほ、本当にありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410410,
					"content": "ちょっとだけだから、すぐ終わるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410411,
					"content": "#じゃあお願いね。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410408,
					"content": "掃除は任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
