				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "霄灯作りって難しいなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、霄灯は作れる？モンモンよく分かんない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410104,
					"content": "通したりひっくり返したりすると、材料が壊れちゃったり、線が折れちゃったりするの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410105,
					"content": "モンモン、霄灯を作って羽に送りたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410106,
					"content": "羽はいつも店番をしてるから、遊ぶ時間も霄灯を作る時間もないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410107,
					"content": "でも羽にもきっと願い事はあるよね。だからモンモンが霄灯を作ってあげたいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410108,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "でも、モンモン自分が作ったのを羽にあげたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410111,
					"content": "それに、霄灯を作るコツを覚えて、羽にも教えてあげたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、モンモンに…霄灯作りを教えてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410113,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410115,
					"content": "これで霄灯が…できたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410116,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！早くこの霄灯を羽にあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410109,
					"content": "一つ作ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
