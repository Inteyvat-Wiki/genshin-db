			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "お、お客さん、いらっしゃいませ！その…おかけになって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410203,
					"content": "霄灯を渡しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "霄灯を…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410205,
					"content": "羽、この霄灯あげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410206,
					"content": "モンモン？えっ、この霄灯はモンモンが作ったの？あ、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410207,
					"content": "#この{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}が教えてくれたの、あまりよくできてないけど…気にいってくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "モンモン"
				},
				{
					"id": 413410208,
					"content": "すごく良くできてるよ！ちょうど、霄灯を作る時間がなくて悩んでたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410209,
					"content": "ありがとう、モンモン！あとで他の人に頼んでこの霄灯を門に掛けるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410210,
					"content": "どうして他の人に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "それは…父さんは体が弱くて…霄灯を掛けに来られないんだ。僕は背が低いから、届かないと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410213,
					"content": "だから、霄灯を掛けるためには、他の人に手伝ってもらうしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "羽"
				},
				{
					"id": 413410214,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "手伝ってくれるの？ありがとう！ここを離れられないから、他の人を呼ぶのも難しかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羽"
				},
				{
					"id": 413410215,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "お家の人は掛けてくれないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
