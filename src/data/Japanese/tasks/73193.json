			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サバーフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "草元素の力が使えたのですか？まさか、神の目の所有者に出会えるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930902,
					"content": "久しぶりにこういう方にお会いしたので、懐かしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930903,
					"content": "なあなあサバーフさん！これでいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731930904,
					"content": "ええ、草元素の力を直接与えれば、すぐ芽生えることでしょう。少し待ちましょう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930905,
					"content": "ゆっくりと、弱々しい芽が土から萌え出た。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "いくつかの葉っぱが生えた後、幼芽は成長しなくなった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#わぁ、生えたぞ！フフン、言っただろ。{NICKNAME}はな、なんでも上手くできるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 731930908,
					"content": "すぐに効果が出ましたね。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930909,
					"content": "花を咲かせられなくて残念だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "いえ、しょうがないことですから…急いでも仕方ありませんわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930911,
					"content": "植物は芽吹き、枝分かれして、蕾をつけ、開花しなければなりません。こんなに早く芽生えさせられたのは、それだけですごいことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930912,
					"content": "ローズにもう少し時間をください。ちゃんと養分を吸収させてから咲かせた方がいいと思いますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930913,
					"content": "それに、今日はもう十分助けていただきました。これ以上ご迷惑をおかけできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "サバーフ"
				},
				{
					"id": 731930914,
					"content": "暇な時に、見に来てくださると嬉しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サバーフ"
				}
			]
		}
	]
}