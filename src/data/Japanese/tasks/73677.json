			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エドモンド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736770101,
					"content": "狩人さん、お願いします。僕も連れてってください！絶対役に立つからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770102
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770102,
					"content": "おい、落ち着けって！今はイノシシ狩りの人手を集めてるんだぞ。狩りの経験がないお前を雇えないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770103
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770103,
					"content": "はぁ…どうしよう。僕の…僕の論文はイノシシと共に林に消え去るしかないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770104
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770104,
					"content": "二人して暗い顔して、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770105,
					"content": "おや、これは噂の旅人じゃないか。学生の兄ちゃん、元気出せって。この人ならいい方法があるかもしれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770106,
						736770108
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770106,
					"content": "何だか面倒な予感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770107
					]
				},
				{
					"id": 736770107,
					"content": "はは、そう言うなって。モンドの栄誉騎士は腕もさることながら、人助けも得意だって有名なんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770110
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770110,
					"content": "オイラたちになにしてほしいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770111,
					"content": "実は最近、イノシシの出没が頻繁になって、狩人の人手が不足してるんだ。それで、イノシシ狩りのボランティアを募集してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770112
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770112,
					"content": "このスメールから来た学生の兄ちゃんも参加したいって言ってるんだが、腕や脚が細すぎて、うちの募集基準を満たしてなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770113
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770113,
					"content": "うーん、おまえは学生だろ？どうして狩りに参加したいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770133,
					"content": "#イノシシはまるまるして可愛いけど、突進されたら大変だぞ。{NICKNAME}みたいな腕前がないなら、試さないほうがいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770114,
					"content": "それはもちろん分かってる。でも、この辺りに伝説の生物が出たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770115
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770115,
					"content": "まてまて、「伝説の生物」ってなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770116,
					"content": "ああ、多分何日か前に俺が見つけた、白い鬣のイノシシのことだろ。さっきこいつと話してた時に言っちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770117
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770117,
					"content": "でも、確かにあんなイノシシは今まで見たことがないけど、本当にそこまで特別なことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770118
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770118,
					"content": "もちろん！僕の知る限り、君が目撃したあの種のイノシシは、百年前に絶滅した「雪のイノシシ」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770119
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770119,
					"content": "最近、ドラゴンスパインでこいつらの痕跡を見つけたって、ある冒険者たちが言ってるんだけど…目撃報告があやふやで、業界はまだそれを信用していないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770120
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770120,
					"content": "実を言うと、僕はスメール教令院の生論派の学生なんだ。最近は論文のテーマがなかなか決まらなくて、気分転換にブリーズブリュー祭に来てみた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770121
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770121,
					"content": "もし雪のイノシシが生存している確実な証拠を見つけることができれば、それはとんでもない学術的な重大発見になるから、僕の卒業論文もスラスラ書けるってわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770122
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770122,
					"content": "#なるほどな。{NICKNAME}、なんだか、これまで出会った教令院のやつって、みんなこういう悩みを抱えてるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736770123,
					"content": "学業は重要だが、体がすべてなんだぞ。学生の兄ちゃんの身の安全を考えたら、俺たちはこいつを連れてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770134
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770134,
					"content": "旅人、こいつの代わりに、狩りのチームに参加してやってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770124
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770124,
					"content": "でも、もしお前のようなベテランが加われば、イノシシ狩りの効率も大幅に向上するだろ。そしたらみんなもこいつのために雪のイノシシの痕跡を探す余裕ができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770125
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770125,
					"content": "ほ、本当かい？安心してくれ。僕の研究経費は結構充実してるから、みんなが満足する報酬を必ず渡せるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770126,
						736770127
					],
					"speakerTitle": "ファーラビ"
				},
				{
					"id": 736770126,
					"content": "いいよ。科学研究のためにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770128
					]
				},
				{
					"id": 736770128,
					"content": "よし、決まりだな！旅人、すぐイノシシ狩りに出発するぞ。この間は、あそこで雪のイノシシを見たんだ。お前も一緒に来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770129
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770129,
					"content": "よく使う狩りの道具を林に置いてあるから、ついでに道具の使い方も教えてやるよ。準備が出来たら、出発するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770130,
						736770131
					],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770130,
					"content": "準備できた。行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736770131,
					"content": "もうちょっと準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770132
					]
				},
				{
					"id": 736770132,
					"content": "ああ。準備ができたら俺のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エドモンド"
				},
				{
					"id": 736770127,
					"content": "わかった。研究経費のためにね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770128
					]
				},
				{
					"id": 736770108,
					"content": "#{M#俺}{F#私}の出番みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736770109
					]
				},
				{
					"id": 736770109,
					"content": "はは、さすがモンドの栄誉騎士、腕がいいのはもちろん、人助けも得意なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736770110
					],
					"speakerTitle": "エドモンド"
				}
			]
		}
	]
}