			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "変わった岩について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "変わった岩の写真を撮ったって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500603,
					"content": "ぜひ見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500604,
					"content": "これ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "おっと、この写真！さすがフォンテーヌで作られた新たな機種で撮ったものだな、はっきり映っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500606,
					"content": "前にテスト機を購入したことがあるが、ぼやける写真しか撮れないし、それに一台の写真機を運ぶには二人も必要だ。だから、最後は教令院に置かれて埃をかぶっているだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500607,
					"content": "埃をかぶる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "そうだよ、俺の一回の食事代だぞ。うん…どうやら新たな機械を購入する必要があるだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500610,
					"content": "話が逸れてしまったな、どれどれ、この石は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500611,
					"content": "うん、これは化石だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500612,
					"content": "化石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "そう、それに海洋生物がたくさんいる…面白いよ。璃月には…「林も田野も、広々とした海に呑まれていた」という言葉がある？これのことを言っているのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500614,
					"content": "層岩巨淵に化石があるということは、これらの生物はかつて短い時間内に地下に埋められたことだ。そのため、骨格がこんな完全に保たれるのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500615,
					"content": "そういえば、ここで地震がよく起きるそうだ…これで説明がつくよ、活発な地質活動は化石が形成される必要な条件の一つだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500616,
					"content": "この地域の古生物の類群の研究に非常に役に立つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500617,
					"content": "でも一枚だけじゃ足りないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500619,
					"content": "もしまたこのような化石を発見できたら、写真を撮ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500620,
					"content": "何枚撮ればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "そうだな、レポートに使うものだから、似た写真は4、5枚あれば十分なはずだ…それじゃあ5枚にしよう。似たような化石の写真を5枚撮ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500622,
					"content": "適正価格で買い取るよ…これは大発見だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500608,
					"content": "ちょっともったいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
