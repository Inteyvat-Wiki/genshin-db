		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "いいね、なかなかお目にかかれない良い写真だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500903,
					"content": "これらの写真があれば、探検隊にかかった費用の元も取れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500904,
					"content": "ほら、これなんかは太古の海洋生物の骨格だ。形もはっきりしているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500905,
					"content": "これは、層岩巨淵が形成される前、実はここが海であったことを証明している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500906,
					"content": "残念だな。もしここがスメールだったら、こんな化石を見つけたら、そのまま教令院に運んで研究できるのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500907,
					"content": "次の総務司との打ち合わせで相談するとしよう。こちらで人を雇って保護してもらってもいいから、とにかく注意して扱わなければならないんだ。鉱夫たちに叩かれて壊れたりなんかしたら大変だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500908,
					"content": "だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500909,
					"content": "だが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "かろうじて写真は足りるだろうが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500912,
					"content": "前にも言っただろう。このように状態がよく、形も完全な化石の形成には条件がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500913,
					"content": "それは、すぐ土の中に埋められた、と言うことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500914,
					"content": "層岩巨淵の化石は基本的に、ある決まった高さのエリアにしか存在しない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500918,
					"content": "決まった高さ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "おっと、地質学的目線から見れば、この程度の差は無視できるものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500915,
					"content": "それは化石がごく僅かな時間で、しかもかなり近い期間内に形成された証拠だ…そしてその非常に短い期間に、生態上の大きな変化が起こったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500916,
					"content": "例えば、巨大な衝撃によって…とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500917,
					"content": "うーん、層岩巨淵に一体何が起きたのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710500919,
					"content": "上下の高さの差はかなり大きいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "もしかして、写真が足りない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
