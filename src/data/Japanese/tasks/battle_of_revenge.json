			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「海乱鬼」頭領"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "お前は？はははっ、あの時の小僧じゃないか？なんだ、また収集品を贈りに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040302,
					"content": "武器を取り戻しに来た！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040303,
					"content": "ふむ…根性だけは少しあると見た、悪くない。だが、たった一人の助っ人を連れてまたここに来るなんて、俺をバカにしてるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040304,
					"content": "まあ、その根性に免じてチャンスをやろう。来い！場所を移そうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040305,
					"content": "だが…手下たちに何もさせないのもよくない。助っ人を連れてきたんだろ？そいつに手下たちと遊んでもらおうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040306,
					"content": "いつでもいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "はははっ、言うじゃないか。野郎ども、よく聞け…こいつに痛い目を見せてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040309,
					"content": "お前は、俺と一緒に来てもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040310,
					"content": "ではお任せします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040311,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "ありがとうございます。すぐに倒してあなたの援護に回りますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040313,
					"content": "大口を叩くのはいいが、本当に俺を斬れるかどうか、やってみるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「海乱鬼」頭領"
				},
				{
					"id": 728040307,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を楽しませて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "その様子からして、やはりあの海乱鬼たちはあなたの足元にも及びませんでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040407,
					"content": "そっちも勝ったみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "はい、ですが、お恥ずかしながら…最後は一槍突き刺しただけで逃げられてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040409,
					"content": "ですが彼も大怪我を負っていたので、もう何年かは騒ぎを起こせないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040410,
					"content": "それに何よりも、この手で彼を打ち負かし、武器を取り戻せました。完全に雪辱を果たせましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040411,
					"content": "おめでとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "本当にありがとうございました！ですが、まだ気を緩めるわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040413,
					"content": "すべての起因は、私の実力不足によるもの。これからも訓練に励み、実力を磨いていくつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040414,
					"content": "ですので…これからも訓練の相手をしてもらえると幸いです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040415,
					"content": "あっ、それと、これを受け取ってください。多くはありませんが…感謝の気持ちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040416,
					"content": "本当にありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		}
	]
}