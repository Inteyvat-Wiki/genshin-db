				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "ぐぁっ！やめてくれ！い、一体どこからそんな助っ人を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040207,
					"content": "悪党め！今すぐ私の武器を返せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040208,
					"content": "ま、まだあの武器のことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040209,
					"content": "私は武器を取り返しに来ただけだ。あの武器がどこにあるのか言え。そうすれば、命だけは見逃してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040210,
					"content": "くぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040211,
					"content": "これ以上言っても時間の無駄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "うぐっ！お助けを！別に話さないとは言ってないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040214,
					"content": "あ…あの武器は、親分の収集品になってる。もし取り戻したいんなら、拠点で親分を探してくるといい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040215,
					"content": "ふんっ、察しだけはいいみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040216,
					"content": "お二人とも、その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040217,
					"content": "失せろ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "はっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "「海乱鬼」"
				},
				{
					"id": 728040219,
					"content": "実力はないのに、逃げ足だけは早かったですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040220,
					"content": "あっさり仲間を売った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "海乱鬼は利己的な烏合の衆なんです。忠誠心も信念もありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040222,
					"content": "面倒事に遭遇すれば、すぐに逃げる。よくあることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040223,
					"content": "しかし、これもすべてあなたのおかげです。あなたがいなければ、彼らはそう簡単に引き下がらなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040224,
					"content": "しかしこれから、海乱鬼の本拠地に乗り込む必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040225,
					"content": "以前お話した計画の通り、私はあの首領を倒しに行きますので、残りの雑魚どもはお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040226,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "ではお任せします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 728040227,
					"content": "一度に10人は片付けられる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "次の人を探そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
