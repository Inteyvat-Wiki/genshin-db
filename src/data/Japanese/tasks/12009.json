			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090501,
					"content": "こんにちは。荒瀧一斗について聞きたいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090502,
					"content": "また彼のこと…ええ、問題ないわ。すでに天領奉行のために調査を行っているの。それよりも、モラの方は支払えるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090503
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090503,
					"content": "もちろん、君たちの事なら知っているわ。色んな冒険をしてきたのでしょ、なら各業界の規則も十分理解しているわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090504,
					"content": "え、えーっと…いくらかかるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090505,
					"content": "三十九万七千モラよ。一括払いでおねがい。それと、もし荒瀧一斗を捕らえることができたら、冒険者協会からもらう報酬の5パーセントを分け前として支払ってもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090506,
					"content": "高すぎないか！？それに、どう計算したらそんな数字になるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090507,
					"content": "ふふっ、話は最後まで聞いてちょうだい。相談料は既に天領奉行が払ったから、君たちは分け前だけ払えばいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090508,
					"content": "しかもその分け前も、私が冒険者協会に直接もらいに行くから大丈夫、得したわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090509
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090509,
					"content": "さて本題に戻りましょう。この事件を理解するには、稲妻の有名な昔話を知る必要があるわ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090510,
					"content": "青鬼は？青鬼はその後どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090511,
					"content": "青鬼はそれから姿を消し、誰も見ていないわ。今残っているのは赤鬼だけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090512,
					"content": "ううう、なんでだぁ…青鬼はいいやつなのに——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090513,
					"content": "昔話と現実に何の関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090514
					]
				},
				{
					"id": 120090514,
					"content": "もちろん、関係なければ話さないわ。一説によると…この昔話は本当の歴史を脚色したもので、荒瀧一斗は赤鬼の末裔らしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090515
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090515,
					"content": "つまり、鬼族は大きな犠牲を経て、ようやく人類の輪になじむことができた。だけど、鬼族の気性にはまだ不安定な要素があるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090516,
					"content": "その不安定さは血筋によって受け継がれている。確かに荒瀧一斗は以前まで悪さをしなかったけど、ある日突然性格が大きく変わるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090517,
					"content": "でもそうなったら、青鬼の想いを裏切ることになっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090518,
					"content": "もう随分と昔の話よ。青鬼は長いこと姿を見せていないから、とっくにいなくなっているかもしれない。裏切るといってももうできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090519,
					"content": "しかも…当の本人が認めているのだから、それ以上疑う必要があるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090520,
					"content": "私の調査によると、彼は南西方向に向かったわ、恐らくもう<color=#00E1FFFF>ヤシオリ島</color>に着いている頃ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090521
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090521,
					"content": "珊瑚宮軍の管轄地域なら、天領奉行も捕まえに行けない。だから、荒瀧一斗の逃亡先としても理由は十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090522
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090522,
					"content": "分かった、情報ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090523
					]
				},
				{
					"id": 120090523,
					"content": "構わないわ。当然のことをしたまでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090524
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090524,
					"content": "ちょっと待った、もう一つ質問があるんだ。もし荒瀧一斗ってやつの性格が激変してたら、凶悪で暴力的になってるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090525,
					"content": "そうなるかもね。彼の過去の戦いっぷりから考えるに、かなりケンカ慣れしていると思うわ。凄まじい力を持っているのは間違いないから、あなたたちで彼を抑えることができるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090526
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090526,
					"content": "じゃあ…鬼に豆をまく話も、実際に使えるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090527,
					"content": "あら、そういえば、荒瀧一斗は豆アレルギーらしいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090528
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090528,
					"content": "鬼族は多少なりとも豆を怖がるの。彼は特に苦手で、触れることすらできないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090529
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090529,
					"content": "アレルギー反応を起こして、弱らせることができれば、簡単に捕まえることが出来るんじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090530,
						120090532
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090530,
					"content": "それしか方法はなさそうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090531
					]
				},
				{
					"id": 120090531,
					"content": "そうだな、弱点が分かってれば安心だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090534,
					"content": "たまたま、お粥に使おうと思っていた豆が一袋あるから、君たちにあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090535
					],
