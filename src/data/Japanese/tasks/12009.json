			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090101,
					"content": "キャサリン、オイラたちだぞ。何か手伝えることはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090102,
					"content": "すみません、また手伝ってもらいたいことがあります。今回は天領奉行直々に冒険者協会へと依頼された、重要かつ危険な任務です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090103,
					"content": "協会は、この任務は経験豊富な冒険者にしか任せられないと判断し、そこであなたたちの名が上がりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090104,
					"content": "へへっ、それほどでもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090105,
						120090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090105,
					"content": "なんだか危なそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				},
				{
					"id": 120090107,
					"content": "それについて説明しますと、天領奉行はここ最近、「荒瀧一斗」という名の鬼族の青年を探しているのです。彼を捕まえるため、お尋ね者のお触れまで出すほどでして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090108,
					"content": "鬼族？なんか聞いたことあるな。おでこに角の生えた、見た目が怖そうな人だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090109,
					"content": "はい。その人物はとても派手で騒々しいため、町では割と有名です。とは言え、過去に事件を起こしたわけでもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090110,
					"content": "それが最近になって、強盗や人さらいのようなことをするようになったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090111,
					"content": "さらに悪事を働いただけでなく、天領奉行が彼を連行しようとした時、その任を執行していた同心に手を上げ、仲間と共に逃走をしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090112,
					"content": "悪い人みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090113
					]
				},
				{
					"id": 120090113,
					"content": "とにかく、オイラたちに悪者を捕まえてほしいっていう依頼だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090114,
					"content": "安心しな。こいつに任せれば、どんな相手でもちょちょいのちょいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090115,
					"content": "はい。しかし、やはり万全な準備をした方がいいと思います。その人物は神の目の持ち主で、配下に「荒瀧派」という組織を持っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090116,
						120090118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090116,
					"content": "大人数とのケンカは苦手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090117
					]
				},
				{
					"id": 120090117,
					"content": "そうだな、まだどんな相手なのか全く分からないことだし、おまえの言う通り、慎重に進めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090120,
					"content": "荒瀧一斗という人物について、なぜそのようなことをして、そして今どこを逃げているのか、私たちはまだ情報を掴めていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090121
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090121,
					"content": "町にいる皆さんの方が詳しいと思うので、そこなら有益な情報を得られるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090122,
					"content": "分かった、後で聞き込みに行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090123
					]
				},
				{
					"id": 120090123,
					"content": "ご協力ありがとうございます。私はこちらで朗報を待っていますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 120090118,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}には子分のパイモンがいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090119
					]
				},
				{
					"id": 120090119,
					"content": "わ、悪かったよ！もう大口たたかないから、オイラを戦わせようとしないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090106,
					"content": "天領奉行だけでは解決できないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				}
			]
		},
		{
			"id": 1200902,
			"completionStepIds": [
				1200902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200902",
							"2"
						],
						"stepId": 1200902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小倉澪",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090201,
					"content": "荒瀧一斗？彼の事なら知っていますが…私は天領奉行の勘違いだと思っています。荒瀧一斗が悪事を働くはずないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090202
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090202,
					"content": "え？そんなにあいつのこと信頼しているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090203,
					"content": "そういうことではなく、彼には悪事の「才能」がないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090204,
						120090205
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090204,
					"content": "力がない…ということ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				},
				{
					"id": 120090206,
					"content": "彼に関する話を聞けば、理解できると思います。彼は以前、よく巷の子供たちとじゃんけんやかくれんぼをして遊んでいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090207
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090207,
					"content": "子供たちはいたって単純で分かりやすいもの。しかし単なる遊びでも、荒瀧一斗は大負けすることがあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090208
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090208,
					"content": "わざと負けてあげてたのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090209,
					"content": "それは違うと思います。この前、彼が小さな子供に勝った後、飛び跳ねながら「やっと勝ったぜ！」「俺様は無敵！」と叫んでいましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090210
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090210,
					"content": "そして、その子から飴玉を勝ち取ると、目の前で食べ始めたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090211
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090211,
					"content": "うぇっ、最低なやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090212,
					"content": "私もさすがに少しやり過ぎだと思い、泣きそうだったその子のために説教しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090213
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090213,
					"content": "ただ、荒瀧一斗はすぐに、そして素直に謝ったのです。だから、その子もすぐにまた笑ってくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090214
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090214,
					"content": "荒瀧一斗は「素直に負けを認め、決して手を抜かない」ため、子供たちに好かれているのだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090215
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090215,
					"content": "このようなよく子供に負ける人が…どうやって悪事を働くのか、私には想像もできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090216,
						120090217
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090216,
					"content": "言いたいことは分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090218,
					"content": "聞いた感じ、芯があって、悪くないやつみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090219,
					"content": "はい。私もそう思っていましたが、天領奉行はすでに決定的な証拠を握っているとの噂です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090220
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090220,
					"content": "無論、彼を擁護するつもりはありません。本当に過ちを犯したのであれば、素直に罰を受けるべきだとは思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090221
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090221,
					"content": "うん、ありがとな！オイラたちももう少し情報を聞いてみるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090217,
					"content": "意外な性格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090205,
					"content": "知力に問題がある…ということ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				}
			]
		},
		{
			"id": 1200903,
			"completionStepIds": [
				1200903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200903",
							"2"
						],
						"stepId": 1200903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古谷昇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090301,
					"content": "荒瀧一斗についてかい？彼のしたことは耳に入ってるよ。もう逃げたらしいけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090302
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090302,
					"content": "その情報を聞いた時は、少し意外だった。あ、いや、それほど意外でもないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090303
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090303,
					"content": "それは、一斗が以前から評判の悪いやつだったからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090304,
					"content": "いや、なんて言うか…コホッコホッ…彼は何をやるにしても声が大きくて、血気盛んで、どこか騒々しい人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090305
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090305,
					"content": "彼の性格は、よく言えばとても明るい、悪く言えば情緒不安定。気分がいい時は愉快な人物だが、怒った時はそれはもう激しくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090306
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090306,
					"content": "荒瀧一斗に対して、僕は別に悪い印象を持ってはいない。でも、もし彼が怒りのまま衝動に駆られたら、何をするか想像がつかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090307,
						120090308
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090307,
					"content": "彼は普段、何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				},
				{
					"id": 120090309,
					"content": "それがはっきりと分からなくてね。コホッコホッ…僕は割と普段から町で起きたことに気を配ってる方なんだけど、荒瀧一斗はどうもぶらぶらして過ごしているみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090310
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090310,
					"content": "助けが必要な人がいれば助ける。その他の時間は、子分や子供たちと遊んでるだけだと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090311
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090311,
					"content": "あっ、収入がなくて生活が苦しくなったから、悪事を働いたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090312
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090312,
					"content": "変わった人なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090313,
					"content": "ゴメン、他の情報は僕もそう詳しくなくてね。とにかく、彼は元気な人と一緒にいるのが好きなようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090314
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090314,
					"content": "他の人からも話を聞いてみた方がいいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090315
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120090315,
					"content": "おう、ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090308,
					"content": "彼は何か定職に就いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				}
			]
		},
		{
			"id": 1200904,
			"completionStepIds": [
				1200904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200904",
							"2"
						],
						"stepId": 1200904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090401,
					"content": "荒瀧一斗？ああ、もちろん知ってます。今、彼を捕まえようとしている最中ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090402
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090402,
					"content": "ヤツは稲妻城を離れたようです。それ以上手がかりがなく、冒険者協会を含む他の組織に協力を依頼しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090403
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090403,
					"content": "ああ、オイラたちもキャサリンから聞いたんだ。荒瀧一斗には前科がなくて、今回の出来事も突然だったとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090404,
					"content": "その略奪とか強盗は、全部証拠があるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090405,
					"content": "もちろんです。証拠がなければ、これほどの人手を動かすことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090406
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090406,
					"content": "強盗犯は通常、自分の身元を隠そうとしますが、鬼族は目立つためすぐに彼だと分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090407
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090407,
					"content": "他の鬼の可能性は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090408
					]
				},
				{
					"id": 120090408,
					"content": "最初は我々も彼が怪しいと思うだけだったのですが、調査の時に本人が自ら犯行を認め、しかも我々を挑発してきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090409
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090409,
					"content": "一番腹立たしいのは、最後に周りの者たちを連れて逃げ出したこと…彼は最初から準備をしていたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090410
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090410,
					"content": "彼に犯罪の動機はあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090411
					]
				},
				{
					"id": 120090411,
					"content": "もちろん、現実的な動機も心理的な動機も十分にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090412
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090412,
					"content": "彼はこれまで貧しい生活をしてきた上に、まともな仕事にも就いていませんでした。しかもとある集団の面倒も見ていて、金銭面でかなりの負担を抱えていたと思われます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090413
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090413,
					"content": "苦労して貧乏生活をするよりも、悪事を働いた方が楽に生きられると思ったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090414
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090414,
					"content": "心理的動機は、今となると少し言いにくいのですが、「目狩り令」が執行された時、我々に神の目を奪われたことがあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090415
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090415,
					"content": "天領奉行に仕返しするためってことか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090416
					]
				},
				{
					"id": 120090416,
					"content": "当時、荒瀧一斗は激しく抵抗したため、九条裟羅様に助けを求めてやっと彼を抑えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090417
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090417,
					"content": "…その件について、悪いのは我々ですが、まさか彼が復讐のためにこのような過激な手段に出るとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090418
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090418,
					"content": "聞いた感じ、感情の振れ幅が激しい人みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090419,
						120090420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090419,
					"content": "確かに動機は十分みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				},
				{
					"id": 120090421,
					"content": "はい。もし君たちが荒瀧一斗を捕まえたら、我々のところに連れてきてください。規則に従って、彼の処置をしますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090422
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090422,
					"content": "分かった、情報ありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120090420,
					"content": "確かな証拠があるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				}
			]
		},
		{
			"id": 1200905,
			"completionStepIds": [
				1200905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
