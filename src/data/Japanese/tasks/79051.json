			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "ここにもう1冊日記があるぞ、保存状態もかなり良さそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510102,
					"content": "ふぅ…安心したぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510103,
					"content": "この画家は気になってたことが解決できて、絵も上達したみたいだな。きっとすごい人になれるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510104,
					"content": "でも、結局行っちゃったんだな…シズクちゃんたちの傍にいてあげられなかったって思うと、オイラまでちょっと寂しくなっちゃったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510105,
					"content": "芸術家は複製品が好きじゃないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "そうだな、わからなくもないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510108,
					"content": "でも1個だけわからないんだけど…あいつは自分で言ってたよな、この壁画は変形したり位置がズレたりするかもって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510109,
					"content": "この前の事故はあんなにすごかったのに…壁画のズレは、たいしたことないみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510110,
					"content": "シズクちゃんたちが要だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "なるほどな！どうりでシズクちゃんたちが、「集流映写灯」と壁画の修復にあれだけ詳しいわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510113,
					"content": "うぅ…オイラ少しうるっときたぞ。シズクちゃんたちはちょっと鈍いとこもあるけど、ちゃんと傍にいてくれるし、大事にしてくれるから、本当に最高の友達だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "閲覧"
				},
				{
					"id": 790510111,
					"content": "この子たちが友達の壁画を守った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "オリジナルを大事にするのも一理ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
