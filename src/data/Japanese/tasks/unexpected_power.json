			"dialogs": [
				{
					"id": 3532801,
					"content": "どうだ？この世界の「元素」を感じたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532802,
					"content": "どうやら、おまえは神像に触れるだけで「風」の元素力を手に入れられるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532803,
					"content": "この世界の人が力を得るには、おまえみたいに簡単じゃないんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532804,
					"content": "この力の源…やはり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "うん、だっておまえはこの世界の人じゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532809,
					"content": "ここから西へ行くと、自由の都「モンド」に行けるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532817,
					"content": "モンドは「風」の都市で、七神の中で風神を祀ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532810,
					"content": "神像から力を得られるおまえなら、そこで神の手がかりを入手できるかもな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532811,
					"content": "#それと、モンドには吟遊詩人がたくさんいるから、{M#妹}{F#お兄}さんの情報が手に入るかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532812,
					"content": "よしっ、じゃあ行くか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532813,
					"content": "この世界の「元素」はおまえの祈りに応えた。いい兆しだとオイラは思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3532807,
					"content": "おかしいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "「おかしい」は神様にとって失礼だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
