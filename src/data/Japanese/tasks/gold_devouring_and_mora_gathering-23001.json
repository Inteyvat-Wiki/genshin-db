			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハティム"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230010101,
					"content": "うーむ…どれにしたものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010102
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010103
					]
				},
				{
					"id": 230010103,
					"content": "いや、今日の「千金料理」は何にしようかと考えていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010104
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010104,
					"content": "「千金料理」って…お金で作った料理か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010105,
					"content": "いや、食べると金運がアップする偉大な料理のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010106
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010106,
					"content": "それ、オイラも食べてみたいぞ！…でも、そんなの本当にあるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010107,
					"content": "ハハハッ、それはお前が知らないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010108
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010108,
					"content": "例えば、璃月には「モラミート」という貨幣の名を冠する高貴な料理があるが…当然、これには強力な金運が秘められている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010109
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010109,
					"content": "次に「バターチキン」。にじみ出る黄金色の脂が、金貨が溢れんばかりの財布を連想させるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010110
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010110,
					"content": "それにモンドの「お肉ツミツミ」。名前も盛り付けも、いかにも積み上がる富の象徴という感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010111
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010111,
					"content": "そうした料理を食べて、カリミ取引所で先物取引に臨めば…きっと大儲けできるはずなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010112
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010112,
					"content": "なんか、こじつけっぽいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010113,
						230010133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010113,
					"content": "先物ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010114
					]
				},
				{
					"id": 230010114,
					"content": "知らないのか？うーん…簡単に言えば、現物取引とは違って、未来の取引のことだ。たとえば、そこのチビ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010115
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010115,
					"content": "オイラはパイモンだ！そこのチビ、じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010116,
					"content": "ハハハッ、じゃあチビのパイモン、お前は何が好きだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010117
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010117,
					"content": "え？オイラは…えっと…スライムが好きだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010118,
					"content": "ハハハッ、よし！では仮に、俺の手元にスライムの液体があったとする。価格は1瓶100モラとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010144
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010144,
					"content": "今日お前が5万モラ出して俺からスライムの液体を500瓶買う、これが現物取引だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010119
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010119,
					"content": "そ、それは多すぎて飲みきれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010120,
					"content": "これは「もしも」の話だ…仮にお前が今日500瓶買ったとする。でもお前はそんな大量のスライムの液体を毎日俺から購入するなんてこと、約束できないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010121
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010121,
					"content": "う…うん。お腹ぱんぱんになったら、もう買わないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010122,
					"content": "だろう？俺だって、いつでもスライムの液体を提供するとは約束できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010123
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010123,
					"content": "そういう時こそ、先物の出番だ。先物は目の前で代金と商品を交換する一般的な取引とは違い、ある種の「取引契約」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010124
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010124,
					"content": "「スライムの液体を1瓶購入」することも、「スライムの液体の一部を販売」することも一種の「取引契約」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010125
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010125,
					"content": "俺がまだスライムの液体を提供できる場合は、先物取引所にスライムの液体販売の「取引契約」を提出する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010126
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010126,
					"content": "お前がスライムの液体を買いたければ、先物取引所に行ってスライムの液体の「取引契約」を検索すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010127
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010127,
					"content": "つまり「先物取引」は精確かつ巧妙に「取引契約」を売買することで、利益を得るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010128
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010128,
					"content": "もちろん、今話したのはただの例えだ。スライムの液体が本当に先物取引で扱われるようになったら、野外のスライムは根こそぎ獲られてしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010129
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010129,
					"content": "へえ…す、すごいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010130,
					"content": "うーん…ちんぷんかんぷんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010131
					]
				},
				{
					"id": 230010131,
					"content": "ただ、先物市場は変化が激しい。俺のように経験豊富なプロでも、買った先物が確実に儲かるとは言い切れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010132
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010132,
					"content": "だからこそ、取引前に金運をもたらす「千金料理」を食べて、運気をいい方に変えたいわけだ。そこで…今日はなにを食べるべきか、となってくるわけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010136,
					"content": "ん…ちょっと待てよ？いま気づいたんだが、お前の髪…黄金色じゃないか！まぶしい、実にまぶしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010137
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010137,
					"content": "黄金は富の象徴。お前に料理を選んでもらえば、きっと金運上昇間違いなしだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010138
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010138,
					"content": "俺に「千金料理」を一品選んでくれないか？ちゃんと報酬は用意する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010139
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010139,
					"content": "取引で儲けが出たら、ボーナスもつけよう。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010140
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010140,
					"content": "もし損失が出たら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010141
					]
				},
				{
					"id": 230010141,
					"content": "ハハハッ、心配御無用。このカリミの偉大なる富豪、ハティム様が約束しよう——利益は分配するが、損失は俺がかぶる。どうだ、これで心置きなく選べるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010142
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010142,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010143
					]
				},
				{
					"id": 230010143,
					"content": "では、選んでもらおうか。<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>の3品のうち、今日の「千金料理」はどれだと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010133,
					"content": "なんで3種類全部食べないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010134
					]
				},
				{
					"id": 230010134,
					"content": "うまい食材だからって見境なく混ぜたら、暗黒料理になってしまうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010135
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010135,
					"content": "それと同じだ。どれも金運が上がるとはいえ、全て食べては逆効果なのだ。最強の「千金料理」を一品選ばなくてはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010136
					],
					"speakerTitle": "ハティム"
				}
			]
		},
		{
			"id": 2300102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
