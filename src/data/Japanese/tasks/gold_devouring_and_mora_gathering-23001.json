			"dialogs": [
				{
					"id": 230010601,
					"content": "うーむ…どれにしたものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010602
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010602,
					"content": "おや、旅人じゃないか、ちょうどよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010603
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010603,
					"content": "おまえ…まさか、また「千金料理」を選んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230010604,
					"content": "ハハハ、ご明察！ちょうど「千金料理」を一つ選んで、先物市場へ出かけようとしていたところだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010605
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010605,
					"content": "どうだ？もう一回を手伝ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010606,
						230010608,
						230010614
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010606,
					"content": "わかった、今日もいつものやり方でいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010607
					]
				},
				{
					"id": 230010607,
					"content": "そうだ！話が早くて助かるな。<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>のうち、本物の「千金料理」を選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010608,
					"content": "待って、「千金料理」って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010609
					]
				},
				{
					"id": 230010609,
					"content": "食べると金運がアップする偉大な料理だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010610
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010610,
					"content": "例えば、璃月には「モラミート」という貨幣の名を冠する高貴な料理があるが…当然、これには強力な金運が秘められている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010611
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010611,
					"content": "次に「バターチキン」。にじみ出る黄金色の脂が、金貨が溢れんばかりの財布を連想させるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010612
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010612,
					"content": "それにモンドの「お肉ツミツミ」。名前も盛り付けも、いかにも積み上がる富の象徴という感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010613
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010613,
					"content": "そうした料理を食べて、カリミ取引所で先物取引に臨めば…きっと大儲けできるはずなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010623,
					"content": "それじゃあ、俺の「先物取引」のために、<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>のうち、本物の「千金料理」を選んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010614,
					"content": "待って、先物ってなんだっけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230010615
					]
				},
				{
					"id": 230010615,
					"content": "現物取引と対をなす、ある種の未来の取引だ。仮に俺の手元にスライムの液体があったとする。価格は1瓶100モラとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010616
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010616,
					"content": "今日お前が5万モラ出して俺からスライムの液体を500瓶買う、これが現物取引だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010617
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010617,
					"content": "だが、お前はそんな大量のスライムの液体を毎日俺から購入するなんて約束はできないだろうし、俺だって、いつでもスライムの液体を提供するとは約束できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010618
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010618,
					"content": "そういう時こそ、先物の出番だ。先物は目の前で代金と商品を交換する一般的な取引とは違い、ある種の「取引契約」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010619
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010619,
					"content": "「スライムの液体を1瓶購入」することも、「スライムの液体の一部を販売」することも一種の「取引契約」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010620
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010620,
					"content": "俺がまだスライムの液体を提供できる場合は、先物取引所にスライムの液体販売の「取引契約」を提出する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010621
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010621,
					"content": "お前がスライムの液体を買いたければ、先物取引所に行ってスライムの液体の「取引契約」を検索すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010622
					],
					"speakerTitle": "ハティム"
				},
				{
					"id": 230010622,
					"content": "つまり「先物取引」は精確かつ巧妙に「取引契約」を売買することで、利益を得るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230010623
					],
					"speakerTitle": "ハティム"
				}
			]
		}
	]
