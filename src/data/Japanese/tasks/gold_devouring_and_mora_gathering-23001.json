	"talks": [
		{
			"id": 2300101,
			"completionStepIds": [
				2300101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
