			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "…そうですか、それはどういたしまして。あなたの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411002,
					"content": "キャタピラー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}、こんな所であなたに会うなんて。パイモンはどうしたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411004,
					"content": "待って。まさかあなたも何かしらの怪物で、知っている人の振りをしてボクをからかっているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411005,
					"content": "少し前に会ったことがあるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "…そうなんですか？あなたとお別れしてからかなり経っているような気がしていました。きっと歳を重ねすぎて、覚えていられることがどんどん減ってきてるんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411007,
					"content": "…本当に、あなたは怪物ではないんですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411008,
					"content": "覚えてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "巨人の花園のことを。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "覚えてる、覚えていますよ。本当にあなただったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411012,
					"content": "すみません。ボクはこの場所であまりに多くの不思議なことに遭遇し、勝ち目のない戦いを何度も経験してきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411013,
					"content": "でも、ついにここに変化が起きました。金色の光が昇ってヒマワリが咲いたんです。もしかしたら、古代の人々が想像した宇宙にも変化は起こるのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411014,
					"content": "すべてがいい方向へと進むかもしれない。ボクもそれを理解して、手放せるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411015,
					"content": "キャタピラー…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "一緒に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "ふふっ、本当にあなたで間違いないようです。ボクがかつて知り合った「あなた」は、今も変わっていない。正直で優しいから、いつもお節介を焼いてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411018,
					"content": "大丈夫です、ボクに助けは必要ありません。あなたもボクの力量を見たでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411019,
					"content": "それに、ここの事情についてはボクのほうが詳しいかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411020,
					"content": "#ヒルチャール、その{M#少年}{F#少女}に急いでここを離れるよう伝えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "何か言いたいことがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "…僕の言葉が分かるの？うん、じゃあ聞くけど、君の目には僕はどう映ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "犬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "そうか…ならまだ間に合う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#これも君のためだ。ここを離れるんだ、{M#少年}{F#少女}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#ええ、そうですね。{NICKNAME}、あなたはもっと輝く世界にいるべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 741411027,
					"content": "他にも質問が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "それはダメ。じゃあね、もう戻ってこないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "弟子と小さな魚のことを。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
