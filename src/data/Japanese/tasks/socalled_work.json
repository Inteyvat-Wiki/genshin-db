			"dialogs": [
				{
					"id": 221140101,
					"content": "終わった、何もかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "うっ…この仕事に向いてないかもって安に言われた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140104,
					"content": "これってクビってことでしょ？どうしよう…ちゃんと毎日真面目に仕事してるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140105,
					"content": "えっ？どうしていきなり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "えっと…この前あなたに、その…船の数を数えてもらったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140107,
					"content": "あなたを信じてるから、確認もせず、そのまま報告したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140108,
					"content": "それで、間違ったデータがたくさんあって…安がすごく怒って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140109,
					"content": "ねえ、私の代わりに安に言ってくれないかな？こ、今後はちゃんと真面目に働くから！もうあなたにお願いしたりしないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140110,
					"content": "私はもう話す勇気がないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140111,
					"content": "船の数が間違ってた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "そう、船の数の統計をあなたにお願いしたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140113,
					"content": "あなたを信じてるから、確認もせず、そのまま報告したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140114,
					"content": "でもあなたにお願いしたのはたまにだし、ちゃんと自分でデータを統計したもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140115,
					"content": "二つのデータが混ざってて、どこが間違ってるか私も分からなくなったから、安すごく怒ってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140116,
					"content": "ねえ、私の代わりに安に言ってくれないかな？こ、今後はちゃんと真面目に働くから！もうあなたにお願いしたりしないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
