			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "うっ…もう詩は書けない、真面目に仕事しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140602,
					"content": "仕事のほうが大事だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "わかってるよ、でも朝から晩まで同じことして、時間が経ったら…退屈になるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140604,
					"content": "それに、こういう些細な仕事はそんなに重要じゃないし、誰も気にしないから、つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140605,
					"content": "はあ、安はいつも「どの仕事も価値がある」、「どの仕事も大事だ」って言ってるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140606,
					"content": "でも、本当にそうだったら、誰も仕事を選んだりしないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140607,
					"content": "仕事に責任を持って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "あなたに頼んだのはたまたまだよ、いつもは自分でしてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140609,
					"content": "仕事の責任…私も分かるけど、仕事が忙しくなるほど、サボりたくなるから、あなたにお願いしたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140610,
					"content": "本当に暇だったら、逆に仕事はないかなってなるけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140611,
					"content": "まあ、あなたは仕事したことがないから、言っても分からないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140612,
					"content": "どうしてそんなに詩を書きたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "どうして急にそれを？そうだね…何のために働くと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140614,
					"content": "私からすれば、「働くために働く」は、あまりにも退屈だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140615,
					"content": "なんというか、人は夢が必要、そうでしょ？日常の仕事とは全く違う「夢」がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140616,
					"content": "そしたら、疲れてもう頑張れない時も、少なくとも「夢」の中でリラックスできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140617,
					"content": "まあ、それはあくまで私の考え方だよ。冒険者の人たちがどう考えてるかは、分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140618,
					"content": "なにせ夢のために生きてるみたいな人たちだからね、私は逆に分を縛るために仕事も必要だって思ってるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140619,
					"content": "でも…ハハッ、「夢」は所詮「夢」で、働く時は地道に働かないと、私はいい例だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				}
			]
		},
