					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140502,
					"content": "できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "よかった、私の準備もそろそろ終わるよ。もう少ししたら品物を照合してくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140506,
					"content": "そうだ、これはあなたへのお礼、どうか受け取って。あともう少ししたら品物を照合してくる。今回は絶対にミスしない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140504,
					"content": "詩は書いてないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "まさか！今は詩を書く場合じゃないって、私だって分かるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "霖鈴"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
