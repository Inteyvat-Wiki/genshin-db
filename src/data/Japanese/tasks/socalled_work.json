			"dialogs": [
				{
					"id": 221140701,
					"content": "技術もないし、使える木材もない、「桶職人」として失格だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140702,
					"content": "「桶職人」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "ああ、私は桶を作る職人みたいなものだよ。まだ木材が足りてないのに、もう桶を作ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140704,
					"content": "ただ、私が持つ木材の品質が良くないからね、それで作った桶は、いいものにはなれないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140705,
					"content": "でも、新しい木材を探すことになると、いつ桶ができるか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140706,
					"content": "桶の納品が日に日に近づいてくる。もうなりふり構えないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140707,
					"content": "はあ、私みたいに困ってる「桶職人」は他にいるのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				},
				{
					"id": 221140708,
					"content": "霖鈴の仕事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "彼女の仕事？ああ、君たちに船の統計を頼んだ、そうでしょ？知ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140710,
					"content": "驚いた顔しなくてもいいよ。結果がよければ、過程はそんなに気にしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140711,
					"content": "それに、彼女が君たちに渡した報酬は、彼女自身が出したものだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140712,
					"content": "でも、もらったデータを確認もせずに、直接報告してくるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "安"
				},
				{
					"id": 221140713,
					"content": "そういう責任感のない態度が、一番腹立ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
