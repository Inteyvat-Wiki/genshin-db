			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "うっ…仕事どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140302,
					"content": "チャンスを与えると言ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "本当に！？よかった、よかったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140304,
					"content": "ん？品物の確認？まずい、そんなのしたことがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140305,
					"content": "また間違ったらきっと今度こそ終わりだよ、だめだ、ちゃんと準備しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140306,
					"content": "前の品物照合基準を探さないと…それとフォーマットも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140307,
					"content": "品物の数の確認をお願いしていい？伝票を元に、数を確認するだけでいいから、その後は私がちゃんと詳しく確認する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140308,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "じゃあお願いね！私はここで照合の準備してるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140310,
					"content": "今回は絶対にミスできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140311,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "だ、だめだ。品物の確認は船の統計より複雑だから、自分でしないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 221140313,
					"content": "だから、あなたたちには品物の数の確認をしてほしい。その後私がちゃんと照合するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				}
			]
		},
