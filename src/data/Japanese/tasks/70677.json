					},
					{
						"sceneId": 48000,
						"position": [
							39.722,
							0.239,
							21.347
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 706770101,
					"content": "おやおや、お客さんが来てたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770102
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770102,
					"content": "ここですごく長く待ってたのに、誰も来てくれなかったんだ。少し休むだけのつもりが、ソファーが気持ち良すぎて、つい眠りこんじまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770103
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770103,
					"content": "うわあ！ぬいぐるみが喋ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770104,
					"content": "そうそう、ぬいぐるみは喋るものだからな。待て待て、うーん、こういう時はまず自己紹介をしたほうがいいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770105
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770105,
					"content": "二人ともこんにちは。俺は…俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770106
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770106,
					"content": "…俺って、誰だっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770107
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770107,
					"content": "えっ？そんなこと聞かれても…おまえ、寝ぼけてるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770108,
						706770109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770108,
					"content": "#{M#君}{F#あなた}は「オオカミ伯爵」だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770110
					]
				},
				{
					"id": 706770110,
					"content": "ええ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770111
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770111,
					"content": "真に受けるなって。冗談だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770112,
					"content": "ちなみに、オイラはパイモン、こいつは旅人だ。ふぅ、「入ったらなにかを忘れてしまう謎の部屋」ってわけじゃなさそうでよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770113,
					"content": "ごめんごめん…寝すぎたからか、ずいぶん沢山夢を見てさ。どこまでが本当に経験したことかってことも分からなくなってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770114
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706770114,
					"content": "そうだな…確か「今の」俺は「ドアボーイ」で、ここに来る「お客さん」を出迎えるのが仕事だったはず…うん！お客さんたち、俺のことは「オオカミくん」って呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770115
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770115,
					"content": "おう。でも、夢なら、どれも本当に経験してはいないんじゃないか？夢っていうのはおまえが想像したものだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770116,
					"content": "想像したものって本当に経験したことじゃないのか？お客さんは物知りなんだな。俺には分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770117
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770117,
					"content": "恐ろしい呪いにかかって、溶けない氷に心臓を封印されて、果てしない雪原で寂しさに耐えた日々…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770118
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770118,
					"content": "薄い霧がかかった森の中で「白牙」と一緒に遊び、金色の蝶を追いかけて、月の映る川を渡った毎日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770119
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770119,
					"content": "そして凱旋する軍隊の一員として、クラッカーの紙切れを浴びながら、女王陛下から勲章を授かる遠くない未来の栄光を想像したあの日——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770120
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770120,
					"content": "俺にとっちゃ、どれも本当に経験したこととなんの変わりもない。直近の夢も覚えてるぞ。道が枝分かれになった花園の中で、魔女の姉ちゃんが俺にこう言ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770121
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770121,
					"content": "「これからあなたはドアボーイよ。ちゃんとお客さんをもてなしてあげてね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770122
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770122,
					"content": "そしたら俺はここに来てたってわけさ。んで、さっきも言ったけど、ずーっと待ってようやく…二人のお客さんを迎えることができた！これでやっと「ドアボーイ」としての責務を果たせるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770123,
					"content": "他に何か聞きたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770124,
						706770131,
						706770139,
						706770147
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770124,
					"content": "魔女について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770125
					]
				},
				{
					"id": 706770125,
					"content": "おまえが言ってた「魔女の姉ちゃん」って誰なんだ？夢の中のキャラクターっぽいけど、なんか不思議とそれだけじゃない気もするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770126,
					"content": "魔女の姉ちゃんは魔女の姉ちゃんさ。お客さんもお客さんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770127
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770127,
					"content": "魔女の姉ちゃんと友達…あっ！そうそう、魔女の姉ちゃんの友達も魔女だったんだ。みんなすごい魔法を知ってたぞ。創造の魔法、それに幻の魔法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770128
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770128,
					"content": "羽根ペンで魔法を使ってた魔女の姉ちゃんは不思議なインク瓶を持ってて、中には「幻想の真実」が入ってたんだ。こっそり舐めてみたけど、すっげー苦かった…クーン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770129
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770129,
					"content": "でも、他の姉ちゃんたちはその魔法が気に入ったみたいで、創造の魔法を使って「幻想の真実」を「真実の幻想」に変えてたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770130
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770130,
					"content": "一体どうやってやったんだろう？俺にもよく分かんねえや。だって、ただのぬいぐるみだしな。考えるのに使う部分はきっと、綿と毛糸でパンパンだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770131,
					"content": "この部屋について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770132
					]
				},
				{
					"id": 706770132,
					"content": "オイラたちは図書館にあった、今まで開けられなかった扉の向こうからやってきたんだけど、ここは一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770133,
					"content": "ここは招待されたお客さんだけが入れる特別な部屋だ。二人とも、おめでとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770134
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770134,
					"content": "二人はこれで資格をゲットしたってことだから、他の友達を招待することもできるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770135
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770135,
					"content": "そうそう、すぐ片づけて暖かいお茶とデザートを用意するからな。デザートは甘めのやつでいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770136
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770136,
					"content": "おう！…って違う！オイラは、ここは一体どこなんだってことを聞きたかったんだ。オイラたちはまだモンドにいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770137,
					"content": "うーん、難しい質問だな。ここは魔女の姉ちゃんが魔法で作った部屋で、俺には魔法が分からないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770138
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770138,
					"content": "でも、「ドアボーイ」として保証してやるよ…ここは安全で居心地のいい場所だってな！二人がここで楽しく過ごせることを祈ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770139,
					"content": "あの本とさっきの戦いについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770140
					]
				},
				{
					"id": 706770140,
					"content": "お客さんのパフォーマンス、本当に最高だったぞ！つい見とれちまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770141
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770141,
					"content": "…パフォーマンス？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770142,
					"content": "うん、魔女さんが言ってたんだ。物語の本にあるページはそれぞれが「現在」の一部なんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770143
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770143,
					"content": "きっとお客さんは特別で、だからこそ物語の主人公として舞台で華麗なパフォーマンスを披露できたんだと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770144
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770144,
					"content": "手に汗握る戦闘シーンってのは…一部の物語にとっちゃ欠かせない香辛料みたいなもんだからな！もちろん、俺もそういう話が好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770145
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770145,
					"content": "もしお客さんの華麗なパフォーマンスを本にするとしたら、どんなタイトルがいいだろうな？戦記？激戦録？征服記？それとも戦闘編？どれも捨て難いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770146
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770146,
					"content": "とにかく、もしお客さんがこれからも、みんなにさっきみたいな素晴らしいパフォーマンスを見せてくれるなら…いや、ぜひ見せ続けてくれ！そして、「現在」の物語のページをどんどん残してくれたら嬉しいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770123
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770147,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706770148
					]
				},
				{
					"id": 706770148,
					"content": "謎は深まるばっかりだぜ…でも、オオカミくんも悪いやつには見えないし、きっと大丈夫だよな？それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770149,
					"content": "テイワットを旅するには、やっぱり度胸がないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770150,
					"content": "ワオー、冒険者っぽいセリフだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770151
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770151,
					"content": "へへっ、当たり前だろ！オイラたちは正真正銘の冒険者だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706770152,
					"content": "「ドアボーイ」として、俺ももっと頑張らないと。疲れたお客さんに休憩の場所を提供して、元気いっぱいで新たな冒険を始めてもらえるように努力するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706770153
					],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770153,
					"content": "お客さんたちも、もし疲れたら、ここに戻って休んでくれよな。俺がもてなしてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子オオカミ",
					"speakerSubtitle": "「ドアボーイ」"
				},
				{
					"id": 706770109,
					"content": "#{M#君}{F#あなた}はみんなに愛される栄誉騎士だよ。",
