			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "やっと<color=#00E1FFFF>璃月</color>に着いた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010202,
					"content": "#そこの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_GIRLB]}ちゃん、その隣に浮かんでいるチビは、いくらで売っているのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010203,
					"content": "いくら積まれても売る気はない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "いくら積まれても売られる気はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010209,
					"content": "ハハハッ、確かに最近は懐に余裕がないから、あまり出せないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010210,
					"content": "なにせ普通の商人だ。珍しい宝物を売っているわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010211,
					"content": "…なんかあやしいぞ、こいつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010212,
					"content": "そう言わないで…そうだ、飴食べる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}、こいつは信頼できるやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010214,
					"content": "そうだ、君たちも「海灯祭」目当てで璃月に来たんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010215,
					"content": "今年の「明霄の灯」はとにかくすごい。巨大な灯を浮かせるために使った「浮生の石」はここ20年で最も大きいものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010216,
					"content": "神話に出てくる雲の中の城が本当に実在していたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010217,
					"content": "きっと同じくらい大きな浮生の石がくっついているんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "博来"
				},
				{
					"id": 400010218,
					"content": "なんかすごそう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010219,
					"content": "ようこそ、璃月へ——<color=#00E1FFFF>璃月港</color>の代表としての言葉ではないが、少なくとも私の店はいつでも君を歓迎するよ。はははは、機会があればまた会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				},
				{
					"id": 400010205,
					"content": "一介の商人には払えない額だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "なんかおかしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010207,
					"content": "でも正直に言うとちょっと気になるな…一体いくらだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010208,
					"content": "まあ、いくら積まれても売る気はないということにしておくか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江舟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}、見ろよ！あの石が空中に浮いてるぞ！鎖もまっすぐになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010302,
					"content": "鎖がなかったら、どこまで飛んでいくんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010303,
					"content": "あれは「明霄の灯」の材料、浮生の石。この「霄市」はそのために作られたものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010304,
					"content": "えっと、誰…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010305,
					"content": "明霄の灯の建設進捗統計を担当している江舟だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010306,
					"content": "君たちは初めて璃月に来て、初めて海灯祭を見た者かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010307,
					"content": "そうだけど…どうして分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010308,
					"content": "去年は変わったマスコットを連れた旅人なんていなかったからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010309,
					"content": "紹介しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010310,
					"content": "「明霄の灯」というのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "海灯祭で、人々が飛ばす小さな提灯が「霄灯」で、璃月のみんなが共同で建設した巨大な提灯が「明霄の灯」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010312,
					"content": "「霄市」の屋台は璃月の各商会が年に一度、お金のためではなく、「明霄の灯」を建設するために開いたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010313,
					"content": "君たちもよければ、手伝ってくれると助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010314,
					"content": "じゃ、じゃあ何かメリットはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010315,
					"content": "「明霄の灯」はその努力を覚えてくれるよ。来年の初めての満月の夜、きっと君の願いも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010316,
					"content": "もっと現実的なものはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010317,
					"content": "はあ、そう現実的にならなくてもいいのに。地道に生きる人も、たまに顔を上げて星空を見るだろ？人は夢が必要だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010318,
					"content": "とにかく、「明霄の灯」の建設に手を貸してくれたら、<color=#00E1FFFF>「霄市」</color>ではその分のお返しがもらえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "江舟"
				},
				{
					"id": 400010319,
					"content": "つまり、努力すれば美味しいものが手に入れる、だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}、やるぞ！まずは<color=#00E1FFFF>「霄市」</color>の人たちに話を聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "今年の「明霄の灯」のデザインは「移霄導天真君」か。見栄えを気にするあやつが喜びそうじゃのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010602,
					"content": "「移霄導天真君」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "今年の海灯祭の「明霄の灯」は「移霄導天真君」のイメージを参考にデザインされたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010604,
					"content": "鹿の角をもっと大きくしてくれるといいんじゃが。なにせ鹿の角はあの仙人の誇りじゃったからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010605,
					"content": "その角には岩王帝君の力が込められておって、璃月で最も硬いものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010606,
					"content": "しかし「あの決戦」で山が崩れそうになり、彼は麓にいた人々を守るため、自ら角を斬ってくれと友人に頼んだんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010607,
					"content": "彼は斬り落とされた角を支点にして、山を支えた。彼自身も最後の一滴の血が流れるまで戦ったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010608,
					"content": "今になってもなお、彼の角に支えられた「天衡山」は高くそびえ立っておる、そして彼が戦いで流した血は「碧水川」となった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010609,
					"content": "ほぉっほぉっ…信じてくれるかどうかは別として、この話を聞いてくれただけで、ばあやは満足じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010610,
					"content": "海灯祭が今も在り続けているのは、あの「旧友」たちが寂しがり屋だからかもしれないのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 400010611,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "さようなら。往古来今、美徳の精神が続かんことを。",
