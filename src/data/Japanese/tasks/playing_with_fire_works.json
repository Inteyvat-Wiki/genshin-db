					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "おっと、宵宮の新しい友達やないか。今日は遊びに来たんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490102,
					"content": "商売はうまくいってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "えらい順調や！はははっ、うちの娘が花火をごっつええ感じにしたおかげやな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490104,
					"content": "今日来たんは、宵宮に会いに来たんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490107,
					"content": "あいにく、花火の材料を探してくるっちゅうて、出かけとるで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490108,
					"content": "どこに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "あ？なんて？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490110,
					"content": "宵宮、どこに行ったの！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "おう、それか…俺も知らんわ。あの子は言ったかもしれんが、俺は耳が遠いからな…聞こえんかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490112,
					"content": "あの子になんか用か？花火を買って遊びたいんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490113,
					"content": "宵宮と遊びたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "おう、今回はたぶん無理や。あの子、花火のことで出かけた時は、いつ帰ってくるんか俺にも分からん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490115,
					"content": "せや、あの子が出かける前、新しい花火を店に置いたんや。それを使って遊ぶとええで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490118,
					"content": "その花火、どこに置いたか…たしか部屋の奥や…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490119,
					"content": "それってあまり良くないんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "平気平気、店にはまだ在庫がたくさんある、一つや二つ遊びに使っても大したことないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490122,
					"content": "それに、あの子は元々誰かにこの新しい花火を試してもらいたいと思ってたんや。ちょうどよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490123,
					"content": "安心して花火で遊ぶとええで。それが終わったら、感想を言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490124,
					"content": "あの子が帰ってきたら、俺から伝えとく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490125,
					"content": "安心せえ、花火を遊んだのがお前さんらと知ったら、きっとあの子も喜ぶで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490126,
					"content": "はよ行き。それと、花火をやる時は城外でやるんやで。城内でやると、また人が集まってくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490120,
					"content": "宵宮に言ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "花火を遊びたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "ははっ、問題ないで。あの子が出かける前、新しい花火を店に置いたんや。それを使って遊ぶとええで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490105,
					"content": "宵宮はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "おや、今日は宵宮に会いに来たんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "長野原龍之介"
				}
			]
