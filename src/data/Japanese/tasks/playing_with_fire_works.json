			"dialogs": [
				{
					"id": 220490301,
					"content": "帰ってきたか、花火はどうやった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490302,
					"content": "綺麗だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "ならよかったわ、はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490306,
					"content": "よし、俺も店の準備をしてくるわ。最近花火を買いに来る人が増えてきとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490307,
					"content": "あの子まだ帰って来ないなんて、どこほっつき歩いとるんや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 220490304,
					"content": "まだ遊び足りない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "そんなに気に入ったんか？なら、今度また遊びにきぃや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "長野原龍之介"
				}
			]
		}
