			"dialogs": [
				{
					"id": 761010201,
					"content": "イルーガ！やっと戻ってきたんだな！ニキータさん…マスター・ライトキーパーが待ってるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "オラヴィ"
				},
				{
					"id": 761010202,
					"content": "え？ニキータ？マスター・ライトキーパー？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}、「ニキータ」ってさ、オイラたちに「シルバーランプの芯」を探してくれって頼んできたおじいちゃんじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010204,
					"content": "確か、「しがない」ライトキーパーだって言ってたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010205,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "義父さんったら…はぁ。すみません、ちょっとした悪戯心だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010208,
					"content": "ひとまず、状況を報告しに行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010206,
					"content": "どう見ても普通のライトキーパーじゃなかったでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
