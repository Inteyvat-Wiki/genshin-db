			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}さん、パイモンさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010102,
					"content": "へへっ、来たぜ！すっごくにぎやかだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010103,
					"content": "この間はみんなお疲れ様でした。後処理もほぼ片付いて、ようやくこうしてパーティを開く余裕も出てきましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010104,
					"content": "イルーガもお疲れさま。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "僕がしたことなんて、たいしたことではありません。それに、お二人の協力がなければ、今よりももっと多くの犠牲が出ていたはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010106,
					"content": "オイラたちはおまえの隊員だぞ！よそ者扱いするなよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010107,
					"content": "ふふ、そうでした。あ、義父さんが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010108,
					"content": "今日、集まってもらったのは、単なる祝賀会のためではない。この苦難の末に勝ち得た勝利を記念するためでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010109,
					"content": "杯を掲げる時、我々と共に杯を交わすことのできなかった者たちのことを忘れないでくれ。彼らは血と肉を代償に、その誓いを果たしたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010110,
					"content": "この度の戦いでは、イルーガ率いる「闇夜の鶯」調査分隊が最も困難な任務を担うこととなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010111,
					"content": "#特に{NICKNAME}とパイモン。この危機的状況下で、躊躇うことなく我々に加わり、作戦において大きな役割を果たしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010112,
					"content": "二人を加えた分隊の者たちは、犠牲を恐れることなく危機に立ち向かい、困難の中、勝利へ続く道を切り開いてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010113,
					"content": "彼らの功績——そして生きる者と未来のために戦ったすべての人々の功績は、永遠に歴史に刻まれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010114,
					"content": "我々は勝利を手にした！しかし、この勝利には大きな代償も伴った。大いに涙を流し、追悼してくれ。ただし、決して悲しみに打ちのめされるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010115,
					"content": "我々が戦い抜いた理由である、「未来」が訪れようとしている。種火を受け継ぎ、導きのランプをこうこうと照らし続けるために、我々はまだ立ち止まるわけにはいかないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010116,
					"content": "しかし、今日だけは、勝利のために、不滅の英雄である戦友たちのために、そして未来のために、乾杯しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニキータ"
				}
			]
		},
