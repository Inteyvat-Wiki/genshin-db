					"nextDialogs": [
						761010805
					]
				},
				{
					"id": 761010805,
					"content": "あはは、そうでしたか。でも、気持ちはわかります。これから、こんな風にお祝いできる日が増えるといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ロロン"
				}
			]
		},
