					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "魔天への扉はすでに開かれました。これっぽちのクーヴァキ、私には何の影響もありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011302,
					"content": "しかし、なぜ私はここに囚われているのでしょう…？なるほど、サンポ・ミルは、またしても私を拒ばんだのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011303,
					"content": "あらあら、誰かと思えば…珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011304,
					"content": "…誰です？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011305,
					"content": "その姿は…ああ、レラー、君でしたか。よかった、生きていると信じていましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011306,
					"content": "さあ、サンポ・ミルの力を従わせるのです！聖なる継嗣の血を持つ君ならできるはずです…あの三人の出来損ないどもとは違って、貴方は私の最高の弟子なのですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011307,
					"content": "はっ、あたしをレラーと間違えるなんて…あんなに口達者だったあの「怪僧」が、ここまで判断力を鈍らせるなんて、皮肉なものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011308,
					"content": "躊躇ってはなりません、レラー。我々の理想を忘れてしまったのですか？本来あなたのものであったはずの地位と身分を取り戻したくはないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011309,
					"content": "虐げられ、貶された人々のための「楽園」を作り、あの醜いフェイの貴族たちを跪かせるのでしょう？蒼星の王廷で…貴方を助けようとしているのは人間である私だけなのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011310,
					"content": "今や、あと一歩で星々の階段を登れるというところに来ました…天空の外から「楽園」が降臨する時、私たちのような選ばれし者だけが生き残れるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011311,
					"content": "その時、全ての腐敗と穢れが浄化されるのです…これこそ、貴方の望む世界なのではないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011312,
					"content": "違う。そんなのは彼の望んだ世界じゃないわ…まだ下手な嘘を重ねるつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011313,
					"content": "あんたは最初から彼を利用して、ただ彼にサンポ・ミルを手に入れさせるために嘘をつき続けてただけ。あんたの言う「楽園」は、最初からあんた一人だけのものでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011314,
					"content": "彼が軍人としての身分を捨てて大盗賊になったのも、あんたとアルヴィス大公が仕掛けた罠のせいだった——違う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "「教授」"
				},
				{
					"id": 761011316,
					"content": "さっき、人違いだと言ったけど…あたしは彼の立場と意志を受け継ぐ者よ。もちろんレッド・ミラーの名だって甘んじて受け入れるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011317,
					"content": "レッド・ミラーの名の下に——ラウスヴァンギ、怪僧、「教授」、不死なる毒蛇…あんたの物語に、このあたしが終止符を打ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "アリエー"
				},
				{
					"id": 761011318,
					"content": "やりましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761011319,
					"content": "今度こそ、あの不死の悪霊を屠ることができました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761011320,
					"content": "「その不死なる毒蛇は必ずや二度蘇り、三度討ち破られるだろう…月下の世界の英雄たちに葬り去られるまで…」\\n勇敢なライトキーパーたちと肩を並べて戦い、ついに「教授」を倒した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "その後、ピラミダに数日滞在した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}