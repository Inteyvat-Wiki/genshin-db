			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "義父さん、ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010302,
					"content": "おかえり。キプマキの崖の様子はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010303,
					"content": "手短に状況を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "やはりそうか…ここからでもはっきりと見える。エンブラの柱はもう、完全にアビスの力に…あの不死の悪霊「教授」に完全に支配されてしまったのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010305,
					"content": "しかし、今のところ大きな動きは見られない。そのアリエーさんが全力で対抗しているからなのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010306,
					"content": "彼女が私たちのために勝ち取ってくれた貴重な時間を、一瞬たりとも無駄にはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010307,
					"content": "幸いフリンズと皆の協力のおかげで、準備はほぼ済んでいるがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010308,
					"content": "君たちが持ち帰った「スパイラルソード」のおかげで、「テルピケラウナスの矢」も形になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010309,
					"content": "ええと、その…「テルピケラウナスの矢」ってなんなんだ？「シルバーランプの芯」とか「スパイラルソード」みたいな、すごい聖物か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010310,
					"content": "はっはっは、それよりもっと凄い物だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010311,
					"content": "五百年前、ライトブリンガーは力及ばず、不死の悪霊をキプマキの崖の下に封印することしかできなかった。しかし、その後もライトブリンガーと初代詠月使は諦めなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010312,
					"content": "いつの日か不死の悪霊を完全に滅ぼすため、彼らは古の技術でこの「弓矢」を作り上げた。そして、私たちライトキーパーは代々それを守り続けてきたのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010313,
					"content": "そして今、使命を果たすべき時が訪れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010314,
					"content": "おお…そんなにすごい矢があるのか。どんな風なのか、見てみたいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010315,
					"content": "ふふ、もうすでに見ているぞ。というより、私たちは今まさに「テルピケラウナスの矢」の中にいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010316,
					"content": "えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "ま、まさか、オイラたちも一緒に発射され…って、ありえないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010320,
					"content": "正確には、このグレート・ミード・ホールは「テルピケラウナスの矢」を囲うように建てられている。そして、君たちが持ち帰った「スパイラルソード」とは、その失われていた矢尻なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010321,
					"content": "「スパイラルソード」をここに装填すれば、「テルピケラウナスの矢」は発射準備に入る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010322,
					"content": "でも、これって暖炉じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761010323,
					"content": "暖炉ですが、「スパイラルソード」を「矢尻」に変える特殊な装置でもあるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761010324,
					"content": "「悪しき卵」が孵化する前に…この伝承の「弓矢」で、屠る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010325,
					"content": "不死の悪霊は最後の抵抗を見せるだろう。だが、どれほどの手駒を寄越そうが、必ず我々が食い止める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010326,
					"content": "「テルピケラウナスの矢」の発射という重大な任務は、君たちに託そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニキータ"
				},
				{
					"id": 761010318,
					"content": "#{M#俺}{F#私}も発射されるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#なるほど、{NICKNAME}がオイラたちの最終兵器だったのか！…って、そんなわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "パイモン"
				}
			]
		},
