			"dialogs": [
				{
					"id": 760780401,
					"content": "今までの経験からすれば、周辺の魔物を倒せば、裂け目は自然と消えるはずなんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780402,
					"content": "どうしてワイルドハントの気配がまだ消えないんでしょう…おかしいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780403,
					"content": "まだ、ワイルドハントの穢れに侵食されている場所がある——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		},
