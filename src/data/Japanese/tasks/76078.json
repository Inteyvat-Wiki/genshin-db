			"dialogs": [
				{
					"id": 760780101,
					"content": "いつもは、ワイルドハントから生まれた魔物を全て駆除すれば、穢れた気配は消えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780102,
					"content": "ですが、この裂け目は消えずに残り続けています。非常に珍しいですが、先例がないわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780103,
					"content": "周りを調査してみましょう。恐らくまだ穢れているものが近くにあるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
