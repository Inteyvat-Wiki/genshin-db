						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "ああ、ランプですね。ワイルドハントを排除するために使われる、ライトキーパーの大切な持ち物です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780202,
					"content": "ランプがあり、カバーにはワイルドハントの気配も残っている…なのに、持ち主が見当たりませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780203,
					"content": "残念ですが、ここで起きたことは容易に想像がつきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780204,
					"content": "ライトキーパーはいつもこうして静かに犠牲になります…こういった形で同僚の逝去を知るのはいつものことですが…胸が痛みますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780205,
					"content": "…名もなき同士よ、あなたのランプは僕が引き継ぎます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780206,
					"content": "その肉体は清められ、炎は再び燃え上がり…ナド・クライを守ると誓った新たなライトキーパーの手に渡るでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780207,
					"content": "フリンズはランプを綺麗にすると、大事そうにしまった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "恐らく、だからワイルドハントは完全に消えなかったんでしょう。本部の人が回収に来るまでの間、一時的に僕がこのランプを保管します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780209,
					"content": "…おや、ランプの下になにかあるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760780210,
					"content": "これもこの同僚の形見でしょう。ランプと一緒に保管すべきかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
		},
