				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "ここにも誓いのランプがありますね。きっと先輩の遺物でしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780502,
					"content": "ランプにはまだワイルドハントの穢れが残っています…ここで何が起きたのか、想像に難くないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780503,
					"content": "誓いのランプを手にした日から、僕たちの命はランプの灯火とリンクし続けます…使命を果たすその時まで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780504,
					"content": "ナド・クライの平和と安寧のために、最後の瞬間まで戦い抜いた勇士に敬意を表します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780505,
					"content": "——ランプは僕が預かりますので安心してください。英霊の冠をあなたに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780506,
					"content": "これは本部に持ち帰って、もう一度灯してから、この意志を引き継げる人に託します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760780507,
					"content": "イルーガはランプをきれいにした後、丁寧にしまい込んだ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "これで、ここのワイルドハントは完全に排除できましたし、先輩の英霊も帰る場所を見つけられました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		}
	]
