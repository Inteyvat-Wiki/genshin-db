			"dialogs": [
				{
					"id": 762050201,
					"content": "かなり長い足場が必要そうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050202,
					"content": "万象を導き、聖なる御名を綴る。詞章を紡ぎ、使いは歩を進める。この聖殿に、言の葉をもって汝が道を切り開かん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050203,
					"content": "キーン——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "ドアを調べる"
				},
				{
					"id": 762050204,
					"content": "はい、出来上がりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050205,
					"content": "万象を導き、聖なる御名を綴る。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "詞章を紡ぎ、使いは歩を進める。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050207
					]
				},
				{
					"id": 762050207,
					"content": "この聖殿に、言の葉をもって汝が道を切り開かん。",
