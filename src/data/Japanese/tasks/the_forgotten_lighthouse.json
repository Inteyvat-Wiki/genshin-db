			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "えっと…どうしたらいいのかしら…もうすぐ来る頃よね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050102,
					"content": "来たぞー…って、おい！押し出そうとするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050103,
					"content": "コホン…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050104,
					"content": "まだ準備ができてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "どう説明すればいいのかしら。ああ、うまく表現できない…最初から順を追って話すしかないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050106,
					"content": "——もっと言うと、魔女たちが初めて風神に挑んだ時のことから話さないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050107,
					"content": "いくらなんでも遡りすぎだろっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050108,
					"content": "ううっ、ひどいわ。自分の口から話すのは本当に恥ずかしいのに…でも仕方ないわよね、事実は事実なんだもの…アリスにさえ知られなければ、笑われたりはしないはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050109,
					"content": "あいつ、また心の声が漏れてるみたいだな。それに、自分の「口」でって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050110,
					"content": "しーっ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "羽根は一時的に、書斎の一番高い場所に隠したの。挑戦の難易度は、高いほどクリアした時の達成感も増すと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050112,
					"content": "でも、あたしはああいう気まぐれな風を操るのが苦手で…ある程度の高さに到達すると、どうしてもそれ以上飛べなくなってしまうみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050113,
					"content": "羽根なんて、魔法で降ろせばいいんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050114,
					"content": "それだと、遊びじゃなくなってしまうじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050115,
					"content": "それはまあ…そうだな…じゃあ、もうどうしようもないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050116,
					"content": "ニコ、もう一言だけ言ってもらえる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "えっ？何を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050118,
					"content": "シムランカでは、言葉が魔法だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "なるほど、そういうことね！やってみましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050121,
					"content": "ううっ、ひどいわ。自分の口から話すのは本当に恥ずかしいのに…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "でも仕方ないわよね、事実は事実なんだもの…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "アリスにさえ知られなければ、笑われたりはしないはず…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "ニコの言葉を階段にできたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
