					}
				]
			},
			"dialogs": [
				{
					"id": 762050301,
					"content": "手に入れたぞ！やったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050302,
					"content": "でも…うぅっ、まだ頭がガンガンするぜ。ニコのやつ、階段を作るためだからって、張り切りすぎだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762050303,
					"content": "このあたしにそんな指摘をするなんて、いい度胸じゃない？強大な魔女が指先一つで、宝箱の中身を全部ニンジンに変えちゃうかもって考えたりはしないのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050304,
					"content": "パイモンは子供だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "ふふっ、冗談に決まってるじゃない。寡黙なる天の使いは、そんな些細なことを細かく根に持たないわよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050307,
					"content": "#——その日、旅人とパイモンが七重の階段を上ると、見慣れた後ろ姿が{M#彼ら}{F#彼女たち}を待っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050308,
					"content": "背中に光と炎が織りなす翼を輝かせる彼女の姿は、初めて出会った時と同じように気高く美しいものでした。しかし、その両目には残酷な光が宿っていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050309,
					"content": "「どうして？」旅人とパイモンは同時に問いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050310,
					"content": "「もっと言うと、あの日パイモンが、あたしが話すのに力を入れすぎだって文句をつけた時のことから話さないとね。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762050311,
					"content": "言葉には魔法が込められてるんだぞ！そんな怖いこと言うなよな！",
