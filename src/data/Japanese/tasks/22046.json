			"dialogs": [
				{
					"id": 220460101,
					"content": "神社がまた乱れてるにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "にゃおーん、主らか、ちょうどいい時に来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460104,
					"content": "しばらく掃除をしなかったから、神社の部屋に汚れがたくさんたまってるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460105,
					"content": "これじゃ神社に来た人間をおもてなしすることはできにゃい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460106,
					"content": "主ら、前と同じように、神社を掃除してくれにゃいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460107,
					"content": "大祐と悦子は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "うちは自分からあの緑色の二人に声をかけることはにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460109,
					"content": "あの背の高い人間、うちを見る眼差しがとても変にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460110,
					"content": "もう一人の緑色の人間も、いつもやる気がなさそうにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460111,
					"content": "にゃおーん、どう考えても、頼りにならない人間にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460115,
					"content": "とにかく、主らに任せた。前と同じように、長い棒と水で「掃除」してくれ。いいにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460116,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "とにかく、このことは頼んだにゃ。うちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460119,
					"content": "うちはここで主らを待つことにするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460117,
					"content": "なんとなく分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "大島さんに頼んだら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "あの石人間はずっと忙しくしているにゃ。いつも何かを叩いてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 220460114,
					"content": "石はもうできたはずなのに、なんでまだ叩いてるにゃ。おかしいにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「寝子」"
				}
			]
		},
