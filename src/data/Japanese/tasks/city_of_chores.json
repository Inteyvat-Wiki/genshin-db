				"objectNames": [
					"望雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "おかえりなさい、お土産は届けてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190702,
					"content": "全員に届けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "ありがとう…あなたがいてくれて、本当に助かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190704,
					"content": "千岩軍は祭りの時も休みがないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "それは…はぁ、総務司もできるだけ交代制で勤務を手配してるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190706,
					"content": "璃月は大きいから、警備や見回りをする場所が多すぎるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190707,
					"content": "交代制を行っても、人手不足が解消しないの。だからいつも誰かが残業することになるわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190708,
					"content": "それに今年の海灯祭は往年より盛大でしょ、警備や見回りの圧力が高くて…どんなに人手を調整しても足りないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190709,
					"content": "それは大変だったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "ありがとう、でも大丈夫。これも私たちがやるべきことだから…それに海灯祭が上手くいってくれれば、私たちも頑張った甲斐があるというものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190712,
					"content": "そうだ、海灯祭期間は他にも助けが必要な人が大勢いると思うから、もしよかったら色々協力してくれると助かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190713,
					"content": "もっとたくさんの人に「海灯祭」に来てもらえたら、祭りもより賑やかになるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190714,
					"content": "私たちが「霄灯を送る」理由はね、誰もが霄灯を飛ばせて、願い事ができるようにするためなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190715,
					"content": "もっと広く言えば…「海灯祭」を一人一人に届けて、祭りの雰囲気を楽しんでもらうためよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190716,
					"content": "だって、海灯祭はみんなの祭りなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190717,
					"content": "さて、私はまだ用事があるからもう行くわね。あなたが海灯祭を楽しんでくれることを祈ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190710,
					"content": "お疲れ様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
