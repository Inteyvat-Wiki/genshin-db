			"dialogs": [
				{
					"id": 718190101,
					"content": "はぁ…まだまだ仕事が終わらないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "大丈夫よ、海灯祭で溜まってた用事を整理してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190104,
					"content": "ただ…整理すればするほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190105,
					"content": "もちろん同僚にも少し分けたんだけど、今年は私の班が霄灯を送ることになったの…だから早く準備しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190106,
					"content": "霄灯を…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "そう…でも多分あなたが考えている「霄灯を送る」とは違うわ。ただ送るだけじゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190109,
					"content": "一言で言えば…祭りの祝福や雰囲気を届けると言った方がいいのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190110,
					"content": "例えば、海灯祭期間中は、みんな家に帰ってるでしょ。お店もほとんど休みを取ってるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190111,
					"content": "でも祭りの秩序を守ったり、事務を処理したりするために、千岩軍は海灯祭でも勤務してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190112,
					"content": "だから祭り期間中は、総務司がその人たちのためにお土産を届けに行くのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190113,
					"content": "私もちょうど、城の護衛をしている千岩軍の人たちに「霄灯を送る」ところだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190114,
					"content": "でも…あいにく人手が足りなくてね…まだ届けられていない分もあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190115,
					"content": "旅人、お土産を届ける手伝いをしてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "本当？ありがとう、じゃあ頼んだわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190118,
					"content": "誰に届けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "確認するね…えっと…まだ届けられていない千岩軍の人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190120,
					"content": "向明…弘毅…それと蔡楽ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190121,
					"content": "彼らの位置を記しておくから、頼んだわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718190107,
					"content": "たくさんの人に送るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
