			"dialogs": [
				{
					"id": 718190301,
					"content": "この井戸水はどうなってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190302,
					"content": "海灯祭のお土産について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "おっ、総務司からのお土産か。受け取るよ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190304,
					"content": "でも、俺はまだここで勤務する必要がある。市民がここに水を汲みに来るかもしれないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 718190305,
					"content": "はぁ、この井戸水、どうなってるんだ…飲めないってことだけは確かだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弘毅"
				}
			]
		},
