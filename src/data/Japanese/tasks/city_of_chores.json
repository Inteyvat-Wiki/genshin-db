			"dialogs": [
				{
					"id": 718190401,
					"content": "うぅ…まだ、願い事が書き終わってないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190402,
					"content": "…泣くな。千岩軍のおじさんが取ってきてくれるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190403,
					"content": "蔡楽について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "あの千岩軍のおじさんを探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190405,
					"content": "さっき一弦が霄灯に願い事を書いてた時、うっかり空に飛ばしちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190406,
					"content": "あの千岩軍のおじさんが、霄灯が木に引っかかってたのを見たらしくて…それで、僕たちのために取ってきてくれるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190407,
					"content": "あの霄灯は特別なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "僕も一弦にそう言ったんだけど…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190410,
					"content": "うぅ…いやだよ…あれは兄さんがやっとのことで作ったやつだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "一弦"
				},
				{
					"id": 718190411,
					"content": "一弦泣くな、千岩軍のおじさんはもうすぐ戻ってくるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190412,
					"content": "だからごめんね。もしあの千岩軍のおじさんを探してるのなら、あっちの方を見てきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一柱"
				},
				{
					"id": 718190408,
					"content": "もう一つ新しいの作らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
