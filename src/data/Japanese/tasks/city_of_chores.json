				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "ん？何か用か？今勤務中だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190202,
					"content": "海灯祭のお土産について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "静かに！勤務中なんだぞ。なになに、お土産？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190204,
					"content": "総務司から届けてくれたのか？そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190205,
					"content": "はぁ、また海灯祭か…今年こそは家に帰りたかったんだがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190206,
					"content": "しかしこの状況だと、気を緩められそうにない…帰るのは何日か先か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190207,
					"content": "届けてくれてありがとう。これはもらっておくよ。ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "向明"
				},
				{
					"id": 718190208,
					"content": "はぁ、あの人いつになったら離れるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "向明"
				}
			]
		},
