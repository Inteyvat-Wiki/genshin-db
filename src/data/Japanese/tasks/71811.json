			"dialogs": [
				{
					"id": 718110412,
					"content": "「写真機」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "届けてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110402,
					"content": "届けたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "お手数をおかけしました。忙しくて目が回りそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110404,
					"content": "そうでした、この「写真機」はあなたにお送りします。本当にありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110405,
					"content": "えっ、いいのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "お気になさらないで。手伝ってくれたのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110408,
					"content": "そんなに貴重な物ではありませんよ。それは仕入れの時に、フォンテーヌからもらった試供品です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110409,
					"content": "製品版とは多少違いがありますが…基本的な機能は全て揃っているので、楽しむ分には十分です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110410,
					"content": "それと…気に入ったのなら、ついでに宣伝してくれると助かります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110411,
					"content": "コホン…とにかく、ありがとうございました！この「写真機」は受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110406,
					"content": "これ、お高いんだよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
