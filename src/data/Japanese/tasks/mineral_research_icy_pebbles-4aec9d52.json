			"dialogs": [
				{
					"id": 761970120,
					"content": "(test)",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "かつて海を漂流していた時、どこからともなく聞こえてくる呼び声を耳にした。他のみんなは何も感じていなかったが、私はすぐにその声に魅了されてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970102,
					"content": "それって異界からの声じゃない？あたしも聞いたことあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970103,
					"content": "後になって気づいたんだが…あの声には彼岸に辿り着けなかったすべての夢が込められていた。いわば、怨念の集合体なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970104,
					"content": "寒波石を持っていけばよかったのにね。真ん中の穴を通して覗けば、誰があなたを呼んでたのか見えたはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970105,
					"content": "だが当時の私はまだ血気盛んな若造で、危険を目の前にしても、それをチャンスとしか思えなくてな。誘われるがままに海に飛び込んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970106,
					"content": "あの穴が異界につながってるって聞いたことあるけど…あんな小さな穴、どうやって通るんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970107,
					"content": "そしてその後…荒波が、私の財産も、名誉も、家族も、すべて奪い去ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970108,
					"content": "野心と欲望に駆られた冒険は、決して良い結果をもたらさないものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970109,
					"content": "あっ、引っかかっちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970110,
					"content": "取ってあげる。もう、こんなことしちゃダメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970111,
					"content": "リンネアお姉ちゃん、戻ってきたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970112,
					"content": "近くで寒波石を集めてたんだけど、君たちが話してるのが見えたから、ちょっと挨拶しようと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970113,
					"content": "そうだ、リンネアお姉ちゃんなら、本当に寒波石で異界への扉を開けられるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970114,
					"content": "私でも無理だって。前にも言ったでしょ？あれはただのこじつけの民間伝承で、信頼できる根拠なんてないんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970115,
					"content": "そうか…無理なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970116,
					"content": "あっ…聞いてたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970117,
					"content": "コホン…いや、私はもう昔の私じゃない。今の私は満足しているんだ、何も求めていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "ヴィジャミ"
				},
				{
					"id": 761970118,
					"content": "そうなんだ、残念だね。じゃあ、私も寒波石を集めるのを手伝うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "アウニ"
				},
				{
					"id": 761970119,
					"content": "うん、お願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970124,
					"content": "アウニが手伝ってくれたおかげで、すぐに収集が終わった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "ありがとう、でももう集め終わったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 761970123,
					"content": "そっか、じゃああたしはモレーおじいさんたちのところに行くよ。またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アウニ"
				}
			]
		},
