				]
			},
			"dialogs": [
				{
					"id": 402050701,
					"content": "月光が我らを結ばん…詠月使様、何か御用でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050702
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050702,
					"content": "ラウマはあなたたちがここまでやって来た経緯を話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050703
					]
				},
				{
					"id": 402050703,
					"content": "盗み？私たちがそんなことをするわけがありません！根も葉もない中傷でございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050704
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050704,
					"content": "確かに危険な機械を一つ持ち帰りました。しかし、盗んだ物ではありません。賊から押収したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050705
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050705,
					"content": "誤解があるなら、客人たちに説明してくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050706
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050706,
					"content": "たしか数日前、すぐ近くの野外で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050707
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050707,
					"content": "ん？あの者たちは何を…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050708
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050708,
					"content": "まだかよ？あの野蛮人どもにバレる前にテストを済ませないといけないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050709
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050709,
					"content": "他の場所じゃだめなのか？ここだと落ち着いてできないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050710
					],
					"speakerTitle": "そそっかしい宝盗団メンバー"
				},
				{
					"id": 402050710,
					"content": "アホ、雇い主の言葉を忘れたのか？こいつはクーヴァキがないと動かないんだ。そうでもなかったらこんなところ来るかよ…黙って手を動かせ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050711
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050711,
					"content": "大声出さないでくれ、えーっと…たぶんここだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050712
					],
					"speakerTitle": "そそっかしい宝盗団メンバー"
				},
				{
					"id": 402050712,
					"content": "なんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050713
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050713,
					"content": "なにやってんだよ！こんなでかい音、バレちまうだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050714
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050714,
					"content": "す…少なくとも、これでこいつの威力はわかっただろう？これで戻って報告できるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050715
					],
					"speakerTitle": "そそっかしい宝盗団メンバー"
				},
				{
					"id": 402050715,
					"content": "はぁ、そうだな、じゃあ早く片付けてズラかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050716
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050716,
					"content": "待て！その危険物を置いていけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050717
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050717,
					"content": "もうバレたのか！？そいつ、もう一回起動できないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050718
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050718,
					"content": "さっきどうしたか忘れちゃったよ…こんなの持ち上げられない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050719
					],
					"speakerTitle": "そそっかしい宝盗団メンバー"
				},
				{
					"id": 402050719,
					"content": "はぁ…さっさと逃げるぞ！現行犯で捕まるのが一番まずい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050720
					],
					"speakerTitle": "焦っている宝盗団メンバー"
				},
				{
					"id": 402050720,
					"content": "…ということで、捕まえることはできませんでしたが…機械は回収できました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050721
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050721,
					"content": "アイノ、もう一回聞くぞ。また何か危ないものを作っただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050722
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050722,
					"content": "それも誤解なんじゃないか？アッツォが見た機械が、カンカン・アマサヒカエメとは限らないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050723,
					"content": "うーん…その機械にこんなマークってついてた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050724
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050724,
					"content": "ええ、ありましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050725
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050725,
					"content": "これはアイノがみんなのためにデザインしたマークで、バラして改造しても絶対に消えないように、毎回特殊処理を施してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050726
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050726,
					"content": "だから、それは本当にカンカン・アマサヒカエメなんだと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050727
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050727,
					"content": "誤解が解けたなら、持ち主に返そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050728
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050728,
					"content": "お言葉ですが詠月使様、軽率に返してしまうのはよくないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050729
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050729,
					"content": "あの機械はナシャタウンの大砲と似た原理で動いています。ですが、同じように扱うのはいけないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050730
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050730,
					"content": "ナシャタウンの大砲はクーヴァキで何度も「ワイルドハント」を撃退し、この土地を守ってきました。なので、我々はあの大砲を月神様の庇護だと思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050731
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050731,
					"content": "ですが、あの機械は…どちらかと言えば「商品」に近いと思います。悪党が私利私欲を満たすために使う…という状況になりかねません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050732
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050732,
					"content": "こちらの工房の主人はナド・クライの様々な勢力と取引しておられますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050733
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050733,
					"content": "私は…彼女がこの機械を誰かに売るために作ったのではないかと、疑わずにはおられません…一度でも闇市に流れ、濫用されれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050734
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050734,
					"content": "カンカン・アマサヒカエメはアイノの仲間だ！売り物じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050735
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050735,
					"content": "…それはあなたの言い分でしかないでしょう。我々はリスクを冒すわけにはいきません。悪事を企む輩の手に渡ってしまえば、神聖な月の光は冒涜されてしまいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050736
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050736,
					"content": "（だから言ったじゃん…面倒な事になるって…変なことに巻き込まれちまった…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050737
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050737,
					"content": "私としては、危険な機械は破壊してしまうのが一番だと思います。似たような機械が作られることも阻止しなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050738
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050738,
					"content": "カンカン・アマサヒカエメを壊すの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050739
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050739,
					"content": "私たちの事情もご理解ください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050740
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050740,
					"content": "みんな悪いやつだ…！どいて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
			]
		},
