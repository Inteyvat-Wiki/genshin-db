			},
			"dialogs": [
				{
					"id": 402050501,
					"content": "おや、カチャカチャ・クルムカケ工房のご主人ではありませんか！お噂はかねがね…何かお力になれることはありますかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050502
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050502,
					"content": "あたいに任せな…単刀直入に言うけど、最近ここでカチャカチャ・クルムカケ工房のロボットを取引したやつはいるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050503
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050503,
					"content": "…率直に申し上げると、私どもは取引のプラットフォームを提供しているだけなので、取引の内容にまで口出しはしないのですよ。だからこそ、皆さんはうちを選んでくださるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050504
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050504,
					"content": "買いたいものや売りたいものがあるなら、掲示板に張り出していただければ、取引を望む人を募集できますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050505
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050505,
					"content": "そんなに適当なのか？さすが脱法闇市だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050506
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050506,
					"content": "おい！アイノの機械を高く買い取りたいってやつがあるぞ！？カンカン・アマサヒカエメのことじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050507,
					"content": "カンカン・アマサヒカエメは盗まれたんだよ！盗品が売られてるかもしれないのに、取り締まりもしないなんて…キミも悪人なの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050508
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050508,
					"content": "酷い言い草ですな。さっき言った通り、私たちは取引の内容には、絶対に口出ししません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050509
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050509,
					"content": "お客様が揉めた際にも中立の立場を貫き通すことこそが私たちの流儀であり、プロ意識なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050510
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050510,
					"content": "…カンカン・アマサヒカエメはアイノの仲間なのに…商品みたいに取引しようだなんて、許せない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050511
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050511,
					"content": "ああっ、破られては困りますな！少なくとも、今日闇市が閉まるまでの間は、その募集を掲示板に載せたままにしなくてはいけないのです。ご容赦ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050512
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050512,
					"content": "「お客様が揉めた際は中立の立場を貫き通す」んだろ、ほっとけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050513,
					"content": "その募集を張り出したのは、有料会員様ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050514
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050514,
					"content": "プラットフォームを提供する側だって、利益が必要でしょう？もしもっと多くのモラをお支払い頂けるのでしたら、新たな募集でその募集を覆い隠してもいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050515
					],
					"speakerTitle": "ユースタチ"
				},
				{
					"id": 402050515,
					"content": "はぁ…どんな場所にも、そこのルールがある。騒いでも無駄だ。手がかりは見つけたし、とりあえずこの募集をじっくり見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050516
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050516,
					"content": "どれどれ…「高価買取！とある機械を探しています。スタイルから見て、カチャカチャ・クルムカケ工房の作品だと思われます。詳細は直接会った時にお話しします…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050517
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050517,
					"content": "情報屋によると、この機械は一台しか見つかっておらず、現在は霜月の子の手に渡っているようです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050518
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050518,
					"content": "「提供してくださった方には、多額の報酬を提供します…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050519
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050519,
					"content": "霜月の子が持ってるのか？もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050520,
					"content": "工房は霜月の里とナシャタウンの間にあるから、霜月の子の人たちは街に降りてくるとき、工房の前を通っていくんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050521
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050521,
					"content": "だから、アイノたちも霜月の子の人たちにはあまり警戒してなかったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050522
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050522,
					"content": "そういうことなら、霜月の子のやつが盗んだのか？なんでアイノのロボットの仲間を盗んだんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050523,
					"content": "…きっと霜月の子の人たちも、カンカン・アマサヒカエメの作ったお菓子を食べたかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050524
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050524,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050525,
					"content": "いつもイネファがアイノのお菓子を食べる量を制限してくるから、カンカン・アマサヒカエメを作ったの。レシピを入力して、原料を入れてれば自動的にお菓子を作ってくれるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050526
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050526,
					"content": "お菓子を作るロボット？それだけのために？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050527
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050527,
					"content": "はっはっは、そう言えばナド・クライの各勢力を騙せるとでも思っているのか？工房のご主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050528
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050528,
					"content": "誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050529
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050529,
					"content": "アシッコじゃないか…うちの姐さんにも顔が利く大物だ。にしても、なんでわざわざこんな場所へ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050530
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050530,
					"content": "ヴォイニッチ商会と結べる取引もあれば、ここに来ないとできない取引もあるということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050531
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050531,
					"content": "儲け話でさえあれば、私はなんでもいいのだよ。そして、さっき君たちが見ていた募集は、私が貼らせたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050532
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050532,
					"content": "カンカン・アマサヒカエメを取引しようとしてたのはキミだったの？じゃあキミも悪いやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050533
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050533,
					"content": "そう言うな。商売の場に、取引の話はつきものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050534
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050534,
					"content": "確かに、私は君の作品に興味を持っている。以前霜月の子たちから買い取ろうとしたが、あの信徒たちは頭が固すぎて、何の情報も渡してはくれんかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050535
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050535,
					"content": "やはりこういう話は本来の持ち主とすべきだったな。ああいった機械をもう一つ作ってくれないか？報酬は弾む。あの募集の十倍の額でもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050536
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050536,
					"content": "悪いやつと話すことなんてないもん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050537
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050537,
					"content": "あの募集に、取引の手段は明記されていない。奪おうが何しようが気にしないんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050538
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050538,
					"content": "たかがケーキを焼けるだけのロボットだぞ？そこまでするこたぁないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050539
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050539,
					"content": "こうしよう。カチャカチャ・クルムカケ工房に「貸し」を作るってことで、情報屋から聞いた情報を教えてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050540
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050540,
					"content": "その機械には「ドッカン・クーヴァキレーザー砲」に使われている技術が使用されているそうだ。兵器にすれば、凄まじい威力を発揮するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050541
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050541,
					"content": "なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050542
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050542,
					"content": "あの大砲——あれはクーヴァキを破壊的なエネルギーに凝縮できる。だが、大きすぎるし、重すぎる。量産にも運搬にも向いていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050543
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050543,
					"content": "それに、毎回発射前に長時間かけて弾薬を補充しなければならない。つまり、商品化は難しいということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050544
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050544,
					"content": "だが、あれを小型化し、量産できるようにすれば…威力こそ再現できなかろうが——完璧な商品となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050545
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050545,
					"content": "それに、よく考えてみろ。霜月の子が機械を狙った原因も、そこにあるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050546
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050546,
					"content": "あいつらの教義において、クーヴァキは神聖な神の力であり、冒涜は許されない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050547
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050547,
					"content": "ナシャタウンの大砲が、クーヴァキを「ワイルドハント」に対抗する力、住民を守る力として利用していることは許せても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050548
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050548,
					"content": "金さえ払えば誰でもクーヴァキを使えるようになるのは看過できない…あの大砲の技術が商品となって闇市に流れれば、いずれそうなってしまうだろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050549
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050549,
					"content": "それは霜月の子たちにとって、この上なく冒涜的な行為だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050550
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050550,
					"content": "だから、その技術を売ってくれ。そういった面倒なことを私に押し付けると思えば、安いものだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050551
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050551,
					"content": "あんた、またなんか危ないものを作ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050552
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050552,
					"content": "さっきから言ってるでしょ、カンカン・アマサヒカエメはすっごく美味しいお菓子を焼いてくれるロボットなの！戦争兵器なんかじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050553
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050553,
					"content": "カンカン・アマサヒカエメはアイノの仲間だから、絶対助ける！あの子のことはあきらめて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050554
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050554,
					"content": "本来の持ち主と交渉しても無駄か…残念だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050555
					],
					"speakerTitle": "アシッコ"
				},
				{
					"id": 402050555,
					"content": "これからどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050556
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050556,
					"content": "少なくとも、泥棒が霜月の子のほうにいるのはわかったから、向こうに行けば…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050557
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050557,
					"content": "ラウマに手伝ってもらえばいいかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050558
					]
				},
				{
					"id": 402050558,
					"content": "たしかに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050559
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050559,
					"content": "待て、あの商人が言ってたことが本当なら、色々と面倒なことになるぞ。心の準備をしてから行けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
