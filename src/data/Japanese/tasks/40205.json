			"dialogs": [
				{
					"id": 402050401,
					"content": "最後の一個だ！絶対あいつが持ってるぞ！あっ、あっちに逃げた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050402,
					"content": "逃げるな！これでもくらえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050403
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050403,
					"content": "アイノ、危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050404,
					"content": "ぐぬぬぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050405
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050405,
					"content": "アイノー！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050406,
					"content": "うぅ…あ！偵察ユニット——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050407
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050407,
					"content": "アイノの無事が一番だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050408
					]
				},
				{
					"id": 402050408,
					"content": "ふぅ…危なかったな。おまえも、無茶しすぎだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050409,
					"content": "無事でよかった…なかなかの身のこなしじゃないか。あたいの出番かと思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050410
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050410,
					"content": "（無事でよかった…何かあったら、イネファに何て言えばいいか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050411
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050411,
					"content": "無事じゃないよ。カンカン・アマサヒカエメが奪われちゃった…うぅ、アイノはカチャカチャ・クルムカケ工房のボスだから、泣いちゃダメ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050412
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050412,
					"content": "霜月の子を代表して、謝らせてくれ。うちの者がそなたを止めていなければ、奪われることもなかっただろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050413
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050413,
					"content": "詠月使様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050414
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050414,
					"content": "本当に彼女が機械を利益を得る手段としてしか見ておらぬならば、作り直せばよかったはずだ。立場を悪くするだけの正義感など、燃やさねばよかったものを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050415
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050415,
					"content": "満月の明かりですら、彼女の心の粗は映し出せぬ。それに対して、そなたたちの厳しすぎる心は、月の光の届かぬ闇に沈もうとしておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050416
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050416,
					"content": "…私からも謝罪します…申し訳ございませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050417
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050417,
					"content": "誤解が解けたならいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050418,
					"content": "そなたも、そう悲しむでない。心の清き者は、常に月の導きを受けることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050419
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050419,
					"content": "きっと仲間を取り戻せるはずだ。必要なら、うちの者からも手伝いを手配しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050420
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050420,
					"content": "…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050421
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050421,
					"content": "じゃあ、これからどこを探しに行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050422,
					"content": "そんなの火を見るより明らかだろ。やったのは脱法闇市の商人に決まってる。アイノと霜月の子が衝突するのもお見通しだったんだ。だからこそ、その隙を狙った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050423
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050423,
					"content": "もっと言えば、きっとカンカン・アマサヒカエメを盗み出したのも、商人の指示だったんだ。だからロボットがここにあることも知ってたし、事前に計画を立てられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050424
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050424,
					"content": "今のところ、一番怪しいのはアシッコだな。でも、ほかのやつって可能性も捨てきれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050425
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050425,
					"content": "なるほど…ヤフォダはどこに行けばいいかわかってそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050426,
					"content": "（またあたいが動かなきゃいけないのか？あそこの商人はみんな怪しいって言ったばかりなのに…闇市が終われば、どこに行くか分からないんだぞ。はぁ…調子に乗って首を突っ込むんじゃなかった。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050427
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050427,
					"content": "ヤフォダもアイノが悲しむのは見てられないよな。これからも頼りにしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050428,
					"content": "ヤフォダ、頼りにしてるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050429
					]
				},
				{
					"id": 402050429,
					"content": "（…こんなの、断れるわけないだろ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050430
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050430,
					"content": "わかった、じゃあ…少なくとも二日くれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050431
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050431,
					"content": "アイノなら待てるよな。こんなにたくさんの人が助けてくれてるんだ、きっと大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050432,
					"content": "わかってる…みんな、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				}
			]
		},
