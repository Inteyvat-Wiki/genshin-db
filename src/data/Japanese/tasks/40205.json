			"dialogs": [
				{
					"id": 402050101,
					"content": "よう、ラウマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050102,
					"content": "旅人とパイモン？昼も夜も、月光が我らを結ばん——何か悩みがあるなら、言うが良い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050103
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050103,
					"content": "また全部お見通しなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050104,
					"content": "月光に照らされた眉間のしわは、満月のしみのように、雲の間からそなたの心を映し出しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050105
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050105,
					"content": "おっと、お嬢サマがご機嫌斜めになってきた…詠月使さん、悪いけど先にあたいの話を聞いてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050106
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050106,
					"content": "ヤフォダはここに来た経緯を丁寧に、慎重に説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050107
					]
				},
				{
					"id": 402050107,
					"content": "…盗み？霜月の子はそのような卑劣な行為を忌み嫌っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050108,
					"content": "まだ推測でしかないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050109
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050109,
					"content": "少し待ってくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050110
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 402050110,
					"content": "確かに先日、とある機械を持ち帰った一族の者がいる。共に詰問し、真偽を明らかにしようではないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				}
			]
		},
