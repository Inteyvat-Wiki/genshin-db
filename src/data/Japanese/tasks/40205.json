			"dialogs": [
				{
					"id": 402050201,
					"content": "お…落ち着いてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050202
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050202,
					"content": "アイノ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050203,
						402050206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050203,
					"content": "無茶はやめて、アイノ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050204
					]
				},
				{
					"id": 402050204,
					"content": "でもこいつら、カンカン・アマサヒカエメを壊すって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050205
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050205,
					"content": "オイラたちがそうはさせないぞ！でも、無茶苦茶したって、なにも解決しないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050209,
					"content": "大変です——飛行型の機械が私たちの倉庫を襲撃して、あの機械を奪っていきました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050210
					],
					"speakerTitle": "ヘルミ"
				},
				{
					"id": 402050210,
					"content": "こんな時に！？まさか、私たちとこの子が衝突する時を待っていたのか——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050211
					],
					"speakerTitle": "アッツォ"
				},
				{
					"id": 402050211,
					"content": "わわ、偵察ユニットがいっぱいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050212,
					"content": "絶対あの闇市のやつらだ…！あたいらは狙われてたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050213
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050213,
					"content": "ここに簡易的な月霊の道を作るから、月霊を呼んで助けてもらって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050214
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050214,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050215
					]
				},
				{
					"id": 402050215,
					"content": "そうだ、こいつらを墜落させればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050206,
					"content": "アイノの仲間は傷つけさせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050207
					]
				},
				{
					"id": 402050207,
					"content": "おう！だから、オイラたちを信じてくれ！まずは落ち着こうぜ、無茶はダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050208,
					"content": "アイノ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "アイノ"
				}
			]
		},
