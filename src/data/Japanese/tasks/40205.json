			"dialogs": [
				{
					"id": 402050301,
					"content": "よう、ヤフォダ。わぁ、ほんとにたくさん人が集まってるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050302,
					"content": "あたいの情報網をなめないで欲しいね。まずはここの取引記録を調べよう。泥棒は多分、ここで盗品を換金するはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050303
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050303,
					"content": "アイノのロボットの仲間を盗んだのはどこのどいつ！出てきて！説明して！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050304
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050304,
					"content": "（調査ってそういうことじゃねぇよ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050305
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050306
					],
					"speakerTitle": "興味津々の商人"
				},
				{
					"id": 402050306,
					"content": "こいつがあの工房の主なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050307
					],
					"speakerTitle": "興味津々の商人"
				},
				{
					"id": 402050307,
					"content": "ちょうどいいところに来た！取引してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050308
					],
					"speakerTitle": "焦っている商人"
				},
				{
					"id": 402050308,
					"content": "キ、キミたちが泥棒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050309
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050309,
					"content": "泥棒？ここには商人しかいねぇよ。なぁ、ロボットのオーダーメイドを頼めないか。それなりの値段は出すぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050310
					],
					"speakerTitle": "興味津々の商人"
				},
				{
					"id": 402050310,
					"content": "あのメイドロボットはあんたが作ったんだよな！その技術、売ってくれねぇか？俺もメイドロボットが欲しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050311
					],
					"speakerTitle": "焦っている商人"
				},
				{
					"id": 402050311,
					"content": "ど…どいてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050312
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050312,
					"content": "コホン…基本的な礼儀すら知らねぇんだな。脱法闇市で商売するほど落ちぶれるわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050313
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050313,
					"content": "たとえ工房の主があんたたちと取引することに同意したとしても、ここのカウンターできちんと商談に持ってくべきだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050314
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050314,
					"content": "アイノが作る機械はナド・クライ中で大人気なんだ。ここのやつらが押し寄せるのも無理ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050315
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050315,
					"content": "イネファも、カンカン・アマサヒカエメも、売るために作ったんじゃないもん…ここの大人、大っ嫌い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050316
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050316,
					"content": "でも、旅人の言う通り、ここの大人たちは泥棒してたとしてもなんとも思わなさそうだね。アイノの方法じゃだめだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050317
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 402050317,
					"content": "本当にあの方法で泥棒をあぶりだそうとしてたのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402050318,
					"content": "よっぽど世間知らずなんだな。ここの商人には金しか見えてない。道徳なんて、あいつらにとっちゃ一モラにもならないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050319
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 402050319,
					"content": "手がかりはやっぱカウンターじゃないと手に入らなそうだな。ついてきな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤフォダ"
				}
			]
		},
