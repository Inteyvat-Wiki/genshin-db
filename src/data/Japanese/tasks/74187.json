			"dialogs": [
				{
					"id": 741870601,
					"content": "コホン、第九軍団の兵士たちよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741870602,
					"content": "あ？お前らは何者だ？まさか、エストが呼んできた助っ人じゃないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870603,
					"content": "その通りだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "しかも普通の助っ人じゃなくて、とっても強い助っ人なんだぞ！オイラたちはカッシオドル様についてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741870609,
					"content": "#（{NICKNAME}とパイモンは演技の才能があるようだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741870610,
					"content": "えっ…カッシオドル様だって？偉大なる至尊は彼をアルモリカに派遣したと聞いてたが…まさかこんなに早く戻ってきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870611,
					"content": "それは…実はこいつが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741870612,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741870613,
					"content": "コホンッ、とにかく、オイラたちは前線の軍団の状況を確認しに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741870614,
					"content": "そうか、そうだろうと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870615,
					"content": "俺たちは本隊と一緒にカリュブディス砦には行かなかったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870616,
					"content": "だが、ここに残って最後の「後片付け」をするのは、別におかしなことじゃないだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870617,
					"content": "これも「フォボス」の命令なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "それは…「フォボス」は元々俺たちに指示を出してくれるはずだったんだが…ここに来てから、「フォボス」のメロディーが聴こえないことが多くなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870619,
					"content": "それで、俺たちはボエティウス様の指示に従って行動するしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870620,
					"content": "ああ、あの失礼な人か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "おい、お前、よくもボエティウス様のことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870622,
					"content": "尊き調律師であるボエティウス様は至尊のご指示に従って行動なさってきた。ボエティウス様の命令はすなわち「フォボス」の命令だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870626,
					"content": "「フォボス」も過ちを犯すのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "お前は本当にレムリア人か？「フォボス」を作り出したのは、全能の至尊と無謬の予言者であることを知らねえのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870628,
					"content": "#{M#君}{F#あなた}たちはメロディーを聴いてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "うっ…そりゃそうだが。でも「フォボス」以外の何を信じればいいってんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870630,
					"content": "もし俺たちが間違った道を歩んでるんだとしたら、「フォボス」が無視するはずないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870623,
					"content": "人の命を奪えとは言わなかったはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "人の命を奪う、か…戦争が始まる前、至尊は確かに弱き人間を救うよう命じた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870625,
					"content": "だが、俺たちの今の行為も「フォボス」は黙認したんだぞ。「フォボス」の指示が至尊のご意思と食い違うことなど、あり得るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870605,
					"content": "至尊に遣わされた使者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "使者ってなんだよ…おう、その通りだ。オイラたちはカッシオドル様についてきたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741870607,
					"content": "カッシオドル様の従者だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "そうだぞ。オイラたちはカッシオドル様の従者なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "パイモン"
				}
			]
		},
