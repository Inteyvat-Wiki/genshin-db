						741870702
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870702,
					"content": "戦争が始まってから、ずっと胸がもやもやしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870703,
					"content": "俺たちは自由と幸せを求めてたのに、気付いたら「フォボス」に導かれてこんなとこまで来ちまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870704,
					"content": "一体何が間違ってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870705,
					"content": "もし帰って至尊様に会ったら、ここの状況と、俺たちの疑問を伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "隊長"
				},
				{
					"id": 741870706,
					"content": "よろしく頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "隊長"
				},
