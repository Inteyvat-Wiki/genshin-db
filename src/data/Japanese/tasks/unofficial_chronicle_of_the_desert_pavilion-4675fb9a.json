							782.193,
							169.734,
							356.146
						],
						"pointId": 5
					},
					{
						"sceneId": 103,
						"position": [
							780.915,
							169.73,
							357.299
						],
						"pointId": 99
					}
				]
			},
			"dialogs": [
				{
					"id": 700670401,
					"content": "君たち…見かけない顔だな。まだ新人が上がってくるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670402
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670402,
					"content": "いや、みっちゃんが一緒にいるってことは、助けに来てくれたのかい？俺はヴェニエプ、キングデシェレトの体がまだ存在していた時代の人間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670403
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670403,
					"content": "#オイラはパイモン、こっちは{NICKNAME}、こっちはカテリンドだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670404,
					"content": "オイラたちは、最近の人間ってところだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670405,
					"content": "カテリンド…君、お姉さんがいたりしないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670406
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670406,
					"content": "あなたも、姉を知っているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670407
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670407,
					"content": "もちろん。ここに来た人はみんな友人だ。かつての身分なんて関係なくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670408
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670408,
					"content": "俺は元々、キングデシェレトの霊廟を建設する作業員だった。取るに足らない人間さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670409
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670409,
					"content": "あの日、砂漠を歩いていただけなのに、突然選ばれて、無想の間に放り込まれて…そのなかで百年弱、過ごしたのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670410
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670410,
					"content": "外に出てみれば、周りは古代の人間ばかり。中にはキングデシェレトよりも昔から生きている人もいると来た。それでも、俺たちは自由に話ができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670411
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670411,
					"content": "その後、ここの神の姉妹に、砂漠の建築は引き上げていないから記憶を頼りに復元してくれって言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670412
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670412,
					"content": "皆に手伝ってもらって、やっとこのエリアを作り上げたのに…見てくれよ、この瓦礫の山を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670413
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670413,
					"content": "そういえば、聞きたかったんだけど…外にあるあの人の形をした砂の像って、キングデシェレト時代の…えっと…芸術なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670414,
					"content": "砂で人を造ることで、物質的な肉体と生命の無常さを人々に伝えている、とか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670415
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670415,
					"content": "…君は本当に、お姉さんと似てないな。君は他の人たちと同じように、本を読むのが好きなんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670416
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670416,
					"content": "あれは人間だよ。罰を受けて、砂に変えられてしまった人間さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670417
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670417,
					"content": "ええっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670418,
					"content": "安心して、みんな生きてるから。ここに「死」は存在しない。ここの問題さえ解決すれば、全員元に戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670419
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670419,
					"content": "そうだ！前に、助けてくれたらキングデシェレトから貰った硬貨をやる、みたいなこと言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670420,
					"content": "それって、すっごい値打ちのあるお宝なんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670421,
					"content": "あはは、あげないよ！俺のお守りなんだから。それに…俺が地上で生きてた唯一の証だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670422
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670422,
					"content": "そんなに大事なのか…じゃあ、今回は特別に報酬は受け取らないでおいてやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670423,
					"content": "おっと、向こうからやってきたみたいだ——話し込みすぎたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670424
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670424,
					"content": "雑談はここまでにしよう。君って、レムリアの新米百人隊長くらいには強いかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670425
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670425,
					"content": "またそのたとえか…その「新米百人隊長」って、一体どのくらいの実力なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
