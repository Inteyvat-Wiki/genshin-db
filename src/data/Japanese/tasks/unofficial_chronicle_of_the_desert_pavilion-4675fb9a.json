			"dialogs": [
				{
					"id": 700670101,
					"content": "ここはどこなんだ？これで終わりってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670102,
					"content": "おう、終わったぜ。みんな元通りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670103
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670104
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700670104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670105
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670105,
					"content": "どうしたんだ？唇を震わせて。またこうして俺に会えて、感動のあまり涙腺を抑えきれなくなったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670106
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670106,
					"content": "ぷっ、あははははは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670107
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700670107,
					"content": "あはははは…ク、クシャーマ、わ、笑っちゃだめだろ！バレちゃうって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670108
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670108,
					"content": "ふん、好きに笑えよ。お前たちに笑われたからって、俺が余計に恥ずかしくなるわけじゃあるまいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670109
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670109,
					"content": "愛も運命、死も運命だ。別に笑うことじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670110
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670110,
					"content": "ごめんごめん、もう笑わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670111
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670111,
					"content": "そういえば、カテリンドはどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670112,
					"content": "俺もわからないな。元に戻った時には、みんなと扉の外にいたんだ。さっきまで抱き合って喜んでたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670113
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670113,
					"content": "スカルパに「そろそろ抱き合うのはやめにして、みんなを連れて中央エリアに戻ってくれ」って言ったあと、単独でお前たちのところに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670114
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670114,
					"content": "みんなこの辺りにいるはずだし、あいつもそう遠くにはいないと思うけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670115
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670115,
					"content": "これ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670116
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670116,
					"content": "アメジストのブローチみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670117,
					"content": "私のカバンから消えた…お姉ちゃんのものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670118
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670118,
					"content": "おお！じゃあこれで一つ取り戻したな。やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670119,
					"content": "この時代の展示品として、ここに置かれちゃったんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670120
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670120,
					"content": "実は、墓碑に何を書こうか考え始めたのは、お前のお姉さんに聞かれたのがきっかけだったんだ。別に何千年も考えてたわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670121
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670121,
					"content": "ここでは死なないの？じゃあ、墓碑に刻みたい最高の言葉！みたいなのも書くところないのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670122
					],
					"speakerTitle": "ロムヒルダ"
				},
				{
					"id": 700670122,
					"content": "かつての俺の地位を考えると、恐らく祭司たちの墓地に入って、銀白の枝と共に眠ることになってただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670123
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670123,
					"content": "名誉なことではあるが…たしかに文字を刻める墓碑はなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670124
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670124,
					"content": "それなら、あたしはそんな栄誉なんていらない。もう墓碑に何を書くか決めちゃってるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670125
					],
					"speakerTitle": "ロムヒルダ"
				},
				{
					"id": 700670125,
					"content": "教えてあげる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670126
					],
					"speakerTitle": "ロムヒルダ"
				},
				{
					"id": 700670126,
					"content": "とにかく、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670127
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670127,
					"content": "キングデシェレトのコインをくれる気になったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670128,
					"content": "まだ覚えてたのかい。それなら、キングデシェレト様への懺悔の経文を一万回読み上げられたら、君にあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670129
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670129,
					"content": "こいつ、クシャーマからキングデシェレトが亡くなったと聞いたとき、泣くぐらい怒ったんだぜ。「嘘をつくな！」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670137
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670137,
					"content": "「嘘だ！この嘘つきめ！そんなわけない！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670138
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670138,
					"content": "俺が墓碑に刻もうとしてた言葉より、こっちの方が笑えるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670130
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670130,
					"content": "わかった、わかったよ。そこまでイヤならもういいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670131,
					"content": "ふん、だったら——「オイラたちはカテリンドのなくした物を探しに来ただけだぞ」って言っとくか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670132,
					"content": "おまえたちを助けるのはついでだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670133,
					"content": "#…パイモン、{NICKNAME}さん、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670134
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670134,
					"content": "気にすんな！元々、オイラたちが巻き込んじゃったみたいなもんだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670135,
					"content": "俺にもそれくらい優しくしてもらいたいものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670136
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670136,
					"content": "…本当に、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カテリンド"
				}
			]
		},
		{
			"id": 7006702,
