				]
			},
			"dialogs": [
				{
					"id": 700671001,
					"content": "ヴェニエプ！生きてたんだな、よかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671002
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671002,
					"content": "もちろん、ここじゃ死ねないのは知ってるさ。砂になってなくてよかった、って言いたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671003
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671003,
					"content": "とにかく、言いたいことはわかんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671004
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671004,
					"content": "まあね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671005
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671005,
					"content": "みんな、本当にありがとう——みっちゃんもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671006
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671006,
					"content": "私は何もしてませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671007
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700671007,
					"content": "ヴェニエプが紹介してくれたので、ウィトルウィウスにもこれまでの経緯を説明した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671008
					]
				},
				{
					"id": 700671008,
					"content": "ベテラン百人隊隊長以上の実力とはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671009
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671009,
					"content": "おまえの戦闘力が最終的にどういう評価になるのか気になってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700671010,
					"content": "でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700671011
					]
				},
				{
					"id": 700671011,
					"content": "じゃあ、俺がみんなのところに連れて行ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671012
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671012,
					"content": "ふふん、ヴェニエプは、あくまでキングデシェレト時代の建築の紋様と装飾スタイルを提供してくれただけだからな。この辺りのだいたいの構造と通路に関しちゃ、俺が担当したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671013
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700671013,
					"content": "その通り。見た目はメッキ時代の建築のようだけど、実はみんなの知識の結晶なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェニエプ"
				}
			]
		},
