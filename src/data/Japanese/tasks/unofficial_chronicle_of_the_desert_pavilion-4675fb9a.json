						"position": [
							775.416,
							187.536,
							452.886
						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 700671501,
					"content": "ヴェニエプ！みっちゃん！ロムヒルダと新顔さんも…本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671502
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671502,
					"content": "…私はロムヒルダの妹のカテリンドです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671503
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700671503,
					"content": "そうなの。ふたりとも本当によく似ていて美人ね。私はクシャーマ、マハー…あれ？えっと、何を言おうとしたんだっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671504
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671504,
					"content": "そうなの。ふたりとも本当によく似ていて美人ね。私はクシャーマ、マハールッカデヴァータの時代から来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671505
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671505,
					"content": "草の神様がまだ小さくなかった時代よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671506
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671506,
					"content": "ヴェニエプがクシャーマに紹介してくれた。ヴェニエプは、彼女に先ほどウィトルウィウスの身に起きた悲しい出来事と…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671507
					]
				},
				{
					"id": 700671507,
					"content": "彼が数千年、あるいは数万年もかけて考えた、墓碑に刻む言葉について話した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671508
					]
				},
				{
					"id": 700671508,
					"content": "あー、笑い死ぬかと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671509
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671509,
					"content": "ウィトルウィウスには俺から聞いたって言わないでくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671510
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671510,
					"content": "無理よ、今後見かけるたびに笑っちゃいそうだもの。すぐバレちゃうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671511
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671511,
					"content": "さて、無駄話はここまでだ——もう全部の場所を探したかな？見落とした場所はない…はず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671512
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671512,
					"content": "まだ見つけられてない人はいないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671513
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671513,
					"content": "もういないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671514
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671514,
					"content": "じゃあ、砂になった人を戻す方法について、何かわかったことはないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671515
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671515,
					"content": "今までの探索では、特に何も…「砂上の楼閣」のみんなは、からくりや科学には疎いしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671516
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671516,
					"content": "結局、「ガモラの処罰者」を倒すしかないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671517
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671517,
					"content": "#それなら心配いらないよ。俺たちにはレムリア副軍団長クラスの戦闘力を持つ{NICKNAME}がいるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671518
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671518,
					"content": "あら、また昇格しましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671519
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700671519,
					"content": "でも、「ガモラの処罰者」は姿を隠してるから、なかなか見つからないのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671520
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671520,
					"content": "そうなんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671521
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700671521,
					"content": "おまえたち、せっかく助かったんだし…とりあえず神殿の中心に避難したらどうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700671522,
					"content": "あそこにはイストリアとジョセフスもいるしな。物知りみたいだったし、あいつらなら、なんとかする方法を知ってるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700671523,
					"content": "あら！イストリアってば無事だったのね。よかったわ…一番の古株で勉強熱心なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671524
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671524,
					"content": "博学だし、歴史や文化についてもたくさん知ってるし…この世で一番の物知りだと言っても過言じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671525
					],
					"speakerTitle": "クシャーマ"
				},
				{
					"id": 700671525,
					"content": "なら、急ごう。早く戻って詳しい話を聞いて、ウィトルウィウスとみんなを助け出すんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェニエプ"
				}
			]
		}
	]
}