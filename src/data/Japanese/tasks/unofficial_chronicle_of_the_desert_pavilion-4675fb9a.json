			"dialogs": [
				{
					"id": 700670301,
					"content": "こっちに来るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670302
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670302,
					"content": "こんなところで自分の墓碑に何を書くか考えるなんて、贅沢すぎるのはわかってるけど、実は…笑わないでくれよ。もう考えてあるんだな、これが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670303
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670303,
					"content": "「俺の愛を、パトラポリスの——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670304
					],
					"speakerTitle": "ウィトルウィウス"
				},
				{
					"id": 700670304,
					"content": "ウィトルウィウス！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670305,
					"content": "言い終わる前に、砂になっちゃいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670306
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670306,
					"content": "ダメだ…悲しむべきなのに、笑いが…砂から戻ったら、死ぬほど気まずいだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670307
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670307,
					"content": "楽観的なんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670308
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670308,
					"content": "先にあの守衛を処理するか、急いで生存者を捜索するか、決めないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェニエプ"
				}
			]
		},
