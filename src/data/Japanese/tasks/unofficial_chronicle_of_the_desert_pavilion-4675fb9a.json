			"dialogs": [
				{
					"id": 700670701,
					"content": "おお、すごい。少なくともベテラン百人隊長クラスの実力はあるようだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670702
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670702,
					"content": "#{M#君}{F#あなた}の国には、いいたとえはなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670703
					]
				},
				{
					"id": 700670703,
					"content": "大方広の間にいる教養のある人たちのほうが、論理的に戦闘力を比べてくれそうだから、彼らの基準に従っただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670704
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670704,
					"content": "はぁ、教養があるっていいよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670705
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670705,
					"content": "知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670706
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670706,
					"content": "エリニュスの部下の騎士たちは、一人で三人のレムリア百人隊隊長と戦えたそうだよ。それでもエリニュスにはかなわないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670707
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670707,
					"content": "ワニの王の配下のメジャイは精鋭とは呼べないけど、魔獣の対処に長けてた。その実力は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670708
					],
					"speakerTitle": "ヴェニエプ"
				},
				{
					"id": 700670708,
					"content": "わ、わかったから、それよりも先におまえの友達を助けに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670709,
					"content": "続きが気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670710
					]
				},
				{
					"id": 700670710,
					"content": "また今度な！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
