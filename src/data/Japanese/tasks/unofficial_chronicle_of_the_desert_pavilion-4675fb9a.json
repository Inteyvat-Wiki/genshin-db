					},
					{
						"sceneId": 103,
						"position": [
							712.414,
							175.657,
							423.585
						],
						"pointId": 163
					},
					{
						"sceneId": 103,
						"position": [
							712.293,
							175.641,
							422.247
						],
						"pointId": 164
					}
				]
			},
			"dialogs": [
				{
					"id": 700670201,
					"content": "イストリア、来たんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670202,
					"content": "うん。「砂上の楼閣」のみんなが本殿に戻ってきたから、急いで合流しに来たよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670203
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670203,
					"content": "カテリンドのものは見つかったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670204
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670204,
					"content": "心配してくださってありがとうございます。無事見つかりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670205
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670205,
					"content": "それは良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670206
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670206,
					"content": "そういえば、メランタとニヒリットの名前の意味を知っているかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670207
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670207,
					"content": "はいはい！知らないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670208,
					"content": "「憂鬱」と「虚無」…ですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670209
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670209,
					"content": "物知りだね。本を読むのが好きなのかな？君とはお姉さんよりも仲良くなれそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670210
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670210,
					"content": "はい、お姉ちゃんは活発で、体を動かすことの方が好きでした…でも、私が字を読めなかった頃は、たくさんの物語を読み聞かせてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670211
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670211,
					"content": "そんな人が、どうして憂鬱に取り憑かれてしまったのだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670212
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670212,
					"content": "あっ、苦しむ我々をよそに高みの見物を決め込んでいるあの守護者の事じゃない。心理的な方の憂鬱さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670213
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670213,
					"content": "…姉はそこまで話していたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670214
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670214,
					"content": "彼女が療養所に入所したって話も聞いたよ。現代の人間が、空の神殿の天へと昇る遺跡に療養所を建てるなんてね…とんでもない話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670215
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670215,
					"content": "実は元々、「憂鬱」は生理的な病変だと考えられていたんだよ。憂{RUBY#[D]メランコリー}鬱の語源が「黒い胆汁」であるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670216
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670216,
					"content": "でも、後にそれは心因性の病気だと考えられるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670217
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670217,
					"content": "時代に合わせて、認識って変わっていくものだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670218,
					"content": "そう——現代で、人々がやっとその真実を再発見した。病気には薬と温かな付き添いが欠かせない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670219
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670219,
					"content": "僕の時代はみんな知っていたことなんだけどね…天の使いが直接教えてくれたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670220
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670220,
					"content": "天の使いや風神の詩歌が憂鬱な気持ちを癒せるからといって、一般人の当たり障りない慰めにも同じ効果があるとは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670221
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670221,
					"content": "つまり…どういうことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670222
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670222,
					"content": "これは秘密だから、大きな声では言えないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670223
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670223,
					"content": "どうして空と空間の力を司る偉大な神は、自分の創造物に「虚無」と「憂鬱」という名前を付けたか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670224
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670224,
					"content": "それは恐らく、共感能力が欠けているからだ。彼女は全能だけど、無意味な物事や心の病に対しては、なす術を持たないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670225
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670225,
					"content": "だから彼女は、自身が最も苦手とするその二つを創造物の名前にしたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670226
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670226,
					"content": "わかる気がするぞ。勝てない宿敵って、なんかかっこよくて強そうなイメージだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670227,
					"content": "#ちなみにオイラの宿敵は、「腹ペコ」と「モラ欠」と「{NICKNAME}欠」だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700670228,
					"content": "すごく弱そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670229
					]
				},
				{
					"id": 700670229,
					"content": "悠久の時を生きてきたからこその知恵…ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670230
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 700670230,
					"content": "はは、知恵だなんて…そんなに大げさなものじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670231
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670231,
					"content": "僕はもう一度生きる機会のために、全てを捨てる勇気が欲しいんだ。分かるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670232
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670232,
					"content": "助けが必要になったら、僕のところに来てくれ。お姉さんの話もしてあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670233
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 700670233,
					"content": "…はい、そうします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カテリンド"
				}
			]
		},
