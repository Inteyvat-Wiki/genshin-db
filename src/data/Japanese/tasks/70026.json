				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260101,
					"content": "こんにちは、またお会いしましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260102,
					"content": "あなたの最近の依頼完了記録は実にすばらしいものです。冒険者協会のスター会員と言っても過言ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260103,
						700260105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260103,
					"content": "それほどでも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260104
					]
				},
				{
					"id": 700260104,
					"content": "我々冒険者協会稲妻支部は日頃から他の支部との交流があります。あなたのモンドと璃月での活躍は耳に入っているので、謙遜する必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260107,
					"content": "実は、比較的簡単な調査をあなたに依頼したいのです。調査対象は鶴観エリアにあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260108,
					"content": "鶴観エリアは独特な気候で、霧が濃いのですが、調査を行うだけなら、大した危険はないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260109,
					"content": "協会はこの調査をとある経験豊富な冒険者に依頼したことがありますが、鶴観に到着した途端に戻ってきて、依頼を放棄しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260110,
					"content": "その冒険者は特に何も説明せず、ただ自分の力不足だと言って、諦めたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260111,
					"content": "あれ以来、この依頼を受けてくれる人はおらず、依頼人も焦って何度も状況を聞きに来ているのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260112,
					"content": "そこで経験豊富で、サバイバルに慣れた冒険者を雇えば、この依頼を完璧にこなせるはずだと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260113,
					"content": "そこで、あなたを思いついたのです。旅人さん、引き受けてくれますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260114,
						700260117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260114,
					"content": "なんだかあやしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260115
					]
				},
				{
					"id": 700260115,
					"content": "そのように感じるのは無理もありません。あの冒険者が諦めたのも、予想外のことでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260116,
					"content": "鶴観は人けの少ないところです。協会でもあそこの状況をほとんど把握していません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260120,
					"content": "そうですね、ならば少しだけ依頼の要求を下げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260121
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260121,
					"content": "もし調査エリアで危険に遭遇した場合、無理をせず、協会に戻って助けを求めてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260122,
					"content": "依頼人はスメール「教令院」の学者です。本来は鶴観の気象を研究する予定でしたが、調査中に問題が発生したとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260123
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260123,
					"content": "そこで協会へ協力の依頼を出したのです。その学者は確か、研究費の大部分を依頼にお支払いしたので、とても手厚い報酬となっています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260124,
						700260125
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260124,
					"content": "引き受ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260126,
					"content": "依頼を引き受けてくれてありがとうございます。すぐに調査地点を地図に標記しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260127
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260127,
					"content": "調査の際は、くれぐれも安全に気を付けてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260128
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260128,
					"content": "星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260125,
					"content": "やってみてもいいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260117,
					"content": "考えてみる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260118
					]
				},
				{
					"id": 700260118,
					"content": "依頼に未知なる危険を感じたから、躊躇っているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260119,
					"content": "実は、他の冒険者に同じような理由で断られたことがあります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260105,
					"content": "話したいことがあるならどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260106
					]
				},
				{
					"id": 700260106,
					"content": "やはり噂通り、話が早いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 7002602,
			"completionStepIds": [
				7002603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002603",
							"2"
						],
						"stepId": 7002603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260201,
					"content": "旅人さん、お帰りなさい。状況はどうでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260202,
					"content": "「復活する遺跡重機」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260203
					]
				},
				{
					"id": 700260203,
					"content": "調査エリアに出現する奇妙な遺跡重機、何度倒しても立ち上がってくる…これに関して、依頼人は全く言及していませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260204
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260204,
					"content": "もしかしたら、あの冒険者が落ち込んでいたのも、その奇妙な遺跡重機が原因なのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260205
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260205,
					"content": "このような命を脅かす大事なことは、もっと早く私たちに説明するべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260206
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260206,
					"content": "依頼内容を確認する際、情報を漏れなく提供するよう何度も強調したのですが…ホッセイニさんはどうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260207
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260207,
					"content": "表現が不明確だったり、内容が漏れていたり、最近の依頼はそのようなものが多いです。このようでは、安心して冒険者に依頼を任せることができません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260208,
						700260210
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260208,
					"content": "お疲れ様…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260209
					]
				},
				{
					"id": 700260209,
					"content": "私は大丈夫です。ただ、依頼人にはしっかりと、説明責任を果たしてもらいたいと思うのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260212,
					"content": "すみません。つい余計なことを話してしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260213
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260213,
					"content": "あなたと依頼人が直接話したほうが一番合理的だと思います。「復活する遺跡重機」については、彼に直接聞いてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260214
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260214,
					"content": "しかし彼はこのような調査結果を、受け入れてくれるのでしょうか。調査を続行したいのなら、依頼人も一緒に方法を考えてくれるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260215
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260215,
					"content": "こちらもしっかりと状況を記録しておきます。依頼が続行されるのであれば、協会はあなたを全力でサポートいたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260216
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260216,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260217
					]
				},
				{
					"id": 700260217,
					"content": "それではホッセイニさんと連絡を取り、相談してみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700260210,
					"content": "それも冒険の一部だから気にしてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260211
					]
				},
				{
					"id": 700260211,
					"content": "協会と依頼人のために代弁することも、私の仕事です。同時に冒険の一部…とも言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 7002603,
			"completionStepIds": [
				7002604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002604",
							"2"
						],
						"stepId": 7002604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ホッセイニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260301,
					"content": "鶴観に関する研究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260302,
						700260303
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260302,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				},
				{
					"id": 700260304,
					"content": "おお、ちょうど協会から届いたばかりの状況説明を読んでいて、君が依頼を引き受けてくれたんじゃないかと思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260305
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260305,
					"content": "今回の調査依頼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260306
					]
				},
				{
					"id": 700260306,
					"content": "はぁ、君が言いたいことは知っている。先ほどキャサリンさんに怒られたから、状況は把握している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260307
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260307,
					"content": "私が依頼した調査エリアに「復活する遺跡重機」が出現したということだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260308,
						700260309
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260308,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260310,
					"content": "その遺跡重機は見たことあるが、まさか「復活」するだなんて、予想外の事態だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260311
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260311,
					"content": "稲妻に来てから、噂の霧に覆われた鶴観に興味を持ち始めた。自ら調査に行ったこともある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260312
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260312,
					"content": "鶴観は予想以上のもので、素晴らしい研究対象だ。しかし、何回も調査に行ったが全て失敗し、何の収穫も得ていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260313
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260313,
					"content": "ちょうどそのように思っていた時、この霧に覆われていない島と、あの遺跡重機を発見した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260314
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260314,
					"content": "だが万全な準備をしていなかったため、島に上陸してすぐ離れることになった。遺跡重機は確かにこの目で見たが、細かくは観察できなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260315
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260315,
					"content": "わざと隠してたわけではない。実を言うと、冒険と研究は似ていて、予想外の状況がよく現れる。そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260316
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260316,
					"content": "ただ、よくよく考えてみると、今回の状況は少しだけ心当たりがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260317
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260317,
					"content": "私の推測はこうだ。その遺跡重機は自己修復機能を搭載しており、十分なエネルギー供給によって、各機能が正常に動作している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260318
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260318,
					"content": "通常の遺跡重機と比べるとだいぶ進化している。恐らく、遺跡重機の特別な型番だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260319
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260319,
					"content": "遺跡重機のような自律装置は混沌の炉心によってエネルギー供給されている。混沌の炉心がダメージを受けると、機体の動力が不足して動かなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260320
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260320,
					"content": "しかしその特異体は違って、外部からエネルギーを取り込むことができる…その外部エネルギーというのは、恐らく地脈エネルギーの可能性が高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260321
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260321,
					"content": "古代文明におけるエネルギー応用に関して、私はある程度の知識を持っている。文献によると、かつては永遠に動作し続ける自律装置が存在していたとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260322
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260322,
					"content": "文献が正しければ、恐らくその特異体は古代文明によるエネルギー研究の産物で、とても重要な研究対象になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260323
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260323,
					"content": "なんとかして動作を止めて、本格的な研究を行わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260324
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260324,
					"content": "方法はあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260325
					]
				},
				{
					"id": 700260325,
					"content": "方法は…3つあるが、その内の2つは効率が悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260326
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260326,
					"content": "少し考えさせてくれ。おっ、そうだ、ちょうどいいではないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260327
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260327,
					"content": "稲妻に来る前、私は教令院でいくつかの文化財の持ち出しを申し込み、新しい課題を挙げた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260328
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260328,
					"content": "それを故郷の友達に送ってくれるよう頼んだが、今さっきそれが届いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260329
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260329,
					"content": "その中には古代機器の「プルシナスパイク」が何組か入っている。理論上、地脈の力を乱す力を放出できるから、特異体のエネルギー供給を遮断できるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260330
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260330,
					"content": "しかし原因は分からないが、この「プルシナスパイク」は不具合が発生している。運搬中に破損したのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260331,
						700260332
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260331,
					"content": "じゃあどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260333,
					"content": "学術研究にはこのような予想外のことがよく発生する…ははっ、慣れれば問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260334
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260334,
					"content": "私も君も「プルシナスパイク」を使用する必要があるなら、一緒に協力して修理しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260335,
						700260338
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260335,
					"content": "なんだか利用されてる気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260336
					]
				},
				{
					"id": 700260336,
					"content": "そんなとんでもない。我々の目的は一致しているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260337
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260337,
					"content": "それに、私は他人に迷惑をかけることは好まない。「教令院」の名声を傷つけてしまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260341,
					"content": "分かった、信じる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260342
					]
				},
				{
					"id": 700260342,
					"content": "感謝する。ならば協力は頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260343
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260343,
					"content": "「プルシナスパイク」の修理の難点は、必要となる部品の素材が特殊で、大量生産が難しいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260344
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260344,
					"content": "古いもので修理を行うのが一般的な方法だ。つまり、同じ部品を使う古代遺物を集め、それらから取り出す必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260345
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260345,
					"content": "幸い、このような部品は古代遺跡でよく見かける。地下に古代遺跡群が埋まっていれば、部品も手に入るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260346
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260346,
					"content": "もちろん、古代遺物群が見つからないという心配もしなくていい。私には既存の効率を上げる装置がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260347
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260347,
					"content": "君に渡す装置は「アイシャ混沌探知機」と言う。動作原理は複雑であるため、説明は割愛する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260348
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260348,
					"content": "とにかく、「アイシャ混沌探知機」は古代遺物群または地脈エネルギーの異常を探知すると反応する。観測の精度も…比較的高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260349
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260349,
					"content": "当面の課題は、探知機を使って地中深くに埋まっている部品を探し出すことだ。十分な数の部品が見つかれば、修理と調整を始められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260350
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260350,
					"content": "部品収集は数日かかるかもしれないが、決して焦る事のないように。地道な研究精神を持って臨んでいこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260351
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260351,
					"content": "説明は以上だ。理解したのなら、この偉大なる装置を試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260338,
					"content": "本当に効果があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260339
					]
				},
				{
					"id": 700260339,
					"content": "実際に「プルシナスパイク」を使ったことはないが、それの駆動原理は学術界で検証されている。理論は決して嘘をつかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260340
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260340,
					"content": "私を信じなくても構わないが、科学の力は信じて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 700260332,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260309,
					"content": "全く知らなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260303,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				}
			]
		}
	]
}