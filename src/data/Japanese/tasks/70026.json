	"talks": [
		{
			"id": 7002601,
			"completionStepIds": [
				7002601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
