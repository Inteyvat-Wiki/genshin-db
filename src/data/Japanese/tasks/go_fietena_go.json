			"dialogs": [
				{
					"id": 402200101,
					"content": "自分を責めないで、ミニー。あなたのせいじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200102
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200102,
					"content": "ああ、十分よくやったよ…ゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200103
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402200103,
					"content": "イーガンさん、慰めなくていいよ。そんな体調だと、ここまで来るだけでも大変だったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200104,
						402200105
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200104,
					"content": "競技の結果はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				},
				{
					"id": 402200106,
					"content": "旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402200107,
					"content": "わたしから説明を…ごめんなさい、栄誉騎士様。怪我人を抱えてゴールに着いた時にはもう、他のチームの選手たちはとっくにゴールしてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200108
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200108,
					"content": "怪我人は救護員が検査に連れていってくれたけど、わたしたちのチームは…いい成績を残せませんでした。ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200109
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200109,
					"content": "みんな、あんなに頑張って走ってくれたのに、わたしが足を引っ張っちゃいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200110
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200110,
					"content": "ミニー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200111
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402200111,
					"content": "怪我をした人を見かけた時、実はすごく迷ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200112
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200112,
					"content": "みんな、何日も頑張って練習を重ねてきた。もしわたしが戻ってあの人を連れていかなかったら、こんな成績にはならなかったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200113
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200113,
					"content": "救護員もアンバーさんも近くにいたし、みんなもそんなに離れてなかった。わたしが助けなかったとしても、あの人が命を落とすことはなかったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200114
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200114,
					"content": "なのに、耐えられなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200115
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200115,
					"content": "大丈夫だよ～ミニーちゃん。分かってるからぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200116
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200116,
					"content": "怪我してる人を放っておくことなんて、できないよねぇ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200117
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200117,
					"content": "「炎魂戦士なら、助けを求める手を絶対に握るはず。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200118
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200118,
					"content": "えっと、そのセリフは何巻から引用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200119
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200119,
					"content": "わたしが今考えたの、えへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200120
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200120,
					"content": "…隊長、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200121
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200121,
					"content": "ミニー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200122
					],
					"speakerTitle": "シェリリン"
				},
				{
					"id": 402200122,
					"content": "大きな事故がなくてよかった。びっくりしたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200123
					],
					"speakerTitle": "シェリリン"
				},
				{
					"id": 402200123,
					"content": "ミニー、お前の命より大切なものなんてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200124
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200124,
					"content": "もう危ないことはしないでちょうだいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200125
					],
					"speakerTitle": "シェリリン"
				},
				{
					"id": 402200125,
					"content": "お父さん、お母さん。ごめん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200126
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200126,
					"content": "ちょっとしたトラブルにより、輝かしい成績を収められなかった。悔しいけれど、これが現実というものだ。努力が必ず実るとは限らない。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200127
					]
				},
				{
					"id": 402200127,
					"content": "でも、みんなの笑い声と、それまで重ねてきた努力が確かにそこにあった。いつか、このことが別の形で実を結ぶかもしれない。\\nミニーは少し苦い表情をしていたが、同時に安心したような表情も浮かべていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200128
					]
				},
				{
					"id": 402200128,
					"content": "ミニー選手、体の具合はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200129
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200129,
					"content": "あ、審判さん。平気です、問題ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200130
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200130,
					"content": "…あなたは、さっきの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200131
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200131,
					"content": "どうも。「飛雷の稲光」チームの謙三だ。君が助けてくれたおかげで大怪我を免れた。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200132
					],
					"speakerTitle": "困惑している稲妻の選手"
				},
				{
					"id": 402200132,
					"content": "聞いてくれ。「飛雷の稲光」チームの全員と、俺たち組織委員会で話し合ったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200133
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200133,
					"content": "ミニー選手が他のチームの選手を助けるために戻った行為は、称賛に値するものだ。そして組織委員会一同、この事故がなければチーム「炎魂戦士」の成績はもっと良かったはずだと認めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200134
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200134,
					"content": "現時点でチーム「炎魂戦士」の順位はメダル授与にはほど遠いが、検討の結果、栄誉を受けて然るべきと判断した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200135
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200135,
					"content": "そこで、上位チームへ授与するメダルに加え、特別なメダルを授与しようと思う。命を優先した行動を称えるためにもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200136
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200136,
					"content": "ありがとうございます、ドゥラフさん。お父さん、お母さん。約束はちゃんと守るよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200137
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200137,
					"content": "ああ。前に約束したとおりにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200138
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200138,
					"content": "…ちゃんと安全を優先するなら、旅へ出ても構わないよ、ミニー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200139
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200139,
					"content": "えっ？でもわたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200140
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200140,
					"content": "父さんから見て、お前はもう十分「入賞」を果たしていると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200141
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200141,
					"content": "ふふっ、そうね。そのメダルが何よりの証拠よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200142
					],
					"speakerTitle": "シェリリン"
				},
				{
					"id": 402200142,
					"content": "父さんからの提案だが、みんなで家族旅行にでも行こうじゃないか。お前の大好きな八重堂に行ってみるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200143
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200143,
					"content": "父さんや母さんのような大人が楽しめる漫画は見つかるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200144
					],
					"speakerTitle": "モリッツ"
				},
				{
					"id": 402200144,
					"content": "よかったねぇ、ミニーちゃん。最高のスタートだよ～。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200145
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200145,
					"content": "わたし…すごく嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200146
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200146,
					"content": "まさに思い出の瞬間だね。記念に写真を残さないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200147
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200147,
					"content": "そうだねぇ。みんなで一緒に撮ろう～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200148
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200148,
					"content": "なら『炎魂戦記』第二巻で、フィエテナが初めてマーヴィカと共闘するシーンを再現した写真にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200105,
					"content": "ミニー、体の調子はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				}
			]
		},
