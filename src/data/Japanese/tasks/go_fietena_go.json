			"dialogs": [
				{
					"id": 402200201,
					"content": "もうすぐ競技が始まるぞ。みんな準備はどうだ？来る途中ですごい数の人を見たぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402200202,
					"content": "タオルよし、熱々のスープ、それから防寒用の毛布もよし。うん…足りないものはなさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200203
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200203,
					"content": "事前に話し合ってたとおり、隊長たちは今ウォーミングアップ中のはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200204
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200204,
					"content": "正式にスタートしたら、私はゴールで待機していつでも水と毛布を配れるように準備しておくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200205
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200205,
					"content": "わたし、さっき家から来たばかりなんだけど、もうすぐ競技が始まるよ？ウォーミングアップ、まだ終わってないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200206
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200206,
					"content": "確かにちょっと遅いね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200207
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402200207,
					"content": "ヴァレサとシロネンはのんびりやるようなタイプじゃないしな…オイラたちが様子を見てくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402200208,
					"content": "じゃあ、お願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミニー"
				}
			]
		},
