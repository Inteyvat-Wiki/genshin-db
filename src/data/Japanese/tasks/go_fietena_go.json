			"dialogs": [
				{
					"id": 402201601,
					"content": "あっ、ヴァレサたちがようやくテントから出てきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402201602,
					"content": "深刻そうな顔をしてるけど、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402201603,
					"content": "イーガンが熱を出した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201604
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201604,
					"content": "うぅ…もっと気にかけていればよかった…イーガンさんがくしゃみをしてた時に何度か聞いたんだけど、大丈夫だって言うからぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201605
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201605,
					"content": "きっと競技に支障が出るのがいやで、無理してたんでしょ。そしたら今日になって熱が出て、完全に寝込んじゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201606
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201606,
					"content": "もう組織委員会には連絡して、薬とか防寒用具は全部揃ってるし、医療スタッフも派遣してくれたみたいだから、そんなに心配はいらないよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201607
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201607,
					"content": "でもさ…もうすぐ競技が始まるんだろ？つまり、出場メンバーが一人足りないってことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402201608,
					"content": "そうなの～どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201609
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201609,
					"content": "この大会はみんなにとってすごく大事なものだし、ミニーちゃんのご両親もゴールで見てるはず…だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201610,
						402201611
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201610,
					"content": "#{M#俺}{F#私}が出るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201612
					]
				},
				{
					"id": 402201612,
					"content": "ウチらもそれは考えたんだ。そもそも一緒にトレーニングしてたし、コースも知ってる。体力も野外活動の経験も申し分ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201613
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201613,
					"content": "でも、こんなタイミングであんたを仲間に入れるのって、重大な局面で逃れようのない任務をわざと押し付けてるみたいで、ちょっと忍びないんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201614
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201614,
					"content": "一番大事なのは、旅人さんの気持ちじゃないかな～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201615,
						402201616,
						402201617
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201615,
					"content": "ミニーにとってすごく大事な大会だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201618
					]
				},
				{
					"id": 402201618,
					"content": "わぁ…さすが「トゥマイニ」だねぇ。どこにいても、きみはわたしたちの英雄。誇りであり、希望だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201619
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201619,
					"content": "ほらほら、時間ないんだし感動するのは後にしよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201620
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201620,
					"content": "簡単に説明しとくよ。ウチら四人のリレー順だけど、ウチ、旅人、ヴァレサ、最後がミニーね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201621
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201621,
					"content": "あんたの走るルートは上り坂だから、あんまり一気に飛ばさず、体力を温存することを忘れないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201622
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201622,
					"content": "ウチと交替したら、指示に従って前に走って。ヴァレサが神像のところで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201623
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201623,
					"content": "うんうん！わたしたちなら絶対やれるよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201624
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201624,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201625
					]
				},
				{
					"id": 402201625,
					"content": "じゃ、出発。スタートラインに行こ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201616,
					"content": "モンドに来たことを無駄にはさせない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201618
					]
				},
				{
					"id": 402201617,
					"content": "「炎魂戦士は簡単にはあきらめない。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201618
					]
				},
				{
					"id": 402201611,
					"content": "#{M#俺}{F#私}がやってみようか？",
					"roleType": "TALK_ROLE_PLAYER",
