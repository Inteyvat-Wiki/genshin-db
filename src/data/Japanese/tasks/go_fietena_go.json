			"dialogs": [
				{
					"id": 402201201,
					"content": "入賞はできなかったけど、メダルはもらえたねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201202
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201202,
					"content": "すまん…ゴホゴホッ…こんな時に風邪をひくなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201203
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402201203,
					"content": "大丈夫だよ、イーガンさん。体を大事にしなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201204
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402201204,
					"content": "一緒に競技に出ることはできなかったけど、少なくとも集合写真は撮れたしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201205
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402201205,
					"content": "ま、悔しいんなら次の大会にも出たらいいじゃん。そこで金メダルを獲ってやろーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201206
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402201206,
					"content": "ゴホッ…次こそは必ず俺も…ゴホッ、出場するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201207
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402201207,
					"content": "ひとまずゆっくりしなさい。次は風邪をひかないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201208
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402201208,
					"content": "隊長。万が一に備えて、次は私もトレーニングに参加する。補欠メンバーは一人でも多くいたほうがいいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201209
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402201209,
					"content": "じゃあ、約束ね～次もみんなで集まろう～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402201210
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402201210,
					"content": "#もちろん{M#俺}{F#私}も行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402201211
					]
				},
				{
					"id": 402201211,
					"content": "うん、約束する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミニー"
				}
			]
		},
