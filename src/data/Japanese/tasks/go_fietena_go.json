			"dialogs": [
				{
					"id": 402200501,
					"content": "選手の皆さん、観客の皆さん、ごきげんよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200502
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200502,
					"content": "組織委員会より、今回のドラゴンスパイン国際クロスカントリー大会の審判に任命されたドゥラフだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200503
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200503,
					"content": "各チーム、競技のルールを遵守するとともに、自らの限界を超え、良い成績を出してほしいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200504
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200504,
					"content": "また、雪山の地形は非常に険しい。事故を未然に防ぐため、できる限りコース上を走行するよう努めてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200505
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200505,
					"content": "組織委員会が事前にコースを整備しているが、雪山という環境はそう単純ではない。コースを外れれば、依然として危険は残っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200506
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200506,
					"content": "そしてもう一つ、忘れないでほしいことがある。体調が優れず完走できない事態や、思わぬ怪我があった場合は、コースの脇で休むように。組織委員会のスタッフが迅速に駆けつけ、怪我人の救護を行う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200507
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200507,
					"content": "隊長、どうしてイーガンさんがいないの？もうすぐスタートなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200508
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200508,
					"content": "ミニー、イーガンは熱が出て寝込んでるんだ。競技には参加できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200509
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402200509,
					"content": "ええっ？そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200510,
						402200511
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200510,
					"content": "#大丈夫、{M#俺}{F#私}がいるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				},
				{
					"id": 402200512,
					"content": "安心しろ、ミニー。こいつはすごいんだぜ！オイラたちがいれば、優勝だってできるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402200513,
					"content": "よ…よかったぁ。ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200514
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200514,
					"content": "…では、参加チームの紹介に移ろう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200515
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200515,
					"content": "スメールから参加のチーム「砂を行く者」、稲妻から参加のチーム「飛雷の稲光」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200516
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200516,
					"content": "璃月から参加のチーム「夕陽」、フォンテーヌから参加のチーム「グレイハンズ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200517
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200517,
					"content": "冒険者たちによるチーム「ビヨンド・ザ・マウンテン」。清泉町の住民たちによるチーム「神速の狩人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200518
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200518,
					"content": "そして最後は、様々な国の選手から成る混合チーム——「炎魂戦士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200519
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200519,
					"content": "ほかのチームの選手たちも強そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402200520,
					"content": "慌てない、緊張しない！今こそ、フィエテナさまのことを考える時だよ。みんな、勇気を出して～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200521
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200521,
					"content": "わたしたちなら、どんな障害だって乗り越えられる！乗り越えられないなら、ぶつかって押しのけちゃえばいいんだよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200522
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402200522,
					"content": "全員があんたの真似するのはムリだって…ま、でもその通りか。こんな時に弱音なんて吐いてられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200523
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402200523,
					"content": "#{M#俺}{F#私}に任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200524
					]
				},
				{
					"id": 402200524,
					"content": "わたしも頑張るよ。みんなを、自分を信じる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200525
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402200525,
					"content": "では、選手は位置について…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200526
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200526,
					"content": "よーい…スタート！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 402200511,
					"content": "#{M#俺}{F#私}がイーガンの区間を走る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200512
					]
				}
			]
		},
