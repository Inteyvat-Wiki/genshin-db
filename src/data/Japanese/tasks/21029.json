			"dialogs": [
				{
					"id": 210291101,
					"content": "よかった、じゃあ早速作ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291102,
					"content": "うわ！辛っ！み、水はどこ？水ちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291103
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291103,
					"content": "どうやら、絶雲の唐辛子を入れすぎたみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210291104,
					"content": "ふぅ…もう大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291105
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291105,
					"content": "少し辛いけど、こっちのほうが美味しいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291106
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291106,
					"content": "それに、この辛さは…眠気を覚ますのにも役に立ちそうだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291107,
						210291108
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291107,
					"content": "絶雲の唐辛子の量を減らしたほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210291109
					]
				},
				{
					"id": 210291109,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、ありがとう。この作り方、覚えておくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291110
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291110,
					"content": "父と一緒に旅行に行くとき、また機会を見つけて父に作ってあげるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291111
					],
					"speakerTitle": "モン"
				},
				{
					"id": 210291111,
					"content": "うーん…父は辛いものを食べられたっけ？食べられたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モン"
				},
				{
					"id": 210291108,
					"content": "味が悪くないならいい。",
					"roleType": "TALK_ROLE_PLAYER",
