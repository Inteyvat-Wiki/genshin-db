			"dialogs": [
				{
					"id": 740751701,
					"content": "装置の上の部分を念入りに調べたが、何も見つからなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751702
					]
				},
				{
					"id": 740751702,
					"content": "ここも、なんにもないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740751703,
					"content": "キャタピラー、あたしたちは何を探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751704
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740751704,
					"content": "水仙十字聖剣を作る材料を探しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751705
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751705,
					"content": "水仙十字結社は地下の国と古代フォンテーヌの神秘主義哲学によって、物質世界に必要な四種類の架空物質を再現しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751706
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751706,
					"content": "理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751707
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740751707,
					"content": "神秘的なものはそもそも、体験によってのみ作用するんです。元素力以上に、普通の枠にはまらないものだとも言えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751708
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751708,
					"content": "数十年前、私は教令院素論派の入門から中級教材を記録しましたが、元素力はさほど神秘的なものではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751709
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740751709,
					"content": "そうですか。とにかく結論から言えば、フォンテーヌに伝わる古来からの手法と地下の古国の技術の結晶というわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751710
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751710,
					"content": "そうして世界には「記憶」、「願い」、「霊魂」、「人格」という四種の物{RUBY#[D]サブスタンス}質が現れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751711
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751711,
					"content": "複数の解釈を避けるため、「記憶」「願い」「霊魂」「人格」にそれぞれピースを分けて考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751712
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751712,
					"content": "どうしてそんなもので聖剣を作るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740751713,
					"content": "水仙十字結社の神秘主義哲学では、神殿は宇宙の縮図であり、メンバーは神々の代行者であり、聖油は鍛え抜かれた意志ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751714
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751714,
					"content": "そして聖剣はすべてを切り開く「理性」です。これは完璧なる人の意志から生まれる必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751715
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751715,
					"content": "うさんくさいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751716
					]
				},
				{
					"id": 740751716,
					"content": "まあまあ、神秘主義哲学とはこういうものですよ。類似性のあるものは何でも取り入れて、それが魔法になった暁には、すべての偽りが真実に変わるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751717
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751717,
					"content": "とにかく、次のところへ急ぎましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
