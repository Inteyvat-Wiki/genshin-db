			"dialogs": [
				{
					"id": 740750101,
					"content": "「ここは霊魂の象限、霊魂の廟、霊魂の間」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750102,
					"content": "「永遠の眠りにもつきそい」…「一瞬で生まれ、何時も相いれず、絶対に離れることはない」…「現世の至宝」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750103,
					"content": "ふぅ——今回は怖いものもなかったな。答えは懐中時計か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750104,
					"content": "そう言えば、アンも一つ持ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750105,
					"content": "時計は、確かに高価だけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "じゃあ答えはお金、モラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750107,
					"content": "お金と永眠するのは人生で二番目につらい悲劇ですよ。何か最大かは聞かないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740750108,
					"content": "じゃあ最大の悲劇って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750109,
					"content": "私は答えを知っています。「一文無しで棺おけに横たわること」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750110,
					"content": "そういう価値観って、よくないと思うな。世の中にはもっと大切なものが沢山あるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750111,
					"content": "だから「聞かないで」と言ったんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740750112,
					"content": "申し訳ございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750113,
					"content": "話を戻しましょうか。これまで述べた理由からして、答えは高級時計やモラじゃないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740750114,
					"content": "じゃあなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750115,
					"content": "答えはとても簡単です。類似のなぞなぞを検索したところ、マッチング率は70%でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750116,
					"content": "出典は、数百年前の古典小説です。原文：「私は交錯した一瞬の視線の中で生まれ、追いかける人を背に駆けだした。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750117,
					"content": "「…あらゆる骨肉と内臓を断ち切っても、骨の髄まであなたを想い、同じ床につく。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750118,
					"content": "答えは「愛」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750119,
					"content": "それならわかるよ。この懐中時計にもきっと、愛に溢れた思い出がいっぱい詰まってるんだね。私のと一緒だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750120,
					"content": "懐中時計が開くといいんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "うん、きっといつか開けられるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750122,
					"content": "おバカさんったら、なかなかやるじゃない！世界で一番可愛い機械犬だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750123,
					"content": "光栄です。しかし「可愛い」というのは主観的な形容詞であり、私の理想は「頼もしい丈夫なプロトタイプ4ACV07」という呼称を使っていただくことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740750124,
					"content": "うんうん、そういうところが可愛いんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740750125,
					"content": "…昔の会話の再現ですか？前にも、この光景を見たことがあるような気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740750126,
					"content": "ともかく、なぞなぞがすでに誰かに解かれてしまっている以上、すぐに行動しないといけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
