						740751804
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751804,
					"content": "一体誰が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "ジェイコブでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751806,
					"content": "エリナスで、私たちはジェイコブと衝突を起こしました。補足：これは比較的最近起こったほうの「エリナス」事件です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740751807,
					"content": "扉のところにいた悲劇の被害者を見たとき、彼だと分かりました。案の定、まだ動いていたようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751808,
					"content": "ジェイコブはここのものを持ち去って、一体なにをするつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740751809,
					"content": "簡単なことです——あちらも水仙十字の聖剣を作り直そうとしているんでしょう。水仙十字結社の使命はまだ終わっていませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740751810,
					"content": "さて、ボクたちも最後の一箇所に急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				}
			]
		},
