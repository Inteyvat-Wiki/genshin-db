					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "誰かが最近ここに来たみたいだぞ。オイラたちより遺跡調査に慣れた人がいるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750202,
					"content": "あそこ…懐中時計が落ちてるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750203,
					"content": "いつもの冒険のときみたいに、石碑に書かれていることを見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750204,
					"content": "「ここは霊魂の象限、霊魂の廟、霊魂の間」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750205,
					"content": "「永遠の眠りにもつきそい」…「一瞬で生まれ、何時も相いれず、絶対に離れることはない」…「現世の至宝」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750206,
					"content": "これは明らかに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "うーん。価値の高い懐中時計…現世の宝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750209,
					"content": "わかった、きっとモラだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750210,
					"content": "ちょ、ちょっと違うと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "確かに、なぞなぞの答えがそんなに安っぽいわけないよな。じゃあ、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750212,
					"content": "わかった、「財宝」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750213,
					"content": "いいね。まあ、とりあえず違うってことで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "なんだよ！なんでオイラを信用しようとしないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750215,
					"content": "だったらなんだと思うか、言ってみろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750216,
					"content": "今日はいい天気だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "おい、話題をそらすな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750218,
					"content": "重要じゃないよ。まずは奥を見に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "おい！わからないならわからないって言えよな！気まずいからって急ぐなよ、オイラを置いて行かないでくれ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740750207,
					"content": "なぞなぞだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
			]
		},
