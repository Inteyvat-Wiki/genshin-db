			"dialogs": [
				{
					"id": 730210301,
					"content": "オレのスープが…ううっ…なんでこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210302,
					"content": "（黙って逃げ出そうか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランパス",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "…うん、確かに川の源流の水だ。「活源水」は冷たくて月みたいに澄んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210402,
					"content": "アランチャトラ、アランサカ、アランファラもこういう水を吸って成長したら、あんなバカにはならなかったろうな。アランパカティ、オレの妹だけは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210403,
					"content": "コホンッ、次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210404,
					"content": "ん？そうだな、次はお詫びの印にスープを作ってもらうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210405,
					"content": "アランパスの指導の下、水に野菜や果物を入れて調理を開始した。\\n鍋からはだんだん、いい匂いがしてきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "完成後、一同は完成したばかりの「スープ」を味見した。\\n…予想通り、確かに食材の香りはするが…\\nなんの味付けもしていないスープはやはり素朴すぎた。\\n少しも味がしないのだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "うんうん、「至高のごちそう」はこういう香りでなくっちゃな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210408,
					"content": "#うーん…{NICKNAME}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210409,
					"content": "喉の渇きを癒すって意味では確かにスープ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "あのさ、塩コショウしたら、もっと美味しくなると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210412,
					"content": "塩コショウしたら、何でもおいしくなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "おお…アランムフクンダ様、何たることでしょう！塩を足すだと…あんな恐ろしいものをか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210414,
					"content": "塩気のある土地に命は育たない。アランナラは縮んで干からびた種になっちゃうんだぞ…それなのにナラは、塩を入れろだと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210415,
					"content": "スープに味がないのは、当たり前だろ！オマエたちナラは、そんなことも分からないのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210416,
					"content": "前にいたあのナラはスープを飲んで、こんな話をしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210417,
					"content": "「ナラの世界では、子供たちが帰る頃になると、家々からスープの匂いが漂ってくる。だから、スープに必要なのは香りだけ」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210418,
					"content": "#それから{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は、オレのスープが香り高いって褒めてくれたんだ。それだけは忘れない。オマエの言うことなんか誰が信じるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210419,
					"content": "でも匂いだけじゃダメだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210420,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210421,
					"content": "フン、でもまあ、オマエらが次のウツァヴ祭のナラだってことは、アランラジャやアランパカティに認められたってことだろ。しょうがない、何とかして味つきのスープを作ってみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210422,
					"content": "じゃあ次は、もっといい水で作ろう。そしたらもっとうまいスープができるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210423,
					"content": "…水の問題じゃない気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "そうか…でもとにかく、「お料理修行」は無事に終わった。よし、あとは全部ウツァヴ祭が来てからにしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210425,
					"content": "スープの作り方も教えたことだし、オマエたちも偉大なナラが認めた味をせいぜい楽しめ。でもこれだけは忘れるな。絶対いい水を使うこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210426,
					"content": "#（{NICKNAME}、次はもっと調味料を入れてみようぜ。ぜったい、もっと美味しくなるはずなんだ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210410,
