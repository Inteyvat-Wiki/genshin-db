				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "わぁ！この鍋、いったいなにを煮てるんだ？すっごくいい匂いだな。匂いだけで、よだれが止まらないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210102,
					"content": "なにかのスープみたいだな。うーん…なんのスープか、見ただけじゃ分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210103,
					"content": "#あれっ、{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210104,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "スープを作ってる人、今、いないみたいだぞ。すっごくいい匂いだし、こっそり味見しちゃおうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210106,
					"content": "じゃあ、こっそり一口だけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "いいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210112,
					"content": "お鍋の容量は、見た目よりも少なかった。\\nこうして、鍋の中身は全部なくなった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "ぷはっ…ん？このスープ、すっごくいい匂いなのに、味が全然しないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210114,
					"content": "おお、アランムフクンダ様よ！おい、そこのナラ、どういうつもりだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210115,
					"content": "ア、アランナラ？いきなりどっから出てきたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210116,
					"content": "地中から出てきた！そんなことより、オレのスープを盗み食いするとは何事だ！このアランパスが苦労して作ったっていうのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210117,
					"content": "ごめんなさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210119,
					"content": "ふんっ、オレのスープを勝手に飲んでおいて、ごめんなさいで済むと思うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210123,
					"content": "ここでスープを作るのがどれだけ大変かわかるか？雨が降ったかと思うと、太陽が顔をのぞかせるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210124,
					"content": "なんとかスープを作って、新鮮なハッラの実を摘みに行ったら、オマエらが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210125,
					"content": "あんまりいい匂いだったからつい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210126,
					"content": "でも、そんなに大変なのに、なんでここでスープを作ろうと思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210127,
					"content": "フンッ、料理で一番大切なのは、毎日アレを手に入れることだからだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210128,
					"content": "シェフとしてのプライド？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "水！水だよ！スープの香りは水で決まるんだ。だから、最高の水を使いたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210131,
					"content": "ここに来るまで、アパーム叢林のあちこちで水を汲んでスープを作ったんだ。それはもう沢山、それこそ、木の葉っぱほどの量を汲みまくって、やっと最高の「活源水」を見つけたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210132,
					"content": "まさにウツァヴ祭にふさわしい「至高のごちそう」だ！ま、オマエたちに話しても、分からないだろうけどさ…前にいたあのナラにしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210133,
					"content": "そう言えばオイラたち、アランパカティのところから来たんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210134,
					"content": "アランパスにこれまでの経緯を説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "へえ、「妹」のナラの友達だったのか！しかも、ウツァヴ祭をやるだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210136,
					"content": "でも大丈夫だ。もう「活源水」は手に入れたし、「至高のごちそう」もできた。この鍋の中に…それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210138,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "えへへっ。そう落ち込むなって。スープはすっごくいい匂いしてたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210140,
					"content": "ああ、オレの「活源水」！水源には「ヤプシュナ」が棲みついてる。奴らがいなくなった隙に、やっと一鍋分の水を汲んだのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210141,
					"content": "ダメだ。絶対オマエたちに「活源水」を一鍋分、弁償してもらう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210142,
					"content": "「ヤプシュナ」…？それ、なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210143,
					"content": "ふんっ、ナラは森のことをなんにも分かってないな。水の中に棲んでる、四本足でしっぽがあって、噛みついてくる奴のことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210144,
					"content": "…犬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210145,
					"content": "犬は水中に棲んでないよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "あ、そっか。じゃあ「ヤプシュナ」ってなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210148,
					"content": "「ヤプシュナ」のことはどうでもいいから、水！オレはあそこの「活源水」が欲しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210149,
					"content": "#はいはい…{NICKNAME}、しょうがない。行くか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210150,
					"content": "そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "絶対「活源水」を汲んで来いよ。他の水じゃダメだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210151,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "水犬って何…水元素でできた幻形の犬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "初心を忘れない決意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "ぜ、全部パイモンが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#おい、{NICKNAME}！オイラを売るのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210122,
					"content": "ダレが飲んでいようが関係ない！とにかくスープがなくなっちまったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "アランパス"
				},
				{
					"id": 730210108,
					"content": "それは駄目でしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "だって気になるじゃないか。うぅっ、こっそり一口、一口だけでいいから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730210110,
					"content": "食べてお腹を壊したらどうするの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "ふふんっ、そうやってオイラを甘く見るもんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "パイモン"
				}
			]
		},
