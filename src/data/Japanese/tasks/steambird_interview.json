			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ユーフラシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746500101,
					"content": "いい天気ね。そう思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500102,
						746500103
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500102,
					"content": "そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746500104
					]
				},
				{
					"id": 746500104,
					"content": "もし仕事の日の天気が毎日こんなにキュートだったら、最高なのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500105
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500105,
					"content": "仕事といえば…あなた、「人生いろいろ」欄の「トラブルキラー」職の面接に来たんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500106,
						746500108
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500106,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746500107
					]
				},
				{
					"id": 746500107,
					"content": "素晴らしいわ。あなた、「トラブルキラー」っていう言葉に疑問を抱かないなんて。言葉の使い方に関してイーサンの好みは少し変わってるけど、シンプルで分かりやすいのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500111
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500111,
					"content": "まあ、それはさておき…あなたは仕事を探しているけど、うちの新聞の「人生いろいろ」欄に助けを求めに来たわけじゃない…そう私が推理した方法が気になるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500112
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500112,
					"content": "観察よ。スチームバード新聞に助けを求める市民の顔はどれも気が気でなさそうな様子なの。でも、あなたの足取りはすごく軽くて、表情もリラックスしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500113
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500113,
					"content": "フフッ、幸せな人はみんな似たような感じでね。でも、不運な人はそれぞれ違った負のオーラをまとっているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500114
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500114,
					"content": "まあ、安心してちょうだい。「人生いろいろ」欄の投稿者が直面している問題ってさほど大きいものじゃないし、手を焼くこともないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500115
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500115,
					"content": "さて、それじゃ今回の依頼内容を見てみましょうか。どれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500108,
					"content": "「トラブルキラー」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746500109
					]
				},
				{
					"id": 746500109,
					"content": "まあ、そうなるわよね。「トラブルキラー」って言い方、あんまり品がないからうちの新聞のセンスとは合わないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500110
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500110,
					"content": "ふむ…イーサンの言葉選びと文章力には、改善の余地があるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500111
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500103,
					"content": "とっても気持ちいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500104
					],
					"speakerTitle": "ユーフラシア"
				}
			]
		},
		{
			"id": 7465002,
			"completionStepIds": [
				7465002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7465002",
							"2"
						],
						"stepId": 7465002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ユーフラシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746500201,
					"content": "毎週、あなたには時間を少し割いて「人生いろいろ」欄に投稿された内容を読んでもらうわ。解決できそうな依頼をいくつか選んで処理したら、私のところに戻ってきて報酬を受け取ればそれでオーケーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500202
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500202,
					"content": "一部の依頼内容は、あまりに簡単すぎて目を疑うだろうけど…この仕事の価値をあまり過小評価しないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500203
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500203,
					"content": "私たちから見て、投稿された問題がどれほど些細なものであっても、投稿した人からすると指先に刺さって取れなくなったトゲのようなものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500204
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500204,
					"content": "そういう投稿者を助けて「トゲ」を抜くことができれば、報酬を得られるだけでなく周囲から尊敬と感謝の眼差しを向けられるようになる。住民からの評判も上がるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500205
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500205,
					"content": "時が来たら、もっと複雑で重要な仕事をあなたに任せるつもりよ、フフッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500206
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500206,
					"content": "人々が幸せになる手助けをして、人間性の灯りを照らすこと。それこそが私たち報道機関の使命であり、すべての出版者の気持ちと抱負でもあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500207
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500207,
					"content": "め、面接はいらないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746500208
					]
				},
				{
					"id": 746500208,
					"content": "面接？あなたへの面接は、あなたが新聞社の前に来た時点でもう終わっているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500209
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500209,
					"content": "そう驚かないで。私には独自のルートがあるの。フフッ…それくらいできないようじゃ、新聞社の編集長なんて務まらないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746500210
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 746500210,
					"content": "さて…仕事についての注意事項はしっかり伝えたわ。受けるかどうかは、あなたの選択次第。よく考えてみてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ユーフラシア"
				}
			]
		}
	]
}