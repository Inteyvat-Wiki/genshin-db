			"dialogs": [
				{
					"id": 740880401,
					"content": "#ここにも「サーベイランスアンカー」があるはずです。僕が扉を開けましょう。回収作業は{NICKNAME}さんに任せましたよ。",
					"roleType": "TALK_ROLE_NPC",
