					"クロニエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880601,
					"content": "ふぅ…それでもやはりショワズールの誤魔化そうとする姿が忘れられないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740880602,
					"content": "それにレモンド…あの人の傲慢で尊大な…他人のことなんて眼中にないって様子も。彼の私を見る目に気づいた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740880603,
					"content": "あの二人に比べればあなたのほうがよっぽどいい人よ。あなたならあの人たちのポジションに就いても、きっと絶対あんな風にはならないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロニエ"
				}
			]
		}
	]
