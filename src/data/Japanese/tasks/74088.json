		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナッカー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "ここは元々サー·ビュトールの「クロックワーク応用研究院」でした。伝統的なクロックワーク機械の研究領域において、彼は指折りの権威だったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740880502,
					"content": "でも…学術的な視点で見れば…伝統的なクロックワーク機械の発展と改良はすでに停滞期に入ってます。応用という点では、伝統的なクロックワーク機械の劣勢はあまりに明らかです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740880503,
					"content": "とにかく、サー·ビュトールの研究は学院内で次第に隅の方に追いやられるようになり、経費を削減されただけでなく、研究員の採用も少なくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740880504,
					"content": "一連の不運な出来事の後、ついにサー·ビュトールの研究チームはきれいさっぱり解散を宣言し、ここも基本的には廃棄となったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740880505,
					"content": "はぁ…僕に言わせれば、サー·ビュトールは運が悪すぎましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナッカー"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
