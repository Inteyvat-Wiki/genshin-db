			"dialogs": [
				{
					"id": 741570301,
					"content": "物件販売中。お手頃価格、ご購入はお早めに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "物件売却情報"
				},
				{
					"id": 741570302,
					"content": "#あっ、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}にパイモンお姉ちゃん。ルロワさんを探しに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570303,
					"content": "ブノワさんは家にいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "いないよ。ルロワさんはもうこの家には住まないんだってパパが言ってた。地下に行くんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570308,
					"content": "サーンドル河に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "オイラたちがこの前行った、あのサーンドル河にか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741570310,
					"content": "そことは違うよ。パパが言ってたのはもっと下のほうの地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570311,
					"content": "スチームバード新聞にね、ルロワさんが登山中に高いところから落ちて、思い切り転んじゃったんだって書いてあったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570312,
					"content": "転んだのと引っ越しがどう関係あるのかはよく分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570313,
					"content": "そうだ！さっき来たときね、おムコのおじさんと優しいお姉ちゃんに会ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570314,
					"content": "そのお姉ちゃん、あたしのことをすごく気に入ったみたい。目が同じ紫色をしてたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570315,
					"content": "それからね、どこに住んでるのかって聞かれて、時間ができたらまた会いたいって言ってた。あたしの友達になってくれるんだって。やっぱりルロワさんの家族はみんな優しい人だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570316,
					"content": "うーん、ほんとは持ってきたバブルオレンジをルロワさんにあげたかったんだけど、もういないって言うし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570317,
					"content": "#{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}にあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570318,
					"content": "ありがとな、モリィ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741570319,
					"content": "えへへ、どういたしまして！パパとママが、お友達には気前よくしなさいって言ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570320,
					"content": "今日もひとつ良いことをしたし…帰ったら日記に書かなきゃ！えへへ、よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570321,
					"content": "あなたは楽しそうに通りを歩いていくモリィを黙って見送った。ルロワ一家の物語はこうして幕を閉じた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "たまたま通りかかっただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "#ルロワさんが引っ越しちゃったこと、ちょうど{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}に教えようかなって思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570307,
					"content": "ルロワさんはもうこの家には住まないんだってパパが言ってた。地下に行くんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "モリィ"
				}
			]
