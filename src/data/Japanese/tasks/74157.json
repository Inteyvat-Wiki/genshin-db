			"dialogs": [
				{
					"id": 741570201,
					"content": "物件販売中。お手頃価格、ご購入はお早めに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "物件売却情報"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、パイモンお姉ちゃん。ルロワさんがこの家からいなくなっちゃったみたいなの。ルロワさんのことをどこかで見かけなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570203,
					"content": "（なあ、ホントのことを言うべきか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741570204,
					"content": "見たよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "そっか！じゃあ、あたしの代わりにお菓子美味しかったよって伝えてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570206,
					"content": "うん、伝えたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#よかった！{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}は約束を守ってくれたんだね！優しい！そうだ。バブルオレンジを持ってきたの、あげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570214,
					"content": "モリィがため息をついて、あなたたちに手を振り、別れを告げて立ち去ろうとしたとき…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "ドアが開き、オータムとアトーズが建物の中から出てきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "外から声が聞こえると思ったら、あなたたちだったのね。まだ何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570217,
					"content": "たまたま通りかかっただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "そうか？世界は狭いものだね。ちょうど僕とオータムもここを出るところだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570219,
					"content": "ブノワさんは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "ああ、彼ならもう別の場所に行ってしまったよ。そこは僕たちが数十年後に行く場所だ。すぐに会うことはできないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570221,
					"content": "これは言いづらいことだが…「明日」と「思いがけない事故」、どちらが先に来るかなど誰に分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570225,
					"content": "おや、いつもブノワさんに会いに来てた子じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570227,
					"content": "おばさん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570228,
					"content": "…似ている、それに紫色の瞳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570229,
					"content": "お、おばさん…？どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570230,
					"content": "あなた、いくつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570231,
					"content": "九歳だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570232,
					"content": "パパとママの名前は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570233,
					"content": "えっと…おばさんどうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570234,
					"content": "君、その顔…この女の子が何だというんだ？…まさかそんな偶然ないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570235,
					"content": "あなたは養子にやられた子？教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570236,
					"content": "#…{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、このおばさんと知り合いなの？なんでいきなり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570237,
					"content": "そんな聞き方をするやつがどこにいる。代われ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570238,
					"content": "お嬢ちゃん、確か君は義父ととても仲が良かったよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570239,
					"content": "うん、ルロワさんはすごく優しかったよ。おムコのおじさん、ルロワさんは引っ越しちゃったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570240,
					"content": "そうだ。彼は遠いところへ行ってしまったからもう戻ってはこないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570241,
					"content": "義父は、いつも君たちに何を話してくれたんだい。教えてもらえるかな？戻ったら彼に、君が会いたがっていたと伝えてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570242,
					"content": "ルロワさんはお菓子をくれたり、ナナをなでさせてくれたよ。それから目がきれいだって褒めてくれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570243,
					"content": "ほかには？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570244,
					"content": "あたしのパパとママによろしく伝えてほしいってよく言ってた。パパとママは、そういうの好きじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570245,
					"content": "パパはいつも、ルロワさんは悪い人で自分たちのことを「ゆすってる」って怒ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570246,
					"content": "パパとママはあたしが会いにいくのを許してくれなかったけど、あたしルロワさんと約束してたから、こっそり会いに来てたんだ。おじさん、パパには内緒だよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570247,
					"content": "彼ならやりかねないことよ。最後の一滴を搾り取るまで絶対にやめることはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570248,
					"content": "…下衆が…ああ、ごめん…ちょっと別の話をしていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570249,
					"content": "お、おじさんにおばさん…まだ何かある？ないなら…も、もう帰るね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570250,
					"content": "…パパとママは、あなたを愛してる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570251,
					"content": "うん。世界で一番のパパとママだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570253,
					"content": "良かったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570254,
					"content": "もう帰るね。ばいばい、おじさんとおばさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570255,
					"content": "またね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570256,
					"content": "これでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "この光景を何度も想像してきたけど…あの子が幸せに暮らせていることを知れたから、それだけで十分よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570259,
					"content": "私は…自分の父親とは違う。今の幸せな家庭に水を差すつもりはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570260,
					"content": "話の腰を折るつもりはないが…確かあの子のためにオルゴールを買ってやったんじゃなかったか？渡さなくていいのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570261,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570262,
					"content": "その必要はなくなったわ。あの子…そういうものには困ってなさそうだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570263,
					"content": "これから先、あの子と頻繁に会える方法を考えてみる。必要なものがあれば私が何とかするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570264,
					"content": "…これは他の人にあげることにする。せっかく時間をかけて選んだんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570265,
					"content": "白い髪のお嬢ちゃん。プレゼントは好き？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570266,
					"content": "えっ、オイラ？オイラにくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741570267,
					"content": "そう、あなたにあげる。最後に価値を見出してあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570268,
					"content": "アトーズ、悪いけど…私たちはフォンテーヌ廷にもう少し留まる必要があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741570269,
					"content": "構わないさ、どこにいても僕にとっては一緒だ。行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570270,
					"content": "あなたたちは通りを歩いて去っていく二人を黙って見送った。ルロワ一家の物語はこうして幕を閉じた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "彼女に教えなくていいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "ブノワさんはどうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "この世は、極度の貧困と極度の貪欲という不均衡で満ちている。フォンテーヌの法のもとで裁けないのなら、僕たち自身で裁くべきだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570224,
					"content": "つまり、彼は行くべきところへ行ったということさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741570208,
					"content": "忘れてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "あっ…そうなんだ。残念だなぁ。もうルロワさんに伝える機会なんてないかも…持ってきたバブルオレンジは…あなたたちにあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570210,
					"content": "見てない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "そっか、残念…もうルロワさんには会えないのかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570212,
					"content": "#あたし、バブルオレンジを持ってきたんだ。ルロワさんに会えるかもしれないって思ってたんだけど、引っ越しちゃったみたいだし…これは{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}にあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "モリィ"
				},
				{
					"id": 741570213,
					"content": "何があっても、あたしルロワさんのことは忘れないよ。それじゃまたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "モリィ"
				}
			]
		},
