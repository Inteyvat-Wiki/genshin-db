			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
					}
				]
			},
			"dialogs": [
				{
					"id": 746940101,
					"content": "ってことは…アタシが引いたこのカードは、なかなかいいカードってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940102
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940102,
					"content": "ヒヒッ、運命とはあくまで運命。初めから良いも悪いもないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940103
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940103,
					"content": "だが、その正位置の「力」に限って言えば、おまえの仕事にぴったりの意味を持つね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940104
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940104,
					"content": "「力」は情熱や勇気、自信、渇望…そして、完璧で迷いのない愛を象徴しておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940105
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940105,
					"content": "どのような突発的な事態に直面しようとも、おまえならその場を主導し、掌握できるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940106
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940106,
					"content": "あっはっはっはっ、そいつは褒めすぎじゃないか？いい卦が出たら、代金を弾むのがアタシたちの掟でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940107
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940107,
					"content": "ほら、机の上に置くよ。もし時間があれば、アタシの船の仲間たちも見てやってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940108
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940108,
					"content": "ヒヒッ、そんなことを頼まれたのは初めてだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940109
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940109,
					"content": "あいつらは、南から北まで、風に吹かれ波に揉まれながら何年も航海してきた。みんな、山ほどの悩みを抱え込んでいるはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940110
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940110,
					"content": "あいつらの親分とはいえ、アタシじゃ解決してやれない問題もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940111
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940111,
					"content": "せっかくあんたみたいな占い師に出会えたんだ。船に来てもらって、あいつらの心につっかえてるもんを解消してくれないかと思ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940112
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940112,
					"content": "報酬なら心配いらない。今回、いくつか大きな商売をしてかなり稼げたからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940113
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940113,
					"content": "面白そうだが、遠慮しておくよ。わしのカードボックスには、大人数を占えるほどのカードは入っておらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940114
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940114,
					"content": "おっ、旅人にパイモン！久しぶりじゃないか。あんたたちも卜占を頼みに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940115,
						746940116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940115,
					"content": "うん。卜占っていうか、占い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940117
					]
				},
				{
					"id": 746940117,
					"content": "もちろん、商売をしに来たのさ。ついでに、誰かさんのために新しい商売のルートを調べにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940118,
						746940119
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940118,
					"content": "その誰かさんって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940120
					]
				},
				{
					"id": 746940120,
					"content": "他に誰がいる、当然我らが天権様だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940121
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940121,
					"content": "あの女、今度は何を企んでいるのか知らないが、数日前に突然、フォンテーヌでいい商売ができるって持ちかけてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940122
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940122,
					"content": "アタシが何か言う前に、あいつは詳細な計画書を取り出して、そこに書かれたルートに従って進めばいいって言ってきてな。事前に部下を派遣して調べさせたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940123
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940123,
					"content": "ちょうど最近は急ぐ仕事もなかったから、彼女の言う通りに来てみたら、何もかもがものすごく順調に進んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940124
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940124,
					"content": "本来なら半月はかかるはずだった仕事が、一週間ちょっとで終わったのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940125
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940125,
					"content": "だったらすぐ帰るのももったいないし、いっそここでもう少し遊んでいこうと思ったんだ。仲間にも休暇をやって、息抜きをさせている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940126
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940126,
					"content": "昨日はホテル・ドゥボールを貸し切ってみんなでとことん飲んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940127
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940127,
					"content": "あいつらはまだホテルで寝ている。アタシは外で風にあたって、酔いを覚ましていたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940128
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940128,
					"content": "少し歩いたところで、こちらの…えっと、占者さんに呼び止められて、カードを一枚引いてくれって言われてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940129
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940129,
					"content": "もう引いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940130
					]
				},
				{
					"id": 746940130,
					"content": "ほら、この「力」ってカードだ…見たところ良さそうなカードだけど、正の向きだから、さらにいいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940131
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940131,
					"content": "正位置の「力」か…なんていうか、確かに北斗らしい気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746940132,
					"content": "ああ。さて、そのカードに込められたもう一つの意味について話そうかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940133
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940133,
					"content": "まさか、何か悪い知らせでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940134
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940134,
					"content": "言っただろう、良し悪しなんてないよ。占いとも…ふふ、直接の関係はないし、ちょっとした気まぐれな思いつきとして捉えとくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940135
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940135,
					"content": "外面的な力にしても、内面的な精神にしても、確かにおまえは強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940136,
					"content": "例えるなら、おまえは暗闇の中の灯火だ。闇を払い、迷える者に進むべき道を導く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940137
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940137,
					"content": "だが、よく覚えておきな。それに引き寄せられるのは、道に迷った弱者だけじゃない。虫けらもまた、明かりに群がり光と熱を奪い合うんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940138
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940138,
					"content": "灯火はやつらにも等しく温もりを与えられると信じて、より激しく燃焼しようとする。そうしなければ、光が弱まってしまうと考えるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940139
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940139,
					"content": "厄介な虫けらどもを追い払ってくれる者がいれば、まだ救いはあるだろうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940140
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940140,
					"content": "もしそうでないのなら、いずれ灯火も取るに足らぬ虫けらのために、自分ごと燃やし尽くしてしまうかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940141
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940141,
					"content": "…そう考えると、アタシには何の問題もないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940142
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940142,
					"content": "アタシにはある友人がいる。彼女は昔から人の悩みを解決するのが得意で、それに…ははっ、目が届きにくい場所に潜んでる「ネズミ」なんかを、よく自分の手で駆除しているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940143
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940143,
					"content": "それは珍しいね。おまえの口ぶりからして、ずいぶんその友人を信頼しておるようだ。その者なら、道を見失うこともなさそうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940144
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940144,
					"content": "あいつが？ははっ、もしあいつが道に迷うようなら、璃月の全国民が迷子になっちまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940145
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940145,
					"content": "今回だって、あいつが教えてくれたルートで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940146
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940146,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940147
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940147,
					"content": "はっ、道理でな。おかしいと思っていたんだ。あの女が本気ででかい商売をする気なら、アタシがここでのんびり過ごしているのを許すわけがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940148,
						746940149
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940148,
					"content": "さすが天権、と言うべき？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940150
					]
				},
				{
					"id": 746940150,
					"content": "へへっ、簡単に言うと、凝光は北斗に休みをあげたかったんだな。でも、なんでこんな回りくどいことをしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746940151,
					"content": "あの女ならきっとこう言うだろう。「回り道をしなければならないこともあるわ。それこそが近道なのよ」ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940152
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940152,
					"content": "彼女の複雑な考えなんて、さっぱり分からない。ふっ…けど、商売のルート拡大にはアタシが不可欠なんだ。悪いようにはされないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940153
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940153,
					"content": "アタシという「力」のカードは、先陣を切って波をかき分け、ただひたすら突き進んでいけばいいだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940154
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940154,
					"content": "…おっと！もうこんな時間か。仲間の様子を見に戻るとしよう。ついでに酔いを覚まさせて、出航の準備をさせないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940155
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940155,
					"content": "旅人、パイモン、それに占者さんも、機会があったらまた会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940156
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940156,
					"content": "…このカードもなかなかの珍品だな…人にあげてもいいのか？いや、ダメだろうな…まあ…見せるくらいなら大丈夫か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940157
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 746940157,
					"content": "迷える者を庇護し導く光…そして、光を求めず手を差し伸べる者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746940158
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940158,
					"content": "面白いじゃないか。暇があれば、璃月に行ってみるかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746940149,
					"content": "休暇にも理由を持たせるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746940150
