			"dialogs": [
				{
					"id": 250250101,
					"content": "少しの間でいいから、上がってきてくれる？池を掃除したいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "ペレ·ヌイ"
				},
				{
					"id": 250250102,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "怠け者なコホラ竜"
				},
				{
					"id": 250250103,
					"content": "いい子だから上がって来てちょうだい。早くしないと抱っこしちゃうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "ペレ·ヌイ"
				},
				{
					"id": 250250104,
					"content": "キュッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "怠け者なコホラ竜"
				},
				{
					"id": 250250105,
					"content": "うわ…逃げ足早いんだから…どうやって捕まえたらいいんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "ペレ·ヌイ"
				},
				{
					"id": 250250106,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "あら？温泉に入りに来たの？ごめんね、今掃除してるから少し待ってもらってもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "ペレ·ヌイ"
				},
				{
					"id": 250250108,
					"content": "…とは言っても、この子がなかなか上がってくれなくて…はぁ…まだ掃除しなくちゃいけないところが山ほどあるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "ペレ·ヌイ"
				},
				{
					"id": 250250109,
					"content": "この前無理やり抱っこして引き上げたのを根に持ってるのかな？まいったね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ペレ·ヌイ"
				}
			]
		},
