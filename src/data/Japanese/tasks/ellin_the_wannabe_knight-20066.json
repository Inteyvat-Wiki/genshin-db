			"dialogs": [
				{
					"id": 200660101,
					"content": "困った…どうすればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "今度の騎士選抜のために、訓練してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660104,
					"content": "…でも、ジン様のような力がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660105,
					"content": "だから「力」よりも、「コツ」を身につけたほうがいいかなと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660106,
					"content": "たとえば、一気にこの杭を全部破壊する方法とか…あまり丈夫そうに見えないけど、父さんがわざわざ見つけてくれたから、その気持ちを無駄にしたくないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660107,
					"content": "時間があったら、一緒に考えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660108,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "うん、ゆっくり考えよう、杭は逃げたりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660111,
					"content": "勝手に逃げていくのは使われた時間と命だけだよ、ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660114,
					"content": "この距離だと、片方を倒しながら、もう片方に爆弾をポイできれば最高だと思うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660115,
					"content": "ハハハッ、冗談だよ。爆弾なんて、簡単に見つけられないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660109,
					"content": "二人で壊す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "団体戦が得意なの？…いつでも仲間がいる人がうらやましいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200660113,
					"content": "私みたいな人はひとりで戦う方法を勉強するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "エリン"
				}
			]
		},
