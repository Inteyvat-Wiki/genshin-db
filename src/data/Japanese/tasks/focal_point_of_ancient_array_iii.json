			"dialogs": [
				{
					"id": 761000701,
					"content": "邪魔だ、どけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761000702,
					"content": "ふふふ…何を焦っている…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000703,
					"content": "どうせ皆…いつかは死ぬ運命なのだ…ただ…少し早く逝くに過ぎない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000704,
					"content": "あいつは…三年前に死ねなかったと嘆いていたのだろう？願いを叶えてやっただけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000705,
					"content": "…ビョルンのことを言っているのか？彼に何をした！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761000706,
					"content": "弱すぎただけだ…弱者…クズ…虫けら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000707,
					"content": "死んで当然だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000708,
					"content": "彼を侮辱するな！彼は弱くなんかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761000709,
					"content": "ほう…お前から見れば…あいつは強者なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000710,
					"content": "だが…強者だからと言って、死なぬわけではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000711,
					"content": "お前は…よくわかっていると思っていたがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000712,
					"content": "お前より強い者たちも…皆、死んだだろう？…三年前も…十年前も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000713,
					"content": "…黙れ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761000714,
					"content": "そうだな…弱いのは…お前だけだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000715,
					"content": "そうでもなければ…なぜ…毎回お前だけが生き残る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000716,
					"content": "…お前が尻尾を巻いて戦場から逃げ出したからだろう？お前は…臆病者だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "魔物の声"
				},
				{
					"id": 761000717,
					"content": "イルーガ！そいつの言う事なんて聞くな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761000718,
					"content": "#うるさい——覚悟し{M#ろ}{F#て}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#…{NICKNAME}さん！さっさと決着をつけましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
