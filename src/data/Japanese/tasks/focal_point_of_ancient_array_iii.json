			"dialogs": [
				{
					"id": 761001601,
					"content": "…ビョルンの容態はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001602,
					"content": "重態です…あまりにも急な襲撃だったので…わ、私たちを守ろうとして…ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "エーグル"
				},
				{
					"id": 761001603,
					"content": "…戦場は危険すぎましたが、移動にさえ耐えられそうになくて…っ、応急処置しかできませんでした…私たちが今できる範囲では、とても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "エーグル"
				},
				{
					"id": 761001604,
					"content": "…隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001605,
					"content": "ビョルン…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001606,
					"content": "…申し訳ない…任務を果たせず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001607,
					"content": "そんなことない——陣地を立派に守りきってくれたじゃないですか！みんなも無事です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001608,
					"content": "本当に…？なら、僕は果たせたのか…よかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001609,
					"content": "もう話さなくていいから、治療に専念してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001610,
					"content": "今話さないと…もう機会がないかもしれないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001611,
					"content": "——そんなこと言わないでください！隊長命令です…！大丈夫…きっと大丈夫だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001612,
					"content": "ふ…わかった…もう…言わないでおくよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001613,
					"content": "でも…これでやっと、ヴェイドに顔向けできる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001614,
					"content": "彼はよく…僕たちライトキーパーはヴィンテル草のようだと…言っていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001615,
					"content": "ワイルドハントに…一人で立ち向かっても…脆く弱く…ヴィンテル草の花のように…はかなく散ってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001616,
					"content": "でも…葉さえ残っていれば…根さえしっかり張っていれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001617,
					"content": "次の…またその次の季節に…必ず新しく花を咲かせる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001618,
					"content": "僕たちは負けない…よね…隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001619,
					"content": "…そうです！僕たちは負けない！この手で、必ずあの魔物を屠ってみせる…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001620,
					"content": "…あなたは僕たちの中で最強だから…信じているよ…隊長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001621,
					"content": "安心してください、ビョルン。約束は必ず守ります。だから、もう休んでください…怪我が治ったら、きっと何もかもよくなりますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001622,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "ビョルン"
				},
				{
					"id": 761001623,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001624,
					"content": "#…{NICKNAME}さん、パイモンさん、行きましょう。任務はまだ終わっていません…時間は有限です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 761001625,
					"content": "イルーガ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 761001626,
					"content": "ビョルンのためにも、前に進もう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "#{M#俺}{F#私}たちは絶対に敵を倒して、勝利を掴む。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "…はい、先に進みましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		}
	]
