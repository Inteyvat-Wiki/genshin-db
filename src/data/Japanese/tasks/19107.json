			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エルザー",
					"コナー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "コナー、よくやりました。このままいけば、ディオナがアカツキワイナリーのバーテンダーになる日も近い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 191079802,
					"content": "成功するといいですね。何週間も待ち伏せしてやっと手に入れたチャンス…逃すことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 191079803,
					"content": "ええ、お疲れ様でした、コナー。私たちのオファーにディオナが応えてくれるためにも、このすべては無駄にできません。ここからが正念場です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 191079804,
					"content": "絶対にディオナへ私たちの誠意と情熱を見せましょう！ああ、だからと言ってやり過ぎは注意ですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 191079805,
					"content": "分かってますよ、エルザーさん。何度も練習してきましたから、ミスはしません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 191079806,
					"content": "何を話してるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "えっ！？な、何でもありません！ワイナリーのことを相談してたんですよ、ハ…ハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 191079808,
					"content": "そ…そうそう、ワイナリーの今後についてね…エルザーさん、後でまた最近の支出について話しましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "コナー"
				}
			]
		},
