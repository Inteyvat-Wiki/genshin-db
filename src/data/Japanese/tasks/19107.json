				"points": []
			},
			"dialogs": [
				{
					"id": 191079701,
					"content": "エルザーさん、本当に大丈夫でしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 191079702,
					"content": "コナーよ、ディオナに私たちの誠意を見せることが今一番大事なこと。覚悟を決めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "エルザー"
				},
				{
					"id": 191079703,
					"content": "わ、わかりました、エルザーさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "コナー"
				}
			]
		},
		{
			"id": 1910798,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
