			"dialogs": [
				{
					"id": 711060201,
					"content": "羅おじ、戻って来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060202,
					"content": "おお、ご苦労だったな！茶釜を直す技師が来て、今ちょうどあそこで直してもらってるところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060203
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060203,
					"content": "あれ、茶葉の問題は解決したんじゃ…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060204
					]
				},
				{
					"id": 711060204,
					"content": "そうだ。茶葉の件は解決したが、茶釜を直せば観光名所として旅行客を引き寄せられるかと思ってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060205
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060205,
					"content": "この茶釜は、絶雲の間の留雲借風真君が翹英荘に与えた仙家の宝物とされてる…やれやれ、いったいどこが壊れてるんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060206
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060206,
					"content": "ええっと…だったら、あいつはなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060207,
					"content": "はぁ、技師の言うことはさっぱりでな。構造分析だの、結合だの、何かの図だのって…とにかく茶釜を調べてるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060208
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060208,
					"content": "あっ、あっちへ行った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060210,
						711060211
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060210,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060213
					]
				},
				{
					"id": 711060213,
					"content": "オートモンターニュは手際よく検査を終わらせた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711060214
					]
				},
				{
					"id": 711060214,
					"content": "羅さん！茶釜の検査が終わったわ。今のところ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060215
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060215,
					"content": "あれ？二人とも、こっちに戻ってたのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060216
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060216,
					"content": "茶釜のことが心配で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060217
					]
				},
				{
					"id": 711060217,
					"content": "ふふっ、心配は無用よ。問題があるところには解決策もあるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060218
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060218,
					"content": "それでどうなんだ？茶釜に悪いところはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060219
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060219,
					"content": "悪いところがあるというより、むしろ…そうね、これを見て。ボンドグラフを用意したんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060220
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060220,
					"content": "流れ自体は悪くないはず。でもここのジャイレータにいくらか異常が見られるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060221
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060221,
					"content": "流れ…？うぅ～ん、なに言ってるのかサッパリだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060222,
					"content": "あはは…ごめんね。こういう言い方に慣れちゃってて。つい難しい言葉が出ちゃうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060223
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060223,
					"content": "簡単に言えば、茶釜そのものに損傷はないんだけど、これと繋がってる三つの装置に問題が生じてるの。だから、周囲の元素力の流れがちょっとおかしくなってるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060224
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060224,
					"content": "ふむ、三つの装置か…なるほど！君たちが「装置」と呼ぶものを我々は「山の守」と呼んでいる！山の地相ってのは複雑でな、仙力を持つ石で整えてやる必要があるんだ。元素力が乱れないように——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060225
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060225,
					"content": "う～ん…元素力の乱れって確かに恐ろしいけど、これらの装置と地相には…それほど関係がないかな。直接繋がってるわけじゃないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060226
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060226,
					"content": "装置の構造をはっきりとは確認できないけど、動作の原理は共通してるはず！伝説にある「仙人」たちって、きっと素晴らしい職人だったんでしょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060227
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060227,
					"content": "ははっ、そんなのは言うまでもない！この機械の奥深さについては理解できないが…最初にそれを設置した留雲借風真君という方は、そりゃとんでもない仙人でね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060228
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060228,
					"content": "この「山の守」というのは…機能からして「三相誘導元素チューナー」と呼んだほうがより正確そうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060229
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060229,
					"content": "ん？「キューナー」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060230,
					"content": "そう！フォンテーヌ運動エネルギー工学科学研究院の創始者であるマスターアラン·ギヨタンも、かつて減衰装置を設計し、元素力を調整したとされているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060231
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060231,
					"content": "彼の設計図は失われてしまったけど、原理的には同じはず…だいたいはね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060232
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060232,
					"content": "はは…私ももう歳だ、それを学んだところで身に付かんよ。それで、もう一度聞くが一体何が問題なんだ？深刻なのか？直せるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060233
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060233,
					"content": "我々技術職人に言わせれば深刻かどうかは重要じゃないわ。要は「直せる」か、「直せない」かの違いだけ。これに関して言えば…直せないのなら、とっくにここを出ていってるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060234
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060234,
					"content": "ははっ、そうか。ならよかった！てっきり仙人が私たちの怠慢をとがめるために、鎮め物に仙術を施して直せなくしたのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060235
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060235,
					"content": "羅さん、どんな機械だって同じよ。メンテナンスせずに長いこと放っておいたら、トラブルは起きるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060236
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060236,
					"content": "ギヨタンマスターも言ってたわ——たとえいかに精巧なシステムであっても、動くがままに放っておけば、いずれ壊れることは避けられないってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060237
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060237,
					"content": "ええっと、話がよく理解できないんだけど…とにかく、その「キューナー」ってのを直せば問題は解決するんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060238,
					"content": "そう、その通り！茶釜と繋がっている三つの装置はここからそう遠くないわ。行って少しいじればすぐに直せるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060239
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060239,
					"content": "#{M#俺}{F#私}も手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060240
					]
				},
				{
					"id": 711060240,
					"content": "あら、それはありがたいわね！だったら善は急げよ、さっそく出発しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060241
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060241,
					"content": "#おお…よぉーし、幸先は良さそうだ。{NICKNAME}{M#坊ちゃん}{F#お嬢様}にパイ。茶釜の件は君たちと技師のお嬢さんに任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060211,
					"content": "なるほど、これが軽功…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060212
					]
				},
				{
					"id": 711060212,
					"content": "いや、ぜったい違うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060213
					],
					"speakerTitle": "パイモン"
				}
			]
		},
