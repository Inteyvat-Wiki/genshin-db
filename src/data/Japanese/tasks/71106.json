					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060805,
					"content": "オートモンターニュと共に茶釜のところへやって来た…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
