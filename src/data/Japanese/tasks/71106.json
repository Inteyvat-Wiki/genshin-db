			"dialogs": [
				{
					"id": 711060101,
					"content": "羅おじ、戻って来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060102,
					"content": "おお、ご苦労だったな！茶釜を直す技師が来て、今ちょうどあそこで直してもらってるところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060103
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060103,
					"content": "まぁ、どこが悪いのか分からんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060104
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060104,
					"content": "ええっと…だったら、あいつはなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060105,
					"content": "はぁ、技師の言うことはさっぱりでな。構造分析だの、結合だの、何かの図だのって…とにかく茶釜を調べてるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060106
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060106,
					"content": "あっ、あっちへ行った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060108,
						711060109
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060108,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060111
					]
				},
				{
					"id": 711060111,
					"content": "オートモンターニュは手際よく検査を終わらせた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711060112
					]
				},
				{
					"id": 711060112,
					"content": "羅さん！茶釜の検査が終わったわ。今のところ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060113
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060113,
					"content": "あれ？二人とも、こっちに戻ってたのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060114,
						711060115
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060114,
					"content": "茶釜のことが心配で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060116
					]
				},
				{
					"id": 711060116,
					"content": "ふふっ、心配は無用よ。問題があるところには解決策もあるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060117
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060117,
					"content": "それでどうなんだ？茶釜に悪いところはあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060118
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060118,
					"content": "悪いところがあるというより、むしろ…そうね、これを見て。ボンドグラフを用意したんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060119
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060119,
					"content": "流れ自体は悪くないはず。でもここのジャイレータにいくらか異常が見られるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060120
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060120,
					"content": "流れ…？うぅ～ん、なに言ってるのかサッパリだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060121,
					"content": "あはは…ごめんね。こういう言い方に慣れちゃってて。つい難しい言葉が出ちゃうの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060122
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060122,
					"content": "簡単に言えば、茶釜そのものに損傷はないんだけど、これと繋がってる三つの装置に問題が生じてるの。だから、周囲の元素力の流れがちょっとおかしくなってるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060123
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060123,
					"content": "ふん、思ったとおりだったな！陸じいの強情っぱりめ。問題は茶釜じゃなく、土壌にあるとばかり言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060124
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060124,
					"content": "ふむ、三つの装置か…なるほど！君たちが「装置」と呼ぶものを我々は「山の守」と呼んでいる！山の地相ってのは複雑でな、仙力を持つ石で整えてやる必要があるんだ。元素力が乱れないように——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060125,
						711060127
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060125,
					"content": "なるほど、そういうことか！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060126
					]
				},
				{
					"id": 711060126,
					"content": "う～ん…元素力の乱れって確かに恐ろしいけど、これらの装置と地相には…それほど関係がないかな。直接繋がってるわけじゃないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060129
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060129,
					"content": "装置の構造をはっきりとは確認できないけど、動作の原理は共通してるはず！伝説にある「仙人」たちって、きっと素晴らしい職人だったんでしょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060130
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060130,
					"content": "ははっ、そんなのは言うまでもない！この機械の奥深さについては理解できないが…最初にそれを設置した留雲借風真君という方は、そりゃとんでもない仙人でね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060131
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060131,
					"content": "この「山の守」というのは…機能からして「三相誘導元素チューナー」と呼んだほうがより正確そうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060132
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060132,
					"content": "ん？「キューナー」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060133,
					"content": "そう！フォンテーヌ運動エネルギー工学科学研究院の創始者であるマスターアラン·ギヨタンも、かつて減衰装置を設計し、元素力を調整したとされているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060134
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060134,
					"content": "彼の設計図は失われてしまったけど、原理的には同じはず…だいたいはね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060135
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060135,
					"content": "はは…私ももう歳だ、それを学んだところで身に付かんよ。それで、もう一度聞くが一体何が問題なんだ？深刻なのか？直せるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060136
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060136,
					"content": "我々技術職人に言わせれば深刻かどうかは重要じゃないわ。要は「直せる」か、「直せない」かの違いだけ。これに関して言えば…直せないのなら、とっくにここを出ていってるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060137
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060137,
					"content": "ははっ、そうか。ならよかった！てっきり仙人が私たちの怠慢をとがめるために、鎮め物に仙術を施して直せなくしたのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060138
					],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060138,
					"content": "羅さん、どんな機械だって同じよ。メンテナンスせずに長いこと放っておいたら、トラブルは起きるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060139
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060139,
					"content": "ギヨタンマスターも言ってたわ——たとえいかに精巧なシステムであっても、動くがままに放っておけば、いずれ壊れることは避けられないってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060140
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060140,
					"content": "茶釜に問題があるのに、トラブルの元を解決しようともせず、いい茶葉が育たないのを土のせいにするという考えは、そもそも理に適っていないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060141
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060141,
					"content": "（確かに、浮錦のやつも言ってたよな。お茶が美味しくなくなったのは、水と土に問題があるからだって。例の「キューナー」を直せたら、水と土の問題も解決できるかもしれないぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711060142,
					"content": "とにかく！茶釜と繋がっている三つの装置はどれもここからそう遠くないわ。行って少しいじればすぐに直せるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060143
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060143,
					"content": "#{M#俺}{F#私}も手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060144
					]
				},
				{
					"id": 711060144,
					"content": "あら、それはありがたいわね！だったら善は急げよ、さっそく出発しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060145
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060145,
					"content": "#おお…よぉーし、幸先は良さそうだ。{NICKNAME}{M#坊ちゃん}{F#お嬢様}にパイ。茶釜の件は君たちと技師のお嬢さんに任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅おじ"
				},
				{
					"id": 711060127,
					"content": "羅おじ、ひとまず落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060128
					]
				},
				{
					"id": 711060128,
					"content": "羅さんの話はだいたい合ってるわ。これらの装置は確かに元素力の乱れを防ぐための機械よ。ただ、地相とは関係がないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060129
					],
					"speakerTitle": "オートモンターニュ"
				},
				{
					"id": 711060115,
					"content": "茶葉のことが心配で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060116
					]
				},
				{
					"id": 711060109,
					"content": "なるほど、これが軽功…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711060110
					]
				},
				{
