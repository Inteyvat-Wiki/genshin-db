				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "諸行無常、諸行無常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "おや？若者や、花見でもしに来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140104,
					"content": "残念じゃが、この「琉璃百合」はもう散ってしまったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140107,
					"content": "この花…どうして散っちゃったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140108,
					"content": "ばあやが若い頃、この「琉璃百合」は人の感情がわかると言われておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140109,
					"content": "たとえば笑い声や歌声…楽しそうな声を聞くと、花も喜んで綺麗に咲くんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140110,
					"content": "逆に良くないこと…たとえば、でたらめな噂話なんぞを聞くと、すぐに枯れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140111,
					"content": "…じゃあ、この花たちは今、璃月港の現状を感じ取ってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140112,
					"content": "そうじゃ、岩王帝君が死んだなんて噂はただ事じゃない。いろんな噂が流れとるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140113,
					"content": "ファデュイの陰謀だの、「海にいるあれ」が暴れたからだの、七星の自作自演だと言う者もおる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140114,
					"content": "この港はまるでマッチの山みたいじゃ。小さな火が付いただけで、それが一気に燃え広がる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140115,
					"content": "はあ、この話はここまで。ばあやは年寄りじゃから、小言を言うのが癖でな…して若者、何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140116,
					"content": "「洗塵の鈴」を借りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "ああ、あれか…覚えとるよ。確かに持っとるが…どこにやったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140118,
					"content": "あの鈴は、ばあやが若い頃にある友達が持っていたものなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140119,
					"content": "その鈴をじっと見つめていたら、彼がばあやにくれたんじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140120,
					"content": "あのとき彼は言っておった、今後誰かがこの鈴を借りに来たら、必ず渡してほしいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140127,
					"content": "過去に、この鈴が借りられることは何度もあったのじゃが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140128,
					"content": "いつの間にか、鈴を借りに来る人はいなくなっておった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140129,
					"content": "ふう、ばあやの老いた体じゃ探すのにちと時間がかかりそうじゃ、少し待っててくれるかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140130,
					"content": "自分たちで探す。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "そうだよ、おばあちゃん。家まで送るから、探すのはオイラたちに任せてくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140132,
					"content": "ついでに、部屋の片付けもしてやるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140135,
					"content": "子供たちや、鈴ならすぐ近くに保管してあるから心配無用じゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140136,
					"content": "ん？おばあちゃん家ってこの近くにあるのか？うわ…ここって玉京台だぞ、金持ちなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140137,
					"content": "ほぉっほぉっ、ばあやじゃ城内に屋敷なぞ買えんよ——この壺を見ておくれ、ばあやの荷物は全部ここに入っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140138,
					"content": "荷物が全部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140139,
					"content": "家の鍵もこの中に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "ほぉっほぉっ…とにかく、鈴はこの壺の中にある。鈴が欲しいなら、中を覗いてみるとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140140,
					"content": "荷物って、まさか鈴だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "失礼だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140142,
					"content": "そ、そうだとしても、き、きっと貴重な鈴なんだ！おばあちゃん、そうだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140143,
					"content": "パイモン、壺に入って探してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "入るか！どう考えてもオイラが入れるわけないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140145,
					"content": "それに入る必要もない、蓋を開けて中を見ればいいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140133,
					"content": "ジンさんから探し物のコツを学んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "おう…いきなり自慢か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140121,
					"content": "あるものを借りに来た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "あるもの？ああ…「洗塵の鈴」を借りに来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140123,
					"content": "それ以外、若者が求めるものなぞ、このばあやは持っていないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140124,
					"content": "でも、その鈴はばあやのものではない、ある友達が持っていたものなんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140125,
					"content": "若い頃、ばあやは綺麗なものが好きでね。鈴が気に入ったから譲ってくれと友達にお願いしたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140126,
					"content": "そんなばあやに参ったのか、友達が鈴をくれてのう。でもそのとき、今後誰かがこの鈴を借りに来たら、必ず渡してほしいと言われたんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140105,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "ああ、気にせんでくれ。ただこの「琉璃百合」が散っていくのを見て、もったいないと思っておっただけじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "ピンばあや"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "子供たち、鈴がほしいんじゃろ？急がないのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140202,
					"content": "でも、この壺は長いこと掃除してないんだ、気を付けておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140203,
					"content": "綺麗な服を汚したら、大変じゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピンばあや"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ピンばあや"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "若者は体がよく動いていいのう。こんなにすぐ見つかるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140302,
					"content": "おばあさんは仙人なのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "仙人…その二文字を他人から言われたのは久方ぶりじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140304,
					"content": "ばあやが仙人かどうかは、もう分かっとるじゃろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140312,
					"content": "むぅ…わかったような、わからないような。でも、おばあちゃん…この鈴もっていっていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140313,
					"content": "変だと思わない？岩王帝君にあんなことがあったばかりなのに、鈴を取りにくるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140314,
					"content": "おかしな子じゃ。今まで、この璃月港からどれだけの仙人が去り、その度にどんな波風が立ったか知らないじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140315,
					"content": "しかし、そのどれもがしきたりに従って「送仙儀式」を行ってきた。ならば、今回も行うというのが筋じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140316,
					"content": "「犯人探し」ばかりして、「送仙儀式」を疎かにするなぞ本末転倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140317,
					"content": "今この時、鈴を借りに来た者が現れたのは、きっと旧友の誰かが耐え切れなくなって、立ち上がったからじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140318,
					"content": "だから、ばあやは鈴を渡す、当然じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140319,
					"content": "もし「旧友」が鈴を返さなかったら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "返さない？ほぉっほぉっ、仮にそうなったら、ばあやが直接行って返してもらうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140321,
					"content": "ずいぶんとご無沙汰しとるし、お茶でもしながら世間話するのもよいじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140326,
					"content": "さあ、鈴は渡したしお行き。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140327,
					"content": "それと、あなたたちにお使いを頼んだ人に伝言を頼みたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140328,
					"content": "時間があったら、お茶をしに来てほしい。ばあやの持ち物は少ないが、急須くらいは持っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140329,
					"content": "おう！伝えておく、ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140322,
					"content": "この鈴、くれない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "おい！これはおばあちゃんのだぞ！用事が済んだら返さないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140324,
					"content": "ほぉっほぉっ、素直な子じゃ。欲しいならそのまま持っとるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140325,
					"content": "でも、この鈴は寂しがり屋でね、いつの間にかこっそりばあやの元に戻ってるかもしれないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140305,
					"content": "「璃月七星」の方だよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "「璃月七星」…昔、ばあやとその仲間があの子たちのことを手伝っておったが、最近はそれもなくなったのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140307,
					"content": "ここ数年、彼らはよく頑張ってくれとるよ。ばあやたちは安心して任せられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140308,
					"content": "まさかファデュイの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "ファデュイ？ほぉっほぉっ、この子は想像力が豊かだね。何を考えてるんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140310,
					"content": "ばあやは年寄りだから、ああいう部外者とは関わりたくないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 10140311,
					"content": "でも、彼らの手がもう少し伸びてきたら、それも避けられないかもしれないねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "ピンばあや"
				}
			]
		},
