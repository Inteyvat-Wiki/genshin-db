					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "ああ、確かに「洗塵の鈴」だ…ふむ、いい状態だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140402,
					"content": "一緒に香膏も置いておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140403,
					"content": "ピンばあやとは知り合いなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "知り合いでなければ、鈴が彼女のところにあると知らないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140407,
					"content": "うーん…あやしいぞ！でも言いたくないなら、今は聞かないでおいてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140408,
					"content": "そうだ、おばあちゃんから伝言を預かってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140409,
					"content": "「時間があったら、お茶をしに来てほしい。ばあやの持ち物は少ないが、急須くらいは持っておる」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140410,
					"content": "ハハハッ、その口調、似合わないな。しかし、彼女の急須は確かにいいものだ、美味い茶が飲める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140411,
					"content": "時間があったら…いい茶葉を持って、彼女に会いに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140412,
					"content": "それで、儀式にはあとなにが必要なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140413,
					"content": "ああ、次は…<color=#00E1FFFF>凧</color>を買いに行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140414,
					"content": "凧！一緒に遊んでくれるのか？まさか…休憩時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140415,
					"content": "ハハッ、違う。凧は子供のおもちゃだが、璃月の儀式においては他にも象徴的な意味合いを持つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140416,
					"content": "詳しくはあとで説明する、まずは凧を手に入れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10140417,
					"content": "むぅっ…よくわからないけど、わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10140405,
					"content": "鍾離先生も仙人なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "仙人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "鍾離"
				}
			]
		},
