			"dialogs": [
				{
					"id": 200620301,
					"content": "杭は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620302,
					"content": "見つかったけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "ハッ…お前、やりすぎだろ。あんなに丈夫な杭がバラバラになるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620304,
					"content": "まあ、戦う時は誰も杭なんかのために手加減はしないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620305,
					"content": "そのままエリンに渡すわけにはいかないが…材料があれば、少し加工したら使えるようになるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620306,
					"content": "なんとか組み立てたが…まあ、それなりに使えるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620307,
					"content": "とにかく礼を言うぞ。報酬だ、ただ働きはさせないと言ったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620308,
					"content": "俺はもう冒険者じゃなくなったが、冒険者のルールは守るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルマン"
				}
			]
		},
