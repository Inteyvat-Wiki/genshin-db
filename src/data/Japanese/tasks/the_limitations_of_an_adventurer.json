					"ヘルマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "どうすればいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "ああ…娘のエリンは西風騎士団に入りたくて、今騎士選抜の準備をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620104,
					"content": "はあ…元々自分で指導しようと思ったが、あの子はどうしても俺が冒険者だって信じてくれなくて、一人で訓練すると言い出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620105,
					"content": "あの子に証明する方法もないし…なにせ家族ができた後はもう冒険ができなくなったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620106,
					"content": "自分の冒険欲と自尊心に比べて、家族を守ることが今の俺にとって大事なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620107,
					"content": "でも俺みたいな「冒険者」でも、できることはある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620108,
					"content": "昔冒険に行った時、ヒルチャールが訓練に使う杭を観察したことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620109,
					"content": "あの杭はなかなかクオリティが高いし、エリンの訓練にも使えるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620110,
					"content": "ヒルチャールの訓練用の杭をいくつか探してきてくれないか？冒険者のルールに従って、ただ働きはさせないさ。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620111,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "ハハッ、お前みたいなやつは気に入ったよ、冒険者になったばかりの頃の俺と似てる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620114,
					"content": "冗談だ、気を付けて行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620112,
					"content": "ヒルチャールくらいなら自分で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "だ、だめだ。冒険者の力にも限界がある。一人の冒険者は一つの冒険で精一杯だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620116,
					"content": "「結婚生活」という冒険は…どんな偉大な冒険者でも、全力で立ち向かうしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620117,
					"content": "だから、杭を集めるのはお前しか頼めないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルマン"
				}
			]
		},
		{
			"id": 2006202,
