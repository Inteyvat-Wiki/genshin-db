			"dialogs": [
				{
					"id": 200620201,
					"content": "杭は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620202,
					"content": "見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "おう…ハハッ、このクオリティはなかなかだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620204,
					"content": "ヒルチャールの訓練に耐えられるなら、きっとエリンの訓練にも耐えられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620205,
					"content": "ありがとう。冒険者のルールに従って、報酬を渡すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルマン"
				}
			]
		},
		{
