			"dialogs": [
				{
					"id": 200620601,
					"content": "この杭はなかなかいいよね、訓練の成果も上がった気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620602,
					"content": "でも、これほど丈夫な杭を、父さんは一体どこから見つけたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620603,
					"content": "ま、まさか買ってきたんじゃないよね？これいくらかかるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				}
			]
