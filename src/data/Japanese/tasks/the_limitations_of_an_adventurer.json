						200620402
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620402,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "エリンが訓練を頑張ってる。俺にできることはそれくらいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620404,
					"content": "俺がまだ冒険者だったら、自分で取りに行ったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620405,
					"content": "それにモンドの冒険者協会の現状からして…俺の「仲間」たちの多くはもう冒険者から身を引いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620406,
					"content": "それも仕方ないと思う。西風騎士団が強いからな、若者たちはみんな西風騎士になりたいと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "ヘルマン"
				},
				{
					"id": 200620407,
					"content": "野外で頑張る冒険者になりたい人はもういないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘルマン"
				}
			]
		},
		{
