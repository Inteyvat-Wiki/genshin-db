			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "どう訓練すればいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620502,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "今騎士選抜の訓練してるの。でもいくら訓練しても要領がつかめないし、指導してくれる人もいないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620504,
					"content": "昔は冒険者だったから指導できるよって父さんは言ってくれたけど、そんなの信じられないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620505,
					"content": "あの父さんに私を指導できるなんてとても思えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200620506,
					"content": "訓練用の道具を用意してくれるって言ってたけど、一体なにを用意するのだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				}
			]
		},
