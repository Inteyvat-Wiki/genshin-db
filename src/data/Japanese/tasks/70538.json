				]
			},
			"dialogs": [
				{
					"id": 705380101,
					"content": "のんびりできていいわ～！モンドの森はキャンプをするのにうってつけね。商売しに来た甲斐があったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380102
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705380102,
					"content": "湿度と温度が丁度良くて、ちょっと動いただけで全身汗だくになることもない。日差しもほどほどで爽やかな香りよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリア"
				}
			]
		},
		{
			"id": 7053803,
			"completionStepIds": [
				7053803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
