				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381301,
					"content": "（くつろいでるし、邪魔しないでおこう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381302
					]
				},
				{
					"id": 705381302,
					"content": "（それもそうだな。こんなところでキャンプをするくらいだから、誰にも邪魔されたくないんだろ…そっと立ち去ろうぜ）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7053814,
			"completionStepIds": [
				7053801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
							"2"
						],
						"stepId": 7053801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381401,
					"content": "（栄誉騎士として見過ごせない！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381402
					]
				},
				{
					"id": 705381402,
					"content": "し…親切なジュリアさん？悪いんだけどさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381403,
					"content": "おまえが意図せず犯した罪が、おっきなトラブルを巻き起こしてるんだ。モンドの法律に関わることだから…手を出させてもらうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381404,
					"content": "えっ？何の話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381405
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381405,
					"content": "ちょっと待って！あなたたち…今にも何か襲いかかりそうな雰囲気だけど、狩りにでも行くの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381406
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381406,
					"content": "その必要はないわよ。食材ならたくさん蓄えてあるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381407
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381407,
					"content": "きゃあっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリア"
				}
			]
		},
		{
			"id": 7053815,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053801",
							"2"
						],
						"stepId": 7053801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381501,
					"content": "（越権行為はしたくない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381502
					]
				},
				{
					"id": 705381502,
					"content": "（えっけん？急に変な言葉を言うなよ？…でもどこかで聞いたことがあるな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381503,
					"content": "（つまり、犯人を捕まえるのは他の騎士の仕事だって言いたいのか？オイラたちの役目じゃないことをしちゃダメ、他人の手柄を奪っちゃダメ…ってことか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381504,
					"content": "（むむ…考えてみるともっともだ！ジュリアさんは罪を犯したけど、根っからの悪党ではなさそうだしな…普通の騎士でも彼女を捕まえられるよな）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381505,
					"content": "（普通の騎士にしてみれば、楽チンで手柄を立てる恰好のチャンスだ。オイラたちにそんな手柄があっても意味がないし、ここは騎士たちに譲ってやろう…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381506,
					"content": "（でもジュリアさんが今いる場所は、街からずいぶん離れてるだろ。騎士たちはすぐ見つけられるのかな？なんとかしてジュリアさんをモンド城の近くまで連れ戻さないとな）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381507,
					"content": "こっそり何を話してるの？放流の話に興味があるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381508
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381508,
					"content": "あっ！さっき…ジュリアさんが魚の話をしたから…晩ご飯はなににしようかと思ってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381509,
						705381510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381509,
					"content": "急に焼き魚が食べたくなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				},
				{
					"id": 705381511,
					"content": "えっ？あっ…ああ！そうそう！それだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381512,
					"content": "せっかくモンドへ来たなら、モンド風焼き魚は外せないぞ。香ばしくて食べやすいんだ。それからニンジンとお肉のハニーソテー、山盛りの完熟トマトのミートソース！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381513,
					"content": "あら!言われなければ忘れるとこだったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381514
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381514,
					"content": "ずっと商売のことだけを考えてて、取引を終えた今は自然を堪能してたの。モンド城内で食事を楽しむことなんて、頭からすっぽり抜けてたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381515
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381515,
					"content": "「鹿狩り」というレストランが安くておいしいと耳にしたの。配達もしてくれるから、何度か適当に注文したことがあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381516
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381516,
					"content": "でもあの時、モンドの名物料理といえば何なのかを聞き忘れちゃって。私がキャンプをしてるこの場所まで配達員が来られるとも限らないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381517
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381517,
					"content": "それなら、少ししたらモンド城へ戻ってごちそうをたらふく食べたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381518,
					"content": "そうね！ついでに、モンドには他にどんな特産があるのか地元の人に聞いて、友人へのお土産に買って帰ろうかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381519
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381519,
					"content": "たしか城門のそばで二人の騎士が見張りをしてたわ。彼らなら詳しいはずだし、いいアドバイスがもらえるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381520
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381520,
					"content": "ぐずぐずしてられないわね。今すぐ戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381521
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381521,
					"content": "ジュリアはウキウキとキャンプを後にし、モンド城の方へと急ぎ足で向かっていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705381522
					]
				},
				{
					"id": 705381522,
					"content": "ジュリアさん、自分から騎士と話しに行くことになったな…喋ってるうちに逮捕されるだろうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381523,
					"content": "でも彼女がしたことに悪気はなかったと、騎士たちも気づくはずだ。そもそも進んで悪さをしたやつが、自分から出向くわけないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381524,
						705381525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381524,
					"content": "きっと軽い罰で済むだろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381526,
					"content": "そうだな！ちょっと悪いと思うけど、彼女が犯した過ちには変わりはないから、その責任を取るべきだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381527,
					"content": "ジュリアさんには自分の過ちに気付いて、罰金を支払っても、あまり気を落とさないことを祈ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381525,
					"content": "穏便な方法で問題を解決したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381510,
