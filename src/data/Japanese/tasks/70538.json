							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053803",
							"2"
						],
						"stepId": 7053803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ポルト"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2261.872,
							235.99,
							-784.188
						],
						"pointId": 6247
					}
				]
			},
			"dialogs": [
				{
					"id": 705380301,
					"content": "流石は栄誉騎士に白い助手さん。あっという間に逃亡犯を見つけたわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380302
					],
					"speakerTitle": "ポルト"
				},
				{
					"id": 705380302,
					"content": "以前から同僚たちは彼女を容疑者として見ていた。素性とモンドを発つ時間を確認した後、彼女はドーンマンポートのほうへ逃げ、船に乗り出国すると思われていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380303
					],
					"speakerTitle": "ポルト"
				},
				{
					"id": 705380303,
					"content": "まさか明冠山地に潜り込んでいたとは。道理で足取りが掴めなかったわけだ…見事に捜査の裏をかかれたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380304
					],
					"speakerTitle": "ポルト"
				},
				{
					"id": 705380304,
					"content": "えっと、彼女に逃げ隠れするつもりはみじんもなかったと思うぞ…そもそも、何が起きたのかまったく気付いてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380305,
					"content": "とにかく、ジュリアさんは罪を犯したけど悪気はなかったはずだ。お手柔らかに頼むぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380306,
					"content": "当然だ。彼女には誠意があると聞いてる。犯人でも協力的なら、我々だって心穏やかに説き聞かせられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380307
					],
					"speakerTitle": "ポルト"
				},
				{
					"id": 705380307,
					"content": "調査小隊の話では、現時点の状況と損害は完全に把握できているそうだ。あとは我々が規定に則り、彼女の招いた損失を評定し、妥当な罰金を科すのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380308,
						705380309
					],
					"speakerTitle": "ポルト"
				},
				{
					"id": 705380308,
					"content": "罰は罰金で十分だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				},
				{
					"id": 705380310,
					"content": "ふぅ…この事件にオイラたちも関わるなんて思わなかったぜ…騎士団が犯人を捕まえるってこんな感じなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380311,
					"content": "それにしても、悪気があってモンドの酒造業を陥れようとしてたわけじゃなくて、過失だったからよかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380312,
					"content": "もし凶悪な犯人だったら、捕まえても頑なに反省せず、うるさく騒ぎ立ててただろ。そうなればオイラたちまで一日の気分が台無しになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705380313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380313,
					"content": "ジュリアさんには自分の間違いをよくわかってくれたらいいんだけどな。罰金を支払っても、あまり落ち込まないことを祈ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705380309,
					"content": "根は悪くないからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705380310
					]
				}
			]
		},
		{
			"id": 7053811,
