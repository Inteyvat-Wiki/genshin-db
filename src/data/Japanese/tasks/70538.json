			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381101,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381102
					]
				},
				{
					"id": 705381102,
					"content": "あら、新しいお友達ね！どうぞ座って。お茶やお食事はいかが？おしゃべりしましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381103
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381103,
					"content": "私はジュリアって言うの。スメールから来た商人よ。ちょうど大きな取引を終えたところでね。今はモンドの自然を味わってるところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381104
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381104,
					"content": "ここでキャンプをする人には初めて会ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381105,
					"content": "普通、商人は…自分の店や商品を守るべきだろ？言われなきゃ商人だなんて思いもしなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381106,
					"content": "あらま、商人にも休みは必要なのよ。誰にでも趣味はあるものでしょ？労働と休息のバランスが肝心なのよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381107
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381107,
					"content": "スメールでは四六時中、学業に追われてる学生でさえこのことを大事にしてるわ。自分でゲームを発明して気晴らししてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381108
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381108,
					"content": "私の商売の元手は、ある学生が発明したボードゲーム「ゴロゴロ炸裂キノコ」を代わりに販売して稼いだお金よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381109
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381109,
					"content": "あの天才学生は言ってたわ。「仕事に終わりはないから、適度に休息を取って…サボらないと」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381110
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381110,
					"content": "彼女のお陰でそれまで想像もつかなかった富を得たわ。だから彼女の言葉を自分のモットーにしてるの。お陰で毎日楽しく過ごせてるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381111,
						705381112
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381111,
					"content": "その天才に覚えがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				},
				{
					"id": 705381113,
					"content": "ジュ、ジュリアさん…「ゴロゴロ炸裂キノコ」を代わりに販売することになった経緯を詳しく聞かせてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381114,
					"content": "あら？あなたたちもこのゲームを聞いたことがあるの？結構昔のゲームなのに…数年あるいは十数年になるかしら。時間が過ぎるのはあっという間ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381115
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381115,
					"content": "たまたまよ。当時、その学生はちょうど故郷に帰るところだったの。そこで持ち帰れない荷物を売ることにしたのよ。荷物の中に「ゴロゴロ炸裂キノコ」の駒と碁盤が含まれてたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381116
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381116,
					"content": "あの頃の私は廃品を回収するただの雑貨商で、運よく彼女に出会えたの。そして駒のことを尋ねたら、自分の発明したゲームがまだ遊べると気付いたみたいで、簡単に教えてくれたのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381117
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381117,
					"content": "彼女は私に、苦労を惜しまないのなら、そのゲームを今後も広めるように言ったわ。それで試しに数セットを復刻販売してみたら売れ行きがよかったの！収入がウナギのぼりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381118
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381118,
					"content": "「ゴロゴロ炸裂キノコ」の流行りは長くは続かず、すぐに他のゲームに取って代わられたけど、大きな商売をするための元手を稼ぐことができた。雑貨売りで生計を立てなくてもよくなったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381119
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381119,
					"content": "天才学生がそれとなしに言ったことが、私の運命を変えたと言えるわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381120,
						705381121
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381120,
					"content": "そんなうまい話、ホントにある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381122,
					"content": "よくよく考えれば彼女らしいぞ…当時は手当たり次第にいくつもゲームを作ってたんじゃないか？「ゴロゴロ炸裂キノコ」はそこまで重要な作品じゃなかったとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381123,
					"content": "でも商売で、ゲームのあの権利、この権利って管理するのは面倒に違いないぞ…金稼ぎよりも気苦労の少ないほうをとったんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381124,
					"content": "きっとそうね。あなたたちもたまたまだと思うわよねえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381125
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381125,
					"content": "後になって天才学生はモンドの出身だと聞いたの。以来、モンドには限りなく好感を抱いてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381126
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381126,
					"content": "それで何年もの間、機会があればモンドで商売をして、この土地の風土や人情を感じたいと思ってたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381127
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381127,
					"content": "モンドは期待通りの場所だったわ！大きな取引も決まったし、存分に遊ばせてもらってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381128
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381128,
					"content": "あなたたちも試してみるといいわよ。労働と休息をうまく組み合わせれば、心地よく暮らすためのリズムを見つけられるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381121,
					"content": "自分の作品をそんな簡単に譲れちゃう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381122
					]
				},
				{
					"id": 705381112,
					"content": "学生ってのはもしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381113
					]
				}
			]
		},
