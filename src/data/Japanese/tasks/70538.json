			"dialogs": [
				{
					"id": 705381201,
					"content": "商売？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381202
					]
				},
				{
					"id": 705381202,
					"content": "あら、地元の人？座ってスープでも飲む？何か食べる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381203
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381203,
					"content": "親切だな！おまえは…キャンプ愛好家か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381204,
					"content": "あはは、それも間違ってないわ。私はジュリアよ。スメールの商人なの。しばらくすれば私の名前も覚えられるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381205
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381205,
					"content": "査定が済んだらブランシュさんのところで私の商品を買えるようになるわよ——スメールの特色ある食材や香料、食器をね。安価で質もいいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381206
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381206,
					"content": "モンド人って穏やかよね。とんとん拍子で取引がまとまって、値段交渉もほとんどしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381207
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381207,
					"content": "スメール人が付き合いにくいわけではないのだけど…私たちはロジックと細部を重視するわね。大口注文の金額を話し合う時はいつも商談が長引くのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381208,
						705381209
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381208,
					"content": "スメールにもあっさりした人はいるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381210
					]
				},
				{
					"id": 705381210,
					"content": "そうだぞ。どこにでもいろんな人がいるぜ。一緒くたにはできないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381211,
					"content": "今まで商売がうまくいかなかったのは、単に運が悪かったせいかもしれないぞ。今回モンドへ来た時、たまたまツイてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381212,
					"content": "ツイてた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381213
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381213,
					"content": "確かにそうね！モンドに着いてすぐ、商売繁盛を願って魚を放したの…あれが私に幸運を運んでくれて、理想の取引先と出会えたのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381214
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381214,
					"content": "魚を…放した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381215,
					"content": "そうよ！ここで会ったのも何かの縁だし、こっそり教えてあげるわ。フォンテーヌへ行ったことのある商人から聞いた秘密で、ごく少数のスメール人しか知らないことなんだけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381216
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381216,
					"content": "大事なことを成す前に動物を放流すると運気が好転するのよ！中にはわざわざ動物を買って放流する人までいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381217
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381217,
					"content": "ハンターの仕事をしたことがあるなら、自分のためにやってみるといいわね。お金は多少かかるけど、入ってくる幸運は大きくて、試す価値があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381218
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 705381218,
					"content": "#{NICKNAME}、まさか…シードル湖に突然現れたコオニフグって、彼女が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381219,
						705381220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381219,
					"content": "（この商人が諸悪の根源だ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381221
					]
				},
				{
					"id": 705381221,
					"content": "（自分が大きな過ちを犯したとは知らないみたいだ…どうする、教えてやるか？すでに事態は深刻だぞ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381222,
					"content": "（それとも、今すぐ彼女を捕まえて騎士団のところへ送り届け、処遇を決めてもらうか？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381223,
					"content": "（うぅ…選べないぞ…彼女は親切でいい人だし、オイラたちをもてなしてくれたばかりだ。急に態度を変えたらあんまりじゃないか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705381220,
					"content": "（うっかり屋さんすぎるでしょ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381221
					]
				},
				{
					"id": 705381209,
					"content": "モンドにも抜け目ない人はいるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381210
					]
				}
			]
		},
		{
			"id": 7053813,
			"completionStepIds": [],
