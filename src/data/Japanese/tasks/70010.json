			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "依頼について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "私の依頼を見てここに来たの？確かに君に手伝ってほしいことがあるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100103,
					"content": "具体的に言うと、君たちにドラゴンスパインに行って、写真を2か所撮ってきてほしいの。位置はあとでマップに記してあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100104,
					"content": "もちろん冒険者協会のルールに則って、適切な報酬をあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100105,
					"content": "どう？考えてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100106,
					"content": "どうして写真を撮るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "そのことは…サイリュスと関係があるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100108,
					"content": "前にドラゴンスパインの特産を送ってほしいって頼まれたの。風花祭でそれを使って協会の宣伝をするらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100109,
					"content": "でも、もう風花祭なのに、サイリュスからなんの連絡もないの。風花祭だから忙しいのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100110,
					"content": "たしかに…アイツも風花祭が忙しくなる年頃になったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100111,
					"content": "もうその年頃は大分過ぎてると思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "そう？私は別になにも思わないけど…まっ、このことは別にいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100113,
					"content": "私もいくつか鉱石を集めたり、地形図と魔物の記録を整理したわ。あとはドラゴンスパインの景色を撮るだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100114,
					"content": "旅人、ドラゴンスパインに行って、写真を2か所撮ってきてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100115,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "じゃあ任せたわね。具体的な位置はマップに記したから、そこに行くといいわ。終わったら私のところまで来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100117,
					"content": "城内に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "城内は賑やかすぎて、苦手なの。私はここの方が落ち着けるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100119,
					"content": "それにここでもやるべきことがたくさんあるから、しばらくは戻れないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100120,
					"content": "写真を撮る位置はマップに記したから、そこに行くといいわ。終わったら私のところまで来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
