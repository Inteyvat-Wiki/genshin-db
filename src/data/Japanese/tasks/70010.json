			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "…ん？なにか？今から歌おうとしてるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100502,
					"content": "冒険者協会の募集について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "それね、広告は見たわ。でもあまり興味がないの。それに、冒険者協会に入会しなくても、歌声だけでモンドを守れるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100504,
					"content": "それに冒険者協会に入会しても、ほとんど雑用を任せられるでしょ、私にとっては無意味なことだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100505,
					"content": "だから、冒険者協会にはあまり興味がないの。誘ってくれてありがとう、ごめんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100506,
					"content": "募集に関する資料を見て。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "え？これって雪山だよね。雪の中の七天神像って…意外と神秘的だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100508,
					"content": "そうだ、ここって高いのかな？聞いた話だけど、雪山ってものすごく高いんだって。そこで歌うと声もきっと遠くへ届くよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100509,
					"content": "後で冒険者協会に行って聞いてみるよ。たしか、そこで冒険者を雇えるらしいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "ヘレン"
				},
				{
					"id": 700100510,
					"content": "でも、冒険者ってこんなところにも行けるんだね、意外と面白そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘレン"
				}
			]
		},
