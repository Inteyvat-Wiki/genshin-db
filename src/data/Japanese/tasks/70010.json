			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "どうだい、みんなの意見はもう聞いたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100602,
					"content": "聞けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "前も言ったと思うが…まぁこんな状況なんだ、俺はもう慣れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100604,
					"content": "どんな方法でも構わないから、目的を達成できればそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100605,
					"content": "この後雪山に戻って玉霞に依頼の状況を報告するんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100606,
					"content": "じゃあついでに、この手紙を彼女に渡してきてくれないか。彼女も協会の近況を知りたがっていると思うから、頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100607,
					"content": "はぁ、今度こそ新人を雇えるといいが…こんな方法で雇った新人は、本当に一人前の冒険者になれるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
		},
