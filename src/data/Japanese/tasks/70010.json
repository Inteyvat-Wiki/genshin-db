						700100702
					]
				},
				{
					"id": 700100702,
					"content": "帰ってきたの。結構時間がかかったじゃない、サイリュスに何か余計なことを頼まれたのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100703,
					"content": "サイリュスさんのために情報を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "アイツは何を考えてるの？…ん？その手紙は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100705,
					"content": "この手紙に協会の近況が入ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "分かったわ。こんなに厚い手紙…確かに風花祭でも休む暇がないみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100707,
					"content": "でも、そんなに頑張ってるのなら、モンド城の冒険者協会にも新人がたくさん入るんじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100708,
					"content": "新人がたくさん入れば、そんなに忙しくなくなって、私とまた冒険に行けるかしら…それもいいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100709,
					"content": "この手紙はしっかり読んでおくわ。でもサイリュスにこき使われた君には、報酬を多くあげないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100710,
					"content": "ご苦労様。これは報酬よ、受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
