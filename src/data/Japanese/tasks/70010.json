				"objectNames": [
					"ジョセ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "やあ、よく来てくれた！このジョセの最新作を聴いていかないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100402,
					"content": "冒険者協会の募集について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "冒険者協会の募集？すまない、あまり興味がないんだ。あっちこっち駆け回る仕事は、詩を書くためにならないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100404,
					"content": "しかも、ここモンドで歴史の詩を書くには…騎士団をモデルにするのが一番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100405,
					"content": "だから冒険者協会の募集には興味がない。依頼主のために猫を探す冒険者になっても、詩は上達しないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100406,
					"content": "募集に関する資料を見て。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "これは…雪山の景色なのか？見た感じ悪くないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100408,
					"content": "このようなところに行けたら、新たな刺激が見つかるかもしれない。この周りを見ても、それほど危険じゃないみたいだしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100409,
					"content": "うん…後で冒険者協会に行って聞いてみるよ。入会しなくても、冒険者を雇って一緒に見に行くのも良いかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "ジョセ"
				},
				{
					"id": 700100410,
					"content": "雪山の旅か…良いかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョセ"
				}
			]
		},
