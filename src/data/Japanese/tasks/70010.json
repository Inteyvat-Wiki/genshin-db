			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "依頼について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "どう？終わったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100203,
					"content": "終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "ご苦労だったわ。サイリュスにおくるものは包んであるから、持って行ってちょうだい。戻ってきたら報酬をあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 700100205,
					"content": "足りるかどうか分からないけど、もし新人を募集するのであれば、魔物の記録と鉱石が一番魅力的でしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サイリュス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "はぁ、この募集計画もダメそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100302,
					"content": "玉霞からの贈り物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "ん？俺に贈り物？ああそうだ…前に頼んだんだ。自分でも忘れてたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100304,
					"content": "風花祭で忙しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "風花祭？そんなことをする暇はない。前に決めた募集計画がダメそうなんで、新しい計画を練ってる最中だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100306,
					"content": "玉霞から何が送られてきたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100307,
					"content": "鉱石…ダメだ…今の若者はそんなのに興味はない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100308,
					"content": "地形図…協会の人なら使うかもしれないが、新入りの募集には役に立たない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100309,
					"content": "魔物の調査記録…これも協会の冒険者にはぴったりだが…募集には…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100310,
					"content": "おっ？この2枚の写真、悪くないな。景色も良いし、見るからに安全そうだ。この写真から興味を持ってくれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100311,
					"content": "どうしてこれを選んだの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "冒険者と関係があるものを避けてるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700100313,
					"content": "協会の現状を知らないからそんなことが言えるんだ。今の若者は、魔物やら鉱石やら地形図なんかに興味はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100314,
					"content": "彼らの注意を引くためには、もっとこう…「現実的」なものじゃないとダメなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100315,
					"content": "今は風花祭だ。若者たちはみんな、普段とは違った方法で自分をアピールしたがる…もちろん危険がない方法でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100316,
					"content": "ドラゴンスパインを探検することもその方法の一つだ。誰かが興味を示せば、協会に問い合わせがくるだろう。そうすれば、協会に入ってくれる可能性も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100317,
					"content": "まぁ、入るとまではいかなくても、依頼をしてくれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100319,
					"content": "それにこの写真の位置、2枚とも大通りのそばだから、気を付ければ危険に遭うこともないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100320,
					"content": "もうこんな方法でしか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "これが現状なんだ。他に方法があればこんなことはしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100322,
					"content": "まっ、それでも信じられないのなら、その2枚の写真を持って周りの人に聞いてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100323,
					"content": "まず彼らに、冒険者協会の募集だと伝えて、その2枚の写真を「募集資料」として見せてみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 700100324,
					"content": "そしたらきっと、なんで俺がこんなことをしてるかが分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
