				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "普段はここにいるのに、今日は痕跡すら見当たらない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260302,
					"content": "ショックでどこかに隠れちゃったのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260303,
					"content": "どこにいるのか探してみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "…いや、しばらくそっとしておこう。今日はキャンドルキノコをここに置いていけばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260305,
					"content": "あの子のこと、よく知ってるんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "まあ、しばらく面倒を見てたからな。もともと繊細な子でさ、知らない人に会うだけでもびっくりするくらいだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260307,
					"content": "長い間ご飯をやって、ようやく近づいてくれるようになったのに…はぁ…あの悪党どものせいでまた引きこもってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260308,
					"content": "仕方がないから、しばらくそっとしてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260309,
					"content": "一緒に来てくれてありがとう。報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260310,
					"content": "会えなかったのはちょっと残念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "大丈夫だ。良くしてくれた人のことはちゃんと覚えてるから、そのうち自分から会いに来てくれるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260311,
					"content": "やっぱり会ってみたかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
