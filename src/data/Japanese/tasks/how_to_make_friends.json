			"dialogs": [
				{
					"id": 250260501,
					"content": "ふん、もうユムカ仔竜を傷つけるような度胸はないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260502,
					"content": "何か、誤解があったような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "やつらの言葉に耳を傾けちゃだめだ。俺はやつらがユムカ仔竜に縄を結び付けようとしたところをこの目で見たんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260504,
					"content": "俺がその場にいなかったら、どうなってたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260505,
					"content": "手伝ってくれてありがとう。この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260506,
					"content": "ああ、くそっ、やつらの逃げ足が早すぎた。もしやつらを捕まえたら、次こそ全員とっちめてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティアモ"
				}
			]
