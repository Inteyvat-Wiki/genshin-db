			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティアモ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "先にユムカ仔竜に会いに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "うん…それも一理あるな。あの子はきっとすごくショックを受けてるから、早く行ってあげた方がいいかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260203,
					"content": "じゃあ、ついてきてくれないか。その見た目からして経験豊富な冒険者なんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260204,
					"content": "俺たちが一緒なら、あの野郎どもも無闇に近づけないだろう。報酬のことは心配するな。冒険者のルールに従ってちゃんと用意するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260206,
					"content": "たしか、あの子は新鮮なキャンドルキノコが大好物だったな…あそこの木の下にたくさん生えてるはずだから、あっちで採ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260205,
					"content": "俺は反対側でキャンドルキノコを採る。競技場の近くの崖で落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "ティアモ"
				},
				{
					"id": 250260207,
					"content": "あの子がよく休んでいたところに行けば、会えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ティアモ"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
