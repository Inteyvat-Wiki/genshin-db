			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.274,
							451.958,
							4735.029
						],
						"pointId": 17224
