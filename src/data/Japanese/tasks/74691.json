					{
						"sceneId": 3,
						"position": [
							3459.075,
							446.463,
							4717.811
						],
						"pointId": 340100825
					}
				]
			},
			"dialogs": [
				{
					"id": 746910101,
					"content": "…ん？あ、あそこにいるのは…ドドコか？オイラの見間違いじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910102,
						746910103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746910102,
					"content": "ここはフォンテーヌだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				},
				{
					"id": 746910104,
					"content": "いや…やっぱりドドコだぞ！しかもあれは…バーベロスのドドコだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910105,
						746910106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746910105,
					"content": "よかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910107,
					"content": "おや、これは奇遇だね。旅人、それにパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910108
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910108,
					"content": "バーベロスみたいな凄腕の占い師の口から「奇遇」って言葉を聞くのは、なんだか変な感じがするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746910109,
					"content": "正真正銘、「奇遇」だよ。わしは冗談など言ってないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910110
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910110,
					"content": "旅人は世界の外から来た「降臨者」だからね。運命がテイワットに縛られていないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910111
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910111,
					"content": "ヒッヒッヒッ、たとえどんな占い師だろうと、おまえの未来は予測できないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910112
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910112,
					"content": "だが、今回の「奇遇」は実に絶妙だ。少し前に、おかしな予兆を垣間見たんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910113
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910113,
					"content": "ちょうど暇を持て余していたもんだから、その一筋の予兆を少しばかり占って、その軌跡を辿っておったのさ…ちょっとした気晴らしと、短い休暇ってところだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910114
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910114,
					"content": "そうそう、予兆を追っている最中に、おぼろげな運命の糸を何本か捕まえてね。その主の姿も見てみたんだ。それが、こいつらだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910115
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910115,
					"content": "みんな…知り合い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910116
					]
				},
				{
					"id": 746910116,
					"content": "ほら、だから言ったでしょ？旅人はとっても友達が多いから、彼らのことも知ってるはずだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910117,
						746910118
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910117,
					"content": "この声は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910119,
					"content": "ハ～イ、旅人、パイモン！会うのは結構久しぶりよね？今回、バービーが占いをした時に私も参加したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910120
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910120,
					"content": "ああ。アリスがしつこくせがまなければ、わしはこれらの名前を無視しても問題ない変数として、占いの算式から除外していたところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910121
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910121,
					"content": "それじゃ、休暇が取れなくなってたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910122
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910122,
					"content": "そ・れ・に！魔女が予言を導き出したからには、その予言に関わる子供たちをガッカリさせるわけにはいかないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910123
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910123,
					"content": "みんな、新しいプレゼント、偉大な使命、そして神秘的な予言を待ち望んでいるんだもの…とにかく、省略するなんて絶対にダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910124
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910124,
					"content": "…まったく、おまえには呆れたよ。だが、こうした微小な変数を集めれば、わしの算式も少しは修正できるかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910125
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910125,
					"content": "ここへ来たのは、そういうわけさ。彼らに会って、可能なら簡単な占いでもしてやろうと思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910126
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910126,
					"content": "えっと…それで、みんなはいつ来るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910127
					]
				},
				{
					"id": 746910127,
					"content": "そんなことまで詳しく占う暇はないが、これだけは言えるね——遅かれ早かれやって来るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910128
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910128,
					"content": "つまり、ここに露店を出してずっと待ち続けるつもりなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746910129,
					"content": "大丈夫、このドドコはただの身代わりだからね。本体のわしはしっかり研究を続けておるから、時間の無駄にはならないのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910130
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910130,
					"content": "そうなのよ！バービーのドドコには自動感知システムを搭載してあげたから、お目当ての人が屋台の前に来たら彼女に知らせが届くようになってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910131
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910131,
					"content": "それに、ドドコも楽しそうに体をくねらせるから、視線を釘付けにすること間違いなし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910132
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910132,
					"content": "何しに戻ってきたんだい？腕をどかしな、水占の盤が落ちてしまうじゃないか。あと、そのホットチョコレートをわしの原稿用紙にこぼさないよう、カップはしっかりと持つんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910133
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910133,
					"content": "はいはい、ちょっと待っててね…これでよし、っと。そうそう、バービー、このカップはあなたの分だから。本当に、砂糖はほんの少ししか入れてないの。誓ってもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910134
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910134,
					"content": "おまえにとっての微糖とわしにとっての微糖は、甘さに大きな差があるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910135
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910135,
					"content": "コホン…話がそれちゃったね！とにかく、バービーの占いの結果を聞いた時、本当なら私はその子たちを集めて、素敵なパーティーを盛大に開こうと思ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910136,
					"content": "招待状の届け方まで考えて、わざわざカッコいい鳥をたくさん探したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910137
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910137,
					"content": "想像してみて。みんなが寝静まった深夜に、純白の巨鳥が不思議な招待状をくわえてやってくるの。その封筒を開けると、今まで見たこともない世界に——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910138
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910138,
					"content": "だが、そんなことをしても運命の軌跡を乱すだけだ。それに、こんな些細な予言の面倒を見てやるなんて面倒くさいったらありゃしない。そりゃ、止めるに決まってるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910139
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910139,
					"content": "残念だけど、パーティーを開く機会はまだまだあるよね！ちょうどいいタイミングが来たら、みんなを招待するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910140
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910140,
					"content": "少しでも早くパーティーを開くために、旅人、パイモン！その子たちを連れてくる任務は、あなたたちに任せたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910141
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910141,
					"content": "い、いいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910142
					]
				},
				{
					"id": 746910142,
					"content": "あはは…これも運命の軌跡を乱すことになるんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746910143,
					"content": "ふむ…こいつらはもともと旅人と関わりがあるし、理論的には、すでに運命も絡み合っておるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910144
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910144,
					"content": "旅人が出向いて呼んできたとしても、占いへの影響はさほどないだろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910145
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910145,
					"content": "さすがは旅人、やっぱり頼りになるよ。パーティーのためにもお願いね。ケーキに一番近い特等席を二つ、取っておいてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910146
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910146,
					"content": "…バービー、どうして紙をちぎってるの？何をするつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910147
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910147,
					"content": "これで耳を塞ぐのさ。おまえは耳にうるさくて、ニコは頭に響くときたもんだ。まったく、オクタヴィアが恋しいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746910118,
					"content": "アリスさん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910106,
					"content": "世界はついにドドコに占領されたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910103,
					"content": "いろんなドドコの見すぎで幻覚が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				}
			]
		}
	]
}