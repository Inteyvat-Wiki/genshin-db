			"dialogs": [
				{
					"id": 790720101,
					"content": "#おや、これはこれは、噂の{NICKNAME}じゃないか。隣にいるのは、きっと仲間のパイモンだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720102,
					"content": "へへ、その通りだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790720103,
					"content": "#{M#俺}{F#私}たち、そんなに有名なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "オルビット城は、ほかの場所よりも噂が広まるのが速いからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720105,
					"content": "ちょうどいいところに来てくれた。「フライングハット」というゲームを完成させたばかりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720106,
					"content": "『フライングハッター』の帽子職人みたいに、みんなに素敵な帽子をプレゼントすることはできないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720107,
					"content": "この「フライングハット」ゲームを遊ぶ人たちに楽しいひと時を過ごしてもらうことはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720108,
					"content": "ゲームにはそれぞれ別の三つの遊び方があって…ああ、もちろん全然難しくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720109,
					"content": "少し遊べば、すぐ覚えられると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720110,
					"content": "試してみたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "じゃあ、こっちに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デヴィット"
				},
				{
					"id": 790720112,
					"content": "ちょっと立て込んでて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "そうかそうか。時間があったらまた来てくれ。僕はもうしばらくここにいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デヴィット"
				}
			]
		}
