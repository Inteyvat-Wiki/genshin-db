			"dialogs": [
				{
					"id": 761490101,
					"content": "だ、誰ですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}。現代の人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "あなたたちの時代のことは存じ上げませんが、わたしはアラーラと申します。静寂期の修行者でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490104,
					"content": "ここに来てからどれほどの時が経ったのか、もう覚えていません。守り続けていた戒律も、すでに破ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490105,
					"content": "やはり、無念無想の修行は、人を無想悪天へと転生させてしまうものなのですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490106,
					"content": "大したことじゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "お礼なんていらないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "いえいえ、本当にありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490109,
					"content": "君を助けたのはついでみたいなものだよ。僕たちは瞑想以外の方法でここから出るつもりなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490110,
					"content": "瞑想が苦手なのですか？それとも、あなたたちの時代ではそういった技術を教わらないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490111,
					"content": "僕が初めてここに来た時は、離れるのに数百年もの歳月を費やした。そうして真理を探究したいと願う欲望や、親しい者たちに会いたいという欲望を捨て去ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490112,
					"content": "今度こそ、僕は何も手放さずに出たい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490113,
					"content": "わたしも仲間に入れてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490114,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761490115,
					"content": "みっちゃんがまた「亡念の破片」を拾ったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490116,
					"content": "死念？死随{RUBY#[S]しすいねん}念なら知っていますが…死に直面した時の心境を鍛えることができるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490117,
					"content": "カテリンドも見つかったことだし、ここから脱出する方法を探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490118,
					"content": "本当に、自力でここから出られるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761490119,
					"content": "メランタとニヒリットが人を連れて自由に出入りできるんだから、みっちゃんにだってできるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490120,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761490121,
					"content": "「亡念の破片」を三つ集めたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490122,
					"content": "あっ、「亡念の破片」というのは仮の名前だよ。みっちゃんがこれを集めて何をするつもりなのかわからないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490123,
					"content": "みっちゃん、次はどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761490124,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761490125,
					"content": "みっちゃんが示す方へ進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イストリア"
				}
			]
		},
