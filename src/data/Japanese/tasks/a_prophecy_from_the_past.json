			"dialogs": [
				{
					"id": 160011501,
					"content": "これにする！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011502
					]
				},
				{
					"id": 160011502,
					"content": "客人は、レンジャーの弓をプレゼントに選びました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011503
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011503,
					"content": "レンジャー…ドゥリンもこの世界を冒険したかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160011504,
					"content": "旅人とパイモンの影響を受けたのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011505
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011505,
					"content": "モンドからナド・クライまで、これまでいろんな場所をまわって、たくさんの人に出会ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011506
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011506,
					"content": "そういう人たちと話す時…生まれや育ちが遠くても、一つだけ共通の話題があるって気づいたんだ——二人の話題だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011507
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011507,
					"content": "そうだったのか…へへっ、オイラたちは有名な冒険者だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160011508,
					"content": "冒険者ってつまり、世界を探索するレンジャーでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011509
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011509,
					"content": "ボクはずっと、冒険者は物語を追う者であると同時に、自分たちの物語を残す者でもあると思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011510
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011510,
					"content": "ボクも…そうなりたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥリン"
				}
			]
