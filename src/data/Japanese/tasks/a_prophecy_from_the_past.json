			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドゥリン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2256.417,
							230.083,
							-808.091
						],
						"pointId": 14073
					}
				]
			},
			"dialogs": [
				{
					"id": 160010201,
					"content": "よう、ドゥリン！次のヒントは出て来たか？オイラたちは次の章に入る気満々だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010202,
					"content": "いつでもオッケー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010203
					]
				},
				{
					"id": 160010203,
					"content": "ありがとう。ちょうど二人に会いに行こうと思ってたんだ。とりあえず一緒に見てくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010204
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010204,
					"content": "風が音楽を運び、物語の種を芽生えさせる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010205
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010205,
					"content": "音楽は風と共に遠くに行き、過去へと消える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010206
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010206,
					"content": "さあ、風と物語の出会う地へ赴きなさい。三つの謎で一つの詩を紡ぎ、三つのフレーズを一つの歌につなぎ合わせるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010207
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010207,
					"content": "音楽の中にある詩と歌こそ、この物語の萌芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010208
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010208,
					"content": "これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010209
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010209,
					"content": "またなぞなぞか？風とか音楽とか言ってたけど…どういう意味なんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010210,
					"content": "風や音楽と言えば、誰を連想する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010211
					]
				},
				{
					"id": 160010211,
					"content": "うーん…おお！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010212,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010213
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010213,
					"content": "風とか、音楽とか、詩っていえば、やっぱりあの吟遊野郎だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010214,
					"content": "それって、バルバトス様のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010215
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010215,
					"content": "知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010216
					]
				},
				{
					"id": 160010216,
					"content": "モンドに来たばかりの頃、アルベドがボクをバルバトス様に紹介してくれたんだ。ボクみたいな存在は、気になるに決まってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010217
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010217,
					"content": "なるほどな…で、あいつに会うにはどこに行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010218,
					"content": "きっとバルバトス様もこの話を聞いてると思うから、風に従って進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010219
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010219,
					"content": "そっか！あいつが神だってこと、たまに忘れちゃうぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1600103,
			"completionStepIds": [
				1600103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
