			"dialogs": [
				{
					"id": 160010901,
					"content": "よし…これでこの章も完成したみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010902,
					"content": "あの魔法使いたちって、魔女会のメンバーだろ？みんなドゥリンのことを気にかけてたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010903,
					"content": "でも、魔女たちの言ってたことは謎めいててよく分からなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010904,
					"content": "悪龍の運命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010905
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010905,
					"content": "気になるか？でも、それってすでに解決した話だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010906,
						160010907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010906,
					"content": "シムランカで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010908
					]
				},
				{
					"id": 160010908,
					"content": "うーん…きっと、魔女のおばさんたちの助けのおかげでもあるんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010909
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010909,
					"content": "それと、気になったんだけど…ボクたちは物語のどこを補完したんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010910
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010910,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010911,
					"content": "たしかに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010912
					]
				},
				{
					"id": 160010912,
					"content": "補完っていうより、新しい内容を書き込んだだけっぽかったよな。わかんないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010913,
					"content": "でも、インクが消えたのは確かだぞ。他のヒントもなかったし、任務完了ってことでいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010914,
					"content": "じゃあ、順調ってことなのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010915,
						160010916
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010915,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010917
					]
				},
				{
					"id": 160010917,
					"content": "うん…お母さんの遺した想いってことで、ちょっと敏感になってるだけかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010918
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010918,
					"content": "今回もありがとう。次の章のヒントが出たら、また連絡するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010919
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010919,
					"content": "じゃあまた、次の章でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010916,
					"content": "いざって時はアリスが助けてくれるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010917
					]
				},
				{
					"id": 160010907,
					"content": "みんなの祝福を得た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010908
					]
				}
			]
		},
