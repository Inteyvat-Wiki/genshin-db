						"stepId": 1600103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2368.205,
							227.884,
							-843.246
						],
						"pointId": 13952
					},
					{
						"sceneId": 3,
						"position": [
							2361.06,
							223.99,
							-843.051
						],
						"pointId": 14458
					}
				]
			},
			"dialogs": [
				{
					"id": 160010301,
					"content": "旅人、パイモン、それに童話の世界から来た龍くん。久しぶりだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010302
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010302,
					"content": "風の中からボクを呼ぶ声が聞こえたよ。謎解きで困ってるんだってね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010303
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010303,
					"content": "お邪魔してごめんなさい、バルバトス様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010304
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010304,
					"content": "そう言わないでよ。ボクもその謎解きには興味があるんだ。聞かせてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010305
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010305,
					"content": "ふふっ…ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010306
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010306,
					"content": "なにかわかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010307,
					"content": "三つの謎と三つのフレーズ…昔のことを思い出したよ。君たちの求めてる答えは、その「昔のこと」の中に隠されてるんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010308
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010308,
					"content": "おおっ、吟遊野郎に会いに来て正解だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010309,
					"content": "昔、モンドにやって来た数人の魔女が、ボクと勝負したいって言ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010310
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010310,
					"content": "でも、ボクは武力ではなく、歌やライアー、そして詩で争いを終わらせようと提案した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010311
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010311,
					"content": "ボクはライアーを弾いて、彼女たちにこの詩を歌った——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010312
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010312,
					"content": "「風よ、風よ、私の代わりに客人を迎えておくれ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010313
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010313,
					"content": "「青々とした草原を歩けば、形なき君も姿を得られる。そうすれば、客人のために一曲踊れるだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010314
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010314,
					"content": "「雲海の縁を舞えば、よからぬ輩も君の歌声に怯む。そうすれば、客人のために邪魔者を遠ざけられるだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010315
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010315,
					"content": "「星々の下を飛べば、俗世の喧噪も洗い流される。そうすれば、客人のために心情を語る場を作れるだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010316
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010316,
					"content": "「行っておくれ、客人との約束の地へ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010317
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010317,
					"content": "「そこには争いも闘いもなく、心地よい時間だけがお茶とともに微睡むだろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010318
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010318,
					"content": "三つのフレーズはここまで。三つの謎の答えは、もうわかったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010319
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010319,
					"content": "…森の中、崖のそばと…空の上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010320
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010320,
					"content": "大正解！そういえば、あの時この謎を最初に解いたのも、君のお母さんだったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010321
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010321,
					"content": "物語を書く人と、物語を詠む人の間には、何らかの繋がりがあるのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010322
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010322,
					"content": "森の中、崖のそば、空の上…ああ、あそこだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010323,
					"content": "この答えが示してる場所が、君たちがこれから向かう場所だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010324
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010324,
					"content": "当時、魔女たちはボクのなぞなぞを解いて、ボクの提案を受け入れた。そして、彼女たちはその場所を集会の場所に選んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010325
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010325,
					"content": "この本のヒントをもとに、そこでボクのフレーズを演奏してみたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010326
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010326,
					"content": "こういう時だけは頼りになるな。さすが風神バルバトスさまだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010327,
					"content": "ありがとう、バルバトス様。ボクは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010328
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010328,
					"content": "なになに？まだボクに聞きたいことがありそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010329
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010329,
					"content": "うん…吟遊詩人のバルバトス様は、数え切れないほどの物語を読んできたでしょ。作者が思う「未完成の物語」って、どんな物語だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010330
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010330,
					"content": "それは、まだ叶えられていない願いが物語にあるか…んー、続きはお楽しみにってことで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010331
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010331,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010332
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010332,
					"content": "頼もしいって言ったそばから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010333,
					"content": "君の欲しい答えはこの物語の中にあるはずだよ。君のお母さんが残した物語に、口出しはできないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010334
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 160010334,
					"content": "そうだね…出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥリン"
				}
			]
		},
