			"dialogs": [
				{
					"id": 160010507,
					"content": "つまり、ここも物語の中の世界なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010508,
					"content": "そこへ、突如新しい客が現れました。彼らも龍の子の誕生日パーティーに参加したいのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010509
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010509,
					"content": "しかし、悩んだ末にプレゼントを用意した魔法使いたちに対し、この三人は何も持ってはいませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010510
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010510,
					"content": "このままでは、客人として歓迎されるはずもありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010511
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010511,
					"content": "プレゼント？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010512
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010512,
					"content": "そんなのどうすればいいんだよ？オイラたちもさっき知ったばっかりなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010513,
					"content": "客人は不満の言葉を垂れるよりも、どんなプレゼントを贈るか考えるべきなのでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010514
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010514,
					"content": "…物語を進めるには、プレゼントを用意しないといけないみたいだな。でも、今から用意するにしても…どこで手に入れればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010515,
					"content": "あるいは、辺りを探してみるべきなのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010516
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010516,
					"content": "それを早く言えよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
