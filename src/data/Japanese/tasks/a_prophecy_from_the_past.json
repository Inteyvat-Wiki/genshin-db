						160011603
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011603,
					"content": "ドゥリンって勉強が好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160011604,
					"content": "ううん、でも、この世界の常識をもっと勉強しないとって思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011605
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011605,
					"content": "どうしてそう思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160011606,
					"content": "…知ってる？モンドでは、炎で魚を狩ると、罰を受けるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011607
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011607,
					"content": "もしかして、クレーと一緒に…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011608
					]
				},
				{
					"id": 160011608,
					"content": "…クレーちゃんから狩りのコツを学べると思ったんだ。ジンさんに捕まって反省室に入れられた後、やっとそれが普通じゃないことに気づいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011609
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011609,
					"content": "この世界の常識はシムランカとは違うから、みんなに迷惑をかけないように、急いで勉強しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011610
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160011610,
					"content": "それって常識の問題なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
