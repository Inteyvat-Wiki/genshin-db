					"nextDialogs": [
						160010613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010613,
					"content": "物心ついた時から、ボクはお母さんが書いた物語の中で過ごしてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010614
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010614,
					"content": "だからオルビット城の積み木の小人みたいに、お母さんの物語には全てが書かれてると思ってたんだ。自分で将来のことを考えるなんて、めったになくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010615
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010615,
					"content": "あの時のボクは何が欲しかったんだろう…こんなこと考えるのは初めてだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010616
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 160010616,
					"content": "じゃあ、ちょうどいい機会だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 160010617,
					"content": "シムランカを出てこの世界に来てから、もうだいぶ経ってるだろ。みんなと色々経験してきたし、そろそろ将来について考えてもいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010618
					],
					"speakerTitle": "パイモン"
				},
