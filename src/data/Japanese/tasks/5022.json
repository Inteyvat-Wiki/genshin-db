			"dialogs": [
				{
					"id": 50220801,
					"content": "おはよう！昨日は悪い夢でも見たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 50220802,
					"content": "おまえがベッドで寝返りする音がずっと聞こえてたぞ。あんまり眠れなかったみたいだな。もうすぐ決戦だから緊張してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 50220803,
					"content": "（さっきの夢…あっという間に記憶が曖昧になっちゃった。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "（夢の中の景色は薄いベールがかかったように、はっきりしない。思い出そうとすると、頭が痛い…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "へへっ、今日はマーヴィカに会う日だ。元気出してこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
