			"dialogs": [
				{
					"id": 50220401,
					"content": "（ここはどこ？まさか…夜神の国？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "#（{M#俺}{F#私}はどうしてここに？さっきは確か…うっ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "（頭がクラクラして、思考が働かない。とりあえずあたりを歩いてみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
