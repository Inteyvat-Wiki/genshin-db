					}
				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "（光の壁を通り抜けた瞬間、全身が凍ったかと思った。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "（夜神の加護はここに届かないみたい…冷たさと暗闇が五感に染みわたり、疲れ果てた誰かの苦しげな溜め息だけが耳に響く。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "（彼らはどれだけ歩いてきたのだろうか。そして、これからどれだけ歩くのだろうか…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "（あれ？あの人は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "故郷を遠く離れた地に、戦火が燃え盛る。我らの血はすでに最後の一滴まで流しきった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 50220706,
					"content": "戦士たちよ、もう暫くの辛抱だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "「隊長」"
				},
				{
					"id": 50220707,
					"content": "（どうして「隊長」がここに？何を言ってるんだろう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "いつの日か、お前たちを約束の場所に連れていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「隊長」"
				}
			]
		},
