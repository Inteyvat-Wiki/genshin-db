					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "モサモサアナグマ"
				},
				{
					"id": 760310105,
					"content": "わっ！おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310106,
					"content": "…うっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310107,
					"content": "いたっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "モサモサアナグマ"
				},
				{
					"id": 760310109,
					"content": "足が滑っちゃった？ううん、私は大丈夫だよ。ん？キミたちも来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310110,
					"content": "「月神」も動物にぶつかられたりするんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310111,
					"content": "動物たちが放つクーヴァキには「悪意」がないから、ぜんぜん気にならないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310112,
					"content": "どうしたの？怖いの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "モサモサアナグマ"
				},
				{
					"id": 760310114,
					"content": "うん、うんうん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310115,
					"content": "おまえも動物の言葉がわかるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310116,
					"content": "ナド・クライは月の昇る地。クーヴァキのもとで生きる動物はみんな「月神の眷属」だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310117,
					"content": "こいつはなんて言ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310118,
					"content": "住んでるところに魔物が現れたんだって。ラウマを探しに行く途中、魔物に追われてここに来ちゃったみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310119,
					"content": "そっか、だから怖がってたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310120,
					"content": "送ってあげないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "うん、ラウマのところに送ってあげよう。彼女がなんとかしてくれるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310122,
					"content": "よし、また外出だな。道中、ちゃんと隠れてるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
