			"dialogs": [
				{
					"id": 760310301,
					"content": "…うむ、ご苦労だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310302,
					"content": "昼も夜も、月光が我らを結ばん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310303,
					"content": "…ん？前聞いたのとちょっと違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310304,
					"content": "あっ！話が終わったみたいだぞ。いまだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310305,
					"content": "ラウマ様！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "マチェイ"
				},
				{
					"id": 760310306,
					"content": "またかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310308,
					"content": "…苦労をかけたな。少し出かけるが、すぐ戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310310,
					"content": "もう誰もおらぬ。出てきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310311,
					"content": "なんだ、気付いてたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310312,
					"content": "「クー{RUBY#[D]月の少女}タル」から放たれるクーヴァキに気付かぬわけないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310313,
					"content": "なぜ後をつけていた？…私の仕事を視察でもしていたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310314,
					"content": "うぅ…ご…ごめん。実はラウマに聞きたいことがあって来たんだけど、なかなかタイミングを掴めなくて…嫌な思いさせちゃったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310315,
					"content": "そうか…なるほど。善処しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310316,
					"content": "でも、おまえの一日の仕事ぶりを見て、これ以上負担をかけるのが忍びなくなってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310317,
					"content": "大したことはない。「詠月使」としてやるべきことをしておるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310318,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "ラウマ"
