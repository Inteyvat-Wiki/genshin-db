					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310102,
					"content": "すぅー…すぅー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310103,
					"content": "あっ！昼寝中だな。またあとで来ようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "パイモン"
				},
				{
