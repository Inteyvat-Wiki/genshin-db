			"dialogs": [
				{
					"id": 760310201,
					"content": "…うむ、後でクネグンダに果物を届けさせる。数日は安静にしたほうがよかろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310202,
					"content": "ラウマ、忙しそうだな。ちょっと待ってようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310203,
					"content": "「霜月の子」にとって「詠月使」がとても重要な存在だってことはずっと前から知ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310204,
					"content": "彼女たちのほうが本当の「神」よりも大変な思いをしてるのかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310205,
					"content": "あ、やっとひと区切りついたみたいだ！今のうちに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310206,
					"content": "ラウマ様、ちょっと目を通していただきたいものが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "ヴァナモ"
				},
				{
					"id": 760310207,
					"content": "ああ、すぐ行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760310208,
					"content": "また呼ばれてったぞ！ぜんぜん休まないんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760310209,
					"content": "邪魔にならないように、ついてってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
