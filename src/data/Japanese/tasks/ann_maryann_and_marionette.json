			},
			"dialogs": [
				{
					"id": 742530201,
					"content": "平穏な日々って、本当に素敵なものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530204,
					"content": "もうこんな時間？ふふっ、それじゃあ、これからもこうして一緒にお茶を飲みましょうね、サンドローネさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
}