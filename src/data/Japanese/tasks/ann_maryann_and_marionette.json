			"dialogs": [
				{
					"id": 742530101,
					"content": "正直なところ、いまだに信じられないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530102,
					"content": "ワタシもアランもあの時、アナタはもうこの世にいないと本気で思っていたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530103,
					"content": "ええ…もっと早く目覚めていれば、あなたたちに会いに行けたかもしれない…でも、運命とはこういうものなのかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530104,
					"content": "マリアンさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530105,
					"content": "それにしても、本当に不思議な運命ね。アンと旅をしている最中に、サンドローネさんの肖像画が描かれた映影ポスターを見かけるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530106,
					"content": "それで、ワタシに連絡してくれたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530107,
					"content": "うん、そうなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530108,
					"content": "ああ…とても懐かしいコーヒーの香り…ふふっ、お茶会に招いてくれてありがとう、サンドローネさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530109,
					"content": "庭も優雅で華やかに飾られていて、とっても素敵ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530110,
					"content": "ここはワタシとアランがかつて住んでいた家なんだもの。手入れして当然でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530111,
					"content": "ふふ、お兄ちゃんよりずいぶんしっかりしてるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530112,
					"content": "アランは部屋をきれいに飾ろうとしたことなんて一度もしたことなかったし、きれいなものにも無反応だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530113,
					"content": "ルネだってそうよ。部屋の装飾を気にしたり、真面目にお茶会の準備をしたりするのは、私とジェイコブくらいだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530114,
					"content": "子供の頃からそうだったの？てっきり、年を取ったせいだと思っていたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530115,
					"content": "ええ、昔から。とても聡明なくせに、他の面ではいつも不器用だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530116,
					"content": "だからこそ、私たちの中で唯一、虚ろな夢でなく、真実の苦しみを選んだのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530117,
					"content": "それでも、アランは後悔なんてしていないと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530118,
					"content": "うん。「勇者」だったからね——それこそがアランの願いだったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530119,
					"content": "むしろ、後悔してるのはあたしたちのほう。彼の願いは、こんなに孤独なものじゃなかったはずなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530120,
					"content": "サンドローネさん、あなたはどう？何か願いはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530121,
					"content": "…アランと同じことを聞くのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530122,
					"content": "えっ？お兄ちゃんからも聞かれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530123,
					"content": "本当に成長したのね…昔なら、そんなこと絶対聞かなかったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530124,
					"content": "「願い」なんて、意味のない言葉よ。欲しいものはなんでも手に入る——？ハッ、それならこの世はここまで不愉快なことで満ち溢れていないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530125,
					"content": "今のワタシは自分がしたいこと、正しいと思うことをしているわ。これが願いと言えるのかは分からないけれど、少なくとも…幸せよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530126,
					"content": "それはとても素晴らしいことよ…少し羨ましいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530127,
					"content": "あなたは…アランを恨んでる？マリアンの姿に似せて、あなたを造った彼を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "マリアン"
				},
				{
					"id": 742530128,
					"content": "恨んだことなんて一度もないわ。アランはずっと、ワタシはワタシで唯一無二の存在なんだから、自分自身の人生を歩むべきだと言ってくれた。そして、実際にそうしてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742530129,
					"content": "ふふっ。物語もお茶菓子も、あなたが満足できる選択が一番だよ、サンドローネ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "アン"
				},
				{
					"id": 742530130,
					"content": "アンの言う通りよ。だから今は、あなたが心を込めて用意してくれたお菓子を静かに楽しませてもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マリアン"
				}
			]
		},
