			"dialogs": [
				{
					"id": 715330101,
					"content": "…うーん、何か違う気が…「祝灯状」って、難しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330102,
					"content": "「祝灯状」の制作中？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "あれ？旅人さん、こんなところでお会いできるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330104,
					"content": "海灯祭に参加しにきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "え？いえ、手紙の配達任務で来たんです。それがちょうど海灯祭の時期と重なって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330106,
					"content": "出発前に、クレー先輩から海灯祭の「祝灯状」がほしいと言われていたので、ついでに買って帰ろうと思っていたのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330107,
					"content": "まさか、自分で作るものだとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330108,
					"content": "頑張ってどうにか作ってみましたが、どこか違うような気がして…でも、具体的に何が間違ってるのかもよくわからないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330109,
					"content": "旅人さんなら、色々ご存じでしょう？アドバイスを頂けませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 715330110,
					"content": "うーん、そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
