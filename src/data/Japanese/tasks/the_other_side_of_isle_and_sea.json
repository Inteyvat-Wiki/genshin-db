			"dialogs": [
				{
					"id": 790040101,
					"content": "ん？これを見ろ、石の上になにか描いてあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "観察"
				},
				{
					"id": 790040102,
					"content": "見た感じ…海難事故に遭った船のようだ…人もたくさん乗ってたみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "観察"
				},
				{
					"id": 790040103,
					"content": "よくわからないな…とりあえずこの壁画を記録しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "観察"
				}
			]
		},
