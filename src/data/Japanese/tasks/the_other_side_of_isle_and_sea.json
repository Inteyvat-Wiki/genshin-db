			"dialogs": [
				{
					"id": 790041201,
					"content": "やあ、何か用でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041202,
					"content": "その、おまえって「学者」だったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790041203,
					"content": "ははっ、そうとも言えるね。正確に言えば「遊学者」だが、まあ…「学者」でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041204,
					"content": "何か「学者」の手助けが必要な問題にでも遭遇したのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041205,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "海上の島…島にある壁画…ふむ、面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041207,
					"content": "学者を探していたのは、壁画を解読したかったから。そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041208,
					"content": "手伝ってくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "もちろん。これまで未知の物事を研究する機会を拒んだことはないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041213,
					"content": "ではさっそく、壁画を見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041214,
					"content": "どうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "ふむ…なるほど…すまないが、もう少し考える時間をくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041210,
					"content": "報酬は払う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "はははっ、そのやり方から見て、君は経験豊富な冒険者のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790041212,
					"content": "しかし私にとって、未知の物事こそ一番の報酬さ。これ以上のものは必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "サイード"
				}
			]
		},
