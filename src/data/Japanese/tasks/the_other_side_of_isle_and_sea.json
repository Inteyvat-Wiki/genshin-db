			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900402",
							"3"
						],
						"stepId": 7900402,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900419",
							"2"
						],
						"stepId": 7900419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "よし、これで壁画をたくさん記録できたな。ぜんぶ合わせて見れば、大体の出来事がわかるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サイード"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "ふむ、壁画に描かれた内容自体は難しいものではない。具体的な順序は分からないが、一つ一つ理解していけば問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040402,
					"content": "まずはこの絵、海難事故に遭った人々が記録されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040403,
					"content": "海難事故に遭い、君たちがこの壁画を見つけた島まで漂流したのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040404,
					"content": "そして、彼らはその島で暮らした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040405,
					"content": "この壁画を見てみよう。5つの物体が描かれている。物体の内部には、それぞれ違った標識もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040406,
					"content": "まるで5つのコップに水が入っているように。それにコップに入っている水の量もそれぞれ違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040407,
					"content": "通常、このような描き方は、ある物事の状態変化を表している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040414,
					"content": "物事の状態変化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "しかしその物事が何なのか、私には推測できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040409,
					"content": "もしそこが海の中の島であるならば、これは「海水」を指しているのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040410,
					"content": "では、続きを見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040411,
					"content": "さらにまた一回の海難事故を経て、島に新たな「客」を招き入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040412,
					"content": "ほら、最初に事故に遭った人たちが2回目の人たちを助けようとしてる。それに、二つに割かれた船も描かれてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040413,
					"content": "最初の壁画では、船は彼らの置かれている境遇の中にあるただの物に過ぎなかったが、この壁画では、難破した船の様子が詳細に描かれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040416,
					"content": "この難破船は、島に辿り着いた人々にとって何か特別な意味があったのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040417,
					"content": "そしてこの壁画だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040418,
					"content": "君たちも見ての通り、この壁画にある山には、特別な印がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040419,
					"content": "その人たちにとって、その場所に何か重要な物があったのだと私は思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040422,
					"content": "最後はこの一枚。島を離れる方法を見つけ、そこから離れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040423,
					"content": "これらの壁画に込められた物語はこれで全部だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040424,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "遠慮しないでくれ。元々この類の研究には興味があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040426,
					"content": "これらの壁画と物語を教えてくれてありがとう、モンドでもこのような収穫があるなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040427,
					"content": "ふむ…私もそろそろ外に行ってみるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイード"
				},
				{
					"id": 790040428,
					"content": "どうして壁画を使ったの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
