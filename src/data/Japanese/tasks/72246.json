				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"カマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "きれいな腕輪！きれいな花瓶！璃月のものはすごくきれいですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460102,
					"content": "…あ、だめです。こんなに乏しい語彙力は、小説家として失格ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460103,
					"content": "神技のような技術で作られた花瓶を買って、次の小説の参考にしましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460104,
					"content": "うん…こんなストーリーを書きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460105,
					"content": "「局面を変える鍵は、まさか花瓶に隠された神の目だった…！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460106,
					"content": "なんか面白そうですね！どう思いますか、カマ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460107,
					"content": "僕はどうでも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460109,
					"content": "個人的には…「花瓶」を描写する文章の量はきちんと考慮したほうがいいと思う。過剰に描写してしまうと、その意図がバレてしまう。だが、描写が不足していると、唐突になってしまうことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460110,
					"content": "おお、その通りですね！メモしておきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460111,
					"content": "あっ、ごめんなさい！場所を変えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460112,
					"content": "あと、何回も言いましたが、私に「様」をつけないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460113,
					"content": "ん？しかし考えてみれば、普通の旅人二人のうち、一人がもう一人を「様」と呼ぶことも珍しいことではありませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "墨田"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"墨田",
					"カマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "わぁ——実に楽しいですね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460202,
					"content": "さすがは北陸最大の図書館！『少女ヴィーラの憂鬱』を一気に読み終える機会があるなんて、信じられません！なんて爽快なんでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460203,
					"content": "墨田様、声が大きい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460204,
					"content": "あ、ごめんなさい。つい興奮してしまいました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460205,
					"content": "いや、ケガをしてほしくないから注意しただけだ。あの司書のお姉さんから強者の威圧感を感じた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460206,
					"content": "え？そうですか？私は普通に、ふわっとした、典型的な魔女かと思いましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460207,
					"content": "よく考えると…こういうキャラが一番強いのかもしれませんね。確かに、絶対に怒らせてはいけません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460208,
					"content": "そうですね、一理あります。今度は、こんなキャラを意識して作品を書いてみるのもいいかもしれませんね。『大図書館の魔法使い』とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460209,
					"content": "旅はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "久しぶり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460211,
					"content": "#え、伝説の{NICKNAME}さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460212,
					"content": "旅ですか…私も昔、よく旅をして各地で取材をしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460213,
					"content": "「雷災を描写するために無想刃狭間に行く」、「蛇の妖怪を描写するために蛇神の首に行く」、「逐電者の生活を描写するためにカマを入隊させる」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460214,
					"content": "カマ大変そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "大したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460216,
					"content": "しかし、今回は正真正銘の旅、何の目的もなく、ただ遠くへ旅をしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460217,
					"content": "私は気づきました。『紀野の旅』のように、書きがいのある面白い話はたくさんあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460218,
					"content": "私はカマと一緒に、地元の人に勧められた観光スポットやお店を探す旅に出ました。そして、大自然の中でキャンプをしながら、見知らぬ旅人たちに篝火や物語を共有しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460219,
					"content": "そして目が覚めたら、旅費が全部盗まれていました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460220,
					"content": "大丈夫なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "問題ありません。盗賊を見つけ、十数人いると分かった時は、もう取り戻せないと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460222,
					"content": "しかしカマは、彼らを説得し、すべての旅費だけでなく、鴉マークのコインもたくさん取り戻してくれたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460223,
					"content": "絶対面白い物語が書けそうな気がしますが、カマはその過程を教えてくれませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460224,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "やるべきことをやっただけ。墨田様が気にする必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460227,
					"content": "いえ、カマは本当に頼りになります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460228,
					"content": "あなたと一緒なら、世界の果てまで旅をしても問題ありませんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460229,
					"content": "それに、なんだか、鶴観から大きく変わったようですね。やりたいこともあって、疑問や意見も言えるようになりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460230,
					"content": "墨田様がそれを良くないと思うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460231,
					"content": "凄くいいと思いますよ！あなたの意見はどれも参考になります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460232,
					"content": "じゃ、邪魔しないでおこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#ええ、{NICKNAME}さん。『フィッシュル皇女物語』のように、すべての終わりでまた会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}、ありがとう。元気で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460233,
					"content": "またどっかで会えるだろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "カマは凄い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
