					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "墨田"
				},
				{
					"id": 722460402,
					"content": "『淨琉璃機動隊』？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "カマ"
				},
				{
					"id": 722460403,
					"content": "ええ。カマ、記憶力がいいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
