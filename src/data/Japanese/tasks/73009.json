			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アランラジャ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#ワシがウツァヴ祭を過ごせたのは、ナラ{NICKNAME}とパイモンのおかげじゃ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091302,
					"content": "残念ながら、ワシはアランマたちのようにキミと一緒に冒険することも、手助けすることもできん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091303,
					"content": "じゃが、この夢は永遠にキミたちを歓迎する。外の世界に疲れを感じたら、ヴァナラーナへ来なさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラジャ"
				}
			]
		},
