			"dialogs": [
				{
					"id": 730091401,
					"content": "「マラーナ」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091402
					]
				},
				{
					"id": 730091402,
					"content": "あれはもう随分と昔のことじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091403,
					"content": "かつてアランナラは大地の上を歩き、ナラや万物と仲良く暮らしておった。森にはまだマラーナもおらんかった。ずっとずっと前、あの災難が起きるまでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091404,
					"content": "たくさんの者がサルバに還った後、マラーナが地上で猛威を振るい始めた。森がようやく生気を取り戻すと、アランナラは身を守るため、本物のヴァナラーナを夢の中に隠したのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091405,
					"content": "森は元々、死が何かを知らんかった…枯れた花や死んだ獣に満ちた大地を思い出すあの日までは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091406,
					"content": "ちょうどその日、大地は自らが漆黒の毒血をかつて口にしたことか——あるいは今まさに口にしようとしていることを思い出した。そして川は、太陽が沈み、あらゆる水が蒸発した真っ赤な世界を頭に思い浮かべた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091407,
					"content": "そしてカレらは、死が万物に否応なく訪れることを知ったのじゃ。その時「マラーナ」が誕生した。それがつまり「死」じゃ。その存在を知った者には、必ず死が訪れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091408,
					"content": "マラーナには、すべてを死に向かわせる力がある。マラーナは大きくて暗いクネクネしたものを自らの化身に選び、死をもたらす使徒にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091409,
					"content": "もちろんワシの物語の中では、マラーナの化身の形ははっきりとせん。獣か鳥か、それともナラか、はたまた疫病か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730091410,
					"content": "じゃが、伝説は伝説じゃ。それはもうワシの記憶ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラジャ"
				}
			]
		},
