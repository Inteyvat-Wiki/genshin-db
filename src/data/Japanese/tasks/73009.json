						730090202,
						730090203
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730090202,
					"content": "（早くラナを治さないと…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "（そっと離れよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7300903,
			"completionStepIds": [],
