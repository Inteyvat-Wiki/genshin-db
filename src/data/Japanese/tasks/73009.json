			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090301,
					"content": "（ラナはまだ昏睡状態だ。アランラナは近くにいない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730090302,
					"content": "（ラナを包む「泡」の中から何やら景色が浮かび上がってきた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730090303,
					"content": "（景色に浸ってみよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "あなたは森にいる。あまりにも広大で静かな森を、あなたは自由自在に動き回る。\\n時おり木漏れ日が髪を金箔のようにきらめかせた。あなたと同じくらいの背丈の野草が嬉しそうに小さく笑い、通り過ぎるあなたの手にそっと触れる。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "風の中で木がハミングし、流水が音楽を奏でる。その時、あなたは不安げな泣き声に気づく。声をたどっていくと、そこには小さな人形がいた。\\n泣き疲れたのか、彼女は草地に突っ伏して眠っていた。あなたは彼女に寄り添い、心安らぐ歌声を響かせた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "（…ラナの容態は悪化していないようだ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730090307,
					"content": "（静かにここを離れよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
