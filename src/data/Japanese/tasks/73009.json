					"アランラナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "アランラナがカノジョのお世話をする。一番の親友だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730090102,
					"content": "#ナラ{NICKNAME}、「ヴァナラーナ」に行って「大夢のメロディー」を披露して。それから、カレらに「ビージャの実」を準備するよう伝えて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730090103,
					"content": "どういうこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "雲が雨を降らせ、雨が大地に染み込むのが分かるように。種が芽を出し、大樹になり、たわわに実をつけるのが分かるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730090104,
					"content": "う、うん。分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#ナラ{NICKNAME}、よく分かってないみたいだけど、心配はいらない。何が正しいか、何をすべきかは自然と分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "アランラナ"
				}
			]
		},
		{
			"id": 7300902,
			"completionStepIds": [],
