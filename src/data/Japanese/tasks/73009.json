			},
			"dialogs": [
				{
					"id": 730090801,
					"content": "他にウツァヴ祭の準備に必要なものは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090802
					]
				},
				{
					"id": 730090802,
					"content": "ふむ、アランカヴィがヴァナラーナの中心にいるはずじゃ。ウツァヴ祭を開催するなら、アイツの手伝いが必要じゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラジャ"
				}
			]
		},
		{
			"id": 7300909,
			"completionStepIds": [],
