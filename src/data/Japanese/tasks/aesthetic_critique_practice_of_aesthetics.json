			"dialogs": [
				{
					"id": 240100301,
					"content": "具象的な形に影響されてはいけない…なんとか美を抽出し、それからシンボリズムの手法を使って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100302,
					"content": "いや、違う…やっぱり違う。ここの構図はあまりにもわざとらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
