				}
			]
		},
		{
			"id": 2401005,
			"completionStepIds": [
				2401006
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401006",
							"2"
						],
						"stepId": 2401006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100501,
					"content": "助かったよ！これだけの絵の具があれば、しばらく問題ないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100502,
					"content": "絵の具を水に流したりしないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "水に流す？あはははっ、確かに私の画法は君が言ったのと似てるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100504,
					"content": "ただ、私は絵の具を直接キャンバスに絞り出した後、ナイフとヘラを使って絵を描くんだ。そうすることで、印象深いタッチを得られるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100505,
					"content": "本当に助かったよ。この絵の具があれば絵を描き続けることができる。もし時間があったら、いつでも見に来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100506,
					"content": "今回、順調に創作のスタートを切ることができたのも、ひとえに君のお陰だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100507,
					"content": "この絵が完成した暁には、君が最初の鑑賞者になってくれたら嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				}
			]
		},
