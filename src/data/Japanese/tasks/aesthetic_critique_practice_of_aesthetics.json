			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブシコー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "いらっしゃい。何かお探しかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 240100202,
					"content": "デピエリの絵の具について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "ああ、彼の代わりに絵の具を受け取りに来たのか？ちゃんと用意してあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 240100204,
					"content": "彼はすぐ絵の具を切らすんだよな。絵の具を買った後、そのまま水に流してるんじゃないかって思うほどだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "ブシコー"
				},
				{
					"id": 240100205,
					"content": "よし、彼に頼まれた絵の具は全部ここにある。持ってくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブシコー"
				}
			]
		},
