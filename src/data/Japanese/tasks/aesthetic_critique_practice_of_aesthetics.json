			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "確かにいい考えではあるが…本当にできるだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100102,
					"content": "絵の進捗はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "おお、君か。この前は写真を撮ってくれて助かったよ。おかげで写真の景色からいろいろヒントを得ることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100104,
					"content": "大まかな構想はできていて、何枚か下書きも描いたんだが…なんというか、あまりしっくりこないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100105,
					"content": "誤解しないでくれ。自分の描いた絵が美の欠片もないゴミだという意味じゃない。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100106,
					"content": "これらの絵には、平凡な絵と区別される「特別な所」が欠けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100107,
					"content": "それに、私の構想したイメージはあまりに具象的なものでね。そのまま描き出してしまえば、私が表現したかった美は大きく損なわれてしまうに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100108,
					"content": "はぁ、この問題はすべての画家にとって悩みの種だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100109,
					"content": "他のものを描いてみたらどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "アドバイスありがとう。でもこれは、題材を変えれば解決できる問題じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100111,
					"content": "山水の風景画を描こうと、あるいは鳥や魚などの動物、はたまた人間世界の日常を描こうと、この問題は常に存在する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100112,
					"content": "この問題を解決するために、何人かの画家仲間たちはあることをした——自分の心の感情に従って、それらの具象的な景色を分解および変形させるってことをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100113,
					"content": "そうやって描かれた絵で、画家が一番表現したいのは心の感情なんだ。彼らのキャンバスには…えっと、どう説明したらいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100114,
					"content": "そう！彼らのキャンバスに描かれた人物や景色、さらには光の線までもが奇怪な感じを帯びていて、まったく伝統的な美が感じられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100115,
					"content": "もしざっと見ただけなら、ほとんどの人は絵について無知で粗野な人、もしくは気が狂った人がそれを描いたと思うだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100116,
					"content": "しかし、もし心を落ち着かせ、心と感受性を研ぎ澄ませばきっと聴こえるはずだ。その絵から発せられる画家の叫び声がな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100117,
					"content": "その叫び声は画家の心から発せられるもの。その人の様々な感情を訴えている…そして大半の場合、それらの感情はかなり激しいものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100118,
					"content": "その声は耳ではなく、心で聴かなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100124,
					"content": "しかし私は…具象的な情景を描くことを諦めたくはない。だから、他の方法を考えついたわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100125,
					"content": "つまり、色合いに重きを置くと決めたんだ。そのためにはもっと濃密な色合いと、シンプルで力強いタッチを見つける必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100126,
					"content": "同時に、光と陰影、そして伝統的な意味での構図を弱める…これらは私が表現したいものに影響を与えるから、しばしキャンバスから降りてもらうしかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100127,
					"content": "けど、一つ問題があってね…濃密な色合いを作るためには、大量の絵の具が必要になる。絵の具を直接キャンバスに絞り出さないといけない場合さえあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100128,
					"content": "その結果…絵の具が…底をついてしまったんだ。だからといって、今イーゼルを畳んで離れるわけには絶対にいかない。創作に支障を来たすわけにはいかないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100129,
					"content": "旅人、私の代わりに街に行ってブシコーという人を訪ねてくれないか？彼に上質な絵の具を頼んであってね。今ごろ用意できているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100130,
					"content": "もしくは…トリックフラワーの蜜を採ってきてくれれば、自分で絵の具を作ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100131,
					"content": "花の蜜で絵の具を作れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "ははは、もちろん。画家仲間の中には鳥の卵で絵の具を作る人もいるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100133,
					"content": "そうやって作られた絵の具は、繊細な色合いと豊かなグラデーションを持ち、華やかで盛大な情景を描くにはもってこいなんだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100136,
					"content": "心の優しい君は、まさか芸術家の頼みごとを断ったりしないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100137,
					"content": "はいはい、分かったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "ああ！しかと頼んだぞ。ものが手に入ったら、直接私のところに持ってきてくれればいい。ここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100138,
					"content": "しょうがない…任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "自分で絵の具まで作れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "ははは、もちろん。自力で絵の具を作ることは、画家としての基本スキルなんだ。それでこそ、より良くイメージをコントロールできるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100119,
					"content": "他の画法を試してみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "いい考えだね。私の画家仲間の中にも同じ考えを持った人たちがいるんだ。彼らは「具象的でない」方法で、「抽象的」なものをキャンバスの上に表現しようと試みている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100121,
					"content": "中でも最も極端的な人は、具体的な何かを描くことすら諦め、純粋な色の塊でイメージを表現しようとしているんだ…「新描写主義」と彼らは自称しているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100122,
					"content": "でも正直、私でさえ彼らの作品が何を表現しているのか分からなくってね。色の塊や線に含まれたリズム的な美を感じるのが精いっぱいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240100123,
					"content": "その絵がいったい何を表現しているか…その画家に教えてもらうしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "デピエリ"
				}
			]
		},
		{
			"id": 2401002,
			"completionStepIds": [
				2401002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
