			"dialogs": [
				{
					"id": 412120501,
					"content": "おまえら見たか？あのヒルチャール、本のようなものを持って逃げて行ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120502,
					"content": "しまった…ボクのスケッチブックだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120503,
					"content": "偉大な画家になりたいのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "オイラは普通の泥棒だと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120506,
					"content": "ボクのスケッチブックを盗むとは、ふん、いい度胸をしているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120507,
					"content": "アルベドが静かに怒っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120508,
					"content": "手伝うよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "錬金術の勉強がしたかったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
