			"dialogs": [
				{
					"id": 412120301,
					"content": "うん？気配がしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120302,
					"content": "怪物、出かけてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120303,
					"content": "なら、怪物が現れる前に、辺りを散策しようか。それとも、休憩の方がいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120304,
					"content": "休憩して少しお喋りするのは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "ボクもそう思っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120309,
					"content": "お喋りか？オイラも混ざりたいぞ。場所を開けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120310,
					"content": "キミが今回のことに対して多くの疑問を抱いていることは知っている。先ほども言った通り、全て話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120311,
					"content": "ただ、ボクはキミに嘘は吐きたくないのでね。現段階でまだ明かせないことは、省略させてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120312,
					"content": "おぉ…意外とさっぱりしてるやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120313,
					"content": "思っていたよりも誠実な人だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120316,
					"content": "うんうん！…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120318,
					"content": "アルベドが叫んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "そんなわけがあると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120322,
					"content": "あっ！ヒルチャールだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "パイモンが叫んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "違うぞ！なんでアルベドじゃなくてオイラを疑うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120314,
					"content": "思っていたよりも清々しい人だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "ちょうど聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120308,
					"content": "分かった、何が聞きたいんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "アルベド"
				}
			]
