			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "道が途切れているな。洞窟の入り口しかないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120602,
					"content": "中に入ったのかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "足跡から推測するに、ここへ入っていったようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120604,
					"content": "それならオイラたちも行こう！逃がすもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120605,
					"content": "待った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120606,
					"content": "この雪山の体積は尋常ではない。この中の道も、恐らく想像を超える険しさだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120608,
					"content": "感じるかい？風に混じる氷と石の匂い…そしてこだま。この中の空間はとんでもなく広いだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120609,
					"content": "本当だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120610,
					"content": "軽率な行動は控えた方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120611,
					"content": "でも…せっかくここまで追いかけてきたんだぞ！このまま逃がしちゃうのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120612,
					"content": "あのスケッチブック、大切な物だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "ああ、大切だ。だが、それでも無謀な行動は控えるべきだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120614,
					"content": "もう一つ道がある。ただ、少し苦労するだろうけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120615,
					"content": "ボクの考えが間違っていなければ、この洞窟の出口は山の反対側にあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120616,
					"content": "キミもボクも飛ぶのが得意だろう。準備するんだ。一気に飛んで行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
