			"dialogs": [
				{
					"id": 412120701,
					"content": "アルベド、作業は順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120702,
					"content": "まあまあだよ。いくつかのページが破られていたが、それ以外は無事だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120703,
					"content": "雪山の気温は低すぎる。特にあの洞窟付近の気温は耐えがたいレベルまで達していた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120704,
					"content": "その上、ヒルチャールが唾を本に垂らしていた。凍った紙があのような低温にさらされたらどうなるか、考えたくもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120705,
					"content": "凍った紙って、触ったら粉々になるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120706,
					"content": "そんな状態から修復できるなんてすごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "さすが錬金術師だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120708,
					"content": "もしスケッチブックがボロボロになってたら、アルベド絶対キレてたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120709,
					"content": "どうしてそう思うのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120710,
					"content": "だっておまえ、イラストとメモをいっぱい書いたって言ってただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120711,
					"content": "確かに、このスケッチブックはボクが常に持ち歩いていたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120712,
					"content": "だが、こんなもののために本気で怒ったりはしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120713,
					"content": "もし取り戻せなかったら、また新しく描けばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120714,
					"content": "えっと…思ったより冷めてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120715,
					"content": "そうは思わないな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "そうなのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120718,
					"content": "だって、それは真剣に描いたものだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "そうだそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120720,
					"content": "絵には思い出が詰まっている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120722,
					"content": "それを簡単に諦めてはいけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "そうだぞ！オイラもそれが言いたかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120724,
					"content": "…そうだね。描き直すのも手間がかかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120725,
					"content": "アルベドは天才だから、人と考え方が違うのかもしれないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120726,
					"content": "だって、おまえは他のやつにできない事もできるし、知らないことも知ってるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120727,
					"content": "そういう人はたまに変なところで大雑把なんだ。賢い人の悪いところだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120728,
					"content": "彼もパイモンのこと賢いと言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "パイモンは興味深い生物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120730,
					"content": "パイモンもたまに大雑把になるのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "おい！なんでもオイラと重ねるんじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120733,
					"content": "では、話題を変えよう。サイリュスが言っていたが、雪山のヒルチャールは冒険者を襲って荷物を奪うそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120734,
					"content": "さっきのは、きっとそのヒルチャールたちの拠点だろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120735,
					"content": "ここのヒルチャールは強い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "ああ、あの一帯のヒルチャールは、麓のやつらに比べてかなり強かったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120737,
					"content": "ボクもそう思う…恐らくこれも「龍」と関連しているんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120738,
					"content": "ドゥリンの亡骸の穢れた力は怪物を強化する。その上この寒さだ。雪山にはいくつもの無人区域が存在するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120739,
					"content": "旅人よ、剣を見せてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120740,
					"content": "雪山の戦闘を経て、この剣は力を吸収し、その内へと蓄えられている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120741,
					"content": "そしてキミの浄化の力により、龍の血に汚染された力がろ過されたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120742,
					"content": "これはとても面白い現象だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120743,
					"content": "オイラたちに掛かれば、手慣れたもんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120744,
					"content": "キミに浄化の力があるとは知っていたが…なるほど、これが…まさに百聞は一見に如かずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120745,
					"content": "力を蓄えられる剣って危険だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "確かに安全な武器であるとは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120747,
					"content": "ヒルチャールに奪われなくてよかったな！雪山のヒルチャールがもっと強くなっちゃう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120748,
					"content": "ファデュイの方がもっと危険じゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "ヒルチャールも危険だぞ！もしあいつらが力を得たら、きっと…超、いや、究極ヒルチャールになるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120751,
					"content": "ヒルチャール魔人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "ヒルチャール悪魔人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120753,
					"content": "ヒルチャール悪雪魔人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "雪って付くと弱そうに感じるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120755,
					"content": "そういえば、この剣ならアルベドの力も吸収できるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120756,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120757,
					"content": "試してみたいと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120758,
					"content": "うわ！視線が氷のように冷たいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120759,
					"content": "パイモンは冗談を言っただけだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "いや、気にしていないよ。とにかく、キミには引き続きその剣を使ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120762,
					"content": "でも、こんな危険な剣をオイラたちに任せて大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120763,
					"content": "アルベドは表情と頭の中で考えてることが全然違うからわからないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120764,
					"content": "違う…とはどういうことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120765,
					"content": "だが、なぜキミたちにここまで託すのかについて、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120766,
					"content": "「異常者」同士、ある種の共通認識を感じているからかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120767,
					"content": "異常者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "孤独な個体…普通の人とは異なる体…ボクとキミのようなね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120769,
					"content": "(……？)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(どういう意味だろう？)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "パイモンは悪意がないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "宝盗団の方がもっと危険じゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "パイモンも悪いところがあるのか！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "そういう時はもっと怒るべきだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
