			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "アルベド！戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120102,
					"content": "あれ、お客さんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120103,
					"content": "あれ、知っている顔だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "雪山は新人にはまだ早すぎるかもしれないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120106,
					"content": "冒険とは己の限界への挑戦だろう？困難や刺激のない旅に何の意味がある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120107,
					"content": "狂暴なヒルチャールの強盗がいたり、膝まで埋まるほどの雪があったりしても、冒険者は決して歩みを止めてはならん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120108,
					"content": "サイリュス、要点を言ってくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120109,
					"content": "ハハハハ、何を言ってるんだ。会話は探検と同じ、過程が大事なんだ。要点などない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120110,
					"content": "ああ！キャンプ場を強盗に奪われ、氷に覆われた雪の中で火を起こし、飯を作る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120111,
					"content": "雪山の旅は冒険者協会の新人たちには忘れられない経験となるだろう、ハハハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120112,
					"content": "ああ、そうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120113,
					"content": "例え今、彼らが俺のことを恨むことになったとしても、未来ではきっと俺に感謝しているだろうな。冒険はこうして受け継がれて行くのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120114,
					"content": "ああ、続けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120115,
					"content": "うわ…興味のないことに対するアルベドは、やっぱり感じが悪いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120116,
					"content": "冒険者には全く興味がないみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "そうか？おまえを見てる時のあいつは、楽しそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120118,
					"content": "しかし、新人が弱すぎるのか、雪山が強すぎたのか。今回の損失は酷いものだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120119,
					"content": "なにが酷かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120120,
					"content": "おぉ…！お前は…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120121,
					"content": "こんにちは、サイリュスさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120123,
					"content": "やぁ、若き冒険者とその仲間よ、ここで会えて嬉しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120124,
					"content": "この極寒の山がお前たちに面倒事を与えてなければいいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120125,
					"content": "乗り越えられることなら面倒じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120126,
					"content": "ハハハ、そうだな！その自信ある言葉、気に入ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120127,
					"content": "わざわざ雪風の中ここに来るなんて、何か用事でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120128,
					"content": "#ヒルチャールのデータを採取しにきたんだよ。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}には助手として手伝ってもらっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120129,
					"content": "（あれ？そうだっけ？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "なるほど、みんな理想を追い求めここに集っているのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120132,
					"content": "計画がうまく進むことを願っている。俺は新人たちの様子を見に行く。またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 412120201,
					"content": "へへ、オイラなんかわかっちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120202,
					"content": "アルベドがサイリュスを誤魔化してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "魔剣だからな。他のモンドの人には知られたくないんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120204,
					"content": "聞こえているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120205,
					"content": "さっき、聞かない方がよかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "「いい」も「よくない」も存在しないさ。知りたいことがあるのなら全て話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120207,
					"content": "——しかし今ではない。ボクにはまだやらなければならないことが残っているんでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120208,
					"content": "やらなければならないこと？うーん、それってどうせ…オイラたちも手伝わなきゃいけないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120209,
					"content": "パイモン、キミはどんどん賢くなっているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120210,
					"content": "なに！オイラはずーっと賢いぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412120211,
					"content": "この付近で怪物の新しい生息地を見つけた。異なる属性の怪物は、我々に違ったデータを提供してくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120212,
					"content": "いつも実験に興味津々だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "実験には根気が必要なんだよ。錬金術師にとって、何事も突き通すのは基礎中の基礎だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120214,
					"content": "準備はいいかい？では行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412120130,
					"content": "（他人に剣の事を知られたくないみたいだ）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "どこかで会ったような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
