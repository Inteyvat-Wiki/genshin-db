			"trigger": {
				"objectNames": [
					"レイフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "旅人、おかえり。本当に助かったよ…ネルミンは何だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330602,
					"content": "自分に花が育てられるか心配してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "それは…彼女と一緒に研究してみるよ。本当にだめなら誰かに聞いてみるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330604,
					"content": "もしだめだったら、俺は…そうだな…育てやすくて、すぐ成長するものを探すか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330608,
					"content": "コホン、とにかく…手伝ってくれてありがとな、旅人。これはお礼だ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330609,
					"content": "後で他の物は自分でネルミンに渡すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330610,
					"content": "おいおい、この園芸道具、取扱説明書が付いてないぞ？これじゃ使い方がさっぱり分からないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330605,
					"content": "これまで花を贈ったことはないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "贈ったことはあるんだが…これまで人に頼んで買ってきてもらったのは、成長しきった花ばかりだったからな。村に届く頃には、花はもうしぼんじゃってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330607,
					"content": "だから今回は、植えたばかりの花の種を鉢植えごとネルミンに贈ることにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "レイフ"
				}
			]
		},
