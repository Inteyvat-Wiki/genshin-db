				"objectNames": [
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "室内の誰かが物音に気づいたようだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "こんにちは、何かご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330503,
					"content": "この鉢植えについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "これを…レイフが私に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330505,
					"content": "この鉢にお花の種が植わってる…？本当ですか？届けてくれてありがとう、とても嬉しいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330506,
					"content": "でも…本当に私が育てられるかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330507,
					"content": "花を育てたことがないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "私…植物の世話が苦手で、これまでもたくさん観葉植物を枯らしてしまったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330509,
					"content": "この鉢植えの花はきっともっと大事に育てないとですよね。もし私が育てて枯らしてしまったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330510,
					"content": "ううん、ダメダメ…お花が手元にある以上、大切にお世話しなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 732330511,
					"content": "クルスームおばあちゃんならきっとどうすればいいか知ってるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
