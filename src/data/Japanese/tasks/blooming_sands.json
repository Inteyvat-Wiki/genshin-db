					"レイフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "そうそうこれだよ、ほんっとうにありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330402,
					"content": "花屋さんでも始めるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "いや、これは…一度にたくさん買っておけば、何度も外出しないですむかなって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330405,
					"content": "君はひとまずそばで休んでいてくれ。俺は種を植えて、肥料をやらないといけないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330406,
					"content": "レイフは植木鉢をいじり始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "よし！これで、ネルミンはこの鉢植えに水をやるだけでいいはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330408,
					"content": "旅人、今度はこの鉢植えをネルミンに届けてもらえないだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330409,
					"content": "何で自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "俺はこの道を見張ってないといけないんだ…食糧や物資が運ばれてきたら、村の人を呼んで受け取りに来てもらわないといけないからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330411,
					"content": "お前も感じてるだろうけど、辺りはこの気温だろ…もし受け取るのが遅れると、物資が暑さでダメになってしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330412,
					"content": "旅人、お願いだ。ネルミンの家はここからそう遠くはないから、この鉢植えだけ届けてくれればいい。残りの物は俺が何とか持って帰るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レイフ"
				},
				{
					"id": 732330403,
					"content": "こんなにたくさん買って何するの！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
