					"アザライ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "はぁ…まだ貨物が来るな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330202,
					"content": "レイフの品物について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "レイフの注文した物ですか？さっき届いた貨物の中に、ちょうど入ってましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330204,
					"content": "でも、彼が買ったものは沢山ありますから…彼の荷物を取りにいらしたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330205,
					"content": "え、重いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "その植木鉢の他にも、色んな種に、肥料に、園芸用品に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330208,
					"content": "これを全部合わせると、軽くはないですねえ。うーん…あなた一人で運べますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330209,
					"content": "方法はあるはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "そうですか…わかりました、では品物を全部お包みしましょう。ご苦労様です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				},
				{
					"id": 732330210,
					"content": "もう約束しちゃったから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "ど、どのくらい…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
