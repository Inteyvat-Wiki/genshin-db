			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "四人のターゲットの情報は全部掲示板に載ってる。俺に聞いてもいいが、賞金額についての交渉には一切応じない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760370107,
					"content": "賞金首を片付けた証拠を提出する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "懸賞金のターゲットについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "現在ターゲットは四人いるが、手がかりがあるのは三人のみ。詐欺の容疑で懸賞がかけられているスメールの占星術師、ヒディンバ——<color=#00E1FFFF>南の港周辺</color>によくいるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760370104,
					"content": "発狂した稲妻の海乱鬼。<color=#00E1FFFF>空寂の回廊</color>を通る行商人たちを次々と殺害している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760370105,
					"content": "危険物の密輸を行う組織団員。<color=#00E1FFFF>町の北側の海岸にあるキャンプ</color>を拠点にしているそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760370106,
					"content": "極めて凶悪な海賊、「裂けアゴ」のハルク。手がかりは今のところない。どこかに潜伏しているのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レゼック"
				},
				{
					"id": 760370108,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レゼック"
				}
			]
		},
