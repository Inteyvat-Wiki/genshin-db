			"dialogs": [
				{
					"id": 756750101,
					"content": "ハイ！ハイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756750102,
					"content": "頭がもう音楽でいっぱい！ほらほら、踊ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756750103,
					"content": "ノリノリ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "セディル"
				},
				{
					"id": 756750104,
					"content": "いぇい、いぇい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "マナイア"
				},
				{
					"id": 756750105,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "モオ"
				},
				{
					"id": 756750106,
					"content": "お小遣いを稼いじゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750107,
					"content": "あれ？いつの間に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756750108,
					"content": "ヌスタさんが忙しそうだったから、空いた時間にヌスタさんの弟子を手伝って、魔物の巣に入って退治してきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750109,
					"content": "ナタだと、戦うにも踊るにも思いっきり体を動かせて、楽しいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750110,
					"content": "本当に手間をかけさせちゃったね、マイン。新人たちにたくさん経験を積ませるつもりだったんだけど、まさかあいつらだけじゃこの任務をこなせないとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750111,
					"content": "帰ったら、みっちりしごいてやらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750112,
					"content": "全然手間じゃなかったよ、弟子のみんなもよく頑張ってたし。ただ、巣の中に予想の七倍もの数の魔物がいるなんて、誰も思わなかっただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750113,
					"content": "「花翼の集」がたくさん報酬を払ってくれたおかげで、アイベルにプレゼントを買うお金まで貯まったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750114,
					"content": "でも、君のお休みもそろそろ終わりなんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756750115,
					"content": "あと何日か遊んだら、船のチケットの予約とか、帰りのことも考えないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 756750116,
					"content": "まあまあ、まだ踊ってられるよ。ロクサネ、ルテリエ、シェニー、それにフェルロイスは最近競うように任務に就いてるから、あたしが横取りするわけにはいかないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 756750117,
					"content": "じゃあ、このまま踊り続けて、楽しく過ごそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "セディル"
				},
				{
					"id": 756750118,
					"content": "踊り疲れたら食べる！お腹いっぱいになったら寝る！悩みなんて全部吹き飛ばしちゃえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "マナイア"
				},
				{
					"id": 756750119,
					"content": "キュキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "モオ"
				},
				{
					"id": 756750120,
					"content": "メリュジーヌたちとコホラ仔竜は一列に並び、ぴょんぴょんと跳ねながらステージの方へ向かっていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "本当にかわいらしいお客さんたちだったね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750122,
					"content": "へへっ。おまえも楽しそうだな、ヌスタ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756750123,
					"content": "穏やかで晴れやかな笑顔だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "本当かい？それじゃあ、これから「リズムビートパーティー」には毎回参加しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750126,
					"content": "会うたびに「姉御」やら、ひどい時は「おばさん」なんて呼んでくるやつらに気づかせてやらないと…あたしの心は、お前たちよりずっと若いんだってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750127,
					"content": "今後の「リズムビートパーティー」も今回のような形式にして、さらにもっと頻繁に開催すべきだよ！毎月恒例のイベントになったっていい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 756750124,
					"content": "いつもより若々しく見えるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}