						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "手伝いに来てくださってありがとうございます！さっそく最初の薬を試してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}、飲みすぎるなよ！気分が悪くなったら、すぐに吐き出すんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390503,
					"content": "分かった、大丈夫だよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "うう…心配だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390505,
					"content": "準備ができたから、薬をちょうだい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "これは「超スゴイポーション」という薬です。理論上は超すごい人になれるはずです！ええ…理論上は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390507,
					"content": "ベレナータから薬を受け取ると、一気に飲み干した。\\n鼻をつく匂いは耐えがたかったが、意外にも水薬の口当たりは甘くとろみがあって、飲みにくくはない。\\n身体のほうは、特に何の反応もなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "それからベレナータの指示どおり、ブリーチャープリムスが活発になるまで待った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
