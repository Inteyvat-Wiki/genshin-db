							415.747,
							4528.094
						],
						"pointId": 4515
					},
					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "ここです、ここが実験ラボです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390802,
					"content": "ええ、では次に試していただくのは「真眼薬」です。準備はよろしいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390803,
					"content": "準備オッケーだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "おう…気をつけろよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390805,
					"content": "ベレナータから薬を受け取った。嗅ぐと日なたで長い間腐っていた海草のような匂いに、思わず吐きそうになってしまう…\\nしばらく躊躇ったのち、一気に飲み干した。水薬は飲みにくくはなかった——正確には、味らしい味がしなかった…\\n身体のほうは、特に何の反応もなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "それからベレナータの指示どおり、しばらく休んだ。何の変化もないようだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "だが、しばらくして…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "なんだ、なんの変化もなさそうだな…ふぅ、心配して損したぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390809,
					"content": "#ええ、でも…{NICKNAME}さん、さっきちょっとぼうっとしてたような？どうかしましたか？何か見えた、とか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390810,
					"content": "見えた…半透明の船が半分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "ええ？面白い！でも…えとえと…もっと詳しく説明してもらえますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390812,
					"content": "遠すぎて、はっきり見えなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#面白いですね、ええ！…でも薬効の具体的な証明にはなりそうにありません…{NICKNAME}さんが遠くの岩礁や船の残骸を「幽霊船」として見てしまっただけかもしれませんから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390814,
					"content": "なので…はあ、今回の実験はやっぱり成果なしですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390818,
					"content": "ありがとうございました。今回はすごい実験記録が集まりましたよ！きっと次の調剤で使えます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390819,
					"content": "うーん…「よく知った話を聞いた、しかし…」ええ、「他の人もその現象を見るかどうかを調べ、さらに要考察」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390820,
					"content": "え…つまり、まだ他のやつにも薬を試してもらうつもりなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390821,
					"content": "ええ、そうです。だって…信頼できる目撃者が二人以上はいないと、薬が本当に「真実」を見せてくれるのかどうか確認できないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390822,
					"content": "「真実」というのは、目や思いに縛られず、誰かの心によって歪められることもなく…ずっとそこにあり、そのまま存在しているものですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390823,
					"content": "えっと…例えば…何千年も生きてる神様みたいなもんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390824,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390825,
					"content": "いいえ、白い砂、ヒトデの死骸、揺れる波の…これこそが「真実」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390826,
					"content": "でも薬剤師さまは…夢や思い出を通じて、新しい「真実」が生み出せるとも仰っていました。この矛盾した言葉の意味は、ベレには分かりません…でも理解しようと努力しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390827,
					"content": "うわぁ…急に深い話になったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390828,
					"content": "えへへへ、じゃあ深い話はここまでにしましょう！とにかく、手伝ってくださってありがとうございました。これをどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390829,
					"content": "ええ…それから、また新しい薬を調合するときも、ぜひ来てくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390815,
					"content": "巨大なものに切断されてるみたいに見えた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390817,
					"content": "あ、すみません！今…ちょっとぼうっとしてました。で、でも…さっきの情報は記録しましたから。ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "ベレナータ"
				}
			]
		},
