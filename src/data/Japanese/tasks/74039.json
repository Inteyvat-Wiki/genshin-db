			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ベレナータ",
					"パイモン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2502.251,
							445.137,
							4638.478
						],
						"pointId": 4512
					},
					{
						"sceneId": 3,
						"position": [
							2501.867,
							445.247,
							4636.573
						],
						"pointId": 4513
					},
					{
						"sceneId": 3,
						"position": [
							2501.063,
							445.119,
							4637.081
						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "#つ、つまり、さっき{NICKNAME}さんがサクッと怪物を倒せたのは、「超スゴイポーション」の効き目があったからということでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390602,
					"content": "超スゴイポーションで超すごい人になれた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "下手な広告のキャッチコピーみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390604,
					"content": "わあ！ありがとうございます！やっぱり薬効があるんですね。さすがは薬剤師さまの処方です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390609,
					"content": "ええ、そうですね。「超スゴイポーション」の実験はこれで一段落ということで。次に試すのは…これ！「ぽかぽかポーション」です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390610,
					"content": "その名前って、ぜんぶ自分でつけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390611,
					"content": "いいえ、ベレナータはネーミングセンスがないので、他の人に名付けてもらったんですけど、変ですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390612,
					"content": "そういうわけでもないけど…薬にとっては、作用が一目でわかる名前のほうがいいからな。この理屈は間違ってないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390613,
					"content": "初めて聞いた理屈ですけど…でも確かに、薬剤師さまもそんな感じのお考えです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390614,
					"content": "#コホン、そのことはともかく。{NICKNAME}さん、この薬を試す準備はいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390615,
					"content": "うん、始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "うわぁ、この薬もひどい匂いだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390617,
					"content": "この「ぽかぽかポーション」は、理論上は体を温めてくれて、どんな寒さも平気になります！ええ…理論上は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390618,
					"content": "ベレナータから薬を受け取った。かびて埃が積もった古い革のような匂いがする…\\nしばらく躊躇ったのち、一気に飲み干した。水薬は飲みにくくはなく、シナモンの香りとわずかにジンジャーの辛みがした…雨の日に書斎でパチパチ燃える暖炉を思い出した。\\n身体のほうは、特に何の反応もなかった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "それからベレナータの指示どおり、しばらく休んだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "何も感じなかった…甘いだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "え！？でも…あんなにツンとした匂いがしたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390607,
					"content": "う…そうですか？どこか間違えちゃったのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390608,
					"content": "落ち込むなって…とにかく、えーっと、とにかく飲みにくくも毒でもなかったんだから、それだけでも成功だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7403907,
