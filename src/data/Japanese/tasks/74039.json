					}
				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#{NICKNAME}さん！もしもし？大丈夫ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390702,
					"content": "うう…ご、ごめんなさい…ベレ、薬が変なものを引き寄せるとは知らなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390703,
					"content": "体がぽかぽかになったから、こうなったんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "えっ…それが原因なのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390705,
					"content": "あ…なるほど、水生動物はぽかぽかしたものを太陽の光と勘違いして、寄って来たんですね。つまり…薬は成功です！ありがとうございます！本当にありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390706,
					"content": "うーん…そんな理屈じゃないと思うけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390707,
					"content": "水生動物…？炎スライムじゃなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "そうですか…うん、幻覚作用ですね…はい、記録しました！全く効果がないわけでもないですね…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390709,
					"content": "でもその効果はマズイだろ！今日は大きなカニが炎スライムに見えただけだったけど、もっと危険な相手だったらどうするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390720,
					"content": "ええ…もうずいぶんご迷惑をおかけしてますけど、まだ実験が必要な最後の薬があるんです…その、お願いしていいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390721,
					"content": "毒じゃないならいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "毒があるかどうかも試してみないと分からないんじゃないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390725,
					"content": "うう、ありがとうございます！じゃあ次は…「真眼薬」です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390726,
					"content": "えっ？待て待て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390727,
					"content": "一本目は「超スゴイポーション」、二本目は「ぽかぽかポーション」。で、最後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390728,
					"content": "「真眼薬」です。つまり「真実を目にすることができる」という意味ですが…どうかしましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390729,
					"content": "いや別に…ただネーミングが前の二つと比べて、いきなり360度変わったような気がしたからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390730,
					"content": "それじゃ変わってないのと同じ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "え…？か、数え間違えただけだろ！とにかくそういうことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390733,
					"content": "えへへ、前の二つは薬剤師さまがつけてくれた名前だったんですが、「真眼薬」はベレナータが自分でつけたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390734,
					"content": "ベレナータにはネーミングセンスがなくて…やっぱり薬剤師さまには及びませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390735,
					"content": "そ、そうか…逆かと思ったぜ…でも自信持っていいぞ！むしろこっちのほうがまともな薬の名前っぽいしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390736,
					"content": "えへへ、ありがとうございます。その…この薬は前の二つとは違って、危ないかもしれません…ですから、ベレナータのラボまで来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390737,
					"content": "ええ…海の中なら薬効を中和できる環境になっているはずですし、ラボには危険に対処できる道具があるので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390738,
					"content": "うわぁ…今度は本当に劇薬なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390739,
					"content": "今すぐ始めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "ええ、ついてきてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390731,
					"content": "それを言うなら180度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "毒を食らわば皿まで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "そうだな、途中で投げ出すのも情けないしな。とはいえ…やっぱり心配だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390710,
					"content": "大丈夫、炎スライムは弱いから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#まあ確かに…じゃなくて！そりゃ{NICKNAME}は強いけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390712,
					"content": "あら、でも待ってください…さっき「炎スライム」って言いました…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390713,
					"content": "そうだぞ…オイラたちにはカニにしか見えなかったのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390714,
					"content": "カニ？…海にカニがいるのは確かに普通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "でもさっきは普通じゃなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390716,
					"content": "燃えてる感じはリアルで、熱さえ感じた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "そうですか…ええ、幻覚作用ですね…はい、記録しました！全く効果がないわけではありませんでしたけど…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390718,
					"content": "とにかくご無事でよかったです！ただ…申し訳ありません、薬はまた失敗です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390719,
					"content": "#気にするなよ、とにかく…そう、匂いはひどいけど、半分は成功したんだ！ほら、{NICKNAME}もピンピンしてるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "パイモン"
				}
			]
		},
