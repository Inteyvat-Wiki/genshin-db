			"dialogs": [
				{
					"id": 740390101,
					"content": "うん…陰干しにしたタイダルガのペーストに、ルエトワールの塩辛を…えっと、「少々」…えーっと…「少々」ってどのくらいなの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390102,
					"content": "ん？スープでも煮てるのか…？うえっ！なんだこの変な匂い…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390103,
					"content": "え？変な匂い？そんなはずは…カラボス様の処方箋通りに調合したんですから、匂いは普通のはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390104,
					"content": "カエルの死体で三年発酵させたスズキの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "やめろよ！絵面が頭に浮かんじゃうだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390108,
					"content": "と、とにかく、何を作ってるんだ？ええと…何か手伝うことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390109,
					"content": "薬ですよ、薬を調合しているんです…大勢の人を助けられる薬を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390110,
					"content": "あー…つまり…おまえは薬剤師なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390111,
					"content": "ベレナータはまだ薬剤師じゃなくて、薬剤師さまの助手です。薬剤師さまはカラボス先生というすごい方です。ベレはまだまだたくさん学ばないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390112,
					"content": "へへっ、すごい薬剤師の助手なら、きっとおまえもすごい助手なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390113,
					"content": "エへへ…まあ…い、いえ、そんなことありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390114,
					"content": "とんでもないことです…ベレナータにはまだ、知らないことが沢山あります。今はただ薬剤師さまのために頑張って薬を調合しているだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390115,
					"content": "あ、あの…ベレナータは名前をお教えしましたが、そちらのお名前はまだお聞きしていませんね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390116,
					"content": "#オイラはパイモンで、こいつは{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390117,
					"content": "パイモンさん…いいお名前ですね。白いクラゲのように、にぎやかで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}さん…ちょっと変わったお名前ですね。きらきら輝いているのに、フレンドリーな感じです。お会いできて嬉しいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390119,
					"content": "あの…手伝うことはあるかと聞いてくださいましたよね…手伝ってほしいです。でも、お願いしていいかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390120,
					"content": "どうぞ遠慮なく言って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "おう！手伝ってほしいことがあるなら、遠慮なく言ってくれていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390122,
					"content": "試してみてほしいんです…新しく調合した薬を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390123,
					"content": "え…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390124,
					"content": "薬は嫌な匂いがするし、飲みにくいっていうのは分かってますけど…たくさんの人を助けられて、たくさんの病気を治せます。つまり役に立つんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390125,
					"content": "でも私たちは病気になりませんし、変なものも飲みたくありません…このままでは、ベレナータの薬を試してくれる人がいなくなります。それで困っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390126,
					"content": "う…こいつ、自分で「変なもの」って言ったぞ。危なくないのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390127,
					"content": "大丈夫です、私たちにとっては毒じゃありません。えっと…つまり、理論上は、あなたたちにも毒にはならないでしょう…ええ、理論上は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390128,
					"content": "実験が必要な薬は…ええと、全部で三種類あります。一つは有能で、すごい人になれる薬！一つは体を温める薬。そしてもう一つは…ええと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390129,
					"content": "ベレナータもよく分からないのですが…カラボス様は「真実」を見抜ける人になれると仰ってました。そう聞いたことは間違いないんですけど、よく分からなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390130,
					"content": "やっぱり危なそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740390131,
					"content": "いえ、危なくはありません…その、手伝ってもらえますか？手伝ってくれるなら、今すぐご案内します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ベレナータ"
				},
				{
					"id": 740390106,
					"content": "心を静めたらスイートフラワーの香りも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "いや、そんなことはないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "パイモン"
				}
			]
		},
