						746560102
					]
				},
				{
					"id": 746560102,
					"content": "おお、若き友よ、バブルオレンジを持ってきてくれたかい？俺にも少し分けておくれ。食べながら語ろうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560103
					],
					"speakerTitle": "イスメノール"
				},
				{
					"id": 746560103,
					"content": "彫像は言葉のない詩であり、腹を空かせた時に鑑賞すべきではない。これはとある決闘者が人生最後の決闘で俺に教えてくれたことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "イスメノール"
				},
				{
					"id": 746560106,
					"content": "用意できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "人伝に聞いた通り、バブルオレンジへのお礼を用意しておいたが…どうやら、あんたが準備できてから渡さないといけないようだ…",
					"roleType": "TALK_ROLE_NPC",
