			"dialogs": [
				{
					"id": 401710601,
					"content": "準備はいい？スピリットの織り機の使い方はカンタンよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710602,
						401710604
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710602,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710603
					]
				},
				{
					"id": 401710603,
					"content": "こういうの初めてかもしれないけど、キミならきっとうまくできるハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710604,
					"content": "ちょっと待ってて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710605
					]
				},
				{
					"id": 401710605,
					"content": "分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
		{
