			"dialogs": [
				{
					"id": 401710101,
					"content": "旅人が来れば、きっと全部よくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710102
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710102,
					"content": "おーい！オロルン、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710103,
					"content": "あっ、旅人、パイモン。こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710104
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710104,
					"content": "オイラたちに用があるって聞いたから、飛んできちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710105,
					"content": "そうか…なんだか胸が温かい。これが幸せ、なのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710106
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710106,
					"content": "え、急にどうしたんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710107,
					"content": "君たちは真の友達だ。うちの野菜も君たちに会えたら、きっともっとよく育つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710108
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710108,
					"content": "えーと…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710109,
					"content": "君たちを褒めてる。人は褒められると喜ぶと聞いたんだが、嬉しくなったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710110
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710110,
					"content": "#ありがとう。でも{M#君}{F#あなた}は悩んでるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710111
					]
				},
				{
					"id": 401710111,
					"content": "バレてしまったか。そうだ、今はまるで、うまく蜜を作れないミツムシのように困っている。僕の前に、ばあちゃんが立ちはだかっているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710113
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710113,
					"content": "シトラリが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710114
					]
				},
				{
					"id": 401710114,
					"content": "ああ。知っているだろう、ばあちゃんは天才だ。天才はいつも他人の道を塞いで、絶望させる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710115
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710115,
					"content": "しかも僕はその孫だ。きっと僕には他人の何倍もの絶望が降りかかる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710116
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710116,
					"content": "これで分かってくれただろう？だからお願いだ、ばあちゃんを何とかしてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710117
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710117,
					"content": "一体なにがあったんだよ？深刻そうってことしか分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710118,
					"content": "どうしても君たちを味方にしたい。ばあちゃんを何とかできる人がいるとしたら、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710119,
						401710121
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710119,
					"content": "#{M#俺}{F#私}が、その人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710120
					]
				},
				{
					"id": 401710120,
					"content": "#ああ、最初に思いついたのが君だ、{M#じいちゃん}{F#ばあちゃん}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710123,
					"content": "#{M#じいちゃん}{F#ばあちゃん}、前にそう呼んで叱られたが、もう一度呼ばせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710124
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710124,
					"content": "僕は、君は何か違うと感じた。ばあちゃんの君への態度も他とは違う。出会ってからの出来事がそれを証明している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710125
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710125,
					"content": "「シトラリを何とかできる四十の者」というウォーベンがあったら、君はきっと一番目に描かれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710126
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710126,
					"content": "ほかに三十九人もいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710127,
					"content": "他の人も全員旅人だ。三十九人の旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710128,
						401710130
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710128,
					"content": "そう言われても、孫はまだ早い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710129
					]
				},
				{
					"id": 401710129,
					"content": "お願いだ、僕を助けてくれ。本当に大事なことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710132,
					"content": "今は暇そうに見えると思うが、実は進む道について悩んでいる。ばあちゃんが道を塞いでいて、僕は前に進めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710133
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710133,
					"content": "だが、君たちが来てくれたから、もう進んでも大丈夫なはずだ。それに時間は待ってくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710134
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710134,
					"content": "何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710135
					]
				},
				{
					"id": 401710135,
					"content": "知っての通り、ばあちゃんが好きなのは娯楽小説、たくさん酒を飲むこと、寝ることだ。君ならこれをうまく利用してばあちゃんをおびき出せるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710136
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710136,
					"content": "つまり、好きなものでシトラリを釣って、おまえの相手をする暇をなくそうってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710137,
					"content": "その通りだ。ちゃんと準備して、言うことも考えておいた。ばあちゃんにこう言えばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710138
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710138,
					"content": "「親愛なるシトラリ、『蜃気楼戦記』の最新刊と『オルツィ嬢事件簿』の特別番外編を持っている。一緒に読まないか？」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710139
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710139,
					"content": "君が撒いたエサなら、ばあちゃんはちょっと建前を並べた後、何か理由をつけて食いつくはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710140
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710140,
					"content": "#{M#俺}{F#私}ってそんなにすごいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710141
					]
				},
				{
					"id": 401710141,
					"content": "適当に言ってるだけだろ！うまいこと言って、その気にさせようとしてることくらいオイラにだってわかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710142,
					"content": "それは違う。ばあちゃんは口には出していないが、旅人に一目置いているのが分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710143
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710143,
					"content": "そうなのか…オロルンが焦ってるのはわかるし…まあ、シトラリとちょっとおしゃべりするぐらいなら、そんなに大変じゃないよな。引き受けてもいいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710144,
					"content": "ああ、まるで野菜に水をやるのと同じくらい簡単だ。うちの野菜たちがここにいてくれれば…あ、すまない。野菜の話をしている場合ではなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710145
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710145,
					"content": "どうか僕を信じて、一緒に来てくれ。君がいれば、きっと全てうまくいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710130,
					"content": "#…{M#じいちゃん}{F#ばあちゃん}に任せなさい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710131
					]
				},
				{
					"id": 401710131,
					"content": "#旅人の{M#じいちゃん}{F#ばあちゃん}、助けてくれるんだな？本当に大事なことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710121,
					"content": "#あはは、まさか{M#俺}{F#私}のことじゃないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710122
					]
				},
				{
					"id": 401710122,
					"content": "#そのまさかだ。僕が最初に思いついたのは{M#じいちゃん}{F#ばあちゃん}、君のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "オロルン"
				}
			]
		},
		{
