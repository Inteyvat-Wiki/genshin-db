						],
						"pointId": 350900100
					}
				]
			},
			"dialogs": [
				{
					"id": 401710201,
					"content": "あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710202
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710202,
					"content": "どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710203,
					"content": "ばあちゃんが…いない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710204
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710204,
					"content": "僕が入れないように、あの洞窟の入り口に立ちはだかっていたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710205
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710205,
					"content": "道を塞ぐってそのままの意味かよ！てっきり比喩だと思ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710206,
					"content": "一つの段落に比喩を二回使ったら、娯楽小説として二流だと、ばあちゃんが言っていた。僕は二流にはなりたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710207
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710207,
					"content": "おい、いま自分のことを娯楽小説にたとえてたよな？さっきのも入れて、もう二回、比喩を使ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710208,
					"content": "えっ？あ、しまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710209
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710209,
					"content": "とにかく、これで進めるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710210
					]
				},
				{
					"id": 401710210,
					"content": "おう、シトラリが譲ってくれたみたいだな。オロルン、今ならなんでもできるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710211,
					"content": "そんなにうまくいくはずが…ばあちゃんは、そう簡単に僕を捕まえるのを諦めてはくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710212
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710212,
					"content": "洞窟に入ったら、ばあちゃんの監視の術で見つかるか、ワナにかかるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710213
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710213,
					"content": "どうして捕まえようとするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710214
					]
				},
				{
					"id": 401710214,
					"content": "そうだぞ。しかもワナまであるのかよ！おまえ…また前みたいに変なこと考えてないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710215,
					"content": "僕はただ、人を助けたい…だが、ばあちゃんはそれを許してくれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710216
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710216,
					"content": "た、助けるって！？？なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710217,
					"content": "試しに先に入ってみてくれないか？今はまだ問題なさそうだけど、時間が経てば経つほど、危ない人はもっと危険度を増していく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710218
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710218,
					"content": "おまえはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710219,
					"content": "僕はばあちゃんのワナにかからないように、しばらく入口で待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710220
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710220,
					"content": "ワナがあったら、こっちがかかっちゃうじゃないかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710221,
					"content": "それは心配ない。ばあちゃんのワナは旅人のことを識別できるから、君たちに手を出したりはしないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710222
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710222,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710223
					]
				},
				{
					"id": 401710223,
					"content": "ああ。僕はうちのミツムシに君の偉大な実績を話してきた。ばあちゃんも同じようにワナに話してるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710224
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710224,
					"content": "おまえと一緒にするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710225,
					"content": "#とにかく、頼んだぞ、{M#じいちゃん}{F#ばあちゃん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710226
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710226,
					"content": "誰か困ってるんなら、とりあえず中に入ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
