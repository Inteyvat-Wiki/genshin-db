						],
						"pointId": 350900102
					}
				]
			},
			"dialogs": [
				{
					"id": 401710401,
					"content": "ふぅ…無事に入れたぜ。なにもなかったな。シトラリのワナが、オイラたちを識別できるって本当なのかもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710402,
					"content": "うわっ！見ろ！あそこに誰かいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710403,
					"content": "おい！しっかりしろ！聞こえるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710404,
					"content": "反応が無い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710405
					]
				},
				{
					"id": 401710405,
					"content": "寝てるのか？いや、病気か？…もしかして、こいつがオロルンの言ってた、助けを待ってるやつなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710406,
					"content": "ここもなんか妙な感じだぞ。なにをするところなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710407,
					"content": "何かの儀式みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710408
					]
				},
				{
					"id": 401710408,
					"content": "うーん…オロルンを呼んでこようぜ。あいつならここがなんだか、きっと知ってるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710409,
					"content": "ごめん、ばあちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710410
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710410,
					"content": "ずいぶん立派になったみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710411
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710411,
					"content": "…本当にごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710412
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710412,
					"content": "六人の英雄になったから、何をしても許されるとでも思ったの？ねえ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710413
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710413,
					"content": "どうしてあの霊感音痴のコトにクビを突っ込んだのよ！ちゃんと説明しなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710414
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710414,
					"content": "オロルン！…とシトラリ…あはは…戻ってきてたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710415,
					"content": "え？ええーっ？キミたち、どうして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710416
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710416,
					"content": "（ちょっと待って、どうしてこのコたちがいるのよ？さっきの怖い顔、見られてないよね？あぁ、ワタシのイメージが…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710417
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710417,
					"content": "あ、あはは…こんにちは。えっと…さっきはオロルンと、その…ごっこ遊びをしてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710418
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710418,
					"content": "娯楽小説の人物になりきって、セリフを言うモノよ。だから、さっきのはどれもホンキじゃないの。そうよね、オロルン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710419
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710419,
					"content": "えっ？あ…ああ、ばあちゃんの言うとおりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710420
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710420,
					"content": "旅人も、すまない。手伝ってもらおうと思っていたのに、ばあちゃんに捕まって、ごっこ遊びに付き合っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710421,
						401710422,
						401710423
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710421,
					"content": "謝らなくていい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710425,
					"content": "シトラリ、オロルン、おまえたち、ここで一体なにしてるんだ？そいつ、どうしちゃったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710426,
					"content": "彼はルラ。霊視中にアクシデントがあって、こんな風になっちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710427
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710427,
					"content": "霊視って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710428
					]
				},
				{
					"id": 401710428,
					"content": "スピリットをカラダから離脱させて、未知を探究する巫術よ。小説にシャーマンが出てきたコトない？あんな感じね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710429
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710429,
					"content": "問題は、彼のスピリットがどこかで迷子になって、カラダに戻れなくなってるコト。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710430
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710430,
					"content": "つまり、体はここにあるけど、魂がないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710431,
					"content": "スピリットは魂とはちょっと違うの。でもまあ、単に魂が抜けてるっていう理解でも大丈夫よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710432
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710432,
					"content": "ああ。僕はルラのスピリットを取り戻そうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710433
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710433,
					"content": "フン、このルラが普通の人ならナニも言わないし、オロルンを止めたりもしない。でもルラが霊感音痴ってコトが問題なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710434
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710434,
					"content": "霊感音痴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710435
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710435,
					"content": "霊感、つまり霊的なものを感じ取るチカラが全然ない人のコトよ。ジブンの周りのスピリットを感知したり、操ったりもできないし、関連する巫術も使えないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710436
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710436,
					"content": "そんな人が、何らかの方法で巫術を無理やり使おうとしたら…キミの目の前にいる、ルラみたいになるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710437
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710437,
					"content": "謎煙の主の巫術はスピリットと密接に関係してるし、問題を解決する方法もそう。だから霊感音痴に普通の治療は効果ナシなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710438
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710438,
					"content": "そういった人たちの巫術に何かしらのアクシデントがあったら、ほぼほぼ助けようがないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710439
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710439,
					"content": "助けようならある。魂のことなら、僕には…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710440
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710440,
					"content": "もう分かったでしょ？このコが何をするつもりなのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710441
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710441,
					"content": "オロルン、おまえ、自分の体質を利用しようとしてるのか…でも、それって危ないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710442,
					"content": "ばあちゃんは心配しすぎなんだ。体はもう問題ないし、安全な方法も見つけた。この方法でしか、ルラのスピリットを取り戻せないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710443
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710443,
					"content": "そんなことゼッタイ考えないで！ルラのためにどこまでするか、ワタシが分からないとでも？まったく…本当に考えなしのアンポンタンなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710444
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710444,
					"content": "うーん…オロルンは確かに、人を救うためなら自分を顧みないタイプだよな。シトラリも心配症だし。どうすればいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710445,
						401710448,
						401710450
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710445,
					"content": "シトラリに賛成。オロルンはアンポンタン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710446
					]
				},
				{
					"id": 401710446,
					"content": "僕はアンポンタンでいい。君たちの応援さえあれば、僕はルラのスピリットを連れ戻せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710447
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710447,
					"content": "ちょっと！ばあちゃんをなんだと思ってるの？孫の出番なんてあるわけないでしょ？もちろん、ワタシにだって方法はあるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710452,
					"content": "おお！ホントか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710453
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710453,
					"content": "えっ？ばあちゃん、本当にまだ手があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710454
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710454,
					"content": "頭の悪い方法だって通用すれば、なんだってアリよ！この悪ガキ、ホントにいつも手を焼かせてくれるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710455
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710455,
					"content": "旅人、元からキミに連絡するつもりだったの。ワタシの方法は大規模なものだから、キミの手伝いが必要かもしれないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710456
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710456,
					"content": "じゃあ、ちょうどよかったな。オロルンが先に声をかけてくれてたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710457
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710457,
					"content": "わかった。何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710458
					]
				},
				{
					"id": 401710458,
					"content": "二つの方向から攻めてみましょ。一つ目はしらみつぶしに探すっていう、おバカな方法ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710459
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710459,
					"content": "ルラの周りに、夜神の国に通じる境界の門を描いたの。これよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710460
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710460,
					"content": "境界の門を起動したら、付近をさまようスピリットが引き寄せられるから、運が良ければ、その中にルラのものがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710461
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710461,
					"content": "前と同じように、しばらくキミにチカラを分け与えて、霊視を共有する。でも、そのためにこの脱魂の香炉を使わなければならないの。忘れないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710462
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710462,
					"content": "前みたいな事故はもう起こらないから、安心してちょうだい！夜神の国に行った時みたいに、霊をたくさん見かけるコトになるハズよ。それを全部集めればいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710463
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710463,
					"content": "その後の見分け作業はオロルンに任せて。このコが関わるって決めたんだから、一番大変なトコロを任せましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710464
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710464,
					"content": "もう一つは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710465
					]
				},
				{
					"id": 401710465,
					"content": "スピリットが自然に集まる性質を利用するの。霊視は一般的に、何らかの謎を探るのが目的よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710466
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710466,
					"content": "ルラが知りたがってたコトが分かったら、彼のスピリットを引き寄せられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710467
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710467,
					"content": "ルラのカラダを媒体にして霊視すれば、多少はその考えを読み取れるハズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710468
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710468,
					"content": "なるほど！なんとなくわかった気がするぜ。一つ目の方法は大きな網でなるべくたくさんの魚を捕るかんじで、二つ目の方法はエサで魚を釣るみたいなことだよな。オロルンがおまえを娯楽小説で釣ろうとしてたのと同じだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710469
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401710469,
					"content": "うぅ…パイモン、それを今、言わなくても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710470
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710470,
					"content": "はぁ！？このっ、あとでおしおきよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710471
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710471,
					"content": "でも、ばあちゃんはすごいな。人間を媒体に霊視するなんて。ずっと、物しか使えないと思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710472
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710472,
					"content": "フン、ゴマをすってもムダよ。スピリットを失った人間のカラダなんて抜け殻と同じ。モノと大して変わらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710473
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710473,
					"content": "旅人、あそこにあるのはワタシのスピリットの織り機よ。ワタシが霊視した断片的なものを記録できるの。ワタシが霊視を始めたら、それにウォーベンをセットしてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710474
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710474,
					"content": "準備ができたら教えてね。すぐに始めるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710448,
					"content": "オロルンに賛成。シトラリはアンポンタン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710449
					]
				},
				{
					"id": 401710449,
					"content": "ねえ、ちょっと！黒曜石の老婆をなんだと思ってるの？もちろん、ワタシにだって方法はあるんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710450,
					"content": "シトラリなら他の方法があるはず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710451
					]
				},
				{
					"id": 401710451,
					"content": "フフン、トーゼンでしょ。だてに黒曜石の老婆をやってないわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 401710422,
					"content": "次は気をつけてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710423,
					"content": "#ごっこ遊び？{M#俺}{F#私}も混ぜて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710424
					]
				},
				{
					"id": 401710424,
					"content": "遊んでる場合じゃないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710425
					],
					"speakerTitle": "パイモン"
				}
			]
		},
