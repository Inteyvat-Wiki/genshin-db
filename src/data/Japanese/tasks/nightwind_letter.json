				},
				{
					"id": 401710721,
					"content": "分かった…頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710722
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 401710722,
					"content": "任せて。",
