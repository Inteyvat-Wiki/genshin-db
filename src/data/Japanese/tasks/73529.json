{
	"id": 73529,
	"type": "WQ",
	"name": "鋭気と優雅のダンス？",
	"description": "「隠者の遊園」の中心エリアで、変わった言動をする「ブレードダンサー」があなたたちから何かを感じ取ったようだ…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2023,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
