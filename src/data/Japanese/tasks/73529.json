	"talks": [
		{
			"id": 7352901,
			"completionStepIds": [
				7352901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352901",
							"2"
						],
						"stepId": 7352901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レフェイン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735290101,
					"content": "感じたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290102
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290102,
					"content": "お前たちの一挙一動から漏れ出す「戦場のステップ」の気配…なんとカラフルで、ワンダフルなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290103
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290103,
					"content": "燃ゆる切っ先が頬を掠めた瞬間、お前たちの瞳に灼熱のゴールドラインが煌いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290104
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290104,
					"content": "氷の壁を軸に舞い踊る優雅なターンは、足先のステップと共に厳格でゴージャスなリズムを刻む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290105
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290105,
					"content": "轟音を立てて押し寄せる古木の城壁。鋼の巨人の軍勢と対峙する中で、俊敏に動くお前たちの姿は、一瞬たりともペン先そしてカメラの追随を許さなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290106,
						735290107
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290106,
					"content": "何言ってるのか分からない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				},
				{
					"id": 735290108,
					"content": "お前たちのその豪快なオーラは、まさに俺が尊敬してやまないものだ。間違いない…お前たちなら、きっと俺の心の友になれるはずだ…ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290109
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290109,
					"content": "俺は「ブレードダンサー」レフェインだ。お前たちの名を教えてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290110
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290110,
					"content": "うわぁ…やばい喋り方するやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290111,
					"content": "#オイラはパイモン、こいつは{NICKNAME}だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290112,
					"content": "オイラたちは確かにすごいけど、レフェインの話はすごく複雑で、どういう意味かまったく分からなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290113,
					"content": "刃物は持ってないみたいだし、服装もダンサーっぽくないよな。なんで「ブレードダンサー」を自称してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290114,
					"content": "鋭い質問だ。パイモン閣下は俺の心に試練を与えていらっしゃるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290115
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290115,
					"content": "有限な武器を刃とせず、剣をその心に秘め、必要な時にいかなるものにもその鋭気を乗せることで、形ある戦法を枷から解き放つことができるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290116
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290116,
					"content": "決して服装などには拘らず、戦場と言う名のステージに立った瞬間から、華麗な身のこなしを披露し、優雅なスキルで全てを掌握する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290117,
						735290118,
						735290119
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290117,
					"content": "つまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290120,
					"content": "的確な要約だ！だがどうか「鋭気」と「優雅」という二つのキーワードを無視しないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290121
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290121,
					"content": "待った…分かったぞ！お前たちは既に遥か高みの境地へと至っている。謀らずともこの二つを実践できているというわけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290122
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290122,
					"content": "では早速、この扉に入って「幽思閃念の旋舞」のステージへ登り、俺に至高なるダンスを披露してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290123
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290123,
					"content": "イディア様のおかげで、「幽思閃念の旋舞」の中には、色んな強敵がファントムとして現れるようになっている。やつらは、お前を徹底的に倒そうとしてくるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290124
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290124,
					"content": "心の中に秘めている「鋭気」を解き放つ瞬間、その胸の奥底に眠る最強の剣は抜かれ、強敵を草刈りの如く薙ぎ払うことができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290125,
						735290126
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290125,
					"content": "分かったかも！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290127,
					"content": "その通り。以心伝心の語らいだったな、愉快痛快だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290128
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290128,
					"content": "俺はここで瞑想しながら、良き知らせを待っている！お前がこの唯一無二のバトルダンスを楽しんでくれることを祈っているぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290129
					],
					"speakerTitle": "レフェイン"
				},
				{
					"id": 735290129,
					"content": "ええと、なんだかおまえたち、少しずつ…息が合うようになってきたような感じがするんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290130,
					"content": "今やっと気づいたけど、レフェインはオイラたちを、喧嘩が強いって褒めてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290131,
					"content": "そんで、あいつは戦闘試練の秘境を管理してて、オイラたちの戦いぶりを見たいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290132,
					"content": "まあ、別に悪い話じゃないかもな…戦いをダンスに例えるのは、ちょっと独特だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290133,
					"content": "簡単なことをすごく複雑そうに言い換えるのも、きっと能力のうちなんだろうな。そういう話し方を真似られれば…どんな人が相手でも、すぐにハッタリを利かせられるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290134,
						735290135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290134,
					"content": "#実は{M#俺}{F#私}もハッタリが得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290136,
					"content": "ふん！褒めるのはついでの会話スキルだけどな。あいつといっぱい話せば、きっと全部理解できるようになるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290137,
					"content": "早くその「幽思閃念の旋舞」とかってところで、かっこよくて痛快な「至高なるダンス」をかましてやろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290138,
					"content": "#レフェインはオイラたちにどんな大げさなコメントをくれるんだろうな…{NICKNAME}、今後使えそうだから、ちゃんと聞いて覚えるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735290135,
					"content": "レフェインは褒め上手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290126,
					"content": "爽快な戦闘試練なんだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290118,
					"content": "服装は関係ない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290119,
					"content": "何でも使う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290107,
					"content": "でももっと褒めて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				}
			]
		}
	]
}