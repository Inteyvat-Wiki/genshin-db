			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "みんな、価値のある情報をたくさん提供してくれたね。整理してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530802,
					"content": "分かりやすいものもあれば、信じられないようなものもある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530803,
					"content": "仙霊の身分と行方がわかるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "うん、やってみるね。ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530805,
					"content": "（レイラ、落ち着いて。手がかりは錯綜してるけど、あなたならできるよ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530806,
					"content": "（まず、既存の手がかりから仙霊の身分を連想しよう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530807,
					"content": "（次にその行動の軌跡と動機を分析して、最後にさっきの推論と結びつければ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530808,
					"content": "（その行動戦略が分かるはず。うん、この考え方でやってみよう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レイラ"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530902,
					"content": "分析を聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "うん。まず、カタユンさんが提供してくれた情報から、仙霊の正体はルタワヒスト学院の学生だってことが分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530904,
					"content": "外部の人間である可能性はほぼ排除できる。なぜなら、管理者に知られずに、あの二冊の本を持ち出すことはできないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530905,
					"content": "次に、不思議な超能力のことはいったん置いておいて、目撃された場所はすべて、私たちの学院が星象観測の地点として推奨しているところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530906,
					"content": "つまり…仙霊は研究をしてて、しかもその内容は私と似てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530907,
					"content": "私が出した質問は簡単なものじゃないのに、その日のうちに返信してくれた。似たような予備知識を把握してる証拠だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530908,
					"content": "それなら、この推測を基に、星象観測の地点で仙霊を待てばいいと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530909,
					"content": "いい考え。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "ほ、褒めすぎだよ…実は、もっと別の理由があるの。今までずっと考えていた推測がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530912,
					"content": "でもそれは重要じゃない。とりあえず行ってみましょう。手がかりがあるとはいえ、結論が出るかどうかはまだ分からないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530913,
					"content": "どうしてそう思うのかは…仙霊が来なかったら、教えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レイラ"
				},
				{
					"id": 191530910,
					"content": "これだけ推理する力があるなら、論文を完成させるのも問題ないはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}