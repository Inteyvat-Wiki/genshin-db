	"talks": [
		{
			"id": 7468401,
			"completionStepIds": [
				7468401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468401",
							"2"
						],
						"stepId": 7468401,
						"stateName": "QUEST_STATE_UNFINISHED"
