			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランジット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746840101,
					"content": "二人とも、こないだは本当にお疲れ様。最初の目的とは多少ズレてしまったが、色々と収穫のある良い旅だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840102,
						746840103
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840102,
					"content": "爽快な戦いができた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840104
					]
				},
				{
					"id": 746840104,
					"content": "「色々と収穫」っていうより、むしろ教訓になったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840105,
					"content": "そうかもね。絆を結ぶなんてこと、すぐにできるようなものじゃない。それに今回のように色んな相手に挑むんじゃなく、どれか一つに絞って、そいつに集中すべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840106
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840106,
					"content": "ナタだって、そういう過程を経てるしね。古龍の国から今のように人と竜が互いに信じ合い、仲間になって共に暮らす状態になるまで、どれだけ長い時間を要したか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840107
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840107,
					"content": "はぁ、このせっかちな性格がいけなかったというわけか。魔物なら、自分を負かした相手に多少なりとも敬意を持つと思って、今回のようなやり方を選んだんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840108
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840108,
					"content": "最初からコツコツと時間をかけて——例えば毎日エサをやって、少しずつ近づいていけば、成功率をもっと上げられたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840109
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840109,
					"content": "まぁ確かに、理屈的にはそうかもしれないな。でも、そもそもおまえが選んだ相手たちは、そこら辺の猫とか犬じゃないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840110,
					"content": "そうだね。でもあの魔物たちは、私から見るとナタの竜に似たところがあった。だから、あいつらを選んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840111
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840111,
					"content": "だって、そうすればナタの友人たちに冒険譚を聞かせる時、私の成し遂げたことがいかにすごいか理解しやすいんじゃないかと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840112
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840112,
					"content": "あいつらのどこがナタの竜に似てるんだ？…う～ん、エンシェントヴィシャップは似てるかもしれないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840113,
					"content": "何を言ってる？他のやつらにも似てるところはあるだろ？色とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840114
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840114,
					"content": "その理屈で行くなら、スライムもナタの竜に似てるって言えるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840115,
					"content": "ふむ、スライムは元素生物で、竜も元素生物だ…確かに一理ある。もしかしたら、スライムには竜になれる可能性が秘められてるのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840116
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840116,
					"content": "ってことは、やはりスライムから絆を結ぶべきだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840117,
						746840119
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840117,
					"content": "計画の規模が一気に縮んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840118
					]
				},
				{
					"id": 746840118,
					"content": "実現する難易度もだいぶ下がったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840121,
					"content": "ははっ、とにかく何事も試してみないとね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840122
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840122,
					"content": "今回は二人のおかげで助かった。いつかまた会った時には、冒険の仲間ができていて、それから物語の「主人公」を名乗れるようにもなっていたいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840123
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840123,
					"content": "じゃ、君たちもどうか良い旅を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746840119,
					"content": "少なくともスライムのほうがリスクは低い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840120
					]
				},
				{
					"id": 746840120,
					"content": "あくまで比較してって話だろ？野外でスライムに囲まれただけで、手も足も出ない新米冒険者を散々見てきたじゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746840121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746840103,
					"content": "相手が強すぎた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746840104
					]
				}
			]
		}
	]
}