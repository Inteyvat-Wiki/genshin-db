			"dialogs": [
				{
					"id": 742080301,
					"content": "不思議な色変わりの結晶について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742080302
					]
				},
				{
					"id": 742080302,
					"content": "ああ、いつも通りといこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080303
					],
					"speakerTitle": "ピト"
				},
				{
					"id": 742080303,
					"content": "悪くない。でも、こんなに気持ちよく取引できる機会はもう今後なさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080304
					],
					"speakerTitle": "ピト"
				},
				{
					"id": 742080304,
					"content": "不思議なものが不思議であるとされるのは、それが希少だからだ。過去にも冒険家から不思議な色変わりの結晶を購入したことがあるが、その取引はたったの三回だけだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080305
					],
					"speakerTitle": "ピト"
				},
				{
					"id": 742080305,
					"content": "彼の話によれば、そのような代物はそれ以降二度と手に入らなかったそうだ。その中には、私たちの知らない自然の神秘があるのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080306
					],
					"speakerTitle": "ピト"
				},
				{
					"id": 742080306,
					"content": "私が思うに、この世界のためにも少しばかり謎を取っておくのは悪くない選択だ。そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピト"
				}
			]
		}
	]
