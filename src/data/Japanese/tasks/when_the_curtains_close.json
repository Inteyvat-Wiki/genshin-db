						],
						"pointId": 330201505
					}
				]
			},
			"dialogs": [
				{
					"id": 401060101,
					"content": "二十年前、教令院はサーチェンの資産を手に入れたばかりだった。まるでその巨額の投資を祝うように、その年の学院祭は特別盛大に行われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060102
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060102,
					"content": "あの頃、僕はまだ幼かった。シティを歩いていたら、あちこちに学院トーナメントのポスターがあって…思わず父さんにそのことを聞いた。あの冠が特別に見えて、とてもキレイだとも言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060103
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060103,
					"content": "父さんは、「じゃあ父さんが優勝して、冠で遊ばせてやろうか？」と聞いてきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060104
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060104,
					"content": "僕は嬉しくて、一生懸命頷いた。でも、その試合で、父さんは冠を手に入れることはできなかった。帰ってきたときは、とてもがっかりしてたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060105
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060105,
					"content": "その後、父さんは砂漠へ調査に行くと言って、家を出た。そしてしばらくもしないうちに、流砂に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060106
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060106,
					"content": "…どんなに経っても、僕はこのことを思い出す勇気がなかった。僕が余計なことを言わなかったら、あんなことにはならなかったかもしれない、ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーヴェ"
				}
			]
		},
		{
			"id": 7352402,
			"completionStepIds": [
				7352403
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060107,
					"content": "お父さんは、その時サーチェンに会ったかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060108
					]
				},
				{
					"id": 401060108,
					"content": "え？まさか…オイラたちが聞いた、二十年前砂漠に行ったっていう人だけど、あれって実は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401060109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060110
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060110,
					"content": "…ははっ、だからサーチェンは僕を見て、懐かしいなんて感じたのか？これはまったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060111
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060111,
					"content": "…優しすぎる父さんのことだ、サーチェンの理論を聞いたときは辛かっただろう。だから砂漠へ行って、苦しむ人々を探そうとした…僕にはそれがよくわかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060112
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060113
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060113,
					"content": "何度も自分に言い聞かせた。父さんは優勝できなくてがっかりしたんじゃない、見たままのことが全てじゃないと。でも…結局は、僕が試合のことを話したせいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060114
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060114,
					"content": "カーヴェ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401060115,
					"content": "心配するな。僕は…僕はあの冠を壊したんだ。これからはそんな悲劇は起きない。もう、起きないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーヴェ"
				}
			]
		},
		{
			"id": 7352403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060116,
					"content": "（以前した調査のことを隠す。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060117
					]
				},
				{
					"id": 401060117,
					"content": "すまない、まだ学院トーナメントのことを考えてたんだ。つい独り言をこぼしてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060118
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060118,
					"content": "なんだか悲しそうだけど…本当に大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401060119,
					"content": "大丈夫さ。もう過ぎたことだし、人間は前を向いてなきゃならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーヴェ"
				}
			]
		},
		{
			"id": 7352404,
			"completionStepIds": [
				7352406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352406",
							"2"
						],
						"stepId": 7352406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カーヴェ",
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060201,
					"content": "会食のとき、どこへ行ってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060202
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060202,
					"content": "君に報告する義務はないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060203
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060203,
					"content": "まさか、またどこかで本でも読んでたのか？君もいい加減生き方を変えるべきだと思うぞ。本を読むだけじゃ人は生きていけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060204
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060204,
					"content": "そうか？君の奢りで生きていくほうが、よほど難しいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060205
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060205,
					"content": "君ってやつは…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060206
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060206,
					"content": "ふん、想像に難くないぞ。どうせサーチェンのことを調べに行ってきたんだろ？あのメモを見れば分かるさ。でも意外だな、君がサーチェンの研究に興味を持つとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060207
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060207,
					"content": "あいつのやり方は本当に気に食わない。君の…確かに君の観点も嫌いだ、でも君はサーチェンとは異なるタイプの人間だし、その観点において重なってる部分はないはずだ。利己主義と虚無は違うからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060208
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060208,
					"content": "興味なんてものは置いておくとして、サーチェンは一人の力で、これだけの規模の実験結果を遺した。そこにまったく意味がないわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060209
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060209,
					"content": "それと、褒めてくれてありがとう。ただ、俺は院へ行く途中というだけで、君のそういう話を聞きたかったわけじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060210
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060210,
					"content": "おい、学者にとって、理念を討論するよりも尊い話題ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060211
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060211,
					"content": "俺の知る限り、君の言う気に食わないサーチェンは、二十年前に君の父親と会っていた可能性が高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060212
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060212,
					"content": "…何だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060213
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060213,
					"content": "…まさか…いや、そういうことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060214
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060214,
					"content": "はぁ、だからサーチェンは僕を見て、懐かしさを覚えたのか。父さんが砂漠へ行ったのは、あいつの影響を受けたからだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060215
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060215,
					"content": "恐らく、そうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060216
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060216,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060217
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060217,
					"content": "冠を壊してよかったよ。これからは…こんなことも、もうないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060218
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060218,
					"content": "知識の境界線は、遠く外へと伸びている。将来、必ず同じことを研究する人間が現れるだろう。因論派にとって、それは合理的な研究方針だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060219
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060219,
					"content": "また君の講義が始まったのか？たとえ本当に君の言う通り、人間が知識の罠に落ちやすいとしても、必ずしもあんなふうになるとは限らないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060220
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060220,
					"content": "それに…一部の個体と全体の行動は、必ずしも一致するものではないんだということも、君は認めなければならない。サーチェンは、極めて特別なケースだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060221
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060221,
					"content": "彼を止めた君も、またそうだろう。この種の争い自体は特別なものだが、今の時代に限ったことじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060222
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060222,
					"content": "君も言ったじゃないか、「一部の個体」だと。誰もが君のような選択をするわけじゃないと、ちゃんと分かっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060223
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060224
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060224,
					"content": "…それでも、僕は自分の論点を諦めない。僕を説得しようとするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060225
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060225,
					"content": "構わない。俺たちは長いこと、こうした言い争いをしてきた。今更分かってもらえるとは期待していないさ。正しいか、間違いか、それはもう話の核心じゃなくなっているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060226
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060226,
					"content": "…教えてくれて、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060227
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060227,
					"content": "何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060228
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 401060228,
					"content": "教えてくれてありがとうって言ったんだ。おい！聞こえてないふりをするな！わざとやってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060229
					],
					"speakerTitle": "カーヴェ"
				},
				{
					"id": 401060229,
					"content": "感謝がしたいなら、普段の三倍は誠意を見せろ。さあ、もう一回だ。",
					"roleType": "TALK_ROLE_NPC",
