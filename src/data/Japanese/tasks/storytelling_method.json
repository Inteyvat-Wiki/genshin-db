			"dialogs": [
				{
					"id": 728120201,
					"content": "はい、物語はここまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120202,
					"content": "こんなに疲れたことは今までなかったよ。この物語は、そんなに複雑なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120203,
					"content": "君が事前に設定を決めていなかったからだよ。設定に縛られていなかったら、物語の中の要素がめちゃくちゃになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "茂"
				},
				{
					"id": 728120204,
					"content": "そうしたら、君は物語をコントロールできなくなった。何を書いても疲れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "茂"
				},
				{
					"id": 728120205,
					"content": "はぁ…もう君と争う力もない…旅人、ありがとう…判断してくれて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120206,
					"content": "君の判断は実に…勉強になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120207,
					"content": "報酬を受け取ってくれ、僕は帰って小説を書き続けるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 728120208,
					"content": "設定とストーリー、はぁ…一体どっちが重要なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		}
