				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "旅人、ようやく来てくれた。今日はもう来ないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380102,
					"content": "今日は私が璃月を離れる日、今までさんざん君にお願いばかりしてきたんだ…君にはしっかりお礼を言っておかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380104,
					"content": "コホン…さっきまで、君に会ったらどんな感謝の言葉を述べようか考えていたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380105,
					"content": "いざ話すとなると、きれいさっぱり忘れてしまった。見苦しいところを見せてしまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380106,
					"content": "大丈夫、また会える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "本当か？ハハハ、それは良かった。その時は、君と共に色々なところを回れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380109,
					"content": "そうだ。最後に一つお願いしたいことがある。確か君は「写真機」を持っていたな？私のために一枚撮って欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380110,
					"content": "船乗りから聞いたんだが、外を旅するときは故郷の「写真」を思い出に持っておくといい、とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380111,
					"content": "しかし、もちろん私に「写真機」というものはないから、君に頼むしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380112,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "いい感じのポーズで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "ど、どんなポーズをとれば…？とにかく、後ろの景色を撮ってもらえれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380107,
					"content": "しばらくしたら、フォンテーヌで探すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
