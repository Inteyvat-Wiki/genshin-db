			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "旅人、ありがとう。この「写真」で十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380203,
					"content": "ふう、ついに出発のときだ。普段、人から「男子の志は四方にあり」やら、「万巻の書を読み、万里の道を行く」だのと聞くときは、なんと気概に溢れていることかと感じたものだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380204,
					"content": "いざ、自分が故郷を離れ遠く船出す身になってみれば、そんな気概は微塵もなく、ただもう少しここにいたいとしか思わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380205,
					"content": "旅人、今回の旅で私は、本当に欲しい物を見つけられると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380206,
					"content": "分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "ハハ…そうだな。私は一体何を探しているんだ？私自身ですらわかっていないのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380210,
					"content": "よし、そろそろ時間だ。あの商人と合流する。この報酬を受け取ってくれ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380211,
					"content": "小鳥は…結局来てくれなかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210380208,
					"content": "自分次第だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "それは…ほぼ「これは縁次第」と言っているようなものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "孫宇"
				}
			]
		},
