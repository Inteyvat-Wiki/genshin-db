							8663.825
						],
						"pointId": 9241
					}
				]
			},
			"dialogs": [
				{
					"id": 250280301,
					"content": "あっ…箱が壊されてるみたいだぞ…たぶんレコードも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 250280302,
					"content": "あいつが僕たちをあそこにおびき寄せたんだろうな。はぁ…一体どこからこんなやり方を仕入れたんだか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280303
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280303,
					"content": "君たちはミル·ヌイさんの頼みでレコードを回収しに来たんだろう？前に君たちが彼と話しているのを見たから、なんとなく察してはいたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280304
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280304,
					"content": "僕らはみな「流泉の衆」の者だ。あいつは…前はいいやつだったんだけど、最近どこからか悪いことを学んできたようでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280305
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280305,
					"content": "すまない、自己紹介が遅れたね。僕はリロ。僕の…仲間に代わって、もう一度謝るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280306
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280306,
					"content": "…このやりとり、実に美しくないね。もし部族の中にいたら、少なくとも飲み水くらいはごちそうできるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280307,
						250280309
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280307,
					"content": "冒険者だから慣れっこだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280308
					]
				},
				{
					"id": 250280308,
					"content": "そうなのかい？君の格好やさっきの身のこなしといい、確かに経験豊富な冒険者のようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280313,
					"content": "…オホン。まぁそれは置いといて、まずは周囲の状況を何とかしよう。僕がレコードの欠片を集めるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280314
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280314,
					"content": "僕も君と一緒にミル·ヌイさんに会いにいくよ。直接謝らなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280309,
					"content": "前は、璃月の人と仕事をしてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280310
					]
				},
				{
					"id": 250280310,
					"content": "ああ。僕はもともと璃月のある男性に雇われていてね、一緒に鉱脈を探して山へ入ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280311
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280311,
					"content": "彼と仕事をしていたあの頃、僕はかなりお世話になったよ。彼がナタを去る時には、僕に「逸揚」という璃月の名前まで贈ってくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280312
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280312,
					"content": "彼によると「空を優雅に飛翔する」って意味らしい。まぁ…僕にはよく分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280313
					],
					"speakerTitle": "リロ"
				}
			]
		},
