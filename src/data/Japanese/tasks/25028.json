					"nextDialogs": [
						250281103
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250281103,
					"content": "お前もよぉ、あの璃月人とつるむようになってから、女々しくなっちまったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281104
					],
