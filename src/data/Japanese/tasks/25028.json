			"dialogs": [
				{
					"id": 250280701,
					"content": "ああ…俺のレコードが…これは原盤だぞ…原盤のレコードだぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280702
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280702,
					"content": "本当に申し訳ない。もし手伝えることがあったら何でも言ってほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280703,
						250280704
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280703,
					"content": "一枚しかないってわけじゃないし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280704,
					"content": "完全に失われたわけじゃないし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280705,
					"content": "もういいさ。ここまで粉々になっちゃあ…修復のしようもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280706
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280706,
					"content": "この際…一つだけ聞かせてほしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280707
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280707,
					"content": "…俺の音楽を聴いて、いいと思ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280708
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280708,
					"content": "子どもや竜の赤ちゃんが気に入るような「良さ」じゃなくて、いわゆる…流行りの曲の「良さ」のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280709
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280709,
					"content": "分かるか？このアルバムを聴いて、そういう感じはしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280710
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280710,
					"content": "流行りの感覚？ええと…ちょっと待ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280711
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280711,
					"content": "あんたらの部族が竜の赤ちゃんにレコードを奪わせたのは、収録されてる曲が流行りに乗ってて気に入ったから。違うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280712
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280712,
					"content": "ええと、説明してもいいかい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280713
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280713,
					"content": "僕らはそもそも…竜の赤ちゃんに君のレコードを奪うよう「指示」していない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280714
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280714,
					"content": "彼らは君のアルバムの曲に魅かれて、自分から走っていったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280715
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280715,
					"content": "なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280716
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280716,
					"content": "君の曲は素晴らしいよ！信じてくれ。僕が君のレコードを再生するたび、竜の赤ちゃんたちがはしゃいで僕らを取り囲んで走り回り、大喜びするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280717
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280717,
					"content": "なんだと？くそっ…俺のアルバムは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280718
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280718,
					"content": "君の気持ちは分かる。こんなに素晴らしいレコードを守り切れなくてとても申し訳なく思うよ。でも僕は、君と一緒にもう一度作品を作りたいんだ！この僕が誰にもレコードを奪わせはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280719
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280521,
					"content": "俺のアルバムは！童謡とかじゃねえんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				}
			]
		},
