			"dialogs": [
				{
					"id": 250281201,
					"content": "すごいな！二人の勇ましい戦いぶりがすごく印象的だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281202
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250281202,
					"content": "力強さだけじゃなく、すごくリズム感があったな。まるでタクトを振って戦場を指揮してるみたいだったぞ！でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281203
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250281203,
					"content": "…あのバラバラに砕け散ったレコード。あれが、この演奏の中の不協和音なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281204
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250281204,
					"content": "不運な目に遭った俺の友人たちに大霊の加護があらんことを…ともかく、これでレコードの一部だけでもあいつらのもとに持って帰れるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281205
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250281205,
					"content": "これをやるよ。受け取ってくれ！リロの兄貴、部族に帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281206
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250281206,
					"content": "俺の大事な友人たちが卒倒しなけりゃいいが…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
