				},
				{
					"id": 250281104,
					"content": "はぁ…あのな、こんなレコード、どうせ売れねぇんだよ。だから、このオレがわざわざ営業してやってんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281105
					],
					"speakerTitle": "不機嫌そうな部族の者"
				},
				{
					"id": 250281105,
					"content": "ハハハハッ、見ろよ。チビどももコイツの味が気に入ったみてぇだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281106
					],
					"speakerTitle": "不機嫌そうな部族の者"
				},
				{
					"id": 250281106,
					"content": "もう十分だろう。レコードを渡してくれ。僕が返しにいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281107
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250281107,
					"content": "…オイ、いい加減にしろよ。ぶちのめされてぇのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250281108
					],
					"speakerTitle": "不機嫌そうな部族の者"
				},
				{
					"id": 250281108,
					"content": "ハハッ、いいぜ。ちょうど相手がいなくて退屈だったんだ。ちょっと遊んでやろうじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "不機嫌そうな部族の者"
				}
