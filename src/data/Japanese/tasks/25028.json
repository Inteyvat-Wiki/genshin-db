			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ミル·ヌイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280101,
					"content": "ああっ、もう終わりだ！俺のポップスの傑作が…食われちまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280102
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280102,
					"content": "くそっ…こんなことなら、パッカにキッズコーナーにでも入れてもらったほうがマシだったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280103
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280104
					]
				},
				{
					"id": 250280104,
					"content": "#あんたは…{NICKNAME}か！良かった、来てくれたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280105
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280105,
					"content": "すごく大事なことを頼みたいんだ！ナタの…いや、世界のポップスの未来が！あんたの救いの手を待ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280106,
						250280107
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280106,
					"content": "お、落ち着いて話して！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280109
					]
				},
				{
					"id": 250280109,
					"content": "急いで俺のレコードを救出してほしいんだ！じゃないとあのコホラ仔竜たちに全部食われちまうか…音楽のことも分からないやつに粉々にされちまう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280107,
					"content": "えっ？どうして歌が得意だって分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280108
					]
				},
				{
					"id": 250280108,
					"content": "えっ…と…あんたが歌が得意だって分かって俺もうれしいよ、そのうちコラボできるかもな…でも今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280109
					],
					"speakerTitle": "ミル·ヌイ"
				}
			]
		},
		{
			"id": 2502802,
			"completionStepIds": [
				2502807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502807",
							"2"
						],
						"stepId": 2502807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2502802",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ミル·ヌイ",
					"リロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250280201,
					"content": "よし、リロの兄貴。今日の俺たちの目標はあいつらだ。しっかり準備しといてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280202
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280202,
					"content": "問題ない、準備できてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280203,
						250280204
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280203,
					"content": "またアルバム作り？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				},
				{
					"id": 250280205,
					"content": "やあ、ここであんたに会えるとはな。ああ、そうさ。俺たちは新曲のために素材集めをしてるところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280206
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280206,
					"content": "前回のことがあってから、俺とリロの兄貴でアルバムについてよく話し合ったんだ。ものすごく刺激を受けたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280207
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280207,
					"content": "それは大げさだよ。僕はただ、ミル·ヌイさんに方法を変えるか、でなければ他の素材を探して音楽を作ることを提案しただけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280208
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280208,
					"content": "僕が以前聴いた部族の音楽には、武器のぶつかり合う音、戦闘の時の雄叫び、人々の駆け回る足音までもが曲に取り入れられていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280209
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280209,
					"content": "そうやって作られた曲は受け入れられやすいし、あっという間に話題になる…僕が思うに、それこそがミル·ヌイさんの求めていた「ポップスの感覚」なんじゃないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280210
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280210,
					"content": "その通り！だから俺たちは戦士を探して、彼らの戦う姿をよく観察しようと思ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280211
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280211,
					"content": "じゃあ、素材集めの対象は見つかったんだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280212
					]
				},
				{
					"id": 250280212,
					"content": "ああ！今まさにあそこに見えてる人たちさ。部族の人から聞いたんだけど、彼らはいつも外で戦闘の相手を探していて、腕も立つらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280213
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280213,
					"content": "そう。つまり簡単に言うと、彼らは一日中外で問題を起こしては、手当たり次第にケンカをふっかけてるというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280214
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280214,
					"content": "彼らに負ければ、その代償として身ぐるみ剥がされることになるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280215
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280215,
					"content": "俺のミュージシャン仲間も何人か、あいつらにカツアゲされたんだ…ほんっと許せないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280216
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280216,
					"content": "ああ。部族の人たちも、さすがにもう見て見ぬふりできないみたいで、彼らにお灸を据えてくれる人を探しているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280217
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280217,
					"content": "まともな人たちだとは思えないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280218
					]
				},
				{
					"id": 250280218,
					"content": "向こうが何考えてるかなんて誰にも分からないだろ？正直、俺にはああいう連中の考えはまったく理解できないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280219
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280219,
					"content": "もしあんたが嫌じゃなければ、リロの兄貴と一緒にあいつらを懲らしめてやってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280220
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280220,
					"content": "あんたの実力はもう知ってるからな。あんたが戦ってるところを見たら、もっとたくさんのインスピレーションが湧きそうなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280221
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280221,
					"content": "あっ、でも…これだけは注意してくれよ！もしあいつらがレコードを持ってたら、割らないようにしてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280222
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280222,
					"content": "でないと俺のミュージシャン仲間たちが、また気絶しちまうからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280223,
						250280224
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280223,
					"content": "分かった。そこで見てて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280225,
					"content": "おお！はははっ、良かったよ。あんたが協力してくれれば、きっと最高の曲が作れる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280224,
					"content": "#{M#俺}{F#私}の実力を見せてあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280225
					]
				},
				{
					"id": 250280204,
					"content": "音響素材を集めてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280205
					]
				}
			]
		},
		{
			"id": 2502803,
