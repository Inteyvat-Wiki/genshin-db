			"dialogs": [
				{
					"id": 250280501,
					"content": "俺のレコード！よかったよ、レコードが無事で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280502
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280502,
					"content": "すまなかった、ミル·ヌイさん。僕の仲間が君のレコードを奪っていったんだ。代わりに謝らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280503
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280503,
					"content": "レコードが無事でよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280504
					]
				},
				{
					"id": 250280504,
					"content": "ふぅ…言う通りだよ。これは原盤だからな。もし割れたりでもしたら崖から飛び降りたくなるだろうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280505
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280505,
					"content": "…リロの兄貴、あんたも頭を上げてくれ。レコードは無事だったんだし、俺も細かいことは気にしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280506
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280506,
					"content": "一つだけ質問に答えてくれたら、今日のことは帳消しにするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280507
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280507,
					"content": "僕に答えられることなら何でも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280508
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280508,
					"content": "俺の音楽を聴いて、いいと思ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280509
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280509,
					"content": "子どもや竜の赤ちゃんが気に入るような「良さ」じゃなくて、いわゆる…流行りの曲の「良さ」のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280510
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280510,
					"content": "分かるか？このアルバムを聴いて、そういう感じはしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280511
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280511,
					"content": "流行りの感覚？ええと…ちょっと待ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280512
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280512,
					"content": "あんたらの部族が竜の赤ちゃんにレコードを奪わせたのは、収録されてる曲が流行りに乗ってて気に入ったから。違うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280513
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280513,
					"content": "ええと、説明してもいいかい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280514
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280514,
					"content": "僕らはそもそも…竜の赤ちゃんに君のレコードを奪うよう「指示」していない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280515
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280515,
					"content": "彼らは君のアルバムの曲に魅かれて、自分から走っていったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280516
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280516,
					"content": "なんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280517
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280517,
					"content": "君の曲は素晴らしいよ！信じてくれ。僕が君のレコードを再生するたび、竜の赤ちゃんたちがはしゃいで僕らを取り囲んで走り回り、大喜びするんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280518
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280518,
					"content": "なんだと？くそっ…俺のアルバムは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280519
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280519,
					"content": "君の気持ちは分かる。そこまで貴重なレコードが危険な目に遭ったんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280520
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280520,
					"content": "でも僕は、君が新しいアルバムを発表するまで無償で君の護衛をしようと思うんだ！もう誰にも君のレコードを奪わせはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280521
					],
					"speakerTitle": "リロ"
				},
				{
					"id": 250280521,
					"content": "俺のアルバムは！童謡とかじゃねえんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				}
			]
		},
