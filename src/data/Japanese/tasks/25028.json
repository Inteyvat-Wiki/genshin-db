			},
			"dialogs": [
				{
					"id": 250280801,
					"content": "俺のレコード、取り返してきてくれたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280802
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280802,
					"content": "どうしてレコードが盗まれたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280803
					]
				},
				{
					"id": 250280803,
					"content": "ああ、話すと長くなるんだが…俺、最近新曲を出したばっかなんだよ。春と動物を讃えるって感じのテーマでな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280804
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280804,
					"content": "そしたらパッカのやつ、俺の新曲を聴いたあと、それをまたキッズコーナーに置きやがったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280805
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280805,
					"content": "しかも、「こういう面白みがあってシンプルなメロディーは、子どもたちや竜の赤ちゃんたちが絶対に気に入るはずだ」とか言いやがって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280806
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280806,
					"content": "ちくしょう！俺の作品はれっきとしたポップスで、子ども向けの音楽じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280807
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280807,
					"content": "それで腹が立って、俺はレコードを持ってここへ来たんだ。自分の音楽を自分で楽しもうと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280808
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280808,
					"content": "それで…聴いてたら、コホラ仔竜の群れがどんどん集まってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280809
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280809,
					"content": "あっけに取られてるうちに、そいつらが一斉にやってきて俺のレコードをくわえて逃げちまったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280810
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280810,
					"content": "俺は追いかけようとしたんだが、その途中で見るからに荒っぽい連中が集まってるのを見かけてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280811
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280811,
					"content": "ひょっとしたら、あいつらが俺のレコードをコホラ仔竜に奪わせたのかも。俺の音楽を横取りしようと狙ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280812
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280812,
					"content": "うわああっ…とにかく！冒険者、このミル·ヌイのお願いだ。急いで俺のレコードを取り返してきてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280813
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280813,
					"content": "も、もし可能なら…レコードに傷が付かないようにしてほしいんだ。じゃないと俺の今までの努力が…全部水の泡になっちまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				}
			]
		},
