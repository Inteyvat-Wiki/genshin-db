			"dialogs": [
				{
					"id": 250280401,
					"content": "すごいな！二人の勇ましい戦いぶりがすごく印象的だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280402
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280402,
					"content": "力強さだけじゃなくて、すごくリズム感があったな。まるでタクトを振って戦場を指揮してるみたいだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280403
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280403,
					"content": "何より…レコードも無傷だ！ありがとう。これで俺の友人たちもようやく枕を高くして眠れるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280404
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280404,
					"content": "ん、待てよ…リズム？そうか、俺が求めるべきはこういうリズム感だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280405
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280405,
					"content": "このリズムをメロディーのベースにして…いや、もっとヘビーな音の楽器を選ぶべきか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280406
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280406,
					"content": "これをやるよ。受け取ってくれ！リロの兄貴、急いで集落に帰ろう。ひらめいたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280407
					],
					"speakerTitle": "ミル·ヌイ"
				},
				{
					"id": 250280407,
					"content": "ああっ、このリズムをどこかにメモしておかないと…そうだ、服！服にメモしておこう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミル·ヌイ"
				}
			]
		},
