				]
			},
			"dialogs": [
				{
					"id": 706840101,
					"content": "こ、こんにちは！わ、私は…サンサ。吟遊詩人を目指してるの。きょ…今日は私の演奏を聴きに来てくれて、ありがとう。そ、それじゃあ、始めるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840102
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840102,
					"content": "「星拾いの崖の頂上は、一切が静まりかえっている。ど、ど、どの梢にも…」あっ…またやっちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840103
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840103,
					"content": "「どの梢にも、小鳥の姿は見えず、風の音もき、聞こえない…」次は、えっと…「あ、足を止めてひと休みしよう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840104
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840104,
					"content": "うまく歌えなくてごめんなさい…四十二回目と九十回目はどもらなかったのに、なんでダメだったんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840105
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840105,
					"content": "四十二回目と九十回目…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840106,
					"content": "うん！みんなに完璧な演奏を聴いてもらいたくて、百回練習したんだよ。だから、今ので百一回目。今日が初めての公演だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840107
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840107,
					"content": "はぁ、うまくいくと思ったのに…準備が足りなかったのかも。四十二回目や九十回目と何が違ったのかよく振り返って、もっともっと練習しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840108,
						706840109
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840108,
					"content": "百回だって十分多いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840110
					]
				},
				{
					"id": 706840110,
					"content": "そうそう！そんなに練習したのに、さっきみたいになっちゃうってことは…練習の仕方に問題があるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840111,
					"content": "実は、こいつもそこそこ演奏できるんだ。いつもどうやって練習してるか教えてくれないか？なにかアドバイスできるかもしれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840112,
						706840113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840112,
					"content": "少しかじった程度だけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840114
					]
				},
				{
					"id": 706840114,
					"content": "そしてオイラは…プロの観客だ！観客の目線でプロフェッショナルなアドバイスをしてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840115,
					"content": "うぅ…私なんかのために…本当にありがとう！ノートに書いてあるから、ちょっと待っててね！あ、直接見せたほうが早いかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840116
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840116,
					"content": "ん？ノート？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840117,
					"content": "練習するときはいつもメモを取ってるの。注意点とか直したほうがいいところとかね…あ、後ろのページにあるのは他の人の演奏を聴いたり、他の楽器を試したりしたときの感想だから、あまり気にしないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840118
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840118,
					"content": "表紙のくたびれたノートには、サンサの言った通り、練習時のメモが書き込まれている。後半の「感想」はさらに膨大で、むしろ論文のようになっていた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						706840119
					]
				},
				{
					"id": 706840119,
					"content": "うわっ、モンドの図書館にある百科事典より分厚いぞ！サンサって音楽の研究家とかコレクターなのか？いや、もしかして図書館司書？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840120,
					"content": "えへへっ、両親は私に学者になってほしいみたい。それで、こんな勉強方法を身につけさせられたんだ。今は…吟遊詩人になるために活用してるけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840121
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840121,
					"content": "何か間違ってるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840122
					]
				},
				{
					"id": 706840122,
					"content": "先生、どこが良くないと思う？音楽への理解？それとも練習の仕方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840123,
						706840124
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840123,
					"content": "#{M#俺}{F#私}の知識じゃ指導役は無理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840125
					]
				},
				{
					"id": 706840125,
					"content": "その…吟遊詩人になるのってそんなに難しいことなのか？うーん…吟遊野郎が演奏してるときって、いつも緊張とは無縁って感じがしてるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840126,
					"content": "でも、楽器も歌もうまいってことは、やっぱり見えないところで努力してるのかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840127,
					"content": "ヤッホー、旅人。もしかしてボクを探してる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840128
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840128,
					"content": "ウェ、ウェンティさま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840129
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840129,
					"content": "うわっ！ビ、ビックリしたぞ！なんでここにいるんだ、吟遊野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840130,
					"content": "今日はまた、どういう風の吹き回し？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840131
					]
				},
				{
					"id": 706840131,
					"content": "それはもちろん、異郷の花の香りと想いをたっぷり乗せた「風」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840132
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840132,
					"content": "また適当なこと言ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840133,
					"content": "ヘヘッ、さっき散歩してたら、アイデアが降ってきたんだ。木から落ちたリンゴが頭にぶつかるみたいにね。だから、頭に浮かんだ詩を葉っぱに書いてたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840134
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840134,
					"content": "まだ書き終わってないのに「ヒュー」って音がしてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840135
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840135,
					"content": "「ヒュー」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840136
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840136,
					"content": "やんちゃな風がボクの最初の読者になりたいって、葉っぱを持って行っちゃったんだ。追いかけようとすると、今度は黒い影が目の前に出てきて、葉っぱをくわえて行っちゃってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840137
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840137,
					"content": "おかげでくしゃみを何度もしたよ…そうしてる間に二番目の読者はあっという間にどこかへ行っちゃってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840138
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840138,
					"content": "うぅ…思い出すだけで鼻がムズムズしてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840139
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840139,
					"content": "うーん、葉っぱをくわえて逃げたのって、もしかして猫か？おまえ一人で猫を捕まえるのは無理だと思うぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840140,
						706840141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840140,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840142
					]
				},
				{
					"id": 706840142,
					"content": "私にも手伝わせて！ウェンティさまの歌と演奏にずっと憧れてたの！もしお力になれるならすっごく嬉しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840143
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840143,
					"content": "そ、その…もし新作を取り戻せたら、詩の書き方についていくつか聞いてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840144
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840144,
					"content": "ごめんなさい！急なお願いだってことは分かってるけど今言わないと言う勇気すらなくなっちゃうと思って！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840145
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840145,
					"content": "あははっ、もちろんいいよ。目の前に立ちふさがる壁は葉脈みたいなもので、インスピレーションっていう養分を運んできてくれるんだ。養分が届いたら、すぐに捕まえておかないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840146
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840146,
					"content": "何でも聞いて。全部答えてあげる。今からでもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840147
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840147,
					"content": "ほ、ほんとに！？ノート、ノート…どこやったっけ？あっ、あった…！ちょっと待ってて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840148
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840148,
					"content": "サンサは素早くページをめくって「質問」の箇所を開くと、深く息を吸い込み、これまでの勉強や練習のこと、ぶつかった問題について話し始めた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						706840149
					]
				},
				{
					"id": 706840149,
					"content": "なるほど…聞いた感じじゃ、理論、実践の両方とも十分だと思うよ。ボクのアドバイスなんてなくても平気なんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840150
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840150,
					"content": "でも、どんだけ頑張っても公演がうまくいかないんだぞ？なにか原因があるはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840151,
					"content": "きっと才能がないんだよ…私、吟遊詩人に向いてないのかもね。あはは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840152
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840152,
					"content": "君はどうして吟遊詩人になろうと思ったんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840153
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840153,
					"content": "どうして…憧れてたから、かな。昔、両親の言いつけで部屋にこもって勉強してたの。その時、窓の外から吟遊詩人の歌声が聞こえてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840154
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840154,
					"content": "美しい歌声とメロディーはそよ風みたいに心を満たしてくれた…吟遊詩人になったら、私もあの人みたいになれるかなって思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840155
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840155,
					"content": "あんな風に自由に、楽しく生きてみたい。それでその喜びをみんなと分かち合えたらって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840156
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840156,
					"content": "でも、いざみんなの前に立つとどうしようもなく緊張しちゃって。失敗しないようにたくさん練習したのに、本番になるとどもっちゃうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840157
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840157,
					"content": "君は立派な詩人だと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840158
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840158,
					"content": "えっ？で、でも私…歌も満足に歌えないのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840159
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840159,
					"content": "さっき、自由に楽しく生きるために吟遊詩人になりたいって言ったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840160
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840160,
					"content": "吟遊詩人の歌声っていうのはね、風のように、何かに縛られることなく、どこまでも響くものなんだ。じゃないと、君があの日部屋でその歌声を聞くこともなかったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840161
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840161,
					"content": "君は立派な詩人だよ。ただ…雑音もたくさん聞こえちゃうせいで、発想が縛られて、動けなくなってるんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840162
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840162,
					"content": "人の目は気にしなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840163
					]
				},
				{
					"id": 706840163,
					"content": "そうそう。自由と喜びを分かち合いたいなら、まずサンサがそうならなきゃな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840164,
					"content": "おや、パイモン、吟遊詩人の素質があるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840165
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840165,
					"content": "まずは自分に自由と喜びを…そうだね、ありがとう！今教えてもらったこと、ずっと大切にするね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840166
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840166,
					"content": "じゃあ、さっそく試してみようか？せっかくだし、ボクと旅人が楽器を担当するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840167
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840167,
					"content": "喜んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840168
					]
				},
				{
					"id": 706840168,
					"content": "それじゃ、オイラは観客な。一番自由でプロフェッショナルな観客だ！へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840169,
					"content": "ひ、ひ、人前で初めてうまく歌えた…あっ、今のは緊張じゃなくて嬉しかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840170
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840170,
					"content": "演奏してるとき、私もそよ風になってどこまででも行けるような気がしたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840171
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840171,
					"content": "おまえの気持ちはみんなにも伝わったと思うぜ。あっ、猫もサンサの歌を聞きに来たぞ！ん？猫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840172
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840172,
					"content": "おや、ボクの新作を二番目に読んだ子だね？ぜひ感想を聞かせてく…は…は…はっくしょん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840173
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840173,
					"content": "クロ！ごめんなさい。お隣さんが飼ってる子で、練習のときによく窓のところに飛び乗って観客になってくれるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840174
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840174,
					"content": "ニャオー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840175
					],
					"speakerTitle": "「クロ」"
				},
				{
					"id": 706840175,
					"content": "クロがくわえてるそれって、詩が書かれてる葉っぱか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840176,
					"content": "それはウェンティさまにとって大事なものなの。返してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840177
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840177,
					"content": "ニャ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840178
					],
					"speakerTitle": "「クロ」"
				},
				{
					"id": 706840178,
					"content": "いろいろアドバイスをもらったのに、全然お返しできなくて、ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840179
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840179,
					"content": "いいや、君のおかげで「アイデア」を取り戻せた。これで十分…は…はっくしょん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840180,
						706840181
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840180,
					"content": "感想を聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840182
					]
				},
				{
					"id": 706840182,
					"content": "ニャオ～。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840183
					],
					"speakerTitle": "「クロ」"
				},
				{
					"id": 706840183,
					"content": "おや、ボクの詩が気に入ったのかい？あ、近づかないで…はっくしょん！まだ出来上がってないから、完成を楽しみにしててね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840184
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840184,
					"content": "コホン、熱心な読者だね…それじゃみんな、今度ボクの歌を聴きに来てね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840185
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 706840185,
					"content": "まったく帰るときも風みたいなやつだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840186
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840186,
					"content": "ウェンティさま直々の指導が受けられるなんて…今度お礼をしなくちゃ…二人も本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840187
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840187,
					"content": "ほんの気持ちだけど、よかったらこれを受け取って。私がいろんなところで集めた楽譜をまとめたものなの。いつか役に立つかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840188
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840188,
					"content": "あと、楽器も色々集めてるんだ！もし弾いてみたくなったら、いつでも私のところに来てね。演奏についてもおしゃべりしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840189
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840189,
					"content": "へへっ！じゃあ、ありがたく受け取るぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706840181,
					"content": "この詩は好き？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840182
					]
				},
				{
					"id": 706840141,
					"content": "猫に新作の感想も聞きたいし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840142
					]
				},
				{
					"id": 706840124,
					"content": "努力の方向性の問題かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840125
					]
				},
				{
					"id": 706840113,
					"content": "意見交換する感じで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840114
					]
				},
				{
					"id": 706840109,
					"content": "回数の問題じゃないかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840110
					]
				}
			]
		},
		{
