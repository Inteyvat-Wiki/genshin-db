					"content": "これ、楽譜をまとめたものなの。よかったら受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706840202
					],
					"speakerTitle": "サンサ"
				},
				{
					"id": 706840202,
					"content": "（楽譜集を受け取る）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706840203
					]
				},
				{
					"id": 706840203,
					"content": "もしほかの楽器も弾いてみたくなったら、いつでも私のところに来てね。",
					"roleType": "TALK_ROLE_NPC",
