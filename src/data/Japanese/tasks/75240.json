					"nextDialogs": [
						752400109
					],
					"speakerTitle": "ナワトラリ"
				},
				{
					"id": 752400109,
					"content": "アヤールって何者なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "残念だけど、ここで質問する資格があるのはチャンピオンだけなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "ナワトラリ"
				},
				{
					"id": 752400111,
					"content": "ステージに上がって君の実力を見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナワトラリ"
				}
			]
