			"trigger": {
				"objectNames": [
					"アンソニー",
					"アナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "アナ、もう少し考えてくれ。このことは、もっとじっくり考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140102,
					"content": "もう、そんなに心配しないで。私なら大丈夫だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140103,
					"content": "アナ、体は大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "旅人！ちょうどよかった、一緒にアナを説得してくれ。アナが…冒険者になるって言って聞かないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140106,
					"content": "どうして冒険者になっちゃいけないの？私はもう健康だし、サイリュスさんからも頭がいいから冒険者に向いてるって言われたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140107,
					"content": "まだ病気が治って間もないじゃないか。冒険者になって、もしまた病気になったらどうするんだ？それに、父さんと母さんもきっと同意しないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140108,
					"content": "もうお父さんとお母さんにも言ったわ。冒険者協会の試験に合格できれば、冒険者になってもいいって言われたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140109,
					"content": "え…えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140110,
					"content": "落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "この前サイリュスさんが訓練計画を立ててくれたんだけど、もう何日もそれをやってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140113,
					"content": "でも、それはほとんどが偵察とか、非常食の探索とか、野外サバイバルとかで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140114,
					"content": "聞いた話なんだけど、冒険者っていつも野外で魔物と戦うんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140115,
					"content": "だからそういうことも勉強したいんだけど、教えてくれる人がいなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140116,
					"content": "それに、お兄ちゃんも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140117,
					"content": "ダメに決まってるだろ！魔物なんて危険すぎる！行くにしたって、経験豊富な冒険者について来てもらうんじゃなきゃ駄目だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140118,
					"content": "だからジャックに声をかけたじゃない？もういい返事をもらってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140119,
					"content": "俺はジャックのことをよく知ってる…あいつは自分のことすらままならないのに、アナを守れるはずがないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140120,
					"content": "でも、きっと協会も経験豊富な冒険者をすぐには見つけられないし、私だってそんな依頼を出すお金なんかないもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140121,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が一緒に行こうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "えっ？手伝ってくれるの？やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140124,
					"content": "お兄ちゃん！これで安心したでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140125,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140126,
					"content": "#はぁ…しょうがない。旅人の実力は俺も知ってるからね。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}が一緒なら、少しは安心だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140127,
					"content": "だけど！野外に行くときは、くれぐれも安全に気を付けるんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140128,
					"content": "…それだけは覚えておくんだ、分かったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200140129,
					"content": "わかったわかった…お兄ちゃんってば、耳にタコができちゃうよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140130,
					"content": "旅人さん、早く行きましょう。拠点の位置は、すでにジャックから聞いてあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140122,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は戦闘が得意だけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "どれくらい訓練したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "アンソニー、何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
