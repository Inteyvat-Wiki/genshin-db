			"dialogs": [
				{
					"id": 200140201,
					"content": "魔物を全部倒すなんて！あなたって、本当にすごいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140202,
					"content": "冒険ガイドに書いてあった通りだ…魔物を倒すには、色んな方法があるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140203,
					"content": "でも…正直、魔物にここまで近づくのはやっぱりちょっと怖いね…あなたがいてくれてよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140204,
					"content": "もっと訓練しないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "ええ、わかってるわ。冒険者になるのは、簡単なことじゃないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140206,
					"content": "旅人さん、私は先に城内に帰るね。こんなに長く外にいたら、またお兄ちゃんが心配するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200140207,
					"content": "これからもっと訓練、頑張らなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				}
			]
		},
