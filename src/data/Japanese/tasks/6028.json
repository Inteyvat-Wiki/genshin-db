			"dialogs": [
				{
					"id": 60280301,
					"content": "どうだ？傷口は痛むか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280302,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "使えそうな薬を用意してもらった。必要なら飲むといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60280304,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "あのあと、アリスさんとこんな通話をしたんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280307,
					"content": "ドットーレのやつ…魔女会の意識をよそに向けるために、テイワットの境界で大きな騒ぎを起こしたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280308,
					"content": "私はてっきり、世界の外から来たアビスの力がまたテイワットに干渉してるのかと思ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280309,
					"content": "でも、ドゥリンちゃんたちがナド・クライの虚影に干渉できたことを知って、それがテイワットの内側から来たものだって気づいたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280310,
					"content": "それでも結局、ボクたちは虚影の運命を変えられなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280311,
					"content": "たしかに、あなたたちはあの虚影の結末を変えられなかったけど、ある「変数」があなたに蓄積されたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280312,
					"content": "「変数」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "そう。たとえば、本来は知るはずもなかった情報を手に入れたり、普段は思いつかない考えが湧いたりすることも「変数」の一種なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280314,
					"content": "もちろん、無数の可能性を前にしたら、それは些細なものかもしれない。でも意図的に「変数」を積み重ねれば、話は変わってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280315,
					"content": "その大量の「変数」が、この夜、旅人たちが転移の扉を開けたときに、ドットーレが陰謀を実行するための必要な条件になっていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 60280316,
					"content": "けれど、ドットーレがいったい何をしたのかは、あたしたちにも分からないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 60280317,
					"content": "ああ。俺たちはコロンビーナの現状を把握する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280318,
					"content": "——こんな話をしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280319,
					"content": "ドットーレは姿を消したが、少なくともコロンビーナは彼の手中に落ちていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280320,
					"content": "状況はみんなが思ってるより悪いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280322,
					"content": "彼女は「博士」の計画を阻止するために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280325,
					"content": "飛び込んだところを誰も見てないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "オイラたちは「博士」がなにか力を使ったあと、コロンビーナと同時に消えたところしか見てないぞ。あと、おまえが空から海に落っこちてくるところだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280327,
					"content": "#（そっか…「博士」が時間を止めたとき、{M#俺}{F#私}だけが自由に動けてたから——）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "（みんなにとって、あの戦いとコロンビーナの決断は一瞬のことでしかないんだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "#（あれが「三つの月」の権能…？{M#俺}{F#私}が影響を受けなかったのは…「降臨者」だから？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "つまり、コロンビーナは自ら「月の扉」を開き、レリルとソリンディスがかつて足を踏み入れた謎の空間に落ちた…ってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60280331,
					"content": "厄介なことになったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280332,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280333,
					"content": "ドットーレがずっと姿を見せなかったのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "ということは「三月の出現」も、月の狩人の出現も…ドットーレが裏で操っていたということだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60280336,
					"content": "アリスさんの話によると、彼は自分の運命を超えて、神にしか成し得ない実験をしようとしているらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60280337,
					"content": "…狂気の沙汰としか言いようがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280338,
					"content": "そういえば、笠っちはどこいったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280339,
					"content": "アリスさんと連絡を取った後、心当たりがあるって言って、ドド通話機を持って一人で調査に出かけたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280340,
					"content": "出かけるとき、すごく怖い顔をしてた…笠っちがあんな顔してるところ、ボクは見たことない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280341,
					"content": "（怒りと悔しさのせいかな。ドットーレを十二分に警戒してたのに、結局いいようにやられてしまったから。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "#（そういう意味では、{M#俺}{F#私}も同じだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "戻ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "笠っち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280345,
					"content": "ヒュペルボレイアの虚影ともう一度話して、ようやくはっきりした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "あいつらに、通話機の向こうにいるニコと歴史の解釈が一致しているか試させたんだ。そしたら、案の定あいつらの語る歴史は、ニコの記憶と違っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "どうなってんだ？ニコが間違って覚えてるわけないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280348,
					"content": "あの虚影たちが騙されているからさ。あいつらの歴史には、存在しないはずの救世主がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "その救世主は、そいつらのために偽りの空に新たな月を作り、月神を連れ帰ると約束した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "そしてやつらは愚かなことに、救世主が必要とする月に関する知識を、すべて洗いざらい教えてしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "明らかにドットーレの仕業だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "ヒュペルボレイアの遺跡で、虚影が歴史について語るのを聞いたが、ニコさんはその中に誤りがあると言っておった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280353,
					"content": "でも、ドットーレはあの扉の中に入れないはずだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280354,
					"content": "そう、あいつは中に入っていない。ニコが言うには、これは同じ時代の虚影の因果に干渉したことで引き起こされた異常事態らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "つまりドットーレが積み重ねた「変数」は、あいつと会ったことのない虚影にも影響を与えられるほど巨大なものなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "記憶違いじゃなく、改ざんされていたってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60280357,
					"content": "これこそドットーレがあらゆる手段を使って築き上げた「可能性」だ。あいつは変数を知識に変え、その身に積み重ねた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "そして、祈月の夜の当日…あいつはその知識を使って、本当に「偽物の月」を作り出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "そんなことできるもんなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280360,
					"content": "正確には月そのものを作ったんじゃなく、術式の感知を騙したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "術式はクーヴァキで月の位置を感知する。「偽物の月」が天外の霜月よりもさらに月らしいものであれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "ゲートはコロンビーナを「偽物の月」に送る——つまり、ドットーレの元に送るんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "ドットーレがコロンビーナを制御下に置いた後も、転送の術は維持されたままだった。そしてあいつは少女の力を操り、二つの月髄を奪ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "あの時、月髄は私たちの目の前で忽然と消えた…遺跡を出たときにはもう手遅れであった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280365,
					"content": "そうして、ドットーレは三つの月の力をすべて集めたのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280366,
					"content": "オイラたち…これからどうすればいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280367,
					"content": "前に女皇陛下に伝えた懸念がやはり現実のものとなったか。陛下の判断を仰ぎたいところだが、それをただ待つだけでは遅い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280368,
					"content": "私たちを友人と見なしてくれたのは、ファデュイ執行官の「少女」ではなく、コロンビーナ・ハイポセレニアだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280369,
					"content": "このような一刻を争う状況で、女皇陛下がなおも執行官同士の戦いを禁じるというのなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280370,
					"content": "私は自身の心に従い、「ペルヴェーレ」として戦おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280371,
					"content": "アルレッキーノ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280372,
					"content": "時間が惜しい。先に失礼させていただく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280373,
					"content": "アルレッキーノも冷静でいられなくなってるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280374,
					"content": "#（こうなったのは、自分の責任だと思ってるのかも。それは{M#俺}{F#私}も同じだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280377,
					"content": "おいおい、揃いも揃ってそんな暗くなってどうする。いいか、一つ言っておきたいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280378,
					"content": "たしかに事態は最悪だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280379,
					"content": "ドットーレは騎士なら誰もが忌み嫌うような方法で、一時的な勝利を掴んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280380,
					"content": "魔女ですら、あいつが「変数」を使って運命を変えたって言う。はっはっは、だがな、俺はそう思っちゃいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280381,
					"content": "テイワットの運命は決まってると、いろんな人から聞いてきた。それは確かに事実らしい。だが、どうしてドットーレの運命だけが特別だって言える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280382,
					"content": "あいつが「変数」を積み重ねられるなら、俺たちにだってできるはずだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280383,
					"content": "お前までそんな落ち込んでどうする——遠路はるばる訪れた旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280384,
					"content": "まだ終わっちゃいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280385,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "お前は一人じゃない。ここにいる全員が自分を責めてる。しゃべってるやつも、黙ってるやつもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280388,
					"content": "だが、そのまま肘掛椅子に座って日向ぼっこできるようなやつは、この中にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280389,
					"content": "倒れてもすぐに立ち上がる。これぞ騎士道だ！栄誉騎士、お前は立派なモンドの騎士だろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280390,
					"content": "うん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "ファルカの言う通りだ！まだ終わってないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280392,
					"content": "ドットーレをボコボコにしてやろうぜ！今まで受けた仕打ちをまとめて返してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280393,
					"content": "その意気だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280394,
					"content": "他のやつらはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280395,
					"content": "私はクーヴァキでコロンビーナさんの行方を調べよう。ここで諦めるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280396,
					"content": "ナド・クライで起きたことなら、秘聞の館はなんだって知れる。情報の提供は任しとくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60280397,
					"content": "カチャカチャ・クルムカケ工房も全力で支援します。私とアイノは、ドットーレの今回の作戦を分析して、突破口を調べるつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "イネファ"
				},
				{
					"id": 60280398,
					"content": "アリスさんとニコさんは、テイワットの境界で突然起きた災害を解決しないといけないから、しばらく帰ってこれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280399,
					"content": "二人ともすごく怒ってたよ。ボクとアルベドは魔女会の代理人として、ドットーレに対抗するよう言いつけられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280401,
					"content": "準備はいいかい？いろいろと調査が必要だ。さっそく行動に移ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60280402,
					"content": "頑張るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60280403,
					"content": "僕はドットーレの手口を知っているから、彼の次の行動を予測してみよう。調査も手伝うつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "よし、一応の役割分担は決まったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280405,
					"content": "俺はフリンズとイルーガに連絡して、ライトキーパーに味方になってもらえるよう、マスター・ライトキーパーを説得してほしいと伝える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280406,
					"content": "同時に、ナド・クライの西風騎士にも指示を出す。ライトキーパーや他の組織と連携して、ここの住民の安全を守ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280407,
						60280408
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280407,
					"content": "わかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280409,
					"content": "そうだそうだ！どんとこい、だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280410,
					"content": "よし。いっちょ気合い入れていくぞ、お前ら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 60280408,
					"content": "すべてを迎え撃つ準備を進めよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280386,
					"content": "自分を責めないと、許せそうになくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280334,
					"content": "この計画を準備するためだったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280323,
					"content": "「月の影」に飛び込んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280305,
					"content": "今すぐこれからのことを話そう…",
