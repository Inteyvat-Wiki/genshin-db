			"dialogs": [
				{
					"id": 60280201,
					"content": "ここが…ヒュペルボレイア時代、人々が「月」と交信していた場所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280202,
					"content": "恒月、霜月、虹月…三つの月の力が集まる時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280203,
					"content": "月への扉が開く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280204,
					"content": "ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280205,
					"content": "月髄の準備はできた。あとは最後の一歩を踏み出すだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280206,
					"content": "今はナシャタウンがいちばん賑やかになってる時だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280207,
					"content": "そうだな。おまえもあの賑わいを楽しみたかったと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60280208,
					"content": "大丈夫だよ。最後の…そして唯一の荷物を持っていけるから、私は満足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280210,
					"content": "月からの呼びかけを感じる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280212,
					"content": "コロンビーナ、君の家はあの光の向こうにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 60280213,
					"content": "これでようやく、本当の月に祈る理由ができるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60280214,
					"content": "コロンビーナ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280216,
					"content": "もし機会があったら、またみんなの様子を見に帰ってきてね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "ふふっ、もちろんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280218,
					"content": "この星にはコロンビーナを想ってる友達がいることを忘れないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "うん、忘れないよ。みんな、私のためにいろいろしてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280220,
					"content": "あと、これも覚えておいてほしいな———「昼も夜も、月光が我らを結ばん」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60280221,
					"content": "ふぅ…じゃあ…さようなら、みんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
