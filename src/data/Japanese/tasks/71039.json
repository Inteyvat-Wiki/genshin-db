			"dialogs": [
				{
					"id": 710390101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390102,
					"content": "こんにちは、瑾武姉さん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390105,
					"content": "うわっ、びっくりするじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710390106,
					"content": "わ、悪い…その、志璇を探してるのなら…あいにくだが、彼女はもう隊を離れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390107,
					"content": "どこに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "分からない…少し目を離した隙に、いなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390112,
					"content": "彼女と話をしたが…考えを変える気はないみたいだったよ。どんなことを言っても、たとえ拳を使っても説得できなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390113,
					"content": "はぁ…自分が何をしようとしてるのか、ちゃんと分かっていればいいんだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390114,
					"content": "そう願うしかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390115,
					"content": "そうだ、このことは沐寧にも言っておかないと。一刻も早く救助隊を立ち上げて、あの子を探す！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390116,
					"content": "すぐに行く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "まったくもう…志璇がまたいなくなるなんて！はやく地上の沐寧に知らせないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710390117,
					"content": "安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "離れた時、体調はどうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390111,
					"content": "ヘディーヴの検査によれば、あまりよくないらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710390103,
					"content": "元気？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "ん？志璇は一緒じゃないのか？総務司からの推薦状が下りたことを伝えようと思ったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390202,
					"content": "彼女の作った地図が輝山庁の役に立ってね。総務司も彼女を…えっと、どれどれ…顧問案内役として、正式な職位で迎えるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390203,
					"content": "本当にめでたいことだよ。あんなに走り回ったのも、無駄じゃなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390204,
					"content": "彼女ならもうやめた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "やめた？それってどういう…？ここを離れたという意味か？だが、層岩巨淵を離れた人がいるなんて情報、千岩軍から聞かされていないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390206,
					"content": "志璇は探検隊をやめた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "えっ？そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390208,
					"content": "いや、待て！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390209,
					"content": "いやいや…か、彼女が探検隊をやめたって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390210,
					"content": "志璇が？やめた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390211,
					"content": "だからそう言ってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710390212,
					"content": "…そうか、直ちに救助隊を手配しよう。まだ層岩巨淵にいるのなら、彼女を見つけられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390213,
					"content": "理由がどうあれ…まずは彼女を見つけるのが先決だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390214,
					"content": "彼女の今の状態からして、隊を離脱したのは完全に無茶な行動だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390215,
					"content": "手伝いはいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "すまないが、今回は必要ない…俺もたまには自分で解決しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390233,
					"content": "手伝いが必要なら、すぐに駆けつける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "おう、オイラもだ！後輩を放ってはおけないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710390235,
					"content": "オイラたちも気にかけておこうぜ。どこかで偶然見つかるかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710390217,
					"content": "志璇について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "あんなやつだが、それでも大事な友人だ。俺が人に好かれるような性質じゃないのは分かってるが…それでも、友人のことを忘れるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390219,
					"content": "あいつはいつも冒険者を夢見ていて、以前も何度か大怪我をした…命をも落とすところだった。やっと落ち着いたかと思いきや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390220,
					"content": "もうあの無茶な夢は忘れたと思っていたのに…ロアルドやスタンレーになるなんて、そう簡単にいくわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390221,
					"content": "でもまさか…はぁ…今回はあんたを層岩巨淵に招くべきじゃなかった。また志璇のやる気にスイッチが入ってしまうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390222,
					"content": "でも彼女の努力は無駄じゃなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "無駄じゃない…？それはちょっと功利的すぎる言い方だな。地下の地図を描いてくれた彼女には感謝している…だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390224,
					"content": "「願い」なんて雲をつかむようなことを、命よりも優先させるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390225,
					"content": "俺は全く理解できないぜ。そんなことのために、自分を危険にさらすなんてあり得ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390232,
					"content": "だから、彼女を探すことについては、俺に任せてくれ…いや、千岩軍の救助隊に任せると言ったほうが正しいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390226,
					"content": "でもこれは彼女が選んだ道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "選んだ道…そんなのおかしいぞ！彼女は死に急いでる、あんたはそれが分からないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390228,
					"content": "コホン…すまない、少し言い過ぎた。だが…あんな人間ごときにはどうしようもない状況…彼女は冷静に対処するべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390229,
					"content": "あと二三十年…もしくは十年経っていれば、もっと安全な地下装置ができているかもしれない。その時は急いで地下の地図を描く必要もなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390230,
					"content": "でも彼女は待たなかった…そう、彼女は若いうちに、他人が一生を捧げないと達成できない仕事に尽力した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710390231,
					"content": "あいつはバカだ…俺は友達として、無視するわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "沐寧"
				}
			]
		}
	]
}