			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ペコ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "いやぁ～、お二人には命を救っていただきました！私は行商人のペコと申します。今後もしお客さんになっていただけるなら、特別価格で取引しますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220302,
					"content": "まったく今日はついてませんよ…よりによって、あの噂の人物に遭遇するなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220303,
					"content": "噂って？あいつ、有名なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220304,
					"content": "ええ…悪い噂がね。他の行商仲間から聞いたんですけどね…みんな怖がって、このルートは二度と通らないと言ってました。でもまあ、私はそういうのは信じないタチでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220305,
					"content": "大胆なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220306,
					"content": "私たち行商は、いろんなことに遭遇してきましたからね。それに、みんなで集まって自分の話をするときは、話を少し大げさに盛ることもあるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220307,
					"content": "話が逸れてしまいましたね…彼は「権八」——聞くところによると、稲妻で何か問題を起こしてしまって、辺境の地に逃げてきたそうです。そうそう、恋人も一緒にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220308,
					"content": "だから、さっき言ってた「紫」というのは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "あっ、たしかに！さっき戦ってる時、誰かの名前をぶつぶつ言ってて、おかしな様子だったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220310,
					"content": "正道を外れてきた奴が、新しい場所に来たからってすんなり更生できるわけがありません。まともな稼ぎ口もないし、結局は同じ轍を踏むことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220311,
					"content": "一人だけなら、そんな生き方でもいいかもしれない…でも、命懸けのやり方では、誰に恨みを買うかわかったもんじゃありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220312,
					"content": "噂では、彼の恋人もそれが原因で命を落としたそうで…それからというもの、彼はすっかり気が狂ってしまったとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220313,
					"content": "はぁ…強盗しようとしてたのは許せないけど…ちょっとだけ可哀想に思えてきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220314,
					"content": "だからパイモンはモラのためにそういうことを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "おい！重要なところはそこじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220318,
					"content": "さて、それではこれ以上お二人の時間を取るのも悪いので…お礼だけ、受け取ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ペコ"
				},
				{
					"id": 760220316,
					"content": "もしパイモンが強盗に遭ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#ふふん、オイラにはおまえがいるだろ！オイラのモラは{NICKNAME}が守ってくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}