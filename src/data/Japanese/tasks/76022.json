			"dialogs": [
				{
					"id": 760220201,
					"content": "おい！なにやってるんだ！やめろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760220202,
					"content": "モラ…いや、違う！紫の仇だ…死んでもらうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "怒った侍"
				},
				{
					"id": 760220203,
					"content": "#うわあああ！{NICKNAME}、気をつけろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
