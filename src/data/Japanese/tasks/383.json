			"dialogs": [
				{
					"id": 3830401,
					"content": "やった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830402,
					"content": "前とは全く違う感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830403,
					"content": "風元素…活発になってきたね。これなら問題ないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830404,
					"content": "#{NICKNAME}、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830405,
					"content": "それで、どこで風魔龍を呼べばいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830406,
					"content": "モンド城内はダメだ。失敗したら、取り返しのつかない事態になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830407,
					"content": "このワイナリーも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830408,
					"content": "ああ、ワイナリーがなくなっても大した損害にはならないが、やめたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3830409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830410,
					"content": "海風、もしくは高いところを吹く風は、詩人の歌声を遠くまで運んでくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830411,
					"content": "逆に空気が乾燥していたり、重かったり、憂鬱な雰囲気はダメだ。詩人だけでなく、それは龍にも失礼でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830412,
					"content": "なるほど、海風、もしくは高いところを吹く風、だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830413,
					"content": "うーん、演奏に向いてるところは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830414,
					"content": "崖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "星落としの湖から東、砂浜の南に山地がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3830419,
					"content": "…あっ！こないだおまえが寝てた砂浜だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830420,
					"content": "山の伸びる方向に沿って登ると、<color=#00E1FFFF>星拾いの崖</color>というところに着く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3830421,
					"content": "詩人、君が希望する海風も高いところを吹く風も、そこでなら条件を満たせるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3830422,
					"content": "ふむふむ、星拾いの崖ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830423,
					"content": "…確かにいいところだね。ボクの歌声に相応しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830424,
					"content": "では、準備して星拾いの崖に集合しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830425,
					"content": "みんな、遅刻しないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830426,
					"content": "了解だぜ、団長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830427,
					"content": "あっ、すまない、つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830415,
					"content": "海？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "空を飛びながら弾く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "それはアンバーでも難しいと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "ジン"
				}
			]
		}
	]
