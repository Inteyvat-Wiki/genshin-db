			"dialogs": [
				{
					"id": 3830201,
					"content": "おお——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830202,
					"content": "「トワリン保護協会」！再集結！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3830203,
					"content": "さあ、集めた結晶を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830204,
					"content": "はっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830205,
					"content": "結晶の色がますます濁ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830206,
					"content": "トワリン…一体どんな苦しみを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830207,
					"content": "とにかく、まずはこれらの結晶を浄化しよう。異邦の旅人、お願いだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3830208,
					"content": "この目で見ていなければ、とても信じがたいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3830209,
					"content": "面白い。まるで酒のろ過のように、澄み渡っていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3830210,
					"content": "これだけ涙があれば十分だ。次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
