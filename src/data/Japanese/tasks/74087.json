			"dialogs": [
				{
					"id": 740870201,
					"content": "研究員は普段こんな場所で休んでるの？人道に背くんじゃない？フォンテーヌ科学院はここを優先的に修復しようとは考えなかったのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870202
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870202,
					"content": "…ここには「サーベイランスアンカー」が一つあるはずです。クロニエさんが示唆したように、この場所は早急に修復しなくてはなりません。エネルギー蓄積装置の数には限りがある…あるいは足りていない。そう言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870203
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870203,
					"content": "#僕がクロニエさんの質問に答えている間、「サーベイランスアンカー」の回収作業は{NICKNAME}さんにお任せしましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナッカー"
				}
			]
		},
		{
			"id": 7408703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7408702",
							"3"
						],
						"stepId": 7408702,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナッカー",
					"クロニエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "「宿舎」は他の区域に比べれば、爆発の影響はそれほどでもなかったと言えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870302,
					"content": "宿舎？でもここにはベッドの一つもないわ。研究員はどうやって休むの？椅子の上で眠るわけにはいかないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870303,
					"content": "クロニエさん、あなたの理解する「休息」と研究員たちに必要な「休息」は少し異なるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870304,
					"content": "フォンテーヌ科学院の研究員が「休みが必要だ」と言う時、ただ自分の頭が考え事をするのをしばらく止めたいというだけなんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870305,
					"content": "それで普通はここへ来て、ピアノを弾いたり、気軽に読める本を読んだり、必要であれば飲んだりするわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870306,
					"content": "あら…でも、それなら寝た方が頭を休ませられるんじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870307,
					"content": "それはそうです。でも…我々研究員からすれば、睡眠をとるということはあまりにも時間のムダなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870308,
					"content": "睡眠が時間のムダですって？必要な休息よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870309,
					"content": "睡眠は研究の思考を完全に断ってしまいます。研究という仕事において、そんなことは全く受け入れがたいんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870310,
					"content": "（聞き続ける…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "真面目に言ってるの？睡眠をとらなければ、絶たれるのは命のほうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870313,
					"content": "そんなことはありませんよ。以前の科学院には優れた医療保障がありましたから。一研究員の健康を保証するのは全く難しくないことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870314,
					"content": "それは眠らない理由にはならないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870315,
					"content": "それに…研究員は一時的に頭を休ませるためにここへ来るわけでしょう？研究のための思考はそもそも中断されてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870316,
					"content": "いいえ、頭を一時休ませているとは言っても、実際は学術的な問題を本能的に考え続けています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870317,
					"content": "広大な大海原で、波がしばらく消えたかのように見えても、深い所でひそかに沸き立っているのと同じようなことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870318,
					"content": "時には、このひっそりとしたうねりの持つ力の方が、表面の大波よりもさらに巨大なことがありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870319,
					"content": "分かったわ。あなたが言いたいのはつまり、フォンテーヌ科学院の研究員なら、研究中は休むことなく研究するしかないってことね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870320,
					"content": "それは客観性に欠ける言い方ですね。本当に睡眠が必要なら、帰って寝ればいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870321,
					"content": "だったらこうね。フォンテーヌ科学院の研究員はフォンテーヌ科学院にいる限り、休むことなく研究を続けるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "クロニエ"
				},
				{
					"id": 740870322,
					"content": "あなたのレトリックの腕には脱帽です、クロニエさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナッカー"
				},
				{
					"id": 740870311,
					"content": "（聞かないほうがよさそう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}