						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リーセ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "旅人さん！ちょうどいいところにきた、手伝ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "見ての通り、雪山の厳しい環境はベテラン冒険者にとっても容易く対応できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730104,
					"content": "俺は代理団長様の命に応じて、山に登ろうとする住民たちを阻止してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730105,
					"content": "普通の住民は俺の話で山登りを諦めるが、冒険者たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730106,
					"content": "旅人さんも知ってるだろう、あいつらはいくら口説いてもそう簡単に諦めたりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730107,
					"content": "今まで冒険者関連の事件を何件処理したのか…なのに雪山に登ろうとする冒険者はぜんぜん減っていかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730108,
					"content": "全ての冒険者に気を配るのは無理だろう…だから雪山の何箇所かに補給を配置しようと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730109,
					"content": "補給があるなら、痛い目にあっても雪山から出られるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730110,
					"content": "まあ…運が悪く深く行き過ぎたら、それはもう自分に頼るしかないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730111,
					"content": "という訳で、ここの補給を雪山に置いてもらえるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730112,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "じゃ、頼んだぞ。やれやれ、そこの冒険者たちも旅人さんのようにしっかりしてるといいのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730117,
					"content": "3つの場所を地図に標記しておいたよ。それぞれの場所に<color=#00E1FFFF>ハムを1つ</color>置けば大丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730118,
					"content": "はあ、あの冒険者たちが己の身の程をわきまえてるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730114,
					"content": "それでいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "役が立っても立たなくても…あったほうが増しだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730116,
					"content": "こんなとんでもない環境なんだ、補給が1個増えるに越したことはない。とにかく、頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "リーセ"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
