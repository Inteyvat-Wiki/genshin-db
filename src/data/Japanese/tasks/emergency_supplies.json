				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "物資は置けたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730202,
					"content": "置いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "よかった、これで少しは安心できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730204,
					"content": "ただ、やっぱり雪山に登る人には自分たちでしっかり準備してから来てほしいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730205,
					"content": "そういえば、君もかなり薄着だな。最近のモンド城の流行りなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "リーセ"
				},
				{
					"id": 200730206,
					"content": "この報酬を受け取ってくれ。戻ったら暖かい服を買った方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リーセ"
				}
			]
		},
