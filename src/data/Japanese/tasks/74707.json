			"dialogs": [
				{
					"id": 747070101,
					"content": "…よし、ここまでオーケー！もう一回いくよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070102,
					"content": "はい、カット——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070103,
					"content": "フリーナ！コロンビーナと千織も、また会ったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747070104,
					"content": "ちょうどこの前話していた雰囲気作りのカットを撮り終えたところさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070105,
					"content": "おっ！魚を役者にするってやつだな。どうだった、どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747070106,
					"content": "キミたちのおかげで、ふさわしい「役者」を見つけることができたよ。撮影はとても順調だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070107,
					"content": "水槽のセットもなかなかのものね。フリーナ監督も、水中ドキュメンタリーを撮りたくなったって言ってたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747070108,
					"content": "褒めてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "私もすごく好き。魚たちがのんびり、満足そうに泳いでるのがわかる。キミたちが上手にお世話してるからだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070111,
					"content": "このアクアリウムがずっとここにあればいいのになぁ。そうすれば、時々この魚たちを見に来られるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070112,
					"content": "そんなに惜しいなら、映影にもっとカットを入れればいいじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747070113,
					"content": "キミの言う通りだ。もういくつか追加で撮ろうじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070114,
					"content": "魚を捕るの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070115,
					"content": "撮影のほうの「撮る」さ…さあ、照明、カメラ！スクリプターも配置について！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 747070116,
					"content": "行くぜ！へへ、魚のためにカチンコを鳴らすのは初めてだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747070109,
					"content": "気に入ってくれてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}