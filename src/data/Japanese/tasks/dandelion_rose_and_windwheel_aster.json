				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "あら…この甘さ、ちょうどいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060202,
					"content": "ああ、コーヒーもコクがあって、苦味もちょうどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060203,
					"content": "満足してもらえてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "…リサが言ったことを、私も理解はしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060205,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060206,
					"content": "最近、自分の足りない点をよく反省することがある。仕事の効率も能力も…あらゆる面で改善の余地があると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060207,
					"content": "私のストレスが、きっと知らない間にリサにも影響を与えてしまっていたんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060208,
					"content": "全然分かってないんじゃないかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060210,
					"content": "そうね。ほら、可愛い子ちゃんだって分かっているみたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060211,
					"content": "あなたがあまりにも疲れた顔をしていたから、一緒にお酒やお茶を飲んで、楽しいことで息抜きをしようと思っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060212,
					"content": "それなのに、ここでもあなたは仕事のことばかり考えているんだもの。そんなんじゃ、わたくしだって悲しくなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060213,
					"content": "ずっと気を張り詰めていたら、いつか倒れてしまうわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060214,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#{NICKNAME}、君もそう思うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060216,
					"content": "はぁ、どうやら…息抜きすることを学ぶのが、私にとって一番の課題のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060217,
					"content": "璃月には「一張一弛」という言葉がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "ああ！仕事をする時はしっかり仕事をして、休む時にはゆっくり休む。わかりやすく言えば、おまえら二人を足して二で割ったような感じがちょうどいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060219,
					"content": "変な例え…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060221,
					"content": "な、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060222,
					"content": "ありがとう。酒場は飲み物を飲むだけでなく、気分まで明るくしてくれる場所だったのだな。だから、リサとガイアは酒場が好きなんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060223,
					"content": "ええ、そうね。でもそれは、バーテンダーが誰かにもよるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060224,
					"content": "今日は可愛い子ちゃんのおかげで、ジンを説得できたわ。あなたの口がとても上手だからでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060225,
					"content": "そんなことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "ふふっ、それじゃあ、わたくしたちはこれで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060228,
					"content": "機会があれば、またここに来て息抜きをしようと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060229,
					"content": "ああ！じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060226,
					"content": "役に立てたなら良かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}