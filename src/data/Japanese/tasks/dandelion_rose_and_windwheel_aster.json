			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "あら、可愛い子ちゃんじゃない。会えて嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060102,
					"content": "まさか、こんなところで会うとはな。私もリサと同じ気持ちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060103,
					"content": "もう「こんなところ」だなんて…酒場は体を休めて、楽しむにはぴったりの場所なのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060104,
					"content": "はぁ、可愛い子ちゃんには想像できないでしょうね。わたくしがどれほど苦労して、仕事に追われているジンを椅子から立ち上がらせたことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060105,
					"content": "それに、まだ来たばかりなのに、ジンったらもう心配した表情をしているし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060106,
					"content": "リサ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060107,
					"content": "騎士団は事務仕事が多いからね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "そうだな。ジン団長は代理団長だし、騎士団のことが心配になるのも仕方ないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060109,
					"content": "でも、せっかく来たんだから…楽しんでけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060110,
					"content": "ほら、こいつに美味しいドリンクを作ってもらえ。飲めばきっと気分も明るくなるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060111,
					"content": "気分転換にちょうどいいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "はぁ、息抜きの仕方を学ばなきゃいけないのはジンだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060113,
					"content": "可愛い子ちゃん、ロマンティックオードを一杯いただけるかしら。サイズはミディアムで、甘めにしてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060114,
					"content": "ジンは？何にする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705060115,
					"content": "ああ…私はコーヒーでいい。同じミディアムサイズで頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060116,
					"content": "ジン団長、普段からコーヒーばっかり飲んでるし、たまには他のにしたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705060117,
					"content": "ありがとう。だがやはり、眠気を覚ますようなものが飲みたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 705060118,
					"content": "分かった、少し待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "ああ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジン"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
