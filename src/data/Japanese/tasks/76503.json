			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フリンズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#おや、{NICKNAME}さんにパイモンさん。まさか、こんな辺鄙な場所でお会いするとは思いませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030102,
					"content": "何か手がかりを追ってここまで来たのですか？それとも道に迷ったのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030103,
					"content": "この辺りを見てまわってただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "そういうことでしたか。この廃船の甲板から眺めるクーヴァキ実験設計局は…実に壮観ですからね。まるで眠れる巨獣を思わせます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030106,
					"content": "ほんとだな。遠くからでも威圧感が伝わってくるぜ。あの中にはどれだけの秘密が隠されてるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765030107,
					"content": "ええ。モチーフを求めているあなたたちなら、きっとこの光景から数えきれないほどのインスピレーションを得られるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030108,
					"content": "何せ、光と闇の境界からは、人々を惹きつける物語がしばしば生まれるものですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030109,
					"content": "へへっ、青く光るランプと一緒にここに立ってるフリンズにも、なにか物語が隠されてそうだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765030110,
					"content": "そういえば、フリンズは今日…えっと…あそこを見張ってなくてもいいのか？休暇中だったり？それともパトロール中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765030111,
					"content": "どちらとも言えます。影に潜む災いを見張るのが、僕たち「ライトキーパー」の永遠の責務です。どこにいても、警戒を怠ることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030112,
					"content": "ですが、今のところこの場所の気配は穏やかです。どうか肩の力を抜いて、安心して撮影に励んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030113,
					"content": "せっかくだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "僕の写真をですか？それは些か予想外でした。正直、カメラの前に立って、凝視されるのには慣れていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030116,
					"content": "あなたたちなら分かっていただけるでしょう…僕は沈黙する墓石と共に、死者の囁きに身を置くことを日常としている者ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030117,
					"content": "ですが、友人の頼みを断るのは無粋というもの。それにおもてなしの心にも欠けてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030118,
					"content": "どうぞご自由に、撮りたい瞬間を切り取ってください。あなたたちの創作に、ささやかなインスピレーションを贈れるのなら、僕も光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 765030114,
					"content": "フリンズの写真を撮ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
