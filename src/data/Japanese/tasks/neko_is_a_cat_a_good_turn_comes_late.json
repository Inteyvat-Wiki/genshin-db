				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "来たか。石人間が、もうすぐ完成だと言っていたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160102,
					"content": "主ら、あいつのところに行ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平",
					"「寝子」",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "ふぅ、完成まであと少しだ。本当に大変な作業だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160202,
					"content": "おっ、君たちか、それに代理宮司様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160203,
					"content": "できたのかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160204,
					"content": "ああ！完成だ、ははっ！それに、儀式感を加えるため、わざと少し残しておいたんだ。代理宮司様が来てから、最後の部分を削ろうと思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160205,
					"content": "気が利くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "へへっ、当たり前よ。こんな大事なこと、真面目にやらないとダメだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160207,
					"content": "にゃおーん…石を叩くのが大事なことにゃのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160208,
					"content": "うーん…なんて言うか、一般的に、彫刻にするのはどれも重要なものや大事なものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160209,
					"content": "パイモンは食べ物を彫刻にするべき。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "おい！失礼だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722160211,
					"content": "つまり良いものかにゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160212,
					"content": "はははっ、それは…まあ…良いものよりも良いものだろう！なんてったって彫刻は、「永遠の記念」なんだから、はははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160213,
					"content": "違う。「永遠の記念」じゃないにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160214,
					"content": "うちは、響が帰ってくる道の途中でもし迷ったら、うちの形をした石を見つけられると思ったのにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160215,
					"content": "そしたら、響もここにたどり着ける。迷ったりもしにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160216,
					"content": "そ、そうだったのか。代理宮司様は本当にその「響」って人のことを気にかけてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160217,
					"content": "寝子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "響はいつ帰ってくるかわからにゃい。それに響と百目鬼が言っていたにゃ、うちの形をした石ができたとき、良いことが起こると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160219,
					"content": "ところで、石人間、まだうちにしてほしいことはにゃいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160220,
					"content": "いや、別にない…雑談はここまでにして、代理宮司様、いま最後の部分を削るぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160221,
					"content": "いち…にの…さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160222,
					"content": "こ、この雲、これはいったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160223,
					"content": "猫の形になった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "響にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160226,
					"content": "えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "響？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160228,
					"content": "にゃにゃっ！きっと響にゃ！響が言っていたにゃ！良いことが必ず起こるにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160229,
					"content": "響が言っていた、その石ができれば、良いことが起こる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160230,
					"content": "よかった、よかったにゃ！響が言っていたことは本当だったにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160231,
					"content": "響はきっと帰ってくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160232,
					"content": "お…おう！はははっ、なんのことか分からないが、その様子からして、良いことみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160233,
					"content": "寝子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "主らのおかげで、神社もキレイになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160235,
					"content": "「賽銭箱」も直った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160236,
					"content": "「絵馬掛け」も直った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160237,
					"content": "うちの形をした石も作った。きっとこれで、響も帰ってくるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160238,
					"content": "それに、百目鬼、蛇目、それと響の友達たち、みんな響と一緒に帰ってくるにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160239,
					"content": "主は本当にいいやつにゃ！飯よりもいいやつにゃ！響も主のこときっと気に入るにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160240,
					"content": "うち、あの子らを呼んできて、響のことを伝えるにゃ。それと、これからたくさんの人が神社に来ることも。きちんとあの子らに説明しないといけにゃい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160241,
					"content": "すべて事前に準備しないといけないにゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160242,
					"content": "響…にゃおーん！よかった、よかったにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722160224,
					"content": "いったいどういうこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "代理宮司様がこんなに喜ぶなんて。どうやらその人は、すごく大切な人みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160302,
					"content": "でも、どこにいるか分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悦子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "確かに、「響」…「浅瀬神社」…「百目鬼」…どれも気になるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160402,
					"content": "いつからいたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "島でこんなに大きな騒ぎがあったら、来ない方がおかしいでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160404,
					"content": "それと、説明しなきゃいけないことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160405,
					"content": "大祐、話してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160406,
					"content": "あっ…分かったよ、悦子。その、僕が言いたいことは…このセイライ島に関することなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160408,
					"content": "セイライ島の歴史はとても古く、様々な調査を行った協会でも、有用な情報がまったく見つかっていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160409,
					"content": "協会の資料によると、数百年前のここは、「海賊」が集まる場所だったみたいだ。当時、幕府が全面的に海賊を片付け、島の住民たちを別の場所に移住させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160410,
					"content": "その「百目鬼」とは、たぶん、当時幕府と正面から対峙した海賊の頭である「赤穂百目鬼」のことだ。書類にもはっきりと名前が記録されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160411,
					"content": "協会が僕たちに渡した資料によると、この「赤穂百目鬼」は海賊の船隊を指揮し、海上で幕府と戦っていたという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160412,
					"content": "彼の船隊は幕府に制圧され、セイライ島に逃げてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160413,
					"content": "だが、幕府の船隊が彼を追撃しようとした時、突然セイライ島に原因不明の雷が落ちた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160414,
					"content": "赤穂百目鬼の船隊と幕府の船隊は、その雷に当たり…そのまま消息を絶った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160415,
					"content": "雷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "後は私から話すわ…このことに関する最大の疑問点は、突如現れた雷にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160417,
					"content": "赤穂百目鬼の船隊は雷のせいでほぼ壊滅した…でも幕府がセイライ島に手配した船隊も、同じようにほとんど壊滅したの。そうして鳴神島に撤退し、船隊の再編までとても長い時間をかけたらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160418,
					"content": "いくらなんでもタイミングが良すぎるのよ、この雷が落ちた時が。そう…まるで…誰かに操られていたかのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160419,
					"content": "わざと封印が解かれたあの「鎮め石」のことを、まだ覚えているでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160420,
					"content": "そして、その「鎮め石」を封印したら、島の雷も収まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160421,
					"content": "安易な推測はできるだけ避けたいけど…これらは、多かれ少なかれ関連していると思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160422,
					"content": "その、寝子さまに聞いてみるってのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160423,
					"content": "それはやめた方がいいと思う…資料では百目鬼は失踪したと書かれているけど、あんな雷に当たったんじゃ、たぶんもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160424,
					"content": "私たちは引き続きこの島で探索をして、このことに関する手がかりも見つけたいと思ってる。しばらく経ってから、協会へ報告しに行くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160425,
					"content": "ふふ、旅人、もしかしたら、その時はまた一緒に仕事できるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160426,
					"content": "その時はよろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "ええ、よろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160428,
					"content": "大祐、準備をしなさい。引き続き探索計画を練るわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160429,
					"content": "えっと…悦子、寝子さまは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160430,
					"content": "以前と同じように、その猫に接するといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160431,
					"content": "でもこれだけは覚えておいて。言ってはならないことは、決して口にしないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160432,
					"content": "あの猫…今、とっても嬉しそうにしてる。空気を壊すようなことは言っちゃだめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160433,
					"content": "分かったよ、悦子！えへへ、やっぱり君って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160434,
					"content": "…ただ、より効率的に依頼をこなすためよ。早く仕事に戻りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160435,
					"content": "セイライ島…どうやらまだまだ秘密があるみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悦子"
				},
				{
					"id": 722160407,
					"content": "何か知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}