			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "ローゼル、何度言われても、君と旅に出ることはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610102,
					"content": "僕は君の友人だ。これだけは永遠に変わったりしない。僕が君のことを嫌いになるはずないからね。でも…でも、僕は遠くに行くのが好きじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610103,
					"content": "エスノワール、そう怖がるなよ。これはただの旅で、それ以上でもそれ以下でもないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610104,
					"content": "外の世界には村にない花や、見たことない人がたくさん存在してるんだぞ。雲の形まで違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610105,
					"content": "言っただろう、お前のために花の種を持って帰ってきたって。保証するよ。あんな形と色をした花、お前は絶対に見たことないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610106,
					"content": "まだ、ただの種だ。花の姿は、植えたのが咲くまで分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610107,
					"content": "もし俺と一緒に旅に来てくれたら、途中で直接そういう花を見つけられるかもしれないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610108,
					"content": "ローゼル…すまない…僕は遠くまで旅に出るつもりはない。あの冒険客たちみたいになりたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610109,
					"content": "あいつらは絨毯の価値にしか興味がなく、綺麗な帽子には目もくれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610110,
					"content": "あれは旅が君たちにもたらした変化だ。僕はまさに、そのことが怖い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610111,
					"content": "確かにそれは事実…だけど、あいつらのスーツケースに入ってる地図や、植物のサンプル、そして記録で埋め尽くされた旅日誌を見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610112,
					"content": "俺たちはそれぞれ違う森を通る風や、別々の湖にそそぐ川みたいなものだ…新しいことを知った今は、たしかにもう昔の自分じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610113,
					"content": "これは旅が俺たちにもたらした変化だけど、怖がりながらも…感謝してることなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610114,
					"content": "両側にクリームが塗られたパンがあったとしたら、どんなに丁寧に持ち上げたって、絶対に片側のクリームがぐちゃぐちゃになってしまうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610115,
					"content": "それなら、クリームを違うパンに塗るよ。別の味にすることだってできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610116,
					"content": "いいアイデアだね。お腹がふくれそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "君たちか、やっと帰ってきてくれたな。ローゼルが外の世界の美しさについてばかり話して、一緒に旅に出ようって口説いてくるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610119,
					"content": "君たちは外の世界を知っているか？本当に…ローゼルの言う通りなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610117,
					"content": "悪くないね。クリームも手につかないし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
