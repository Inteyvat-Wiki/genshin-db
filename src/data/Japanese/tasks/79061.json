			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>中の世界</color>も悪くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "おう、ここはエスノワールの「家」なわけだしな。ここが好きなんだろ？それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790610303,
					"content": "ここには友達が沢山いる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "その通りだ！僕はそういうものを失ってしまうことが怖くて、ずっと悩んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610307,
					"content": "どれもよくて、素晴らしい…だから彼らが変わっていくのも、自分が変わるのも嫌だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610308,
					"content": "…でも、旅は何もかもを変えてしまう。そうだろう？ローゼル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610309,
					"content": "ああ、必ずな。辛い思いなんかさせたくないけど、お前を騙せない…エスノワール。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610310,
					"content": "ローゼル…分かった。君の気持ちは分かってる。きっと君も、僕の気持ちは理解してくれてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610311,
					"content": "君の誘いを真剣に考えてみるよ。もう少しだけ待ってくれ…少なくとも今は、君と一緒にゆっくりお茶を楽しみたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610312,
					"content": "ああ…一緒にいてやるよ、エスノワール。次の出航日まで、まだまだ時間はある。一緒に考えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610304,
					"content": "綺麗な花が沢山ある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "それに美味しいケーキも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "ローゼル、僕は…君と一緒に旅に出てもいい。でも…何を準備すればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610402,
					"content": "簡単さ！まずはジャム、パンと好奇心をカバンに入れて、着心地の良い服を着るんだ。着替えも持っていこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610403,
					"content": "そして最後は覚悟だ——今言ったものの一部を、途中で捨てないといけないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610404,
					"content": "おお…かなり複雑そうだな。どれも捨てたくない…全部、大切な宝物で、愛してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610405,
					"content": "捨てた後にまた新しい宝物を見つけられるさ、エスノワール。",
