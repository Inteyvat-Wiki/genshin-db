			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "うん、<color=#FFCC33FF>外の世界</color>には新鮮なことが沢山ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "そうだぞ。美味しい食べ物と面白い遊びだけじゃない。不思議な出来事を経験したり、すごい人に出会ったりすることあるぞ。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790610203,
					"content": "物事の美しい本質にとことんこだわる人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "本当か？…外の世界には「価値」しか存在しないんだと思ってたよ。帽子を被りたいのに、その勇気はない…そんな人ばっかりだとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610207,
					"content": "それは…まあ、その…ケ、ケーキの上のチョコチップみたいに、どれも違う味っていうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790610208,
					"content": "チョコチップが全部同じ味だったら、ケーキも美味しくなくなっちゃうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790610209,
					"content": "パイモン、いいこと言うね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "あれだけ話を聞かされたら、少しは身につくぞ。へへっ、なかなか理にかなってただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790610212,
					"content": "そうなのか？も…もう少し考えさせてくれ…もしかしたら…ちょっとだけ旅に出てみるのも、悪くないかもしれない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610213,
					"content": "焦る必要はない、エスノワール。次の出航日まで、まだまだ時間はあるから、一緒に考えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610210,
					"content": "パイモン、完全にここに溶け込んでるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "永遠に色褪せない輝かしい理想や…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "夢に向かって努力する人たちもいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
