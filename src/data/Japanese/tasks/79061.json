			"dialogs": [
				{
					"id": 790610501,
					"content": "すまない、ローゼル。やっぱり…君と一緒に旅に出ることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610502,
					"content": "ここにいられるだけで十分なんだ。でないと、君が旅から戻るとき、迎えに来る者がいなくなってしまうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610503,
					"content": "でも、エスノワール、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610504,
					"content": "ローゼル——僕は賢くもないし、勇敢でもない。でも、僕には分かる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610505,
					"content": "風が森を通り抜け、川は湖に流れ込む。一周回って、最後にすべては旅の原点に帰るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610506,
					"content": "あれだけの変化を経験しても、最後は…最初の自分に戻りたくなるかもしれないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "エスノワール"
				},
				{
					"id": 790610507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "ローゼル"
				},
				{
					"id": 790610508,
					"content": "家で待ってるよ、僕の親友。いつものようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスノワール"
				}
