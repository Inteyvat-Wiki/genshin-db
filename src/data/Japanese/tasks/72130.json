			"dialogs": [
				{
					"id": 721300101,
					"content": "独特な形をした石灯籠。不穏なエネルギーを放っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721300102,
					"content": "この石灯籠、気味悪いぞ…でも、なんだか知ってる気配がするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721300103,
					"content": "ん？誰かがここに字を書いたみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721300104,
					"content": "「駐屯している兵士、この鎮め物に何か疑問がある場合、無想刃狭間にいる梶さんへご相談を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721300105,
					"content": "字の感じからして、書かれたのはつい最近のようだ。雨に洗い流された痕跡がある。下には小さな字ではっきりと何か書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721300106,
					"content": "「見知らぬ人の文字を、信じてはいけない。行軍は迅速に行われるべきもの。これは遅らせるための賊人の罠に違いない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721300107,
					"content": "「許可を得ず軍から離れた者は、厳罰に処す！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "観察"
				},
				{
					"id": 721300108,
					"content": "この梶さんっていう人が石灯籠と関係してるみたいだ。無想刃狭間に行って聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
