			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210901,
					"content": "クソッ、また弾かれた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210902,
					"content": "次はあの兄ちゃんの口を塞いでくれ。あの縁起でもない口…毎回言い当てるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210903
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210903,
					"content": "もうこの秘境いやだぞ——！惟神晴之介はオイラたちと会うのが怖いんだろ、腰抜けなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210904,
					"content": "でも、近くに天領奉行の武士がまだ駐留してるぜ。兄ちゃんと「式大将」は中にいるから、トラブルは避けられたみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210905
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210905,
					"content": "（惟神…いったいどこにいるんだろう？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210906
					]
				},
				{
					"id": 400210906,
					"content": "じゃあいつも通り、秘境の再構築が終わったら、中に入ってあいつらと合流しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210907
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210907,
					"content": "それまで身を隠してた方がいいな。アタイたちがまだここ一帯をうろついてることを、天領奉行に知られない方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210908
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210908,
					"content": "次に入った時は、ぜったいにすべての元凶を見つけ出してやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4002114,
			"completionStepIds": [
				4002114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002114",
							"2"
						],
						"stepId": 4002114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400211401,
					"content": "「拓本」に残っている符術の力には限界がある、だから僕が取り戻せる記憶も限られている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211402
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211402,
					"content": "まだ足りないのか？じゃあ計画通り、引き続き秘境の奥深くへ進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211403
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211403,
					"content": "いやいや、秘境は再構築されたんだから、せっかく見つけたルートもとっくに使えなくなってるって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211404,
					"content": "その点については心配無用。秘境の再構築には規則がある、だからなんとなく方向が分かるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211405
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211405,
					"content": "あっちに向かえば間違いないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211406
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211406,
					"content": "ちょっと待ってくれ、質問があるぞ！「式大将」、さっき「拓本」に残ってる力が足りないから、記憶の回復にも限りがあるって言ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211407,
					"content": "だったら、なんでその道が正しいってわかるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211408,
					"content": "この前おまえと一緒にあの扉を通ったら、オイラたちは秘境の外に出た…つまりここにある扉には、本物じゃないものもあるってことだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211409,
					"content": "もしおまえが間違えてオイラたちを危ない場所に連れて行ったら、それこそ終わりじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211410,
					"content": "そう心配するのも無理はない、だが僕は君たちが納得のいく答えを示すことはできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211411
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211411,
					"content": "もし、「寮司」の直感だと言ったら、受け入れてくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211412
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400211412,
					"content": "なんか心許ないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211413,
					"content": "パイモンの言ったことはもっともだが、アタイたちは「式大将」という案内役を信じるしかない。じゃないと、ここにずっといる羽目になるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211414
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400211414,
					"content": "それに万が一、秘境がまた動き出したら…その時は、もっと方向が分からなくなるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211415
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400211415,
					"content": "ふむ、外に行ってから、少し焦ってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211416
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211416,
					"content": "もしかして…何かトラブルにでも遭ったんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211417
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211417,
					"content": "俺の知る限り、現段階では稲妻の情勢はまだ安定しているとは言えない。このような秘境は天領奉行が対処すべきことだが、天領奉行は人手が不足していて、全体の局面を制御するには不十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211418
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211418,
					"content": "だから、君たちが依頼を受け、ここへ来た。そしておそらく、それは天領奉行による依頼だったのだろう、君たちは彼らの命を受けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211419
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211419,
					"content": "あいつらのやり方なら、直接秘境に突撃して、すべてをねじ伏せてしまう。そうなる前に「式大将」の記憶を取り戻さなければ、もうチャンスはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211420
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211420,
					"content": "だから君は焦っている、そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211421
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211421,
					"content": "やっぱり稲妻を調査してたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400211422
					]
				},
				{
					"id": 400211422,
					"content": "全部おまえらの陰謀だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400211423,
					"content": "俺は確かにあることを調査しているが、君たちの考えているようなことじゃない。このことはまた後にしよう、今は目先の問題の方が先だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211424
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211424,
					"content": "旅人、俺は君と付き合いがある、こういうところでわざわざ嘘をつく必要はない。稲妻に着いた後、俺は周辺地区で魔物の痕跡を見つけ、自然とこの秘境まで辿り着いたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211425
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211425,
					"content": "ここは闘士のために設立された訓練場のように…戦いと殺し合いしか存在しない。ここにいると、自分を思いっきり解放して楽しむことができる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211426
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211426,
					"content": "こう言っちゃ悪いけど、旅人とパイモンを除いて、そこの二人に会ったのはこれが初めてだ。俺が立場をあまり気にしない人だっていうことを、君たちは知らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211427
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211427,
					"content": "善悪、正邪、使命…これらのことは本当に重要なことなのか？極限の戦いや楽しい殺し合いよりも魅力的なのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211428
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211428,
