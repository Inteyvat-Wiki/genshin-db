			"trigger": {
				"objectNames": [
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210101,
					"content": "旅人、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210102
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210102,
					"content": "さっき九条裟羅さんが来たんだ、あそこにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210103
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210103,
					"content": "うろうろしてるのを見ると、本当にオイラたちのことが心配みたいだな…すごく警戒してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210104,
					"content": "真剣さと責任感の表れだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210105
					]
				},
				{
					"id": 400210105,
					"content": "状況がちょっと複雑だ、まずは彼女と話をしてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
			"id": 4002102,
			"completionStepIds": [
				4002102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002102",
							"2"
						],
						"stepId": 4002102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210201,
					"content": "皆の者、近ごろの働き、ご苦労だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210202
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210202,
					"content": "人手を連れてきた。ここ一番の正念場はもう過ぎたと言えよう。ここからは、この道を守ることで魔物を効果的に防ぐことができるはずだ。逃げ出す者がいても、ヤツらを荒海一帯に封じることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210203
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210203,
					"content": "以前、ここの秘境内から大きな音が聞こえた、おそらく中には大量の仕掛けがあるのだろう…時機を見計らい、兵を投入して攻め入る、我々は今その準備を進めている途中だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210204
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210204,
					"content": "もっと秘境に近いところに駐留したりしないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210205,
					"content": "以前の行動時、武士たちは秘境と十分な距離を保つことを考えていなかった。そのため魔物の奇襲に対し、慌てて退却する羽目になったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210206
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210206,
					"content": "一回目は想定外と言えるが、二回目は手落ちだ。このようなことを再び起こすことは許されない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210207
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210207,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210208,
					"content": "（ちょうどいい、チャンスはまだある。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210209
					]
				},
				{
					"id": 400210209,
					"content": "この後は九条陣屋へ戻り、他の地区の防衛を調整する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210210
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210210,
					"content": "来るのが少々遅かったが、ここは天領奉行が引き受けよう。お前たちの協力に感謝する。事前に話していた報酬についても、しかと覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210211
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210211,
					"content": "辛炎殿、この手紙を。中には私が手配した「通行証」が入っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210223
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210223,
					"content": "辛炎殿のために、最も長い期間の滞在期限を申請しておいた。その期間を利用して、稲妻をじっくり観光してもらえると嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210212
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210212,
					"content": "それ以外にも、食事と宿泊施設を手配した。城内へ戻ったら、手紙に書かれた通りに宿へ向かうといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210213
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210213,
					"content": "マジかよ！こんなの天からモラが降ってきたようなもんだろ？食事も宿も無料で、稲妻観光までできる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210214
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210214,
					"content": "遠慮するな、当然のことをしたまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210215
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210215,
					"content": "ありがとう。あんた最近すごく忙しくしてるだろ、いつ休んでるのか気になってたんだ…もし、あんたが休暇を取れた時にアタイがまだ稲妻にいたら、ぜひアタイの路上ライブを見に来てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210216
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210216,
					"content": "正直、私は詩や音楽にあまり興味がない。だが辛炎殿は天領奉行に多大な貢献をした。ならば私も…機会があれば…行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210217
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 400210217,
					"content": "これで、辛炎が一番心配してたことも解決したな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210218,
					"content": "いやいや、一番心配なのは「式大将」のことだって！こっからはアタイの個人的な利益とは関係なしだ…友達として、あいつを助けてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210219
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210219,
					"content": "それとあの兄ちゃんも。旅人、もちろんあいつも助けるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210220,
						400210221
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210220,
					"content": "無事だとは思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				},
				{
					"id": 400210222,
					"content": "じゃあ行こうぜ。こっそり「式大将」と合流しに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210221,
					"content": "放ってはおけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				}
			]
		},
		{
			"id": 4002103,
			"completionStepIds": [
				4002113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002113",
							"2"
						],
						"stepId": 4002113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210301,
					"content": "辛炎さん、旅人さん、パイモンさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210302
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210302,
					"content": "さっき、ある女将領が人を連れてこの辺りを偵察していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210303
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210303,
					"content": "あいつは天領奉行の人で、九条裟羅っていうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210304,
					"content": "九条裟羅…天領奉行にはそのような人がいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210305
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210305,
					"content": "天領奉行の当主の名は聞いたことがある、たしか男性だった。九条…えっと、なんだったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210306
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210306,
					"content": "はっきりとは覚えていないが、些細なことを思い出した。たしか、晴之介とその天領奉行の当主は将棋をしたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210307
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210307,
					"content": "その晴之介って人、もしかして偉い人だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210308,
					"content": "雑談はあとにしようぜ。誰にも気づかれないうちに、早く陰陽寮の中に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210309
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210309,
					"content": "そうだな、それにあの行方不明のやつも探さないと！早く行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210310,
					"content": "よし、じゃあみんな、僕について来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大将」"
				}
			]
		},
		{
			"id": 4002105,
			"completionStepIds": [
				4002105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002105",
							"2"
						],
						"stepId": 4002105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210501,
					"content": "わぁっ！おまえここにいたのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210502,
					"content": "おっ、来たんだね。もう待ちくたびれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210503,
					"content": "君たち、せっかくのいいところを見逃しちゃったね、実に惜しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210504,
					"content": "こいつ、けっこう元気そうだぞ。傷も負ってないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210505,
					"content": "ん？心配してくれてたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210506,
						400210508
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210506,
					"content": "別に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210507
					]
				},
				{
					"id": 400210507,
					"content": "どうやら、俺の実力を信頼しているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210510,
					"content": "相棒として、古きライバルとして、君は知っているはずだ。こういうサプライズに満ちた戦いは、俺の好みだってことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210511,
					"content": "秘境が再構築されている間、部屋が上下に移動して、魔物も一緒に辺りを駆け回っていた。うん！ここ何日か、とても楽しく戦えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210512,
					"content": "それに「式大将」が必要とする拓本もいくつか見つけられた。中には彼の記憶と力が入っているはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210513,
					"content": "ちょうどいいタイミングだったな。早くそれらを回収しようぜ、「式大将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210508,
					"content": "ちょっとだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210509
					]
				},
				{
					"id": 400210509,
					"content": "本当？君に心配してもらえるなんて、光栄だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 4002108,
			"completionStepIds": [
				4002108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002108",
							"2"
						],
						"stepId": 4002108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210801,
					"content": "この部屋は陰陽寮の最深部に非常に近い。たしか…僕と晴之介もここに長く留まっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210802
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210802,
					"content": "僕たちはずっと稲妻各地から来る武人を観察していた。彼らは宴で酒を飲む時、「我々も強大な魔物を倒す力を手に入れた！」と声高く叫んでいたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210803
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210803,
					"content": "もしかしたら、あんたと惟神晴之介って、その武士たちを連れて魔物を退治しに来たんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210804
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210804,
					"content": "その可能性もあるが、他の可能性もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210805
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210805,
					"content": "言い換えれば、そのような状況は晴之介がわざと仕組んだものである可能性がある。制御不能になった陰陽寮を再び掌握するため、武士たちを引き連れ、秘境に入り魔物を退治するよう命じた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210806
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210806,
					"content": "「式大将」は、公子の言ってた推測についてさらに考えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210807,
					"content": "まったく、俺だって別に毎回悪い方に考えてるわけじゃないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210808,
					"content": "ただ合理的で包括的な推測をしただけだ。みんなに悪意はないと知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210809
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210809,
					"content": "僕の記憶はまだ完全なものじゃない、だが欠けている部分もどんどん減ってきた。もうすぐ全回復するだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210810
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210810,
					"content": "それに、なんだか感じるんだ…前に進めば、晴之介に会えるかもしれないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210811
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210811,
					"content": "この陰陽寮は、別に最近できたものってわけじゃないんだろ？その人はこの中にずっといるのか？うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210812,
						400210813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210812,
					"content": "「式大将」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				},
				{
					"id": 400210814,
					"content": "旅人？ちょっと待て、あんたもしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210815
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210815,
					"content": "#やっぱり{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}から話す必要がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210816
					]
				},
				{
					"id": 400210816,
					"content": "みんなの真剣な表情から察するに…とても重要なことみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210817
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210817,
					"content": "でも、真剣すぎてもあれだろ？ここはもう十分不気味なのに、これだとなんか内輪揉めしてるみたいだ！やっぱりオイラが言うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210818,
					"content": "あの時、秘境から魔物が逃げ出してるって聞いて、天領奉行の武士たちと一緒にここまで来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210819,
					"content": "オイラたちがおまえに会った時、おまえは秘境の由来をまったく知らなかった。それどころか、自分がなんで生まれたのかさえも…でもオイラたちは、あの時おまえが本当になにも知らなかったって信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210820,
					"content": "たとえおまえを信じられなくても、オイラたちは辛炎を信じてる。辛炎がおまえを認めたのなら、オイラたちもおまえと一緒に行動を取る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210821,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210822
					]
				},
				{
					"id": 400210822,
					"content": "探索が進むにつれて、オイラたちは秘境の深くに入り、真相がすぐ目の前のところまで来た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210873
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210873,
					"content": "でも今に至るまで、この秘境が…邪悪な目的で創造されたかどうか、まだ判断できていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210823,
					"content": "箱には宝も災いも入っている可能性がある。つまりオイラたちは、その箱を開ける最後の瞬間にまで来たんだ！警戒もなしに開けるわけにはいかないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210824,
						400210825,
						400210826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210824,
					"content": "もし惟神が悪意を持っていたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210827,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210828
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210828,
					"content": "アタイは他人が後戻りできない選択をするのを見るのが好きじゃない。だけど…旅人が言ったように、アタイたちは十分な準備をして、お互いに責任を持つ必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210829
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210829,
					"content": "分かった…どうやら僕が決断を下す時が来たようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210830
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210830,
					"content": "ここまで、僕はずっと謎に包まれたまま君たちの助けを受けてきた。たとえ短い間しか共に戦っていないとしても、お互いに秘密があってはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210831
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210831,
					"content": "今ある情報では、まだ保証はできない。僕は晴之介を信じたい、でもこの年月を経て、彼が変わっていないかどうかは分からない。それか、僕の記憶が偽りのものだという可能性もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210832
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210832,
					"content": "僕は「陰陽師」によって作られた「式神」で、記憶も不完全だ。君たち4人こそ、今の僕にとって完全に信頼できて、すべてを託せる人たちなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210833
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210833,
					"content": "僕は君たちを信頼している。だけど晴之介への…責任もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210834
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210834,
					"content": "彼は僕を創造してくれた、僕は彼に付き従う義務がある。もし君たちの言った通り、彼が悪者だった場合、彼に制御されるのも僕の運命だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210835
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210835,
					"content": "できることなら、この善良な心を最後まで持ち続けたい。でも道具は主の意志に逆らってはならない。彼が僕を創造したというのなら、僕を制御することができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210836
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210836,
					"content": "もしこれから僕と晴之介が、天に背き道理に反することをしでかしたら、その時は…君たちが、僕たちのために相応しい最後を与えてくれると信じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210837
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210837,
					"content": "うぅ…最終的に難題をオイラたちに投げるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210838,
					"content": "でも意外と誠実だったな。それに責任感のあることも言ってたし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210839
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210839,
					"content": "#{NICKNAME}、この答えなら、おまえも納得できるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210840,
						400210841
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210840,
					"content": "うん、「式大将」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210842,
					"content": "あんたら…事前に話し合って、演技してたのか？片方が疑う役で、もう片方が信じる役を演じるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210843
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210843,
					"content": "アハハッ、いい方法だね。この方法なら、「式大将」の記憶にまだ欠けている部分があるかどうか試すことができる…旅人、成長したね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210844
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210844,
					"content": "なにが「試す」だ！オイラたちは緻密な計画を立てて、一発で成功させたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210845
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210845,
					"content": "辛炎が言ってただろ？あいつはあいつのやり方で、信用できるかどうか確かめるって。だったらオイラたちも、オイラたちのやり方がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210846
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210846,
					"content": "それに、今これを言えば、「式大将」を励ますこともできるしな！たとえあいつが迷ってても、オイラたちはあいつを信じてて、一緒に前へ進む。このことを、あいつにわからせてあげたかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210847
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210847,
					"content": "もし「式大将」が本当に仲間だったら、すぐに敵味方を選ぶようなことはしない。自分自身に存在する脅威を正直に言えてこそ、仲間に対して責任を持っていると言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210848
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210848,
					"content": "誠実さが感じられた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210849
					]
				},
				{
					"id": 400210849,
					"content": "僕は嘘が得意じゃない…僕の心からの気持ちを感じ取ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210850
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210850,
					"content": "善人でも他人を騙し、他人を利用する時がある。その逆で、悪人にも懸念や心配事があるというものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210851
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210851,
					"content": "自分にとって残忍ともいえる答えを口にできたということは…たしかに覚悟を決めているということだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210852
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210852,
					"content": "辛炎が言ってたように、えっと…なんて言うんだっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210853
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210853,
					"content": "なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210854
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210854,
					"content": "あっ、思い出した！「この言語はすごく誠実で、人の心の奥底にある最も正直な部分を動かすんだ」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210855
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210855,
					"content": "一文字も間違わないなんて、あんたよくそんなの覚えてたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210856
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210856,
					"content": "それで、戦う前の決起会は終わったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210857
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210857,
					"content": "終わったなら行こうか、速戦即決だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210858
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210858,
					"content": "「式大将」、心配するな。アタイたちがあんたのそばにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210859
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210859,
					"content": "分かっている。僕も全力を尽くす、君たちに面倒はかけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210860
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210860,
					"content": "かけても大丈夫だ！最終的にオイラたちが勝てればな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210861
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210861,
					"content": "肝心な一戦で勝ちさえすれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210862
					]
				},
				{
					"id": 400210862,
					"content": "いや、最悪の事態にも備えておく必要がある。この扉の向こうが秘境の奥深くではなく、仕掛けに繋がっていたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210863
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210863,
					"content": "おいおい、縁起でもないこと言うなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210864
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210864,
					"content": "もしもの話だよ。そうならないという保証は誰にもできない、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210865
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210865,
					"content": "残念なことに、確かにそうだ。今の僕ではそれを防ぐことはできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210866
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210866,
					"content": "僕はまだここを完全に掌握したわけじゃないんだ、すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210867
					],
					"speakerTitle": "「式大将」"
				},
				{
					"id": 400210867,
					"content": "俺は別になんとも思ってないよ。聖地に挑戦できるまたとないチャンス、もう10回再構築してくれてもいいくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210868
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210868,
					"content": "うぅ…オイラはいやだぞ。楽しみたいならおまえ一人で行ってこいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210869
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400210869,
					"content": "とにかく、もし再構築が起きたら、君たちは自分の安全を確保した上で、できる限り集まって行動するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210870
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210870,
					"content": "あんたは？また戦いに行っちまうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210871
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400210871,
					"content": "心配いらないよ、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210872
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210872,
					"content": "もちろん、すべての危険を楽しむから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210841,
					"content": "今なら完全に信用できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210825,
					"content": "もし彼が稲妻に危害を加えようとしていたら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210826,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}はこっちの味方でいてくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210813,
					"content": "打ち明けたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				}
			]
		},
		{
			"id": 4002109,
			"completionStepIds": [
				4002109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
