			"dialogs": [
				{
					"id": 200180101,
					"content": "ありがとう、旅人…はぁ、絶対やらかすって分かってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "怖がっているメイガー"
				},
				{
					"id": 200180102,
					"content": "酒を運ぶ仕事も失敗するなんて、俺はどうすればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "怖がっているメイガー"
				},
				{
					"id": 200180103,
					"content": "きっとこのままクビにされるんだ。コナーさんには前からだめだって思われてるかもしれないし、エルザーさんはすでに解雇通知書を用意してるかもしれない。終わった、なにもかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "怖がっているメイガー"
				},
				{
					"id": 200180104,
					"content": "お、落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "はあ、もう終わったんだ。でも酒は運ばないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "怖がっているメイガー"
				},
				{
					"id": 200180106,
					"content": "車も壊れたし…旅人、材料を探してきてくれないか？<color=#00E1FFFF>丈夫な木の板</color>があればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "怖がっているメイガー"
				}
			]
		},
