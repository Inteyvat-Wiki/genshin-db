			"dialogs": [
				{
					"id": 140220201,
					"content": "あ、来たわね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220202
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220202,
					"content": "千織！服の制作は順調か？ちょっと疲れてるように見えるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220203,
					"content": "あともう少し工程が残ってるけど、エローフェに任せてあるわ。夜のファッションショーには間に合うはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220204
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220204,
					"content": "時間ぎりぎりだな、ハラハラするぞ…でも、おまえはファッションショーに行かなくて大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220205,
					"content": "安心して、ユーサーの件もファッションショーも負ける気はないから。それに今夜はファッションショーの関係でユーサーの工房も稼働してないから、証拠を探す唯一のチャンスなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220206
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220206,
					"content": "あいつが先に悪さをしたのは事実だけど、こうやって無断で入るのも犯罪なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220207,
					"content": "やつの工房は普段から見学を受け付けてるのよ。今日は稼働してないとは言ってるけど、見学不可だなんて言ってないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220208
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220208,
					"content": "私たちはただの好奇心旺盛なお客さんってだけ。何か問題でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220209
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220209,
					"content": "まあ、おまえがそう言うなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220210,
					"content": "さ、あれがユーサーの工房よ。時間がないから、急ぎましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220211
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220211,
					"content": "えっ…なんであんなところに建てたんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220212,
					"content": "販売戦略の違いね。「千織屋」は高級品のオーダーメイド、やつは薄利多売。あそこに建てたのも、たぶん賃料が安いからでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220213
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220213,
					"content": "なるほどな。でも、薄暗くて不気味だし、オイラだったら絶対にあんなところで服を買わないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220214,
					"content": "まったくその通りね。ここから気を引き締めていくわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				}
			]
		},
