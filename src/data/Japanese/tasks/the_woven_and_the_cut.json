						],
						"pointId": 7889
					}
				]
			},
			"dialogs": [
				{
					"id": 140220901,
					"content": "お待たせ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220902
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220902,
					"content": "そんなに待ってないぞ。でも、なんでわざわざここで渡すんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220903,
					"content": "…はい、これ。受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220904
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220904,
					"content": "これって…ブローチか？おっ、「千織屋」のロゴだな。ん？オイラの分もあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220905,
					"content": "まだ二つしか作ってないのよ。色々考えたけど、やっぱり君たちに贈ることにしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220906,
						140220907
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220906,
					"content": "ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				},
				{
					"id": 140220908,
					"content": "今回、君たちにはかなり助けられたでしょ。それにずっと一緒にいてくれたしね…本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220909
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220909,
					"content": "君たちの信頼に応えるためにも、絶対に負けちゃいけないって、そう自分に言い聞かせてたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220910
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220910,
					"content": "でも、一番の功労者はやっぱり千織だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220911,
					"content": "ううん、違うの。これだけははっきり言える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220912
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220912,
					"content": "「夢」に向かって長年走り続けてきて、気づいたことがあるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220913
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220913,
					"content": "自分自身の信念や忍耐も重要だけど、一番大切なのは支えあえる仲間だってことにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220914
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220914,
					"content": "独りでできることはたかが知れてる。もし今回君たちが助けてくれなかったら、私は本当に何もかも失ってたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220915
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220915,
					"content": "それはちょっと大げさじゃないか…それより、ファッションショーでおまえが言ってたことのほうがオイラは気がかりだぞ。もし千織屋の服を買う人がいなくなったらどうすんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220916,
					"content": "たしかに偉そうな言い方だったかもしれないけど、私の素直な気持ちでもあるの。世間に妥協したくないし、ましてや誰かの言いなりにもなりたくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220917
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220917,
					"content": "これだけは自信を持って言えるわ。「千織屋」の服は最高の品だってね。いいものは必ず人々に認められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220918
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220918,
					"content": "へへ、なら心配する必要はないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220919,
					"content": "じゃ、そろそろ打ち上げに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220920,
					"content": "ええ、そうね。でももう少しだけ、今夜の景色を眺めていたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220921
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220921,
					"content": "だって、フォンテーヌに来てから最も美しい夜を、こうして見ることができたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				},
				{
					"id": 140220907,
					"content": "大切にするね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				}
			]
		},
