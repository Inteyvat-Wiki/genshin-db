			},
			"dialogs": [
				{
					"id": 140220701,
					"content": "…やっと入口まで戻ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220702,
					"content": "…ほう？これは予想外だな。下の包囲から抜け出すとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220703
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220703,
					"content": "ユーサー！もう逃げ道はないぞ！おまえの工房で犯罪の証拠を手に入れたからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220704,
					"content": "その証拠を握ってるお前らが、ここから出られるって根拠はあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220705
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220705,
					"content": "また警備ロボ…本当に懲りないのね。そんなことにつぎ込むモラがあるなら、もっとまともなことに使ったらどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220706
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220706,
					"content": "俺にとっちゃ、これがまともなことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220707
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220707,
					"content": "「千織屋」を潰すこと？それとも、君の薄汚い服を作ること？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220708
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220708,
					"content": "「ファッション」が、ただの滑稽な茶番劇にすぎないと証明してやることだっ！無知なやつらが集まって騒ぎ立ててるだけでしかないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220709
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220709,
					"content": "…君は「ファッション」の時流にとらわれすぎよ、ユーサー。無暗に合わせるのではなく、自分が作りたいものを作って、その時流を変えてみせるべきだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220710
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220710,
					"content": "この期に及んで説教はやめろ！いずれお前も、「ファッションの時流」に屈するときが来るぞ。結局のところ、ファッションとは「世論」の一種に過ぎないんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220711
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220711,
					"content": "ううん、「ファッション」とは、ある理念に対する人々の憧れを指すの。そして「千織屋」の理念は、絶対に屈しないということ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220712
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220712,
					"content": "フン！ファッション業界の寵児こと「千織屋」がどん底に陥ったとき、その理念がどれだけバカげたものか、皆も気づくだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220713
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220713,
					"content": "君のそのくだらない思い込みを証明するために、私のブランドに手を出したの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220715
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220715,
					"content": "…昔の君はこんなんじゃなかった。人々の心を動かす作品を作りたいと意気込んでたユーサーは、一体どこに行ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220716
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220716,
					"content": "現実離れした夢を追うことが、どれだけバカげたことか気づいただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220717
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220717,
					"content": "…自分の夢を諦めた挙句、今やそれを蔑むなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220718
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220718,
					"content": "すべてを見透かしたかのように君は思い込んでるけど…自分が諦めた道が間違ったものだと証明したいだけでしょ？そうやってただ自分自身をごまかしてるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220719
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220719,
					"content": "正直、今の君は本当に情けないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220720
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220720,
					"content": "情けないのは、「テイワット全土に自分のブランドを広める」なんて白昼夢を見てるお前のほうだ。フォンテーヌにすらいられなくなるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220721
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220721,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220722
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220722,
					"content": "…君の言う通り、夢を追う人はみんなバカかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220723
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220723,
					"content": "でも、そんなバカになる勇気すらない弱虫共のほうが、よっぽど情けないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220724
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220724,
					"content": "なんだとッ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220725,
						140220726
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220725,
					"content": "…千織、先に行ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				},
				{
					"id": 140220727,
					"content": "そうだぞ、ここはオイラたちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220728,
					"content": "ううん、君たちこそ先に行ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220729
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220729,
					"content": "えっ？でも…あいつ、銃を持ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220730,
					"content": "大丈夫。先に会場に行って、計画通り進めてってみんなに伝えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220731
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220731,
					"content": "ここは、私が直々にあいつを懲らしめてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220732,
						140220733
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220732,
					"content": "…分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220734,
					"content": "…千織、絶対間に合わせろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220735,
					"content": "行かせるものか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220736
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220736,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140220737
					]
				},
				{
					"id": 140220737,
					"content": "君と協力関係にあった過去に免じて、今までは大目に見てあげてたけど、ユーサー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220738
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220738,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220739
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220739,
					"content": "君の工房を「見学」させてもらって、考えが変わったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220740
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220740,
					"content": "フン…この期に及んでなお、口が減らないとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220741
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220741,
					"content": "過去に何を経験して、どんな理由があったとしても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220742
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220742,
					"content": "私の友人の言葉を借りれば——可哀想だなんて、これっぽっちも思えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220743
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220743,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220744
					],
					"speakerTitle": "ユーサー"
				},
				{
					"id": 140220744,
					"content": "「千織」というブランドに込められた意味を、しかと教えてあげる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				},
				{
					"id": 140220733,
					"content": "…くれぐれも気をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220726,
					"content": "…ファッションショーのほうが大事だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				}
			]
		},
