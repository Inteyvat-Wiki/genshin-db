			"dialogs": [
				{
					"id": 140221201,
					"content": "なんか、すごく汚いな。上にある服って、本当にここで作られたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221202,
					"content": "…あっちを見て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221203
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221203,
					"content": "うぇ…水がめちゃくちゃ汚れてる。ここまで異臭が漂ってくるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221204,
					"content": "ユーサーのやつ、よくもうちの材料に問題があるって言えたものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221205
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221205,
					"content": "汚い手口で経営してるのは、あいつのほうじゃんかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221206,
					"content": "彼の作った服は手触りがおかしいなって思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221207
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221207,
					"content": "コストを抑えるために、工房でこっそり小細工をしてたってわけね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221208
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221208,
					"content": "こんな風に作られた服を着て、本当に大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221209,
					"content": "色褪せや、服が縮む問題はさておき、不正規の材料を使った服を着続けると…肌のトラブルを引き起こしかねないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221210
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221210,
					"content": "ひどすぎるぞ…早くこの証拠を撮っとこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221211,
					"content": "これであいつも法廷で言い逃れできないだろ！引き続き先へ進もうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
