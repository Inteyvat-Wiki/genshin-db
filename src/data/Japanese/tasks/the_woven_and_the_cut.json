			"dialogs": [
				{
					"id": 140220801,
					"content": "…これでどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220802
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220802,
					"content": "もうちょい左。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220803
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220803,
					"content": "…こう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220804
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220804,
					"content": "うん、完璧ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220805
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220805,
					"content": "よいしょっと…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220806
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220806,
					"content": "わぁ！いいわね！千織さん、写真を撮ってもいいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220807
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140220807,
					"content": "もちろんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220808
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220808,
					"content": "千織お姉さんがお店のロゴを作ってたなんて、全然知らなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220809
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220809,
					"content": "ファッションウィークが始まる前から用意してたのよ。ファッションショーで結果を出せたら、掲げようと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220810
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220810,
					"content": "テイワットを席巻するなら、ブランドロゴぐらいないと。その点においては、「棘薔薇の会」のほうがリードしてたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220811
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220811,
					"content": "言われてみれば、うちの魔術団もロゴを作ったほうがいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220812
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140220812,
					"content": "なら、そのロゴにはお兄ちゃんと私のトレードマークの「ファニーハット·キャット」と「ビックラキャット·ボックス」、それからペールスも描かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220813
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140220813,
					"content": "じゃあ、ペールスのことは…「ハラペコクール·ペンギン」とでも呼ぼうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220814
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140220814,
					"content": "ぷっ、あはははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220815
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220815,
					"content": "じゃあ帽子の中に、二匹の猫と一匹のペンギンが詰め込まれてる感じ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220816
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220816,
					"content": "わぁー、あったかそう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220817
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220817,
					"content": "狭そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220818
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140220818,
					"content": "千織さん、写真もばっちり撮れたし、旅人が渡してくれた証拠と合わせて、明日の『スチームバード新聞』に載せられると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220819
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140220819,
					"content": "ありがとう、シャルロット。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220820
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220820,
					"content": "気にしないで。人々に真相を伝えるのは、記者として当たり前のことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220821
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140220821,
					"content": "お礼に今度から「ヴェリテくん」の衣装は、全部無料で仕立ててあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220822
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220822,
					"content": "きゃーっ！ほ…本当にいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220823
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 140220823,
					"content": "もちろんよ。リネとリネットも遠慮しないで。今後、公演で着たい衣装があれば、いつでも言ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220824
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220824,
					"content": "ステージ衣装以外はダメ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220825
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140220825,
					"content": "恩に着るよ、千織さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220826
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140220826,
					"content": "あたしはなーにもいらないからね！代わりにちょこちょこ顔を見せに来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220827
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220827,
					"content": "わたしも何もいらないよ。これからも国際配達を頼むときは、わたしを指名してくれれば、それで十分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220828
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220828,
					"content": "あ、そういえば、綺良々はいつ帰るの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220829
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220829,
					"content": "あっ！えーっと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220830
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220830,
					"content": "「棘薔薇の会」で人力車を手配しておいたから、綺良々を乗せて、みんなで送ってあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220831
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220831,
					"content": "そ、それは恥ずかしすぎるにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220832
					],
					"speakerTitle": "綺良々"
				},
				{
					"id": 140220832,
					"content": "へへ、オイラたちもなにかお礼がもらえるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220833,
					"content": "もちろん。あとで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220834
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220834,
					"content": "会場の秩序を乱し、スポットライトを無断で利用。また公共の場での武器使用、および事前申請なしに危険な演目を実施…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220835
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220835,
					"content": "うっ…シュヴルーズ、オイラたちの説明を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220836
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220836,
					"content": "…今述べた事項に該当する者を見かけたら、特巡隊隊長——シュヴルーズまで報告するように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220837
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220837,
					"content": "罪状を並べるのは楽しい？びっくりしたじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220838
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220838,
					"content": "こっちのセリフだ。次また会場であんなことをするなら、事前に知らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220839
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220839,
					"content": "もし事前に君に知らせてたら、許してくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220840
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220840,
					"content": "いや。だがせめて驚くことはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220841
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220841,
					"content": "それなりの見返りもあったでしょ？有害な商品を生産するサーンドル河の腹黒工房の主を、ご丁寧に縄で縛りつけてあげたじゃない？行き届いたサービスだと思うけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220842
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220842,
					"content": "まぁそういうことにしておこう。今日のところは譲っておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220843
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220843,
					"content": "まあまあ、ここにいる人はみんな友達なわけだし、これからみんなでご飯に行かない？「棘薔薇の会」がおごるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220844
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220844,
					"content": "私はいい。まだ処理をしないといけない手続きがたくさんあるのでな。皆で楽しんできてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220845
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220845,
					"content": "そうだ、千織。ここに来る途中、ヴェンゲルさんに会った。お前への伝言を預かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220846
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220846,
					"content": "はいはい、どうせ「すまない」とか謝ってたんでしょ？わざわざ伝えてくれなくても結構。日を改めて彼の店に行って、笑ってやるつもりだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220847
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220847,
					"content": "当たりだ。彼のことをよく知ってるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220848
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220848,
					"content": "君にもお礼を言っておくわ、シュヴルーズ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220849
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220849,
					"content": "当たり前のことをしたまでだ。それと、もう一つだけ言わせてもらおう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220850
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220850,
					"content": "さっきのパフォーマンスは素晴らしかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220851
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 140220851,
					"content": "当然でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220852
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220852,
					"content": "さっ、打ち上げに参加する人は回れ右して、あたしについてきてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220853
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140220853,
					"content": "旅人、パイモン、「景色のいいところ」でちょっと待っててくれる？ナヴィアには少し遅れるって言っとくから。君たちに渡したいものがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220854
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220854,
					"content": "景色のいいところ？あっ！あそこだな！わかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220855
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140220855,
					"content": "うん、すぐ行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				}
			]
		},
