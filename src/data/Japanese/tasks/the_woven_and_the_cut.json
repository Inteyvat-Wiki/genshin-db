					}
				]
			},
			"dialogs": [
				{
					"id": 140221401,
					"content": "見た感じ、倉庫っぽいな。うぅ…ここもひどいニオイがするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221402,
					"content": "えっ！来た道が塞がれたぞ！どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221403,
					"content": "#{M#俺}{F#私}たちを工房に閉じ込めるつもりみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140221404
					]
				},
				{
					"id": 140221404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221405
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221405,
					"content": "私たちが来ることを予測してたみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221406
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221406,
					"content": "そういえば千織、ユーサーはおまえのことをよく知ってるって、前に話してたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221407,
					"content": "うん、実は…ユーサーは創業当時の経営パートナーなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221408
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221408,
					"content": "えっ？ぜんぜんそういう風には見えなかったぞ！あんなに仲が悪いのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221409,
					"content": "フォンテーヌに来たばかりの頃、私も彼もデザイナーとして「ファッション」の舞台に憧れてた。その共通の目標に向かって、一時期協力してたことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221410
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221410,
					"content": "伝統に囚われず、他人とは一線を画したデザインで、人々の目を奪うような服を作りたい…それが私たちの夢だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221411
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221411,
					"content": "けど、周りからの不評を耳にし、投資家たちに首を横に振られるたび…ユーサーは自信を失っていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221412
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221412,
					"content": "そしてファッションウィークの前夜、彼は理想の服を作ることは無理だと結論づけ、私と決裂したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221413
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221413,
					"content": "私は一か八かの覚悟で、すべてを賭けて臨んだわ…最後の日にやっと納得のいく服を仕上げて、不安を抱えながら、ファッションショーに赴いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221414
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221414,
					"content": "その結果、千織は一躍有名になって、一方夢を諦めたユーサーは、不正な手段で服を売り始めた…ってわけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221415,
					"content": "具体的な事情は私も知らないけど、「千織屋」を開店して以来、彼が毎年のようにちょっかいをかけてきたのは事実よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221416
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221416,
					"content": "くぅ～！おまえの成功にやきもちを焼いてるだけじゃんかよ。可哀想だなんて、これっぽっちも思えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140221417,
					"content": "とりあえずは、ここから出る方法を考えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221418
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221418,
					"content": "ファッションショーに間に合わなくなったら、やつの思うつぼだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221419
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221419,
					"content": "あっ、あそこに操作台がいくつかあるぞ！なにか押せるボタンがないか見てみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
