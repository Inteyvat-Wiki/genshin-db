			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "ああ、君たちか。前に宝石を売ってくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590102,
					"content": "おう、この前、オイラたちから買い取った宝石できれいなアクセサリーを作るって言ってたよな？もうできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590103,
					"content": "すごく楽しみにしてたんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590104,
					"content": "それが…君たちをがっかりさせるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590105,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590106,
					"content": "宝石が嵌め込まれたアクセサリーにしたいけど、この鉱石は硬度が高すぎて、手細工で研磨するのも難しすぎるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590107,
					"content": "しかも一番困るのは、鉱石を分割して磨いた後、あろうことか、鉱石の当初の光沢がなくなることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590108,
					"content": "とにかく、工芸品を作るにはまったく向いてなくってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590109,
					"content": "うぅ、それは予想外だな。この石にはなんらかの使い道があるって思ってたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590110,
					"content": "使い道って言ったら、完全にないわけでもないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590126,
					"content": "そう言いながら、チェシルは機械時計をカウンターに並べた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "見ろ、今回新しく作った機械時計。あの鉱石を使ってみたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590112,
					"content": "最初は自分に見る目がなかったせいにして、石を処分しようと思ったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590113,
					"content": "加工の失敗した鉱石を見た時計職人さんたちが、鉱石の硬度が高い性質を見込んで、時計内部のコア部品として使ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590114,
					"content": "高い硬度によって摩耗への耐性が高いから、コア部品の材料としては、既存の材料よりも優れるってのが思いもよらない結果だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590115,
					"content": "しかし、時計の部品に使われるとなると、より安定的な供給が必要となる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590116,
					"content": "それならなんとかなる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "プーカと鉱脈についてチェシルに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "なるほど、なんという偶然だ！このプロトタイプの時計は新しく発明された貝式防水構造が採用されていて、最初からメリュジーヌにも快適に使ってもらうために作られたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590120,
					"content": "こうなったら、この時計をプーカさんに届けてくれないか？ついでに前もって少し説明してもらえると助かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590121,
					"content": "私はメリュジーヌと取引した経験がないからな…もしプーカさんが安定した供給を保証してくれるなら、新たな生産ラインを構築できるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590122,
					"content": "後で、私から直接プーカさんを訪ねて相談するよ！時計のデザインに、メリュジーヌのスタイルを取り入れるのもよさそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590123,
					"content": "へへっ、もし成功したら、プーカにとってもいいことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590124,
					"content": "この機会をうまく利用すれば、プーカも自前の宝石工房を持てるかもしれない。プーカのところに戻って話してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590125,
					"content": "それじゃ、よろしくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740590117,
					"content": "直接プーカと連絡を取ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
