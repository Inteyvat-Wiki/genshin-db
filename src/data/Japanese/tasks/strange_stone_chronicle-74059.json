			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME}{M#兄さん}{F#姉さん}とパイモン、久しぶりだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590202,
					"content": "また前回みたいに奇妙な石を集めたいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590203,
					"content": "うーん、確かにそうだけど、説明すると長い話になるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590204,
					"content": "チェシルに渡された時計をプーカに渡し、奇妙な石を使って時計を作りたいというチェシルの考えを伝えた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "す、すごい。その石でこんなものが作れるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590206,
					"content": "うん？いや、石が使われてるのは、コア部品のとこだけだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590207,
					"content": "水の中でもカチカチって動く時計なんて、初めて見た！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590208,
					"content": "えーっと、たしかオイスター式とか、貝式とかの構造が採用されてるってチェシルが言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590209,
					"content": "へへ、時計の音を聞くだけですごく楽しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590210,
					"content": "こんな普通の石にも、ちゃんと使い道があるなんて、思いもしなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590211,
					"content": "以前の私は、姉さんみたいに珍しい宝石がないとすごい作品を作るのは無理だって思ってたんだ。でも、普通の石だってこんなに素晴らしいものが作れるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590212,
					"content": "どんな物にも、使い道はあるんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "うんうん、私なんだか急に自信が湧いてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590214,
					"content": "プーカは見栄えの良い場所に時計を丁寧に置いた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "じゃあ、プーカは鉱石を用意して、後でチェシルに売ればいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590216,
					"content": "そしたら、プーカもお姉さんみたいに、自前の宝石工房を持てるようになるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590217,
					"content": "プーカはいろんな石をいっぱい持ってるから、それぞれの使い道が見つかるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740590218,
					"content": "うんうん、頑張って準備するね。ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590219,
					"content": "もしまたほしい石があれば、いつでも私のところに来てね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740590220,
					"content": "へへっ、気にすんなって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
