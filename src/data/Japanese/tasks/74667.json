			"dialogs": [
				{
					"id": 746670201,
					"content": "星と深淵を目指せ！ようこそ、冒険者協会へ。何かお困り事はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 746670202,
					"content": "ま、またキャサリンだ。こっちも「人形」なのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670203,
						746670204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746670203,
					"content": "きっとそうだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670205
					]
				},
				{
					"id": 746670205,
					"content": "何かお手伝いできることはありますか？依頼を受けに来たのですか、それとも依頼しに来たのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670206
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 746670206,
					"content": "立ち寄っただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670207
					]
				},
				{
					"id": 746670207,
					"content": "そうですか…協会に関する質問があれば、なんでもお聞きください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670208
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 746670208,
					"content": "誠心誠意、完璧なサービスを提供し、お答えできる質問にはすべてお答えいたしますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670209
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 746670209,
					"content": "それでは、協会への貢献に感謝します。冒険の旅が順風満帆でありますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 746670204,
					"content": "それ以外の可能性はないはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670205
					]
				}
			]
		}
	]
