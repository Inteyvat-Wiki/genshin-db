			"dialogs": [
				{
					"id": 760090601,
					"content": "わあっ、やっぱりわたしの思ったとおり！二つの石を一緒に置けば、すごーい事が起きるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090602
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090602,
					"content": "うーん、でもこれでさっき見つけた石もなくなっちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090603,
					"content": "えっ？大丈夫だよ。忘れたの？パイモンお姉ちゃん。石の欠片を探してるのは、マイテを買収するためだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
