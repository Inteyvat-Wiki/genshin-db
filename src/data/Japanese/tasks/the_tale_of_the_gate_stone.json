			"dialogs": [
				{
					"id": 760090501,
					"content": "戻ったぞ！カーシャ、この石はどうだ？キレイだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090502,
					"content": "わっ、もう戻ってきたの？さすがプロの冒険者だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090503
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090503,
					"content": "へへっ、こんなの朝飯前だぜ。何百メートルもある迷路の中で穴を掘るとか、何千メートルも離れた場所で写真を撮るとかってわけでもないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090504,
					"content": "ん～…あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090505
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090505,
					"content": "えっ、どうかしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090506,
					"content": "うん…すごくきれいな石なんだけど、このおっきな石に引き寄せられてる感じがするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090507
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090507,
					"content": "ええっ？オイラには全然わかんないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090508,
					"content": "わたしもはっきり感じるわけじゃないの…なんとなく、そんな気がするだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090509
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090509,
					"content": "そう…マイテも言ってた。レッド・ミラーも月神様の導きを感じてフェイのプリンセスに出会ったんだって。わたしの予感もきっと同じものだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090510
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090510,
					"content": "おお！これが伝説の未来予知…いやいや、月神様もそんな暇じゃないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090511,
					"content": "で…その予感からなにをするべきだって思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090512,
					"content": "うーん…例えば、この石をあそこに戻すとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090513
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090513,
					"content": "#わたしはもう子どもじゃないけど、あんな高い場所には上がれないな…{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、代わりに試してくれない？",
					"roleType": "TALK_ROLE_NPC",
