						],
						"pointId": 12561
					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "うーん…これは違うかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090202,
					"content": "#あれっ？こんにちは。見たことない{M#お兄ちゃん}{F#お姉ちゃん}と、んー…白い精霊のお姉ちゃん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090203,
					"content": "霜月の里へようこそ！なにか困ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090204,
					"content": "#いや、一人でなにしてるのか気になっただけなんだ。あ、オイラはパイモン。こっちは{NICKNAME}だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090205,
					"content": "#よろしくね、{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}とパイモンお姉ちゃん！えっと、ナシャタウンのひとじゃないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090206,
					"content": "#{M#俺}{F#私}たちは冒険者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#ああ。{NICKNAME}とオイラはすっごい冒険者なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090211,
					"content": "いいなぁ。友だちと色んな場所を探検して、色んな風景を見て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090212,
					"content": "おう！いろんな場所を回ってきたんだぜ。おまえはここでなにしてたんだ？なにか探してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090213,
					"content": "うん。きれいな石を探してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090214,
					"content": "あ、わかったぞ。宝物にしてとっておくんだな！大人でもそういうのが好きなやつはいるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090215,
					"content": "えっ、違うよ？きれいな石でマイテを「買収」して、わたしのことをさらってもらうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090216,
					"content": "おお、なるほどな。…って、待て待て！なに言い出すんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090217,
					"content": "何だかただごとじゃないね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#あれ？{M#お兄ちゃん}{F#お姉ちゃん}たち、大盗賊レッド・ミラーとフェイのプリンセスの物語を知らないの？マイテは、よその人は大抵知ってるって言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090221,
					"content": "「さあ、月のように輝く眼差しを持つお嬢さん。君の瞳によく似合う宝石でその心を手に入れ、この金の檻から君をさらってみせよう…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090222,
					"content": "お話の意味はよくわからないけど、相手の好きなものをあげれば、その人と一緒に冒険に行けるってことだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090223,
					"content": "そういう意味じゃないと思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "そ、そうだぞ。そいつってつまり…うああっ、小さい子に聞かせるような綺麗な話じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090227,
					"content": "それにしても、そのマイテってどんなやつなんだ？こんな話を子供に教えるなんて、まさか悪いやつじゃないだろうな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090228,
					"content": "マイテは悪いひとじゃないよ！歳もわたしと近いし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090229,
					"content": "#{M#お兄ちゃんとお姉ちゃん}{F#お姉ちゃんたち}みたいに外からやってきた冒険者なの！一人でキャンプの近くでこそこそしてたのを、わたしが見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090230,
					"content": "なんでか知らないけど、わたしたちのことを「捕らえた子どもを生贄として月神様に捧げる怪しい集団」って思ってたみたい。落ち着いてるように見えたけど「殺さないで」とか言ってたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090231,
					"content": "す、すごい誤解だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090232,
					"content": "でしょ？わたしもマイテがどこからそんな噂を聞いたのかわからないの。ヘンだよね。でもなんだか面白かったから、否定しなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090233,
					"content": "そういうときは否定しなきゃだめだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090234,
					"content": "とにかく、交換条件としてマイテはわたしの親友になることを約束して、外の世界のことをいっぱい教えてくれるようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090235,
					"content": "パパもママも「そういうくだらない話は不信心な者が好むものだ」って言って、外の世界のお話を読ませてくれないんだもん…でも、マイテが聞かせてくれるお話はとっても面白いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090236,
					"content": "精霊に恋をした漁師の話とか、3回死んで冥界を支配するお姉さんのもとから3回も逃げ出した大盗賊の話とか、人間になりたかった人外の話とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090237,
					"content": "優しい人も、優しくない人も、ものすごく悪い人も、大金持ちも貧乏人も、それから正義と悪も、結局最後はみんな同じで、苦難の中で死を迎えるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090238,
					"content": "ご両親の言うことは正しいかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "おう…どれも子供向けって感じの話じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090243,
					"content": "でも、わたしもう子どもじゃないよ。マイテも、外の世界は混沌としてるからわたしみたいな子どもには向いてないって言ったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090244,
					"content": "マイテは月神様{RUBY#[D]クーヴァキ}の祝福も使えないし、歳だってわたしと変わらないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090245,
					"content": "でもいいの。わたし、賢いから！マイテがわたしに捕まる前、ずっと「石」が何とかってつぶやいてたから、きっと彼女の目的はきれいな石を集めることなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090246,
					"content": "<color=#00E1FFFF>きれいな石</color>を見つけたら、きっとマイテはわたしに買収されて、レッド・ミラーがフェイのプリンセスをさらったみたいに、わたしをここから連れ出してくれるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090247,
					"content": "だから「買収」なんて言葉を使うなって！きれいな石を見つけて友だちにあげたいだけなんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090248,
					"content": "うーん…まあ、オイラたちもこれからこの辺を回るつもりだし、もしきれいなのを見つけたら、おまえのところに持ってってやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090249,
					"content": "#わっ、ほんと？ありがとう！{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}、パイモンお姉ちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090240,
					"content": "気になるからもっと教えてほしいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "ん？いいよ。えーっと例えば…レッド・ミラーの仲間で、二度と月光の下に立たないって誓った「カゲイタチ」が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "カーシャ"
				},
				{
					"id": 760090242,
					"content": "おい、今はそんなこと話してる場合じゃないだろ！それに、それも子供向けじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090225,
					"content": "#そう。{M#俺}{F#私}はそうやってパイモンを…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#おい、でたらめ教えるなって！確かにオイラは{NICKNAME}の作る料理が好きだけど…さらったとかじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090218,
					"content": "ナド・クライでは普通のこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "ナド・クライでも普通じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760090208,
