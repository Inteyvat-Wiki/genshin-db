			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王鉗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "思妤？か…彼女が俺に霄灯を？み…見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420502,
					"content": "アハハッ、この願い事は俺のために書いたのか。小さい頃、確かにそんな事言ったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420503,
					"content": "もう何年もあっという間に過ぎたな、懐かしいぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420504,
					"content": "でも、なんでお前さんが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420505,
					"content": "家のことで忙しいみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "おぉ…そうなのか…そうかそうか、いいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420508,
					"content": "元気そうで安心したぜ…はははっ…はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420509,
					"content": "これでいいんだ…おっと…俺はまだ仕事があるから、もう行くぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420506,
					"content": "旦那さんの手伝いをするみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
