			"dialogs": [
				{
					"id": 413420401,
					"content": "ん？旅人じゃないか、俺になんか用か？今忙しいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420402,
					"content": "思妤の霄灯について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
