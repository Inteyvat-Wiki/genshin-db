			"dialogs": [
				{
					"id": 413420901,
					"content": "待たせたな、全部終わったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420902,
					"content": "もう全部終わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420903,
					"content": "ああ、この旅人が手伝ってくれたからな。楽勝だったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420904,
					"content": "お前ってやつは…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420905,
					"content": "祭りなのにそんなしけた面すんなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420906,
					"content": "分かったよ。で、霄灯の準備はできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420907,
					"content": "霄灯…あっ！忘れてたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420908,
					"content": "大丈夫大丈夫、霄灯くらい別にどうってこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413420909,
					"content": "そう言うな。この祭りに霄灯を飛ばさないなんて、ありえないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420910,
					"content": "旅人、悪いけど霄灯をもう一つ用意してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420911,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "ありがとう、ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李槌"
				}
			]
		},
