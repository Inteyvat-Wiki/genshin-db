			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王鉗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "よし、これで足りるぜ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413421203,
					"content": "あと少し仕事が残ってるな…港口で新しく入った物資の点検を手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413421204,
					"content": "3つの箱が港口にあるはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "王鉗"
				},
				{
					"id": 413421205,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "じゃあ頼んだぜ。俺はここの仕事を早く終わらせないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王鉗"
				}
			]
		},
