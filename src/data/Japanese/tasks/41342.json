				"objectNames": [
					"李槌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "この霄灯、思妤が送ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420603,
					"content": "聞こえてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "聞かなくても分かるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420606,
					"content": "去年も同じだったよ。船の上で一人、一晩中釘を打ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420607,
					"content": "気持ちは分からなくもないが、ただ…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420608,
					"content": "旅人、悪いけど彼の手伝いをしてくれないか？祭りなのにあんなことでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420609,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "はぁ…頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420611,
					"content": "多分また船の上に行ってるから…そこに行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420612,
					"content": "俺は食べ物の用意をしてくるから、終わったら一緒に食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李槌"
				},
				{
					"id": 413420604,
					"content": "どうして知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
