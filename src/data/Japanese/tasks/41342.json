			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"思妤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "やっぱり、霄灯を渡しに行こうかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420102,
					"content": "霄灯を…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "あら旅人。そうなの、王鉗さんには小さい頃からお世話になってて。普段も、まるで本当に兄のように色々手伝ってくれてて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420104,
					"content": "でも祭りの時期なのに、まだ仕事してるらしいのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420105,
					"content": "だから霄灯を一つ送ろうかと。まあ、私たち小さい頃から一緒にいたから、彼が霄灯を好きなのは知ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420106,
					"content": "送ったらきっと喜んでくれるわ。旅人、もしよかったら、この霄灯を彼に送ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420107,
					"content": "自分で送らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "私も自分で送りたいけど…家のことで忙しくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420110,
					"content": "今買い物してるから、家のことは旦那が一人でやってるのよ。すぐ帰って手伝わないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420111,
					"content": "霄灯のことはお願いね。後で手が空いたら、旦那と一緒に王鉗さんを訪ねるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420112,
					"content": "王鉗さん時間があるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420108,
					"content": "自分で送った方がいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
