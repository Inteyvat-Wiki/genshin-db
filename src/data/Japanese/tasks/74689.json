					}
				]
			},
			"dialogs": [
				{
					"id": 746890101,
					"content": "（先生の言ってた、金髪の旅人と空を飛ぶ白い妖精って…この人たちかな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890102
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890102,
					"content": "なんだ？さっきからブツブツ…オイラたちの顔になにかついてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890103,
					"content": "あっ！ご、ごめんなさい！悪気はなかったんです！ただ…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890104,
						746890105
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890104,
					"content": "落ち着いて、ゆっくり話して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				},
				{
					"id": 746890106,
					"content": "#えっと…私はニネットと言う者なんですが、師匠のレピーヌ・ポーリーン先生が言ってたんです。伝説の冒険者{NICKNAME}さんは、最高の相棒パイモンさんとご一緒だと…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890107
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890107,
					"content": "お二人のことですよね…？まさか、本当にお会いできるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890108
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890108,
					"content": "おおっ！レピーヌ・ポーリーンの弟子か！あいつ、最近うまくやってるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890109,
					"content": "はい！先生のおかげで、私は人生の底から這い上がれたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890110
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890110,
					"content": "いったい何があったの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890111
					]
				},
				{
					"id": 746890111,
					"content": "私、以前は別の方に写真を教わっていまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890112
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890112,
					"content": "一人前のカメラマンになれるよう、貯金を全部つぎ込んで、当時、一番高価だった撮影設備一式を買い揃えたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890113
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890113,
					"content": "先生からも悪くない腕だと言われて…いい写真さえ撮れれば、必ずお金を稼げると思ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890114
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890114,
					"content": "でも…でも私、街に出ていざ人を目の前にすると緊張しちゃって、一言も話せなくなっちゃうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890115
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890115,
					"content": "「こんにちは、写真撮影はいかがですか？」…そう声をかけたいのに、言葉が詰まって、どうしても出てこなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890116
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890116,
					"content": "結局、お客さんたちはみんな、積極的で話し上手なカメラマンの方へ行ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890117
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890117,
					"content": "その後、モラもほとんど底をついて…大切な写真機を売って生活費に充てようかとまで考えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890118
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890118,
					"content": "大変だったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890119
					]
				},
				{
					"id": 746890119,
					"content": "レピーヌ・ポーリーン先生と出会ったのは、そんな時でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890120
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890120,
					"content": "先生は私の機材と写真を見て、励ましてくれて…新しいレンズのテストも手伝わせてくださったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890121
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890121,
					"content": "…私の撮った写真には、他の人にはない静けさと優しさがあるって言ってくれたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890122
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890122,
					"content": "だから！師匠がこの「瞬影」レンズの開発に成功した時、私は誰よりも喜びました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890123
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890123,
					"content": "「瞬影」レンズ？どんなレンズなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890124,
					"content": "高速で動く人物の姿勢や表情を鮮明に捉えられるんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890125
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890125,
					"content": "今はテストの最終段階なんですが…性能検証として、実地で大量のデータを収集しないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890126
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890126,
					"content": "先生はずっとお忙しいので、この仕事は私に任せてくださいました。そこで、テストに付き合ってくださる方を探して、手伝ってもらおうとしたんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890127
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890127,
					"content": "でも…でもまた、いつもの癖が出ちゃって。知らない人に声をかけようとすると、緊張で言葉が出てこなくなっちゃうんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890128
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890128,
					"content": "みんな怪訝な目で私を見てました。きっと、怪しい人だと思われたんだと思います…数日経つのに、結局まだ手伝ってくれる人は見つかっていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890129
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890129,
					"content": "うぅっ…こんなことすらできないなんて、私って本当にダメ人間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890130
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890130,
					"content": "わわっ、泣くなよ…！頑張ったんだろ？お前も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890131,
					"content": "知らない人にいきなり頼み事をするのって、難しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890132,
						746890133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890132,
					"content": "自分を責めないで。努力はしたんだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890134,
					"content": "#そうだぞ！{NICKNAME}なら撮影の腕もピカイチだし、大陸中に友達がいるから、モデルを見つけるのなんか朝飯前だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746890135,
					"content": "ほ、本当ですか？て…手伝ってくださるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890136
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890136,
					"content": "わぁ——！本当に、本当にありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890137
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890137,
					"content": "「瞬影」レンズを搭載した特製の写真機をお渡ししますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890138
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890138,
					"content": "どうか、お友達の一番いきいきとした、その人らしい瞬間を撮ってきてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニネット"
				},
				{
					"id": 746890133,
					"content": "#それに、{M#俺}{F#私}たちが手伝えると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890105,
					"content": "#{M#俺}{F#私}のこと、知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				}
			]
		}
	]
}