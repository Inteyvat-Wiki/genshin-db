			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィナヤック",
					"シュリヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735170101,
					"content": "…つまり結論から言えば、やはり「対ウェネト殺蟲大砲」に頼る必要があったんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170102
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735170102,
					"content": "ぜんぶひっくるめないで！それから「僕の意見を素直に受け入れればよかったのに」みたいな顔をするのもやめて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170103,
						735170104
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170103,
					"content": "なんでまた始まったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				},
				{
					"id": 735170105,
					"content": "あっ、冒険者さん！あのね、私、この事件の原因を解明したのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170106
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170106,
					"content": "——ウェネトが地下で頻繁に活動していることが原因で、この地域の元素エネルギーに乱れが生じているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170107
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170107,
					"content": "そして乱れたエネルギーが、今度は逆にウェネトの習性に影響を与えて、大地を暴れまわらせる…そんな風にして、環境バランスの崩壊が加速してるってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170108
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170108,
					"content": "「対ウェネト殺蟲大砲」のチャージ装置に効率異常が発生したのも、ここの元素エネルギーが乱れているからだったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170109
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170109,
					"content": "だろうと思ったよ。僕の設計した機械が、これほど簡単に故障なんかするはずないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170110
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735170110,
					"content": "使用環境を考慮しなかったっていうのは、設計の問題じゃないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170111,
						735170112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735170111,
					"content": "ウェネトの過度な活発化が原因なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170113,
					"content": "つまり、あれだけ回り道して、結局たどり着いたのは最初と同じ結論ってわけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170114
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735170114,
					"content": "何をやるのか知ることと、何故それをやるのかを知ることは全然別ものよ。学者のくせして、それくらいのことも分からないっていうの？それに、私の推論はまだ終わってないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170115
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170115,
					"content": "一般的には、環境の安定性を保つために、大自然は自ら個体群の生態とその行為を制限するものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170116
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170116,
					"content": "だけど、今回は乱れたエネルギーによって、このバランス機能が無効化され、また同時にウェネトを異常に活発化させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170117
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170117,
					"content": "つまり、元素環境さえ通常状態に戻れば、ウェネトの動きを抑えられる。ちょっと時間が経てば、このバランスも自然に回復してくれるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170118
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170118,
					"content": "元素エネルギーの調整ってことか？そんなこと、どうやってやるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735170119,
					"content": "そうね、まずは元素エネルギーが最も溜まっている「ノード」がどこなのか計算する。加えて、エネルギーの流れを導くことのできる装置を使えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170120
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170120,
					"content": "…溜まったエネルギーを外に導けるわ。あとは大自然の自己調整に任せていいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170121
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170121,
					"content": "「ノード」の場所は既に計算できていて、すぐ近くよ。そしてエネルギーの流れを導く装置なら、私たちは既に持ってるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170122
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170122,
					"content": "まさか…対ウェネト殺蟲大砲のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170123
					]
				},
				{
					"id": 735170123,
					"content": "ご明察。「対ウェネト殺蟲大砲」なら、周りの元素エネルギーを吸収して、一気に発射できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170124
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170124,
					"content": "これからの計画だけど、そこに「対ウェネト殺蟲大砲」を設置して、昨日の手順を一通りやればいいと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170125
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170125,
					"content": "でも、その間も魔物やウェネトを引き付けてしまうでしょうから…まあ、場合に応じて数を減らすのも、自然調整の進捗を加速につながると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170126
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170126,
					"content": "——つまり結論から言うと、やはり「対ウェネト殺蟲大砲」でやつらに一発かます必要があると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170127
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735170127,
					"content": "ちょっと…！その「僕の意見を素直に受け入れればよかったのに」って顔をやめてったら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735170112,
					"content": "解決策はやっぱりウェネトを倒すこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170104,
					"content": "今度はなんのために言い争ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				}
			]
		}
	]
}