			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ユーフラシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "新しい仕事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "あら？「人生いろいろ」の仕事にやりがいを見いだせていないようね。それとも、最近は懐が寂しくてモラが足りていないのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490103,
					"content": "モラはいくらあっても困らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "ええ、そう思うのが普通よね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490107,
					"content": "ここには依頼がいくらでもある。冒険者協会を除けば、スチームバード新聞社はおそらく、フォンテーヌ廷中で最も依頼情報が集まる場所でしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490108,
					"content": "普通に考えたら、私たちがそんな社会的役割を担う必要はないのだけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490109,
					"content": "とにかくモラが欲しいのなら、長期の仕事を紹介するわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490110,
					"content": "これはルロワさんが半年以上前に、うちの「人生いろいろ」コーナーにくれたメッセージよ。ルロワさんのことは、この街の人間ならみんな知っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490111,
					"content": "若い頃はあまり評判がよくなかったけれど、ここ数年は悪い噂を聞かなくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490112,
					"content": "ずっと独りで暮らしていて、たった一人の娘さんも近くにいないからお世話をする人がいないの。確かにヘルパーのアルバイトが必要ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490113,
					"content": "私の知る限り、ルロワさんはお金には困っていないわ。だから、お給料もそれなりのはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490114,
					"content": "この仕事なら特にリスクもないし、報酬も満足いくものだと思うわ。よかったら検討してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490115,
					"content": "家事を手伝うだけでいいんだろ？オイラはいい仕事だと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490116,
					"content": "住所を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "ええ。ルロワさんのお宅は二つ先の角を曲がって、それから迂回して…ああ、それよりも地図をあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490118,
					"content": "私からの紹介だって、忘れずに伝えてちょうだいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ユーフラシア"
				},
				{
					"id": 741490105,
					"content": "どっちもだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "実に頑張り屋さんな若者だこと。まぁいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "ユーフラシア"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
