			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブノワ·ルロワ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "アトーズのシャツが千モラ…モルティシアのネックレスが…ふんっ、今どきの若者はカネがかかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490202,
					"content": "ルロワさん、こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "よう！オイラたち、ユーフラシア編集長の紹介で来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490204,
					"content": "あなたたちはルロワに訪れた理由を説明した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "ははっ、もう半年以上前のことなのに、ユーフラシアさんはまだあの時の依頼を残しておったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490206,
					"content": "そう、確かにアルバイトを募集しようと思っておってな。若い時はバリバリ働けても、年を取ったら誰かの世話にならにゃいかんものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490207,
					"content": "ずーっと働きづめでこの家をやっと手に入れたが、年老いて気づいたら独りきりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490208,
					"content": "確かにそれを嘆いた時期もあったが、幸い今は娘と娘婿が面倒を見てくれとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490209,
					"content": "あの子たちは利口だし夫婦仲もいい。二人がいてくれたら、もう何も不満はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490210,
					"content": "つまりだ…お若いの、もうアルバイトは必要ないということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490211,
					"content": "無駄足になるなんて残念…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "そうがっかりするな。わしは若者が落ち込んどる姿を見るのが一番苦手でな。若いもんは笑ってこの世界の喜びを味わうべきだ——そう思わんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490214,
					"content": "せっかく来てくれたんだ。新聞社のユーフラシアさんの推薦もあることだし、ここはひとつ仕事を頼むとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490215,
					"content": "ちょうど子供らが外出していて、しばらく留守にしとる。わし一人では手が回らん。もちろん、報酬だって払わせてもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490216,
					"content": "わぁ、ルロワじいちゃんってめちゃくちゃいい人だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490217,
					"content": "ははっ、ずいぶんと褒め上手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490218,
					"content": "では頼まれてくれるか。玄関と裏口を掃除して、ついでにナナに魚肉をやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490219,
					"content": "おっと、ナナというのはわしが飼ってる猫だ。玄関にいるあの子だよ。先にナナの代わりに礼を言っておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490220,
					"content": "簡単そうだな。いいぞ、オイラたちに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490212,
					"content": "ユーフラシアさん、どういうこと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
