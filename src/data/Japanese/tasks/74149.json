					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブノワ·ルロワ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "仕事は終わったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490502,
					"content": "おう、終わったぜ、ルロワじいちゃん。それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490503,
					"content": "報酬はあめ玉とお小遣い、どっちがいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490504,
					"content": "ど、どっちも。えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490505,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "欲張りな子だな、ははっ。まぁいい、子供ってのはそうでないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490507,
					"content": "特にパイモンみたいな可愛い娘は、マカロンを食べて、きれいなスカートをはいて、美しい家に住むのがふさわしいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490508,
					"content": "#オイラもそう思うぞ！なあ、{NICKNAME}、だから買っても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490509,
					"content": "ダメ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#うぅ…そんなぁ！{NICKNAME}のケチ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490511,
					"content": "#パイモン、{M#俺}{F#私}たちは冒険者なんだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "でも、それがマカロンとかスカートとか、きれいでおっきな家を買っちゃいけない理由にはならないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490514,
					"content": "おっと、口ゲンカか？まったく子供だな。だが、そうやってケンカするのも悪くない。まだまだ年少だという証だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490515,
					"content": "#{M#俺}{F#私}の実際の年齢は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "子供でいられる時代は短い。大切にするといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490518,
					"content": "さて、報酬とお菓子だ。両方あげるからもう揉めるんじゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490519,
					"content": "やったー、お菓子だ！ルロワじいちゃん、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490520,
					"content": "ブノワと呼んでくれて構わない。ルロワは苗字だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490521,
					"content": "フォンテーヌ廷でルロワはわし一人だ。苗字を強調されると、この老いぼれの寂しさが増す一方でな。だから、下の名前で呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490522,
					"content": "じゃあル…ブノワじいちゃんの娘はルロワって苗字じゃないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490523,
					"content": "ああ、娘とは血が繋がってないんだ。引き取った子でな。だがわしにとっては、実の娘も同然と思っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490524,
					"content": "よければ、明日も来てくれ。その頃にはモルティシアとアトーズも戻っておるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490525,
					"content": "可愛い子供たちに雑用を頼んで、お菓子を食べさせるくらいなら、モルティシアも文句を言うまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490526,
					"content": "時々他の子も訪ねてくるから、一緒に遊ぶといい。わしは子供が好きでな。子供がたくさんいると、家が賑やかになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490527,
					"content": "もし来たときにわしの姿がなければ、ドアをノックしてくれ。アトーズが開けてくれるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490528,
					"content": "じゃあ約束な。明日また来るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741490529,
					"content": "ああ。わしもそろそろ部屋に戻るとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490530,
					"content": "また明日。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "またな、子供たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741490516,
					"content": "ケンカするほど仲がいいって言うしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "パイモン、旅の目的を忘れちゃダメ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
