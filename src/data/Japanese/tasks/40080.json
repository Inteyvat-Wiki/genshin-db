			"dialogs": [
				{
					"id": 400800401,
					"content": "奇遇だね。君たちも来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800402
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800402,
					"content": "吟遊野郎、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800403,
					"content": "目が覚めたら、いい香りが漂っててね。その果実の甘い香りを辿ったら、ここに着いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800404,
					"content": "うんうん。このお酒に使ってる果実、とっても甘い匂いがするよね、クレーもそう思った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800405
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800405,
					"content": "他にも理由があるんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800406
					]
				},
				{
					"id": 400800406,
					"content": "へへっ、実は大事なことを思い出したんだ。君たちがお酒の入った酒樽を地面に埋める前に、もう一つやっておかなきゃいけないことがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800407,
					"content": "えっ！まだなにか足りないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800408
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800408,
					"content": "レザー、ボトルに入っていた半分の「サウザンドウィンドブリュー」の匂いを覚えてる？少し苦みが混じってたでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800409
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800409,
					"content": "ああ、あった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800410
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800410,
					"content": "そう、その苦みが結構大事でね。つまり…これのことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800411
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800411,
					"content": "蒲公英の種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800412,
					"content": "蒲公英酒はもちろん知ってるよね。モンド人にとって、風は魂を連れ戻し、記憶を保存しておくことができるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800413
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800413,
					"content": "蒲公英の種は、その年の最初の風を集めてくる自然の宝石のようなものなんだ。それを酒樽に入れることで、その当時の風も保存したことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800414
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800414,
					"content": "こうやって美酒はその瞬間を記憶し、永遠に留めてくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800415
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800415,
					"content": "つまり「サウザンドウィンドブリュー」は、最初の「蒲公英酒」なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800416
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800416,
					"content": "おお——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800417,
					"content": "すごい——クレーたちのことが、お酒に記憶されるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800418
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800418,
					"content": "どうして決まった味がないかというと、入れる材料は完全に自由だからだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800419
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800419,
					"content": "あ、う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800420
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800420,
					"content": "どうしたの、レザー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800421
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800421,
					"content": "パパとママのお酒、蒲公英の種以外、よく分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800422
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800422,
					"content": "オレのお酒には、友達との感情が、たくさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800423
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800423,
					"content": "パパとママ、やっぱりよく分からない。でも…オレにはみんながいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800424
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800424,
					"content": "みんな、頑張ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800425
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800425,
					"content": "ファルカ、師匠、クレー、ベネット、茶色の猫おじさん、冷たいお姉さん、笑うふりをする大人の人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800426
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800426,
					"content": "グレーの硬そうな女の子、風晶蝶の匂いの人、猫おじさんの娘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800427
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800427,
					"content": "緑の詩人、パイモン、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800428
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800428,
					"content": "みんな、覚えてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800429
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800429,
					"content": "お酒、造るの、難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800430
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800430,
					"content": "みんながいなければ…このお酒は、造れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800431
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800431,
					"content": "みんなと一緒に立ち向かう困難は、困難じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800432
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800432,
					"content": "オレ…うれしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800433,
						400800434
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800433,
					"content": "レザーの役に立てるのなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				},
				{
					"id": 400800435,
					"content": "うん、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800436
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800436,
					"content": "友達も…「ルピカ」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800437
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800437,
					"content": "未来は、みんな一緒。オレが人間でも、狼でも…そんなこと関係ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800438
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800438,
					"content": "大きくなったら…また一緒に、この酒樽を開けに来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800439
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800439,
					"content": "いいことを言ったね。吟遊詩人のボクが聞いても、文句のつけようがない言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800440
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800440,
					"content": "さあ、残るは酒樽を埋めて、熟成するのを待つだけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800441
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800441,
					"content": "一行は力を合わせて酒樽を埋めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800442
					]
				},
				{
					"id": 400800442,
					"content": "ようやく終わったな。オイラ、お祝いしたい気分になってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800443
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800443,
					"content": "たしか、明日は「ブリーズデイ」当日だったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800444
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800444,
					"content": "わぁ！風神様が帰ってくるね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800445
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800445,
					"content": "あはは、そういえばそうだったね。まだ歌謡を全部覚え切れていないから、ボクは戻って杯挙げの儀の準備をするよ。じゃあみんな、また明日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800446
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800446,
					"content": "今夜はぐっすりと寝て、明日の朝は爽やかな風の音に耳を澄ますんだ。そして、最高の吟遊詩人の姿を見に来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800434,
					"content": "みんなうれしいと思うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800435
					]
				}
			]
		},
		{
			"id": 4008006,
			"completionStepIds": [
				4008006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008006",
							"2"
						],
						"stepId": 4008006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ",
					"ウェンティ",
					"ジン",
					"レザー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800601,
					"content": "すごい人だかりだ、みんな風神を迎えに来たんだな。あれ、なんか「エンジェルズシェア」の屋台に人が集まってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800602,
					"content": "ブリュー祭で売られる最高品質のお酒は、杯挙げの儀で風神様にお飲みいただいてから販売するのが通例なの。だから、みんな並んでいるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800603
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 400800603,
					"content": "まったく、あいつらにとって、風神を迎えるのは形だけのことなんだな。リサさんは、レザーに会いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800604,
					"content": "ええ。少し不安だったけど、さっきレザーと話してお酒造りの旅は上手くいったと聞いたわ。今日は安心して一杯飲めるようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800605
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 400800605,
					"content": "うわぁ…リサさんまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800606,
					"content": "ふふっ、レザーたちはもうあっちにいるから、早く行ってらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800607
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 400800607,
					"content": "おっ、来たな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800608
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800608,
					"content": "うわっ、この大量のボトル、どうしたんだよ？事情を知らなかったら、てっきりお酒を売る屋台でもやってるのかと思ったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800609,
					"content": "はははっ、全部レザーのために用意したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800610
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800610,
					"content": "今日はみんなが風神様を迎えて、お酒を飲んでもらう日だってママが言ってた。風神様に喜んでもらえたら、風になってみんなを祝福してくれるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800611
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800611,
					"content": "#クレーたち、風神様を喜ばせて、レザーを助けてもらうんだ。栄誉騎士のお{M#兄}{F#姉}ちゃん見て見て、これ、アルベドお兄ちゃんが貸してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800612
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800612,
					"content": "このボトルはオヤジたちから集めたんだ。途中で割らずに済んでよかったよ…一応、見栄えを良くするためだけのものだから、終わったら返す必要があるんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800613
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800613,
					"content": "ママが言ってた。風神様はお酒にとっても強くて、その気になればシードル湖を一気に飲み干せるんだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800614
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800614,
					"content": "これと、レザーのパパとママが残したお酒で…足りるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800615
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800615,
					"content": "あっ、緑の詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800616
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800616,
					"content": "コホン。やあみんな。この場所に立つことが出来て、ボクはとても光栄に思うよ。今日は西風騎士団の代理団長ジンさんに招かれ、歌謡を披露することになった——「サウザンドウィンドブリュー」をね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800617
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800617,
					"content": "ボクの最高の歌謡を、風とここにいるみんなに捧げよう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800618
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800618,
					"content": "「これらを樽に封印し、\\n焦らず、待つのだ、風が吹き波が立つまで。\\n美酒のボトルをまず蝋で封じ、\\n南風は心地よく、北風は猛る。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800619
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800619,
					"content": "「美酒はどんな味か？\\nモンドの名、自由の夢。\\n何を発酵させ美酒となったのか？\\n探求する勇気、優しさに満ちた慈愛。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800620
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800620,
					"content": "「守護の執念は在りし日のまま、\\n謡を掲げる千風と共に。\\n酸味ある滴は甘くなり、粗雑な樽は潤わん、\\n焦らず、待つのだ、風が吹き波が立つまで。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800621
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800621,
					"content": "「酒樽には何がある？\\n黄金色の小麦と、生い茂る緑。\\n樽から注ぎし美酒、そこに何が漂う？\\n風鈴の音色と、万古の長空。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800622
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800622,
					"content": "「我々は美酒を手に歌う、\\n焦らず、待つのだ、風が吹き波が立つまで。\\n千風が運びし酒肴とは？\\nライアーにまつわる物語と、今宵の美しき夢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800623
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 400800623,
					"content": "友よ、共に杯を掲げよう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800624
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 400800624,
					"content": "風神に感謝を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800628
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800628,
					"content": "風神に感謝を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800629
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800629,
					"content": "風神に感謝を。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800630
					]
				},
				{
					"id": 400800630,
					"content": "でも…風が吹いてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800631
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800631,
					"content": "クレー、悲しむな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800632
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800632,
					"content": "レザー、どうしてなの？風神様が帰ってこないのは、クレーたちが用意したお酒が気に入らないから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800633
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800633,
					"content": "そうじゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800634
					]
				},
				{
					"id": 400800634,
					"content": "そんなことないぞ！クレーは知らないかもしれないけど、風神様は風以外のものにも変身できるんだ。きっと今年は別の何かに変身して帰ってきたんだと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800635
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800635,
					"content": "え？ホントに？もしかして…ボンボンになったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800636
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800636,
					"content": "よし、ボンボンだな！聞こえたか？風神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800637,
					"content": "えへへっ…レザー、風神様からなにか祝福はもらえた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800638
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800638,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800639
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800639,
					"content": "お前たちと一緒に、たくさん語れた。たくさん学べた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800640
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800640,
					"content": "これで、もう怖くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800641
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800641,
					"content": "これが…祝福だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800642
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800642,
					"content": "将来大人になって、お前のお酒が出来上がったら、オレにも飲ませろよ。約束だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800643,
						400800644
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800643,
					"content": "#{M#俺}{F#私}の分もあるよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				},
				{
					"id": 400800645,
					"content": "ああ、みんなと分かち合って、みんなと、思い出を振り返る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800646
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800646,
					"content": "うん、決まりだね！でも…クレーのど渇いちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800647
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800647,
					"content": "話してばっかじゃなくて、なにか飲みに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800648
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800648,
					"content": "そういえば、「エンジェルズシェア」の屋台で売ってる新商品、「バケーションサイダー」がうまいらしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800649
					],
					"speakerTitle": "ベネット"
				},
				{
					"id": 400800649,
					"content": "飲みたい飲みたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800650
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800650,
					"content": "ああ。みんなで行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800644,
					"content": "その時は、きっと今を思い出すだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				}
			]
		},
