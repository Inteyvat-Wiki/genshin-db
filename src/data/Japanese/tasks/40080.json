			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ノエル",
					"スクロース",
					"レザー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800201,
					"content": "レザーのやつ、「補講」は順調に進んでるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800202,
					"content": "スクロースさま、お待ちください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800203
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800203,
					"content": "先輩、パイモンさん、彼女を止めるのを手伝ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800204
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800204,
					"content": "わっ、びっくりした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800205,
					"content": "おまえら、なに慌ててるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800206,
					"content": "実は、スクロースさまと一緒に醸造の材料をあなたさまに渡す予定だったのですが、レザーさまがいらっしゃると聞いた途端、逃げ出してしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800207
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800207,
					"content": "わ…私は知らない人と関わるのが苦手だから、材料を無事に渡せれば、それでいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800208
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800208,
					"content": "そんなのいけません！せっかく二人で頑張ったのですから、一緒に顔を出さないと。スクロースさまの手柄を横取りすることになってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800209
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800209,
					"content": "手柄とか…そういうのはいいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800210
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800210,
					"content": "つまり、騎士団が用意した材料って、「生物錬金」で作ったものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800211,
					"content": "はい、「甘さ四倍の夕暮れの実」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800212
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800212,
					"content": "甘さ四倍？普通の甘さじゃダメなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800213,
					"content": "それに…どうして夕暮れの実なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800214,
					"content": "それを説明するには、最初からお話しする必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800215
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800215,
					"content": "私はお酒の香りが好きで、お酒を造ることについても、ある程度勉強と経験を積んできました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800216
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800216,
					"content": "結論から申し上げますと、原材料の甘みはとても重要な要素なのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800217
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800217,
					"content": "そこで最適な材料を選出するために、モンド周辺にある甘みを含む植物や果実をすべて探し出し、一つ一つ試食して、リストにまとめました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800218
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800218,
					"content": "同じ材料でも産地ごとに調べています。例えば清泉町付近のスイートフラワーは誓いの岬よりも少し甘いんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800219
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800219,
					"content": "うわぁ、かなり大変そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800220,
					"content": "問題ありません。「騎士団メイド」として、当たり前のことをしたまでです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800221
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800221,
					"content": "騎士団を代表して「守護の執念」を見つけることができれば、私にとって大変栄誉あることですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800222
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800222,
					"content": "ノエルの目が、輝いてる…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800223,
					"content": "でもなんだか、リサさんに騙されてる感じがするな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800224,
					"content": "パイモン、しーっ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800225
					]
				},
				{
					"id": 400800225,
					"content": "あっ、本題に戻りますね。私一人で試食をしていたのですが、それでは主観的になってしまうのではと心配になりました…そこにちょうど研究室から出てきたスクロースさまが現れ、相談をしたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800226
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800226,
					"content": "あっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800227
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800227,
					"content": "どうかしましたか、スクロースさま？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800228
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800228,
					"content": "急に思い出した…私、輸入したばかりの実験器具を取りに出かけようとしてたんだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800229
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800229,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800230
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800230,
					"content": "顔色が悪いけど…もしかしてその件を忘れて、ずっと今日まで研究室にこもってたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800231,
					"content": "そ、そうです…すみません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800232
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800232,
					"content": "はぁ、気にしないで、私にも責任があるから。実験器具は後でマージョリーさんのところに取りに行くことにする。ノエル、話を続けて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800233
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800233,
					"content": "あ、はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800234
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800234,
					"content": "そして、スクロースさまから私のリストに対する貴重なアドバイスをいただきました。さすがはプロの研究員の方ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800235
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800235,
					"content": "褒めなくても大丈夫だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800236
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800236,
					"content": "その後、ノエルに事の経緯を話してもらったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800237
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800237,
					"content": "ノエルはそのレザーって子のことを知らないのに、真剣に取り組んでた…私、それに感動したの。でも私から見ると、それら材料はどれも「完璧」じゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800238
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800238,
					"content": "私たちに必要なのは、糖度が高く、発酵しやすい果物。最終的に、リストの中からシードル湖周辺で採取した夕暮れの実のサンプルをベースとして選び、改良を施したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800239
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800239,
					"content": "「生物錬金」を通して甘みの特性を増幅させ、対照実験を行った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800240
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800240,
					"content": "実験が始まった後のスクロースさまの根気強さには、感服いたしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800241
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800241,
					"content": "もう、褒めなくていいって言ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800242
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800242,
					"content": "とにかく…「五式夕暮れの実改六三号甘さ四倍版」の開発に成功したの。糖度は厳しく測定を行い、色合いとふくよかさも一流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800243
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800243,
					"content": "ノエルはそれを簡潔に「甘さ四倍の夕暮れの実」って呼んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800244
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800244,
					"content": "まだ大規模な量産を行えないのが残念だけど…今回はレザーに協力できればそれでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800245,
						400800246
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800245,
					"content": "きっと力になれる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800248
					]
				},
				{
					"id": 400800248,
					"content": "旅人さん、ちょっと話があるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800249
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800249,
					"content": "私、子供の頃から幸せな生活を送っていて…人付き合いが苦手なのに、両親には特に何も言われてこなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800250
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800250,
					"content": "「もっと明るく振る舞いなさい」とか言われたことなんてないし、「好きなことをやればいい」って言われてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800251
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800251,
					"content": "私、分かってるんだ…自分が幸運であったことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800252
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800252,
					"content": "レザーがどんな生い立ちなのか知らないし、想像もつかない。勝手に語るのは、失礼でしかない。でも、彼が楽しく生活できて、やりたいことをやれるのを心から願ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800253
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 400800253,
					"content": "スクロースさま…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800254
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800254,
					"content": "（ガタン——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800255
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800255,
					"content": "ごめん、また遅くなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800256
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800256,
					"content": "師匠、時間見るの忘れた。ずっと喋ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800257
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800257,
					"content": "気にすんな、オイラたちも話してたところだから。って、なんだか同じことをつい最近も言ったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800258,
					"content": "（あれ、スクロースがいなくなってるぞ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800259
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800259,
					"content": "（レザーさまが入ってきた途端、逃げたのでしょうか！？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800260
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800260,
					"content": "こんにちは。私は西風騎士団のメイド、ノエルです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800261
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800261,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800262
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800262,
					"content": "こちらの材料を受け取って下さい。ただ、私一人で用意したものではありません。もう一人、錬金術師の方にご協力いただいたのですが、彼女は今…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800263
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800263,
					"content": "彼女は仕事でちょっと忙しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800264
					]
				},
				{
					"id": 400800264,
					"content": "あ、はい…直接彼女からお渡しできないのが残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800265
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800265,
					"content": "ポーション、花の蜜、それと風晶蝶みたいな匂い…合ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800266
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800266,
					"content": "おっ、やっぱりレザーの嗅覚はごまかせないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800267
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800267,
					"content": "この夕暮れの実、今まで嗅いできたものよりも、甘い。錬金術、すごい、物をいい方向に変化させる。クレーが言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800268
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800268,
					"content": "はい！この甘い夕暮れの実が、あなたにとってもっとも甘く、最高のお酒になるよう祈っております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800269,
						400800270
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800269,
					"content": "もう一人の女の子は他にも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800271,
					"content": "…みんな、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800272
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800272,
					"content": "次、時間がある時に、直接お礼を言う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800273
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800273,
					"content": "おまかせください！どうにかして…毎日忙しくしすぎないようにと、彼女を説得して…あなたに紹介してみせます!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800274
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800274,
					"content": "ああ、オレ待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800275
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800275,
					"content": "さて、材料も揃ったし、次はいよいよお酒造りだな。酒樽はたしか「エンジェルズシェア」の屋台に置いてあるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800276
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800276,
					"content": "じゃあまたな、ノエル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800277
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800277,
					"content": "はい、お気を付けて。すべてがうまく行くよう応援しております！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ノエル"
				},
				{
					"id": 400800270,
					"content": "「好きなことをやればいい」って言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800271
					]
				},
				{
					"id": 400800246,
					"content": "一口食べてみてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800247
					]
				},
				{
					"id": 400800247,
					"content": "おい！どうしたんだよ、おまえ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800248
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4008003,
			"completionStepIds": [
				4008003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008003",
							"2"
						],
						"stepId": 4008003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレー",
					"ディオナ",
					"レザー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800301,
					"content": "#栄誉騎士のお{M#兄}{F#姉}ちゃん、レザー、こっちこっち！ジャジャーン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800302
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800302,
					"content": "ディオナじゃないか！てっきりキャッツテールの屋台に現れるもんだと思ってたけど、今日まで一回も会わなかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800303,
					"content": "うぅ…許せにゃい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800304
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800304,
					"content": "えっ？——どうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800305,
					"content": "むむむむむ——ムカつくにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800306
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800306,
					"content": "二人の仕業だって、クレーちゃんから聞いたにゃ。レザーはパパの友達で、頼れるいい人なのに！よくもお酒に興味を持たせてくれたにゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800307
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800307,
					"content": "レザー、絶対にテーブルに倒れるような、ギャーギャー騒ぐ酔っ払いオジサンになっちゃだめだからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800308
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800308,
					"content": "う…オレ…よく分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800309
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800309,
					"content": "なんだか誤解しているような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800310,
					"content": "クレー、いったいなにを言ったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800311,
					"content": "#うぅ…えっとね、クレー、ディオナお姉ちゃんにレザーはママを探していて、それを栄誉騎士のお{M#兄}{F#姉}ちゃんが手伝ってるって言ったの。悲しんでて、お酒が必要だから、ディオナお姉ちゃんに助けてもらおうかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800312
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800312,
					"content": "まだ話の途中だったのに、ディオナお姉ちゃんが「クレーちゃん、それ以上言わなくていいにゃ。あたしが絶対に阻止するから」って言って…それで、一緒にここまで来たんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800313
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800313,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800314
					]
				},
				{
					"id": 400800314,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800315
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800315,
					"content": "そ…そうだったのか。どうツッコめばいいのか…ディオナはかなり勘違いしてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800316,
					"content": "ディオナに経緯を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800317
					]
				},
				{
					"id": 400800317,
					"content": "つまり、レザーは両親のことを知るために、そのお酒を再現しようとしてるってこと…？あたしを騙そうとしてないよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800318,
						400800319
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800318,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				},
				{
					"id": 400800320,
					"content": "ディオナお姉ちゃんごめんなさい。クレーの説明が下手なせいで勘違いさせちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800321
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800321,
					"content": "怒らないで、レザーのお酒をつくるの手伝ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800322
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800322,
					"content": "クレーもお魚をたくさんドッカーンするから、一緒に食べよう。ドドコもなでなでしていいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800323
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800323,
					"content": "あ…あたし、別に怒ってなんかないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800324
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800324,
					"content": "クレーちゃんが人助けしようとしてるのは分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800325
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800325,
					"content": "レザーに悪い影響を与えたくないから、つい大きな声を出しちゃったにゃ…レザー自身が飲むわけじゃないなら、しょうがない、ちょっとだけ協力してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800326
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800326,
					"content": "でも、先に言っておくけど、あたしが普段扱ってるお酒は醸造が終わっているものなの。いきなり原材料から造れって言われても、どうなるか分からないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800327
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800327,
					"content": "やったー！ディオナお姉ちゃんはいい人だね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800328
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800328,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800329,
						400800330
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800329,
					"content": "ディオナの力があれば、問題なく終わるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800331,
					"content": "ふん、あなたたち口だけは上手なんだから。見ときなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800332
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800332,
					"content": "ディオナは名高い看板バーテンダーの構えを見せ、酒樽の中を混ぜ始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400800333
					]
				},
				{
					"id": 400800333,
					"content": "よし、できたみたいだ。あっという間だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800334,
					"content": "次は、これを置いておく場所を探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800335,
					"content": "「焦らず、待つのだ、風が吹き波が立つまで。」…うーん、つまり、風が吹くところに置けってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800336,
					"content": "風立ちの地は、どうだ？風が強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800337
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 400800337,
					"content": "たしかに！モンドで風と言えば、あそこが真っ先に思い浮かぶな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400800338,
					"content": "わくわく、クレーも一緒に行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800339
					],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800339,
					"content": "あたしはバカパパの監視をしないといけないから、遠慮しとく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800340
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800340,
					"content": "クレーちゃん、また今度一緒に遊ぼうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800341
					],
					"speakerTitle": "ディオナ"
				},
				{
					"id": 400800341,
					"content": "うん、約束だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレー"
				},
				{
					"id": 400800330,
					"content": "ディオナ、頑張れ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800331
					]
				},
				{
					"id": 400800319,
					"content": "そんなこと絶対にしない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800320
					]
				}
			]
		},
