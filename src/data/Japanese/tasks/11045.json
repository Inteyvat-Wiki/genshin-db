	"talks": [
		{
			"id": 1104501,
			"completionStepIds": [
				1104501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104501",
							"2"
						],
						"stepId": 1104501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "旅の途中で、キミはたくさんの謎に出会ってきただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450102,
					"content": "身体能力テストと同じで、ボクは実験を通してキミの知能指数を観察したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450103,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "この遺跡を探索した後、キミが得られた答えをボクに教えてくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450106,
					"content": "この遺跡の両側にはそれぞれ謎があり、それをクリアすると中央の装置が起動できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450107,
					"content": "身体能力テストの時と同じ、方法の制限はない。キミのしたこと全てがボクの観察したい内容だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450108,
					"content": "分かってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "さすがベテランの冒険者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450112,
					"content": "さて、あとはキミ次第だ。どちらを先に選ぶかもキミが決めるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450110,
					"content": "やってみないと分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "これは知能テスト、運はテスト内容ではないから、忘れないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450104,
					"content": "その言い方なんかおかしくない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450462,
					"content": "知らない模様だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "ボクの知る限り、これは文字だよ。テイワット大陸のあちこちにあるけど、いまだ謎に包まれてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450402,
					"content": "解明されてないところが多い、それになぜ符文がここに残されたのかも分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450403,
					"content": "ひとまず書き写しておこう。キミに対する研究が終わったらまた確認してみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450404,
					"content": "あぁ、また分からないものが増えたな。こんな変わったテストや実験で一体どんなことが分かるっていうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450405,
					"content": "結果を得るには、それ相応の代価が必要ってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450406,
					"content": "今回、かなりの収穫があった。それに比べて微々たる代価を支払うなど大したことではないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450407,
					"content": "ボクは先に拠点に戻ってる。キミたちが戻ってくる頃には、奇跡の瞬間を見せることができるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450408,
					"content": "またあとで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "こんなに苦労したんだし、一体どんな結果が出るか楽しみだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450411,
					"content": "他に用がなければ、オイラたちも拠点に戻るか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450413,
					"content": "そう焦らないで、まだ危険は排除されてないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450414,
					"content": "ん？おまえ！まだ雪山にいたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450415,
					"content": "もちろん、君たちとアルベドがしてきたことは全て見せてもらったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450416,
					"content": "警戒心がないのか、それとも単に彼の独特な思考とフレンドリーな態度に騙されたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450417,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "見知らぬ人の指示に従って正体の分からない薬を飲んだり、意味不明な実験に参加したり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450420,
					"content": "単純というより、君が騙されていたと信じたい…もしくはわざとそうしたとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450421,
					"content": "やっぱり警戒心の強いシスターだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450422,
					"content": "彼の研究に協力しただけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "アルベドのことはどうでもいいわ。彼のことは君のような異邦人よりも知ってるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450425,
					"content": "私が気にしているのは一つだけ、君が錬金術で怪物に改造されたかどうかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450426,
					"content": "嘘だろッ！？全然気付かなかったぞ！それに、あいつ今まで錬金術を使ってないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450427,
					"content": "彼のような錬金術師は気付かれるようなヘマをしないものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450428,
					"content": "とにかく、その脅威をモンドに戻すことはできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450429,
					"content": "な、なにするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450430,
					"content": "確かめる方法があるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "案外冴えてるわね。君たちが触れてきたものに危険がないと分かれば、危険性はないと判断できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450432,
					"content": "他のものはすでに調べたわ。唯一確認してないのは、その符文よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450433,
					"content": "この符文、オイラたちもなんなのか分かってないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450451,
					"content": "でしょうね…うん、装置でもないし、ただの符文だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450452,
					"content": "でも一応念のため、この符文の言葉を写しておこうかしら…うん、定期的な見回りも必要ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450434,
					"content": "いいでしょう、君たちに危険性はないと判断する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450435,
					"content": "これで万事問題なし、君たちのせいで残業することになったら損だものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450436,
					"content": "ざ、残業？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450437,
					"content": "最後に忠告しておくわ、異邦人。アルベドのことを何でも信じないこと。考えなしに行動しないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "ロサリア"
				},
				{
					"id": 110450439,
					"content": "あ…もう行っちゃった、自分本位なやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450440,
					"content": "モンドじゃ彼女みたいな人、珍しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450441,
					"content": "心配性なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "うん、それよりもアルベドの拠点に戻ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450442,
					"content": "繊細な人なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "彼が悪い人だと思わない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "アルベドが何か企んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "知能に問題がなくて安心した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "どこかで見たことある気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
