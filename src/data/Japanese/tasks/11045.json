			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "おかえり、ちょうど結論が出たところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450502,
					"content": "しかし、戻って来るまで結構時間が掛かったね、何かあったのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450503,
					"content": "なんでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "結論から言おう。今日、多くのデータを手に入れることができたから、すぐに全ての研究を終わらせることは難しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450507,
					"content": "でも全体を通した初歩的な結論なら教えられる。それは——キミはこの世界の人類とそっくりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450508,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "そんなの一目見れば分かるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450511,
					"content": "あれだけ苦労したのに、結局それだけなのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450512,
					"content": "まあ焦らないで、キミたちにとっては当たり前だけど、この世界にとっては当たり前のことなんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450513,
					"content": "こういう可能性は考えたことあるかい？テイワットという世界はよそ者に対して拒絶反応を起こすと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450514,
					"content": "答えは神のみぞ知る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "この世界の法則を話しただろう。キミが無事にボクと会話してることは普通に見えるけど、本当は奇跡だったりするかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450517,
					"content": "なぜなら、キミと同じよそから来た命、ボクが話した種はテイワットの法則に影響されて成長することすらできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450518,
					"content": "しかし、キミを観察した後、ボクは他のアイデアを閃いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450519,
					"content": "キミの命を真似して、錬金術に新たなインスピレーションを加える——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450520,
					"content": "わっ、な、なんか出てくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450521,
					"content": "無から有へ、芽生えから繁栄へ、それから終わりに向かう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450522,
					"content": "この世界でない命を育むことは、世界を育むことにならないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450523,
					"content": "わあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450524,
					"content": "綺麗だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "おや、これが限界みたいだね。一瞬だけど最高に綺麗な花を咲かす、生命の極致もここにあるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450527,
					"content": "いっぱい苦労したから、永遠に咲いててくれるもんかと思ったけどなぁ。それに果実も実らなかったし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450528,
					"content": "命というのは多種多様で自由なものだよ、長さで決めつけるべきではない。たとえ一瞬でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450529,
					"content": "短い命が必ずしも悪いことではない。効率的で完璧、孤独に囚われないことを意味する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450530,
					"content": "分かるかな？ボクが言った、「ボクたちの会話は奇跡かもしれない」ことについて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450531,
					"content": "少なくとも今はまだ枯れていない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "ん？急にしおらしくなってどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450534,
					"content": "#おーい、元気出せよ、{NICKNAME}。オイラがついてるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450535,
					"content": "それにアルベドも、友達になってやってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110450536,
					"content": "…ありがとう。孤独をなくすことは必要だと思ってないけど…これも悪くないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}、キミが協力してくれたおかげで、ボクは花を咲かす可能性に気付いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450538,
					"content": "「実験対象」として？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "いや、雪山でキミたちと過ごした時間は、価値のある旅だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450540,
					"content": "今後…もし必要があったら、またお願いしてもいいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450541,
					"content": "必要がなくても、いつでも呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "それなら…よろしく頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450544,
					"content": "#ずっと実験結果は「普通」だって{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}に言ってきたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450545,
					"content": "瓶の底に現れないはずの淀みがあるのは、一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450546,
					"content": "黒土を吸えば汚れ、白亜を吸えば無垢になる。キミもボクも、未来が不確かな「素体」ってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450547,
					"content": "もしいつか、暴走するボクがモンドを…壊そうとしたら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450548,
					"content": "キミが止めてくれることを、期待してもいいだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 110450532,
					"content": "#（{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_SISTER]}は今どうしてるんだろう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "短かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "そうかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "それだけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "シスターに止められた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "それなら平気さ、彼女は仕事を全うしたまでだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "アルベド"
				}
			]
		},
		{
