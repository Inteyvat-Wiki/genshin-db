			"dialogs": [
				{
					"id": 240010301,
					"content": "やっぱりここにいたのか。よし、元気そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010302,
					"content": "犬はオペラにもシュテルさんの小説にも興味ないだろうに。あの人、いつになったら気づくんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010303,
					"content": "さて、さっさと戻ろう。シュテルさんが待ちくたびれてるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブラシーネ"
