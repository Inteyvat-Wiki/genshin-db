				]
			},
			"dialogs": [
				{
					"id": 240010401,
					"content": "バレア！ああ、わたくしのベーベちゃん…どこに行ってたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010402,
					"content": "こいつはただ静かな場所を見つけて、しばしの休暇を楽しんでただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010403,
					"content": "本当に心配でたまらなかったのですわ。ブラシーネさん、本当にありがとうございます。次の小説には、絶対にあなたを登場させますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010404,
					"content": "心遣いはありがたいけど、警察の日常に興味がある人なんていないだろうし…インクの無駄遣いはしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010405,
					"content": "では、波乱万丈に満ちたストーリーにいたしましょう…きっと面白くなりますわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010406,
					"content": "いや、そう言ってくれるだけで、もう充分波乱万丈な気分になったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010407,
					"content": "結末も人々の心に響くようなものでなければ！どんな仲間を作ろうかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュテル"
				}
			]
		},
