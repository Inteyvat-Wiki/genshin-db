			"dialogs": [
				{
					"id": 240010101,
					"content": "どうか手をお貸しになって。小説の構想を練っていて、ちょっと目を離した隙に、バレアがいなくなってしまったんですの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010102,
					"content": "まさかバレアを歌劇場の座席においてきちゃってたり、トイレの入り口にリードで繋いだままにしたりしてないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010103,
					"content": "どちらもくまなく探しました。座席の下までつぶさに探しましたけれど、バレアはどこにもいませんでしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010104,
					"content": "わたくしのバレアちゃん…まさか、誰かに誘拐されたり、一目ぼれした誰かに何も考えずについていったなんてこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010105,
					"content": "シュテルさん、バレアは同じ間違いを二回も犯したりしないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010106,
					"content": "でもバレアはまだ幼いんですもの…同じ間違いを繰り返してもおかしくはありませんわ。むしろ喜んでそうするかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010107,
					"content": "バレアの年はきみが思ってるほど若くないはずだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010108,
					"content": "バレアって誰…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "シュテルさんの犬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010111,
					"content": "わたくしの家族なのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010112,
					"content": "そう、彼女の家族が行方不明になってね、助けてほしいって相談されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010113,
					"content": "…シュテルさん、この辺りはもう何回も探しただろ？多分、バレアはもう大自然に向かって行っちゃったんだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010114,
					"content": "では、わたくしたちも大自然を目指しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010115,
					"content": "きみは街に残っててくれ。そのドレスじゃ、バレアを見つけたって追いつけやしないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010116,
					"content": "そんなことはありませんわ。わたくしの声を聞けば、たちまちこっちに走ってきてくれるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010117,
					"content": "じゃあ、さっき私たちが歌劇場の周りで大声で呼びながら探してた時は、きっとバレアに声が届かなかったんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010118,
					"content": "バレアが大人しくシュテルさんのところに帰るかなあ…私一人じゃとても返せそうにないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010119,
					"content": "私も勤務中だから、持ち場をあまり長く離れるわけにはいかないし、ましてや同僚を私と一緒に持ち場から離れさせるわけにもいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010120,
					"content": "旅人、もしよかったら、私とシュテルさんに手を貸してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010121,
					"content": "別に構わないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "じゃ、決まりな。私と一緒に野外でバレアを探してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010125,
					"content": "バレアの体重と体力からすれば、あんまり遠くへは行ってないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010126,
					"content": "バレアは至って健康ですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010127,
					"content": "バレアの精神状態について言ってるのなら、私も賛成だけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010128,
					"content": "じゃあ出発しよう。もし外の楽しさを知ってしまったら、バレアがさらに遠くまで行っちゃうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010129,
					"content": "まあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュテル"
				},
				{
					"id": 240010122,
					"content": "こんなこともおまわりさんの仕事なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "フォンテーヌ廷の市民が助けを求めてきた以上、断る理由もないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "ブラシーネ"
				},
				{
					"id": 240010109,
					"content": "何かトラブル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
