			"dialogs": [
				{
					"id": 740760101,
					"content": "あとはここだけですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760102,
					"content": "よかったね、まだ入り口は封鎖されてるみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760103,
					"content": "ジェイコブはまだここのなぞなぞを解いていないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760104,
					"content": "それか、「解けたものの答えられなかった」のかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760105,
					"content": "えーっと、今までの答えはそれぞれ「影」、「命」、「愛」だったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760106,
					"content": "今までの法則をもとに、私のロジックモジュールが碑文の内容を推測しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760107,
					"content": "「絶対に離れることはなく」…「一瞬で生まれ、何時も相いれず、永遠の眠りにもつきそう」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760108,
					"content": "最後の一句は——「原初の一滴」だってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760109,
					"content": "キャタピラー、セイモア、このなぞなぞの答えがわかるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
