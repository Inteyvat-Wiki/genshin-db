			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "ボク、「原初の一滴」っていう言葉で一つ思いつきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760402,
					"content": "世界創造後の最初の雨に似ていると思ったんです。古代フォンテーヌも水仙十字結社も好みそうなアイデアですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760403,
					"content": "そんなの見つかるわけないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760404,
					"content": "いえ、その雨のしずくは水の中に溶けてしまった…つまり、水の雫はどれも最初の一滴なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760405,
					"content": "原始の神が大きな可能性をばらまいたお陰で、ボクたち一人ひとりの体内に神聖な成分があるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760406,
					"content": "でもそんなにシンプルな答えだったら、先に来てた例のあいつだって、簡単に解答できたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760407,
					"content": "確かに。なら、きっと違うんでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760408,
					"content": "でもまあ、正しい答えでなかったとしても、いい答えですね。なぞなぞの出題者はロマンを解してくれないとは思いますけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760409,
					"content": "ロマンティックだから通してくれるなんて思ってたら、出題者に「セキュリティーのことを全然わかってない」って笑われるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760410,
					"content": "私は答えられません。「原初の一滴」の検索結果：1200件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760411,
					"content": "「伝説によればこの世界における原初の一滴とも言える酒は風神が…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760412,
					"content": "わかった、もういいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "かしこまりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760416,
					"content": "このことなら…あたし、知ってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760417,
					"content": "伝説によると、純水精霊は先代水神の最初の涙でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760418,
					"content": "大地の最初の涙は、最初の純水精霊が人間を理解したときに流したものだったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760419,
					"content": "世界最初の涙って言うと、一番初めに生まれた人間の赤ん坊が泣いたときに落としたものじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760420,
					"content": "動物の涙は塩分を排出するためのものだからね。その平和な時代には、人間は生まれた時でさえ笑いながら息をしてたらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760421,
					"content": "——そう、伝説ではそう言われてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760422,
					"content": "赤子が泣くことと動物が排塩することはどちらもよく似た非感情的行為だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760423,
					"content": "赤子が泣くことには二つの理由があります。一つ目は外界からの刺激のため、二つ目は肺に素早く空気を入れるためです。スメールの生論派教材によれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760424,
					"content": "じゃあ答えは、純水精霊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760425,
					"content": "じゃあ前に来たやつは、正しく解答できなかったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760426,
					"content": "最後の無駄あがきをしてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "望みのありそうな方向性だと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760430,
					"content": "ボクの水仙十字結社に対する理解から考えても、合理的だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760431,
					"content": "どこかで夢を見ている「赤の女王」、心にもないことばかり言う「夢の中の存在」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760432,
					"content": "おまえの言うことって、なぞなぞより難しいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760433,
					"content": "いいじゃないですか、もう最後の瀬戸際なんですから。何はともあれ、最後には、なぞなぞの答えが明らかになりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760434,
					"content": "アン、じゃあお願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "うん、やってみるよ。万一あたしが失敗したら、すぐに他の答えを考えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760436,
					"content": "開いたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760437,
					"content": "絶対に最後のピースを手に入れないといけません。そうでないと、聖剣が水仙十字結社の手に渡ってしまいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760428,
					"content": "望みのありそうな方向性だと思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "風神の酒の話で無駄にあがくよりずっといいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760414,
					"content": "よし、じゃあモンドに行って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "最後の悪あがきなら、もうちょっと望みのある方向にしろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "パイモン"
				}
			]
		},
