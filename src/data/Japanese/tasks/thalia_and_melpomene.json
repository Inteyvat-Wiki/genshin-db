			"dialogs": [
				{
					"id": 740760501,
					"content": "この先が「人格」のピース？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740760502,
					"content": "密度からは目の前の物質を分析できません。重量は…ゼロのようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760503,
					"content": "我々は最後の一つを手にしたようですね。少なくとも、あちらと交渉はできるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760504,
					"content": "楽観的に考えるなら、少なくとも最終的に水仙十字結社が聖剣を作るのだけは阻止できそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760505,
					"content": "違いますよ、パイモン。ボクたちの最終目的は聖剣を作って、それで彼らの計画を阻止することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760506,
					"content": "もちろん、アン、ボクはあなたにとってのこの剣の意義を忘れていませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760507,
					"content": "意志を絶ち切れる聖剣は、あなたにとって謎を解く鍵なのでしょう。ボクにとっても、これは同じくらい大切なものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
