			"dialogs": [
				{
					"id": 740760201,
					"content": "あとはここだけですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760202
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760202,
					"content": "今までの探索はぜんぶ収穫なしだったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760203,
					"content": "ええ。でも、ここの入り口は閉じていましたから、まだボクたちにもチャンスがあるってことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760204
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760204,
					"content": "競争相手はまだここのなぞなぞを解いていないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760205,
					"content": "ここの碑文に書いてあります。「絶対に離れることはなく」…「一瞬で生まれ、何時も相いれず、永遠の眠りにもつきそう」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "セイモア"
				},
				{
					"id": 740760206,
					"content": "最後の一句は——「原初の一滴」だってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760207,
					"content": "今までの数箇所にもこういうなぞなぞがあったはずですよ。答えは覚えてますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "キャタピラー"
				},
				{
					"id": 740760208,
					"content": "「影」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "「命」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "「愛」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "うーん、答えがだんだん抽象的になってきてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740760212,
					"content": "キャタピラー、セイモア、この答えの謎が解けるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
