					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700203,
					"content": "今からあの…「おにぎり」とやらを作ってみる。まあ、簡単な料理だと聞いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700204,
					"content": "あっ、食材の下ごしらえに少し時間がかかるから、そこら辺で待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
