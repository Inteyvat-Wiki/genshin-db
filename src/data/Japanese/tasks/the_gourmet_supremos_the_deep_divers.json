			"dialogs": [
				{
					"id": 721700101,
					"content": "これじゃあ下に潜れない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "旅人、また会ったな。俺たち今…どうにかしてこの水の中に潜り…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700104,
					"content": "新鮮な海草を採って、「おにぎり」なるものを作ろうと思っていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700105,
					"content": "海辺で拾えばいいのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "拾った海草は新鮮じゃないから、料理には使えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700109,
					"content": "城内の人に尋ねたところ、ここの底に良質な海草が生えてると教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700110,
					"content": "でもいざ来てみると…完全に浸水してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700111,
					"content": "俺ら3人とも潜水ができなくて…ここで見てることしかできない状況だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700112,
					"content": "周りに何か装置はない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "あそこに装置が1つあるよ！でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721700114,
					"content": "だけどあの装置、また障壁の中に閉じ込められてる。これじゃ入れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700115,
					"content": "はぁ、もう少し考えるしかないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700116,
					"content": "旅人、この難題を解決できる方法を知っているのなら、早く教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700117,
					"content": "もちろん、海草を採ってきてくれたら、もっと助かるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700118,
					"content": "旭東さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721700119,
					"content": "こほん！もし海草を採ってきたら報酬どころかご馳走まで用意しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700120,
					"content": "おにぎりのどこが「ご馳走」なんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721700121,
					"content": "なぁに、質より量で勝負するのさ…こほん、さて引き続き方法を考えよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700107,
					"content": "潜らなきゃダメなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "海辺で拾った海草は新鮮じゃないから、料理には使えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭東"
				}
			]
		},
