					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700303,
					"content": "よしできた！これぞ「おにぎり」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700304,
					"content": "これはまた…素朴な食べ物だね…私はこれでいいかな、食べきれそうにないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721700305,
					"content": "味さえよければ問題ないさ、私はこれで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721700306,
					"content": "これは旅人の分だな。あとこの「おにぎり」のレシピも書いといてやったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700307,
					"content": "「おにぎり」は簡単に作れそうだが、美味しく作るにはそれなりの技術が必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700308,
					"content": "おっと…お喋りはこの辺にしよう、俺もそろそろ食べるとするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700309,
					"content": "おい！パルヴァネ、さっき食べきれそうにないとか言ってただろう？ちょっとは残してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
