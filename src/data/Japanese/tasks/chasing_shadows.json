			},
			"dialogs": [
				{
					"id": 201010301,
					"content": "うわっ…た、食べないでくれ！——んっ、あれ…人間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010302
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010302,
					"content": "この辺の見張りは…全員倒されたもんだから…「アビス教団」の怪物が攻めてきたのかと思ったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010303,
						201010305
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010303,
					"content": "天空のライアーを取りに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010304
					]
				},
				{
					"id": 201010304,
					"content": "お、お前らなぜ「天空のライアー」がここにあると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010309,
					"content": "秘宝を保管する場所に入るには鍵が必要だ…鍵が欲しいならこの先だ、オレは持ってないからな、こっち来るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010310
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010310,
					"content": "どいつが鍵を持ってるかは知らねえ…とにかく、部屋の中のヤツらに聞け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010311
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010311,
					"content": "かなりのビビりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 201010312,
					"content": "フン…あとは知らねえからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010313
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010313,
					"content": "モンドには…オレらの「執行{RUBY#[S]ファトゥス}官」がいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010314
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010314,
					"content": "「シニョーラ」様に見つかって目つけられても、オレは関係ねえからなッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010305,
					"content": "命をもらいにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010306
					]
				},
				{
					"id": 201010306,
					"content": "ひぃっ————",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010307
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010307,
					"content": "やめてくれ…！そうだ、貴重な情報を教えてやるから！なっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010308
					],
					"speakerTitle": "「ファデュイ」守衛"
				},
				{
					"id": 201010308,
					"content": "実はモンドの至宝「天空のライアー」が、この遺跡の奥に隠してあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「ファデュイ」守衛"
				}
			]
		},
