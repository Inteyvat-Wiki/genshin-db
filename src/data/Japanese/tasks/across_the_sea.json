			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダイパイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "旅人、気を付けた方がいい、今は観光に向いてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100102,
					"content": "ん？なんかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100103,
					"content": "ああ、出るはずのない遺跡守衛が出没してるとの目撃情報が多数届いてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100104,
					"content": "それらの出所を調べたところ、ある遺跡から突然出てきているということがわかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100105,
					"content": "誰かが起動させたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100106,
					"content": "分からない、まだ情報が少ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100107,
					"content": "それにあの遺跡はかなり不気味で、中から「カラカラ」っていう音が聞こえる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100108,
					"content": "本部の許可が下りるまで、我々も探索できないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100109,
					"content": "慎重に行った方が良さそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "とにかく、一般人に被害が出ないよう、今は見回りを強化するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100114,
					"content": "確かに一般人が遭遇したら危ないもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100115,
					"content": "協力しようか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "心遣いはありがたいが…それで貴殿が危険な目に遭ったら、申し訳ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100117,
					"content": "こいつは強いから、心配ないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100118,
					"content": "護身術ができるから安心して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100122,
					"content": "それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100123,
					"content": "<color=#00E1FFFF>山腹</color>で遺跡守衛の足跡を見かけたんだが、通行人に注意することで精一杯でまだ調査できてないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100124,
					"content": "おう、それを調査してほしいんだな？任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100125,
					"content": "「千岩牢固、揺るぎない」、ありがとう、旅人。見回りが終わったら、俺も合流する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100120,
					"content": "10体くらい倒せる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "ハハッ、自信があるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100110,
					"content": "効率が悪い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "ん？今なんか言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100112,
					"content": "おまえ、騎士団を批判してるディルックの旦那に似てきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"テウセル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}見て！すごく大きい、かっこいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100202,
					"content": "変わった格好をした子供だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100203,
					"content": "こんなに近くで見たのは初めてだよ。これ、何か知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100204,
					"content": "動力を失った「遺跡守衛」だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "違う違う、こいつの名前は「独眼坊」だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100208,
					"content": "「独眼坊」？…そんなかわいい名前だったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100209,
					"content": "うん！お兄ちゃんが教えてくれたんだ、僕のお兄ちゃんはおもちゃ屋の販売員でね、こういうのを売ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100210,
					"content": "今、璃月の「おもちゃ研究所」にいて、「独眼坊」はそこで生まれたって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100211,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}もおもちゃ好きだよね。飛んでるそれは最新型かな？話せるんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100212,
					"content": "パイモンも遺跡守衛もおもちゃじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "そうだ！そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100216,
					"content": "ご苦労さん、何か…おや？この坊やは余所の国の子かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100217,
					"content": "さっき知り合ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100218,
					"content": "坊や、この辺に人殺し機械が出没してるんだ、危ないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100219,
					"content": "「人殺し機械」って、こんな感じの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100220,
					"content": "そうだよ、こいつもだ、動き出したらまずいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100221,
					"content": "人殺し機械なんかじゃないよ！「独眼坊」は正義の味方だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100222,
					"content": "…ど、独眼坊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100223,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、「独眼坊」の悪口を言ってる人は悪いやつだから、相手しちゃだめだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100224,
					"content": "坊や、俺はただ心配で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100225,
					"content": "もう聞く耳ないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "すまない、子供の相手は苦手なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100228,
					"content": "この子のことはオイラたちがなんとかするよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100229,
					"content": "ああ、助かる…俺は見回りを再開するが、その子を安全な場所に連れて行ってくれ。ここは危ないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "ダイパイ"
				},
				{
					"id": 110100230,
					"content": "へへっ、「独眼坊」が悪いやつを追い払った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100231,
					"content": "名前はなんて言うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "あっ、僕はテウセル！お兄ちゃんを探すためにスネージナヤから来たんだけど、居場所が分からなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100234,
					"content": "スネージナヤか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100235,
					"content": "そうだ、こういう時は…はい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100236,
					"content": "ん？なんだ…重いぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100237,
					"content": "これはッ…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100238,
					"content": "なんでモラ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "お兄ちゃんからもらったんだ、これを気になる人に渡せば相手も優しくしてくれるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100241,
					"content": "す、すごい理屈だな…これでスネージナヤから璃月まで来れたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100242,
					"content": "テウセルはお金持ちの子なんだな。おもちゃ売りは儲かる仕事だったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100243,
					"content": "ありがたくいただく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#本当に？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100246,
					"content": "じゃあ、僕と指切りしてよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100247,
					"content": "「指切りげんまん嘘ついたら氷漬けにさーれる、指切った！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100248,
					"content": "スネージナヤらしい指切りの歌だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100249,
					"content": "しばらく子守りするしかなさそうだな…でも、どこを探せばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100250,
					"content": "スネージナヤと関係がある場所…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "スネージナヤと関係がある…そうだ、<color=#00E1FFFF>北国銀行</color>に行ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100254,
					"content": "もう出発するの？お兄ちゃんに会えるかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>北国銀行</color>？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "おう、いいアイデアだな！行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100244,
					"content": "貰うね(後でそのお兄ちゃんに返そう)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "た、大量のモラ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "家族はどこにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "こっちに任せて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "へへっ！羨ましいでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "おい！オイラはおもちゃじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100206,
					"content": "気を付けて、危ないから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "そう！「独眼坊」はちょーーー強いんだ。悪いやつは逃がさないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "テウセル"
				}
			]
		},
