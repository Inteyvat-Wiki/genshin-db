			"dialogs": [
				{
					"id": 110100301,
					"content": "公子様、それは宜しくないかと思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 110100302,
					"content": "一回だけだし、いいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100303,
					"content": "ゲッ？こいつもいるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100304,
					"content": "お兄ちゃんだ！お兄ちゃん、お兄ちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100305,
					"content": "この声…まさか！ああ、テウセルだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100306,
					"content": "アハハハッ…兄ちゃんへのサプライズかい？テウセル。スネージナヤに戻らないと会えないと思ってたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100307,
					"content": "トーニャ、それからアントン…みんなはどう？元気かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100308,
					"content": "みんなお兄ちゃんに会いたがってるよ、トーニャお姉ちゃんは毎日お兄ちゃんの無事を祈ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100309,
					"content": "…待って、テウセル！どうやって璃月に来たんだい、連絡も何もなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100310,
					"content": "えっと…お兄ちゃんが乗ってるかなと思っておもちゃ売りの船に乗ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100311,
					"content": "船を降りた後、歩いてたら「独眼坊」に遭遇したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100312,
					"content": "#「独眼坊」が悪いやつを追い払って、それからこの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}と一緒にここに来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100313,
					"content": "密航で来たのか…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "しかも…「公子」の弟だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100316,
					"content": "なんか兄弟揃ってモラをくれるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100317,
					"content": "危ないぞ、テウセル。会えたのは嬉しいけど、もうこういう危ないことしないと兄ちゃんと約束してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100318,
					"content": "うっ…分かった。お兄ちゃん、ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100319,
					"content": "怒ってないよ、心配してるだけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100320,
					"content": "それにこの二人じゃなかったら、もっと危なかったぞ。ちゃんとお礼は言った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100321,
					"content": "うん！ちゃんと言ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100322,
					"content": "やっとオイラたちに気付いたのか？お兄ちゃん～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100323,
					"content": "ハハハッ、ごめんね、家族はいつだって最優先だ、どうか分かってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100324,
					"content": "それに、今は敵対する理由もないし。立場上の問題は一旦忘れてくれよ…俺たち、仲良くしてたじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100325,
					"content": "本当にあっさりしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "ハハッ、「あの件」に関して、俺たちはただの駒に過ぎない。後片付けは…対局をしていた当事者に任せよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100328,
					"content": "俺が気にしているのは、俺たちのあの一戦だけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100329,
					"content": "なんだ？もう一度やるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100330,
					"content": "ハハッ、このタルタリヤ、前と違って次は簡単に負けないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100331,
					"content": "こっちだって強くなってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "おい、今からやるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100334,
					"content": "ハハハッ…今回はいいや、子供の教育によくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100335,
					"content": "#喧嘩？お兄ちゃんはこの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTERA]}と仲悪いの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100336,
					"content": "#まさか？もう一度礼を言うよ、{NICKNAME}、弟を送ってくれてありがとう。俺にとって大事な家族なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100337,
					"content": "それでも警戒はするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "そういえば…聞きたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100340,
					"content": "テウセルのお兄ちゃんは「おもちゃ販売員」だよな？でもおまえはファデュイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100341,
					"content": "コホン…ん…あー、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100342,
					"content": "シッ…子供にとっておもちゃ売りは人気のある仕事だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100343,
					"content": "それに、家族にはファデュイ…国の闇に触れてほしくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100344,
					"content": "俺が女皇に遣われてることを知ってる家族もいるけど、末っ子のテウセルには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100345,
					"content": "コホン、俺はスネージナヤで一番人気のおもちゃ販売員、今は璃月の「おもちゃ研究所」に所属してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100346,
					"content": "わあー、お兄ちゃんすごい！「独眼坊」の相棒だもんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "テウセル"
				},
				{
					"id": 110100347,
					"content": "テウセルの前では合わせてほしい、頼む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100348,
					"content": "そうだ、エカテリーナ。回収の件、今から出発するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110100349,
					"content": "逃げようとしてるじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110100350,
					"content": "しかし、「公子」様に借金回収をさせるなんて、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "エカテリーナ"
				},
				{
					"id": 110100351,
					"content": "仕方ない、賭けであの「デットエージェント」に負けたんだから。体を動かしてくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
