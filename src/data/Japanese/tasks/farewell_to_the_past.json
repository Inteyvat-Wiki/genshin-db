			"dialogs": [
				{
					"id": 120410501,
					"content": "うぅ…頭がクラクラするぞ。どこかに引き込まれたみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410502,
					"content": "あっ！この場所って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410503,
					"content": "「一心浄土」に似てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410504
					]
				},
				{
					"id": 120410504,
					"content": "おい、あっち見ろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410505,
					"content": "もう一人、影がいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410506,
					"content": "またお会いしましたね、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410507
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410507,
					"content": "この身は内なる者の協力者であり、規則の守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410508
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410508,
					"content": "内なる者が規則から逸脱しようものなら、この身は…修羅と化しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410509
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410509,
					"content": "この感じ…まさか人形の将軍か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410510,
					"content": "あなたは私の体で俗世を巡り、永遠の真諦を掴んだようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410511
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410511,
					"content": "今の自分のほうが、過去の自分よりも決意が固く、考えが正しい。そう思っているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410512
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410512,
					"content": "それは新たな考えを得たから？それとも抗うことのできない「摩耗」を受けたからですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410513
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410513,
					"content": "それをあなたに答えるために、私は来たのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410514
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410514,
					"content": "私たちは武人。今この場における対話は、「刀を交えること」のみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410515
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410515,
					"content": "あわわ…ふ、雰囲気が一気に変わったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410516,
					"content": "も、もう…だ、だだ大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410517,
					"content": "先ほどの不調は、私に体を使わせまいと将軍が抵抗していたからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410518
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410518,
					"content": "彼女が言ったように、私が「変化」する考えを持った時点で、彼女は私を敵と見なします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410519
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410519,
					"content": "ただ、意識空間に入れば、私は彼女から独立した存在となり、干渉を受けることがなくなるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410520
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410520,
					"content": "将軍は人形ですが、自我を持っています。必要な時に、ここに現れて私と対決するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410521,
						120410522
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410521,
					"content": "これが以前言ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				},
				{
					"id": 120410523,
					"content": "えっと…影はどんな困難があってもやり遂げるって言ってたけど、まさか自分と戦うことになるなんて誰も想像してなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410524,
					"content": "影と将軍が戦うなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410525,
					"content": "私が将軍に定めた規則…いえ、将軍こそかつての私の理想。「永遠」の礎であり、揺るぎない存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410526
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410526,
					"content": "必要がなければ、私は彼女を変えることなどしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410527
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410527,
					"content": "もう他に方法はないのか？手を出さなくても丸く収まるみたいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410528,
					"content": "影は自分の退路を残すような人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410529
					]
				},
				{
					"id": 120410529,
					"content": "でも、二人とも稲妻のためを思ってやってるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410530,
					"content": "この身は、無上なる威厳を象徴し、一国を統べる権限を与えられ、「雷電将軍」の一切を凝集したもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410531
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410531,
					"content": "当然のことながら、影が前進する中、絶え間なく失われていく苦しみと、永遠を目指す決心も受け継いでいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410532
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410532,
					"content": "これもすべて、「摩耗」に対抗するため。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410533
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410533,
					"content": "決心、勇猛、愛慕、憎悪…そのすべてが時間という長い川の中で歪み、変わっていくのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410534
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410534,
					"content": "「規則」のみが、永遠を保つことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410535
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410535,
					"content": "確かにそれが、あなたを作った時の私の考えでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410536
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410536,
					"content": "同時に、私が越えなければならない高き壁にもなったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410537
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410537,
					"content": "あなたは、私の敵になるというのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410538
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410538,
					"content": "私はあなたの過去であり、永久不変の規則であり、「永遠」の守護者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410539
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410539,
					"content": "ならば私は、臣民に夢を与えし——「雷電影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410522,
					"content": "永遠なる防御機能？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410523
					]
				}
			]
		},
		{
			"id": 1204106,
