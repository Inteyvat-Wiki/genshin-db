			"dialogs": [
				{
					"id": 120410401,
					"content": "着きました、入り口はここです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410402
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410402,
					"content": "うわっ、鳥居が現れた！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410403,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410404
					]
				},
				{
					"id": 120410404,
					"content": "また悪化したような気がします…でも大丈夫です。なるべく早くすべてを終わらせなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410405
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410405,
					"content": "ここはかつて私が直々に封じた…雷電眞の意識空間への入り口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410406
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410406,
					"content": "どうやら、「彼女」はもう、私にこの体を好き勝手使わせる気がないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410407
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410407,
					"content": "ん？どういうことだ、彼女って誰だよ？眞のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410408,
					"content": "ついて来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410409
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410409,
					"content": "ついて行くって、どこに…ってうわぁあ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
