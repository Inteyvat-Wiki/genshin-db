			"dialogs": [
				{
					"id": 120410701,
					"content": "オイラたち、追い出されたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410702,
					"content": "どうするんだよ？本当に影と将軍をあのままずっと戦わせるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410703,
					"content": "ああすることでしか、将軍の規則は変えられないって言ってたけど…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410704,
						120410705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410704,
					"content": "影にはもう肉体がないから、将軍が必要。",
