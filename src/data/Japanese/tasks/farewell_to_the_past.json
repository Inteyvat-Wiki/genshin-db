			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410601,
					"content": "やっと倒せたのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410602,
					"content": "その武芸、衰えてはいないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410603
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410603,
					"content": "しかしその意志は、いつまで持つでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410604
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410604,
					"content": "そ、そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410605,
					"content": "人形の将軍は無敵なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410606
					]
				},
				{
					"id": 120410606,
					"content": "ここは意識空間、彼女の存在はそう揺らぐことのないものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410607
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410607,
					"content": "彼女は摩耗に対抗するために生まれました。意志に関しては、彼女は生きとし生けるものの頂点に立つでしょう。当然、あなたも私も含めて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410608
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410608,
					"content": "じゃ、じゃあこの戦いって…終わりがないってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410609,
					"content": "よもや、それもあり得なくはないでしょう。ですが私は、今の私の意志が決して摩耗による産物でないことを、彼女に証明しなければなりません。私の切り開く未来は、きっと摩耗にも耐えうるほど偉大なものであると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410610
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410610,
					"content": "これを乗り越えなければ、将軍の規則を変えることはできません。稲妻も…「前進」することはないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410611
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410611,
					"content": "これは私の責任です。たとえこの戦いが何か月、何年、何世紀…どれだけ続こうと…何度でも私は彼女を倒します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410612
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410612,
					"content": "じゃあ、その間の稲妻はどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410613
					]
				},
				{
					"id": 120410613,
					"content": "五百年前、人間は戦うことで自らの力を証明しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410614
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410614,
					"content": "そして今、彼らは「願い」を頼りに新たな道へ歩もうとしています。まるで、古き櫻が新しい枝を伸ばすかのように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410615
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410615,
					"content": "そろそろ私も——彼らを信じることを学ばなくてはなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410616,
						120410617
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410616,
					"content": "人間が一人で進んでいってもいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				},
				{
					"id": 120410618,
					"content": "はい、分かっています。ですがもし、眞の言った「夢想」こそが正真正銘の永遠なら、将軍のいない「須臾」など恐るるに足りません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410619
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410619,
					"content": "稲妻の果てしない未来のためならば、どんなに長い戦いも、「永遠」の中の一瞬に過ぎないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410620
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410620,
					"content": "私は稲妻の臣民に、必ず帰ると誓いました。この誓いは、あなたが見届けてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410621
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410621,
					"content": "私のいない間、すべてを神子たちに任せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410622
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410622,
					"content": "でも、でもそれじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410623,
					"content": "私の言葉を伝えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410624
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410624,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410625
					]
				},
				{
					"id": 120410625,
					"content": "うわぁっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410617,
					"content": "みんな将軍様こそが希望だと思ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410618
					]
				}
			]
		},
