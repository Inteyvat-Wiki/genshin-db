			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410201,
					"content": "影、やっぱりここはオイラたちに任せろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410202,
						120410203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410202,
					"content": "なんだか様子がおかしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				},
				{
					"id": 120410204,
					"content": "私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410205
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410205,
					"content": "すみません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410206
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410206,
					"content": "大丈夫だ。影は後ろで休んどけ、体力を回復しとくんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410207,
					"content": "魔物はオイラたちがやっつける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410208,
					"content": "あれ…またあの光だ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410209,
						120410210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410209,
					"content": "また来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410211,
					"content": "こ、ここは一体？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410212
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410212,
					"content": "それに君たちは…なっ、将軍様！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410213
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410213,
					"content": "将軍様、まさかケガをされているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410214
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410214,
					"content": "くっ…平気です。ただ体が思うように動かないだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410215
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410215,
					"content": "我ら幕府武士、必ずや将軍様を最後まで守り抜いてみせましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410216
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410216,
					"content": "野郎ども！かかれッ！また魔物が攻めて来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410217
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410217,
					"content": "いけません、危険すぎます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410218
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410218,
					"content": "これこそ我々の使命です！危険を恐れていては、はなから武器など握ってはおりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410219
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410219,
					"content": "将軍様、ご安心を。このような苦境に立たされた時こそ、神によって与えられた我々の力が意味を持つのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410220
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410220,
					"content": "それって、神の目？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410221,
					"content": "そうです。神は全能であり、人間に力を与えます。つまり、我々に深い期待を寄せているということでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410222
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410222,
					"content": "そして、将軍様が苦境に立たされている今、我々はその誓いを果たさねばなりません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410223
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410223,
					"content": "当時、戦ってた人たちって、こんな風に神の目のことを見てたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410224,
						120410225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410224,
					"content": "希望に満ちたもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410226,
					"content": "将軍様がどこへ行ったのか分からず、みんな絶望の淵に立たされておりました。しかし今、将軍様はここにいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410227
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410227,
					"content": "将軍様が再びみなの前に姿を見せれば、我々の心にある希望も再び燃え上がることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410228
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410228,
					"content": "この希望こそ、暗闇を駆け抜ける光の道しるべとなるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410229
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410229,
					"content": "さあ、みなの者、共に戦おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410230
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410230,
					"content": "オイラたちも戦うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410231,
					"content": "おっと、そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410232
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410232,
					"content": "分かった、安全には気をつけろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410225,
					"content": "揺るぎない抗争心を持ったもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410210,
					"content": "今回は何が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410203,
					"content": "無理しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				}
			]
		},
		{
