			"trigger": {
				"objectNames": [
					"雷電将軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120410301,
					"content": "どうやら、やつらの侵攻が止まったようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410302
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410302,
					"content": "こんなにも激しい戦いを経験したのは初めてだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410303
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410303,
					"content": "ありがとうございます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410304
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410304,
					"content": "あれ？もう平気なのか？まだ休んでてもいいんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410305,
					"content": "問題ありません、少しよくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410306
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410306,
					"content": "見事な手際、感服いたしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410307
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410307,
					"content": "あれら魔物は必ずまたやって来るでしょう。その時はおそらく、獣域ハウンドのような小物だけではないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410308
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410308,
					"content": "ここはすぐにでも将軍様に稲妻城へとお戻りいただき、大将の率いる軍隊と合流してもらうのが得策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410309
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410309,
					"content": "それに将軍様の帰城を目にすれば、きっとみなの士気も上がることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410310
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410310,
					"content": "じゃあ、おまえらはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410311,
					"content": "我々はここに残って魔物どもの足止めをします。これ以上やつらを先に進ませるわけにもいきませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410312
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410312,
					"content": "仲間たちと協力し合えば、敵の数がどんなに多かろうと問題はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410313
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410314,
						120410315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410314,
					"content": "（彼らにとってはこれが正しい「現実」。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				},
				{
					"id": 120410316,
					"content": "お任せください！戦うことこそ、俺たちがもっとも得意とすることですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410317
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410317,
					"content": "将軍様は特別な存在。将軍様だけがこの絶望的な現状を覆し、我々を未来へと導くことができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410318
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410318,
					"content": "稲妻がいかなる脅威に晒されようとも、我々には将軍様を永遠に信じ続けるだけの理由があるのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410319
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410320
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410320,
					"content": "感謝いたします。あなたたちに誓いましょう、稲妻に明るい未来をもたらすことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410321
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410321,
					"content": "その約束が果たされるのは少々遅れてしまいましたが、少なくともこの瞬間から、それが守られることを保証します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410322
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410322,
					"content": "将軍様のそのお言葉だけで、我々はどんな困難にも立ち向かっていけます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410323
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410323,
					"content": "きっとあなた様と共に、稲妻が失ったものをすべて取り戻してみせましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410324
					],
					"speakerTitle": "深見"
				},
				{
					"id": 120410324,
					"content": "常道を恢弘せしは、永遠なる鳴神なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410325
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410325,
					"content": "常道を恢弘せしは、永遠なる鳴神なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410326
					],
					"speakerTitle": "藤木"
				},
				{
					"id": 120410326,
					"content": "消えちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410327,
						120410328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410327,
					"content": "さっきの誓いって、彼らに対して？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410329,
					"content": "彼らに対してであり、私に対してです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410330
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410330,
					"content": "人々の犠牲は、私に計り知れないほどの苦痛をもたらしました。私は、彼らが自身の一切を燃やし尽くす姿と光り輝く姿を無視していたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410331
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410331,
					"content": "その結果——何百年もの間、彼らの意志を蔑ろにしてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410332
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410332,
					"content": "「彼らに何を言っても意味はなく、彼らは地脈の中に漂う記憶に過ぎない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410333
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410333,
					"content": "たとえそうだとしても、私は彼らに…今まで私を信じて疑わなかった人々に応えなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410334
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410334,
					"content": "オイラ思うんだけどさ…思いに応えてくれたのが、たとえ何百年後だったとしても、それでも報われたんじゃないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410335,
					"content": "慰めてくれるのですね…ありがとうございます。しかし、これは元より稲妻の神がやるべきことです。私は行動するのが遅すぎました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410336
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410336,
					"content": "先ほどの武士が言ったように、私は戦士の担うべきことをすべて引き受けていればいいとだけ思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410337
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410337,
					"content": "ですが稲妻に必要なのは、眞のような人物です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410338
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410338,
					"content": "たとえ私と眞がまったく異なっていて、永遠に彼女のようにはなれないとしても——私のやるべきことは、彼女と同じであるべきなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410339
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410339,
					"content": "人間は、影の信頼に値する存在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410340
					]
				},
				{
					"id": 120410340,
					"content": "ええ。強くて、たくましい、誇るべき存在です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410341
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410341,
					"content": "人々に崇められる雷電将軍が、彼らの足を引っ張ってはいけませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410342
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410342,
					"content": "おっ！どうやら、考えがまとまったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410343,
					"content": "稲妻には新たな変化と可能性があります。しかしそれと同時に、時間も必要なんです。「過去」が私たちに残した傷跡は、「未来」へと至る時間の中で癒されていくことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410344
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410344,
					"content": "どれほど時間を費やすことになろうとも、私はやり遂げてみせます。これは私自身が約束したことですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410345
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410345,
					"content": "獣域ハウンドを一掃した今、この件も解決へと向かうことでしょう。今のところ、やつらがこれ以上の脅威をもたらす気配はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410346
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410346,
					"content": "原因の究明や傷ついた神櫻の手当てなどについては、天領奉行か社奉行の者に対応させます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410347
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410347,
					"content": "おう、じゃあ行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410348,
					"content": "影、すごく落ち着いてるように見えるけど、内心はざわついてるんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410349,
					"content": "なんか影って、ここ最近ですごく変わったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410350,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410351,
					"content": "どうしたんだ、影？はやく行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410352
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410352,
					"content": "くっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410353
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410353,
					"content": "影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410354
					]
				},
				{
					"id": 120410354,
					"content": "どうしたんだよ、また具合が悪くなったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410355
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410355,
					"content": "体が…動きません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410356
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410356,
					"content": "どうやら、事態は私の思っていた以上に深刻なようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410357,
						120410358
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410357,
					"content": "ちょっと休憩する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410359,
					"content": "いえ、「彼女」が私を呼んでいます。今が絶好の機会でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410360
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410360,
					"content": "#{NICKNAME}、私の体を支えていただけませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410361
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410361,
					"content": "鳴神大社の下にある…洞窟へ行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410362
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410362,
					"content": "洞窟？中になにかあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410363
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410363,
					"content": "そここそが…過去を断ち切り、未来へと進むための戦場です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410358,
					"content": "とりあえず稲妻城に戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410328,
					"content": "自分に対して誓ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410315,
					"content": "じゃあ、ここは任せた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				}
			]
		},
