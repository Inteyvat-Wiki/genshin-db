			},
			"dialogs": [
				{
					"id": 120410101,
					"content": "先ほどと同じように、私に任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410102
					],
					"speakerTitle": "雷電将軍"
				},
				{
					"id": 120410102,
					"content": "おいおい、ほ、本当に大丈夫なのか？オイラたちをおどかすなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120410103,
					"content": "大丈夫です、戦闘は私のもっとも得意とすることですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電将軍"
				}
			]
		},
		{
			"id": 1204102,
			"completionStepIds": [
				1204106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
