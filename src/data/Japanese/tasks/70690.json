			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アリス",
					"リサ"
				],
				"points": [
					{
						"sceneId": 1004,
						"position": [
							-16.379,
							-5.223,
							-16.718
						],
						"pointId": 286
					}
				]
			},
			"dialogs": [
				{
					"id": 706900201,
					"content": "ふぅ、やっと最後の一山だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900202,
					"content": "いったいどんな本なんだ…『ヒルチャールのサバイバル術』？ヒルチャールって本は読まないだろ？それに『トリックフラワー栽培ガイド』って、誰がそんなもの育てたいと思うんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900203,
					"content": "これは『小さな魔女の辞典』…うーん、名前からして怪しいぞ。それに、こっちはもう整理したはずだよな。この本って見た覚えあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900204,
						706900206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900204,
					"content": "目録にはないみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900205
					]
				},
				{
					"id": 706900205,
					"content": "魔女って聞くと、どうしても思い浮かぶのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900207,
					"content": "あら、私を探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900208
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900208,
					"content": "えっ？アリス！？どこから現れたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900209,
					"content": "パイモンは気づいてないかもしれないけど、私が急に現れたわけじゃない。あの辞典を開いた瞬間から、あなたたちは魔女の「領域」に入ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900210
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900210,
					"content": "うわぁ、やっぱり！あの本、なんか変だと思ったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900211,
					"content": "ふふ、『小さな魔女と消えない炎』っていう物語を読んだことはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900212,
						706900214
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900212,
					"content": "どこかで読んだことがあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900213
					]
				},
				{
					"id": 706900213,
					"content": "それなら説明しやすいね。内容は全然関係ないけど、この本は一応、あの物語のために作られた辞典ってことになるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900216
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900216,
					"content": "そんなふうに説明されたら、余計にわからなくなったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900217,
					"content": "うーん、どこから話せばいいかしら…魔女会が三首会談でファルカに「約束」をしたことは知ってるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900218
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900218,
					"content": "「モンドが最も助けを必要とする時、魔女たちはこの地に戻り、モンドの力になると。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900219
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900219,
					"content": "でも、大人しく危機が訪れるのを待つなんて、魔女会らしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900220
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900220,
					"content": "「物語の終盤になって突然英雄が現れるよりも、事前に伏線を張っておいたほうが納得できる」って、Mも言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900221
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900221,
					"content": "それに危機がいつ訪れるかなんて、誰にも分からないもの。来世かもしれないし、明日かもしれない。準備はしておかないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900222
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900222,
					"content": "だから魔女たちにこの辞典を書いてもらったんだ。もちろん、例の物語本を口実にしてね。そうでもしないと、みんな集まってくれないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900223,
						706900224
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900223,
					"content": "大変だったんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900225
					]
				},
				{
					"id": 706900225,
					"content": "簡単に言うと、この辞典には、バービーの水占の盤を見た魔女たちが作った、モンドの人々のための「課題」がたくさん載ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900226
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900226,
					"content": "共通の目標のために、仲間たちと一緒に困難を乗り越えて成長する…それこそ、危機が訪れる前にできる最良の準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900227
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900227,
					"content": "それって、なんかとんでもないことが起こるみたいに聞こえるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900228,
					"content": "そんなことは言ってないよ。ただ「仲間」と言っても、モンドのみんなにとって仲間と呼べる人物は、一人しかいないかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900229,
						706900230
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900229,
					"content": "なるほど、やっと分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900231
					]
				},
				{
					"id": 706900231,
					"content": "もしかして、最初からこの話にオイラたちを巻き込もうとしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900232,
					"content": "えぇ？まさかこんなことになるなんて、思ってもみなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900233
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900233,
					"content": "うぅ、ズルいぞ、アリス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900234,
					"content": "ふふっ。でもこんな重要なものを、軽々しくテイワットに持ち込むわけにはいかないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900235
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900235,
					"content": "だから「木を隠すなら森の中」って言葉にならうことにしたの。これらの本は、注目されないように、わざわざ私が図書館に寄贈したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900236
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900236,
					"content": "別に悪いことじゃないしね。あなたたちにとっても、仲間に会える良い機会になるんだし、私を助けると思って、ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900237
					],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900237,
					"content": "まったく、おまえには敵わないな。でも、モンドのみんなを助けられるなら、オイラたち、協力するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900238,
					"content": "この辞典はオイラたちが預かっとくぜ。今度みんなに会う時、本の中の「課題」を届けてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900239,
					"content": "本当にありがとう。それじゃあ、あまり長居はしないでおくね。仲間たちと楽しく過ごせるよう、祈ってるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アリス"
				},
				{
					"id": 706900230,
					"content": "最初からこうなる気がしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900231
					]
				},
				{
					"id": 706900224,
					"content": "#それで、この本は{M#俺}{F#私}たちと何か関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900225
					]
				},
				{
					"id": 706900214,
					"content": "聞いたことすらない。",
					"roleType": "TALK_ROLE_PLAYER",
