			},
			"dialogs": [
				{
					"id": 706900101,
					"content": "うわぁ、本がいっぱいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900102,
					"content": "図書館で本を整理するだけなのに、特級の依頼だって言われたから、オイラも覚悟はしてたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900103,
					"content": "それにしたって、これはすごすぎるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900104,
					"content": "あら、可愛い子ちゃん、それにパイモンちゃんも。モンドに戻ってくる時間ができたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900105
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900105,
					"content": "もしかしてお姉さんのことが恋しくなっちゃって、わざわざ会いに来てくれたのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900106,
						706900108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900106,
					"content": "その通りだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900107
					]
				},
				{
					"id": 706900107,
					"content": "しばらく見ないうちに、ずいぶん口が達者になったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900109
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900109,
					"content": "やっと見つけたぞ、リサさん。てっきり今日はいないのかと思ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900110,
					"content": "ふふっ、今日はもともと働くつもりはなかったのよ。でも、キャサリンから「ようやく誰かが図書館の重要な依頼を受けてくれた」って聞いたものだから、ちょっと様子を見に来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900111
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900111,
					"content": "あっ、もしかして…依頼を受けてくれたのはあなたたち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900112,
						706900113
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900112,
					"content": "そのとおり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900114
					]
				},
				{
					"id": 706900114,
					"content": "それなら本当に助かるわ。見ての通り、最近とある匿名希望の支援者さんが、図書館に大量の本を寄贈してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900115
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900115,
					"content": "目録をざっと確認したけど、どれも図書館にはなかった新しい本ばかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900116
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900116,
					"content": "それにジャンルも様々で、かなり厄介な禁書も何冊か混じっていたわ…こうなってくると、適当に誰かを呼んで雑用を頼むわけにもいかないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900117
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900117,
					"content": "それで本当に困っていたの…本の分類と整理を全てお姉さん一人でしていたら、どれだけ時間がかかるか分からないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900118
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900118,
					"content": "でも、あなたたちが来てくれたなら安心だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900119
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900119,
					"content": "アフタヌーンティーをご馳走したいところだけど、この状況だとそれも難しそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900120
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900120,
					"content": "大丈夫だぞ！リサさんの依頼なら、オイラたちに任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706900121,
					"content": "パイモンちゃんは優しいわね。それじゃあ、ここはあなたたちにお願いするわ。邪魔にならないよう、わたくしはここで失礼するわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 706900113,
					"content": "ここには他に誰もいないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900114
					]
				},
				{
					"id": 706900108,
					"content": "さっそく本題に入ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900109
					]
				}
			]
		},
		{
			"id": 7069002,
			"completionStepIds": [
				7069001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
