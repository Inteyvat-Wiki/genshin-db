				]
			},
			"dialogs": [
				{
					"id": 80190401,
					"content": "おや、客人かい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190402,
					"content": "こんにちは！アマディアじいちゃん、オイラたちヴィマラ村が出した依頼を受けて来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190403,
					"content": "おお、そうだったか、ご苦労さん。こんなところまで来てもらって申し訳ないのう。どうか、あの子を見つけてやってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190404,
					"content": "おう。オイラたちいなくなった人のことをもう少し詳しく知りたいんだけど、知ってることを教えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190405,
					"content": "ああ、もちろんいいとも。お前さんたちの役に立つのなら何でも教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190406,
					"content": "ワシは目が不自由で、以前はよくあの子の声を耳にしておった…だが、こうしてあの声が聞こえなくなると、心にぽっかりと穴が開いてしまったかのような気分じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190407,
					"content": "あの子の両親はこのヴィマラ村におらんようじゃ。でも、あの子が寂しそうにしてたことは一度もなかった。それどころか、いつも率先して他人の孤独を和らげようと誰かの相手をしておったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190408,
					"content": "一人暮らしの老人のところへ家事を手伝いに行ったり、村の孤児の遊び相手になってあげたりとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190409,
					"content": "それから誰かが辛い目に遭えば、あの子はその話を聞いておった。人を慰めるのも上手じゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190410,
					"content": "村長として、あの子にはいくら感謝してもしきれない。精神面のケアをするのは、本来ワシの役目の一つじゃからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190411,
					"content": "なるほどな。そいつの失踪をおまえたちが心配してる理由がなんとなくわかったぜ。本当に優しいやつだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190412,
					"content": "でも…名前、住所、それから家族のこととか、村長のアマディアじいちゃんでも知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190413,
					"content": "はぁ…そこは、まさにワシが一番負い目に感じてるところじゃよ。何があってもワシだけは覚えておくべきだったというのに…年を取ってしまったからなのかもしれん…どうしても思い出せなくてのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "アマディア"
				},
				{
					"id": 80190414,
					"content": "あっ…無理して思い出そうとしなくても大丈夫だぞ。オイラたちでなんとかするからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190415,
					"content": "旅人、おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190416,
					"content": "どうやら…ただの失踪事件じゃなさそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "だな。オイラもそう思うぞ…いくらなんでも、名前を覚えてる人がいないなんておかしすぎるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190419,
					"content": "住所も家族の情報もない…まるでこの世界から消えちゃったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190420,
					"content": "いや、どちらかというと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "えっと…それってつまり、この世界から「消された」んじゃなくて、そもそも「存在しなかった」ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190423,
					"content": "ちょっと待ってくれ。オイラこんがらがってきたぞ…記憶の中にしか存在しない人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190424,
					"content": "（ひょっとしたら、マハールッカデヴァータの時と同じように、集団で記憶に変化が起こってるのかも…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "あなたたち…ヴィマラ村に来たばかりの冒険者さん？もしかして、依頼を受けて来てくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190426,
					"content": "おう、そうだぞ。いま失踪事件の調査をしてるところなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190427,
					"content": "よかった、まだ諦めないでいてくれて…本当にありがとう。冒険者協会が依頼のキャンセルをしてしまわないか、ずっと心配してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190428,
					"content": "あ、わたしはアトッサ、ヴィマラ村の住民よ。その…どうか諦めずに、このまま調査を続けてくれないかな。お願い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190429,
					"content": "きっと見つかる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "おう、そう心配しないでくれ。ところで、アトッサは失踪したやつのことをよく知ってるのか？なにか手がかりは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190432,
					"content": "手がかり…って言えるかどうか分からないけど、一緒に来てくれる？ある場所にあなたたちを連れて行きたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190430,
					"content": "全力を尽くすとしか言えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "…記憶の中にしか存在しない人みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "引っかかる点が多い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
