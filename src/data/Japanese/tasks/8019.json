					}
				]
			},
			"dialogs": [
				{
					"id": 80190101,
					"content": "おや？ようこそお越しくださいました！実は今、あなたたちにしか頼めない依頼を預かっておりまして、ちょうど連絡しようと思っていたところなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190102,
					"content": "オイラたちにしか頼めない依頼？う～ん…もしかして「魔神級」の依頼ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190103,
						80190104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190103,
					"content": "そんな分類、初めて聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				},
				{
					"id": 80190105,
					"content": "ふふっ…冒険者協会の依頼にそのような分類はありませんよ。それに、この依頼も想像されているような規模のものではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190106,
					"content": "内容は、ただの「人探し」ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190107,
					"content": "ん？じゃあ…なんでオイラたちにしか頼めないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190108,
					"content": "はい。この間、積まれた依頼を整理していたときに、たまたまこの「人探し」の件を見つけまして——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190109,
					"content": "一見すると普通の依頼なのですが、十数回と失敗した記録が残っているんです。その中には名高い冒険者さんたちもいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190110,
					"content": "冒険者協会の信用を守るため、そしてスメール支部の業績向上を考えた結果、ここ数年で依頼の達成率が一番高い冒険者さんにお願いしたく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190111,
					"content": "…ふふん！もちろんオイラたちのことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190112,
						80190113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190112,
					"content": "パイモンは相変わらずチョロいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190114,
					"content": "ふふっ、お二方はこの依頼の最後の希望です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190115,
					"content": "もしあなたたちでも達成できないのであれば、依頼人に連絡して、取り下げの相談をしようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190116,
					"content": "そっか。じゃあ、さっそく教えてくれ！一体誰を探したらいいんだ？そもそも、なんでそんなに難しいんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190117,
					"content": "この人探しの依頼は、ヴィマラ村の方々が共同で出したものです。伺った話によりますと、ある村人が失踪したとのことですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190118,
					"content": "…依頼をした方々は失踪者の名前すら把握しておりません。覚えているのはただ、失踪者の大まかな特徴と顔だけとのこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190119,
					"content": "えっ？同じ村の人なのに、名前も知らないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190120,
					"content": "それに、冒険者たちがこぞって失敗してるんだろ？もしかしてそんな人物、ハナからいなかったってことはないか？それか…誰かのいたずらだったり…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190121,
					"content": "いえ、その可能性はおそらく低いでしょう。依頼を出された際には村の方が複数人いらっしゃいましたし、あの表情と話し方も、冗談を言っているようには思えませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190122,
					"content": "依頼を出すにも、手続料としてモラが必要です。このようないたずらをしたところで、何のメリットもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190123
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190123,
					"content": "確かに妙だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190124
					]
				},
				{
					"id": 80190124,
					"content": "とりあえず、まずはヴィマラ村で聞き込みをしてみてください。私のところにもいくつか資料はありますが、ここはやはり村の方々から直接情報を得たほうが信憑性も高いでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190125
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 80190125,
					"content": "おう、任せとけ。さっそく出発しようぜ！いろいろ話を聞いてたら、だんだん気になってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190113,
					"content": "必ず達成できるなんて保証はないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190104,
					"content": "任せて。どの魔神の相手をしたらいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				}
			]
		},
