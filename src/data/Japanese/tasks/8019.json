				]
			},
			"dialogs": [
				{
					"id": 80190501,
					"content": "この木の下か？連れてきたかった場所って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190502,
					"content": "うん。他と大差なく見えるけど、わたしにとっては思い出が詰まった場所なの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190503,
					"content": "よくこの木の下で話してたんだ、わたしたち。雲を見ながら風の流れを感じて、つい時間を忘れてしまうなんてこともしょっちゅうあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190504
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190504,
					"content": "わたしね、小さいころ森の中にいたらしくて、それをレンジャーが見つけてくれたの。で、ヴィマラ村に引き取られたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190505,
					"content": "みんなすごく良くしてくれたし、毎日楽しかった。でも、やっぱり当時は寂しくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190506,
					"content": "寂しい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190507,
					"content": "えっと…なんて言ったらいいかな…たまに楽しいことや悲しいことが心の中に湧いてくるの。でも、それを誰に話したらいいのか分からなくって。そもそも、誰かにこの気持ちを話していいのかどうかすらも…ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190508,
					"content": "みんな自分の暮らしがあるし、心の中を打ち明けるのって、時に迷惑になったりするでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190509,
					"content": "その気持ち、分かるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "えっ、あなたもそう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190512,
					"content": "#{M#俺}{F#私}にも、話を聞いてくれる家族がいた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190515,
					"content": "そっか。なら、よかった！本当に羨ましい…わたしにとってね、「彼」は家族であり、そして自分を理解してくれる友達でもあったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190516,
					"content": "どんなことでも、彼になら遠慮せずに話せた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190517,
					"content": "あの人は純粋で気配りが上手で、いつも興味津々って顔をしながら話を聞いてくれてた。退屈そうな顔は一度だって見せたことない。そう、まるで自分自身のことを聞いてるかのようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190518,
					"content": "…失踪してからも、話したいことが山ほどあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190519,
					"content": "ううん、それはもういい。彼にもう一度会えればそれだけで十分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190520,
					"content": "二人は本当に仲がいいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190521,
					"content": "じゃあ、そいつ自身のことでなにか教えてもらったことは？覚えてることはなにかないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190522,
					"content": "そうね…彼から聞いた話のほとんどはヴィマラ村で見た面白い出来事とか、思いもよらない空想じみたことだったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190523,
					"content": "あっ、そうだ。前に「あなたの両親はどこにいるの」って聞いたことあるの…でも、「彼らはここからいなくなった」って言葉が返ってきただけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190524,
					"content": "結局、それが単にここを離れたって意味なのか、それともこの世を去ったって意味なのかは聞く勇気がなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190525,
					"content": "となると、これといった手がかりはなしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190526,
					"content": "あ…こんなに話したのに、役に立てなくてごめんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190527,
					"content": "そんなこと言わないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "ふぅ…こんなにたくさん喋ったのは、彼と一緒にいたとき以来。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190530,
					"content": "そういえば、あの人と話すのはいつもこんな夕暮れ時だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190531,
					"content": "いま思い返してみると、彼と話してると時間の流れがすごくゆっくりになって、ずっと喋ってても、ぜんぜん日が暮れなかった気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "アトッサ"
				},
				{
					"id": 80190532,
					"content": "確かにリラックスしてると、時間の流れが遅く感じるよな…あれ、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190533,
						80190534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190533,
					"content": "毎回、同じ時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190535,
					"content": "（これまでに集めた情報から考えて、もう普通の人探しとして処理はできない気がする…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "（それにアトッサが言ってた時間の流れこそ、この謎を解く鍵かもしれない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "…あれ、あそこのヒルチャールたち、なんだか様子がおかしくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190538,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "あっ、アビス教団がいるぞ！？まさかあいつらがなにかやったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190540,
					"content": "気づかれたぞ！戦闘準備だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190534,
					"content": "時間がゆっくり流れた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190528,
					"content": "少なくとも彼のことをもっと知れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190513,
					"content": "でも今、理解してくれる友達がもっといる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190510,
					"content": "それこそ「家族」が存在する意味なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				}
			]
		},
