							2651.488
						],
						"pointId": 330400533
					}
				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "いらっしゃい！何かお求めで？私はここ一帯で商売を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190302,
					"content": "あ、いや、オイラたち用事があってここに来た冒険者なんだ。さっきキャサリンのとこでヴィマラ村の依頼を受けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190303,
					"content": "ああ…その件か。はぁ…わざわざこんなところまで足を運んでもらってすまないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190304,
					"content": "正直に言うと、ここの人たちはほぼ諦めてるんだ。やって来た冒険者はみんなやる気に満ち溢れてたが、結局すぐ諦めて帰ってしまったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190305,
					"content": "耳にタコができるほど情報について聞かれたし、ヴィマラ村の周辺の地面も掘られて調べ尽くされた。それなのに何の進展もなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190306,
					"content": "じゃあ、そいつの名前は？元々どこに住んでたんだ？あとそいつの家族は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190307,
					"content": "知らない、知らない、知らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190308,
					"content": "えっと…そんなに答えたくないのかよ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190309,
					"content": "あっ…いや、すまない。これは何もイラついてるわけじゃなくてだな…ただ君の三つの質問にそれぞれ答えただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190310,
					"content": "三つとも知らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "知ってることはあまりないが、それでも印象には深く残ってる。何しろ、これまでヴィマラ村で共に暮らしてきた仲間だ。一緒に色んなことをした記憶だってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190313,
					"content": "ただね、それらの具体的な内容が出てこないんだよ。あるいは、昔は知っていたが、今では誰も覚えていないと言ったほうが正しいかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190314,
					"content": "いずれにせよ、村のみんなで情報を交換しあった上でこうなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190315,
					"content": "わかったよ、そういうことにしとくぞ…じゃあ、そいつってどんなやつだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190316,
					"content": "ああ…確か二十代前半の青年だったな。いつも熱心に人を助けていて、優しいやつだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190317,
					"content": "うちに客があまりいないときは、たまに雑談の相手になってくれてね。それに助けを求める人がいたら、我先にと急いで駆けつけてた。ははっ…実に面白いやつだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190318,
					"content": "へぇ、結構そいつのことが気に入ってるんだな。そいつの話になった途端、表情が柔らかくなったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190319,
					"content": "そりゃそうさ。きっとみんなに好かれてただろう。でなきゃ、集まって冒険者協会に依頼を出したりしないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190320,
					"content": "今時、あいつみたいに純粋な心を持った若者はそういない。はぁ、なんで急に姿を消したんだか…危ない目に遭ってなければいいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190321,
					"content": "もしかしたら…こっそりどっかに引っ越しただけなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190322,
					"content": "いや、それはない。彼の性格からして、挨拶もなしにいきなりいなくなったりしないだろう。仮に本当にそうだったとしても、引っ越しなんて大掛かりなことを村の全員に隠し通せるわけがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "バハラーム"
				},
				{
					"id": 80190323,
					"content": "うーん、確かにそうだな…情報ありがとな。他のやつにも聞いてみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80190311,
					"content": "じゃあ、何か知ってることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
		{
			"id": 801904,
