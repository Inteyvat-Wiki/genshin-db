	"talks": [
		{
			"id": 800501,
			"completionStepIds": [
				800501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
