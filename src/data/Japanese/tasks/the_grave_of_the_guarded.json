					"nextDialogs": [
						80050412
					]
				},
				{
					"id": 80050412,
					"content": "おそらく、必然的な繋がりはない。だが近づけば近づくほど、これらの遺跡が、より古い文明に由来したものだと分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050413
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050413,
					"content": "ただ、アビス教団に先を越されてしまったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050414
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050414,
					"content": "より古い文明？えっと…オイラ、よくわかんないんだけど…",
