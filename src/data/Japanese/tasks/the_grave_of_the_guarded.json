			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050101,
					"content": "ヒルチャールが寝泊まりした痕跡があるぞ。依頼で聞いた、様子のおかしいヒルチャールたちが残したのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050102,
					"content": "依頼？そういえば、貴様たちがここに来た理由をまだ聞いていなかったな。普通の旅人なら、層岩巨淵の下に来る理由などないはずだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050103
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050103,
					"content": "オイラたちは冒険者協会の依頼を受けて、層岩巨淵に来たんだ。ここで起こっているヒルチャールの異変を調べにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050104,
					"content": "で、ようやくその手がかりを見つけたってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050105,
					"content": "その答えを知りたいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050106
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050106,
					"content": "えっ？もしかして、ダインはなにか知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050107,
					"content": "ああ、思い当たる節がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050108,
						80050109
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050108,
					"content": "#{M#俺}{F#私}にはさっぱり分からないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				},
				{
					"id": 80050110,
					"content": "貴様たちが感じ取れないのも無理はない、この異様な感覚をな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050111
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050111,
					"content": "…ここが「呪い」の力を弱めているのが、その答えだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050112
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050112,
					"content": "呪い！たしかこの前、ダインがカーンルイアの国民として、不死の呪いをかけられたって聞いたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050113,
					"content": "ああ、俺は数百年、この呪いがもたらす苦痛に耐えてきた。だが、この地に足を踏み入れてから、束の間の安らぎを得たのを感じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050114
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050114,
					"content": "今この時も、俺の身体は強い意志で訴えている——ここに「残れ」とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050115
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050115,
					"content": "そもそも…どうして、ここには呪いを弱める力があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050116,
					"content": "俺もそれを解明したいと思っていたところだ。だが、俺の知る限り、アビス教団にこのような技術はなかったはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050117,
						80050118
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050117,
					"content": "つまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050119,
					"content": "ああ、そういうことだ。貴様はなぜヒルチャールが仮面を被っているのか知っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050120,
						80050121
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050120,
					"content": "聞いたことある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050122,
					"content": "水面に映る自分の顔を恐れ、それを見ないようにするためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050123
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050123,
					"content": "何しろ、記憶の中の自分と比べたら、それはあまりにも醜い。絶望を感じるほどのものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050124
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050124,
					"content": "やっぱり、ヒルチャールは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050125
					]
				},
				{
					"id": 80050125,
					"content": "不死の呪い…その実態は、永久的な「不死」を意味するものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050126
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050126,
					"content": "元に戻る方法はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050127,
					"content": "不可能だ。「摩耗」により魂と肉体はすり減ってゆき、「死」という形を迎えることなく灰となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050128
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050128,
					"content": "ヒルチャールは己の最期が近いことを悟ると、本能的に静かで暗い場所を探す。そして、数百年にも渡る苦しみに別れを告げる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050129
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050129,
					"content": "呪いの力を弱めるこの場所こそが、やつらにとって最も理想的な霊柩というわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050130
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050130,
					"content": "まさか…そんな理由があったなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050131,
					"content": "雑談は終わりだ、構えろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050132
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050132,
					"content": "えっ？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050133,
					"content": "敵だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050121,
					"content": "知らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050122
					]
				},
				{
					"id": 80050118,
					"content": "ここに来たヒルチャールは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050119
					]
				},
				{
					"id": 80050109,
					"content": "あの逆さの都市と何か関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80050110
					]
				}
			]
		},
		{
			"id": 800503,
			"completionStepIds": [
				800503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800503",
							"2"
						],
						"stepId": 800503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80050301,
					"content": "さっきのはいったい…どうして急に攻撃してきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050302,
					"content": "あれは「黒蛇騎士」。カーンルイアの宮廷親衛隊に所属していた者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050303
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050303,
					"content": "えっ！宮廷親衛隊ってことは…おまえの部下だよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050304,
					"content": "昔のことだ。今のやつらは、強力な呪いによって支配されている。その戦い方も、かつての栄光をすべて捨てたものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050305
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050305,
					"content": "…じゃあ、もうアビスの一部になっちゃったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050306,
					"content": "…先に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050307
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80050307,
					"content": "あっ、ダイン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050308,
					"content": "どうした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050309
					],
					"speakerTitle": "ダインスレイヴ"
