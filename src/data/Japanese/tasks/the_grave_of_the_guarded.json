					"nextDialogs": [
						80050415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80050415,
					"content": "ここの建築物の構造は、かつてのカーンルイアと少し似ている…ふむ、逆さでなければより似ているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80050416
					],
					"speakerTitle": "ダインスレイヴ"
				},
