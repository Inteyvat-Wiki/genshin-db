			"dialogs": [
				{
					"id": 140110101,
					"content": "僕の記憶が正しければ、彼はここにいるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110102
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110102,
					"content": "あの、どちら様で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110103
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110103,
					"content": "僕だ、台本は出来たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110104
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110104,
					"content": "何だってこんなところまで追いかけてきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110105
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110105,
					"content": "まあまあ、それは置いといて。まずは外に出てきてくれ、いい知らせがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110106
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110106,
					"content": "フン、信じるかよ。しばらく待っててくれ、もう締めを書いてるところなんだ。完成したら出ていくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110107
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110107,
					"content": "分かった。大作を期待してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110108
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110108,
					"content": "どうやら予想通り、原稿の締め切りは先延ばしになってしまったようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110109
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110109,
					"content": "それでも結末は、この演劇の中でとても大切なところですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110110
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110110,
					"content": "彼が書き終えた台本には、出演者全員が目を通します。みんなが賛成して初めて、結末として採用されるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110111
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110111,
					"content": "人づてに来てるって聞いたんだけど、やっぱり人違いじゃなかったか。でもまさか、本当にあんたたちだなんてね。それに、フリーナまで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110112
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110112,
					"content": "やっぱりこうなるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110113
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110113,
					"content": "ポウルを探してるみたいね。もしまだ時間がかかるんなら、町を自由にぶらぶらしてていいよ。ぜんぶ手配済みだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110114
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110114,
					"content": "ああ、お構いなく。僕たちはここで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110115
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110115,
					"content": "それじゃ、お言葉に甘えさせてもらうわね。町を見て回ってみるわ。お声がけありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110116
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110116,
					"content": "ちょっと来て。空気を読みなさいよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110117
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110117,
					"content": "…最近は、ここの状況も少しは良くなってきているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110118
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110118,
					"content": "徐々に回復してきてるってところかな。でも、多くの人の心の傷は一生治らないかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110119
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110119,
					"content": "すまない。僕も何かしてやりたいとは思っているんだが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110120
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110120,
					"content": "いいっていいって。あたしたち、会うたびにこんな重い話をしなくちゃいけないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110121
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110121,
					"content": "つらくて苦しい記憶なんて誰にでもある。でも、それに気圧されて息が詰まるような思いをしてなきゃなんないわけじゃないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110122
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110122,
					"content": "あんたも、一からやり直すつもりなんだったら、過去のことばっかり口にしてちゃダメよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110123
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110123,
					"content": "慰めの言葉ありがとう。確かに一理ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110124
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110124,
					"content": "でもせめて今は、真剣な気持ちで接したいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110125
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110125,
					"content": "構わないよ。実際に一歩を踏み出すのは、あたしが言うほど楽なことじゃないってことくらいは知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110126
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110126,
					"content": "あたしがここに来たのも、あることを伝えたかったからよ——今までの、災害に対する水神の無策を、誰もが許してるわけじゃないってことをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110127
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110127,
					"content": "不要なトラブルを避けるために、町の人には、あんたたちは劇団のメンバーで、あんたはフリーナを演じる役者だって伝えてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110128
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110128,
					"content": "万全とは言えないけど、これである程度は自由に動けるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110129
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110129,
					"content": "おまえ、そんな気遣い屋さんな一面があったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110130,
					"content": "なあに、その言い草。棘薔薇の会の会長はいつだって果敢で行き届いてるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110131
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110131,
					"content": "じゃあ、あたしは先に行くから。ちゃんと彼女のそばにいてあげてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110132,
						140110133
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140110132,
					"content": "うん、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				},
				{
					"id": 140110134,
					"content": "さて、上に行ってみるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110135
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110135,
					"content": "僕には心の内を打ち明けられる友人がいない。彼女の言う通り、キミたちのそばが一番いいのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110133,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				}
			]
		},
