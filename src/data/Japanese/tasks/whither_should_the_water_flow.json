					}
				]
			},
			"dialogs": [
				{
					"id": 140110201,
					"content": "ナヴィアの配慮にはとても感謝してる。正直、僕も心の準備ができているかと聞かれると…わからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110202
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110202,
					"content": "逃げることは往々にして一番手間のかからない選択肢だが、それは何の問題の解決にもならないし、ハードルを乗り越える手助けにもならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110203
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110203,
					"content": "どうりでポワソン町の話になると、ためらってるっぽかったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110204,
					"content": "ああ、怖くないと言えば嘘になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110205
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110205,
					"content": "それでも僕は、もう一度ここに来るべきだと思った。前に言っただろ？この目で見届けられなかったものを見ておきたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110206
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110206,
					"content": "もしここの人々が僕を赦してくれるのなら、きっと僕は嬉しい。でも、もし彼らが暴言を吐いたとしても——僕はすべてを受け入れるつもりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110207
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110207,
					"content": "ナヴィアの言葉を信じない人もいるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110208
					]
				},
				{
					"id": 140110208,
					"content": "ああ、僕も見られているのは感じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110209
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110209,
					"content": "彼らは、水神の服を着てポワソン町に来ること自体が、ここの住民に対する一種の不敬行為だと考えているのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110210
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110210,
					"content": "僕はかつて、誰かに視線を向けられるのが怖かった。特に、疑われたり、恨まれたりする時だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110211
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110211,
					"content": "…はぁ…僕は、まだ準備ができていなかったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110212
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110212,
					"content": "おまえ、自分に対して案外厳しいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110213,
						140110215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110213,
					"content": "ちょっと、気を張りすぎじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110214
					]
				},
				{
					"id": 140110214,
					"content": "見たいものだけ見るわけにはいかないだろ？でなくちゃ、昔のまんまだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110217
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110217,
					"content": "おいおい、人が段々増えてきたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110218,
					"content": "議論の声があちこちから聞こえてくるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110219
					]
				},
				{
					"id": 140110219,
					"content": "ここには長く留まらないほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110220
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110220,
					"content": "棘薔薇の会の巨船…あそこからならこの町の全貌が見えるだろう。行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110215,
					"content": "本当に意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110216
					]
				},
				{
					"id": 140110216,
					"content": "それはどういう意味だい？まさかキミの目に映る僕は、ひたすら隠れて、責任から逃げることしかできないと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110217
					],
					"speakerTitle": "フリーナ"
				}
			]
		},
		{
			"id": 1401103,
			"completionStepIds": [
				1401104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1401104",
							"2"
						],
						"stepId": 1401104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フリーナ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2831.178,
							397.924,
							4164.861
						],
						"pointId": 5834
					},
					{
						"sceneId": 3,
						"position": [
							2829.195,
							397.926,
							4164.68
						],
						"pointId": 5844
					}
				]
			},
			"dialogs": [
				{
					"id": 140110301,
					"content": "ごめんね…キミたちはお散歩気分だったかもしれないのに、重い話ばっかり振って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110302
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110302,
					"content": "気にするなって。こういうフリーナを見れるのも、なかなか新鮮だしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110303,
					"content": "うん、ありがとう。もう少しだけ付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110304
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110304,
					"content": "キミたちなら薄々気付いているかもしれないけど、僕が過去の自分を受け入れようと思えなかったのは、僕があまりにも長い間、苦痛と孤独に耐えてきたからというだけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110305
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110305,
					"content": "船のそばに行くと、水が徐々に上がっていく光景がフラッシュバックするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110306
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110306,
					"content": "命は次々と水に溶け、ポワソン町の住民が大切にしてきた暮らしと思い出は無に帰した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110307
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110307,
					"content": "神の庇護のもとにいるのだから、厄災が訪れる前には強い存在が立ちはだかってくれるのだと、人々はそう信じていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110308
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110308,
					"content": "僕も、彼らがそう信じられるよう、芝居をずっと続けていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110309
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110309,
					"content": "でも、本当に水が上がってきた時、「水神」は何もしてあげられなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110310
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110310,
					"content": "そんなこと言うなよ。あのときは、おまえだって自分の役目があっただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110311,
					"content": "そう自分を責めないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110312
					]
				},
				{
					"id": 140110312,
					"content": "真実を守るため、僕はずっと同じことを繰り返してきた。でも、そうすればそうするほど、僕は苦しくなり、孤独になっていったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110313
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110313,
					"content": "次第に、真実以外の何もかもを失っていった。…僕は完全に失敗して、自分の場所に座ったまま泣き崩れることになるのが怖かったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110314
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110314,
					"content": "幸いキミたちや…多くの英雄の助けがあったから、最悪の結末は避けることができたけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110315
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110315,
					"content": "誰もが責任を背負い…そして僕は、自由を取り戻した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110316
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110316,
					"content": "よくよく考えてみたら、「自由」とは必要とされないことを意味するわけだ。だって、僕はもう何の役にも立たないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110317
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110317,
					"content": "おまえがそんなことを考えてるなんて思わなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110318,
					"content": "#自由は{M#君}{F#あなた}への報酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110319
					]
				},
				{
					"id": 140110319,
					"content": "報酬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110320,
						140110321
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110320,
					"content": "少なくとも勇気を持って本音を話せたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				},
				{
					"id": 140110322,
					"content": "…うん、そうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110323
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110323,
					"content": "相談相手ができるだなんて、昔は想像もできなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110324
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110324,
					"content": "重大な秘密を守る必要があったからね…他人が本当の僕に気づきやしないか、とても怖かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110325
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110325,
					"content": "「それなら舞台上のフリーナを信じればいい。それが民の信頼すべき姿だ。」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110326
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110326,
					"content": "だからこそ、僕は日々において、好奇心や内から発する感情を、人に勘付かれてはならなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110327
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110327,
					"content": "僕がこの前、人間関係をうまく維持できないと言った理由が、これで分かっただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110328
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110328,
					"content": "そうだったのか…オイラはてっきり、おまえの性格が嫌われやすいだけだと思ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110329,
					"content": "今日はやけに横槍を入れてくるな！キミのそういう話し方こそ、嫌われるんじゃないのかっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110330,
						140110331
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110330,
					"content": "パイモンは元気付けたいだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110332,
					"content": "…ああ、かつての僕には真実しかなかった。今、ようやく解放されて、まだこれからどこへ向かうかは分からないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110333
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110333,
					"content": "選択する資格が、僕にはあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110334
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110334,
					"content": "さて、そろそろ帰ろう。台本も書けた頃合いだろうしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110335
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110335,
					"content": "おう、そうだな。行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110331,
					"content": "話したら少し楽になったでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110321,
					"content": "少なくとも苦痛や孤独を味わうことはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				}
			]
		},
