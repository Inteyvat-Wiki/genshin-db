						],
						"pointId": 6673
					}
				]
			},
			"dialogs": [
				{
					"id": 140110401,
					"content": "もう…言ったでしょ、そんな姿なんだから、もう揚げ物は控えなさいって。なのに、またあんなに沢山フライドポテトとフィッシュフライを平らげるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110402
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110402,
					"content": "棘薔薇の会のボスって、気前がいいよな。何でもタダでご馳走してくれるなんて。こんなチャンス、無駄にするわけにはいかないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110403
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110403,
					"content": "僕は君と違って、役のためにスタイルのことを考える必要もないんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110404
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110404,
					"content": "役の話なんかしてないでしょ？もう少し、健康を気にしたらどうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110405
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110405,
					"content": "こっちは毎日、病気に苦しんでるのよ。あなたが体を大切にしないのを見ると、それだけでムカついてくるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110406
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110406,
					"content": "はぁ…あの二人、またケンカしてるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110407,
					"content": "戻ったぜ！しばらく休戦してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110408,
					"content": "ああ、君たちか。こんな親切な歓待を受けられるのも、君たちのおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110409
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110409,
					"content": "あと少しで終わるみたいだから、もう少し待ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110410
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110410,
					"content": "じゃあ雑談でもしてようぜ。そうだ、さっきのキャラの話だけど、ドルフィーが演るのは純水精霊が変身した人間なんだろ。で、おまえは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110411,
					"content": "僕か？僕も純水精霊の役さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110412
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110412,
					"content": "本来はツルの姿だったんだけど、服が合わなくなってイノシシに変わったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110413
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110413,
					"content": "ぷっ…ごめんごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110414,
					"content": "イノシシもなかなか面白いよ。確か、幼い純水精霊の育ての親だったよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110415
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110415,
					"content": "はい。イノシシは心をこめて幼い純水精霊にこう語りかけるんです——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110416
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110416,
					"content": "「人として生きるというのは、秘密を隠し、苦痛を味わい、孤独とともに歩むこと。それでも君は、それを望むのかい？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110417
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110417,
					"content": "え、その話、なんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110418,
					"content": "これはシナリオの核心をついたセリフで…まさに、団長の人生そのものですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110419
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110419,
					"content": "あの方は、劇団の苦悩の一面を私たちに見せず、ただ純粋に演技を楽しませてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110420
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110420,
					"content": "彼女が離れた後、劇団の運営がどれほど難しいことか…私たちは初めて、身をもって実感しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110421
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110421,
					"content": "この前、キミは「家」と言っていたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110422
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110422,
					"content": "ええ…私は生まれてすぐにこの奇病にかかってしまったので。家族は治らないことに気づくと、私を捨てたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110423
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110423,
					"content": "薬を買うために独り働き、発作が起きると路地に何日も横たわって…物乞い同然でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110424
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110424,
					"content": "でも…声がいいから、歌を習ってみないかと団長が声をかけてくれて…私は、はいと答えたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110425
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110425,
					"content": "歌や演技を教えてくれただけでなく、薬まで買ってきてくれて、病気のときは面倒も見てくれて…彼女にとっては、ぜんぶ大きな負担だったと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110426
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110426,
					"content": "本当にすごい人だったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110427,
					"content": "そうなんだ。…団長は劇団と団員に心血を注いできた。僕たちは全員、彼女を誇りに思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110428
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110428,
					"content": "僕もあの頃は同じようなものだったよ。僕は殺人犯の子供でさ、幼い頃から親の世話は受けず、孤児院に預けられてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110429
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110429,
					"content": "周りのやつらが毎日ケンカを売ってくるんだ。殺人犯の子供なんだから、ケンカにも強いだろ？ってな具合にね。…その実、絶好のいじめの標的だっただけなんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110430
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110430,
					"content": "結局、殴られることに耐えられなくて、逃げ出した。当時は、世の中にはクズしかいないんだと思ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110431
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110431,
					"content": "フフッ…団長に出会えてよかったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110432
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110432,
					"content": "はい。あの時から僕は、解散するまでずっと劇団に残るって決めてたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110433
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110433,
					"content": "結局その日が、本当に来てしまうとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110434
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110434,
					"content": "はぁ、やっと完成したか。さあ、紹介しよう。こちらは今回の公演で顧問をしてくださる、フリーナさんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110435
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110435,
					"content": "ぼ…僕の見間違いか！？あんたら、いつの間にそんなにすごくなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110436
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110436,
					"content": "そう驚かなくとも。僕はただ、劇団と団長の物語に深く心を動かされて、力になりたいと思っただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110437
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110437,
					"content": "オイラたちも同じだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110438,
					"content": "そうだとしても…悪い、ちょっと落ち着くよ。今、何の話をしてたっけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110439
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110439,
					"content": "あ、そうだ、台本だ台本！まず、今回のバージョンでストーリーがどう展開されるかを説明しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110440
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110440,
					"content": "これまでのストーリーはみんなもよく知っている通りだ。幼い純水精霊は家族の忠告を無視し、人間になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110441
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110441,
					"content": "その後、彼女は賑やかに栄える都市で、友情と愛情という収穫も得たが、予期せぬ出来事に見舞われた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110442
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110442,
					"content": "住民たちは突然、周辺の淡水が消え、土地が乾き、植物が枯れていくことに気付いたんだ。異常を察知した人々はパニックに陥った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110443
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110443,
					"content": "水の娘「コリオ」は恋人とともに、責任を持って事件の真相を調査しに行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110444
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110444,
					"content": "その結果、人間の長年の浪費と汚染のせいで、淡水は意志を持つかのようにこの地から逃げ始めていることが分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110445
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110445,
					"content": "つまり、水に意識があるってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110446
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110446,
					"content": "水に意識がある…そんな風に描かれた物語は数多くあるけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110447
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110447,
					"content": "主人公は純水精霊だから、水の考えを瞬時に読み取った。そして彼女は、自分の正体と事件の真相をすべて恋人に打ち明けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110448
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110448,
					"content": "恋人は彼女を受け入れ、淡水を元の場所に戻す方法をともに探そうとした。しかし同時に、それを盗み聞きしていたやつがいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110449
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110449,
					"content": "そして、水の娘は淡水を奪った罪人と見なされ…ジレンマに陥るんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110450
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110450,
					"content": "それから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110451
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110451,
					"content": "それから…水の娘は身を挺して、自らを犠牲に彼女の恋人と全人類を救ったのだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110452
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110452,
					"content": "ええ？コリオは人間から悪いやつだって思われてるんだろ？なのにどうしてまだ人間を救おうとするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110453
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110453,
					"content": "彼女は主に恋人と、彼女の味方になってくれた人々を救いたかったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110454
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110454,
					"content": "恋人への思慕を人類への友愛に昇華することもまた、物語の主人公としてのコリオの偉大さである、ということか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110455
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110455,
					"content": "私が気になるのは違うところなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110456
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110456,
					"content": "「水の娘」の主人公は団長を象徴するっていうのは分かってるわよね？彼女は最後まで、英雄になれなかったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110457
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110457,
					"content": "団長を記念するなら、当然、本当の結末を記録するべきでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110458
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110458,
					"content": "——水の娘は憎しみによって死に至り、彼女を深く愛した者は真実を解き明かすことをやめ…人類は滅亡する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110459
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110459,
					"content": "…しかし、その結末は残酷すぎる。それに、観客に対しても少し無責任だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110460
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110460,
					"content": "ああ、アレリー団長の遭遇と同じで、そんなものは無価値だし、意味が分からなさすぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110461
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110461,
					"content": "事件が起きた日、団長は突然僕たち全員に、まずはフォンテーヌ廷を離れて、街の外で彼女を待つように言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110462
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110462,
					"content": "約束の場所でずっと待っていたけど、ついに団長は来なかった。そして僕たちが帰った時、彼女はすでに行方不明になっていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110463
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110463,
					"content": "警察隊員も僕たちも彼女を見つけることはできず…結局、様々な手がかりは彼女が「連続少女失踪事件」に巻き込まれたことを示しただけだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110464
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110464,
					"content": "団長はこの世で一番いい人だったのに、まったく関係ない不可解な実験の犠牲者になってしまうなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110465
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110465,
					"content": "うぅ…でもキミたちに町の外に隠れろと事前に知らせたのなら、彼女はきっと何かに気付いたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110466
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110466,
					"content": "僕はその後、ずっと調べてきたけど、手がかりはほとんどなかった…ヴィルマントなら何か知ってるかもしれないけど、あいつ、全然教えてくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110467
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110467,
					"content": "ヴィルマントというと、悪役を演じる役者だったね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110468
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110468,
					"content": "ええ、悲しみから抜け出すのが一番難しいのは、彼だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110469
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110469,
					"content": "悲しみ？ふん、あいつはただ罪悪感を抱いてるだけだよ。悲しみと言えば、僕に勝る者はいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110470
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110470,
					"content": "何故なら…劇の中でも、外でも、僕はアレリーを心から愛していたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110471
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110471,
					"content": "そ、そうだったの…初耳だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110472
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110472,
					"content": "そろそろ頃合いかなと思ったんだよ。もしお互いにまだ抱えた秘密があるんなら、合意に達するのなんか無理だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110473
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110473,
					"content": "僕は昔、アレリーに愛を告げた。ほぼ即答で拒絶されたけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110474
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110474,
					"content": "劇団にいるみんなは弟や妹のような存在だから、男女の情なんて一切考えたことがなかったと彼女は言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110475
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110475,
					"content": "アレリーならそう言うだろうなと予想してたから、僕は平気だと返した。ずっと、劇団で彼女を待っていると伝えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110476
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110476,
					"content": "あいつが劇団のことで悩む必要がなくなり、ここにいる全員が居場所を見つける、その日まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110477
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110477,
					"content": "その時が来れば、アレリーも僕のことを考え直せるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110478
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110478,
					"content": "でも結局、そんな日が訪れることはなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110479
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110479,
					"content": "ポウル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110480
					],
					"speakerTitle": "ローウィック"
				},
				{
					"id": 140110480,
					"content": "だから僕の台本では、アレリーは最高の結末を迎えなきゃいけないんだよ。誰が反対したって無駄だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110481
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110481,
					"content": "はぁ、どうやらあなたとヴィルマントの間に起こったことについては、直接会って聞くしかなさそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110482
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110482,
					"content": "実はこれまで、結末に対する意見の相違が一番大きかったのも二人なのよ。どちらかが相手を説得しないといけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110483
					],
					"speakerTitle": "ドルフィー"
				},
				{
					"id": 140110483,
					"content": "もうここまで来たら、そいつを探すしかないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110484
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140110484,
					"content": "キミ、真実に直面する準備はできたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110485
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110485,
					"content": "正直、ちょっと怖いけど…最後の公演のためなら、何だってやるさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110486
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110486,
					"content": "フリーナ様…もしかして、あんたは僕の気持ちが理解できるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110487
					],
					"speakerTitle": "ポウル"
				},
				{
					"id": 140110487,
					"content": "ああ、もちろんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110488
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140110488,
					"content": "さあ、出発しようじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリーナ"
				}
			]
		},
