				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "ようこそ、夢のパイティティ——ティティ島へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540102,
					"content": "この先にバー「ドランクハニー」と「デュードロップ」がある。俺はテクトリだ。客を出迎える役をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
