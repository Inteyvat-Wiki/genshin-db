			"dialogs": [
				{
					"id": 752540509,
					"content": "どこかで会ったような？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "友よ、これは運命が非凡なる人間に与えてくれた印だ。初めて俺に会うのに、どこか久しぶりの再会のように感じないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540502,
					"content": "この狼のような眼帯を見て、俺という存在が並外れていることに気づいただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
