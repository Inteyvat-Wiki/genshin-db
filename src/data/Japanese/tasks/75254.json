			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"テクトリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "俺のウェルカムドリンクを飲んだ友として、一つ忠告をしてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540202,
					"content": "休暇を楽しみに来ただけなら、ティティ島の最北端には近づかないほうがいい。あそこにリラックスできるものはないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
