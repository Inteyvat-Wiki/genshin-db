					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "俺の目について、聞かないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
