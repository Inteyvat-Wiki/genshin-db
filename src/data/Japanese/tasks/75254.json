			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"テクトリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "このテクトリの目が気になるのか？ハハッ、これは男が一生でやらねばならぬ三つのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540604,
					"content": "一つ、辛酸をなめ尽くした体には、一つくらい傷痕がないとな。でないと男が経験した複雑な人生を示すことができず、厚みがなくなってしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540605,
					"content": "二つ、傷痕は服やアクセサリーで隠す。ただし完全には隠さず、控えめに見せる。でないと周りの人はこの男の特別さに気付けなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540606,
					"content": "三つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540607,
					"content": "あの、目のことなんか聞いてないんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "そうだろう？その通り！まさにそれを言おうとしていたんだ。三つ、もし周りの人が気づいていなければ、自分から言い出すこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
			]
		},
