				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"テクトリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "分かった。その目はどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "ふふん、あるハゲ頭にやられちまったのさ…奴は今もこの島にいる。きちんと「礼」をしないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540311,
					"content": "この話を聞いて、あんたも俺の仇討ちをしたいと思っただろう？だがその必要はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540312,
					"content": "こんなに美しい夏の日に、悲しむ人などいないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540313,
					"content": "ウェルカムドリンクを用意した。くつろいでいってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752540314,
					"content": "ドリンクはそこの棚の上にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				}
			]
		},
		{
