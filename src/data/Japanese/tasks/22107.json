			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "「愛とは、遠そうで近いもの。せがむ必要はない、いつかきっと目の前に現れる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070102,
					"content": "なにが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "もちろん僕の恋愛運の話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070104,
					"content": "さっきの言葉は、綺命姉さんが教えてくれたんだ。遠そうで近いって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070105,
					"content": "何かほのめかしてるみたいだ、一体何だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070106,
					"content": "本で見たけど、人の「運勢」が上がる時は周りで良い事が起こるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070107,
					"content": "僕の「恋愛運」は今絶好調さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070108,
					"content": "だから周りを見てきてくれないかい？何か特別な「兆し」があるかどうかを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "じゃあ頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				},
				{
					"id": 221070110,
					"content": "なんで自分で行かないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "「恋は人を盲目にする」って言うだろ、僕自身が見にいっても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070113,
					"content": "なにを見ても、「恋愛運」と関係があるように見えてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221070114,
					"content": "だから、頼むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
