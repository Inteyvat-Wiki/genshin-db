			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "屋上に鳥のカップルが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "うん…よし！それはいい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071003,
					"content": "鳥のカップルは群れから離れ、互いに相手のことしか見ず、相手とならどこまでも行ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071004,
					"content": "この兆しは…僕も僕のことしか見えない運命の人と出会えるってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071005,
					"content": "そして彼女といろいろな苦難を乗り越えて、都市から離れ、二人で世界を旅する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071006,
					"content": "ゴホゴホ！あの、お疲れ…時間があったらまた綺命姉さんに聞いてくるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
