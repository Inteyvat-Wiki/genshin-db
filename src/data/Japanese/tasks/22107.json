			"dialogs": [
				{
					"id": 221071201,
					"content": "落ち葉について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "うーん…これは恋愛と関係ないと思うぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 221071203,
					"content": "落ち葉？もちろん関係あるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071204,
					"content": "落ち葉は目立たないけど、ちょっとしたきっかけさえあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071205,
					"content": "火花がつけば、燃え盛る。風が吹けば、踊り舞う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071206,
					"content": "まるで僕の恋を言っているみたいじゃないか。きっかけがあれば僕と綺命姉さんは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
