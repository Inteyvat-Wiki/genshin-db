					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "すごく繁盛しているお店があった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "うーん、商売繁盛？これはいい、いいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071103,
					"content": "コツコツと努力して、ちゃんと経営すれば必ず報われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071104,
					"content": "人生においても恋愛においても、それと同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071105,
					"content": "ゴホ！ゴホゴホ…あの、ありがとう、もうちょっと考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "志華"
				},
				{
					"id": 221071106,
					"content": "綺命姉さん！いつか僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				}
			]
		},
