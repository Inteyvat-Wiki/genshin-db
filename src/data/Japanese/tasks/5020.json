			"dialogs": [
				{
					"id": 50202001,
					"content": "アテアさんは…わたしにとっても尊敬に値する大先輩だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "アミナ"
				},
				{
					"id": 50202002,
					"content": "おじいちゃんが亡くなってから部族の年長者たちはあたしを「部族の首領」に選んだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "アミナ"
				},
				{
					"id": 50202003,
					"content": "わたしは斬新なアイデアをたくさん持ってるから、きっと「流泉の衆」を「新たな未来」に導くことができるって、みんなそう信じてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "アミナ"
				},
				{
					"id": 50202004,
					"content": "でも、長い間、わたしは自分が何をすべきか分からないままだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "アミナ"
				},
				{
					"id": 50202005,
					"content": "そんなあたしを、アテアさんはいつも励ましてくれたの。ヘマをしても、咎められたことは一度もないよ。一緒に失敗の原因を分析して、次はもっとうまくできるようにって手伝ってくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "アミナ"
				},
				{
					"id": 50202006,
					"content": "心から尊敬してたんだ。だから…教わったことを胸に、やるべきことを頑張ろうと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アミナ"
				}
			]
		}
	]
