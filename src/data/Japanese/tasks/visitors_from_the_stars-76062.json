			"dialogs": [
				{
					"id": 760620101,
					"content": "二人とも大丈夫か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620102,
					"content": "マーゴが少し怪我をしたけど…命に別状はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620103
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620103,
					"content": "どうしてこんなことを…あいつら、夫婦だったんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620104,
					"content": "えっと…「家庭内暴力」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620105
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620105,
					"content": "どこでそんな言葉覚えたんだよ…とにかく、あいつを止めなきゃな…なあ、見たか？ウージの体が真っ黒だったぞ…クロタマゴと同じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620106,
					"content": "でも、あんなにデカいんだよな…もしかして、他のクロタマゴをいっぱい食べたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620107,
					"content": "パイモン…待っててね…私があれくらい大きくなったら…答えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620108
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620108,
					"content": "うぅ…。それで、これからどうするんだ？ウージが戻ってきちゃったし、一旦引き返して、次のチャンスを待つしかないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620109,
					"content": "そんな時間はないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620110
					]
				},
				{
					"id": 760620110,
					"content": "うん…古月の嵐がウージエン生態圏に迫ってる。あそこにはまだ小さな生き物がたくさんいるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620111
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620111,
					"content": "#{M#俺}{F#私}たちが古月の源を取ってくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620112
					]
				},
				{
					"id": 760620112,
					"content": "分かった。でも、気をつけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620113
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620113,
					"content": "マーゴの治療には少し時間がかかるの。キミはウージの注意を引きつけて、私が行くまで持ちこたえてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620114
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620114,
					"content": "月の海には小さな群遊月霊が住んでるから、あの子たちにも手伝ってもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620115
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620115,
					"content": "おう！オイラたちに任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620116,
					"content": "私も…手伝うよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロタマゴ"
				}
			]
		},
