			},
			"dialogs": [
				{
					"id": 760620501,
					"content": "ウージは大人しくなったみたいだな。ってことは…やっぱりあの蔓が原因だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620502,
					"content": "でも、まだ苦しんでるみたい…思考が混乱してて、まともに交流できないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620503
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620503,
					"content": "体内の情報のせい…私にはわかる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620504
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620504,
					"content": "私と…ウージは…同じだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620505
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620505,
					"content": "クロタマゴ、なにをする気だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620506,
					"content": "あの体の中に…ウージエン生態圏の端末の情報がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620507
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620507,
					"content": "覚えてる？あの端末の近くにも…同じよどみの月光蔓が生えてたでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620508
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620508,
					"content": "つまり…こいつが、あそこの情報を吸収したってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620509,
					"content": "うん…その中には…観月者計画の内容が記録されてるのかも…それがきっと、私の使命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620510
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620510,
					"content": "でも、そんなの危険すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620511,
					"content": "パイモン、ニンニンを行かせてあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620512
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620512,
					"content": "あの子は月で生まれたの。私が心配して、勝手に遠く離れた場所へ送っちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620513
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620513,
					"content": "それでも自分の使命のために、キミたちの助けを借りて、なんとかここへ…故郷へ戻ってきた。本当に…立派な決意だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620514
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620514,
					"content": "たとえキミたちが善意で守ろうとしても、あの子はそれを望まないんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620515
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620515,
					"content": "でも、コロンビーナ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620516,
					"content": "こいつががんばってる分、余計に心配になるんだ…反抗期に入って、オイラへの敬意が薄れてきたとしてもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620517,
					"content": "反抗期を過ぎれば、大人びてくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620518
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620518,
					"content": "パイモン…もし私を行かせてくれたら…月よりも大きな敬意を払うから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620519
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620519,
					"content": "でも、あいつはあんなにでかいんだぞ。万が一、飲み込まれたらどうするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620520,
					"content": "もし本当にそうなったら…それもきっと使命の一部…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620521
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620521,
					"content": "おまえってやつは！頑固すぎるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620522,
					"content": "それが今のあの子の心にある、一番強い願いなんじゃないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620523
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620523,
					"content": "そうだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620524
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620524,
					"content": "じゃあ、行っておいで、ニンニン。キミを信じてるよ…この一筋の月の光がキミの決断を見届けて、旅路を守ってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620525
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620525,
					"content": "え？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620526,
						760620527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620526,
					"content": "#{M#俺}{F#私}も信じてるよ、クロタマゴ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620528
					]
				},
				{
					"id": 760620528,
					"content": "ありがとう…それじゃあ、始めるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620529
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620529,
					"content": "あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620530
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620530,
					"content": "クロタマゴ！無事に反抗期を乗り越えるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620531,
					"content": "私なら…できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620532
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620532,
					"content": "う…うまくいったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620533
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620533,
					"content": "思ってたより、状況は悪くないみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620534
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620534,
					"content": "本当によかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620535
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620535,
					"content": "みんな、ありがとう…とても重要な情報が手に入った…ウージエン生態圏と星海生物捕捉ステーションでなにが起きたのか…わかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620536
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620536,
					"content": "何があったの？私も気になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620537
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620537,
					"content": "あの深宇宙からの謎のシグナルが、また届いたんだ…龍族の先駆者がこの世を去ってから、すでに長い年月が経ってたけど…それは問題じゃないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620538
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620538,
					"content": "彼が設計した観月者の塔——イビニベルンの目が、シグナルの発信座標を正確に捕捉したから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620539
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620539,
					"content": "ついに成功したんだな！なんだかワクワクしてきたぞ！で、それはどこから送られてきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620540,
					"content": "月から遠く離れた星の海の奥深く…そこは、たとえ宇宙船がたどり着けたとしても、エネルギー不足で帰れなくなるような場所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620541
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620541,
					"content": "それでも、生命分野の研究者ウージエンは、観月者号と名付けた宇宙船を操縦して、その座標へ向かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620542
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620542,
					"content": "正気を失っちゃったのか？帰ってくるつもりがないってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620543
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620543,
					"content": "彼にとっては、シグナルの真相を解明できればそれで十分だったのかも…それにその距離でも、情報だけなら月に送ることはできたかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620544
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620544,
					"content": "その後、どうなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620545
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620545,
					"content": "彼はそのまま星海の中へ姿を消して…龍族も、観月者号から送られてきた通信を受け取ることはなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620546
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620546,
					"content": "…結局、失敗に終わったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620547
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620547,
					"content": "ううん…それから、さらに数年が経って…ある日、星海生物捕捉ステーションに突然、なにかが衝突したの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620548
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620548,
					"content": "緊急修理を終えた学者たちは、捕捉ステーションに衝突したのが…透明な宇宙船だってことに気づいたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620549
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620549,
					"content": "透明な宇宙船？まさか、それが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620550
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620550,
					"content": "うん…なんらかの理由で姿を隠した…観月者号…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620551
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620551,
					"content": "ウージエンの妻、マーゴが真っ先に宇宙船に入ったんだけど、彼女が内部で見つけたのは…一匹の、トゲのついた黒い球状の生物だけだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620552
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620552,
					"content": "古月スペクトル分析計の解析では、その生物は…ウージエンの情報特性と一致してたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620553
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620553,
					"content": "ど、どういうことだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620554
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620554,
					"content": "マーゴは一連の検査を行って、その結果…愛する人が、神秘的な生物と融合しつつあることがわかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620555
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620555,
					"content": "怖すぎるだろ！それがシグナルを出してた謎の星海生物なんだよな？で、ウージエンはそいつに食べられちゃったってことだろ…助ける方法はなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620556
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620556,
					"content": "残念だけど、龍族の学者たちもそんな状況は今まで見たことがなくて…なすすべもないまま、ウージエンが全く新しい生命へと変貌していくのを、ただ見てることしかできなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620557
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620557,
					"content": "その後、ウージエンは目を覚まして…龍族にメッセージを送った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620558
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620558,
					"content": "どんなメッセージ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620559
					]
				},
				{
					"id": 760620559,
					"content": "それに関する情報はないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620560
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620560,
					"content": "ああもう！なんでまた大事な内容が欠けてるんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620561
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620561,
					"content": "でも、そう考えるとウージエンがかわいそうに感じるな…だって、捕まえようとしてた相手に、逆に捕まっちゃったってことじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620562
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620562,
					"content": "ううん、それは違うよ。宇宙船のログによると、シグナルを発した生物はウージエンを攻撃したわけじゃなくて…むしろ、彼が進んでそれと融合したらしいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620563
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620563,
					"content": "そうして初めて、その生物は言語の壁を越えて…龍族にメッセージを伝えることができた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620564
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620564,
					"content": "本当に信じられないような話だね…ということは、そのメッセージこそが観月者計画の鍵になる内容なのかも…それが何なのか、ますます気になってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620565
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620565,
					"content": "どうやら他の場所も調べる必要がありそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620566
					]
				},
				{
					"id": 760620566,
					"content": "その後…ウージエンはまだ生きてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620567
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620567,
					"content": "メッセージを伝えた後、ウージエンは死に向かい始めた…でもマーゴは生命分野の専門家だったから、ある未完成な技術を彼に使ったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620568
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620568,
					"content": "それは、生命体を…純粋な古月の力へと転換する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620569
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620569,
					"content": "おおっ！龍族の生命の燃素化みたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620570
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620570,
					"content": "彼女のその技術は成功したの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620571
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620571,
					"content": "半分はね…彼女はウージエンの肉体だけを救って、月で初めての、非自然的に誕生した月霊…月霊ウージを創り出したの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620572
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620572,
					"content": "でもウージエンの意識は、その過程で完全に消滅してしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620573
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620573,
					"content": "彼女はそれからの日々、寿命を迎えるまで…その新しい生命の研究にすべてを捧げた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620574
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620574,
					"content": "そして最終的に、教え子のルシャリムに自分にも同じ技術を使うように頼んで…彼女自身も新たな生命に転化したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620575
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620575,
					"content": "ウージエンと同じく、彼女の意識も残ることはなかったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620576
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620576,
					"content": "♪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620577
					],
					"speakerTitle": "マーゴ"
				},
				{
					"id": 760620577,
					"content": "そっか…それがキミたちの物語なんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620578
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620578,
					"content": "なら…あの星海生物が龍族に伝えたメッセージは、ルシャリムに受け継がれてるのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620579
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620579,
					"content": "彼もどこかに研究施設を作ったのかな？だとしたら、観月者計画の重要な内容は、そこに保存されてるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620580
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620580,
					"content": "その研究施設はもう無いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620581
					]
				},
				{
					"id": 760620581,
					"content": "ん？何か知ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620582
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620582,
					"content": "コロンビーナにルシャリム、月幕計画、そして天外からの降臨者について話した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760620583
					]
				},
				{
					"id": 760620583,
					"content": "まさか…天外から来た降臨者に滅ぼされたの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620584
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620584,
					"content": "どうしても…高天の主を思い出しちゃうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620585
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620585,
					"content": "#{M#俺}{F#私}もそう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620586
					]
				},
				{
					"id": 760620586,
					"content": "月を覆い隠す天幕…それも、偽りの空によく似てるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620587
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620587,
					"content": "そうだな…まるで偽りの空の子供版って感じだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620588
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620588,
					"content": "とにかく、研究所は壊れてるし、もしかしたらそいつ自身も爆発に巻き込まれちゃったかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620589
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620589,
					"content": "これは私の推測だけど…ルシャリムはその爆発で死んでないと思う。彼の研究も、残ってるんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620590
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620590,
					"content": "え？なんでそう思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620591
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620591,
					"content": "見て…月の海以外、龍族の施設は破壊されてないでしょ。イビニベルンの目、ウージエン生態圏、星海生物捕捉ステーション…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620592
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620592,
					"content": "これは…高天の主の世界を作り変える計画とは、一致してないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620593
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620593,
					"content": "それじゃ、ルシャリムが施設を守ったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620594
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620594,
					"content": "うん、彼は研究成果を交渉材料にして…高天の主に従うことを選んだのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620595
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620595,
					"content": "コロンビーナの言う通りかもな！そう考えると、その後も観月者計画を続けてる可能性が高いぞ。でも、一体どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620596
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620596,
					"content": "月にはもう一つ、知ってる場所があるの。もしその計画がまだどこかに残されてるんだとしたら、きっとそこだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620597
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620597,
					"content": "だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620598
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620598,
					"content": "ニンニン…まだ私たちに言ってないこと、ある…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620599
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620599,
					"content": "…え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620801
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620801,
					"content": "キミの仲間の中で、使命を追い求めてるのはキミだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620802
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620802,
					"content": "そういえばそうだな…クロタマゴの仲間はみんな、もっとのんきな感じがするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620803,
					"content": "心配しないで。無理に答えさせようとしてるわけじゃないよ。ただ…キミのことを、もっと知りたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620804
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620804,
					"content": "これまで見てきた端末の中にも、キミの情報を記録してるものはひとつもなかったみたいだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620805
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620805,
					"content": "それは…私にもわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620806
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620806,
					"content": "大丈夫、ちょっと気になっただけだから。言いたくないなら、言わなくていいよ。私たちはキミを信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620807
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620807,
					"content": "もし私が本当に、みんなに隠し事をしてたら…どうなるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620808
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620808,
					"content": "これもただ…気になって聞いてみただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620809
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620809,
					"content": "ん…隠し事は必ずしも悪いことじゃない。私の友達がそう教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620810
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620810,
					"content": "でも、もし私が怒ったら…キミにあげた小さな帽子、取っちゃうかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620811
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620811,
					"content": "じゃあオイラも、おまえのためのお菓子を月の海に捨ててやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620812,
					"content": "わかった…あなたたちには、絶対に隠し事をしないって約束するよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620813
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620813,
					"content": "その約束を信じるよ、ニンニン。じゃあ、今度は私についてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620814
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620814,
					"content": "月の裏側に基地があるんだけど、私の力で探ってみたら、すごく巨大な空間だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620815
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620815,
					"content": "本当は、最後まで残しておこうって思ってた。掃除するの、きっと疲れるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620816
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620816,
					"content": "でも今は、掃除の予定を早めないとね…残された問題の答えは、そこで見つかる気がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620817
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620817,
					"content": "みんな、ありがとう…私…どうやってお返しすればいいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620818
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620818,
					"content": "どうかな、パイモン。ニンニン、また少し成長したと思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620819
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620819,
					"content": "そうだな…お礼を心配するようになるとは思ってなかったぞ！でもオイラたち、友達だろ？そんなの気にしなくていいんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620820,
					"content": "#{M#うん…これは彼に教わったこと。ニンニンも、見習うといいかもね。}{F#うん…これは彼女に教わったこと。ニンニンも、見習うといいかもね。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620821
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620821,
					"content": "#そう言ってもらえると{M#俺}{F#私}も光栄だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620822
					]
				},
				{
					"id": 760620822,
					"content": "じゃあ、準備ができたら私についてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620527,
					"content": "#{M#俺}{F#私}も信じてるよ、ニンニン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620528
					]
				}
			]
		}
	]
}