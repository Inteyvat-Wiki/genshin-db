			"dialogs": [
				{
					"id": 760620401,
					"content": "やっと古月の源を手に入れたぞ！これで一件落着だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620402,
					"content": "感じる…この中に、私が必要としてる情報があるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620403
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620403,
					"content": "えっ？端末じゃなくてもいいのか？これはどう見ても自然にできたものだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620404,
					"content": "ううん…これは造られたもの…私にはわかるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620405
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620405,
					"content": "お、おい！気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620406,
					"content": "あ…やっぱり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620407
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620407,
					"content": "これは…ルシャリムっていう学者が作り出した…エネルギー体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620408
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620408,
					"content": "ルシャリム？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620409
					]
				},
				{
					"id": 760620409,
					"content": "ウージエンとマーゴの教え子で…たぶん…あの端末にメッセージを残した人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620410
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620410,
					"content": "実は、この月の海は…かつて…ルシャリムの月幕実験所だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620411
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620411,
					"content": "月幕実験所？それってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620412,
					"content": "それは…月を覆い隠す大掛かりな計画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620413
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620413,
					"content": "月を覆い隠す！？古代の人たちは…いや、龍たちはみんな、でっかい夢を持ってたんだな！そんなの、どうやってやるっていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620414,
					"content": "原理はよくわからないけど…彼の先生のウージエンが関係してるみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620415
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620415,
					"content": "ルシャリムは小型月幕の実験に成功していて…それがウージエン生態圏に応用されてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620416
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620416,
					"content": "おっ、思い出したぞ！外から見るとすっごく寂しい雰囲気なのに、中に入ると全然違う景色だったよな！あれが月幕だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620417,
					"content": "そうだよ…小型月幕の成功によって…月幕計画は次の段階へ進んで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620418
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620418,
					"content": "巨大な月幕発生装置が…ここに建設された…それで月全体を遮るの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620419
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620419,
					"content": "でも今は、月は隠されてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620420
					]
				},
				{
					"id": 760620420,
					"content": "完成する直前に…天外からやってきた存在が、それを突き破ったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620421
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620421,
					"content": "装置が暴走して…実験所が爆発して…すべてが無に帰した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620422
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620422,
					"content": "もしかしたら、地下の奥深くには…なにか痕跡が残ってるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620423
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620423,
					"content": "ちょっと待てよ…天外から来た存在って…まさか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620424,
					"content": "高天の主…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620425
					]
				},
				{
					"id": 760620425,
					"content": "その存在の降臨は…誰にも予想できなかった…でも、それがやってきて…なにもかもを変えてしまったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620426
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620426,
					"content": "ルシャリムの構想だと…月幕計画は観月者計画の要件の一環だった…けど、中止を余儀なくされた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620427
					],
					"speakerTitle": "クロタマゴ"
				},
				{
					"id": 760620427,
					"content": "それで、その観月者計画って一体なんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620428
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760620428,
					"content": "危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620429
					],
					"speakerTitle": "コロンビーナ"
				},
				{
					"id": 760620429,
					"content": "しまった！下にウージがいるぞ！避けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
