			"dialogs": [
				{
					"id": 715370101,
					"content": "栄誉騎士さま！こんなところでお会いできるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 715370102,
					"content": "祝灯状を作ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "はい。せっかくお休みをいただいて璃月港に来たので、お土産を買って、騎士団の皆さんに配ろうと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 715370104,
					"content": "海灯祭期間中、璃月の方は贈り物に祝灯状を添えるのだと聞いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 715370105,
					"content": "真似してみようといくつか作ってみたのです。ただ、どうやっても、あまり美しく出来ないんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 715370106,
					"content": "栄誉騎士さま、綺麗な祝灯状の作り方はご存知ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "ノエル"
				},
				{
					"id": 715370107,
					"content": "うん、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
