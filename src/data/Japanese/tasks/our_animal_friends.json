			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラミヤ",
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "よし、これらの食べ物は専用の箱に入れて届けるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680402,
					"content": "動物たちはそれぞれ習性が違うから、檻に閉じ込めるようなことはしない。プロの飼育員を招いて、動物を追跡しながら、随時健康状態をチェックしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680403,
					"content": "動物のいる場所を特定するのはかなり難しいから、ラミヤさんの開発した「すりこみの鏡」って特殊な道具を使うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680404,
					"content": "この分野については、私よりも専門家の彼女から直接説明してもらったほうがいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680405,
					"content": "ええ。じゃあ、ちょっと説明させてもらうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 716680406,
					"content": "「すりこみの鏡」の開発に使われた技術はアーカーシャに関係したものだけど、具体的な原理を説明するとなると、ちょっと難しいわ。でも、安全性についてはテスト済みだから、安心してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 716680407,
					"content": "動物の体には小型の発信装置がつけてあるの。その信号を鏡が読み取って、動物の視野が映るという仕組みになっているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 716680408,
					"content": "装置にはいろいろ改善点があるけど、今のところ、動いている動物の位置を特定する分には十分役立つはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 716680409,
					"content": "…と、こんな感じだ。準備ができたら、いつでも「アニマルトゥギャザー」に参加してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680410,
					"content": "やることは「すりこみの鏡」を使って動物を探すこと。動物たちも、里親のプレゼントも、君が見つけてくれるのを待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				}
			]
		},
