					"ラミヤ",
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "動物救助会「アニマルトゥギャザー」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680102,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#ああ、君は{NICKNAME}だね。こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680105,
					"content": "うちの商会でイベントをやってるんだけど、興味はあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680106,
					"content": "どんなイベント？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "飛雲商会が出資している「アニマルトゥギャザー」という動物救助会に加入して、居場所を失った、あるいは絶滅の危機に瀕した動物を引き取るというものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680108,
					"content": "飛雲商会は世界各地のボランティアと手を取り、居場所を失った動物と里親を繋ぐことで、動物の問題の解決を図っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680109,
					"content": "ここ数年、救助会も成長してきた。ラミヤさんのような学者とも手を組み、絶滅危惧種の保護といった分野にも目を向けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680110,
					"content": "私の研究成果をこの分野にも活かすことができて、とても嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "ラミヤ"
				},
				{
					"id": 716680111,
					"content": "ははっ、こちらこそ、君と手を組むことができて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680112,
					"content": "ボランティアの皆さん、そしてラミヤさんみたいに先見の明を持つ研究員の方々のおかげで、動物たちに居場所を用意したり、絶滅の危機から守ったりできているのだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680113,
					"content": "璃月だけじゃなく、モンドやスメールなど、飛雲商会が活躍している国に「アニマルトゥギャザー」の動物保護拠点はあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680114,
					"content": "ボランティアの皆さんに感謝を伝えると同時に、「アニマルトゥギャザー」の仲間をもっと増やすために、このイベントを企画したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680115,
					"content": "動物保護エリアに行けば、あの子たちの暮らしを確認できるし、プレゼントももらえるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680116,
					"content": "プレゼントは救助会の職員や里親の方々が共に用意したものだ。もちろん、プレゼントを受け取る側も他の里親にあげるプレゼントを用意する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680117,
					"content": "プレゼントは一旦担当者が回収したあと、前の里親に届ける。プレゼントと言っても、高額である必要はまったくない。気持ちが大切なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680118,
					"content": "#どうだい。{NICKNAME}、参加してみるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680119,
					"content": "ちょっと様子見させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "素晴らしい。君みたいな有名人に参加してもらえて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680122,
					"content": "プレゼントの用意ができたら、私に渡してくれればいい。イベントが終わったら、職員が里親のところに届ける段取りになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680123,
					"content": "あ、そうだ。これまで里親と接してきた経験からすると、地域の特産に興味を持つ人やグルメ好きな人が結構いる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				},
				{
					"id": 716680120,
					"content": "参加したい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
