			},
			"dialogs": [
				{
					"id": 30111113,
					"content": "うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30111101,
					"content": "時間は循環していなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "そっか！あの毎晩鳴るアーカーシャの音は、オイラたちのその日の記憶を消去してたんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111104,
					"content": "だから目が覚めると、みんな花神誕祭を過ごしてないって勘違いするんだ。本当はもう「明日」が来てるのに、みんな「昨日」だって思い込んでる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111105,
					"content": "けど、身体に刻まれた記憶は消せない。だから、ディシアは新しい大剣を扱えた！これでぜんぶ辻褄が合うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111106,
					"content": "…とても巧妙な推論ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30111107,
					"content": "これが正解なんだよな、ナヒーダ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111108,
					"content": "簡単に言うと、捕まえてきた炎元素の晶蝶を、ホタルに見立てて照明に使っているようなものね。「感覚」にこだわり過ぎるがあまり、「本質」を見落としているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30111109,
					"content": "ぜんぜん簡単じゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111110,
					"content": "また間違った結論だったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "なんなら、ディシアともう一度話をしてみたらどうかしら。新たな収穫があるかもしれないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30111112,
					"content": "そうだな、元々手がかりはあいつから得られたんだし…行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30111102,
					"content": "こっちの記憶が毎日消去されてたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
