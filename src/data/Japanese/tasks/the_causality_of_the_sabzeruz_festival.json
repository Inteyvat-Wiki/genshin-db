				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "結局また同じ日かよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110102,
					"content": "そう簡単なことじゃなかったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "ナヒーダ、おまえ本当は昨日の夜、「花神誕日の輪廻」がまだ続くって知ってたんだろ？なんで教えてくれなかったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110104,
					"content": "言ってどうなるっていうの。あなたたちは新たな不安に駆られながら夜を過ごすことになる。それでもなお、明日は訪れないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110105,
					"content": "だったらいっそ…その貴重な機会を利用して、束の間の希望の中、心身を休めたほうがいいでしょ。もしかしたらそのおかげで、思考がより明晰になるかもしれないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110106,
					"content": "たしかに…ナヒーダはオイラたちのことを考えてくれたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110107,
					"content": "当然よ。少なくともこの日々が続く限りは、あなたたちが私のすべてなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110108,
					"content": "ふぇ…急にそんな恥ずかしくなるようなこと言うなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110109,
					"content": "ふふふっ…私が言いたいことはね——あなたたち二人に謎を解くようお願いしたのは私だけど、逆に私のことが見えて、私を感じることができるのもあなたたちだけなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110110,
					"content": "言い換えれば、あなたたち二人がいなかったら、私は「存在しない」のと同じ。だから、あなたたちが私のすべてということよ、わかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110111,
					"content": "なんか、ナヒーダがまたわけのわからないことを言い始めたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110112,
					"content": "雑談はここまでにしましょう。旅人、昨日の新たな手がかりから、「現状」に対して何か違う見解は得られたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110113,
					"content": "「時間の循環」は確かに間違った結論。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "えっ、急に以前の考えを否定するなんて、どういうことだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110115,
					"content": "ディシアの武術が進歩してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "あっ、たしかにそうだな。前はそんなところまで見てなかったぜ。単なる時間の循環なら、体の状態も元に戻るはずだもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110118,
					"content": "なら、新たな結論は何かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110116,
					"content": "ドニアザードの病状が悪化してた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "…ここにいたのか、やっと見つけたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110202,
					"content": "今日のディシアも、やっぱりケガをしてないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110203,
					"content": "ケガ？なんのケガだ？あたしを見くびらないでほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110204,
					"content": "おまえのその新しい大剣、本当はまだ使うのに慣れてないんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110205,
					"content": "ああ、実はあたしもおかしいと思っていたんだ。今日いきなり手に馴染むようになって…って待て、どうしてあたしが大剣を変えたことを知っている？言っていないはずだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110206,
					"content": "えーっと…旅人、やっぱりおまえが説明してくれ。オイラもう説明するのに疲れちゃったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110207,
					"content": "完全に理解してもらわなくても大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "そうだな、そうしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110210,
					"content": "大剣が急に使いやすくなった理由は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "何回も花神誕日を過ごしてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "…あたしがいない間に何があったんだ。変なやつに布教でもされたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110214,
					"content": "うぅ、そこは気にしないで、オイラたちの言ってることを信じてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110215,
					"content": "…そうか。まあ、あんたたちの言いたいことは分かった。つまり、あたしの身体に刻まれている記憶はもうこの剣の扱いに慣れていて、あたしの脳はそのことを覚えていない。そういうことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110216,
					"content": "そう、毎日それを忘れちゃうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110217,
					"content": "なら、反論させてもらおう。そんなことは、絶対にありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110218,
					"content": "ん？なんでだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110219,
					"content": "仮に花神誕祭が何日も続いていて、あたしたちが覚えていないだけだとしよう。だったら、物資の消耗、使ったお金、食べたものなどはどう説明する？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110220,
					"content": "理屈で言えば、財布も空っぽになるはずだ。気づかないはずがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110221,
					"content": "それについては考えたことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "黒幕が賢者だったとして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "たしかに…アーカーシャですべての人の行動を記録して、それからここにある資源を使って一日の始まりに戻せば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110225,
					"content": "ありえないようなことだけど、可能性はあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110226,
					"content": "いや、ありえない。あたしには証拠がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110227,
					"content": "証拠？どこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110228,
					"content": "はぁ…あんたたちは本当に、こうも訳の分からない議論に本気なんだな。いいだろう、少し付き合ってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110229,
					"content": "あたしについて来い。それからドニアザードお嬢様も一緒に。今はまだ、周囲の安全を確保できていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110223,
					"content": "アーカーシャの情報とここの資源を使えば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "毎晩、その日の記憶を消されてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "直接本題に入ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "これだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110302,
					"content": "なんだこれ、おまえが剣の練習に使ってる木製のダミーか？これがどうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110303,
					"content": "これについている傷は分かるか？ここ数日のあたしの成果だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110304,
					"content": "賢者たちがこれを毎日取り換えない限り、とっくにボロボロになっているはずだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110305,
					"content": "そうだぞ、だから毎日変えてるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110306,
					"content": "だったら、賢者は毎回新しいダミーの上に、あたしが過去につけた剣の傷を複製しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110307,
					"content": "あたしも一人の武人だ。あたしが学んだ流派では、非常に細かい「コントロール」が要求される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110308,
					"content": "剣の振り方、力、角度、切り込み点、そのすべてを入念にコントロールしているんだ。つまり、そこにあるすべての剣の傷、そしてその剣を振った時の心境さえもあたしは記憶している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110309,
					"content": "武人の剣は唯一無二——こういった言葉があるように、完全に同じ剣筋を振ることは誰にもできない。あたしがつけた傷を完全にコピーするなんて、絶対に不可能なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110310,
					"content": "そうか？なにか精密な機械で少しずつ「彫刻」してる可能性だってあるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110311,
					"content": "写真機で撮った画像は、画家の描いた風景画に取って代わることは永遠にないと言われている。なぜなら、前者には魂がこもっていないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110312,
					"content": "それはあたしも同じで、彫刻で作られた痕と武芸の修練によるものは…一目で見分ける自信がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110313,
					"content": "…確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "ふぅ…これでもう、疑問に思うところはないだろう？ふむ、これは近ごろ学者たちの間で流行っているという「トンチ」ゲームか何かか？なかなか面白いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110316,
					"content": "それじゃ、これであたしは失礼するよ。もう時間も遅い、ドニアザードお嬢様をニィロウのところまで送ってくる。また今度な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "ディシア"
				},
				{
					"id": 30110317,
					"content": "はぁ…また壁にぶつかったな。「記憶消去」の理論は結局間違ってたってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110318,
					"content": "でも少なくとも、真実の一端は掴めたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110319,
					"content": "時間は循環していなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "おう、それは間違いなさそうだな。じゃあ、なにか新しい考えは思いついたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110322,
					"content": "考えてみる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "おかしい？オイラからしたら、最近起きたことは全部おかしいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110325,
					"content": "#{M#俺}{F#私}たち…なんでシティから出ないんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "ん…？シティから出ない…本当だ！こんな簡単に思いつくこと、なんで今まで試してこなかったんだ。外の時間がここと同じ日になってるかどうか確かめれば、色んなことがわかるはずだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110327,
					"content": "でも本当に不思議だ…今まで一つの考えに固執しすぎてたのかな？それとも、疲れのせいで思いつかなかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110328,
					"content": "本当におかしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "とりあえず戻ってナヒーダに聞いてみようぜ。シティから出ることについて、もしかしてオイラたちの忘れていることがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110329,
					"content": "もっと早く思いつくべきだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "ふいに「あること」がおかしいと気付いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "#{M#俺}{F#私}たちは現実にいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "この可能性は諦めるしかないのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301104",
							"2"
						],
						"stepId": 301104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "ナヒーダ、戻ってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110402,
					"content": "今日は早かったのね。もしかして、何か新しい収穫があったのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110403,
					"content": "おう、そんなところだ。オイラたち、時間が循環してないことも、ここが現実じゃないってこともわかったんだ…ただそれと同時に、新しい疑問も浮かび上がったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110404,
					"content": "シティの外に出たらどうなる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "外…私の記憶では、あなたたちはシティの外へ行くことに関する計画を、二回口にしていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110407,
					"content": "！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "オイラたち、そんなことを言ってたのか！全然覚えてないぞ…それで？その後はどうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110409,
					"content": "たしか…あなたたちは外へ行った結果を一度も話さなかった。いえ、正しくはその計画の夜、二回ともあなたたちは戻って来なかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110410,
					"content": "でも、他にもあなたたちが夜に「戻って来ない」ことが結構あったから、当時の私も変に思わなかったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110411,
					"content": "たしかに、色々調べてるとたまに時間を忘れて、そのまま二日目に入ることもあったな。でもおまえの言う外に行った日の記憶は、オイラたちにはないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110412,
					"content": "そう、それはちょっとおかしいわね。理論上、あなたたちの記憶はすべて呼び覚ましたはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30110413,
					"content": "明日もう一回試してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "おう！絶対なにかおかしいぜ。明日になったら、徹底的に調べてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110416,
					"content": "「ピ——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30110414,
					"content": "もしかしたら突破口はそこにある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "#{M#俺}{F#私}たちは今まで外に行かなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
		{
			"id": 301111,
			"completionStepIds": [
				301101
			],
