					}
				]
			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "甘雨、まだ働いてるの？お疲れさま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870602,
					"content": "え？刻晴さん…いえ、大したことはしていませんよ。今回は全部旅人さんと堂主様が解決してくださったので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870603,
					"content": "自分を過小評価しすぎよ。あの二人はもちろん一番の立役者だけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870604,
					"content": "私たちだってみんなからの信頼に応えることができたじゃない？総務司の仕事、速かったでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870605,
					"content": "確かに表向き、今回の事件は当時の魔神の災いほどではない。でも、本当に危機が勃発したら、どうなってたかわからないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870606,
					"content": "そうですね…そういえば、ずっと疑問に思ってたことがあるんです。あの八門七門の陣というものは、月海亭の資料でも見たことがありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870607,
					"content": "由来が知りたいのね。あれは凝光が作ったものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870608,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870609,
					"content": "ふふ、冗談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870610,
					"content": "あの日、この陣について書かれた札がどこからともなく急に玉京台に現れたの。夜蘭ですら、その由来は突き止められなかったそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870611,
					"content": "どこからともなく…？凝光様は、危険を冒しすぎなのではないでしょうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870612,
					"content": "確かに危険そうに感じるけど、よく考えれば、理屈はわかるわよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870613,
					"content": "璃月全体で考えてみて。危機を察知し、秘法にも詳しい…玉京台で夜蘭の調べをすり抜けて、私たちを助けられる方なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 401870614,
					"content": "あっ…まさか師匠たちが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 401870615,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				}
			]
		},
		{
			"id": 4018707,
