						],
						"pointId": 10621
					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "おーい！旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870102,
					"content": "香菱！何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870103,
					"content": "えへへ、アタシといえば、ご飯でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870104,
					"content": "やっとご飯が食べられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "うん！今はもう空いてるんだよね？逃がさないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870106,
					"content": "ずっと時間が空いてなかったのは、オイラたちじゃなくて、胡桃の方だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870107,
					"content": "そう。堂主様は、もはや雲の上の存在だからね！日程も押さえづらいし、みんなの集まる宴じゃないとなかなか来てくれなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870108,
					"content": "でも大丈夫。今回は前々からの約束だし、アタシたちも言い逃れはダメって念押ししたしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870109,
					"content": "ん？「たち」って、他にも誰かいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870110,
					"content": "えへへ、行秋がね、ずっと前からみんなで集まりたかったんだって。でも、行秋のひいおじいちゃんのこと、知ってるでしょ。そのことでずっと叶わなかったらしいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870111,
					"content": "でも、海灯祭のあの夜、行秋のひいおじいちゃんが突然目を覚ましたの。すっごく喜んでたよ…それでちょうど、やっと会える機会が出来たってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870112,
					"content": "わぁ！ひいじいちゃんの方は、もう大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870113,
					"content": "うん、お医者さんにも診てもらったけど、何も問題ないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870114,
					"content": "起きてからはパイモン並みに食欲旺盛で、もりもり食べてるって言ってたよ。食べ過ぎでかえって具合が悪くなるんじゃないか、みんな心配してるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870115,
					"content": "「パイモン並み」って、誉め言葉には聞こえないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870116,
					"content": "もちろん褒め言葉だよ！パイモンの食欲は、前向きに人生が送れてる証拠だもん。人生たらふく食べるべし、箸を空しくするなかれってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870117,
					"content": "へへっ、香菱、よく言ってくれたな！まさにオイラはそういう理念で今日まで生きてきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870118,
					"content": "へえ？知らなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "ふんっ！とにかくそういうことなんだ！人生たらふく食べるべし、えっと…なんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870120,
					"content": "あははは、パイモンの理念はまたご飯の時にゆっくり聞かせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870121,
					"content": "おう！ご飯はどこで食べるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870122,
					"content": "遺瓏埠だよ。行秋たちもまだそっちにいるから。そうだ、胡桃が特別なお客さんを連れて来るって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870123,
					"content": "誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "行けば分かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870125,
					"content": "あっ、わかったかも！へへっ、でも言わないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870126,
					"content": "#{M#俺}{F#私}も分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "おまえは誰だと思うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870128,
					"content": "#{M#俺}{F#私}もないしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "フン！じゃあどっちが当たるか、勝負だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
