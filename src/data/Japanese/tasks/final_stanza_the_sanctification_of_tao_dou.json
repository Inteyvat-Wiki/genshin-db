						],
						"pointId": 10625
					}
				]
			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "往生堂のあの小娘、大したものだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870702,
					"content": "以前、帝君があそこで客卿とやらをしていたから、興味は持っていたのだが…今になってあの方の真意が分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870703,
					"content": "まったくその通りだが、留雲借風がこれほど称賛するとは、実に珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870704,
					"content": "ほう、珍しいとは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870705,
					"content": "今までであれば、「あの小娘も確かに腕は立つな。だがしかし、妾の申鶴と甘雨も遠からずだ。」とでも言っていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 401870706,
					"content": "フン！妾は何につけても自分の子たちばかり上げる輩だったか？あの小娘はこれほどのことを成し遂げたのだから、多少は褒めてもよかろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870707,
					"content": "ほぉっほぉっ、もちろんじゃ。璃月港に長く住んでおるとな、往生堂は代々英才を輩出しているとよく分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 401870708,
					"content": "歌塵の言うとおりだ。かつて、あの魔神桃都と我らは敵でも友でもなかった。あやつが衆生を気にかけ、幽冥を平定するために甘んじて「煉化」していなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870709,
					"content": "八奇どころか、八仙が来たとて、「桃都」をどうすることもできなかっただろう。その後、自らを境界と化し、衆生に守られて来たとは…実に感慨深い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870710,
					"content": "ところで、未だにあの往生堂の小娘の名も知らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 401870711,
					"content": "姓は胡、名は桃という。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870712,
					"content": "「フー」は何と書く？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870713,
					"content": "「古い月」と書いて、「フー」——「胡乱」の「胡」、「ふざける」の「ふ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870714,
					"content": "「タオ」はなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 401870715,
					"content": "「桃都」の「桃」で「タオ」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 401870716,
					"content": "胡蝶の「胡」に桃都の「桃」と書いて、「胡{RUBY#[D]こーたお}桃」…いい名前だ。まさに名は体を表す、だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 401870717,
					"content": "違う！ふーたおだ。「ふざける」の「ふ」だと仰ったであろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870718,
					"content": "なんだ、ちょっと場を盛り上げただけじゃないか。そんな胡乱な目で見るでない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "理水畳山真君"
				},
				{
					"id": 401870719,
					"content": "ほう？胡山胡水真君にでも改名したらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "閑雲"
				},
				{
					"id": 401870720,
					"content": "ほぉっほぉっ、さあさ、お茶を召し上がれ。帝君が軽策から持ち帰ってくださった鬼山霊芽じゃ。珍しいものじゃから、この機を逃すでないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 401870721,
					"content": "来年も美味しいお茶が飲めるといいのぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "ピンばあや"
				},
				{
					"id": 401870722,
					"content": "ああ、きっと飲める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
}