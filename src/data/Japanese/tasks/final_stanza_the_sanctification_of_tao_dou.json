			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雲菫"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "一番すごい人といえば、万象風角霊官だな。なんたって、奇門占術の創始者なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870302,
					"content": "うん！私もご先祖様に一票。あと玄鳥も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "藍硯"
				},
				{
					"id": 401870303,
					"content": "連山二賢を選ぶぜ、オレは。強い人は往々にして「爪を隠す」もんだ。小説でもそう書かれてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870304,
					"content": "確かに、武侠小説ならね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870305,
					"content": "でも、『竹林月夜』を読んでしまうとね…僕は一番強いのは桃都三仙の一人、白駒だと思うよ。彼女にはきっと何か秘密がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870306,
					"content": "あれっ？雲来釣爺を選ぶ人はいないの？あの玉衡様も、あの剣法は雲来釣爺の釣りの動作から取ったって言ってるくらいなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870307,
					"content": "そりゃそうだけど…ちょっと大物感が足りなくないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870308,
					"content": "うーん、釣り人が実は…っていうのも無くはないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870309,
					"content": "もうー！みんな違う！一番すごいのは、無妄の翁と冥蝶だよ。この人たちがいなかったら、今の往生堂は無いんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870310,
					"content": "一理あるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870311,
					"content": "おお、みんなもう着いてたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870312,
					"content": "旅人、パイモン、やっと来たね。いらっしゃい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870313,
					"content": "ああっ！胡桃、その帽子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870314,
					"content": "今回はちゃんと気づけたね。そう、また新しい梅の枝をつけたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870315,
					"content": "おお、じゃあ旅人とおそろいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870316,
					"content": "いったい何話してたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870317,
					"content": "八奇の中で誰が一番すごいか話し合ってたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "藍硯"
				},
				{
					"id": 401870318,
					"content": "ハハハッ、みんな各々好き放題言ってただけだ。答えなんか出ないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870319,
					"content": "そうだな。戦闘力が見えるようになる眼鏡でもあれば、話は早いんだけど。娯楽小説で、そういうのあるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "重雲"
				},
				{
					"id": 401870320,
					"content": "アハハ、娯楽小説って…ずいぶん行秋に染められちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870321,
					"content": "旅人、いらっしゃい。家族から聞いたよ、胡桃とかなり危険な祭儀を成し遂げたんだってね。曽祖父様の病気が治ったのも、そのおかげだそうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870322,
					"content": "この恩義、言葉では言い尽くせない…今後、また何かトラブルがあったら、いつでも飛雲商会に相談しにきてくれ。出来る限り尽くすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870323,
					"content": "他のみんなも頑張った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "うん、それも聞いたよ。父上と兄上は、時機を見て全員のところを訪ねて回るそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 401870325,
					"content": "礼なんかいらないよ、行秋。それより、八奇の中で一番すごいのは、無妄の翁と冥蝶だってこと、大人しく認めたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870326,
					"content": "もう、答えのない話し合いをいつまでもやってないでさ！揃ったんだから、ご飯にしよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870327,
					"content": "さあ、パイモン！パイモンの人生理念を語る時間だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870328,
					"content": "え、ええっ！？えっと…じ、人生たらふく食べるべし、箸を…なんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870329,
					"content": "箸を空しくするなかれ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "あ、そうだ！それそれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870331,
					"content": "おいおい、ちゃんと言えてないじゃないか、大事な理念なのに。そんなんだと、パイモンの人生も幸先悪いぞ？さっ、頑張れ！もう一回言ってみろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "嘉明"
				},
				{
					"id": 401870332,
					"content": "人生たらふく食べるべし！箸を空しくするなかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870333,
					"content": "よく言った！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "へへっ、もう食べていいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870335,
					"content": "もう一人「特別なお客さん」がいるってこと、忘れてない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 401870336,
					"content": "そういえばそうだったな！誰なのかはとっくに分かってるぞ。分かってるけど、言わないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870337,
					"content": "おやおや？怪しいなあ、本当は全然分かってなかったりして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870338,
					"content": "本当に分かってるってば。あの、あいつだろ…おいっ、はやく助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870339,
					"content": "雲菫だよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "大正解！雲菫の言葉、忘れてなかったんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870341,
					"content": "来た来た！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870342,
					"content": "うわぁ！あれって雲翰社の座頭じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "利興"
				},
				{
					"id": 401870343,
					"content": "今日はツイてるぜ、雲先生が遺瓏埠に来てたなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "捷悟"
				},
				{
					"id": 401870344,
					"content": "皆さん、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870345,
					"content": "今夜は『八奇煉桃都』をもう一度歌います。海灯祭で聞けなかった友人のために——あの時のような舞台の上というわけには参りませんが、どうぞご容赦ください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870346,
					"content": "わあっ！海灯祭で聞けなかったおまえたちに歌ってくれるみたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401870347,
					"content": "しーっ！始まるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 401870356,
					"content": "（訳）「桃都、かく語りき——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870348,
					"content": "「物の怪騒ぐ樹の下で——情ある鬼も、縁なき者も、ただ吾が命に従うべし。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870349,
					"content": "「憂いの地から浮世へ入れば、怨みの炎がすべてを焦がす。骨を刀に、血を馬に、いざ九霄へ攻め入らん。——なんと出鱈目な野心であろう。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870350,
					"content": "「天を補い、世を救い、いざ灯火を参らせん。剣を振り上げ、槍を構えて、婆娑の影を巡らさん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870351,
					"content": "「生死陰陽変えるに能わず、自ら撒きし因果の種よ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870352,
					"content": "「天の道は等しく中道。求めし欲こそ汝の過ち。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870353,
					"content": "「退魔誓いし八門立つ。今こそ桃都、落とさんと！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870354,
					"content": "「我らが魂尽きようとも、後生かならず清濁解す。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "雲菫"
				},
				{
					"id": 401870355,
					"content": "「はたや誰かが、柳を折りて、田畑を涙で濡らすべし。あくる年には、燕が拾い、春の川辺を過ぎ去らん。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲菫"
				}
			]
		},
		{
