			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈",
					"夜蘭"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							874.587,
							265.046,
							326.911
						],
						"pointId": 10622
					}
				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "あの日、お前も旅人と共に境界に入るべきだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870402,
					"content": "心配のあまり判断力まで失っていらっしゃるのかしら。旅人に解決できない問題なら、私はなおさら役に立たないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870403,
					"content": "それに、私を層岩巨淵に遣わしたのは凝光よ。さすがに手が回らないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870404,
					"content": "ご不満なら、日を改めて玉京台に行って、訴えたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870405,
					"content": "フン、天権に天権のことを訴えるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870406,
					"content": "玉衡がいるでしょう？彼女なら分け隔てなく、公平に処理してくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870407,
					"content": "もういい…無事ならそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870408,
					"content": "ええ。望舒旅館はいいところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870409,
					"content": "璃月はどこもいいところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870410,
					"content": "あはは、そうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870411,
					"content": "店長、美露エビをもう一つちょうだい、小皿で辛いのもつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401870412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "魈"
				},
				{
					"id": 401870413,
					"content": "それと杏仁豆腐も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
		{
			"id": 4018705,
			"completionStepIds": [
				4018706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4018706",
							"2"
						],
						"stepId": 4018706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗",
					"凝光"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-647.266,
							258.226,
							428.226
						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "危機は去ったのに、天権様はどうして難しい顔をなさっているんで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870502,
					"content": "堂主と旅人のおかげで、無事解決したけれど…危機の原因は未だに分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870503,
					"content": "情報通の船長なら、ナタでも最近、地脈と人命に関わる大事が起きたことを知っているでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870504,
					"content": "実は、関連しているんじゃないかしらと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870505,
					"content": "それなら、璃月とナタ以外でも起きるはずだな。各地の知らせに注目するよう、仕事仲間に伝えとくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870506,
					"content": "まぁ、今はそういう懸念は一旦しまっておけ。せっかくの祭りなんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870507,
					"content": "ふふっ、もちろん。私が刻晴のように休みなく働くような人間に見える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870508,
					"content": "なら、どうして未だにその使い古したかんざしを刺してる？アタシの分で新しいのでも買えって言っただろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870509,
					"content": "北斗船長の報酬だもの、何度も確認しないと手出しできないわ。誰かさんが約束を取り消して、私をからかおうとしてたら大変よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870510,
					"content": "ハハハッ！あんたってやつは、どうしてもアタシに選んでもらわなきゃ気が済まないってか？よし、行くぞ、市場を回ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870511,
					"content": "あら、いつからそんな気遣いができるようになったのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 401870512,
					"content": "ハハッ、無駄口はよしな。さあ、行くのか行かないのかどっちなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 401870513,
					"content": "ふふっ、付き合ってあげてもいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4018706,
