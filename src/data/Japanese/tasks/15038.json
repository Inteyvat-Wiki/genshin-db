			},
			"dialogs": [
				{
					"id": 150380601,
					"content": "ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380602
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380602,
					"content": "目が覚めたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380603
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380603,
					"content": "私の身体が限界なことに気づき、逆に力を渡すことで、内から鎧を破壊するとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380604
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380604,
					"content": "その力と戦闘に対する嗅覚…やはり、お前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380605
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380605,
					"content": "スカーク、スルトロッチの弟子だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380606
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380606,
					"content": "あれから何年経った？あいつがテイワットを離れて、どれくらい経っている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380607
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380607,
					"content": "数百年だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380608
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380608,
					"content": "数百…！そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380609
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380609,
					"content": "すまない。つい感情が高ぶり、名乗るのを忘れていた。私はスクフヌーガ。お前の師スルトロッチの友であり、その跡を追随する者でもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380610
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380610,
					"content": "スカーク…その名を聞くのは初めてだが、数百年前から私はお前の存在も、お前がいずれ来ることも知っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380611
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380611,
					"content": "数百年前から？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380612,
					"content": "聞かせてくれないか？お前のこと、そして師匠のことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380613
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380613,
					"content": "ああ。まだ理性があるうちに話しておこう。あれは…遥か昔のことだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380614
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380614,
					"content": "私はカーンルイアの貴族で、一族の長男だった。爵位を継ぐ資格を持っていたが、幼い頃に不治の病に罹ったことで、誰も私に期待を寄せていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380615
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380615,
					"content": "それでも私は剣の修行に励み、同世代の者たちを次々と打ち負かした。しかし、そんな努力は何の意味もなさなかった。周囲の目は変わらず、そこにあったのは同情や嘲笑のみ。両親でさえ、私が息を引き取る日を待っていたほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380616
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380616,
					"content": "次第に私の心は冷え切り、毎日をただ無為に過ごすようになった。その時だった——私がお前の師、スルトロッチに出会ったのは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380617
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380617,
					"content": "当時の私たちはまだ若かった。あいつは死刑囚の子で、獄中で産声を上げ、幼い頃から路上での生活を余儀なくされていた。あいつが日々浴びせられる中傷の数は、ウニベルシタス・マギストロラム、通称「深秘院」の名著よりも多かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380618
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380618,
					"content": "だが、あいつは一日中笑顔で過ごしていた。まるで、好意も悪意も何の意味もないかのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380619
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380619,
					"content": "忘れもしない。初めて会ったとき、あいつは私にこう言った——「人は自分のために命を懸けるべきだ。たとえ結果が伴わなくとも、炎のように燃え上がらねばならない。このまま何も感じずに死ぬわけにはいかないのだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380620
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380620,
					"content": "…いかにも師匠が言いそうな言葉だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380621
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380621,
					"content": "あいつは私の才能を認め、励ましてくれた。あいつと手合わせしたとき、初めて戦いの楽しさを感じたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380622
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380622,
					"content": "そしてあいつが十歳の時、とある禁忌にまつわる研究資料を盗み出し、私の病気を治してくれた。この世にできぬことなど存在しないと…そう思わせるほど、あいつは人間の身体で不可能に挑み続けていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380623
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380623,
					"content": "しかし、私は次第にその歩みに追いつけなくなった。私の才能はあいつと比べればあまりにも平凡だったんだ。いつからか、あいつは私の遥か先を行くようになり、私はあいつとの稽古を恥じるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380624
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380624,
					"content": "あの「事変」が成功した後、スルトロッチは私を探し出し、こう言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380625
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380625,
					"content": "俺はもうこの星のすべてに興味を失った。そろそろ離れるつもりだ。その前に、得たばかりの力でお前の不死の呪いを解いてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380626
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380626,
					"content": "俺たちはお前の死を退けるため、力を尽くしてきた。だが「不死」となれば、また別の苦しみが伴う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380627
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380627,
					"content": "まあ、それもいいさ。不死でも別に構わない。無限の命があれば、無限に強くなれる。…そうすればいつかまた、かつてのように手合わせできる日が来るかもしれないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380628
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380628,
					"content": "本当にいいのか？俺が戻るまで何年かかるか分からないのだぞ。お前の身体…あるいは魂がその時まで持つ保証はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380629
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380629,
					"content": "試してみようじゃないか。人は自分のために命を懸けるべきだ、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380630
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380630,
					"content": "ああ、そうだったな。だが、もし永遠の命がもたらす苦しみに耐えられなくなり、死を迎える前にもう一度全力で戦いたくなったら——俺の弟子と戦ってはくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380631
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380631,
					"content": "弟子？お前の口から、そんな言葉が出てくるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380632
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380632,
					"content": "ああ。ヴェズルフェルニルが言うには、俺は宇宙で弟子を取り、彼女をテイワットに送るそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380633
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380633,
					"content": "お前もヴェズルフェルニルのことは知っているだろう？それから、あいつの予言が当たることも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380634
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380634,
					"content": "そう言われると気になってくるな。どんな弟子なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380635
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380635,
					"content": "いや、それについては何も教えてくれなかった。ただいつか「群星が彼女にひれ伏す日が来る」とだけ言っていたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380636
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380636,
					"content": "なんだか凄そうな弟子じゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380637
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380637,
					"content": "当然だ。凡人に俺の弟子になる資格などない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380638
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380638,
					"content": "相変わらずの自信家だな。まあ、確かにその通りだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380639
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380639,
					"content": "さて、もう行こう。もしお前がさらなる強さを求めるのなら、原始胎海にある置き土産が役に立つだろう。前にも言ったように、どの道を選ぶのもお前の自由だ。悪人には悪人なりの自由があるものだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380640
					],
					"speakerTitle": "スルトロッチ"
				},
				{
					"id": 150380640,
					"content": "その言葉を聞いて、私は原始胎海を訪れ、スルトロッチの手により瀕死となった呑星の鯨を見つけた。そして私はその身体の一部を切り取り、この心臓に縫い込んだのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380641
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380641,
					"content": "し、心臓に？聞くだけで痛そうだぞ…そんなことできるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380642,
					"content": "ああ。私は「不死の呪い」を受けているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380643
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380643,
					"content": "お前はその呪いを利用して、自身の身体を力の器にしたのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380644
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380644,
					"content": "呑星の鯨の権能を手にしたところで、人の身では呑み込んだ力に耐えられないだろう。刻一刻と崩れていく肉体と魂を、不死の呪いでかろうじて繋いでいたというわけか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380645
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380645,
					"content": "だが、それは強者に至る道ではない。力とは夢と心血からなる結晶だ。他者から奪ったものがお前の所有物になることはない。故に呑まれたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380646
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380646,
					"content": "全くもってその通りだ。その道理を私も分かっているつもりだった。だが…自分の限界に達してもなお、あいつには遠く及ばなかったんだ。だから、賭けに出ることにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380647
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380647,
					"content": "お前の師匠が懐かしいな。あの家のない悪党どもと騒いでいた時代に戻りたいものだ。私は自分の選択を後悔していないが…お前に、お前たちに謝らせてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380648
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380648,
					"content": "十分痛めつけた、それで帳消しだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380649
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380649,
					"content": "ふっ…お前も面白いやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380650
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380650,
					"content": "「スルトロッチの弟子」…聞こえはいいが、あいつの弟子として過ごすのはさぞ大変だったろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380651
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380651,
					"content": "やつの性格から考えるに、きっとお前に絶望と恐怖を与え、自分の後を追うように脅したんじゃないか？だが、よりにもよってあいつ自身は手の届かない高みにいる…そんなところだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380652
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380652,
					"content": "私たちは暗闇の中で登山しているようなものだ。山の高さも、いつ夜が明けるかも分からず、登り続けなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380653
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380653,
					"content": "そうだな。だが、私はもう決意している。どれほど深い絶望でも必ず越えてみせると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380654
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380654,
					"content": "それにお前の話を聞いて、ふと思ったことがある。もしかすると、師匠が望んでいるのは「死闘」ではなく、「悔いのない敗北」なのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380655
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380655,
					"content": "ほう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380656
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380656,
					"content": "お前は師匠の友人なのだろう？友人同士、きっと似ているところがあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380657
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380657,
					"content": "初めてここに来たとき、お前は濃い霧の中から私を刺して力を奪った。そのトゲからは何の感情も感じられなかったが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380658
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380658,
					"content": "しかし、二度目にお前と対峙したとき、その剣からは情熱と喜びが伝わってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380659
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380659,
					"content": "それはまるで、研究に打ち込んだ者が世界の真理を発見したときのような、あるいは芸術に飢えた者が壮大な殿堂に辿り着いたときのような喜びと同じものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380660
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380660,
					"content": "面白い。そのような感情は表に出ていなかったはずだが、剣から読み取るとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380661
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380661,
					"content": "お前の直感は正しい。私は心からお前たちと戦えたことを喜んでいる。負けたことにも一片の悔いはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380662
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380662,
					"content": "ああ。故に、師匠もお前と同じようにそんな戦いを望んでいるのかもしれないと思ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380663
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380663,
					"content": "死力をもって臨まねばならない相手を前に、潜在能力さえも燃やして戦う。戦いの中で己の限界を超え、その身も心も、持てる力をすべて出し尽くす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380664
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380664,
					"content": "そして、その盛大な決闘と共に、自らの幕を引くのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380665
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380665,
					"content": "そのため、彼にとって善悪など関係ない。唯一望むのは「自我の完成」。…それもまた師匠の強さの秘訣なのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380666
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380666,
					"content": "お前の言う通り、あいつはそう考えているのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380667
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380667,
					"content": "どれほど壮大な戦いになるのか…私も興味が出てきた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380668
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380668,
					"content": "ゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380669
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380669,
					"content": "おまえ、身体が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380670
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380670,
					"content": "異なる力が、私の中でぶつかり合っている。不死の呪いがそれらを何とか束ねているが…痛みがなくなるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380671
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380671,
					"content": "私の理性は今にも崩れようとしている…その戦いをこの目で見られないのが残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380672
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380672,
					"content": "スカーク、スルトロッチがしなかったことを代わりにしてくれないか？私を解放してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380673
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380673,
					"content": "いいだろう。だが、死は唯一の解放ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380674
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380674,
					"content": "お前の罪は死に値するものではないからな。別の方法を選ぶこともできる——お前の意識を、お前が呑み込んだ数々の力と共に砕けばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380675
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380675,
					"content": "不純物は消え、お前の身体は不死の呪いによって元に戻る。そうすればかつての純粋な姿を取り戻し、制御不能な力に苦しめられることもなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380676
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380676,
					"content": "それには長い時間と苦痛を伴うが、選ぶのはお前自身だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380677
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380677,
					"content": "…それも悪くないな。私が目覚める頃、お前とスルトロッチの戦いを見られるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380678
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380678,
					"content": "いつかお前があいつと決着をつける日が来ることを信じている。もっとも、それが茨の道であることは言うまでもないがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380679
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380679,
					"content": "私の夜はここで終わる。だが、お前の旅はまだまだ続く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380680
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380680,
					"content": "（幸い…その旅路は孤独ではなさそうだ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380681
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150380681,
					"content": "私はいつか彼という山を制覇しよう。どれだけ険しい道のりであろうとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380682
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380682,
					"content": "スクフヌーガ、最果てで見届けるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				}
			]
		},
