			"dialogs": [
				{
					"id": 150380201,
					"content": "霧が…晴れてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380202,
					"content": "おい！あれって呑星の鯨に呑み込まれたときに出てきたやつだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380203,
						150380204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380203,
					"content": "あれがスカークの師匠だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380205
					]
				},
				{
					"id": 150380205,
					"content": "そうだったのか。じゃあ、なんであの時、呑星の鯨の中に「極悪騎」が現れたんだ？それに、どうしてあいつまで同じ姿に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380206,
					"content": "何ら不思議ではない。力を求める知的生命体が師匠に会えば、無意識にその模倣をし、同じ力を手に入れようとする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380207
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380207,
					"content": "なぜなら、それこそが彼らの想像する「強さ」の極地だからな。あいつは私の師匠と面識があり、さらに私の力も奪っている。あの姿になるのは、むしろ必然と言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380208
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380208,
					"content": "なるほどな。うわぁ…あらためて見てみるとすごい威圧感だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380209,
					"content": "今回はヌヴィレットがいないから、自分たちでなんとかするしかないな。もう人のものを奪えないようにしっかり懲らしめてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380204,
					"content": "「極悪騎」のかつての姿だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380205
					]
				}
			]
		},
