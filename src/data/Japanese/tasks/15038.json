			"dialogs": [
				{
					"id": 150380801,
					"content": "ふぅ～！たった数日の出来事なのに、だいぶ経った気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380802,
					"content": "やっぱり、オイラたちに乗り越えられない壁なんてないな！さすがオイラたちだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380803,
					"content": "まだまだ本気はこんなものじゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380804
					]
				},
				{
					"id": 150380804,
					"content": "おお、自信満々！でも、本当に強くなったもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380805,
					"content": "もう夜か。そうだ！スカーク、おまえの言ってた「消えた星たち」って、もう戻ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380806,
					"content": "ああ。スクフヌーガに吞み込まれた力も元に戻っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380807
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380807,
					"content": "ふぅ、よかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380808,
					"content": "けど、あんなに星があるのによく気づいたな。オイラだったら、いくつか消えても気づかないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380809,
					"content": "…この数百年の間、私はこの夜空を長らく見てきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380810
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380810,
					"content": "精巧に作られた天穹に偽りの星が垂れ下がり、朽ちた光を放つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380811
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380811,
					"content": "だが…本物ではないからこそ、私はこの星空が与える束の間の安寧を楽しめる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380812,
						150380813
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380812,
					"content": "#{M#俺}{F#私}も綺麗だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380814
					]
				},
				{
					"id": 150380814,
					"content": "美しい泡影もいつかは消える。いずれ、私たちは自らの意思にかかわらず、本物の宇宙に帰るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380815
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380815,
					"content": "時間はすべての人を前へと追い立てる。純粋な心しか持たない者を成長させ、旅の苦しみを味わわせる——時の砂を手に掴み、自分の光を放てるようになるその時までな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380816
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380816,
					"content": "偽りの星空でもこうして見上げると、その広さと壮麗さに心打たれるものだ。優しさで本物の銀河を満たすには、どれほど努力しなければならないのだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380817
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380817,
					"content": "なに言ってるかはよくわかんないけど、旅人ならきっとどうにかしてくれるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380818,
					"content": "こいつに出会ってから、毎日が楽しいんだぜ。どんな苦しいことがあっても、絶対なんとかしてくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380819,
					"content": "一人じゃできないことでも、二人ならできる。二人じゃできないことでも、三人ならできる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380820,
					"content": "オイラたちは、これまでたくさんの友達と出会って、たくさんのすごいことをやってきたんだ。この調子でいけば、きっとどんな願いだって叶えられるはずだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380821,
					"content": "お前なら、確かにできるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380822
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380822,
					"content": "…事は解決したから、私はそろそろ行こう。心の様子が変わって、力の状態も変わっている。慣れるためにもっと修行しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380823
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380823,
					"content": "次に会えるのはいつになる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380824
					]
				},
				{
					"id": 150380824,
					"content": "運命が私たちを再び巡り合わせる。次に出会う場所はありふれた街角かもしれないし、未知の星の上かもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380825
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380825,
					"content": "一期一会。いつか歩みを止めたとき、新しい世界を迎えられることのほうが楽しみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380826
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380826,
					"content": "戦争も痛みも、望まない別れもない世界…燃けた焦土にも、きっと花が咲き誇る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380827
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380827,
					"content": "そのためには、私もお前もさらに強くならなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380828,
						150380830
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380828,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380829
					]
				},
				{
					"id": 150380829,
					"content": "今回の修行をよく復習しておくことだ。ではまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380832
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380832,
					"content": "おう、じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380833,
					"content": "あいつ、口調が少し柔らかくなった気がするけど、気のせいか？これだけのことを一緒に経験したんだし、もう友達ってことでいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380834,
					"content": "そうだ、いいこと思いついたぞ！今日はここでキャンプしようぜ。星を見ながら寝たら、きっといい夢見れるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380835
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380835,
					"content": "夜が明けたら、また新しい旅を始めるんだ。そうだ、前回はオイラが万民堂でおごっただろ？今度はおまえの番だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150380830,
					"content": "はい、スカーク「師匠」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380831
					]
				},
				{
					"id": 150380831,
					"content": "…その呼び方がいいのなら、反対はしない。またいずれ会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380832
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150380813,
					"content": "星空の上を見てみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380814
					]
				}
			]
		}
	]
}