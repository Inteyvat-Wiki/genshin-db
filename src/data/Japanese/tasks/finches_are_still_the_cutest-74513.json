					}
				]
			},
			"dialogs": [
				{
					"id": 745130101,
					"content": "そこのあなたさま、生論派学者であり、グランドバザールとロマリタイムハーバーに昇る、商人の新星であるこのバシマ五世があなたさまにお願いいたします。どうかそう急いで離れようとなさらず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130102
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130102,
					"content": "肩の力を抜き、頭を空っぽにして、わたくしの言葉に耳をお貸しくださいませ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130103
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130103,
					"content": "ヤマガラが一番可愛い！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130104
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130104,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130105,
					"content": "えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130106
					]
				},
				{
					"id": 745130106,
					"content": "ヤマガラは確かに可愛いけど、バシマは…商人で学者なんだよな？根拠もなしにそんなこと言って、激しい議論になったりしないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130107,
					"content": "オイラの印象じゃ、学者はみんな発言には慎重だし、商人だってうかつに大げさなことを言ったりしないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130108,
					"content": "もし「オイラの理論が一番正しい」とか、「オイラの商品が一番すごい」って言っちゃったら、納得しない人にめちゃくちゃ文句を言われるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130109,
					"content": "あれ、どっかで聞いたことのあるような会話だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130110,
						745130111,
						745130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130110,
					"content": "だったら言わせてもらう！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130113,
					"content": "#うわぁ！{NICKNAME}、突然どうしたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130114,
					"content": "本気で言ってるんだとしても、そんな大声で言わなくてもいいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130115,
					"content": "おほほほ！ええ、まさにそういう勢いでございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130116
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130116,
					"content": "もちろん、この世に絶対的な一番なんてないことは分かっています。どんな学術的理論も覆される可能性はありますし、どんな商品もいつかは新しい商品に追い抜かれることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130117
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130117,
					"content": "しかし、客観的な世界がどう変わろうと、誰しも…最も認めている人や物が存在するでしょう？他人が何を言おうと、それは最も価値あるものなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130118
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130118,
					"content": "否定されることを恐れて自信を失えば、自分がなりたい最高の姿には一生なれませんし、自分を認めてくれる人にも出会えることはないでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130119
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130119,
					"content": "もし、あなたさまがたもこのテーブルゲーム「カラコロ！チュンボール」を遊んだことがおありでしたら、必ずわたくしと同じように、ヤマガラが一番かわいい！と、叫びたくなるはずですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130120
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130120,
					"content": "カラ…コロ…チュンボール？それって隣のテーブルにあるやつのことか？これもなんだか見覚えがあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130121,
					"content": "そうですわ。このゲームを遊んでいただければ、心の底からヤマガラの可愛さに開眼されることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130122
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130122,
					"content": "実はこのテーブルゲームを広めようとしているのです。ゲームでハイスコアを取れた方には、報酬もご用意しておりますわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130123
					],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130123,
					"content": "オイラもヤマガラは可愛いと思うし、報酬は多くなくてもいいぞ。楽しく遊べるなら十分だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130124,
					"content": "#{NICKNAME}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130125,
						745130126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745130125,
					"content": "やってみる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130127,
					"content": "おほほほ、わたくしと同意見のようですわね！それではどうぞ、存分にお楽しみくださいませ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バシマ五世"
				},
				{
					"id": 745130126,
					"content": "ヤマガラの可愛さがどれほどのものか！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130111,
					"content": "パイモンが一番可愛い！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130112,
					"content": "以上！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				}
			]
		}
	]
}