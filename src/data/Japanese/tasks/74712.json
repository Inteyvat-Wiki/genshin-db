			"dialogs": [
				{
					"id": 747120101,
					"content": "旅人、パイモンちゃん。いいニュースよ——問題は全部解決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120102,
					"content": "お魚鎮静大作戦、成功よ～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120103,
					"content": "潜水士さんたちが水中を片付け終わって、お魚の患者さんたちがもう少し落ち着いたら、元の環境に帰してあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120104,
					"content": "本当にお疲れ様。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "へへっ、オイラたちみんなが頑張ったおかげだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747120106,
					"content": "今回の件のレポートをパレ・メルモニアに提出したのよ。もうすぐ担当の人員が関連規則を制定して、各機関に通知するはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120107,
					"content": "それから、このテーマにすごく興味を持ってる記者や映影の監督もいるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120108,
					"content": "もしかしたら、そのうち水域環境の保護をテーマにした映影が見られるかもね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747120109,
					"content": "うん、ただ普通に言い聞かせるだけじゃ、頑固なやつとか適当なやつらは、全然聞いてくれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747120110,
					"content": "いっそのこと、めちゃくちゃ怖く撮るといいと思うぞ…例えば…環境が破壊されたせいで…変異した魚たちが超ヤバい大怪獣になって、あちこちを破壊する！とかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747120111,
					"content": "水の中に物を捨てるのが癖になってるやつらに悪夢を見せてやれば、きっと教育効果は抜群だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747120112,
					"content": "そうだったら最高ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シグウィン"
				}
			]
		}
	]
