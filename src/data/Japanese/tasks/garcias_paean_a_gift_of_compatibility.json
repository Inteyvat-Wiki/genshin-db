			"trigger": {
				"objectNames": [
					"ジャーヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030501,
					"content": "あら、そんなに急いでどうしたの？あの機械にまた問題でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030502
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030502,
					"content": "いやいや、それは問題ないんだ。待たせてすまなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030503
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030503,
					"content": "大丈夫、私も今来たところよ。…前にプレゼントをくれるって言ったわよね？だから、私もあなたにこれを用意したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030504
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030504,
					"content": "はい、「ナツメヤシキャンディ」よ。仕事の合間に甘いものを食べれば、身も心もリラックスできるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030505
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030505,
					"content": "あの「ナンバリングマシン」を作るのは大変でしょうけど、自分の体も大切にしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030506
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030506,
					"content": "「ナツメヤシキャンディ」だって？ええと、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030507
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030507,
					"content": "なあに、変な顔して？甘いものは好きだって言っていた気がしたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030508
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030508,
					"content": "い…いやいやいや！その通り、甘いものは大好きだ。だから…その、俺が君に用意したのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030509
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030509,
					"content": "ガルシアは気まずそうに「ナツメヤシキャンディ」とレシピを取り出した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030510
					]
				},
				{
					"id": 738030510,
					"content": "ぷっ…あなたもこれを用意してたの？私たち、心が通じ合っているのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030511
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030511,
					"content": "でも、これは…特別な香りがするわ。それにこれはレシピ…？数字がたくさんあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030512
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030512,
					"content": "それは…俺が「ナンバリングマシン」で複写した「ナツメヤシキャンディ」のレシピだ。作り方と、食材の量が正確な数値で記載してある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030513
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030513,
					"content": "それは前にも言ったように、絶対に正確なんだが…俺は料理が下手だから、このキャンディの味までは保証できない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030514
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030514,
					"content": "大丈夫よ、この「計算」されたキャンディはおいしくいただくわ。これは本当に特別なプレゼントね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030515
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030515,
					"content": "そうだ…ここに来た時、テーブルに原稿用紙がたくさん散らばっていたの。このレシピみたいに数字がぎっしりだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030516
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030516,
					"content": "その中に記号がいっぱい書かれたものがあって、「楽譜」のように見えたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030517
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030517,
					"content": "筆跡が、あなたのとそっくりだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030518
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030518,
					"content": "ぜ、絶対に俺は関係ないぞ！それは…それは、どこかの酔っ払いが、飲み過ぎて適当に書いた落書きだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030519
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030519,
					"content": "私はあなたの原稿の整理を何度も手伝ったわ。文章の清書もね。ごまかせないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030520
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030520,
					"content": "なによ、私がいなくなる前にもう別のお金儲けを思いついたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030521
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030521,
					"content": "だ、断じて違う！他の誰かのために楽譜を書くなんてこと、俺にはできない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030522
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030522,
					"content": "じゃあ、私のためにこの楽譜を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030523
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030523,
					"content": "お…俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030524,
						738030525
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030524,
					"content": "彼は…今まで恋愛の経験が…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030526
					]
				},
				{
					"id": 738030526,
					"content": "ご理解ください、旅人さん。ガルシア先生はその人生のほとんどを研究に費やしてきました。人と接した経験はめったにありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030527
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030527,
					"content": "そんな彼に、過酷な研究をこなしつつ、ある種の…成熟したコミュニケーション技術も身につけろというのは、大変酷というものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030528,
						738030529
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030528,
					"content": "なんとか助けてあげたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030530
					]
				},
				{
					"id": 738030530,
					"content": "それは…ガルシア先生が真実の愛を手に入れられることを願うばかりですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030531
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030531,
					"content": "この心からの祝福は、ガルシア先生からいただいているお給料に見合うものだと確信していますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030532
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030532,
					"content": "…ふふ、そんな困った顔をしないで。今回ばかりはずっと計算に付き合ってあげることもできないわ…もうすぐスメールを離れるんですもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030533
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030533,
					"content": "これは…失敗作だ。俺はきみのために楽譜を書こうとして、きみが過去の公演で使った伴奏の楽譜をほとんどを集めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030534
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030534,
					"content": "それらの楽譜を統計として数式化し、我々の「ナンバリングマシン」にまったく新しい楽譜を出力させようとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030535
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030535,
					"content": "しかし見ての通り、どれだけ数式を修正しようと、計算方法を変えようと、出力されるのはこの数字の山…とても楽譜とは呼べないものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030536
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030536,
					"content": "その失敗作を返してくれないか。俺はそれを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030537
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030537,
					"content": "これは「失敗作」なんかじゃないわ。あなたが私にくれたんだもの…先にもらっちゃったけど。私、これ好きよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030538
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030538,
					"content": "しかし、それはとても楽譜と呼べるものではない。誰にも読めやしないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030539
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030539,
					"content": "それはあなたの見方よ。私はまだこれをちゃんと読んでない。最後まで読めば…いいところが見えてくるかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030540
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030540,
					"content": "信じられないなら、私たちと一緒に来て。そうすれば、旅をしながらこの楽譜を一緒に完成させることもできるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030541
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030541,
					"content": "ジャーヤくん、すまない、俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030542
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030542,
					"content": "…まだやらなければいけない研究がたくさんある、でしょ？そう答えることは分かってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030543
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030543,
					"content": "…この楽譜は、あなたの手元にないと困るかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030544
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030544,
					"content": "いえ、僕が保存用に書き写したものがあります。ジャーヤさん、ガルシア先生が書かれた楽譜は、あなたに差し上げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030545
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030545,
					"content": "なに？いつの間に書き写したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030546
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030546,
					"content": "先生、帳簿係の書類作成能力をなめていただいては困ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030547
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030547,
					"content": "それは…うん？待てよ…ではここに楽譜があったのも君が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030548
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030548,
					"content": "えーと…先生、正直なところよく覚えていません。なにしろ二人とも忙しすぎて、そんなことに構っていられませんでしたからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030549
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030549,
					"content": "路通、あなたみたいに親切な人が彼のそばにいてくれれば安心よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030550
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030550,
					"content": "お褒めにあずかり光栄です、お嬢さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030551
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030551,
					"content": "ああ、もう時間がないわ。劇団に戻らなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030552
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030552,
					"content": "あなたも、見送りはいらないわ。万が一心変わりして劇団の車に飛び乗られたら、路通がスメールに取り残されてしまうもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030553
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030553,
					"content": "僕一人でも璃月に帰ることくらいできますよ、お気遣いなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030554
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030554,
					"content": "それはそうでしょうけど…誰かさんがそれを許してはくれないでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030555
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030555,
					"content": "ジャーヤくん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030556
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030556,
					"content": "さようなら、ガルシア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030557
					],
					"speakerTitle": "ジャーヤ"
				},
				{
					"id": 738030557,
					"content": "…ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030558
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030558,
					"content": "ジャーヤは背を向けて去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030559
					]
				},
				{
					"id": 738030559,
					"content": "先生、ジャーヤさんは行ってしまいましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030560
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030560,
					"content": "…きみの直感はよく当たると言っていたな、路通くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030561
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030561,
					"content": "我々は、いつかまたジャーヤくんに会うことができると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030562
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030562,
					"content": "もちろんです。ですが踊り子たるジャーヤさんの才能を考えるに、次に彼女に会う時は…まずお金を出してチケットを買う必要があるでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030563
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030563,
					"content": "ははは、きっとそうだろうな。…我々も仕事に戻ろう。その時が来て、チケットを買う金もないなんてことにはなりたくないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030564
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030564,
					"content": "旅人さん、長い間お付き合いいただき、誠にありがとうございました。こちらは報酬のモラです、どうぞお受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030565
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030565,
					"content": "研究が上手くいくといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030566
					]
				},
				{
					"id": 738030566,
					"content": "ええ、僕もそう願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030567
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030567,
					"content": "路通くん、その…まだ金は残っているかね？アハンガルさんのところに清算に行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030568
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030568,
					"content": "それでは失礼いたします、旅人さん。ちなみにこれも直感ですが、我々はこれからも協力の機会がたくさんある気がしますよ。では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030529,
					"content": "なにかアドバイスは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030530
					]
				},
				{
					"id": 738030525,
					"content": "ジャーヤさんのペースだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030526
					]
				}
			]
		},
