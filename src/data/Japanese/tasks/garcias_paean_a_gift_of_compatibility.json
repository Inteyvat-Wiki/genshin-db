			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"ガルシア",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030101,
					"content": "恐れながら先生、その「楽譜」は口ずさむ方法すら想像がつきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030102
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030102,
					"content": "率直な意見ですが、もし本当に…普通の楽譜を書きたいのであれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030103,
					"content": "少しお金を払って、シアターの俳優に頼めば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030104
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030104,
					"content": "いかん！いかんいかん！絶対にいかん！それでは意味がない。もう一度数式を修正して、戻ってから再出力するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030105
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030105,
					"content": "しかし、もしそうすれば…もっと時間がかかってしまう。もう一度考えさせてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030106
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030106,
					"content": "何をしているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030107
					]
				},
				{
					"id": 738030107,
					"content": "旅人さん、いいところに。僕とガルシア先生は、あの「ナンバリングマシン」を作曲家にしようとしていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030108
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030108,
					"content": "えーと…これだけでは分かりませんね。簡単に言えば、ガルシア先生は「ナンバリングマシン」がある数式に従って楽譜を出力するよう試みているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030109,
						738030110
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030109,
					"content": "「ナンバリングマシン」にそんなことが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				},
				{
					"id": 738030111,
					"content": "もちろん「ナンバリングマシン」の本質は計算するための機械ですから、楽譜を直接書くことはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030112
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030112,
					"content": "ですので、「ナンバリングマシン」の計算結果を、ガルシア先生みずから別の数式に照らし合わせ…手動での音符への変換、楽譜への書き起こしを行います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030113,
						738030114
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030113,
					"content": "あ、頭が痛くなってきた…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030115,
					"content": "その通りだ！親愛なる路通くん、君は非常にまとめるのが上手い。つまりは…そういうことなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030116
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030116,
					"content": "ひとまず解説はここまでだ、旅人くん！我々にはきみの助けが必要なんだ…頼む、力を貸してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030117
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030117,
					"content": "モラも他の報酬もある。急いで人手がいるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030118,
						738030119
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030118,
					"content": "誰か怒らせたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030120,
					"content": "違う。そんな問題よりもっと重大なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030121
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030121,
					"content": "ジャーヤを…じゃなかった、ジャーヤくんを覚えているかね？彼女は今日、劇団と一緒にスメールを離れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030122
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030122,
					"content": "俺は彼女に、餞別の品を贈ると約束したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030123
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030123,
					"content": "そしてこの純粋に数式から算出された「数式楽譜」こそが、俺がジャーヤくんに贈りたいものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030124
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030124,
					"content": "しかし…しかしだ。この楽譜は歌いたくても歌えない…とても贈り物にはできない代物なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030125,
						738030126
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030125,
					"content": "じゃあ別のものにすれば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030127,
					"content": "ダメだ！ごく普通のプレゼントでは、ジャーヤくんはきっと…すまない、少し混乱していてね、落ち着かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030128
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030128,
					"content": "と、とにかく、「ナンバリングマシン」をもう少し改良する必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030129
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030129,
					"content": "旅人くん、俺と一緒にアハンガルさんを探してくれないか。きみなら間違いない、頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030126,
					"content": "じゃあ贈り物を買えば？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030119,
					"content": "フォンテーヌの人が連れ戻しに来た？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030114,
					"content": "完全に理解した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030110,
					"content": "「ナンバリングマシン」ってすごいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				}
			]
		},
		{
			"id": 7380302,
			"completionStepIds": [
				7380302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380302",
							"2"
						],
						"stepId": 7380302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アハンガル",
					"ガルシア",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030201,
					"content": "お前が描いて寄越した部品の設計図なら見たぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030202
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030202,
					"content": "難しくはない部品だが…お前の望む精度に達するには、仕上げにまだ時間がかかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030203
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030203,
					"content": "大体どれくらいだ？今日中にもらえるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030204
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030204,
					"content": "無理に決まってるだろ！鍛造はな、数字をちょいちょいと書くのとはワケが違うんだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030205
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030205,
					"content": "今日中に手に入らなければ、「ナンバリングマシン」の改造はきっと間に合わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030206
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030206,
					"content": "なあ、どうしてそんなに急ぐんだ。お前のあの機械はもう完成してるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030207
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030207,
					"content": "それについては僕が説明しましょう。我々はいくつかの…その、予想外のトラブルに見舞われまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030208
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030208,
					"content": "路通は事情を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030209
					]
				},
				{
					"id": 738030209,
					"content": "つまり、こいつはそのジャーヤという娘に一目惚れしたと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030210
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030210,
					"content": "なにっ！？違う！我々は協力関係にある、ただのビジネスパートナーだ！そうとも！俺はただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030211
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030211,
					"content": "お前…そのジャーヤという娘に、自分の気持ちを伝えたことがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030212
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030212,
					"content": "気持ち？一体何を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030213
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030213,
					"content": "はあ、何も伝えていないんだな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030214
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030214,
					"content": "いいえ、ガルシア先生は伝えています。それは僕が保証しますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030215
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030215,
					"content": "なにっ！？きみ…路通くん！君がどうしてそれを知っている！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030216
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030216,
					"content": "先生…あのとき僕を厄介払いしようとした言い訳は、あまりにお粗末なものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030217
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030217,
					"content": "それにあの日、カフェで先生はジャーヤさんとたくさん話をされていましたが…「ナンバリングマシン」については最後まで触れませんでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030218
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030218,
					"content": "僕の知る限り、そんなことは普通ではありえませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030219
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030219,
					"content": "うむ、ありがとう路通くん！その優れた記憶力がふさわしい場所で発揮されることを、切に願っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030220,
						738030221
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030220,
					"content": "ジャーヤさんは何て言ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				},
				{
					"id": 738030222,
					"content": "か…彼女は、次の日のコーヒーはおごる、と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030223
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030223,
					"content": "ふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030224
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030224,
					"content": "おお…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030225
					]
				},
				{
					"id": 738030225,
					"content": "…そんなことはどうでもいいんだ、今の問題は部品のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030226
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030226,
					"content": "ゴホン…ま、貰うもんはもらってるしな…超特急で仕上げてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030227
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030227,
					"content": "だがよう、もし本当にその娘の心を射止められる贈り物がしたいなら、なんで直接専門家に聞いてみないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030228
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030228,
					"content": "たとえばシアターを管理しているシェイクズバイル、奴なら出演者の好き嫌いをよく知ってるだろ。ジャーヤにふさわしい贈り物も知ってるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030229
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030229,
					"content": "それはいいアイデアです。ガルシア先生、あなたはここでアハンガルさんと部品の検討を続けていてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030230
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030230,
					"content": "僕と旅人さんでシアターに行って、シェイクズバイルさんに贈り物について聞いてみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030231
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030231,
					"content": "何をするにも予備案は必要…あなたがいつも言っていることですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030232
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030232,
					"content": "ありがとう、路通くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030233
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030233,
					"content": "お気になさらず、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030234
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030234,
					"content": "では行きましょうか、旅人さん。ふさわしい贈り物が見つかるといいんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030221,
					"content": "彼女の態度は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				}
			]
		},
		{
			"id": 7380303,
			"completionStepIds": [
				7380303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
