				"points": []
			},
			"dialogs": [
				{
					"id": 738030401,
					"content": "路通くん！やっと戻ってきたか。ああ、アハンガルさんといろいろ議論したが、やはり部品の製作時間を短縮することはできなかった。一体どうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030402
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030402,
					"content": "それはちょうどよかった。旅人さんと一緒に、ひとつの方策を見つけてきたところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030403
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030403,
					"content": "楽譜を出力する数式はうまくいきませんでしたが、別件で「ナツメヤシキャンディ」のレシピを複製できたことは覚えていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030404
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030404,
					"content": "僕たちは、ジャーヤさんがこのお菓子を大変好いているらしいことを突き止めました。これなら、あるいは…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030405
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030405,
					"content": "…複製したレシピとお菓子を一緒にプレゼントする…か！いい、いいぞ…悪くない発想だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030406
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030406,
					"content": "言っとくが…俺は料理ってやつが苦手だ。料理ができる鍋もないしな。力にはなれないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030407
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030407,
					"content": "先生、ランバド酒場の近くに調理器材があったのを覚えています。そこに行ってみませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030408
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030408,
					"content": "本当かね？それはいい！すぐに行こう！しかし路通くん、君はそんなことまで覚えているんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030409
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030409,
					"content": "それが僕の仕事ですよ、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030410
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030410,
					"content": "一行はランバド酒場へ向かった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030411
					]
				},
				{
					"id": 738030411,
					"content": "すばらしい！器材も食材もそろっている！ええと…数式を思い出させてくれ。覚えているはずだ…俺のペンを。うむ、計算させてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030412
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030412,
					"content": "よし！主な数値はこれでよし、あとは副次的な数値だ。暗算するから少し待ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030413,
						738030414
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030413,
					"content": "ど、どうやってそんなに暗記したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030415
					]
				},
				{
					"id": 738030415,
					"content": "暗記ではない。急いで再計算しただけだ…それも別に複雑なことではないぞ。なにせ一度計算したことがある数値だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030416
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030416,
					"content": "しかし、数値にある各食材とその投入量が対応していないぞ…とはいえ、今はこれ以上計算する時間もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030417
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030417,
					"content": "旅人くん！君は見識が広く、多くの美食に触れてきたに違いない。君の直感で構わない、どの食材の投入量を最大にすべきか判断してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030418
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030418,
					"content": "必要な食材をお伝えします。「ナツメヤシキャンディ」を作るのに必要なのは、デーツ、杏仁、バターとスメールローズです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030419,
						738030426,
						738030433
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030419,
					"content": "デーツの投入量を最大に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030420
					]
				},
				{
					"id": 738030420,
					"content": "うむ…確かに「ナツメヤシキャンディ」というくらいだ、デーツの投入量を最大にするのは理に適っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030421
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030421,
					"content": "路通くん、数値に基づいて食材を入れるんだ。我々には時間がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030422
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030422,
					"content": "はい、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030423
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030423,
					"content": "三人は「ナツメヤシキャンディ」を作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030424
					]
				},
				{
					"id": 738030424,
					"content": "これは…デーツが多すぎたのではないかね？これでは名前から「キャンディ」を取って、単なるナツメヤシと呼んだほうがいいくらいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030425
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030425,
					"content": "ええ…ですが、見ていたらお腹が空いてきました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030443
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030443,
					"content": "とにかく…このお菓子とレシピを急いでジャーヤくんに届けよう。彼女とは、いつもの場所で会う約束をしてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030444
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030444,
					"content": "ああ、そうだ。路通くん、あの楽譜はどこかにしまっておいてくれ。間違って渡してしまったらかなわんからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030445
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030445,
					"content": "待て、俺の楽譜はどこだ？きみが持っているんじゃないのか？路通くん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030446
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030446,
					"content": "先生が持っていたのではないのですか？先生が楽譜を持っていないのなら、それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030447
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030447,
					"content": "…まずいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030448
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030448,
					"content": "…まずいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030449
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030449,
					"content": "急げ！カフェだ！テーブルに置きっぱなしにしたに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030426,
					"content": "杏仁の投入量を最大に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030427
					]
				},
				{
					"id": 738030427,
					"content": "杏仁の風味は俺も好きだが…うーむ、やってみるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030428
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030428,
					"content": "路通くん、数値に基づいて食材を入れるんだ。我々には時間がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030429
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030429,
					"content": "はい、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030430
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030430,
					"content": "三人は「ナツメヤシキャンディ」を作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030431
					]
				},
				{
					"id": 738030431,
					"content": "先生、これは…どちらかというと「杏仁キャンディ」と呼んだ方がいいのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030432
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030432,
					"content": "うむ…キャンディらしい甘みはしっかりついている…味も、悪くはないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030443
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030433,
					"content": "スメールローズの投入量を最大に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030434
					]
				},
				{
					"id": 738030434,
					"content": "なぜ「キャンディ」に花びらを入れるのか、まったく理解できません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030435
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030435,
					"content": "このキャンディがそこそこ値が張るのは、これが理由かもしれんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030436
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030436,
					"content": "路通くん、数値に基づいて食材を入れるんだ。我々には時間がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030437
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030437,
					"content": "はい、先生…その、今更遅いかもしれませんが、この食材は決して安いものではありません…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030438
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030438,
					"content": "親愛なる路通くん、きみは…君はただ花びらを中に入れてくれればいいんだ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030439
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030439,
					"content": "三人は「ナツメヤシキャンディ」を作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030440
					]
				},
				{
					"id": 738030440,
					"content": "なんということでしょう！…このキャンディを見てください。もしこれが食べられるお菓子だと知らなければ、僕はこれをプロポーズの花束だと思ったことでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030441
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030441,
					"content": "路通くん！頼むよ、きみのその尋常でない想像力は、どこか別のふさわしい場面で使ってくれないかね！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030442
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030442,
					"content": "いえ、今こそがふさわしい場面でしょう、先生…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030443
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030414,
					"content": "この数字を全部暗記してるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030415
					]
				}
			]
		},
		{
			"id": 7380305,
