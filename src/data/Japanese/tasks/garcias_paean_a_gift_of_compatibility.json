			},
			"dialogs": [
				{
					"id": 738030601,
					"content": "なぁ、なんだってお前…わざわざあの怪しい機械を使って楽譜を書かなきゃならないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030602
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030602,
					"content": "ほら、スメールシティには香料もあれば、アクセサリー屋だってたくさんあるんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030603
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030603,
					"content": "それが気に入らないなら、俺がちょっとしたアクセサリーをこしらえてやってもいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030604
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030604,
					"content": "いや、それはその…俺とジャーヤくんはあの「ナンバリングマシン」をきっかけに知り合ったわけであるからして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030605
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030605,
					"content": "彼女には、それに関係した贈り物がしたいんだよ。それがこの「数式楽譜」というわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030606
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 738030606,
					"content": "へっ…本当におかしなヤツだぜ。ジャーヤはプロの劇団員だぞ。毎日それはご大層な楽譜を目にしてるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030607
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030607,
					"content": "お前のその楽譜が見向きもされなかったり、すぐに忘れられちまったらどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030608
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 738030608,
					"content": "ジャーヤくんに限ってそんなことはないさ、絶対にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		}
