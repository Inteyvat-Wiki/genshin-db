			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シェイクズバイル",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030301,
					"content": "ふう…やっとひと休みできる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030302
					],
					"speakerTitle": "シェイクズバイル"
				},
				{
					"id": 738030302,
					"content": "ん、君たちは…？何か御用かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030303
					],
					"speakerTitle": "シェイクズバイル"
				},
				{
					"id": 738030303,
					"content": "あのですね、ジャーヤさんのことでご相談が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030304
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030304,
					"content": "路通は質問をした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030305
					]
				},
				{
					"id": 738030305,
					"content": "ジャーヤ？ああ、覚えているとも。彼女のダンスはとても素敵だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030306
					],
					"speakerTitle": "シェイクズバイル"
				},
				{
					"id": 738030306,
					"content": "彼女の好きなものか…うーん、強いて言えば「ナツメヤシキャンディ」というお菓子…かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030307
					],
					"speakerTitle": "シェイクズバイル"
				},
				{
					"id": 738030307,
					"content": "ジャーヤたちはスメールを離れるんだったな？そのせいか最近、彼女は人に頼んでこのお菓子を買い漁っているらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030308
					],
					"speakerTitle": "シェイクズバイル"
				},
				{
					"id": 738030308,
					"content": "「ナツメヤシキャンディ」…そう言えば、先日「ナンバリングマシン」の性能を検証するためにいくつかレシピを複製したのですが、その中に作り方があったように思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030309
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030309,
					"content": "うーん。いいアイディアではありますが…いくらレシピが複製できても、作るのには人の手が必要です。しかし、僕もガルシア先生も調理の技術はからっきしでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030310
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030310,
					"content": "知ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030311
					]
				},
				{
					"id": 738030311,
					"content": "とはいえ、これも予備案のひとつと言えるでしょう。ひとまずガルシア先生に伝えに行きましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030312
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030312,
					"content": "…その表情、何か聞きたげですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030313,
						738030317
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030313,
					"content": "どうしてジャーヤさんと一緒に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030314
					]
				},
				{
					"id": 738030314,
					"content": "それは僕もガルシア先生に言いました。ここで縁ができた劇団の団長も、我々に一緒に来て、帳簿の管理をしてほしいとおっしゃっていたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030315
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030315,
					"content": "しかし、ガルシア先生はその提案を断固として拒否したのです。彼によれば自分の仕事はまだ完成しておらず、「ナンバリングマシン」も改善点がたくさんあるからだ、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030316
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030316,
					"content": "はは、そのときは正直…ガルシア先生の物事に対する優先順位を初めて真剣に疑いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030322
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030322,
					"content": "話はこれくらいにして、ガルシア先生のところに情報を持ち帰りましょう。アハンガルさんの堪忍袋がまだ保っているといいのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				},
				{
					"id": 738030317,
					"content": "ジャーヤさんは何だって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030318
					]
				},
				{
					"id": 738030318,
					"content": "それは分かりません。数日前からガルシア先生がジャーヤさんとデートするたび、僕も近くに座って、できるだけ目を合わさないようコーヒーを飲んでいるのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030319
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030319,
					"content": "正直、ガルシア先生が僕の前に改まって、「ナンバリングマシン」はやめだ、ジャーヤさんについて行く…と言ってくれたらどんなに良いか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030320
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030320,
					"content": "僕がいくらか駄賃をもらって璃月に帰ることになっても、あるいは彼ら二人の帳簿管理を続けることになっても…どちらでも僕は喜んで受け入れましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030321
					],
					"speakerTitle": "路通"
				},
				{
					"id": 738030321,
					"content": "しかし、ガルシア先生はいつも僕の肩を叩いて言うんです。「路通くん、装置の構造について議論を続けよう」とね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030322
					],
					"speakerTitle": "路通"
				}
			]
		},
