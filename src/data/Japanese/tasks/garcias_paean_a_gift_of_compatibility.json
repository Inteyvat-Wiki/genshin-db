	"talks": [
		{
			"id": 7380301,
			"completionStepIds": [
				7380301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
