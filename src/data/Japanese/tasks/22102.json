			"dialogs": [
				{
					"id": 221020101,
					"content": "参りましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "私の目の隈を見てください、もう何日もよく眠れていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020104,
					"content": "館内のお客様を見ましたか？本当に大変です。うちの旅館こんなに高い所なのに、それでも跳ぶ人がいるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020105,
					"content": "まあこの話は置いておいて、さっき城内から野菜の注文をしたので、もうすぐ届くと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020106,
					"content": "でも道中の怪物たちは、大人しくしてくれないでしょうから、怪物を片付けてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "では、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020108,
					"content": "この旅館…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "「世界中の客を集い、見聞を広める」…私はそう思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020111,
					"content": "まあ、お客様が多いだけの離れた場所にあるただの旅館です、大したことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221020112,
					"content": "では、頼みましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
