			"dialogs": [
				{
					"id": 706660101,
					"content": "突破挑戦する！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#にゃ…「もうカードプレイヤーランクの突破試練に参加すると言うのか。だが、{NICKNAME}には確かに挑戦資格があると言えよう。では早速…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660103,
					"content": "「今からジョインに突破試練に必要なフィールドをセットしてもらおう。気を付けたまえよ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「リトルプリンス」"
				}
			]
		},
		{
			"id": 7066602,
			"completionStepIds": [
				7066603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066603",
							"2"
						],
						"stepId": 7066603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「リトルプリンス」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "にゃ！「なんと素晴らしい！プレイヤーランクの試練突破、おめでとう！これで汝も上級プレイヤーと言えよう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660202,
					"content": "にゃ？「たった一度の試練をクリアできただけで上級プレイヤーと言えるのか、だと？まあまあ、世の人の大半は七聖召喚を娯楽として見ているのだから、そんなに真剣にならずとも…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660203,
					"content": "「つまり——真剣に娯楽する人が少数派になるわけだ。だが、例え娯楽だとしても、真剣にやる価値はある。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660204,
					"content": "にゃ！「ああ、そうだ。今の汝は我も認めた者であるから、他のやつがセッティングしたゲームに挑戦してみるのもよいだろう。うむ…きっと彼らも汝を気に入るはずだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660205,
					"content": "他のやつ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "にゃ。「うむ、もちろん我と同じで、酒場にいる猫のことだが…彼らをなめるなよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660207,
					"content": "にゃ～「その時が来れば、ジョインにカードを並べてもらおう。よしでは恒例のあれを言っておくとしよう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706660208,
					"content": "「『七聖召喚』を楽しんでくれたまえ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「リトルプリンス」"
				}
			]
		},
