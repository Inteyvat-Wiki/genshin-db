			"dialogs": [
				{
					"id": 790590101,
					"content": "これは『東遊·旅の始まり』の撮影でボツとなったシーン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790590102,
					"content": "もともと構想していた物語は、フォンテーヌから東へ向かって出発し、スメールシティの知恵の殿堂で不智の智慧を探し求める旅人のお話だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790590103,
					"content": "このシーンは旅人が道中で巨大な岩に封印されていた「変化マスター」を助けて、一緒に旅に出る一幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790590104,
					"content": "はぁ…だが、旅人を演じる水形幻霊も「変化マスター」を演じる水形幻霊もどこかに消えてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790590105,
					"content": "もし、<color=#00E1FFFF>やつらを全員連れ戻して</color>、巨大な岩のそばで練習する瞬間を収められれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "撮影地の備考"
				}
			]
		},
