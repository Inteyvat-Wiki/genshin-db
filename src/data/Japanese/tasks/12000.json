				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "「万文集舎」…ここは璃月港の本屋だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000202,
					"content": "ここに『テイワット観光ガイド』の璃月編がないか聞いてみよう！あの本、いろいろと面白いからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"紀芳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "いらっしゃいませ、どうぞご自由に。買わなくても大丈夫だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000302,
					"content": "『テイワット観光ガイド』の璃月編を探してるんだけど、ここにないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000303,
					"content": "ああ、その本はあまり人気ないから、結構前から置いてないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000304,
					"content": "えっ！？モンド編は面白かったのに…残念だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000305,
					"content": "その本の作者って変わってるからね、ガイドだけど、あまりガイドとして使えないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000306,
					"content": "売れないどころか、その本のせいでお客さんから苦情が入る始末だし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000307,
					"content": "作者の主張が激しいから…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "モンド編は冒険譚として読んでて面白かったのに、残念だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000310,
					"content": "とにかく、ここにはないから諦めて。どうしても読みたいなら、常九殿のところに行ってみるといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000311,
					"content": "常九殿って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000312,
					"content": "軽策荘に住んでてね、様々な絶版本をコレクションとして集めてるんだよ。短気なところもあるけど、本の話になると結構話しやすいから安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000313,
					"content": "彼がまだ璃月港にいた頃、うちの常連さんでね。今でもたまに彼に本を送ったりするよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000324,
					"content": "でも、彼の住んでる場所はなかなか見つけにくいんだ。軽策荘の裏山の桟道を登る必要があるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 120000314,
					"content": "今、絶版本と言った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000315,
					"content": "では、あの絶版した『神霄折戟録』第6卷も、彼のコレクションにあるかもしれないということ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000316,
					"content": "誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "これは失礼した。僕は行秋、たまたま通りがかった読書家だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000319,
					"content": "僕も本を探してるんだ。せっかくだから一緒に軽策山に行って、その常九殿という者を訪ねようと思うが、どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000320,
					"content": "それでは、道案内よろしく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "本を愛する同士だ、かしこまる必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000322,
					"content": "そこまで行くつもりは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "そう言わずに、この璃月港は何かと騒々しい。たまには静かな場所で気分転換するのも必要だと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000317,
					"content": "ビックリした。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "犯罪をそそのかす内容があったとか…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "はぁ、終わりだ…天の裁きだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000502,
					"content": "常九殿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "ん？何かね？用件があるなら手短に言ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000504,
					"content": "絶版本をたくさん持ってるって聞いたぞ。『テイワット観光ガイド』の璃月編を借りたいんだけど、持ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000505,
					"content": "はぁ、本の話はやめてくれ。聞きたくもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000506,
					"content": "層岩巨淵が閉鎖されてから、うちの鉱石の売上は激減だ。その上、「ファデュイ」まで邪魔してくるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000507,
					"content": "支払いのために、わしの愛書はすべて質に入れたよ…！これがどういう意味か分かるか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000508,
					"content": "…読む本がなくてつらい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "違う！本はわしの人生だ！わしが一生かけて集めた大切なコレクションが！全部なくなったんだよ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000511,
					"content": "はぁ…君たちに叫んでも意味がないことくらいわかってる。それより、早く金を作る方法を考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000512,
					"content": "他に用がなければ、帰ってくれ。世間話する気分じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000513,
					"content": "それは、あの『神霄折戟録』の第6卷も質に入れたということかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000514,
					"content": "おや、そのタイトルを知っているとは…君は、中々にいいセンスしてるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000515,
					"content": "オイラたちにはセンスがないって言ってないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000516,
					"content": "それは時代を代表する奇書の一つだ。出版された時は誰も興味を示さなかったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000517,
					"content": "後に武俠小説に対するイメージを変えるものとなり、それを模倣する者もたくさん現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000518,
					"content": "最初の印刷数はかなり少なく、すぐさま絶版したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000519,
					"content": "その後、重版されたのだけど、続編として出版された第6卷だけはなぜか再版されなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000520,
					"content": "そうそう、その通りだ！数がとても少ないから、どれだけ金に困っても質には入れられないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000521,
					"content": "つまり、その本はまだここにあるということだね！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000522,
					"content": "ああ、唯一わしの手元にあるコレクションだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000523,
					"content": "おい！お前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000524,
					"content": "いつまで待たせる気だ！石珀、売るのか売らないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000525,
					"content": "茂才公様を怒らせたら、「ファデュイ」を怒らせたことと同じだからな。どうなるか分かっているんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000526,
					"content": "はぁ、また君か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000527,
					"content": "それでも、七割も引かれた値段で売るわけにはいかない…そんな値段で売ったら、永遠に本を取り戻せなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000528,
					"content": "そんなことは知らん。本を読みたいか、生きていたいかお前が選べ！それとも、本を抱えて棺桶に入りたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000529,
					"content": "くっ…そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000530,
					"content": "お兄さん、商売というのは互いが合意した上でするものだ。強要はいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000531,
					"content": "何だお前？お前には関係ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000532,
					"content": "古華派、行秋。ただのお節介者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000533,
					"content": "プッ…ハハハハッ──！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000534,
					"content": "古華派？今、古華派と言ったか？ハハハッ、この時代にまだ古華派を口にするヤツがいるとはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000535,
					"content": "ただの名前だけの門派だろ？よくも俺の前に立てたもんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000536,
					"content": "正義と肩書きは関係ない。君も虎の威を借る狐のような召使いだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000537,
					"content": "お、お前ッ！首を洗って待ってろ！絶対に痛い目に遭わせてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000538,
					"content": "あとお前もだ！あの鉱石は何がなんでも売ってもらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000539,
					"content": "はぁ、生き地獄とはまさにこのことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000540,
					"content": "ところで、例の本は貸してもらえないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000541,
					"content": "冷たすぎる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "いいんだ、心配してくれる人なんて求めてはいない。さっき庇ってくれた礼に、貸してやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000544,
					"content": "ありがとう！この本を三年も探してたんだ。この恩は必ず返す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000545,
					"content": "そういうのはいい。本をちゃんと返してくれれば、大丈夫だ。古華派の弟子に期待なんかしていないしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "常九"
				},
				{
					"id": 120000546,
					"content": "おい！もう行くのか？まだなにも解決してないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000542,
					"content": "少しは空気を読んで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "…読む本がなくて退屈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
