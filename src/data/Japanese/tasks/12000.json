			"dialogs": [
				{
					"id": 120001001,
					"content": "ただの石ころかと思ったら…まさか「神の目」だったとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001002,
					"content": "きょ、今日のところは見逃してやる！このままで終わると思うな！覚えてろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120001022,
					"content": "痛い目に遭わすとか言っていたけど、彼には一生無理だろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001003,
					"content": "「神の目」を持ってるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "ああ、でも「神の目」を使って相手を倒しても弱い者いじめみたいになるからね、あまり使いたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001008,
					"content": "うーん…あいつら、今は行ってくれたけど、きっとまた来ると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001009,
					"content": "ああ、恩人殿を困らせるわけにはいかない。商売にはやり方があるんだ。この件は、僕が最後まで責任を持つよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001010,
					"content": "「ファデュイ」が商人の味方をするとは考えにくいけど、あの召使いの態度を見た感じ嘘ではなさそうだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001011,
					"content": "本当に手を組んでいるのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001012,
					"content": "それに先ほどヤツが言っていた「茂才公」、その名を聞いたことがある。彼の屋敷は璃月港でもかなり目立つんだ。君たちは何か手がかりがないか探してきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001013,
					"content": "まあ、おまえの考えは筋が通ってるけど…おまえはその間なにをするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001014,
					"content": "僕？僕は他に調べたいことがあるんだ、そうだな…あとで璃月港の玉京台で集合しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001015,
					"content": "本当だよな？オイラたちを雑用係として使ってるんじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001016,
					"content": "おお、そんな考え思いつきもしなかった、素晴らしい！言葉にできないほどの良案だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120001017,
					"content": "ううう！腹が立つぞ、こいつ！殴りたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001018,
					"content": "常九殿を助けるのが先だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "分かった。でも、オイラを怒らせたやつには嫌なあだ名をつけてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001021,
					"content": "そうだ、「本の虫」にしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120001019,
					"content": "事件を解決した後で殴ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "古華派って本当はすごいの！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "いや、誤解だ。さっきのヤツの言葉は悪いが、古華派に対する評価は…まあ、間違っていないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "行秋"
				},
