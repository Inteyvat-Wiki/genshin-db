			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "ここで本を読むのがおまえの正義なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000602,
					"content": "へえ、こんなことが、なるほど…面白いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000603,
					"content": "おい、話を聞け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000604,
					"content": "ふむ、人気なのも頷ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000608,
					"content": "おい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000605,
					"content": "さっきの怖そうな連中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "そうだな、鉱石を安くしないと痛い目に遭わせるって、まるで強盗みたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000609,
					"content": "常九殿を助けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "勝手に僕を仲間はずれにするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000613,
					"content": "聞こえてたんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120000614,
					"content": "この本を借りたのは、このままだと常九殿がこれを質に入れるだろうと思ったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000615,
					"content": "彼に言った言葉は嘘ではない。恩を必ず返す、それが義侠というものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000616,
					"content": "この本は僕が代わりに保管する。そして彼の他のコレクションも、僕がなんとかする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000617,
					"content": "方法はあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "もちろん方法はある。すでに心当たりもあるし、あとは仔細を決めるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000620,
					"content": "ここで少し観察させてくれ。あまり時間はかからないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000621,
					"content": "まだこんなとこにいたとはな！さっきのがただの脅しだとでも思ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000622,
					"content": "ばか派のくせに、大した度胸だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000623,
					"content": "ああ、間違えた、古華派！古華派、だったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000624,
					"content": "「蟷螂が斧を以て隆車に向かう」ということわざがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000625,
					"content": "あ？何言ってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000626,
					"content": "帰ってくれ。強引な商売は僕が許さない。それに、相手が恩ある常九殿なら尚更だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000627,
					"content": "お前、またそいつの味方をするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000628,
					"content": "タイミングが悪かったな！今日は「ファデュイ」の方が後ろについてるんだ！古華派のヤツなんて目じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000629,
					"content": "僕はまだ若いが…それでも数年、世間を渡り歩いてきた。悪人を恐れる必要がどこにある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000630,
					"content": "なら、この俺が痛い目に遭わせてやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昌虎"
				},
				{
					"id": 120000618,
					"content": "方法があるとは思えない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "璃月編は読めそうにない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "本を求める同志なのに、もう諦めるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 120000606,
					"content": "さっきの連中、茂才公の手下って言った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
