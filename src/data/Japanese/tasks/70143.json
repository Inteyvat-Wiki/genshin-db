			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "こんにちは、旅人さん。最近順調ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430202,
					"content": "まあまあ順調。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "はい、あなたの冒険については私も聞きました。このままいけば、きっと優秀な冒険者になれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430204,
					"content": "それで…その冒険者活動について、こちらにとある「冒険情報」があるのですが、いかがでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430205,
					"content": "また新しい依頼…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "どうやら協会のことについてはすでに知り尽くしていますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430207,
					"content": "しかし、今回は依頼ではなく「冒険情報」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430208,
					"content": "この「冒険情報」は、「ドラゴンスパイン」に関するものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430209,
					"content": "あそこにはすでに協会が拠点を設置し、冒険者もたくさんいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430210,
					"content": "場所はマップに記しておきますので、その拠点に行って「玉霞」という冒険者の方から事情を聞いてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 701430211,
					"content": "では、引き続き冒険を。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				}
			]
		}
	]
