			"dialogs": [
				{
					"id": 706960101,
					"content": "久しいな、童よ。最近はどこを旅しておったんじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960102,
					"content": "雪山での出来事を神子に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "なるほど。素晴らしい仲間ができたようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960104,
					"content": "同じ趣味を持つ仲間たちが、遠路はるばるやって来る、か…ふふ、青春の風を感じるのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960105,
					"content": "『炎魂戦記』の魅力にみながどっぷり嵌っておるようなら、そろそろ再版を検討せねばな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960106,
					"content": "読者たちの熱量に応え、妾からちょっとした贈り物をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960107,
					"content": "漫画はどうじゃ？みなに行き渡るよう、十分な数を用意しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960108,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "どれも他所では手に入らぬ初版物じゃ。大事にするんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960109,
					"content": "みんなと一緒に読ませてもらうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
