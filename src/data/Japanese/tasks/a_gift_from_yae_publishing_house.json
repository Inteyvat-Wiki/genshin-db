			"dialogs": [
				{
					"id": 706960201,
					"content": "神子からたくさん漫画をもらったな。みんなにも読んでもらいたいし、表に出すのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706960202,
					"content": "「特戦隊」キャンプの本売り場の横とか。そうすれば、誰でも手にしやすいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706960203,
					"content": "本棚を借りてきて、神子からもらった漫画を置いた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "よぉし。これでみんな自由に漫画が読めるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
