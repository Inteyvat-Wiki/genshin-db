			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "来たんだね。また頼むことになって悪いわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630102,
					"content": "今日は元気みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "あははっ、ありがとう。やっと考えがまとまったって感じかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630104,
					"content": "強引に求めても仕方ないこともあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630105,
					"content": "夜になったら一緒に西側の砂浜に行かない？君たちに送りたいものがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630106,
					"content": "おお！海のお宝か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630107,
					"content": "行ったら分かるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "ここよ。当時、父が最後に海に出た場所がここなの。今日と同じような夜でね、あの日以来、父には会えてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630202,
					"content": "そっか、それは寂しいな…鯨井さんの願いはお父さんにもう一回会うことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630203,
					"content": "あははっ、確かに会いたいけど、海の民はいつの日か海に帰るの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630204,
					"content": "私の願いは、父を超える漁師になることよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630205,
					"content": "小さい頃、父と一緒に海に出たいと思ってたの。でも父はいつも母に私を預けてた。時には近所の男の子を連れて行くこともあったのよ。それなのに、私を連れて行こうとはしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630206,
					"content": "父はいつもね、こう言ってたの。「椛、海辺に来てないで、女の子らしいことをやりなさい。」「船の上ではしゃぐよりも、そのお金で袴でも買いなさい。」と…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630207,
					"content": "私は悔しかった。なんで？女の子らしいことって何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630208,
					"content": "飴を買ったり、花を摘んだり、お姫様ごっこしたり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630209,
					"content": "じゃあなんで冒険に行ったり、海に出たりしちゃいけないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630210,
					"content": "私はそんなのいや。だから父が離れてから、私は漁師の生業を始めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630211,
					"content": "父が探索できなかった海域は、私が探索する。父が捕まえられなかった大物は、私が捕まえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630212,
					"content": "「鯨井」流の釣り技術は、私が継ぐ。「鯨井」家の漁師の名は、私が轟かせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630213,
					"content": "たとえ「海中月」がただの伝説だとしても、私は歩みを止めない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630214,
					"content": "うん、きっと成功するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630216,
					"content": "伝説の魚がいないなら、願いを海に捨てるわ。きっと、父も見届けてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630217,
					"content": "君たちは、何か願いはある？一緒にやってみない？願いを書いて、漂流瓶に入れて力強く投げるの。きっといつの日か叶うわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630218,
					"content": "えっ——そういうのもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630219,
					"content": "でもオイラ、願いがいっぱいあるから…どれを書いたらいいか悩む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630220,
					"content": "手助け本当にありがとう！感謝してもしきれないわね。これはほんのちょっとのお礼よ、受け取ってもらえると嬉しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630221,
					"content": "わぁ——見ろよ、なんだあれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630222,
					"content": "すごく大きな魚の群れだ！しかも光ってる。オイラたちの漂流瓶を気に入ったみたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630223,
					"content": "みんな集まってると、なんか海の中に、でっかい月があるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630224,
					"content": "こ…これは、「月光魚」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630225,
					"content": "あっ！分かった…分かったわ！なるほど、これが「海中月」だったのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630226,
					"content": "えっ？これが「海中月」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630227,
					"content": "そう、忘れもしない。このキラキラと輝く月光…あの時の「海中月」も、嘉瑋が漂流瓶を投げてから現れたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630228,
					"content": "道理でこんな長い月日、誰も「海中月」を捕まえられなかったのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630229,
					"content": "だってそれは、「月光魚」の群れだったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630230,
					"content": "でも意外ね、「月光魚」って…こんな漂流瓶が好きだったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630231,
					"content": "えへへ、もしかしたら、人々が漂流瓶に託した願いが好きなのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630232,
					"content": "あははっ！だったら、私、鯨井椛が全部釣り上げてみせるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630233,
					"content": "オイラも！オイラも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726630234,
					"content": "それなら、私の釣り竿を君たちにあげるわ。これは鯨井家が「海中月」を捕まえるために作った特製の釣り竿よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630235,
					"content": "感謝の気持ちを表すにはほど遠いけど、心からのお礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726630236,
					"content": "それを使って、「月光魚」を全部釣り上げてちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		}
	]
}