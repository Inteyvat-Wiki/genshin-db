			"dialogs": [
				{
					"id": 760550101,
					"content": "（<color=#FFCC33FF>ラウマ</color>は何か聞こえたようだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "…おや？今何か聞こえたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550103,
					"content": "（またお客さん！ルーレットぐるぐる、ルーレット止まる。美味しいご飯もらえる！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550104,
					"content": "（あれ？お客さん、なんでルーレットぐるぐるしないの？はやくはやく！美味しいもの食べたい！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550105,
					"content": "子犬…だろうか？…ルーレットぐるぐる、美味しいもの…どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550106,
					"content": "（お客さん！聞こえてるの？はやく、ぐるぐるして！でないと、美味しいものが食べられない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550107,
					"content": "空腹なのか？…クッキーを持っておる。先に腹を満たすが良い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550108,
					"content": "（ん？ルーレットぐるぐるしてないけど、食べ物くれた…うーん、とりあえず食べる…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550109,
					"content": "（ありがとう！ぼく、パブロフ。クッキー美味しい。でも、ルーレットぐるぐるしてない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550110,
					"content": "どういたしまして。ところで…さっき言っておった「ルーレットぐるぐる」とは、なんのことだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550111,
					"content": "（ルーレットぐるぐるしたら、止める。そうしたら、美味しいものが落ちてくる。毎回同じ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550112,
					"content": "（お客さん、ほんとにぐるぐるしない？みんな、回したらすごく楽しそう。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550113,
					"content": "私は結構だ…どうやら、おまえはここで楽しく暮らせておるようだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550114,
					"content": "（うん！うん！お客さんが遊んでくれるし、ルーレットも遊んでくれる。それに、おいしいものもある。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "パブロフ"
				},
				{
					"id": 760550115,
					"content": "なら良かった。では、主によろしく伝えてくれ。私はこれで失礼する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760550116,
					"content": "（うぅ…またね、お客さん！またね！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パブロフ"
				}
			]
		},
