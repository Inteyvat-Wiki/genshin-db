			"dialogs": [
				{
					"id": 790540401,
					"content": "写真か…今はこんなにも不思議なものがあるんだな。これで道中の景色を簡単に記録できそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540402,
					"content": "#どうした、{NICKNAME}。写真はもう撮ったのか？君たちがあそこで撮った星空、すごく楽しみにしているよ。",
					"roleType": "TALK_ROLE_NPC",
