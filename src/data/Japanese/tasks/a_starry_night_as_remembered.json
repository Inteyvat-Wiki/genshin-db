			"dialogs": [
				{
					"id": 790540301,
					"content": "ジェローニ！戻ってきたぞ、ほら、これが写真だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540302,
					"content": "…本当だ、本物とそっくり同じように見える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540303,
					"content": "この写真、本当に僕にくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540304,
					"content": "もともと、おまえのために撮ったものだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540305,
					"content": "はは、ありがとう…まさかこんなにすごい技術が見られるとは思わなかったよ。もうこんな技術があるなら、ミラージュの外で爆速車を見るのも夢じゃないかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540306,
					"content": "本当に綺麗な星空だ、あの時にもこんな技術があったら良かったのに、そうすれば…あいつもこの星空をいつまでも見れたのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェローニ"
				}
			]
		},
