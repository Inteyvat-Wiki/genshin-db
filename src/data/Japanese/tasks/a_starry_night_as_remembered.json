							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "あれ、君たちはどうしてここへ？ここはコースもないし、標高も高い、ヴェルーリヤ·ミラージュの辺境だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540102,
					"content": "普段は誰もここに来ないんだ、イディアでさえもね…ふん。彼女、ここの存在を把握すらしてないのではないかと疑ってしまうほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540103,
					"content": "ここ、なんにもないじゃないか。ジェローニはここでなにしてたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540104,
					"content": "僕は気晴らしに来てるだけだ…はぁ、そんな「またフェルディナンドと喧嘩して家出したんじゃ？」って目で僕を見ないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540105,
					"content": "いや、本当に喧嘩なんかしてないからな。僕があっちこっち走り回ってるのは、ええと、なんというか、個人的な趣味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540106,
					"content": "この前も話しただろう？「びゅんびゅん爆速車」は最初、僕が提案したものだ。当時僕は、何か簡単に高いところへ登っていけるものがあればいいなと考えていて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540107,
					"content": "だから僕が…このジェローニが爆速車とそのコースを考案したのは、空と高いところへの憧れなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540108,
					"content": "バカみたいだよな。確か稲妻のことわざで、馬鹿と煙は高いところが好きってのがあったが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540109,
					"content": "爆速車を考案しただけでもすごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "でもヴェルーリヤ·ミラージュの中でしか、こんな爆速車は作れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540112,
					"content": "…もういいよ。僕がここに来た理由はもう1つあって、ここの星空を観賞するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540113,
					"content": "ヴェルーリヤ·ミラージュの星空も、瓶の外の星空が屈折して結んだ像なんだろうけど、僕にとっては十分綺麗だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540114,
					"content": "毎晩…ここで星空を眺めていると、心の中がすごく穏やかになるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540115,
					"content": "星空が好きなのは、ジェローニなの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "あんな星空を見れば、誰だって好きになるさ。残念なのは、昼間にも星が見えればいいのにというくらいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540117,
					"content": "もちろん、毎日こんなところまで登らなくても見れるんだったらなお良しだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540118,
					"content": "あっ、その方法…オイラ、1つ思いついたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540119,
					"content": "えっ、本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540120,
					"content": "写真を撮ればいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "…しゃ、写真？今はもうそんなにすごいものがあるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540122,
					"content": "そうだそうだ。ジェローニのために、オイラたちが星空の写真を撮ってやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540123,
					"content": "本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540124,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "でも、きれいな星空を撮るならどこがいいんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540126,
					"content": "おーい、ここだ！夜になると、この場所で一番きれいな星空が見れる。僕がここまで登ってきた理由もそれだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "ジェローニ"
				},
				{
					"id": 790540127,
					"content": "分かったぜ！ジェローニは、オイラたちが写真を撮るのを待ってればいいからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790540110,
					"content": "爆速車は面白い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
