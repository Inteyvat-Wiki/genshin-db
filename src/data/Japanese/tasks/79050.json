			"dialogs": [
				{
					"id": 790501501,
					"content": "へへっ、できたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501502,
					"content": "シズクちゃんたちがすごく喜んでるみたいで、オイラもあったかい気持ちになったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501503,
					"content": "友情の証を守った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "そうだな、これで「ヴェルーリヤ·ミラージュ」にいるあの画家の友達も、あいつの作品も、全部が完璧になったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501506,
					"content": "いつかあいつがまた戻って来て、友達と再会して、自分の傑作をもう一度見られたらいいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501507,
					"content": "そういえば、この絵の作風ってわりと特別だよな…ゴージャスってわけじゃないけど、綺麗だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501508,
					"content": "一番大事なのが、オイラでも理解できるってところだな。もしかして、この壁画の作風を真似したら、オイラでも綺麗でわかりやすい絵が描けるようになるかもしれないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501509,
					"content": "すごい絵が全て複雑だとは限らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "おう！おまえさえいいなら、この壁画の写真を撮ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501512,
					"content": "そうすればオイラ、いつでもあの画家のテクニックを勉強できるようになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501514,
					"content": "オイラが綺麗な絵を描けたら、オイラたちと友達になってくれるシズクちゃんがきてくるかもしれないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790501510,
					"content": "パイモンもこの作風を習いたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
