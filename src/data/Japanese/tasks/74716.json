					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "よかった…これで廃棄物は、おおかた片付いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160102,
					"content": "大変だったよね…旅人、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160103,
					"content": "いやいや！それよりも、今回は収穫が盛りだくさんだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160104,
					"content": "水中の環境も改善できたし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "ありがとう…おかげで、楽しくて充実した時間だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160107,
					"content": "へへっ、これはみんなの努力の結果だろ！それにおまえ、すっごく成長したな！水中でも陸でも、めちゃくちゃ頼りになったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160108,
					"content": "照れないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "う…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160111,
					"content": "ごめん…こういうときって感謝の言葉以外に何を伝えればいいのか、わからなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160112,
					"content": "もう少し、練習する時間が必要かも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160113,
					"content": "焦らずゆっくりでいいからな。自分のペースで少しずつ頑張ればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160114,
					"content": "機会があれば、いつでも協力するから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "うん、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160117,
					"content": "…いつもなら、事が終わった後はしばらく水の中に戻って一人で過ごす時間が必要になるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160118,
					"content": "不思議なことに、あなたたちとこうして話してると…空がすごく穏やかなんだ。この気持ち…伝わるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160119,
					"content": "それじゃ…ぼくは先に帰ってリネたちと合流するね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160120,
					"content": "残りの調査情報は、あなたたちに託すよ。いい収穫があるといいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 747160121,
					"content": "嬉しそうな声がこっちまで聞こえてきていたわ。何かいいことがあったみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160122,
					"content": "うん！オイラたち、魚たちの生活の邪魔になってたゴミをだいたい回収し終わったんだ。ピアノの残りの部品も見つけたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160123,
					"content": "本当？見せてちょうだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160124,
					"content": "…本当ね。これなら、ピアノを直せそうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160125,
					"content": "完全に元通りに復元できるわけじゃないけれど、また綺麗な音楽を奏でられるようになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160126,
					"content": "なんだか嬉しそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160127,
					"content": "そ…そうかしら？まあいいわ、直してくるから。すぐに終わるから、アナタたちはここを飾り付けておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160128,
					"content": "アナタの音色には美しい舞台こそがふさわしいもの。うふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160129,
					"content": "やっぱりすごく喜んでるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160130,
					"content": "わあっ！すごく綺麗なピアノだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160131,
					"content": "すごく上品！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "ふふっ…当然でしょう。誰が直したと思っているの。機械の連動装置も補強して、外装も一新してみたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160134,
					"content": "アナタたちの仕事ぶりも悪くないわね。このピアノに相応しい舞台だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160135,
					"content": "へへ、大したことはしてないぞ。そんなことより、さっそく弾いてみてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160136,
					"content": "…え？今？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160137,
					"content": "以外にいつ弾くって言うんだ？弾くために直したんじゃないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747160138,
					"content": "今日は…やめておくわ！次の機会に弾くのでも遅くはないでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160139,
					"content": "弾き方を忘れちゃった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "フン…うるさいわね…！ワタシはただ、まずはこいつと静かに過ごして、昔を懐かしみたいだけよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160142,
					"content": "ちょっと挑発したくらいで、言うことを聞かせられると思わないことね。出直してきなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747160140,
					"content": "照れてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "美しい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "また何かあったら、いつでも声をかけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "綺麗なお宝もたくさん見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}