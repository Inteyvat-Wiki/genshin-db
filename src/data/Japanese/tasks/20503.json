					"content": "なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030502,
					"content": "鉄を見つけてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "ああ、そんなこともあったな。忙しすぎて忘れてたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030505,
					"content": "まあいい、この色のものも使えないわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030506,
					"content": "鍛造依頼したい",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030503,
					"content": "前に鉄を見つけてこいと言われた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
