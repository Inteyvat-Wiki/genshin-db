			"dialogs": [
				{
					"id": 205030601,
					"content": "鉱石を見つけたら、こっちに来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030602,
					"content": "もちろん、俺が忙しくない時に来るのが一番いいがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030603,
					"content": "なんか機嫌悪い気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "鉄を打つには集中力が必要だ。客の世間話に付き合うのは苦手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030605,
					"content": "腕がよければ、依頼が来る。他のことはいらないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030606,
					"content": "用がなければ仕事に戻るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワーグナー"
				}
			]
		}
	]
