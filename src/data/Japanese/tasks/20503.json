			"dialogs": [
				{
					"id": 205030201,
					"content": "なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030202,
					"content": "武器を見たい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "そこにある、自分で選ぶといい。ほしいものがなかったら、オーダーメイドもできるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030207,
					"content": "オーダーメイドできるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205030208,
					"content": "当然だ。販売、オーダーメイド、精錬、すべてこの鉄工房の仕事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030209,
					"content": "お前に鉱石があればな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030210,
					"content": "どこで鉱石が手に入る？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "どこにでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030214,
					"content": "じゃあこうしよう、この付近で鉄が見つかりやすい場所を教えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030215,
					"content": "鉄を持って来れば、製造してやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030216,
					"content": "分かった、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "礼はいらない。仕事に戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030212,
					"content": "ここで買える？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "他のやつを探せ。こっちは足りないくらいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "ワーグナー"
				},
				{
					"id": 205030204,
					"content": "パイモンの武器を見てみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "おい、なんだそれ！オイラを先陣に立たせるつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205030206,
					"content": "こんなに小さいし、オーダーメイドしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "ワーグナー"
				}
			]
		},
