			"trigger": {
				"objectNames": [
					"アンネット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736800101,
					"content": "こんにちは。風が帰るブリーズブリュー祭へのご参加、ありがとうございます。バルバトス様の祝福があらんことを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800102
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800102,
					"content": "#あれ？{NICKNAME}、見ろよ。ここに新しい告知板があるぞ。しかも、貼り紙がいっぱい貼られてる。まさか依頼とかかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736800103,
					"content": "ふふっ、依頼ではありません。これらはすべて「豊穣の箱」を探すヒントです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800104
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800104,
					"content": "ん？「豊穣の箱」ってなんだ？宝物かなにかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736800105,
					"content": "えっと、その理解でも間違いではないのですが…あなたたちは初めてブリーズブリュー祭に参加されたみたいですね。もし興味がおありでしたら、説明いたしましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800106,
						736800107
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800106,
					"content": "パイモンがすごく興味津々だから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				},
				{
					"id": 736800108,
					"content": "はい、簡単にご説明すると、「豊穣の箱」はモンドの住民が用意したプレゼントで、ブリーズブリュー祭期間中に見知らぬ幸運な人へ贈られるものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800109
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800109,
					"content": "ブリーズブリュー祭は、バルバトス様の帰郷を迎えるためだけの祝祭ではありません。みんなが一緒に豊作の喜びを分かち合い、美しい思い出を振り返る日でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800110
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800110,
					"content": "皆さんはプレゼントを樽型の木箱に入れ、自分にとって思い出深い場所に隠します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800111
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800111,
					"content": "それから、プレゼントの贈り主はヒントを残すんです。どなたであっても、最初に箱を見つけた人がプレゼントをもらえます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800112
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800112,
					"content": "またプレゼントだけでなく、見つけた人へのメッセージが箱に添えられていることもあります。その真摯な祝福は、プレゼントそのものよりも価値があるかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800113
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800113,
					"content": "なんだか面白そうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736800114,
					"content": "いかがでしょう？お二人も「豊穣の箱」を探してみませんか？モンドの地理についてある程度の理解があれば、ヒントを解読するのも簡単なはずですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800115
					],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800115,
					"content": "#{NICKNAME}、やってみようぜ！もしかしたら、知り合いの残したプレゼントを見つけることができるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736800116,
					"content": "お二人に幸があらんことを。ブリーズブリュー祭を楽しんでくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンネット"
				},
				{
					"id": 736800107,
					"content": "うん、お願い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				}
			]
		}
	]
}