			"trigger": {
				"objectNames": [
					"スホヴィーグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "なぁ！ちょっと聞きたいことがあるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760010102,
					"content": "二人のライトキーパーに先ほど手に入れた物を見せ、ライトキーパーの服を着た謎の人物と共に戦い、ワイルドハントを撃退したことを語った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "まさか、シグルドさん…？彼は…今も安らかに眠れていないんですね。僕がもっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "ルシーネ"
				},
				{
					"id": 760010104,
					"content": "そんな風に言うな。君一人の責任じゃない。ワイルドハントが消えない限り、あの人は戦い続けた…私たちにできることは、自分たちの使命を全うすることだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "スホヴィーグ"
				},
				{
					"id": 760010105,
					"content": "ってことは、シグルドもライトキーパーだったんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760010106,
					"content": "ああ、あの人は素晴らしいマスター・ライトキーパーだった…ワイルドハントの軍勢がナド・クライを襲った時も、最後の瞬間まで勇敢に戦い抜いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "スホヴィーグ"
				},
				{
					"id": 760010107,
					"content": "警鈴が鳴り響くと、心を持たない魔物たちでさえ恐れをなしたかのように、前に進むことをためらっていたそうだ…まさかそんな人の形見の品を、君たちが見つけてくれるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "スホヴィーグ"
				},
				{
					"id": 760010108,
					"content": "よかったら、その形見をレンポ島の東部にある戦場跡まで…あの人の墓前まで持って行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "スホヴィーグ"
				},
				{
					"id": 760010109,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "ありがとう。彼の魂が安らかに眠れる日が、早く訪れますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スホヴィーグ"
				}
			]
		},
