			"dialogs": [
				{
					"id": 230060301,
					"content": "旅人さん、何か聞きたいことはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060302,
					"content": "ザカリヤ先生について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "ザカリヤ先生はとても素晴らしい医師で、とても敬虔な草神の信徒でもあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060304,
					"content": "先生はいつも不眠不休で患者さんを治療されているので、食事をとる暇すらありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060305,
					"content": "ザカリヤ先生は、草神様の恩恵を多くの人に行き渡らせることが自分の使命だとも仰っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060306,
					"content": "「治療」は、本当に草神の加護の賜物なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "正確に言えば、「病気が治る」という結果に至ることが、草神様の恩恵なのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060308,
					"content": "草神様は私たちを守り、病気の治療法を発見させ、病気を治す薬草を育む…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060309,
					"content": "草神様の恩恵に感謝します。どうか人々を病から遠ざけたまえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴルシャン"
				}
			]
		},
