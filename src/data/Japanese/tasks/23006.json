						230060403
					]
				},
				{
					"id": 230060403,
					"content": "ありがとうございます、旅人さん。ぜひ報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060404,
					"content": "そういえば最近、ガルゲンさんはまた無理をして働いています。もっとしっかり忠告しないとダメかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060405,
					"content": "まだ手のかかる仕事がたくさん残っていまして、次の掃除もお願いするかもしれません。",
					"roleType": "TALK_ROLE_NPC",
