			"trigger": {
				"objectNames": [
					"ゴルシャン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "ああ、どうすれば人手が見つかるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "あっ！こ、こんにちは旅人さん。もしや…治療が必要ですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060104,
					"content": "ただの通りすがりだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "はは…やはり分かってしまいますか？ですが、確かに困っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060107,
					"content": "最近、なぜか私たちの「ビマリスタン」に治療を受けに来る人が増えて、全員総出で患者を世話しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060108,
					"content": "なのにザカリヤ先生は、それでも私に病院の周りの掃除を続けるように言うんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060109,
					"content": "先生は、多くの人がより良く草神様のご加護を受けるためには、病人の心身と病院の周りを清潔に保つ必要があると言います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060110,
					"content": "でも、今は人手不足ですよ？…とはいえ、さすがに軽症の患者さんたちに助けを求めることはできませんし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060111,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "手伝ってくれるんですか？ありがとうございます！報酬はちゃんと用意します。あまり、多くはありませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060123,
					"content": "おお草神様、人々を病から遠ざけたまえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060113,
					"content": "他に人は雇えないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "場所が場所だけに、進んで来てくれる人はあまりいません。もっとも資金も限られているので、多くを雇うことはできませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060115,
					"content": "普段は交代で当番をするんですが、こう忙しくては誰も暇がありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060116,
					"content": "旅人さん…もしよろしければ、手伝ってもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060117,
					"content": "報酬もご用意します！あまり、多くはありませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060118,
					"content": "ここの人たちの病気って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "ここの患者さんたちの病気は、実際はちょっとした頭痛程度の軽症なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060120,
					"content": "ザカリヤ先生も、この病気は危険ではないと何度も訴えたのですが、誰も聞いてくれませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060121,
					"content": "人々が恐れているのは病気そのものではなく、病気になること、なんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060122,
					"content": "では、掃除の方はお願いしますね、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "ゴルシャン"
				},
				{
					"id": 230060105,
					"content": "困ってる様子だったから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
