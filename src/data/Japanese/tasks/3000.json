			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハイパシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "スメールに到着したからには、目指すはスメールシティだな！なんとかして「クラクサナリデビ」に会う方法を探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000102,
					"content": "#そういえば、「クラクサナリデビ」についてあまり有用な話は聞けなかったけど、おまえから{M#妹さん}{F#お兄さん}を奪った神だとは思えないんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000103,
					"content": "でもスメールは「知恵の国」って呼ばれてるくらいだし、その知恵の神に会えたら、きっと価値のある情報が手に入るよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000104,
					"content": "#{M#俺}{F#私}もそう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "よし、じゃあまずはスメールシティへはどっちに行けばいいか確認しないと。ほら、七天神像のある、あの大きな岩に登ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000106,
					"content": "スメールシティは見えなかったとしても、近くに村があるかどうかくらいはわかるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000107,
					"content": "あっ、ちょっと待った！あそこ、通行人がいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000108,
					"content": "へへ、道を探す手間が省けたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000109,
					"content": "こんにちは——オイラたち、外国から来た旅人なんだ。道を聞きたいんだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000110,
					"content": "あれ？聞こえなかったか…？おーい——そこの人！悪いけど、道を聞いてもいいか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30000112,
					"content": "どういうことだ？オイラたちが呼んでるのは絶対聞こえたはずだよな。なんでこっちを向いてくれないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000113,
					"content": "怒らないで、こういうこともあるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "ふん！…まあ、そっけない態度だったけど、遠くからあいつに着いていけば、人のいるところに辿り着けるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000116,
					"content": "そしたら、また他の人に聞こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000114,
					"content": "もしかして、何か理由があるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハイパシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "あれ？あそこの小さな滝のところで姿が消えたぞ、早く行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000302,
					"content": "うぅ、この洞窟は村に繋がる入り口かなにかなんじゃないかと思ったけど、違ったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000303,
					"content": "見ろ、あそこに座ったぞ。まさか、ここに住んでたりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000304,
					"content": "どうする？もう一回あいつに聞いてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000305,
					"content": "頑張って交流を図ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "はぁ…そうだな、せっかく出会った通行人だしな。たとえオイラたちを歓迎してなくても、なんとか話してみて、方向だけでも示してもらえたらいいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000309,
					"content": "くんくん…あれ、なんかスッキリする匂いだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000310,
					"content": "あの香炉から出てるやつだな。質素な住まいだけど、こんな香りの中で瞑想できるのって、悪くない暮らしかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000311,
					"content": "——！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "おまえ、どうしたんだ？急に顔色が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000313,
					"content": "この香り…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "えっ？香りでそんなに気分が悪くなったのか？でも、オイラは全然平気だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000316,
					"content": "（ここから離れないと…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "（ダメだ、意識が…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#おい、{NICKNAME}、どうしたんだよ！？しっかりしろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30000314,
					"content": "何だか変だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "やっぱり邪魔しないでおこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "うーん、あいつのアレ…「瞑想」ってやつなのか？もしまた邪魔しちゃったら、さっきみたいにただ睨むだけじゃ済まないかもしれないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コレイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "…本当に大丈夫なのか？でも、こんなに時間が経ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001002,
					"content": "焦らないでくれ…師匠は物知りだから。師匠が大丈夫と言ったら、きっと大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001003,
					"content": "あっ、起きたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001004,
					"content": "#{NICKNAME}、よかったぁ、やっと目を覚ましてくれたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001005,
					"content": "ここはどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "ここは…うぅ、その…おまえが気を失ったんで、動転しすぎて、ここがどこなのか聞き忘れてたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001007,
					"content": "ここは「ガンダルヴァー村」。最初はスメールの学者の一時的な休憩所だったんだけど、今は主に森を守るレンジャーが使ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001008,
					"content": "こんにちは、えっと…あたしはコレイ、見習いレンジャーなんだ。今日師匠と見回りをしたとき、気を失ったお前を見つけてここに連れてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001009,
					"content": "助けてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "いやいや、あたしは何もしてないよ。ところで、具合は大丈夫か？どこか痛いところとかないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001011,
					"content": "特にないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "ははっ…それは師匠が調合してくれた薬草スープだ。お前が気絶してる間に、ちょっとだけ口の中に入れさせてもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001014,
					"content": "あっ、そうだ。お前の目が覚めたら、もう一回飲んでもらわないとダメだって師匠が言ってた。すぐ取ってくるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001015,
					"content": "わっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001016,
					"content": "コレイ、どうした？薬草をとりに来たの？言っただろ、触れるなって…後で僕がやるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001017,
					"content": "ごめんなさい、師匠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001018,
					"content": "はぁ…『アビディアの森·食用キノコ図鑑』は告知板に貼ってあるけど、ファーボッドがまた忘れちゃうって言うなら別のところ——彼の頭にでも貼って、他の人にリマインドしてもらうしかないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001019,
					"content": "本当に。今月だけでもう二回もお腹を壊したんですよ。説教しておかなくちゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "ナスリン"
				},
				{
					"id": 30001020,
					"content": "まあ、もし彼が虹色の小人を目の前で踊らせるのが好きなんだったら、今言ったことは忘れていいよ。けど、今度またこういうことがあったらモラを出して貰おうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001021,
					"content": "どう？元気になった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001022,
					"content": "これがあたしの師匠、レンジャー長のティナリさんだよ。ガンダルヴァー村にいるレンジャー全員のリーダーでもあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001023,
					"content": "もうパイモンには君が意識を失った理由を説明したけど、君も目覚めたことだし、もう一回説明するね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001024,
					"content": "スメールの学派には、学者が森で修行しないといけない決まりのところがあってね、「パラハァム」って植物のお香を使って心を安定させて、瞑想状態に入るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001025,
					"content": "君たちは道を尋ねるために、学者のハイパシアが隠居している洞窟に近づいた。その時、洞窟の中ではそのお香が焚かれていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001026,
					"content": "そのお香は大半の人には影響がないんだけど、ごく一部の人の精神を刺激してしまう。そして君はその一部の人だった。この説明で、伝わるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001027,
					"content": "すごく分かりやすい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "そっか、よかった。次は僕の質問に答えてほしいんだけど、倒れた後は、どんな感覚だった？例えば、自我はちゃんと保っていたのかとか、何かを見たとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001029,
					"content": "暗闇で見たものを話した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001031,
					"content": "コレイ、とりあえずパトロール日誌をここに持ってこないよう、他の人に伝えてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001032,
					"content": "えっ？どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001033,
					"content": "#もうしばらく、{M#彼ら}{F#彼女たち}には僕の部屋に泊まってもらう。僕はアミルのところで何とかするよ。ほら、早く行って来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001034,
					"content": "あっ、はい。行ってくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30001035,
					"content": "ちょっと待った、どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001036,
					"content": "ああ、説明するよ。薬草スープをもう一回飲んでもらえれば治ると思ってたんだけど、しばらくはガンダルヴァー村で療養してもらって経過観察をしたほうがいいと判断したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001037,
					"content": "「経過観察」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001038,
					"content": "でも、スメールシティに行かないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "落ち着いて。君が状況を見極められる人なら、僕の説明を聞いてくれれば、事態の深刻さが分かるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001040,
					"content": "さっきの君の話によると、お香のせいで君は強烈な「幻覚」を見てしまったらしい。精神状態も良いとは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001041,
					"content": "それでも深刻と思えないなら、これを嗅いでみてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001042,
					"content": "うぅ——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "おい、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001044,
					"content": "倒れた時の感覚と似てるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001045,
					"content": "今はちゃんと意識があるかもしれないけど、ここで君を放っておいたら、また突然どこかで意識不明になるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001046,
					"content": "それに、ここには多くの猛獣が潜んでるし、危険なエリアだってある。今回みたいな幸運が続くとは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001047,
					"content": "しばらくは、毎日時間通りに薬を飲んで。この匂いを嗅いで不快感を覚えなくなるまで、できるだけ単独行動しちゃだめだから。いいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001048,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "もうちょっと休んでおきなよ、薬草スープを作り直してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30001050,
					"content": "はぁ、なんてこった…スメールについたばっかりで、おまえがこんなことになっちゃうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001051,
					"content": "#{NICKNAME}、早くクラクサナリデビに会いたいって気持ちはオイラにもわかるけど、今のおまえは確かにまずいぜ。まずは元気になってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001052,
					"content": "おい、オイラの話を聞いてるのか？オイラ、心配してるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001053,
					"content": "少し変だと思って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "変？おまえの体のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001055,
					"content": "体も変だけど、それより…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "ああ、おまえが見てた樹の根と赤い空のことか？でも、あれが幻覚じゃなかったら、なんだって言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001058,
					"content": "分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "（あの時、奥深い地の底に立っているような感じだった。あの赤い空は、もしかして…「カーンルイア」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "うーん…おまえの体質は特殊だからな。その判断を信じるぜ。でもだったらさっき、なんでそのことをティナリに言わなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001061,
					"content": "今、あいつはおまえの病状を勘違いしてるってことだけど、おまえの体がどんどん悪くなったりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001062,
					"content": "彼の判断は間違ってないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "えっ、じゃあ…ティナリはおまえが見たやつが幻覚じゃないってわかってて、わざとオイラたちをごまかそうとしてたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001065,
					"content": "そう。だから、真相を突き止めたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "なるほど、だからさっきは黙ってたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001067,
					"content": "だったらここで静かに休んで体を回復しながら、おまえが見たものの真相を解明しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001068,
					"content": "でも、直接ティナリに聞くのはダメっぽいよな…おまえ、なにか案があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001069,
					"content": "コレイと話してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "おお、コレイはオイラたちに親切だし、いいかもな。明日はまず、草神やスメールの風土と気質について聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30001071,
					"content": "部屋で一晩休んだ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "ただ、本当のことを言ってないだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "あれは「幻覚」なんかじゃなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001012,
					"content": "口の中が…苦い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				}
			]
		}
	]
}