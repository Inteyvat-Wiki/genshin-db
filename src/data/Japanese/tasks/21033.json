				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "この剣柄…状態はそこそこ完全ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330404,
					"content": "「蔵鋒」と関係がある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "それはよく見てみないと分からないけど…あ、言い忘れてたけど、以前から武器の欠片は集めていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330406,
					"content": "市場や野外、そして冒険者から欠片をたくさん集めたわ。このやり方なら、「蔵鋒」に関する手がかりが見つかるかもって思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330407,
					"content": "…今になっても、それに関する手がかりは一切ないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330408,
					"content": "大丈夫、璃月では「志さえあれば、必ず成功する」ということわざがあるの。私は探し続けるわ…「蔵鋒」を見つけるまでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330409,
					"content": "あ…そうそう、報酬を受け取って。お疲れ様、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		}
