			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "この方法は…行けるのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330102,
					"content": "まだあの剣を探しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "旅人？あなただったの…そうよ、あの「蔵鋒」を探しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330104,
					"content": "でも、役に立つような手がかりは今でも見つかっていないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330105,
					"content": "でも、それも仕方ないわね。そもそも、璃月全土で一本の剣を探すなんて…難題が過ぎるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330106,
					"content": "剣はとっくに魔物に壊されてしまったかもしれない、という人もいるけど…たとえそれが壊されていたとしても、私は全ての欠片を見つけるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330107,
					"content": "ごめんね、私ばかりしゃべっちゃって。今回の依頼の場所はマップに記しておいたわ。それではお願いね、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210330108,
					"content": "剣が…壊されていないといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		},
