					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "完璧だ！さすが俺にとっての永遠のスーパースター！完璧な手本だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540302,
					"content": "ス…スーパー？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "スター、つまり「映影」で一番重要な役者のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540306,
					"content": "兵士さん、旅人の手本をよく見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540307,
					"content": "大体分かった。剣を振る時、その「動作」を強調するのでなく、「構え」を強調するのだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540308,
					"content": "「構え」であれば…多少思うところがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540309,
					"content": "ほう？それはよかった、他の兵士たちに教えてから、後でもう一回やろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540310,
					"content": "旅人、本当にありがとう、お礼にこれを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540311,
					"content": "次の「映影」の題材は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "次の「映影」の題材か…うーん…実は俺も迷ってるんだ、試したい題材がたくさんあるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540313,
					"content": "鳴神大社にある様々な伝統とか、稲妻に伝わってる狸と狐の伝説とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540314,
					"content": "稲妻の島々にはこんなにもたくさんの題材があるから、作れる物語もいっぱいある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540315,
					"content": "でもひとまず、この『七人目の武士』を完成しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540316,
					"content": "上の方が満足してくれれば、稲妻での「映影」製作を順調に進められることだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540304,
					"content": "今度は別の役も演じたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "問題ない！この「映影」の製作が終わったら、次の新たな「映影」の準備がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
