					"nextDialogs": [
						721540805
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540805,
					"content": "でも「映影」っていうものには、まだ俺が理解していない魅力があると感じている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
