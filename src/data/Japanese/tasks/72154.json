				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"グザヴィエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "ちょっと！兵士さん、さっきのセリフだけど感情表現がちょっと違うかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540102,
					"content": "「武士とは、この地を席巻する清風の如し。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540103,
					"content": "前に話した芝居のこと、まだ覚えてるかな。解放感と世の移り変わりを経験した感じが大事なんだ！解放だ、解放。分かる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540104,
					"content": "このセリフが今回の芝居の中で一番肝心なところなんだ。しっかりと気持ちを込めて、完璧に感情を表現してほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540105,
					"content": "ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540106,
					"content": "それに剣を振る時、そんなに急がないでくれ。自分が撮られているかを確認してほしい。そうじゃないと、「映影機」で上手く撮影できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540107,
					"content": "まずはポーズをとって、そして止まる、いいかい？一回止まってから、勢いよく振り下ろす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540108,
					"content": "でも誰かと対決する時、そんな振り方ではならんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540109,
					"content": "それはそうだが、ストーリーと演出上、調整する必要もある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540110,
					"content": "しっかりと準備してから、もう一度やろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540111,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#ああ、お前か！親愛なる{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}よ、良き風が友人を呼んだようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540115,
					"content": "見ての通り、俺はこの兵士さんと「剣術映影」を撮影しているところなんだ。その名も『七人目の武士』。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540116,
					"content": "ああ、「剣術映影」は俺がこのジャンルの「映影」につけた総称だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540117,
					"content": "剣戟のシーンを記録し、観客にまるで剣の雨の中を渡り歩いているかのように感じさせる「映影」…まあ、このジャンルは大体こんな感じだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540118,
					"content": "虎之助さんヒマなの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "これも上の方に許可していただいたことだ。彼が言うには、幕府の武士たちの威厳を示すのにも役立つと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540120,
					"content": "だが、グザヴィエさんがどうやって上の方たちを説得したのかは分からないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "虎之助"
				},
				{
					"id": 721540123,
					"content": "源次郎様は本当に…非常に厳しく真面目な方だが、思いやりもあるお方だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540124,
					"content": "彼に丁寧に説明した後、俺の要求を快く受け入れてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540125,
					"content": "でも…その代わり、俺はまず幕府に関する「映影」を製作することになった、武士を主人公にした作品がいいとのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540126,
					"content": "その題材には元々興味があったから、俺は受け入れたよ。あの源次郎様もとても喜んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540127,
					"content": "そして兵士さんをこの件に任命し、腕のいい兵士を何人かを割り当ててくれた。で、彼はこう言ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540128,
					"content": "「剣戟の場面は、武士と幕府の威厳を示すようにするのだ」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540129,
					"content": "しかし、源次郎様は本当に長い目で見ている、宣伝のために「映影」を製作することを思いつくなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540130,
					"content": "無論、俺は「映影」の製作のためなら何でも受け入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540131,
					"content": "製作は上手くいっているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "正直…あまり上手くいっていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540133,
					"content": "ここの兵士たち腕はいいが、「その腕前を演じる」ような戦いには慣れていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540134,
					"content": "剣を振るスピードも「映影機」では撮れないほど速いし、演じているうちに画面の外へと走ってしまうことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540140,
					"content": "旅人、時間があったら「映影機」の前で俺の書いた台本通りに演じて、兵士たちに見せてもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540141,
					"content": "お前の実力と理解力なら、「映影機」の前でも落ち着いて振る舞えると信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540142,
					"content": "一歩引いた立ち位置からこの芝居を観れば、彼らもこのストーリーをきっと理解できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540143,
					"content": "早く早く、まずは台本を読んでくれ。セリフはちょっと見るだけで問題ない、このシーンは主に戦闘シーンだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540144,
					"content": "「この戦いには、負けた。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "あっ、これは他のシーンのセリフだ…このシーンは主に戦闘だけで、セリフはほとんどない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540148,
					"content": "台本を見せて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "そうそう、お前が演じる役は「十三郎」だ。彼とその仲間たちは、村を守るためある村の住民に雇われた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540150,
					"content": "えっと…このシーンには「久蔵」という仲間にセリフがあるな…じゃあ、俺がそのセリフを言う、まずは一度ストーリーの流れを追おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540151,
					"content": "このキャラクターに感情移入し、彼のことを理解するんだ！自分のことを「十三郎」だと思ってくれ、いいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540152,
					"content": "わ、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "いいぞ、非常にいい、素晴らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540155,
					"content": "準備ができたら言ってくれ、俺は「映影機」の位置を調整してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540153,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は十三郎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "「苦難が立ちはだかろうとも、武士は武士だ。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "「お前たちは一人前のカカシだ…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "「…だが敵はヤマガラじゃない。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "自分も何かの役を貰っていい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "もちろん！もちろんだ！俺の心の中では、お前は永遠のスーパースターだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540137,
					"content": "あの『たたら物語』はずっと忘れられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540138,
					"content": "ここの兵士たち腕はいいが、「その腕前を演じる」ような戦いには慣れていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540139,
					"content": "剣を振るスピードも「映影機」では撮れないほど速いし、演じているうちに画面の外へと走ってしまうことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540121,
					"content": "どうやって説得したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "兵士さんはとっくに理解してくれていた。だから俺の主な仕事は、あの御輿源次郎様を説得して、稲妻で「映影」の製作許可をもらうこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721540112,
					"content": "「武士とは、この地を席巻する清風の如し。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "今度は感情を込めすぎてる、それでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
