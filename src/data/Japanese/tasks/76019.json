			"dialogs": [
				{
					"id": 760190301,
					"content": "…殺すなり何なり、好きにすればいいさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190302,
					"content": "#うわぁ、オイラと{NICKNAME}はそんな怖いことしないぞ！その代わり、もう二度と人を騙しちゃダメだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190303,
					"content": "ヴィエリみたいなバカでも…んっ？あいつ、いつの間に逃げたんだ？と、とにかく、ああいうバカだって騙すのはダメなんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190304,
					"content": "君たちはお人よしだね。私もスメールにいた時に君たちみたいな優しい人に出会えていたら、こんなことにはなっていなかったのかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190306,
					"content": "何があったのか、聞かないのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190307,
					"content": "これ以上は聞かないほうがいい気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "痛いとこ突いてくれるね…はぁ、最近ずっと売上がゼロなんだよ。そろそろ転職を考えるべきかもしれない。ヴォイニッチ商会に目をつけられるのも嫌だしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190310,
					"content": "もっと早くそう思ってくれたら、さっきも無駄に殴られなくて済んだのにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190311,
					"content": "人間、一世一代の決断をするには、何かしらのきっかけが必要だってことだね。良くも悪くも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190312,
					"content": "#{M#坊や}{F#お嬢さん}、それに空飛ぶおチビさん。もしそのきっかけが必要になったら、いつでも私のところへ来な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190313,
					"content": "え、遠慮しとくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190314,
					"content": "ヒディンバは赤い絹を残し、手を振って去っていった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 760190308,
					"content": "200万モラくれるなら聞くけど。",
