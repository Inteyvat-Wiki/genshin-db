			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "「識者の証」？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190102,
					"content": "な、なんだよお前ら。今、秘密の話をしてるとこなんだ。レッド・ミラーの「偉大なる財宝」の手がかりについてのな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190103,
					"content": "#いいね、{M#俺}{F#私}も混ぜてよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "うーん…それならチームを組まないか？オレも資金が足りなくて困ってたところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190106,
					"content": "オレ、お前、それに飛べるの、合わせて三人か。一人50万モラずつあればちょうどいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190107,
					"content": "50万モラ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190108,
					"content": "はぁ、ヴィエリ君…これは二人だけの秘密って約束しただろ？信頼してるから、話したんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190109,
					"content": "でも…150万モラなんて、オレにとっちゃ「開業資金」なんてもんじゃない額だよ。50万ならなんとか工面できるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190110,
					"content": "この二人は経験豊富な冒険者みたいだし、一緒に組めば成功率が上がるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190111,
					"content": "はぁ、ヴィエリ君のことは信頼してるよ。君が二人を見込んだっていうなら、私も付き合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190112,
					"content": "でもね、この空を飛ぶお友達は、私たちとは体型が違うから、特別なケアが必要だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190113,
					"content": "わぁ、オイラにプレゼントをくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190114,
					"content": "ああ、特別な調合薬さ。ナタの「ストロングトニック」よりも多くの人に合うように作られてる。空を飛ぶお友達ももちろん安心して使えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190115,
					"content": "お値段の方は、普通なら200万モラだけど…ヴィエリ君のお友達ってことだし、100万モラでいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190116,
					"content": "100万モラ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190117,
					"content": "サプライズだね、パイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "サプライズっていうよりショッキングだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190121,
					"content": "そうだよ、ヒディンバさん。飛べるからって役に立つなんて思ってなかったし、「ストロングトニック」はなくてもいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190122,
					"content": "ちょっと待て！それ、全然オイラの味方してないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190123,
					"content": "ふん、宝物の手がかりでもあるんじゃないかって期待してたのに、おまえら、一人は悪いやつだし一人はバカじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190124,
					"content": "#オイラと{NICKNAME}を騙そうったって、そうはいかないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190125,
					"content": "誰が悪人で、騙したって？手がかりは本物、品物も確かに本物だよ。値段の話だって、買う買わないはお互いの問題だろう？まったく、やかましいチビだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190126,
					"content": "…私はね、君のように思い上がった奴が一番嫌いなんだ。大した能力もないくせに、偉そうに他人の威を借りて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190127,
					"content": "ヒ、ヒディンバさん…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "ヴィエリ"
				},
				{
					"id": 760190128,
					"content": "ヴィエリ君も、内緒の話なんだから、もっと近づいて小声で話さないとダメだろ？それなのに大声出して…余計なやつらを呼んじまったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190129,
					"content": "ああ、イライラする。君たちには痛い目見てもらわないと、気が済まないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190130,
					"content": "くらえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヒディンバ"
				},
				{
					"id": 760190119,
					"content": "50万モラ。売ってくれないなら帰るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "なんで値切ってるんだよ！？オイラたち、そんなのいらないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760190104,
					"content": "もう聞いちゃったし、秘密の意味ないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
