			"dialogs": [
				{
					"id": 750320801,
					"content": "結構難しいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320802,
					"content": "飛行隊員が通りすがりの冒険者にあっさり負けたら、隊長に怒られるわよ、ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320803,
					"content": "落ち込まないで。この引退した竜騎士の顔を立ててくれた君には感謝してるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320804,
					"content": "君の飛行も素晴らしいわ。まだ私には及ばないけどね、ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320805,
					"content": "悔しいなら、もう一回やってみる？若いうちはどんどん挑戦すべきよ。負けたって大したことないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				}
			]
		},
