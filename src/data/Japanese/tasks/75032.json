			"dialogs": [
				{
					"id": 750320101,
					"content": "ここの景色、素晴らしいでしょ？飛行にぴったりなのよ。風に乗って空を飛ぶと、すごく気持ちいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320102,
					"content": "そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "こんにちは。飛行訓練がしたいなら、ご自由に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320105,
					"content": "この飛行台は父が造ってくれたものだけど、自由に使ってもらって構わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320106,
					"content": "ありがとう、じゃあお言葉に甘えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "遠慮しないで。飛ぶのが好きな人は、みんな仲間だと思ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320109,
					"content": "ずいぶん若く見えるけど、飛行隊の竜騎士見習いさん？それとも勇士を目指して訓練してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320110,
					"content": "通りすがりの冒険者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "へえ？飛行訓練に熱心な冒険者なんて珍しい。飛行試練のために訓練しに来たのかと思っちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320112,
					"content": "一度空を飛んだら、なかなかその感覚は忘れられないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320113,
					"content": "あの自由をずっと味わっていたいと思うのは誰だって一緒じゃないかしら。私も例外じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320114,
					"content": "かなり詳しいみたいだけど、飛行隊の人間なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750320115,
					"content": "ふふっ、昔はね。でももう引退したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320116,
					"content": "何年も飛行隊の一員として活躍してきたのよ。一般的にはまだ若いけど、飛行隊員としてはいいトシだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320117,
					"content": "体もずいぶん鈍ってきたし、そろそろ潮時かなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320118,
					"content": "同情するような目で見ないで、ふふ。悲しくはないのよ。ただ、ちょっと寂しいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320119,
					"content": "若手の竜騎士たちはまだ空に触れたばかり。だけど、私は流星だって掴んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320120,
					"content": "これからは昔のように毎日半分以上を空で過ごすことはないけど、まだ飛ぶことはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320121,
					"content": "だから、昔の日々をもう一度味わいたくて、ここに来たの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320122,
					"content": "ただ、隣で飛びながらはしゃぐ仲間たちがいなくなったのは、ちょっと寂しいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320123,
					"content": "もしよかったら、一緒に飛ばない？飛行隊にいた時、たまに遊びで、ちょっとした競争をしてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320124,
					"content": "最終得点を比べて、一番すごかった人を空に投げるのよ。で、一番低かった人はみんなにご馳走するわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320125,
					"content": "仲がいいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750320126,
					"content": "そうよ。飛行隊のメンバーはみんな強くて…お互いに仲間であり、ライバルでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320127,
					"content": "はぁ、あんな風に思いっきり笑うこともそうそうないでしょうね。腕もどんどん鈍ってきてるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320128,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320129,
					"content": "でも、体力が落ちて判断が鈍くなっても、経験は時間と一緒にずっと積み重ねてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320130,
					"content": "飛行隊は引退したけど、まだ空の舞台から下りたわけじゃないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320131,
					"content": "どう？空中でベテラン竜騎士に追いつけるか試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320132,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "若い人にこんな話をして、変な人だと思われるんじゃないかって心配してたけど、大丈夫そうで良かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320135,
					"content": "試したくなったら声をかけて。試合目標は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320136,
					"content": "竜に乗って、制限時間内に決まったコースを全力で飛ぶのよ。その間、私が得点を計算しててあげる。成績は四つのランクに分かれるけど、二番目よりも上のスコアが取れたら、君の勝ちよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320137,
					"content": "気が向いたら、いつでも声をかけて。思いっきり勝負しましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320133,
					"content": "考えさせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "ありがとう、時間があったら試すね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
