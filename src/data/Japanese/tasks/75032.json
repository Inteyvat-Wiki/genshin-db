			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マニョーヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "竜もおうちに帰る時間だし、私も空の舞台から下りるべきかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320602,
					"content": "諦めないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "独り言、聞かれちゃったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320606,
					"content": "家に帰って引退のことを家族に話そうと思ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320607,
					"content": "これから暇をもてあそぶことになるわ。何をすればいいか、まだぜんぜん分からないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320608,
					"content": "次の人生の段階に向き合うために、心の整理をつけなきゃね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320609,
					"content": "まずは家族の意見を聞いてみようと思ってね。父は元飛行隊員なんだけど、引退後はトレーナーをやってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320610,
					"content": "同じ道を歩んできた父なら、何かアドバイスをくれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320611,
					"content": "ここの飛行台は解体して持っていくけど、飛行コースは残しておくわ。君みたいな若い戦士には練習場所が必要でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320612,
					"content": "マニョーヤ、また会えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750320613,
					"content": "さあね。でも、この先どんな選択をしても、空を諦めることはできないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320614,
					"content": "君が飛ぶのを止めない限り、きっとまた会えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320615,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "またね、勇士さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320604,
					"content": "…マニョーヤ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "あら、来たのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "マニョーヤ"
				}
			]
		},
