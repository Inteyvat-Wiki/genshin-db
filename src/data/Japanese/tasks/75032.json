			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マニョーヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "ふふふ、やっぱり若者の勢いにはかなわないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320402,
					"content": "星も空から落ちる時がある。人間だってそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320403,
					"content": "時代の主役である若者にバトンタッチして、笑って引退すべきよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320405,
					"content": "でもちょっと悔しいな。私だってまだ若いのに…まだそんなにシワもないのよ。このまま引退だなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320406,
					"content": "現役の時間が短すぎたわ。頂点に立った気分を味わえないまま、もう下り坂だなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320407,
					"content": "こんなに悔しいって分かってたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320408,
					"content": "…とも言えないな。もう一度やり直せるとしても、私はきっと、また同じ道を選ぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320409,
					"content": "全力で頑張れば、私の実力なら飛行隊に入るのも難しくないはず。そしてまたこの年で引退するんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320410,
					"content": "ま、全力を尽くしたつもりだし、悔しがってもしょうがないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320411,
					"content": "…これが人生ってやつなのかもね。思い通りに行かないこともたくさんある。英雄になりたいなら、輝くのはほんの一瞬だってことを受け入れなきゃいけないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320412,
					"content": "マニョーヤ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750320413,
					"content": "#まあまあ、{NICKNAME}はよくやってくれたわ。あら、その不安そうな目は何。さっきは同情するみたいにこっちを見てたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320414,
					"content": "ふふ、生きてればいろんなことに出会うものよ。あなたが受け入れようと拒もうと、必ずね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320415,
					"content": "まあ、元竜騎士の人生経験伝授ってことで。私の問題はちゃんと自分で解決するから、君まで暗くならないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320416,
					"content": "君は優秀だよ。弟たちも君みたいに冷静沈着でいられたらよかったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320417,
					"content": "弟さんがいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750320418,
					"content": "ええ、二人ともヘンな子たちよ。君たちみたいに素直に話を聞いてくれもしないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320419,
					"content": "弟たちも飛行訓練をしてるの。いや、アコミトは逃げることばかり考えてるから、今はどっかに隠れてるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320420,
					"content": "どうしようもない弟たちのことは置いといて…君には才能があると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320421,
					"content": "時間があるなら、もっと練習してみたら？もしかしたら、飛行隊から入隊の打診があるかもしれないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320422,
					"content": "そうしてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "よかった。また君の飛ぶ姿が見られるなんて、嬉しいわ。頑張ってね、若き勇士さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
