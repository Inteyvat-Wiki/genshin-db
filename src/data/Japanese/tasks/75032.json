			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "どう？試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320202,
					"content": "竜に乗って、制限時間内に決まったコースを全力で飛びながら、できるだけ点を稼ぐの。<color=#00E1FFFF>二番目以上のランクに行けたら、あなたの勝ちよ。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320203,
					"content": "準備オッケー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "よし！じゃ、スタート地点に行きましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				},
				{
					"id": 750320205,
					"content": "もう少し準備させて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "ええ、気が向いたら声をかけて。飛行は楽しむのが一番よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニョーヤ"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
