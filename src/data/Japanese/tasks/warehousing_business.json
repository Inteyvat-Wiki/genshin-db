			"dialogs": [
				{
					"id": 230400701,
					"content": "旅人さん、貨物を持ってきてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400702,
					"content": "持ってきたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "よかった、貨物はそこに置いてちょうだい。手伝ってくれてありがとうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400704,
					"content": "ハバチさんは他の貨物を点検しに倉庫に入ってしまったから、この食料はひとまず私が見ていることにするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400705,
					"content": "はぁ、食料の損失が少ないといいんだけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				}
			]
		},
		{
