			"trigger": {
				"objectNames": [
					"ナジャート"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "どう、あの赤鷲たちを追い払ってくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400402,
					"content": "みんな追い払ったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "本当にありがとう。これでハバチさんもようやくまともに食事ができるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400405,
					"content": "そうそう、これはお礼だから受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400406,
					"content": "えーと、今日はどんな貨物が入ってくるんだったかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400403,
					"content": "しばらくは大人しくなると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
