			},
			"dialogs": [
				{
					"id": 230401002,
					"content": "…フゥー…ありがとう、旅人。あんたが手伝ってくれていなければ、この貨物は守れなかっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401003,
					"content": "あなたもいい腕をしてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "ははっ、褒めてくれてありがとう。だが俺一人でこれだけの宝盗団を相手にするのは、少々骨が折れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401007,
					"content": "やれやれ、俺の武術もまだまだだな。キャンディスさんが来ていれば、宝盗団はとっくに地面に突っ伏していたはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401008,
					"content": "ああ——すまない、今はそんなことを言っている場合じゃないな。まずはこの貨物を村に送り返さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401009,
					"content": "ここはあまり安全とはいえないから、あんたも早く帰ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401010,
					"content": "しかし、この宝盗団はどうしてこうも情報に通じていたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハバチ"
				},
				{
					"id": 230401005,
					"content": "一人で来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "他の守衛と一緒に村を出たんだが、彼らは別の場所に貨物を探しに行ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "ハバチ"
				}
			]
		}
