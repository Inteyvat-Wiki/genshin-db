			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナジャート"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "はあ…この赤鷲どもめ！ほんとにキリがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400202,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "あなたは…旅人さんね？エベードから話は聞いてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400204,
					"content": "ウフフ、私たちの村を訪ねてくる旅人がいるなんて思いもよらなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400205,
					"content": "あらまあ、ハバチさんに会ったのね？あの人いつも厳しいから…きつい言い方をするかもしれないけど、わかってあげてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400206,
					"content": "なにしろ…この村の物資はほとんどこの倉庫にしまってあるのよ。食糧だけじゃなく、衣類や武器、財貨まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400207,
					"content": "村の若者には、村を守るほかにもいろんな仕事があって…ハバチさんだけがずっと一人で倉庫を守ってくれているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400208,
					"content": "私は記帳と点検くらいしか、役に立てないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400209,
					"content": "さっき言ってた赤鷲って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "はぁ…それがね、この前干し肉を倉庫に運びこんだんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400211,
					"content": "どこから匂いが漏れたんだか、次々に赤鷲が飛んできて、倉庫のそばの山から離れなくなっちゃったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400212,
					"content": "それで、倉庫内の干し肉はつつけやしないけど、食事をしている人がいると突然群れで襲いかかってくるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400213,
					"content": "追っ払ってもらおうにも、村の守衛にそんな暇はないし、ハバチさんも手が離せないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400214,
					"content": "旅人さん、もし暇があるようなら、あの赤鷲たちを追い払ってくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400215,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "ありがとう、頼むわね。あの赤鷲たちは獰猛だから近づかないほうがいいわ…弓矢を使えば、安全に追い払えるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400217,
					"content": "禿鷲は何を襲ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "運ばれてきた貨物とか、干し肉とか。それからハバチさんのお弁当もね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400219,
					"content": "見張り中のハバチさんが食事をするとき、少しばかりお弁当を置いたタイミングを狙って、赤鷲たちが飛んでくるの。そうして肉を全部くわえて行くのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400220,
					"content": "見張りの仕事があるから、ハバチさんは赤鷲を懲らしめに行くわけにもいかないでしょう。飛び去るのを黙って見送って、急いで残りのお弁当を平らげるしかないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400221,
					"content": "頼むわね、旅人さん。早くあの赤鷲たちを追い払ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				}
			]
		},
		{
