			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナジャート"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "はあ、ハバチさんはいつになったらひと休みできるのかしらね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400502,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "旅人さんじゃない、いいところに来てくれたわね。一つ手伝ってもらいたいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400504,
					"content": "さっき乾物が村に届いて、ハバチさんが倉庫にしまう準備をしに行ったんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400505,
					"content": "赤鷲が食べ物の匂いを嗅ぎつけて、突然群れになって襲ってきちゃったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400506,
					"content": "守衛たちがすぐに駆け寄って赤鷲を追い払ったけど、乾物はついばまれてあちこち散らかってしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400507,
					"content": "他の人たちは他の輸送隊に警告しに行っちゃったから、ハバチさんは無事だった食べ物を回収するのに忙しくて…助けてあげてもらえないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400508,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "ありがとう、頼むわ。申し訳ないけど、私はこれから貨物の受け取りを手伝いにいかないと。本当に忙しくて手が回らないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400510,
					"content": "ハバチさんは大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "それが、ひと休みしてといっても聞かないの。食べ物を集め終えたら、もう一度倉庫を点検しないと、とか言って。このままじゃ体が持たないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400512,
					"content": "貨物は白のリフトの近くにあるはずよ。回収してきてくれないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				}
			]
		},
