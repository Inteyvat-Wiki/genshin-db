				"objectNames": [
					"ナジャート"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "旅人さん！いいところに。今すぐハバチさんの手助けに行ってくれないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400802,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "はぁ…村の外で貨物の輸送が宝盗団に阻まれてしまって、出動できる守衛はみんな応援に向かったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400805,
					"content": "それでもハバチさんは人手が足りないと言って、自分も武器を持って村を出ていったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400806,
					"content": "でもその宝盗団は大勢いるらしくて、ハバチさん一人加わっただけじゃ対応できないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400807,
					"content": "旅人さん、地図に彼の行き先を記すから、急いで助けに行ってあげて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400808,
					"content": "すぐ出発する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "頼むわね、旅人さん。ハバチさんに何事もなければいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400810,
					"content": "彼の武術の腕前は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "宝盗団の一組や二組なんて、ハバチさんにとっては何でもないはずだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400812,
					"content": "でも今回は宝盗団が組織的に輸送隊を待ち伏せしていたらしいわ。輸送隊のメンバーが急いで村に知らせに戻らなかったら、誰も襲撃を知らなかったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400813,
					"content": "はぁ…キャンディスさんがいれば、宝盗団もこんな大胆なマネはしなかったろうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400814,
					"content": "きっと隙を見計らって、不意討ちを狙ったに違いないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400815,
					"content": "旅人さん、頼んだわよ。急いでハバチさんを助けに行ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナジャート"
				},
				{
					"id": 230400803,
					"content": "そんなに慌ててどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
