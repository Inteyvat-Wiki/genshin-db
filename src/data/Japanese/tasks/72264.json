			},
			"dialogs": [
				{
					"id": 722640101,
					"content": "うう…せっかくこの前、山頂に「柱」を立てたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640102,
					"content": "そ、それにしても…いつ来てもドラゴンスパインは寒いな…歯の根が合わないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640103,
					"content": "ぬはは、白髪、弱い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640104
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640104,
					"content": "ええっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640105,
					"content": "吉法師は寒くないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640106
					]
				},
				{
					"id": 722640106,
					"content": "ぬうう、寒い寒い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640107
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640107,
					"content": "寒いのかよ！ムカつくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640108,
					"content": "でも、面白い。全部が白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640109
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640109,
					"content": "白い…ああ、これは「雪」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640110,
					"content": "「雪」…「櫻吹雪」の雪？神櫻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640111,
					"content": "違う違う。雪って言うのはな、ドラゴンスパインを覆う、冷たくて白いものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640112,
					"content": "でもまさか吉法師が「櫻吹雪」を知ってるなんてな。さすが稲妻の妖狸って言うべきなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640113,
					"content": "ぬ！雪！寒い寒い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640114,
					"content": "吉法師、楽しそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640115
					]
				},
				{
					"id": 722640115,
					"content": "山に雪があるから寒い？それとも、山は寒いから雪があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640116
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640117,
					"content": "#ううん、またすごい質問だな。{NICKNAME}、おまえはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640118,
						722640121,
						722640124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640118,
					"content": "雪は水元素だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640119
					]
				},
				{
					"id": 722640119,
					"content": "うーん…だとすると、ここは寒いから水元素が凍って、雪になったってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640120,
					"content": "寒い寒い。雪がたくさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640128,
					"content": "こういうのは、リサさんみたいな博識な人に聞いた方がいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640129,
					"content": "ドラゴンスパインは本当に寒いな。この前山頂を目指した時は、あまりの寒さに意識を失いかけたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640130,
					"content": "でも、眺めは最高だ！影向山からここが見えるってことは、ここの山頂からもきっと影向山が見えるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640131,
					"content": "それに星蛍の洞窟はすっごく深いから、まだ発掘されてないお宝があるかもしれないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640132,
					"content": "お宝！お宝サイコー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640133,
					"content": "吉法師とパイモンはとても気が合うと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640134
					]
				},
				{
					"id": 722640134,
					"content": "へへっ、お宝が無いといい暮らしはできないし、美味しいものも食べられないからな。吉法師はよく分かってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640135,
					"content": "吉法師、雪の中で遊びたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640136
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640136,
					"content": "いいけど、風邪ひくなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640137,
					"content": "もし危ないことがあったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640138
					]
				},
				{
					"id": 722640138,
					"content": "大きい声で「お宝だ」って叫んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640139
					]
				},
				{
					"id": 722640139,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640121,
					"content": "雪は氷元素だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640122
					]
				},
				{
					"id": 722640122,
					"content": "え？ってことは、雪が氷元素だから、ここは寒くなったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640123,
					"content": "寒い寒い。雪がたくさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640124,
					"content": "ガイアの仕業かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640125
					]
				},
				{
					"id": 722640125,
					"content": "「風邪ひくなよ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640126,
					"content": "って違うだろ！ガイアがそれほどすごいとは思えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722640127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				}
			]
		},
