			},
			"dialogs": [
				{
					"id": 230091701,
					"content": "ありがとう、これで材料もしばらくは足りるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091702,
					"content": "ちょっと待ってくれ。すぐにセメン土を調合するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091703,
					"content": "アキムは泥土の調合を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "よし、できた。旅人さん、この泥土をニマに届けてもらえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091705,
					"content": "あいつはこれはずっと待ってたんだ。きっと急いでいるに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091706,
					"content": "しかし、あの子は…うん…とんでもない想像力を持っているな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091707,
					"content": "ニマはこれで「泥んこ戦士」とやらを作るんだとさ。その戦士ってのは人と話ができる泥の壺で、転がって敵を倒したり、不思議な力を使ったりするらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091708,
					"content": "その「泥んこ戦士」の能力だが、体となる壺に入れる材料によって違ってくるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091709,
					"content": "「泥んこ戦士」に名前も付けてるとか言ってたな。確かヤ…なんとかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091710,
					"content": "はっはっは、まあ子供のたわごとだが、発想は本当に面白いよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091711,
					"content": "でも、そんな面白い発想を持ってるんだ、この泥土をおもちゃ代わりに届けてやりたいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091712,
					"content": "あいつが自分の手で「泥んこ戦士」を完成させた暁には、正式に「泥んこ将軍」に就任だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091713,
					"content": "まあ、とにかくだ。この壺の泥土をニマに届けてやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091714,
					"content": "「泥んこ戦士」が正式に焼き上がれば、俺とあんたにも「泥んこ大将」の称号が授けられるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				}
			]
		},
