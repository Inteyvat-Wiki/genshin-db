			"dialogs": [
				{
					"id": 230091401,
					"content": "これはまずい、一体どこが悪かったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091402,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "ああ！あ、あんたは…あの旅人さん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091404,
					"content": "まあ、言うまでもなく、俺の「セメン土」に問題があったのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091405,
					"content": "俺の配合に問題があったのか、実際の使用状況に考えが至らなかったのか分からんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091406,
					"content": "俺の「セメン土」で台所を作った人の多くが、しばらく経ったら泥土に割れ目ができちまったって言うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091407,
					"content": "温度が高すぎて、泥土の中のどれかの成分が失われたんだろうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091408,
					"content": "まあとにかく、まずは壊れた部分の修理をしに行かなきゃならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091409,
					"content": "ただ、修理の必要な家が多すぎて、剥がれた「セメン土」を回収する暇もないから、壺に入れて置いといてくれって言ってあるんだ。ふう…その大きな壺がもういくつもあってだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091410,
					"content": "旅人さん、悪いがこの家に行って、廃棄された「セメン土」を回収してきてくれないか？他の家には俺が行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091411,
					"content": "ああ、一体どこが問題なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				}
			]
		},
