			},
			"dialogs": [
				{
					"id": 230091101,
					"content": "旅人さん！いいところに来てくれた。誰も手伝ってくれなくて悩んでたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091102,
					"content": "研究は進んだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "ううむ…「進んだ」とは言えないな。ただ、あるお客さんが意見をくれてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091104,
					"content": "その人は花を育てていて、花に合った土が見つからないのが一番の悩みだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091114,
					"content": "通気性が良く、栄養があり、水を吸い過ぎても、水はけが良すぎてもよくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091105,
					"content": "その人は俺の「セメン土」にたくさんの改善案をくれて、花を育てるのに適した「花用セメン土」を作ってほしいと頼んできたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091106,
					"content": "俺も面白そうだと思ったから、別の材料を探して「セメン土」を改良しようと思っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091107,
					"content": "そこで今回は、肥沃な泥土を取ってくるのをお願いしたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091108,
					"content": "泥土の位置は地図に書いておくからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091109,
					"content": "なんでこんなに遠いの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "人に聞いたんだ。ちょっと遠いが、そこの泥土はとても肥沃らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091112,
					"content": "ただ…あの辺には魔物が大勢いるみたいだからな、自分で行く勇気がなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091113,
					"content": "だから、あんたにお願いするしかないんだ！旅人さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230091110,
					"content": "こんな場所、どうやって見つけたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
			]
		},
