			"dialogs": [
				{
					"id": 230090201,
					"content": "もっと材料を買ってこないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090202,
					"content": "「セメン土」の方はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "ばっちりだ！むしろ、この泥土の可能性は、俺の想像をはるかに超えていたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090204,
					"content": "壺や器やらはもちろん、建物の穴の補修にも使える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090205,
					"content": "泥土の混合比率を変えれば、そのまま家を建てるのに使っても問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090206,
					"content": "だがなあ…みんなが俺の泥土を注文しに来るもんで、材料が足りなくなっちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090207,
					"content": "肝心のスライムの液体もなくなっちまった。旅人さん、悪いがもう一度スライムの液体を3個取ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090208,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "お願いだ、旅人さん。スライムの液体を3個取ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090209,
					"content": "他の材料は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "他の材料はいろんなルートで注文したり、人に頼んだりしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "アキム"
				},
				{
					"id": 230090211,
					"content": "だが、スライムの液体の消費が予想よりも早すぎてなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "アキム"
				}
			]
		},
