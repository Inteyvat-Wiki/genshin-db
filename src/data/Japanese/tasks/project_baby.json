			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"グラブジル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230041201,
					"content": "蛇をペットとして飼ってるやつ、なんだか前にも見たぞ…そうだ！あの白朮っていう変なやつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041202,
						230041203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041202,
					"content": "長生はたぶん「ペット」じゃないと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				},
				{
					"id": 230041204,
					"content": "ペットの蛇に専用の餌があるのか？普通、蛇はネズミとかを食べるんじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041205,
					"content": "最初は、この子たちも自分で餌を探してたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041206
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041206,
					"content": "餌を食べるところを見た子供たちを驚かせてしまってな。以来、放し飼いにするのはやめて、俺が餌を作って食べさせるようにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041207
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041207,
					"content": "はぁ…だが、俺が餌を作って食べさせるようになってから、この子たちは怠けるようになってしまってな。他の食べ物もほとんど食べなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041208,
					"content": "へへっ、働かずに食べられるご飯なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041209,
					"content": "おいしいに決まってるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "味はまだわかんないだろ、しまりのない顔するなよ！…それに、おまえにそんなチャンスはないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041212,
					"content": "そんなチャンスがあるとしたら…間違いなくオイラのものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041213,
					"content": "よくそんな堂々と言えるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "このまえ薬草を採りにいった時、絶対に餌をどこかの拠点で落としたはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041215,
					"content": "しかし、俺が探すのは難しい。ここに残って、この子たちが飢えすぎて人前に出ていかないよう、見ててあげないとならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041216,
					"content": "旅人、俺の代わりに、拠点から餌を持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041217,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "本当にありがとう。この子たちを連れて探しに行ったら、何が起こるかわからないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041219,
					"content": "この子たちがその気になれば、森に隠れて何日だって平気で遊ぶだろう。そうなれば大変なのは俺だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041225,
					"content": "とにかく…この件は頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041226,
					"content": "君のマップで最近俺が行った拠点に印を付けておくから、それらの場所に行って来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041220,
					"content": "そこにほかの蛇はいないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "ないない、俺は面倒を避けるために、わざわざ蛇の生息地を避けて拠点をこしらえたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041222,
					"content": "拠点はたくさんあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "拠点は俺が雨林で生活をしていた時のもので、当時いくつか作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041224,
					"content": "今はもう雨林で生計を立てることはなくなったが…森に入って薬草を採る時、そうした拠点で休憩くらいはする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041210,
					"content": "最高においしいに決まってるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "そんな言い方したら、長生に怒られるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
