					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040604
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040604,
					"content": "そんなに動物たちの好みに合うなら、この餌を販売してみるのもいいかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040605
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040605,
					"content": "こほん！そんな事より、これらの報酬を受け取ってくれ。手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
		},
