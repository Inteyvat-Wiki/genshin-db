			"dialogs": [
				{
					"id": 230042001,
					"content": "あれ？このビーズは…どうして…これをどこで見つけたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042002,
					"content": "拠点の壺で見つけたんだぞ、おまえが落としたものなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230042003,
					"content": "以前、大道芸の時に使っていたビーズだ。笛を吹くと、この子たちがこれを頭にのせて踊るのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042004,
					"content": "しかし、この手のものは昔からあまり稼げなくてな…ずいぶん長いことやっていなかったんだ。このビーズを失くしていたことすら、まったく気付いていなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042005,
					"content": "とにかく、持ってきてくれてありがとう。この報酬を君たちにあげよう、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
