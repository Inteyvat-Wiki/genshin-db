			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "あれ？この帽子…あははっ、これは以前、俺が蛇ちゃんたちに作った帽子じゃないか。これも落としていたとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042202,
					"content": "以前、子供たちに親しんでもらえるよう、蛇ちゃんに一匹ずつナイトキャップを作ってあげたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042203,
					"content": "ジョリは赤、アムーには緑で、ガナは黄色、ドラークは青の帽子…という具合にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042204,
					"content": "聞いただけで、なんだか可愛いぞ！大道芸もうまくいったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230042205,
					"content": "はじめは悪くなかったんだが…やっぱり蛇ちゃんたちが口を開けると、子供たちは怖くて泣きだしてしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042206,
					"content": "まあいい、この話はやめよう。この報酬、心ばかりだが…受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
