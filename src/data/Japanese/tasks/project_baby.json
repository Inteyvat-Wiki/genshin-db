			},
			"dialogs": [
				{
					"id": 230041101,
					"content": "ペットの蛇に専用の餌があるのか？普通、蛇はネズミとかを食べるんじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041102,
					"content": "最初は、この子たちも自分で餌を探してたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041103,
					"content": "餌を食べるところを見た子供たちを驚かせてしまってな。以来、放し飼いにするのはやめて、俺が餌を作って食べさせるようにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041104,
					"content": "はぁ…だが、俺が餌を作って食べさせるようになってから、この子たちは怠けるようになってしまってな。他の食べ物もほとんど食べなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041105,
					"content": "へへっ、働かずに食べられるご飯なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041106,
						230041107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041106,
					"content": "おいしいに決まってるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				},
				{
					"id": 230041108,
					"content": "味はまだわかんないだろ、しまりのない顔するなよ！…それに、おまえにそんなチャンスはないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041109,
					"content": "そんなチャンスがあるとしたら…間違いなくオイラのものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230041110,
					"content": "よくそんな堂々と言えるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041111
					]
				},
				{
					"id": 230041111,
					"content": "このまえ薬草を採りにいった時、絶対に餌をどこかの拠点で落としたはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041112
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041112,
					"content": "しかし、俺が探すのは難しい。ここに残って、この子たちが飢えすぎて人前に出ていかないよう、見ててあげないとならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041113
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041113,
					"content": "旅人、俺の代わりに、拠点から餌を持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041114,
						230041117,
						230041119
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041114,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "本当にありがとう。この子たちを連れて探しに行ったら、何が起こるかわからないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041116,
					"content": "この子たちがその気になれば、森に隠れて何日だって平気で遊ぶだろう。そうなれば大変なのは俺だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041122,
					"content": "とにかく…この件は頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041123
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041123,
					"content": "君のマップで最近俺が行った拠点に印を付けておくから、それらの場所に行って来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041117,
					"content": "そこにほかの蛇はいないよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041118
					]
				},
				{
					"id": 230041118,
					"content": "ないない、俺は面倒を避けるために、わざわざ蛇の生息地を避けて拠点をこしらえたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041119,
					"content": "拠点はたくさんあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041120
					]
				},
				{
					"id": 230041120,
					"content": "拠点は俺が雨林で生活をしていた時のもので、当時いくつか作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041121
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041121,
					"content": "今はもう雨林で生計を立てることはなくなったが…森に入って薬草を採る時、そうした拠点で休憩くらいはする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230041107,
					"content": "最高においしいに決まってるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				}
			]
		},
