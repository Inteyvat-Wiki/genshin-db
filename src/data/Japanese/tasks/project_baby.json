			"dialogs": [
				{
					"id": 230040901,
					"content": "そうそう、これだ！やっぱり拠点に忘れてたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040902,
					"content": "あの拠点はどうしてツル草の中にあるんだ！寝てる時に刺されたらどうするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230040903,
					"content": "そんなことはないさ、俺は前から野外でキャンプをするのは慣れてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040904,
					"content": "それに、俺があの拠点を作った当時は、周りにそれほどツル草はなかったように思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040905,
					"content": "森から離れて長いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "ある程度はな。具体的なとこは…もうよく覚えていないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040907,
					"content": "あははっ、俺の拠点づくりの腕も、相当なまってしまっただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040908,
					"content": "かつて俺が作った拠点も、いまや荒れ放題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040909,
					"content": "もし俺が今でも雨林で暮らしていたら、一体どんな生活を送っていたんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040910,
					"content": "…すまん、一方的にしゃべってしまったな。この報酬は君にあげるよ、どうか受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
		},
