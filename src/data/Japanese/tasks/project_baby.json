			"dialogs": [
				{
					"id": 230040701,
					"content": "そうそう、これだ！やっぱり拠点に忘れてたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040702,
					"content": "石の下敷きになってたんだぞ。拠点のある場所が崩れたせいで、すごく遠いところまで散らばっちゃってたんだ。けっこう探したぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230040703,
					"content": "そ、そうなのか？どうして崩れてしまったんだろう…この前までは、割と安全だったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040704,
					"content": "あ…そういえば、俺がそこでキャンプをしていた時、夜になるといつも変な声が聞こえて、何かがテントを擦るような音が聞こえていたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040705,
					"content": "蛇ちゃんたちもかなり警戒していて、そのたび俺を起こしてくれたんだ。ただ、外を見ても何もいなかったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040706,
					"content": "まあ、こんな話はよそう。とにかく今回はありがとな、この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
		},
