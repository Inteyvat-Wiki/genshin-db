					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040802
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040802,
					"content": "拠点の状況について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "そ、そうなのか？まさか獣に侵入されていたとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040804,
					"content": "そういえば…以前、俺が作った餌がキノコンや、小鳥を引き付けてしまったことがあったな…獣を引き付けてしまうのも道理だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040805,
					"content": "ふむ…どうやら、まじめにこの餌を売り出すプランを考える必要があるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040806,
					"content": "もしこの商売がうまくいけば、俺が今やっている大道芸よりずっと儲けられるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230040807,
					"content": "っと…話が逸れてしまったな。ははっ、今回はありがとう、この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グラブジル"
				}
			]
		},
