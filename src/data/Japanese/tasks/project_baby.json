			"dialogs": [
				{
					"id": 230042401,
					"content": "おお！俺が前に作った蛇タワーじゃないか？懐かしいな、あははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042402,
					"content": "蛇タワーってなんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230042403,
					"content": "ほら、蛇ちゃんを退屈しのぎに這いまわらせておくためのおもちゃだよ。この子たちを、ずっと俺にぶら下げておくわけにもいかないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042404,
					"content": "持ってきてくれてありがとう、この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "グラブジル"
				},
				{
					"id": 230042405,
					"content": "俺、前はこんな感じでデザインしてたのか？懐かしいな…",
					"roleType": "TALK_ROLE_NPC",
