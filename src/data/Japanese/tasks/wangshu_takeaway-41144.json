						411440302
					]
				},
				{
					"id": 411440302,
					"content": "料理を届けるのを手伝いにきてくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440303,
					"content": "うん、ちょうどいい。鈴官って客が松茸の肉巻きを注文したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440304,
					"content": "少ししたら荻花洲の北西のあるところに届けてほしいようだ。金ももうもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440305,
					"content": "時間があるなら届けに行ってくれないか。報酬は弾むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
