			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151501",
							"2"
						],
						"stepId": 7151501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"和声"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150101,
					"content": "「港内北埠頭にて上演中」…うぅ、この通知、ちょっと曖昧すぎやしないか？なにが上演するのか、誰がやるのかまったくわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150102,
					"content": "上演場所を探してみるか。もし見つからなかったら、通行人に聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150103,
					"content": "あっちに人がたくさんいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150104
					]
				},
				{
					"id": 715150104,
					"content": "あっ、本当だ。あんなに大勢集まってるってことは、上演を観に来た人たちかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150105,
					"content": "聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7151502,
			"completionStepIds": [
				7151502
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151502",
							"2"
						],
						"stepId": 7151502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慶興"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150201,
					"content": "「万事順調、平安慶賀…♪」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150202
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150202,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150203
					]
				},
				{
					"id": 715150203,
					"content": "ちょっと聞きたいんだけど、今からここでなにか上演されるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150204,
					"content": "うん、もうすぐ紙映{RUBY#[S]ジーインシー}戯をやるんだ。君たちもそれを観に来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150205,
						715150206
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150205,
					"content": "『紙映戯』っていうんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150207
					]
				},
				{
					"id": 715150207,
					"content": "違うよ、紙映戯と璃月劇は別物なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150208
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150208,
					"content": "慶興、劇がもうすぐ始まるから、しゃべらないで。おじさんに迷惑がかかっちゃうでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150209
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150209,
					"content": "あ、うん。紙映戯がどんなものかは、二人も観たらわかるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150210
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150210,
					"content": "…お客さんたち、今日お見せするのは、虬髯公の物語だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150211
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150211,
					"content": "先に言っておくが、厠に行きたい人や飲み物を買いたい人がいるなら、事前に行くことをおすすめする。劇が始まったら、もう待ってはくれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150212
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150212,
					"content": "（この劇、『虬髯公』っていうのか。ぜんぜん聞いたことない物語だな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150213,
					"content": "しーっ、小声で話しても聞こえてるよ。静かに観てて。話すのは外題を選ぶときだけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150214
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150214,
					"content": "うぅ…ごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150215,
					"content": "外題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150216
					]
				},
				{
					"id": 715150216,
					"content": "虬髯公のお話はすっごく長いから、全部やると時間がかかるんだ。だからおじさんはいつも、みんなにどの章を観たいか選んでもらってるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150217
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150217,
					"content": "慶興！おじさんの劇の声が聞こえなくなるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150218
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150218,
					"content": "わかったよ、もう絶対に話さないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150219
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150219,
					"content": "みんな、今日は『全本虬髯公』のどの物語が聞きたいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150220
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150220,
					"content": "『投山』か、それとも『拝仙』？もしくは『縛鬼』か『登天』？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150221
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150221,
					"content": "外題を言ってくれさえすれば、おじさんにできない劇はないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150222
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150222,
					"content": "ぼく、虬髯公と妖魔の戦いが観たい！すっごくかっこよくて、必ず勝つやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150223
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150223,
					"content": "『拝仙』と『縛鬼』はもう何回も観ただろ、飽きないのか？ぼくは虬髯公が家に帰って妹に会う場面が観たいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150224
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150224,
					"content": "虬髯公に妹なんかいたっけ？その話は知らないし、観たことないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150225
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150225,
					"content": "どうやら、このお客さんは通のようだね。『奔郷』を選ぶ人はとても少ないんだ。通じゃないと、存在すら知らないことが多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150226
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150226,
					"content": "よし、ちょうど海灯祭だし、妖魔や鬼怪に関することはやめて、情人がいかにして眷属になったかについて話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150227
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150227,
					"content": "この場面に登場する役は三人だ。みんな知ってる虬髯公以外にも、意氷という孤独な女性が一人。そして、南風という君子が一人いる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150228
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150228,
					"content": "#{NICKNAME}、おまえ理解できたか？オイラ、なんだかこんがらがってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150229,
					"content": "今からやるのって、虬髯公って人の物語なんだよな？でも聞いた感じ、その主人公以外にも他の人がいるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150230,
					"content": "でも、オイラたちの目の前にいる役者は一人だけ…えっと、それと…屏風が一つあるな？どうやって劇をやるんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150231,
					"content": "あっ、ここに紙映戯を観たことがない人がいるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150232
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150232,
					"content": "お？そこのお客さん、この分身もできない応公が、どうやって一人で劇を演じるのか聞きたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150233
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150233,
					"content": "実はな、紙映戯は璃月劇ほどの工夫はないが、独特な特徴があるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150234
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150234,
					"content": "璃月劇はすべて現実の役者が演じるが、紙映戯の役者はすべて紙でできてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150235
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150235,
					"content": "あっちの劇台は木で作られたものだが、こっちのは木枠の上に薄い紙を敷いたもの。まあ、どれも紙でできてるから、紙映戯っていうんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150236
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150236,
					"content": "そして、語り手は俺だが、演じるのは俺じゃない。もうすぐ、その三名の紙役者を観られるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150237
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150237,
					"content": "おじさん、この人たち、たぶん虬髯公も知らないはずだよ。だから、まず虬髯公について話してよ。いつも冒頭で話すあれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150238
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150238,
					"content": "あれは前説っていうんだ。ぼくも大好きなんだ。おじさん、話してよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150239
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150239,
					"content": "前説！前説！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150240
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150240,
					"content": "その言葉を聞き、世を正そうとする志を抱くも、無力なことに天下は邪気に包まれていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150241
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150241,
					"content": "その者の名は桓光。世の不平に苦しみ、山々に姿を消した男。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150242
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150242,
					"content": "だが偶然にも、彼はある仙人の弟子となった。それから姿を変え、真っ黒な髭を生やし、虬髯公と名乗った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150243
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150243,
					"content": "仙人の命を受け、剣をもってして魑魅魍魎を打ち倒し追い払う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150244
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150244,
					"content": "虬髯公は長きにわたって修行を積み、ついに悟りを得た。だが仙家の洞府に戻ろうとした時、仙人から己の過去を呼び起こされる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150245
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150245,
					"content": "なんと、彼には妹がいた。まだ俗世と縁が切れたわけではなかったのだ。妹の名は意氷、孤独で貧しく、頼れる者もいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150246
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150246,
					"content": "兄の人生は悲惨なものだった、そう思っていた妹は、まさか兄が故郷に帰ってくるなど想像だにしなかっただろう。その後どうなったかは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150247
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150247,
					"content": "このあとすぐ、お楽しみに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150248
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150248,
					"content": "わーい！ほらほら、ボーっとしてないで、はやく拍手しなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150249,
						715150250
					],
					"speakerTitle": "和声"
				},
				{
					"id": 715150249,
					"content": "素晴らしい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150251
					]
				},
				{
					"id": 715150251,
					"content": "拍手する決まりがあるのか…？わ、わかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715150252,
					"content": "ありがとう。本来なら役者を出して劇を続けるべきなんだが、お二人ともまだ困惑しているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150253
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150253,
					"content": "いっそのこと、こちらに来て演出の指揮を手伝ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150254
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150254,
					"content": "そうすれば、これをより深く理解できるし、役者をこの舞台上で存分に動かすことができるようにもなる。いかがかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150255
					],
					"speakerTitle": "応公"
				},
				{
					"id": 715150255,
					"content": "えーっ、なんでぼくじゃないの。紙映戯はぼくのほうがよく知ってるから、ぼくを選んでよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150256
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150256,
					"content": "もう何回もやったことあるだろ。騒がないで静かに観てろって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150257
