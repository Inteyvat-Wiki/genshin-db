			"trigger": {
				"objectNames": [
					"アランカヴィ",
					"アランマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "アランマと金色のナラか、本当に背が高いな。しかし、その銀色のは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810302,
					"content": "ん？銀色がなんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810303,
					"content": "なんと言うか…狭い木のうろに潜り込むのが得意そうだ！素晴らしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810304,
					"content": "#あっ！ナラの風習にならって、まずは紹介しないと。こちらはナラ{NICKNAME}とパイモン、こちらはアランカヴィ。握手して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810305,
					"content": "少し戸惑いながらアランカヴィと握手した…\\nあまり力を入れずに。\\n変わった触り心地だ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "面白い。ワタシもみんなからナラのことをたくさん聞いていたが、直接ナラの体に触るのは初めてだ。なんと不思議な感触！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810307,
					"content": "前にナラがワタシたちのところに来てから、ずいぶんと経った。それは多くの種が大樹となり、多くの物語が伝説に変わるほどの時間だ。話によれば、それはいいナラだったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810308,
					"content": "#ナラ{NICKNAME}もいいナラだ。岩壁に生える小さな木のように勇敢で強い。そして、キミたちはアランラナを助けるために来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810309,
					"content": "ああ、アランラナか…久しく会っていないが、健やかであることを祈るよ。ヴィマラ村の小さいナラたちも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810310,
					"content": "ヴィマラ村の子供を知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "もちろんだとも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810312,
					"content": "ボクたちみんな知ってるよ！アランラナが帰ってきて、小さいナラの物語を聞かせてくれたんだ。だからナライッサム、ナラバハラーム、ナララナたちはもうボクらの友達だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810313,
					"content": "それは知り合いって言うのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810314,
					"content": "では、どうやって知り合いになるんだ？ナラのように「紹介」して「握手」するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810315,
					"content": "ううん、パイモンが言いたいことは分かる。ナラは一緒にご飯を食べて、一緒に「お宝」を探して初めて知り合いになる。そうだよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810316,
					"content": "いや、そう簡単に表せることでは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "物語を知りさえすれば、それで知り合いだ。アランナラの世界は歌の世界、夢の世界だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810322,
					"content": "#うん、アランカヴィの言う通り。アランナラにとっては、ナラ{NICKNAME}の描いた歌を聞いたり、夢にナラ{NICKNAME}を見たりすれば、それで知り合いさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810323,
					"content": "まあ、それはもう置いとこうぜ…なんせ、オイラたちはもうアランナラの友達だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810324,
					"content": "友達！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "アランマとアランカヴィ"
				},
				{
					"id": 730810325,
					"content": "友達！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "おう、オイラたちウツァヴ祭をするんだ。アランカヴィも準備を手伝ってくれないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810329,
					"content": "やはりそうか。ビージャの実が必要なんだな？もうアランヤサとアランダサ、アランシュティガに「アシュヴァッタ堂」を探しに行かせてあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810330,
					"content": "よく分かったな…でも、なんでおまえたちもアシュヴァッタ堂がどこにあるか知らないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810331,
					"content": "アシュヴァッタ堂はとても神聖な場所だから、普段行かないんだ。すべての記憶がサルバの中で混ざり合うまで、ヴァサラの樹を夢の中で静かに眠らせるためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810332,
					"content": "森はすべてを記憶する。すべての美しいことは消えない。すべての苦しみも、すべての美しいことの養分になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810333,
					"content": "とにかく、アランヤサとアランダサ、アランシュティガたちは外でアシュヴァッタ堂を探している。アランマ、オマエも手伝いに行ってくるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810334,
					"content": "#うん、分かった、行ってくるよ。ナラ{NICKNAME}にパイモン、森で会ったらまた一緒に冒険しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730810335,
					"content": "#よしよし。会えて嬉しかったぞ、ナラ{NICKNAME}とパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランカヴィ"
				},
				{
					"id": 730810327,
					"content": "そろそろ本題を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "なんと言うか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "パイモンと一緒に食事や宝探しをしてきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "おう！オイラたちは知り合いを越えて、最高の仲間だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730810320,
					"content": "#ナラ{NICKNAME}とパイモン、すごい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "アランマ"
				}
			]
		},
