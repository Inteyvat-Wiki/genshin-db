					}
				]
			},
			"dialogs": [
				{
					"id": 741380101,
					"content": "やぁ、戻ったかい？君たち、面白い場面を見逃しちゃったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380102
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380102,
					"content": "面白い場面？なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741380103,
					"content": "さっき僕は回収してもらったクラゲを持って、ここでオージュローさんの確認を待ってたんだ。でもオージュローさんはまだ来なくて、逆にクラゲの購入者が訪ねてきたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380104
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380104,
					"content": "それがね、例のクラゲを放流して以来元気になって商売も繁盛したもんだから、神のご利益があったに違いないと思ったんだって！それで再び購入して放流しようと、僕を訪ねてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380105,
						741380106
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380105,
					"content": "こっちは捕まえてるのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				},
				{
					"id": 741380107,
					"content": "#うぅ…{NICKNAME}が捕まえて、キセアンが販売して、お客さんがまた放流する…おい！この方法で金を稼ぐつもりだったのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741380108,
					"content": "そんな、まさか！そんなわけないだろう！？僕だってもう警察隊のお世話になりたくないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380109
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380109,
					"content": "オホン…僕は彼らに、クラゲを放流しても有害無益だってしっかり説明したんだ。けど聞く耳を持ちやしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380110
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380110,
					"content": "最近自分の運がいいのは、彼らがいわゆる…「良いこと」をしたからだって思い込んでるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380111
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380111,
					"content": "僕が立て続けに不運を味わったのも、クラゲを監禁した報いだってね。はぁ…彼らは一体何を考えてるのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380112
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380112,
					"content": "そして、僕が彼らとまだ揉めていたら、オージュローさんが現れて、そのまま彼らを連行したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380113,
						741380114
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380113,
					"content": "運を使い果たしたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380115,
					"content": "…結局、生物の習性や生態を理解せずにみだりに野生へ放つのは、果たして生物のためになったのかな、それとも自分の幸運のためなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380116
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380116,
					"content": "結局最後は警察隊に捕まったんだから…運がよかったなんて言えないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741380117,
					"content": "ははっ、ちなみに警察隊は僕の要塞行きの罪を免除してくれたよ。君たちのおかげだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380118
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380118,
					"content": "約束していた報酬の他に、ちょっとした記念品も用意したから遠慮せず受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380119
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380119,
					"content": "キセアンはクラゲの入ったボールを取り出した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741380120
					]
				},
				{
					"id": 741380120,
					"content": "えっ…これって？「蛍光ムラサキクラゲ」か？前に見たのより小さいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741380121,
					"content": "そう。昨日、在庫のクラゲからちょうどいいサンプルを選んで一匹一匹記録番号を付けてたんだ。まだ何匹か残っていたから…君たちに記念品としてあげようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380122
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380122,
					"content": "残りのクラゲたちは持ち帰って飼育を続けるよ、自然環境に溶け込む方法があるか色々調べてみるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380123
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380123,
					"content": "いくつか「蛍光ムラサキクラゲ」のサンプルを残すつもりでいてね。集団発光の理由を研究するためにも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380124,
						741380125
					],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380124,
					"content": "なかなか可愛いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380126,
					"content": "ま、待ってくれ——頼むからもう放流だけはしないでくれよ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キセアン"
				},
				{
					"id": 741380125,
					"content": "水中で泳がせたらもっと可愛いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380114,
					"content": "自業自得だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380106,
					"content": "まだ売ってたの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				}
			]
		}
	]
}