					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "じゃ行くよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020203,
					"content": "#まずは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}から。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020204,
					"content": "よお、荷物を寄こせ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "へー、昼間に強盗？千岩軍のおじさん達はあそこにいるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220020206,
					"content": "ルル、早くこっち来て、一緒に逃げるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220020207,
					"content": "こんにちは、何が欲しいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020208,
					"content": "うーん、お金とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "でも、お金はないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020213,
					"content": "船の一番高いものは商人の貨物だってパパが言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020214,
					"content": "#そうしよう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、お金になるものを探しに行ってもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020215,
					"content": "そうしたら、奪えるものができるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020216,
					"content": "うーん、そう、ハスの花托がいいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020217,
					"content": "私たちはハスの花托が大好きなの。だから、ハスの花托を奪いに来る海賊が一番悪いの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020209,
					"content": "その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、遊びでもちゃんとやらないとダメだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020211,
					"content": "ほら見て、あっちの千岩軍のおじさん達がこっちを見てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "ルル"
				}
			]
