						220020303
					]
				},
				{
					"id": 220020303,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020304,
					"content": "モンちゃん、飛くん、ハスの花托を食べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020305,
					"content": "おいおい、それを奪うんじゃなかったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220020306,
					"content": "あっ、そうだ。これあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020307,
					"content": "#子供からこんなにものを奪えるなんて、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}はすごいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020308,
					"content": "なんかこの子の話…もっと深い意味があるような気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 220020309,
					"content": "#今日はお疲れさま、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、今度も一緒に遊ぼう。",
