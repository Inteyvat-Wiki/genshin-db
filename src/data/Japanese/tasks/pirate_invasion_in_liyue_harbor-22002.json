			"dialogs": [
				{
					"id": 220020101,
					"content": "なんでまたボクがキャプテンをやるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "モン"
				},
				{
					"id": 220020102,
					"content": "だって、モンちゃんがキャプテンをやる時が一番楽しいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020103,
					"content": "ルルがそう思っているなら、別にいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "飛"
				},
				{
					"id": 220020104,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}たち何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "#あ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、今から遊ぶところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020106,
					"content": "モンちゃんはキャプテン、飛くんは接客係、私はお金持ちの商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020107,
					"content": "あとは海賊さんがいれば！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020108,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、一緒に遊ぼう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020113,
					"content": "じゃあ、準備ができたらこっち来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルル"
				},
				{
					"id": 220020111,
					"content": "いい人をやりたいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#これはただの遊びだよ。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}はいい人だってわかっているからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "ルル"
				}
			]
		},
