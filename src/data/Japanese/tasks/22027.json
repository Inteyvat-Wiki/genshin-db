			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弥生七月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "ごきげんよう、私に何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270202,
					"content": "あ、あの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270203,
					"content": "漆器について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "祠に漆器を捧げたいから、自分で作ろうとしているの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270205,
					"content": "おねがい、七月姉ちゃん、叶えてもらいたい願い事があるんだ！僕…絶対に作り方を他の人に教えないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270206,
					"content": "作り方の問題じゃないわ。美しい漆器を作るには、塗料だけじゃなくて、長年の積み重ねが必要なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270207,
					"content": "時間の問題以外に、財力の問題もあるわ…うちに代々伝わる漆芸は、私の代でもう四代目になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270208,
					"content": "漆器を研究するために、スメールにも遊学しに行ったわ。とにかく、すぐに漆器制作を覚えるのは…とても無理な事よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270209,
					"content": "そ…そうなの？でも、祠に捧げられるような供え物は、漆器以外思い付かないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270210,
					"content": "祠に供え物を捧げることは、その物の価値よりも、そこに込められた「心」の方が大事だと、私は思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270211,
					"content": "誠実に、自分の一番好きなものを捧げれば、きっと神様から返事をもらえるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "弥生七月"
				},
				{
					"id": 220270212,
					"content": "誠実…僕が一番大好きな物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270213,
					"content": "うん、なんとなく分かったような…やっぱり分からないような…とにかくありがとう、七月姉ちゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270214,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、先に祠へ帰ろう。やっぱり何を捧げればいいのか、意見が欲しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
