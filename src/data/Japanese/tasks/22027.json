			"dialogs": [
				{
					"id": 220270401,
					"content": "やっぱり「三色団子」を捧げよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "そうかな…よし！ちょうど母ちゃんからもらった「三色団子」を持ってるんだ。食べちゃったらもったいないからまだ残してるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270403,
					"content": "これを…神様に捧げよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270601,
					"content": "神様、どうか僕の願いを叶えてくれますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270602,
					"content": "#助けてくれてありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。これをあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270603,
					"content": "明日も見に来るよ。どうか神様が…答えてくれますように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
