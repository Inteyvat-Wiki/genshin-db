					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "漆器はどうやって作るのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270102,
					"content": "どうして漆器を作りたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#あ…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、祠で奇跡があるって話を聞いたことある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270104,
					"content": "聞いた話だけど、祠に貴重な供え物を捧げると、願い事を叶えてくれるかもしれないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270105,
					"content": "きれいな漆器は高価だから、漆器を供え物として祠に捧げたら、きっと願いを叶えてくれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270106,
					"content": "漆器を買うお金はないから、自分で作りたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270107,
					"content": "「弥生漆器」の七月姉ちゃんは漆器作りが得意なんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270108,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、一緒に七月姉ちゃんのところに行って、漆器作りの話を聞いてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270109,
					"content": "問題ない、行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#ありがとう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270111,
					"content": "どうして自分で行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "七月姉ちゃんは普段…すっごく厳しい感じだから、聞きに行く勇気がないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270113,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}が隣にいてくれれば、大丈夫だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
