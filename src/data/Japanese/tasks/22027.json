			"dialogs": [
				{
					"id": 220270301,
					"content": "七月姉ちゃんはああ言ってたけど、僕はいったい何を供え物にしたらいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270302,
					"content": "好きなものと言えば、間違いなく「三色団子」だよ、すごく好きだもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270303,
					"content": "でも「三色団子」を供え物にするなんて、失礼な事じゃない？しかも以前、金平糖をお供えしたことがあるけど、何にも起きなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270304,
					"content": "採りたてのお花を匂い袋にして捧げる人もいるらしいけど、団子よりはマシなのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270305,
					"content": "#どうしたらいいの？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、何を選べばいいか分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
