			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410602,
					"content": "吾は、ヘリオスの建造者——阿倍良久なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410603,
					"content": "オ、オイラはパイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410604,
					"content": "このタイミングで自己紹介する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "向こうが名前を言ったら、こっちも名前を言わないといけないらしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410606,
					"content": "そういう礼儀があるみたいだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410607,
					"content": "構わぬ。遥々遠くからいらしたというのに、このような無様な姿でしか出迎えられぬ無礼をお許しいただきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410608,
					"content": "#大丈夫、{NICKNAME}とオイラはそんなこと気にしないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410613,
					"content": "でも、この残魂さんは、どうしてこんなところに残ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410614,
					"content": "吾は…ヘリオスの建造者。ここは…吾の死にゆく場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410615,
					"content": "暗く冷たき場所で、覚めることのない眠りについた…このままでは死ぬに死にきれん…吾は…吾は、ヘリオスの建造者なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410616,
					"content": "ヘリオスの建造者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410617,
					"content": "ヘリオスってなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410618,
					"content": "そうだったな…ヘリオスは建造時に吾が勝手に呼んでいた名であった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410619,
					"content": "汝らが知っているかは分からぬが、白夜国の民に呼ばれている名は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410620,
					"content": "大日御輿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410621,
					"content": "ヘリオスとは大日御輿のこと。「ハイペ{RUBY#[D]白夜の光}リオン」を運ぶ太陽の車だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410622,
					"content": "大日御輿の建造者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "ああ、いかにも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410625,
					"content": "異郷の旅人よ…吾は大日御輿を建造したが、この大日御輿の上に監禁された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410626,
					"content": "死した後、魂は白夜国の各地へと散らばり、記憶さえも散り散りになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410627,
					"content": "重要なものが…とても重要なものが大日御輿の上にある気がするのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410628,
					"content": "だが、それすらも忘れてしまった。異郷の旅人よ、頼む…三つの場所に置かれた吾の衣、冠、骸骨を取り戻してはくれぬか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410629,
					"content": "それぞれ狭間の街、霊廟の前、蛇心の地にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410630,
					"content": "それらを三つの祭壇に奉納してほしい…さすれば、吾の魂は拠り所に戻り、大日御輿への道は開かれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410631,
					"content": "そして大日御輿の上より、常夜に包まれた幽閉の間に辿り着けるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410623,
					"content": "あなたが？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "吾は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "そうか…異郷から来た旅人であったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410611,
					"content": "遥々遠くからいらしたというのに、このような無様な姿でしか出迎えられぬとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410612,
					"content": "大丈夫だ、気にするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
