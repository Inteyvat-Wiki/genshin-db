		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "ああ…異郷の旅人よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410802,
					"content": "汝のおかげで、吾の魂はすべてを思い出すことができた。実に不可思議なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410803,
					"content": "汝はすでに知っておるかもしれぬが、遥か昔、白夜国は暗黒に包まれていた。ここに暮らしていた民は、アビサルドラゴエアの侵害にひどく怯えておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410804,
					"content": "当時、吾は大日御輿の建造を主導し、白夜国に昼夜の切り替わりをもたらした。「白夜」という国の名前も、それに由来するものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410805,
					"content": "「大日御輿が建てられたことにより、たとえ常世の夜であるこの地でも、黒と白を見分けることができるようになった」という意味が含まれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410806,
					"content": "なんと悲しきことか。魂が拠り所に帰るまで、大日御輿を建てた日も、人々が集まったあのひと時もすべて忘れてしまうとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410807,
					"content": "無念だ。これらは本来、吾の心に刻むべき光景だったというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410808,
					"content": "残念ながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410809,
					"content": "残念ながら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410810,
					"content": "大日御輿が建造された後、光に慣れておらぬドラゴエアはすぐに敗れ、白夜の民はついに安らぎを得ることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410811,
					"content": "ただ生活が安定すると…人の心は予期せぬ方向へと移り変わる。他者がどんな醜い考えを持っているかなど、誰にも分からぬことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410812,
					"content": "異郷の旅人よ、これだけは覚えておきなさい。卑しき者は常に隙を見計らい、自らに属さぬ財力と権力を略奪しようとする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410813,
					"content": "それらの者は民衆を利用し、大日御輿崇拝を押し広めた。人の心をすでに死しているものへ寄せさせるなど、愚の骨頂と言えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410814,
					"content": "それだけでなく…「太陽{RUBY#[D]パエトーン}の子」に白夜の国を統治させようとした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410815,
					"content": "太陽の子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "ああ。毎回、一人の子供が太陽の子に選ばれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410817,
					"content": "もちろん、これらの子供たちは、まだあまりにも未熟な存在だ。国の王としての役割を果たすなど、到底不可能なこと。みな、背後にいる卑しき者に操られる人形に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410818,
					"content": "吾は反対しようとした。しかし、彼らの操る太陽の子に大罪を着せられ、生涯ここに監禁されることとなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410819,
					"content": "太陽の子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410820,
					"content": "それって、いつか自分が操り人形だったって気づくってことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410821,
					"content": "だからこそ太陽の子は、誰一人成長することができぬ。成長してしまえば、卑しき者たちが操れなくなってしまうからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410822,
					"content": "「太陽の子、誕生の御祝、天馬に乗りて、烈日の饗宴へ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410823,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "ああ。彼らはみな、大日御輿の内部に送られた。誕生の祭礼で華やかに着飾り、盛り上がりを見せる宴の中で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410826,
					"content": "…ここに隠されている物も、彼らと関係がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410827,
					"content": "これは太陽の子の身分を証明する手綱だ。吾がここに隠したのは、後の人々に伝えるためだったが…もう意味はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410828,
					"content": "異郷の旅人よ、あの子供たちやこの国は、吾が守れなかった存在だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410829,
					"content": "吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410830,
					"content": "吾は、ヘリオスの建造者——阿倍良久なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410831,
					"content": "大日御輿の建造を導き、常夜の闇に煌々と輝く鏡を吊るした。非凡なる者であると自負している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410832,
					"content": "これほどまでの才を有していながらッ！吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410833,
					"content": "吾は大日御輿で闇を洗い流すことができると考えていた。だがそれよりも、人の心にある欲望こそが、すべてを飲み込む常夜であるなど、いったい誰に知り得よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410834,
					"content": "異郷の旅人よ。この手綱を今、汝に渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410835,
					"content": "この「神輿手綱」こそ、この不条理でふざけた歴史を証明するものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410836,
					"content": "しっかりと保管…いや、汝の好きなようにするといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410837,
					"content": "そんな貴重なもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "元々これに意味はない。魂が拠り所に戻り、これを汝に渡せたのも、すべて運命というものだ。これにとっても、良い最後になったと言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410839,
					"content": "このような才能を持っていながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410824,
					"content": "誕生日に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
