			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "ああ…異郷の旅人よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410202,
					"content": "汝のおかげで、吾の魂はすべてを思い出すことができた。実に不可思議なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410203,
					"content": "汝はすでに知っておるかもしれぬが、遥か昔、白夜国は暗黒に包まれていた。ここに暮らしていた民は、アビサルドラゴエアの侵害にひどく怯えておった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410204,
					"content": "当時、吾は大日御輿の建造を主導し、白夜国に昼夜の切り替わりをもたらした。「白夜」という国の名前も、それに由来するものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410205,
					"content": "「大日御輿が建てられたことにより、たとえ常世の夜であるこの地でも、黒と白を見分けることができるようになった」という意味が含まれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410206,
					"content": "なんと悲しきことか。魂が拠り所に帰るまで、大日御輿を建てた日も、人々が集まったあのひと時もすべて忘れてしまうとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410207,
					"content": "無念だ。これらは本来、吾の心に刻むべき光景だったというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410208,
					"content": "残念ながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410209,
					"content": "残念ながら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410210,
					"content": "大日御輿が建造された後、光に慣れておらぬドラゴエアはすぐに敗れ、白夜の民はついに安らぎを得ることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410211,
					"content": "ただ生活が安定すると…人の心は予期せぬ方向へと移り変わる。他者がどんな醜い考えを持っているかなど、誰にも分からぬことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410212,
					"content": "異郷の旅人よ、これだけは覚えておきなさい。卑しき者は常に隙を見計らい、自らに属さぬ財力と権力を略奪しようとする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410213,
					"content": "それらの者は民衆を利用し、大日御輿崇拝を押し広めた。人の心をすでに死しているものへ寄せさせるなど、愚の骨頂と言えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410214,
					"content": "それだけでなく…「太陽{RUBY#[D]パエトーン}の子」に白夜の国を統治させようとした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410215,
					"content": "太陽の子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "ああ。毎回、一人の子供が太陽の子に選ばれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410217,
					"content": "もちろん、これらの子供たちは、まだあまりにも未熟な存在だ。国の王としての役割を果たすなど、到底不可能なこと。みな、背後にいる卑しき者に操られる人形に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410218,
					"content": "吾は反対しようとした。しかし、彼らの操る太陽の子に大罪を着せられ、生涯ここに監禁されることとなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410219,
					"content": "太陽の子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410220,
					"content": "それって、いつか自分が操り人形だったって気づくってことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722410221,
					"content": "だからこそ太陽の子は、誰一人成長することができぬ。成長してしまえば、卑しき者たちが操れなくなってしまうからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410222,
					"content": "「太陽の子、誕生の御祝、天馬に乗りて、烈日の饗宴へ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410223,
					"content": "まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "ああ。彼らはみな、大日御輿の内部に送られた。誕生の祭礼で華やかに着飾り、盛り上がりを見せる宴の中で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410226,
					"content": "…ここに隠されている物も、彼らと関係がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410227,
					"content": "これは太陽の子の身分を証明する手綱だ。吾がここに隠したのは、後の人々に伝えるためだったが…もう意味はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410228,
					"content": "異郷の旅人よ、あの子供たちやこの国は、吾が守れなかった存在だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410229,
					"content": "吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410230,
					"content": "吾は、ヘリオスの建造者——阿倍良久なり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410231,
					"content": "大日御輿の建造を導き、常夜の闇に煌々と輝く鏡を吊るした。非凡なる者であると自負している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410232,
					"content": "これほどまでの才を有していながらッ！吾は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410233,
					"content": "吾は大日御輿で闇を洗い流すことができると考えていた。だがそれよりも、人の心にある欲望こそが、すべてを飲み込む常夜であるなど、いったい誰に知り得よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410234,
					"content": "異郷の旅人よ。この手綱を今、汝に渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410235,
					"content": "この「神輿手綱」こそ、この不条理でふざけた歴史を証明するものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410236,
					"content": "しっかりと保管…いや、汝の好きなようにするといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410237,
					"content": "そんな貴重なもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "元々これに意味はない。魂が拠り所に戻り、これを汝に渡せたのも、すべて運命というものだ。これにとっても、良い最後になったと言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410239,
					"content": "このような才能を持っていながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410224,
					"content": "誕生日に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
		{
			"id": 7224103,
