			"dialogs": [
				{
					"id": 705170101,
					"content": "この辺りは特になにもなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170102,
					"content": "食べ物も見当たらないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170103,
					"content": "本音が漏れてるよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "だって、秘密を調べてる間も腹は減るもんだろ！別に普通のことじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170106,
					"content": "それに最近は手間のかからない、ただ焼いただけの料理ばっかで…おまえもちょっと飽きてただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170107,
					"content": "砂浜で貝やホラガイを拾ったら、それを果物と一緒に煮込んで食べようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170108,
					"content": "旨くて、甘くて、歯ごたえがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170109,
					"content": "暗黒料理はちょっと…遠慮しとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "試してみたら、案外新たな世界の扉が開くかもしれないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170113,
					"content": "#あれ、{NICKNAME}、あそこ見てみろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170114,
					"content": "突然現れた装置…なんだか怪しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170115,
					"content": "近くに荷物もあるぞ、ファデュイのものかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170116,
					"content": "パイモン大正解、さすがだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "オイラの直感ってよく当たるんだよな、えっへん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170118,
					"content": "って、いやいや喜んでる場合じゃなかった！大変じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170119,
					"content": "ファデュイと関係のあるものが現れたってことは、きっとなにか裏があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170120,
					"content": "ほっといたらどんどん悪化して、また面倒なことになっちゃうかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170121,
					"content": "とりあえず、装置をどうにかしようぜ？必要そうなら、ファデュイの荷物も調べてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}、いつもみたいにやる気全開で頼むぜ！これを片付けたら、安心して食材を探せるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170111,
					"content": "パイモンの食感みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "おい！オイラは海鮮じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705170104,
					"content": "だから積極的だったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}