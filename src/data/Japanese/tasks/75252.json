			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "それより、この辺りでハゲ頭の男を見かけなかったか？用があって探しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520702,
					"content": "#{M#俺}{F#私}もその人を探しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "ん？さっきまでここにいたのか？じゃあ、逃げたんだな。追ってるのがバレたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520709,
					"content": "イカファ…逃がさんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520706,
					"content": "この際だから忠告しておく。俺にもあいつにも近づかないほうがいいぞ。あんたのその綺麗な顔に、白や赤の汚い絵の具がつかないようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520707,
					"content": "これは俺がキャンプで見つけたものだ…持って行くのが間に合わなかったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520708,
					"content": "あんたにやろう。心配いらん。今は俺の一存で決めていいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520710,
					"content": "あいつの命はいずれ俺のものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テクトリ"
				},
				{
					"id": 752520703,
					"content": "見てない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "嘘じゃないよな？あんたは誠実そうだ、信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "テクトリ"
				}
			]
