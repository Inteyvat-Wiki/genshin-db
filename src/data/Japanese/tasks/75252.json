				{
					"id": 752520601,
					"content": "前会ったお客さんを迎えてくれる人でしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "そうか？どうりで見覚えがあるわけだ。だが毎日たくさんの人に会ってるから、よく覚えてない…そんなことはどうでもいい。",
					"roleType": "TALK_ROLE_NPC",
