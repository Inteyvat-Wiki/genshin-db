					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "宝盗団はますます大胆になった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090102,
					"content": "探してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "うん、あなたに頼みたいことがあるからね。この前あなたが言ってた「宝児」なんだけど、調べてたら彼女は宝盗団の人だって確信したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090104,
					"content": "単独行動の原因は…宝物を独り占めしたいか、もしくは宝盗団の本隊のための先遣のどちらかだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090105,
					"content": "ひとりは正体を隠しやすいしね、なにせ経験豊富な旅人も彼女に騙されたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090106,
					"content": "これ以上彼女、そして宝盗団を放っておくと、周りの文物もきっと狙われるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090107,
					"content": "だから、それを止めてほしいの。完全に阻止できなくても、文物をできるだけ取り戻してほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090110,
					"content": "どうして彼女たちの位置が分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "私の推測が正しければ、宝盗団の人たちは私を尾行してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090112,
					"content": "私から直接奪うだけで、貪欲なあいつらはきっと満足しないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090113,
					"content": "私が留まった場所なら、きっと彼らも何かないか探しにくるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090114,
					"content": "よく考えたら、居場所が分かるからね。でも私はただの学者だし、推理や判断はできるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090115,
					"content": "戦闘となると、やはり経験者の君に頼むしかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090116,
					"content": "お願い、あの文物たちを取り戻して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090117,
					"content": "すぐに倒すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "待って、「止める」って言ったけど、すぐにあの宝児に問い質してほしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090119,
					"content": "宝盗団の組織はかなりゆるいけど、同時にその痕跡はつかみにくいの。せっかく君が繋がりを持ってるから、めったにないチャンスだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090120,
					"content": "彼女たちが「帰離原」に現れたのはきっと何か企みがあると思う。君が宝児のそばにいると、その計画を聞き出せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090121,
					"content": "だから、またバラしちゃだめだよ。君の実力を信じてるから、気付かれない場所を探して…速戦即決だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090122,
					"content": "文物を取り戻したらすぐに離れるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
