			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090301,
					"content": "どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090302,
					"content": "文物だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "ふう…そう、私の推測通り、彼女たちは私の考察ルートを元に採掘してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090304,
					"content": "技術はないけど、「人数」の優勢があるからね、その数で掘れば文物を掘り当てるもの当然だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 220090305,
					"content": "君がいなかったら、この文物たちは大変なことになってるかもしれない。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		}
