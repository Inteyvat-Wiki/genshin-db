			"trigger": {
				"objectNames": [
					"ファーバル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736910101,
					"content": "このおもちゃを、みんなが気に入ってくれるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910102
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910102,
					"content": "ここでは何か遊べるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910103
					]
				},
				{
					"id": 736910103,
					"content": "君は…旅人だな？俺はルタワヒスト学院の学生、ファーバルだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910104
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910104,
					"content": "えっと…うちの学院が研究してるもの、知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910105
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910105,
					"content": "えっと…たしか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910106
					]
				},
				{
					"id": 736910106,
					"content": "俺たちルタワヒスト学院は星象を研究してるんだ。もちろん、それが全てってわけじゃない。学院の中にも、数多くの研究分野があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910107
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910107,
					"content": "でも残念ながら…俺たちの研究の多くは、普通の人に説明してもあまり理解してもらえないか、興味を持ってもらえないことが大半なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910108
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910108,
					"content": "だからって直接占星のブースを出したとしても、みんなが議論に没頭してしまって、それどころじゃなくなるって心配もあってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910109
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910109,
					"content": "だから議論を重ねたすえに、俺たちはある折衷案を考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910110
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910110,
					"content": "この特製の星盤を見てくれ。上にたくさん星があるだろ。君には、これらの星をある特定の図案に組み合わせてもらいたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910111
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910111,
					"content": "そ、その図案は特に複雑なものではないし、まだ結論の出ていない論争に関わるものでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910112
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910112,
					"content": "コホン、つまり…これは簡単で楽しく、学術的対立を引き起こすこともない、平和なパズルゲームなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910113
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910113,
					"content": "何だか、すごく緊張してるように見える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910114
					]
				},
				{
					"id": 736910114,
					"content": "このゲームは星にまつわるものだ…うちの学院の一部学生は、星という言葉を聞くだけでナーバスになってしまうのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910115
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910115,
					"content": "はぁ…このおもちゃを設計してた時、「これはただのおもちゃで、学術研究とは何の関係もない」ってどれだけの同級生に説明したことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910116
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910116,
					"content": "この話はやめよう。もし興味があれば、試してみてくれると嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910117,
						736910119
					],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910117,
					"content": "試してみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910118
					]
				},
				{
					"id": 736910118,
					"content": "分かった、星盤はここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファーバル"
				},
				{
					"id": 736910119,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910120
					]
				},
				{
					"id": 736910120,
					"content": "ああ、学院フェスの期間中、俺はずっとここでブースを出してる。プレイしたくなったらいつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファーバル"
				}
			]
		}
	]
}