						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740812401,
					"content": "回収するのって、この紙テープでよかったんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740812402,
					"content": "セヴィニエに回収した紙テープを見せた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "そう、これよ。あなたたち優秀なのね。少しも手間取った様子がないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812404,
					"content": "こんな楽勝な仕事、あっという間だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740812405,
					"content": "それはよかったわ。ある同僚なんか、ちょっとした材料を探すだけでほぼ丸一日かかるほどだったんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812406,
					"content": "まあとりあえず、その紙テープをシセリー先輩に届けてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812407,
					"content": "ついでに、「しばらく戻れない」って伝えてちょうだい。それから…急いでここの実験機を回収してもらうよう、マイヤルデ先輩に連絡してほしいとも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812408,
					"content": "#おう、任せろ！じゃあ{NICKNAME}、来た道を戻ろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740812409,
					"content": "あっ、その必要はないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812410,
					"content": "二人ともダイビングはできるでしょう？実はこのあたりのいくつかの水路は外に繋がってるの。今までは転落防止のために封鎖されてたんだけど、通路を開いてあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812411,
					"content": "#おっ、助かるぜ！{NICKNAME}、泳いで戻ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740812412,
					"content": "通路を開くための端末は中にあるから、私は行くわね。この先はあなたたち二人でも大丈夫よね？迷ったりしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740812413,
					"content": "#ふふん、オイラたちを甘く見るなよ！オイラはテイワット一のガイドなんだからな。オイラがいれば、{NICKNAME}が迷うことなんてないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740812414,
					"content": "それは頼もしい限りね。じゃあ、伝言と紙テープの件はお任せするわ。お見送りできなくて悪いけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "セヴィニエ"
				}
			]
		},
