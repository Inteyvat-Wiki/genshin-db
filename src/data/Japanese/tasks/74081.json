						],
						"pointId": 6385
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "えっと…オイラたち、なにかとんでもないトラブルを引き起こしたんじゃないよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811702,
					"content": "おかしいわね。今の揺れって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811703,
					"content": "確かに揺れを感じた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "あっ…もしかして、さっきオイラたちが上の階で装置を動かしたせいなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811706,
					"content": "ここの扉って、もともとロックされてたわよね？侵入者を防ぐために、わざわざクロックワーク·マシナリーまで配置されてたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811707,
					"content": "「休んで」もらったら、扉が開いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "し、仕方ないじゃんか。向こうから先に攻撃してきたんだから。正当防衛ってやつだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811710,
					"content": "マイヤルデ先輩の実験機は…停止状態のようね。先輩はエリニュス島でお気に入りの場所を見つけて以来、ほとんど帰ってこなくなったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811711,
					"content": "けど、それも仕方ないわね。庭園やダンスフロアみたいな美しい場所で研究の成果を発表できるなら、こんな湿っぽくてボロボロの研究室なんかに戻りたい人なんていないでしょうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811712,
					"content": "ボシュエ先生が退任したあと、ここにあった資材と同じように、みんなもフォンテーヌ科学院の各所に散らばってしまったわ。ソファでさえ一つ残らずね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811713,
					"content": "実験機だけがここに残されて、もう帰ることない人を待っている…まあ、彼らからするとスタンバイモードでここに立っているだけで、別になんてことないんでしょうけど。でも今はひどい状態だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811714,
					"content": "ほら見て、めちゃくちゃになるまで打ちのめされて、クロックワークが落っこちそう。もしマイヤルデ先輩が知ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811715,
					"content": "#ごめん、{M#俺}{F#私}がやった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "ごめん…こ、これってすごく高いもんだったりするのか？もし弁償が必要なら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811719,
					"content": "ふふっ、大丈夫よ。私が言いたかったのは、マイヤルデ先輩が知ったらきっと笑い出すだろうな、ってことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811720,
					"content": "何しろ彼、以前はよく実験機のダンスを止めようとして、逆に倒されてたの。それから、その場に座り込んで笑ってたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811721,
					"content": "あっ、話してばっかで自己紹介がまだだったわね。私はフォンテーヌ科学院の研究員、セヴィニエって呼んでちょうだい。あなたたちは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811722,
					"content": "#オイラはパイモン、こっちは{NICKNAME}で、えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811723,
					"content": "通りかかっただけで、他意はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "そうそう！通りかかっただけなんだ。別に、ここにお宝が隠されてるかもなんて思っては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811726,
					"content": "なるほどね。お宝探しの廃墟ツアーでも計画するつもりなのかしら？だったら、場所を間違えてるわよ。ここは廃墟に見え…いや、実際廃墟なんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811727,
					"content": "ここはまだ、廃墟ツアーのオススメスポットに含まれないと思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811728,
					"content": "そっか！だったらオイラたちはもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811729,
					"content": "…待って、新フォンテーヌ科学院を知ってるわよね？ついでに手伝ってほしいことがあるの。新フォンテーヌ科学院に行って、シセリー先輩を探してきてくれない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811730,
					"content": "新フォンテーヌ科学院に行く予定は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "はぁ…どうすればいいの。まだ仕事が残ってるし、マイヤルデ先輩の実験機は壊されちゃうし、急いで回収しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811733,
					"content": "#う～ん…{NICKNAME}、やっぱりオイラたちが手伝ってあげようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811734,
					"content": "助かるわ！伝言役になってくれるのね。なら、紙テープを回収する仕事も任せちゃおうかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811735,
					"content": "勝手に装置に触るんじゃなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "まあまあ。あなたたちにとっては朝飯前でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811737,
					"content": "研究資料の回収に協力してくれるって名目があれば、委託報酬を支払えるから安心して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811738,
					"content": "えっ？そんなことして大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811739,
					"content": "ええ、研究業務に協力してくれたってことになるでしょ？筋は通ってるし全然問題ないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811740,
					"content": "もし本当に規則にそぐわないとなれば、事務員に差し戻されるだけ。その時は委託費用も自腹を切るつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811741,
					"content": "こういうことはよくあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "私はないわよ？他の人は知らないけどね。確かに、以前は噂で耳にしたけど…おっと、外の人に話す内容じゃないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811743,
					"content": "回収が必要な紙テープは三本。というか、本棚に三本しかないの。すぐ見つかるはずだから、よろしくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811744,
					"content": "その間に、私はもう一度実験機をチェックしておかないと。もう長いこと誰もメンテナンスしてないしね…暴走でもしたらマズいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811745,
					"content": "おう、じゃあ紙テープを全部回収したら戻ってくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740811736,
					"content": "分かった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "他にも探したいお宝があるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "ここにお宝ってある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "実験機の強度アップを検討したことは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "確かマイヤルデ先輩は考えていたわ。最終的な完成品なら、あなたが期待する強度になってるかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "セヴィニエ"
				},
				{
					"id": 740811708,
					"content": "おかしい、なんで扉が開いたんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "気のせいじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
		{
