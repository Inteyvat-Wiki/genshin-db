			"dialogs": [
				{
					"id": 740813101,
					"content": "こんにちはー！セヴィニエのことなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740813102,
					"content": "シセリーに状況を説明し、回収した三本の紙テープを渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "私も向こうの状況を確かめたほうがいいかもって、ちょうど心配していたのよ。そういうことだったのね。伝えてくれてありがとう…それから、紙テープも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "シセリー"
				},
				{
					"id": 740813104,
					"content": "まさか、マイヤルデの実験機がまだ動くなんて…セヴィニエはそんな危険な環境で仕事を続けていたのね。事務員に言って、回収について相談しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "シセリー"
				},
				{
					"id": 740813105,
					"content": "そしたら支払いの問題についても聞くことができるし…やっぱりセヴィニエは頭がいいわね。でも、規定に準ずるかどうかは事務員の判断によるから、ひとまず費用は私のほうで立て替えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "シセリー"
				},
				{
					"id": 740813106,
					"content": "とにかく、協力してくれてどうもありがとう。委託の完了報酬を受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シセリー"
				}
			]
