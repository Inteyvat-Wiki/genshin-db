			"dialogs": [
				{
					"id": 220170201,
					"content": "旅人、小説を何冊か持ってきてくれないか？彼とちゃんと話し合いたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170202,
					"content": "ふん、自分勝手に書いた方が、小説を台無しにするに決まってる。",
					"roleType": "TALK_ROLE_NPC",
