			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "この推理小説は長い間人気があったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170402,
					"content": "この小説が成功した理由は、緻密に設計された謎とストーリーにあると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170403,
					"content": "読者から、ストーリーの進行が速すぎて理解できないという意見が来ていたが、作者は自分のルールに忠実だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170404,
					"content": "そうすることで、この小説は他の推理小説よりも頭一つ抜けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170405,
					"content": "でもこの小説には、しっかりとした設定がある。この種の推理小説のストーリーを支えるには、簡単には変更できない、きちんとした設定が重要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170406,
					"content": "くっ…旅人、他の本はある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "この小説？確か文章が優れていて、筋書きもしっかりしていた。編集者たちも満場一致で褒めていたから、当時はとても売れていたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170502,
					"content": "…そうなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170503,
					"content": "でも、この小説はストーリーと設定の厳密性にこだわり過ぎて、広がりに欠けていた。だから、結局は読者が既に知っている展開を繰り返すことになっていたと思うんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170504,
					"content": "だから、どんどん新鮮さがなくなり、次第に読者を失っていった。そして最終的には、読者をすべて失い、打ち切りになってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170505,
					"content": "設定も物語も、厳しく制限されたら、どれも一緒になってしまう。そして生気のない淀んだ水のように、読者たちから見捨てられてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170506,
					"content": "僕の小説がこんな風になるのは嫌だ！いい物語にはまず、際立った特別なものが必要なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170507,
					"content": "それに、もし…もし作家自身ですら物語に興味を持たなかったら、どうやって読者を感動させるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170508,
					"content": "茂さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170509,
					"content": "わ、分かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170510,
					"content": "そんな深く考えていたなんて、思ってなかったよ。流石『鬼武道』の作者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170511,
					"content": "実は、僕も君を制限したくないんだよ。でも、想像力や創作意欲が過剰で、作品を台無しにしてしまった作家をたくさん見てきたからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170512,
					"content": "順吉、君は作家として、創作についてどう思ってるんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170513,
					"content": "僕は創作意欲が一番大事だと思う。創作意欲がない作家は、人を感動させる作品なんてきっと作り出せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170514,
					"content": "でも僕は、作家にとって一番大事なものは、創作意欲に対する自制心の方だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170515,
					"content": "まだ意見が合わないようだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "茂さん、僕は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170518,
					"content": "しかし、この小説の作者は僕ではなく君だ。僕はただ、小説を完成させるために最善を尽くす編集者に過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170519,
					"content": "もし自分の信念を貫くのならば、自分の好きなように執筆すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170520,
					"content": "君の考えを認めるわけにはいかないけど、理解するよう努力はする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170521,
					"content": "あ…ありがとう！茂さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170522,
					"content": "いいんだ、僕がやるべきことなんだから。ただもちろん、僕が君を理解しようとしているように、君も僕を理解してくれ。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "茂"
				},
				{
