			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"順吉",
					"茂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "もうやめた、やめた！どんなに尻を叩いても無駄だよ！もう作家はやめる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170102,
					"content": "君ってやつは…これまで七回も執筆を辞めるって脅してきたけど、どれも嘘だったって言うのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170103,
					"content": "またケンカしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "旅人、やっと来てくれた！手伝ってほしい事があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170105,
					"content": "君が彼の味方をして以来、彼はますます厳しくなったんだ。何十ものルールを作って僕に守れって言うんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170106,
					"content": "能力の名前から、物語の展開まで、全部…執筆マニュアルに従えって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170107,
					"content": "そんな状態で、いい小説を書けるわけないじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170108,
					"content": "それらはヒット小説からまとめた執筆ルールで、先輩たちの経験の賜物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170109,
					"content": "他の小説を無理やり真似しろっていうのか？そんなの、僕が書いているのか、その「先輩」たちが書いているのかわからなくなるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170110,
					"content": "そういう書き方はしたくないんだ…そんな堅苦しい方法で書きたいのなら自分で書けばいいじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170111,
					"content": "しかも、「八重堂」にも売れない小説がたくさんあるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170112,
					"content": "あれは販促が悪かったんだ、小説そのものには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "茂"
				},
				{
					"id": 220170113,
					"content": "販促なんかのせいじゃないよね。単純に作家の書き方が悪かっただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170114,
					"content": "君は多分知らないと思うけど、僕は「八重堂」が出版した本を全部読んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170115,
					"content": "旅人、小説を何冊か持ってきてくれないか？彼とちゃんと話し合いたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220170116,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "どの小説がいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "僕がそこに置いた小説を何冊か持ってきて。僕はこれらを隣において…こんな風に書いてはいけないって、自分を戒めてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
