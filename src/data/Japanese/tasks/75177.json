			"dialogs": [
				{
					"id": 751770101,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#あれ、{REALNAME[ID(2)|SHOWHOST(true)]}、この写真機はどこで手に入れたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770103,
					"content": "まさか、他の人の目を盗んで…ってわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770104,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "キュウ…ウルル！ウルル！ギャア！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "見覚えのある動き…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "おお、これは「ミートシチュー・ブレイズ」じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770110,
					"content": "へへっ、「こだまの子」にいた時、監督になりたいのに写真機を逆にセットしちゃったやつがいて…あっ！もしかしてこの写真機って、あいつから借りてきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770111,
					"content": "キュ！ウルル…ウルァ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "オイラたちと一緒に写真を撮りたいってことか？へへっ、そういう意味だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770113,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "そういえば、ずっと一緒に冒険してるのに、まだ写真を撮ってなかったな！こいつの呪いも解けたことだし、これで元気に大きくなれるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770115,
					"content": "#でも、大きいテペトル竜になるまでってどれくらいかかるんだ？もし明日急に大きくなったら…もう{REALNAME[ID(2)|SHOWHOST(true)]}の小っちゃい姿は見れなくなっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770116,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "へへっ、一枚撮ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770119,
					"content": "よし、セッティング完了！逆さまになってないかもちゃんと確認したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770120,
					"content": "じゃあ、カウントダウンが終わったら「ミートシチュー・ブレイズ」って言うんだぞ！さん、にー、いちっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770121,
					"content": "「ミートシチュー・ブレイズ」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#バッチリ撮れたな！ほら、{REALNAME[ID(2)|SHOWHOST(true)]}もかっこよく映ってるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770124,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}は写真を手に取ると、背を向けてそっと硬い殻の下…柔らかい背中へとしまい込んだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#でもさ、なんで{REALNAME[ID(2)|SHOWHOST(true)]}は急に写真を撮りたくなったんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770127,
					"content": "キュイオン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "キュ…キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#あれ、どうしたんだ？{REALNAME[ID(2)|SHOWHOST(true)]}、どこか具合でも悪いのか？様子が変だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770131,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "きっと、自分だけの冒険を始めたいんだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "えっ、なんだよ、自分だけの冒険って…オ、オイラたちとは一緒に旅をしたくないのか？うぅ…オイラ、なんか嫌なことでも言っちゃったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770135,
					"content": "食いしん坊だなんてもう言わないから、ずっと一緒にいようぜ…な？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770136,
					"content": "キュ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "…パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "うぅ…分かってる、分かってるよ…ちびもいつか大きくなるんだ。こいつにも、行くべき場所があるって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770139,
					"content": "それでも、いきなり離れるって言われたら、寂しいに決まってるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770140,
					"content": "大丈夫、きっとまた会える…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#ほんとか？これから、うぅ…これからオイラたちが助けを求めたら、{REALNAME[ID(2)|SHOWHOST(true)]}、絶対にすぐ駆けつけるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770142,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も冒険で困ったことがあったら、すぐにオイラたちのところに来るように！もちろん、無理するのもダメだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770144,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "…それと、あまり食べ過ぎないこと。倒せないデカブツに遭遇したらすぐに逃げること。あと、食べ過ぎはダメだけど、食べるべきお肉もしっかり食べること…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770146,
					"content": "それと、なによりも！いっちばん大事なのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770147,
					"content": "元気に育ってくれること…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "そう、ちゃんと大きくなること。山と同じぐらいにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770149,
					"content": "キュウ、キュウ、キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "うぅ…その意気だ！絶対…絶対にオイラたちのこと、忘れちゃダメだからな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751770151,
					"content": "静かな森の中、あなたは別れを惜しみながらブレイズ・ミートシチューを一緒に味わい、時折訪れていたキャンプ場を片付けた。\\nそして、これから独りで旅に出る仲間のために、道中で手に入れた思い出の品を整理しながら、今までに起きたことを思い返す——洞窟の入口を塞いでいたユムカ竜に、海辺のプクプク獣、それからナタで出会った個性豊かな人々…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "その後…あの金の文字を送ってきた謎の存在が脳裏をよぎった。\\n「あいつ、一度も姿を見せなかったな。オイラたち、きっと利用されたに違いないぞ。」とパイモンは愚痴っていたが…\\nそれを聞いてふと、トゥラン聖山の底で見た成長した竜の姿を思い出す。\\n複雑な感情を浮かべていたあの瞳…この子もいつか、あんな風に立派な姿に成長するのだろうか。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "目の前の仔竜は最後、角でパイモンの額にそっと触れ、それからあなたの手のひらに優しく頬をすり寄せた。\\nそして、まるで自らを奮い立たせるかのように——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "幼い竜は決然と背を向け、ゆっくりと去っていった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "うん、撮ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "「ミートシチュー・ブレイズ」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "その響き、思い出すな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}