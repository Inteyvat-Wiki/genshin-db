			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "ああ、やっと一段落ついたわ…二人ともありがとう。二人が手伝ってくれなかったら、クレームの嵐だったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570702,
					"content": "#{M#俺}{F#私}たちは親切な冒険者だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "冒険者なの？だったら記念に君たちの写真を撮らせて。情熱あふれる姿を残してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570704,
					"content": "はい、チーズ！のんびりナタののびのびサマー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570705,
					"content": "本当にありがとう。これもどうぞ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イツトリ"
				}
			]
		},
