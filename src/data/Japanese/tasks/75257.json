			"dialogs": [
				{
					"id": 752570801,
					"content": "うん、素敵な写真！最後はこちらの貴公子。何をお撮りしましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570802,
					"content": "よくぞ言ってくれた。私は生まれてこの方、品のある人間になることを最も重要視してきたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "インティ"
				},
				{
					"id": 752570803,
					"content": "品があってこそ、人はよりエレガントに、より洗練されるのだ——お分かりかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "インティ"
				},
				{
					"id": 752570804,
					"content": "ふむ…ちょっと考えさせて…よし、始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イツトリ"
				}
			]
