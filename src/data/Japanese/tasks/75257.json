			},
			"dialogs": [
				{
					"id": 752570101,
					"content": "ねぇ、設備は整ってるんだろ？なんでやってないんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "ゾマ"
				},
				{
					"id": 752570102,
					"content": "申し訳ありません、お客様。本アトラクションの裏方が二日酔いで、今日は来られないんです。また明日お越しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570103,
					"content": "あたしゃもう歳でね、明日またこんな遠くまで歩いて来いなんてたまったもんじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "ゾマ"
				},
				{
					"id": 752570104,
					"content": "そうそう。それにみんな都合というものがあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "インティ"
				},
				{
					"id": 752570105,
					"content": "申し訳ありません。この「夏の記念撮影コーナー」は、ゲストの好みに合わせて撮影背景のセッティングをするコーナーでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570106,
					"content": "裏方がいないと、本当に進められないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570107,
					"content": "手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "え？手伝ってくれるの？すごく助かるわ。そこまで難しい仕事じゃないの。ゲストの要求通りに記念撮影の背景をセットすればいいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イツトリ"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
