				]
			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "いい出来だったわね。次はこちらのファデュイのお兄さん。どんなふうにお撮りしますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570302,
					"content": "ガンマンのように撮ってくれ。一目で百発百中の腕前と分かるように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "ウェチェカ"
				},
				{
					"id": 752570303,
					"content": "そうすれば中隊の射撃大会で順位が下のほうでも傷つかないですむ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "ウェチェカ"
				},
				{
					"id": 752570304,
					"content": "了解、では始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イツトリ"
				}
			]
		},
