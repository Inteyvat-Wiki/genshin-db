			"trigger": {
				"objectNames": [
					"イツトリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "面白そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "よかった！ではどなたから始めましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "イツトリ"
				},
				{
					"id": 752570203,
					"content": "レディファーストで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "インティ"
				},
				{
					"id": 752570204,
					"content": "異議なし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "ウェチェカ"
				},
				{
					"id": 752570205,
					"content": "おやまあ、紳士的だこと。あんたたちみたいな若い人と一緒に写真を撮りたいねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "ゾマ"
				},
				{
					"id": 752570206,
					"content": "へっ？まあ…構いませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "インティ"
				},
				{
					"id": 752570207,
					"content": "コホン、異議なし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "ウェチェカ"
				},
				{
					"id": 752570208,
					"content": "ふーむ…いや、まだ足りないねえ。もう三人くらいほしいわ。入るでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "ゾマ"
				},
				{
					"id": 752570209,
					"content": "ふふ…あと花火もあるといいねえ。若い頃はそういう雰囲気が大好きだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "ゾマ"
				},
				{
					"id": 752570210,
					"content": "分かりました、では始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イツトリ"
				}
			]
		},
		{
			"id": 7525703,
