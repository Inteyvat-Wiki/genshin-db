				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "おお！旅人じゃないか、ここで会うとはな。よし、この酒場で一杯やるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080102,
					"content": "まさか、あなたがここにいるなんてね。会えて嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080103,
					"content": "二人ともどうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "えっ…おまえたち、もしかして二人で来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705080105,
					"content": "ああ、「このお方」がゆっくりと休みたいって言うもんでな。この辺りを旅行することにしたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080106,
					"content": "だが、旅行に対する認識がアタシらの間でズレてたみたいだ。まだ数えるほどしか山にも登ってないのに、「ここで休憩する」とか言い出してな。まったく、これだから金持ちってやつは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080107,
					"content": "その言い方、傷つくわね。私はあなたのために、わざわざお酒を飲めるような場所を選んであげたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080108,
					"content": "まあ、見識の広い「船長様」からすると、この小さな酒場では物足りないみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080109,
					"content": "ちっ、分かったよ。ったく、今回はアタシのおごりだ。これでいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080110,
					"content": "北斗のおごり？オイラたちの分もか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705080111,
					"content": "#パイモン、{M#俺}{F#私}たちはバーテンダーだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "そうだった、つい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705080113,
					"content": "二人とも何が飲みたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "私はスモールサイズの樺木をいただけるかしら。酸味を強めでお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 705080115,
					"content": "なら、アタシはラージサイズの夕暮れを頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 705080116,
					"content": "分かった、少し待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
			],
