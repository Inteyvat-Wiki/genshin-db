			"dialogs": [
				{
					"id": 716701101,
					"content": "さっきのピークを過ぎてからは、一時的に安定してるみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701102
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701102,
					"content": "そうね…でも異常はまだ残ってるわ。しばらくしたら、また活発になるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701103
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701103,
					"content": "とはいえ、せっかく余裕が出来たことだし、この機会にしっかり休んで、次の戦いに備えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701104
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701104,
					"content": "おう、ちゃんと準備してくるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716701105,
					"content": "今のうちにお腹いっぱい食べて、しっかり休んで力を蓄えようぜ！それから、対策も考えないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
