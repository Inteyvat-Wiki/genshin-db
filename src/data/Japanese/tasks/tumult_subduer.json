			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"方謹",
					"刻晴",
					"夜蘭"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1108.29,
							202.929,
							-9.85
						],
						"pointId": 300201064
					},
					{
						"sceneId": 3,
						"position": [
							975.844,
							260.604,
							-187.825
						],
						"pointId": 310500127
					}
				]
			},
			"dialogs": [
				{
					"id": 716700201,
					"content": "うーん…なんか変だな。向こうに見える地脈の穢れの煙…見れば見るほど不気味だぞ。あそこからヤバい魔物でも湧いてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700202,
					"content": "千岩軍がわざわざ拠点を作って、見回りの兵や防御施設をいっぱい置いてるみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700203,
						716700204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700203,
					"content": "前にも似たような光景を見たかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				},
				{
					"id": 716700205,
					"content": "おう！今まで通り、千岩軍と力を合わせて魔物をやっつけようぜ！地脈の穢れのことはその後で考えよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700206,
					"content": "止まってください。この先は危険です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700207
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700207,
					"content": "…！？そのオーラ…まさか、教官ですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700208
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700208,
					"content": "教官？おまえ、オイラが寝てる間に千岩軍でバイトでもしてたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700209,
						716700210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700209,
					"content": "ええ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700211,
					"content": "私は方謹——この千岩軍の分隊のリーダーを務めています。参謀の蘇定から、お噂はかねがね…百年に一人の素晴らしい才能をお持ちとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700212
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700212,
					"content": "西風騎士団の栄誉騎士は、緊急時には隊長級の指揮権を有すると聞きます。教官という呼び方も、あながち間違いではないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700213
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700213,
					"content": "そんなことより、玉衡様のところへご同行願えませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700214
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700214,
					"content": "刻晴もいたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700215,
					"content": "ってことは、事態はそう単純じゃなさそうだ。一発殴って解決、とはいかないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700216,
					"content": "玉衡様——予想通り、旅人と副官のパイモンが来てくださいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700217
					],
					"speakerTitle": "方謹"
				},
				{
					"id": 716700217,
					"content": "ご苦労さま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700218
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700218,
					"content": "久しぶり。相変わらず、情報が入るや否や、すぐ前線に駆けつけるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700219,
						716700220
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700219,
					"content": "手伝いに来てあげた！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700221,
					"content": "手短に話すわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700222
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700222,
					"content": "ここの地脈の穢れは長い間安定していたんだけど、なぜか最近急に活発になって、魔物の襲撃事件を何度も引き起こしているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700223
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700223,
					"content": "溢れ出る魔物を排除した後も、乱れが収まらなくて、触れた者を奇妙な秘境へと送り込んでいる…今までにないことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700224
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700224,
					"content": "おかしいな…まさか、この地脈の穢れが…行き来できるポイントになってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700225,
					"content": "こんな人数じゃ足りないんじゃないのか？早く増援を呼ぼうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700226,
					"content": "それなら心配はいらないわ。今のところ、防衛線はとても安定している。みんな帰離原からの精鋭部隊で、経験豊富な兵士ばかりなの。一騎当千と言っても過言ではないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700227
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700227,
					"content": "ただ…厄介なことに、地脈の乱れを引き起こした根本的な原因が見つからないの。このままずるずるとここに駐屯していても、人と資源を浪費して、部隊を疲弊させるだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700228
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700228,
					"content": "敵の弱点を狙って、無駄なく兵を遣るべきだわ。受け身ばかりでは、いつまでも勝てないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700229
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700229,
					"content": "確かにな…殴られるたびに反撃だなんて、そんなのやってられないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700230,
					"content": "すでに夜蘭が部下を連れて秘境を調査しているわ。あと数時間もしたら、重要情報を持って帰ってくるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700231
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700231,
					"content": "あら、ごめんなさい。玉衡様が旅人と心ゆくまでおしゃべりできるように、ゆっくり帰ってきた方が良かったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700232
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700232,
					"content": "うわっ、いつからいたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700233,
					"content": "早かったわね。調査、うまくいかなかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700234
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700234,
					"content": "半々ってところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700235
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700235,
					"content": "良い知らせとしては、大まかな状況は見えてきたわ。今回の異常現象は、地脈の乱れの余韻によるものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700236
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700236,
					"content": "既存のサンプルの調査結果と、軍事史の記述を照らし合わせた結果…地脈は記録のある悲惨な戦いを秘境の中で再現していることがわかったわ。溢れ出る魔物もその一部でしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700237
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700237,
					"content": "地脈の乱れ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700238
					]
				},
				{
					"id": 716700238,
					"content": "旅人はピンと来るんじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700239
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700239,
					"content": "モンドでも似たような現象が起きたそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700240
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700240,
					"content": "幸い、その時の状況はそれほど深刻ではなく、栄誉騎士と闇夜の英雄が力を合わせて、地脈の穢れから湧き出る魔物を排除し続け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700241
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700241,
					"content": "地脈に蓄えられた「情報」をすべて消費することで、最終的には正常な状態に戻ったとか。つまり、消耗戦で勝利を収めたというわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700242
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700242,
					"content": "あの時と同じことが起きてたのか…どうりで今回も赤いわけだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700243,
						716700244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700243,
					"content": "その栄誉騎士って誰だろう？すごい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700245,
					"content": "なるほど、あくまで軽快にあしらうことで、暗に今の自分ならもっと出来ることを伝えて報酬を吊り上げようって魂胆ね。大丈夫、今回はがっかりさせないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700246
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700246,
					"content": "えっ…な、なにいってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700247,
					"content": "それで、悪い知らせのほうは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700248
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700248,
					"content": "ええ、見ての通り、今回の地脈の乱れは今までとは違う。外に出た魔物を片付けるだけでは不十分よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700249
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700249,
					"content": "全ての魔物を排除しながら、一気に秘境の最深部に向かわないと、何度でも繰り返されるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700250
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700250,
					"content": "それに、乱れ地点に繋がる秘境には、なにか特殊なルールがあるみたいなの。私と兵士たちを警戒し、捜査を拒んでいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700251
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700251,
					"content": "最初は、秘境の中にある物を採取したりもできたんだけど、奥へと進むうちに兵士たちは衰弱して、いつもの力を発揮できなくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700252
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700252,
					"content": "進むにつれて魔物もどんどん凶暴になるし、性質も多種多様になって…かなり手ごわかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700253
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700253,
					"content": "地脈による制限を受けずに済む者だけが、妨害を無効化して、そこに存在する特殊なルールを調べられるみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700254
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700254,
					"content": "そういう人材が兵を率いれば、危険な環境を乗り越え、地脈の乱れを根本から是正することができるでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700255,
						716700256
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700255,
					"content": "理解した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700257,
					"content": "つまり、地脈の乱れが活動を休止するまで、外で魔物を退治し続けるか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700258
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700258,
					"content": "旅人が兵を率いてその中に突入し、その源を制圧するかってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700259
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700259,
					"content": "二つのプランを考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700260
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700260,
					"content": "凝光に連絡して、防衛費を増やしてもらうわ。開陽にも、すぐに後続の交替部隊を手配するように伝えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700261
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700261,
					"content": "あれ？この流れでそのまま旅人に依頼しないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700262,
					"content": "璃月の安寧を守るのは、千岩軍と七星の使命。人員をなるべく危険から遠ざけるのが、指揮者の責務よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700263
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700263,
					"content": "私個人の気持ちからしても、君にすべての危険を背負わせたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700264
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700264,
					"content": "だから、気が乗らないなら千岩軍を長期的に駐屯させ、複数の部隊を交代で作戦に投入し、兵士の育成を兼ねて魔物を討伐させることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700265
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700265,
					"content": "同時に斥候を派遣して秘境内の情報を収集し、その特性を引き続き調べるわ。ゆくゆくは部隊を率いて、一気に制圧できるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700266
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700266,
					"content": "もちろん、君が手伝ってくれると言うなら、駐屯部隊の総力をあげて支援するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700267
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700267,
					"content": "地脈の乱れを効果的に抑制できたら、それ相応の報酬も支払いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700268,
						716700269
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700268,
					"content": "#{M#俺}{F#私}には手伝う義理がある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700270,
					"content": "そうだな。璃月の仲間としても、最強冒険者コンビとしても、刻晴と夜蘭の友達としても、見て見ぬふりなんかできないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700271
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700271,
					"content": "報酬については最初から心配してないぜ。刻晴も夜蘭も、オイラたちをぞんざいに扱わないって分かってるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700272
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716700272,
					"content": "いい目ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700273
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700273,
					"content": "ありがとう——じゃあ、協力をお願いするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700274
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700274,
					"content": "夜蘭、旅人を秘境の奥へ連れていくよう部下に知らせて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700275
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716700275,
					"content": "待って、まずは分析しないと。乱れ地点は周期的に状態を変化させている。慎重に行くべきよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700276
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716700276,
					"content": "旅人もその間に準備してちょうだい。最善のチームを組んで、激戦に備えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701201
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701201,
					"content": "チャンスよ。今入れば、秘境の中心に入っていけるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701202
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701202,
					"content": "大事なのは進みながら「ルール」を見極め、適切な方法で敵を倒すことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701203
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 716701203,
					"content": "周りの環境や味方の状況に注意しながら、慎重に進んでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701204
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701204,
					"content": "事態が思わしくない時は、一時撤退して態勢を整えてもいいのよ。無理はしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701205
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701205,
					"content": "無事の帰還を祈ってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701206,
						716701207
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 716701206,
					"content": "全力を尽くす！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716701208,
					"content": "おう！刻晴、夜蘭、朗報を待っててくれよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716701207,
					"content": "頑張って戦う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716700269,
					"content": "一緒に戦う仲間もたくさんいる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700256,
					"content": "#{M#俺}{F#私}以外にいないってことだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700244,
					"content": "そんなことあったっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700220,
					"content": "大げさだね——頑張るけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700210,
					"content": "#{M#俺}{F#私}が教官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700204,
					"content": "気を抜かずに、戦いの準備を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				}
			]
		},
