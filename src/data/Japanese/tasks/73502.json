			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "「昼間と交代する昼間、橋の上から退勤する灯台の後ろ姿が見える。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 735020102,
					"content": "な、なんだコレ…謎解きか？それとも諺とか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735020103,
					"content": "昼間と交代する昼間？た、退勤する後ろ姿…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735020104,
					"content": "旅人じゃないか！あんたらもデルースさんの謎解きに興味があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020105,
					"content": "これ、本当に謎解きなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "ああ、この謎解きは教令院の学者、デルースさんが出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020108,
					"content": "俺の知る限り…あの人は教令院でも変人と呼ばれているらしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020109,
					"content": "彼は人とあらゆる種類の謎解きについて議論したり、色々な暗号を研究したりするのが好きなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020110,
					"content": "だが、彼の謎解きには難解すぎるものもあって…そのせいで、彼と交流しようとする人は滅多にいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020111,
					"content": "そこで、こういう「なぞなぞに報酬をつける」方法を編み出したってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020112,
					"content": "簡単に言えば、この謎解きはとある「宝蔵地」を示している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020113,
					"content": "正しい時間に、正しい方法で、正しい場所に到達できれば、宝を手に入れられるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020114,
					"content": "それから、デルースさんはヒントもくれた。これらの「宝蔵地」は、どれもスメールシティの中にあるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020115,
					"content": "だが…見ての通り、この謎解きを解いた冒険者は今までに一人もいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020116,
					"content": "もし興味があるなら、あんたも試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020117,
					"content": "まあ、俺に言わせれば、もっと重要なことを優先したほうがいいと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カマル"
				},
				{
					"id": 735020106,
					"content": "なぞなぞの出題者を知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デルース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "今日も誰も来ないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020302,
					"content": "これが「知識の殿堂の正門」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "そう、ここが「知識の殿堂の正門」だ！ど…どうやら君は、俺のすべての謎解きを解いたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020304,
					"content": "よかった！今日も誰も解けないんじゃないかと思っていたんだ！もう少しで昼食を取りに戻るところだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020305,
					"content": "どうして謎解きを作るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "もちろん、「面白い」からだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020307,
					"content": "即答したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735020308,
					"content": "それ以外に、俺が謎解きを作る理由があると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020309,
					"content": "まさか、俺が他人を困らせて楽しんでいる…とでも思っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020310,
					"content": "どうだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "はははっ、それじゃ君たちも教令院の連中と同じだ、俺を誤解している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020313,
					"content": "俺がなぞなぞを作るのは、単純に謎解きを解くときの考え悩む感覚が好きだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020314,
					"content": "俺の謎解きを振り返ってみれば、そこには必ず謎解きを解くための「キーワード」があると気づくだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020315,
					"content": "そのキーワードを突破口にして考え続ければ、必ず謎解きは解ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020316,
					"content": "もし俺が人を困らせたいだけなら、すべての手がかりを消して、この謎解きを本当に「解けない謎解き」に変えているさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020317,
					"content": "それはともかくとして、俺の謎解きを解いた君たちに報酬を渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020318,
					"content": "これは君たちが自分で「考え」て勝ち取った報酬だからな、ちゃんと受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デルース"
				},
				{
					"id": 735020311,
					"content": "なんとも言えない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
