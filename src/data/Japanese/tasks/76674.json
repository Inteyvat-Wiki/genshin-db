			"dialogs": [
				{
					"id": 766740101,
					"content": "予想外の仕上がりね。もし誰かがここに迷い込んだら、きっと魔女の力に感心するでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740102,
					"content": "もし誰かがここに迷い込んだら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "うーん…どんな人かによるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740105,
					"content": "導きは、貪欲や怠惰を招きやすいの。あなたたちのように自分の力で道を切り開く人なら、喜んで手伝うけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740106,
					"content": "希望をすべて魔女に託して、働かずして何かを得ようとするような人たちは…ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740107,
					"content": "まさか、彫刻に変えたりしないよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766740108,
					"content": "そんなことはしないわ。そういう人たちは、ここから連れ出して秘聞の館に導くの。あたしよりも、あのネフェルという女性のほうが、彼らとの接し方を心得ているはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740109,
					"content": "何の代償も支払わずに望みを叶えられるなんておいしい話はないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				},
				{
					"id": 766740103,
					"content": "その人の願いを叶えてあげるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
