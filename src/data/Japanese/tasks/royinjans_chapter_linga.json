			"dialogs": [
				{
					"id": 730280101,
					"content": "ここには巨大ロボットの部品もあるみたいだ。ジャザリーさんが見たら、きっとまた写真機を取り出すぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280102,
					"content": "そういえばアランラキャ、秘密基地のデカいパーツは自分が運んだって言ってたよな。まさかほんとのことじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280103,
					"content": "ほんとに決まってるでしょ。アランラキャ、ナラに嘘つかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730280104,
					"content": "やっぱり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "昔、子供たちと一緒に秘密基地で遊んでたアランナラって、アランラキャのことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280107,
					"content": "でも、アランラキャも全部忘れちゃってるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280108,
					"content": "ノートに書いてあった花と関係してるのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "うん。マウティーマ稠林のアランナラに花をもらった後、なにもかも忘れちゃったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280111,
					"content": "あいつら三人も、オイラたちみたいに冒険したんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280112,
					"content": "アランラキャ、それがなんの話か分からないし、思い出せない。でも、小さいナラと遊ぶのは楽しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "アランラキャ"
				},
				{
					"id": 730280113,
					"content": "うん。いつもご機嫌でいられるといいな、アランラキャ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730280109,
					"content": "前にも同じような事があった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "#{M#俺}{F#私}の推理が確かなら…",
					"roleType": "TALK_ROLE_PLAYER",
