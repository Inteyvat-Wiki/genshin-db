			"dialogs": [
				{
					"id": 761870401,
					"content": "このお菓子、すっごくおいしいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "マメール"
				},
				{
					"id": 761870402,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761870404,
					"content": "えっ！？もうそんな時間？今日はありがとう——お菓子、おいしかったよ！また会おうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マメール"
				},
				{
					"id": 761870403,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
