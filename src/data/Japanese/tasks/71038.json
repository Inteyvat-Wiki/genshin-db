					"nextDialogs": [
						710380406
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710380406,
					"content": "お願いします…ゴホッゴホッ…そんな目で、見ないでください…私たちに、失望しないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380407
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710380407,
					"content": "金色の城…黒の宮殿…ゴホッ！天より現れし使者たちが離れ…",
