	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志璇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "こんにちは、先輩！さあさあ、どうぞ座って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360402,
					"content": "冒険のことについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "どうして以前の私があんなにも頑なで、みんなをあそこまで心配させたか…それが聞きたいんですか？あはは…もうすっごく反省したので、説教は勘弁してもらえると助かります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360404,
					"content": "でもまあ、「危険」にこだわるのは、やはり我々冒険者の性なのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360405,
					"content": "私たちは生まれながらにして、強靭な脊柱と器用な四肢を持ってる…こんなに良い武器があるのに、波風のない生活を送るなんてつまらないじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360406,
					"content": "まあ、私も致命的なリスクについて、考えなかった訳ではありません。ですが…そうですね、一つ質問してもいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360407,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "モンドの大冒険者スタンレーは、燼寂海を越えたことで名を轟かせましたが…彼はあの冒険で、自らの親友を失いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360409,
					"content": "冒険のせいで亡くなった親友…彼の名を知る者は少ないですが、その記憶は今もなお冒険者たちの間で語り継がれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360410,
					"content": "私は思うんです…ええと、先に言っておきますが、幼稚だと思わないでくださいよ、先輩。スタンレーの帰らぬ友は…亡くなったわけでなく、正真正銘「生きている」のではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360411,
					"content": "一番大事なのは、命そのものだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "ですが、たとえ亡くなったとしても…人々の心に刻まれることで、生命が続いているとは言えませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360413,
					"content": "人々の憧憬と思い出、評価や見解の助けを借りて…別の方法で生きる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360422,
					"content": "あまり他人の目を気にしない方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "皆さんそう仰います。「自分らしくいればいい」「自分のことだけに集中すればいい」と…表面的には助言の言葉に聞こえますが、結局、諦めるよう説得しているだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360424,
					"content": "実際、前にも言ったように…私の冒険は、他人のためではなく…まして自分のためでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360425,
					"content": "えっと…先輩はこんな考えを持ったこと、ありませんか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360426,
					"content": "この世界は神々によって作られたもの…凡人である私たちは、たとえ神々の贈る「目」がなくとも、安寧と忘却に屈してはならないという執念を持っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360427,
					"content": "この悔しい気持ちは決して意味のないものではありません。その気持ちがあるからこそ、私は命がけで危険な場所を探索できるんです。なぜなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360428,
					"content": "弱き体と、神々でさえも恐れる永遠の力…それこそ、人が「人」でいられる理由だから…私はそう信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360429,
					"content": "冒険に意味を与えるのは自分一人じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "はい…分かっています。皆さんの手助けも、先輩にかけてしまった迷惑も忘れません…この冒険は、私一人の力ではないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360437,
					"content": "あははっ、それでこそ冒険者じゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360432,
					"content": "そんなに英雄になりたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "先輩に比べたら、私なんてまだまだです…英雄になりたいと言うよりは…「生きたい者こそ、死を恐れない」と言ったほうが正しいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360434,
					"content": "これは、スメールの先輩に教えてもらった言葉なんです。彼女は「エルマイト旅団」から聞いたと言っていましたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360435,
					"content": "この言葉、すごく理にかなっていると思います…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360436,
					"content": "いや…不吉なことを必死に追い求めてるって言ったほうが正しいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710360414,
					"content": "人の記憶に残るのも、ある種の成功だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "はい…ですが私は人生の「成功」なんて考えたこともありません。むしろその逆で、たとえ「失敗」したとしても、皆の印象に残るならそれでいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360416,
					"content": "少なくとも——「志璇のやつ、層岩巨淵に挑戦したんだってな！」って、言ってもらえるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360417,
					"content": "それに、無人の地で犠牲になった人々とは違って…今の私のようであれば、忘れ去られてしまうことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360418,
					"content": "そんなの考えたこともない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "そうですか…？それはきっと、先輩のように外から来られた方は、どこにいたって自然と注目される存在になるからじゃないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360420,
					"content": "お金持ちの家に生まれた子供が、貧困を必要のない刺激的な冒険だとしか思わないように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710360421,
					"content": "あっ、ごめんなさい…決して悪い意味ではなくて。私はただ…いえ、聞かなかったことにしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "志璇"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"瑾武",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "まったく志璇ったら、ビーコンを回収しに行ったきり…戻って来やしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380202,
					"content": "あの子の寄り道癖を知ってたから三時間もあげたって言うのに…もうかれこれ五、六時間経ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380203,
					"content": "あの子はあんたを尊敬してるから、連れ戻すのを手伝ってくれると助かる。誰かが事故に遭うのは御免だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710380204,
					"content": "まったく！どこに行ったんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
