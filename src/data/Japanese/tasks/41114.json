			"dialogs": [
				{
					"id": 411141501,
					"content": "すごい戦いぶりだったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141502,
					"content": "私を怒らせた罰です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141503,
					"content": "モナは強いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "当然です！パイモンもそう思ってますよね？ねっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141505,
					"content": "そうだな、モナがいなかったらもっと大変な目に遭ってたかもしれないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141506,
					"content": "フン、聞こえてますか！ファデュイの執行官！悪者めっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141507,
					"content": "でも、先ほどの彼は嘘をついているように見えませんでした。師匠が占星術を教えてくれた時に言っていた「偽りの空」には他の意味があるのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141508,
					"content": "…オホン、少し考え事をしてました。さあ、仕事しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>隕石の核心</color>はこの周りにあるはずだ！",
					"roleType": "TALK_ROLE_NPC",
