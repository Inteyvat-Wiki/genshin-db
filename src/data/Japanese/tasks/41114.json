			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "おおっ、これが核心か？他の隕石とは少し違うな！なんか…明るい感じ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141602,
					"content": "この石から凄まじい元素力と意志を感じます。核心で間違いありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141603,
					"content": "…壊した方がいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "ええ、壊さないとみんなは目覚めません……この核心が事件の根源ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141605,
					"content": "#{NICKNAME}、がんばれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141606,
					"content": "こういうことだったんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141607,
					"content": "未知の頂きに登ろうとしてたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "人類の信念が千年間も存在するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141610,
					"content": "ああ、占星学はやはりすごいですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141611,
					"content": "なんで急にそんな結論に！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141612,
					"content": "星と交流することで、全ての秘密が見えるからです。もちろん、それができる占星術師はそうそういませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141613,
					"content": "モナ、今回は本当にありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "きゅ、急にどうしたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141615,
					"content": "そういえば、フィッシュルは不思議な人でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141616,
					"content": "だよな！なんというか…あー…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141617,
					"content": "奇想天外な人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "確かにそうだけど、よく考えたら…彼女の言葉も間違ってなかったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141620,
					"content": "まさか、間違った方法で正解に辿り着けるタイプの人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141621,
					"content": "そうかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141622,
					"content": "ただ、とんがり帽子山が小さな島になってるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141623,
					"content": "かつての山が小さな島になって、船に乗れば簡単に行けるようになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141624,
					"content": "誰でもとんがり帽子山に登れるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141625,
					"content": "誰でも山頂に行ける。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "レーナルトはそれで喜ぶのか？きっとこんな結果は予想外だったろうな。けど、今のモンドの人々は風神の助けでみんな飛べるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141627,
					"content": "翼を手に入れた人々は、もっと遠くへ高い場所へ行ける、未知を発見できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141628,
					"content": "（彼の願いは叶ったんだろうか？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "さあ、隕石の核心の処理も終わったし、眠った人たちも目が覚めてると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141630,
					"content": "これで冒険者協会の依頼を無事完了したってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141631,
					"content": "うん…みんな早く目覚めるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "考え方が変わってる人だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "意志を未来に託そうとしたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}