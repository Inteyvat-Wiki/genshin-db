					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411140702,
					"content": "ですが、レーナルトという方が書いた本を知っています。一度図書館に行ってみてはどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411140703,
					"content": "ですが、レーナルトという方が書いた本を知っています。一度<color=#00E1FFFF>図書館</color>に行ってみてはどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
