			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "あった！冒険者手帳『山と海の書』、作者レーナルト！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141402,
					"content": "でも、足りないページがあるぞ、全然分からない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141403,
					"content": "はぁ…まさか無駄足になるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141404,
					"content": "諦めずこれをモナに見せてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "あっ、そうだよな、そうしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
