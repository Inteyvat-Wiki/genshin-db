			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "へえ？これがとんがり帽子山ですか？小さくなりましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141102,
					"content": "先客がいるみたいだぞ？ここは観光名所なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141103,
					"content": "あっ！おまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141104,
					"content": "う…うん？君たちか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141105,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "あの様子、まさか夢から覚めたばかりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141108,
					"content": "自力で目覚めるなんて…ありえないです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141109,
					"content": "フン、君たちにできないことが、僕までできないとは限らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141110,
					"content": "一歩遅かったな、僕の「研究」はもう終わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141111,
					"content": "やっぱりファデュイの仕業だったのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141112,
					"content": "そうカリカリするな、今日は時間がない。また今度にさせてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141113,
					"content": "待て！何が目的だ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "今まで雪山の夢の中にいましたよね？レーナルトのことは、どれくらい知っているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141115,
					"content": "レーナルト？何のことだ…まあいい、今は雑魚を気にしている場合じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141116,
					"content": "気付いてしまったんだ…恐ろしい、重大なことに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141117,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141118,
					"content": "何のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "星空自体、巨大な嘘なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141120,
					"content": "星空が…嘘？どういう意味ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141121,
					"content": "モナの占星術を否定する気か？でも、そこまで言わなくてもいいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141122,
					"content": "それに夜に空を見上げれば、星が見えるじゃんかよ。それが嘘なわけないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411141123,
					"content": "ハハッ…ハハハハハッ！甘い、甘すぎるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141124,
					"content": "まあ、君のせいじゃない。少し前まで僕もそう信じてたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141125,
					"content": "少し前まで？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411141126,
					"content": "フン、君たちの話に付き合ってる暇はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141127,
					"content": "「道化」のやつ…こんな任務を僕に任せて、事前に「発見」の可能性を教えないとは…僕を驚かしたかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141128,
					"content": "今から「真相」を確かめなければならない。失礼するよ、青二才ども！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 411141106,
					"content": "今まで寝てたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
