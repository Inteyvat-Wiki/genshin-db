			"trigger": {
				"objectNames": [
					"モナ",
					"フィッシュル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "ん？フィッシュルがオイラたちを待ってるみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140102,
					"content": "ちょうどよかったです。寂しいですが、言わなければなりませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140103,
					"content": "しばしの別れよ、同行者。あなたは勇気を見せてくれた。この風もあなたを称えるために吹いているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140104,
					"content": "えーーっ？なんで急にお別れなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140105,
					"content": "フィッシュル、行っちゃうの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "大隕石のせいで昏睡現象がひどくなっています。各地で人手が不足しているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140107,
					"content": "お嬢様と私は患者たちの世話を担当する故、あとはお任せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}…さよなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140109,
					"content": "あなたは最高の聞き手だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140110,
					"content": "普段、私と一緒に行動する冒険者たちは多くいるけど、そのほとんどがオズの偵察を目的としてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140111,
					"content": "今回の旅は、素晴らしい冒険の旅だった。こっちだって最後まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140112,
					"content": "ん？フィッシュルの話し方、いつもと違くないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140113,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140114,
					"content": "（あぁああ——ついうっかり普通に話しちゃった…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140115,
					"content": "つまり…勇敢で、知恵のあるあなたたちなら、どんな困難だろうと露と消えるでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140116,
					"content": "オズの「通訳」が逆になってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140117,
					"content": "オホン…あなたたちなら、真実にたどり着けるはずだ、という意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140118,
					"content": "…そ、そうよ、この皇女の従者だもの。断罪の騎士よ、みんなを闇から光の地に連れ戻すのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411140119,
					"content": "誰が従者ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140120,
					"content": "オズ、フィッシュル、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "またお会いできる日を楽しみにしています。全てが終わった後、さけっ、コホン、お茶でもしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411140122,
					"content": "はぁ、いい協力者だったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140123,
					"content": "それより、いいお知らせです。新たな発見がありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140124,
					"content": "大隕石から採集した砂塵を占いに使ったところ、とある情報が見つかったのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140125,
					"content": "この隕石には千年以上の歴史があり、レーナルトは昔の人であることが分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140126,
					"content": "隕石は彼の意志を運び続けました。つまり千年以上もの間、彼の願いはまるで弱まることがなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140127,
					"content": "山頂に登りたいと切望する人間…きっとあなたと同じ冒険者だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140128,
					"content": "冒険者？道理で雪山に登りたがってたわけだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140129,
					"content": "今までは時間を掛ければ答えを導き出せていましたが、今度は考えを変えて、根本から問題を解決しないといけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140130,
					"content": "そうだな！今はそのレーナルトってやつを調べるべきだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140131,
					"content": "ええ…もし隕石に願いが乗せられているとなると、フィッシュルの言った通り、それは「呪い」です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140132,
					"content": "まさか先に言い当てられるとは…まあいいです、優秀な占星術師はこれしきのこと気にしませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140133,
					"content": "とにかく、呪いを解きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140134,
					"content": "早速出発しよう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140136,
					"content": "昔の冒険者を調べるなら、まず<color=#00E1FFFF>冒険者協会</color>に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
