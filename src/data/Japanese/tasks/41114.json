			"dialogs": [
				{
					"id": 411140801,
					"content": "作者、レーナルト…レーナルト…あった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140802,
					"content": "レーナルトが書いた本は図書館<color=#00E1FFFF>一階</color>の<color=#00E1FFFF>北西側</color>にあるらしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140803,
					"content": "北西…あっちだな！",
					"roleType": "TALK_ROLE_NPC",
