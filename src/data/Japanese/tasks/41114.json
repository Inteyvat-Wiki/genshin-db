				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "本を見つけたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140902,
					"content": "見せてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140903,
					"content": "欠損があって、内容が繋がってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "まあ、そんなことだろうと思いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140905,
					"content": "普通の占星術師ならここで諦めるでしょうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140906,
					"content": "しかし、このモナは未来の占星術を担う者、これぐらい造作もありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140907,
					"content": "不足している部分を星盤で推算して、解読すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140908,
					"content": "ふう——！読み終わりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140909,
					"content": "どんな内容なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140910,
					"content": "想定通り、レーナルトは2000年前の冒険者です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140911,
					"content": "「とんがり帽子山」という雪山に登るのが彼の夢でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140912,
					"content": "2000年前？じゃあ、あの隕石は…そいつの「命ノ星座」！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140913,
					"content": "彼の命ノ星座はある原因で召喚されました。この点に関しては、ファデュイが関係してると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140914,
					"content": "確かに、あいつら変わったことばかりするからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140915,
					"content": "隕石にある元素力は、暗示という形で周りの住民に影響を及ぼし夢を見せました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140916,
					"content": "私の考えが正しければ、隕石の中には核心のような存在があるはず、それがレーナルトの精神の結晶です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140917,
					"content": "どこにある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "仮に私がレーナルトでしたら、きっと夢見ていた場所に行こうとするはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140919,
					"content": "とんがり帽子山にあるってことか？でも…どこだ？聞いたことないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140920,
					"content": "私も初めて聞きました。本にあった地図と今のモンドの地形を比較すると、とんがり帽子山はもう存在しないことが分かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140921,
					"content": "雪山が消えるなんてことあり得るのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411140922,
					"content": "風神バルバトスは人々のために氷雪を飛ばし、モンドの地形を変えたと、そう本で読みました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140923,
					"content": "かつての山は海に沈んでしまっているのです。しかし、それほどの高い山であれば、海中に沈んだとしても何かしら痕跡が残ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140924,
					"content": "——その痕跡とは海面から顔を覗かせる山頂部分です、そして今の名を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>「マスク礁」</color>と言います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
		{
			"id": 4111411,
