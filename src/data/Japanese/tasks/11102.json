			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "お前たちか…お前たちのことはよく覚えている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020202,
					"content": "ここ一帯で「妖魔」に憑かれたものを片付けていたんだが、どうやら邪魔したようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020203,
					"content": "（あれ、なんだか素直になってないか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020204,
					"content": "ここで妖魔退治してたのか、邪魔なんかじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020205,
					"content": "この魔物が変異したのも、我を取り巻き、我を汚染する「業障」のしわざだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020206,
					"content": "変異、業障…あれ、もしかして…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020207,
					"content": "『護法仙衆夜叉録』にあった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "たしか、魈には「護法夜叉」っていう別名があったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020210,
					"content": "そういうことだったのか…うぅ、うぅぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020211,
					"content": "かわいそうな魈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020212,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020213,
					"content": "#さっき本で{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の過去を知った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "あぁ、数百年前のくだらない物書きが書いた戯言か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020216,
					"content": "諸行無常、一切皆苦。同情と泪は、夜叉の意志には必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020217,
					"content": "我の亡き同士たちも、後世に語られるために戦ったのではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020218,
					"content": "うぅ、ご…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020219,
					"content": "構わない。まだ邪気が強くなってきている洞天がある、もう行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020220,
					"content": "オ、オイラたちも連れてってくれ！絶対役に立つから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020221,
					"content": "必要ない、我は一人で行動する方が好きだ。それに変異の原因が我であっては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020222,
					"content": "さっきのお詫びに！…ダメか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020224,
					"content": "…ついてこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 111020214,
					"content": "さっき『護法仙衆夜叉録』を読んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "魈が「最後の夜叉」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
