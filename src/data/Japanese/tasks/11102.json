			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "ここの邪気はなんだか身の毛がよだつぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020402,
					"content": "「靖妖儺舞」を使い、ここの「業障」を断つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020403,
					"content": "平常心を保つことに集中しろ、魔神の邪念に呑み込まれるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "「妖魔」に憑かれたやつがこんなに…少しでも遅れてたら、大変なことになっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020602,
					"content": "さっきお前たちが言っていた、「掇星攫辰天君」とは何者だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020603,
					"content": "オイラが説明しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020604,
					"content": "「願いを叶える仙人」などに騙される人がいるなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020605,
					"content": "仙人である魈には、願いを叶える力ってあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020606,
					"content": "昔の璃月には、労せずして得ようとする者はいなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020607,
					"content": "数千年前の璃月の民が必要だったのは、自分たちの住む所を守る力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020608,
					"content": "でも今の時代の人々にとっては、願いを叶える仙人の方がいいんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020609,
					"content": "この時代がどれだけ軟弱であろうと、我とは関係ない。我は帝君の意志に従うのみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020610,
					"content": "オイラまた間違ったことを言ってしまったみたいだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020611,
					"content": "そ…そうだ！あの偽仙人は「禁忌滅却の札」っていう魔を退治できるものを持ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020612,
					"content": "そんなもので退治を？ふん…愚かな。消さずして退治など、どうりで全てここに集まるわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020613,
					"content": "このままでは、我の手に負えなくなる…「禁忌滅却の札」をそいつの手から回収する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020614,
					"content": "「回収」だけじゃ足りないよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "やっぱりオイラの仲間だぜ！オイラもそう思ってたんだ。オイラたちを騙したあいつを懲らしめてやらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020617,
					"content": "ちょうどこっちには正真正銘の仙人もいるしな…魈が手を出せば、もう二度と仙人を名乗れないと思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020618,
					"content": "いや。我が討つのは妖魔のみ、人は殺さない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020619,
					"content": "いや、殺すとは言ってない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020621,
					"content": "確かにそいつが悪行をやめれば、璃月にとっても有益なことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020622,
					"content": "我に「夢遊諸境法」という術がある。本来は眠りについた魂と体を引き離すのに使うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020623,
					"content": "これを応用すれば、他人の魂を呼ぶこともできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020624,
					"content": "うわっ！これが本当の仙法か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020625,
					"content": "「夢枕」的な？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "これを行うには儀式をする必要がある。悪いが…香炉を一つ、七星灯を七つ、それと温度を下げられる物を少し用意してくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020628,
					"content": "温度を下げられる物…霧氷花とかがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020629,
					"content": "でも香炉と七星灯はそこら辺に落ちてるものじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111020630,
					"content": "天衡山南部の道路わきに、「夜叉石像」が二体あるのは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020631
					],
