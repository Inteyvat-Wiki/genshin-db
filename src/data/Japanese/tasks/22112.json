					"speakerTitle": "淮安"
				},
				{
					"id": 221120202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "旅館の下の方に置いてありますから、すぐ見つかるはずだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120204,
					"content": "探してきてもらえませんか？また誰かがうっかり転落しないように、私はここで見張っておきます…",
					"roleType": "TALK_ROLE_NPC",
