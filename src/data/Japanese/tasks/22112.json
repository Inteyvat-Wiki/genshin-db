					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "補修しないとだめですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "おや、あなたでしたか。見てください、上への階段が壊れてます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120104,
					"content": "このままでは、転落事故が起きてしまいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120105,
					"content": "なぜ壊れたかって？ああ、少し前に旅館に入ろうとする魔物がいましてね、私が相手をしたんですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120106,
					"content": "つい本気を出してしまって、デカブツを階段のほうに飛ばしたら、そのまま階段も壊れました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120107,
					"content": "補修しようと思いましたが、なかなか時間がなくて…しかし今お客様が増えてきましたし、さすがに放置するわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120108,
					"content": "補修は私一人でなんとかできますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120109,
					"content": "もし時間があったら、木の板を持ってきてもらえますか？誰かがうっかり転落しないように、私はここで見張っておきます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "ではお願いします。木の板はもう買っておきました。旅館の下の方に置いてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120112,
					"content": "そこからいくつか持ってきてもらえると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120113,
					"content": "また壊れたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "ハハハッ、今度は壊さないように手加減しますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120115,
					"content": "とにかく、まずは補修です。そのためにわざわざ木の板を買っておきました。旅館の下の方に置いてあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120116,
					"content": "持ってきてくれると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
		{
