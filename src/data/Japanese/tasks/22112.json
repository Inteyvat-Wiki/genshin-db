			"dialogs": [
				{
					"id": 221120501,
					"content": "よし、これで大丈夫でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120502,
					"content": "違和感がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "違和感、ですか？仕方ありません、職人さんでもないですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120504,
					"content": "ふう…しかしこれとは別に、補修しないといけない所がもう1箇所あります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120505,
					"content": "まあ、今日はここまでにしましょう。旅館はまだ営業中ですからね、お客様のところに行きませんと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120506,
					"content": "階段の補修に旅館の商売、なかなか大変ですよ…さて、報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
