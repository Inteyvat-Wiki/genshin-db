				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "ご厚意に感謝します。ですが、私は西風教会のシスターですので、個人的な贈り物を受け取るわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "ハンネローレ"
				},
				{
					"id": 708190202,
					"content": "私にとっては、このような潮風に乗る素晴らしい香りを感じられただけで、もう十分なのです。美しいものを独占せず、風の中に残しておくことこそが、敬虔な信徒のなすべきことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "ハンネローレ"
				},
				{
					"id": 708190203,
					"content": "ですが、南風のように穏やかなあなたのそのご厚意は、確かに受け取りました。お礼として、こちらの本を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "ハンネローレ"
				},
				{
					"id": 708190204,
					"content": "風神のご加護があらんことを。あなたの進む道が、この香りのように美徳と自由、そして仁愛に満ちたものでありますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハンネローレ"
				}
			]
		},
