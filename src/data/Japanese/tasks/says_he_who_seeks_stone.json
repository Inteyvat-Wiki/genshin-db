			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "本当に「老石」だ…感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740402,
					"content": "あんたらに任せて正解だったよ。冒険者協会に頼んでたら、こんなに早く見つからなかっただろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740403,
					"content": "それはどうかな。もしかしたら冒険者協会も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740404,
					"content": "#{M#俺}{F#私}たちにお願いするかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "確かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740406,
					"content": "冒険者…そうだな、実は昔は、羨ましく思ってたんだ。冒険者たちは毎日あちこちを駆け回って、どんなところへも行けるかのようだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740407,
					"content": "層岩巨淵に派遣されてからもう何年も経つのに、俺は層岩巨淵の頂上…丹砂崖にすら行ったことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740408,
					"content": "おまえ、行ったことなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740409,
					"content": "丹砂崖はなんというか、「有名だけど、地元の人はほとんど行かない観光地」みたいなところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740410,
					"content": "まあ、すごく近いから、時間があればいつでも行けると思ってるんだろうな…結局、一度も行かなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740411,
					"content": "じゃあ早速行ってみようぜ！今すぐ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740412,
					"content": "思いついたらすぐ行動に移すってことも重要だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740413,
					"content": "いや、遠慮しておく。今は暇じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740414,
					"content": "それに、使い走りみたいなことは、冒険者たちに任せたほうがいいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740415,
					"content": "彼らが訪れるのは、とても危険な場所だ。もし俺が着いて行って途中で怪我をしたら…足手まといになってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740416,
					"content": "確かに、ケガしたら大変だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740417,
					"content": "もしも俺が怪我でもしたら、下にいる探検隊の管理も、鉱夫たちの安全検査も回らなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740418,
					"content": "それに、ちょっとでも問題を起こしたら、深刻な事態になってしまうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740419,
					"content": "色々事情があったんだな…てっきり、沐寧は怪我するのが怖いだけなんだと思ってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740420,
					"content": "層岩巨淵の周りに立ちはだかる高い崖や深い滝…それに岩王帝君が残した古戦場のような危険な場所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740421,
					"content": "それらに近寄る気は一切ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740422,
					"content": "ほら、老石3枚の報酬だ。輝山庁の方はまだ老石を必要としているから、見つけたら持ってきてくれ。3枚ずつ回収するから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740423,
					"content": "もちろん、相応の報酬は準備しておく。老石を手に入れたら来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740424,
					"content": "おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
