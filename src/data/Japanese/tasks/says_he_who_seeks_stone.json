				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "また「老石」三個だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740602,
					"content": "「親切な民」二人から頂いた「老石」、確かに受け取った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740603,
					"content": "もう二個も見つけてくれたのか。しかも品質もこれまで見たものより遥かに優れている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740604,
					"content": "はぁ…これは、俺が昔持ってたやつを思い出させるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740605,
					"content": "おまえも持ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740606,
					"content": "#持ってるのに{M#俺}{F#私}たちに探させたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "「昔」持ってただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740609,
					"content": "その「老石」は盛露庁にいた父が持っていた端材で、品質もいまいちだった。だからおもちゃとして俺に渡してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740610,
					"content": "あの頃は定職にも就かずにぶらぶらしてた。毎日のように父と喧嘩しては、岩上茶室に居座ってたよ。借金までして、俺は絶体絶命だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740611,
					"content": "ええっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740612,
					"content": "酷かったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "ああ、正に若気の至りだったよ。とにかく、俺が窮地に陥ったとき…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740614,
					"content": "あれを「老石」だと見抜いた人物が現れたんだ。俺はただの石だと思ってたから、その石をモラに変えて窮地を何とか乗り越えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740615,
					"content": "そしたらこの間、父に「沐寧、昔お前が遊んでた石はどこにやった？」と聞かれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740616,
					"content": "「ただの石だ。まだ持ってるわけないだろ。」としか、答えようがなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740617,
					"content": "そう答えながらも、心の中ではずっとモヤモヤしてた。もしあのとき石を売らなければ、父に見せてやれたのにってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740618,
					"content": "…まあいい、こんな話をしても無駄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740619,
					"content": "おまえは正しい道に戻ってこれたんだから、もう大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740620,
					"content": "そうだな…それでも借りた金はコツコツと返さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740621,
					"content": "この話は終わりだ。「老石」があったら、持ってきてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740622,
					"content": "まだ足りないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "そうだな、あと三個だ。あと三個探してくれれば足りるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740625,
					"content": "老石は元から希少な鉱物なんだ。たとえ輝山庁がこれ以上の数を求めているとしても、恐らく層岩ではもう見つからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740623,
					"content": "あとどれくらい必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "まずは自分のを上納するべきじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
