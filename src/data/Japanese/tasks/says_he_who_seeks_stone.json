					"沐寧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740101,
					"content": "「老石」…はぁ…層岩巨淵に来てからもう何年も経つって言うのに、「老石」なんかにはほとんどお目にかかったことがない。輝山庁のお偉いさんたちよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740102,
					"content": "自分で探しに来てみろって言うんだ。そしたらこの作業がどれだけ大変か、理解できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740103,
					"content": "沐寧——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740104,
					"content": "おお、あんたたちか。まだ層岩巨淵の上層にいたとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740105,
					"content": "あっ…もちろん、歓迎してないわけじゃないぞ！その…他に急ぎの用事はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740106,
					"content": "なんだよ。なんだか悩んでるみたいだったからあいさつしに来てやったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740107,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "はぁ…あんたら、「老石」のことは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740110,
					"content": "あれは鉱区でも滅多に出ない珍しい鉱物なんだが、長年層岩巨淵で働いてきた俺でも二、三個しか見たことがない。まさに誰も想像できないような、立派な宝石なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740111,
					"content": "中でも、最も高品質のものは、後光が差すかのように見え、その色合いはまるで夕暮れ時の海と空を隔てる水平線のような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740112,
					"content": "これのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "…あっ…なんてことだ、持っているとは…しかも、今まで見てきた中でも最上級の老石じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740114,
					"content": "#頼む、{NICKNAME}…その「老石」を売ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740115,
					"content": "あり得ないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "そうだぞ。これは友達から貰ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740118,
					"content": "それに、これを買えるほどのお金を持ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740119,
					"content": "お上のご要望だから、金の問題はない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740120,
					"content": "お上の要望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740121,
					"content": "そうなんだ。実は輝山庁のお偉いさんたちが、なぜか急に「老石」に興味を持ち始めてな。層岩巨淵で探してくるよう言われたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740122,
					"content": "しかし、俺は毎日ごまかし…コホン、公務の対応で忙しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740123,
					"content": "そうだ、あんたに「老石」探しをお願いする代わりに、輝山庁の報酬をあげよう。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740124,
					"content": "それに、「老石」でさえあれば、あんたが持ってるそれと同等の品質じゃなくたっていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740125,
					"content": "輝山庁の報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740126,
					"content": "本来は自ら探すべきなんだが、最近の層岩巨淵は色々あって大変でな。手が回らないから、あんたたちに頼むしかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740127,
					"content": "はぁ、輝山庁のお偉いさんたちがどれくらい必要としているのかも分からない。とりあえず、3枚持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740128,
					"content": "そうかそうか、分かったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740116,
					"content": "絶対に譲らない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "何か困ったことでも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
