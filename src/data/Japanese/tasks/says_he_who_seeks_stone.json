				},
				{
					"id": 710740803,
					"content": "一巨獣一闘争の労だ、気にするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740804,
					"content": "「一挙手の労」でしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "おお！オイラが言いたかったのは…こんなこと、巨獣と闘うのと同じくらい楽勝だぜってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740806,
					"content": "パイモンが言い訳してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "ははっ…パイモンの言う通りだな。二人が海魔と戦った功績は知っている。これしきのこと、きっと朝飯前だったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740808,
					"content": "その通り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "まさか総務司に入っても尚、「層岩での老石探し」のような仕事を担当するとはな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740811,
					"content": "そう言えば、その昔親父さんと喧嘩ばかりしてたおまえが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740812,
					"content": "どうやって総務司に入ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740813,
					"content": "昔は大きな借金を抱えてたって言っただろ？行くあてもなかったが、家にも帰れなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740814,
					"content": "そしたら、借金取りは父を探して盛露庁まで押しかけてきて…あのときは、父にこっぴどくやられて足の一つでも折られるんじゃないかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740815,
					"content": "でも、足は大丈夫そうだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740816,
					"content": "それは…恥ずかしながら、父は借金を返済してくれた上、道で行き倒れていた俺を見つけ出してくれたんだ。「お前の借用書は全部俺が持っている。これからは俺に金を返すんだ」と父は言った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740817,
					"content": "そして借金を理由に…仕事をさせられたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740818,
					"content": "なるほど、じゃあ今は親父さんからお金を借りたことになってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740819,
					"content": "その通りだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740820,
					"content": "当時は借金取りに追われて、夜もぐっすり眠れないほどだった。だから、二度目の機会をもらった俺は、今度こそ絶対に変わろうと誓ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740821,
					"content": "その機会をくれたのが、いつも揉めていた父だなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740822,
					"content": "父はいつものように俺と揉めたりはせず、真摯に話し合ってくれた。はぁ…もっと早くそうやって話し合うべきだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740823,
					"content": "でももしあの頃から父に話し合う気があったとしても、俺は聞く耳を持たなかっただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740824,
					"content": "親父さん、おまえに優しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740825,
					"content": "そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740826,
					"content": "だから何があっても、この仕事をこなさないといけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740827,
					"content": "今回の層岩の事も、輝山庁の「老石」探しの雑用も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740828,
					"content": "#今回は{M#俺}{F#私}がやってあげたんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "他人の力を借りるのも、仕事の内さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740830,
					"content": "でも今回は本当に、あんたらのおかげだ。こんなに早く終わるなんて思ってもみなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740831,
					"content": "へへっ、ちゃんと分かってるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710740809,
					"content": "全く苦労がなかったわけじゃないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
}