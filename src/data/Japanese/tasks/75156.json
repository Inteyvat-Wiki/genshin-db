			"dialogs": [
				{
					"id": 751560101,
					"content": "うぅ、やっと竜運搬車から出られたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560102,
					"content": "はぁ、この中って蒸し暑いし、変な匂いがするし…半日いただけなのに寿命が二、三年は減っちゃった気分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560103,
					"content": "あれ？今回はどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "あっ、恩人様！旅の途中でまた会える…ううん、またあなたに助けられるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560105,
					"content": "恩人様、この前会った時に、私はコヌラフで、「謎煙の主」の見習い祭司だって言ったの、覚えてるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560106,
					"content": "今は祭司の修行をしてて…えっと、部族の年長者から、ナタの各地に先祖が残した宝があるから、「その宝を探してこい！」って言われて——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560107,
					"content": "修行って名目で集落から追い出されちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560108,
					"content": "それで見事、この近くにお宝の手がかりがあるって情報を掴んだの…「何とか獣」の足跡を辿れば、お宝にたどり着けるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560109,
					"content": "それって言うまでもなく、駄獣でしょ？まさか…モコモコ駄獣じゃないわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560110,
					"content": "とにかく…駄獣のあとをついて来たの。そしたら、こいつらの拠点に辿り着いたはいいけど、駄獣を盗む泥棒と誤解されてその場で閉じ込められたってわけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560111,
					"content": "埋もれたお宝を見つけるどころか、私が埋められるところだったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560112,
					"content": "手がかりも情報も足りない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "そうよね。もう二度と軽率な行動はしないわ…もしかしたら、閉じ込められて憂き目にあって得た教訓こそがお宝なのかもね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560114,
					"content": "はぁーあ、体中が臭いわ。どこかでお風呂に入らないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 751560115,
					"content": "助けてくれてありがとう。手持ちは多くないけど、お礼として受け取って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヌラフ"
				}
			]
		},
