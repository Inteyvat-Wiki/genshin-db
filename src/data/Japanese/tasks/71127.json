					{
						"sceneId": 3,
						"position": [
							1493.036,
							443.555,
							2842.422
						],
						"pointId": 311600077
					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME}、それにパイモン。よく来てくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270402,
					"content": "あれ？霊淵？どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270403,
					"content": "中に入れないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270404,
					"content": "入れない？どこか入れない場所があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270405,
					"content": "錦落の庭だ。今、浮錦がそこで休息を取っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270406,
					"content": "錦落の庭…ええっと、浮錦が最初にオイラたちを連れ込んだあの場所か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270407,
					"content": "あそこは浮錦が仙力で封鎖している住まいだ。妾には彼女のような仙力がないため、彼女の元へ行けなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270408,
					"content": "えっ？でも浮錦が前に休みに帰ったとき、おまえそんな話してなかったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270409,
					"content": "その時は忘れていたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270410,
					"content": "助けが必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "ああ、汝らには彼女と同じ仙力があり、錦落の庭の門を開けることができる。助けてもらえるとありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270416,
					"content": "えっ？待てよ…つまりおまえ、ずっとここでオイラたちを待ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270417,
					"content": "汝らを待っていたわけではない。錦落の庭に入る方法を探っていたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270418,
					"content": "おんなじようなもんだと思うけど…まっ、とにかく、オイラたちも浮錦の体調がちょっと気になるし、霊淵、一緒にあいつのお見舞いに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270419,
					"content": "うむ、恩に着る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270420,
					"content": "妾についてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270412,
					"content": "藍ってば、まぬけだなぁ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "ほんとだぞ！そんな大事なこと、なんで忘れてたんだよ。まったく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270414,
					"content": "なにせ妾は愚鈍な獣にすぎぬからな。彼女に会ってたくさんのことを思い出した反面、その分忘れてしまったのだ。妾の手落ちだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270415,
					"content": "汝らには彼女と同じ仙力があり、錦落の庭の門を開けることができる。助けてもらえるとありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "霊淵"
				}
			]
		},
		{
