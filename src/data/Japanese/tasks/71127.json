						],
						"pointId": 311600084
					}
				]
			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#おや？{NICKNAME}、パイモン、それに霊淵ではないか…どうしてここへ来たのじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270502,
					"content": "わっ！浮錦の声がするぞ！？えっと…下のほうから聞こえてくるみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270503,
					"content": "心配で来たんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "そうだぜ、おまえの体調が心配で断りもせずに来たんだ——でも、浮錦だってなにも言わずにオイラたちをここへ連れて来たことがあるだろ？これでおあいこだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270509,
					"content": "ふむ？…ああ！すまんかったの！錦落の庭へ戻って休もうというときに、入口の封鎖を解き忘れたようじゃ…！悪いことをした。せっかく我を見舞いに来てくれたというのに、面倒をかけたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270510,
					"content": "面倒って言うほどでもないぜ。けど、どうしてその…えっと、水たまりの中に隠れてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270511,
					"content": "どう説明をしたらいいか…一番気に入っとる姿を取り戻すことがまだできておらんのじゃ。毎回鯉の姿を見せるばかりでは少々…心苦しいのでな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270512,
					"content": "もう何度も見てきたから今さらだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "ははっ…以前はいつでも人の姿に戻れたがゆえに、鯉の姿で行動したほうが便利じゃと思っとった。しかし今では、こんなツルツルの姿でしかいられん。これではかえって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270515,
					"content": "なんだよ、変なこだわりだな…とにかくおまえが無事ならよかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270516,
					"content": "けど霊淵が前に言ってた話だと、浮錦は力を使い切ったわけじゃなくて、沈玉の谷の自然の中に力が散らばったから弱くなったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270517,
					"content": "だったら薬蝶の谷で金色の鯉を探したときみたいに、散らばった仙力を集めれば浮錦は回復するんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270518,
					"content": "うむ…理論上は間違っておらんの。しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270519,
					"content": "そうだろ？じゃあ今後、似たような鯉を見つけたらここへ連れてくるぜ！そうすれば浮錦も早くよくなるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270520,
					"content": "そ、そんな面倒事を頼むのは申し訳ない！力はまだそこまで使い切ってはおらん。しばらくの間ここで静養すればきっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270521,
					"content": "面倒というほどじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "…出くわしたら逃さないようにしないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "そうか、礼を言う。しかし我のことでおぬしらにこれ以上迷惑をかけたくはないのだ。すでに多すぎるほどのことをしてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270524,
					"content": "もし旅の途中で散らばった仙力を見つけたら、ここの祀{RUBY#[D]スーロン}瓏へ直接放り込んでおくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270525,
					"content": "水と土はもう元通りになったが、祀{RUBY#[D]スーロン}瓏により多くの力を注げば、沈玉の谷は天候に恵まれ、豊作となるはずじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270526,
					"content": "…汝はどうなる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270527,
					"content": "やれやれ、言ったじゃろう。ここでしばらく静養すればよくなるとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}にパイモン、見舞いに来てくれて心から感謝する。我は実にうれしいぞ。薬君が去って以来、ここに人が来たのは初めてじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270529,
					"content": "それに霊淵、おぬしにも感謝しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270530,
					"content": "感謝されるようなことはしていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270531,
					"content": "#何を言うておる！それなら、{NICKNAME}とパイモンをここに連れてきてくれたことに感謝するとしよう。まったくおぬしときたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270532,
					"content": "#最後に…今一度お礼を言わせてくれ、{NICKNAME}、パイモン。我のためにしてくれたこと、何もかもに感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270513,
					"content": "だからって隠れる必要はないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "#霊淵が{M#君}{F#あなた}を心配してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "いいや。妾はただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270508,
					"content": "ほら、霊淵は心配で言葉も出てないだろ！それで断りもせずに来たんだ——でも、浮錦だってなにも言わずにオイラたちをここへ連れて来たことがあるし、これでおあいこだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7112709,
