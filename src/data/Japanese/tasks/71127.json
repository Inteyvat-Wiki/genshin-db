	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮錦",
					"霊淵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "そういえば、ここって浮錦の洞天なんだよな？今まで見てきた洞天とはちょっと違う気がするけど…なんて言うか…すごく「現実感」がないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270302,
					"content": "奇妙キテレツな装置がないし、透明な宙に浮く橋もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270303,
					"content": "実に申し訳ない話なのじゃが…以前はあまりに恥ずかしく、きっちり説明できずにおったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270304,
					"content": "我は南の仙人たちのように新しい空間を作り出すことができぬ。「錦落の庭」は「洞天」と呼べるようなものではなく、せいぜい「洞窟」といったところじゃろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270305,
					"content": "「洞窟」だろうと「洞天」だろうと、どっちも仙人の「洞府」だと思うぞ！…でも浮錦はいつになったら人の姿に戻れるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270306,
					"content": "彼女が蓄えた力はすべてこの地に散ってしまった。しばらくの間、人の姿には戻れないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270307,
					"content": "妾が力を使い果たしたときも同じだった。主が死んだ後、人の姿に戻れるまでに何度雪が降り、溶けて、また降ったか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270308,
					"content": "そうだったのか…ん？待てよ、霊淵も人の姿になれるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270309,
					"content": "ふふっ、そりゃ当たり前じゃ！二人は知らんじゃろうが、かつて薬君山にいた頃の霊淵の姿といったら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270310,
					"content": "浮錦、それ以上話す必要はない。今の話とは何も関係ないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270311,
					"content": "そうか？ならば人の姿になった後、廟会で茶葉の菓子を食べすぎて、泣きながら薬君に痩せるお茶を作ってくれと頼みに行った話は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270312,
					"content": "それとも、祝典の酒をうっかりお茶と間違えて飲んでしまい、山のイノシシを引きずり「薬君と自分ならどちらのほうが美しいか」と聞いた話も、話す必要はないかの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270313,
					"content": "…浮錦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270314,
					"content": "うわぁ、そんな話をされちゃ、霊淵がいったいどんな姿になったのか気になってきたぞ！今みたいに青かったのか？それとも…うーん、もっと白かったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270315,
					"content": "#{F#私}{M#俺}も気になる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "どうして気になるのか理解できない。汝も人ではないか。人の姿かたちに興味があるのなら自分を見ておけばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270321,
					"content": "#はは…とにかく、おぬしらには感謝しておるぞ、{NICKNAME}にパイモン。他者とこんな風に交流できる日がまた来るとは、思いもせんかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270322,
					"content": "コホン——我は幸せな気持ちでいっぱいじゃ。ここはひとつ、二人の旅路が順風満帆かつ幸運に恵まれたものとなるよう加護を授けてしんぜよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270323,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711270324,
					"content": "…す、すまんの、ちょいと気持ちが高ぶってつい…仙人のようなセリフを言ってみたかったんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270325,
					"content": "何はともあれ、これからの旅が順調に進むことをここで祈っておるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270317,
					"content": "霊淵、ちょっと変身してみせてよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "断る。人の体というのはあまりに弱い。獲物を引き裂く鋭い牙もなければ、かたきを追い詰める鋭い爪もない。浮錦に命令されない限り、人間にはならないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "霊淵"
				},
				{
					"id": 711270319,
					"content": "…ん？何を言っておるんじゃ？そういうことは、やはり霊淵がどうしたいかで決めるべきじゃと思うが…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711270320,
					"content": "妾に「どうしたいか」などという考えはない。もし汝がそうすべきだと思ったのなら言ってくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "霊淵"
				}
			]
		},
		{
			"id": 7112704,
