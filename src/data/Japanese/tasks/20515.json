			"dialogs": [
				{
					"id": 205150101,
					"content": "アナはまたどこにいったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150102,
					"content": "またいなくなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "そうだよ、城内を探したが、どこにもいないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150104,
					"content": "お前も一緒に探してくれ、もう歩けないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150105,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "頼んだよ。あいつ、もうすぐ病気が治るのはいいけど、これ以上無茶したら、俺が病気になるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150111,
					"content": "そうだ…教会に行ってシスターたちにお礼したいってこの前アナが言ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150112,
					"content": "大聖堂の周りを探してくるといい。それと、アルバートさんに聞いてみるといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150113,
					"content": "彼はよく大聖堂の周りを…まあ、ずっといるから、何か見てるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150107,
					"content": "冒険者になったかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "うそだ、ありえない、そんな馬鹿な…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205150109,
					"content": "お、お前なんか言えよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "アンソニー"
				}
			]
		},
