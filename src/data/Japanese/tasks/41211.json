			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "ファデュイだって？しかも宝盗団の拠点でボクたちを襲うとは…もしや後を付けられていた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110202,
					"content": "でも、なんでオイラたちの後を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110203,
					"content": "あ！もしかして、おまえがなにかやらかしたんじゃないだろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110204,
					"content": "キミ、何かやらかしたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110205,
					"content": "だからしてないって！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "うーん…それならオイラたちのせいじゃないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110208,
					"content": "ボクが思うに、ファデュイもこの剣を探しているのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110209,
					"content": "えー？でも、おまえはこの剣をちゃんと隠してたんだろう。なんでファデュイが知っているんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110210,
					"content": "雪山で戦うキミの姿を見られたのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110211,
					"content": "ファデュイの目が良ければ、この剣が特別だと気づくはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110212,
					"content": "ファデュイはなんでも欲しがるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110213,
					"content": "これは特別だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110214,
					"content": "似た話を聞いたことあるような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "ファデュイが神に関する物を集めていることは、キミたちも知っているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110216,
					"content": "おぉ、言われてみれば、ディルックの旦那が言ってたような。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110217,
					"content": "ドゥリンは風神の敵だ。神に相当する力を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110218,
					"content": "「神に匹敵する存在」も「神に関係する存在」も、どちらも同じようなものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110219,
					"content": "道理でファデュイに狙われるわけだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "なるほどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110221,
					"content": "少し前にこの周辺をスケッチしに来た時、あるものを発見した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110222,
					"content": "この先を少し行ったところに特殊な土地があるんだ。そこの地脈は、他の場所とは違っていてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110223,
					"content": "近くの怪物がそこに引き付けられ、影響を受けると身体能力が高くなるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110224,
					"content": "そんなことがありえるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110225,
					"content": "でも、オイラたちはこの剣を強くすればいいんだもんな？なら、そこに行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110226,
					"content": "そうだね。ついでに異なる敵がその剣に与える影響も観察したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110206,
					"content": "何もしてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "どんな感じだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110302,
					"content": "剣の力が更に強まった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "ひとつの推測に過ぎないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110305,
					"content": "この剣が敵から力を吸収すると、この雪山に隠されたドゥリンの亡骸と共鳴するのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110306,
					"content": "わぁ…なんだかすごそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110307,
					"content": "もしこの仮説が成立するんなら、この雪山にいる怪物もドゥリンの亡骸と共鳴できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110308,
					"content": "なぜ龍の亡骸と共鳴できるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "恐らく、ここ一帯にいる怪物の力の根源と関係あるんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110310,
					"content": "ドゥリンは普通の怪物ではない。死してなお、雪山全体に影響を与えているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110311,
					"content": "神秘的な龍の力…これはある種の呪いだね。",
