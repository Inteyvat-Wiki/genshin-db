			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "アルベドー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110102,
					"content": "戻ってきたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110103,
					"content": "たくさん頑張ったんだぞ。この剣を見てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110104,
					"content": "はい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "ふむ…やはり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110106,
					"content": "ボクの思った通りだね。この剣は戦いを通じて成長している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110107,
					"content": "剣なのに、そんなことあり得るのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110108,
					"content": "だから特別なのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110109,
					"content": "そうだ、大事なことを伝える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110110,
					"content": "付近を調査したところ、怪しい痕跡を見つけた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110111,
					"content": "え、泥棒じゃないだろうな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110112,
					"content": "#泥棒はむしろ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちなのでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "あっ、確かに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412110115,
					"content": "その痕跡を見たところ、調査の必要性があると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110116,
					"content": "泥棒なのか、または別のものなのか、調べれば自然と分かっていくだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412110113,
					"content": "宝盗団はそう思ってないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
