			"dialogs": [
				{
					"id": 50130801,
					"content": "こだまの子の魔物はぜんぶ倒したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 50130802,
					"content": "アビスの忌瘤はわたしが破壊したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "カチーナ"
				},
				{
					"id": 50130803,
					"content": "流泉の衆のほうも終わったよ。ふふ～ん、あたしの一撃で全滅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 50130804,
					"content": "謎煙の主も危機を脱したところよ。花翼の集を手伝いに行く？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 50130805,
					"content": "ああ、あそこの状況は特にひどいとか…僕も今向かっているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 50130806,
					"content": "必要ない、一掃した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 50130807,
					"content": "もうか！？さっきまで競技場にいたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 50130808,
					"content": "とにかく誰かを殴りたかったんだ。どれだけ我慢してたか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 50130809,
					"content": "そ、そっか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 50130810,
					"content": "イアンサ、豊穣の邦のほうはどうする？イアンサの家は競技場から遠いでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 50130811,
					"content": "ああ、それなら心配いらないぞ。さっきヴァレサから、もう片付いたって連絡が来てる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "イアンサ"
				},
				{
					"id": 50130812,
					"content": "どうやら全部処理できたようだな。アビスの勢いも弱まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 50130813,
					"content": "数の勝負なら、反魂の詩が負けるはずないもんな！数に頼ってる時点で、あいつらの負けだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 50130814,
					"content": "…待った。アビスが魔物を集めて、競技場に向かわせてるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 50130815,
					"content": "反魂の詩が一番の障害だと気づいたか。聖火を破壊する気だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "キィニチ"
				},
				{
					"id": 50130816,
					"content": "そんなことさせないよ！みんな、競技場に向かおう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 50130817,
					"content": "新しいアビスの忌瘤が落とされたみたいだね。どれも競技場の近くっぽいから、手分けして破壊しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 50130818,
					"content": "そうだ、競技場の入口を守る人も必要だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 50130819,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "よ～し、これが最後の戦いだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				}
			]
		}
	]
}