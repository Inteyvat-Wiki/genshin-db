			"dialogs": [
				{
					"id": 733520101,
					"content": "こんにちは、異郷の旅人と小さなお友だち。花神誕祭は楽しめとるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520102,
					"content": "わしは「幻のおもちゃ王」と呼ばれておってな。花神誕祭の開催に合わせて、「ゆらゆらフロート車」という新しいゲームを期間限定で出しておるんじゃ。どうじゃ、興味はないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520103,
					"content": "ゆらゆらフロート車？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733520104,
					"content": "なんか、フロート車に揺られて楽しそうにしてるナヒーダが目に浮かぶな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733520105,
					"content": "すごく面白そう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "そうじゃな。「クラクサナリデビ様が毎日楽しく過ごせますように」というのは、我々スメール人の願いでもある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520108,
					"content": "お前さんたちの言う場面はまるで…一枚の美しい絵のようじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520109,
					"content": "じゃが、このゲームはお祝いというより、冒険に近いかもしれんのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520110,
					"content": "「賢い子も、おっちょこちょいな子も、おとなしい子も、やんちゃな子も、美しい心を持つ子は、みんな花神誕祭で自分だけのフロート車を与えられました…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520111,
					"content": "「そして、そのフロート車に乗り込んで、それぞれの旅に出ました。道中で危険にも遭いましたが、ピンチをチャンスに変え、宝物である千輪の花を見つけたのです…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520112,
					"content": "パイモンは聡明でおとなしい子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "へへっ、そうだな！オイラたちもきっと千輪の花をゲットできるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733520115,
					"content": "ほほほ。二人とも思う存分楽しんでおくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マックスオド"
				},
				{
					"id": 733520113,
					"content": "ピンチをチャンスに変えるのは得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "そんなナヒーダを見てみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}