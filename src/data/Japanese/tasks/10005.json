			"dialogs": [
				{
					"id": 100050201,
					"content": "アルベド、やっぱりここにいたんだな。えっと…絵を描いてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100050202,
					"content": "ああ、少し前まで忙しくて絵を描く時間がなかったんだけど、ちょうど最近落ち着いてきたから、また筆を取って練習してみようと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050203,
					"content": "確かに色々あったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "そうだね。でも、キミたちと騎士団のみんなが協力してくれたおかげで、無事解決できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050205,
					"content": "それに、師匠が残した最後の課題もクリアできたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050206,
					"content": "結果から見れば、これ以上ないくらい完璧だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050207,
					"content": "スクロースも最近、成長著しくてね。錬金に関わる多くの仕事を、一人でこなせるようになってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050208,
					"content": "騎士団のほうも、ボクが出ていく必要のある問題は特に抱えてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050209,
					"content": "課題もなく、仕事もなく、面倒事もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050210,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "いや、なんでもないよ。たぶん毎日、頭を酷使する生活に慣れてしまったんだろうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050213,
					"content": "こうして完全に暇になると、正直、少し落ち着かないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050214,
					"content": "無意識のうちに「まだ解決すべき問題が残ってるんじゃないか」って考えてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050215,
					"content": "でも残念なことに、今のモンド城には、あらゆる問題に対して「完璧な解」が用意されてるようで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050216,
					"content": "ちょっとくらい休んだって、別にいいんじゃないか？毎日忙しくしてたら、身体が持たないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100050217,
					"content": "どうしても落ち着かないなら、オイラたちと一緒に遊びに行こうぜ！オイラ、サボり方にはめちゃくちゃ詳しいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100050218,
					"content": "ハハッ、それならパイモンにしっかり教えてもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100050219,
					"content": "トラブルに巻き込まれたいなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "言うな、言うな！おまえがそういうこと言うと、毎回トラブルが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100050220,
					"content": "#{M#俺}{F#私}と一緒にいるといいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "新しいトラブル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
