							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "アルベド、こんなに暇そうにしてるなんて珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051302,
					"content": "まあでも、レインドット様が残した「課題」をやり遂げたんだ。少しくらいは肩の力を抜いてもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051303,
					"content": "ほら！まだ話し終わってもないのに、もうトラブルがやってきたじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051304,
					"content": "セバス、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051305,
					"content": "アルベドの知り合い？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "ああ。セバスも、ボクの師匠レインドットが造ったんだ。強いて言えば、ボクの「家族の一員」みたいなものかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051307,
					"content": "#さすが{M#君}{F#あなた}の家族関係だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "「強いて言えば」とは何だ？あんな大きな屋敷に、執事は私だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051309,
					"content": "君とレインドット様が使った瓶や缶は、一匹の猫が片付けてるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051310,
					"content": "おまえ…猫じゃないのか？猫がどうやって執事をやるんだ？瓶や缶まで片づけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051311,
					"content": "ふむ、君はどうやって空を飛んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051312,
					"content": "どうって…オイラ、元々飛べたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051313,
					"content": "私も同じだ。元からできた。事実を問題にしても答えは出ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051314,
					"content": "お、お、おまえ…こいつムカつくぞ！オイラ、今から…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051315,
					"content": "彼の主人はレインドット…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "オイラ…もうこいつの話は聞かないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051318,
					"content": "余計な話はここまでだ。アルベド、レインドット様の命令を受けて、君に伝言を届けに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051319,
					"content": "コホン…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051320,
					"content": "「親愛なるアルベド、君があの課題に対して『自分の納得できる解』を見つけたと聞き、とても嬉しく思うよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051321,
					"content": "「しかし、一度答えが出た問題は、思考を巡らせる意味を失う。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051322,
					"content": "「君の頭の中で絶えず揺れているあの振り子も、今ごろは『退屈』のほうに傾きかけてるのではないかな？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051323,
					"content": "「それなら、君も自分自身に問いかけてみるといい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051324,
					"content": "「『既知の答え』を捨て、『未知の問題』を探す。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051325,
					"content": "「問題はいつだって答えより面白く、時間を潰すには最適だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051326,
					"content": "「次に会う時、君がどんな『問題』を持ってきてくれるのか、とても楽しみにしてるよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051327,
					"content": "「もし、私でさえ思いつかなかった問題を見つけられるなら、それが一番だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051328,
					"content": "「可能性はあまり高くないが、まずは努力してみることだ。運が良ければ、私を本当に驚かせられるかもしれない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051329,
					"content": "「そうだ、問題を考えたり、答えたりするための『自分』を作ろうとはしないほうがいい。試してみたが、まったく意味はなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051330,
					"content": "「最後にもう一つ。セバスに君への贈り物を持たせておいた。受け取るといい。それと、セバスに食べ物を与えないこと。彼は空腹にならない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051331,
					"content": "師匠の教えに従います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051332,
					"content": "ゴホッ、ゴホッゴホッ…レインドット様からは以上だ…疲れたな…ゴホッゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051333,
					"content": "伝言はもう伝えた。こんな寒い場所に長居は無用だ。モンド城に行って伝言を届けないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051334,
					"content": "モンド城？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "モンド城にレインドットの関係者がいるのか…あっ！まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051336,
					"content": "彼はまだ「生まれたばかり」だが、既にレインドット様は彼が解決すべき「課題」を予見してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051337,
					"content": "さてさて、もう本当に行くぞ。ここは寒すぎて尻尾が痛いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051338,
					"content": "レインドット様からの贈り物を机に置いたから、忘れずに受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051339,
					"content": "アルベド…おまえの家族、どんどんややこしくなってきてないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051340,
					"content": "急に猫が現れるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "でも本当にあの猫はおまえの「家族」に入るのか？自分のこと執事とか言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051342,
					"content": "セバスは間違いなく、師匠が造った存在だ。かなり前にね。一般的な理論で考えれば、セバスはボクの「先輩」にあたるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051343,
					"content": "でも、ボクたちは普通の「家族」ではないから、この関係もあまり意味はないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051344,
					"content": "でも、あの時かなりセバスの世話になったのは事実だ。彼は瓶や缶を片づけてくれただけじゃなくて、ボクのデッサンのモデルにもなってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051345,
					"content": "待った。今日おまえが描いてる猫って、セバスなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051346,
					"content": "そう。ボクの習慣でね。問題について考える時、無意識に手を動かして、思考の補助をするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051347,
					"content": "こういう時は、セバスを描くことにしてる…何回も描いたから、もう慣れてるし、ほとんど頭を使わなくてもいけるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051348,
					"content": "そう言えば確かに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "普通の子猫だと思ってたのに！すごい経歴だったんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051351,
					"content": "これでキミも、この猫の名前を知ったね。これからは時間がある時に、ボクとセバスの話をもっと聞かせてあげてもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051352,
					"content": "でも今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051353,
					"content": "「樹は最も完璧な実を誇る。満ち足りていて、欠点のない実を。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051354,
					"content": "「しかし夢を宿した種よ、殻の中に広がる宇宙の王にとどまってはならない」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051355,
					"content": "…もっと考える必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051349,
					"content": "アルベドが猫を描いてるのを前に見た…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "パイモン、やっぱり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
