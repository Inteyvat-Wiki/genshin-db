			"dialogs": [
				{
					"id": 100051401,
					"content": "アルベド、こんなに暇そうにしてるなんて珍しいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051402
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051402,
					"content": "まあでも、レインドット様が残した「課題」をやり遂げたんだ。少しくらいは肩の力を抜いてもいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051403
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051403,
					"content": "うわっ！セ、セバス！どこから出てきたんだ？全然音がしなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051404,
					"content": "セバス、また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051405
					]
				},
				{
					"id": 100051405,
					"content": "キミはセバスに会ったことがあるようだね。それで、ボクとセバスの関係については、何か聞かされてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051406
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051406,
					"content": "アルベドの「先輩」って言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051407
					]
				},
				{
					"id": 100051407,
					"content": "…強いて言えば、そうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051408
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051408,
					"content": "#さすが{M#君}{F#あなた}の家族関係だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051409
					]
				},
				{
					"id": 100051409,
					"content": "「強いて言えば」とは何だ？あんな大きな屋敷に、執事は私だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051410
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051410,
					"content": "君とレインドット様が使った瓶や缶は、一匹の猫が片付けてるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051411
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051411,
					"content": "おまえ…猫じゃないのか？猫がどうやって執事をやるんだ？瓶や缶まで片づけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051412,
					"content": "ふむ、君はどうやって空を飛んでるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051413
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051413,
					"content": "どうって…オイラ、元々飛べたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051414,
					"content": "私も同じだ。元からできた。事実を問題にしても答えは出ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051415
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051415,
					"content": "お、お、おまえ…こいつムカつくぞ！オイラ、今から…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051416,
						100051417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051416,
					"content": "彼の主人はレインドット…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051418
					]
				},
				{
					"id": 100051418,
					"content": "オイラ…もうこいつの話は聞かないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100051419,
					"content": "余計な話はここまでだ。アルベド、レインドット様の命令を受けて、君に伝言を届けに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051420
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051420,
					"content": "コホン…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051421
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051421,
					"content": "「親愛なるアルベド、君があの課題に対して『自分の納得できる解』を見つけたと聞き、とても嬉しく思うよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051422
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051422,
					"content": "「しかし、一度答えが出た問題は、思考を巡らせる意味を失う。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051423
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051423,
					"content": "「君の頭の中で絶えず揺れているあの振り子も、今ごろは『退屈』のほうに傾きかけてるのではないかな？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051424
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051424,
					"content": "「それなら、君も自分自身に問いかけてみるといい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051425
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051425,
					"content": "「『既知の答え』を捨て、『未知の問題』を探す。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051426
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051426,
					"content": "「問題はいつだって答えより面白く、時間を潰すには最適だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051427
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051427,
					"content": "「次に会う時、君がどんな『問題』を持ってきてくれるのか、とても楽しみにしてるよ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051428
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051428,
					"content": "「もし、私でさえ思いつかなかった問題を見つけられるなら、それが一番だ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051429
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051429,
					"content": "「可能性はあまり高くないが、まずは努力してみることだ。運が良ければ、私を本当に驚かせられるかもしれない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051430
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051430,
					"content": "「そうだ、問題を考えたり、答えたりするための『自分』を作ろうとはしないほうがいい。試してみたが、まったく意味はなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051431
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051431,
					"content": "「最後にもう一つ。セバスに君への贈り物を持たせておいた。受け取るといい。それと、セバスに食べ物を与えないこと。彼は空腹にならない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051432
					],
					"speakerTitle": "「レインドット」"
				},
				{
					"id": 100051432,
					"content": "師匠の教えに従います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051433
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 100051433,
					"content": "ゴホッ、ゴホッゴホッ…レインドット様からは以上だ…疲れたな…ゴホッゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051434
					],
					"speakerTitle": "セバス"
				},
				{
					"id": 100051434,
					"content": "ともかく、伝言はすべて伝えた。何で君はこんなところにいるんだ？彼と同じ、モンド城にいてくれれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051435,
						100051436
					],
					"speakerTitle": "セバス"
				},
