			"trigger": {
				"objectNames": [
					"マルタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、あそこの岩ヤドカニが見える？何か不思議な儀式をしてるみたいだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050102,
					"content": "そういう生態なんだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "そうなの？ああ…なんかわかった気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050104,
					"content": "だったら、ナシャタウンにもこの岩ヤドカニたちと同じような人がたくさんいるよ。肩を組んで歩く人もいれば、会ったらすぐに殴りあって離れる人もいるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050105,
					"content": "これがナシャタウンの生態ってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050106,
					"content": "そうだよ、理解が早いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#ねぇ{M#お兄ちゃん}{F#お姉ちゃん}、この岩ヤドカニたちをみんな池に集めてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050109,
					"content": "「フラッグシップ」にトレジャーハンターを全員集めるみたいな感じっていうか。面白いことになりそうじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761051501,
					"content": "#岩ヤドカニが同じところに集まった時、どうなるのか見てみたいな…{M#お兄ちゃん}{F#お姉ちゃん}、今時間ある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マルタ"
				},
				{
					"id": 761050107,
					"content": "ちょっと違うけど、まあいいや。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
