						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715060101,
					"content": "ホッセイニは、理論的に問題ないって言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715060102,
					"content": "スパイクで余計に黒泥が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060103
					]
				},
				{
					"id": 715060103,
					"content": "そうか、そういうことか…地面係数の変化を考えていなかった。これは予想外だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060104,
					"content": "地面係数？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715060105,
					"content": "そう、前の実験場は、そのほとんどが柔らかい土の上だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060106,
					"content": "しかし層岩巨淵の場合、スパイクのエネルギーが伝わる媒介は土ではなく、また違った質と特性を持った岩だ。そのため、本来の計算結果に狂いが生じてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060107,
					"content": "やはり、真理は憶測で創り上げた想像の中には存在していない。現実でしっかりと検証を行うべきだったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060108
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060108,
					"content": "検証するにしても危険だろ。それに…なんで黒泥が急にこんなに湧いたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715060109,
					"content": "確かに、ここは鉱区から離れているから、黒泥はこうも湧かないはず…どうやら、事態は思ったより切迫しているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060110,
					"content": "それに、「プルシナスパイク」が黒泥の環境に影響を与えたということは、やはり推測通り、これは地脈に関する問題ということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060111,
					"content": "つまり、実験と実証の必要性を証明したということにならないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060112
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060112,
					"content": "ただ、もし私一人で試運転をしていたら、きっと魔物に襲われていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060113
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060113,
					"content": "ケガをするだけならまだしも、もし「プルシナスパイク」に深刻なダメージがあったら、フィルナス大先生や「妙論派」の学者たちにどう説明したらいいか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060114
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060114,
					"content": "自分のことをもっと考えたほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060115
					]
				},
				{
					"id": 715060115,
					"content": "ふむ、今回の試運転で得られたデータは、計算結果の修正に役立ちそうだ。このパラメータによる干渉を解決する方法は…よし、四つもある。その中でもっとも効果的なのは、一つのはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060116,
					"content": "#{NICKNAME}、試運転に協力してくれて本当にありがとう。これから「プルシナスパイク」を再調整するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060117,
					"content": "しばらく経ったら、鉱区に運んで起動してみる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060118,
						715060119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060118,
					"content": "鉱区に運ぶ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060120
					]
				},
				{
					"id": 715060120,
					"content": "いや、元々私はヘディーヴと層岩巨淵の地元鉱夫を雇って、運んでもらうよう話し合っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060121
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060121,
					"content": "だが、何人かの鉱夫は、私が鉱区に現れた黒泥を解決しようとしているのを聞くと、報酬はいらないと言ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060122
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060122,
					"content": "私はヘディーヴと一緒に、総務司にいる層岩巨淵を管理している沐寧さんに相談をした——このお金を補助金として彼らに配りたいと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715060123
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060123,
					"content": "スパイクの運搬が終わった後、機器を起動する役目は君に任せよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715060119,
					"content": "一人で運ぶの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715060120
					]
				}
			]
		}
	]
}