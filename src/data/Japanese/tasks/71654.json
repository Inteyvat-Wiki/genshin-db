			"dialogs": [
				{
					"id": 716540201,
					"content": "わぁ…この壺の中の空間、ピンばあやの壺よりもっと広いぞ。しかも、真ん中に大きな家が！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716540202,
					"content": "でも、周りにはなにもないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716540203,
					"content": "パイモンが石を削ってもう一軒建てたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "削るもんか！剣を持ってるおまえが削れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716540207,
					"content": "でも、家以外周りになんもないのはおかしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716540208,
					"content": "おい、見てみろよ、なんだあれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716540205,
					"content": "穴でも掘って住んでみたら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "家があるのに穴に住むバカがいるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "パイモン"
				}
			]
