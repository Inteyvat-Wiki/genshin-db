				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "…あっという間だったな。俺の手もだいぶ良くなったし、明日にはまた調理の仕事に取りかかれそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490102,
					"content": "今まで本当にご苦労だったな。最後の一日も無事平穏に過ぎるといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490103,
					"content": "うぅ…おまえがそう言うと、また何か起こりそうな気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490104,
					"content": "一日が無事過ぎていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "ふぅ——何事もなく夜になったな！特にトラブルも起きなかったし…そっか、オイラたちもすっかり板についたってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490106,
					"content": "初めて仕事した時なんか、塩加減とか辛さの調節を覚えるのに半日もかかってたし…今なら何が起きても「朝飯前」だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490107,
					"content": "あんまり自惚れないほうが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "もうこんな時間だし、お客さんも来ないだろ？…いや、そうだ…初日にリネたちが来た時もこんな時間だったような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490110,
					"content": "旅人と、パイモン？久しぶり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490111,
					"content": "アンバー？それにエウルアとミカ！こんな遅くにご飯を食べにきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490112,
					"content": "先ほど、商隊の護衛任務が終わったばかりで、石門へと戻る途中なんです。もともとはレーションを食べながら移動を続けるつもりだったんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490113,
					"content": "エウルア隊長が長いこと璃月料理を口にしていないとのことで、この旅館で食事ができないかなと思い、立ち寄ってみたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490114,
					"content": "ええっ、エウルアがそんなこと言ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490115,
					"content": "…コホンッ！任務の最中ずっとレーションばかりで…たまたま口直しがしたくなっただけよ！なに？いけないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490116,
					"content": "望舒旅館へようこそ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "注文って…えっ？待ちなさい。どうして君が接客を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490119,
					"content": "いま、旅人はこの旅館の腕利きシェフなんだぜ！おまえら、タイミングがよかったな！ここで作る最後の料理にちょうど間に合ったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490120,
					"content": "ええっ！そうなの？じゃあエウルアが提案してくれなかったら、旅人の料理を逃してたってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490121,
					"content": "じゃあ何を頼もうかな…わたし、璃月料理ってあんまり覚えてないんだよね…ミカとエウルアは何か食べたいものある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490122,
					"content": "「栄誉騎士」先輩の料理を味わえるなら、僕にとっては学びの絶好のチャンスです。どんなメニューだって構いませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490123,
					"content": "…私も何でも構わないわ。食事を済ませて先を急がないといけないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490124,
					"content": "おまえが提案したんだろ？それなのに「何でも構わない」って…じゃあアンバー、おまえが何でも好きに注文してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490125,
					"content": "うーん、じゃあ…わたしも「何でも構わない」かな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490126,
					"content": "ぽかーん——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490117,
					"content": "ご注文はお決まりでしょうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "一日はまだ終わってないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
