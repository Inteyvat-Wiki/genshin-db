					"nextDialogs": [
						401499406
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401499406,
					"content": "おじいちゃんは昔、よく璃月料理を作ってくれたの。毎日夜になるまで一緒に訓練して、わたしはいつも食卓のそばにいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401499407,
					"content": "香りを嗅ぎながら、おじいちゃんがキッチンから出てくるのを待ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401499408,
					"content": "たまにエウルアが来て…口ではずっと不満ばかり言ってたけど、食事が始まると楽しそうにしててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401499409,
