							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "…いい香りです。塩加減とうま味が見事に調和していて、お米の一粒一粒に味わいがある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490202,
					"content": "できたてほやほやのちょうどいい湯気も…何だか懐かしい感じがするよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490203,
					"content": "へぇ、「騎士団で最高の兵糧」が見劣りするほどね…教えて。この料理の名前はなんていうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490204,
					"content": "名前…えっと——「適当混ぜ飯」ってわけにはいかないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490205,
					"content": "…別に名前はないぞ、材料や作り方もごく普通だし…一体どこから紹介すればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490206,
					"content": "材料も作り方も普通なんですか？てっきり何か特別な食材とか手法を使ったのかと思ってました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490207,
					"content": "これは「一番美味しい」料理じゃなくて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "「一番適してる」と思う料理だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "「一番美味しい」わけじゃなくて、「一番適してる」って…ど、どんな意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490210,
					"content": "三人は長い帰路を急ぎながら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "レーションを食べ続けた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "空腹だったから特別美味しく感じたってことですか？それだけじゃないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490213,
					"content": "…冷めきったレーションばかり食べていたから、熱々で出来立ての香りを恋しく思わざるを得なかった。そういうことでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490214,
					"content": "あっ、これが璃月で言う「鍋気」というものですか？聞いたことがあるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490215,
					"content": "そうそう。この匂い、まるでレストラン「鹿狩り」に戻ったような感じ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490216,
					"content": "ええっ？「鹿狩り」の気分になったら、璃月料理を食べにきた意味がなくなっちゃうだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490217,
					"content": "味のことを言ってるんじゃないよ。ほっとするような感覚…っていうのかな？我が家に戻ってきた感じがする！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 401490218,
					"content": "ほっとする…我が家…もしかして、これが言笑の言ってた「我が家に帰ってきた」ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401490219,
					"content": "世の中に絶対的な「美味」はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "人それぞれ、みんな好みがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "でも、料理人はそれぞれのお客さんのために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "心から相手のことを思いやる気持ち…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "…どれもわりと似てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "つまり…この料理の隠し味は「気持ち」ってことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 401490224,
					"content": "古臭い話にも聞こえるけど…確かにこの料理を食べ終えたあと、そう思ったわ。素晴らしいわね。このレシピ、覚えておくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 401490225,
					"content": "レシピを覚えたんなら、やっぱり名前も必要じゃない？それで、この料理の名前は決まったの？",
