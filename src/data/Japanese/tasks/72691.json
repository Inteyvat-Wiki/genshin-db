			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#兄さん}{F#姉さん}は、この会場をずいぶん長いこと歩き回っているみたいだね。きっと芸術を楽しむことのできる風情の分かる方なんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910102,
					"content": "実は、そんな風情あることで君に頼みたいことがあるんだが、手伝ってもらえないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910103,
					"content": "話してみて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "こちらのモンドから来た吟遊詩人、レネさんと俺は意気投合してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910105,
					"content": "ああ、大伴さんの言う通りなんだ。彼と知り合ってまだ数日しか経っていないのに、その知識の豊富さには感心されっぱなしだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910106,
					"content": "ははっ、レネさんそれは褒めすぎだって。とにかく、俺たちは詩を以て友を会す詩人だ。だから、共に詩を書くことにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910107,
					"content": "せっかく稲妻に来たんだし、レネさんもきっと稲妻の特色を取り入れた作品にしたいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726910108,
					"content": "そうだね。でも今回のスケジュールはいっぱいいっぱいで、散策して観光するヒマがないんだ、残念なことにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910109,
					"content": "何をしたらいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "友よ、僕は「郷愁」をテーマにした詩を書いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910111,
					"content": "遊子という者は異郷の景色を目にすると、自然と故郷のことを思い出してしまう。だから、詩にこの土地ならではのものを入れたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910112,
					"content": "創作のアイデアを得るために、写真機で写真を撮ってきてくれないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910113,
					"content": "稲妻にも、この地ならではのものがたくさんあるだろう？たとえばモンドだったら、「蒲公英」と「風車アスター」を誰もが思い出すように…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910114,
					"content": "おう、任せてくれ。稲妻の特産を写真で撮ればいいってことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726910115,
					"content": "ああ、じゃあ頼んだよ！参考にこの途中まで書いた詩を君たちに渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910116,
					"content": "写真の数はそうだね…それぞれ違ったものを映した写真が<color=#00E1FFFF>4枚</color>あれば十分なはずだ。報酬として、それ相応の旅費を払わせてもらうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910117,
					"content": "#{NICKNAME}、レネさんが欲しい写真も分かったし、さっそく出発しようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
