				},
				{
					"id": 726910302,
					"content": "うん、撮ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "ありがとう。どれどれ…どれも見たことのないものばかりだ！おおっ、この写真はよく撮れてる！こっちのも詩の題材に相応しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910304,
					"content": "友よ、君たちが撮ってきてくれた写真のおかげで、アイデアが湧いてきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910305,
					"content": "提供してくれた写真をもとに、詩句をいくつか書いてみたんだが、どれを採用するか迷ってしまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726910306,
					"content": "君の意見を聞きたい。君ならどの詩句を選ぶ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レネ"
				}
			]
		},
