					"nextDialogs": [
						726910203
					]
				},
				{
					"id": 726910203,
					"content": "そうか。稲妻の特産の写真を<color=#00E1FFFF>4枚</color>撮ってきてくれればそれでいい、どうか頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レネ"
				}
