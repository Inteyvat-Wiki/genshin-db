			"dialogs": [
				{
					"id": 20155325,
					"content": "稲妻内戦の情勢は良いものとは言えない。だが戦争が長引けば長引くほど、我々の有利になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20155326
					],
					"speakerTitle": "殿中監指示"
				},
				{
					"id": 20155326,
					"content": "抵抗軍に「邪眼」を広めるため、戦争を煽り、両指揮官に戦争継続の意志を促す…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20155327
					],
					"speakerTitle": "殿中監指示"
				},
				{
					"id": 20155327,
					"content": "皆の衆には、ネイサン閣下を補佐し、珊瑚宮軍の勝利の希望を打ち砕いてもらいたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20155328
					],
					"speakerTitle": "殿中監指示"
				},
				{
					"id": 20155328,
					"content": "想定外のことがあった場合、ネイサン閣下の脱出を手助けすること。「ファデュイ」の件は決して露見してはならない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20155329
					],
					"speakerTitle": "殿中監指示"
				},
				{
					"id": 20155329,
					"content": "これは「邪眼」の件に関わる大事、しかと心に刻むように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "殿中監指示"
				}
			]
