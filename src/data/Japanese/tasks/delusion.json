			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"ゴロー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150101,
					"content": "哲平の容態は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150102,
					"content": "今まで気づいてあげられなかったなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "…すでに軍にあるすべての邪眼を接収するよう命を下しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150105,
					"content": "ほとんどの人に生命力の流失が起きていましたが、深刻な状況には至っていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150106,
					"content": "ですが、ごく一部では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150107,
					"content": "珊瑚宮様、今からこの件で倒れた者の負傷兵営を設置し、彼らの容態を診たいと考えております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20150108,
					"content": "ただ兵士たちは皆、邪眼と知ってもなお使い続けたいと騒いでいるようですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20150109,
					"content": "この件はあなたに任せます。私は一度、前線へ向かわなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150110,
					"content": "このような一大事が起これば、軍の心もきっと揺らぐことでしょう。その混乱に乗じて幕府軍が攻めてきてしまえば、今までの苦労も水の泡です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150111,
					"content": "何かお考えはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150112,
					"content": "ファデュイの計画を阻止する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "いけません、危険すぎます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150114,
					"content": "鎖国令は未だ続いています。彼らの邪眼は恐らく稲妻で生産されたものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150115,
					"content": "これほど莫大な人員と資源を動かせるということは、背後に必ず本土の勢力が加担しているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150116,
					"content": "彼らを阻止するためには、邪眼を生産している工場を潰すしかありません。しかし、そこにはきっと厳重な警備が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150117,
					"content": "あなたにそのような危険を冒させるわけにはいきません。少なくとも軍と一緒に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150118,
					"content": "もう時間がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "珊瑚宮様、邪眼の接収は急いで行われたため、ファデュイの目を誤魔化せていない可能性があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20150120,
					"content": "軍隊の準備でこれ以上時間を費やせば、ヤツらに勘づかれ、間違いなく逃げられるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "ゴロー"
				},
				{
					"id": 20150121,
					"content": "はい…少し考えさせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150122,
					"content": "邪眼を接収する時から、この件についてはすでに考えていました。巨大な工場、見つかりにくい場所、そして輸送経路の近くにあり、材料の供給を確保しなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150123,
					"content": "これらの条件に合う場所はそう多くありません。それに兵士たちが邪眼を手に入れた場所から推測するに、工場は<color=#00E1FFFF>ヤシオリ島</color>南西部の海に面した山崖にある可能性が高いでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150124,
					"content": "私はあなたを止めません。しかし、くれぐれもお気を付けください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150125,
					"content": "私たちは多くの戦友を失ってきました。あなたまで失いたくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150126,
					"content": "行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "え？その<color=#00E1FFFF>邪眼工場</color>に行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20150128,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "本気なのか？もう少し考えてみても…うぅ、わかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20150103,
					"content": "容態が急に悪くなった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
		{
			"id": 201504,
