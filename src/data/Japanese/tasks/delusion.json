			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150401,
					"content": "まさか君たちがここまで辿り着くなんてね、やるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150402
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150402,
					"content": "面白い。久しぶりに再会したというのに、今すぐにでも命のやり取りをしたそうな勢いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150403,
						20150404
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150403,
					"content": "邪眼を製造するなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				},
				{
					"id": 20150405,
					"content": "ああ、そのことだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150406
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150406,
					"content": "一つ間違えていることがある。確かに僕はここにいるが、計画を執行するにあたり、ただその代理人をしているにすぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150407
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150407,
					"content": "首謀者はもちろん他にいる。ほら、凄腕なんだろ？頑張って探してきなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150408
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150408,
					"content": "あらら、こんな「些細な事」で怒っちゃったの？どうやら変わっちゃったみたいだね…情けなくて、小胆なへなちょこに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150409
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150409,
					"content": "些細なことだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20150410,
					"content": "間違ったことを言ったかな？浮世では、人の命なんて雑草と同じなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150411
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150411,
					"content": "邪眼がなくても彼らは死んでいただろう。少なくとも、邪眼は彼らの「願い」を叶える機会を授けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150412
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150412,
					"content": "目狩り令がどんな価値を持っているのか、君たちに分かるかい？これを実現するのにかなりの力を費やしたのは、僕たちにとって有益なことだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150413
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150413,
					"content": "そして今その結果を見てみると、すべて価値のあるものだということがあらためて分かる。争いを作り、邪眼を広めるため道を開き、力を追い求める弱者を惹きつける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150414
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150414,
					"content": "ほんの少しの代価で、世界を掌握するかのような感覚が得られるんだ。生命を引き換えに力を手に入れられるなんて、お得だと思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150415
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150415,
					"content": "目狩り令はおまえたちがけしかけたのか？まさか、始めから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20150416,
					"content": "稲妻の外側はとても強固に見えるけど、内側は…僕たちが利用できるほど綻びに満ちていたよ。ほんの少し手間をかけるだけで、内部から攻め落とせるほどにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150417
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150417,
					"content": "「永遠」は時間を非常に長く伸ばすことができる。だけど、その間にある一つ一つの節目はとてつもなく脆弱なものになるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150418
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150418,
					"content": "抵抗軍にいる君の友達のように、どんなに努力しても、無駄なのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150419
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150419,
					"content": "水中の泡のように、美しさを放った後は、破滅が待っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150420
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150420,
					"content": "失えば失うほど手にしたいと思い、無能であればあるほどそれに抗う！アッハハハ、こういう茶番は、見ていて滑稽で実に楽しいものだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150421,
						20150422
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150421,
					"content": "哲平は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150423,
					"content": "#おい！{NICKNAME}、落ち着け——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20150422,
					"content": "彼は無能なんかじゃない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150404,
					"content": "邪眼を抵抗軍に配るなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				}
			]
		},
