			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "待て、ここに手がかりがあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111229902,
					"content": "きっと、あの鉱夫たちが残したものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111229903,
					"content": "霊矩関の出口に向かおう。そこに足跡がなければ、彼らはまだ霊矩関の中にいることになる。もし新しい手がかりを見つけたら、それを辿ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
