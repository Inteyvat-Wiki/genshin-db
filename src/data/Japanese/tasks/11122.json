			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "あっ、足跡だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220202,
					"content": "どうやら霊矩関を通過して、さらに先へ行っているみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220203,
					"content": "足跡を追えば、彼らの行先が分かるはずだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小玲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "この辺りで鉱夫の格好をした人を見なかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220402,
					"content": "ええ、見たわよ。4、5日前だったかしら、何人かここを通ったわ。かごを背負って、つるはしを持ってたわね…おそらく、その人たちがそうじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220403,
					"content": "そうそう、それだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220404,
					"content": "4、5日前？どうやら、彼らの歩く速度は予想よりも遅いようだ。おそらくは霊矩関の地形に手間取ったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220405,
					"content": "あの人たち凄く変わってたわ。4人の大男が眠そうにぼーっとしててね！先頭には子供がいて、ゆらゆら～って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220406,
					"content": "その子供の姿ははっきりと見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220407,
					"content": "ちらっと見ただけだけど、青い髪で背が小さかったわね。たぶん…女の子だったわ！それにその子、すごく真剣な表情をしていた、少しも笑うことなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220408,
					"content": "彼らが歩いたのはこの道か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220409,
					"content": "そうよ、ここから先へ向かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "小玲"
				},
				{
					"id": 111220410,
					"content": "オイラたちも追おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琬玉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "先ほどの魔物たちですが、気性が荒く、横を通っただけで襲いかかってきたんです…助けてくれてありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220702,
					"content": "私は琬玉、璃月盛露庁に所属していて、文化遺産の研究をしてます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220703,
					"content": "う～ん、鉱夫じゃなかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220704,
					"content": "鉱夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220705,
					"content": "オイラたち4人の鉱夫を探してるんだ！みんな背の高い大男で、採掘に使う道具を持ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220706,
					"content": "あなたが言うその人たち…私、見たかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220707,
					"content": "ホントか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220708,
					"content": "はい。一昨日のことです、南天門から霊矩関へ向かう途中、反対側から一人の子供と何人かの大人が歩いてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220709,
					"content": "詳しく説明してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "それが急いでいたので、よく見ていませんでした。顔の特徴とかは覚えてません…ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220711,
					"content": "いや十分だ、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220712,
					"content": "お役に立てれば幸いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220713,
					"content": "これから学術会議に参加する予定がありますので、私はこれで。助けてくださってありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "琬玉"
				},
				{
					"id": 111220714,
					"content": "さっきの学者によれば、鉱夫たちは南天門の方へ行ったみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220715,
					"content": "でも、同じ人たちかどうか分かりませんよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220716,
					"content": "子供と大人のグループなんて、めったにないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220717,
					"content": "あると思うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "えっ…じゃ、じゃあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220719,
					"content": "あっ、あそこの石を見てください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220720,
					"content": "おぉ、その手があったか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220721,
					"content": "多分使えそうです、試してみますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220722,
					"content": "うぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220723,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220724,
					"content": "間違いありません、同じ人たちです。この道に沿って進んでます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220725,
					"content": "クンジュ殿が石から記憶を読み取るところは、何度見ても興味深い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220726,
					"content": "こんなこと普段なんの役にも立ちませんが、鍾離先生にそのように言っていただけて光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220727,
					"content": "クンジュはオイラたちのコンパスだな！おまえのおかげで迷わずに進めそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220728,
					"content": "あははっ、そうですか？同行した甲斐がありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220729,
					"content": "うん、この感じ…事件を捜査しているみたいで、面白いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220730,
					"content": "それは結構だが、警戒も怠るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220731,
					"content": "4人の成人男性が呆けながら連日子供の後ろをついて行き、山を超えている…これは尋常なことではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220732,
					"content": "はい！その通りですね。鍾離先生は実に慎重なお方だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220733,
					"content": "それと、あの学者を襲ったベビーヴィシャップだが、あそこまで攻撃的な魔物ではなかったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220734,
					"content": "ここに至るまでに様々な手がかりを入手したが、それらと一体どんな関係が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220735,
					"content": "鉱夫たちは一昨日、南天門へ向かった。ここから行くには、険しい山道を通ることになる。仮に彼らの目的地が南天門ならば、追いつける可能性もあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220736,
					"content": "おう、すぐに出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220737,
					"content": "先ほどこの近くに印を残しておいた。万が一、戴殿が追いついて来たら、印を辿って俺たちを見つけられるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220738,
					"content": "さすが鍾離だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
