			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鉱夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "横にかごも落ちてます…確かに鉱夫のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220803,
					"content": "オーイ、オイラたちの声が聞こえるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220804,
					"content": "この様子だと、疲れ果ててここで気絶したか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220805,
					"content": "起こすか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220806,
					"content": "まだ…掘れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "鉱夫"
				},
				{
					"id": 111220807,
					"content": "あっ？なにか言ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220808,
					"content": "何かに抵抗してるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "これほどの執着…異常だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220811,
					"content": "近くに休める場所がある。そこにこの人を連れて行ってから、今後の策を練ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220809,
					"content": "立ち上がろうとしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220902,
					"content": "どうだ？死んだりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220903,
					"content": "過労で昏睡状態になっている。幸い、命に別状はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220904,
					"content": "どうしてこんなに疲れたんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "オイラさっき聞こえたんだけど、なにか掘るって言ってたぞ。そのせいで疲れたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220906,
					"content": "可能性はあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220907,
					"content": "奇妙だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "あれ？この人の懐に何か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220910,
					"content": "これは…鉱石の破片？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220911,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220912,
					"content": "皆さん、この人が持っていた鉱石の破片の記憶を見ました。この破片は、この人が鉱山から持ってきたものです。この人は確かに僕たちの探している鉱夫の一人のようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220913,
					"content": "その彼がここに倒れていた理由、一体何だと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220914,
					"content": "誰かに連れ去られた後…ここに捨てられたとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220915,
					"content": "でもそれなら、なんでここまで連れて来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220916,
					"content": "何かが起き、彼を一行から外すしかなかったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220917,
					"content": "…う～ん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220918,
					"content": "ダメだ、ぜんぜん分からないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220919,
					"content": "あっ、そうでした！この破片を見て思い出しましたが、皆さんに渡したい物があったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220920,
					"content": "なんだなんだ、プレゼントか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220921,
					"content": "俺たちに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220922,
					"content": "戴と出会う前までずっと頭にモヤが掛かっていたんですが、皆さんと調査をしていくうちに、そのモヤが晴れてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220923,
					"content": "戴が皆さんに依頼してくれて、助かりました。もし皆さんがいなかったら、僕一人ではこんなに多くの手がかりを見つけられなかったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220924,
					"content": "これは僕が市場で買い集めた水晶です。ただの水晶に見えますが、実は珍しいものなんですよ！一人一個ずつ、記念として受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220925,
					"content": "綺麗な水晶だな。わあ、色も変わるぞ！見る角度によって…全然違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220926,
					"content": "高そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "遠慮せず、受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220929,
					"content": "これは鍾離先生に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220930,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220931,
					"content": "あれ？ど、どうしたんです？好みに合いませんでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220932,
					"content": "いや、そんなことはない。ただ、こんな時に贈り物を受け取るとは思わなかっただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220933,
					"content": "ありがとう、大事にさせてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220934,
					"content": "受け取ってくれてありがとうございます。価値のある物はそれを分かってくれる友達に贈ってこそ意味がありますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220935,
					"content": "ここ一帯は石も多いので、僕はこの辺にある石を適当に触ってみます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220936,
					"content": "クンジュは本当に石が好きなんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220937,
					"content": "鉱石は大地の結晶であり、時間の積み重ねでもあります。それらと一緒にいると、安心できるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220938,
					"content": "皆さんはゆっくり休んでてください。出発前に一声かけてくれると助かります。僕はすぐ近くにいますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "クンジュ"
				},
				{
					"id": 111220939,
					"content": "一人で大丈夫かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "心配するな、さっき周囲を見たところ危険はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220941,
					"content": "そうだ、お前に話すことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220942,
					"content": "えっ？なんか深刻なことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220943,
					"content": "旅人、「鎮龍石」について、どんな印象を持っている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220944,
					"content": "特に何も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "クンジュが探してる鉱石だよな、何か特別な意味でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220946,
					"content": "鎮龍石は鍛造に使われる珍しい鉱石だ。一般的な水晶は、そのほとんどが高温環境下で自然に形成されるが、鎮龍石は元素反応によって生成される結晶だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220947,
					"content": "元素反応で物が作れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220948,
					"content": "ああ。しかし、長期保存できるのはごく一部だけでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220949,
					"content": "鎮龍石は千年前の戦いの中、強烈な元素力がぶつかり合ったことにより誕生した。そして戦いが終わった後も、それらが奇跡的に形を留めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220950,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220951,
					"content": "だが、やはり造物であるため結晶の数は少なく、知名度も低い。それに数百年前にはすでにもう採掘し尽くされている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220952,
					"content": "現代の璃月人が、なぜ今はもう存在しない鉱石を探す？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220953,
					"content": "確かに！それにこの石の存在を知ってるなら、もう掘り尽くされてることも知ってるはずだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220954,
					"content": "おかしいぞ…矛盾してる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220955,
					"content": "鉱石を商売にする者の中にも、鎮龍石に興味を持つ人はいる。しかし、クンジュ殿のように動機がはっきりしないまま石を探すのは…いささか妙だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220956,
					"content": "もしかしたら別の意図があるのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "別の意図…悪いやつなのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 111220958,
					"content": "今はまだ断定はできない。だが、様子は見た方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220959,
					"content": "それと、今一番重要なのは鉱夫たちを救い出すこと。それ以外のことは、遅かれ早かれ明らかになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220960,
					"content": "相手との距離は縮まってきている。このまま進めば、残りの鉱夫も見つかるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220961,
					"content": "休憩が終わったら、クンジュ殿に声をかけて調査の続きといこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220962,
					"content": "先ほどの鉱夫はあのまま休ませておくのがいい。事件が解決した後に戻ってこよう。それと戴殿に書き置きを残す。そうすれば、彼が来た時にすぐ対処できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111220927,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "連れ去られただけじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
