				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百蔵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "五百蔵、元気にしてたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740102,
					"content": "ぬっ！見破られるとは何たる不覚！お前らはいったい…って、この匂いは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740103,
					"content": "何だ、お前らか。久しぶりだから匂いを忘れてしまっていたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740104,
					"content": "五百蔵は相変わらずだな。人見知りだし、やっぱり石のままだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740105,
					"content": "ぬ！？お前、それはどういう意味だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740106,
					"content": "早く封印が解かれますように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "たかが人間ごときの封印！吾輩が本気を出せば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740109,
					"content": "コホン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740111,
					"content": "#ふん。そう言えば、子狸たちがお前らに迷惑をかけたようだな。いい匂いがする金髪の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}がよく遊んでくれると、小狸たちがいつも言っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740112,
					"content": "#金髪の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "人間はみんな、吾輩たち妖狸一族を封印した奴のような悪人で、恐ろしい者だと思っていた。しかし今になってやっと、いい人もいると分かったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740116,
					"content": "ほとんどがいい人だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#そうだ。オイラと{NICKNAME}が会ってきた人間も、ほとんどがいい人だったぞ。五百蔵が封印されたのは、クシを盗んだせいじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740119,
					"content": "ふん、クシはもう返したはずだ。もし霊善坊に法術を習った奴に会ったら伝えてくれ。吾輩を石から出せってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740120,
					"content": "あのクソ狐のせいでここにだいぶ長居してしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740121,
					"content": "（愚痴を言う五百蔵ってなんだか、年取ったオヤジみたいだな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740122,
					"content": "（実際かなり年のはずだよ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "小童どもよ、お前らは手も足も石じゃないから、きっと色んな所に行ったことがあるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740124,
					"content": "フフーン、オイラとこいつは海の向こう側から来たんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740125,
					"content": "五百蔵に璃月とモンドについて話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "…ほぉ、世の中には色んな所があるのだな。あっぱれだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740127,
					"content": "これまでずっと小狸からの報告しか聞けなかったから、外の様子は全く分からなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740128,
					"content": "昔、影向山で北の海の向こうを眺めていると、とんでもなく高い山が見えたものだ。影向山よりも高いかもしれないな。それがどんな山なのか、ずっと知りたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740129,
					"content": "あそこは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "方角からすると、多分ドラゴンスパインじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740132,
					"content": "ぐぬぬ、ドラゴンスパイン…聞いただけで寒気がしてくる。アイツはなぜそんなところに行きたいのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740134,
					"content": "コホンッ。さっきも言ったが、お前らはいい奴だ。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740135,
					"content": "オイラたちに頼みでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740136,
					"content": "ぬ！こう見えても、吾輩は鎮守の森を守るよう、大御所様の命を受けた隠神保生司正だぞ！石に封印されていなければ、今頃は八畳敷の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740137,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "吾輩は自由に身動きがとれないが、子供たちは問題ない。小狸を外に連れ出し、「修行」の供をしてほしいのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740144,
					"content": "「吉法師」を連れて行くがいい。前回お前らと遊んだ後、ずっと会いたがっていてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740145,
					"content": "いいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "そうだな。吉法師とは言葉が通じないから、一緒に旅をするとなると、きっと苦労するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740148,
					"content": "それなら問題あるまい。我ら妖狸一族は人間の言葉を理解している。お前ら人間が妖狸の言葉を理解できないだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740149,
					"content": "え！そうだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740150,
					"content": "でも旅仲間となると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "旅をしながら話もしたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#オイラと{NICKNAME}みたいにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740153,
					"content": "ぬっ、しょうがない。以前、我ら妖狸一族の法術で、食べ物を作ってくれた奴がいただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740154,
					"content": "この吾輩にかかれば、お前らが吉法師と話せるようにする「飯」を用意することなど、朝飯前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740155,
					"content": "美味しい「飯」だ！やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740156,
					"content": "美味しくないかもよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "ふん、吾輩の腕前を見くびってはいかんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740158,
					"content": "五百蔵はどこからこの料理を出したのだろう…\\n何はともあれ、パイモンと二人で、五百蔵のお腹に載った「見た目は美味しそうな料理」をいただいた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "おお、うまいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740160,
					"content": "当然だ。吾輩はかつて泥団子と狸の毛で作った刺身の盛り合わせで、緒方の四鬼を騙したこともあるんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740161,
					"content": "五百蔵ってすごいんだな！それじゃあ、さっきオイラたちが食べたやつは、なにで作ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740162,
					"content": "聞かないほうがいいこともある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740164,
					"content": "まあいいや、早速吉法師と話してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740146,
					"content": "もう一つ問題がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "まあね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#おう、{NICKNAME}の考えてることは分かるぞ！つまり、お宝はあるのかってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740140,
					"content": "お宝？当然だろう、吾輩は五百五もの妖狸を統べる者。稲妻のお宝など、一つ残らず知っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740141,
					"content": "じゃあ困ってる事って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "オイラたち人助けがすっごく得意なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740131,
					"content": "方角から見ると、多分ドラゴンスパイン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "いい匂い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}じゃなくて{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "パイモンも早く封印が解けて欲しいって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
