			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "吉法師、久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740202,
					"content": "ぬ！白髪と金髪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740203,
					"content": "#金髪って{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "オイ！誰が白髪だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740205,
					"content": "すごい。言葉、伝わる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740206,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は{NICKNAME}、隣はパイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "ちゃんと覚えとくんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740208,
					"content": "カサカサスミレウリ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740209,
					"content": "えっ、スミレウリ？カサカサってなんなんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740210,
					"content": "とにかく、なんとか話せるようになったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740211,
					"content": "何とかって感じだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "一応、五百蔵に伝えに行こうぜ。これから吉法師を長い旅に連れて行くんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740213,
					"content": "五百蔵！イェーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740214,
					"content": "イェーイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百蔵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "ぬ！どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740302,
					"content": "ぬ！白髪と金髪に会えた、嬉しい。スミレウリぽんぽこ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740303,
					"content": "スミレウリぽんぽこ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "ぬ？お前、意外と冴えてるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740305,
					"content": "ぽんぽこ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740306,
					"content": "スミレウリぽんぽこってどういうこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "ぽんぽこはぽんぽこ、スミレウリはスミレウリ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740308,
					"content": "もう問題なく話せるようだな。ぬはは、吾輩の「料理」の腕は相変わらず素晴らしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740309,
					"content": "…一応、話せる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "いや、全然ダメだろ！吉法師がなにを言いたいのか、オイラほとんど理解できないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740312,
					"content": "そうだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740313,
					"content": "五百蔵に、吉法師との交流について伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "ほう、なるほどな。安心するがいい。それはお前らが、まだ吉法師の匂いに慣れていないからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740315,
					"content": "焦らずゆっくり慣れて行け！吉法師の匂いに慣れたら、話していることも理解できるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740316,
					"content": "「ゆっくり」って、いったいどれくらいかかるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740317,
					"content": "それは…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740318,
					"content": "ぬ！とにかく焦るでない。せっかちなやつらだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740319,
					"content": "せっかち、いくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740320,
					"content": "もしかして、五百蔵も分からないんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "ふん！吾輩は長い時を生きてきた妖狸大王隠神五百蔵だぞ。お前ら人間のように、時間など一々気にしないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740322,
					"content": "（ほとんどの時間、石像に封印されてたけどな。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740323,
					"content": "でもどうして五百蔵は人と話せるんだろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "ぬ、無礼な。なぜ人間が吾輩と会話できるのか、と尋ねるべきだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740325,
					"content": "吾輩のように長生きしてきた強き妖狸は、多かれ少なかれ、人間と接した経験がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740326,
					"content": "遠い昔、吾輩たちは天狗や狐、鬼に妖怪、そして人間たちとよく話したものだ。人の物語には人の話しか出て来ないが、実はそのうちの半分くらいは人間に化けた妖狸の話なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740327,
					"content": "残りは人間自身の物語と、天狗に狐、鬼や妖怪の物語が半分ずつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740328,
					"content": "しかし、さらにその半分には、彼らに変装した我ら妖狸たちの物語が含まれている。そして妖狸に関する物語の半分は、吾輩五百蔵の話なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740329,
					"content": "つまり、吾輩はただ者ではないのだ。お前らと話すことなど造作もないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740330,
					"content": "分かった、十六分の五が五百蔵の物語。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "ぬ？「十六分の五」…美味い食べ物の名前か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740332,
					"content": "美味しそう。食べたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME}はさっきの話から、五百蔵に関する物語の割合を計算しただけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740334,
					"content": "五百蔵、すごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740335,
					"content": "うぬ、当たり前だ。吾輩のすごさを、しっかりと見習うがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740336,
					"content": "あれ？だんだん「吉法師」の言ってることが分かるようになって来たような気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740337,
					"content": "白髪、賢い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740338,
					"content": "褒められたはずなのに、なんだか嬉しくないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740339,
					"content": "ふむ、良かろう。その子はお前らに託したぞ。修行に付き合ってやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740340,
					"content": "吾輩がまだ若かったころも、稲妻の十八ヶ所や、大妖狸「九百九」の旧跡を訪ねたものだ。そして狸の進むべき道を貫いたからこそ、このような偉業を成し遂げられたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740341,
					"content": "おぉ！だから五百蔵は石に封印されたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740342,
					"content": "ぬはは、石に封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740343,
					"content": "ぬ！？吉法師、お前まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740344,
					"content": "本題に戻ろうぜ！オイラたち最初はどこに行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740345,
					"content": "五百蔵がさっき言った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "ああ、そうだな！ドラゴンスパインへ出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740348,
					"content": "「そこに山があるから」——くぅ、やっとこのセリフをカッコよく言える時が来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726740349,
					"content": "そこに山があるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726740350,
					"content": "ぬぅぅ、聞いただけで寒くなってきた…吉法師、決してお腹を冷やすんじゃないぞ。風邪を引いてしまうと、腹太鼓が叩けなくなるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740351,
					"content": "#そして、飯もちゃんと食うんだ。外にいる時は金髪の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}にしっかりとついて行くんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "五百蔵"
				},
				{
					"id": 726740352,
					"content": "#分かった！金髪の{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_UNCLE|INFO_FEMALE_PRONOUN_AUNT]}について行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "「吉法師」"
				},
