				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "マンク、戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750080102,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "ああ、やっと戻ってきたか。待っている間、不安で気が気じゃなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080104,
					"content": "…遺跡に行くよう提案したのは俺なのに、もし君たちが戻ってこなかったら、どうしようかと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080105,
					"content": "それで…「盗炎の賢者」が遺跡に残した象徴物は見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080106,
					"content": "大変だったけど、なんとか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "君たちならきっとやってくれると思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080109,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "ほら、この円盤みたいなやつだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750080111,
					"content": "ああ…「通牒の金盤」だ！伝説の「通牒の金盤」は実在していたのか…！素晴らしい、研究資料に加筆しておかなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080112,
					"content": "「通牒の金盤」っていうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750080113,
					"content": "あ、ああ。失礼、とても興奮してしまって…これは「盗炎の賢者」が手ずから扱ったものだと言われている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080114,
					"content": "正直なところ…一瞬だけ、持ち帰って家宝に…と思ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080115,
					"content": "#ダメだぞ！これで{REALNAME[ID(2)|SHOWHOST(true)]}を助けないといけないんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750080116,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "ああ、分かっている…さて、俺が持っているのは、この一枚の手がかりだけだった。もう一枚の在り処については、さっぱりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080118,
					"content": "オシカ·ナタ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#ん？{NICKNAME}、今「オシカ·ナタ」と言ったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080120,
					"content": "（石碑に触れた時に見えたことを伝えた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "なるほど。まさかオシカ·ナタとはな…オシカ·ナタは花翼の集の北、海を隔てたところにある古の都市の遺跡だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080122,
					"content": "オシカ·ナタとなると…申し訳ないが、力になれそうにない。あそこは部族はもとより、龍の遺物研究会の研究員ですら、立ち入りが禁止されているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080123,
					"content": "何年も前、龍の遺物研究会の研究員が依頼を受けてオシカ·ナタへ調査しに行った。だが、海に沈んだ石のように、消息を断ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080124,
					"content": "それ以来、研究会ではオシカ·ナタに一切手を出さなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080125,
					"content": "気にするなって。それだけ情報があれば十分だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750080126,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "ああ…改めて礼を言わせてくれ。「通牒の金盤」をこの目で見られて本当に嬉しいんだ。早く帰ってしっかり記録しておかないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080128,
					"content": "#本当にありがとう、{NICKNAME}とパイモン。君たちの旅がうまくいくことを願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080129,
					"content": "#それから、{REALNAME[ID(2)|SHOWHOST(true)]}、君の「焔の主の祝福」の印が取れますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080130,
					"content": "じゃあね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "ああ…旅の終点…すべての魂が帰る場所で、必ず再会できるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マンク"
				},
				{
					"id": 750080107,
					"content": "楽勝だったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
