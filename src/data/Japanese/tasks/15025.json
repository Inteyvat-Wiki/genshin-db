			"dialogs": [
				{
					"id": 150250101,
					"content": "君らがトラポ様に選ばれた人だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250102,
					"content": "おまえは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250103,
					"content": "俺は族長から案内人を任されたトルテック。族長の寄越した伝達使から話は聞いてる。さあ、ついてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トルテック"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トルテック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "確か、前は入れたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250202,
					"content": "選ばれた人だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "だけど、おかしなことに、作品が完成した後も、先祖たちは封印を解かなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250204,
					"content": "その後、洞窟に入れたのは二百年前の大シャーマン、ウィツィリンだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250205,
					"content": "彼女の話によると、そのラクガキはある英雄の物語を描いてるらしい。主人公の名前はクントゥルっていって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250206,
					"content": "おっと、すまん。ラクガキっていう芸術が好きだから、つい夢中になっちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250207,
					"content": "おまえは一緒に行けないんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250208,
					"content": "ああ。洞窟に入ろうとしたことはあるんだけど、封印に阻まれてね。俺の仲間のイクトミ竜に力を借りても、解けなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250209,
					"content": "あの封印は先祖の試練なのかもな。試練を乗り越えられなければ、鑑賞する資格もないってことなんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250210,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250211,
					"content": "そう気にすんな。そうじゃなくても、俺はついていくわけにはいかないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250212,
					"content": "族長のように伝統に異論を唱える度胸は、俺にはない。イクトミ竜の族親が選んだ者だけが、使命を果たせるっていうんなら、一緒に行ったところで足手まといになるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "トルテック"
				},
				{
					"id": 150250213,
					"content": "そっか…それじゃ、行ってくるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
