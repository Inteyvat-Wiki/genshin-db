			"dialogs": [
				{
					"id": 150251001,
					"content": "ここの景色をどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251002,
					"content": "すっごくきれいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150251003,
					"content": "もう少し遠くを見てごらん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251004,
					"content": "わあ、ラクガキだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150251005,
					"content": "数千年前、謎煙の主ができた当初から、あの色たちは私たちと共にあり続けてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251006,
					"content": "確かに、私は革新を起こし、この古い部族に新たな風を吹き入れようとしている。だが、部族のルーツを守るために、決して捨ててはならないものもあるということは、分かっているつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251007,
					"content": "そのうちの一つが、「歴史を語る方法」なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251008,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150251009,
					"content": "数千年以上にわたり、私たちの一族は歴史を「色」で染め続けてきた。その中に、ある種の守り伝えるべき伝承があると思うんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251010,
					"content": "だから、どのような困難があろうとも、特別なウォーベンの作り方を明らかにしなければならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251011,
					"content": "ごめん、オイラそこまで考えてなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150251012,
					"content": "いや、理解してくれて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150251013,
					"content": "一緒に頑張ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "ああ。次、会った時には、この伝承を再び伝えていけるようになることを祈ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				}
			]
		},
