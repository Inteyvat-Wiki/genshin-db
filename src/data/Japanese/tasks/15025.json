					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "これを見てくれ。このウォーベンは先祖が残した作品の一つでね。私たちが目指しているのはこういったものなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250702,
					"content": "おお…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250703,
					"content": "描かれている人物は、我々の部族の伝説のシャーマン——ウィツィリンだ。彼女は二百年以上も前の人でね、かつてイクトミ竜の族親に選ばれた者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250704,
					"content": "色を駆使する秘術に長けていてね、見事に自分の使命を果たしたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250705,
					"content": "君たちの前にあるウォーベンには、彼女の功績が記録されている。このウォーベン自体、彼女自身の作品である可能性が高いんだ。類似するウォーベンの中でも特に素晴らしい出来のものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250706,
					"content": "だが残念なことに、彼女がこの世を去った後、選ばれた者は「神の贈り物」に頼るしかなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250707,
					"content": "伝承をこれからも、後世に伝えたいんだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "その通りだ。私だけではない、謎煙の主の皆がそう思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250709,
					"content": "うんうん！なんだか急にわくわくしてきたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250710,
					"content": "試作品用のものを持ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250711,
					"content": "謎煙の主の人が試作品用のウォーベンを持ってきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "旅人、ウォーベンに色を付ける方法は少々複雑だけど、君ならきっとできると思うよ。私の指示通りにすれば大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250713,
					"content": "分かった、やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "これには既に柄が織られている。それを特殊な染料で染めて、柄ごとに色を分けるんだ。染料が染みこむまでには時間がかかるから、隣の色と混ざらないように、しばらく待つようにしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250715,
					"content": "（指示された通りにウォーベンに色を付ける。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "上手だ、柄もはっきりしていて、染まり具合も申し分ない。あとは、その染料を全て使えば、あの「色」が再現できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250717,
					"content": "おお、いよいよ最後だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250718,
					"content": "（染料を使い切る。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "うーん…成功したのか？なんかうまくいってない気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250720,
					"content": "「色」は再現できていない…失敗のようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250721,
					"content": "何か間違えた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "いや。君は飲み込みが早くて、すぐに染色の技法を身に着けた。私がやってもたぶん同じことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250723,
					"content": "じゃあ、どうしてうまくいかなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250724,
					"content": "特殊な織り方があるのかもしれない。それか、染色の工程が普通とは違うか…もしくはその両方…結局、謎は解けずじまいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250725,
					"content": "ごめんな、役に立てなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250726,
					"content": "いや、こちらこそ申し訳ない。無駄足を踏ませてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250727,
					"content": "報酬は約束通り支払おう。私はこれからも調査を続けるから、君たちもどうかこの使命を諦めないで欲しい。新しい手がかりが見つかり次第、すぐに連絡しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250728,
					"content": "心配するな。最初から諦めるつもりはないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250729,
					"content": "でも…一つ聞きたいんだけど、ウォーベン作りってこんなに大変だろ？なんで文字で記録しないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250730,
					"content": "ずっと変革したいって思ってるなら、ここから変えてみてもいい気もするんだ。文字のほうが便利だし、もっと詳しく書けるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150250731,
					"content": "…何か私のことを誤解しているようだね。まぁいい、その質問に答えよう。ただ、一緒に来てほしい場所があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "ビラム",
					"speakerSubtitle": "謎煙の主の族長"
				},
				{
					"id": 150250732,
					"content": "おう…わかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
