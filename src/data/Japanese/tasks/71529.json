			"dialogs": [
				{
					"id": 716665101,
					"content": "鮮やかね、私の負けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665102,
					"content": "あなたに負けるというのも、光栄だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665103,
					"content": "そんな方法で勝つのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665104,
					"content": "そうだぞ、すばやい敵には、柔軟に応じないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716665105,
					"content": "一つの戦術がうまくいかなかったら、考え方を変えるべきだ。オイラと旅人が旅をしてるときは、柔軟に考えてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716665106,
					"content": "一つの方法だけ考えてたら、いくらがんばっても解決しない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716665107,
					"content": "そういや、忍も同じようなことを言ってたな…こうしてみると一理あるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665108,
					"content": "でもやっぱ今度考えることにする。まずは目の前のこと、虫相撲が最優先だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
