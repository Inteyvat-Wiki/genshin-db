				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "理不尽な…こんな虫相撲のやり方があんのかよ？俺様は…顔がもうパンパンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665002,
					"content": "勉強になったわ、ありがとう閣下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665003,
					"content": "しかも、こんなに腰が低いときた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665004,
					"content": "ふん！牛使い{RUBY#[S]「真剣虫相撲大鬼王」}野郎！オイラたちがいなかった間に、おまえ負けてるじゃんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716665005,
					"content": "それは違うわ。「真剣虫相撲大鬼王」が諦めなければ、私に負けたとは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665006,
					"content": "戦いであれ、人生であれ、一時的に低迷するのはよくあること。そこで諦めない限り、真の「敗北」とは言えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665007,
					"content": "よく…言った…！そうだ、俺様はまだ負けを認めちゃいねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665008,
					"content": "でも、色んな言い訳を探す必要はない。そんな口先だけの言葉はいらない。口を開く暇があったら、一撃でも多く相手を攻撃しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665009,
					"content": "ぐっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665010,
					"content": "鬼王はこういう相手との戦いは得意じゃないみたいだから、出陣する大将を変えて、試合を注意深く観察することにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716665011,
					"content": "ちゃんと観察するというのも修行では欠かせないことだ。新しい技も勉強できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 716665012,
					"content": "そうだな！ちょうどダチ公も来たことだし！「鬼王の右腕」、今回はお前の番だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665013,
					"content": "へへっ、やっとおまえの出番だな。頑張ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716665014,
					"content": "まぁ、楽勝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "伝説の冒険者が出陣するの！？油断は禁物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「百花は一刀に如かず」"
				},
				{
					"id": 716665015,
					"content": "うわ、怖い！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
