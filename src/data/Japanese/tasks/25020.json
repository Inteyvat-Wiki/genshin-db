				]
			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "キュイ？キューッ、キュー…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200502,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200503,
					"content": "ホーリーは水浴びしながら嬉しそうに「フロートボール」で遊んだ。すると、泥もみるみるうちに洗い流されていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "ははっ、すぐに遊び始めるとは思わなかったよ。どうやら相当気に入ってくれたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200505,
					"content": "ホーリーも十分きれいになったし、あいつのところに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200506,
					"content": "キュー？キューン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200507,
					"content": "プレゼント、気に入ってくれたか？今日からそれはお前のだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200508,
					"content": "キューッ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200509,
					"content": "お前をきれいにするのはほんっとに大変だよ…でもまあ、やっとコツを掴めたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200510,
					"content": "キュー…キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200511,
					"content": "どうした俺の手なんか持って…？ああ、大した怪我じゃないから大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200512,
					"content": "キュー…キュキュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200513,
					"content": "どうしたんだよ、さっきまで楽しそうに遊んでたのに急に元気なくしちゃって…もしかして疲れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200514,
					"content": "手伝ってくれてありがとな。これを報酬だと思って受け取ってくれ。大したものは入ってないから遠慮しないでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200515,
					"content": "キュッ、キュー！キューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200516,
