			"dialogs": [
				{
					"id": 250201001,
					"content": "そうそう、これだ！取ってきてくれてありがとな。今これを…痛って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201002,
					"content": "すまん。さっきボールの骨組みを作る時にうっかり手を切っちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201003,
					"content": "ああいう細かい作業はやっぱ苦手だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201004,
					"content": "ちょっと待ってろよ——エンバーコアフラワーの茎を骨組みに結んで、その上から布を被せれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201005,
					"content": "カズーガは再び「フロートボール」作りに取り掛かった。苦闘の末、彼の手には傷が三筋増えていたが、ついに「フロートボール」が完成した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "できたぜ！これを持ってホーリーを探しに行こう。あいつのことだから、絶対にあそこの木の下で土を掘ってるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201007,
					"content": "先に傷を手当てして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "ああ、大した傷じゃないから大丈夫だ。あとで適当な布切れで簡単にやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250201009,
					"content": "それより大はしゃぎしてるのを放っとくのもあれだし、早くホーリーを探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				}
			]
		},
