					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "ホーリー！ちょっと体を拭くだけだから！いい子にしてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200102,
					"content": "キュー、キュキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200103,
					"content": "なあ、一回体を洗わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200104,
					"content": "ほら、すぐそこに池があるだろ？水浴びしても、またすぐ遊べるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200105,
					"content": "キューッ！キュキュッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250200106,
					"content": "あっ、ちょっ！待て！走るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200107,
					"content": "…今、何か通りすぎなかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "集落のお客さんか？すまないな、最近ホーリーが元気を持て余してて、走り回ってるんだ。あいつがびっくりさせなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200110,
					"content": "水浴びさせようとしてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "させるっていうか…してくれるように「お願い」してるって感じだな。ここ最近、よく雨が降るからさ、遊びから帰ってくるころにはいつも泥だらけなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200112,
					"content": "きれいにしてやりたいけど、あいつは遊ぶことしか頭に無いし、いっつも走り回ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200113,
					"content": "俺みたいな…普通のやつじゃ、追いつけないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200114,
					"content": "美味しいもので釣るのはどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "それもやってみたさ。でも俺の考えが分かってるみたいで、俺がいると食べ物に近づこうともしないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200116,
					"content": "なのに俺が目を離すとすぐに地下から潜っていって全部食べて、また地下に逃げるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200117,
					"content": "さすがテペトル竜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "まったくだ。ホーリーがでかくなったらどんなトラブルを起こすことやら…考えたくもないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200119,
					"content": "チョウエンの店を荒らすようなことだけはしないことを祈るぜ…宝石の弁償はとてもじゃないけどできないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200120,
					"content": "はぁ…バッツが前に教えてくれたアイデアを試してみるしかなさそうだ…でも本当にテペトル竜がボールを気に入るだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200121,
					"content": "バッツ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "ああ、テペトル竜の世話役だ。あいつは賢くて音楽にも詳しいし、人間にも竜にも好かれてるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200123,
					"content": "昔、ホーリーが体を洗わせてくれないことを相談したら、バッツがすぐに「フロートボール」の設計図をくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200124,
					"content": "マタオホからもらった物らしいけど、竜たちがかなり気に入ってくれてたんだってさ。だからホーリーにも一個作ってやったらどうかってアドバイスをくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200125,
					"content": "材料を集めて、さあ今から作ろうってとこだったのにホーリーがまたはしゃぎ始めてさ。まったく、落ち着きがないったらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200126,
					"content": "しゃーない、今は「フロートボール」に期待するしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200127,
					"content": "#{M#俺}{F#私}に何かできることはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "手伝ってくれるのか？それはありがたい。あんたみたいな親切なやつに会えて、俺は本当にラッキーだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200130,
					"content": "じゃ、あそこの箱の中からエンバーコアフラワーの茎を取ってきてくれ。俺はここで「フロートボール」の骨組みを作ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250200128,
					"content": "必要なら手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "うわっ！もう少しでぶつかるところだった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
