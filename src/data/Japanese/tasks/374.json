			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "まあ、見てて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740202,
					"content": "こんにちは、シスターさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740203,
					"content": "風神のご加護があらんことを。若き詩人さん、何かご用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740204,
					"content": "実はね、モンドの危機を救う方法がわかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740205,
					"content": "あら、それは風神に感謝しなければならないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740206,
					"content": "でも、それは騎士団に報告するべきよ。関係のない修道女に言ってもどうにもならないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740207,
					"content": "あははっ、そんなことないよ、お姉さんの力が必要だから話してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740208,
					"content": "そう、たとえば…天空のライアー。あれがあれば、ボクは風魔龍を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740209,
					"content": "おかえりください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740210,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740211,
					"content": "あれはとても凶悪な龍ではありますが、代理団長様が意を決すれば倒せないこともない相手です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740212,
					"content": "そ、それはダメだよ！そんなことしたら、風魔龍が死んじゃうじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740213,
					"content": "東風を裏切った愚獸です。風神様だって、あいつを許したりしないはずだわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740214,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740215,
					"content": "ん…えっと、お姉～さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740216,
					"content": "ダメなものはダメよ、詩人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740217,
					"content": "（くっ…この子にお姉さんって呼ばれると、何だか不思議とちょっと嬉しいわね…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740218,
					"content": "うん…仕方ないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740219,
					"content": "これ以上、隠したままにするわけにもいかないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740220,
					"content": "ボクの忠実なる信者よ、喜べ！今、君の目の前にいるのが、<color=#00E1FFFF>風神バルバトス</color>本人なんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740221,
					"content": "驚いた？泣きたくなった？仕える神様に会えてどう？感動した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740222,
					"content": "…他に用がなけば、私は戻って仕事をさせてもらいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740223,
					"content": "ま、待って——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
