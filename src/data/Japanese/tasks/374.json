			"dialogs": [
				{
					"id": 3740701,
					"content": "それで、「天空」って一体…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3740702,
					"content": "モンドの至宝、風神バルバトスがかつて使っていたライアーだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740703,
					"content": "天空のライアーがあれば、ボクはトワリンを悪夢から目覚めさせられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740704,
					"content": "…本当にそれで風魔龍の破壊を止められるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3740705,
					"content": "もちろん、ボクはこの世界で一番の詩人だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740706,
					"content": "過去、未来、そして今、ボクの知らない詩はないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740707,
					"content": "ボクの目を見て、ボクのこと頼もしいと思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740708,
					"content": "…あやしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "はははっ、それは吟遊詩人には効かないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740712,
					"content": "それで、どうやって天空のライアーを手に入れるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3740713,
					"content": "大聖堂のとある安全な場所に保管されているって聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740714,
					"content": "まずは下調べだ。もし興味があるなら、一緒に来てくれても構わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740709,
					"content": "少し信じても大丈夫かと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "ウェンティの目は故郷の空と似ている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
