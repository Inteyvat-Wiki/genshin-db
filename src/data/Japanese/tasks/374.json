			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "うん、シスターは振り向かずにそのまま行ってしまったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740302,
					"content": "でも、予定してた目的はクリアした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740303,
					"content": "少なくとも、彼女はこの大聖堂に天空のライアーがあることを否定しなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740304,
					"content": "#それで、{NICKNAME}、騎士団で話題の新人くん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3740305,
					"content": "君も、やってみないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
