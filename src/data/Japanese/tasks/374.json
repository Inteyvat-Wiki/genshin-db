			},
			"dialogs": [
				{
					"id": 3740401,
					"content": "風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740402,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "あら、あなたは…騎士団の新メンバーね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740406,
					"content": "どうしてここに？代理団長様から何か頼み事かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740411,
					"content": "うん、騎士団は天空のライアーを借りたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "本当に…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740413,
					"content": "あなたのことを疑ってるわけじゃないけど、少し前に怪しい詩人に同じこと言われたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740414,
					"content": "彼はでたらめを言っていたわ、あまつさえ自分のことをバルバトスだともね。きっと何か企んでいるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740415,
					"content": "天空のライアーには、その使用に決まりがあるの。バドルドー祭の期間中だけ使えるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740416,
					"content": "それに借し出しには団長、主教、それから民衆の代表者の同意とサインされた書類が必要だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740417,
					"content": "それで、騎士団のサインは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740418,
					"content": "団長に言われてない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "とにかく、書類は必須よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740423,
					"content": "最近は忙しくてね、他に用件がなければ失礼するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゴテリンデ"
				},
				{
					"id": 3740419,
					"content": "ごめんなさい、忘れていた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "パイモンが食べた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3740404,
					"content": "#栄誉騎士の{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "ええ、知ってるわ。あの日、あなたはアンバーと一緒にモンドを救ってくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "ゴテリンデ"
				}
			]
		},
