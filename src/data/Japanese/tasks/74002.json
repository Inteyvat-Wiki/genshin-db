					"nextDialogs": [
						740021331
					]
				},
				{
					"id": 740021330,
					"content": "#これは{M#君}{F#あなた}の物語。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021331
					]
