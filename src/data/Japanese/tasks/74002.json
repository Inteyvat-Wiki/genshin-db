					"nextDialogs": [
						740021072
					]
				},
				{
					"id": 740021046,
					"content": "大したことはしてないし、遠慮しとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021051
					]
				},
				{
					"id": 740021047,
					"content": "それだと、「騎士団長」になっちゃう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021048
					]
				},
				{
					"id": 740021048,
					"content": "大変そうだから、やめとく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021049
					]
				},
				{
					"id": 740021049,
					"content": "#いつか{NICKNAME}が騎士団長になったら、オイラを栄誉騎士にすることを忘れないでくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021050
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021050,
					"content": "栄誉騎士パイモン、なかなかいい響きだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021051
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021036,
					"content": "#これは{M#君}{F#あなた}たちの、うちわのこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021037
					]
				},
				{
					"id": 740021037,
					"content": "#コホンッ、{NICKNAME}は、みんながそう言ってるんだから、受け取ればいいって言ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021038
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021014,
					"content": "これ以上聞きたくない。さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021016
					]
				},
				{
					"id": 740021015,
					"content": "#{M#俺}{F#私}はどっちにも入ってないから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021016
					]
				}
			]
		},
