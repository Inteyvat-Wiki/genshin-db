				"points": []
			},
			"dialogs": [
				{
					"id": 740021301,
					"content": "ナルキッソスの下っ端たちは、なんでそんなに多くの肩書きを持ってるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021302,
					"content": "役に立たないやつほど、肩書きが必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021303
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 740021303,
					"content": "#実は彼らはみんなナルキッソス配下の猛将で、僕たちはもう何度も戦って、多くの損失を被ったんだ。でも、{NICKNAME}は凄腕の持ち主だから、君にとっては脅威にならないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021304
					],
					"speakerTitle": "アル"
				},
				{
					"id": 740021304,
					"content": "#ごめんね…騎士{NICKNAME}。ナルキッソスの手下にはあたしたちの攻撃が効かないから、あなたに一肌脱いでもらうしかないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021305,
						740021306
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021305,
					"content": "楽勝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021307
					]
				},
				{
					"id": 740021307,
					"content": "うぅ…プリンセス·リリスはどこにいるんだ？もう行き詰まっちゃったみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021308,
					"content": "これからのことは、あたしも考えたことがなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021309
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021309,
					"content": "うーん…ひとまず、上を目指そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021310
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021310,
					"content": "え？どうやって上に行くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021311,
					"content": "パイモン、飛び上がってよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021312
					]
				},
				{
					"id": 740021312,
					"content": "おい！仮にオイラが上に行けたとしても…上でナルキッソスの手下に遭遇しちゃったらどうするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021313,
					"content": "#たとえ上に水仙十字王国のお宝がいっぱい詰まってるんだとしても…{NICKNAME}と一緒じゃなくちゃ、お宝探しって感じがしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021314,
					"content": "上か…分かった。プリンセス·リリスが分けてくれた魔法に頼ってはいるけれど、僕たちも多かれ少なかれ力を持っているから、ある程度のことはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021315
					],
					"speakerTitle": "アル"
				},
				{
					"id": 740021315,
					"content": "うーん…でも、それじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021316
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021316,
					"content": "俺たちは同源…つまり起源が同じで、こういうことは一番分かりやすくて、受け入れやすいはずだろ？それに、前にもやったことはあるだろうが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021317
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 740021317,
					"content": "分かってる、理屈は分かってるよ。でも、こういうことは何でか、すっごく嫌なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021318
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021318,
					"content": "そんな表情しないで、アン。私たちはもともと同じ水の塊で、一心同体だったでしょ。私たちはただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021319
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 740021319,
					"content": "…ただプリンセスに付き添うために、薄い膜に身を包んで、違う姿になっただけ。プリンセスのためなら、私たちが再び一緒に集まるのも、おかしなことじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021320
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 740021320,
					"content": "まてよ、おまえらはなにを言ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021321,
					"content": "僕たちが形を捨てて一体となれば、今よりも強い魔力を生み出すことができる。そうすれば、君たちを塔の頂上まで送り届けることができるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021322
					],
					"speakerTitle": "アル"
				},
				{
					"id": 740021322,
					"content": "え？でもそしたら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021323,
					"content": "友よ、案ずるな。僕たちは同じ水の塊から生まれた。たとえ形を捨てたとしても、それは君が考えているような死を意味するわけじゃない。純水はあらゆる形に変化することができ、その変化も一方向的なものではないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021324
					],
					"speakerTitle": "アル"
				},
				{
					"id": 740021324,
					"content": "そう！冒険や戦いには参加できなくても、一緒に進むことはできるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021325
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 740021325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021326
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021326,
					"content": "#騎士{NICKNAME}、パイモン、あなたたちはどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021327
					],
					"speakerTitle": "アン"
				},
				{
					"id": 740021327,
					"content": "#それは{M#俺}{F#私}が決めることじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021328,
						740021329,
						740021330
					]
				},
				{
					"id": 740021328,
					"content": "#決められるのは{M#君}{F#あなた}だけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740021331
					]
				},
				{
					"id": 740021331,
					"content": "#うぅ…{NICKNAME}の言う通りだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740021332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740021332,
					"content": "団長、ご命令を！高塔の封印は既に解除され、同時にナルキッソスからの侵入を防ぐ機能も失われた！今は一刻を争う事態だ！",
