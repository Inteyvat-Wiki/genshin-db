			"dialogs": [
				{
					"id": 740020301,
					"content": "オイラたち、さっきバブルで空に向かって宙を飛んでたよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020302,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020303
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020303,
					"content": "そんで、そのままずっと上に飛んで、結局水の中に飛び込んだってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020304,
					"content": "そうだけど、何か問題でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020305
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020305,
					"content": "うぅ、聞きたいことが多すぎて、どこから言えばいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020306,
						740020307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020306,
					"content": "水仙十字王国って不思議だなと思って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740020308
					]
				},
				{
					"id": 740020308,
					"content": "…うぅ、わかった、もう聞かないぞ！プリンセス·リリスの「宝物」はこの近くにあるんだったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020309,
					"content": "そう。すぐそこだよ、三重の封印に守られてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020310
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020310,
					"content": "どこだ？あ、あれか？外のバブルはデカいけど、宝物は小さな宝箱の中にあるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020311,
					"content": "よく見ると、デカいバブルの周りに、水流みたいなのが繋がってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020312,
					"content": "ここのバブル·フォーメーションは何か理由があってあたしたちを攻撃しないみたいだね。よし、これを使って封印を解除しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020313
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020313,
					"content": "発射されたバブルを<color=#00E1FFFF>水流と繋がってるリングに導くと</color>、バブルの破壊力が水流を通して伝わって、封印の力を弱めてくれるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020314
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020314,
					"content": "はぁ、あのバブル、本当に怖いんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020315,
					"content": "一、二、三…<color=#00E1FFFF>水流は三つある</color>みたいだけど、これを全部何とかすれば、宝物が手に入るってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020316,
					"content": "#そういうこと！頼んだよ、騎士{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020307,
					"content": "誰も重力には縛られたくないもんね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740020308
					]
				}
			]
		},
