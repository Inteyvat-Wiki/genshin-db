			"dialogs": [
				{
					"id": 740020801,
					"content": "やっと見つけた…一番大切な宝物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020802
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020802,
					"content": "懐中時計みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020803,
					"content": "すでに止まってるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740020804
					]
				},
				{
					"id": 740020804,
					"content": "うーん…ずっと水に浸ってたから、とっくの昔に壊れてたんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740020805,
					"content": "この中には、プリンセス·リリスの大切な時間がたっぷり入ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020806
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020806,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740020807
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 740020807,
					"content": "戻ろう、塔の下に。友達と再会しに行きましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
