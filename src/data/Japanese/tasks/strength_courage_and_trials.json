			"dialogs": [
				{
					"id": 706940101,
					"content": "バンバンさん、まだ腰痛い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940102,
					"content": "とりあえずは大丈夫だ…温めると、本当に楽になるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940103,
					"content": "へへっ、火薬で湿った包帯を温めるときは、ちゃんと時間を加減せなあかんで。ほっといたら、包帯に火ぃが燃え移ってまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940104,
					"content": "そんな包帯の温め方、宵宮しか思いつかないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706940105,
					"content": "おっと…これは！大英雄と白い仲間じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940106,
					"content": "マンガウォーベンの中のシーンが見られるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940107,
					"content": "これは治療中…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "心配しなくていい！外をぶらぶらしてたら、めったに見ない強敵に巡りあったもんで、ちょっと腕試ししてたんだけどさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940110,
					"content": "そしたら、腰をひねっちまって…雪玉になって転がり落ちたあたしを、宵宮さんが助けてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940111,
					"content": "うわぁ…聞いてるだけで痛そうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706940112,
					"content": "はは、『炎魂戦記』の言葉を借りると——うちはただの通りすがりの戦士や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940113,
					"content": "それも、自由な雇われのな！騎士団から許可ももろたし、魔物討伐は自由にしてええんやって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940114,
					"content": "まだ魔物が徘徊してるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "そうだな。騎士団に連絡して、もっと人手を回してもらうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706940117,
					"content": "確かに油断はできひんけど、そこまで切羽詰まってへんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940118,
					"content": "騎士団の人たちがクロスカントリー大会のフィールド周辺にいた魔物は片付けてくれはったみたいやし、もうあとチョロチョロしてるんは残党だけや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940119,
					"content": "参加選手の中にも、強い冒険者はいっぱいいはるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940120,
					"content": "体力も胆力もある人たちやから、こっちがあんまし気ぃ遣たら、かえって気ぃ悪しはるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940121,
					"content": "だから、冒険者協会のやり方にならって、現地でチームを組ませ、残った魔物の処理を一種の試練としてるってわけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940122,
					"content": "それが「バトルソウル試練」だ。魔物の一掃を基本としつつ、できる限り英雄たちの戦い方を真似て、自分を超えることを目指してもらう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "「バンバンローリングストーン」"
				},
				{
					"id": 706940123,
					"content": "「豊穣の邦」らしいアイデアだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706940124,
					"content": "#{M#俺}{F#私}も参加するよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#ええやん！久しぶりに{NICKNAME}の腕前、見してもらえるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940127,
					"content": "むっちゃ楽しみや。今のあんたの身のこなし…花火に喩えたらどんなんやろな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706940125,
					"content": "#{M#俺}{F#私}も参加しないと！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "近くには住民もいるし、気を付けないとね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "戦ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}