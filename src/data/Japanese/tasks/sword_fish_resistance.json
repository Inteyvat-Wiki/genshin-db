			},
			"dialogs": [
				{
					"id": 20101401,
					"content": "中々やりますね…噂ほど誇張されたものではありませんでしたが、それでも凄いです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101402
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101402,
					"content": "自己紹介しましょう、私は幸徳、メカジキ二番隊の代理隊長を務めています。こちらは嘉久、隊にいるベテラン兵です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101403
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101403,
					"content": "只今より、「隊長」の責務を正式にあなたへお渡しします。メカジキ二番隊、いつでも準備は整っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101404
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101404,
					"content": "まだ他に騒ぎを起こしてる浪人はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101405
					]
				},
				{
					"id": 20101405,
					"content": "襲撃を受けた場所は主に2か所あります。ここの浪人たちはすでに隊長が片づけましたので、残るは<color=#00E1FFFF>本島の東</color>にある浅瀬ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101406
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101406,
					"content": "しかし、あそこは浪人の数がとても多く、先ほどの者より手強い相手ばかり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101407,
						20101408
					],
					"speakerTitle": "嘉久"
				},
				{
					"id": 20101407,
					"content": "行ってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				},
				{
					"id": 20101409,
					"content": "そうだな、海祇島と幕府軍はまだ戦争してるんだ。こんな悪いヤツらに騒ぎを起こしてもらっちゃ困るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101408,
					"content": "後方の安全を確保したいと心海が言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101409
					]
				}
			]
		},
