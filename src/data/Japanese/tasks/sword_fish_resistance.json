			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100201,
					"content": "#あっ、{NICKNAME}、来たんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100202
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100202,
					"content": "もうすぐ珊瑚宮様との約束の日だ。そろそろ出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100203
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100203,
					"content": "準備はできたかな？まずは<color=#00E1FFFF>海祇島</color>の軍営に連れていってあげるよ。それから珊瑚宮様のところまで行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100204
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100204,
					"content": "もし途中で船酔いしたら、すぐに僕に言ってね。でも君は南十字船隊にいたことがあるらしいから、大丈夫だと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100205
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100205,
					"content": "よし、じゃあ出航だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哲平"
				}
			]
		},
		{
			"id": 201004,
			"completionStepIds": [
				201004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201004",
							"2"
						],
						"stepId": 201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100401,
					"content": "ここが僕たち海祇島軍隊の訓練営だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100402
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100402,
					"content": "今ある抵抗軍は、ほとんどが海祇島本土の兵士によって構成されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100403
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100403,
					"content": "一部の人はたたら砂で幕府軍と正面から戦い、もう一部の人は海祇島で民の安全を守ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100404
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100404,
					"content": "哲平も昔ここで訓練してたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100405,
					"content": "うん、でも残念なことに教官が前線に出ることを認めてくれなくて、たたら砂の戦いでは後方で雑用をしてたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100406
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100406,
					"content": "僕はしばらくここにいるから、何か用があったらここに来るといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100407
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100407,
					"content": "もし僕がいなければ、書き置きでも残しておいて。それを見かけたら、すぐに君を探しに行くから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100408
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100408,
					"content": "…ああ、しまった…もうすぐ<color=#00E1FFFF>珊瑚宮様</color>との約束の時間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100409
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100409,
					"content": "今度また君に海祇島を紹介するよ、今はまず<color=#00E1FFFF>珊瑚宮</color>まで行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100410
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100410,
					"content": "珊瑚宮、それって<color=#00E1FFFF>珊瑚宮心海</color>が住んでるところだよな…行ってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 201006,
			"completionStepIds": [
				201006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201006",
							"2"
						],
						"stepId": 201006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100601,
					"content": "何はともあれ、兵糧は最重要事項です。少しの過ちも許されません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100602
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100602,
					"content": "我々と幕府軍の衝突が日に日に激しくなっている今、いち早く後方作業の安定化を図る必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100603
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100603,
					"content": "はっ。再考してみます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100604
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100604,
					"content": "ご安心を。以前手に入れた物資もありますので、軍隊の拡張も進んでいますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100605
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100605,
					"content": "人手不足だった頃は苦労をかけましたね。これからは形勢も良くなっていくでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100606
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100606,
					"content": "軍隊の拡張？それはよかったです。今回はいったいどなたが背後で支援してくれたかは知りませんが、本当に助かりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100607
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100607,
					"content": "ん？哲平じゃないか、お前海祇島に戻ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100608
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100608,
					"content": "その方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100609
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100609,
					"content": "#へへっ、珊瑚宮様のお客さん。僕は{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}を海祇島に連れてくるためにここに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100610
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100610,
					"content": "それって…？まさか最近軍隊の中で噂になってる…無限の力を有し、放つ矢は百発百中、そして体は金剛のように堅いあの新人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100611
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100611,
					"content": "なんでそんな噂があるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100612,
					"content": "お二方とも遠路はるばるお越しいただいたからには、きっと何か急用があるのでしょう。これ以上私が邪魔をするわけにはいきません。今度また時間があれば、私のところにお茶でも飲みにいらしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100613
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100613,
					"content": "では珊瑚宮様、私はこれで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100614
					],
					"speakerTitle": "大久保大介"
				},
				{
					"id": 20100614,
					"content": "珊瑚宮様、先ほど大久保の兄貴から「支援」という言葉が聞こえましたが、いったい何のことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100615
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100615,
					"content": "少し前に、ある方から手紙が届いたのです。その方は、海祇島の抗争を支援するために、大量の物資を送り届けてくださいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100616
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100616,
					"content": "そのおかげで、我々はやっと兵力を確保し、幕府軍と正面から立ち向かうことができるようになったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100617,
						20100619
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100617,
					"content": "それはよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100618
					]
				},
				{
					"id": 20100618,
					"content": "実を言うと、このことについて私は疑念を抱いているのです…ただ海祇島の資源はあまり豊かではないので、この物資は確かに渡りに船とも言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100621,
					"content": "相手側の要求も度を超したものではありませんでした。ただ我々に、全力で幕府軍に抗ってほしいようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100622
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100622,
					"content": "彼らの目的がなんであれ、少なくとも目的は同じです。ここは一旦、表に出るのを避けたいと思っている盟友ということにでもしておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100623
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100623,
					"content": "もちろん、警戒を完全に解くわけにはいきません。もし何か異常を見つけたら、すぐに私に報告してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100624
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100624,
					"content": "珊瑚宮様、前線への食料供給も良くなるのでしょうか？何日か前に負傷兵営に行ったら、仲間たちが焼肉を食べたいと騒いでました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100625
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100625,
					"content": "ふふ…ご安心を。もう手配してありますよ、これで焼肉をお腹いっぱい食べられるでしょう。もちろんお酒は許しませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100626
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100626,
					"content": "よかったです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100627
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100627,
					"content": "あなたたちにも苦労をかけてきましたね。目狩り令が発令され、それに抗うために反乱を起こしてからというもの、軍隊の献立はいつも似通った物になっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100628
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100628,
					"content": "今後は私も後方勤務部隊と相談し、その点について改善をします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100629
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100629,
					"content": "しかし我々の物資は有限ですので、勝利するまでは、もう少し我慢してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100630
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100630,
					"content": "じゃあ、目狩り令はいつ終わるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100631,
					"content": "その質問は…私にも答えられません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100632
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100632,
					"content": "目狩り令の発令は元々奇妙なものでした。天領奉行も将軍様も、態度が少し変だったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100633
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100633,
					"content": "天領奉行が突然目狩り令を実行し始め、将軍様も目狩り令がもたらす戦争に目をつぶっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100634
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100634,
					"content": "それらの謎を解き明かさなければ、目狩り令は終わらないでしょう。しかし、これだけは保証できます。目狩り令がある限り、私たちは抗うことを諦めません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100635
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100635,
					"content": "今一度確認させてください。海祇島と抵抗軍の現状について、すべてを理解してなお、私たちと共に戦ってくれますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100636
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100636,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}はあきらめない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100637
					]
				},
				{
					"id": 20100637,
					"content": "わかりました。ではこれより、あなたを正式に——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100638
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100638,
					"content": "海祇島特別行動隊「メカジキ二番隊」の隊長に任命します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100639
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100639,
					"content": "メメメ、メカジキ二番隊！？あ、あの「メカジキ」の名を冠する特別行動隊のことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100640
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100640,
					"content": "特別行動隊に加入するだけでも困難なのに、一気に隊長になるなんて…凄すぎます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100641
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100641,
					"content": "掟破りの任命ですが、あなたの英知、勇気、力は、隊を勝利へ導くことができると信じています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100642
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100642,
					"content": "やったぁ！じゃあ、いつ就任式をやるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100643
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100643,
					"content": "メカジキ二番隊は現在、本島<color=#00E1FFFF>南西</color>の山岳で待機しています。近頃は<color=#00E1FFFF>浪人</color>が騒ぎを起こしていますので、後方の安定化を図るために特別行動隊に出向いてもらっているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100644
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100644,
					"content": "委任状はすでに用意してあります、彼らに見せてください。そこの浪人も、一緒に片付けてくれると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100645
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100645,
					"content": "特別行動隊にいる者は皆、海祇島の精鋭です。少々驕り高ぶるところもあるかもしれませんが、あなたなら彼らの信頼を得られると私は信じていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100646
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100646,
					"content": "じゃ、じゃあ僕は？珊瑚宮様、僕に何かできる作戦などはないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100647
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100647,
					"content": "僕も抵抗軍に貢献したいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100648
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100648,
					"content": "もちろんありますよ。後ほど手配します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100649
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20100649,
					"content": "#任務を完璧に遂行することを約束します！へへっ、{NICKNAME}、君はメカジキ二番隊の隊長になったけど、僕も君に負けないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100650
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100650,
					"content": "おう、気をつけていけよ。無理はしないようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100651
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100651,
					"content": "#じゃあ、{NICKNAME}、オイラたちも出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100619,
					"content": "本当に信用できるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100620
					]
				},
				{
					"id": 20100620,
					"content": "私も疑念を抱いていますが…ただ海祇島の資源はあまり豊かではないので、この物資は確かに渡りに船とも言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
