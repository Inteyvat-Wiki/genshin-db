						20101103
					]
				},
				{
					"id": 20101103,
					"content": "ふふ…そうは言っても、幸徳たちはきっとあなたを試したのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101106,
					"content": "しかし、あなたの実力であれば、そのような試練も楽々と越えられると思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101107,
					"content": "報告に来たということは、海祇島にいた浪人たちをすでに追い払ったということですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101122,
					"content": "もちろん！オイラたち、あいつらを叩きのめしておいたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101108,
					"content": "わかりました。では今後は、大久保に見張りを手配させ、彼らが再び騒ぎを起こさないようにすれば大丈夫でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101109
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101109,
					"content": "ご苦労様でした。これほどの手柄を立てたのです、報酬をあげなくてはなりませんね。そうですね…昇進は…まだ早いので…俸禄を増やしましょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101110,
					"content": "哲平はいないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101111
					]
				},
				{
					"id": 20101111,
					"content": "哲平には任務を手配しました。幕府海軍の奇襲作戦です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101112,
					"content": "彼は後方にいたくないようでしたので、彼の選択を尊重しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101113
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101113,
					"content": "ところで話は戻りますが、ある特殊な任務を、あなたに任せたいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101114,
					"content": "「特殊な任務」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101115,
					"content": "はい。海祇島とたたら砂の間に、<color=#00E1FFFF>魔神遺跡</color>があります。あそこにはいくつかの島がありまして、物資輸送の中継地点にも使われるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101116
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101116,
					"content": "しかし近頃、そこに保管された兵糧が忽然と消えてしまうことが多々起きています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101117
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101117,
					"content": "ですが、隊がそこへ行った時、何も危険はなかったとのことでした…この真相をあなたたちに調査していただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101118
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101118,
					"content": "これは急を要することではありません。この何日かはまず、軍に慣れることを優先した方がいいでしょう。海祇島を回ってみてもいいと思いますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101119
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101119,
					"content": "哲平が戻ってきたら、彼ともお話してあげてください。天気のいい日は海に出るのもいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101120
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20101120,
					"content": "哲平、本当に大丈夫かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101121,
					"content": "#あいつうっかり屋だから、なんか心配だ。そうだ、{NICKNAME}、<color=#00E1FFFF>訓練営</color>であいつを待とう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101104,
					"content": "ちょっとだけ「試練」をやった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101105
					]
				},
				{
					"id": 20101105,
					"content": "そうですか、確かに彼らのやりそうなことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101106
					],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
