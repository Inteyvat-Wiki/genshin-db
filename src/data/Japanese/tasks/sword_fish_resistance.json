				"points": []
			},
			"dialogs": [
				{
					"id": 20100901,
					"content": "#久しぶり、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100902
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100902,
					"content": "どう？メカジキ二番隊の人たちとはうまくやってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100903,
						20100904
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100903,
					"content": "順調。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				},
				{
					"id": 20100905,
					"content": "ははっ、じゃあ先輩であるこの僕が、兵をまとめる方法を教えてあげよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100906
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100906,
					"content": "彼らの俸禄を増やして、報奨金も用意する。それに規律を守るように言って…それから、なんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100907
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100907,
					"content": "…哲平、それどこで聞いたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100908,
					"content": "八重堂から出版された小説で読んだんだ…だいぶ前のことだけどね。当時、いくつかの団子と引き換えに、友達に見せてもらったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100909
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100909,
					"content": "小説に書いてあるもので軍隊を率いるなんて、これが俗に言う「机上の空論」ってやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100910,
					"content": "ふふん、僕をなめてもらっちゃ困るな。今の僕は君たちと同じように、「軍隊の統治方法」の勉強と模索をしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100911,
						20100912
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100911,
					"content": "まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100913,
					"content": "そう！海戦で大きな手柄を立ててね、今や僕も特別行動隊の隊長さ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100914
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100914,
					"content": "それに最も新しい小隊で、「ニシン一番隊」っていうんだ！どうだ、凄そうな名前だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100915
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100915,
					"content": "しかも、僕たちの隊服も製作中だって珊瑚宮様から聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100916
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100916,
					"content": "製作が終わったら、一緒に隊服を取りに行こう。新しい隊服を着たら、きっと凄くかっこいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100917
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100917,
					"content": "本当にありがたいことだ。これも全て、支援があったおかげだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100918
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100918,
					"content": "その隊服、オイラにもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100919,
					"content": "もちろん！君も僕たち海祇島軍隊の一員なんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100920
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100920,
					"content": "やったぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100921,
					"content": "隊長、新しい作戦任務が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100922
					],
					"speakerTitle": "内村"
				},
				{
					"id": 20100922,
					"content": "#ああ、今行くよ。じゃあ僕はこれで、{NICKNAME}、また今度ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100923
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100923,
					"content": "君も、僕に軽々追い越されないよう気をつけてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100924
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100924,
					"content": "オイラたちがおまえに負けるもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100925,
					"content": "コホンッ…それはどうかな。僕はいま絶好調でね。手柄を立てるにはもってこいの状態なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100926
					],
					"speakerTitle": "哲平"
				},
				{
					"id": 20100926,
					"content": "まさか哲平が小隊長になるなんてな、どうやら本当に努力してるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100927,
					"content": "少し休憩して、<color=#00E1FFFF>魔神戦争の遺跡</color>に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20100912,
					"content": "哲平も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100913
					]
				},
				{
					"id": 20100904,
					"content": "結構難しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100905
					]
				}
			]
		},
