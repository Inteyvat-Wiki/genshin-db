				"points": []
			},
			"dialogs": [
				{
					"id": 20101301,
					"content": "あなたが新たにメカジキ二番隊の隊長に任命された方ですね。珊瑚宮様からすでにお話は聞いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101302
					],
					"speakerTitle": "メカジキ二番隊代理隊長"
				},
				{
					"id": 20101302,
					"content": "軍でも以前からあなたについての噂が出回っていました。委任状の確認も終わっています。ですが、まだ一つ懸念が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101303
					],
					"speakerTitle": "メカジキ二番隊代理隊長"
				},
				{
					"id": 20101303,
					"content": "ん？なにか問題でもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101304,
					"content": "簡単に言えば、あなたが従う価値のある方かどうかです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101305
					],
					"speakerTitle": "メカジキ二番隊代理隊長"
				},
				{
					"id": 20101305,
					"content": "それってどういう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101306,
					"content": "普段であれば、直接戦ってみればそれで終わる話なんですが、今はちょうど、絶好の的がたくさんあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101307
					],
					"speakerTitle": "メカジキ二番隊の老兵"
				},
				{
					"id": 20101307,
					"content": "ここに来たのは、近ごろ騒ぎを起こす<color=#00E1FFFF>浪人</color>のせいなんですよ。もしそれら<color=#00E1FFFF>浪人</color>を片づけられれば、私たちもあなたの実力を認めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101308
					],
					"speakerTitle": "メカジキ二番隊の老兵"
				},
				{
					"id": 20101308,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101309
					]
				},
				{
					"id": 20101309,
					"content": "おう、オイラたちの実力を見せてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
