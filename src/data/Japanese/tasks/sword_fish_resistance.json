						20101602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101602,
					"content": "これはまだ一部に過ぎません、近くにまだ拠点が二つあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101603
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101603,
					"content": "どの拠点を攻めても、他の二つの拠点にいる浪人の存在が不安要素となるでしょう。彼らは、支援に来るか逃げるか、自由に選択できますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101604
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101604,
					"content": "じゃあ、同時に攻めよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101605
					]
				},
				{
					"id": 20101605,
					"content": "それは、隊長に危険が及ぶ可能性が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101606
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101606,
					"content": "隊を分ければ、隊長の護衛が減ってしまいます。少々不安が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101607
					],
					"speakerTitle": "幸徳"
				},
				{
					"id": 20101607,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20101608
					]
				},
				{
					"id": 20101608,
					"content": "おう、オイラたちがこれくらいで傷を負うもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20101609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20101609,
					"content": "分かりました。では彼らを一網打尽にした後、またここで合流しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "幸徳"
