			"dialogs": [
				{
					"id": 4660101,
					"content": "ディルックの旦那！あのな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660102,
					"content": "ちっ、ガイアのヤツか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660103
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660103,
					"content": "こうなる予感はしていた。あいつにとって、僕から一本取る絶好のチャンスだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660104
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660104,
					"content": "なにやら因縁深そう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660105,
					"content": "それより、騎士団の考えは僕の予想とあまり変わらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660106
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660106,
					"content": "今はその策を逆に利用してやればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660107,
						4660111
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660107,
					"content": "酒場に行かない方がいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660108
					]
				},
				{
					"id": 4660108,
					"content": "ダメだ。騎士団は僕が酒場に行くことを知っているし、行かなければ逆に疑われる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660109
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660109,
					"content": "それもガイアの計算のうちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660110
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660110,
					"content": "じゃあ、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660112,
					"content": "考えるから、静かに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660113
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660114
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660114,
					"content": "…僕を監視するなら、望み通りにしてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660115
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660115,
					"content": "完璧な「アリバイ」を作ればいいだけの話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660116
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660116,
					"content": "「アリバイ」？どうやってだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660117,
					"content": "知りたいなら、一つ手を貸してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660118
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660118,
					"content": "もったいぶるなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660119,
					"content": "<color=#00E1FFFF>ワイナリーの北西</color>に、モンドでも有数の霧氷花の産地があるんだ。そこの霧氷花が今、いい感じに育っているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660120
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660120,
					"content": "それを少し採ってきてほしい。僕はここで他の準備を進めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660111,
					"content": "何かいい案は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660112
					]
				}
			]
		},
