					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660801,
					"content": "<color=#00E1FFFF>ワイナリーの北西</color>に、モンドでも有数の霧氷花の産地があるんだ。そこの霧氷花が今、いい感じに育っているはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660802
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660802,
					"content": "<color=#00E1FFFF>霧氷花</color>を十分に集めてきたら、次の計画に進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				}
			]
		},
		{
			"id": 46609,
			"completionStepIds": [
				46622
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"2"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100052",
							"4"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4660901,
					"content": "ああ、戻ってきたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660902,
					"content": "紹介しよう、こちらはワイナリーの醸造師だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660903,
					"content": "霧氷花がこんなに！今からもう「それ」の効果が楽しみだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660904,
					"content": "精製設備はこの純度に耐えられるか？問題は生じないだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660905,
					"content": "お、おおおお！やっとオーナーに話しかけられた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660906,
					"content": "ご安心ください！オーナーの指示であれば、命がけで完成させてみせます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660907,
					"content": "命をかけるような仕事じゃないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660908,
					"content": "では、お話を続けてください。こちらは仕事を開始しますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660909,
					"content": "その霧氷花でなにするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660910,
					"content": "ああ、実は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660911,
					"content": "この前、ワイナリーで新しい味を開発しようとした時、清涼感をアップさせるため霧氷花を少し入れてみたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660912,
					"content": "精製された霧氷花は確かに魅力的な出来栄えだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660913,
					"content": "じゃあ、よく売れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660914,
					"content": "いや、客を引き寄せたのではなく…それはスライムを引き寄せたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660915,
					"content": "元素力を吸収して生きているヤツらにとって、その誘惑は蠱惑的で抗えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660916,
					"content": "だから、この特性を利用して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660917,
					"content": "ドン！ガラガラッ…ドンドン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660918,
					"content": "うわっ！何の音だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660919,
					"content": "さ、寒いっ！ディルック、様…精製は…か、完了しました…が…せ、設備が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "コナー"
				},
				{
					"id": 4660920,
					"content": "ご苦労。設備の心配はいらない、執事に新しいものを購入してもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660921,
					"content": "出た！金持ち発言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660922,
					"content": "今話していたのがこれだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660923,
					"content": "精製された霧氷花——「元素の餌」とでも呼ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660924,
					"content": "すごい！この体の芯まで響くような元素の気配！どうやって使えばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660925,
					"content": "少し地面に垂らせばいい。気を付けろ…少しだけでいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				}
			]
		},
