						4660721
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660721,
					"content": "これを飲んだら帰るといい。騎士団のみんなによろしく伝えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660722
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660722,
					"content": "あ、ああ…いえ遠慮しておきます。そろそろ騎士団に戻らないといけないので、この酒はディルック様が飲んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660723
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4660723,
					"content": "…うーん…妙だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660724
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4660724,
					"content": "ひぃ…ドキドキしたぞ、絶対バレると思った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660725,
					"content": "それも想定済みだ、だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660726
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660726,
					"content": "…今日、君たち以外の客はみんなアカツキワイナリーの者だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660727
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660727,
					"content": "まさかの全員サクラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660728,
					"content": "全員じゃないさ…正確に言うと、「俺以外は」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660729
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660729,
					"content": "ガイア！なんでこんなところにいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660730,
					"content": "静かに芝居を鑑賞できる場所を選んだだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660731
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660731,
					"content": "まさか…最初からいたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660732,
					"content": "ああ、この「闇夜の英雄のアリバイ」劇は素晴らしかったぜ。その辺の酒よりも遥かにうまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660733
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660733,
					"content": "フン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660734
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660734,
					"content": "それで、この件を騎士団に報告するつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660735
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660735,
					"content": "ハハハッ…俺のことをよく知っているくせに、告発なんかに興味はないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660736
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660736,
					"content": "ただ単に、モンドの「闇夜の英雄」がどこまでやれるか知りたかっただけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660737
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660737,
					"content": "やっぱり、お前はいつも俺の期待を裏切らないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660738
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660738,
					"content": "君の期待に応える義務などない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660739
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660739,
					"content": "ああ、分かっているさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660740
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660740,
					"content": "しかし、一番意外だったのは、孤高の「闇夜の英雄」が他人の助けを受け入れたことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660741
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660741,
					"content": "申し訳ないが、本日の営業はここまでだ。お帰り願えるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660742
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660742,
					"content": "はいはい。いいさ、今夜はもう酒で盛り上げる必要もないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660743
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660743,
					"content": "でも出る前に一つ、言いたいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660744
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660744,
					"content": "…聞こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660745
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660745,
					"content": "ディルック、お前にこの「助手」がいて、俺は不思議と安心したぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660746
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660746,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660747
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660747,
					"content": "素敵な夜を。じゃあ、またな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660748
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4660748,
					"content": "ガイアのあの言葉、どういう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660749
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660749,
					"content": "あいつのことはいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660750
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660750,
					"content": "今回はいろいろと助かった。これは礼だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660751
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660751,
					"content": "おおっ！ありがとう旦那！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660752
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4660752,
					"content": "一人で行動することに慣れてはいたが、君たちの手を借りるのもなかなかに悪くなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660753
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660753,
					"content": "今後、何か助けが必要になったら、僕のところに来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4660710,
					"content": "少し入口の方で体を動かしてたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660711
					]
				},
				{
					"id": 4660711,
					"content": "そうなのか。しかし、なぜ今なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660712
					],
					"speakerTitle": "ホフマン"
				}
			]
		},
