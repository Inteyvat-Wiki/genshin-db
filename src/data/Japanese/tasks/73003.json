					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "ふぅ…ふぅ…やっと終わった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030302,
					"content": "ラナお姉さん…ぐすっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030303,
					"content": "イッサム…男の子なんだから泣かないの。ほら…お姉さんは死域での感覚を…教令院の学者たちに伝えて…それで死域を消してもらえば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030304,
					"content": "#それに…見たでしょ…ラナお姉ちゃんが戦う姿、ううん…{NICKNAME}{M#お兄ちゃん}{F#お姉ちゃん}が戦うところを。{M#彼}{F#彼女}にちゃんとお礼を言うのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030305,
					"content": "ラナ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030306,
					"content": "もう喋らないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "ラナ、とりあえず休んだほうがいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030309,
					"content": "あ…ははっ…大丈夫ですから。ちょっと疲れてめまいがしただけです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030310,
					"content": "ラナお姉さん…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030311,
					"content": "な…なに言ってるのよ。イッサムはトラの子なんだから、泣いちゃダメ！怪我はしてない？気分は…？めまいがするとか、だるいとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030312,
					"content": "おれは大丈夫。でもラナお姉さんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030313,
					"content": "平気だってば…私、こう見えても百戦錬磨のレンジャー長なんだから。さ、行きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030308,
					"content": "助けを呼んでくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
