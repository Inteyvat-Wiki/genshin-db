					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "イッサム…どうしてこんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030202,
					"content": "#うえーん、ラナお姉さん…{M#お兄さん}{F#お姉さん}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030203,
					"content": "あれ？イッサムがなんで…死域に…それに魔物がいっぱいいるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030204,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030205,
					"content": "#ここは{M#俺}{F#私}に任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "まずい…もう時間がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030208,
					"content": "#ああ、もうっ。{NICKNAME}、お願いです！一緒に戦ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030209,
					"content": "イッサムはそこでじっとしてて！いま助けに行くからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030206,
					"content": "あの緑色のは一体…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
			"id": 7300303,
			"completionStepIds": [
				7300306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
