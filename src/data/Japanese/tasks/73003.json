			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#ごめんなさい…{NICKNAME}、パイモン。少し休ませて…イッサム、ちょっと待っててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030802,
					"content": "ラナ、ほんとに大丈夫なのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030803,
					"content": "助けを呼んでくる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "いえ、大丈夫です…ちょっと、休めばよくなりますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030805,
					"content": "ラナお姉さん、ごめん…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030806,
					"content": "もう…大丈夫だって言ってるでしょう。でも、お姉ちゃんは怒ってるんだからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030807,
					"content": "約束したはずでしょ…森には入らないって。私が元気になったら、言うことを聞かなかった罰にお仕置きしちゃうんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030808,
					"content": "ううっ…アルフォンソさんからこの辺におっきなキノコがあるって聞いて、お姉さんに食べさせてあげようと思ったんだ。そしたら元気になるかなと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030809,
					"content": "まったく…余計なお世話よ。私はみんなの顔を思い浮かべるだけで、元気になれるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030810,
					"content": "でも、ふふっ…ここのキノコ、ほんとに大きいね…カレーに入れたらおいしいだろうなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030811,
					"content": "アルフォンソに言われて来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "ううん…アルフォンソさんには、勝手に外に出るなって言われた。でもおれはお姉さんにおいしいものを食べさせたくて…それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030813,
					"content": "アルフォンソがそんなことするはずないですよ。彼はイッサムのお兄さんなんですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030814,
					"content": "そうだな…でも、イッサムはなんで死域に閉じ込められたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030815,
					"content": "森の中で誰かにつけられてる気がしたんだ…「マラーナの化身」かと思ったら怖くなって…それでひたすら走って…ぐすっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030816,
					"content": "そしたら「マラーナ」の中に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030817,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030818,
					"content": "「マラーナ」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "死域のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030820,
					"content": "うん…そう、死域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030821,
					"content": "「マラーナの化身」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "うん。マラーナの代わりに地上で悪事を働く…黒くて、おっきなやつ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030828,
					"content": "マラーナって…変な名前だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030829,
					"content": "ええ。でもなんで私、マラーナが死域だって知ってたんでしょう…？うっ…頭がくらくらする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030830,
					"content": "イッサム、さっきの緑色のは何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030831,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030832,
					"content": "「アランラカラリ」…マラーナに侵蝕されないように人間を守ってくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030833,
					"content": "理解不能なものがどんどん出てくる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "それは…森の「魔法」であり「音楽」…それはラン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030835,
					"content": "それって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "ラナ、とりあえず余計なことはいいから、ゆっくり休んどけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030838,
					"content": "もうちょっとで思い出せそうなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030839,
					"content": "ラナお姉さん、ほんとにごめんなさい…もう勝手に出歩いたりしない。おとなしく家にいるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030840,
					"content": "うん、分かった。イッサムは賢くて、元気で、正しいことと悪いことをちゃんと判断できる人間になるんだよ…キノコが食べられるかどうか見分けられるみたいにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030841,
					"content": "うん…分かったよ…ごめんなさい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "イッサム"
				},
				{
					"id": 730030842,
					"content": "#「マラーナ」は悪で、森は善…強くて正直で、困ってる人を助けられる人になって…{NICKNAME}やパイモンみたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030843,
					"content": "それから、忘れないで…森はすべてを記憶する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030844,
					"content": "マズいぞ。ラナの容態が悪化してる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030845,
					"content": "助けを呼びに行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "え…？ううん…大丈夫…少し休めばよくなりますから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}、お願い…私の代わりにイッサムを家まで送り届けて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030849,
					"content": "ああ、イッサム行こう。ラナ、すぐ帰ってくるからここでじっとしてろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030846,
					"content": "ラナ、ちょっと待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
