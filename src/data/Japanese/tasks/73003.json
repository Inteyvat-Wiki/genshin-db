			"dialogs": [
				{
					"id": 730030101,
					"content": "一緒に来ていただいて助かりました。でも付近の死域の拡大傾向については、ティナリ先輩に報告しなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030102
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730030102,
					"content": "んん？あれは…村の子供じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030103,
					"content": "え？イッサム！待ちなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラナ"
				}
			]
		},
		{
			"id": 7300302,
			"completionStepIds": [
				7300312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
