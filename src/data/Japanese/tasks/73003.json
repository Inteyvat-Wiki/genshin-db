						730030707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030707,
					"content": "そう、ナラはかしこい。アランラカラリはマラーナを止められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730030711,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
