					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "「アランラナ」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "この間、イッサムと話してた時にその名前を聞いたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030724,
					"content": "そう、ナライッサムはアランラナの友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730030725,
					"content": "「アランナラ」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "え？いまアランナラって言ったか？そう言われてみると、前に見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030715,
					"content": "野菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "なんだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "マラーナの侵蝕を防げるとかいう…変な名前のやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730030710,
					"content": "アランラカラリ、マラーナを止められる。ヘンな名前じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "アランラナ"
				}
			]
		},
		{
