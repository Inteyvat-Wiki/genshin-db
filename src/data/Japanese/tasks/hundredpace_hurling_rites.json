			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"廷稚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715230101,
					"content": "うーん、これならそれほど難しくないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230102
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230102,
					"content": "何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230103
					]
				},
				{
					"id": 715230103,
					"content": "ゲームの準備係なんだ…「百発百中の投壺」を聞いたことはあるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230104
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230104,
					"content": "すべての壺が命中するように投げるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230105
					]
				},
				{
					"id": 715230105,
					"content": "おお！ほとんど正解だ、このゲームの真髄はまさに「投げる」こと。だが「壺」を投げるわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230106
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230106,
					"content": "これの遊び方は私も古い本で読んだのだ、簡単に紹介しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230107
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230107,
					"content": "最も伝統的なルールによれば、この「投壺」というゲームは全ての参加者が静かに座っていなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230108
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230108,
					"content": "えっと、静かに座ってさらに特殊な姿勢を保たなければならない——ここでは紹介を割愛するよ、座布団がないからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230109
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230109,
					"content": "静かに座ったら、プレイヤーは特定の音楽のリズムに合わせ、持っている「投矢」を遠くの「壺」に向かって投げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230110
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230110,
					"content": "「投矢」の入れ方、すなわち「役」にも、それぞれ特別な名前がついている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230111
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230111,
					"content": "最初に壺に入った矢は「有初」と呼ばれ、二本目の矢も入れば「連中」という。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230112
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230112,
					"content": "投げた矢が壺の耳に当たれば「貫耳」。壺に入った矢が跳ね返ってくれば「驍箭」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230113,
						715230116
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230113,
					"content": "ふ、複雑すぎる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230114
					]
				},
				{
					"id": 715230114,
					"content": "ご心配なく。言っただろう、これは「最も伝統的なルール」にすぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230115
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230115,
					"content": "皆に遊んでもらいやすくするため、ルールをかなり簡略化した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230118,
					"content": "コホン、とにかく、一定時間内に「投矢」をたくさん壺に入れればいい、あとは…私に任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230119
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230119,
					"content": "ルールがかなり簡単になったね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230120
					]
				},
				{
					"id": 715230120,
					"content": "ああ…その本にあったルールでも、壺に入った矢が多い人が勝ちと書いてあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230121
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230121,
					"content": "負けたら酒を飲んで詩を作れとかは…私はやりたくないな、気まずくなりそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230122
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230122,
					"content": "とにかく！会場準備はほぼできたし、「壺」はあっちだ。「投矢」もすぐに持ってこよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230123
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230123,
					"content": "興味があるなら、プレイしてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230116,
					"content": "お、覚えられない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230117
					]
				},
				{
					"id": 715230117,
					"content": "ご心配なく。こんなに名前を覚える必要はない。これは、その…私が覚えるべきものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				}
			]
		}
	]
}