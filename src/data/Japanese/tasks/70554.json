			"dialogs": [
				{
					"id": 705540101,
					"content": "栄誉騎士殿、白い助手さん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540102
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540102,
					"content": "初めまして、栄誉騎士様、パイモン様。私はグランフィディア、以後ご指示に従います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540103
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705540103,
					"content": "機嫌が良さそうだな、ヘルター！それから初めまして、騎士のお姉さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540104,
					"content": "おっ、もう営業を始めるところなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540105,
					"content": "はい！「エンジェルズシェア」と「キャッツテール」が協力してくれたおかげで、ドリンクスポットの準備は全て整いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540106
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540106,
					"content": "定番のストレートドリンクの他に、ドリンク作成サービスや期間限定のデリバリーサービスもご提供しています…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540107
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540107,
					"content": "ドリンク作成？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540108,
					"content": "そういえばずいぶん前に「エンジェルズシェア」でバーテンダーをやってたよな？最近じゃ、ナド・クライの「フラッグシップ」でも腕を振るってたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540109,
						705540110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540109,
					"content": "そうだね。でも随分前のことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				},
				{
					"id": 705540111,
					"content": "今あるドリンクメニューは伝統的なものばかりで、遠征が始まる前から慣れ親しんでいました。そこで新しい選択肢を提供するため、メニューの改良を考えているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540112
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540112,
					"content": "しかし、私は住民依頼の管理に戻らなければなりません。グランフィディアはドリンク作成の経験が不足していますし、デリバリーの注文対応もありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540113
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540113,
					"content": "もし時間がありましたら、少しの間、手伝っていただけないでしょうか？しばらくすれば、もう一組の部下が望風山地から戻ってきますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540114
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540114,
					"content": "もちろん、報酬はお支払いします。さらに、残業手当も2倍出しますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540115,
						705540116
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705540115,
					"content": "ドリンク作りには結構自信があるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540117,
					"content": "細かい経営のことはわからないけど、オイラ、デリバリー注文の手伝いならできるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540118,
					"content": "テイワット最高のガイドとして、オイラも時代に乗り遅れないように街を回って、モンドの最近の変化を知っておきたいしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540119,
					"content": "こんなにあっさり、お二人の協力を得られるとは思いませんでした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540120
					],
					"speakerTitle": "ヘルター"
				},
				{
					"id": 705540120,
					"content": "私はパイモン様を全力でサポートさせていただきます。飲み物の小分け作業などは、得意ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540121
					],
					"speakerTitle": "グランフィディア"
				},
				{
					"id": 705540121,
					"content": "じゃあ、さっそく始めようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705540116,
					"content": "バーカウンター全部任せてくれてもいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540110,
					"content": "よく覚えてないけど、大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				}
			]
		}
	]
}