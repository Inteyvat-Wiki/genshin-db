			"dialogs": [
				{
					"id": 752710601,
					"content": "ユプイ！来てくれたんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710602,
					"content": "ジキ…？あなたなの？どうしてそんな格好をしてるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "ユプイ"
				},
				{
					"id": 752710603,
					"content": "ほら、君の大好きなナナシアンだよ…借りてきたんだ。どうかな？それにこのバルーンも、僕が用意したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710604,
					"content": "実はずっと前から言いたかったことがあるんだ…僕と付き合ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710605,
					"content": "あ…頭がどうかしちゃったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "ユプイ"
				},
				{
					"id": 752710606,
					"content": "違うよ！愛しのユプイ、どうか付き合ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710607,
					"content": "本当に頭がおかしくなったんじゃないの？今日は私たちが結婚して三周年なのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "ユプイ"
				},
				{
					"id": 752710608,
					"content": "もちろん覚えてるさ！でも…ちゃんとした告白をしたことがなくて、ずっとロマンチックさの欠片もないって言われてたから…遅れた告白だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710609,
					"content": "あは…そうだったの？ふふ…じゃあ喜んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "ユプイ"
				},
				{
					"id": 752710610,
					"content": "えっ？ほんとう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710611,
					"content": "ええ、喜んで。ロマンチックな私のダーリン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "ユプイ"
				},
				{
					"id": 752710612,
					"content": "ゆったりした風が吹き、二人は抱きしめあった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
