			"dialogs": [
				{
					"id": 752710101,
					"content": "そのバルーンを壊さないで。遊びたいなら、別のバルーンをあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710102,
					"content": "このバルーンは特別みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "ちょっと気恥ずかしいけど…これは大事な小道具なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710104,
					"content": "何に使うものかは見れば分かるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710105,
					"content": "プロポーズ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "告白だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710109,
					"content": "このロマンチックなバルーンの真ん中で、愛しのユプイに自分の気持ちを伝えるんだ。どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710110,
					"content": "赤いバルーンを使うべき。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "へえ？確かに一理あるね…もっと「ロマンチック」について勉強したほうがいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710112,
					"content": "でも、もうすぐユプイが来るんだ。今からどこに赤いバルーンを探しに行けばいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710107,
					"content": "告白？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "あ…当たり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "ジキ"
				}
			]
		},
