			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "ロマンチックな赤いバルーン！すごくきれいだ…ユプイもきっと気に入るよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710302,
					"content": "君もそう思うだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710303,
					"content": "えっと…どうかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "とにかく、君には本当に感謝しているよ。まだ行かないで。ユプイにも紹介したいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710306,
					"content": "そろそろやって来るはずだ。約束したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジキ"
				},
				{
					"id": 752710304,
					"content": "もちろん。感動すると思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
