			},
			"dialogs": [
				{
					"id": 400680501,
					"content": "扉に鍵がかかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680502,
					"content": "モナ、水に変身して中に入ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "何をバカなことを言っているんですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680506,
					"content": "辛炎、なんで扉に鍵をかけたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680507,
					"content": "ハハ、そう聞かれても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680508,
					"content": "うーん、でもアタイは家の前にある植木鉢の下とかに鍵を置くような人間だから...近くに鍵があるはずなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680509,
					"content": "おう！じゃあ、どこかに植木鉢があるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680510,
					"content": "植木鉢はないけど…あれは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "可能性がないとは言い切れねーな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680504,
					"content": "万葉が高く飛べば、きっと解決するはず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "…遠慮しておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "楓原万葉"
				}
			]
		},
