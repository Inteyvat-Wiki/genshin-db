			"trigger": {
				"objectNames": [
					"楓原万葉",
					"辛炎",
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "おきろ——！お日様の光がお尻に当たってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680202,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "#パイモン、{M#俺}{F#私}は仰向けで寝ていた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "じゃ、おなかに当たってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}、よく眠れたでござるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680206,
					"content": "まあまあ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "皆そのような感じだ。拙者は一番早く起きたゆえ、今朝は辺りを散策して朝餉になりそうな果物を採ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680209,
					"content": "一緒に食べようと思って、オイラずっと我慢しながらおまえが起きるのを待ってたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680210,
					"content": "みんなと一緒に朝食をとった。果物を食べながら、みんなは雑談し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "ん？フィッシュルはいなかったけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680212,
					"content": "うん、アタイたちと一緒に行動したくないみたいなんだ。冒険者協会から他の仕事が入ったって言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680213,
					"content": "それ、明らかに嘘じゃないか！幽夜浄土を復興するために来たって言ってたのに、なんでまた冒険者協会の仕事をするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680214,
					"content": "いいから…パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "彼女のあの様子、何か悩みがあるのであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680216,
					"content": "アタイたち、昨日と同じように、モナについててもらおうとしたんだ。だけど、モナは冒険者の仕事を知らないから、一緒に冒険には行けないって断られたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680217,
					"content": "一人になるために、幽夜浄土って言い訳も出さかったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680218,
					"content": "彼女はかなり大きな困り事を抱えていると見えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680219,
					"content": "はぁ、友人としてフィッシュルを助けてあげたいですが、今日は彼女の言う通り、他の島を探索しに行くことになりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680220,
					"content": "え？そうなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "満場一致だったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680222,
					"content": "#{M#俺}{F#私}は何も言ってないから満場じゃない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "あんたの分はパイモンが代わりに投票した。あんたらはコンビだから、あんたのいる場所にパイモンがいて、逆も同じなんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680224,
					"content": "へへ、おまえは冒険者だぞ。絶対行くだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680225,
					"content": "（パイモン…しょうがない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "私たちはみんな一緒に行動した方がいいと、フィッシュルが言ったんです。調べたいことがあるらしくて、それが終わったら合流するから心配する必要はないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680227,
					"content": "ああ見えて経験豊富な冒険者ですから、彼女を信じていいと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680228,
					"content": "拙者はフィッシュル殿と知り合ったばかりで、これはあくまでも推測に過ぎぬが——彼女は…彼女自身の中に矛盾を抱えているのではなかろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680229,
					"content": "なんだか当たってるような感じがするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680230,
					"content": "他人との齟齬は、解決に向かって努力するか諦めるかの二択だが、自己矛盾は、簡単に捨て去れないものでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680231,
					"content": "…拙者にもそのような時期があったから分かる。彼女が何に悩んでいるのかは知らぬが、今必要としているのは、一人の時間でござろうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680232,
					"content": "アタイもそう思うぜ。でも、せっかくの冒険なのにちょっと勿体ないよな…だって、みんなで一緒にいるほうが面白いぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680233,
					"content": "辛炎はほんとに前向きだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680234,
					"content": "そうだ！まだ言ってなかったけど、今朝、北にある島であの不思議な現象が起きたみたいなんだ。旅人が朝食を食べ終わったら、調べに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680207,
					"content": "悪くない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
			"completionStepIds": [
				4006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
