			"dialogs": [
				{
					"id": 400681001,
					"content": "うわ、外だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400681002,
					"content": "ん～やっぱり外は明るいぜ。あの熱い洞窟も嫌いじゃないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400681003,
					"content": "「寒山甘泉」はこの辺りの山にあるはずでござる。探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400681004,
					"content": "待ってください、どうして地下なのに光があるんですか？これは…水脈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400681005,
					"content": "あの花によると…水脈は植物に関係があって、植物は山の泉と関係してる。だからきっと、水脈に沿って進めば問題ないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
