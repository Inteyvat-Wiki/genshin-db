				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "うわ！すっごくでかい花だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680902,
					"content": "なんだか熱いですね…あの花と何か関係があるんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680903,
					"content": "まさか、ここに客が来るとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680904,
					"content": "うわああああ、こ、こいつしゃべれるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680905,
					"content": "昨日はリスもしゃべった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "それはそうだけど！で、でもやっぱりなんか感じが違うだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680908,
					"content": "よう！アタイたち、外の浜辺にあった鼓みたいな植物を触ったらここに送られてきたんだ。あんたはここの主人か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680909,
					"content": "ここは音楽の殿堂。私はただの門番に過ぎない。友よ、そなたたちも究極の音楽を求めにきたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680910,
					"content": "その通りさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680911,
					"content": "それでは、そなたが音楽に託すものは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680912,
					"content": "アタイの歌は反逆の歌だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680913,
					"content": "ほう！素晴らしい。そなたとは分かり合えそうだ——出会えたことを幸運に思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680914,
					"content": "変な花とも気が合うんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680915,
					"content": "付き合いやすい人と言うのは、どこに行っても友達がたくさんいますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680916,
					"content": "ここまで辿り着けたのだから、より深い殿堂に入りたいだろう。しかし殿堂に入るためには、私の歌声が必須。すまないが、今は少し声が枯れてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680917,
					"content": "大丈夫か？えっと、その…悪寒に利く薬でも飲むか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680918,
					"content": "いや…私はただ、長いこと「寒山甘泉」を口にしていないだけだ。あれさえ飲めば再び歌えるようになり、道を開けてやれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680919,
					"content": "「寒山甘泉」？それって泉の名前か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680920,
					"content": "そう。その水を飲めば、疲れた大人も眠い小鳥も、物心つかぬ子供まで…誰もが美しい歌を歌えるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680922,
					"content": "よし、探してきてやるよ。泉の場所を教えてくれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680923,
					"content": "感謝する！澄んだ水で育った植物は困難を乗り越え、山を登る…泉は、緑豊かな山の上だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680924,
					"content": "山に登るのか！海水を汲めばいいのかと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680925,
					"content": "泉の湧き水と海水は全然違うでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680926,
					"content": "ただ…泉をその目に映すには、私の力が必要かもしれない。手を差し伸べなさい。そなたに私の世界を見せてやれるようにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "灼火の心"
				},
				{
					"id": 400680927,
					"content": "アタイと握手したら、もうアタイの友達だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680906,
					"content": "昨日は船もしゃべった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
