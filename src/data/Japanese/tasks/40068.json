			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原万葉",
					"モナ",
					"辛炎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "普通の島に見えるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680302,
					"content": "…風の匂いが、熱く燃えているようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680303,
					"content": "えっと…水占の盤が少し明るくなりましたが、まだ見えません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680304,
					"content": "おい！みんな、これを見ろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680305,
					"content": "これは…鼓というべきか、それとも植物っていうべきか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680306,
					"content": "植物でできた楽器であるか？ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680307,
					"content": "辛炎、ここはもしかすると、あなたに関する島ではありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680308,
					"content": "えっ、じゃあこれはアタイのために用意された楽器か？それならさっそく打ってみようかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680309,
					"content": "待たれよ。昨日は拙者が盆景の築山に触れると、皆が特殊空間に移動したでござろう。辛炎殿、先に準備をしたほうがよいのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680310,
					"content": "そうかもな、でも心配いらないぜ。アタイは音楽にかけては、常に準備万端だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛炎"
				}
			]
		},
		{
