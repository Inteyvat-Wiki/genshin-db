				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "コ、コホン、埃まみれだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680402,
					"content": "大丈夫か、パイモン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680403,
					"content": "やはり、場所が変わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680404,
					"content": "何だか荒れた場所のようですが…辛炎、ここはあなたに関する幻境なんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680405,
					"content": "そうだと思うんだけど…変だな、何でこんなに荒れてんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680406,
					"content": "見ろ！あそこ、すごく明るいぞ。オイラたちを誘ってるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680407,
					"content": "ふむ、行ってみるとするか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680408,
					"content": "いやいやいや！どう見ても罠だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400680409,
					"content": "それはそうですが、他に道もありませんし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400680410,
					"content": "確かに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "それに、もしこれが辛炎殿の幻境なら、罠などあるはずがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400680412,
					"content": "嬉しいぜ！こんなに早くアタイを認めてくれるなんてさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400680413,
					"content": "確かに一理あるな、それじゃ行ってみるか。でも気をつけろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
