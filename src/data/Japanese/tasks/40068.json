			"dialogs": [
				{
					"id": 400681501,
					"content": "これがオイラたちの探してた「寒山甘泉」のはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400681502,
					"content": "これを飲めば、美しい歌を歌えるようになるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681503
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400681503,
					"content": "興味があるならば、試してみるとよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681504
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400681504,
					"content": "いやいや！私は歌を歌えませんから…万が一効かなかったら恥ずかしいじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681505
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400681505,
					"content": "ハハハ、モナの声は綺麗だから、歌に向いてるぜ。もしよければ、拠点に戻ってから歌う時の呼吸法を教えてやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681506
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400681506,
					"content": "え？ほ、本当にいいんですか？ぜ、絶対に笑わないって約束してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681507
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400681507,
					"content": "もちろん、笑わったりしないさ。誰だって初めはゼロから学ぶんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681508
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400681508,
					"content": "はい…それじゃ、試してみてもいいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681509
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400681509,
					"content": "よし。じゃあその前に、泉の水をあいつの元に届けようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681510
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400681510,
					"content": "浜辺にある鼓に触れれば、幻境に入れるでござる。もう一度やってみるとよい。",
