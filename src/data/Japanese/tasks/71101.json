	"talks": [
		{
			"id": 7110101,
			"completionStepIds": [
				7110101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110101",
							"2"
						],
						"stepId": 7110101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"鍾離",
					"田饒舌"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711010101,
					"content": "おい、見ろ。本当にいたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010102,
					"content": "おーい！鍾離——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010103,
					"content": "ん？ああ、お前たちか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010104,
					"content": "オイラたち、おまえに聞きたいことがあるんだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010105,
					"content": "すまないが、少し待っていてはくれないか？今、手が離せない状況でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010106
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010106,
					"content": "なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010107,
					"content": "ていうか、こんなに早く城内に戻ってくるなんて…すごいスピードだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010108,
					"content": "こちらのお二方は鍾離さんのご友人でしょうか？よくあなたを探しにこちらへ来ているようですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010109
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010109,
					"content": "ああ、互いによく知る友人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010110,
					"content": "なるほど、そうでしたか。では、もしお時間がありましたら、お二方も一緒に説得していただけませんでしょうか。実は今、鍾離さんに老石を譲っていただけないかお願いしていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010111
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010111,
					"content": "老石を？なにに使うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010112,
					"content": "お二方はご存じないかもしれませんが、老石は今やとても希少な鉱石でして、かなり値が張るものなんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010113
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010113,
					"content": "今日、いつものように講談をしていたところ、常連の鍾離さんがいらっしゃいました。物語も進んでいき、私の十八番である「創龍点睛」を語ることになりまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010114,
						711010115
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010114,
					"content": "あの物語だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				},
				{
					"id": 711010116,
					"content": "いい物語でしょう？実は鍾離さんからも、よく講談を褒めていただけるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010117
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010117,
					"content": "鍾離さんは見識が広く、世情にも通じているお方。私もそれは知っていたのですが、歴史や神話に対しても造詣が深いことを知りませんでした。ですので、それに関する質問を鍾離さんにしていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010118
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010118,
					"content": "微力ながら、お役に立てて何よりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010119
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010119,
					"content": "いえいえ、大変助かりました！ほら、雑談は趣の分かる方とすべき、とよく言うではないですか。その点において、鍾離さんは様々な考えをお持ちなので、いつも妄想を膨らませていただいております、はははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010120
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010120,
					"content": "以前、私はこのようなことを鍾離さんに言いました——「この物語は、岩王帝君が霊石で若陀龍王を彫るところから始まります。その後、戦いへと発展するのです。どうです、素晴らしい構成でしょう！」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010121
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010121,
					"content": "そうすると鍾離さんは、「物語は良いが、細部が少し異なる。他の者も考察しているように、岩王帝君は彫刻の腕がさほど高くなかった。あまり美しいものは彫れなかっただろう。」とおっしゃったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010122
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010122,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010123
					]
				},
				{
					"id": 711010123,
					"content": "風情に欠けると、そう思いませんか？以前、軽策荘の螭が山水となって、美しい景色を創り上げたという話をした時も…世の中、そのように上手くいくことはないとおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010124
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010124,
					"content": "はぁ、人は見識が広くなると詩情に欠けてしまうものなのでしょうか？鍾離さんを見てください。こんなにも整った身なりをしているのに、どうして風情がないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010125
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010125,
					"content": "田殿の言葉は確かに一理ある。このことは心に留め、しかと反省しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010126
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010126,
					"content": "しかし、田殿の物語はいつも躍動感に溢れたものだ。俺はただ田殿の参考になるようにと、一般的な見解を述べただけに過ぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010127
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010127,
					"content": "それに講談師は知的な者が多い。田殿の眼力をもってすれば、俺のような真摯な聞き手がここを訪れる理由も理解できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010128
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010128,
					"content": "もちろんですとも！鍾離さんが私を思っておっしゃってくれたということは、重々承知しております。きっと私に、璃月港一の講談師になってほしいと思っているんですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010129,
						711010130
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010129,
					"content": "（全然分かってないと思う…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010131,
					"content": "で、それが老石となんの関係があるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010132,
					"content": "ああ、そうでしたね、話を戻しましょう。実はこの前、他の方にも『創龍点睛』を語ったんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010133
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010133,
					"content": "二番煎じっていうか、むしろ煎じ過ぎじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010134,
					"content": "語り継がれる価値のある物語と言ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010135
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010135,
					"content": "確かに田殿の物語には、何度も繰り返し語られるものがある。だが講談は創作と同じ、作るには時間がかかるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010136
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010136,
					"content": "やはり、鍾離さんは分かっていらっしゃる。その日、通りかかった鉱夫が私の講談を聞いて、こう言ったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010137
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010137,
					"content": "層岩巨淵を知ってるか？あそこにはとても綺麗な、上品な色をした石があってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010138
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010138,
					"content": "その石は、層岩巨淵の長い道の上にあるんだ…と言ったのです。これは本当なのでしょうか？道とはいったい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010139
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010139,
					"content": "大方、間違ってはいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010140
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010140,
					"content": "層岩巨淵は謎に包まれた場所。たとえ見識の広い鍾離さんであっても、そこには行ったことがないくらいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010141
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010141,
					"content": "ただ、最近になって鉱業もいくらか持ち直し、徐々に人の出入りも増えてきたそうです。まあ、私も人づてに聞いた話ではありますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010142
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010142,
					"content": "ああ、確かにそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010143
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010143,
					"content": "道の上に石があると言っていましたが、ならばその道はどのようにしてできたのでしょう？確かなことは誰にも分かりません。ただ、まるで何か巨大なものが通ったかのような、曲がりくねった道があるそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010144
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010144,
					"content": "激しい戦いの末、それを見た者は誰もが衝撃を受けた！そう、それは古き戦場であったのだ——と、そう言っている者もいますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010145
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010145,
					"content": "しかし、一体誰と誰が戦ったのでしょう。私たちには分かりません。ただ私が思うに、岩王帝君と若陀龍王もあの地で戦ったことがあるのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010146
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010146,
					"content": "実を言うと、いま新しい講談を作っているんです。それには、この話を取り入れたいと思っています。とても素晴らしい作品になることは間違いありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010147
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010147,
					"content": "だから、鍾離さんをお招きして、ご意見を伺おうと思いまして。ですがまさか、ちょうど手元に老石があるとは思いませんでした…商人から手に入れたとおっしゃっていましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010148
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010148,
					"content": "優れた目があれば、自然と選別にも長けるのですね。その老石は言わば、私の物語の象徴となる存在です。鍾離さんさえ良ければ、その石を買い取り、記念にしたいと思っているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010149
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010149,
					"content": "鍾離…ホントにこいつに石を譲るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010150,
					"content": "ふむ…田殿は講談師の中でも、非常に優れたお方だ。それに、俺はその忠実な聞き手の一人でもある。もし田殿の創作に利するのであれば、喜んで支援しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010151
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010151,
					"content": "いいのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010152,
					"content": "しかし、このまま石を渡してしまっては、田殿の話に手抜かりが生じてしまう。考えてみてほしい、岩王帝君はあの若陀龍王を本当にその地下に封じたのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010153
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010153,
					"content": "専門家の話によると、層岩巨淵の下には洞窟と坑道がいくつもあるらしい。もしも若陀龍王がそこに封じられているのなら、きっと毎日のように眠りを妨げられることになる。そのような可能性を、岩王帝君は考えなかったのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010154
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010154,
					"content": "たしかに…その通りだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010155,
					"content": "それもそうですね…岩王帝君はそのような考えなしの行動はしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010156
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010156,
					"content": "うん、確かに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010157
					]
				},
				{
					"id": 711010157,
					"content": "はぁ…実は私、このお気に入りの扇子と、鍾離さんの老石を交換しようと思っていたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010158
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010158,
					"content": "あれ？そこに描いてあるのって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010159
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010159,
					"content": "いかにも。これは、私が『創龍点睛』を語るときに持つ扇子です。龍は空へと舞い、天下を駆け巡る。心は高みにあり、まさに広大無辺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010160
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010160,
					"content": "わぁ…めずらしい扇子だな。オイラも欲しくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010161,
					"content": "そうだ、老石ならオイラたちも持ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010162,
					"content": "なんですと！？お、お二方、老石を私に譲っていただけませんか？もちろん、この扇子と交換いたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010163
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010163,
					"content": "それは考え直したほうがいいだろう、田殿。老石は貴重なものであり、その扇子も決して一般の品ではない。そのような交換は、双方にとって損失を生むことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010164
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010164,
					"content": "そ…そうですか？私の扇子は、なにも一本だけではないのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010165
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010165,
					"content": "田殿が描いた絵は、実に素晴らしきものだ。その題材となった講談が好きな者であれば、きっと誰もが喜ぶ品だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010166
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010166,
					"content": "本当ですか？いえ…確かにそうですね。分かる人には分かると言いますから…私は何より、もっと多くの方に物語を認めていただきたいだけ。この扇子に絵を描いているのも、いつか縁ある方に贈るためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010167
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010167,
					"content": "であれば尚のこと、扇子は差し上げるべきかと！なにせ、皆さんも私と縁のあるお方ですから。少々お待ちください、今すぐ持ってまいりますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010168
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010168,
					"content": "田饒舌はまるで風のような速さで、すぐに二本の扇子を持ってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711010169
					]
				},
				{
					"id": 711010169,
					"content": "本当にいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010170
					]
				},
				{
					"id": 711010170,
					"content": "もちろんです。私の講談を聴いたことがあるのですから、それは縁があるということ。それに、私の扇子は一本だけではありません。あなた方に差し上げるのが、もっとも相応しいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010171
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010171,
					"content": "鍾離さんも遠慮なくどうぞ！手作りなので、お気に召すかは分かりませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010172
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010172,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010173
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010173,
					"content": "田殿の気持ち、遠慮なく受け取ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010174
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010174,
					"content": "…こんなにも良き扇子だ、大切にする価値がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010175
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010175,
					"content": "あっ、そうだ！オイラたちが鍾離に会いに来たのって、あの話がしたかったからだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010176
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010176,
					"content": "すみません、お邪魔してしまったようですね。どうぞどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010177
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 711010177,
					"content": "邪魔だなど、とんでもない。田殿、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010178
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010178,
					"content": "鍾離、おまえ層岩巨淵に来てたよな？みんなを救ったのっておまえだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010179
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010179,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010180
					]
				},
				{
					"id": 711010180,
					"content": "魈も、もしおまえの助けがなかったら、脱出できなかったかもしれないって言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010181
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010181,
					"content": "そのようなことを？ふむ、それは興味深いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010182
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010182,
					"content": "時が経つにつれ——心を開くようになったということか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010183
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010183,
					"content": "それで、なんで層岩巨淵にいたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010184
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010184,
					"content": "おや？何かあったのか。俺の耳には届いていないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010185
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010185,
					"content": "えっ！？お、おまえ、とぼけるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010186
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010186,
					"content": "ははっ、とぼけてなどいない。ふむ、先ほどの扇子、実に良きものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010187
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010187,
					"content": "鍾離！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010188
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711010188,
					"content": "…俺はただの閑人に過ぎない、四方をさすらうのもごく自然なことだ。道中、何かに遭遇したのなら、それは縁によるもの。礼など必要ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010189
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010189,
					"content": "この広大な世へと思いを馳せるには、まだまだ各地を見て回るべきだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010190
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010190,
					"content": "鍾離先生も過去が懐かしいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010191
					]
				},
				{
					"id": 711010191,
					"content": "そんなことはない。俺は今やただの人だ。人は常に、今を生きている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010192
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010192,
					"content": "龍は空へと舞い、天下を駆け巡る。心は高みにあり、まさに広大無辺…何も間違ってなどいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711010193
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010193,
					"content": "東西南北、至る所に喜びは満ちている。天地山海、それすべてが佳境だ。今後も時間が許す限り、世を渡り歩くことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 711010130,
					"content": "（ただ細部が違うと言いたかっただけ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010131
					]
				},
				{
					"id": 711010115,
					"content": "#{M#俺}{F#私}も時々思い出すことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711010116
					]
				}
			]
		}
	]
}