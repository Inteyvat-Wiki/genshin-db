			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "前に拾ったノートと紙を彼に渡した…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "ちょっと見せて……うん、間違いない！これだよ…！本当にありがとう。この中には、ファデュイの悪事の証拠がたくさん書いてあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910205,
					"content": "悪事の…証拠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760910206,
					"content": "見てよ、あいつらがパハ島に建てた施設と持ち込んだ機械装置を…あそこは元々、たくさんの動物たちの住処だったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910207,
					"content": "僕、クリムゾン・ソルトマーシュから戻ったばかりなんだけど…きっとファデュイの機械のせいで、あそこのクラゲたちは衰弱してるんだ…みんなにこのことを知らせないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910208,
					"content": "え？ヴァルベリーゼリーたちのことか？でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760910209,
					"content": "クリムゾン・ソルトマーシュでの出来事を語った…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "やっぱり、もう遅かったのかな…それでも、やっぱり記録は残さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910211,
					"content": "このノートはあげるよ。僕は急いで戻って、他のノートの内容を整理して、記事にまとめないといけないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910213,
					"content": "あ、そうだ！もし誰かに話す時は、ちゃんと「セミヨン」、つまり僕が教えたって言ってね。帰って記事にまとめて新聞にするには、まだちょっと時間がかかるからさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910214,
					"content": "とにかくありがとう！じゃあ、またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
