					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "空飛ぶ妖精さん！僕のノート…大切なノートがファデュイに取られちゃったの。取り返してきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910102,
					"content": "オイラは妖精じゃないけど…そのくらいなら手伝ってあげられるぞ！それにしても、ファデュイはなんで子供のノートを取り上げたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760910103,
					"content": "僕がノートの内容を公開するのが怖いのかも…ノートを取り返してくれたら、その秘密をあなたたちにも教えてあげるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910105,
					"content": "でも、そんな話は後だよ。とにかく<color=#00E1FFFF>ノートを取り返して</color>ほしいんだ。ノートから散らばった<color=#00E1FFFF>紙も落ちてるかも…</color>場所はそこのファデュイがいるところだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
			"beginWay": "TALK_BEGIN_AUTO",
