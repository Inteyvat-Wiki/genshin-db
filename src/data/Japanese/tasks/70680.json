					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "お客さん、こっちこっち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800102,
					"content": "いい知らせがあるんだ。ちょっと遅くなっちゃったけど…新しい舞台を用意できたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800103,
					"content": "観客に素晴らしいショーを披露したお客さんは、絵の世界の扉を開く鍵を入手できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800104,
					"content": "待て待て！物語の本の次は絵の世界なのか？この場所、ますますワケがわからなくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706800105,
					"content": "言いたいことは分かるぞ！でも、物語の本でこんな話を読んだことがあるんだ——マジシャンが観客にタネ明かしするのは、観客の楽しみを奪うことだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800106,
					"content": "だから、分からないくらいがちょうどいいんだ。魔女の姉ちゃんの魔法は愛と同じで、考えるんじゃなくて感じるものなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800107,
					"content": "まぁそう言われると、納得できるような…でも絵の世界の舞台は、前の舞台とどう違うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706800108,
					"content": "絵の世界にはルールがたくさんあるんだ。新しい舞台では「友情」と「信頼」関係が試される。物語によくあるテーマだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800109,
					"content": "そして試練を乗り越えた人は、魔女の姉ちゃんから小さな祝福をもらえる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800110,
					"content": "えっ？幸運を呼ぶおまじないとかか？だったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706800111,
					"content": "気軽に願い事をしないほうがいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "うっ！たしかに、気軽に願い事なんてしちゃいけないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706800114,
					"content": "絵の具はもう額縁に落とされた。魔女の姉ちゃんがくれる小さな祝福ももう秘密じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800115,
					"content": "お客さん！準備ができたら、絵の世界の舞台に入ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800116,
					"content": "「口笛を吹いて、悩みを忘れて、勇気を胸に抱くんだ！」——物語の登場人物が新しい冒険へ出るときみたいにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子オオカミ"
				},
				{
					"id": 706800112,
					"content": "たぶん違うと思う、それに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}