			"dialogs": [
				{
					"id": 200040501,
					"content": "おかえりなさい、家賃をゲーテさんに渡してきてくれましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040502,
					"content": "全部渡した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "よかったです。幸いこの部屋の家賃はそれほど高くなかったので…なんとか掻き集めることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040504,
					"content": "もう何日か、サラダを食べなければいけないようですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
