			"trigger": {
				"objectNames": [
					"ゲーテ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "ありがとう、これで十分だ。これを職人に渡して…それから、家賃の回収にも行かねば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040702,
					"content": "はぁ…あのアス…アス…なんとかモナが、家にいるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040703,
					"content": "アストローギスト·モナ·メギストス。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "そうそう！そんな名前だった。まったく私としたことが…すぐ忘れてしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040705,
					"content": "ん？モナはまだ家賃を払ってないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200040706,
					"content": "ああ。他の人たちからはもう受け取ったが、彼女だけまだなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040707,
					"content": "何回も出向いたんだが、いつも不在でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040708,
					"content": "旅人、悪いんだが、私の代わりに家賃を回収しに行ってきてくれないかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲーテ"
				}
			]
		},
