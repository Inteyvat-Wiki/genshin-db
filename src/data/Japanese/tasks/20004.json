			"dialogs": [
				{
					"id": 200040401,
					"content": "どうだった？えっと…君たちのお友達は見つかったかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040402,
					"content": "家賃はこれで大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "おお、これで大丈夫だ。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040404,
					"content": "しかし…君たちの友達は、いったい何をしているのかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040405,
					"content": "とても有能そうなのに、いつもお金に困っているようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲーテ"
				}
			]
		},
