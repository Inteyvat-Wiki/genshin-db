				"objectNames": [
					"モナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "あなたでしたか、お久しぶりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040302,
					"content": "慌てているようですが、私に何か用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040303,
					"content": "モナ、ここ最近どこに行ってたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200040304,
					"content": "何日も探したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "それはすれ違いでしたね。あいにく…数日前に『スチームバード新聞』から新たな原稿の依頼を受けたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040306,
					"content": "「星の軌道変化と個人の運命の関係」というトピックです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040307,
					"content": "その原稿を書くために、何日も野外で星を観測し、夜遅くに帰っていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040308,
					"content": "モナ…お金を稼ぐために頑張ってるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 200040309,
					"content": "フォンテーヌで新しいプラネタリウムが出るんですよ。実はもう…手付金も払ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040310,
					"content": "今回の原稿料が入って残りを払えば、正式にあのプラネタリウムを手にできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040311,
					"content": "ゲーテさんへの家賃は大丈夫なの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "家賃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040313,
					"content": "あっ…！た、確か…お金を残しておいたはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040314,
					"content": "ちょっと待ってください、探しますので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040315,
					"content": "（モナは自分の財布を漁り始めた…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "これと…これで！家賃が払えるはずです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 200040317,
					"content": "（もしかして、全財産…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "このお金をゲーテさんに渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
