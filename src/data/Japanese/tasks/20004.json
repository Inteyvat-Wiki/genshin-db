			"trigger": {
				"objectNames": [
					"ゲーテ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "はぁ…どうやら、直々に行かねばならんようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040102,
					"content": "この老いぼれた体は、いつガタが来てもおかしくないというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040103,
					"content": "何か急用でもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "おや、旅人じゃないか。いや…急用ではないんだが、ちょっと厄介なことがあってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040105,
					"content": "ファデュイが私のホテルを貸し切り状態にしていることは、君も知っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040106,
					"content": "彼らにホテルを貸してから、私も「ゲーテホテル」のオーナーとして、当然ながら彼らの世話をした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040107,
					"content": "食材の仕入れ先への連絡、修理の手配、他にも雑事を色々とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040108,
					"content": "最近は、ホテルの机と椅子が壊れたから、直ちに適切な木材を職人に届けるための手配をしたり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040109,
					"content": "街で貸してる部屋の、家賃を回収しに行ったり…まったく、家賃回収の時、マーヴィンはいつも姿を消すんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040110,
					"content": "はぁ、この老いぼれがあと何年こうして続けられるだろうか…それに、マーヴィンはいつになったらもう少し利口になってくれるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040111,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "手伝ってくれるのか？とても助かるよ。マーヴィンのやつも、君のようにしっかりしてくれたら、私がこんなに疲れることもないんだがね…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040114,
					"content": "それじゃあ悪いが、杉材と樺材をそれぞれ一つ用意してきてくれないか。すぐに職人に渡す必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゲーテ"
				},
				{
					"id": 200040112,
					"content": "ここでちょっと休んでて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
			"completionStepIds": [
				2000403
			],
