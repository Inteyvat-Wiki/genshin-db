					}
				]
			},
			"dialogs": [
				{
					"id": 765110101,
					"content": "試合もここまで進み、そろそろあの達人が顔を出すだろうとネフェルさんは予測してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110102,
					"content": "いかにも、シエチェフ殿。すでに夜風が彼の者の気配を運んできてくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110103,
					"content": "#久しぶりでござるな。{NICKNAME}、パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110104,
					"content": "お主らの相変わらず元気そうな姿が見れて、心から嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110105,
					"content": "万葉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "万葉がナド・クライに来てたなんてな。このライトキーパーと話してたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110108,
					"content": "って…なんだか雰囲気がピリピリしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110109,
					"content": "そう感じるのも無理もない。なにしろ、大会は佳境に入り、各地の「武術の達人」たちが最終結果を待っているのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110110,
					"content": "大会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "ああ、「ナド・クライレギュレーションファイト」の決勝戦へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110113,
					"content": "思いのままに技を繰り出せる派手な試合とは異なり、この大会は純粋な武器の技に焦点を当てている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110114,
					"content": "そこで俺たち組織委員会は冒険者協会に依頼して、「南十字」船隊の一流剣士を顧問として招待したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110115,
					"content": "なるほど、万葉は武術大会の審査員なのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110116,
					"content": "うむ。あの武闘会の知らせが遥々ナド・クライまで届いていたとは…拙者も少々驚かされた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110117,
					"content": "北斗の姉君は先ごろナシャタウンの催しに参加し、ここでの用事をすべて済ませた。おそらく、またしばらくここを訪れることはないであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110118,
					"content": "対して、時間に余裕があり、「南十字武闘会」の経験もあった拙者が、シエチェフ殿の誘いに応じた…というわけでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110119,
					"content": "楓原さんの鋭い観察眼と、極めて客観性の高い評価のおかげで、混乱した試合状況でも正確に結果を判定できたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110120,
					"content": "しかし、また厄介なことになってな…優勝候補の三人はそれぞれ強みを持っていて、誰も相手の技を破れないまま試合が進まなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110121,
					"content": "このままだと、あと何日かけても決着がつきそうにない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110122,
					"content": "ええっ、決着がつかない試合…？そんなの初めて聞いたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110123,
					"content": "拙者は、やはりあの策を実行すべきだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110124,
					"content": "ああ、やはりここはプロ中のプロに頼まないといけないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110125,
					"content": "#ん、なんで{NICKNAME}を見るんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110126,
					"content": "お主の腕前を少々見せつければ、この膠着状態も打破できるやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110127,
					"content": "#{M#俺}{F#私}が模擬試合をやるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "いや、お主には「南十字武闘会」の王者、武術界の権威として、優勝者を決める最終審査をしてもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110130,
					"content": "三人の優勝候補とそれぞれ戦い、彼らがお主に与えた脅威の度合いに応じて点数を付け——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110131,
					"content": "最も得点の高い者を、優勝とするのでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110132,
					"content": "そして、大会への貢献に対する謝礼として、優勝者に贈られる予定だった賞金の半分は、君に支払おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110133,
					"content": "そんな解決方法でいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110134,
					"content": "試合の膠着状態も解決できるし、オイラたちの顔を立てて分け前までくれるなんて…さすが万葉だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765110135,
					"content": "こんなこと、初めてだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "話が早くて助かる。それじゃ、決まりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "シエチェフ"
				},
				{
					"id": 765110138,
					"content": "#よろしく頼むでござるよ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110139,
					"content": "彼らは三者三様の得意技を持っておる。だが、お主ならばこの手合わせを存分に楽しみ、かつての勝者としての勇姿を見せてくれるであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 765110136,
					"content": "確かにすごく斬新なやり方だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "#{M#俺が}{F#私が}会場を盛り上げるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "武術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "久しぶり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}