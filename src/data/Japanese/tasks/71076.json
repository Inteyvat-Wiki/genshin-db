			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アントン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621201,
					"content": "俺たちはすぐに撤退を始める。もしお前の冒険に支障をきたしてしまったのなら、本当にすまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621202,
						710621210,
						710621213,
						710621221
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621202,
					"content": "千岩軍との協力について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621203
					]
				},
				{
					"id": 710621203,
					"content": "遥か前のことだ。ここが封鎖されたばかりのころ、俺たちは璃月の七星を訪ねた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621204
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621204,
					"content": "最初はうまく交渉してたんだ…「淑女」様も、双方に有益な貿易協定をいくつも立てた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621205
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621205,
					"content": "ファデュイ先遣隊が層岩巨淵に駐在することも、元は付加条件の一つだったんだ…俺たちがここに来たのも、異変の根源の調査と消滅を行うためだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621206
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621206,
					"content": "調査で得たすべての情報は、スネージナヤと璃月によって公平に共有される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621207
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621207,
					"content": "他に目的はないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621208
					]
				},
				{
					"id": 710621208,
					"content": "少なくとも俺たちの知る限りでは、ない。俺たちは出発する時、市民から祝福を受けたほどだ…自身を犠牲に他人を守る英雄の部隊だと、市民たちもそう思っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621209
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621209,
					"content": "はぁ…なのにまさか、こんなことになるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621210,
					"content": "「黒災」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621211
					]
				},
				{
					"id": 710621211,
					"content": "またの名を「漆黒の災い」と言う。まあ呼び方はどうでもいいな…五百年前に起きた大災難のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621212
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621212,
					"content": "とにかく…俺たちスネージナヤ人の永遠の敵さ。この五百年、災いは潜伏しているだけだと、俺たちはそう考えている。だから、警戒を解くことは永遠にない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621213,
					"content": "#{M#君}{F#あなた}たち自身について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621214
					]
				},
				{
					"id": 710621214,
					"content": "俺たちか？何も言うことはない…努力して戦ったが、失敗に終わった。それだけのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621215
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621215,
					"content": "ここに来たばかりの頃、俺たち第九中隊は六十四人いたんだ。それが今はどうだ？隊長を含め…犠牲になった者や失踪した者が、半分を超えている…かもしれないし、超えていないかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621216
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621216,
					"content": "まあ、大体半分だろう…俺たちは散り散りになり、お互いに連絡する術を失った…俺たちは負けたんだから、すぐに撤退するべきだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621217
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621217,
					"content": "#{M#君}{F#あなた}たちの地上の仲間が璃月港を攻撃した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621218
					]
				},
				{
					"id": 710621218,
					"content": "そうか…驚きはしたが、理解はできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621219
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621219,
					"content": "より有意義な冒険にするために、「雄鶏」様は自ずと価値の低い資産を切り捨てる。それが「雄鶏」様の理性さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621220
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621220,
					"content": "あのお方の直属部下として、俺たちに何も文句はない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621221,
					"content": "カタリナについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621222
					]
				},
				{
					"id": 710621222,
					"content": "彼女に会ったのか？彼女は生きていたのか…？俺たちを許してくれているといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621223
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621223,
					"content": "彼女と彼女の弟、ニコライ伍長は、「壁炉の家」で育った…女皇陛下の子供たちなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621224
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621224,
					"content": "彼女はいつも、必ず弟を探し出すんだと言っていた。でも俺は…下の環境が彼女にそんな馬鹿な考えを与えたんだと思った…彼女の弟は、生きてるはずがないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621225,
						710621230
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621225,
					"content": "だから彼女を見捨てたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621226
					]
				},
				{
					"id": 710621226,
					"content": "見捨てた…？いや、彼女は…自分の意志で残ったんだ。もしも懸念を心に抱える者がいれば…チーム全体の足を引っ張るだけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621227
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621227,
					"content": "俺たちは…一人が大勢のために自分を犠牲に、そして大勢が重要なお方のために自分を犠牲にする…それがファデュイの覚悟なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621228
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621228,
					"content": "カティアはきっとその覚悟ができていた。もちろん、コーリャもだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621229
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621229,
					"content": "あいつらが俺に同じことをしても、俺は理解できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621230,
					"content": "彼女の状況はそんなに悪くない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621231
					]
				},
				{
					"id": 710621231,
					"content": "お前は外の者だからな。ファデュイは平民に対し醜態を演じるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621232
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621232,
					"content": "だが彼女にとって、俺たちは家族だ。彼女も、俺たちの家族だった…かつてはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621233
					],
					"speakerTitle": "アントン"
				},
				{
					"id": 710621233,
					"content": "コーリャを探すと決めたのは、彼女自身だ…だから、俺たちを許してくれていることを願ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アントン"
				}
			]
		},
