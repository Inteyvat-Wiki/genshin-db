				"objectNames": [
					"ラドミール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710622801,
					"content": "食料をありがとう。何か話があるならアントン隊長に言ってくれ。私から話すことは何もない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622802
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710622802,
					"content": "その…誤解しないでほしい。部隊機密なんだ、理解してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622803
					],
					"speakerTitle": "ラドミール"
				},
				{
					"id": 710622803,
					"content": "コホンッ、とにかく…次は友として会えることを期待している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラドミール"
				}
			]
		},
		{
			"id": 7106234,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
