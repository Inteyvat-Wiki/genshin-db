			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}さん、パイモンさん、お帰りなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 745310102,
					"content": "たくさん写真を撮ってきたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "嬉しいです！今回は本当にありがとうございました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 745310105,
					"content": "みなさんが撮影を手伝ってくださっている間、私も何もしないわけにはいかないって思って…このままじゃ、ずっと成長できませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 745310106,
					"content": "だから勇気を出して、通りすがりの方にお願いしてみたんです。私も、頑張ってたくさん写真を撮ったんですよ！これでテストデータは十分なはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "ニネット"
				},
				{
					"id": 745310107,
					"content": "#ふふん、さすがは私の弟子ね！まあ、{NICKNAME}さんが手を貸してくれたおかげでもあるけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310108,
					"content": "レピーヌ・ポーリーン！いつ戻ってきたんだ？最近忙しいんじゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745310109,
					"content": "それはもちろん、大儲け間違いなしのビーーーッグ・ビ・ジ・ネ・スの話がやっと片付いたので！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310110,
					"content": "それでこのところ本当に手が離せなかったんです。ニネットのこと、お世話になりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310111,
					"content": "この子、技術もセンスも申し分ないんですが、ちょっと臆病なところがあるんです。でも、おかげで大きな一歩を踏み出せたみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310112,
					"content": "ふーん。まあいいけど、どんな儲け話なんだ？なーんか胡散臭いし、また変なニュースでも聞いて、全財産つぎ込もうとしてるんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745310113,
					"content": "まさか！このレピーヌ・ポーリーンは失敗から学ぶエンジニアですもの！今度こそ正真正銘、絶対に損しない超大型プロジェクトですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310114,
					"content": "（ちょっと不安になってきた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "ふふん、今言っちゃったら面白くないでしょう？完成したら、真っ先にご招待しますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レピーヌ・ポーリーン"
				},
				{
					"id": 745310103,
					"content": "「瞬影」レンズ、かなり良かったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
}