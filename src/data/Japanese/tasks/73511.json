			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュリヤ",
					"フォディル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "もうあのバカ…そのまま砂漠に飛び出していくだなんて！フォディルさん、お願い、あいつを助けてあげて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110102,
					"content": "悪いが、村の守備人員に限りがあってな。「やつら」にも警戒しないといけないから、今は助けてやれるほどの余裕がないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110103,
					"content": "でも、あのバカがあんなに必死だったのも、「あいつら」に対処するためよ！同じ立場ってことに免じて、どうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110104,
					"content": "はぁ、探しに行きたくないわけじゃないさ。だが、守衛たちも今は「やつら」の動向を監視するため、砂漠のあちこちに散らばっているんだ。人を集めるといったって、時間が必要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110105,
					"content": "そんな…今からキャラバン宿駅に戻って助けを求めても、きっと間に合わない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110106,
					"content": "誰か危ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "えっ？あなたたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110109,
					"content": "通りすがりの冒険者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "——と、その最高の仲間のパイモンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110111,
					"content": "冒険者さん？本当に…！？よかった、神様…！ヴィナヤックのやつ、まだ救いの手があったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110112,
					"content": "冒険者さん！どうかヴィナヤックを助けてください。報酬については心配いらないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110113,
					"content": "まずは状況を教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "ああ。砂漠では「やつら」が暴れてるから、いつもよりだいぶ危険になってる。状況を把握してから決めた方がいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110115,
					"content": "えっと…その通りね。ごめん、ちょっと焦ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110116,
					"content": "さっきから聞きたかったんだけど、「やつら」って一体なんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110117,
					"content": "——ウェネトの群れのことさ。何故か知らないが、やつらは最近、異常なほどに凶暴化しているんだ。しかも砂嵐に隠れて通りすがりの獲物を襲っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110118,
					"content": "たかが虫けら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "…それはそうだが、今回はさすがに数が多すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110121,
					"content": "砂嵐を盾にしやがるもんで、さほどダメージも与えられない。危険を察知すると、やつらはすぐに逃げてしまうからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "フォディル"
				},
				{
					"id": 735110122,
					"content": "うぅ、それは確かに厄介だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110123,
					"content": "アアル村だけでなく、通りすがりの旅商人も影響を受けてるわ。だから、暴れまわっているウェネトたちに対処するため、教令院から私とヴィナヤックが送られたってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110124,
					"content": "でも、キャラバンに頼んで届けてもらう予定だった「パーツ」が途中でウェネトに襲われた挙句、砂嵐に吹き飛ばされて行っちゃったの。今はもう…魔物たちのおもちゃにでもなってるでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110125,
					"content": "キャラバン宿駅に戻って助けを求めるつもりだったんだけど、もう何年も経ってるのに、あいつが相変わらず機械みたいに融通の利かないやつだなんて思いもしなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110126,
					"content": "その大切なお宝のパーツを取り戻すとかなんとか言って、一人で砂漠に飛び込んで行ったのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110127,
					"content": "ああーもう——いっそ魔物に捕まっちゃったらいいのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110128,
					"content": "#うぅ…どうしよう、{NICKNAME}？このままじゃその学者が危ないってだけじゃなくて、ウェネトが起こすトラブルも厄介だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110129,
					"content": "砂漠の危機を放っておけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "冒険者さん…ありがとう！本当にありがとう！ごめんね、さっきは怒りのあまり、ちょっと失言だったわ…今からマップで襲撃事件の場所をマークするから、その…どうか、あいつを一刻も早く見つけ出してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110132,
					"content": "あいつの頭が、そのまま魔物の群れに突っ込むほどにはサビてないことを祈るわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュリヤ"
				},
				{
					"id": 735110130,
					"content": "救援は任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "もっとでかいのも相手にしたことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "助けが必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
