			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィナヤック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "この角度から潜入して、地形をうまく利用して隠れる…太陽の角度がこれより低ければ…僕がこれより速ければ…はぁ、やはり無理だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110302,
					"content": "何の計算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "「正面から魔物と接触せずにパーツを回収できるルート」さ…ウェネトのせいで、僕のお宝パーツが全部辺りの魔物の群れに吹き飛ばされてしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110304,
					"content": "——ってうわっ！誰だ君たち？いつからここにいた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110305,
					"content": "ずっと隣でぶつぶつ言ってるのを聞いてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "安心しろ！オイラたちは悪いやつなんかじゃないぞ。オイラたち、おまえの仲間に頼まれてきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110307,
					"content": "仲間だと？まさかシュリヤのやつか？いやいや、あいつは僕が魔物に捕まっても知らないって言ってたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110308,
					"content": "あっ——わかったぞ。あいつが君たちにパーツの回収を頼んだってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110309,
					"content": "僕が捕まったってどうでもいいけど、パーツが回収されなかったらまずい…ふむ、あいつが言いそうなことだ、理にかなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110310,
					"content": "…そういう風に理解したいなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "とにかく、君たちには感謝だ。どれだけ計算しても解決できないもんだから、いっそのことこのまま突っ走って、行き当たりばったりで考えようとしていたところだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110312,
					"content": "…一歩でも間違えれば、魔物にとっ捕まっていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110313,
					"content": "はぁ、もし僕がいなくなったら…あいつは不器用だし…誰が機械の面倒をみるって言うんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735110314,
					"content": "シュリヤがあれほど心配してた理由がなんとなく分かってきたぜ…こいつ、本当に機械パーツのことしか頭にないんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}、さっさとパーツを集めようぜ！こいつがまた危ないことを考え始める前にな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
