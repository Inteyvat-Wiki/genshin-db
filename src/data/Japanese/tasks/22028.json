			"trigger": {
				"objectNames": [
					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！聞いて聞いて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280102,
					"content": "この前祠にお供え物を捧げたら、願い事が…少し叶ったんだ！願い事の一部だけなんだけど…きっと神様が応えてくれたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280103,
					"content": "どんな願い事をしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "えっと…この前、ずっと読んでいる漫画の作者が、もっと早く更新してくれるようにって、神様にお願いしたんだ。二日に一回くらい更新してくれたら最高だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280105,
					"content": "そうしたら、その作者が一度に普段の二倍の内容を更新したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280106,
					"content": "でも…次の三回は休載するんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280107,
					"content": "それ、願いが叶ったって言えるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "うぅ…とりあえず、きっと神様は僕の願いを聞いてくれたんだ。全部叶ってないのは、まだ供え物が足りないからだと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280110,
					"content": "だから今日は、他の祠にも供え物を捧げてみようよ！そうしたら、きっと神様は僕の願いを完璧に叶えてくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280111,
					"content": "父ちゃんと母ちゃんに聞いたよ。この辺りにはもう二つの祠があるんだ。一つは木漏茶屋の近く、もう一つは町から出た道にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280112,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、先にどっちの祠に行った方がいいと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280108,
					"content": "逆に内容が一回分減ってない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
