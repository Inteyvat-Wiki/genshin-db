						220280802
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280802,
					"content": "神様、今回は応えてくれますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280803,
					"content": "明日、特別な事が起きていないか確認しに来る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280804,
					"content": "あと、今まで助けてくれてありがとう、これはお礼だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "翔太"
				},
				{
