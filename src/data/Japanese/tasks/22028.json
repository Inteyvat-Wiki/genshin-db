			"dialogs": [
				{
					"id": 220280501,
					"content": "ここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280502,
					"content": "聞いた話だけど、昔、とある同心のおじさんが、花見坂の人々の平和と安全を願って、この祠にたくさんの折り鶴を奉納したらしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280503,
					"content": "その後、辺りにある一軒の家で火事が起こったんだ。でもその家はもともと手抜き工事だったから、一気に崩れちゃって、火が近所に広がらなかったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280504,
					"content": "大事にならずに済んだのは、みんな、神様が守ってくれたんだって思ったらしいよ…えへへ、だからわざわざ折り鶴も持ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280505,
					"content": "今回は何を捧げればいいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280506,
					"content": "同心のおじさんみたいに折り鶴を捧げたら、神様も答えてくれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280507,
					"content": "でも僕思うんだけど、この祠は茶屋に近いから、抹茶味の金平糖を捧げた方が神様に伝わりやすいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280508,
					"content": "僕も、抹茶味の金平糖が好きなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220280509,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
