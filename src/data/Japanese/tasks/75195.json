			"dialogs": [
				{
					"id": 751950201,
					"content": "なんてこった…こりゃまた優しい人が現れたもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "デュータ"
				},
				{
					"id": 751950202,
					"content": "ライノ竜を呼んで荒地の岩をどかしてもらい、ついでに出てきた魔物も処理してもらおうかと考えてたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "デュータ"
				},
				{
					"id": 751950203,
					"content": "まだ何もしとらんのに、全部片付いちまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "デュータ"
				},
				{
					"id": 751950204,
					"content": "日課として家の前の果樹に毎朝肥料をやってきたが…日々の善行を重ねてきたからこそ、こうして神が褒美をくれたのだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "デュータ"
				},
				{
					"id": 751950205,
					"content": "優しいお方よ、まさに神の使いだ！心から礼を言おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "デュータ"
				},
				{
					"id": 751950206,
					"content": "大したもんじゃないが、少しのモラと役に立つかわからんガラクタをやろう。遠慮せずに持っていくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デュータ"
				}
			]
		}
