			"dialogs": [
				{
					"id": 706690201,
					"content": "にゃ！「恐れ入ったよ。プレイヤーランクの試練突破、おめでとう！これで汝も伝説プレイヤーと言えよう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690202
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706690202,
					"content": "にゃ…「伝説プレイヤーとは、すごい称号だな…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690203
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706690203,
					"content": "「汝にはこれからも自分のカードの腕前を磨いて精進してほしい！伝説プレイヤーという称号に負けないすごいプレイヤーになってくれ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690204
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706690204,
					"content": "「今となっては余計な科白かもしれないが…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690205
					],
					"speakerTitle": "「リトルプリンス」"
				},
				{
					"id": 706690205,
					"content": "「『七聖召喚』を楽しんでくれたまえ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
