					"リヴァ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750860301,
					"content": "来たね！タルカがあなたのことをすごい人だってずっと言ってるの。あまりあなたに引き離されないよう、私に頑張れって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750860302,
					"content": "あの言い方からして、私が勝てるとはまったく思ってないようね。ここは姉として、すごいところを見せてやらないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750860303,
					"content": "そういうわけだから、試合では絶対手加減しないよ。お互い全力を出して、勝負しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750860304,
					"content": "#{M#俺}{F#私}を本気にさせたこと、あとで後悔するよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "そうこなくっちゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750860308,
					"content": "さ、おしゃべりはここまでよ。準備ができたら、始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750860306,
					"content": "#{M#俺}{F#私}の狙いは参加賞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "それって私を油断させる作戦？ふふ、騙されないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "リヴァ"
				}
			]
		},
