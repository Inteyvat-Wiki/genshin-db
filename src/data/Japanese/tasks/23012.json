			"dialogs": [
				{
					"id": 230120101,
					"content": "ニャー…ゴホン、ケホ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120102,
					"content": "#{M#君}{F#あなた}、何してるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "うちの子猫たちを探しているのです。いつもは私がこうやって呼ぶと、すぐに返事するんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120104,
					"content": "まさか、今日は発音が間違ってるのかしら？こんなに呼んでるのに返事がないなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120105,
					"content": "直接名前を呼んだら…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "そうだぞ！普通子猫を探すんなら、直接名前を呼ぶもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230120107,
					"content": "でも、私たち人間の言葉で名前を呼んだとしても、子猫たちには分からないのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120108,
					"content": "えっ！？そ、そう言われると確かに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230120113,
					"content": "でも、これ以上呼んでもしょうがないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120114,
					"content": "旅人さん、ひとつ真面目な質問があるのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120115,
					"content": "どうぞ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "…「猫語」を習いたくはありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120118,
					"content": "え？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230120120,
					"content": "つまり、オイラたちに猫語を教えてくれるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230120116,
					"content": "報酬は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "「今日は発音が間違ってる」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "さっきの「ニャー」という鳴き声、実はあれが子猫たちの名前なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120111,
					"content": "だって、人の言葉で子猫たちの名前を呼んでも、きっと分からないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120112,
					"content": "えっ！？そ、そう言われると確かに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "パイモン"
				}
			]
		},
