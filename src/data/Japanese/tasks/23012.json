			"dialogs": [
				{
					"id": 230120301,
					"content": "もう子猫を連れて来てくれたのですね。本当にありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120302,
					"content": "その様子だと、あなたたちの「猫語」は悪くないみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120303,
					"content": "これは報酬よ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120304,
					"content": "こんなに早く「猫語」をマスターできる人は珍しいんです。次もまたお願いするかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120305,
					"content": "ニャッ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "人の言葉で話せよ！サリーは猫じゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230120307,
					"content": "あなたの表情から「大丈夫」とおっしゃりたいのは分かります。でも…今の発音には改善の余地がありますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230120308,
					"content": "でも大丈夫です。これからも「猫語」を教えてあげます、一緒に勉強しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サリー"
				}
			]
		},
