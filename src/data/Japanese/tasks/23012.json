			"dialogs": [
				{
					"id": 230121101,
					"content": "前にも猫と話したことがあったな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "「寝子」のことか？でも、寝子は人の言葉が話せる猫だから、「猫語」でってわけじゃないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230121103,
					"content": "そうです。ただし、その代わりに子猫を一匹連れ帰ってほしいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230121104,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "じゃあ、約束してくれるんですね？本当にありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "サリー"
				},
				{
					"id": 230121109,
					"content": "ゴホン、ゴホン…それじゃあよく聞いてください。これが私が長い時間をかけてまとめた「猫の定型語」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サリー"
				},
				{
					"id": 230121105,
					"content": "街によって猫の探し方って違うんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "あはは…そうだな。そう考えるとオイラたち、いろんな街で猫を探してきたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230121107,
					"content": "猫を飼う人の悩みって大体おんなじだよな。みんな、子猫が好きなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "パイモン"
				}
			]
		},
