					"嵐姉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "また何もなし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "あら、またあなたたちなのね。協会の任務に飽きてきたところかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090104,
					"content": "もし興味があるなら、私の依頼を受けてみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090105,
					"content": "「帰離原」のとあるところに弓を持ったヒルチャールがたくさんいて、通行人の邪魔をしてるらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090106,
					"content": "ただのヒルチャールだけど、数が多いし、高い所を占領してるから普通の冒険者じゃどうしようもないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090107,
					"content": "あなたの仕事はそいつらを倒すこと。倒したら、十分な報酬を支払うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090108,
					"content": "そうだ、もし「剣」に関する何かを見つけたら、持ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "若さゆえの怖いもの知らずかしら、こんなにあっさりと受けるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090112,
					"content": "まあ、そこが冒険者らしいといえばらしいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090115,
					"content": "ええ、雑談はここまでにするわ。準備ができたら、行ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090110,
					"content": "ヒルチャールと剣の関係は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "大丈夫、心にとどめておいてくれたらいいの。あったら持って帰って、なかったらそれでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090114,
					"content": "今回の目標はヒルチャールを倒すこと。倒してくれたらちゃんと報酬を支払うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
