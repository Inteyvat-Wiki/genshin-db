			"dialogs": [
				{
					"id": 221090301,
					"content": "どう？倒した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090302,
					"content": "全部倒した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "よくやったわ。あのヒルチャールたちはあなたにとってそんなに厄介じゃなかったでしょ？ふふっ、聞いてみただけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090304,
					"content": "「剣」に関するものはないのね？まあ、それも想定内だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090305,
					"content": "さあ、報酬を受け取りなさい。ご苦労様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090306,
					"content": "どうして「剣」のことが気になる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "…あなたには特別に教えてあげるわ。あの剣は「蔵鋒」、兄の剣よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090308,
					"content": "でも兄が亡くなった時、あの剣は兄のそばにはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090309,
					"content": "兄がいつも持ち歩いている武器を捨てるなんて、一体何があったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090310,
					"content": "今でも分からないわ。剣も見つからないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221090311,
					"content": "雑談はここまでにするわ。さあ、報酬を受け取りなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		}
