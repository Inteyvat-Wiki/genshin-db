			"dialogs": [
				{
					"id": 721570101,
					"content": "これは…「鎮め石」はどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721570102,
					"content": "やっぱり、そう簡単にはいかないみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570103,
					"content": "辺りを探してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "仕方ないわね。何か手がかりはないか、辺りを探しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570105,
					"content": "こんなに広い場所、いつまで探さないといけないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721570106,
					"content": "ふふ、それは私たちの運次第ね。とにかく始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570107,
					"content": "どうやら…「鎮め石を探す」ことも、「鎮め石」を封印するために解決しなきゃいけない問題の一つね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570108,
					"content": "この問題を解決できる手がかりが、この近くにあるといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570109,
					"content": "こうしちゃいられない。大祐、早く始めるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "悦子"
				},
				{
					"id": 721570110,
					"content": "わ、わかったよ、悦子…そうするしかないみたいだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大祐"
				}
			]
