			"dialogs": [
				{
					"id": 412109901,
					"content": "アルベド先生の秘密は絶対にすごいはず。じゃないと、隠す必要がないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スクロース"
				}
			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"スクロース"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "あれ、スクロースじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100202,
					"content": "おまえも雪山に探索しに来てたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100203,
					"content": "うわ！びっくりした…研究報告について考えている時に突然話しかけないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100204,
					"content": "ぼーっと突っ立ってたように見えたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100205,
					"content": "そ、そんなことない。新しく開発した種が4倍も大きいスイートフラワーの名前を考えてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100206,
					"content": "それは美味しそうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "あれ？興味があるの？今度見せてあげるよ、絶対ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100209,
					"content": "雪山じゃなかったらいつもは持ち歩いていたのに…残念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100210,
					"content": "そういえば、おまえって城内で研究してるんじゃないのか？こんなところでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100211,
					"content": "ティマイオスと一緒にアルベド先生の実験データの整理を手伝ってたの。ティマイオスはついさっきここから離れていったんだけど、会わなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100212,
					"content": "会ってないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100213,
					"content": "アルベド先生と比べたら、自分はデータを読み解く力がないって落ち込んじゃってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100214,
					"content": "先生が見ればすぐに分かるものも、私たちは考えないと分からないから。恐らく、知識と経験の差だと思うんだけれど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100215,
					"content": "それで辺りを散歩しに行っちゃったの。で、私は一人ここに残って作業をしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100216,
					"content": "（ティマイオス、サボってるだけじゃ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "本当は作業が終わったら辺りを見て回ろうと思ってたんだけど、報告書から興味深いデータを見つけたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100218,
					"content": "はあ…でもまだ探索の旅には出られそうにないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100219,
					"content": "探索？なにを探すんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100220,
					"content": "あれ…あなたたち、もしかして手が空いてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100221,
					"content": "空いてるぞ！ちょうどここら辺をブラブラしてたとこだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100222,
					"content": "なら手伝ってくれる？実は…アルベド先生が、私とティマイオスに何か隠しているみたいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100223,
					"content": "アルベドはおまえらの先生みたいなもんだろ？生徒相手に隠すことなんてあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100224,
					"content": "でも、何かをずっと隠している気がする…錬金術に関する何かすごいものを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100225,
					"content": "なにも分かってないのにヤケに自信たっぷりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100226,
					"content": "だって、私もティマイオスも錬金術の熱狂的な研究者だから。もし別の何かなら、私たちに隠す理由がないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100227,
					"content": "あー…確かにその通りかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100228,
					"content": "アルベド先生の隠し事を調べてくれる？とても気になるの！お願い、お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100229,
					"content": "んー…どうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100230,
					"content": "彼女が知りたがってるなら調べよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "やった！よかった、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "スクロース"
				},
				{
					"id": 412100233,
					"content": "よし！それならさっそく、行くとするか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100231,
					"content": "アルベドの隠し事が気になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "それ、食べられるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
