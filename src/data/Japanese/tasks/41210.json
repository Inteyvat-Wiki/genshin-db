			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "アルベドー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100302,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "おや？キミたち何しに戻ってきたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100304,
					"content": "道に迷ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100305,
					"content": "違うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100306,
					"content": "秘密を調査してほしいと頼まれた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "ん？秘密？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100309,
					"content": "お、おいおい、なに言ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100310,
					"content": "こういう時は普通こっそり調査するもんだろ？なんで全部言っちゃうんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100311,
					"content": "アルベド相手に隠し通せないし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "うぅ…そうかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100313,
					"content": "丁度いい。ボクもキミに頼み事があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100314,
					"content": "これを受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100315,
					"content": "ん？なんだこれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100316,
					"content": "見ての通り、片手剣さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100317,
					"content": "アルベドは鍛造もできるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "剣はボクが打ったものではない。だが、先ほどそれに錬金術を施した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100320,
					"content": "試してみたくないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100321,
					"content": "#え？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "ボクの研究によると、それは特殊な剣で、キミにしか扱えないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100323,
					"content": "そしてボクは今、その剣のデータが必要なんだ。キミにそれを使ってたくさん戦ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100324,
					"content": "ちょっと待ってくれ、こいつにしか使えない剣って、どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100325,
					"content": "何か副作用があるのでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "なかなか鋭いね。その剣には、ある種の呪いがかかっているんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100327,
					"content": "普通の人には扱えないが、キミは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100328,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100329,
					"content": "つまり、この剣の呪いは唯一キミにだけ害を与えない。だから、キミ以外にボクを手伝える人はいないってことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100330,
					"content": "無駄話はこれくらいにして、この近くで怪物を探してくれるかい。使えば分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100318,
					"content": "錬金術師と鍛冶屋を兼業しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "人に話せない秘密があると聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
