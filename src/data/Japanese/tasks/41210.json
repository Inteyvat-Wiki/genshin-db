			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凶悪な男"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "見つけたぞ！あのクソガキだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "凶悪な男"
				},
				{
					"id": 412100402,
					"content": "さっさとあれを寄こせ、盗人め！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "凶悪な男"
				},
				{
					"id": 412100403,
					"content": "宝盗団？こんな寒いところにも宝盗団っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100404,
					"content": "うるせぇ！寄こせ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "凶悪な男"
				},
				{
					"id": 412100405,
					"content": "気を付けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルベド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "オイラたちを盗人呼ばわりするなんて、こいつの方がよっぽど盗人なのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100502,
					"content": "来るのが早いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100503,
					"content": "アルベドは泥棒なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "まさか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100506,
					"content": "あいつらが言ってたのって、この剣のことみたいだな。一体どういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100507,
					"content": "なんて目で見るんだ。このボクが剣を盗むはずがないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100508,
					"content": "少し前、騎士団がモンド城外で宝盗団を捕まえたんだよ。その際、彼らが違法に運搬していた物を全て押収してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100509,
					"content": "この剣はその中にあったんだよ。誰も取りに来ず、どこから来たのかも不明。ずっと倉庫に放置されていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100510,
					"content": "倉庫に荷物を取りに行った時、偶然この剣にボクが気づいてね。まあ、こんな古い剣、錬金術の材料にする以外、使い道はないんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100511,
					"content": "おい、押収された物を自分のものだって言ってたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100512,
					"content": "それで…その剣を持ち出したと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100513,
					"content": "ああ、この剣を使って実験しようと思ってね。ただ、調査していくうちに、これの本当の来歴を知ってしまったのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100514,
					"content": "この古臭い武器はとある鍛冶職人が作った、伝説の魔剣なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100515,
					"content": "魔剣！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100516,
					"content": "鍛冶職人はこれを完成させたすぐ後に失踪し、剣も行方知らずになっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100517,
					"content": "押収物の中に混ざっていたことから、恐らく宝盗団に盗まれ、ずっとそのままだったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100518,
					"content": "え！剣を作った人が失踪したのか！？うぅ…こわいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100519,
					"content": "それで「呪われた魔剣」なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100520,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100521,
					"content": "人が魔剣をつくり出せるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "キミは<color=#00E1FFFF>「ドゥリン」</color>とこの雪山の話を知っているかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>「ドゥリン」</color>、つまり数百年前に<color=#00E1FFFF>「風神バルバトス」</color>と<color=#00E1FFFF>「トワリン」</color>が共に倒した、モンドの脅威だった黒龍のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100524,
					"content": "激戦の末、打ち負かされたドゥリンは空から落ち、真っ白い雪の中に打ちつけられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100525,
					"content": "雪山に積もる雪が一年中溶けないのは、実に奇妙なことだ。ドゥリンがここに落ちたのは、偶然か、はたまた必然か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100526,
					"content": "必然だって言いたいのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100527,
					"content": "雪山を墓場に選んだのは、氷の力でドゥリンの毒を封印するためだったのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100528,
					"content": "バルバドスのような神なら、そんな方法を思いつくだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100529,
					"content": "おぉ…吟遊野郎ってそんなにすごいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100530,
					"content": "これはただのボクの推測だ。だが、この雪山とドゥリンが深く関係していることは確信している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100531,
					"content": "そして、キミの手の中にある剣は、ドゥリンの亡骸が材料として使われている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100532,
					"content": "龍の亡骸！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100533,
					"content": "ああ。死んだ龍の目玉、爪、鱗……それらを粉末にしたものが剣身に塗られている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100534,
					"content": "そうすれば、ドゥリンの穢れと毒が剣の中に溶け込み、その力の源になるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100535,
					"content": "これは非常に高等な技術だ。鍛冶職人は完成後、きっと喜んで自分の手でその斬れ味を試しただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100536,
					"content": "彼がこの剣を使えば、穢れた力は柄を通ってその体に入り込む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100537,
					"content": "それは常人では抗えない力だ。呪いにより精神錯乱に陥った鍛冶職人は、辺りを彷徨い、もしかしたらその身に何かが起こったのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100538,
					"content": "うわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100539,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "トワリンの涙を浄化したキミは、類稀なる力を持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100541,
					"content": "そんな力を持ったキミなら、穢れと毒に侵食されることなく、その危険性も排除できるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100542,
					"content": "そのため、この剣はキミにしか扱えないってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100543,
					"content": "そう言うけど、やっぱこの剣…あぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100544,
					"content": "ひ、光ってるぞ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 412100545,
					"content": "これはまさに実験開始の合図だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100546,
					"content": "この剣はまだ弱い。だが、これには力を吸収し、どんどん強くなる能力が秘められている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100547,
					"content": "ある意味、これも「生き物」と言えるだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 412100548,
					"content": "旅人よ、これを持って冒険してくれるかい。これを成長させてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "アルベド"
				},
				{
