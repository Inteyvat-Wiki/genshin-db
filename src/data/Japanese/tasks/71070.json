					"nextDialogs": [
						710702503
					]
				},
				{
					"id": 710702503,
					"content": "おい、暇人扱いするなよ。お前たちが俺を必要とした時には、きっと忙しくなるだろうからな。",
					"roleType": "TALK_ROLE_NPC",
