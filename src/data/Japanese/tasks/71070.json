	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "ああ、来たんだね。道を開いてくれてありがとう。志璇のことも、色々と助けてもらったね。みんな感謝してるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700102,
					"content": "拠点について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "どうだい、悪くないだろ？実は本業なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700104,
					"content": "拠点や晶石灯作り、鉱具の修理まで…十代の頃から父に教えられてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700105,
					"content": "段々と、父は老いてきて…父の目が悪くなってきてからは、鉱区の安全設備のメンテナンスはあたしが担当するようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700106,
					"content": "そこからは…見ての通りさ。あたしはもう若くないし、それからは平凡な人生を過ごしてきた…旦那がいたが、とうに死んだ。娘はスメールの学校に通ってるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700107,
					"content": "鉱区の男の寿命は長くなくてね。残された子供はみんなあたしが面倒を見てる…だから常にお菓子を持ち歩いてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700108,
					"content": "そうだね…子供たちはいつも、目をキラキラさせながら期待してるんだ。あたしらが持つ糖瓜や、キレイな小石にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700109,
					"content": "おおっ…じゃあ瑾武姉さんは今も飴を持っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710700110,
					"content": "飴かい？街で売られている奇抜な飴はないよ。持ってるのは、ただの角砂糖さ。厭うんじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700111,
					"content": "そういう飴だったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710700112,
					"content": "周りでは多くの人が行き交うけれど、ずっとあたしと一緒にいてくれるのは彼らへの思いだけさ。ははっ、あんたみたいに鉱区に入ってくる冒険者たちもいるしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700113,
					"content": "志璇について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "志璇は明蘊町で生まれた、鉱区の新世代の人間さ。実は層岩巨淵の経験豊富な鉱夫はみんな明蘊町出身なんだよ…志璇は運が悪かったのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700115,
					"content": "あっ…誤解しないで欲しいんだけど、生活が厳しいって言いたいわけじゃないよ。数年前、明蘊町は鉱石不足が原因で、生産を止めたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700116,
					"content": "その後、志璇は層岩巨淵にやってきたんだけど、そこでもトラブルが起きて生産が止まってしまった…あの子は鉱夫に向いていなかったのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700117,
					"content": "そんな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "その後はそれぞれの道を選んで、あたしは鉱坑に残ることにした——去った後も、設備はメンテナンスが必要だろ。そしてあの子は冒険者になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700119,
					"content": "あの子と来たら、いつまで経っても成長しやしない。やっぱり鉱区での経験が足りないんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700120,
					"content": "もし鉱夫の生活に慣れていて、危険に遭遇した人を自らの手で助けたことがあれば…命の大切さをもっと理解できていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700121,
					"content": "変なお願いだけど…あの子のことを見守ってやってくれないかい？あの子が自分の命を危険に晒さないようにさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700122,
					"content": "また後で。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "ああ、気をつけるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
