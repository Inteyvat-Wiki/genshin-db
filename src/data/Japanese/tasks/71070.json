			"dialogs": [
				{
					"id": 710702901,
					"content": "あっ、来てくれたんだな！ようこそ、層岩巨淵探検隊の爆破班兼ドリンク提供所へ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702902,
					"content": "メンバー全員——すなわち俺、クレイトポンがお前に敬意を払う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702903,
					"content": "ははっ、この一杯はご馳走しよう！お前たちには感謝しないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702904,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "正式に探検隊の一員になった以上、もちろんチームと一緒にここに残るさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702907,
					"content": "ハァ…ヘディーヴと瑾武姉さんが部下をもっと手配してくれればいいんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702908,
					"content": "その時が来たら、俺が爆破班のリーダー兼唯一のメンバーじゃなくなるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710702905,
					"content": "ここに残るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
