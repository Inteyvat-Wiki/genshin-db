						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クレイトポン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "よう！旅はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710701702,
					"content": "#まあまあ。{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "俺に機会を与えてくれてありがとうよ。砲弾の信管作りが成功してから、みんな俺を受け入れてくれるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710701704,
					"content": "地上に出て何をするかは…ハハ、まだ決めてないんだ！まあ、多分宝盗団はやらないと思うけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710701705,
					"content": "多分…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "もちろん、絶対にやらない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710701708,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "ああ、元気でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710701706,
					"content": "本当に…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヘディーヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "コイツ…ん？ああ、君か。すまないが、今は取り込み中でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701802,
					"content": "じゃあ、これでチャラだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "からかうのはやめてくれ。俺たちは今かなりヤバい状況なんだ、分かってるのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701805,
					"content": "あの光っている晶石破片を見ただろ？俺の考えでは、これよりも大きいのが奥にあるはずだ…君もそう予想しているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701806,
					"content": "理論的には、上の破片が「帰還」した後は、エネルギー測定値がだいぶ安定したはずで…実際、そうだったんだ。でも…波形は違う…完全に違っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701807,
					"content": "何言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "君は、学校に通わなかったのか？まあいい…要は俺たちは間もなく、二つの大きな力の衝突に直面するんだ。石臼の上にある豆のようにな。理解できたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701810,
					"content": "もっと大きな時間スケールから見た俺たちは、上下から訪れる2つの力に押され、一瞬で豆乳になってしまうかもしれないんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701811,
					"content": "信じられないのなら今に見ていなさい。あの志璇とかいう冒険者…すぐ近くであれに接触してしまった人間を、俺は見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701812,
					"content": "今は血を吐くだけかもしれないが、明日には肺を吐き出してしまう恐れがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701813,
					"content": "なにか手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "君が？うん…そうだな…時間さえくれれば、きっと何か方法は見つかるはずさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701815,
					"content": "でも今一番重要なのは、このまま探索を続け、下で何が起こっているのか確認することだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701816,
					"content": "大丈夫、こんな大事を放置しておく訳にはいかないさ…責任をもって探検隊員の身の安全を保障する。金を無駄にするわけにもいかないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701817,
					"content": "#{M#俺}{F#私}の安全も保障してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "正直なところ、君の能力はオレの予想を越えている…君ならきっと自分でなんとかできるだろうと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701819,
					"content": "まあいい、つまらん言い訳はよそう…万が一君になにか起こったら、責任を取って補償する。これでいいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710701808,
					"content": "分かりやすく説明して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
