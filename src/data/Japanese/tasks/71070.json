			"trigger": {
				"objectNames": [
					"志璇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702701,
					"content": "本当にすみません…私のわがままのせいで、先輩にご迷惑をおかけしてしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702702
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702702,
					"content": "これからも引き続き既存の地図を改良していこうと思います。そして瑾武姉さんを手伝ってビーコンを設置し、黒い物質の状況を観測していきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702703,
					"content": "あれは…彼らの話では、五百年前の漆漆黒の災いと関係している可能性が高いらしいです。ただ、それが過去の余震にすぎないのか、それとも復活する兆しなのかは不明ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702704,
					"content": "とにかく、先輩のおかげで理解できました。人の限界がどこにあるのか、そして…その限界の中で、生き甲斐をどう見出せばいいのかを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702705,
					"content": "うわぁ…志璇の話し方が、なんだか哲学者みたいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710702706,
					"content": "#{M#俺}{F#私}はそう深く考えたことがないな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "ただただ、先輩には本当にお世話になりました。それに比べて私は…地図を描くときですら、いつも先輩にご迷惑を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702708,
					"content": "危険に遭遇する度、先輩の足を引っ張ってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702709,
					"content": "#{M#君}{F#あなた}の安全を優先しただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "はい…そして私はあきらめません。十分に休んでから、また出発しますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710702710,
					"content": "大丈夫、地図を完成できるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
			]
		},
