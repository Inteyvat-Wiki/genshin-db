					"content": "そろそろ行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "分かった、引き留めないよ。でも、探検隊はいつでも君を歓迎するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
