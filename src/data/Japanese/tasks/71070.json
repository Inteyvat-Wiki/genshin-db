			"dialogs": [
				{
					"id": 710703001,
					"content": "#おや？てっきり、もうここを離れたんだと思ったよ。こんにちは、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703002
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710703002,
					"content": "エネルギー測定値はだいぶ安定している…ありがとう。帰ったら、君のことも論文に書くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703003
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
					"id": 710703003,
					"content": "ただ、名目上は探検隊の雇い主だからね。ここに長期滞在して、その影響を観察する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703004
					],
					"speakerTitle": "ヘディーヴ"
				},
				{
