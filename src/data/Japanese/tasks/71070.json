					"speakerTitle": "タリエシン"
				},
				{
					"id": 710701902,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "私は伝統を重んじる吟遊詩人でね。ここへ来たのはもちろん、インスピレーションを得るためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710701904,
					"content": "うわぁ…あんなに元気だったのに、なんでそんな死にそうな顔してるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710701905,
					"content": "鉱区に入るのは初めてでね…それに…ここに来る途中、急ぐあまり足を捻ってしまったのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710701906,
					"content": "ぐっ…いたた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710701907,
					"content": "邪魔しないでおくよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "すぅー…はぁー…この薬、使いにくいなぁ…あ、そっちも気をつけてくれたまえ。何か新しいネタがあったら、ぜひ教えてくれるかい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タリエシン"
				}
			]
