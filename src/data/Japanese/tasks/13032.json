			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "うぅ…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320902,
					"content": "もう目覚めの時間かよ、オイラもっと見たかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320903,
					"content": "うちらが願いで召喚した流星は、まさかの地面から上に飛ぶ星やったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320904,
					"content": "花火とまったく一緒やん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320905,
					"content": "——こんなんじゃ足りひん、もっともっと見たいわ。うちが見た中でいっちゃん生き生きしてて、いっちゃん豪華で…いっちゃん浪漫のある夢やった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320906,
					"content": "オイラも同意見だぞ。でも、オイラたちを連れてその上まで跳ぶとは思わなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320907,
					"content": "へへっ、うちも深く考えてへんかってん。あんな機会やもん、一発派手なことやっとかんと、勿体な過ぎる思てん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320908,
					"content": "#宵宮、{M#君}{F#あなた}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "夢だってとっくに気付いてたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "うちのことは、あんたが一番よう知ってるやろ。夢かどうかなんかまーったく気にしてへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320911,
					"content": "せやけど、あんたらに感謝せんとな。全部、流星雨が簡単に見れるもんとちゃうから言うて、用意してくれた代替案やったんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320912,
					"content": "めっちゃ気に入ったで。ほんま、めちゃくちゃ気に入った。今までうちが貰った全部の贈り物の中でも、一番やわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320913,
					"content": "だったらよかったぜ。本当のことを知ったら、怒るんじゃないかって心配してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320914,
					"content": "そんなわけないやん。夢で、親切で優しい、めっちゃかわええアランナラを見れて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320915,
					"content": "キノコがぎょうさんあるところを走り回ったり、飛んだりして、思いもしいひん形で「蒼松石」を見つけて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320916,
					"content": "もうそろそろ目覚める頃やろなぁ思てたら、今度はダンチですごいこと起きてんで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320917,
					"content": "…エービンちゃんが胸元から、「蒼松石」の眼鏡を取り出して…みんなで一緒に地面から飛び上がる流星を見つけたと思ったら、その流星の一部になるやなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320918,
					"content": "#{M#俺}{F#私}たちはずっと夢の中にいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "#{M#俺}{F#私}たちはずっと目覚めなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "せやな、夢っちゅうんは幻やけど、二度と再現も体験もできひん一回きりの「経験」や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320921,
					"content": "本当かどうかなんかに拘ってしもたら、きれいなもんも感動も、大量に見逃してまうんちゃう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320922,
					"content": "へへっ、宵宮は褒め上手だな。「パイモンの親友」ランキングでのランクを一つ上に上げてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320923,
					"content": "そんなランキング、あるんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "そうだ、アランナラのことだけど、あいつらのことは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320925,
					"content": "アランナラもめっちゃかいらしかったなぁ。これも、よう彫られた木彫りのおかげや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320926,
					"content": "えっ、木彫り？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320927,
					"content": "そうや——木彫りを見てへんかったら、夢であんな可愛いアランナラは見れへんかったやろうしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320928,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320929,
					"content": "#宵宮は{M#俺}{F#私}たちの言いたい事が分かったみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "木彫りよりも可愛いと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "へへっ、安心しぃ、ようわかっとる。可愛いと思てんねんから、当然守りたいとも思とる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320932,
					"content": "ほな、そろそろ時間や。エービンちゃんを家に送ってこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321101,
					"content": "エービンを家まで送った後、宵宮と一緒にしばらくスメールに滞在した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
		{
			"id": 1303211,
			"completionStepIds": [
				1303211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
