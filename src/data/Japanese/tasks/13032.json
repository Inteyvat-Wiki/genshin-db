			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "はぁー、はぁー、やっぱりお姉ちゃんのほうが速いよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320202,
					"content": "へへっ、もっと長い距離やったら分からへんで。追いつかれるかと思ったもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320203,
					"content": "うんうん、エービンも負けてなかったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320204,
					"content": "走りなら、大勢の大人に勝ったことあるよ。足が長くったって、速いとは限らないからね。鍛錬もすっごく大事なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320205,
					"content": "あと数年経ったら、うちは相手にもならへんやろな。はははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320206,
					"content": "うーん、そやなぁ、次はどっち行こか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320207,
					"content": "あれ？見ろ、前になにかが浮かび上がって来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320208,
					"content": "まるで…星みたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "ひょっとして、私たちについて来てほしいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320210,
					"content": "うん、そうかもな。ついてってみよか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
