						],
						"stepId": 1303206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エービン",
					"宵宮",
					"アランシャニ",
					"アランプールヴァ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "こ、これって…終わっちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320602,
					"content": "めっちゃええ夢やったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320603,
					"content": "寂しい顔なんかせんでええ。ほら、隣みてみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320604,
					"content": "アランシャニ！よかった、まだいてくれたんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320605,
					"content": "アランシャニ、謝りたい。アランシャニ、ナラを探しにいきたくなかったわけじゃないの。ただ、アランシャニは時間をよく覚えられなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "アランシャニ"
				},
				{
					"id": 130320606,
					"content": "アランシャニはシティに行く勇気がなかった。ナラに会えなかったから、アランシャニはナラエービンに、新しい友達ができたんだと思っちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "アランシャニ"
				},
				{
					"id": 130320607,
					"content": "よくあることじゃ、しょうがあるまい。そこまで悔やむ必要などない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "アランプールヴァ"
				},
				{
					"id": 130320608,
					"content": "大丈夫、分かってるの。私が立ち直れなかったせい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320609,
					"content": "でも、私分かったの。お姉ちゃんの言う通り、誰にだって不運は訪れる…大事なのは、お互いに支え合うことなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320610,
					"content": "みんな、私を助けてくれてありがとう。私、取り戻してもらった記憶や夢に背かないよう、頑張るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320611,
					"content": "へへっ、あんたもお姉ちゃんのこと助けてくれたんやし、ええねんええねん。ほんまやったら、うちらは「蒼松石」の手がかりなんか何もなかったんやさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320612,
					"content": "ほんまにそれで合うてたら、すぐ見つかるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320613,
					"content": "お姉ちゃんは流星雨を見たいんだよね。そのために「蒼松石」が必要なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320614,
					"content": "せやで。そやそや、見つけたらあんたも一緒に見に来ぃや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320615,
					"content": "そういうことなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320616,
					"content": "「蒼松石」をあなたに貸してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320617,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320618,
					"content": "ど、どういうことだ？胸のところから…メガネを取り出した！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320619,
					"content": "#{M#俺}{F#私}にも分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "アランプールヴァ"
				},
				{
					"id": 130320621,
					"content": "はははっ、なんでこれが、うちのいるもんやってわかったん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320622,
					"content": "私にもよくわからない…私のために一番大切な友達を見つけてくれたから、私も一番貴重なものであなたを助けてあげなきゃと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320623,
					"content": "そしたら光がこの姿になったの。これがあなたが必要とするもの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320624,
					"content": "おおきに…まさか、こないにあっさり解決するとは思わへんかったわ。さっそく試させてもらうで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320625,
					"content": "使い方はようわからへんけど、ここは直感ちゅうことで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320626,
					"content": "どこやどこや～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320627,
					"content": "おっ！見えたみたいやで、なかなか目立つやん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320628,
					"content": "ほな、うちが先導するわ。流星雨を見終わったら、家まで送ったるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320629,
					"content": "それに、助けてくれてほんまにありがとさん。——っていうのはありきたりなお礼の言葉やけど…一つ褒め言葉も言うていい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320630,
					"content": "あんたら、さいっこうの語り部やわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320631,
					"content": "ほう、それは奇遇じゃな。ワシからもその言葉をそっくりそのまま返そう、赤色のナラ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランプールヴァ"
