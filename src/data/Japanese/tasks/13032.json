			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮",
					"ニオシャ",
					"エービン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "スメールってほんまにええとこやなぁ。また遊びに来るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321106,
					"content": "もちろん、いつでもいらしてください。エービンも喜びます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "ニオシャ"
				},
				{
					"id": 130321107,
					"content": "約束だよ。ずっと待ってるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130321108,
					"content": "はははっ、分かった分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321109,
					"content": "お姉ちゃん…帰る前に、もう一つ伝えておきたいことがあるんだ——私、新しい夢ができたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130321110,
					"content": "自分の力で稲妻に行って、稲妻の花火をこの目で見たい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130321111,
					"content": "わぁ、えらいおっきい夢やなぁ！ははっ、まさかこの旅で、うちの花火屋に新しいお客さんを引き寄せられるとは思っても見いひんかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321112,
					"content": "安心しぃ、うちがあんたのために花火を作ったるわ。一回見たらもう、ぜーったい忘れられへんやつをな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321113,
					"content": "あんたらもやで。冒険がどんなに忙しゅうても、稲妻に遊びに来るんは忘れんといてな。どんな時でも、みんなあんたらのことを歓迎するんやさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321114,
					"content": "今回の旅の成果を、あんたらと一緒に空に打ち上げたいなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321115,
					"content": "おう、約束だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130321116,
					"content": "道中気を付けてね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "了解、あんたは相変わらず優しいなぁ、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321122,
					"content": "ほなうちからも…これなーんや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321123,
					"content": "アランナラの木彫り…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "うん、あんたがうちのために選んでくれたんと一緒の子や。うちに似てるってあんたとパイモンちゃんが言うてくれたやろ？さっき一つ買うてきてん、あんたにあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321125,
					"content": "なぁんか良うないときはこれ見てぇな。少なくともうちはあんたの味方やって思たら、ちょっとは元気が出るかもしれへんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321126,
					"content": "もちろん、うち本人に会いに来るんが一番やけどな、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321127,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "うん、ほなうちは帰るわ。すぐまた会えるって信じてるしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321130,
					"content": "うちのために用意してくれた旅、もうめちゃくちゃ気に入ったわ。それどころちゃう…もう、感無量や！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321131,
					"content": "その友情と優しさは、どこまで行っても、あんたらの背中を支えてくれる強い力になるはずやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321132,
					"content": "このまま、旅の終点まで、世界の果てまで行きー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321133,
					"content": "ほな、また！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321128,
					"content": "大事にするよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "毎日楽しく過ごせますように。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "毎日楽しく、ずっと楽しく、やで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321120,
					"content": "花火はパッと消えてまうけど、友情は一生もんや！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "あ、あんた、いきなりなに言うねん、恥ずかしいやんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				}
			]
		}
	]
}