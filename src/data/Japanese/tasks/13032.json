			"trigger": {
				"objectNames": [
					"アランプールヴァ",
					"エービン",
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "さっきから聞きたかったんだけど…準備ってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320102,
					"content": "ナラエービンはまだ完全に思い出しておらん。記憶と夢は、どちらも欠けてはならんのじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "アランプールヴァ"
				},
				{
					"id": 130320103,
					"content": "夢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320104,
					"content": "でも私…もう立てない。治るかどうか分からないし、治るとしてもどれだけ時間がかかるか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320105,
					"content": "そのような心配はいらぬよ。ナラエービン、覚えておくのじゃ…夢はキミの体ではなく、こころに関係するものじゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "アランプールヴァ"
				},
				{
					"id": 130320106,
					"content": "こころ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320107,
					"content": "ワシの案内はここまでにしておこう。大切なものは、ナラエービン自身で取り戻すんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "アランプールヴァ"
				},
				{
					"id": 130320108,
					"content": "えっ？消えてしもた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320109,
					"content": "周りの空まで、ちょっと変わったみたいやな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320110,
					"content": "こころ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320111,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320112,
					"content": "ええ——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320113,
					"content": "私…立てた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320114,
					"content": "何の力もいらなかった。変な感じもしない…全部病気になる前と一緒だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320115,
					"content": "おい、もしかしてオイラたち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320116,
					"content": "夢の中に入った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "だな。この前もこんなことがあったよな…道理であいつ、心配いらないって言ってたんだ。夢の中なら、エービンも自由に動けるんだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320118,
					"content": "みてみて、私、立っちゃったよ！えへへ、立てるようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320119,
					"content": "よかったやん。これで一緒にアランシャニを探しに行けるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320120,
					"content": "なぁ、かけっこしようや！あんたがどれくらい速いんか、ええ機会やし見してぇな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320121,
					"content": "まだしっかり回復はしてないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320122,
					"content": "…まあいっか、そんなことしらない。走りましょう！走ることなら、大人だって怖くないんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320123,
					"content": "あっ、走り出したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320124,
					"content": "こんなに順調にいくなんてな。もうちょっとくらい、慣れる時間が必要かと思ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320125,
					"content": "これぞ才能ってものかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "へへっ、そうだな。オイラたちも追いかけようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320126,
					"content": "これが願いってことかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
