				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "たぶん、ここが終わりだよな。でも、アランナラは見かけなかったぜ…ここのおっきい石だけでさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320502,
					"content": "ほんと楽しい…こんな気持ち、ほとんど忘れちゃってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320503,
					"content": "知ってる？走れないと、自分の世界はほんの少ししかないって思っちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320504,
					"content": "でも、走り続けることさえできたら、目の前には新たな景色が現れ続けて…世界は私の前に、無限に広がってくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320505,
					"content": "#どうやってこんなことができたのかは分からないけど…きっと{M#お兄ちゃんとお姉ちゃんたち}{F#お姉ちゃんたち}のおかげだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320506,
					"content": "ははっ、そんなん重要とちゃう。大事なんは、あんたが色んなことを思い出したことやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320507,
					"content": "記憶は過去を象徴してるだけとちごて、未来を照らす力でもあるんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320508,
					"content": "病気さえ治せば、こう言う楽しさはみんな、あんたのところにまた戻ってきてくれんねん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320509,
					"content": "うん、お姉ちゃんありがとう、あなたたちもありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320510,
					"content": "じゃあ、アランシャニを探し続けましょう。ここにはいないみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320511,
					"content": "そうだな。でも、だったらどうしてオイラたちをここまで誘導したんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320512,
					"content": "#{M#俺}{F#私}、この石がすごく印象的に感じる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "はっきりと説明できないし、これがなんなのかはわからないけど、なんとなく見覚えのある感じがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320514,
					"content": "何だか、「これ」が元々私の一部だったような感じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320515,
					"content": "わかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320516,
					"content": "この石はもしかしたら、この子の「蒼松石」なんかもしれへんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320517,
					"content": "そ、蒼松石？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320518,
					"content": "（宵宮って物語を作るのが上手。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "（鉱石のこと、忘れかけてた。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "めっちゃ希少な鉱石なんやで。人の初心と夢を象徴してんねんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320521,
					"content": "これが見えるっちゅうことは、失ったものを取り戻せたっちゅうことやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320522,
					"content": "そうだったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320523,
					"content": "なんか、おとぎ話みたい。おとぎ話なんてもう信じないって決めたのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320524,
					"content": "でも、本当によかった。やっと取り戻せた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320525,
					"content": "えっ！？と、通り抜けちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320526,
					"content": "うちらも行くで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320527,
					"content": "お、おい、宵宮…！もう、しょうがない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320528,
					"content": "通り抜けてはみたけど、周りを見る限り、特に目立った変化はないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320529,
					"content": "久しぶり、ナラエービン。久しぶりって、合ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "アランシャニ"
				},
				{
					"id": 130320530,
					"content": "アランシャニ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320531,
					"content": "どうして悲しい顔なの？あっ、アランシャニわかった、これは嬉しい顔だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "アランシャニ"
				},
				{
					"id": 130320532,
					"content": "アランシャニ！うわぁあん——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "エービン"
				},
				{
					"id": 130320533,
					"content": "はははっ、アランナラはうちらに、浪漫たっぷりの旅を用意してくれてんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320534,
					"content": "あの子にいっちゃん大事な友達を取り戻させてくれただけちごて、うちらに「蒼松石」がなんなんかも教えてくれたんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320535,
					"content": "あとでうちらも、うちらだけの「蒼松石」を探しに行くで。絶対、いっちゃん純粋なレンズを作ったるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320536,
					"content": "おう！理由はわからないけど、オイラもできる気がするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 130320537,
					"content": "これこそ冒険だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "#{M#俺}{F#私}も楽しくなってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "うん！せやけど、まずはエービンちゃんをスメールシティまで送ったらなあかんな。お母ちゃんが心配しはるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320540,
					"content": "目の前の光景は夢や幻のようにぼやけ始め、気付けばもとの場所に戻されていた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1303206,
			"completionStepIds": [
				1303206,
				1303207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
