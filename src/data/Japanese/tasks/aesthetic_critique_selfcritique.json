			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "いや、違う…光と陰影を取り除いたら、絵のグラデーションはどうするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150402,
					"content": "絵の具の表現力が足りないし…色彩の違いもイマイチだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150403,
					"content": "ダメだ、いくつかの要素を取り除いただけなのに…絵全体がめちゃくちゃになっちまった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150404,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "君だったのか。会えてよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150407,
					"content": "誤解させたならすまない。さっきは絵のことを考えながら、うろうろ歩き回ってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150408,
					"content": "理解してもらえないかもしれないが、私はじっとした状態では、何も考えられなくってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150409,
					"content": "一つの場所に留まってずっと考えごとをしていると、どんどんイライラしてくるんだ…だから、散策しながら考えるクセがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150410,
					"content": "考えごとをしている時、どこへ行くかは足の気の向くままに任せている。一つの場所に留まってさえなければいいのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150411,
					"content": "だから…よくあることでね。心配させて、すまない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150412,
					"content": "考えた結果、何か結論は出た？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "全然進捗なしだ。まったく…手がかりさえ見つけられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150415,
					"content": "光と陰影を取り除いたら、絵のグラデーションが失われるし、描く対象の形を弱くしたら、絵の構図を支えられなくなってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150416,
					"content": "いくつかの要素を取り除いただけなのに、絵全体が崩れはじめ、挙句にはごちゃごちゃしたゴミと化してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150417,
					"content": "ああ、ただの独り言だから、気にしないでくれ。引き続き解決方法を考えてみるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150418,
					"content": "まずは元の場所に戻って、イーゼルを探さないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150413,
					"content": "考えてた問題はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "何か危険な目にでも遭ったかと思った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"デピエリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "ふぅ…ふぅ…ありがとう。本当に助かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150602,
					"content": "一体どういうことだ。ここで絵を描いてただけなのに、突然あいつらに囲まれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150603,
					"content": "イーゼルに向かって、しつこく攻撃してきて…私の絵を食べようとでもしてたんだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150604,
					"content": "あいつらに絵をダメにされるわけにはいかないから、キャンバスを抱えて逃げたのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150605,
					"content": "でも、すぐに追いつかれて…君が助けてくれて本当によかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150606,
					"content": "この絵に何か問題でもあるんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "ま、まったく分からない！トリックフラワーの蜜で絵の具を作ってる最中だったんだ。ほら、前に君が採ってきてくれただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150609,
					"content": "ちょっと待った…もしかして、あいつらはトリックフラワーの蜜の入った絵の具に惹きつけられたんじゃないよな？でも絵の具と混ぜた後、匂いはしなくなったはずだが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150610,
					"content": "絵の具の配合方法を変えるのは気が引けるし、他の方法を考えるしかないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150611,
					"content": "ゴホン、トリックフラワーにまでこの絵の美しさが伝わって、鑑賞に来たのかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "デピエリ"
				},
				{
					"id": 240150607,
					"content": "何かやらかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}