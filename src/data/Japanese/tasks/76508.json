					}
				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "「流泉の衆」でイベントでもやってるのか？観光客が増えてる気がするぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080102,
					"content": "あそこにスメールから来たっぽい人がいるな…ダンスのパフォーマンスか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080103,
					"content": "おっと！これはこれは、偉大なる大英雄さんと、キュートな参謀のパイモンじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080104,
					"content": "あなたはあたしの最も敬愛する戦士で、武術と舞踊に長けた勇者…そして人生を楽しむ達人だ——会えて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080105,
					"content": "ん？どこかで見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080106,
					"content": "#それに、{NICKNAME}はダンスも踊れるって。なんで知ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080107,
					"content": "そりゃもちろん、聖火競技場で踊ってるのを見たからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080108,
					"content": "#記念写真を撮った後、あたしは隅っこのほうでちび竜ビスケットを食べながら{NICKNAME}の祝福の舞を見てたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080109,
					"content": "#ダンスってのは気楽に、自分を解き放つのが一番だ。{NICKNAME}のダンスは、見ていて一緒に踊りたくなったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080110,
					"content": "思い出した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "光栄だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080114,
					"content": "さて、話を戻そうか。ご覧の通り、スメールの友人たちが遊びに来てくれてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080115,
					"content": "そこでムトタやアミナ、パカル、そしてムアラニと話し合った結果、「花翼の集」、「こだまの子」、「流泉の衆」合同でスメールの客人をもてなすことにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080116,
					"content": "「エルマイト旅団」の傭兵も結構いるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080117,
					"content": "へへ、砂漠を旅してる時に殴り合った勢いで友達になったとかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080118,
					"content": "あはは、だいたいそんな感じ。でも殴り合ったのはあたしたちじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080119,
					"content": "千尋の砂漠の南でバーベキューをしてたら凶暴な赤鷲が群がってきちゃってね。あたしたちが腹いっぱいになって動けなくなった隙を突いて襲いかかって来たのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080120,
					"content": "これがずる賢いやつらでねぇ…苦戦した末に手も足も出ず、あっちは慣れ親しんだ地形を利用して攻めてくるもんだから、あたしたちは疲弊して撤退するしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080121,
					"content": "するとそこに傭兵の一団が現われて、赤鷲に向かって不思議な剣舞をやってみせた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080122,
					"content": "すると赤鷲の群れは通じ合ったみたいに、どこかへ消えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080123,
					"content": "け、剣舞で赤鷲を追い払ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080124,
					"content": "怪しい舞が怖くて逃げたんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "不思議だろ？あたしたちもその舞の秘密が気になって仕方がなくってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080127,
					"content": "キャンプを撤収した後みんなで派手に飲み食いした後、ダンスのテクニックについて色々話したんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080128,
					"content": "途中で他の魔物や野獣が邪魔しに来るようなら、みんなで立ち向かってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080129,
					"content": "二週間もしないうちに命を預け合えるほどの戦友…あと、ダンス仲間になったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080130,
					"content": "別れる前に、今後は互いのホームを訪ね合って「ダンス交流会」を続けて行こうって約束したんだ。今回はその初の試みってわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080131,
					"content": "#なあ{NICKNAME}、スメールとナタのダンス交流イベントだなんて…こんなの初めてだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080132,
					"content": "確かに新しいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "せっかくの機会だし、あたしたちに指導しておくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080135,
					"content": "ムアラニもいるよ。あたしたちの中でもとりわけ明るくて…いわばダンサーの顔だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080136,
					"content": "あと「エルマイト旅団」の友人は、リーダー兼アドバイザーとして現地の有名な踊り子を雇ったらしい。それも大金をはたいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080137,
					"content": "二人も知ってる踊り子じゃないかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080138,
					"content": "誰か分かった気がするぞ。へへっ、後で驚かせてやろうっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080139,
					"content": "いいよ、参加する！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "あははっ！ますます盛り上がりそうだね。ムアラニの言葉を借りて言えば、ビッグウェーブ！ってやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080142,
					"content": "さあ、ひとまずタラネに会いに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080140,
					"content": "そんなイベント、見逃せない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "見てみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "もともと知り合いだったとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "次に会う時は覚えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "今のあたしじゃ力不足ってことだね。胸を張れるような実績もないし、もっと頑張らないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "ヌスタ"
				}
			]
		},
		{
			"id": 7650803,
			"completionStepIds": [
				7650802
			],
