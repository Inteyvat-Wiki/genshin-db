							9052.41
						],
						"pointId": 350200533
					}
				]
			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#えっ？ええっ！？あの有名な{NICKNAME}さんじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 765080302,
					"content": "ニィロウさんに来てもらえるだけでも最高にラッキーなのに、達人中の達人まで来てくれてるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 765080303,
					"content": "もっとおだててくれ。あたしまで気分がよくなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080304,
					"content": "ん？それはオイラの台詞じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080305,
					"content": "そうだね！同じ台詞でもパイモンが言うと軽やかで柔らかくてかわいらしくて、まるでウクレレの音色みたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080306,
					"content": "あたしが言うと…酒をあおったドラムスが演奏した時みたいに、抑揚たっぷりで安定感があって力強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080307,
					"content": "イアンサ師匠の教えじゃ、バスドラのダブルペダルは踏めば踏むほどいいんだ。それも自動小銃みたいに途切れることなく叩けるほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080308,
					"content": "要するに、同じことを言っても話者が違えば新鮮に聞こえるんだよ。お互いに補い合えて、リズムもピタリと合う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "ヌスタ"
				},
				{
					"id": 765080309,
					"content": "そ、そうなのか？ちょっとよくわかんなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765080310,
					"content": "ヌスタさん、いいこと言うじゃん。大事なのは「リズム」ってことだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 765080311,
					"content": "私たちのダンスは自由で大胆だけど、無秩序ってわけじゃない。少なくとも肝心な動きはきっちりとリズムに合わせる必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 765080312,
					"content": "最近新しいダンスを振付したんだけど、体験に来た新人や…新入りの竜には、リズムをつかむのがまだ難しいみたいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080313
					],
					"speakerTitle": "タラネ"
				},
				{
					"id": 765080313,
