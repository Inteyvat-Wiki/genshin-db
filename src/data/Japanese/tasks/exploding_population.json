				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナンタック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "どうだ？その表情、悪くなかったんじゃないか？見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610602,
					"content": "ほう？新しい種類の魚だ！悪くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610603,
					"content": "当時の私を追い越そうという勢いだな。ハハハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610604,
					"content": "あなたも素手で魚が捕れるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "ゴホッゴホッ…どうやら小さな魚は君にとって楽勝だったか。君にはもっと難しいのに挑戦してもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610606,
					"content": "知らないかもしれないが、種類が同じ魚でも、環境や食物の影響により、大きな違いが生まれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610607,
					"content": "見た目は同じでも、中にはとても活発的で、すさまじくエネルギッシュな個体がいる。よく水面から飛び出すから、印象に残りやすいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610608,
					"content": "その個体は商業価値も観賞価値もとても優秀なものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610609,
					"content": "数々の愛好家が高値で購入し、水槽で飼って観賞する。だから、「観賞魚」と呼ばれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610610,
					"content": "それって「非常パイモン」以外に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "「観賞パイモン」がいるってことだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "違うぞ！パイモンがそんな多くの種類あるわけないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610613,
					"content": "それと同じ道理さ！どうやら完全に理解したようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610614
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610614,
					"content": "近ごろ、望風山地近くの水域でたくさんの「観賞魚」が確認された。マップに記しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610615
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610615,
					"content": "今から行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナンタック"
				}
			]
