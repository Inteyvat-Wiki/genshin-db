			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナンタック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "場所はここだ。水の中の魚を見たか？本当にきれいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610402,
					"content": "これが君のために用意した道具だよ。釣り竿、釣り餌、それと釣り餌の配合も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610403,
					"content": "まずは釣り針の上に釣り餌をかけ、魚群が集まった場所を狙い…竿を投げる！それから大人しく魚がかかるのを待つんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610404,
					"content": "新人には、「ビギナーズラック」があるらしいぞ。私も当時は、0.5メートルもあるビッグバスを釣り上げたんだ！君も試してみてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610405,
					"content": "パイモンをもう一人釣り上げたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "オイラだけじゃ満足できないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610407,
					"content": "パイモン？そのような名前は聞いたことがない。一種の魚か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610408,
					"content": "以前釣り上げた「不思議な海鮮」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "おい！「非常食」から「不思議な海鮮」になったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610410,
					"content": "なるほど！君も経験のある釣り人だったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610411,
					"content": "では君の収穫を期待しているよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナンタック"
				}
			]
		},
