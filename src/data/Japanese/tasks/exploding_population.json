			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "星と深淵を目指せ、ようこそ、冒険者協会へ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706610102,
					"content": "近ごろ、釣り協会からの依頼を受けております。彼らによると、付近の水域にいる魚に異常が発生しているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706610103,
					"content": "しかし具体的な状況の説明はありません。旅人さん、お手伝いお願いできないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706610104,
					"content": "あなたなら、どんな状況でも、必ず解決できると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706610105,
					"content": "釣り協会？あの釣りのこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "えっ？あの釣りとはなんでしょう…？あなたの言う釣りは、どの釣りでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 706610107,
					"content": "まったく、釣り協会だろ、美味しい魚をたくさん釣り上げる協会のことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610108,
					"content": "時間がもったいない！早く行こうぜ！えへ、えへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナンタック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "近ごろの魚は活発だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610202,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "ああ、やっと助っ人が来たか。ようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610204,
					"content": "私はナンタック、モンド釣り協会のベテランの釣り人だ。コホンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610205,
					"content": "最近、近くの水域に新たな種類の魚がたくさん出現した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610206,
					"content": "すぐに他の地域の同業者に話したら、やはり各地でもこの現象が起きているらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610207,
					"content": "中には、テイワット百年以来の魚類大量発生期が訪れたという者もいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610208,
					"content": "原因はまだ完全に究明できていないが、多かれ少なかれ生態環境が良くなったことと関係しているだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610209,
					"content": "えっと——そいつらが増えすぎて、おまえたちに迷惑をかけてるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610210,
					"content": "安心しろ、オイラに任せてくれ！そいつらが不味くなければ、オイラが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706610211,
					"content": "ハハッ、迷惑という程のことじゃない。釣り協会にとって、魚群は多ければ多いほどいい。人手が足りていればの話だがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610212,
					"content": "はっきり言って、今の私たちの人手では…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610213,
					"content": "短期間内に、釣り上げたすべての新種の魚を研究するのは…難しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610214,
					"content": "だが逆に、これは釣り協会発展の絶好のチャンスだと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610215,
					"content": "だから、冒険者協会で依頼を出したんだ。どうだ？我々に加入する気はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610216,
					"content": "釣りは面白いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610217,
					"content": "問題ない、釣りは得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "よし、やる気満々な若者だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610223,
					"content": "ではまず、私と一緒にシードル湖に行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610224,
					"content": "あそこには我々が新人に用意した釣り場がある。基本的なテクニックを君に教えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610219,
					"content": "直接潜って捕まえていい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "直接潜るのは危ないだろ？冒険者は勇敢なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610221,
					"content": "だが魚は君たちほど勇敢じゃない。人が水の中に入ったら、きっと驚いて逃げてしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "ナンタック"
				},
				{
					"id": 706610222,
					"content": "だから、それはやめた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "ナンタック"
				}
			]
		},
