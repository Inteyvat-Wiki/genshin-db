			"trigger": {
				"objectNames": [
					"早柚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "タ、タヌキが人間になった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170202,
					"content": "なんだこれ、初めて見たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170203,
					"content": "拙はタヌキじゃない…ムジナだ…すぅ…すぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170204,
					"content": "眠い…もっと寝ないと…背が伸びない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170205,
					"content": "まさか、こいつが神子の言ってた「専門家」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170206,
					"content": "全然そんな風に見えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170207,
					"content": "ふふ…こやつは「終末番」の一員、正真正銘の「忍者」じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170208,
					"content": "忍者！じゃあさっきのは、伝説の変化の術か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170209,
					"content": "でも、「終末番」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170210,
					"content": "終末番は社奉行にある、神里綾人の隠密部隊じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170211,
					"content": "現在、神里綾人と社奉行は中立な態度を維持しておる、妾でも終末番を動かすことはできぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170212,
					"content": "しかし、年中サボっている終末番の一員を捕まえて手伝わせることくらいは可能じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170213,
					"content": "ぐぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170214,
					"content": "では、汝らには城内へ入り、天領奉行が裏切った証拠を探してきてもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170215,
					"content": "あのような場に妾が顔を出すのは相応しくないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170216,
					"content": "そんなこと言われたって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170217,
					"content": "どうすればいいか全然分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "ん？もうとっくに分かっているものじゃと思っておったが。いいじゃろう、少し手がかりをやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170220,
					"content": "部外者にとって、天領奉行の細部まで知ることはたしかに困難なことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170221,
					"content": "じゃが、三奉行が将軍を補佐し、密接な関係を保っている以上、他の奉行が異変に気づくこともままあることじゃろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170222,
					"content": "社奉行！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "ふふ…わかったようじゃな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170224,
					"content": "幕府軍の汝に対する捜索はまだ終わっておらぬ。じゃが、この終末番の忍者の助けがあれば、汝の友と無事再会できるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170225,
					"content": "約束の日までに証拠を持ってくるんじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20170218,
					"content": "証拠っていったい何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201704",
