				},
				{
					"id": 20171004,
					"content": "けど威力がとんでもなくてな、実験できる場所も見つからんくて…ちょうどええから、あんたらにあげるわ、うちの代わりにどんなもんか見てきてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 20171005,
					"content": "あっ、それと、火ぃつけたらすぐ走るんやで、やないと服が燃えてまうからな。それと耳も塞いだ方がええで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 20171006,
					"content": "え…なんかこわいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20171007,
					"content": "あははっ、大丈夫やって。ただの花火やから、なんの問題もあらへん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 20171008,
					"content": "じゃあ、やってみる…ありがとな、宵宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
