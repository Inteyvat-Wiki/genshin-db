				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トーマ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "君たち、どうして戻って来たんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170404,
					"content": "抵抗軍は？今の戦況は？オレはここから出ても大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170405,
					"content": "まだ無理だと思う…オイラたちが来た時も、近くで見回りしてる人がいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170406,
					"content": "まだ終わってないんだね…じゃあ、ここに来たのはオレたちに相談事があるからかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170407,
					"content": "お嬢を呼んでくるから、ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170408,
					"content": "現状を綾華とトーマに教えた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170409,
					"content": "なるほど、様々なことを経験したようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170410,
					"content": "状況はすべて理解しました。今はとにかく天領奉行が裏切ったという証拠を見つけなくてはなりません。そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170411,
					"content": "そう言われると、確かに気になる点がございました。幕府軍と抵抗軍は長きに渡り交戦してきましたが、将軍様がそのことについておっしゃったことは一度もなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170412,
					"content": "最初は単に将軍様がそのことに興味を持っていないのかとも思いましたが、いま考えると、天領奉行が将軍様に呈上した<color=#00E1FFFF>上奏</color>に何か問題があったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170413,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170414,
					"content": "天領奉行は国内の軍事事務を掌握しています。彼らに隠蔽の考えがあった場合、我々に知る術はございません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170415,
					"content": "その結果、将軍様は目狩り令で生じる害を誤算してしまい、それを続けているのでしょう。もし天領奉行の上奏を手に入れることができましたら、すべてが分かるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170416,
					"content": "だけど、上奏に触れる権限をもつ者は、九条孝行一人しかいないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170417,
					"content": "それにあそこの警備は厳重で、たとえ早柚の助けがあっても、上奏をこっそり持ち出すのは至難の業だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170418,
					"content": "あの護衛たちの気を一時的に引くことのできる何かがあればいいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170419,
					"content": "そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170420,
					"content": "注意を引くのなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "宵宮の花火！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170423,
					"content": "トーマらしい策ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170424,
					"content": "しかし理にかなっているかもしれません。天領奉行の隣には千手百目神像があります。もしその周囲で花火を放てば、天領奉行も無視はできないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170425,
					"content": "その時に早柚が天領奉行に入り込めば、上奏や他の証拠などを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170426,
					"content": "よし！オレが自由になれる日が、どんどん近づいてきてるのを感じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170427,
					"content": "ふぅ…こうして座って一緒に話すのも、もうだいぶ前のことに思えてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170428,
					"content": "まだそんな経ってない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "オレにとってはそうなんだ。毎日ここで君たちを待ってるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170430,
					"content": "昔から、確かにここはオレの一番好きな秘密の場所なんだけど、今回ここに身を潜めるようになって、もうずっと茶屋の外には行けてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170431,
					"content": "クソ～っ、温泉に入りたいなぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170432,
					"content": "トーマ、かわいそうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170433,
					"content": "今は目先の問題を解決するのが先です。目狩り令が廃止になれば、トーマも自由になれますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170434,
					"content": "せっかくの再会ですが、談笑している時間はないようですね。すべてが終わってから、またきちんとお祝いをしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170435,
					"content": "その時はもう一回鍋遊びをやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170436,
					"content": "まだそれを引っ張るのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170437,
					"content": "天領奉行の近くには護衛がたくさんいます。くれぐれもお気をつけて。終わったらここでまた会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170438,
					"content": "#じゃあ{NICKNAME}、オイラたち<color=#00E1FFFF>花見坂</color>へ<color=#00E1FFFF>宵宮</color>を探しに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170421,
					"content": "前にもやったことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
