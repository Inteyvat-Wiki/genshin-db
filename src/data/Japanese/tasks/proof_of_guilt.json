			"dialogs": [
				{
					"id": 20170701,
					"content": "ん…予想通りだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170702,
					"content": "人がたくさん…気をつけないと…見つかる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170703,
					"content": "潜入するには、注意を逸らさないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170704,
					"content": "宵宮を信じるしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "拙が上奏を手に入れたら、<color=#00E1FFFF>木漏茶屋</color>で集合する、それでいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170706,
					"content": "それと、もし拙が捕まったら…助けに来て…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170707,
					"content": "本当に大丈夫か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170708,
					"content": "と、とにかくオイラたちは先に<color=#00E1FFFF>千手百目神像</color>のところに行こう！見回りに見つからないように気をつけろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
