			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#どうでしょう、{NICKNAME}、計画はうまくいきましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170902,
					"content": "分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "お疲れ様です、あとは早柚を待つだけですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170905,
					"content": "しばらくすると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170906,
					"content": "ふぅ…ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170907,
					"content": "たしかに運動は成長を促すけど、これは運動しすぎたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170908,
					"content": "くらくらして…みんな…回ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170909,
					"content": "だめ、眠る前に、まだ重要なことが…そう、手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170910,
					"content": "主らの言う「上奏」がなんなのかわからない…けど、怪しいものはぜんぶ持ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170911,
					"content": "はい、これ…拙はもう寝る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "早柚"
				},
				{
					"id": 20170912,
					"content": "お嬢、これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170913,
					"content": "この封がされたもの、天領奉行が将軍様に呈上した「上奏」で間違いないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170914,
					"content": "それ以外にも、これは…彼らとファデュイの間で交わされた手紙ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170915,
					"content": "どうやら八重宮司様の判断は正しかったようです。今の稲妻の紛争は、彼らが助長したものでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170916,
					"content": "これらの証拠があれば十分。これを<color=#00E1FFFF>八重宮司</color>様に渡せば、あのお方が次の計画を立ててくれるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170917,
					"content": "私も人手を招集し、稲妻にいるファデュイをできる限り探し出します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170918,
					"content": "だけど、将軍様には気をつけろ。あの方の刀を振るう姿を思い出すたび、身が震え上がる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "トーマ"
				},
				{
					"id": 20170919,
					"content": "八重宮司様を信じるしかありません。あのお方は将軍様と密接な関係にあります、何か方法があるのかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20170920,
					"content": "たしか、もうすぐ神子との約束の日だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170921,
					"content": "オイラたちも支度が終わったら、<color=#00E1FFFF>鳴神大社</color>に行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 20170903,
					"content": "花火に火をつけて逃げてきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
