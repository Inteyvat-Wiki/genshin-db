			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェリックス·ユーグ",
					"スワン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "モンドの情熱は想像以上だ…あのヒルチャールたちでさえ、活気に溢れている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140102,
					"content": "とにかく…ユーグさん、もう勝手に出歩かないでくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140103,
					"content": "なんだって？私の装置はどうなる。もうすぐで完成するというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140104,
					"content": "あとは…一、二、三…十八…十九個の部品だけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140105,
					"content": "すでに冒険者が探していますので、安心して城内に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140106,
					"content": "いやいや、装置がないと…インスピレーションが湧いたとき、どう責任を取ってくれるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140107,
					"content": "インスピレーションは一瞬で去ってしまう。例えるなら…酒を飲んだあとのゲップのように、すぐ消えてしまうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140108,
					"content": "おっと、この比喩はなかなかに良かったな。書き残しておこう。グザヴィエもきっと気に入るだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140109,
					"content": "うぅ…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140110,
					"content": "おや？栄誉騎士…よかった、栄誉騎士じゃないですか！どうぞ、こちらへ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140111,
					"content": "どうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "ご紹介いたします、こちらはフォンテーヌ廷からいらした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140114,
					"content": "空想家だ！我々は自らをそう呼んでいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140115,
					"content": "…ユーグさん、こちらは我々モンド城の栄誉騎士の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140116,
					"content": "ハハッ！ユーグ、フェリックス·ユーグだ！君に敬意を表そう、栄誉騎士！なんて言ったって、君のことはよーく聞いていたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140117,
					"content": "#{M#俺}{F#私}を知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "もちろん、もちろんだとも！君のことは知っているさ。むしろ、知らない人間なんているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140119,
					"content": "何てったって以前、君がモンドで風龍と戦った事実は、『スチームバードデイリー』で三週間も一面を飾ったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140120,
					"content": "ハハハッ、私が君と喋っていることを記者たちが知ったら、きっと嫉妬で夜も眠れないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140121,
					"content": "『スチームバードデイリー』って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "知らないのか？『スチームバードデイリー』はフォンテーヌ廷の…ふむ…知名度がとても高い新聞だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140123,
					"content": "そして君は、彼らに最高の売り上げをもたらした立役者というわけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140125,
					"content": "一面？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "ああ。なんて言ったって君は、彼らに最高の売り上げをもたらした立役者だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140127,
					"content": "一面見出し、号外記事、専門家インタビュー、そして最高の挿し絵まで揃えていたからな。ハッ！きっと儲かりまくっただろうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140128,
					"content": "それでは…旅人さん、フェリックス·ユーグさん、僕はこれで…まだ他の用事がありますので、失礼いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "スワン"
				},
				{
					"id": 705140129,
					"content": "スワンはそそくさと去っていった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "あぁ、やっぱり。うわさの通り、西風騎士団には処理しきれないほどの事務があるらしいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140131,
					"content": "それで、どうしてモンドに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "私か？実は今、テイワット全土を回る計画を立てているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140133,
					"content": "目的はもちろん、私が作ったこの「動機コア」を売ることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140134,
					"content": "簡単に言うと、一種のゼンマイ式装置なんだがな。このコアは、一定の間隔をあけてゼンマイを巻くだけで、運動エネルギーを長時間供給できるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140135,
					"content": "この装置を紹介するために、特別に「動機コア」を動力源にした永久機関型おもちゃを作った。その名も、「からくり械画」さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140136,
					"content": "君にも見せたいのはやまやまなんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140137,
					"content": "あの装置は非常に出来がよくてね、魔物でさえもその魅力に惹かれてしまうようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140138,
					"content": "現状…私の装置は魔物たちによってバラバラにされてしまって、好き勝手に遊ばれているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140139,
					"content": "すでに冒険者協会に助けを求めたが、未だに進展がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140140,
					"content": "栄誉騎士、もしよければ、手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140141,
					"content": "信じてくれ、私の装置…そして報酬は、君を失望させはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140142,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "素晴らしい。やはり新聞に書いてあった通りだ。君は実力もさることながら、優しい心を持った冒険者なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140144,
					"content": "モンドで出会ったのが惜しいほどだ。もしここがフォンテーヌ廷だったら、『スチームバードデイリー』の記者を連れてきてインタビューさせたかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140145,
					"content": "きっと君の魅力に感動し、喜んで再び三週間の一面を君で飾って、インタビューの報酬を捧げたことだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140124,
					"content": "一面見出し、号外記事、専門家インタビュー、そして最高の挿し絵まで揃えていたからな。ハッ！きっと儲かりまくっただろうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140112,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
