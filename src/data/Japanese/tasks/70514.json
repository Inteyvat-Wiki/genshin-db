			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "栄誉騎士！戻って来たか。パーツの件はどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140302,
					"content": "これであってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェリックス·ユーグ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "これだ、間違いない！素晴らしい、私のパーツだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140402,
					"content": "よし、パーツも揃ったし、あとは組み合わせるだけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140403,
					"content": "さて…栄誉騎士、もしよかったら、この「からくり械画」の部品を組み合わせてみないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "フェリックス·ユーグ"
				},
				{
					"id": 705140404,
					"content": "きっと気に入るはずだ。私を信じてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェリックス·ユーグ"
				}
			]
		},
		{
			"id": 7051405,
