			"trigger": {
				"objectNames": [
					"パイモン",
					"アルフォンソ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "（ヴィマラ村の「悪者」を見つけ出そう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "こんにちは、アルフォンソ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800103,
					"content": "#君たちか。{NICKNAME}、何か用か？ラナを探してるのなら、彼女はもう行ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800104,
					"content": "相談したいことがある——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "ヴィマラ村に潜んでいる「悪者」について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#ああ。{NICKNAME}が悪者を片付けるって約束したから、ラナも安心して旅に出られたんだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800107,
					"content": "…そうか。分かった、心当たりはないが、聞きたいことがあれば聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800108,
					"content": "まず、状況を整理しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "それじゃ…ヴィマラ村で最初にいなくなった子供は誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800110,
					"content": "スダッベ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "おう、オイラも思い出したぞ！スダッベだ！アマディアじいちゃんの目に効く薬草があるって聞いて、こっそり森に入ったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800120,
					"content": "ああ、そうだ。当時、俺たちはとても心配して、捜索隊を結成し森に入った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800121,
					"content": "そうそう！ラナが捜索隊を作ったのはおまえだって言ってた！それにカレーを持っていったんだろ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800122,
					"content": "薬草のことをスダッベに教えたのは誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "…俺だ。スダッベはいい子で、アマディアおじいさんのことをよく気にかけている。あの子と話した時に、そのことを話したのを覚えている。だが、俺はこうも言った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800124,
					"content": "おう、オイラ知ってるぞ！「勝手に森に行ったらダメだ」って言ったんだろ。おまえにそう言われたってスダッベから聞いたぞ。スダッベは、本当にアマディアじいちゃんのことを大切に思ってるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800125,
					"content": "…他に何か聞きたいことはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800126,
					"content": "えっと…それから、二人目に迷子になったのは誰だっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800127,
					"content": "カブス。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "カブス…あの子は妹が失踪した件について、「友達」と相談しようと森に行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800136,
					"content": "そうだな。カブスに物語を話した時、あいつもそう言ってた！アルフォンソ、カブスの友達って誰か、おまえは知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800138,
					"content": "いや、俺も知らないんだ。森でカブスもあの子の友達も見つけられなかったからな。君たちも知っているように、あの子もスダッベと同じく突然帰ってきた。しかし、何も覚えていなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800139,
					"content": "まだ何か問題があるのか？その後、子供がいなくなることはなくなったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800140,
					"content": "パイモンが言ってやって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "ええ？おう…コホン、次にいなくなるのはイッサムのはずだった、そうだよな？でも、オイラたちとラナはたまたまあいつに会って、助けることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800142,
					"content": "なぜそんなことが起きたのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "ああ…あいつの話だと…アルフォンソから森の洞窟に大きなキノコがあるって聞いたらしいぞ。それを採って、ラナに食べさせようと思ったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800144,
					"content": "でもその道中、ファデュイの悪者に追いかけられて、怖くて逃げた結果、死域に閉じ込められたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800145,
					"content": "ん？あいつ、死域に入ったのか…そんな話、俺は聞いてないぞ！危険すぎる、どうしてそんなことに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800146,
					"content": "#いや、違う…あの子が誤って死域に入ってしまったのなら、どうやって無事に帰ってきたんだ？{NICKNAME}は神の目がなくても元素力を扱えるが、あの子は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800147,
					"content": "（えっと…アランラナのこと、アルフォンソに話してもいいのかな？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800148,
					"content": "（大丈夫。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "…アルフォンソ、信じられないかもしれないけど、森には「アランナラ」っていう精霊がいるんだ。イッサムたちとアランナラは友達だから、そいつらがあいつを助けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800151,
					"content": "アランナラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800152,
					"content": "でも、ファデュイは本当に悪いやつらだな、子供まで狙うなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800154,
					"content": "はぁ…でも、こうして整理してみても、ヴィマラ村に潜む悪者の正体はまだ分からないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800155,
					"content": "パイモン、誰かに監視されてるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "ええ？どこだ！？もしかして、オイラたちが探してる悪者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800157,
					"content": "パイモンが見てきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "オイラ一人でか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800159,
					"content": "何か見つけたら呼んで、すぐ行くから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#ふん、分かったよ。全部{NICKNAME}にやらせるわけにもいかないし、今回はオイラがやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800162,
					"content": "パイモンはやる気に満ちあふれた様子で飛んでいった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "なぜわざわざ余計なことをする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800164,
					"content": "知らないほうがいいこともあるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "場所を変えて話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800165,
					"content": "こういうことは、知る必要がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "小さいし空も飛べるから、偵察にぴったり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "（彼に知らせるべき。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "スダッベ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "いやいや、オイラたち今スダッベのことを話し終えたばかりだろ！たしか、あいつのお兄さんの…カブスだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800130,
					"content": "イッサム。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "違うだろ？イッサムがいなくなった時、オイラたちが一緒に助けたはずだ…たしか、二人目はスダッベのお兄さん、カブスだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800132,
					"content": "チャンチャン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "待て待て、チャンチャンは璃月にいるやつだろ…？チャンチャンとなんの関係があるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800134,
					"content": "#はぁ…大丈夫かよ、{NICKNAME}？たしか、二人目はスダッベのお兄さんで、カブスだったろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800111,
					"content": "カブス。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "スダッベだったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800113,
					"content": "イッサム。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "いやいや、違うだろ！イッサムは最後にいなくなったやつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800115,
					"content": "スダッベだったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800116,
					"content": "ティミー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "ティミー？おいおい、ティミーは関係ないだろ！それに、あいつはモンドにいるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730800118,
					"content": "ティミー？…最初にいなくなったのは、スダッベだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "アルフォンソ"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルフォンソ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "いつから俺を疑い始めた？スダッベとイッサムが俺のことを話したからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800202,
					"content": "#{M#君}{F#あなた}が{M#俺}{F#私}の名前を知ってたから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "#ラナは{M#俺}{F#私}の名前を{M#君}{F#あなた}に言わなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "もしかしたら、俺は耳がいいだけかもしれない。ラナがアマディアおじいさんに君を紹介した時、ちょうど名前を聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800205,
					"content": "アマディアおじいさんにも名前を言ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "…油断したか。だがこのテイワットで、情報の早い組織はファデュイの他にも冒険者協会がある。なぜ俺を冒険者だと思わなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800207,
					"content": "#{M#君}{F#あなた}は{M#俺}{F#私}をよく知ってるようだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "神の目なしでも元素力が使えると知ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "君は各地で冒険しているから有名人だろう。たとえファデュイじゃなくても、知っているはずだ…とにかく、俺がファデュイである証拠を君は持っていないんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800212,
					"content": "そう、でもそれはどうでもいいこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "ああ、君の言う通りだ。「証拠」を重視するのは法律だけ。そして鋭敏な猟犬は、怪しい匂いを追うことで獲物を見つけられることを理解している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800214,
					"content": "もちろん、賢い猟犬は追跡の途中で悪龍に遭遇するのを防ぐため、嗅いではいけない匂いを避けようとする。しかし、君の経歴から見るに、自分の身の安全だけを考える人ではないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800215,
					"content": "ラナにパトロールしないよう警告したのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "ファデュイの行動を邪魔させないため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "…それも理由の一つだ。だがそれより、それが原因で彼女に怪我をしてほしくなかったんだ。他のファデュイは俺と違って、彼女にも、ヴィマラ村にも何の感情を抱いていないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800218,
					"content": "#「アルフォンソ」、{M#君}{F#あなた}は一体何者なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "血縁者に付けられた名は、すでに氷雪の中で失われた。「壁炉の家」から与えられた名は、トロフィン·スネージヴィッチだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800220,
					"content": "壁炉の家のスネージヴィッチ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "…その反応から見るに、君は少し心当たりがあるようだな。俺の「兄弟姉妹」に会ったことがあったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800222,
					"content": "ああ、誰に会ったとか、そいつの状況とかは教えないでくれ。彼らが君に正体を明かしたということは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800223,
					"content": "陛下を裏切ったということなのだろう、もし今も元気であればの話だがな。すでに亡くなっていたら…はぁ、そんな話は聞きたくもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800224,
					"content": "壁炉の家は「召使」様が設立した孤児院だ。壁炉の家で生活している子供たちは全員、血縁者がいない。だが、俺たちにはもっと大切な「兄弟姉妹」がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800225,
					"content": "大きくなると、素質のある子供は特別部隊に入るための訓練を受け、各地に潜伏し命令を待つ。残念ながら、俺は「素質のある子供」と判断された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800226,
					"content": "#{M#君}{F#あなた}が受けた命令は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "「アランナラ」を捕獲することだ。これは「博士」様からの命令だった——アランナラと夢、死域との繋がりを研究するためだそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800228,
					"content": "「夢」と「死域」を兵器化するのは、あの方の研究テーマの一つらしい。もちろん俺も、君に倒されたファデュイも、あの方にとっては「研究資源」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800229,
					"content": "俺たちはアランナラに会うことができない。でもカブス、スダッベ、そしてイッサムたちには…アランナラと友達になる資格がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800230,
					"content": "子供を誘拐して、アランナラを誘い出した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "そうだ。そして、アランナラは本当に現れた。しかし、アランナラの力は本当に不思議なものだな。厳重に警備されたキャンプから、誰にも気づかれず子供を救出するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800232,
					"content": "「博士」様は本当に、すごいものに目をつけたようだ。ハハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800233,
					"content": "#俺からも質問がある、{NICKNAME}。なぜアランナラは、カブスとスダッベが誘拐されたこと、そして助け出された記憶を消したのだ？自分の正体を知られたくなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800234,
					"content": "怖かったことを覚えていてほしくないから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "将来、暴力に頼って欲しくないから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "そうか…あのアランナラ…「アランラナ」といったか？ラナの名前によく似た良い名前だ。機会があれば、「ありがとう」と伝えておいてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800237,
					"content": "どうしてお礼を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "ヴィマラ村は、俺にとって本当に家みたいなところでな。ラナとイッサムは、俺が本来持つべき家族のような存在…カブスとスダッベも、大切な弟と妹だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800239,
					"content": "あいつらには健やかに成長して、真っ当で優しい大人になってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800240,
					"content": "だから、俺の「仕事」を邪魔はしたが、アランラナがしてくれたことには感謝している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800241,
					"content": "…ああ、やっと分かった。君がパイモンを立ち去らせたように、子供たちもこんな暗くて卑しいことを知らないほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800242,
					"content": "「若者よ、幼少期に胸を躍らせ、幸せを感じ、望むことをやって、見たいものを見るがいい。しかし、暗き日々も忘れてはいけない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800243,
					"content": "…これは壁炉の家の教えだ。大人は必ず暗闇に直面する。だから、幼い時から備えておくべきなんだ。そうすれば、自分と大切な人を守ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800244,
					"content": "もしかしたら、君たちのやり方も一理あるかもしれない。俺が壁炉の家で育ち、ヴィマラ村に駐留する特別部隊の一人にならなければ…もし俺がヴィマラ村の生まれだったら、どれほどよかったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800245,
					"content": "そんなことを言っても、何の意味もない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "ああ、分かっている。ただ、残念でならないんだ。「トロフィン·スネージヴィッチ」ではなく、ずっと「アルフォンソ」のままでいたい。俺は、イッサムの本当のお兄さんになりたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800247,
					"content": "しかし善人になりたくとも、俺は組織の人間だ。ラナの家族、子供たちの家族になりたかったが、俺にはすでに裏切ることのできない「家」がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800248,
					"content": "君は多くの仲間を持ち、執行官様に匹敵するほどの実力を持つが、どの都市や国にも属していない。騎士であるものの、自由な栄誉騎士である君には理解できないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800249,
					"content": "理解できるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "#でも、{M#君}{F#あなた}のしたことは許されない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "話したいことは以上だ。さあ、俺をどうするつもりだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800254,
					"content": "#この村に近づかず、{M#俺}{F#私}の前にも現れないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "…そうか、分かった。この先、君の前には現れない。あとファデュイに戻るつもりもない。俺の任務は失敗したからな、「兄弟姉妹」に恥をかかせることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800256,
					"content": "イッサムはずっと、「アルフォンソ」お兄さんの帰りを待つだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800257,
					"content": "もう行って。パイモンが戻ってくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "それじゃあな。いや、永遠にさよならだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800259,
					"content": "（戦闘）考えが変わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#悪者にふさわしい結末が、何なのか分かった…ただ黙って待つつもりはない。たとえ相手が{NICKNAME}で、たとえ俺に勝算がなくとも、俺は全力で戦う。なぜなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800261,
					"content": "俺は善の中の悪、薬の中の毒、子羊の中の狼、黄金の杯にある水銀…俺の名はスネージヴィッチ。さあ、来いッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800262,
					"content": "（戦闘）アランラナとある約束をした…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "悪者を必ず懲らしめるって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#悪者にふさわしい結末が、何なのか分かった…ただ黙って待つつもりはない。たとえ相手が{NICKNAME}で、たとえ俺に勝算がなくとも、俺は全力で戦う。なぜなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800265,
					"content": "俺は善の中の悪、薬の中の毒、子羊の中の狼、黄金の杯にある水銀…俺の名はスネージヴィッチ。さあ、来いッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルフォンソ"
				},
				{
					"id": 730800251,
					"content": "理解できない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800252
					]
				},
				{
					"id": 730800252,
					"content": "#それに、{M#君}{F#あなた}を理解しようとも思わない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800210,
					"content": "#{M#君}{F#あなた}はファデュイの状況に詳しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800211
					]
				},
				{
					"id": 730800211,
					"content": "ファデュイが悪事を働いているなんてことは、この大陸にいる人であれば多かれ少なかれ耳にしたことあるだろう…とにかく、俺がファデュイである証拠を君は持っていないんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "アルフォンソ"
				}
			]
		},
