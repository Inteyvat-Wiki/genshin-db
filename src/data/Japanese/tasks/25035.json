			"trigger": {
				"objectNames": [
					"ミチカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "あのうっかり屋ども、また荷物をいくつか失くしたんだな。配達の時はそんな派手な動きをするなとあれほど言ったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350102,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "「伝達使」の何人かが言いつけを守らずに、客の荷物を失くしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350104,
					"content": "はぁ、それが俺たち「懸木の民」の名誉を傷つける行為だと、あいつらは分からないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350105,
					"content": "配達ならちゃんと配達すればいいし、坂に出くわしたら普通に乗り越えればいいのに、どうして途中でスライドをやり出すんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350106,
					"content": "何度も言ったのに、あの若いやつらは全然聞き耳を持ちやしない。毎日毎日刺激を求めるばっかりで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350107,
					"content": "はぁ、また誰かに頼んで荷物を探さないと。そうだな、誰か時間があるやついるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350108,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "え？手伝ってくれるのか？そりゃ、ありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350110,
					"content": "すぐには手伝ってくれる人が見つかりそうにないし、俺が自分で探しに行くと、「伝達局」の店番をする人がいなくなっちまうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350117,
					"content": "と言っても、当てもなく探させはしないさ。あいつらがいつもどの辺を通るかは知ってるから、荷物を失くした場所もなんとなく見当がつく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350118,
					"content": "おおよその紛失した地点をマップにマークしておくから、後は頼んだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350111,
					"content": "荷物って、大きい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "いや、全然。むしろ大きくないから、毎回探すのに手間取るんだ。はぁ、あのうっかり屋たちめ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350113,
					"content": "…時間があるんだったら、荷物を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350114,
					"content": "今、うちの人手が足りてないんだ。俺が自分で探しに行くと、店を空けることになっちまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350115,
					"content": "分かった。手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "いいのか！？本当に助かるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "ミチカ"
				}
			]
		},
