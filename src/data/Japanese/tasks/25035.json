			"dialogs": [
				{
					"id": 250350801,
					"content": "二個…三個…これで全部だ。良かった、荷物はこれで全部取り戻せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350802,
					"content": "…待てよ、この荷物はトゥンダマが担当してたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350803,
					"content": "これ、今回の報酬だ。手伝ってくれてありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "ミチカ"
				},
				{
					"id": 250350804,
					"content": "ふぅ…どうやらトゥンダマと少しお話しないといけないみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミチカ"
				}
			]
