						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "ふぅ…い、生きてる…！よかった…この地に足のついた感じ、安心するぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360102,
					"content": "パイモンはずっと浮いてるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "そうはいっても、地面の近くで浮いてるのと、空で飛ばされまくるのは大違いだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360104,
					"content": "ここもあんまり頑丈には見えないけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#ええっ？脅かすなよ。落っこちても、オイラ一人じゃおまえと{REALNAME[ID(2)|SHOWHOST(true)]}を助けきれないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360106,
					"content": "チチ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "「ココウィク」"
				},
				{
					"id": 751360107,
					"content": "あれが天蛇の船か？やったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360108,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "船っていうより、でっかい環っかにしか見えないぞ！うねうねしてて、蛇っぽいとも言えなくはないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360110,
					"content": "なんとかしてあそこに行こうぜ。少なくともこっちよりは安全そうだし…うぅ、でもポーナはどこに飛ばされたんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360111,
					"content": "飛行経験は豊富だって言ってたけど、それでもちょっと心配だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360112,
					"content": "風向きから考えると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "うーん、確かに…風向きで考えたら、きっとこの近くに落ちてるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360114,
					"content": "ここでじっとしてても仕方ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "うーん、確かに。ここで思い悩んでもしょうがないよな。もしかしたら、もう天蛇の船でオイラたちを待ってるかもしれないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360116,
					"content": "それじゃ行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
