			"dialogs": [
				{
					"id": 751360401,
					"content": "はぁ、せっかく天蛇の船に着いたっていうのに、また石を探さなきゃいけないなんて。もっとスリリングな冒険になるかと思ったのにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751360402,
					"content": "とにかく、炎石探しは君たちに任せたよ。何かあったら、いつでも声をかけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ポーナ"
				}
			]
