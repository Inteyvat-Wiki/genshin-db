			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "おおっ、できたぞ！でも、なんでまた「光の刻印」が出てきたんだ？これが伝説の「返還の玉」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360502,
					"content": "待てよ、よく見たら、これって「通牒の金盤」じゃないか！前に手に入れたやつとそっくりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360503,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "なるほど、そうだったんだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "アビスを封印する秘宝と、呪いや災厄を祓う象徴物——確かに似てるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360506,
					"content": "今さら気づいたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "なんだよ、気付いてたんなら、早く教えてくれよな！って、おまえはなんで気づいたんだ？まさかおまえまで「冒険者の経験」とか言わないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360508,
					"content": "アビスを封印する秘宝と、呪いや災厄を祓う象徴物——確かに似てるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360509,
					"content": "でもこんなもので、本当にオシカ・ナタのアビスの穢れを抑えられるのか？龍の遺物研究会の人もそんなこと言ってなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360510,
					"content": "「返還の玉」が「通牒の金盤」だったってことは、まさかあの悪龍がオイラたちを狙ったのって、これが理由だったのか？",
					"roleType": "TALK_ROLE_NPC",
