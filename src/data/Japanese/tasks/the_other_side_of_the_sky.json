			"dialogs": [
				{
					"id": 751360201,
					"content": "これはなんだ？見た目は炎燐石に似てるけど、光ってるし燃えてるぞ。ポーナのよりすごいみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360202,
					"content": "もしかして、これが炎燐石の本来の姿なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360203,
					"content": "熱っ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#{NICKNAME}！なにか見つけるたびに手を出すの、やめろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360205,
					"content": "ごめん、つい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "パイモンに言われたくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#ん？{REALNAME[ID(2)|SHOWHOST(true)]}はなにかわかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360209,
					"content": "#おおっ、すごいぞ、{REALNAME[ID(2)|SHOWHOST(true)]}。おまえはここで大活躍できるかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360210,
					"content": "#次になにか熱いお宝があったら、{REALNAME[ID(2)|SHOWHOST(true)]}に任せたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360211,
					"content": "クルルッ、キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "やっほー！こっちこっち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "ポーナ"
				},
				{
					"id": 751360213,
					"content": "おおっ、ポーナじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751360214,
					"content": "でも、なんであんな場所に？落っこちたのかな…とにかく合流しようぜ！",
