				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "（<color=#FFCC33FF>フリンズ</color>は飴細工に興味があるのかも？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "ウナーヤタさん、もしよければ僕にも飴細工を一つ作っていただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760380402,
					"content": "あなたは…ライトキーパーのフリンズさんだったわね。以前、お店で見かけたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380403,
					"content": "ええ、たまに物資の仕入れに来るんです。覚えていただけているとは、光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760380404,
					"content": "今日はたまたまここを通ったのですが、あなたの素晴らしい飴細工の技を拝見しまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760380405,
					"content": "色々考えたのですが、やはり一つ作っていただきたいと思ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760380406,
					"content": "いや、そんな、かしこまらないでよ。恥ずかしくなっちゃうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380407,
					"content": "それじゃ、今から作るから、ちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380408,
