			"dialogs": [
				{
					"id": 760380201,
					"content": "飴細工を一つ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "どうぞ。開けたら早めに食べてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナーヤタ"
