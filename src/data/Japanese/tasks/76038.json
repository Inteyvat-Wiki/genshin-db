			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウナーヤタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "（<color=#FFCC33FF>ネフェル</color>は飴細工に興味があるかも？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "飴細工を一つもらえるかい、ウナーヤタ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760380103,
					"content": "ネフェルさん、わざわざ買いにきてくれたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380104,
					"content": "心と体のために、たまには散歩もいいかと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760380105,
					"content": "甘いものを食べれば、頭を使う作業も捗る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760380106,
					"content": "すてき！今作るからちょっと待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380107,
					"content": "このお金をとっといてくれないかい。次ヤフォダが来た時に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760380108,
					"content": "ヤフォダにもっと大きいのを作ればいい？それとももっと甘め？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380109,
					"content": "いや、この金を渡してやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 760380110,
					"content": "あたしは二倍の金額を置いていった——散々サボって気が済んだら、あたしにも飴細工を一つ持ち帰るようにって伝えといておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				}
			]
		},
