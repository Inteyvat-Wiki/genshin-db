			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウナーヤタ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "（<color=#FFCC33FF>ラウマ</color>は飴細工に興味があるのかも？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "ウナーヤタさん、私にもいくつか飴細工を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760380302,
					"content": "もちろんよ、ラウマさん。この前ラウマさんが持ち帰った飴細工、子供たちは気に入ってくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380303,
					"content": "ふふっ。皆、とても気に入って、食べるのが惜しいと言っておった。飴が溶ける直前まで手に持ち、ゆっくり味わって食べていた子もいたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760380304,
					"content": "そう…よし、じゃあ次は道具を持って、そっちに行くわ。その場で子供たちに作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380305,
					"content": "それは素晴らしい。子供たちもきっと喜ぶであろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 760380306,
					"content": "あ、話が逸れちゃったわね…飴細工はあとで作っておくわ。完成したら、人に頼んでそちらに届けてもらうようにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380307,
					"content": "でもその前に…ふふっ、実は今、いいこと思いついたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380308,
					"content": "ラウマさん、ちょっと待ってて。今すぐスペシャルな飴細工を作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナーヤタ"
				}
			]
		},
