				{
					"id": 760380508,
					"content": "（<color=#FFCC33FF>アイノ</color>は飴細工に興味があるのかも？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "店長！アイノにも飴細工ちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760380502,
					"content": "久しぶりね、アイノさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380503,
					"content": "へへっ、今日は町で修理の手伝いがあったから、いっしょに飴細工も買いに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760380504,
					"content": "はやくはやく！イネファがいないうちに、多めに作って…それか、もっと甘くして！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760380505,
					"content": "それは構わないけど…食べ終わったら、ちゃんと歯を磨くんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380506,
					"content": "わかってるって。アイノ、飴を食べた後は必ず歯磨きしてるから、歯がすごく丈夫なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 760380507,
					"content": "あはは…それじゃ、少し待っててね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナーヤタ"
				}
			]
