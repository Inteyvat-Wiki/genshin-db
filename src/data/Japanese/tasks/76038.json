			"dialogs": [
				{
					"id": 760381109,
					"content": "（<color=#FFCC33FF>リンネア</color>は飴細工に興味があるかも？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "リンネアさん、またルミのため？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381102,
					"content": "はい、ルミはここの飴細工が大好きなんです。食べるのももったいないみたいで、ほんのちょっとずつしか舐めないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 760381103,
					"content": "でも、何回か舐めるうちに溶けちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 760381104,
					"content": "ウナーヤタさん、ルミのために飴細工をもう一つ作ってもらえませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "リンネア"
				},
				{
					"id": 760381105,
					"content": "はーい！ちょっと待っててね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381106,
					"content": "（きゃ～、ルミちゃん、超可愛い！なでなでしたい～！でも、勝手に触ってもいいのかな？いや、やっぱり失礼だよね…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381107,
					"content": "はい、どうぞ、リンネアさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381108,
					"content": "ありがとうございます！ルミ、飴細工だよ。食べ…あれ、寝ちゃったの？じゃあ、あとであげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リンネア"
				}
			]
