				{
					"id": 760381005,
					"content": "でも、ライトキーパーって本当に忙しいんだね…飴細工を食べきれないこともあるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381006,
					"content": "あはは、任務で忙しいというよりは…助けが必要な人を見かけて手伝いに行ったりするので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760381007,
					"content": "食べかけの飴細工って保存しづらいので、包みにくるんでポケットに入れるくらいしかできないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760381008,
					"content": "でも、用事が終わって取り出す頃には、完全に溶けてしまいそうですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760381009,
					"content": "うーん…小さな飴細工ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381010,
					"content": "そうだ、小さな飴細工でもいろんな味を入れられるはず！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381011,
					"content": "一番下はこの味で…この味を上に重ねて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381012,
					"content": "できたよ、「いろんな味の小さな飴細工」！これで要望通りかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381013,
					"content": "はい！ありがとうございます、ウナーヤタさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760381014,
					"content": "ううん、気にしないで。ライトキーパーのお手伝いはできないけど…飴細工なら、いくらでも作れるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760381015,
					"content": "これが僕たちの仕事ですから。では、失礼します——まだ任務があるので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760381016,
					"content": "気をつけてね。飴細工が食べたくなったら、いつでも来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナーヤタ"
				}
			]
		},
