						760380703
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760380703,
					"content": "ヤフォダ、常連なんだから、私の飴細工のサイズは決まってるって知ってるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380704,
					"content": "そんなこと言わないでさ、今日は良いことがあったんだよ！だから、ね？大きめに作ってよ、はやくはやく！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760380705,
					"content": "良いことって？依頼がうまくいった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380706,
					"content": "へへへ、そうなんだ。超簡単な護衛任務、楽勝だったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760380707,
					"content": "荷物も依頼主も、傷一つなく無事完遂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760380708,
					"content": "とにかく早く大きめのを作ってよ。帰ったら食べるからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "ヤフォダ"
				},
				{
					"id": 760380709,
					"content": "もう、しょうがないなあ。ちょっと待っててね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナーヤタ"
