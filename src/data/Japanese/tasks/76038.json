						760380911
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380911,
					"content": "（そうそう！こういうふわふわしたのがいいって思ったんだよね。この子の雰囲気にぴったり！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380912,
					"content": "うん、これも美味しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760380913,
					"content": "あと二つもらってもいい？持ち帰って、月霊たちにも食べてさせてあげたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760380914,
					"content": "げ…月霊？構わないけど、今は材料が足りなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "ウナーヤタ"
				},
				{
					"id": 760380915,
					"content": "じゃあ明日また来るね。月霊たちも連れてくるから。",
