			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"笠っち"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "僕らには、それぞれ進むべき道があるということだ——多くを語る必要はないだろう。なかなか美味しいお茶だったよ、ごちそうさま。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "笠っち"
				},
				{
					"id": 733560202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 733560204,
					"content": "ああ、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "笠っち"
				},
				{
					"id": 733560203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
}