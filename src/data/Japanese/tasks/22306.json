			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"張順"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060101,
					"content": "どうしたもんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060102
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060103
					]
				},
				{
					"id": 223060103,
					"content": "俺は南十字船隊の船員だったが、運悪く怪我をしてしまってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060104
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060104,
					"content": "船隊を辞めた後、生活に必要な金を作るために、博来という名前の商人に数枚の宝蔵図を抵当に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060105
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060105,
					"content": "本当に宝物があったら、俺の分を残してくれると約束してくれたが、いつになってもそういう情報がなくて、彼は探してないんじゃないかと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060106
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060106,
					"content": "このままだとどうにもならないから、すまないが、宝物を探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060109,
						223060116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060108
					]
				},
				{
					"id": 223060108,
					"content": "じゃあ頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060120,
					"content": "まずは<color=#00E1FFFF>博来</color>から<color=#00E1FFFF>宝蔵図</color>をもらって、<color=#00E1FFFF>宝物</color>を直接<color=#00E1FFFF>彼</color>に持っていってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060121
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060121,
					"content": "彼とはもう話を通してある。俺の分は残してくれてるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "張順"
				},
				{
					"id": 223060109,
					"content": "どうして船隊を辞めた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060110
					]
				},
				{
					"id": 223060110,
					"content": "自分の体は自分が一番知っている。いつ再発するか分からない古傷のせいで船隊に迷惑をかけたくないから、自分で辞めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060111
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060111,
					"content": "その後、溜めた金で事業を展開しようとしたが、なかなかうまく行かなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060112
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060112,
					"content": "俺が持ってた宝蔵図も、前に船隊と一緒に出航した時に手に入れた戦利品なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060113
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060113,
					"content": "しかし俺の体は歩くだけで精一杯だというのに、探検なんてとても考えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060114
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060114,
					"content": "生活に必要な金を作るために、俺は博来という名前の商人に数枚の宝蔵図を抵当に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060115
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060115,
					"content": "でも彼も探検に行けそうにないと思う。なにせ彼は普通の商人だからな…だから、宝探しの件はお前に頼みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060116,
					"content": "豪華な宝物があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060117
					]
				},
				{
					"id": 223060117,
					"content": "ハハハッ、それはないと思うぞ。宝蔵図は船隊に配られた戦利品だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060118
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060118,
					"content": "本当に豪華な宝物があったら、配る前に船隊の者が謎を解いて宝物を持って帰っただろうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060119
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223060119,
					"content": "でも、豪華な宝物じゃなくても、多少金にはなるはずだ。少なくとも三人で分けるには十分だ…だから、宝探しの件は頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "張順"
				}
			]
		},
