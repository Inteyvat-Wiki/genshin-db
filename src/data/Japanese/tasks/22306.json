			"dialogs": [
				{
					"id": 223060201,
					"content": "やあ、なんか見ていかない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060202
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060202,
					"content": "宝蔵図の件。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060203
					]
				},
				{
					"id": 223060203,
					"content": "宝蔵図？ああ…張順が抵当に入れたあれのことかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060204
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060204,
					"content": "君、まさか本当に宝物があると信じてる…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060205
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060205,
					"content": "まあ、君は宝物という単語を聞けば目が輝くような根っからの冒険者だろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060206
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060206,
					"content": "宝蔵図を私が持っても意味がないし、君にあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060207
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060207,
					"content": "でも本当に宝物を見つけたら、私の分も忘れないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060208
					],
					"speakerTitle": "博来"
				},
				{
					"id": 223060208,
					"content": "なにせこの宝蔵図はこっちに長い間置いてたからね、保管料くらい取っても普通だと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博来"
				}
			]
		},
