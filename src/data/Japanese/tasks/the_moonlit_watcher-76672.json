					}
				]
			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "ホワイトベリークルムカケに、燻製フィッシュステーキ…ベリーとお肉のソテーに、夜廻りのスープまで…こんなにご馳走が並んでたら、食べきれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766720203,
					"content": "うーん…ライトキーパーたちの夕食と同じ量を用意したので、三人で食べるには少し多すぎたかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720204,
					"content": "まあ大丈夫です、ゆっくり食べていてください。僕は義父さんのところへ少し顔を出してきますので。夜までここにいらしてもらっても構いませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720205,
					"content": "こんなに料理が上手だったなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "実は、隊長になる前はよくみんなの食事を作っていたんです。ただ、最近はそういった時間がなかなか取れなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720209,
					"content": "ピラミダには、本当に色々な場所から人が来ていて、食の好みもそれぞれ違います。ですから、どんな味付けの料理も一通り作れないと、みんなに楽しんでもらえないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720210,
					"content": "今回はお二人の好みがあまり分からなかったので、色々なスタイルのものを作ってみました。どれかお口に合うものはありましたか？ぜひ教えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720211,
					"content": "#パイモンが好きなものは、{M#俺}{F#私}も好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "なんだよ、それ！言っとくけど、あのベリーとお肉のソテーはオイラが先に目をつけたんだからな！横取りするなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766720213,
					"content": "あはは、ご心配なく。足らなければ、もっと作りますから。僕の大事な隊員を空腹にはしておけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720216,
					"content": "口で何と言おうと、好きなものを食べた時の幸せそうな表情は、嘘をつきませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720217,
					"content": "みんなの幸せそうな笑顔を見ること以上に、嬉しいことなんてありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720218,
					"content": "もしみんなを笑顔にできるなら、ライトキーパーとしての責務を果たすことも、美味しい料理を振る舞うことも、僕は喜んで引き受けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720219,
					"content": "お二人からすると些細なことかもしれませんが、これが僕の偽りなき願いです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720220,
					"content": "そんな風に自分を卑下しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "そうだぞ！みんなのために、こんなに色々やってきたんだ。絶対みんな感謝してるって！おまえが自分のことを悪く言ってばかりいたら、逆に怒るかもしれないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766720223,
					"content": "少なくとも、オイラと旅人が怒るからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766720224,
					"content": "あはは、ありがとうございます。さて、食事と関係のない話はここまでにしましょう。どうぞ料理を召し上がってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720221,
					"content": "ここまでできるなんて十分すごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "イルーガの手料理なら何でも好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "お世辞なんて言う必要ありませんよ。ですがそう言ってもらえると、もっと君の口に合う料理を作りたくなりますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 766720206,
					"content": "パイモンなら食べきれる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "もちろんだぞ！せっかく作ってくれたんだから、ちゃんと全部食べなくっちゃな！それにしても、イルーガがこんなに料理上手だったなんて、びっくりだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}