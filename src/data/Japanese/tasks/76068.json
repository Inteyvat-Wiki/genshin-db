			"dialogs": [
				{
					"id": 760680101,
					"content": "どうやら、姉さまも「人」としての姿を選び終えたようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680102,
					"content": "ふふっ、あなたの姿も私の予想通りよ、カノン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680103,
					"content": "でも、あなたがあの愛らしく小さな生命たちのために、自ら進んでそのような姿を創り出すなんて、思いもしなかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680104,
					"content": "当然のことだよ、姉さま。あのか弱い命たちが私を信じ、呼ぶのなら、私は彼らの声に応えるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680105,
					"content": "私たちは世界を維持するために生まれた。「人」という名の生命が私たちの世界に住まうことを望むのなら、彼らの願いに耳を傾けることもまた、王が私たちに与えた使命だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680106,
					"content": "ええ、王も言っていたものね。星の海に生きるすべての命は、私たちと共に漆黒に立ち向かう盟友なのだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680107,
					"content": "でも、私が言いたいのはそういうことじゃないの。ただ、「霜月」にこんなにも感情豊かな一面があるなんて思わなかったから。今のあなた、とても可愛いわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680109,
					"content": "…姉さまの言葉遣いも、あの小さな人間たちに影響され始めているようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680110,
					"content": "彼らの言葉はいつもそんなふうに曖昧なんだ…なるべく使わないでほしい。姉さまの言う「可愛い」が何を表現したいのか、私にはまったく理解できないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680111,
					"content": "もう、そんなことどうでもいいじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680112,
					"content": "アリア姉さまもカノン姉さまも、せっかく人としての姿を作ったんだよ！まずすべきなのはここをこっそり抜け出して、地上の人たちと一緒に遊ぶことでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680113,
					"content": "じゃなきゃ、作った意味がなくなっちゃうよ！ほら、早く早く、誰かに見つからないうちに——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680114,
					"content": "ふふっ、私たちの可愛い妹はもう待ちきれないようね、カノン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680115,
					"content": "彼らが地上に文明を築き始めたばかりの頃は、「あんなよそ者たちは信用ならないよ。もちろん、その創造物もね」と言って、見向きもしなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680116,
					"content": "そ、それとこれとは話が別だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680117,
					"content": "今でもあのよそ者たちを中に入れるべきじゃなかったって思ってるけど、地上の人たちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680118,
					"content": "はぁ…ソネットが楽しければそれでいい。行っておいで。しっかり、姉さまについて行くんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680119,
					"content": "え？カノン姉さまは行かないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680120,
					"content": "あの降臨者の従者が、私に話があるらしくてね。なんでも、この世界の重力ポテンシャルと計量テ{RUBY#[D]時間の規則}ンソルについて、だそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680121,
					"content": "イスタロトが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680122,
					"content": "たしか、そんな名前だったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680123,
					"content": "人の名前はちゃんと覚えないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680124,
					"content": "でも、私の気のせいかもしれないけど、彼女はあの降臨者に対して、なんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680125,
					"content": "大丈夫。早まった判断はしないよ、姉さま。でも、気には留めておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "カノン"
				},
				{
					"id": 760680126,
					"content": "ええ、それならいいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "ソネット"
				},
				{
					"id": 760680128,
					"content": "ふふ、何でもないわ。じゃあ、私たちは先に行くわね、カノン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680129,
					"content": "安心して、お土産はちゃんと買ってきてあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "アリア"
				},
				{
					"id": 760680130,
					"content": "…お土産はなくてもいいよ。正体が誰にも知られないよう気をつけてくれれば、それで十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノン"
				}
			]
		}
	]
}