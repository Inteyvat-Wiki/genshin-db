					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "私は絶対に！絶対に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290102,
					"content": "おや？あなたは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の依頼を受けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "あの依頼のことですか。そうです、私がお願いしました。武芸の練習相手を探しているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290105,
					"content": "私の依頼を受け取って下さったのですか？しかし、あなたとお会いしたことはないような気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290106,
					"content": "失礼しました、実力を疑っているのではありません。ですが、あなたの武芸がどれほどのものなのか、把握できていないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290107,
					"content": "巨龍を倒したことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "ははは…本当ですか？巨龍を倒した場所の方が気になりますね。何せ、巨龍など噂でしか聞いたことがありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290112,
					"content": "戦いも得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "はは、武芸みたいなことは、口だけではなく、実戦で確認しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290114,
					"content": "望むところだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "どうして匿名で依頼を出したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "そ、それには…あまり大声で言えない理由がありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290117,
					"content": "コホン、しかし依頼を受けてくれたあなたには本当のことを言いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290118,
					"content": "つい先日、何名かの同心と共に任務に出かけていたのですが、その帰り道で突然、商人の集団を襲撃しようとしている海乱鬼を発見しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290119,
					"content": "他の同心とともに商人を助けに向かいました。最初は我々が優勢で、海乱鬼たちはすぐに去っていきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290120,
					"content": "しかし、休憩していた時、横から突然頭領らしき人物が率いる海乱鬼が現れたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290121,
					"content": "私たちは反応し切れず、不意を突かれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290122,
					"content": "勝機を失った私たちは、海乱鬼の攻撃を防ぎながら、商人たちを町へと逃がすことしか出来なかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290123,
					"content": "そして、海乱鬼の頭領と戦うときに…武器を奪われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290124,
					"content": "そいつはその武器を手にし、高く持ち上げ、私に向けて大笑いしました。何という屈辱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290125,
					"content": "商人たちはどうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "私たちが撤退している最中、幸いにも見回り中の同心に会い、それを見た海乱鬼たちが逃げていったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290127,
					"content": "商人たちは無事町へと護送しましたが、彼らの荷物は全て…はぁ、私が弱かったせいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290128,
					"content": "戻った後、武器を支給されました。しかし、その事をまだ無念に思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290129,
					"content": "だからこそ、武芸を磨くために、その依頼を出したのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290130,
					"content": "十分に強くなって、自分の手であの海乱鬼を倒し武器を奪い返す。以前の屈辱を晴らすのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290109,
					"content": "神の死を見届けたことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "え？それは璃月の「迎仙儀式」を見たっていうことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290111,
					"content": "ははっ、そんなことなら、大勢の璃月人も「神の死を見届けた」ことがあると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
