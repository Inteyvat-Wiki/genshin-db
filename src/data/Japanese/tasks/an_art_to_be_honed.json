			"dialogs": [
				{
					"id": 220290201,
					"content": "先ほどは手加減したのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290202,
					"content": "気にせず掛かってきてください。強くなるためなので、手加減は必要ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
