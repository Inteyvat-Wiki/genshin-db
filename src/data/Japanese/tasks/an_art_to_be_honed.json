			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "はぁ…はぁ…あなたの腕は、確かなものです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290302,
					"content": "ま…参りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290303,
					"content": "だ、大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "だ…大丈夫。少し呼吸を整えさせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290306,
					"content": "あなたほどの強さであれば、巨大な龍を倒したという話も嘘ではなさそうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290307,
					"content": "巨大な龍を倒したのは本当だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "はははっ…もちろん信じます。私と手合わせしてくれてありがとうございます。この試合は、ちゃんと心に刻んでおきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290309,
					"content": "よろしければ、今後も練習に付き合ってください。あなたほどの強者に鍛えられれば…私の無念も必ず晴らせます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290310,
					"content": "無念？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "コホン…気にしないでください。これは今回のお礼です、受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290312,
					"content": "私は戻って休まなければいけません。あ…あなたの技と力は凄まじかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220290304,
					"content": "ごめん、少しやりすぎた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
