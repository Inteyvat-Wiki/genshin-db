			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "旅人さん、ちょうどいい時にいらっしゃいましたね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310102,
					"content": "聞き覚えのある展開だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310103,
					"content": "次の言葉はきっと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "さすが熟練の冒険者ですね。おっしゃる通り、旅人さんにぴったりな依頼があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310106,
					"content": "万端珊瑚探偵所からあなたに、「動物集団失踪事件」を調査してほしいとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310107,
					"content": "えっ？動物を探すだけでいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310108,
					"content": "#ふふん、そんな簡単なこと、本当に{NICKNAME}がやる必要あるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310109,
					"content": "出前を送ったこともあるから大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "でも、「万端珊瑚」って事件を解決する探偵所だろ？なんで逆に冒険者に依頼してるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310114,
					"content": "どうやら珊瑚さんは、龍二さんと一緒に行動してくださる経験豊富な冒険者を必要としているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310115,
					"content": "それと…珊瑚さんからこのように言われています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310116,
					"content": "「今回の事件では、多くの方々のペットが行方不明になり、弊社に莫大な量の依頼が舞い込んできた。もし解決できれば、豊富な報酬を用意する」とのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310117,
					"content": "#豊富な報酬…！そ、そうだったのか。{NICKNAME}、オイラ…主人のもとに帰れないペットのこと、すごくかわいそうだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310118,
					"content": "それにどんな依頼だろうと、きっとなにか経験を得られるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310119,
					"content": "パイモンは分かりやすいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "とにかく、珊瑚たちのところに行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310110,
					"content": "車を直したこともあるから大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "風魔龍を倒したこともあるから大丈夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "風魔龍撃退はあなたにとって「簡単なこと」なのですか…？さすがです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 400310104,
					"content": "新しい依頼があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚",
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "予想していたよりも早く来たわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310203,
					"content": "もちろんだ！豊富な報…動物の失踪事件って聞いたから、居ても立っても居られなかったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310204,
					"content": "#それで、なにが起きたんだ？オイラと{NICKNAME}がいれば、どんなことだって解決できるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310205,
					"content": "仕事をするのはこっちなんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "オイラも頑張っておまえのこと応援するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310207,
					"content": "元気ね。それじゃ、事件の説明をするね。ここ数日、突如たくさんの依頼が舞い込んできたの。どれも失踪した動物を探してほしいという内容だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310208,
					"content": "それらの動物はほとんどがペットで、自分からいなくなることはありえないはずなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310209,
					"content": "確かに稲妻には不思議な力に関する物語があるけど、すべての事象に原因と結果があるように、論理で解決できない謎はない。ここ数日の現地調査でも、このことは証明されているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310210,
					"content": "仕事をしているのは私なんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310211,
					"content": "パイモンが頑張って応援してくれるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "ん…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310213,
					"content": "…ありがとうございます、お構いなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310214,
					"content": "ここ数日、失踪した動物の痕跡を辿って、いくつか野外の拠点を見つけました。中には魔物が駐在しているものもありましたが、大きな問題はありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310215,
					"content": "しかし、その中の一つの拠点において、閉じ込められた動物を解放しようとした時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310216,
					"content": "「突如現れた黒い影によって邪魔された」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310217,
					"content": "私が目を覚ました時、拠点には何もありませんでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310218,
					"content": "無様ね、龍二。「三本刀金八」事件で、伝説の悪鬼虎千代のように叫びながら犯人を倒した気勢はどこに行ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310219,
					"content": "死んだふりをしていた私を抱えて、叫びながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310220,
					"content": "所長、それ以上は！どうか言わないでください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310221,
					"content": "そ、その続きは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310222,
					"content": "まずは今ある事件に集中しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "とにかく、私たち「万端珊瑚」は、君たちのような経験豊富な冒険者が必要なの。一緒に動物を救うためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310228,
					"content": "君たちがいれば、龍二が気絶しても、なんとか対応できるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310229,
					"content": "でも、なんで自分で行かないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310230,
					"content": "私？私は頭脳派だから、やるのは頭を使うことだけ。私にとって、身体はただの付属品よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310231,
					"content": "（うわっ、怠けを正当化してるぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310232,
					"content": "もちろんただ働きはさせないわ。報酬はきちんと払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310233,
					"content": "報酬！！じゃあ今すぐ出発しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310234,
					"content": "まったくパイモンは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "ちょっと待って。行く前にこれを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310237,
					"content": "ん？なんだこれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>「四方の網」</color>。友人に作ってもらった便利な道具で、書籍に記載されている「惟神陰陽術」を参考にしたものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310239,
					"content": "犯罪者を取り押さえるほどの力はないけど、動物くらいは余裕で捕獲できる…たぶん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310240,
					"content": "これがあれば、失踪した動物を簡単に連れ戻せると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310241,
					"content": "おう！これがあれば楽勝だ！珊瑚所長って気が利くな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310242,
					"content": "褒めなくてもいいわよ。私はただ君たちが失敗するのを見たくないだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310243,
					"content": "それと龍二、君も一緒に同行しなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310244,
					"content": "分かりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310245,
					"content": "ここ数日、新たに失踪した動物の痕跡を発見しました。私について来てください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310246,
					"content": "それじゃ出発しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "ええ。いってらっしゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310247,
					"content": "ありがとう、珊瑚所長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "パイモンは行動力が凄い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "続きは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "あら、私たちが過去に解決した事件に興味があるの？当時はね、こういう経緯だったの。普段は愛想のいい捕り手の金八が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310225,
					"content": "ま、まずは今ある事件を解決しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310226,
					"content": "そうね、悪かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 4003103,
			"completionStepIds": [
