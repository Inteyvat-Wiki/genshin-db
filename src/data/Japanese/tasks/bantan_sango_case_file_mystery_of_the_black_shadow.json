			},
			"dialogs": [
				{
					"id": 400310501,
					"content": "素晴らしい！その身のこなし、実に頼りがいがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310502,
					"content": "#ふふん、{NICKNAME}はすごいんだ。これくらい楽勝だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310503,
					"content": "それでは、次の目標へ向かいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310504,
					"content": "えっ？まだあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310505,
					"content": "もちろんです。珊瑚所長が引き受けた依頼の数から見て、稲妻史上最大の動物失踪事件ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310506,
					"content": "とは言っても…通常このように多数の動物が同時に失踪するなどありえません。この事件は、どう考えても異常です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310507,
					"content": "以前、痕跡を辿って他の場所に行ってみたら、そこでも動物が捕まっていたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310508,
					"content": "まだ「隠密行動」は必要？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "今回はもう大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310510,
					"content": "ご心配なく、あなたの実力があれば、何の問題もありません。着いたら分かりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 4003108,
