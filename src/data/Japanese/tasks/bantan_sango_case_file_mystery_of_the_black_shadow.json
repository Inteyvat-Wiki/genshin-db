			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "本当に助かりました、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310802,
					"content": "#だから言っただろ、{NICKNAME}はすごいって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310803,
					"content": "動物の数が合ってるかどうか、はやく確かめようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310804,
					"content": "これは…数が足りません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310805,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310806,
					"content": "しかし、収穫がなかったわけではありません。少なくとも今回は「黒い影」にやられることなく、動物も多数見つけることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310807,
					"content": "これで、事件調査が滞ることは回避できました。ただ、今のところ他に手がかりがないのが残念ですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310808,
					"content": "私はこのまま調査を続けます。あなた方は他の用事でもしておいてください。何か進展があったら、また万端珊瑚探偵所で会いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310809,
					"content": "おう、そうするしかないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
