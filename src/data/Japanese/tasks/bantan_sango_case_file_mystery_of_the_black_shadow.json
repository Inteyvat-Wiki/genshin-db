					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315102,
					"content": "「四方の網」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "それはね…元々は龍二に使わせるものだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315104,
					"content": "私たちの仕事は決して危険がないわけじゃない。龍二はこれまで何度も怪我をしてきたから、「遠くからでも犯人を制圧できる」便利な小道具が欲しかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315105,
					"content": "だから、古い書籍をたくさん調べて、この網を設計して友人に作ってもらったってわけ。でも結果的には、動物を捕える程度の力しかなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315106,
					"content": "何はともあれ、その道具が君の手によって力を発揮できるのはいいことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315107,
					"content": "「三本刀金八」事件について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "あの事件に興味があるの？それはね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315109,
					"content": "いや…龍二は当時のことについて語りたくないみたいだから、やめておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400315110,
					"content": "もう行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "ええ。いってらっしゃい。",
