					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "これまでの調査によれば、場所はこちらになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310302,
					"content": "たしかに動物がたくさんいるな。みんな失踪した動物なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310303,
					"content": "でもあれって…犬…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310304,
					"content": "ここを守ってたのって、犬だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310305,
					"content": "なるほど、そういうことだったんですね。お恥ずかしい限りです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310306,
					"content": "ん？龍二、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310307,
					"content": "…あの時、私を一瞬で倒した「黒い影」は、あの犬だったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310308,
					"content": "相手が強かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "いえ、慰めなくて結構…私が弱すぎたんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310312,
					"content": "何はともあれ、あの直立した姿勢と…高慢な感じ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310313,
					"content": "似てるやつのことを思い出したぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310314,
					"content": "木漏茶屋の…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "そう、太郎丸だ！オイラもそいつのことが頭に浮かんだぞ。最初は本当に言葉がしゃべれるのかと思ったけど、結局しゃべれなくて残念だったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310317,
					"content": "木漏茶屋の店主のことでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310318,
					"content": "あれ？龍二も知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310319,
					"content": "うわさを聞いたことがあるだけです。確かに少し似ていますが、油断してはいけません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310320,
					"content": "太郎丸は人間社会とも接点が多く、皆さんに優しい。しかしこの犬については、まだ詳細が分かっていません。気をつけたほうがいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310321,
					"content": "そうだな。すごく合理的な判断だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310322,
					"content": "調査で培ってきた経験に過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310323,
					"content": "でも…どうして犬が他の動物を集めて見張ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400310324,
					"content": "それを知るには、より多くの手がかりを探す必要があります。飼い主たちが非常に焦っている今、当面は動物の救出が最優先でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310325,
					"content": "#ここからは{NICKNAME}さんにお任せします。動物を見つけた後のことは、私にお任せください。一刻も早く家に送り届けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310326,
					"content": "一緒に行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "あれは一緒に行けばなんとかなるような相手ではないですし、正確な強さもまだはっきりしていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310328,
					"content": "ところで、今までに「隠密行動」をした経験はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310329,
					"content": "「天空のライアー」を盗んだことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "実に不思議な経験ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310333,
					"content": "とにかく、その犬を避ければ、動物たちを救出することができるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310334,
					"content": "事前に注意を引けるようなものを用意しました。お役に立てるといいのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310335,
					"content": "では、頼みましたよ。私はここで待っていますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310330,
					"content": "迎仙儀式で追手から逃げたことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "離島で汚職官僚を追跡したことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "太郎丸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "龍二弱い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "そんなこと言うなよ！きっと相手が強すぎたんだ。オイラでもきっと勝てなかったと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
