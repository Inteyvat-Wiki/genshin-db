			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"新之丞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340201,
					"content": "くそっ！退くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340202
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340202,
					"content": "早く、旦那様にこのことを伝えないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340203
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340203,
					"content": "オイ、逃がすかっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340204,
					"content": "追わなくて結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340205
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340205,
					"content": "魚を釣るには餌が必要です。放っておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340206
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340206,
					"content": "それよりも、彼らは先ほどの戦いで鍵を落としていました。まずは、新之丞を救出します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340207
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340207,
					"content": "ただ、激しい戦闘だったので鍵を見失ってしまったようです。蹴られてどこかに行ってしまったのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340208
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340208,
					"content": "あっ、タヌキがいるぞ！もしかして、タヌキが持ってったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340209,
					"content": "ええ、追いかけましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
