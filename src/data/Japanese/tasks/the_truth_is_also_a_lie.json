			"dialogs": [
				{
					"id": 120340701,
					"content": "まさか、九条家と柊家が婚姻関係を結ぶなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340702
					],
					"speakerTitle": "小百合"
				},
				{
					"id": 120340702,
					"content": "勘定奉行で働いている親戚がいるから、あとで彼女に聞いてみるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340703
					],
					"speakerTitle": "真理"
				},
				{
					"id": 120340703,
					"content": "でも彼女、結婚のことなんてこれまで一言も言っていなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真理"
