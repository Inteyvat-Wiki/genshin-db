			"dialogs": [
				{
					"id": 120340501,
					"content": "これ見て、勘定奉行の柊お嬢様と天領奉行の九条鎌治様が結婚するみたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340502
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340502,
					"content": "コホッコホッ…へぇ、これ以上、お似合いの二人はいないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340503
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 120340503,
					"content": "ええ。けど突然よね、そんな雰囲気まったくなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340504
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 120340504,
					"content": "ああ。でも、この一歩を踏み出すのは、そう簡単なことではなかったはずだ。二人の門出を祝おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷昇"
				}
			]
		},
