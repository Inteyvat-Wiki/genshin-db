			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203411",
							"2"
						],
						"stepId": 1203411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九条鎌治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340801,
					"content": "皆様、いいところにお越しくださいました。実は、僕も今しがた耳にしたばかりなのですが…どういう訳か、僕と千里さんの婚姻が公表されたようなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340802
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340802,
					"content": "どうして、こんなにも急な発表がされたのでしょう？僕は、まだ心の準備が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340803
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340803,
					"content": "それなんだけど、実はすっごく複雑なことになってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340804,
					"content": "九条鎌治に事の経緯を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340805
					]
				},
				{
					"id": 120340805,
					"content": "なるほど…まさか、僕たちの婚姻を利用しようとする者が現れるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340806
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340806,
					"content": "このまま婚姻を進めた場合、貴方に影響はさほどありません。しかし、柊様のほうには何かしらあると考えたほうがいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340807
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340807,
					"content": "僕も、その可能性を考慮していなかったわけではありません。ただ、彼女と結ばれたいという想いのほうが勝ってしまったのです。だから、千里さんを守るためなら何でもすると、そう彼女に約束をしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340808
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340808,
					"content": "ええ、お気持ちはお察しします。ただ失礼ながら、彼女はそもそも貴方の庇護を必要としていなかったのではないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340809
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340809,
					"content": "考えてもみてください、貴方が彼女が守られなければ大変なことになると思った時点で、彼女は何か失っていることになるのではないでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340810
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340810,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340811
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340811,
					"content": "貴方を責めるつもりはありませんよ。大切な人を守りたいという気持ちは当然ですから。それに、貴方はとても聡明で優しいお方。心配のあまり混乱さえしていなければ、もっと慎重に考えることができたはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340812
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340812,
					"content": "貴方の愛する柊様は、きっと自立心が強く、優しく、決して屈しないお方なのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340813
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340813,
					"content": "しかし、もし彼女がこのまま貴方と婚姻を結べば…これから先、貴方にもたれ掛かることになってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340814
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340814,
					"content": "それでも、問題ないのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340815
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340815,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340816
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340816,
					"content": "僕は心から彼女を愛しています。この身を捧げても、彼女を幸せにしたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340817
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340817,
					"content": "だからこそ、彼女が苦しむ姿はもちろん、利用される姿も見たくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340818
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340818,
					"content": "神里様のおっしゃる通りです。僕の今までの考えは…あまりにも稚拙で自分本位でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340819
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340819,
					"content": "ただ、もう手遅れなのではないでしょうか？既にあちこちに布告が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340820
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340820,
					"content": "私に策があります。しかし…この策には「悪役」が必要です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340821
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340821,
					"content": "鎌治様、この策で私と貴方は悪役を演じ、ある程度の危険に身をさらす必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340822
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340822,
					"content": "いかがなさいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340823
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340823,
					"content": "まだ挽回の余地があるのならば、ぜひその策をご教授いただきたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340824
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340824,
					"content": "私は勘定奉行の者にこう伝えました。この婚姻によって、勘定奉行と天領奉行が一つになることはない、これは逆に勘定奉行を孤立させる計略であると。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340825
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340825,
					"content": "この計略で柊家の力を弱めるには、ある条件が必要です。それは、天領奉行が婚姻について何も思わないこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340826
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340826,
					"content": "そもそも「目狩り令」の終結後、天領奉行は勢力の弱まった勘定奉行に手を出すことも可能でした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340827
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340827,
					"content": "そのような行動を起こさなかったのは、貴方が天領奉行の当主に就き、そして相手に柊様がいたからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340843
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340843,
					"content": "つまり、貴方にとって最善とも言える手は、社奉行の支持を受け、一刻も早く婚礼の儀を挙げること。そして、柊様を迎えることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340828
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340828,
					"content": "——それによって、天領奉行の当主である貴方は、もう何も心配をする必要がなくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340829
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340829,
					"content": "なるほど！確かに今の状況に合った、巧妙な策と言えます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340830
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340830,
					"content": "これなら、柊千里は不可欠な存在になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340831
					]
				},
				{
					"id": 120340831,
					"content": "そうです。我々の狙いは柊様の立場を変えることにあります。早々に彼女を「追い出すべき足手まとい」から、「いなくてはならない守護者」へと変えるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340832
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340832,
					"content": "そうすれば、勘定奉行での柊様の地位も確保できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340833
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340833,
					"content": "あの者たちがこの一件の背後にある組織網に気づいた時、婚姻を阻止するため、あらゆる手段を講じるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340834
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340834,
					"content": "彼らが作り上げた障害は、彼ら自身の手で解決してもらえばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340835
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340835,
					"content": "承知しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340836
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 120340836,
					"content": "うぐぐ…組織網がうんたらかんたら…って、複雑すぎてわけわかんないぞ！オイラたちはなにをしたらいいんだ、もっとわかりやすく言ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340837,
					"content": "となれば、「事の背景」が勘定奉行の耳に無事届くようにしなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340838
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340838,
					"content": "私と話をした松浦様も今頃は落ち着きを取り戻し、起こりうる事態を考えているはず。用心を始めることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340839
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340839,
					"content": "彼は間違いなく、稲妻城内に偵察を多数送り込みます。我々はその者を利用し、偽の情報が育つようにするのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340840
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340840,
					"content": "鎌治様、貴方のお力もお貸しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340841
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340841,
					"content": "神里綾人は、九条鎌治に詳細を伝えた。しばらくして…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340842
					]
				},
				{
					"id": 120340842,
					"content": "そろそろ頃合いですね。私の忍びが彼の放った偵察を一名特定しました。その者が策にかかるか、皆で見に行くとしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 1203409,
			"completionStepIds": [
				1203414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203414",
							"2"
						],
						"stepId": 1203414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀夫",
					"岡林"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340901,
					"content": "うわぁ、天領奉行の人がこんなにたくさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340902,
					"content": "あの、この通りで何か起きたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340903
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340903,
					"content": "僕は商人なのですが、気付いたらこのような厳重な警備が敷かれていたもので、少し怖くなりまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340904
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340904,
					"content": "いえ、ご心配なく。既にご存じかと思いますが、九条鎌治様と柊千里様が近々婚姻を結ばれます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340905
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340905,
					"content": "そこで九条様は、柊様を予定より早く稲妻城へお迎えするつもりなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340906
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340906,
					"content": "そ、そんなことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340907
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340907,
					"content": "ここにいる皆は、柊様のためにその道を守っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340908
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340908,
					"content": "我々だけでなく、この先にも天領奉行の者が大勢待ち構えており、その全員が同じ任務を背負った者たちです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340909
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340909,
					"content": "…その、僕が言うのもあれですが、いくら何でも張り切りすぎなのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340910
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340910,
					"content": "いえ、こうすることで、九条様が柊様を重要視していると世間に見せつけているんですよ。九条様は最初から最後まで、このように格式高い扱いを続けようとされています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340911
					],
					"speakerTitle": "岡林"
				},
				{
					"id": 120340911,
					"content": "そ、そうだったのですね…すみません、お騒がせしました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340912
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340912,
					"content": "な、なんてことだ。旦那様が懸念していた点が的中するとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340913
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340913,
					"content": "あの者たちは通りを護衛していると言っていた。もし旦那様が柊様を手放さなければ、この男たちはいずれ離島へ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340914
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340914,
					"content": "いや、柊様が離島から離れれば、彼らが押し寄せてくる可能性がより増すかもしれない…天領奉行を相手に、今の旦那様では勝てる見込みなどないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340915
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340915,
					"content": "すぐに戻って報告しないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340916
					],
					"speakerTitle": "秀夫"
				},
				{
					"id": 120340916,
					"content": "あいつ、逃げてったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340917,
						120340918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340917,
					"content": "恐怖で顔が青ざめてたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340919
					]
				},
				{
					"id": 120340919,
					"content": "これで仕掛けは十分。膨れ上がる疑心暗鬼は、恐怖を育てる養分となるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340920
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340920,
					"content": "あとはそれが成長し、熟すのを待つだけです。嵐の前の静けさこそ、もっとも不安を煽るものですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340921
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340921,
					"content": "あいつら、大人しく過ちを認めるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340922,
					"content": "気になるのであれば、二日後また離島へ来て、柊家の状況を確認するといいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340923
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340923,
					"content": "私は他にも色々と公務があるので、ひとまずここで身を引くとします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340924
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340924,
					"content": "——駒は既に動きました。彼らが投降するのも、時間の問題でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340925
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340925,
					"content": "そんなに自信があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340926
					]
				},
				{
					"id": 120340926,
					"content": "ええ。このような手を使うのは、何も初めてではありませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340927
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340927,
					"content": "では皆さん、またお会いしましょう。柊千里が幸せになることを、心から願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340928
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340928,
					"content": "行っちゃったぞ…本当にあいつの予想通りになるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340929,
						120340930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340929,
					"content": "やっぱり、最後まで見届けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340931
					]
				},
				{
					"id": 120340931,
					"content": "おう、オイラも同感だ。二日後、また離島に来てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340930,
					"content": "やっぱり、柊千里が心配。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340931
					]
				},
				{
					"id": 120340918,
					"content": "事の重大さに気づいたんだろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340919
					]
				}
			]
		},
