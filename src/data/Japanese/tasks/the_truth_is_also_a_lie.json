				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"新之丞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120340401,
					"content": "本当にありがとうございます、助かりました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340402
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340402,
					"content": "あやうく溺れ死ぬところでした。彼らは、私を檻ごと海に放り込むつもりだったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340403
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340403,
					"content": "そ、そうだ！お嬢様の婚姻ですが…何者かがそれを利用して、良からぬことを企んでいるようなんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340404
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340404,
					"content": "落ちつけ、新之丞。そのことならもう知ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340405,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340406
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340406,
					"content": "はい、その件でしたら、私たちも気づいていました。ここまでの流れも、私が考えていたものとほぼ一致しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340407
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340407,
					"content": "この計画の首謀者は、そう簡単に諦めないでしょう。すぐに新たな策を講じてくるはずです。私たちも、対抗手段を考えなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340408
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340408,
					"content": "社奉行様が、自ら手を貸してくれるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340409
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340409,
					"content": "この件は三奉行に留まらず、稲妻全土に関わる一大事。私の中立的な振る舞いも、ここまでです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340410
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340410,
					"content": "将軍様は、昔からくだらない権力争いを嫌悪していました。将軍様の臣下たる奉行として、私はこの件を解決に導く義務があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340411
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340411,
					"content": "そ、そうなのですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340412
					],
					"speakerTitle": "新之丞"
				},
				{
					"id": 120340412,
					"content": "新之丞、とりあえず今は戻ってはいけません。どこか身を潜めるのが得策です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340413
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340413,
					"content": "旅人さんにパイモンさん、我々もここを離れましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340414
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340414,
					"content": "しばらくすると…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120340415
					]
				},
				{
					"id": 120340415,
					"content": "おや、これはこれは、社奉行様ではありませんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340416
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340416,
					"content": "あなたが理由もなくここに現れ、私の部下に怪我を負わせたと聞きましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340417
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340417,
					"content": "まさか、何か企んでいらっしゃるのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340418
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340418,
					"content": "いえ、私刑が行われていると小耳に挟んだものでして。責任ある稲妻の公人として、見過ごすわけにはいかなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340419
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340419,
					"content": "たとえ新之丞が貴方の家臣であっても、好き勝手にできるという法はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340420
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340420,
					"content": "私刑？はっ、私刑だなんてとんでもない。これは、ただのお仕置きですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340421
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340421,
					"content": "あの雑輩…どういう訳かお嬢様のもとへ行き、自分勝手で失礼なことを口走ったのです。身の程知らずも甚だしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340422
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340422,
					"content": "そのせいで、お嬢様はひどく怯えていらっしゃる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340423
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340423,
					"content": "つまり、彼がそのような行動を取った理由を、貴方は分からないのですね？そうでなければ、「どういう訳か」なんて言い方はしないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340424
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340424,
					"content": "こちらはあらぬことを色々と吹き込まれたのです。訳が分からないのも当然でしょう。両家の婚姻は実にめでたいことですが、あの小賢しい男のせいで、事が複雑になってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340425
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340425,
					"content": "柊様が九条家へ嫁いだとしても、柊家のお嬢様であることに違いはありません。勘定奉行でもっとも地位あるお方のままです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340426
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340426,
					"content": "もちろん、私たちも誠心誠意を尽くして彼女に仕え、後顧の憂いを断つのにお力添えします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340427
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340427,
					"content": "責務を果たすのが我々の原則。それを守るどころか、あの男はお嬢様の心を乱した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340428
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340428,
					"content": "彼は情熱的な男であったがゆえに過ちを犯したのでしょう。しかし、あなたのように高貴なお方であれば、同じ結論には至らないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340429
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340429,
					"content": "くそぉ～！理屈ばっかこねやがって…ムカつくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340430,
						120340431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340430,
					"content": "（遠回しな言い方ばかりしている。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				},
				{
					"id": 120340432,
					"content": "そういえば、ふと思い出した話があります。社奉行に就いて以来、私は毎日のように興味深いものを見聞きしてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340433
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340433,
					"content": "ある外国の商人から聞いた話によると、とても長い舌を持つ鳥がいるそうなんです。その舌を口の外へ引っ張り出すと、結び目を二つも作れるほど長いとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340434
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340434,
					"content": "貴方も博識なお方。そのような希少な鳥が普段どういった目的で使われるか、当てられるのではないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340435
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340435,
					"content": "はっ？えっと…観賞用の愛玩動物ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340436
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340436,
					"content": "ふふっ、この鳥の面白いところは飼うことができず、何の役にも立たないところでして。仮に捕まえたとしても、舌を切って窓から放り捨てるしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340437
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340437,
					"content": "なぜなら皆、口を揃えてこう言うのです。「舌が長く、屁理屈ばかりこねて騒いだ挙げ句…すべてハッタリであった」と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340438
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340438,
					"content": "なっ…！社奉行様ともあろう方が、我々勘定奉行を揶揄するためにここまで来られたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340439
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340439,
					"content": "いえ、とんでもありません。勘定奉行の皆様は、いつも実直で、自身の責務を果たす善良な方々だと思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340440
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340440,
					"content": "まさか、貴方のような方が人を煙に巻いたり、重箱の隅をつついたりするとは思いもしませんでした。その上、柊様を勘定奉行から引きずり下ろそうと画策するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340441
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340441,
					"content": "社奉行様、その発言に証拠はあるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340442
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340442,
					"content": "目の前に証人がいるではありませんか。貴方は、彼が核心を突いたのを知って、慌てて口封じをしようとしましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340443
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340443,
					"content": "おや、松浦家は名家だというのに、忠誠心は臣下である彼に遠く及ばないようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340444
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340444,
					"content": "せっかく教育を受けて官僚になったのに、表沙汰にはできない悪巧みばかりするなんて。賢いと言うべきか、愚かだと言うべきか…ふむ、果たしてどちらでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340445
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340445,
					"content": "将軍様のために働いてきた貴方は、周りの優秀な人々からちっとも学ばず、利益に目がくらみ、自らの前途を断ってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340468
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340468,
					"content": "松浦様、私は決して怒ってなんかいませんよ。むしろ、貴方のことを残念に思っているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340446
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340446,
					"content": "…くく、はっははっ！ああ、そうですか？では、聡明なあなたは、私をどうしようというのです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340447
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340447,
					"content": "これは我々勘定奉行の問題。こちらで何とかします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340448
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340448,
					"content": "それから、他家の内情にまで口を出すのであれば、私も勝手にあなたの意図を推察してもよいということですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340449
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340449,
					"content": "あなたはただ、勘定奉行と天領奉行の力が一箇所に集中することを避けたいだけ。もしそうなれば、奉行間の均衡が取れなくなり、社奉行の地位が脅かされてしまうからです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340469
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340469,
					"content": "——だから、もっともらしい理由を見つけて、この婚姻をなかったものにしようと企んでいるのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340450
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340450,
					"content": "おや？貴方の目にはそのように映っていたのですね。さすがと言うべきでしょうか。三勢力に関する利害の配慮は、私よりも遥かに優れているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340451
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340451,
					"content": "ふん、婚礼は必ず行います。どのような手を使おうとも止めることは出来ません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340452
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340452,
					"content": "今頃は布告もされ、稲妻でその瓦版が飛び交っているでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340453
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340453,
					"content": "九条鎌治と柊千里が恋仲であったことは、世間に知られていませんでした。ですが、今はもう各地で話題となっているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340454
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340454,
					"content": "これが布告された時点で、たとえ婚姻がまだであっても、あとは時間の問題です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340455
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340455,
					"content": "ふむ。なるほど、やはり私の考えが足りていませんでしたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340456
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340456,
					"content": "ほう！ようやくそれを思い知ったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340457
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340457,
					"content": "本当は貴方のことを、そこらの人々よりは賢いと思っていたのですが…まったく残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340458
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340458,
					"content": "神里綾人、き…貴様ぁ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340459
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340459,
					"content": "もう言いたいことは終わりのようなので、そろそろ私もよろしいでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340460
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340460,
					"content": "…何が言いたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340461
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340461,
					"content": "婚姻を結ぶことで勘定奉行と天領奉行が一つになれると、本気でお思いですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340462
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340462,
					"content": "実際、孤立するのは、勘定奉行のほうかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340463
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340463,
					"content": "なに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340464
					],
					"speakerTitle": "松浦"
				},
				{
					"id": 120340464,
					"content": "さて、貴方とは大変有意義なお話ができましたので、これで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340465
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340465,
					"content": "お、おい！なにがなんだか、オイラさっぱりなんだけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340466
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340466,
					"content": "彼らが策を講じるのであれば、私も無策で挑むわけにはいきません。予想していた通り、彼らは前に出て牙を見せてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340467
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340467,
					"content": "まずは稲妻城に戻って、現状を確認しましょう。策の説明はその後いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340431,
					"content": "（確かに、隙を見つけるのが難しい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120340432
					]
				}
			]
		},
