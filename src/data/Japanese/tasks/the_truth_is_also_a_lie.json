			},
			"dialogs": [
				{
					"id": 120340101,
					"content": "なにしてるんだ！新之丞をはなせ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120340102,
					"content": "そこの者、直ちに暴行を止めなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340103
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 120340103,
					"content": "どうして、社奉行様が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340104
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340104,
					"content": "いや、俺たちを動かせるのは旦那様だけ。他のやつの言葉に耳を貸すつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120340105
					],
					"speakerTitle": "久保"
				},
				{
					"id": 120340105,
					"content": "そうですか…ならば、覚悟なさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 1203402,
			"completionStepIds": [
				1203406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
