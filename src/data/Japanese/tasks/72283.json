			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "お前もダメだったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830202,
					"content": "きっと今日はツイてない日なんだ。なにか悪いものに影響されてるに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830203,
					"content": "もう少し試してみるか？的は陸ウナギの稚魚みたいに動き回りはしないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "明石"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "おお！成功したのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830302,
					"content": "でも、お前の動きを見ると、きっとかなりの熟練者なんだろうな。俺みたいな素人は、数年練習したってお前みたいにはなれないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830303,
					"content": "それに毎日こんなところで練習しているせいで、もう長いこと陸ウナギを見てない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830304,
					"content": "お前は陸ウナギが好きか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830305,
					"content": "好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "そうか。俺は陸ウナギが大好きでな。好きすぎるから、自分で養殖しようと思ったんだ。あいつら、すごく可愛いと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830308,
					"content": "料理になった陸ウナギも勿論、さらに美しい。見た目もいいし、何より美味いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830309,
					"content": "陸ウナギが好きだから養殖をしたいのに、その陸ウナギを飼育するために弓の練習ばかりしている。これって本末転倒じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830310,
					"content": "結局、俺はやっぱり自由な陸ウナギが好きなんだ。養殖のことはもう忘れよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830311,
					"content": "そうだ、手本を見せてくれてありがとうな。これはお前にやるよ、これからも頑張れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明石"
				},
				{
					"id": 722830306,
					"content": "いや、ちょっと苦手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}