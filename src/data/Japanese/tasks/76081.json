						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "シグルドさん、あなたは僕の恩人です。あの時、あなたがライトキーパーを率いて南下し、敵と戦ってくれていなければ…僕はきっと人知れず命を落としていたことでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810302,
					"content": "でも、なぜあなたの魂は安らぎを得られず、今も彷徨い続け、戦い続けているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810303,
					"content": "ワイルドハントの穢れに染まり、身体さえもバラバラになって…あなたは今も、あの戦場から抜け出せていないんですね。あなたにとって、戦いはまだ終わっていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810304,
					"content": "その点では、僕も同じかもしれません。ワイルドハントが完全に消え去るその日まで、真の安らぎは得られない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810305,
					"content": "お目にかかれて光栄です、シグルドさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810306,
					"content": "分かりました。ライトキーパーにとって、最高の交流は刀を手に取り、互いに切磋琢磨することですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810307,
					"content": "では、新世代のライトキーパーの腕をお見せします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		},
