						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "あなたとの一戦は実に痛快でした、シグルドさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760810202,
					"content": "英雄がこのような末路を辿るとは、実に残念です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760810203,
					"content": "命を捧げたこの土地で、孤独にさまようことになるとは…ライトキーパーの誓いに応えた時、果たして今日のことを予測していたでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760810204,
					"content": "仮に予測していたとしても、ためらうことはなかったんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760810205,
					"content": "いつかまた来ます——それではまた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				}
			]
		},
		{
