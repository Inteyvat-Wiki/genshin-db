				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "ありがとうございました、シグルドさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810402,
					"content": "安心してください。皆さんが命を捧げられた後、義{RUBY#[D]ちち}父のニキータが新しいマスター・ライトキーパーとなり、皆さんに救われた人々と共にライトキーパーの軍団を再建しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810403,
					"content": "今では、ワイルドハントの暗い影の下でもこの地を守れるまでに成長しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810404,
					"content": "皆さんの献身は決して無駄ではありませんでした。皆さんの功績も、意志も、忘れ去られることはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760810405,
					"content": "さようなら、シグルドさん。時々また会いに来ますから、どうか安らかに眠ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "この魔物の制圧方法…いや、あの方はとっくに亡くなっているはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760819902,
					"content": "まさか、なんらかの方法で目覚めた…？ボーンモス荒原の北東部にある浜辺にある、あの方の墓に赴かなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 760819903,
					"content": "義父さんから聞いたことがあります。かつて共に戦った伝説のマスター・ライトキーパー「シグルド」の物語を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760819904,
					"content": "紫の剣光に金色の髪——伝説通りの姿だ…この間出会ったあの人はもしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "イルーガ"
				},
				{
					"id": 760819905,
					"content": "ボーンモス荒原の北東にある浜辺が彼の埋葬地です。時間があったら、行ってみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルーガ"
				}
			]
		}
	]
}