						750442402
					]
				},
				{
					"id": 750442402,
					"content": "「…作業員マフチントリ、テラナンク、および…排水の建設を担当…勤務怠慢により、進捗が遅れ…慈悲深く…刑罰を科さず…三週間の配給停止…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "「…<color=#00E1FFFF>排水装置</color>を起動する<color=#00E1FFFF>石の鍵</color>は…に置かれている…許可なく…新たな作業員が配置されるまで…」",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
