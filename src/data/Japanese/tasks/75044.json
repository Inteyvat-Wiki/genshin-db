				},
				{
					"id": 750444402,
					"content": "よく見たら、この幻写霊の前にある壺だけ空っぽだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750444403,
					"content": "もしかして、他の幻写霊は探すべきものを見つけたのに、この幻写霊だけは見つけられてないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750444404,
					"content": "#かわいそうだな…{NICKNAME}、この壺に入ってるはずのものをオイラたちが探してやろうぜ。…でも、なにを入れたらいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750444405,
					"content": "（入れる。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
