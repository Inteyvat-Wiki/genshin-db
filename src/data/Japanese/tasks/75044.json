			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "召竜台、開放中。マターガの特訓への参加を希望する人と、または竜は召竜台までお越しください。心に刻め：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "目を引くスローガン"
				},
				{
					"id": 750440702,
					"content": "誇るべきは、努力と積極性。恥じるべきは、怠惰と消極性！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "目を引くスローガン"
				},
				{
					"id": 750440703,
					"content": "今日頑張らないと、明日は飯抜きだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "目を引くスローガン"
				},
				{
					"id": 750440704,
					"content": "前へ突き進み、竜の如く飛べ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "目を引くスローガン"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "合図はまず左の角笛、次は右、それから左、最後に右だ。間違ったら後悔するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "マターガ！絶対に忘れるな！！"
				},
				{
					"id": 750440802,
					"content": "鳥肉を少し与えておくといい。竜の機嫌を取れば、つつかれずに済む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "マターガ！絶対に忘れるな！！"
				},
				{
					"id": 750440803,
					"content": "（マターガという人物が自分のために残したメモのようだ。熱い感情がひしひしと伝わってくる。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "マターガ！絶対に忘れるな！！"
				},
				{
					"id": 750440804,
					"content": "（どの文にもビックリマークが付いてるけど、逆に効果が薄れるような…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マターガ！絶対に忘れるな！！"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
