					],
					"speakerTitle": "幻写霊"
				},
				{
					"id": 750444602,
					"content": "おお、これなんだな！赤いのがついてるやつが必要みたいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750444603,
					"content": "でも、あれっ？前に入れたものが…確かに入れたはずだよな。ちょっと待てよ、なんかおかしい気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750444604,
					"content": "中に違うものが入ってるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "パイモン"
				},
