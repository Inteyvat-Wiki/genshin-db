			"dialogs": [
				{
					"id": 207400401,
					"content": "花について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "お花を摘み終わったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400403,
					"content": "はい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "どれも新鮮で美しい…ありがとう、このお花たちがあれば、きっとお客さんも来てくれると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400405,
					"content": "それと、一つお願いがあるんだけど…暴風の時、店の蒲公英も全部吹き飛ばされたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400406,
					"content": "蒲公英の種が風に連れ去られるのは悪いことじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400407,
					"content": "モンドの花屋に蒲公英が置いてないのはやはりおかしいよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400408,
					"content": "蒲公英は摘んで持って帰れないから、種から作らないといけないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400409,
					"content": "だから、蒲公英の種を一つ探してきてもらえないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400410,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "じゃあ、お願いね。モンド城外には蒲公英がたくさんあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400412,
					"content": "どこで取れる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "モンド城外に蒲公英がたくさんあるから、すぐに取れると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
				}
			]
		},
