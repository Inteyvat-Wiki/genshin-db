						207400503
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400503,
					"content": "手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "ありがとう、これで十分だよ。あとで植木鉢に植えるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400505,
					"content": "あなたが前に摘んできてくれたお花も、植木鉢に植えるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400506,
					"content": "そうだ、これはお礼だよ、受け取ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 207400507,
					"content": "早くお花を植木鉢に植えないとね、それと蒲公英の種も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フローラ"
