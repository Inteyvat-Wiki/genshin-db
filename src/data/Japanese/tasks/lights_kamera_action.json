			},
			"dialogs": [
				{
					"id": 750230301,
					"content": "ん？手順をもう一度聞きたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230302,
					"content": "もう一度説明して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "まずは演出道具の配置だ。樽は<color=#00E1FFFF>画面の中心、主役や背景を隠さない位置</color>に置く。元素の餌は<color=#00E1FFFF>敵役が入ってくる方向</color>に置いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230304,
					"content": "その後、必要に応じて、<color=#00E1FFFF>敵役を樽の近く</color>に誘導し、安全な場所に退いてから<color=#00E1FFFF>樽を壊す</color>と完成だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230305,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "それでは、頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アカタンカ"
				}
			]
		},
