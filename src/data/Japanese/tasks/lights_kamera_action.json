			"dialogs": [
				{
					"id": 750230201,
					"content": "#{NICKNAME}、これを見ろ！ここに写真機と舞台背景があるぞ！もしかして、映影の撮影現場じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230202,
					"content": "#でもここの舞台背景…それとこの建物たち、すっごくちっちゃいぞ！{NICKNAME}が巨人みたいに見えるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230203,
					"content": "グルゥ…キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "ちっぽけな人間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "パイモンが住むのにぴったりかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "フフン、これでオイラたちは立派な「オオモノ」だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230208,
					"content": "こんな手足も伸ばせない狭い家には住むもんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230239,
					"content": "一人のナタ人が自然な流れで会話に加わってきた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "おお！君たちも映影に興味があるのかい？だったらぜひとも、このアカタンカの力になってくれ！このナタの地に、新しい流行を巻き起こそうじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230210,
					"content": "キュウ！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、嬉しそうだけど、こいつに賛成してるのか？おまえも映影が好きだったのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230212,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "なかなか見る目があるぞ、おチビさん！実は、ここにあるものは全て、あるテペトル竜をスターにするために準備したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230214,
					"content": "しかし残念なことに、そのテペトル竜は私の友人が連れ去ってしまったんだ。創作の理念が合わず、大喧嘩をしてね…彼女は私の一番大切な役者を連れて、どこかへ行ってしまったよ。はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230215,
					"content": "友人と一緒に仕事をするべきではなかった。プロジェクトは失敗し、友人も失ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230216,
					"content": "だが、構わないさ。なんたって今、私の前に新しいテペトル竜が現れたんだからね。このやる気満々な姿…必ずや成功を遂げ、大スターになるに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230217,
					"content": "いかがかな？時代を画するこの作品の完成を手伝ってくれたら、それ相応の報酬を支払おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230218,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}が好きなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "絶対成功なんて、まるで詐欺みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "たとえ一発で有名になれなくても、撮影を手伝ってくれた報酬はきちんと支払うつもりだ。損はさせないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230221,
					"content": "手伝うのはいいけど、まずはどんな映影なのか知りたいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230222,
					"content": "私が考えた内容はこうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230223,
					"content": "ブーン——パーン、パンパン、パーン。眩しい光が消えると、丸々としながらトゲのある来客が部族に殺到した。ジージー、ジージー、草地に少し留まっただけで焦げた匂いが漂ってくる。「ひぃ！シバルバーの使者だ！」部族の人々は恐怖の表情を浮かべ、パーン、パンパン、パーン、「やつが来たぞ！歯もない邪悪な生物だ！部族を食い尽くすつもりだ！」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#邪悪な暴徒が部族の防壁に飛び込もうとしたその時！カーン——カーン——尾に赤いリボンをつけた救世主が突然現れた。「なぜここに？」黒曜石よりも硬い両爪は、どんな土石でも簡単に砕き散らすことができる。「だが敵の柔軟性は、それよりも勝っている！{REALNAME[ID(2)|SHOWHOST(true)]}の勝ち目は…」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "「キュウ——！」怒鳴り声というより、悲鳴に近い。歯のない邪悪な生物もブルブルと震えている。空高く舞い上がる炎と、それに続く轟音、そして液体燃素に浸かったよりも熱い熱波！歯のない邪悪な生物は四散し、「あちい！あちい」と叫ぶ。その余波は生き残った部族を巻き込んだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "尾に赤いリボンをつけた救世主はいつの間にか姿を消した。その姿がどうやって現れたのか、誰も知らない…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "いかがかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230228,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "すごい。こんな作品が見たかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "独特だけど、分かりづらかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "やはり！こういうのが好きな人は必ずいると信じていたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230232,
					"content": "それは…前に外から来た人から、「差別化戦略」も悪くないと言われてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230233,
					"content": "#えっと、オイラにはよくわからないけど、{REALNAME[ID(2)|SHOWHOST(true)]}に気に入ってもらえばそれでいいぜ。それで、具体的に何をすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750230234,
					"content": "至って簡単さ。まずは演出道具の配置。<color=#00E1FFFF>樽と元素の餌を適切な場所に置いて</color>くれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230235,
					"content": "樽は最大の目玉だから、<color=#00E1FFFF>画面の中心</color>に置く必要があるが、主役や背景を遮ってはいけない。元素の餌は<color=#00E1FFFF>敵役が入ってくる方向</color>、すなわち側面に置くのがいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230236,
					"content": "#役者が全員揃ったら、動き始めてくれ。{REALNAME[ID(2)|SHOWHOST(true)]}、尾に赤いリボンをつけた救世主のご登場だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230237,
					"content": "ストーリーに合わせて、<color=#00E1FFFF>敵役を樽の近くまで誘導し</color>、素早く離れて、安全な場所から<color=#00E1FFFF>樽を壊せば</color>、見事に完成だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "アカタンカ"
				},
				{
					"id": 750230238,
					"content": "完成した映影を見るのが待ち遠しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アカタンカ"
				}
			]
		},
